                "senses": [
                    {
                        "sense_id": "623230ba-b2b3-3969-a332-f52d1e6d344a",
                        "entry_id": "7cc2395f-17bc-32d0-b299-7de311a49b87",
                        "glosses": [
                            "bolesny przykurcz mięśni szyjnych powodujący odchylenie głowy i szyi w stronę barku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc4eb709-43ee-4497-8dc3-77461e4c5847",
                                "sense_id": "623230ba-b2b3-3969-a332-f52d1e6d344a",
                                "text": "W przypadku kręczu ułożeniowego zazwyczaj następuje samowyleczenie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e206cc6-445f-4e63-b5c8-2aed0446ef85",
                        "source_entry_id": "7cc2395f-17bc-32d0-b299-7de311a49b87",
                        "source_sense_id": "623230ba-b2b3-3969-a332-f52d1e6d344a",
                        "target_lang_word": "crick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "434efb0a-a2c9-3c60-89b9-11642f2a171b",
                                        "entry_id": "f7369494-288d-3874-877e-e76dcf87541b",
                                        "glosses": [
                                            "A painful muscular cramp or spasm of some part of the body, as of the neck or back, making it difficult to move the part affected."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a283848-4dc7-3edd-bc05-05d83fd04467",
                                        "entry_id": "f7369494-288d-3874-877e-e76dcf87541b",
                                        "glosses": [
                                            "A small jackscrew."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dbb00e8-f8a6-3657-a10d-caf6459728d7",
                                        "entry_id": "733aaa4d-fae5-3cdd-920c-8e6631c197a1",
                                        "glosses": [
                                            "To develop a crick (cramp, spasm)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f79ec89-d58e-45bb-9f34-505a7f0d83b8",
                                                "sense_id": "6dbb00e8-f8a6-3657-a10d-caf6459728d7",
                                                "text": "Stomach sleeping never worked for her because her neck cricked and pained in so short a time, that she never got the chance to fall asleep that way although the rest of her body snuggled well into the bed in that position."
                                            },
                                            {
                                                "example_id": "1e53a581-505b-4733-a99a-74f368f4c7ff",
                                                "sense_id": "6dbb00e8-f8a6-3657-a10d-caf6459728d7",
                                                "text": "“He's upstairs.” As soon as she said this, a loud knocking came from the crawl space below. Katrín was so startled that her neck cricked painfully as she looked down. Adrenalin rushed through her veins and the pain in her fingers disappeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e4d7f5-90e9-3db6-ab77-57f6682ad2e2",
                                        "entry_id": "733aaa4d-fae5-3cdd-920c-8e6631c197a1",
                                        "glosses": [
                                            "To cause to develop a crick; to create a crick in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9e1d1b-a804-45fd-bbdd-5545d1468970",
                                                "sense_id": "d7e4d7f5-90e9-3db6-ab77-57f6682ad2e2",
                                                "text": "He'd fallen asleep after all (and he'd done it in such a way as to crick his neck and his back and put his right arm to sleep; hardly a good start to a busy day) and now daylight was seeping through the bald patches in the thatch, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16961cf4-6643-37d6-be4f-3da7c5c1236b",
                                        "entry_id": "733aaa4d-fae5-3cdd-920c-8e6631c197a1",
                                        "glosses": [
                                            "To twist, bend, or contort, especially in a way that produces strain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53fcd92c-fa9b-4785-b2da-a5f342652223",
                                                "sense_id": "16961cf4-6643-37d6-be4f-3da7c5c1236b",
                                                "text": "He stopped a few feet from her, probably because he'd have to crick his neck to glare at her and that would just be embarrassing for him. “Dealing with garbage suits you.”"
                                            },
                                            {
                                                "example_id": "09054d0b-d302-42d2-bdff-553c306aa1ad",
                                                "sense_id": "16961cf4-6643-37d6-be4f-3da7c5c1236b",
                                                "text": "The throbbing pain that even now was coursing through his neck and shoulders, making him crick his neck."
                                            },
                                            {
                                                "example_id": "041f541f-755d-4220-b032-78b7f3a07419",
                                                "sense_id": "16961cf4-6643-37d6-be4f-3da7c5c1236b",
                                                "text": "Addy was tall for a woman, and he liked that because he didn't have to crick his neck ..."
                                            },
                                            {
                                                "example_id": "b4e16df6-191f-4680-8ce5-f13b9d3c2467",
                                                "sense_id": "16961cf4-6643-37d6-be4f-3da7c5c1236b",
                                                "text": "Now she was able to stand on her feet, so long as she kept her neck cricked."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crick",
                                "target_lang_code": "en",
                                "target_senses": [
