                "senses": [
                    {
                        "sense_id": "b5dad54d-c27a-3ab0-a8a7-cdca0d877267",
                        "entry_id": "62092bbf-5930-39cd-b849-af5debd10b04",
                        "glosses": [
                            "een cirkelvormige wafel, geheel bedekt met chocolade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721f073d-aea3-4cfa-bd43-5e17cff73c67",
                                "sense_id": "b5dad54d-c27a-3ab0-a8a7-cdca0d877267",
                                "text": "Soms is het chocolade omhulsel van een oublie opgehoogd aan de bovenkant en opgevuld met chocoladecrème."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d3f1ead-2c8e-444e-b040-ad8ee3976168",
                        "source_entry_id": "62092bbf-5930-39cd-b849-af5debd10b04",
                        "source_sense_id": "b5dad54d-c27a-3ab0-a8a7-cdca0d877267",
                        "source_sense_description": "een cirkelvormige wafel, geheel bedekt met chocolade",
                        "target_lang_word": "oublie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oublie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                        "entry_id": "08b7f57e-880d-3dc9-9913-a3b7e78e076f",
                                        "glosses": [
                                            "Mince gaufre que l’on cuit entre deux fers, et qui peut être roulée en cornet."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c17bb1d9-9227-433b-9a7a-afea4041efd5",
                                                "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                                "text": "On sert aussi des spumas de chocolat, de café et autres ; ce sont des espèces de crèmes fouettées et glacées, d’une légèreté extrême, qu’on saupoudre quelquefois de cannelle râpée très-fine, le tout accompagné de barquilos, oublies roulées en longs cornets avec lesquels on prend sa bebida, comme avec un siphon, en aspirant lentement par l’un des bouts ; petit raffinement qui permet de savourer plus longtemps la fraîcheur du breuvage."
                                            },
                                            {
                                                "example_id": "96265b79-1218-4f1f-be0b-fc2fe073bd4c",
                                                "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                                "text": "Sous le porche, une marchande d'oublies agitait sa lanterne et offrait son antique friandise à des ombres fuyantes."
                                            },
                                            {
                                                "example_id": "8e38c74b-3abb-45c1-8edf-545fee75119c",
                                                "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                                "text": "Une savoureuse odeur de farine, de beurre chaud et de miel flottait autour de l’éventaire.\n« Chaudes, chaudes les oublies ! Tout le monde n’en aura pas. Allez, bourgeois, mangez ! Chaudes les oublies ! » criait le marchand qui s’agitait derrière un fourneau en plein air."
                                            },
                                            {
                                                "example_id": "2c37d817-7fb2-4cba-83e7-e07086d124ed",
                                                "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                                "text": "Elle se hâta de dire que je n'étais pas son fils, mais celui de sa sœur, et elle ajouta qu'elle n'était pas mariée. Sur quoi l'aimable vieillard me donna deux sous, pour aller acheter des « oublies » au marchand qui était au bout de l'allée."
                                            },
                                            {
                                                "example_id": "bf8e0b54-08e9-45a8-8808-6e997290d03f",
                                                "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                                "text": "On roule ordinairement les oublies en forme de cornets."
                                            },
                                            {
                                                "example_id": "bc6c7075-cd09-4755-8cde-80fc0401bb8b",
                                                "sense_id": "66eb7c44-aa45-3b2b-9e9c-ccce7f2fe997",
                                                "text": "C’étaient les vendeurs de plaisirs portant, sur le dos, leur grand cylindre rouge surmonté d’une tourniquet de loterie qui appelaient les promeneurs avec une crécelle et les invitaient à gagner leurs oublies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3813909-ba02-3c8b-9ec2-ef4929f12b77",
                                        "entry_id": "08b7f57e-880d-3dc9-9913-a3b7e78e076f",
                                        "glosses": [
                                            "Pain d’autel préparé pour être consacré à la messe."
                                        ],
                                        "tags": [
                                            "Au sens primitif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d50bec-52a6-4f52-9fa7-dc20ba9043ec",
                                                "sense_id": "d3813909-ba02-3c8b-9ec2-ef4929f12b77",
                                                "text": "Et des souvenirs d’enfance lui revenaient, de cousines, de tantes, entrevues dans des parloirs, des femmes douces et graves, blanches comme des oublies, qui l’intimidaient, en parlant bas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oublie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b75bf35-f034-3e60-ba7a-f3962a1acfed",
                                        "entry_id": "6fbee46b-590e-3263-b9bc-fb9810b8b776",
                                        "glosses": [
                                            "Interjection exprimant un refus, une négation ou une désapprobation forte destinée à un unique interlocuteur."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a83c372e-9c29-4c99-980b-a7fb563efd62",
                                                "sense_id": "8b75bf35-f034-3e60-ba7a-f3962a1acfed",
                                                "text": "Oublie ! Ça ne risque pas d’arriver prochainement."
                                            },
                                            {
                                                "example_id": "41a33e87-3ee2-4154-b8ea-e91a6c3241ca",
                                                "sense_id": "8b75bf35-f034-3e60-ba7a-f3962a1acfed",
                                                "text": "Tu veux que je te file quoi ? Ça !? Oublie meuf."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oublie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0204a1ab-be57-3c22-a4d7-5bc82b728cec",
                                        "entry_id": "26f3e940-f413-3b8d-9bef-1270e7884623",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de oublier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2bb130b-c81f-402f-b934-e58adb2a1fac",
                                                "sense_id": "0204a1ab-be57-3c22-a4d7-5bc82b728cec",
                                                "text": "Enrobée, bottée, bijoutée, parfumée, maquillée et le sac qui ne dépareille pas, c’est primordial. Non. Je me dérobe, débotte, débijoute, déparfume, démaquille et j’oublie le sac."
                                            },
                                            {
                                                "example_id": "3cd1612d-102f-46ea-9580-e6cd304b702d",
                                                "sense_id": "0204a1ab-be57-3c22-a4d7-5bc82b728cec",
                                                "text": "A c’ t’ heure que ma vie n’est plus la vie de ma vie Que je suis désamanché Que je suis sans tendre moitié A c’ t’ heure je m’oublie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01ed042f-a484-36af-b754-b10de9790b3f",
                                        "entry_id": "26f3e940-f413-3b8d-9bef-1270e7884623",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de oublier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d954cd82-b144-4eb9-83e7-31dadbaf2f6a",
                                                "sense_id": "01ed042f-a484-36af-b754-b10de9790b3f",
                                                "text": "Une autre logique prévaut qui aboutit à pourvoir aussi d’un tribunal de commerce tel petit bourg navré de n’avoir bénéficié d’aucune autre promotion administrative. Si donc Belvès, Saint-Céré ou Salon sont « déconsularisés » avant la fin de l’Empire, Tinchebray, dans l’Orne, garde le sien, et on n’oublie ni Pont-Audemer ni Pertuis — qui est après tout la capitale du pays d’Aigues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de58e3d-303f-328a-9112-03183c5e36b4",
                                        "entry_id": "26f3e940-f413-3b8d-9bef-1270e7884623",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de oublier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb7138b-7eb8-416b-88b2-2bc6d234e8ce",
                                                "sense_id": "6de58e3d-303f-328a-9112-03183c5e36b4",
                                                "text": "Que mon front de cheveux au printemps se couronne,\nOu que tout dépouillé comme l’arbre en automne,\nIl penche sous le temps si prompt à déflorir ;\nLes lauriers de l’Arno cesseront de verdir,\n La neige sera flamme, et la pierre amollie ;\nMon cœur deviendra pierre, avant que je l’oublie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf42fea-49d9-3790-bafc-dcae45d4f671",
                                        "entry_id": "26f3e940-f413-3b8d-9bef-1270e7884623",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de oublier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a59d76-941d-4679-b008-66a2419604f4",
                                                "sense_id": "ccf42fea-49d9-3790-bafc-dcae45d4f671",
                                                "text": "Et que le lecteur n’oublie pas que j’ai opéré sur moi-même ; que mon travail a été un travail d’auto-chirurgie et sans autre anesthésique que le travail lui-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde75fbd-5cc1-3a9d-886e-dc676f70bc0b",
                                        "entry_id": "26f3e940-f413-3b8d-9bef-1270e7884623",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de oublier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
