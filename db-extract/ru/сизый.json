                "senses": [
                    {
                        "sense_id": "4d09107a-a5ec-3b3b-838d-5f5cad70109d",
                        "entry_id": "e48ee675-396a-3247-b1a7-81b084ec46d0",
                        "glosses": [
                            "dove-coloured/colored, warm grey, bluish"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406abd99-4aed-4b68-ae5d-52f35d8304be",
                                "sense_id": "4d09107a-a5ec-3b3b-838d-5f5cad70109d",
                                "text": "си́зый го́лубь",
                                "translation": "rock dove (IOC preferred term), rock pigeon",
                                "english": "rock dove (IOC preferred term), rock pigeon"
                            },
                            {
                                "example_id": "68ed9ace-56df-4f0e-a62a-02c7b791c25c",
                                "sense_id": "4d09107a-a5ec-3b3b-838d-5f5cad70109d",
                                "text": "си́зый тума́н",
                                "translation": "blue-grey mist",
                                "english": "blue-grey mist"
                            },
                            {
                                "example_id": "407d76b8-5448-4852-9763-6762b7c533dd",
                                "sense_id": "4d09107a-a5ec-3b3b-838d-5f5cad70109d",
                                "text": "То́лстый си́зый го́лубь прилете́л на доро́гу и поспе́шно отпра́вился пить в лу́жицу во́зле коло́дца.",
                                "translation": "A plump blue pigeon flew on to the road and hurriedly started to drink water from a puddle near the well.",
                                "english": "A plump blue pigeon flew on to the road and hurriedly started to drink water from a puddle near the well."
                            },
                            {
                                "example_id": "3a22ce6e-79ce-48a0-aeb8-c976982e487b",
                                "sense_id": "4d09107a-a5ec-3b3b-838d-5f5cad70109d",
                                "text": "Грузови́к впереди́ вы́бросил клуб си́зого ды́ма и прое́хал вперё́д ме́тров на пятна́дцать.",
                                "translation": "The truck in front of them belched out a cloud of blue smoke and moved forward about fifteen meters.",
                                "english": "The truck in front of them belched out a cloud of blue smoke and moved forward about fifteen meters."
                            }
                        ]
                    }
