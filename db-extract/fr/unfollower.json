                "senses": [
                    {
                        "sense_id": "a5e64d74-6415-344c-94b3-3241626c7702",
                        "entry_id": "22d810e0-ef8e-36cb-aeea-0cf5b43a7afc",
                        "glosses": [
                            "Arrêter de suivre sur Twitter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f0ea16-543e-47af-b18f-5cffd8fcdbac",
                                "sense_id": "a5e64d74-6415-344c-94b3-3241626c7702",
                                "text": "Selon le journal espagnol, la «preuve définitive» de la rupture est à chercher sur Twitter, où Irina Shayk a unfollowé Cristiano Ronaldo."
                            },
                            {
                                "example_id": "f829d663-52e9-4eee-bd30-b48d4fe0c50d",
                                "sense_id": "a5e64d74-6415-344c-94b3-3241626c7702",
                                "text": "Les gens ils unfollowent en pensant qu'on va continuer de les suivre. Mais non."
                            },
                            {
                                "example_id": "c0024d47-1b45-43aa-9ddc-a89aacbbb71e",
                                "sense_id": "a5e64d74-6415-344c-94b3-3241626c7702",
                                "text": "Nabilla et Thomas se séparent définitivement et s'unfollowent sur Twitter."
                            },
                            {
                                "example_id": "f5ef5072-8e7a-41f8-968e-ffea067bb42e",
                                "sense_id": "a5e64d74-6415-344c-94b3-3241626c7702",
                                "text": "Ce soir je vous autorise à l'unfollower sans le préavis."
                            }
                        ]
                    }
                ],
