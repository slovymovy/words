                        "entry_id": "33839b9e-62e7-37ad-a716-4b5989088908",
                        "glosses": [
                            "Fragment de roche solide expulsé pendant l’éruption d’un volcan ou lors d'un impact météoritique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffdf737a-dc0b-4f85-ab18-ba54e7d72546",
                                "sense_id": "bbb25197-bac4-3343-8f4a-c0a4e5d2097b",
                                "text": "…sont très visibles aussi les éjectas de matériaux éparpillés tout autour de l'impact."
                            },
                            {
                                "example_id": "86ff76c0-0155-406b-9ae6-9fdea3ce464e",
                                "sense_id": "bbb25197-bac4-3343-8f4a-c0a4e5d2097b",
                                "text": "Un éjecta est une projection de matière lié à l’impact d’une météorite ."
                            }
                        ]
                    }
                ],
