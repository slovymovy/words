                "senses": [
                    {
                        "sense_id": "24c75af2-f912-3235-946f-1add6d190b85",
                        "entry_id": "7da545f7-236e-318b-8a82-81f3d2c51a55",
                        "glosses": [
                            "Vorgabe (Regel) zur Vermeidung von Kontamination/Verunreinigung/Ansteckung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61ebc7d-829c-4fef-9553-beb9bd034076",
                                "sense_id": "24c75af2-f912-3235-946f-1add6d190b85",
                                "text": "„Beim Husten und Niesen werden unzählige Krankheitserreger weiterverbreitet. Einfache Hygieneregeln tragen dazu bei, andere nicht anzustecken.“"
                            },
                            {
                                "example_id": "5c6f2af4-8b33-4987-9b57-a78095b0c37d",
                                "sense_id": "24c75af2-f912-3235-946f-1add6d190b85",
                                "text": "„Wenn Sie sich während dieser strikt an die Abstands- und Hygieneregeln halten, ist keine Quarantäne nötig, wenn eine (unwissentlich) infizierte Person dieselbe Veranstaltung besucht hat.“"
                            },
                            {
                                "example_id": "b83dcf36-4f37-4d25-ad53-78b44738ccda",
                                "sense_id": "24c75af2-f912-3235-946f-1add6d190b85",
                                "text": "„So vorgesorgt kann unter Einhaltung der wichtigsten Hygieneregeln (s.u.) auf der Reise eigentlich nichts mehr passieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
