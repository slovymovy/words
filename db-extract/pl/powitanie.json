                                        "sense_id": "d1458a61-33ed-3900-97f8-5be8d95341b0",
                                        "entry_id": "47f56d85-9d59-3cd4-b3df-1bb73b7ae5da",
                                        "glosses": [
                                            "A conventional phrase used to start a letter or conversation or otherwise to acknowledge a person's arrival or presence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e71c48b-0b25-4738-be42-b12182bd5df9",
                                                "sense_id": "d1458a61-33ed-3900-97f8-5be8d95341b0",
                                                "text": "It's polite to begin a letter with a greeting, but this practice is less common in email."
                                            }
