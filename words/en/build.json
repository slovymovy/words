                        "pl": [
                            {
                                "target_lang_word": "budować",
                                "target_lang_sense_clarification": "tworzyć budynki lub konstrukcje"
                            },
                            {
                                "target_lang_word": "zbudować",
                                "target_lang_sense_clarification": "ukończyć budowę obiektu"
                            },
                            {
