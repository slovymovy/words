{
    "word_family": [
        "seedling",
        "seedy",
        "seedless",
        "reseed",
        "unseeded"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3a96bac-2575-3863-95a5-773ce0cb89fd",
                    "sense_definition": "A small, hard part produced by a plant, from which a new plant of the same kind can grow.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers sow <w>seeds</w> in the fertile soil every spring.",
                            "target_lang_translations": {
                                "ru": "Каждую весну фермеры сеют <w>семена</w> в плодородную почву.",
                                "zh": "农民们每年春天都会在肥沃的土壤里播下<w>种子</w>。"
                            }
                        },
                        {
                            "text": "She bought a bag of sunflower <w>seeds</w> to eat as a snack.",
                            "target_lang_translations": {
                                "ru": "Она купила пакет подсолнечных <w>семечек</w>, чтобы перекусить.",
                                "zh": "她买了一袋葵花<w>籽</w>当零食吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sow seeds",
                        "sunflower seeds",
                        "plant a seed",
                        "pumpkin seeds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая твердая часть, производимая растением, из которой может вырасти новое растение того же вида.",
                        "zh": "植物产生的坚小部分，能够长成同类的新植物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семя",
                                "target_lang_sense_clarification": "ботанический термин"
                            },
                            {
                                "target_lang_word": "семечко",
                                "target_lang_sense_clarification": "разговорное; отдельное зерно (например, подсолнуха)"
                            },
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "семя злаковых культур"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种子",
                                "target_lang_sense_clarification": "植物的种子；最常用说法"
                            },
                            {
                                "target_lang_word": "籽",
                                "target_lang_sense_clarification": "口语中常用于某些可食用的籽，如葵花籽、南瓜籽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32d9a733-9aa6-357d-97de-c9848e92f8cf",
                    "sense_definition": "The beginning or origin of something, especially an idea or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>seeds</w> of doubt began to grow in his mind after the conversation.",
                            "target_lang_translations": {
                                "ru": "<w>Зёрна</w> сомнения начали прорастать в его уме после этого разговора.",
                                "zh": "谈话之后，怀疑的<w>种子</w>开始在他心里生根。"
                            }
                        },
                        {
                            "text": "Small disagreements can often be the <w>seeds</w> of a much larger conflict.",
                            "target_lang_translations": {
                                "ru": "Маленькие разногласия часто могут стать <w>семенами</w> гораздо большего конфликта.",
                                "zh": "小小的分歧常常会成为更大冲突的<w>种子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "germ"
                    ],
                    "common_phrases": [
                        "seeds of doubt",
                        "seeds of change",
                        "seed of an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начало или источник чего-либо, особенно идеи или чувства.",
                        "zh": "某事物的开端或根源，尤其指想法或感情的起点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "переносное значение: источник, начало"
                            },
                            {
                                "target_lang_word": "семя",
                                "target_lang_sense_clarification": "переносное значение: зародыш чего-либо"
                            },
                            {
                                "target_lang_word": "зародыш",
                                "target_lang_sense_clarification": "начальная стадия развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种子",
                                "target_lang_sense_clarification": "比喻某种想法、感情或问题的开端"
                            },
                            {
                                "target_lang_word": "萌芽",
                                "target_lang_sense_clarification": "强调想法或变化刚开始出现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c73c93fd-020b-3858-ac75-29a0de950bfe",
                    "sense_definition": "A competitor or team ranked in a specific position in a tournament draw.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The top <w>seed</w> was unexpectedly defeated in the first round of the match.",
                            "target_lang_translations": {
                                "ru": "Первый <w>сеяный</w> был неожиданно побежден в первом раунде матча.",
                                "zh": "头号<w>种子选手</w>在比赛第一轮竟然爆冷出局。"
                            }
                        },
                        {
                            "text": "She entered the tournament as a low <w>seed</w> but played incredibly well.",
                            "target_lang_translations": {
                                "ru": "Она вошла в турнир под низким <w>номером посева</w>, но играла невероятно хорошо.",
                                "zh": "她以较低排位的<w>种子选手</w>身份参加比赛，但发挥得非常出色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top seed",
                        "number one seed",
                        "high seed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник или команда, имеющие определенный рейтинг при жеребьевке турнира.",
                        "zh": "在锦标赛抽签中按排名被安排到特定位置的选手或队伍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеяный игрок",
                                "target_lang_sense_clarification": "спорт: участник с высоким рейтингом"
                            },
                            {
                                "target_lang_word": "сеяный",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种子选手",
                                "target_lang_sense_clarification": "体育比赛中按排名被安排种子位的选手"
                            },
                            {
                                "target_lang_word": "种子队",
                                "target_lang_sense_clarification": "用于团队项目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a6edc9e-5459-3e7f-8b60-82b69858d733",
                    "sense_definition": "A number or value used to initialize a pseudorandom number generator.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game uses a specific <w>seed</w> to generate the terrain map.",
                            "target_lang_translations": {
                                "ru": "Игра использует специальное <w>начальное значение</w> для генерации карты местности.",
                                "zh": "这款游戏使用特定的<w>种子</w>来生成地形图。"
                            }
                        },
                        {
                            "text": "If you use the same <w>seed</w>, the program will produce the exact same sequence of numbers.",
                            "target_lang_translations": {
                                "ru": "Если вы используете то же самое <w>начальное число</w>, программа выдаст точно такую же последовательность чисел.",
                                "zh": "如果使用相同的<w>种子</w>，程序就会生成完全一样的数字序列。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "random seed",
                        "seed value"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Число или значение, используемое для инициализации генератора псевдослучайных чисел.",
                        "zh": "用于初始化伪随机数生成器的数值或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начальное значение",
                                "target_lang_sense_clarification": "информатика"
                            },
                            {
                                "target_lang_word": "сид",
                                "target_lang_sense_clarification": "сленг программистов и геймеров"
                            },
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "калька с английского"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种子",
                                "target_lang_sense_clarification": "计算机中伪随机数生成器的初始值；最常用"
                            },
                            {
                                "target_lang_word": "种子值",
                                "target_lang_sense_clarification": "强调其数值属性"
                            },
                            {
                                "target_lang_word": "初始种子",
                                "target_lang_sense_clarification": "强调用于初始化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31ab44fb-01b9-3a37-a9a4-f3db8301d097",
                    "sense_definition": "Semen or sperm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, a man's lineage was often referred to as his <w>seed</w>.",
                            "target_lang_translations": {
                                "ru": "В древних текстах род мужчины часто называли его <w>семенем</w>.",
                                "zh": "在古代文本中，男人的血脉常常被称为他的<w>种</w>。"
                            }
                        },
                        {
                            "text": "The biblical passage mentions the spilling of <w>seed</w> on the ground.",
                            "target_lang_translations": {
                                "ru": "В библейском отрывке упоминается излитие <w>семени</w> на землю.",
                                "zh": "那段《圣经》经文提到把<w>精液</w>洒在地上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spill seed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "literary or biblical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Семя или сперма.",
                        "zh": "指精液或精子，多见于古雅、文学或圣经语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семя",
                                "target_lang_sense_clarification": "биологическая жидкость"
                            },
                            {
                                "target_lang_word": "сперма",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种",
                                "target_lang_sense_clarification": "书面或圣经语境中的古雅说法"
                            },
                            {
                                "target_lang_word": "精液",
                                "target_lang_sense_clarification": "现代医学或通用说法"
                            },
                            {
                                "target_lang_word": "精子",
                                "target_lang_sense_clarification": "强调生殖细胞时可用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94953377-fb94-3416-acad-a1e6506cfe5b",
                    "sense_definition": "Offspring or descendants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prophecy promised that his <w>seed</w> would inherit the land forever.",
                            "target_lang_translations": {
                                "ru": "Пророчество обещало, что его <w>семя</w> унаследует землю навеки.",
                                "zh": "预言承诺他的<w>后裔</w>将永远继承这片土地。"
                            }
                        },
                        {
                            "text": "They were considered the royal <w>seed</w> of a long-forgotten dynasty.",
                            "target_lang_translations": {
                                "ru": "Они считались королевским <w>семенем</w> давно забытой династии.",
                                "zh": "他们被认为是一个早已被遗忘的王朝的皇室<w>后裔</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spawn"
                    ],
                    "common_phrases": [
                        "seed of Abraham"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "literary or biblical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потомство или потомки.",
                        "zh": "后代或子孙，多见于古雅、文学或圣经语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семя",
                                "target_lang_sense_clarification": "устаревшее, библейское"
                            },
                            {
                                "target_lang_word": "потомство",
                                "target_lang_sense_clarification": "современный синоним"
                            },
                            {
                                "target_lang_word": "род",
                                "target_lang_sense_clarification": "поколение, династия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后裔",
                                "target_lang_sense_clarification": "较正式、常用"
                            },
                            {
                                "target_lang_word": "后代",
                                "target_lang_sense_clarification": "常见通俗说法"
                            },
                            {
                                "target_lang_word": "子孙",
                                "target_lang_sense_clarification": "强调家族血脉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b92ea81-db14-3d68-83b4-68e1df2bdb9f",
                    "sense_definition": "To plant seeds in the ground.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>seed</w> the lawn before the rainy season starts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>засеять</w> газон до начала сезона дождей.",
                                "zh": "我们得在雨季开始前给草坪<w>播种</w>。"
                            }
                        },
                        {
                            "text": "The gardener decided to <w>seed</w> the flower bed with wildflowers.",
                            "target_lang_translations": {
                                "ru": "Садовник решил <w>засеять</w> клумбу полевыми цветами.",
                                "zh": "园丁决定在花坛里<w>播种</w>野花。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "seed the lawn",
                        "seed the field",
                        "seed the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сажать семена в землю.",
                        "zh": "把种子播撒到土里。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засевать",
                                "target_lang_sense_clarification": "покрывать посевами (поле, газон)"
                            },
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "разбрасывать или помещать семена в почву"
                            },
                            {
                                "target_lang_word": "сажать",
                                "target_lang_sense_clarification": "общий термин для посадки растений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "播种",
                                "target_lang_sense_clarification": "把种子播到地里；最自然常用"
                            },
                            {
                                "target_lang_word": "撒种",
                                "target_lang_sense_clarification": "较书面，也可指大面积播撒种子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49ca8985-82a5-36f5-b802-a0db6d05ffe7",
                    "sense_definition": "To produce or drop seeds (of a plant).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you let the lettuce <w>seed</w>, it will become bitter and inedible.",
                            "target_lang_translations": {
                                "ru": "Если вы позволите салату <w>дать семена</w>, он станет горьким и несъедобным.",
                                "zh": "如果让生菜<w>结籽</w>，它就会变苦，没法吃了。"
                            }
                        },
                        {
                            "text": "The flowers will <w>seed</w> themselves if you leave them alone until autumn.",
                            "target_lang_translations": {
                                "ru": "Цветы <w>посеются сами</w>, если вы оставите их в покое до осени.",
                                "zh": "如果你一直不管这些花到秋天，它们会自己<w>结籽</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go to seed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить или сбрасывать семена (о растении).",
                        "zh": "指植物产生种子或把种子散落出来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать семена",
                                "target_lang_sense_clarification": "образовывать семена"
                            },
                            {
                                "target_lang_word": "осеменяться",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结籽",
                                "target_lang_sense_clarification": "指植物长出种子"
                            },
                            {
                                "target_lang_word": "结种子",
                                "target_lang_sense_clarification": "较直白的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21094334-17c2-30b7-9871-fdf8e848b8ef",
                    "sense_definition": "To arrange the draw of a tournament by ranking competitors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organizers will <w>seed</w> the top players to keep them apart in the early rounds.",
                            "target_lang_translations": {
                                "ru": "Организаторы <w>распределят</w> лучших игроков, чтобы развести их в ранних раундах.",
                                "zh": "主办方会把顶尖选手<w>列为种子选手</w>，以免他们在前几轮就相遇。"
                            }
                        },
                        {
                            "text": "He was <w>seeded</w> fourth in the national championship.",
                            "target_lang_translations": {
                                "ru": "Он был <w>посеян</w> четвёртым на национальном чемпионате.",
                                "zh": "他在全国锦标赛中被<w>列为4号种子</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "seeded player",
                        "highly seeded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать жеребьевку турнира, распределяя участников по рейтингу.",
                        "zh": "按选手排名安排锦标赛抽签，把他们设为种子选手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "спорт: распределять игроков в сетке"
                            },
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "列为种子选手",
                                "target_lang_sense_clarification": "按排名安排为种子选手"
                            },
                            {
                                "target_lang_word": "列为……号种子",
                                "target_lang_sense_clarification": "用于具体编号，如1号、4号种子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60bfdec0-978d-3617-8fd7-9b1aa199c278",
                    "sense_definition": "To keep a file available for others to download on a peer-to-peer network.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is polite to <w>seed</w> the torrent for a while after you finish downloading it.",
                            "target_lang_translations": {
                                "ru": "Вежливо <w>раздавать</w> торрент некоторое время после завершения загрузки.",
                                "zh": "下载完这个种子文件后继续<w>做种</w>一段时间，是一种礼貌。"
                            }
                        },
