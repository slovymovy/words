                ],
                "senses": [
                    {
                        "sense_id": "a2082afe-b6ff-3dec-9d82-07d2f11dd200",
                        "entry_id": "7581fcdc-ddbb-3086-a8ca-0ae669788257",
                        "glosses": [
                            "Donner un caractère empathique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563a2d9d-18c7-4893-8050-f3b26482ba24",
                                "sense_id": "a2082afe-b6ff-3dec-9d82-07d2f11dd200",
                                "text": "Empathiser une action c’est essayer d’intégrer toutes les dimensions et implications de cette action: ses origines, sa composante émotionnelle, et plus important encore – ses conséquences."
                            }
                        ]
                    },
                    {
                        "sense_id": "229ec50f-fde4-39d0-9141-d84003f3937c",
                        "entry_id": "7581fcdc-ddbb-3086-a8ca-0ae669788257",
                        "glosses": [
                            "Se montrer empathique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1c67d2-1b2b-4a6a-8751-68a321920245",
                                "sense_id": "229ec50f-fde4-39d0-9141-d84003f3937c",
                                "text": "Empathiser implique l'attribution d'états mentaux à autrui ainsi qu'une réponse affective appropriée aux états émotionnels de nos semblables."
                            },
                            {
                                "example_id": "36dde829-db7c-484a-875f-eb4f1567785e",
                                "sense_id": "229ec50f-fde4-39d0-9141-d84003f3937c",
                                "text": "Par exemple, qui peut affirmer avoir la capacité de penser, d'empathiser autant dans la peau d'un homme que dans celle d'une femme."
                            }
                        ]
                    }
                ],
