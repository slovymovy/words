{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cecc6878-8044-3319-b406-9e2134168d9b",
                    "sense_definition": "Clothing or a particular style of dress, especially of a distinctive or official kind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors performed on stage dressed in traditional <w>garb</w> from the eighteenth century.",
                            "target_lang_translations": {
                                "nl": "De acteurs traden op het podium op, gekleed in traditionele <w>kledij</w> uit de achttiende eeuw."
                            }
                        },
                        {
                            "text": "He chose to wear simple clerical <w>garb</w> rather than ornate robes for the service.",
                            "target_lang_translations": {
                                "nl": "Hij koos ervoor om een eenvoudig klerikaal <w>gewaad</w> te dragen in plaats van rijk versierde mantels voor de dienst."
                            }
                        }
                    ],
                    "synonyms": [
                        "habit"
                    ],
                    "common_phrases": [
                        "traditional garb",
                        "clerical garb"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kleding of een specifieke stijl van kleden, vooral kenmerkend, ceremonieel of officieel van aard."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gewaad",
                                "target_lang_sense_clarification": "statige, traditionele of ceremoniële kleding"
                            },
                            {
                                "target_lang_word": "dracht",
                                "target_lang_sense_clarification": "kenmerkende of traditionele kledingstijl"
                            },
                            {
                                "target_lang_word": "kledij",
                                "target_lang_sense_clarification": "kleding, vaak formeel of specifiek"
                            },
                            {
                                "target_lang_word": "dos",
                                "target_lang_sense_clarification": "feestelijke of opvallende kleding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c5fdb3e-2dd1-3a2d-82f7-b4e9de42de0d",
                    "sense_definition": "An outward appearance, guise, or form of presentation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dangerous proposal was presented in the <w>garb</w> of economic reform.",
                            "target_lang_translations": {
                                "nl": "Het gevaarlijke voorstel werd gepresenteerd in de <w>gedaante</w> van economische hervorming."
                            }
                        },
                        {
                            "text": "Selfish motives often conceal themselves under the <w>garb</w> of charity.",
                            "target_lang_translations": {
                                "nl": "Zelfzuchtige motieven gaan vaak schuil onder de <w>mantel</w> van liefdadigheid."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the garb of",
                        "under the garb of"
                    ],
                    "target_lang_definitions": {
                        "nl": "Uiterlijke verschijning, gedaante of mantel waarin iets zich voordoet."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gedaante",
                                "target_lang_sense_clarification": "uiterlijke vorm of verschijning"
                            },
                            {
                                "target_lang_word": "mantel",
                                "target_lang_sense_clarification": "dekmantel of schijn"
                            },
                            {
                                "target_lang_word": "jasje",
                                "target_lang_sense_clarification": "uiterlijke vorm waarin iets gegoten is"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c01586cc-a28e-3cc5-bc30-ba32923ab46c",
                    "sense_definition": "A fashion, manner, or personal style of dressing oneself.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His peculiar <w>garb</w> always drew curious glances from passersby in the street.",
                            "target_lang_translations": {
                                "nl": "Zijn eigenaardige <w>uitdossing</w> trok altijd nieuwsgierige blikken van voorbijgangers op straat."
                            }
                        },
                        {
                            "text": "She preferred an artistic <w>garb</w> that reflected her unconventional lifestyle.",
                            "target_lang_translations": {
                                "nl": "Ze gaf de voorkeur aan een artistieke <w>kledingstijl</w> die haar onconventionele levenswijze weerspiegelde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in reference to personal fashion style"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een persoonlijke wijze, manier of stijl van kleden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kledingstijl",
                                "target_lang_sense_clarification": "manier van kleden"
                            },
                            {
                                "target_lang_word": "dos",
                                "target_lang_sense_clarification": "manier van uitgedost zijn"
                            },
                            {
                                "target_lang_word": "uitdossing",
                                "target_lang_sense_clarification": "opvallende manier van kleden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d59aa44-7e24-397b-a9f1-87f7fe4498f3",
                    "sense_definition": "A sheaf of grain, especially wheat, often used in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_heraldic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family coat of arms featured a golden <w>garb</w> on an azure background.",
                            "target_lang_translations": {
                                "nl": "Het familiewapen vertoonde een gouden <w>korenschoof</w> op een azuurblauwe achtergrond."
                            }
                        },
                        {
                            "text": "Three <w>garbs</w> were emblazoned upon the ancient shield hanging in the hall.",
                            "target_lang_translations": {
                                "nl": "Drie <w>korenschoven</w> prijkten op het oude schild dat in de hal hing."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Primarily used in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een korenschoof, vooral van tarwe, gebruikt in de heraldiek."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "korenschoof",
                                "target_lang_sense_clarification": "gebonden bundel graan in de heraldiek"
                            },
                            {
                                "target_lang_word": "schoof",
                                "target_lang_sense_clarification": "heraldisch figuur van graan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f86e68fd-5e30-3c22-b0fb-76500d237009",
                    "sense_definition": "A medieval unit of measure for arrows, typically containing twenty-four arrows.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_heraldic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The armory received several <w>garbs</w> of arrows before the archers departed for battle.",
                            "target_lang_translations": {
                                "nl": "De wapenkamer ontving verscheidene <w>bundels pijlen</w> voordat de boogschutters ten strijde trokken."
                            }
                        },
                        {
                            "text": "Each archer was supplied with a bow and an entire <w>garb</w> of steel-tipped arrows.",
                            "target_lang_translations": {
                                "nl": "Elke boogschutter werd voorzien van een boog en een volledige <w>bundel</w> pijlen met stalen punten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Medieval unit of measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een middeleeuwse maateenheid voor pijlen, doorgaans bestaande uit vierentwintig pijlen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bundel pijlen",
                                "target_lang_sense_clarification": "middeleeuwse eenheid van 24 pijlen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0df2114b-f9c3-3e19-8870-648099620e59",
                    "sense_definition": "To dress or clothe someone in a particular kind of attire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards were <w>garbed</w> in heavy steel armor from head to foot.",
                            "target_lang_translations": {
                                "nl": "De wachters waren van top tot teen in zwaar stalen harnas <w>gehuld</w>."
                            }
                        },
                        {
                            "text": "Attendants carefully <w>garbed</w> the young prince for his formal coronation ceremony.",
                            "target_lang_translations": {
                                "nl": "Bedienden <w>kleedden</w> de jonge prins zorgvuldig voor zijn officiële kroningsceremonie."
                            }
                        }
                    ],
                    "synonyms": [
                        "habit",
                        "habilitate"
                    ],
                    "common_phrases": [
                        "garbed in"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand kleden of uitdossen in een specifieke stijl of outfit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kleden",
                                "target_lang_sense_clarification": "van kleding voorzien"
                            },
                            {
                                "target_lang_word": "uitdossen",
                                "target_lang_sense_clarification": "opvallend of feestelijk kleden"
                            },
                            {
                                "target_lang_word": "hullen",
                                "target_lang_sense_clarification": "kleden of omhullen met een gewaad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}