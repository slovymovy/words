                "senses": [
                    {
                        "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                        "entry_id": "3633ed9f-1c57-3790-bcb6-e10d0e49f031",
                        "glosses": [
                            "That cannot be resisted; irresistible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e3d998-a9c3-4c7d-ac91-bfd10c3eb8d6",
                                "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                                "text": "His name was Talus, made of yron mould, / Immoveable, resistlesse, without end […]"
                            },
                            {
                                "example_id": "190bda26-94c4-4e0b-8741-2e35014b2be6",
                                "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                                "text": "Maſters commands come with a power reſiſtleſs / To ſuch as owe them abſolute ſubjection; / And for a life who will not change his purpoſe? / (So mutable are all the ways of men) / Yet this be ſure, in nothing to comply / Scandalous or forbidden in our Law."
                            },
                            {
                                "example_id": "eaf48b9e-fd2a-4f29-80b9-e5f84f74997f",
                                "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                                "text": "Delving earth in his resistless way, / Howling, the Child with fierce flames / Issu'd from Enitharmon."
                            },
                            {
                                "example_id": "b7b08a53-7c05-4788-aa40-3d7ea40b0721",
                                "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                                "text": "My limbs now tremble, and my eyes swim with the remembrance; but then a resistless, and almost frantic, impulse, urged me forward; I seemed to have lost all soul or sensation but for this one pursuit."
                            },
                            {
                                "example_id": "a958aa9c-681d-4f02-8709-7d7392b0753a",
                                "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                                "text": "I seize the descending man .... I raise him with resistless will. / O despairer, here is my neck, / By God! you shall not go down! Hang your whole weight upon me."
                            },
                            {
                                "example_id": "74b30e5c-2762-41f9-91a3-49ade6a5f549",
                                "sense_id": "cd192f4e-1627-304c-a9ca-4070acf4476d",
                                "text": "Is all our Life, then, but a dream / Seen faintly in the golden gleam / Athwart Time's dark resistless stream?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d821d7c0-88e7-3651-924a-ef68af900774",
                        "entry_id": "3633ed9f-1c57-3790-bcb6-e10d0e49f031",
                        "glosses": [
                            "Putting up no resistance; unresisting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5612aeac-af03-4787-9f77-5c9e5cb7ea8b",
                                "sense_id": "d821d7c0-88e7-3651-924a-ef68af900774",
                                "text": "All this time they were doing something—I could not see what—to the corpse; sometimes they were too busy rifling the dead body, I believe, to talk; again they let it fall with a heavy, resistless thud, and took to quarrelling."
                            }
                        ]
                    }
