                    {
                        "sense_id": "f50a8bcf-602c-3c84-be13-d70309293e21",
                        "entry_id": "8c423880-8d94-3dc3-8470-621bd324ad3b",
                        "glosses": [
                            "prepositioneel deel van een voornaamwoordelijk bijwoord: geheel door"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a806057-2d3f-480c-9b05-00ea198b1c78",
                                "sense_id": "f50a8bcf-602c-3c84-be13-d70309293e21",
                                "text": "Hij was er nog niet geheel doorheen, toen het fluitsignaal klonk."
                            },
                            {
                                "example_id": "2296d7f2-100b-44a6-8b0e-987fd3eb80e6",
                                "sense_id": "f50a8bcf-602c-3c84-be13-d70309293e21",
                                "text": "Met waterverf schilderde ik het gelige landschap waar ik de afgelopen dagen doorheen was gekomen."
                            },
                            {
                                "example_id": "3422e6f2-f2d5-4d39-b139-dfff91eae8d7",
                                "sense_id": "f50a8bcf-602c-3c84-be13-d70309293e21",
                                "text": "Terug in de flat trokken we vrolijk de theedoeken van de sandwiches, pakten flesopeners en kurkentrekkers, zetten een plaat op en keken naar het aansnijden van de witte boltaart, waar Cynth een scheut rum doorheen had gedaan."
                            }
                        ]
                    }
                ],
