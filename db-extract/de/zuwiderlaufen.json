                "senses": [
                    {
                        "sense_id": "59f7dd7a-54ad-3b86-b737-c420decfeaa6",
                        "entry_id": "8a190517-f74d-3a8c-a8e4-7e19a35b50f6",
                        "glosses": [
                            "sich so gestalten, so ablaufen, dass etwas etwas anderem widerspricht, im Gegensatz zu diesem steht"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "6776c8e4-4d12-4bc3-87cc-a8df5d393106",
                                "sense_id": "59f7dd7a-54ad-3b86-b737-c420decfeaa6",
                                "text": "„Durfte er sich von Drohung und Furcht verleiden lassen, einen unverbrüchlichen Schwur abzulegen, welcher der von ihm zu Lübeck übernommenen Pflicht zuwiderlief?“"
                            },
                            {
                                "example_id": "3d078985-af9d-49a4-aa54-32a814c0bfe0",
                                "sense_id": "59f7dd7a-54ad-3b86-b737-c420decfeaa6",
                                "text": "„Selten wurde das der zionistischen Forderung zugrunde liegende Problem so deutlich ausgesprochen: Der zionistische Traum lief den Prinzipien der Demokratie zuwider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
