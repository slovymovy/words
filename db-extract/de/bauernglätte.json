                "senses": [
                    {
                        "sense_id": "d9adbe01-d956-34d5-9bb5-9ae87cfe24a8",
                        "entry_id": "a84f53e3-d03e-3770-af33-e1539a113b86",
                        "glosses": [
                            "Glätte auf Fahrbahnen, die durch Verschmutzungen landwirtschaftlicher Maschinen/Fahrzeuge verursacht wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "57dc6989-f0ec-48d3-bb11-f733d542db44",
                                "sense_id": "d9adbe01-d956-34d5-9bb5-9ae87cfe24a8",
                                "text": "„Während [einer] Versammlung wurde sich darauf verständigt, dass die Landwirte Sorge tragen müssen, dass die Straßen anschließend wieder geräumt und gesäubert werden, wenn sie von ihrem Acker kommen. Ansonsten können gefährliche Situationen für nachfolgende Autofahrer entstehen, wie im Oktober 2014, als ein Lkw-Fahrer zwischen Zidderich und Techentin aufgrund von Bauernglätte in einer Rechtskurve von der Straße abkam und gegen einen Baum krachte.“"
                            },
                            {
                                "example_id": "e1dded6f-386e-4c01-ac75-a75ae351078a",
                                "sense_id": "d9adbe01-d956-34d5-9bb5-9ae87cfe24a8",
                                "text": "„Die Polizei in den Kreisen Nordfriesland und Schleswig-Flensburg geht erstmals gezielt gegen die sogenannte Bauernglätte vor, also Straßenverschmutzung durch landwirtschaftliche Fahrzeuge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
