                    {
                        "translation_id": "1d55c836-2ac9-4997-9537-afcb091ac17b",
                        "source_entry_id": "412eeff5-be56-3d47-8fe4-c58c19768ce2",
                        "source_sense_id": "61cbc523-543c-32a4-8049-a120cc7fc480",
