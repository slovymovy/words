    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3036d9cf-2668-3716-8d6b-5af1b0197275",
                    "sense_definition": "Qui prend parti de manière active et résolue pour une cause politique, sociale ou morale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "engagement_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette autrice est célèbre pour sa littérature <w>engagée</w> en faveur des droits humains."
                        },
                        {
                            "text": "Ce musicien reste un artiste très <w>engagé</w> dans la protection de l'environnement."
                        }
                    ],
                    "synonyms": [
                        "militant"
                    ],
                    "antonyms": [
                        "dégagé"
                    ],
                    "common_phrases": [
                        "artiste engagé",
                        "littérature engagée"
                    ]
                },
                {
                    "sense_id": "87541d74-2c7d-36ce-81f6-82ddf56f9c97",
                    "sense_definition": "Qui est lié par une promesse, un contrat ou une obligation préalable et n'est donc pas libre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne peux pas venir dîner ce soir car je suis déjà <w>engagé</w> auprès d'un ami."
                        },
                        {
                            "text": "L'avocate était déjà <w>engagée</w> sur un autre dossier complexe pour toute la semaine."
                        }
                    ],
                    "synonyms": [
                        "occupé",
                        "pris"
                    ]
                },
                {
                    "sense_id": "602bb6ae-cbd8-3a1b-b4ba-b56a2782b666",
                    "sense_definition": "Qui a pénétré, avancé ou qui est inséré dans un lieu, une ouverture ou un passage étroit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture était déjà bien <w>engagée</w> dans l'allée étroite quand un camion est arrivé en face."
                        },
                        {
                            "text": "Le randonneur s'est retrouvé <w>engagé</w> sur un sentier escarpé sans équipement adapté."
                        }
                    ],
                    "synonyms": [
                        "enfoncé",
                        "introduit"
                    ]
                },
                {
                    "sense_id": "8b05ce96-7753-3c54-aebe-c6b693f606ff",
                    "sense_definition": "Qui est déposé comme gage ou garantie en échange d'un prêt d'argent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa montre en or était <w>engagée</w> au mont-de-piété depuis plusieurs mois."
                        },
                        {
                            "text": "Ils ont pu récupérer les bijoux de famille qui étaient <w>engagés</w> pour payer leurs dettes."
                        }
                    ],
                    "synonyms": [
                        "hypothéqué",
                        "gagé"
                    ]
                },
                {
                    "sense_id": "2475f659-83e2-338e-aa3f-4998f0edefae",
                    "sense_definition": "Occupé et inaccessible, en parlant d'une ligne téléphonique ou d'une communication.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tonalité répétitive indiquait clairement que le numéro composé était <w>engagé</w>."
                        },
                        {
                            "text": "Le standardiste m'a prévenu que toutes les lignes restaient <w>engagées</w> jusqu'à midi."
                        }
                    ],
                    "synonyms": [
                        "occupé"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "En parlant d'une ligne de téléphone"
                        }
                    ]
                }
            ]
        },
        {
