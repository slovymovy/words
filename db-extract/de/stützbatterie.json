                "senses": [
                    {
                        "sense_id": "30d5db04-4889-3df9-96ae-23dc9cc32641",
                        "entry_id": "bb83c931-822e-367e-bc1f-3072326fe1b0",
                        "glosses": [
                            "Batterie zur Überbrückung von Stromausfällen zum Beispiel von Solarzellen bei Taschenrechnern oder bei Trennung vom Netz bei Weckradios"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b053aa2b-049f-44b4-acfc-1b7218a30993",
                                "sense_id": "30d5db04-4889-3df9-96ae-23dc9cc32641",
                                "text": "„Optische Multiturn-Drehgeber verwenden zur Erfassung der Umdrehungen entweder mehrere Codescheiben, die intern über ein Getriebe verbunden sind, oder elektronische Zähler mit Stützbatterie.“"
                            },
                            {
                                "example_id": "7d3d1e5c-71c2-4485-a448-480fdeb9c675",
                                "sense_id": "30d5db04-4889-3df9-96ae-23dc9cc32641",
                                "text": "„Mit einer Kapazität von 78 Ah ersetzt der Lithium-Ionen-Akku sowohl die Starterbatterie als auch die Stützbatterie.“"
                            },
                            {
                                "example_id": "11eaae3c-ac93-4a64-b906-a1879d736560",
                                "sense_id": "30d5db04-4889-3df9-96ae-23dc9cc32641",
                                "text": "„Übrigens hatte beim Tesla die Antriebsbatterie gar nicht gebrannt, sondern nur eine Stützbatterie. Ergo viel Rauch um nichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
