        "nl-extract.jsonl": [
            {
                "entry_id": "945ba70a-36a8-3bc8-8757-9dd92493a73d",
                "word": "aliënatie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "5aac549f-5229-47e7-b7b5-7126dce7aa6e",
                        "entry_id": "945ba70a-36a8-3bc8-8757-9dd92493a73d",
                        "tags": [
                            "plural"
                        ],
                        "form": "aliënaties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1e3ed0c-1601-38a2-92a6-47f80f75dc57",
                        "entry_id": "945ba70a-36a8-3bc8-8757-9dd92493a73d",
                        "glosses": [
                            "gevoel dat iets niet langer eigen, vertrouwd en begrijpelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e6ea81-f97a-41b1-a236-49a70b0226aa",
                                "sense_id": "f1e3ed0c-1601-38a2-92a6-47f80f75dc57",
                                "text": "De vervreemding van het culturele-zelf die deel uitmaakte van het kolonialistische systeem heeft ook bijna altijd geresulteerd in een diepe linguïstische aliënatie."
                            }
                        ]
                    },
                    {
                        "sense_id": "69f01303-4467-3f50-b499-68dddd75a65a",
                        "entry_id": "945ba70a-36a8-3bc8-8757-9dd92493a73d",
                        "glosses": [
                            "overdracht van het eigendom van een goed aan iemand anders, bijv. door verkoop, ruil of schenking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2344f8-49d6-4cf0-9a8d-eca7becabcae",
                                "sense_id": "69f01303-4467-3f50-b499-68dddd75a65a",
                                "text": "Eigendomsrechten zijn een bundel rechten en verantwoordelijkheden die legaal afdwingbaar zijn. Deze rechten omvatten (1) toegang, (2) gebruik, (3) beheer, (4) uitsluiting, en (5) aliënatie (het recht tot verkopen)."
                            }
                        ]
                    },
                    {
                        "sense_id": "be34fa4e-282c-3acf-9034-fb41a8c03954",
                        "entry_id": "945ba70a-36a8-3bc8-8757-9dd92493a73d",
                        "glosses": [
                            "sociale ontwrichting als gevolg van arbeidsdeling"
                        ],
                        "tags": [
                            "marxisme"
                        ],
                        "examples": [
                            {
                                "example_id": "573fd8c2-a276-4666-bc9b-f73e7577d762",
                                "sense_id": "be34fa4e-282c-3acf-9034-fb41a8c03954",
                                "text": "Het interessante daarbij is dat Lermontov zich niet heeft laten sturen door een meer of minder gesofisticeerde vervreemdingsfilosofie: noch het Unbehagen an der Kultur, noch enig marxistisch georiënteerd alienatie-begrip zou bij hem ook maar een voet aan de grond hebben gekregen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6797de24-fc80-47b0-aa3e-a60b89b39338",
                        "source_entry_id": "945ba70a-36a8-3bc8-8757-9dd92493a73d",
                        "source_sense_id": "f1e3ed0c-1601-38a2-92a6-47f80f75dc57",
                        "source_sense_description": "vervreemding",
                        "target_lang_word": "alienation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alienation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The act of alienating."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4960f9-190b-4d99-b472-aa4b4638d569",
                                                "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                                "text": "The alienation of that viewing demographic is a poor business decision."
                                            },
                                            {
                                                "example_id": "4b075774-8e26-492d-a2b3-cce2984e8b5b",
                                                "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                                "text": "That the mode of alienating their lands, the main source of discontent and war, should be so defined and regulated as to obviate imposition and as far as may be practicable controversy concerning the reality and extent of the alienations which are made."
                                            },
                                            {
                                                "example_id": "b292fa99-d7f1-4da2-8956-36decc90a859",
                                                "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                                "text": "Wearing an Audie Murphy black jacket, playing a Chuck Berry guitar, and performing his electrified alienation with passionate indifference, Dylan assassinated the audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c483514-838c-3349-a3e2-4249d121bebe",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The state of being alienated."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871c26ff-5f1c-4d2c-8c04-7f555b1c0187",
                                                "sense_id": "9c483514-838c-3349-a3e2-4249d121bebe",
                                                "text": "I refer to the state of our divisions and alienations of spirit on account of religion."
                                            },
                                            {
                                                "example_id": "46b76b19-80e6-46b6-b8c4-b10dd5ab0d43",
                                                "sense_id": "9c483514-838c-3349-a3e2-4249d121bebe",
                                                "text": "As Hegel showed, time is the necessary alienation, the terrain where the subject realizes himself by losing himself, becomes other in order to become truly himself. In total contrast, the current form of alienation is imposed on the producers of an estranged present. In this spatial alienation, the society that radically separates the subject from the activity it steals from him is in reality separating him from his own time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c55c35-e007-3fd2-8235-121f21f2fde4",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "Emotional isolation or dissociation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557c557c-101e-4c25-b85b-145cda72d4ae",
                                                "sense_id": "85c55c35-e007-3fd2-8235-121f21f2fde4",
                                                "text": "But these domestic alienations are not confined to those who once moved in the higher orders of society--the monthly registers announce almost as many divorces as marriages, and the facility of separation has rendered the one little more than a licentious compact, which the other is considered as a means of dissolving."
                                            },
                                            {
                                                "example_id": "d2179f44-bf3c-4f53-83d2-3e5f70b2bb4d",
                                                "sense_id": "85c55c35-e007-3fd2-8235-121f21f2fde4",
                                                "text": "To watch it even once is to be distracted, but in an evocative and resonant manner--to be drawn away from Benning's travels and alienations and reminded of one's own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90a34032-174b-337b-bb6d-1c27ae5df81e",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "Verfremdungseffekt."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "084b6fa8-6545-3256-bc2d-6fd2cd10fa54",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The transfer of property to another person."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c312efc-7503-497a-8702-f8a632a6a97f",
                                                "sense_id": "084b6fa8-6545-3256-bc2d-6fd2cd10fa54",
                                                "text": "The most usual and universal method of acquiring a title to real estates is that of alienation, conveyance, or purchase in it's limited sense: under which may be comprized any method wherein estates are voluntarily resigned by one man, and accepted by another; whether that be effected by sale, gift, marriage settlement, devise, or other transmission of property by the mutual consent of the parties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8753197a-d62d-3909-8507-78224bada9cb",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The estrangement of people from aspects of their human nature as a consequence of the division of labour and living in a society of stratified social classes."
                                        ],
                                        "tags": [
                                            "Marxism",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
