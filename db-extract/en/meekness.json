                        "examples": [
                            {
                                "example_id": "4a4d4688-f867-4921-94eb-a8af47c3197e",
                                "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                "text": "But thou, O man of God, flie these things; and follow after righteousnesse, godlinesse, faith, loue, patience, meekenesse."
                            },
                            {
                                "example_id": "f9bab15d-9529-488c-a3b9-4f0bcb64c54a",
                                "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                "text": "Nor could Pym fail to notice that his old friend in rendering account of himself assumed the familiar meekness of the displaced person in the presence of his betters."
                            }
                        ]
                    }
                ],
