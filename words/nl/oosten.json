                {
                    "sense_id": "45565c04-9bd1-3d68-9192-39dc9b206160",
                    "sense_definition": "De landen en culturen in Azië en het oostelijke deel van de wereld, gezien vanuit Europa.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "region",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Veel specerijen werden vroeger uit het <w>Oosten</w> gehaald.",
                            "target_lang_translations": {
                                "en": "Many spices were formerly brought from the <w>East</w>.",
                                "ru": "Раньше многие специи привозили с <w>Востока</w>.",
                                "pl": "Dawniej wiele przypraw sprowadzano ze <w>Wschodu</w>.",
                                "de": "Viele Gewürze wurden früher aus dem <w>Osten</w> importiert.",
                                "fr": "Autrefois, de nombreuses épices étaient importées d'<w>Orient</w>.",
                                "it": "In passato molte spezie venivano importate dall'<w>Oriente</w>.",
                                "cs": "Mnoho koření se dříve dováželo z <w>Východu</w>.",
                                "tr": "Eskiden pek çok baharat <w>Doğu'dan</w> getirilirdi.",
                                "es": "Antiguamente se traían muchas especias de <w>Oriente</w>."
                            }
                        },
                        {
                            "text": "De cultuur in het <w>Oosten</w> verschilt van die in het Westen.",
                            "target_lang_translations": {
                                "en": "The culture in the <w>East</w> differs from that in the West.",
                                "ru": "Культура <w>Востока</w> отличается от культуры Запада.",
                                "pl": "Kultura na <w>Wschodzie</w> różni się od tej na Zachodzie.",
                                "de": "Die Kultur im <w>Osten</w> unterscheidet sich von der im Westen.",
                                "fr": "La culture en <w>Orient</w> diffère de celle de l'Occident.",
                                "it": "La cultura in <w>Oriente</w> differisce da quella dell'Occidente.",
                                "cs": "Kultura na <w>Východě</w> se liší od té na Západě.",
                                "tr": "<w>Doğu'daki</w> kültür Batı'dakinden farklıdır.",
                                "es": "La cultura en <w>Oriente</w> difiere de la de Occidente."
                            }
                        }
                    ],
                    "synonyms": [
                        "Oriënt"
                    ],
                    "antonyms": [
