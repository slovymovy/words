                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He described his dating life as pretty <w>vanilla</w> compared to his friends.",
                            "target_lang_translations": {
                                "ru": "Он описал свою личную жизнь как довольно <w>традиционную</w> по сравнению с друзьями.",
                                "zh": "他说和朋友们相比，他的约会生活相当<w>传统</w>。"
                            }
                        },
                        {
                            "text": "They have a happy but strictly <w>vanilla</w> relationship.",
                            "target_lang_translations": {
                                "ru": "У них счастливые, но строго <w>традиционные</w> отношения.",
                                "zh": "他们的关系很幸福，但属于严格的<w>传统</w>型。"
                            }
