                    },
                    {
                        "translation_id": "78d009ad-42b3-491e-ac86-0685053c2f92",
                        "source_entry_id": "6b8e7648-6f92-352e-8bf3-818041ffa217",
                        "source_sense_id": "2141cbfd-eaf4-3dfd-9c46-845b67d691ea",
