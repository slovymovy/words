                "translations": [
                    {
                        "translation_id": "7145282f-e958-499d-912a-572d6d5561d0",
                        "source_entry_id": "da5c8dae-95bb-390f-8aef-e94f541f5497",
                        "source_sense_id": "8a838614-ee76-309b-83ec-e4de0aacdfd9",
                        "target_lang_word": "memorable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "memorable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                        "entry_id": "462f375a-88d3-30db-803d-0175a6f22bdd",
                                        "glosses": [
                                            "Worthy to be remembered; very important or remarkable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cba3d3-b495-43b6-b1fe-d97d928cc30a",
                                                "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                                "text": "a memorable holiday"
                                            },
                                            {
                                                "example_id": "870d81a6-a7b1-4758-b239-0671fa4dd8ad",
                                                "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                                "text": "Men have surviving Fame to gain,\nBy Tombs, by Books, by memorable Deeds"
                                            },
                                            {
                                                "example_id": "7ffc9542-54f0-45fa-958f-3dfdd4c83cfb",
                                                "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                                "text": "But Mr. Hunt hated the character immediately -- Elmo wasn't edgy enough -- and, on one memorable morning, brought him into the Muppeteers' lounge \"hanging by the rods,\" the chopsticklike bars that control his paws."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "memorable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d3eb92f-b51b-3210-b52a-aaf900ae5496",
                                        "entry_id": "268668cd-8522-3853-b5a0-be1901252770",
                                        "glosses": [
                                            "Something interesting enough to be remembered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe2b08e-250d-47c6-a502-eda57d8f42b4",
                                                "sense_id": "0d3eb92f-b51b-3210-b52a-aaf900ae5496",
                                                "text": "These were all the memorables of our visit to Dumbarton Castle, which is a most interesting spot, and connected with a long series of historical events."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feeca93b-2038-4dab-bad1-5de8d1f3bb22",
                        "source_entry_id": "da5c8dae-95bb-390f-8aef-e94f541f5497",
                        "source_sense_id": "8a838614-ee76-309b-83ec-e4de0aacdfd9",
                        "target_lang_word": "mémorable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mémorable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                        "entry_id": "70d09948-6efa-3caa-8b50-37301bbdc7fa",
                                        "glosses": [
                                            "Qui est digne de mémoire, qui mérite d’être conservé dans la mémoire, qui est remarquable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb10bbca-992c-445e-9967-a16ebc9554a2",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "Action, chose, journée, fait, événement mémorable."
                                            },
                                            {
                                                "example_id": "b48d0327-6627-473e-90d2-466784c6a104",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "Combat, siège mémorable."
                                            },
                                            {
                                                "example_id": "c31afedf-879e-4c62-8be0-32ef08908c05",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "Il n’a rien fait de mémorable."
                                            },
                                            {
                                                "example_id": "e28d37cb-4fc5-47d7-b1ff-8a4d6f79bc89",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "Les actes, les faits mémorables."
                                            },
                                            {
                                                "example_id": "bf0e3252-f526-4fb4-b6be-b2e6fe1be33c",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "Paroles mémorables."
                                            },
                                            {
                                                "example_id": "4ebb0979-e4d4-4556-8799-ad46044b1425",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "D’après mes propres conjectures sur le texte de l’anonyme, auteur du Bellum Hispaniense, et quelques renseignements recueillis dans l’excellente bibliothèque du duc d’Ossuna, je pensais qu’il fallait chercher aux environs de Montilla le lieu mémorable où, pour la dernière fois, César joua quitte ou double contre les champions de la république."
                                            },
                                            {
                                                "example_id": "2ed099c4-3e6c-453c-aa90-3a32badbb692",
                                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                                "text": "Comment transformer ce geste en une expérience mémorable pour vous et votre partenaire ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
