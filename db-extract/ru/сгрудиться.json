                ],
                "senses": [
                    {
                        "sense_id": "21616ce0-c52f-3a6f-bcf1-7a3b4ab98f68",
                        "entry_id": "87b23043-af5b-39e3-ab3b-73860c37b521",
                        "glosses": [
                            "прост. собраться в кучу, образовать толпу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcba59e9-e8a1-43a5-bcb8-3c1250b55a0b",
                                "sense_id": "21616ce0-c52f-3a6f-bcf1-7a3b4ab98f68",
                                "text": "Выходящие сгрудились у дверей."
                            },
                            {
                                "example_id": "de08f42a-2e2a-4281-bdb1-347035cd2a62",
                                "sense_id": "21616ce0-c52f-3a6f-bcf1-7a3b4ab98f68",
                                "text": "Офицеры сгрудились толпою, мяли, тискали Крыкова, хлопали его по широким плечам; он улыбался растерянно… Но вдруг, сбившись с ноги, они стали наступать друг другу на пятки и мгновенно сгрудились в толпу."
                            },
                            {
                                "example_id": "58742add-ddd6-4407-aaa5-95558c27fbfd",
                                "sense_id": "21616ce0-c52f-3a6f-bcf1-7a3b4ab98f68",
                                "text": "Возле башни сгрудились извозчики, не могли разъехаться и, выбиваясь из сил, ругались матерью."
                            }
                        ]
                    }
                ],
