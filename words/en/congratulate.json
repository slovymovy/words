{
    "word_family": [
        "congratulation",
        "congratulatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60b33dd6-2388-3002-b975-fe746c7a4a2e",
                    "sense_definition": "To express pleasure or praise to someone for their success or good fortune.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "celebrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to <w>congratulate</w> you on your promotion.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>поздравить</w> вас с повышением."
                            }
                        },
                        {
                            "text": "Please <w>congratulate</w> Dave and Lisa on their wedding when you see them.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поздравь</w> Дейва и Лизу со свадьбой, когда увидишь их."
                            }
                        }
                    ],
                    "synonyms": [
                        "felicitate",
                        "praise"
                    ],
                    "antonyms": [
                        "criticize"
                    ],
                    "common_phrases": [
                        "congratulate someone on",
                        "congratulate the winner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать радость или похвалу кому-либо в связи с его успехом или удачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поздравлять",
                                "target_lang_sense_clarification": "выражать радость по поводу успеха"
                            },
                            {
                                "target_lang_word": "поздравить",
                                "target_lang_sense_clarification": "совершить действие поздравления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "204adf1a-93a6-375c-b049-07bbcc385354",
                    "sense_definition": "To feel pleased or proud of oneself for an achievement or for being lucky.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>congratulated</w> myself on finishing the marathon in under four hours.",
                            "target_lang_translations": {
                                "ru": "Я <w>поздравил себя</w> с тем, что пробежал марафон менее чем за четыре часа."
                            }
                        },
                        {
                            "text": "You should <w>congratulate</w> yourself for making such a difficult decision.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>похвалить себя</w> за принятие такого трудного решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "pride oneself"
                    ],
                    "common_phrases": [
                        "congratulate yourself on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать удовлетворение или гордость за себя в связи с достижением или удачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поздравлять себя",
                                "target_lang_sense_clarification": "гордиться своим достижением"
                            },
                            {
                                "target_lang_word": "мысленно похвалить себя",
                                "target_lang_sense_clarification": "чувствовать внутреннее удовлетворение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}