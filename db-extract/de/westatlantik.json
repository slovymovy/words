                "senses": [
                    {
                        "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                        "entry_id": "75e40ab1-e923-3855-b6b1-a94311cb5578",
                        "glosses": [
                            "der auf der westlichen Erdhalbkugel liegende Teil des Atlantiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b162857c-fcb3-4fe7-ac58-bb7a6ddf256f",
                                "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                                "text": "„Im Westatlantik, von Neuengland bis Brasilien, kommt die Art Turritopsis dohrni vor, die früher Turritopsis nutricula genannt wurde.“"
                            },
                            {
                                "example_id": "8616a8b4-efdd-46ca-8346-549b8ddb42c5",
                                "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                                "text": "„Denn ein toter Hund wird gemeinsam mit Perlmutt aufgefunden, einem Material, das erst nach der Entdeckung Amerikas aus dem Westatlantik in Europa auftaucht, womit die Indizien zum eigentlichen Fall der Spionage führen.“"
                            },
                            {
                                "example_id": "06bd3e99-6996-496e-b03f-9264c6c19699",
                                "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                                "text": "„Der 62 m hohe Leuchtturm selbst wurde 1846 errichtet und dient der Berufsschifffahrt als Orientierungspunkt zwischen Westatlantik und Mittelmeerzufahrt.“"
                            },
                            {
                                "example_id": "103b97da-672d-44b9-87f5-033b94536a17",
                                "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                                "text": "„Portugal hingegen hatte ja bereits eine funktionierende Route, auch besaß es schon nautische Aufzeichnungen vom südlichen Westatlantik.“"
                            },
                            {
                                "example_id": "09d06d34-24e9-4781-98ba-b15dd7beea50",
                                "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                                "text": "„Dann wehte bis gut nach Mittag ein heiterer, böiger Frühjahrswind, leicht und sehr beweglich, der direkt aus dem äquatornahen Westatlantik hierherkommt.“"
                            },
                            {
                                "example_id": "c292eb5c-d82d-4742-890f-96792ae4a4cb",
                                "sense_id": "3ff69fd2-77ab-3c95-bda5-00f613a2ab29",
                                "text": "„Man trifft sie im nördlichen Westatlantik bei Neufundland und Grönland genauso an wie bei Island, Norwegen, in der westlichen Ostsee, im Ärmelkanal und in der Bretagne als dem südlichsten Gebiet ihres Vorkommens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
