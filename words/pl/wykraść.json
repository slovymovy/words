{
    "word_family": [
        "kradzież",
        "złodziej",
        "kradziony"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95db2201-db75-3c6b-8fe2-b34aa2766f9e",
                    "sense_definition": "potajemnie zabrać komuś cudzą własność",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kradzież",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej <w>wykradł</w> cenne dokumenty z sejfu w środku nocy.",
                            "target_lang_translations": {
                                "ru": "Вор <w>выкрал</w> ценные документы из сейфа посреди ночи."
                            }
                        },
                        {
                            "text": "Ktoś <w>wykradł</w> wszystkie pieniądze z kasy podczas przerwy obiadowej.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>украл</w> все деньги из кассы во время обеденного перерыва."
                            }
                        }
                    ],
                    "synonyms": [
                        "skraść",
                        "ukraść"
                    ],
                    "common_phrases": [
                        "wykraść dokumenty",
                        "wykraść pieniądze"
                    ],
                    "target_lang_definitions": {
                        "ru": "тайно похитить чужую собственность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украсть",
                                "target_lang_sense_clarification": "общее значение, совершить кражу"
                            },
                            {
                                "target_lang_word": "похитить",
                                "target_lang_sense_clarification": "более формальный или книжный вариант"
                            },
                            {
                                "target_lang_word": "выкрасть",
                                "target_lang_sense_clarification": "акцент на извлечении чего-либо из защищенного места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fca67cf8-4605-3aec-b3a6-26a4f3982f69",
                    "sense_definition": "uprowadzić kogoś wbrew jego woli",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kradzież",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestępcy próbowali <w>wykraść</w> dziecko z placu zabaw.",
                            "target_lang_translations": {
                                "ru": "Преступники пытались <w>похитить</w> ребенка с детской площадки."
                            }
                        },
                        {
                            "text": "W filmie szpiedzy <w>wykradli</w> naukowca z tajnej bazy wojskowej.",
                            "target_lang_translations": {
                                "ru": "В фильме шпионы <w>похитили</w> ученого с секретной военной базы."
                            }
                        }
                    ],
                    "synonyms": [
                        "uprowadzić",
                        "porwać"
                    ],
                    "target_lang_definitions": {
                        "ru": "насильно увезти или увести кого-либо против воли"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похитить",
                                "target_lang_sense_clarification": "стандартный термин для насильственного удержания человека"
                            },
                            {
                                "target_lang_word": "украсть",
                                "target_lang_sense_clarification": "разговорный вариант, часто используется в отношении детей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b26229-1f4e-3222-bbf4-37eabb6d034c",
                    "sense_definition": "wyjść skądś po cichu, niezauważenie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "skradanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musiał <w>wykraść</w> się z domu przez okno, żeby rodzice go nie usłyszeli.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>выбраться</w> из дома через окно, чтобы родители его не услышали."
                            }
                        },
                        {
                            "text": "Goście zaczęli powoli <w>wykradać</w> się z nudnego przyjęcia.",
                            "target_lang_translations": {
                                "ru": "Гости начали потихоньку <w>улизнуть</w> со скучной вечеринки."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymknąć się",
                        "wyślizgnąć się"
                    ],
                    "common_phrases": [
                        "wykraść się z domu"
                    ],
                    "target_lang_definitions": {
                        "ru": "незаметно выйти откуда-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выскользнуть",
                                "target_lang_sense_clarification": "выйти тихо и незаметно"
                            },
                            {
                                "target_lang_word": "улизнуть",
                                "target_lang_sense_clarification": "разговорный вариант, сбежать незаметно"
                            },
                            {
                                "target_lang_word": "выбраться",
                                "target_lang_sense_clarification": "выйти из сложной ситуации или места"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}