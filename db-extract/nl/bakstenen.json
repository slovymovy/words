                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ebe2b2-24c0-4780-8e39-c03401ba54d2",
                                                "sense_id": "52f57889-6f69-3b1c-a88d-e70a266b33c1",
                                                "text": "I can sell bricks, I don't need to rap / Buj so peng it makes the fiends collapse / Cook that coca into crack / I was selling Zs while you was in your bed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cdd3367-2e87-3b07-9c97-4606d6c85724",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
                                        "glosses": [
                                            "A trans woman who does not pass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "offensive",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed75ff6-e759-4c3f-ac3a-55167e9d50d1",
                                                "sense_id": "4cdd3367-2e87-3b07-9c97-4606d6c85724",
                                                "text": "Was she like you—a brick, never passed, never gonna?"
                                            },
                                            {
                                                "example_id": "666b65fd-6129-4a60-9387-a0c5ce44a66d",
                                                "sense_id": "4cdd3367-2e87-3b07-9c97-4606d6c85724",
                                                "text": "In the world of drag, “brick” is a shady word, slang lobbed at queens whose makeup looks busted, whose wardrobes have seen better days, or who are just generally giving hot mess."
                                            },
                                            {
                                                "example_id": "46764feb-812f-453b-9d0f-240543101d9e",
                                                "sense_id": "4cdd3367-2e87-3b07-9c97-4606d6c85724",
                                                "text": ":( body positivity doesn't work on me :3 being a brick is awful smh"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brick",
