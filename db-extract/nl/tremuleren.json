                "translations": [
                    {
                        "translation_id": "f3c07bc7-740e-4744-9ba2-9015d9714b07",
                        "source_entry_id": "316713ec-6c3a-3de8-adde-8f27913ee317",
                        "source_sense_id": "c2ba88c2-32a5-33c3-874a-47d36ca65988",
                        "target_lang_word": "trémuler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trémuler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b82daba7-1ce3-3df2-b06a-3771c53f818b",
                                        "entry_id": "61f69479-5202-314f-b0d3-2cfa4423679e",
                                        "glosses": [
                                            "Trembler."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0b1ec5-158d-402d-bd4c-c4c92f46a7f8",
                                                "sense_id": "b82daba7-1ce3-3df2-b06a-3771c53f818b",
                                                "text": "Là, il se mit à se contorsionner, à trémuler et à trembler convulsivement, bavant, écumant et poussant toujours son cri de bête."
                                            },
                                            {
                                                "example_id": "1d7b5e90-f8b1-4ed5-be5a-2a62369ed60f",
                                                "sense_id": "b82daba7-1ce3-3df2-b06a-3771c53f818b",
                                                "text": "Les sept cors tonitruants firent trémuler les vitraux dans leurs plombs."
                                            },
                                            {
                                                "example_id": "500aa712-fb40-4d72-af24-884827121d11",
                                                "sense_id": "b82daba7-1ce3-3df2-b06a-3771c53f818b",
                                                "text": "il est là, livide et frileux, tapi dans un coin. … Il trémule, les mains entre les cuisses, deux limaces sirupeuses et élastiques sur les lèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68faf3a-af1f-381c-9c98-2d5da93834eb",
                                        "entry_id": "61f69479-5202-314f-b0d3-2cfa4423679e",
                                        "glosses": [
                                            "Être agité de tremblements par contraction musculaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d70ffd54-7b95-4fc9-aea9-fac0c18f9e23",
                                                "sense_id": "f68faf3a-af1f-381c-9c98-2d5da93834eb",
                                                "text": "Il existe à peine d’exagération des réflexes au bras et à la jambe du côté gauche : cependant il arrive quelquefois que lorsque le malade pose le pied sur la pointe, tout le membre inférieur gauche se met à trémuler ; …"
                                            },
                                            {
                                                "example_id": "65ba28ce-9d10-4f2e-8b60-25b81fb3aaf4",
                                                "sense_id": "f68faf3a-af1f-381c-9c98-2d5da93834eb",
                                                "text": "En soulevant le membre inférieur droit, et en lui imprimant quelques secousses, la cuisse se met à trémuler, la jambe et la cuisse se raidissent et l’attaque commence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c722460-7ff7-394c-a777-dba33d9fe587",
                                        "entry_id": "61f69479-5202-314f-b0d3-2cfa4423679e",
                                        "glosses": [
                                            "Faire bouger de façon tremblante."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
