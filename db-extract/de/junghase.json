                ],
                "senses": [
                    {
                        "sense_id": "890dd9e8-91d4-390a-9efc-55c37b483cd4",
                        "entry_id": "021dc2ac-b130-3d4c-bdcb-6e5a5b990a09",
                        "glosses": [
                            "Hase geringen Alters, junger Hase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8419394-9014-490c-b869-a552c0a1b44b",
                                "sense_id": "890dd9e8-91d4-390a-9efc-55c37b483cd4",
                                "text": "„Junghasen vertragen keine Nässe. Regnet es in den ersten Monaten sehr viel, ist die Vermehrungsrate geringer als bei trockener Witterung.“"
                            },
                            {
                                "example_id": "e77ecc7f-a218-4be6-b5f3-dbaa70a62c30",
                                "sense_id": "890dd9e8-91d4-390a-9efc-55c37b483cd4",
                                "text": "„Man kann sagen, daß ein Hasenpaar – die Häsin setzt ein bis drei Junge in einem Jahr – acht bis zehn Nachkommen zur Welt bringt; nicht, mitgerechnet sind die im März gesetzten Junghasen, die sich im selben Jahr schon paaren und Junge setzen.“"
                            },
                            {
                                "example_id": "25d211de-a923-4799-b64e-5c1742b4fc3e",
                                "sense_id": "890dd9e8-91d4-390a-9efc-55c37b483cd4",
                                "text": "„Weltweit zählen Hasen zu den Beutetieren für Prädatoren und Fleischfresser. In Europa sind das unterschiedliche Raubtiere, Greifvögel und Rabenvögel, die insbesondere den Großteil der Junghasen erbeuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
