                        "examples": [
                            {
                                "example_id": "d85bfcb2-8da6-4c8c-951e-7d3df1a5026f",
                                "sense_id": "a5a5d445-7fd6-329c-bd40-f5ea2c203dd1",
                                "text": "Du solltest öfter in den Rückspiegel schauen.",
                                "translation": "Tu devrais regarder plus fréquemment dans le rétroviseur."
                            },
                            {
                                "example_id": "1a16cbce-aa10-4db2-adcd-9156af0e4f30",
                                "sense_id": "a5a5d445-7fd6-329c-bd40-f5ea2c203dd1",
                                "text": "Ahmad, 57, schaut auf den Bildschirm, der im neuen Bus seinen Rückspiegel ersetzt hat, und fährt los."
                            }
                        ]
                    }
                ],
