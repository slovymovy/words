                        "examples": [
                            {
                                "example_id": "cd57c3d4-45db-4f54-bf93-d7d6a7d7aed7",
                                "sense_id": "20e3cf38-c890-3530-9917-15a26dbd6c7e",
                                "text": "„In jeder Kunstzeitschrift konnte man heute Artikel über ihn lesen.“"
                            },
                            {
                                "example_id": "30edf0f0-061a-4c9e-ba28-8db2a5c6d290",
                                "sense_id": "20e3cf38-c890-3530-9917-15a26dbd6c7e",
                                "text": "„Tags darauf kam er mit einem Galeriebesitzer und einer Sammlerin wieder, bekannte Leute, deren Ansichten landauf, landab in Kunstzeitschriften zu lesen waren.“"
                            }
                        ],
