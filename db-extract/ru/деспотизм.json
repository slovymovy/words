                    {
                        "translation_id": "6266b08d-a516-430e-b71e-9950e615a62a",
                        "source_entry_id": "027f3144-399d-3358-9829-bb344bab58ea",
                        "target_lang_word": "Despotismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Despotismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13a68fbc-76a3-35d4-a432-b640c8a5590d",
                                        "entry_id": "36746c56-2b5e-32f2-afcf-f771dc46c477",
                                        "glosses": [
                                            "Herrschaftsform, in der das Staatsoberhaupt die uneingeschränkte Herrschaft ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9827c6d-265d-46e0-8706-d9353ed14976",
                                                "sense_id": "13a68fbc-76a3-35d4-a432-b640c8a5590d",
                                                "text": "Der Despotismus einte das Land."
                                            },
                                            {
                                                "example_id": "93edf618-3977-49a4-a014-5f95e0aa64b5",
                                                "sense_id": "13a68fbc-76a3-35d4-a432-b640c8a5590d",
                                                "text": "„Der Grund für seine Haltung war unbedingte Gegnerschaft zum verhassten Zarismus, in dem die SPD reinen Despotismus sah.“"
                                            },
                                            {
                                                "example_id": "83a13cd5-4853-481c-adae-28ccd408a47f",
                                                "sense_id": "13a68fbc-76a3-35d4-a432-b640c8a5590d",
                                                "text": "„Der Despotismus erhöht die Wollust, er sucht Unterwerfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bf0139d-ac7a-4a1e-b380-cf2940335ed5",
                        "source_entry_id": "027f3144-399d-3358-9829-bb344bab58ea",
                        "target_lang_word": "Tyrannei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tyrannei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab55fa23-5a7a-36d4-ab1e-029fe34f2479",
                                        "entry_id": "734fbc80-ef63-381c-873f-4285fac72506",
                                        "glosses": [
                                            "willkürliche und unterdrückerische Gewaltherrschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef1f9f3-1ba9-42ae-b12a-9b9b9fdc2d98",
                                                "sense_id": "ab55fa23-5a7a-36d4-ab1e-029fe34f2479",
                                                "text": "Die Revolution sollte der Tyrannei des alten Regimes ein Ende bereiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65e3e136-66e8-3aea-8351-72dd10d22837",
                                        "entry_id": "734fbc80-ef63-381c-873f-4285fac72506",
                                        "glosses": [
                                            "rücksichtslos herrschsüchtiges Verhalten eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2f9fbd-c2cb-487a-bcc4-cd5b168e78da",
                                                "sense_id": "65e3e136-66e8-3aea-8351-72dd10d22837",
                                                "text": "Er versuchte der Tyrannei seines Vaters zu entkommen."
                                            },
                                            {
                                                "example_id": "4f30d668-e468-44d8-a320-5d2e58609f24",
                                                "sense_id": "65e3e136-66e8-3aea-8351-72dd10d22837",
                                                "text": "„So übte der verwünschte alte Präfekt mit seiner verunstalteten Nase seine Tyrannei überall dort aus, wo die Liebhaber ihre Sinnenfreuden suchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
