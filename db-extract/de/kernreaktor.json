                "senses": [
                    {
                        "sense_id": "d3984dd3-601a-3412-accf-b4ed5c0ec03c",
                        "entry_id": "8107a841-2feb-385a-b1a7-e901b655b604",
                        "glosses": [
                            "Reaktor, in dem Atomkerne in einer Kettenreaktion immer wieder zur Spaltung gebracht werden und der oft zur Energiegewinnung eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713d3ae1-eed5-4e90-8092-9fa46aba7fe1",
                                "sense_id": "d3984dd3-601a-3412-accf-b4ed5c0ec03c",
                                "text": "„In erster Linie kommt es in einem Kernreaktor zur einer Kettenreaktion.“"
                            },
                            {
                                "example_id": "cdf2b21a-aadd-4a24-a732-fcaf38b3e45e",
                                "sense_id": "d3984dd3-601a-3412-accf-b4ed5c0ec03c",
                                "text": "„Und die Bewohner der Gemeinden arbeiten in dem halben Dutzend Minen, entweder in der Verwaltung, oder sie holen als Minenarbeiter das Uranoxid aus der Erde, das gesiebt, aufbereitet, abtransportiert und in die Länder mit Kernreaktoren verkauft wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c62711c-7b41-443e-a7cf-31a3bf28b7b6",
