                        "source_sense_description": "to cause to feel extreme apprehension or unease",
                        "target_lang_word": "entsetzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entsetzen",
