                "translations": [
                    {
                        "translation_id": "8208d6db-427b-42a8-aeaa-9163b6d7c244",
                        "source_entry_id": "ece660de-eddf-322b-996c-378ba415f037",
                        "source_sense_id": "b0c58bc7-b7d0-3948-80aa-5acbe1157c07",
                        "target_lang_word": "harceler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harceler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48a310fb-8723-3ed7-ba43-844e81988957",
                                        "entry_id": "6b55984e-ee39-3aa8-bebb-fa89a3ca1bc7",
                                        "glosses": [
                                            "Tourmenter une personne, ou un animal, en le poursuivant sans relâche, en le malmenant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb51dcd9-59f8-4f5d-bbad-d1922481e5bd",
                                                "sense_id": "48a310fb-8723-3ed7-ba43-844e81988957",
                                                "text": "Cet élève a harcelé plusieurs de ses camarades de classe après avoir été victime de harcèlement précédemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b7eef9c-db4a-3aed-9411-7afd8ee6818e",
                                        "entry_id": "6b55984e-ee39-3aa8-bebb-fa89a3ca1bc7",
                                        "glosses": [
                                            "Tourmenter une personne, ou un animal, en le poursuivant sans relâche, en le malmenant.",
                                            "Tourmenter physiquement ou psychiquement une personne sans relâche, la tyranniser (surtout dans le contexte scolaire)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9937e8c-15b0-395e-89e2-864c35138b79",
                                        "entry_id": "6b55984e-ee39-3aa8-bebb-fa89a3ca1bc7",
                                        "glosses": [
                                            "Fatiguer l’ennemi par de fréquentes attaques, par de fréquentes escarmouches ou embuscades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4055a7d3-7a3b-46eb-a773-661f9dd331f2",
                                                "sense_id": "b9937e8c-15b0-395e-89e2-864c35138b79",
                                                "text": "Mais sa marche était lente et inégale ; poursuivie par l’ennemi, dont les bâtiments légers la harcelaient, elle vit son arrière-garde coupée le 21 juillet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e33b17-6fb5-3687-bdc4-060363be9d2f",
                                        "entry_id": "6b55984e-ee39-3aa8-bebb-fa89a3ca1bc7",
                                        "glosses": [
                                            "Importuner quelqu’un par des demandes, des questions, des réclamations permanentes."
                                        ],
                                        "tags": [
                                            "Harceler de ou par"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfdee043-a278-4983-8e54-5a066d41ba3c",
                                                "sense_id": "14e33b17-6fb5-3687-bdc4-060363be9d2f",
                                                "text": "Les journalistes me harcèlent de questions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "172e9ca1-9775-33a1-b116-e61bcff9b80d",
                                        "entry_id": "6b55984e-ee39-3aa8-bebb-fa89a3ca1bc7",
                                        "glosses": [
                                            "Fatiguer, agacer quelqu’un par des demandes, des questions réitérées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "883f4ffa-5f45-4dab-b63a-c186f1419a83",
                                                "sense_id": "172e9ca1-9775-33a1-b116-e61bcff9b80d",
                                                "text": "Arrêterz de me harceler ; je ne vous répondrai pas !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae6a88c-e660-34f7-92b2-9082a015132f",
                                        "entry_id": "6b55984e-ee39-3aa8-bebb-fa89a3ca1bc7",
                                        "glosses": [
                                            "Exhorter de manière réitérée pour faire agir et progresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc702808-c17a-4368-a40d-2e96fd746d34",
                                                "sense_id": "cae6a88c-e660-34f7-92b2-9082a015132f",
                                                "text": "Il est très paresseux, il faut le harceler pour le faire s’activer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b908444-ecbe-4633-8edb-11502504df6a",
                        "source_entry_id": "ece660de-eddf-322b-996c-378ba415f037",
                        "source_sense_id": "b0c58bc7-b7d0-3948-80aa-5acbe1157c07",
                        "target_lang_word": "fortement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                        "entry_id": "321a97ef-a2fb-37ee-bed6-fa125cc85af0",
                                        "glosses": [
                                            "Avec force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138b1d0e-f3da-4686-b723-92ee002b083a",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "L’objectif majeur de cette étude était d’identifier l’influence de différents facteurs dynamiques sur la distribution spatiale des matières en suspension dans une région côtière macrotidale et fortement influencée par les apports fluviaux."
                                            },
                                            {
                                                "example_id": "9229aba6-2775-4e14-af3f-4ee3ed612ec6",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "Cela tient fortement à la muraille."
                                            },
                                            {
                                                "example_id": "9e737e5d-b651-4915-a9df-0ff8575c4950",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "Cette nouvelle génération d’espionnes, ultradéterminée, qui a redoublé d’efforts pour s’imposer, challenge aussi fortement les agents à l’ancienne."
                                            },
                                            {
                                                "example_id": "f048df1e-d06f-461d-bbe5-b466be56d22a",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "C’est un ouvrage fortement pensé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e064e95-ac62-3c35-88d5-ada7b4a2108a",
                                        "entry_id": "321a97ef-a2fb-37ee-bed6-fa125cc85af0",
                                        "glosses": [
                                            "Très, beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7b627d4-b2cd-3969-a2e8-26fbb8b1ae0c",
                                        "entry_id": "321a97ef-a2fb-37ee-bed6-fa125cc85af0",
                                        "glosses": [
                                            "Avec une netteté saillante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d167a3-2200-4aca-83d8-b0e147a407cb",
                                                "sense_id": "c7b627d4-b2cd-3969-a2e8-26fbb8b1ae0c",
                                                "text": "Des contours, des muscles, etc., fortement dessinés."
                                            },
                                            {
                                                "example_id": "cd40fbc3-0251-42f1-90d5-1b7579192cdc",
                                                "sense_id": "c7b627d4-b2cd-3969-a2e8-26fbb8b1ae0c",
                                                "text": "Des traits marqués fortement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9c7631a-cf94-47fc-b88e-5ed13f4077a4",
                        "source_entry_id": "ece660de-eddf-322b-996c-378ba415f037",
                        "source_sense_id": "b0c58bc7-b7d0-3948-80aa-5acbe1157c07",
                        "target_lang_word": "grossièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "D’une manière grossière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32bfdad5-2ad9-47de-a3d9-0ef7a076dc39",
                                                "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                                "text": "Il y avait dans la chaise un jeune homme grossièrement vêtu."
                                            },
                                            {
                                                "example_id": "535af6a6-0154-4334-a531-5f3373571160",
                                                "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                                "text": "Les volets, grossièrement faits, se recommandaient par une solide peinture vert dragon."
                                            },
                                            {
                                                "example_id": "2cfc904f-8818-41ac-8d5f-4a0242d8f7ea",
                                                "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                                "text": "Quelques chiffres grossièrement ébauchés sur l’écorce des ormeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fe0dfd-a3d4-3e11-a0b8-6147200bb5db",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "D’une façon opposée à ce qu’il y a de spirituel, d’intellectuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b093fc-a9c8-4058-937e-83e5cc09c0fd",
                                                "sense_id": "11fe0dfd-a3d4-3e11-a0b8-6147200bb5db",
                                                "text": "L’usage des pensées et de l’écriture me sert au besoin [dans l’absence] ; mais cependant, ma fille, je vous avoue grossièrement que j’ai une très sensible envie de vous voir et de vous embrasser de tout mon cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eff68ee-6c12-385f-af28-e02d79f9517b",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "Avec maladresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3856d204-548e-4956-b591-c10d0384e67e",
                                                "sense_id": "2eff68ee-6c12-385f-af28-e02d79f9517b",
                                                "text": "Il loue grossièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "D’une manière qui suppose ignorance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3205975-e02f-424b-8b59-35f8ba0cf710",
                                                "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                                                "text": "S’ils s’emportent seulement contre les répréhensions et non pas contre les choses qu’on a reprises, je ne m’empêcherai jamais de leur dire qu’ils sont grossièrement abusés et que leur zèle est bien aveugle."
                                            },
                                            {
                                                "example_id": "c2e106cf-3b53-4af5-b2ea-1fc16948860e",
                                                "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                                                "text": "Vous êtes donc grossièrement et visiblement trompé, quand, au préjudice de cette divine loi, vous n’apportez à la prière nulle préparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dcf9207-6509-35df-842c-ae424b5870c9",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "Avec incivilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d171c669-96e4-4010-ab06-08ff19357bf4",
                                                "sense_id": "0dcf9207-6509-35df-842c-ae424b5870c9",
                                                "text": "Répondre grossièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "Sommairement, imparfaitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f7a2aa-0048-4412-a009-8b067cad0f90",
                                                "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                                "text": "Les bases des tours visigothes sont carrées ou ont été grossièrement arrondies pour recevoir les défenses du Vᵉ siècle."
                                            },
                                            {
                                                "example_id": "3ef9ed71-1e4a-437a-9c58-2cbfce11f671",
                                                "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                                "text": "Arrivée au troisième étage, qui passait pour être le second, Manon s’arrêta, fit mouvoir les ressorts d’une antique serrure, et ouvrit une porte peinte en couleur d’acajou ronceux grossièrement imité."
                                            },
                                            {
                                                "example_id": "f91e7d3e-464f-4a41-baf8-b494a7b638cf",
                                                "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                                "text": "Content d’avoir grossièrement esquissé mon plan, je revins aux situations de détail que j’avais tracées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
