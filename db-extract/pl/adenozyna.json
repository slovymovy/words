        "pl-extract.jsonl": [
            {
                "entry_id": "0aef7f2b-8e08-3d8c-b6d4-74eb6583b278",
                "word": "adenozyna",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e36c0c88-26d1-38ff-af23-1372992e9daf",
                        "entry_id": "0aef7f2b-8e08-3d8c-b6d4-74eb6583b278",
                        "glosses": [
                            "nukleozyd purynowy złożony z adeniny i rybozy, pełniący ważne funkcje biologiczne, m.in. jako składnik ATP, ADP, AMP oraz jako neuroprzekaźnik; C₁₀H₁₃N₅O₄"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e559fd-28bb-4cef-a627-6fc2e6e8549c",
                                "sense_id": "e36c0c88-26d1-38ff-af23-1372992e9daf",
                                "text": "Adenozyna stymulując cyklazę adenylową powoduje wzrost cAMP w płytkach i w ten sposób hamuje ich aktywację."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08b83c21-4f23-46d7-a293-9feef4792141",
                        "source_entry_id": "0aef7f2b-8e08-3d8c-b6d4-74eb6583b278",
                        "source_sense_id": "e36c0c88-26d1-38ff-af23-1372992e9daf",
                        "target_lang_word": "adenosine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adenosine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0186e5-bf60-3cd5-b59f-89f5cbccaf7c",
                                        "entry_id": "d1815261-312f-3f96-b86b-d3b25d08132a",
                                        "glosses": [
                                            "A nucleoside derived from adenine and ribose, found in striated muscle tissue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9116d2-38c1-45cf-8c15-4a34f4f8631c",
                                                "sense_id": "ea0186e5-bf60-3cd5-b59f-89f5cbccaf7c",
                                                "text": "Adenosine levels can be quickly righted after a few nights of good sleep, however."
                                            },
                                            {
                                                "example_id": "ce2ad04b-8251-4a3d-9092-49dbd05f0bd4",
                                                "sense_id": "ea0186e5-bf60-3cd5-b59f-89f5cbccaf7c",
                                                "text": "Caffeine acts as an antagonist at receptors in the brain for one of the chemical messengers called adenosine."
                                            },
                                            {
                                                "example_id": "67a8cf2b-974b-4c9a-b4e4-93b1d1e05aca",
                                                "sense_id": "ea0186e5-bf60-3cd5-b59f-89f5cbccaf7c",
                                                "text": "Think of adenosine as a chemical barometer that continuously registers the amount of elapsed time since you woke up this morning."
                                            },
                                            {
                                                "example_id": "15f39465-f49f-412c-a8e0-747fe9cf9f41",
                                                "sense_id": "ea0186e5-bf60-3cd5-b59f-89f5cbccaf7c",
                                                "text": "SAM: Readings confirmed. Based on the levels of adenosine in your system, the neural implant is functioning properly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6040b83-8405-4d44-9821-0016726dd578",
                        "source_entry_id": "0aef7f2b-8e08-3d8c-b6d4-74eb6583b278",
                        "source_sense_id": "e36c0c88-26d1-38ff-af23-1372992e9daf",
                        "target_lang_word": "adénosine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adénosine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2ea348-f4fa-35a8-ab2c-973ecb5876a4",
                                        "entry_id": "610d3155-2e17-363e-9cf4-bb118b981e35",
                                        "glosses": [
                                            "Nucléoside formé d'un cycle ribose attaché à la base azotée adénine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ac013c-3d6a-470f-b639-a19e6b71b5ad",
                                                "sense_id": "8f2ea348-f4fa-35a8-ab2c-973ecb5876a4",
                                                "text": "Ces hélices, insérées dans l’épaisseur de la membrane des cellules, y dessinent les contours d’une sorte de guichet dans lequel l’adénosine va s’engager pour communiquer une information à l’intérieur de la cellule qui les porte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
