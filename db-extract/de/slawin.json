                    }
                ],
                "senses": [
                    {
                        "sense_id": "d991cfab-38eb-3e19-b994-1a7b84dc2946",
                        "entry_id": "ff8fc6fe-73f7-38c1-8711-b9623a2d3863",
                        "glosses": [
                            "weibliche Angehörige einer Völkergruppe im Osten Europas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f6c542-ae46-465b-9170-be0b707abc4e",
                                "sense_id": "d991cfab-38eb-3e19-b994-1a7b84dc2946",
                                "text": "„Besonders enge Beziehungen entwickelte Maria Grollmuß zu den Slawinnen im Lager. Dabei kamen ihr ihre sorbische Herkunft und ihre guten tschechischen Sprachkenntnisse zugute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ea4b9c5-7dca-44b2-ba34-77703d6b2171",
                        "source_entry_id": "ff8fc6fe-73f7-38c1-8711-b9623a2d3863",
                        "source_sense_id": "d991cfab-38eb-3e19-b994-1a7b84dc2946",
                        "source_sense_description": "weibliche Angehörige einer Völkergruppe im Osten Europas",
                        "target_lang_word": "Slav",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slav",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "992db095-1e2f-3556-b1d1-390e2b774122",
                                        "entry_id": "6b3a3e20-9ec0-385a-9ada-9fc8b4e22155",
                                        "glosses": [
                                            "A member of any of the peoples of Europe who speak the Slavic languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7a3e129-5e43-3d29-a453-8112b823020b",
                                        "entry_id": "6b3a3e20-9ec0-385a-9ada-9fc8b4e22155",
                                        "glosses": [
                                            "The Slavonian grebe."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Slav",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                        "entry_id": "62eb8350-61f1-31ef-bb05-5a190627e936",
                                        "glosses": [
                                            "Synonym of Slavic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc44f81-255e-4bee-9c9d-10c50ba44a09",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "Arising out of her intercourse with the Slavs of the interior, Dubrovnik became a very Slav city, both in manners and in sympathy."
                                            },
                                            {
                                                "example_id": "9c761f92-3549-4e7a-80c9-291877975e20",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "If black Persian is what you want, there’s a very Slav coat, full-length, with fuchsia wool lining and with pockets sticking out on either hip, and there’s a three-quarter affair with a small, rolled collar, a narrow tuxedo front bound with silk braid, and a full, loose back."
                                            },
                                            {
                                                "example_id": "c7c70373-29d9-4b83-a885-660ef51f80ad",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "She spoke French with a very Slav accent."
                                            },
                                            {
                                                "example_id": "8c7569ff-8d38-4049-b436-c75cb1c62450",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "The young Jugoslav taxidriver who took us to the airport drove with a discontented and furious disdain. He took a very Slav view of the migration. He had gone out as a boy of 17 eight years before, and cared very little for it."
                                            },
                                            {
                                                "example_id": "d93d3db0-f37e-4b51-b51e-7dafbe1bcacf",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "Obliged by my own question to face him if it were to appear as innocent as it actually was, I took in his features. It was not a very Slav face."
                                            },
                                            {
                                                "example_id": "422ecd66-c23b-41f4-951b-4385605650e6",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "While the social system could thus be improved, [G. Stanley] Hall knew that heredity was more important. He argued that a pound of heredity was “worth a hundredweight of education.” It was necessary to pay attention to better breeding: “The nation that breeds best, be it Mongol, Slav, Teuton or Saxon, will rule the world in the future.”"
                                            },
                                            {
                                                "example_id": "31c526fa-4d7a-4cae-8c1d-a32207bda555",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "The drawing by Tchelitchew is beautiful, but not at all like the character of the gardener whom it portrays. He was an educated head gardener. This is a peasant; a very Slav peasant at that."
                                            },
                                            {
                                                "example_id": "6894bb33-3097-40c6-94d5-e4335717f0ae",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "‘Zorka is a strange name for an English girl,’ Nicky said musingly as they sat down, wanting to know more about the girl who was his daughter. ‘It is a very Slav name. Is your sister perhaps very Slav, Captain Fielding? Is she more Slav than English?’ / Amused by Kechko’s continuing interest in his family Stephen took the plate proferred him, saying truthfully, ‘My sister is very Slav in both looks and temperament.’"
                                            },
                                            {
                                                "example_id": "be775380-4208-48f2-9dda-c422e6d12381",
                                                "sense_id": "fcb8dc88-9ebc-3a53-b399-b89c16ce1b76",
                                                "text": "The big advantage of learning Russian is that, once you’re proficient, you can understand other Slav languages such as Czech, Polish or Bulgarian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e652c0e-6d0b-4ec9-a43a-afda2f40e7b1",
                        "source_entry_id": "ff8fc6fe-73f7-38c1-8711-b9623a2d3863",
