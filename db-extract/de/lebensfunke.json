                "senses": [
                    {
                        "sense_id": "6b892ba4-55ef-3093-bc50-b8ce570293f7",
                        "entry_id": "9b3a4bbd-698d-3a24-9f54-93f0c8f0db24",
                        "glosses": [
                            "schwache Spur/schwaches Anzeichen von Leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d98644f6-4f37-4a8b-963d-baa64e3eabeb",
                                "sense_id": "6b892ba4-55ef-3093-bc50-b8ce570293f7",
                                "text": "„Nur ein leises Röcheln verkündete, daß der Lebensfunke noch nicht ganz von ihm gewichen war.“"
                            },
                            {
                                "example_id": "80ecb8df-840f-48c4-9220-b50b4b29c938",
                                "sense_id": "6b892ba4-55ef-3093-bc50-b8ce570293f7",
                                "text": "„Ich wollte an den sterblichen Überresten des Fremden mit abgewandtem Gesicht vorbeigehen, doch als ich mich dem Leichnam näherte, glaubte ich ein leises Geräusch zu hören, als wäre der letzte Lebensfunke doch noch nicht erloschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
