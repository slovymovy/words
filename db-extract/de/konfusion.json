                ],
                "senses": [
                    {
                        "sense_id": "a82fb227-2a69-3f3b-bdad-936afc8bf797",
                        "entry_id": "bca0e7c6-4f87-3718-932d-6fd6ce2ee29d",
                        "glosses": [
                            "Zustand des Durcheinanders oder der Verwirrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b40b1627-cc5d-4a13-bacc-2f5c98d43531",
                                "sense_id": "a82fb227-2a69-3f3b-bdad-936afc8bf797",
                                "text": "„Der andere Passagier dagegen saß so ruhig und regungslos wie immer in dieser Konfusion und sagte kein Wort;…“"
                            },
                            {
                                "example_id": "e8283aec-b8a0-4b38-8d9a-735654372e7c",
                                "sense_id": "a82fb227-2a69-3f3b-bdad-936afc8bf797",
                                "text": "„Zu welchen Konfusionen das vom Denken begleitete Vergleichen der Männer führen kann, zeigen die umlaufenden Professorenwitze über verwechselte Schüler und die galgenhumorigen Väterwitze über das Phänomen der Zwillingsgeburten.“"
                            },
                            {
                                "example_id": "fc8904fd-814e-445b-97ad-6b820d11b010",
                                "sense_id": "a82fb227-2a69-3f3b-bdad-936afc8bf797",
                                "text": "„Die hübsche Zofe geriet in Konfusion und rief nach Madame.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
