                ],
                "senses": [
                    {
                        "sense_id": "2695707d-8797-3136-a7e1-17ac509b5db5",
                        "entry_id": "35c04769-6996-39a1-9021-6b7fcdc3f419",
                        "glosses": [
                            "historische Scheidemünze, vor allem im nordwestdeutschen Raum, meist mit der Aufschrift Stuber. Entstanden als Nachprägung des niederländischen Stuiver / Stüwer, Niederländisch: stuiver ^(→ nl), im 16. Jahrhundert, war sie bis zu Beginn des 19. Jahrhunderts in Gebrauch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e7520e-cf6f-48e6-9aab-8439af2f00bc",
                                "sense_id": "2695707d-8797-3136-a7e1-17ac509b5db5",
                                "text": "(Chronik des Peter Delhoven vom Ende des 18. Jahrhunderts:) „So musten sonst die armen Leuthe in Hackenbroich, […] abwechselnd wie Leibeigene die Arbeiten auf der herschaftlichen Burg verrichten. Mit jedem halben Tage wurden sie abgelöset; dafür reichte mann ihnen einen Stüber. Izt müssen sie einen ganzen Tag dienen, und man reicht ihnen doch nicht mehr als einen Stüber; zwar ein armer Betrug, der aber nur einen armen Mann drücken kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eed65114-f714-3043-ba74-b5e3311835f8",
                        "entry_id": "35c04769-6996-39a1-9021-6b7fcdc3f419",
                        "glosses": [
                            "Währungseinheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201cc3fa-08b3-402b-996b-9472f3496b0d",
                                "sense_id": "eed65114-f714-3043-ba74-b5e3311835f8",
                                "text": "(Chronik des Peter Delhoven vom Ende des 18. Jahrhunderts:) „So musten sonst die armen Leuthe in Hackenbroich, […] abwechselnd wie Leibeigene die Arbeiten auf der herschaftlichen Burg verrichten. Mit jedem halben Tage wurden sie abgelöset; dafür reichte mann ihnen einen Stüber. Izt müssen sie einen ganzen Tag dienen, und man reicht ihnen doch nicht mehr als einen Stüber; zwar ein armer Betrug, der aber nur einen armen Mann drücken kann.“"
                            },
                            {
                                "example_id": "f1c3bb40-8d1a-43d0-8103-5d6f0b0d90db",
                                "sense_id": "eed65114-f714-3043-ba74-b5e3311835f8",
                                "text": "„Wichtig war auch zu prüfen, ob die Eltern in der Lage sein würden, das vorgesehene Schulgeld von 1 Stüber (monatlich) zu bezahlen, ob ihnen angesichts ihrer finanziellen Verhältnisse nur ein halber Stüber zugemutet werden konnte … “"
                            },
                            {
                                "example_id": "978e8a95-f2fb-48a7-b395-e4548e1faa8b",
                                "sense_id": "eed65114-f714-3043-ba74-b5e3311835f8",
                                "text": "Ein Gulden zählte 20 Stüber."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b747c078-235a-43ff-84fd-7d35b2c5aa02",
                        "source_entry_id": "35c04769-6996-39a1-9021-6b7fcdc3f419",
                        "source_sense_id": "2695707d-8797-3136-a7e1-17ac509b5db5",
                        "target_lang_word": "stiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7286aeb9-2678-3905-b28f-7046f0ce03b9",
                                        "entry_id": "24a1a4a2-51c7-3b61-ac63-05246492ea1e",
                                        "glosses": [
                                            "A small Dutch coin worth one twentieth of a guilder."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62b7639a-efd1-31c0-a582-f099760998de",
                                        "entry_id": "24a1a4a2-51c7-3b61-ac63-05246492ea1e",
                                        "glosses": [
                                            "Anything of small value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c626c3-ec3c-488c-a27d-fe9828accb86",
                                                "sense_id": "62b7639a-efd1-31c0-a582-f099760998de",
                                                "text": "’Tis not worth a single stiver, said the bandy-leg'd drummer."
                                            },
                                            {
                                                "example_id": "810a3aa7-bb5e-45ff-b8f1-945ce792087b",
                                                "sense_id": "62b7639a-efd1-31c0-a582-f099760998de",
                                                "text": "[A]ll hands, including the captain, received certain shares of the profits called lays […] And though the 275th lay was what they call a rather long lay, yet it was better than nothing; and if we had a lucky voyage, might pretty nearly pay for the clothing I would wear out on it, not to speak of my three years' beef and board, for which I would not have to pay one stiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22063e76-44a8-45de-9e1b-0271ad1734e4",
                        "source_entry_id": "35c04769-6996-39a1-9021-6b7fcdc3f419",
                        "source_sense_id": "2695707d-8797-3136-a7e1-17ac509b5db5",
                        "target_lang_word": "stuiver",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stuiver",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2c645701-2d8e-3128-9872-6e8b0927ef6c",
                                        "entry_id": "ee3b64a1-a53e-3d22-8691-e81640e99c24",
                                        "glosses": [
                                            "een muntstuk van vijf cent (f 0,05), een twintigste van een gulden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede1d27e-811f-4d75-84a7-b7a90cf6e879",
                                                "sense_id": "2c645701-2d8e-3128-9872-6e8b0927ef6c",
                                                "text": "Daar heb ik wel een paar stuivers voor over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
