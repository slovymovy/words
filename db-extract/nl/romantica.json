                        "examples": [
                            {
                                "example_id": "f80ff8b3-d2d6-4ff6-b96c-bf525aae0c2d",
                                "sense_id": "270e8dc7-b17b-3030-9cf9-9c86f07fcb26",
                                "text": "De twee waren sinds 2009 samen. Ze kregen een dochter, Linde, en zoon Goof. Susans boek En dan de liefde: lotgevallen van een romantica kwam begin dit jaar uit."
                            },
                            {
