                    {
                        "sense_id": "cda8f5f2-db94-3c8a-834e-41f09116937f",
                        "entry_id": "e3102d1f-572b-37c2-84d8-7263abfecdc0",
                        "glosses": [
                            "christologischer Hoheitstitel und Selbstbezeichnung Jesu (immer distanzierend in der 3. Person Singular), womit dieser Charakter und Amt des Messias für sich in Anspruch nimmt"
                        ],
                        "tags": [
                            "Christliche Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "abb69d3c-63e2-4177-b2a5-a768472dc60a",
                                "sense_id": "cda8f5f2-db94-3c8a-834e-41f09116937f",
                                "text": "„Der Menschensohn, irdisch so arm, daß er nichts hat, wo er sein Haupt hinlege, ist gekommen, selig zu machen; sein Zeichen wird am Jüngsten Tage am Himmel aufleuchten und er in der Herrlichkeit des Vaters wiedererscheinen, um jeglichem zu vergelten nach seinen Werken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
