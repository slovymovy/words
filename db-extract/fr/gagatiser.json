                "senses": [
                    {
                        "sense_id": "1422a5ed-03d3-376e-b5b4-33c1eee87022",
                        "entry_id": "ef4e19f5-d76f-3a73-9a42-7ce14e19d528",
                        "glosses": [
                            "Retomber en enfance, devenir sénile, gâtifier, être gâteux ou gaga, ou en présenter l’apparence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5acfaf6f-4cc6-4c3d-b9e8-dba1a7b8178e",
                                "sense_id": "1422a5ed-03d3-376e-b5b4-33c1eee87022",
                                "text": "Ils gagatisent devant leur nouveau-né."
                            },
                            {
                                "example_id": "620918fb-0457-4556-ba3e-8e3a64478d80",
                                "sense_id": "1422a5ed-03d3-376e-b5b4-33c1eee87022",
                                "text": "Lorsqu’ils parviennent à garder leur sérieux et à parler de moi sans gagatiser, les scientifiques me décrivent généralement comme un animal trapu, au pelage épais, brun-gris, avec des oreilles rondes, une tête large, un arrière-train court et une queue sans poils, de petite taille."
                            }
                        ]
                    }
                ],
