                    },
                    {
                        "form_id": "5633da04-05dd-4522-91eb-4717e0be2bf0",
                        "entry_id": "db544919-9bd0-31b6-b4c1-1a516e539cad",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вы́прямив"
                    },
                    {
                        "form_id": "f4aae5dd-dfd9-4d82-b3e0-0be5e43cd6e0",
                        "entry_id": "db544919-9bd0-31b6-b4c1-1a516e539cad",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вы́прямивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88a98815-d123-3b09-98f3-cd0b1fc138fb",
                        "entry_id": "db544919-9bd0-31b6-b4c1-1a516e539cad",
                        "glosses": [
                            "сделать прямым (что-нибудь согнувшееся, покривившееся), устранить кривизну, неровность"
                        ],
                        "tags": [
                            "что."
                        ],
                        "examples": [
                            {
                                "example_id": "6a21d2ae-4abc-4beb-8ccc-33aefe56a027",
                                "sense_id": "88a98815-d123-3b09-98f3-cd0b1fc138fb",
                                "text": "Яркий румянец вспыхнул на лице Вареньки; она выпрямила свой тонкий, стройный стан, гордо приподняла головку, и ― да простит ей Бог!"
                            },
                            {
                                "example_id": "fc356903-2dc1-49a5-9a78-3bd4bdffd27d",
                                "sense_id": "88a98815-d123-3b09-98f3-cd0b1fc138fb",
                                "text": "Так, чтобы выпрямить дерево, которое долго гнул ветер в одну сторону, надо насильственно перегибать его в другую."
                            },
                            {
                                "example_id": "d483be5c-f102-40cc-b1cc-06f787448bd8",
                                "sense_id": "88a98815-d123-3b09-98f3-cd0b1fc138fb",
                                "text": "Да: разогнуть дикую кривую, выпрямить её по касательной ― асимптоте ― по прямой."
                            }
                        ]
                    },
                    {
                        "sense_id": "9365c785-1fa3-39b2-b1ee-679ab64f4327",
                        "entry_id": "db544919-9bd0-31b6-b4c1-1a516e539cad",
                        "glosses": [
                            "проф. преобразовать переменный электрический ток в постоянный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b33f977-14ef-4efb-9af0-c36a12c3101b",
                                "sense_id": "9365c785-1fa3-39b2-b1ee-679ab64f4327",
                                "text": "Наконец, в тех случаях, когда требуется выпрямить токи очень больших мощностей (до 200 А при напряжении до 50 кВ), в качестве вентилей применяют так называемые ртутные выпрямители."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdb8248c-aa3f-4fb3-8a0c-ddfd73c7644c",
                        "source_entry_id": "db544919-9bd0-31b6-b4c1-1a516e539cad",
                        "target_lang_word": "redresser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redresser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Rendre droite une chose qui l’avait été auparavant, ou qui devait l’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cbcf39-6e57-4467-8394-9a14904c1476",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Redresser une planche courbée."
                                            },
                                            {
                                                "example_id": "5684d25b-33f8-4ad2-85d4-097c5f746ae2",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Redresser un arbre qui penche."
                                            },
                                            {
                                                "example_id": "34d30c2a-f408-45be-9808-0a9481c57205",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Redresser un bâton."
                                            },
                                            {
                                                "example_id": "4d6ea605-8720-40f1-8f24-1ab6285259e0",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Redresser la tête."
                                            },
                                            {
                                                "example_id": "d034bf07-2124-4e06-981f-971a9d69bfd7",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "On a fait porter un appareil à cet enfant pour lui redresser la colonne vertébrale."
                                            },
                                            {
                                                "example_id": "8bcf5dae-11c0-4206-b383-85eb8b644939",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Un arbre qui se redresse après avoir été courbé avec effort."
                                            },
                                            {
                                                "example_id": "779cde45-1397-44f9-b7ca-05c97684a059",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Redresser le jugement, l’esprit, les idées de quelqu’un."
                                            },
                                            {
                                                "example_id": "fe29db0b-8186-4d8a-abb2-c11338e7814d",
                                                "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                                                "text": "Redresser les torts, secourir les opprimés, réparer les torts qui leur ont été faits ; cette façon de parler est empruntée aux romans de chevalerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a19d5d71-65d4-3161-929f-f16e93d800d5",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Remettre dans le droit chemin, dans la bonne voie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd86fd1c-3e1d-4bbc-bf9e-d782e06e3cb4",
                                                "sense_id": "a19d5d71-65d4-3161-929f-f16e93d800d5",
                                                "text": "Je me trompais dans mon raisonnement, vous m’avez redressé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de1187e-e523-38f7-a27b-8417c1c19b5f",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Châtier, mortifier."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34ada1b7-20c4-4b6d-9489-0bf11f00230d",
                                                "sense_id": "9de1187e-e523-38f7-a27b-8417c1c19b5f",
                                                "text": "Il faisait l’entendu, l’impertinent ; mais on l’a redressé, on l’a bien redressé."
                                            },
                                            {
                                                "example_id": "96e41cf7-6c9a-4a93-aaa9-04414a7062c7",
                                                "sense_id": "9de1187e-e523-38f7-a27b-8417c1c19b5f",
                                                "text": "Mais elle riait: le travail de tête, oui; tandis que le travail des pieds et des mains, au contraire, lui faisait du bien, la redressait comme un jeune arbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35c1462-9f9b-3494-9265-e3926f32de0f",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Élever, ériger de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb9d315-770d-4275-b9db-94dc26cb7c5f",
                                                "sense_id": "c35c1462-9f9b-3494-9265-e3926f32de0f",
                                                "text": "Redresser une statue abattue, un monument renversé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68804e9-641d-3f30-8f4b-3b2e0c10763d",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Transformer un courant alternatif en courant continu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f165a97b-fdcb-3ff0-86eb-66864b6225f2",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Prendre une position droite."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed2e88da-8327-4aca-b4d9-2a23416f8d35",
                                                "sense_id": "f165a97b-fdcb-3ff0-86eb-66864b6225f2",
                                                "text": "Vers la droite, l’un des aéroplanes piqua follement du nez, se redressa presque perpendiculairement, explosa avec un bruit énorme et s’abîma en flammes dans la mer."
                                            },
                                            {
                                                "example_id": "5c085975-8220-438e-9d08-133f148e123e",
                                                "sense_id": "f165a97b-fdcb-3ff0-86eb-66864b6225f2",
                                                "text": "Puis, s'appuyant sur les accoudoirs de cuir usé, Gérard sortit sa grande carcasse du confortable fauteuil et se redressa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c7a8237-8b04-36b3-be15-89027409e73a",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Commencer à se redresser se dit figurément de tous ceux qui paraissent enorgueillis de quelque nouvel avantage, de quelque nouveau succès."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d846d19-a9b0-3bca-ba1e-40ca1dfaab26",
                                        "entry_id": "1abda3a4-db20-34cc-8f39-6243ad2ce3a4",
                                        "glosses": [
                                            "Reprendre contenance ; retrouver de l’énergie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c841ed7-17cd-4012-991b-794cba2c03be",
                                                "sense_id": "7d846d19-a9b0-3bca-ba1e-40ca1dfaab26",
                                                "text": "Puis, sous l'effet combiné d'une reprise dans l’industrie sidérurgique et de la réduction des importations par l’imposition de droits compensateurs, tant aux États-Unis que dans la Communauté européenne, le marché du ferrosilicium s’est redressé au cours du dernier trimestre de 1994."
                                            },
                                            {
                                                "example_id": "bca664f9-b5a0-43d5-83f1-d8328bb3c7e4",
                                                "sense_id": "7d846d19-a9b0-3bca-ba1e-40ca1dfaab26",
                                                "text": "Se redresser sous l’outrage."
                                            },
                                            {
                                                "example_id": "5d48d96d-de86-4fff-8e56-35255a91721d",
                                                "sense_id": "7d846d19-a9b0-3bca-ba1e-40ca1dfaab26",
                                                "text": "Devant cet affront, il s’est redressé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
