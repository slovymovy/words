                    {
                        "translation_id": "f3a17f40-65ef-4597-b706-c86b11622fe8",
                        "source_entry_id": "e9525f7f-4908-3746-bf20-0b89dd22a857",
                        "source_sense_id": "c2b335c2-d146-3733-a88e-d6d122773033",
                        "target_lang_word": "Neutralität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neutralität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "341bb06b-6c61-3ef8-9e57-ad5a45c8bce2",
                                        "entry_id": "b9b310d3-bfa7-39e1-a3ea-d2af180dca8e",
                                        "glosses": [
                                            "unparteiische, unvoreingenommene Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a055d8-d8d0-47c8-94d5-113ab166d1f2",
                                                "sense_id": "341bb06b-6c61-3ef8-9e57-ad5a45c8bce2",
                                                "text": "Viele meinen, dass der Staat zu religiöser Neutralität verpflichtet sei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69b9f149-6d57-3d99-9313-2c5f14bdfe6a",
                                        "entry_id": "b9b310d3-bfa7-39e1-a3ea-d2af180dca8e",
                                        "glosses": [
                                            "Haltung eines Staates, sich nicht an einem bestimmten Konflikt oder an Konflikten im Allgemeinen zu beteiligen und keine Konfliktpartei zu unterstützen"
                                        ],
                                        "tags": [
                                            "Völkerrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "111946c0-1fe3-43d1-b3c2-2713c8da8d94",
                                                "sense_id": "69b9f149-6d57-3d99-9313-2c5f14bdfe6a",
                                                "text": "Die dauernde Neutralität ist ein Grundsatz der schweizerischen Außenpolitik."
                                            },
                                            {
                                                "example_id": "22a87886-ca36-4a03-be27-208d799b62fb",
                                                "sense_id": "69b9f149-6d57-3d99-9313-2c5f14bdfe6a",
                                                "text": "Eine große Mehrheit der Schweizer lehnt einen EU-Beitritt ab, vor allem wegen der Sorge um Neutralität."
                                            },
                                            {
                                                "example_id": "b2785fca-1f3e-473c-a0a8-dddc0655950b",
                                                "sense_id": "69b9f149-6d57-3d99-9313-2c5f14bdfe6a",
                                                "text": "„Amerikaner waren bisher noch nicht offiziell aufgetreten: ihre zweijährige gewinnbringende Neutralität wurde erst durch den Schlag von Pearl Harbour beendet.“"
                                            },
                                            {
                                                "example_id": "ddacd02f-663a-4601-8bc6-97a4204838d5",
                                                "sense_id": "69b9f149-6d57-3d99-9313-2c5f14bdfe6a",
                                                "text": "„Frankreich hatte nichts gegen diesen Plan einzuwenden, zumal die Türkei zur gleichen Zeit ihre Neutralität erklärte, sollte in Europa ein neuer Krieg ausbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0e4d5c6d-1790-38e4-af74-9736e9b5495f",
                                        "entry_id": "b9b310d3-bfa7-39e1-a3ea-d2af180dca8e",
                                        "glosses": [
                                            "Eigenschaft einer chemischen Verbindung, weder sauer noch basisch zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5328ae92-0a7a-4b89-af0c-2e423a954bb9",
                                                "sense_id": "0e4d5c6d-1790-38e4-af74-9736e9b5495f",
                                                "text": "Man stellte fest, dass die Lösung den pH-Wert 7 hat und zeigte damit ihre Neutralität."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b3800f53-a66f-3180-8240-020f0d9e5d62",
                                        "entry_id": "b9b310d3-bfa7-39e1-a3ea-d2af180dca8e",
                                        "glosses": [
                                            "Eigenschaft, auf etwas Bestimmtes keinen Einfluss zu nehmen"
                                        ],
                                        "tags": [
                                            "meist in Zusammensetzungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed78b0f-6296-4b48-b8f7-eb21438c8c8b",
                                                "sense_id": "b3800f53-a66f-3180-8240-020f0d9e5d62",
                                                "text": "Viele bezweifeln die CO₂-Neutralität von Atomenergie (= bezweifeln, dass bei der Erzeugung von Atomenergie kein CO₂ frei wird)."
                                            },
                                            {
                                                "example_id": "c315fd5e-6c24-4a59-bbf4-74bf18c20a4b",
                                                "sense_id": "b3800f53-a66f-3180-8240-020f0d9e5d62",
                                                "text": "Wenn also ein Unternehmen in Bayern eine gewisse Menge CO₂ ausstößt, dafür aber in Eritrea […] Treibhausgase in der gleichen Menge reduziert werden, ist unterm Strich Neutralität hergestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
