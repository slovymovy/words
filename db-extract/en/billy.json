                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a15858ac-479f-3c6c-9a69-ef1da115deca",
                                        "entry_id": "9e64a51e-3b50-3eeb-bae8-661c699f0dc3",
                                        "glosses": [
                                            "männliches Ziegentier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ddefe3a-914b-4714-b191-1b96cce6cd01",
                                                "sense_id": "a15858ac-479f-3c6c-9a69-ef1da115deca",
                                                "text": "Vor dem recht wilden Ziegenbock im Streichelzoo haben viele Kinder ein bisschen Angst."
                                            },
                                            {
                                                "example_id": "2db64d2f-44f8-4dee-9e54-8d849652668a",
                                                "sense_id": "a15858ac-479f-3c6c-9a69-ef1da115deca",
                                                "text": "„Der Ziegenbock meckerte, als wäre er darüber erbost.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
