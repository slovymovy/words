                        "sense_id": "89c62017-bba6-3c1d-9cf0-020089e30c6b",
                        "entry_id": "da50c0eb-4472-3678-80d8-5e6a8c423d2f",
                        "glosses": [
                            "bedrijf of een deel van een bedrijf waar producten geslepen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7d4671-aab8-4b5d-8da5-ea91a743d7b2",
                                "sense_id": "89c62017-bba6-3c1d-9cf0-020089e30c6b",
                                "text": "De luchthavenverkoop is inmiddels goed voor een derde van de omzet en tweehonderd van de vijfhonderd personeelsleden van de firma, die naast de slijperij bij het Waterlooplein ook een juwelierszaak op de Dam uitbaat."
                            },
                            {
                                "example_id": "f87e1b42-60f9-4067-b5fc-726e3164b8cb",
                                "sense_id": "89c62017-bba6-3c1d-9cf0-020089e30c6b",
                                "text": "De slijperij dacht dat de kostbare diamant in een afvalbak was gevallen, maar niets bleek minder waar. Op camerabeelden is te zien dat de schoonmaker verdachte bewegingen met zijn poetsdoek maakt."
                            }
                        ]
                    }
