                ],
                "senses": [
                    {
                        "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                        "entry_id": "585cd0fa-962e-3809-b7c6-43353e68627d",
                        "glosses": [
                            "Grenzbereich zwischen einer Wiese und dem angrenzenden Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6c5eed-bf23-4d79-b34f-9fbbc7f0c34d",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Am Wiesenrand steht ein alter Mirabellenbaum, darunter eine Liege, genau der richtige Platz, um dort ein Mittagsschläfchen zu halten oder einfach nur eine gute Zeit zu haben.“"
                            },
                            {
                                "example_id": "b2fa4754-3337-45f5-b4ee-c9451ba5a8ae",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "[Das Habichtskraut:] „Wer ländlich wohnt, kann sich gegen diese Pflanze kaum wehren, denn sie ist überall am Wiesenrand und an Straßen zu finden.“"
                            },
                            {
                                "example_id": "5d5a3473-f8a1-4db6-a6c2-0bae938765b9",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„\"Der Holunder sucht die Nähe des Menschen\", sagt man. In der Tat wächst er am liebsten im Schutze alter Scheunen, nah bei den Häusern und Höfen, an Wiesenrändern oder entlang von Bahngleisen.“"
                            },
                            {
                                "example_id": "b03eda3d-fe9a-43f7-9672-2b57db31c3f5",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Auf einer Schmetterlingswiese finden Großes Ochsenauge, Schachbrettfalter und Spanische Flagge reichlich Nektar. Eine Nisthilfe am Wiesenrand bietet Brutröhren für Wildbienen.“"
                            },
                            {
                                "example_id": "18990328-f358-4d0f-bdb5-7ea57447c4ff",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Im Herbst findet man Beeren und Pilze, im Frühling muss man sich mit Wildkräutern bescheiden. Sie wachsen vor allem an Wald- und Wiesenrändern.“"
                            },
                            {
                                "example_id": "f8795e8d-4ba1-40eb-ba9f-416bcb43bece",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Mit seinen Schilf- und Wiesenrändern ist der Degerndorfer Weiher zwar sehr idyllisch, aber auch pflegeintensiv.“"
                            },
                            {
                                "example_id": "765c32a5-1776-47fe-a872-77489cfb7ee4",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Nur die von Kastanien gesäumten Wiesenränder spenden Schatten, der Großteil [der Wiese] liegt in der Sonne, […].“"
                            },
                            {
                                "example_id": "d392917f-d13c-44cd-ae12-dc6582af46a6",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Im Einsatz waren ein Hubschrauber sowie insgesamt rund 100 Kräfte der Augsburger Polizei und der Bereitschaftspolizei Königsbrunn. Sie haben Ackerflächen, Wiesenränder und das Flüsschen Schmutter nach den verschwundenen Frauen durchkämmt.“"
                            },
                            {
                                "example_id": "1a101340-d16d-432e-beab-901979027eed",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Der Weg führt uns dann stetig bergab bis zur Landstraße. Auf der anderen Straßenseite geht es auf dem Weg am Wiesenrand entlang weiter.“"
                            },
                            {
                                "example_id": "753e6379-267a-452e-9cd2-f720322ee9c7",
                                "sense_id": "f6414d57-ef13-31e9-90a6-a71935bc451b",
                                "text": "„Wer heute nach Tölz kommt und im Garten der Villa spazieren geht, kann am Wiesenrand einen Steinhügel sehen: das Grab von Moritz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
