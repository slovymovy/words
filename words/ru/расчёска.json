    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72a32c09-74b4-33fd-b5c9-709fafd161ec",
                    "sense_definition": "Предмет гигиены в виде пластинки с рядом зубьев или щетки, используемый для приведения волос в порядок.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comb_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Утром она не смогла быстро найти свою деревянную <w>расчёску</w>.",
                            "target_lang_translations": {
                                "nl": "'s Ochtends kon ze haar houten <w>kam</w> niet snel vinden."
                            }
                        },
                        {
                            "text": "Перед выходом из дома он всегда приглаживает волосы мелкой <w>расчёской</w>.",
                            "target_lang_translations": {
                                "nl": "Voordat hij van huis weggaat, strijkt hij zijn haar altijd glad met een fijne <w>kam</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "гребень",
                        "гребёнка"
                    ],
                    "common_phrases": [
                        "деревянная расчёска",
                        "массажная расчёска",
                        "зубья расчёски"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een voorwerp met tanden of een borstel, gebruikt voor het ontwarren en in model brengen van het haar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kam",
                                "target_lang_sense_clarification": "met tanden"
                            },
                            {
                                "target_lang_word": "haarborstel",
                                "target_lang_sense_clarification": "borstel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33ff5f3d-4a7d-346a-8ad1-e055454d34aa",
                    "sense_definition": "Действие по значению глаголов расчесать, расчёсывать; приведение волос, шерсти или волокон в порядок.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comb_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При качественной <w>расчёске</w> льна волокна становятся значительно мягче и ровнее.",
                            "target_lang_translations": {
                                "nl": "Bij een kwalitatieve <w>kamming</w> van vlas worden de vezels aanzienlijk zachter en gelijkmatiger."
                            }
                        },
                        {
                            "text": "После долгой <w>расчёски</w> густой шерсти собака выглядела очень аккуратно.",
                            "target_lang_translations": {
                                "nl": "Na een lange <w>borstelbeurt</w> van de dikke vacht zag de hond er erg netjes uit."
                            }
                        }
                    ],
                    "synonyms": [
                        "расчёсывание"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het kammen of borstelen van haar, wol of vezels."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het kammen",
                                "target_lang_sense_clarification": "handeling"
                            },
                            {
                                "target_lang_word": "het borstelen",
                                "target_lang_sense_clarification": "handeling met een borstel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
