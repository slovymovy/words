                "translations": [
                    {
                        "translation_id": "1cbfa147-1b8c-4918-9245-8f818e3517c5",
                        "source_entry_id": "e13b13ce-7281-3d18-b247-2a367d0c4990",
                        "source_sense_description": "digression",
                        "target_lang_word": "digression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digression",
