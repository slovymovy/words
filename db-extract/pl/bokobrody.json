                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28db8f4b-400f-33b6-bd38-7303fda6b280",
                                        "entry_id": "d46d5eab-3803-3cbc-aae0-4f8467840437",
                                        "glosses": [
                                            "Masculin pluriel de favori."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f406b7ba-1e72-4356-a264-95918f37f6ec",
                                                "sense_id": "28db8f4b-400f-33b6-bd38-7303fda6b280",
                                                "text": "Et il s’y livre à ses goûts favoris : goûts invétérés de Méridional que Paris n’a pu déméridionaliser !"
                                            }
                                        ]
