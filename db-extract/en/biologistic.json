                                            {
                                                "example_id": "1ad2b81d-0210-41a0-a8d0-138b2a324a9e",
                                                "sense_id": "fe40e0d6-cf69-31e0-ad10-1ac6536d31b0",
                                                "text": "Der Sozialdarwinismus ist eine extreme biologistische Ideologie."
                                            },
                                            {
                                                "example_id": "19bdf8a0-99ad-4c37-a90b-b1b8660cffe0",
                                                "sense_id": "fe40e0d6-cf69-31e0-ad10-1ac6536d31b0",
                                                "text": "„In der zweiten Hälfte des 19. Jahrhunderts hat sich der Biologismus des Denkens in verschiedenen Distrikten der Wissenschaften vom Menschen bemächtigt. Biologistische Interpretationen fanden in der Soziologie, in der Kulturanthropologie, in der Geschichtsschreibung und in der Rechtswissenschaft starken Nachklang.“"
                                            },
                                            {
                                                "example_id": "b813fc37-581a-4bb7-9dc9-1921f4a74021",
                                                "sense_id": "fe40e0d6-cf69-31e0-ad10-1ac6536d31b0",
                                                "text": "„Der Sozialdarwinismus war eingebettet in ein biologistisches Weltbild, das mit dem Siegeszug der Naturwissenschaften zunehmend dominant wurde.“"
                                            }
                                        ],
