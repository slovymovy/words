{
    "word_family": [
        "zwabberen",
        "gezwabber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bd16ad2-59cf-32eb-9bd0-b4b52d21e13e",
                    "sense_definition": "een schoonmaakhulpmiddel bestaande uit een bundel draden aan een steel om vloeren te reinigen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaakgerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schoonmaker gebruikt een natte <w>zwabber</w> om de keukenvloer weer helemaal glanzend te maken.",
                            "target_lang_translations": {
                                "en": "The cleaner uses a wet <w>mop</w> to make the kitchen floor completely shiny again."
                            }
                        },
                        {
                            "text": "Hij pakte de <w>zwabber</w> en begon direct met het vloer dweilen nadat hij sap had gemorst.",
                            "target_lang_translations": {
                                "en": "He grabbed the <w>mop</w> and immediately started mopping the floor after he spilled juice."
                            }
                        }
                    ],
                    "synonyms": [
                        "mop",
                        "dweil"
                    ],
                    "common_phrases": [
                        "natte zwabber",
                        "met de zwabber dweilen"
                    ],
                    "target_lang_definitions": {
                        "en": "a cleaning tool consisting of a bundle of strings or cloth on a handle used for cleaning floors"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "cleaning tool"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32684a5c-03ee-35db-bc89-c4c67d69def8",
                    "sense_definition": "een persoon die wankelt of zwalkt, vaak als gevolg van overmatig alcoholgebruik",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoonskenmerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het feestje liep de oude <w>zwabber</w> onvast over de straat naar huis.",
                            "target_lang_translations": {
                                "en": "After the party, the old <w>drunkard</w> walked unsteadily down the street toward home."
                            }
                        },
                        {
                            "text": "Iedereen in het dorp kende hem als een goedaardige <w>zwabber</w> die vaak in de kroeg zat.",
                            "target_lang_translations": {
                                "en": "Everyone in the village knew him as a good-natured <w>drunk</w> who was often in the pub."
                            }
                        }
                    ],
                    "synonyms": [
                        "dronkenlap",
                        "zatlap",
                        "zuipschuit",
                        "zwalper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik voor een dronkaard"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who staggers or wobbles, often as a result of excessive alcohol consumption"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drunkard",
                                "target_lang_sense_clarification": "habitual drinker"
                            },
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "slang for a drunk person"
                            },
                            {
                                "target_lang_word": "drunk",
                                "target_lang_sense_clarification": "intoxicated person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6701e384-f785-3250-a60f-b84e1a5f4a08",
                    "sense_definition": "iemand zonder vaste woon- of verblijfplaats die rondzwerft",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoonskenmerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arme <w>zwabber</w> sliep onder de brug om beschutting te vinden tegen de regen.",
                            "target_lang_translations": {
                                "en": "The poor <w>tramp</w> slept under the bridge to find shelter from the rain."
                            }
                        },
                        {
                            "text": "Hij leefde jarenlang als een <w>zwabber</w> en trok van stad naar stad zonder doel.",
                            "target_lang_translations": {
                                "en": "He lived for years as a <w>vagabond</w>, moving from city to city without a goal."
                            }
                        }
                    ],
                    "synonyms": [
                        "landloper",
                        "zwerver"
                    ],
                    "target_lang_definitions": {
                        "en": "someone without a fixed place of residence who wanders around"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tramp",
                                "target_lang_sense_clarification": "homeless wanderer"
                            },
                            {
                                "target_lang_word": "vagabond",
                                "target_lang_sense_clarification": "person without a home"
                            },
                            {
                                "target_lang_word": "drifter",
                                "target_lang_sense_clarification": "person moving from place to place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b0f9fcf-0a19-30c0-8929-69ed7003cba9",
                    "sense_definition": "een scheepsjongen of matroos met de laagste rang die belast is met eenvoudige schoonmaakklusjes",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als jonge <w>zwabber</w> moest hij elke ochtend het houten dek van het schip schrobben.",
                            "target_lang_translations": {
                                "en": "As a young <w>swab</w>, he had to scrub the ship's wooden deck every morning."
                            }
                        },
                        {
                            "text": "De kapitein gaf de <w>zwabber</w> de opdracht om de kajuit onmiddellijk schoon te maken.",
                            "target_lang_translations": {
                                "en": "The captain ordered the <w>cabin boy</w> to clean the cabin immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheepsjongen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in maritieme context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a cabin boy or sailor of the lowest rank responsible for simple cleaning tasks"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swab",
                                "target_lang_sense_clarification": "low-ranking sailor"
                            },
                            {
                                "target_lang_word": "cabin boy",
                                "target_lang_sense_clarification": "boy working on a ship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5548a557-7ac3-3424-bac8-f7c0590714be",
                    "sense_definition": "iemand die zeer onverantwoordelijk leeft en alleen maar van feest naar feest gaat",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "persoonskenmerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn ouders vonden hem een echte <w>zwabber</w> omdat hij nooit een serieuze baan zocht.",
                            "target_lang_translations": {
                                "en": "His parents thought he was a real <w>wastrel</w> because he never looked for a serious job."
                            }
                        },
                        {
                            "text": "Die <w>zwabber</w> geeft al zijn geld uit aan drank en uitgaan in de stad.",
                            "target_lang_translations": {
                                "en": "That <w>party animal</w> spends all his money on drinks and going out in the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuifbeest",
                        "fuifnummer",
                        "doordraaier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele aanduiding voor een losbol"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "someone who lives very irresponsibly and only goes from party to party"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "party animal",
                                "target_lang_sense_clarification": "person who loves partying"
                            },
                            {
                                "target_lang_word": "wastrel",
                                "target_lang_sense_clarification": "irresponsible person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7624354-9e0d-30ae-a871-cce9e0f6a805",
                    "sense_definition": "een persoon die zichzelf of zijn omgeving niet goed schoonhoudt",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "persoonskenmerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Was je handen eens, je ziet eruit als een vieze <w>zwabber</w> na dat werk in de tuin.",
                            "target_lang_translations": {
                                "en": "Wash your hands for once; you look like a dirty <w>slob</w> after that work in the garden."
                            }
                        },
                        {
                            "text": "Niemand wilde naast die <w>zwabber</w> zitten vanwege de sterke geur van vuil.",
                            "target_lang_translations": {
                                "en": "No one wanted to sit next to that <w>sloven</w> because of the strong smell of dirt."
                            }
                        }
                    ],
                    "synonyms": [
                        "smeerpoets"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en licht beledigend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who does not keep themselves or their environment clean"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sloven",
                                "target_lang_sense_clarification": "untidy person"
                            },
                            {
                                "target_lang_word": "slob",
                                "target_lang_sense_clarification": "lazy and dirty person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94540fd0-f274-3eaf-8035-8e4271c11560",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>zwabberen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zwabber</w> elke zaterdagochtend de vloer van de woonkamer om alles schoon te houden.",
                            "target_lang_translations": {
                                "en": "I <w>mop</w> the living room floor every Saturday morning to keep everything clean."
                            }
                        },
                        {
                            "text": "Terwijl ik de gang <w>zwabber</w>, luister ik graag naar mijn favoriete muziek.",
                            "target_lang_translations": {
                                "en": "While I <w>mop</w> the hallway, I like to listen to my favorite music."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ik-vorm van het werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'to mop' or 'to stagger'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "to clean with a mop"
                            },
                            {
                                "target_lang_word": "stagger",
                                "target_lang_sense_clarification": "to walk unsteadily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc79602-9cb0-3bac-b64a-db3581d9af90",
                    "sense_definition": "de gebiedende wijs van <w>zwabberen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zwabber</w> die vloer nu direct voordat het vuil intrekt!",
                            "target_lang_translations": {
                                "en": "<w>Mop</w> that floor right now before the dirt soaks in!"
                            }
                        },
                        {
                            "text": "Alsjeblieft, <w>zwabber</w> even de keuken nadat je klaar bent met koken.",
                            "target_lang_translations": {
                                "en": "Please, <w>mop</w> the kitchen for a moment after you're done cooking."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of 'to mop' or 'to stagger'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "command to clean"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}