                "senses": [
                    {
                        "sense_id": "8d09f67c-b574-3e3c-98d3-9787921e3295",
                        "entry_id": "eb50cfe9-c333-31aa-bc54-072d50f87845",
                        "glosses": [
                            "Pertaining to or causing tears."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc06642f-72e2-4f3f-91d1-1c3b98ea0a5a",
                                "sense_id": "8d09f67c-b574-3e3c-98d3-9787921e3295",
                                "text": "1919: It is sheer affectation to lacerate a man with the poisonous fragment of a bursting shell and to boggle at making his eyes water by means of lachrymatory gas. — Winston Churchill, \"1919 War Office Memorandum\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f85c8e-0e3c-4159-a662-621405a18448",
                        "source_entry_id": "eb50cfe9-c333-31aa-bc54-072d50f87845",
                        "source_sense_id": "8d09f67c-b574-3e3c-98d3-9787921e3295",
                        "source_sense_description": "causing tears",
                        "target_lang_word": "lacrymogène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacrymogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d926f95c-9088-3f10-ab62-15076de0a029",
                                        "entry_id": "b73739c8-541d-352e-a759-c12ff099bee6",
                                        "glosses": [
                                            "Qui provoque la sécrétion de larmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceccd576-7832-4998-9881-b01d29d70699",
                                                "sense_id": "d926f95c-9088-3f10-ab62-15076de0a029",
                                                "text": "Gaz lacrymogène."
                                            },
                                            {
                                                "example_id": "74cba20d-61a0-4391-a8ac-8fb04cf41ce5",
                                                "sense_id": "d926f95c-9088-3f10-ab62-15076de0a029",
                                                "text": "De mémoire de policier, c’est du jamais-vu : le 5 août, le ministère de l’Intérieur a passé un appel d’offres pour 1,2 million de grenades fumigènes, assourdissantes et lacrymogènes !"
                                            },
                                            {
                                                "example_id": "2a735e39-f98c-4e97-ab67-f3231f620881",
                                                "sense_id": "d926f95c-9088-3f10-ab62-15076de0a029",
                                                "text": "Quelques histoires lacrymogènes, et elles l’écoutaient avec un regard apitoyé…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lacrymogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d30129fc-83d8-3d9c-906b-23ff5c02577a",
                                        "entry_id": "4ffa1072-a6c1-318a-bda4-c218851d02d3",
                                        "glosses": [
                                            "Gaz lacrymogène."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "324fc8ce-307b-4bcb-a013-a3ebccbd4cfb",
                                                "sense_id": "d30129fc-83d8-3d9c-906b-23ff5c02577a",
                                                "text": "Les lacrymogènes n’en péteront que mieux !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b87035e-97e2-42ea-ba95-b6dcc132d2cc",
                        "source_entry_id": "eb50cfe9-c333-31aa-bc54-072d50f87845",
                        "source_sense_id": "8d09f67c-b574-3e3c-98d3-9787921e3295",
                        "source_sense_description": "causing tears",
                        "target_lang_word": "lacrymatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacrymatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2f4826-9d79-339d-a0a6-e5f76b368346",
                                        "entry_id": "e81c8a44-6802-341d-8306-ddd2896085b1",
                                        "glosses": [
                                            "Petit vase de terre cuite ou de verre, déposé dans la plupart des tombeaux, et qui, selon toute apparence, contenait les huiles odorantes dont on parfumait le bûcher avant de l’allumer."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aa48b63-a977-496c-8dac-ca75a3adb460",
                                                "sense_id": "5e2f4826-9d79-339d-a0a6-e5f76b368346",
                                                "text": "on donne le nom de lacrymatoire à ces vases de verre ou de terre cuite, à long cou, à goulot évasé, et dont le ventre est plus large du double que le cou, qu’on trouve assez souvent mêlés aux cendres et ossemens, dans les sarcophages, le urnes cinéraires, et autres sépultures des anciens romains."
                                            },
                                            {
                                                "example_id": "70628402-dd22-4405-a1ab-cc56917f51d5",
                                                "sense_id": "5e2f4826-9d79-339d-a0a6-e5f76b368346",
                                                "text": "Vittorio et Egidio recueillaient leur dû dans un sac de toile qu’ils tendaient aussi lugubrement qu’un lacrymatoire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lacrymatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dda95ae3-917c-38f2-87ca-d6a311fc18e3",
                                        "entry_id": "a9ed3f1c-c27c-375c-be03-707dfecce5c9",
                                        "glosses": [
                                            "Qui concerne ces objets, leur usage."
                                        ],
                                        "tags": [
                                            "Adjectivement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "512889d7-45e1-401c-a697-2301e8be3881",
                                                "sense_id": "dda95ae3-917c-38f2-87ca-d6a311fc18e3",
                                                "text": "j’ajouterai qu’on a trouvé dans des tombeaux, près de l’Inachus, un grand nombre d'objets en terre cuite, tels que des lampes, des patères, des coupes, des vases lacrymatoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0141b571-8c5a-3e82-877e-2cb5bb7adb7f",
                                        "entry_id": "a9ed3f1c-c27c-375c-be03-707dfecce5c9",
                                        "glosses": [
                                            "Qui déclenche le larmoiement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca09f5a8-e70c-46bc-9b16-8675327ed937",
                                                "sense_id": "0141b571-8c5a-3e82-877e-2cb5bb7adb7f",
                                                "text": "Moins gnan-gnan que le vétuste et lacrymatoire retraité, la matrone impatientée finit par répondre : « J’aimerais assez qu’on me confiât d’autres secrets. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
