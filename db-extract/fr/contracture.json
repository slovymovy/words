                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83584eaa-1cde-3de0-9e3b-6e71666f263e",
                        "entry_id": "90f8b107-d767-35ab-abbe-3a5d290a6928",
                        "glosses": [
                            "Rigidité plus ou moins considérable et prolongée des muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33986d87-43d1-4845-b8c6-bd6b32ff6d90",
                                "sense_id": "83584eaa-1cde-3de0-9e3b-6e71666f263e",
                                "text": "À noter que Jonathan se plaint d’une légère contracture à la cuisse, ce qui expliquerait en partie sa course moyenne."
                            },
                            {
                                "example_id": "b6347015-49a7-4251-a993-98d77d7f708b",
                                "sense_id": "83584eaa-1cde-3de0-9e3b-6e71666f263e",
                                "text": "Un défaut d’occlusion de la mâchoire, un mauvais appui du pied sur le sol, des chocs et des traumatismes peuvent également déclencher des contractures et douleurs cervico-dorsales."
                            }
                        ]
                    }
                ],
