                "senses": [
                    {
                        "sense_id": "9ca3ebf4-9b59-30db-b5e0-37bb4e8757d8",
                        "entry_id": "c69ac4ef-8cda-3b92-8aa2-ddb19044392c",
                        "glosses": [
                            "Waffe, die zur Verteidigung eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8690b5a4-ea78-41db-93a6-e18ddd2093c3",
                                "sense_id": "9ca3ebf4-9b59-30db-b5e0-37bb4e8757d8",
                                "text": "„Obwohl die jungen Fleischfresser fast doppelt so groß waren wie der Pflanzenfresser, hielten sie Abstand und wagten nur zaghafte Angriffe während ihre Beute sich zusammenkauerte und ihre Verteidigungswaffen gegen sie richtete.“"
                            },
                            {
                                "example_id": "be217543-ff33-4822-acf4-cfa555165c87",
                                "sense_id": "9ca3ebf4-9b59-30db-b5e0-37bb4e8757d8",
                                "text": "„LANCE (Laser Advancement for Next Generation Compact Environment) ist Teil des SHiELD-Programms (Self-protect High Energy Laser Demonstrator) der USAF und zielt, wie der Name schon sagt, darauf ab, keine Angriffswaffe, sondern eine Verteidigungswaffe zu entwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
