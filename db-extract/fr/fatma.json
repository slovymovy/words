                            {
                                "example_id": "64b89644-cc61-40c6-ba66-a6e41ed346ea",
                                "sense_id": "17daf2ab-4a76-3b39-b97e-3a06d9cf8c61",
                                "text": "Car il restait une épine dans le pied de l’armée française. Une écharde empoisonnée, profondément plantée dans ses chairs, et qui, à tout moment, risquait d’infecter l’ensemble du corps expéditionnaire. Cette écharde, c’était Lalla Fatma N’Soumer. La sorcière."
                            }
                        ]
                    }
