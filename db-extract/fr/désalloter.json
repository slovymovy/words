                                "example_id": "b7deb4a5-2f56-41bf-8e47-bbead2a21113",
                                "sense_id": "d863b93c-a4c8-33ed-80c7-2ea8be688c92",
                                "text": "Noter qu’il est possible de désalloter."
                            }
                        ]
