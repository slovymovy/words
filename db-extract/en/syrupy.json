                    {
                        "translation_id": "ac9dc7d0-4fea-4363-8a56-0462714c0557",
                        "source_entry_id": "a3b0516b-3488-3be5-9a7d-a0ca3c75722b",
                        "source_sense_description": "having the taste or consistency or syrup",
                        "target_lang_word": "siropeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siropeux",
