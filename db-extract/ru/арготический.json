                        ]
                    },
                    {
                        "translation_id": "2c267fe4-aac6-4645-a551-93b84a23126b",
                        "source_entry_id": "24b0c4f7-180a-3f46-a4e5-05c7e06c250f",
                        "target_lang_word": "slang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd24ace3-620d-30cf-b24d-5aae202d17ac",
                                        "entry_id": "d2859c53-fdb4-3f02-ac02-b51f3ca910cf",
                                        "glosses": [
                                            "Language outside of conventional usage and in the informal register."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31ebdcf-a7a1-4d6a-81fb-d31b1aa291bb",
                                                "sense_id": "bd24ace3-620d-30cf-b24d-5aae202d17ac",
                                                "text": "She was amused by his talk, which was simple, straightforward, rather humorous and keen, and interspersed with homely expressions of a style which is sometimes called slang."
                                            },
                                            {
                                                "example_id": "47bc603e-7c99-4c71-bedd-c613dfcb7cbb",
                                                "sense_id": "bd24ace3-620d-30cf-b24d-5aae202d17ac",
                                                "text": "English-speaking Australians have always had a love affair with slang."
                                            },
                                            {
                                                "example_id": "ed0bf76e-4b79-4aa2-97c2-7152388d598d",
                                                "sense_id": "bd24ace3-620d-30cf-b24d-5aae202d17ac",
                                                "text": "After years when I met a friend inside the aircraft and could sense stiffness in the conversation, a whiff of mild slang was the ice breaker, followed by loads of campus nostalgia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df31f908-36f8-3c90-a7b7-48fd9cafb20b",
                                        "entry_id": "d2859c53-fdb4-3f02-ac02-b51f3ca910cf",
                                        "glosses": [
                                            "Language that is unique to a particular profession or subject; jargon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a82d636-fe12-3040-8da2-bcb15a7a0916",
                                        "entry_id": "d2859c53-fdb4-3f02-ac02-b51f3ca910cf",
                                        "glosses": [
                                            "The specialized language of a social group, sometimes used to conceal one's meaning from outsiders; cant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e098c3-93df-401d-b778-eff10d26ca4e",
                                                "sense_id": "2a82d636-fe12-3040-8da2-bcb15a7a0916",
                                                "text": "\"Oh, there are so many superior teas and sugars now. Superior is getting to be shopkeepers' slang. / \"Are you beginning to dislike slang, then?\" said Rosamond, with mild gravity. / \"Only the wrong sort. All choice of words is slang. It marks a class.\" / \"There is correct English: that is not slang.\" / \"I beg your pardon: correct English is the slang of prigs who write history and essays. And the strongest slang of all is the slang of poets.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c983b83-9902-313e-94f2-46fdb8032b13",
                                        "entry_id": "d2859c53-fdb4-3f02-ac02-b51f3ca910cf",
                                        "glosses": [
                                            "A particular variety of slang; the slang used by a particular group."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7e578b-213a-4130-9dd0-b7b77c813317",
                                                "sense_id": "8c983b83-9902-313e-94f2-46fdb8032b13",
                                                "text": "[F]or a detailed analysis see Liberman (2008 157ff) who sees it as one of a number of terms found in pan-European slangs meaning concealment and/or cheating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78594438-821d-34dd-ba55-b376e92e7685",
                                        "entry_id": "d2859c53-fdb4-3f02-ac02-b51f3ca910cf",
                                        "glosses": [
                                            "An item of slang; a slang word or expression."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c387fdf-109b-4dee-bc55-60b3791cc024",
                                                "sense_id": "78594438-821d-34dd-ba55-b376e92e7685",
                                                "text": "Anyway, I have learned many slangs while I am in New York, and one of them, a remarkable slang, is sheister."
                                            },
                                            {
                                                "example_id": "d30b7c53-91cc-4f0f-9cdf-67251d2ebd8c",
                                                "sense_id": "78594438-821d-34dd-ba55-b376e92e7685",
                                                "text": "The internet comes up with so many slangs used by people to survive in the online world. Many of those slangs are in the form of abbreviations, for instance, the word \"u\" which refers to \"you\"[.]"
                                            },
                                            {
                                                "example_id": "a1a2b238-492b-49d5-aaa7-6f4e8adfec6e",
                                                "sense_id": "78594438-821d-34dd-ba55-b376e92e7685",
                                                "text": "More importantly and closer to life, slangs help build an instant intimacy and informality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da842508-e2ef-3c0f-ae8c-1ca677c44645",
                                        "entry_id": "d2859c53-fdb4-3f02-ac02-b51f3ca910cf",
                                        "glosses": [
                                            "A curse word."
                                        ],
                                        "tags": [
                                            "India",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b645b43a-fd7f-4719-85e7-c7c3099316be",
                                                "sense_id": "da842508-e2ef-3c0f-ae8c-1ca677c44645",
                                                "text": "Such attempts were made even more aggressive by the fact that these local women were known for picking fights easily and using slangs to verbally abuse their neighbours."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "559df55f-a900-3d5c-b7e0-80c7c477f38b",
                                        "entry_id": "608aebb5-0638-3d7c-ab23-9c72e3d64cc2",
                                        "glosses": [
                                            "To vocally abuse, or shout at."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbdc41bd-805f-45f8-9347-a1489081f4fc",
                                                "sense_id": "559df55f-a900-3d5c-b7e0-80c7c477f38b",
                                                "text": "Also, he had to keep his temper when he was slanged in the theatre porch by a policeman."
                                            },
                                            {
                                                "example_id": "131c8640-013b-4e3e-917f-a902e88c3d3f",
                                                "sense_id": "559df55f-a900-3d5c-b7e0-80c7c477f38b",
                                                "text": "Stephen feared that he would yell louder, and was hostile. But they made friends and treated each other, and slanged the proprietor and ragged the pretty girls …"
                                            },
                                            {
                                                "example_id": "319317fd-a4db-4b36-8b8c-72cdae8bd177",
                                                "sense_id": "559df55f-a900-3d5c-b7e0-80c7c477f38b",
                                                "text": "\"If they had been a row of his favorite Pressmen he could not have slanged them worse.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6253a2ca-651f-359d-896f-1807d6bb6fee",
                                        "entry_id": "fc9abcd7-0bb6-3aba-b642-7bb146a61abf",
                                        "glosses": [
                                            "simple past of sling"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "form-of",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3568aca6-92e8-4c2e-8771-e82617588d35",
                                                "sense_id": "6253a2ca-651f-359d-896f-1807d6bb6fee",
                                                "text": "Before he slang the all-deciding stone[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5854a0ad-610e-354d-b185-ad807b193167",
                                        "entry_id": "57870078-3c50-3394-b598-74aca0b12d74",
                                        "glosses": [
                                            "Any long, narrow piece of land; a promontory."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b2af805-bc83-4076-b4cf-35e029379565",
                                                "sense_id": "5854a0ad-610e-354d-b185-ad807b193167",
                                                "text": "There runneth forth into the sea a certaine shelfe or slang, like unto an out~thrust tongue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slang",
                                "target_lang_code": "en",
                                "target_senses": [
