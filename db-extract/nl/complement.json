                                    },
                                    {
                                        "sense_id": "f04710c4-65de-3783-808f-4a55858a10f2",
                                        "entry_id": "15f5041e-f002-3c1b-9467-e6e2378a8f6b",
                                        "glosses": [
                                            "Something (or someone) that completes; the consummation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
