                "senses": [
                    {
                        "sense_id": "89512d66-f325-3eb6-9af6-a4b244c0a30e",
                        "entry_id": "24499b5b-51c9-3218-aedc-14f2d2376dcc",
                        "glosses": [
                            "springkussen in de vorm van een kasteel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7481ed3-e65c-4b43-9cd5-4f3803795615",
                                "sense_id": "89512d66-f325-3eb6-9af6-a4b244c0a30e",
                                "text": "Meerderjarigen zijn almaar later volwassen. Je zou je daar zorgen over kunnen maken. Tenzij je de organisator bent van een adult springkasteelfestival."
                            },
                            {
                                "example_id": "e6b07367-87c7-442d-9fa9-6b40930ac169",
                                "sense_id": "89512d66-f325-3eb6-9af6-a4b244c0a30e",
                                "text": "“Voor alle jonge en oudere lezers hebben we een mooie dag vol activiteiten in elkaar gezet”, vertelt Arijan van Bavel, eigenaar van de Waarbeek. “Er is een springkasteel, een grabbelton en bezoekers krijgen hun eigen krantenpagina."
                            },
                            {
                                "example_id": "561aec5b-4ba3-49d2-83f9-d5548eaf0bc2",
                                "sense_id": "89512d66-f325-3eb6-9af6-a4b244c0a30e",
                                "text": "De ondergrondse speeltuin is een bekende instelling in Amsterdam: een verlaten, nogal koude verkeerstunnel waarin speeltoestellen, een springkasteel en een worstenkraam zijn neergezet."
                            },
                            {
                                "example_id": "60c0e6ae-c6eb-4b55-b418-7312441e7646",
                                "sense_id": "89512d66-f325-3eb6-9af6-a4b244c0a30e",
                                "text": "Negen kinderen in het West-Duitse Gondershausen zijn gewond geraakt toen zij vielen uit een springkasteel dat de lucht in werd geblazen. Vijf van hen zijn er ernstig aan toe, melden Duitse media."
                            }
                        ]
                    }
