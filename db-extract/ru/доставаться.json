                ],
                "senses": [
                    {
                        "sense_id": "ab651149-5484-334b-afb9-63484c49526d",
                        "entry_id": "ae5aac9c-0801-3936-a210-2dbd24725ce3",
                        "glosses": [
                            "to fall to one's share; to fall to one's lot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5418d89-3d41-4636-8236-91cddc2bd72f",
                                "sense_id": "ab651149-5484-334b-afb9-63484c49526d",
                                "text": "Им доста́лись лу́чшие места́ в теа́тре.",
                                "translation": "They got the best seats in the theater.",
                                "english": "They got the best seats in the theater."
                            },
                            {
                                "example_id": "65e0b4e4-221a-4b4a-9b57-339511c7fb8e",
                                "sense_id": "ab651149-5484-334b-afb9-63484c49526d",
                                "text": "Ей доста́лась нелёгкая до́ля.",
                                "translation": "An uneasy fate fell to her lot.",
                                "english": "An uneasy fate fell to her lot."
                            }
                        ]
                    },
                    {
                        "sense_id": "c05c307d-9a27-3d04-98e2-cc3adc3050ec",
                        "entry_id": "ae5aac9c-0801-3936-a210-2dbd24725ce3",
                        "glosses": [
                            "passive of достава́ть (dostavátʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "a7dc3319-85ec-4e0b-8f23-f685d40b0f84",
                                "sense_id": "c05c307d-9a27-3d04-98e2-cc3adc3050ec",
                                "text": "Ты да́же не зна́ешь, как достаю́тся э́ти де́ньги.",
                                "translation": "You don't even know how this money is gained.",
                                "english": "You don't even know how this money is gained."
                            }
                        ]
                    }
                ],
