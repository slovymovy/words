                                ]
                            },
                            {
                                "target_word": "staging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76ece153-bb21-3e77-904f-be48dc44f7ed",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "A performance of a play"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e02dbd0-3a0b-468c-9476-f7edad05e581",
                                                "sense_id": "76ece153-bb21-3e77-904f-be48dc44f7ed",
                                                "text": "The 1984 premiere production (and, judging from a few reviews, the subsequent stagings) was much more solemn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde5b8ae-8d7a-3322-9ab2-9e45efeaabef",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The scenery and/or organization of actors' movements on stage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1e49e8-d26a-4510-94bf-5d7cb62dd147",
                                                "sense_id": "dde5b8ae-8d7a-3322-9ab2-9e45efeaabef",
                                                "text": "This, he argues, was in turn especially strongly shaped by imported British theatre traditions, particularly the use of the proscenium arch stage which was radically different from the open staging of precolonial and early colonial India and produced and emphasis on frontality in theatre productions that is now deeply structured into Bollywood films, most notably in their smile-at-the-camera song-and-dance sequences."
                                            },
                                            {
                                                "example_id": "c82a9a09-7fd0-4c79-b1fa-dc8a4bf67474",
                                                "sense_id": "dde5b8ae-8d7a-3322-9ab2-9e45efeaabef",
                                                "text": "A variety of magical effects or tricks might have been possible on the Jacobean playhouse if Sabbattini's elaborate staging machinery was at hand at the at period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5426006a-c19a-362e-a746-378f829edb53",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The arrangement or layout of something in order to create an impression."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2672dfc-f319-48f7-bbe4-6b2544e7759a",
                                                "sense_id": "5426006a-c19a-362e-a746-378f829edb53",
                                                "text": "Ranging along a continuum of degrees of \"realism,\" each of these tourist sites embraces particular conceptions of animal subjectivity, notions of authenticity, and models of human-animal relationships. Each represents a different relationship to the concept of \"situ.\" The higher the perceived realism quotient for each site, the more difficult it is to detect the staging of the natural."
                                            },
                                            {
                                                "example_id": "f51c2d86-51ef-452a-a8dc-388408fa8388",
                                                "sense_id": "5426006a-c19a-362e-a746-378f829edb53",
                                                "text": "Staging often raises the value of a property by reducing the home's flaws, depersonalizatin, de-cluttering, cleaning, and making it look its best with furniture placement, lighting, color, and much more."
                                            },
                                            {
                                                "example_id": "eca59819-0b8c-44a0-bc31-9394bd79307c",
                                                "sense_id": "5426006a-c19a-362e-a746-378f829edb53",
                                                "text": "The representation and staging of reconstruction, of architectural design and of planning models, in particular, played a prominent role in the visual imagery and promotional discourse on both sides."
                                            },
                                            {
                                                "example_id": "1a21446e-d6f1-422f-bede-a3486041f965",
                                                "sense_id": "5426006a-c19a-362e-a746-378f829edb53",
                                                "text": "What about all the homicides staged as interrupted robberies, home invasions, burglaries, suicides, accidents, drowning, car accidents, household falls, and other types of incidents resulting in victims' deaths that were ruled suicide, accident, natural, or otherwise that were really murders? The red flags of staging were missed and victims were not served justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea844a6-2927-3052-8e24-c9fc15e6ca73",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The organization of something in order to prepare for or facilitate working with it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbd534b-2a44-4e19-9f73-94cba03c2f34",
                                                "sense_id": "4ea844a6-2927-3052-8e24-c9fc15e6ca73",
                                                "text": "Staging Mobilities explores the dynamic process between 'being staged' (as, for example, when traffic lights command us to stop or when timetables organize your route and itineraries) and the \"mobile staging\" of interacting individuals (as, for example, when we negotiate a passage on the pavement, or when we choose a particular mode of transport in accordance with our self-perception. The rationale for the book is therefore to address the following overall research question: What are the physical, social, technical and cultural conditions for the staging of contemporary urban mobilities?"
                                            },
                                            {
                                                "example_id": "d0e8017c-2461-42fc-82ca-86aa2f171f8b",
                                                "sense_id": "4ea844a6-2927-3052-8e24-c9fc15e6ca73",
                                                "text": "Kierkegaard wants his listeners to see Thorvaldsen's statue in the same way that he wants his readers to attend to his writing -- not as an end in itself, but as a staging of desire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f61e933-c1f4-3509-b5c8-ace96c1273e1",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "A structure of posts and boards for supporting workmen, etc., as in building."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5985e13-7202-4df3-946b-db0c8d78d855",
                                                "sense_id": "8f61e933-c1f4-3509-b5c8-ace96c1273e1",
                                                "text": "We spent a lot of time up on the staging of the great furnaces, trying to pick up the tricks of the trade from the taciturn furnacemen who sat around placidly smoking, or chewing twist, and occasionally throwing in more pig iron to the molten white-hot metal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9724c3a5-3760-3f17-b495-1350df04f35e",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The act or process of putting on an event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7145fdf0-a783-4242-86ea-fd60e593756c",
                                                "sense_id": "9724c3a5-3760-3f17-b495-1350df04f35e",
                                                "text": "The item 'event costs' is particularly difficult to break down since the staging of the competitions results in a variety of different expenditures."
                                            },
                                            {
                                                "example_id": "d5dd3c61-f1fa-4f2a-a257-f8d9c760139f",
                                                "sense_id": "9724c3a5-3760-3f17-b495-1350df04f35e",
                                                "text": "The staging of events which aimed to transform the city's public spaces and streets into spectacular urban landscapes for promotional purposes was also pioneered in the late 1920s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb072c4-4c96-3d1d-9c0b-02f3d33b1db8",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The business of running stagecoaches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c791fac1-2bfb-3847-8bf3-75d91c020736",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The act of journeying in stagecoaches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66a160dd-9d13-3bff-ab7d-32ffdabe0cdb",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The classification of a case of a disease, usually a cancer, into its anatomic or prognostic stage, which is a category of severity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824cd84f-ce8f-4a4d-9c31-fae39e3f32ea",
                                                "sense_id": "66a160dd-9d13-3bff-ab7d-32ffdabe0cdb",
                                                "text": "By convention, clinical staging should be performed after complete excision of the primary melanoma (including microstaging) and after information about metastases to either regional or distant anatomic sites has been obtained after clinical, radiologic, and laboratory assessment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77081577-1899-314c-aa96-52ff850cd50c",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "An environment for testing that exactly resembles a production environment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7836c364-6ec8-301a-a065-fbd896121c21",
                                        "entry_id": "010509a3-c184-3ae7-95e7-f964d4665366",
                                        "glosses": [
                                            "The process of loading and unloading commercial vehicles."
                                        ],
                                        "tags": [
                                            "countable",
