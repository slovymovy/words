                "senses": [
                    {
                        "sense_id": "f6b2ab3b-7d5f-3b38-a4fd-2013ede8c4b0",
                        "entry_id": "07a19861-480d-30ae-952a-74b50a6221d5",
                        "glosses": [
                            "nonverbale Ausdrucksweise über Mimik und Gestik, Teil der Körpersprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d693abdc-e367-45f7-a1af-7a5832ff8919",
                                "sense_id": "f6b2ab3b-7d5f-3b38-a4fd-2013ede8c4b0",
                                "text": "„Während der Feste und Bankette wurde als weiteres Spiel auch das Gebärdenspiel veranstaltet.“"
                            },
                            {
                                "example_id": "29291930-9da5-4223-8305-6a323e199bbf",
                                "sense_id": "f6b2ab3b-7d5f-3b38-a4fd-2013ede8c4b0",
                                "text": "„Mein Gebärdenspiel war die Musik dazu und die Plastik – oft stellte ich mich in kühnen oder neckischen oder schmachtenden Posen vor den Spiegel, und war dann selbst entzückt über das Bild im Spiegel.“"
                            },
                            {
                                "example_id": "ceeec999-5dad-47c1-9fe0-1026767af8d6",
                                "sense_id": "f6b2ab3b-7d5f-3b38-a4fd-2013ede8c4b0",
                                "text": "„Sein Gebärdenspiel war völlig entspannt … er sprach von Stücken, die er für dieses Theater schreiben wollte.“"
                            },
                            {
                                "example_id": "712bf30f-dde5-4c3e-a3d3-8919c7496a86",
                                "sense_id": "f6b2ab3b-7d5f-3b38-a4fd-2013ede8c4b0",
                                "text": "„Gewahrte man Nespoli, so folgte ihm ein bedeutungsvolles Gemurmel und Gebärdenspiel.“"
                            },
                            {
                                "example_id": "5722e5ef-a35a-4bf3-a1f1-5d6a89c94154",
                                "sense_id": "f6b2ab3b-7d5f-3b38-a4fd-2013ede8c4b0",
                                "text": "„Rehhagel gab zu, er habe nach dem Platzverweis befürchtet, daß wir hier 3:0 oder 4:0 verlieren würden. Seinem Gebärdenspiel war anzumerken, daß ihm auch die Schadensbegrenzung auf 0:2 ausreichend Frust bereitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b59601d1-f22a-3456-b43b-0bc6918bb642",
                        "entry_id": "07a19861-480d-30ae-952a-74b50a6221d5",
                        "glosses": [
                            "schauspielerische Darstellung als künstlerische Pantomime"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b894cf4d-897e-4d49-9b07-030e816b7342",
                                "sense_id": "b59601d1-f22a-3456-b43b-0bc6918bb642",
                                "text": "„Für ein O schließen sich die Arme zum Kreis, ein E wird durch ein Kreuzen der Arme angedeutet, soviel habe ich aus der morgendlichen Übungsstunde behalten, doch es reicht nicht, um das schnelle Gebärdenspiel zu verfolgen, mit dem sieben Eurythmistinnen auf der Bühne die rauschende Rede des Erzengels Raphael begleiten.“"
                            },
                            {
                                "example_id": "4ed88a4d-c279-4c77-b683-e577ecc68dd0",
                                "sense_id": "b59601d1-f22a-3456-b43b-0bc6918bb642",
                                "text": "„Danny Boyle, der Regisseur, treibt seine Schauspieler in hektisches Gebärdenspiel.“"
                            },
                            {
                                "example_id": "b9ce1ccd-9700-4307-a3db-7b884cd31596",
                                "sense_id": "b59601d1-f22a-3456-b43b-0bc6918bb642",
                                "text": "„Hier ein stummes Gebärdenspiel, da ein Wortwechsel, hier das Bild eines Zustands, da eine Bewegungsstudie, dort die Fixierung einer auf das Wesentlichste reduzierten Aktion.“"
                            },
                            {
                                "example_id": "05b146ec-9468-4796-b024-e9bc259ae2bd",
                                "sense_id": "b59601d1-f22a-3456-b43b-0bc6918bb642",
                                "text": "„Podreccas ferngesteuerte Darsteller ein geradezu hinreißendes Gebärdenspiel.“"
                            },
                            {
                                "example_id": "8f1bc77d-85ac-4883-9853-1e9585602096",
                                "sense_id": "b59601d1-f22a-3456-b43b-0bc6918bb642",
                                "text": "„Mehr als zwei Dutzend Personen, die ihre Rollen fortwährend wechseln und ineinandertauschen, tanzen die neueste Geschichte Frankreichs, den lüsternen Tango der zwanziger Jahre, die fröhliche Valse Musette des Vorkriegs, den Swing der Liberation, den Rock der Auflehnung und das apokalyptische Gebärdenspiel des Jahrhundertendes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
