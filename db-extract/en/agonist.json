                        "glosses": [
                            "Someone involved in a contest or battle (as in an agon), protagonist."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "624ed084-30c2-3655-90a5-242f9442e78d",
                        "entry_id": "66a8fdaf-1234-3a27-8f2d-771c1a68a104",
                        "glosses": [
                            "The muscle that contracts while the other relaxes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4d8f13-48f9-4546-8fd5-4aae3742bb46",
                                "sense_id": "624ed084-30c2-3655-90a5-242f9442e78d",
                                "text": "When bending the elbow, the biceps is the agonist."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c5159ac-b943-3737-b9fa-85a29987fdf9",
                        "entry_id": "66a8fdaf-1234-3a27-8f2d-771c1a68a104",
                        "glosses": [
                            "A molecule that can combine with a receptor on a cell to produce a physiological reaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648d921b-9434-4a9c-a00f-1562b14070d6",
                                "sense_id": "1c5159ac-b943-3737-b9fa-85a29987fdf9",
                                "text": "Acetylcholine is an agonist at the cholinergic receptor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cdb5982-6264-4bad-8103-150d3b7daed2",
                        "source_entry_id": "66a8fdaf-1234-3a27-8f2d-771c1a68a104",
                        "source_sense_description": "someone involved in a contest or battle",
                        "target_lang_word": "agonista",
