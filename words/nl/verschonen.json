{
    "word_family": [
        "verschoning"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcbc0dba-d33b-3633-977c-539e8e369185",
                    "sense_definition": "Het vervangen van vuile zaken door schone exemplaren",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "hygiëne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verschoon</w> mijn lakens elke week.",
                            "target_lang_translations": {
                                "zh": "我每周都会<w>换洗</w>床单。"
                            }
                        },
                        {
                            "text": "Het is belangrijk om regelmatig de luiers te <w>verschonen</w>.",
                            "target_lang_translations": {
                                "zh": "定期<w>更换</w>尿布很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vervangen"
                    ],
                    "common_phrases": [
                        "bed verschonen",
                        "luiers verschonen"
                    ],
                    "target_lang_definitions": {
                        "zh": "将脏的东西换成干净的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "更换",
                                "target_lang_sense_clarification": "指替换旧物或脏物"
                            },
                            {
                                "target_lang_word": "换洗",
                                "target_lang_sense_clarification": "特指更换并清洗衣物或床单"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fdb788e-a1a2-3102-b9e2-c4fd9e8b3ee5",
                    "sense_definition": "Iemand of iets sparen of vrijwaren van iets vervelends",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vrijwaren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gelukkig bleef de wandeling <w>verschoond</w> van regen.",
                            "target_lang_translations": {
                                "zh": "幸运的是，这次徒步旅行<w>免于</w>雨水的干扰。"
                            }
                        },
                        {
                            "text": "Ik hoop in de toekomst van dit soort vragen <w>verschoond</w> te blijven.",
                            "target_lang_translations": {
                                "zh": "我希望将来能<w>免于</w>回答这类问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "besparen",
                        "vrijwaren"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人或某事免受不愉快的影响"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "免于",
                                "target_lang_sense_clarification": "指避免遭受某种情况"
                            },
                            {
                                "target_lang_word": "幸免",
                                "target_lang_sense_clarification": "指幸运地避开了灾祸或麻烦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "377b4d43-9725-3eb0-9a43-9cdf1ab5a239",
                    "sense_definition": "Iemand verontschuldigen of een actie rechtvaardigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verontschuldiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wilt u mij <w>verschonen</w> voor mijn late reactie?",
                            "target_lang_translations": {
                                "zh": "请<w>原谅</w>我回复晚了。"
                            }
                        },
                        {
                            "text": "Dit gedrag <w>verschoont</w> zijn eerdere fouten niet.",
                            "target_lang_translations": {
                                "zh": "这种行为并不能<w>辩解</w>他之前的错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "verontschuldigen",
                        "vergeven"
                    ],
                    "target_lang_definitions": {
                        "zh": "请求原谅或为某行为辩解"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "原谅",
                                "target_lang_sense_clarification": "请求他人宽恕"
                            },
                            {
                                "target_lang_word": "辩解",
                                "target_lang_sense_clarification": "为错误行为寻找理由"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}