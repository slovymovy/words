                                            {
                                                "example_id": "36c44b17-6e1c-42ba-a28b-8e2fc70876f7",
                                                "sense_id": "75a45fac-48bc-31cf-ab4c-95743adcaf79",
                                                "text": "The territory should be small enough to be surveyed in its entirety from a hilltop."
                                            },
                                            {
                                                "example_id": "62c2e702-e0e5-4b4e-9f78-e2f27b6aa4cd",
                                                "sense_id": "75a45fac-48bc-31cf-ab4c-95743adcaf79",
                                                "text": "After crossing the flatlands Lincoln, with its magnificent hilltop cathedral, comes into view before we pull into the station, with its lovely Tudor revival-style buildings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
