                        "glosses": [
                            "In an ordinate manner; regular; orderly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ecf62a9-35f6-46d3-9166-0c6bce94b89d",
                                "sense_id": "10076ea3-28d0-3987-afa2-13efc0c85b72",
                                "text": "[…] as if it be but exactly round (as there are abundance of such stones found betwixt two hills in Cuba, an Island of America) or ordinately Quinquangular, or have the sides but Parallel, though the Angles be unequal, as is seen in some little stones, and in a kind of Alabaster found here in England; these stones, I say, gratifie our sight, as having a nearer cognation with the Soul of Man, that is Rational and Intellectual, and therefore is well pleased when it meets with any outward Object that fits and agrees with those congenite Ideas her own nature is furnished with."
                            }
                        ]
                    }
