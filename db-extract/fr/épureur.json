                "senses": [
                    {
                        "sense_id": "32b11907-476d-34bc-8ea6-6b1ea5d97d99",
                        "entry_id": "8acb93c5-4313-3bf3-a23a-febced3ca6f7",
                        "glosses": [
                            "Personne qui épure les huiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a69a1781-4188-4f2c-b9f6-2e4d455e4f78",
                                "sense_id": "32b11907-476d-34bc-8ea6-6b1ea5d97d99",
                                "text": "Chez les épureurs, l'huile de colza, dépurée au moyen de l'acide sulfurique concentré, et que plus tard des lavages à l'eau ont débarrassée de l'excès d'acide, est filtrée au travers de mèches en coton, ou, pour plus d'économie; au travers de sciure de bois convenablement tassée."
                            },
                            {
                                "example_id": "13568cc8-d240-4b25-96cd-ac6596dca74f",
                                "sense_id": "32b11907-476d-34bc-8ea6-6b1ea5d97d99",
                                "text": "Une autre falsification, qu'opèrent les épureurs, se fait au moyen de l’huile de baleine, qu'on mélange avec celle épurée de colza par moitié, lorsque la différence des prix y donne lieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa1d4776-cd86-3428-86ed-8d659537644e",
                        "entry_id": "8acb93c5-4313-3bf3-a23a-febced3ca6f7",
                        "glosses": [
                            "Agent de l'Épuration en 1944 et 1945."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2abf6d9a-3e53-481a-b84f-949f53f3ed1b",
                                "sense_id": "fa1d4776-cd86-3428-86ed-8d659537644e",
                                "text": "Je l'ai eue je ne l'ai plus... elle est partie avec le reste!… vous savez rue Girardon… quand les épureurs… ont épuré mon domicile avec trois voitures de déménagement…"
                            },
                            {
                                "example_id": "c309c128-f49d-4b24-8982-9efa3e1f3054",
                                "sense_id": "fa1d4776-cd86-3428-86ed-8d659537644e",
                                "text": "Bardèche utilise le procédé de la parallélisation avant tout contre les « épureurs » en leur reprochant leur injustice parce qu’ils empêchent les anciens collaborationnistes d’exercer leur profession comme ils l’avaient fait pendant les années 1940 à 44."
                            }
                        ]
                    }
