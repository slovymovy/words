                {
                    "sense_id": "d34bd2d8-1e80-30dc-bd4f-1ce203c0524a",
                    "sense_definition": "Surrounded by a fence or other barrier to enclose an area.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fenced</w> garden kept the dogs from running into the street.",
                            "target_lang_translations": {
                                "it": "Il giardino <w>recintato</w> impediva ai cani di correre in strada."
                            }
                        },
                        {
                            "text": "They kept their horses in a large <w>fenced</w> area behind the barn.",
                            "target_lang_translations": {
                                "it": "Tenevano i loro cavalli in una grande area <w>recintata</w> dietro il fienile."
                            }
                        }
                    ],
                    "synonyms": [
                        "enclosed",
                        "walled"
                    ],
                    "antonyms": [
                        "open"
                    ],
                    "common_phrases": [
                        "fenced area",
                        "fenced yard"
                    ],
                    "target_lang_definitions": {
