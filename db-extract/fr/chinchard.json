                        "cross_references": []
                    },
                    {
                        "translation_id": "82e63b29-7637-49d0-82ad-734b552d85ea",
                        "source_entry_id": "8d3a9b81-c9e2-36a8-ae3b-368554745543",
                        "source_sense_id": "38698f27-6a79-3889-82e2-bb468689ba26",
                        "target_lang_word": "ставрида",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ставрида",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8732be-12af-35f8-99b5-9631b7c438b6",
                                        "entry_id": "2da73f48-d76e-35de-91d2-caf3793aa8e0",
                                        "glosses": [
                                            "зоол., ихтиол. морская промысловая рыба отряда окунеобразных (лат. Trachurus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b58bfd9-f32d-4634-a3af-77a7f5b10d26",
                                                "sense_id": "7d8732be-12af-35f8-99b5-9631b7c438b6",
                                                "text": "Христофориди был отчаянным рыболовом. Он выходил на ловлю ночью, чтобы захватить место у мигалки, где лучше всего ловилась ставрида."
                                            },
                                            {
                                                "example_id": "06343bd7-7929-477d-9fdb-26fa2e2ead78",
                                                "sense_id": "7d8732be-12af-35f8-99b5-9631b7c438b6",
                                                "text": "На юге нашей страны, в Чёрном море, ловятся кефаль, барабулька, скумбрия, ставрида, мелкая рыба — хамса, тюлька, бычки — и некоторые осетровые рыбы."
                                            },
                                            {
                                                "example_id": "e4a7e03e-5a2a-46c3-9993-c6383e57c8b2",
                                                "sense_id": "7d8732be-12af-35f8-99b5-9631b7c438b6",
                                                "text": "Луфарь и ставрида плавают более-менее крупными стаями, и охота на них очень сходна с охотой на кефаль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b67b4ca7-bd02-3b1d-9276-4a901389fb5b",
                                        "entry_id": "2da73f48-d76e-35de-91d2-caf3793aa8e0",
                                        "glosses": [
                                            "неодуш. мясо такой рыбы, употребляемое в пищу"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eec5007-9f37-3164-8a2f-bfab668f0544",
                                        "entry_id": "2da73f48-d76e-35de-91d2-caf3793aa8e0",
                                        "glosses": [
                                            "неодуш. кушанье, приготовленное из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
