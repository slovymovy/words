                "forms": [],
                "senses": [
                    {
                        "sense_id": "853eae79-2a77-30a5-871d-c8fec653d9a6",
                        "entry_id": "872af9c0-c69b-39cb-a233-bf0fbfbf213d",
                        "glosses": [
                            "Describing a time period inserted between others; leap, (as in leap day, leap month, or leap year)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ceaee7a0-03cd-360b-ac02-c5e70748d4db",
                        "entry_id": "872af9c0-c69b-39cb-a233-bf0fbfbf213d",
                        "glosses": [
                            "Inserted between other things"
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c52e931-82af-448b-9d34-69989be1515e",
                                "sense_id": "ceaee7a0-03cd-360b-ac02-c5e70748d4db",
                                "text": "Breaks caused by chromosome aberrations in regions with repeats may not result in a sharp decline of viability, so that break points of chromosome rearrangements in intercalary heterochromatin may be more frequent than in other regions."
                            },
                            {
                                "example_id": "6b422925-ab44-45e8-a4b9-b2b5ab40b20a",
                                "sense_id": "ceaee7a0-03cd-360b-ac02-c5e70748d4db",
                                "text": "In this new model, the anterior and posterior blastemas were formed as signaling centers to direct intercalary reorganization of body regionality or positional information."
                            }
                        ]
                    },
                    {
                        "sense_id": "698d3586-e539-3885-9b45-8a7869018fe1",
                        "entry_id": "872af9c0-c69b-39cb-a233-bf0fbfbf213d",
                        "glosses": [
                            "Inserted between other things",
                            "of a meristem: situated between zones of permanent tissue, thus a shoot growing at the base of a leaf, in comparison with apical growth at the tip of a root or plant."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e89c315f-b37e-3fb4-8a56-f6104130ac3d",
                        "entry_id": "872af9c0-c69b-39cb-a233-bf0fbfbf213d",
                        "glosses": [
                            "Inserted between other things",
                            "of a wing vein: between the major veins common to insect wings."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2a917e1-7290-491c-9501-ea04e8ccc5d6",
                                "sense_id": "e89c315f-b37e-3fb4-8a56-f6104130ac3d",
                                "text": "...two radial cells, second longer than first; intercalary fork fairly distinct; crossvein r-m vertical..."
                            }
                        ]
                    }
                ],
                "translations": [
