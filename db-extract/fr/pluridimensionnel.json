                        "examples": [
                            {
                                "example_id": "acd07fbd-10b7-4d8c-b57a-c05a56680eb4",
                                "sense_id": "f11a3687-6bec-34be-ab16-f7435180e461",
                                "text": "Cette crise est pluridimensionnelle."
                            },
                            {
                                "example_id": "8b6f023e-5a89-445f-b43b-6a76150f85f5",
                                "sense_id": "f11a3687-6bec-34be-ab16-f7435180e461",
                                "text": "Elle est devenue mathématicienne, spécialiste reconnue des domaines pluridimensionnels."
                            },
