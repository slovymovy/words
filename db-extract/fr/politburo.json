                    {
                        "sense_id": "0ae628d8-319e-3804-8bed-f0d8484170a6",
                        "entry_id": "a7976b26-d21a-3a96-aa84-1f426783906e",
                        "glosses": [
                            "Bureau politique, organe dirigeant du parti communiste de plusieurs pays."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "65300ee3-b9cd-42cc-a1b9-5dd94023a5af",
                                "sense_id": "0ae628d8-319e-3804-8bed-f0d8484170a6",
                                "text": "Choe Ryong-Hae, directeur du politburo de l’Armée populaire du Corée, s’est envolé pour la Chine en tant qu’envoyé spécial de Kim Jong-Un, a indiqué l’agence sans préciser le motif de sa visite."
                            },
                            {
                                "example_id": "b46bd837-b274-4b6c-917d-d44bcb9a83e7",
                                "sense_id": "0ae628d8-319e-3804-8bed-f0d8484170a6",
                                "text": "Des larmes inattendues chez un haut dirigeant du sévère politburo qui lui valent depuis une popularité exceptionnelle auprès des Chinois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "467b8db4-374d-41ac-a02d-c0c595aaf67c",
                        "source_entry_id": "a7976b26-d21a-3a96-aa84-1f426783906e",
                        "source_sense_id": "0ae628d8-319e-3804-8bed-f0d8484170a6",
