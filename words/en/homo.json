                            }
                        },
                        {
                            "text": "The characters in the play argued about rumors that he was a <w>homo</w>.",
                            "target_lang_translations": {
                                "zh": "剧中的角色因他是<w>同性恋者</w>的传言而争吵不休。"
                            }
                        }
                    ],
