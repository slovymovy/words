                "senses": [
                    {
                        "sense_id": "c74fa727-2e3c-317e-afc2-45d88f1357ae",
                        "entry_id": "6e5f648d-b210-3575-a3c8-ae08cfcf6a83",
                        "glosses": [
                            "Teil, das aus Metall besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67add374-08dd-472a-8350-18061f77a9c3",
                                "sense_id": "c74fa727-2e3c-317e-afc2-45d88f1357ae",
                                "text": "Ein nicht ordnungsgemäß fest gespanntes Metallteil flog quer durch die Werkstatt."
                            },
                            {
                                "example_id": "5041cb66-f949-40c5-8efb-0f80afefbfe0",
                                "sense_id": "c74fa727-2e3c-317e-afc2-45d88f1357ae",
                                "text": "„Neben den Getreide-, Draht- und Papiermühlen gab es Pulver- und Tuchmühlen, sowie Hammer- und Walzmühlen für die Herstellung von Metallteilen und Blechen.“"
                            }
                        ],
