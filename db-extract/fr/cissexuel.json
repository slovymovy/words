                ],
                "senses": [
                    {
                        "sense_id": "9da0884f-7605-38f8-bd9d-4e6c272db550",
                        "entry_id": "d29046d6-75d9-3206-ab71-b130ac665080",
                        "glosses": [
                            "Qui découle de l’alignement entre sexe biologique et genre ressenti."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea61b5b-4ad3-4796-adb7-14b622eb6b6c",
                                "sense_id": "9da0884f-7605-38f8-bd9d-4e6c272db550",
                                "text": "Ce nouveau regard « négatif» avec lequel sont scrutées les personnes transsexuelles n’est pas à l’œuvre pour les personnes cissexuelles et il s’agit là d’un privilège dont elles profitent."
                            },
                            {
                                "example_id": "816cf059-f5c9-44d0-97d3-f9516ad3a3d6",
                                "sense_id": "9da0884f-7605-38f8-bd9d-4e6c272db550",
                                "text": "Dans les interactions sociales, la seule différence entre mon genre transsexuel et leurs genres cissexuels c’est que ma féminité est souvent caractérisée comme secondaire, illégitime, ou comme une imitation de leur féminité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42713481-6c42-47ff-8a75-84a98515acf7",
                        "source_entry_id": "d29046d6-75d9-3206-ab71-b130ac665080",
                        "source_sense_id": "9da0884f-7605-38f8-bd9d-4e6c272db550",
                        "target_lang_word": "cissexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cissexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c2b5e93-466b-3222-901e-375d26e5de36",
                                        "entry_id": "f15d795b-5617-31ca-895f-9415612f80f8",
                                        "glosses": [
                                            "Having a gender identity which matches one's birth sex; for example, identifying as male and having (been born with) male genitalia."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "665bf851-7147-44fb-b019-163e6f247496",
                                                "sense_id": "7c2b5e93-466b-3222-901e-375d26e5de36",
                                                "text": "That we are working on the grounds of ontology seems clear, since the “actually” begins from a cissexual primal origin birth moment that cannot be changed but only concealed—Angie is “biologically” once-and-forever Justin."
                                            },
                                            {
                                                "example_id": "88ac4bdb-1b18-4ff3-b0fb-a27c1c435397",
                                                "sense_id": "7c2b5e93-466b-3222-901e-375d26e5de36",
                                                "text": "Ungendering is the process by which cissexual people start to look for details or evidence that the trans person is no longer living in his/her birth gender."
                                            },
                                            {
                                                "example_id": "1b9b39b2-6d0d-4e55-892c-36300d0a2506",
                                                "sense_id": "7c2b5e93-466b-3222-901e-375d26e5de36",
                                                "text": "Comfort is a cissexual privilege, ascribed to those who identify with and are socially and institutionally recognizable as the sex they were assigned at birth, thus conforming to a certain kind of gender norm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
