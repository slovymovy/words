                        "cross_references": [
                            {
                                "target_word": "belief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4d0286-9437-3d7d-bc55-3d7f710c0a2b",
                                        "entry_id": "049a668b-53fd-3436-a74a-8f7185379dca",
                                        "glosses": [
                                            "Mental acceptance of a claim as true."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c29c2b24-8064-4eea-a92e-bb8c4867ff7d",
                                                "sense_id": "2d4d0286-9437-3d7d-bc55-3d7f710c0a2b",
                                                "text": "It's my belief that the thief is somebody known to us."
                                            },
                                            {
                                                "example_id": "efc23a41-6b45-452b-b4f6-e75fa116908b",
                                                "sense_id": "2d4d0286-9437-3d7d-bc55-3d7f710c0a2b",
                                                "text": "The belief that there is no conflict between [livestock] farming and arable production also seems to be unfounded: by preventing the growth of trees and other deep vegetation in the hills and by compacting the soil, grazing animals cause a cycle of flash floods and drought, sporadically drowning good land downstream and reducing the supply of irrigation water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97aeb974-31d1-3c22-b185-fbeb57ff94e7",
                                        "entry_id": "049a668b-53fd-3436-a74a-8f7185379dca",
                                        "glosses": [
                                            "Faith or trust in the reality of something; often based upon one's own reasoning, trust in a claim, desire of actuality, and/or evidence considered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7afe1e2-45d0-4af0-9d74-d4f41ddacaef",
                                                "sense_id": "97aeb974-31d1-3c22-b185-fbeb57ff94e7",
                                                "text": "My belief is that there is a bear in the woods. Bill said he saw one."
                                            },
                                            {
                                                "example_id": "2ed73695-224b-43dc-9a21-f9bb7997181d",
                                                "sense_id": "97aeb974-31d1-3c22-b185-fbeb57ff94e7",
                                                "text": "Based on this data, it is our belief that X does not occur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a8a163f-b358-35c7-886d-0270066c56e1",
                                        "entry_id": "049a668b-53fd-3436-a74a-8f7185379dca",
                                        "glosses": [
                                            "Something believed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ebdfd1-63a3-4758-8cca-87ba88fd60b1",
                                                "sense_id": "4a8a163f-b358-35c7-886d-0270066c56e1",
                                                "text": "The ancient people have a belief in many deities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d54774-207d-3c31-9245-090fafcfa796",
                                        "entry_id": "049a668b-53fd-3436-a74a-8f7185379dca",
                                        "glosses": [
                                            "The quality or state of believing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92741307-0a01-4360-95b3-e5aac3a9996d",
                                                "sense_id": "29d54774-207d-3c31-9245-090fafcfa796",
                                                "text": "My belief that it will rain tomorrow is strong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa58bd3-3e03-3acc-8846-a90dddcf36b2",
                                        "entry_id": "049a668b-53fd-3436-a74a-8f7185379dca",
                                        "glosses": [
                                            "Religious faith."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d545ea8-5483-42a4-a9ef-ec4bd6b754d1",
                                                "sense_id": "cfa58bd3-3e03-3acc-8846-a90dddcf36b2",
                                                "text": "She often said it was her belief that carried her through the hard times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73cb8905-f6ce-3058-b5fa-da00b1d276f3",
                                        "entry_id": "049a668b-53fd-3436-a74a-8f7185379dca",
                                        "glosses": [
                                            "One's religious or moral convictions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5ecb2b-0d40-4b9d-88e0-bc9784997d47",
                                                "sense_id": "73cb8905-f6ce-3058-b5fa-da00b1d276f3",
                                                "text": "I can't do that. It's against my beliefs."
                                            },
                                            {
                                                "example_id": "d40b04eb-53bb-4c0f-a502-9840ba3b254d",
                                                "sense_id": "73cb8905-f6ce-3058-b5fa-da00b1d276f3",
                                                "text": "The Trump administration will allow federal workers to promote their religious beliefs to colleagues, display religious items at work and pray together or individually, according to a memorandum issued Monday by the Office of Personnel Management. […] Title VII of the Civil Rights Act of 1964 forbids employers from discriminating based on religion. They are required to make reasonable accommodations for their employees’ religious practices and beliefs unless it would be an “undue hardship” to do so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
