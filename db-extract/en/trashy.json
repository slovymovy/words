                        "sense_id": "da7d9017-56d7-30f8-9bbd-4fa843e7da51",
                        "entry_id": "853c0d01-57e2-3777-a4f1-5ca4b8515070",
                        "glosses": [
                            "Like trash; having low quality and a perceived lack of depth, especially of books and films."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142994d2-7573-40e1-9bd9-c75a191dae88",
                                "sense_id": "da7d9017-56d7-30f8-9bbd-4fa843e7da51",
                                "text": "a trashy novel"
                            },
                            {
                                "example_id": "127130fe-8bf5-4222-a853-22f85d3676ab",
                                "sense_id": "da7d9017-56d7-30f8-9bbd-4fa843e7da51",
                                "text": "It was nonsense this being in love; there wasn't such a thing as love outside of trashy novelettes."
                            },
                            {
                                "example_id": "6eeaf310-a960-4580-a2cc-ed46e89930a0",
                                "sense_id": "da7d9017-56d7-30f8-9bbd-4fa843e7da51",
                                "text": "Take to your bed with a trashy book or meet someone amusing for lunch. Even better, take to your bed with a trashy man or woman who's amusing; but if you knew someone trashy and amusing, you probably wouldn't be feeling depressed."
                            },
                            {
                                "example_id": "16afe17e-0daf-49b9-af09-dd480399c9ac",
                                "sense_id": "da7d9017-56d7-30f8-9bbd-4fa843e7da51",
                                "text": "\"Michigan's taste in beer is so good, even its \"trashy\" brew of choice is an icon and a staple...\""
                            }
                        ]
                    },
