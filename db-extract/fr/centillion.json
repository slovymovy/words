                "senses": [
                    {
                        "sense_id": "49e0c0e3-994e-3f75-b4f0-ac187668b9f1",
                        "entry_id": "b42847fe-17e1-3a53-b05d-1dc6571a38c1",
                        "glosses": [
                            "Un million à la puissance cent, soit 10⁶⁰⁰."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbad34ff-fc80-4fe2-8b30-735bb38e37fb",
                                "sense_id": "49e0c0e3-994e-3f75-b4f0-ac187668b9f1",
                                "text": "Nous supposerons alors que l’unité de ce nombre est elle-même un centillion, ou tout ce qui lui plaira, cela ne nous coûte rien et tout nombre est raisonnable pourvu qu’il soit fini."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ea09379-774a-4815-8002-ac44ee07ffcd",
                        "source_entry_id": "b42847fe-17e1-3a53-b05d-1dc6571a38c1",
                        "source_sense_id": "49e0c0e3-994e-3f75-b4f0-ac187668b9f1",
                        "target_lang_word": "Zentillion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentillion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                        "entry_id": "c37acb82-f7ed-32a6-b5ec-914b5a81c0a5",
                                        "glosses": [
                                            "die große Zahl 10⁶⁰⁰ (entspricht einer 1 mit 600 folgenden Nullen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1537b510-aabb-4c75-8f85-7a348ac3b742",
                                                "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                                "text": "„Die höchste benannte Zahl ist die Zentillion, die 10 zur 600sten Potenz erhoben bedeutet, also eine Eins mit 600 Nullen.“"
                                            },
                                            {
                                                "example_id": "657f505c-2c21-4d5e-9900-baa5999e33c8",
                                                "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                                "text": "„Unsere heutigen Zahlworte bilden eine Reihe, deren letzte bequem zu sprechende Zahl mit sechshundert Stellen wir eine Zentillion nennen würden.“"
                                            },
                                            {
                                                "example_id": "3567df0f-5fc5-4c68-bb41-b4854d23b295",
                                                "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                                "text": "„Man denke sich m als eine ungeheuer große Zahl (z.B.: 1 Zentillion, d. h. 1 mit angehängten 600 Nullen), und nun 1 Sekunde in m gleiche Theilchen getheilt, so durchläuft ein von einer unveränderlichen absoluten Kraft getriebener Atom: […] gewisse Raumtheilchen. […]“"
                                            },
                                            {
                                                "example_id": "23f42e0b-1d76-44a4-af8f-dfdaa2965bdf",
                                                "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                                "text": "„Als die Band ihren Online-Auftritt bei AOL hatte (der eine Zentillion Mal angeklickt wurde, ich bin sicher, ihr habt ihn auch gesehen), gaben sie auch ein Interview, bei dem sie gefragt wurden, wer denn in ihrem Video die Audrey spielen würde […].“"
                                            },
                                            {
                                                "example_id": "0035c882-62fc-4e7e-b5a1-e090b464fb66",
                                                "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                                "text": "„Das deutsche Kunstzahlsystem […] läßt sich ohne sprachlichen Zwang bis zur Zentillion = 10⁶⁰⁰, allenfalls auch bis zur Nongentillion = 10⁵⁴⁰⁰ oder mit einer Neubildung zur Dezentillion = 10⁶⁰⁰⁰ ausdehnen.“"
                                            },
                                            {
                                                "example_id": "fa6470a3-bd5d-4229-a3ce-9ebec7d7edd1",
                                                "sense_id": "5f778eca-4546-3780-9ab1-d6066f5ac9ed",
                                                "text": "„Auf diese Weise können wir auch die Namen noch höherer Zahlen bilden, z.B: Zentillion = 10^(100 * 6) = 10⁶⁰⁰.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
