                        ]
                    },
                    {
                        "translation_id": "7496e8e6-0d11-4897-b02b-58fb2b258585",
                        "source_entry_id": "d08ecd3e-bfb2-38fb-9b1d-07a8ed82ff96",
                        "source_sense_description": "seize power",
                        "target_lang_word": "usurper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usurper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                        "entry_id": "78155709-157c-3ea9-a656-253bb487addd",
                                        "glosses": [
                                            "S’emparer, par violence ou par ruse, d’un bien, d’une souveraineté, d’une dignité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d002faa2-b22d-4cc5-a613-b539c76d8df5",
                                                "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                                "text": "Il a tenté d'usurper le poste de directeur en falsifiant des documents. Il a donc voulu s'approprier illégalement ou sans droit cette fonction ou ce titre."
                                            },
                                            {
                                                "example_id": "c2ef435d-030f-493d-9cc7-4b0c8b7cf54a",
                                                "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                                "text": "Que tout individu qui usurperait la souveraineté soit à l'instant mis à mort par les hommes libres."
                                            },
                                            {
                                                "example_id": "a3c6a8d1-b18b-4b12-bdc7-9efec26ad531",
                                                "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                                "text": "La faiblesse du califat permit aux gouverneurs de provinces et autres satrapes d’usurper le pouvoir et de fonder ainsi, à leur gré, des dynasties de courte ou de longue durée."
                                            },
                                            {
                                                "example_id": "ff53a995-e878-45f0-86e3-e2476dbcea5d",
                                                "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                                "text": "Toute femme suspectée d'avoir des rapports avec une autre femme était considérée comme une tribade, comme une fricatrice, car elle usurpait à l'homme le rôle qui procédait du frottement."
                                            },
                                            {
                                                "example_id": "8d530b7e-e2bf-48d5-a1e4-620d32288f2f",
                                                "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                                "text": "[…] ; le chatbot CYBERLOVER a attiré l'attention des autorités en raison de son penchant à amener les internautes à divulguer suffisamment d'informations personnelles pour que leur identité puisse être usurpée."
                                            },
                                            {
                                                "example_id": "ed767cb6-7cc7-4391-9cf3-7dc57d4ad12c",
                                                "sense_id": "1f0483b5-05bc-39cd-a54c-3a4a981236b5",
                                                "text": "Une page Facebook au nom de votre entreprise, même vide, est une manière d'éviter le « cybersquat », c'est-à-dire que quelqu'un usurpe votre identité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b60f1bb5-0ce0-38c0-b21f-36d353ebb23d",
                                        "entry_id": "78155709-157c-3ea9-a656-253bb487addd",
                                        "glosses": [
                                            "Empiéter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee0dfb9d-ecca-4ce6-a184-ab0c5d37b878",
                                                "sense_id": "b60f1bb5-0ce0-38c0-b21f-36d353ebb23d",
                                                "text": "La sociobiologie pourrait n'être qu'un avatar amusant de l'histoire des religions ou des pseudo-sciences. Malheureusement ses excès et la place qu'elle a usurpée dans les médias et dans les instances scientifiques de quelques pays tend à faire oublier les progrès considérables de la neurobiologie, de la physiologie du comportement et de l'éthologie animale et humaine."
                                            },
                                            {
                                                "example_id": "7bbb1584-6152-44dc-aad5-c0976cc066ea",
                                                "sense_id": "b60f1bb5-0ce0-38c0-b21f-36d353ebb23d",
                                                "text": "Vous usurpez sur mes droits, sur mes possessions."
                                            },
                                            {
                                                "example_id": "7f8c897e-2d77-40d9-9e36-266fe489648d",
                                                "sense_id": "b60f1bb5-0ce0-38c0-b21f-36d353ebb23d",
                                                "text": "Ce cultivateur tâche toujours d’usurper sur ses voisins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d187f2-a1b0-3925-984f-3e9c52492d2a",
                                        "entry_id": "78155709-157c-3ea9-a656-253bb487addd",
                                        "glosses": [
                                            "Prendre ou s’établir de manière indue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862a3769-6756-43b0-a946-f51a96dd3998",
                                                "sense_id": "c1d187f2-a1b0-3925-984f-3e9c52492d2a",
                                                "text": "Après y avoir étudié quelque temps, il trouva que la réputation du lieu était usurpée et que l'art pugilistique n'y offrait rien de remarquable. Il quitta donc Chao-lin -sseu et mena une vie errante."
                                            },
                                            {
                                                "example_id": "be747ae6-1a85-49d6-8b61-324b773f4d30",
                                                "sense_id": "c1d187f2-a1b0-3925-984f-3e9c52492d2a",
                                                "text": "« GAI COMME LE CANAL ». Cette expression d’effroi glacé n’est pas usurpée quand nous prend l’idée saugrenue de sillonner les parties les plus urbaines des canaux de l’Ourcq et de Saint-Denis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5700937e-8a9c-373b-81f5-f6a330c483ee",
                                        "entry_id": "78155709-157c-3ea9-a656-253bb487addd",
                                        "glosses": [
                                            "Occuper un emplacement illégitime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc20d79a-3195-4344-8d2b-b19138bb93f6",
                                                "sense_id": "5700937e-8a9c-373b-81f5-f6a330c483ee",
                                                "text": "La table était placée dans un coin qu’elle usurpait d’une façon manifeste, comme en témoignait la grande tache claire que son pied avait laissée sur le tapis à l’endroit où elle se trouvait d’abord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a47086d-6c0e-47e0-9b37-90a2b3c3551e",
                        "source_entry_id": "d08ecd3e-bfb2-38fb-9b1d-07a8ed82ff96",
