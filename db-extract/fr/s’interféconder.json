                "senses": [
                    {
                        "sense_id": "b8b91cd9-624d-3862-af9a-96319ca4040b",
                        "entry_id": "4fdade04-9f6c-3678-9b35-093c88464525",
                        "glosses": [
                            "Se féconder mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db55d1e-60d4-4d27-9c2d-5f8bbea7514c",
                                "sense_id": "b8b91cd9-624d-3862-af9a-96319ca4040b",
                                "text": "Les occasions de travail individuel et de groupe (4e principe de design) doivent s'interféconder."
                            },
                            {
                                "example_id": "5cd049b8-53cd-46a2-882a-818ca8905bc4",
                                "sense_id": "b8b91cd9-624d-3862-af9a-96319ca4040b",
                                "text": "J'entends bien que des genres ou des tendances différentes peuvent s'entrecroiser et s'interféconder."
                            },
                            {
                                "example_id": "6b4c771f-1ba9-4ffb-96f6-01a23a5877b1",
                                "sense_id": "b8b91cd9-624d-3862-af9a-96319ca4040b",
                                "text": "Depuis des années, les paléontologues s'interrogent sur les liens entre les deux espèces : auraient-elles pu s'interféconder ?"
                            }
                        ]
                    }
