                "senses": [
                    {
                        "sense_id": "5132a57e-9025-3312-802c-2fc26aab31cc",
                        "entry_id": "3dd02641-769c-3492-989e-2b1acbb0ce43",
                        "glosses": [
                            "Manière d’être d’un état d’esprit, d’un caractère exclusif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff5aef1-036e-4bda-8451-4a35a3c2f6b4",
                                "sense_id": "5132a57e-9025-3312-802c-2fc26aab31cc",
                                "text": "C’est un parti pris d’exclusivisme. Elle est l’âme d’une seule amitié et de ces gens qui déshéritent leurs propres enfants pour combler quelque étranger, ami de la dernière heure."
                            },
                            {
                                "example_id": "35dac408-1b7d-4669-9cef-48f76bde05da",
                                "sense_id": "5132a57e-9025-3312-802c-2fc26aab31cc",
                                "text": "À noter l’insistance mise par Nadvi sur la supériorité et l’exclusivisme de l’islam vis-à-vis de toutes les autres religions et de tous les autres systèmes."
                            },
                            {
                                "example_id": "2662cca0-33e7-4814-9fed-3c8b85f7ccd0",
                                "sense_id": "5132a57e-9025-3312-802c-2fc26aab31cc",
                                "text": "Souvent, au long de son histoire, le particularisme d’Israël né de son élection et de son souci de garder la loi a été ressenti comme un exclusivisme..."
                            }
                        ]
                    }
                ],
