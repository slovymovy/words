{
    "word_family": [
        "communication",
        "communicative",
        "communicator",
        "communicable",
        "uncommunicative",
        "miscommunicate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16337d94-a278-3ebe-ae6c-7b2c4f0abc9b",
                    "sense_definition": "To exchange information, news, or ideas with someone through speech, writing, or other signals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exchange information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people use their smartphones to <w>communicate</w> with friends every day.",
                            "target_lang_translations": {
                                "ru": "Многие люди используют свои смартфоны, чтобы каждый день <w>общаться</w> с друзьями.",
                                "zh": "很多人每天都会用智能手机跟朋友<w>联系</w>。"
                            }
                        },
                        {
                            "text": "It is important to <w>communicate</w> effectively in a professional environment.",
                            "target_lang_translations": {
                                "ru": "В профессиональной среде важно эффективно <w>взаимодействовать</w>.",
                                "zh": "在职场环境中进行有效<w>沟通</w>很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "articulate"
                    ],
                    "common_phrases": [
                        "communicate effectively",
                        "communicate with others"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмениваться информацией, новостями или идеями с кем-либо с помощью речи, письма или других сигналов.",
                        "zh": "通过说话、写作或其他信号与他人交换信息、消息或想法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общаться",
                                "target_lang_sense_clarification": "поддерживать взаимные отношения, разговаривать"
                            },
                            {
                                "target_lang_word": "взаимодействовать",
                                "target_lang_sense_clarification": "вступать в контакт для обмена информацией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沟通",
                                "target_lang_sense_clarification": "指人与人之间交换信息、想法或感受"
                            },
                            {
                                "target_lang_word": "交流",
                                "target_lang_sense_clarification": "强调彼此交流、互相表达"
                            },
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "强调保持联系，常用于朋友、家人之间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec99aec6-f17f-31bf-8018-6eef1dc2d204",
                    "sense_definition": "To impart or transmit information, knowledge, or feelings to someone else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exchange information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager needs to <w>communicate</w> the new policy to all staff members.",
                            "target_lang_translations": {
                                "ru": "Менеджеру необходимо <w>сообщить</w> о новой политике всем сотрудникам.",
                                "zh": "经理需要把新政策<w>传达</w>给所有员工。"
                            }
                        },
                        {
                            "text": "It is vital that I <w>communicate</w> this information to you immediately.",
                            "target_lang_translations": {
                                "ru": "Жизненно важно, чтобы я немедленно <w>передал</w> вам эту информацию.",
                                "zh": "我必须立即把这条信息<w>告诉</w>你，这一点至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "articulate"
                    ],
                    "common_phrases": [
                        "communicate information",
                        "communicate a message"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать информацию, знания или чувства кому-то другому.",
                        "zh": "把信息、知识或感情传给别人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "делать известным, извещать"
                            },
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "доводить до сведения, транслировать"
                            },
                            {
                                "target_lang_word": "уведомлять",
                                "target_lang_sense_clarification": "официально извещать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传达",
                                "target_lang_sense_clarification": "把信息、意思或政策传给别人"
                            },
                            {
                                "target_lang_word": "传递",
                                "target_lang_sense_clarification": "把信息或物件转送给别人"
                            },
                            {
                                "target_lang_word": "告诉",
                                "target_lang_sense_clarification": "直接把事情告诉某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e19fe191-36b5-3621-a68b-fa5f4869dce5",
                    "sense_definition": "To be connected by an opening, door, or passage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The living room <w>communicates</w> with the back garden by these French windows.",
                            "target_lang_translations": {
                                "ru": "Гостиная <w>сообщается</w> с задним двором через эти французские окна.",
                                "zh": "客厅通过这几扇法式落地窗与后花园<w>相通</w>。"
                            }
                        },
                        {
                            "text": "The two hotel rooms <w>communicate</w> through a small internal door.",
                            "target_lang_translations": {
                                "ru": "Два гостиничных номера <w>соединены</w> небольшой внутренней дверью.",
                                "zh": "这两间酒店客房通过一扇小小的内门<w>连通</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "communicating rooms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть соединенным проемом, дверью или проходом.",
                        "zh": "通过开口、门或通道连接在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщаться",
                                "target_lang_sense_clarification": "иметь общую дверь или проход"
                            },
                            {
                                "target_lang_word": "соединяться",
                                "target_lang_sense_clarification": "быть связанным физически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相通",
                                "target_lang_sense_clarification": "指两个空间之间有门、窗或通道相连"
                            },
                            {
                                "target_lang_word": "连通",
                                "target_lang_sense_clarification": "强调房间、道路等彼此连接"
                            },
                            {
                                "target_lang_word": "相连",
                                "target_lang_sense_clarification": "较宽泛地表示物理上连接在一起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39d9b07b-4920-3262-9ac2-2c3a25f8891f",
                    "sense_definition": "To pass on a disease or physical condition to another person or animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virus was mainly <w>communicated</w> via contaminated water and poor hygiene.",
                            "target_lang_translations": {
                                "ru": "Вирус в основном <w>передавался</w> через загрязненную воду и плохую гигиену.",
                                "zh": "该病毒主要通过受污染的水和糟糕的卫生条件<w>传播</w>。"
                            }
                        },
                        {
                            "text": "Certain parasites can <w>communicate</w> infections between different species.",
                            "target_lang_translations": {
                                "ru": "Определенные паразиты могут <w>переносить</w> инфекции между различными видами.",
                                "zh": "某些寄生虫会在不同物种之间<w>传染</w>感染。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "communicate a disease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать болезнь или физическое состояние другому человеку или животному.",
                        "zh": "把疾病或某种身体状况传给另一个人或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "распространять инфекцию"
                            },
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "передавать вирус или болезнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传播",
                                "target_lang_sense_clarification": "指疾病、病毒等扩散传播"
                            },
                            {
                                "target_lang_word": "传染",
                                "target_lang_sense_clarification": "指把疾病传给别人或别的动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a497d917-0256-3315-816f-3eb035740f11",
                    "sense_definition": "To receive the bread and wine during the Christian ritual of the Eucharist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious ritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parishioners gathered at the altar to <w>communicate</w> during the morning service.",
                            "target_lang_translations": {
                                "ru": "Прихожане собрались у алтаря, чтобы <w>причаститься</w> во время утренней службы.",
                                "zh": "教友们聚集在祭坛前，在晨间礼拜中<w>领圣餐</w>。"
                            }
                        },
                        {
                            "text": "In some traditions, the congregation would <w>communicate</w> only on special feast days.",
                            "target_lang_translations": {
                                "ru": "В некоторых традициях паства <w>причащалась</w> только по особым праздничным дням.",
                                "zh": "在一些传统中，会众只在特殊节日<w>领圣餐</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать хлеб и вино во время христианского обряда Евхаристии.",
                        "zh": "在基督教圣餐礼中领受饼和酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причащаться",
                                "target_lang_sense_clarification": "принимать участие в таинстве причастия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领圣餐",
                                "target_lang_sense_clarification": "基督教中指在圣餐礼中领受饼和酒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75b6d07f-b3f0-3948-83e8-bb1dc401d90c",
                    "sense_definition": "To transmit a physical quantity or quality, such as motion or heat, from one object to another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine uses a series of gears to <w>communicate</w> motion to the wheels.",
                            "target_lang_translations": {
                                "ru": "Двигатель использует ряд шестерен, чтобы <w>передавать</w> движение колесам.",
                                "zh": "发动机利用一系列齿轮把运动<w>传递</w>给车轮。"
                            }
                        },
                        {
                            "text": "The metal rod will <w>communicate</w> the heat from the flame to the handle.",
                            "target_lang_translations": {
                                "ru": "Металлический стержень будет <w>проводить</w> тепло от пламени к ручке.",
                                "zh": "这根金属杆会把热量从火焰<w>传导</w>到把手。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать физическую величину или качество, такое как движение или тепло, от одного объекта к другому.",
                        "zh": "把运动、热等物理量或性质从一个物体传到另一个物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "транслировать энергию или движение"
                            },
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "книжн., придавать свойство или движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传递",
                                "target_lang_sense_clarification": "把运动、力量等从一个物体传到另一个物体"
                            },
                            {
                                "target_lang_word": "传导",
                                "target_lang_sense_clarification": "多指热、电等在物体间传过去"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "867cae82-7ad7-347b-ac17-1f55496c23de",
                    "sense_definition": "Describing something that is shared, joined, or made common.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shared state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that humans possess a <w>communicate</w> nature that binds them together.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что люди обладают <w>общей</w> природой, которая связывает их воедино.",
                                "zh": "那位哲学家认为，人类拥有一种把彼此联系在一起的<w>共同的</w>本性。"
                            }
                        },
                        {
                            "text": "The property was considered <w>communicate</w> among all members of the small community.",
                            "target_lang_translations": {
                                "ru": "Имущество считалось <w>совместным</w> среди всех членов небольшой общины.",
                                "zh": "这份财产被视为这个小社区全体成员<w>共有的</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English as an adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий что-то общее, соединенное или разделяемое всеми.",
                        "zh": "描述某事物是共同的、连接的或为大家所共有的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "разделяемый всеми членами группы"
                            },
                            {
                                "target_lang_word": "совместный",
                                "target_lang_sense_clarification": "принадлежащий сообществу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共同的",
                                "target_lang_sense_clarification": "指大家共同拥有或共享的"
                            },
                            {
                                "target_lang_word": "共有的",
                                "target_lang_sense_clarification": "指由全体成员共同拥有的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}