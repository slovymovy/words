                                "example_id": "0076c3a2-4590-4197-a868-abe06bdde044",
                                "sense_id": "82a01909-7a59-3b96-bb52-e7a1e3e3e453",
                                "text": "„Im Januar 1942 war bei 21 Nummern noch nicht klar, ob es sich um einen offenen oder geschlossenen Nummernstempel gehandelt hatte.“"
                            },
                            {
                                "example_id": "d306bb4a-303b-4bed-b105-69747c8c7d95",
                                "sense_id": "82a01909-7a59-3b96-bb52-e7a1e3e3e453",
                                "text": "„Auch der zweite bekannte Brief mit Nummernstempel »41« für Ettenheim hätte eigentlich eine Frankierung mit 6 Kreuzern erfordert und stammt aus der Korrespondenz des Freiherrn von Türckheim.“"
                            }
