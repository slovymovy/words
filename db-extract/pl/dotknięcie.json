                        "sense_id": "c4b1a2dc-c452-3886-b691-87355e79e66f",
                        "entry_id": "377c4ec4-d7d2-347e-add6-1adc9293c7ee",
                        "glosses": [
                            "rzecz. odczas. od dotknąć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be54bcba-c013-4bf5-9eea-944b801077ef",
                                "sense_id": "c4b1a2dc-c452-3886-b691-87355e79e66f",
                                "text": "Oparła się miękkiem dotknięciem swego ramienia na mojem ramieniu i tak szliśmy dalej po bezbrzeżnie pustych ulicach, nasłuchując ciągle, w której stronie huczą strzały."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
