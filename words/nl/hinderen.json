            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03d2c4d9-291b-36f9-b835-c6266684e10e",
                    "sense_definition": "iemand storen of lastigvallen bij wat diegene aan het doen is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "storen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je de muziek zachter kunnen zetten, want het <w>hindert</w> mij bij het studeren.",
                            "target_lang_translations": {
                                "en": "Could you turn the music down, because it is <w>disturbing</w> me while I study.",
                                "fr": "Pourrais-tu baisser la musique, car cela me <w>gêne</w> pour étudier."
                            }
                        },
                        {
                            "text": "Ik wil je niet <w>hinderen</w> tijdens je werk, maar ik heb een korte vraag.",
                            "target_lang_translations": {
                                "en": "I don't want to <w>bother</w> you during your work, but I have a quick question.",
                                "fr": "Je ne veux pas vous <w>déranger</w> pendant votre travail, mais j'ai une petite question."
                            }
                        }
                    ],
                    "synonyms": [
                        "derangeren",
                        "storen",
                        "lastigvallen"
                    ],
                    "antonyms": [
                        "helpen"
                    ],
                    "common_phrases": [
                        "iemand hinderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to disturb or bother someone while they are doing something",
                        "fr": "déranger ou importuner quelqu'un dans ce qu'il est en train de faire"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disturb",
                                "target_lang_sense_clarification": "to interrupt someone's activities"
                            },
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "to annoy or cause trouble for someone"
                            },
                            {
                                "target_lang_word": "hinder",
                                "target_lang_sense_clarification": "to make it difficult for someone to do something"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gêner",
                                "target_lang_sense_clarification": "déranger ou troubler quelqu'un dans son activité"
                            },
                            {
                                "target_lang_word": "déranger",
                                "target_lang_sense_clarification": "interrompre ou importuner quelqu'un"
                            },
                            {
                                "target_lang_word": "perturber",
                                "target_lang_sense_clarification": "troubler le déroulement de ce que fait quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f804861-eba5-3580-858d-1a3d1ed68fff",
                    "sense_definition": "de voortgang of beweging van iets of iemand vertragen of tegenhouden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "blokkeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De omgevallen boom op de weg zal het verkeer ernstig <w>hinderen</w>.",
                            "target_lang_translations": {
                                "en": "The fallen tree on the road will seriously <w>hinder</w> the traffic.",
                                "fr": "L'arbre tombé sur la route va sérieusement <w>entraver</w> la circulation."
                            }
                        },
                        {
                            "text": "Slecht weer kan de voortgang van de bouw flink <w>hinderen</w>.",
                            "target_lang_translations": {
                                "en": "Bad weather can significantly <w>impede</w> the progress of the construction.",
                                "fr": "Le mauvais temps peut considérablement <w>ralentir</w> l'avancement des travaux."
                            }
                        }
                    ],
                    "synonyms": [
                        "beletten",
                        "belemmeren"
                    ],
                    "antonyms": [
                        "helpen"
                    ],
                    "common_phrases": [
                        "de voortgang hinderen",
                        "het verkeer hinderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to slow down or stop the progress or movement of something or someone",
                        "fr": "ralentir ou bloquer la progression ou le mouvement de quelque chose ou de quelqu'un"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hinder",
