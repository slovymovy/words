                                            {
                                                "example_id": "74347ace-6576-4773-b727-b76ddb45922e",
                                                "sense_id": "95d2c04c-b224-338e-bad0-e2940a1e4f3e",
                                                "text": "It is quite true that the yells and shrieks, the bonnetings and ticklings, the hat throwing and fighting, give way for the instant to an intense desire to behold the sight, and the immense concourse was momentarily hushed in the depth of its excitement […]"
                                            }
                                        ]
