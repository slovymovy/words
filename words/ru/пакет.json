    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0efd1d4-4306-3a77-abc0-4101d1859a63",
                    "sense_definition": "Небольшой мешок из бумаги, полиэтилена или другого мягкого материала для упаковки и переноски вещей.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В магазине мне дали большой бумажный <пакет> для покупок.",
                            "target_lang_translations": {
                                "en": "At the store, they gave me a large paper <bag> for shopping.",
                                "de": "Im Laden gab man mir eine große <Tüte> aus Papier für die Einkäufe."
                            }
                        },
                        {
                            "text": "Она положила яблоки в прозрачный <пакет> и пошла к кассе.",
                            "target_lang_translations": {
                                "en": "She put the apples in a transparent <bag> and went to the checkout.",
                                "de": "Sie legte die Äpfel in eine durchsichtige <Tüte> und ging zur Kasse."
                            }
                        }
                    ],
                    "synonyms": [
                        "мешок",
                        "кулёк"
                    ],
                    "common_phrases": [
                        "полиэтиленовый пакет",
                        "бумажный пакет",
                        "пакет с продуктами",
                        "мусорный пакет"
                    ],
                    "target_lang_definitions": {
                        "en": "A bag made of paper, plastic, or other soft material for packing and carrying items.",
                        "de": "Ein Beutel aus Papier, Kunststoff oder anderem weichen Material zum Verpacken und Tragen von Gegenständen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bag",
                                "target_lang_sense_clarification": "general container"
                            },
                            {
                                "target_lang_word": "plastic bag",
                                "target_lang_sense_clarification": "specific material"
                            },
                            {
                                "target_lang_word": "carrier bag",
                                "target_lang_sense_clarification": "shopping context"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Tüte",
                                "target_lang_sense_clarification": "allgemeiner Behälter aus Papier oder Plastik"
                            },
                            {
                                "target_lang_word": "Plastiktüte",
                                "target_lang_sense_clarification": "spezifisch aus Kunststoff"
                            },
                            {
                                "target_lang_word": "Einkaufstasche",
                                "target_lang_sense_clarification": "im Kontext des Einkaufens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6cdba9a-1e6e-3cbe-b79c-06785e311ae9",
                    "sense_definition": "Картонная упаковка прямоугольной формы для жидких продуктов (молока, сока, кефира).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На завтрак он обычно выпивает целый <пакет> апельсинового сока.",
                            "target_lang_translations": {
                                "en": "For breakfast, he usually drinks a whole <carton> of orange juice.",
                                "de": "Zum Frühstück trinkt er normalerweise einen ganzen <Karton> Orangensaft."
                            }
                        },
                        {
                            "text": "Пожалуйста, купи <пакет> молока по дороге домой.",
                            "target_lang_translations": {
                                "en": "Please buy a <carton> of milk on your way home.",
                                "de": "Bitte kauf auf dem Heimweg eine <Packung> Milch."
                            }
                        }
                    ],
                    "synonyms": [
                        "упаковка",
                        "коробка"
                    ],
                    "common_phrases": [
                        "пакет молока",
                        "пакет сока",
                        "открыть пакет"
                    ],
                    "target_lang_definitions": {
                        "en": "A cardboard container, usually rectangular, for liquid products like milk or juice.",
                        "de": "Eine meist rechteckige Verpackung aus Karton für flüssige Lebensmittel wie Milch oder Saft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carton",
                                "target_lang_sense_clarification": "for liquids"
                            },
                            {
                                "target_lang_word": "pack",
                                "target_lang_sense_clarification": "packaging unit"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Packung",
                                "target_lang_sense_clarification": "allgemeine Verpackungseinheit"
                            },
                            {
                                "target_lang_word": "Karton",
                                "target_lang_sense_clarification": "speziell für Flüssigkeiten wie Milch oder Saft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a5118f2-9469-3565-a652-4318ef4a8f69",
                    "sense_definition": "Набор или комплект взаимосвязанных документов, предметов или услуг, предлагаемых вместе.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "set",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для получения визы необходимо собрать полный <пакет> документов.",
                            "target_lang_translations": {
                                "en": "To obtain a visa, it is necessary to collect a complete <package> of documents.",
                                "de": "Um ein Visum zu erhalten, muss man ein vollständiges <Paket> an Dokumenten zusammenstellen."
                            }
                        },
                        {
                            "text": "Компания предлагает сотрудникам хороший социальный <пакет>.",
                            "target_lang_translations": {
                                "en": "The company offers employees a good benefits <package>.",
                                "de": "Das Unternehmen bietet den Mitarbeitern ein gutes Sozial<paket>."
                            }
                        }
                    ],
                    "synonyms": [
                        "набор",
                        "комплект"
                    ],
                    "common_phrases": [
                        "пакет документов",
                        "социальный пакет",
                        "контрольный пакет акций",
                        "пакет предложений"
                    ],
                    "target_lang_definitions": {
                        "en": "A set or collection of related documents, items, or services offered together.",
                        "de": "Eine Zusammenstellung von zusammengehörigen Dokumenten, Gegenständen oder Dienstleistungen, die gemeinsam angeboten werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "package",
                                "target_lang_sense_clarification": "set of items/services"
                            },
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "collection"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Paket",
                                "target_lang_sense_clarification": "im Sinne von Bündel oder Set"
                            },
                            {
                                "target_lang_word": "Set",
                                "target_lang_sense_clarification": "Sammlung von Dingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56cca827-05e2-36cf-a585-0b5423448bae",
                    "sense_definition": "Конверт или свёрток с письмами, документами или важными бумагами (часто официальный).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Курьер доставил секретный <пакет> прямо в кабинет директора.",
                            "target_lang_translations": {
                                "en": "The courier delivered the secret <packet> directly to the director's office.",
                                "de": "Der Kurier lieferte ein geheimes <Paket> direkt in das Büro des Direktors."
                            }
                        },
                        {
                            "text": "Он вскрыл плотный <пакет> и достал оттуда важные бумаги.",
                            "target_lang_translations": {
                                "en": "He opened the thick <packet> and took out important papers.",
                                "de": "Er öffnete das dicke <Paket> und holte wichtige Papiere heraus."
                            }
                        }
                    ],
                    "synonyms": [
                        "конверт",
                        "свёрток",
                        "бандероль"
                    ],
                    "common_phrases": [
                        "служебный пакет",
                        "секретный пакет",
                        "передать пакет"
                    ],
                    "target_lang_definitions": {
                        "en": "An envelope or bundle containing letters, documents, or important papers.",
                        "de": "Ein Umschlag oder Bündel, das Briefe, Dokumente oder wichtige Unterlagen enthält."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "packet",
                                "target_lang_sense_clarification": "small package/mail"
                            },
                            {
                                "target_lang_word": "parcel",
                                "target_lang_sense_clarification": "wrapped package"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Paket",
                                "target_lang_sense_clarification": "versandtes Bündel"
                            },
                            {
                                "target_lang_word": "Umschlag",
                                "target_lang_sense_clarification": "für Briefe oder Dokumente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a1a06a9-c53e-39ad-bf23-472d6dd20900",
                    "sense_definition": "Блок данных, передаваемый по компьютерной сети как единое целое.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за плохой связи часть <пакетов> данных была потеряна.",
                            "target_lang_translations": {
                                "en": "Due to poor connection, some of the data <packets> were lost.",
                                "de": "Wegen der schlechten Verbindung ging ein Teil der Daten<pakete> verloren."
                            }
                        },
                        {
                            "text": "Программа анализирует входящие сетевые <пакеты> на наличие ошибок.",
                            "target_lang_translations": {
                                "en": "The program analyzes incoming network <packets> for errors.",
                                "de": "Das Programm analysiert eingehende Netzwerk<pakete> auf Fehler."
                            }
                        }
                    ],
