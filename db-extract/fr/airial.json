                        "glosses": [
                            "Vaste terrain herbeux ombragé de chênes, sur lequel sont disposés les bâtiments des habitations rurales landaises."
                        ],
                        "tags": [
                            "Aquitaine"
                        ],
                        "examples": [
                            {
                                "example_id": "bdfa1f14-7ae7-4337-81c9-574fa6e36d16",
                                "sense_id": "85813f48-6669-35d6-8dd3-26a3d13cefd3",
                                "text": "Il a plu toute la journée d’hier et toute la nuit. Des flaques subsistent sur l’airial, frangées d’une fine écume jaune pâle."
                            },
                            {
                                "example_id": "e71282c0-8d03-447c-97ad-b4953686d57a",
                                "sense_id": "85813f48-6669-35d6-8dd3-26a3d13cefd3",
                                "text": "Ce cocon de verdure qui entourait l’airial de Marie a aussi disparu sur la route de Joué, où la tour de guet culmine, esseulée, au milieu d’un paysage lunaire."
                            }
                        ]
                    }
