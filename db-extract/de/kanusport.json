                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c32729ed-bae2-4f5d-add9-542f0a70767d",
                                "sense_id": "dd8d1e17-33bf-39df-ae3d-4f4ffb34057c",
                                "text": "„Im Kanusport wird grundsätzlich zwischen den Bootsklassen Kajak und Kanadier unterschieden. Während es im Kanu-Freizeitsport sehr unterschiedliche Bootsgrößen mit bis zu vier Paddlern im Kajak und bis zu zehn Paddler im Kanadier gibt, sind im Wettkampfsport nur bestimmte Bootsklassen gebräuchlich, für die in jeder Kanu-Disziplin eigene Baubestimmungen bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
