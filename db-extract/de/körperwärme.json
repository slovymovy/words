                        "entry_id": "130a21d3-7735-332b-b4d4-0d66eca22334",
                        "glosses": [
                            "Wärme, die durch einen menschlichen oder tierischen Körper erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50cef42-6224-46ac-87cd-725420f2125c",
                                "sense_id": "79c71d57-20f5-3f0d-b616-f48ff2285b12",
                                "text": "„Am Freitag suchte die indische Luftwaffe mit speziellen Körperwärme-Sensoren Hunderte unbewohnte Inseln in der Andamanensee, einem Randmeer des Indischen Ozeans, ab.“"
                            },
                            {
                                "example_id": "778aabd2-e80b-4263-b600-1828b3f6d550",
                                "sense_id": "79c71d57-20f5-3f0d-b616-f48ff2285b12",
                                "text": "„Er spürt ihre Körperwärme, riecht ihren Duft, süß, warm, würzig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
