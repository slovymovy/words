                "senses": [
                    {
                        "sense_id": "ea0e6fa9-769f-3868-b481-5ae0c15a00d8",
                        "entry_id": "9851e640-d22a-3780-8573-e656457b2959",
                        "glosses": [
                            "warmer trockener Wind, der von der Sahara aus (Staub mit sich führend) auf die Kanarischen Inseln und Madeira zuweht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b8f9ed-ea4a-4cd0-aa7f-d203cf7fcea2",
                                "sense_id": "ea0e6fa9-769f-3868-b481-5ae0c15a00d8",
                                "text": "„Zuweilen tritt ein staubführender heißer Ostwind (Leste) ein, wie auf den Kanaren, ein afrikanischer Wüstenwind, von dem Taylor eine eingehendere Beschreibung geliefert hat[…]. Er gibt auch Beispiele für die Temperatur und Luftfeuchtigkeit beim Auftreten des Leste[…].“"
                            },
                            {
                                "example_id": "ec14b3ea-78a4-48ef-a535-396dcbff003d",
                                "sense_id": "ea0e6fa9-769f-3868-b481-5ae0c15a00d8",
                                "text": "„Nur wenn der heiße Leste, ein aus Afrika kommender Südostwind, weht, ist ein Temperaturanstieg auf über 30 Grad zu verzeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
