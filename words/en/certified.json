{
    "word_family": [
        "certifiable",
        "certificate",
        "certification",
        "certifier",
        "certitude"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c8d7ce0-7d66-3e29-80bf-f2c2212977ff",
                    "sense_definition": "Having met an official standard or completed a specific training program.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>certified</w> public accountant with over ten years of experience.",
                            "target_lang_translations": {
                                "ru": "Она — <w>дипломированный</w> общественный бухгалтер с более чем десятилетним стажем."
                            }
                        },
                        {
                            "text": "The school offers a <w>certified</w> training program for aspiring chefs.",
                            "target_lang_translations": {
                                "ru": "Школа предлагает <w>сертифицированную</w> программу обучения для начинающих поваров."
                            }
                        }
                    ],
                    "synonyms": [
                        "qualified",
                        "accredited",
                        "licensed"
                    ],
                    "antonyms": [
                        "unqualified",
                        "unlicensed"
                    ],
                    "common_phrases": [
                        "certified training program",
                        "certified public accountant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий официальному стандарту или завершивший специальную программу обучения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломированный",
                                "target_lang_sense_clarification": "имеющий диплом или сертификат специалиста"
                            },
                            {
                                "target_lang_word": "сертифицированный",
                                "target_lang_sense_clarification": "прошедший официальную сертификацию"
                            },
                            {
                                "target_lang_word": "квалифицированный",
                                "target_lang_sense_clarification": "имеющий необходимую квалификацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e16efef8-e1f1-3861-bb47-b624992c8b53",
                    "sense_definition": "Authenticated or verified in writing by an official document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must provide a <w>certified</w> copy of your birth certificate for the application.",
                            "target_lang_translations": {
                                "ru": "Для подачи заявления вы должны предоставить <w>заверенную</w> копию свидетельства о рождении."
                            }
                        },
                        {
                            "text": "The lawyer requested a <w>certified</w> document to prove the ownership of the land.",
                            "target_lang_translations": {
                                "ru": "Адвокат запросил <w>заверенный</w> документ, чтобы подтвердить право собственности на землю."
                            }
                        }
                    ],
                    "synonyms": [
                        "authenticated",
                        "verified",
                        "validated"
                    ],
                    "antonyms": [
                        "unverified",
                        "forged"
                    ],
                    "common_phrases": [
                        "certified copy",
                        "certified document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подтвержденный или заверенный в письменной форме официальным документом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заверенный",
                                "target_lang_sense_clarification": "подтвержденный подписью или печатью"
                            },
                            {
                                "target_lang_word": "удостоверенный",
                                "target_lang_sense_clarification": "официально подтвержденный"
                            },
                            {
                                "target_lang_word": "подлинный",
                                "target_lang_sense_clarification": "о документе, чья аутентичность подтверждена"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f757d36-ba0d-3de2-8c9e-6e514b75b716",
                    "sense_definition": "simple past and past participle of <w>certify</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician <w>certified</w> that the equipment was safe for use.",
                            "target_lang_translations": {
                                "ru": "Техник <w>подтвердил</w>, что оборудование безопасно для использования."
                            }
                        },
                        {
                            "text": "The results were <w>certified</w> by the board of directors yesterday.",
                            "target_lang_translations": {
                                "ru": "Результаты были <w>утверждены</w> советом директоров вчера."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «certify» (удостоверять, сертифицировать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтвердил",
                                "target_lang_sense_clarification": "в значении действия в прошлом"
                            },
                            {
                                "target_lang_word": "заверил",
                                "target_lang_sense_clarification": "официально подтвердил подлинность"
                            },
                            {
                                "target_lang_word": "сертифицированный",
                                "target_lang_sense_clarification": "в качестве причастия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}