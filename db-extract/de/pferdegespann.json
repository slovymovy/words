                    {
                        "sense_id": "8d96ee3a-d35f-33f5-8798-dbf931f64ff0",
                        "entry_id": "6a584b3e-b15b-357d-964a-6ba6f48367cd",
                        "glosses": [
                            "Gespann, bei dem Pferde als Zugtiere verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81fbc35e-60d5-46a4-b2d6-21d373a0f195",
                                "sense_id": "8d96ee3a-d35f-33f5-8798-dbf931f64ff0",
                                "text": "„Er konnte eine gigantische Nervensäge sein, nicht als Bodybuilding, Möhrensaft und Steroide im Kopf. Und immer genug Koffein im Blut, um ein komplettes Pferdegespann aus den Hufen zu hauen.“"
                            },
                            {
                                "example_id": "9c91418f-d2ec-4c46-b88d-ea861a112b67",
                                "sense_id": "8d96ee3a-d35f-33f5-8798-dbf931f64ff0",
                                "text": "„Teilnehmer steigen in Northeim in den Bummelzug und werden ab Bodenfelde per Leiterwagen und Pferdegespann zum Tagungsort kutschiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
