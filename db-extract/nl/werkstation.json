                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A building in an airport where passengers transfer from ground transportation to the facilities that allow them to board airplanes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07aedf1e-68e2-4ed5-9f1a-561159e1e37d",
                                                "sense_id": "785c9163-71c1-39e1-96f7-624aec446525",
                                                "text": "Terminal 1 is for domestic flights, whereas Terminal 2 is for international flights."
                                            },
                                            {
                                                "example_id": "cb608c80-71e5-4dd4-9dca-6401ca1a0a22",
                                                "sense_id": "785c9163-71c1-39e1-96f7-624aec446525",
                                                "text": "A shuttle service runs free of charge between the three terminals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21b6f11-88a8-3516-93c7-523e02f3beea",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A harbour facility where ferries embark and disembark passengers and load and unload vehicles."
