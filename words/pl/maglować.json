{
    "word_family": [
        "magiel",
        "maglownica",
        "maglarnia",
        "zmaglować",
        "wymaglować",
        "przemaglować"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c988d3f6-04ca-3e9f-bca4-3a0d236c45e7",
                    "sense_definition": "prasować bieliznę, pościel lub tkaniny za pomocą magla",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prasowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja babcia zawsze woli oddawać pościel do pralni, aby dokładnie ją <w>maglować</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка всегда предпочитает сдавать постельное бельё в прачечную, чтобы тщательно его <w>катать</w>."
                            }
                        },
                        {
                            "text": "Pracownicy pralni przez cały poranek <w>maglowali</w> obrusy przygotowane na wielkie przyjęcie.",
                            "target_lang_translations": {
                                "ru": "Работники прачечной всё утро <w>гладили на катке</w> скатерти, подготовленные для большого приёма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maglować pościel",
                        "maglować obrusy"
                    ],
                    "target_lang_definitions": {
                        "ru": "гладить, прокатывать бельё или ткань с помощью катка (гладильного пресса)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катать",
                                "target_lang_sense_clarification": "гладить бельё с помощью катка или скалки"
                            },
                            {
                                "target_lang_word": "гладить",
                                "target_lang_sense_clarification": "проглаживать на катке или прессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54365ddc-53ae-39ac-a3a3-4d4b51449b05",
                    "sense_definition": "zadawać komuś natarczywe pytania; dociekliwie kogoś przesłuchiwać",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wypytywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziennikarze bez litości <w>maglowali</w> polityka na konferencji prasowej przez ponad dwie godziny.",
                            "target_lang_translations": {
                                "ru": "Журналисты безжалостно <w>допрашивали</w> политика на пресс-конференции более двух часов."
                            }
                        },
                        {
                            "text": "Policjanci zaczęli <w>maglować</w> podejrzanego świadka, próbując ustalić jego prawdziwe alibi.",
                            "target_lang_translations": {
                                "ru": "Полицейские принялись <w>колоть</w> подозрительного свидетеля, пытаясь выяснить его настоящее алиби."
                            }
                        }
                    ],
                    "synonyms": [
                        "wypytywać"
                    ],
                    "common_phrases": [
                        "maglować świadka",
                        "maglować podejrzanego"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "допрашивать, засыпать кого-либо назойливыми или дотошными вопросами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допрашивать",
                                "target_lang_sense_clarification": "настойчиво расспрашивать с пристрастием"
                            },
                            {
                                "target_lang_word": "пытать",
                                "target_lang_sense_clarification": "в переносном смысле: выпытывать, мучить вопросами"
                            },
                            {
                                "target_lang_word": "распекать",
                                "target_lang_sense_clarification": "подвергать строгому разбору или допросу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3214d7f5-2cbc-3569-853b-70244280f526",
                    "sense_definition": "uparcie i wielokrotnie wracać do jakiegoś tematu, ciągle go analizując",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omawianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestańmy bez końca <w>maglować</w> ten sam problem i przejdźmy wreszcie do konkretnych działań.",
                            "target_lang_translations": {
                                "ru": "Давайте перестанем бесконечно <w>мусолить</w> одну и ту же проблему и перейдём наконец к конкретным действиям."
                            }
                        },
                        {
                            "text": "Na każdym zebraniu zarząd nieustannie <w>magluje</w> sprawę zeszłorocznego budżetu.",
                            "target_lang_translations": {
                                "ru": "На каждом собрании правление без конца <w>пережёвывает</w> вопрос о прошлогоднем бюджете."
                            }
                        }
                    ],
                    "synonyms": [
                        "omawiać"
                    ],
                    "common_phrases": [
                        "maglować ten sam temat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянно мусолить, пережёвывать или вновь и вновь возвращаться к одной и той же теме"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусолить",
                                "target_lang_sense_clarification": "постоянно и нудно обсуждать одно и то же"
                            },
                            {
                                "target_lang_word": "пережёвывать",
                                "target_lang_sense_clarification": "многократно повторять и обсуждать известное"
                            },
                            {
                                "target_lang_word": "полоскать",
                                "target_lang_sense_clarification": "постоянно муссировать какой-либо вопрос"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}