                        "glosses": [
                            "Relatif à Vladimir Ilitch Lénine, son action, sa personnalité, etc."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "71e52934-e078-4cca-8215-6da9b1142846",
                                "sense_id": "7d605f5c-33a8-3112-beed-0215e665705b",
                                "text": "Seul le respect absolu des normes léniniennes au sein du Parti et de l’État, pourra garantir que ces « phénomènes négatifs » ne se répètent plus."
                            },
                            {
                                "example_id": "f03d5edd-c5d4-45ad-a1ce-71b756369ca0",
                                "sense_id": "7d605f5c-33a8-3112-beed-0215e665705b",
                                "text": "Ce politisme éclaire ce trait léninien qu’est l’impatience, la volonté de sauter par-dessus le temps."
                            }
                        ]
                    }
