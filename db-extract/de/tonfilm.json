                "senses": [
                    {
                        "sense_id": "fc763dc7-172c-39ef-8a04-0c8cae9d897d",
                        "entry_id": "ad960182-d95c-35f0-a3a5-b0990d8910b2",
                        "glosses": [
                            "Film, bei dem außer dem Bild auch Geräusche, Musik und Sprache wiedergegeben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0132713e-fe13-47b7-a0a1-5db56d129175",
                                "sense_id": "fc763dc7-172c-39ef-8a04-0c8cae9d897d",
                                "text": "„Von einem späteren Zwischenspiel abgesehen, machte der Tonfilm Alf Bertini als Musiker ein für allemal den Garaus, unwiderruflich und schrecklich endgültig.“"
                            },
                            {
                                "example_id": "065d19f6-87a9-4239-a5a3-b56f56e7a0c3",
                                "sense_id": "fc763dc7-172c-39ef-8a04-0c8cae9d897d",
                                "text": "„Ab 1929 wurden auch erste jiddische Tonfilme produziert, vor allem in Polen und den USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
