                    {
                        "sense_id": "18f72b70-51cb-3224-b43a-ffcb768d8b7a",
                        "entry_id": "2655b6e0-0e1e-3215-a63c-f4a97b164449",
                        "glosses": [
                            "korte dikke stok, bedoeld om lijfstraf mee uit te delen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8bbc7f4-6ad8-4a3b-9dfa-80ad7eab8340",
                                "sense_id": "18f72b70-51cb-3224-b43a-ffcb768d8b7a",
                                "text": "De bende kwam de straat in met knuppels en kettingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d699e51-1d9e-4175-ae0a-409e8e80878d",
                        "source_entry_id": "2655b6e0-0e1e-3215-a63c-f4a97b164449",
                        "source_sense_id": "18f72b70-51cb-3224-b43a-ffcb768d8b7a",
                        "source_sense_description": "korte dikke stok, bedoeld om lijfstraf mee uit te delen",
                        "target_lang_word": "Knüppel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knüppel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                        "entry_id": "f2484c3c-137a-3b09-9bca-095953533a12",
                                        "glosses": [
                                            "dicker Stock, der meist als Schlagwaffe verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9078d7bf-eb07-40fc-825e-11335609ec50",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "Er nahm den Knüppel und schlug zurück."
                                            },
                                            {
                                                "example_id": "79026bdb-ac08-4e62-b560-364cc73ca6a2",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "„Heu und Federvieh holten sie aus den Ställen, verflucht von den Bauern, die mit Knüppeln und Mistforken drohten, aber nichts gegen die Waffen der Reiter ausrichten konnten.“"
                                            },
                                            {
                                                "example_id": "3ea3173e-3e1d-40b9-ad49-4478c4457838",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "„Das war, als würfe man jemandem einen Knüppel zwischen die Beine.“"
                                            },
                                            {
                                                "example_id": "be780d62-44c6-4513-a823-9dc31be471f7",
                                                "sense_id": "928403ab-ad33-3afc-84ed-47f71cc1b96a",
                                                "text": "„Der Gegner dieses Fechters, der den Degen wegwarf und einen Knüppel in die Hand nahm, das waren die Russen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "605d289e-33fd-3f60-add1-6a87e9998bac",
                                        "entry_id": "f2484c3c-137a-3b09-9bca-095953533a12",
                                        "glosses": [
                                            "Brötchen aber zusätzlich mit Milch hergestellt"
                                        ],
                                        "tags": [
                                            "in Berlin und Umgebung eine Backware ähnlich einer Schrippe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928ab616-ae57-4fca-ab80-0b0d5d2a2d7c",
                                                "sense_id": "605d289e-33fd-3f60-add1-6a87e9998bac",
                                                "text": "Oh wie lecker, hier gibt es Knüppel und Splitterbrötchen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10a88908-0f7f-4a4c-b2af-970117ca1515",
                        "source_entry_id": "2655b6e0-0e1e-3215-a63c-f4a97b164449",
                        "source_sense_id": "18f72b70-51cb-3224-b43a-ffcb768d8b7a",
                        "source_sense_description": "korte dikke stok, bedoeld om lijfstraf mee uit te delen",
                        "target_lang_word": "bludgeon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bludgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20f226ae-ced5-3856-b547-b8680faac42e",
                                        "entry_id": "531f9f58-1c57-3ed1-ba82-eb54fa334497",
                                        "glosses": [
                                            "A short, heavy club, often of wood, which is thicker or loaded at one end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c7c67b-47eb-4094-b0cc-fb8161555ef7",
                                                "sense_id": "20f226ae-ced5-3856-b547-b8680faac42e",
                                                "text": "We smashed the radio with a steel bludgeon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bludgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b945a3-6adb-36d7-9674-58b566749215",
                                        "entry_id": "9bb67499-e645-3c91-bc54-18b7272c6cd7",
                                        "glosses": [
                                            "To strike or hit with something hard, usually on the head; to club."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e65eb3-52bf-4720-b843-7b324bb78b32",
                                                "sense_id": "d7b945a3-6adb-36d7-9674-58b566749215",
                                                "text": "The apprehended rioter was bludgeoned to death."
                                            },
                                            {
                                                "example_id": "19b7861d-5b75-49fa-94ab-7761c92d1a67",
                                                "sense_id": "d7b945a3-6adb-36d7-9674-58b566749215",
                                                "text": "They didn't get shot to death in hold-ups, strangled to death in rapes, stabbed to death in saloons, bludgeoned to death with axes by parents or children or die summarily by some other act of God."
                                            },
                                            {
                                                "example_id": "8ee8e254-0811-458c-a97c-c45121d8473a",
                                                "sense_id": "d7b945a3-6adb-36d7-9674-58b566749215",
                                                "text": "Thomas Briggs, a senior bank clerk in the City, lived in Hackney, and on 9 July 1864 he was returning there by train from Fenchurch Street after a Saturday spent at work when he was bludgeoned to death in a first-class carriage, probably by a young German tailor named Franz Müller. (Let's hope it was Müller, because he was hanged for it.) And so Briggs was an all-round pioneer: an early commuter and the very first victim of a railway murder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe243e6-6b7f-395c-a15d-524a5cc702e2",
                                        "entry_id": "9bb67499-e645-3c91-bc54-18b7272c6cd7",
                                        "glosses": [
                                            "To coerce someone, as if with a bludgeon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c05ee35f-a6bd-4ce1-94d0-14a4d988ecdb",
                                                "sense_id": "8fe243e6-6b7f-395c-a15d-524a5cc702e2",
                                                "text": "Their favorite method was bludgeoning us with the same old arguments in favor of their opinions."
                                            },
                                            {
                                                "example_id": "db731b25-829c-4919-b6ee-1952fba95233",
                                                "sense_id": "8fe243e6-6b7f-395c-a15d-524a5cc702e2",
                                                "text": "Gianna Parasini: You've never worked in the corporate world, have you, Commander? You can't bludgeon through bureaucracy.\nShepard: I can bludgeon pretty hard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
