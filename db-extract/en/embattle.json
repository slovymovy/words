                        "glosses": [
                            "A merlon, or a single one of the series of solid projections of a battlement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4611d171-d215-45d8-87fc-10d5f524ebe8",
                                "sense_id": "b492fb0a-ebe6-3fa8-93f0-a83a7ca8cea8",
                                "text": "Again, it can be drawn with the angle of the limbs being greater or less than a right angle, but they will appear to conflict with the embattles which have to be rectangular. In some ordinaries such as the fess, there must be an odd number of embattles, otherwise it will start high and end low [...]"
                            }
                        ]
                    }
                ],
