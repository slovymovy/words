                                        "examples": [
                                            {
                                                "example_id": "08452301-43da-4c4c-bf78-0a64590f391d",
                                                "sense_id": "dc35864d-b334-3628-8464-dbc197d5d6eb",
                                                "text": "On promet également de diminuer des problèmes sociaux comme l’itinérance , la violence conjugale , le maltraitement des enfants et le suicide."
                                            },
                                            {
                                                "example_id": "273bfbf9-ce40-49f4-a09d-b4d4e094eed0",
                                                "sense_id": "dc35864d-b334-3628-8464-dbc197d5d6eb",
                                                "text": "Et faire condamner ledit Thévenin en 3000 livres d’intérêts pour le prétendu assassinat par lui commis en la personne de sa femme, et maltraitements à lui [Duchemin] commis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
