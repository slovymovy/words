                    {
                        "sense_id": "872ce776-09ba-3f56-97af-fc6acc695ba5",
                        "entry_id": "4a989d70-5da5-348d-b160-f9b0ca7ec260",
                        "glosses": [
                            "freistehendes, meist kleines, einfach gebautes Gebäude, das in einem Garten steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92e3b8a-4687-4273-81f7-40dfc4065cb1",
                                "sense_id": "872ce776-09ba-3f56-97af-fc6acc695ba5",
                                "text": "Die von ihm selbst gebaute Gartenlaube ist beim letzten Sturm zusammengekracht."
                            },
                            {
                                "example_id": "47abe377-604e-44dc-b1b0-7baf47d0d3ff",
                                "sense_id": "872ce776-09ba-3f56-97af-fc6acc695ba5",
                                "text": "„Dieser sagte, er solle im Gasthaus warten, und führte die beiden Schwestern in eine Gartenlaube, wo er sie einschloß.“"
                            },
                            {
                                "example_id": "a94e8ddf-feca-43b2-9c81-24831e736b1c",
                                "sense_id": "872ce776-09ba-3f56-97af-fc6acc695ba5",
                                "text": "„Bis Mitternacht machten die Gastgeber in der Gartenlaube ihrer Empörung Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
