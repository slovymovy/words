{
    "word_family": [
        "beantwoorden",
        "antwoord",
        "beantwoord"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c9cf26d-3441-3a81-abd8-d0cfeb637c21",
                    "sense_definition": "geen antwoord gekregen hebben of gestuurd hebben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op zijn bureau lagen nog veel <w>onbeantwoorde</w> brieven van de afgelopen week.",
                            "target_lang_translations": {
                                "en": "There were still many <w>unanswered</w> letters from the past week on his desk."
                            }
                        },
                        {
                            "text": "Het is onbeleefd om een zakelijke e-mail zo lang <w>onbeantwoord</w> te laten.",
                            "target_lang_translations": {
                                "en": "It is rude to leave a business email <w>unanswered</w> for so long."
                            }
                        }
                    ],
                    "antonyms": [
                        "beantwoord"
                    ],
                    "common_phrases": [
                        "onbeantwoorde brieven",
                        "onbeantwoorde e-mail"
                    ],
                    "target_lang_definitions": {
                        "en": "not having received or sent a reply"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unanswered",
                                "target_lang_sense_clarification": "of letters or emails"
                            },
                            {
                                "target_lang_word": "unreplied",
                                "target_lang_sense_clarification": "not responded to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c35d268-b74a-3621-95c0-5bd7962864e2",
                    "sense_definition": "van een probleem of vraag: dat er nog geen oplossing of uitsluitsel voor is gevonden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oplossing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe het nu verder moet met de kunstgrasvelden is een nog <w>onbeantwoorde</w> vraag.",
                            "target_lang_translations": {
                                "en": "How to proceed with the artificial grass pitches is a still <w>unanswered</w> question."
                            }
                        },
                        {
                            "text": "Veel wetenschappelijke kwesties blijven voorlopig nog <w>onbeantwoord</w> door gebrek aan data.",
                            "target_lang_translations": {
                                "en": "Many scientific issues remain <w>unanswered</w> for the time being due to a lack of data."
                            }
                        }
                    ],
                    "synonyms": [
                        "onopgelost",
                        "onbeslist"
                    ],
                    "antonyms": [
                        "opgelost",
                        "beslist"
                    ],
                    "common_phrases": [
                        "onbeantwoorde vraag",
                        "onbeantwoorde kwestie"
                    ],
                    "target_lang_definitions": {
                        "en": "of a problem or question: for which no solution or definitive answer has yet been found"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unanswered",
                                "target_lang_sense_clarification": "of a question or issue"
                            },
                            {
                                "target_lang_word": "unresolved",
                                "target_lang_sense_clarification": "not yet decided or solved"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "690d40e2-3ddf-3f7d-a5a9-c488d35abdcd",
                    "sense_definition": "van een liefde: dat je verliefd op iemand bent die niet verliefd op jou is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge man leed zeer onder de <w>onbeantwoorde</w> liefde die hij voelde.",
                            "target_lang_translations": {
                                "en": "The young man suffered greatly from the <w>unrequited</w> love he felt."
                            }
                        },
                        {
                            "text": "Zijn gevoelens voor haar bleven helaas <w>onbeantwoord</w> na hun eerste ontmoeting.",
                            "target_lang_translations": {
                                "en": "His feelings for her unfortunately remained <w>unrequited</w> after their first meeting."
                            }
                        }
                    ],
                    "common_phrases": [
                        "onbeantwoorde liefde"
                    ],
                    "target_lang_definitions": {
                        "en": "of love: being in love with someone who does not feel the same way about you"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unrequited",
                                "target_lang_sense_clarification": "of love or feelings"
                            },
                            {
                                "target_lang_word": "unreturned",
                                "target_lang_sense_clarification": "not reciprocated"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}