                "entry_id": "1ecbafa9-c731-39d8-9968-09fb7737b500",
                "word": "decile",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5fb79e3a-84e7-44b8-8aae-60c7803d6946",
                        "entry_id": "1ecbafa9-c731-39d8-9968-09fb7737b500",
                        "tags": [
                            "plural"
                        ],
                        "form": "deciles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4f8b085-e94f-3ba8-be19-fa60711ccb2d",
                        "entry_id": "1ecbafa9-c731-39d8-9968-09fb7737b500",
                        "glosses": [
                            "Any of the values in a series that divides the distribution of individuals in that series into ten groups of equal frequency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781a7afc-3512-4c63-8c2b-4c6c16b4ea62",
                                "sense_id": "a4f8b085-e94f-3ba8-be19-fa60711ccb2d",
                                "text": "Although few people scored high marks, everyone did quite well—the lowest decile was over 50%."
                            }
                        ]
                    },
                    {
                        "sense_id": "012b2375-1fce-36ef-83a5-d1d6568dda11",
                        "entry_id": "1ecbafa9-c731-39d8-9968-09fb7737b500",
                        "glosses": [
                            "Any one of the ten subsets or groups so divided."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61ce63d-8392-477f-b472-07d60cbbce2c",
                                "sense_id": "012b2375-1fce-36ef-83a5-d1d6568dda11",
                                "text": "Our school is in the top decile for exam results."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cb311ea-f950-371a-adda-3b792f0d99c3",
                        "entry_id": "1ecbafa9-c731-39d8-9968-09fb7737b500",
                        "glosses": [
                            "An aspect or position of two planets when they are distant from each other a tenth part of the zodiac."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f5480cb-02e7-4ae6-ac2b-bc501894fd3a",
                        "source_entry_id": "1ecbafa9-c731-39d8-9968-09fb7737b500",
                        "source_sense_description": "value",
                        "target_lang_word": "décile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61586943-5e44-3c29-a875-4f4851e8d2b1",
                                        "entry_id": "93659930-56f8-3efa-8ed9-b4d9fc43b29f",
                                        "glosses": [
                                            "Chacune des neuf valeurs qui divisent une distribution statistique ordonnée en dix groupes d’effectifs égaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037680e2-e8c3-40e6-804c-ce25bf5efaed",
                                                "sense_id": "61586943-5e44-3c29-a875-4f4851e8d2b1",
                                                "text": "Si on ordonne une distribution de salaires, de revenus, de chiffre d'affaires..., les déciles sont les valeurs qui partagent cette distribution en dix parties égales.\nAinsi, pour une distribution de salaires :\n— le premier décile (noté généralement D1) est le salaire au-dessous duquel se situent 10 % des salaires ;\n— le neuvième décile (noté généralement D9) est le salaire au-dessous duquel se situent 90 % des salaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4107fbb2-ec60-3f8c-8a7f-b669eca0ca65",
                                        "entry_id": "93659930-56f8-3efa-8ed9-b4d9fc43b29f",
                                        "glosses": [
                                            "L’un des dix ensembles de données situés entre ces neuf valeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b7aef4-7347-4104-a0e0-ba33571c53fd",
                                                "sense_id": "4107fbb2-ec60-3f8c-8a7f-b669eca0ca65",
                                                "text": "Les parts de dépenses de chacun des deux déciles les plus pauvres n’ont augmenté que marginalement au cours des années 1990."
                                            }
                                        ]
                                    }
                                ]
                            },
