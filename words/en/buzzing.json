            "senses": [
                {
                    "sense_id": "6cb02084-18e7-32fc-aaf2-441aa74366bb",
                    "sense_definition": "Very happy; full of joyful excitement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was absolutely <w>buzzing</w> after passing her driving test on the first try.",
