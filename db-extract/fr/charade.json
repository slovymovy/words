                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a93ef7b-495d-40da-9c26-56020f44006e",
                                                "sense_id": "e291bbbe-9780-3d0f-b9e9-89261b210a9c",
                                                "text": "Pan zgaduje szarady?… Posłałem taką: Pierwsze i drugie — to zwierz kopytkowy, / Pierwsze i trzecie — ozdabia damskie głowy; / Wszystkie razem na wojnie strasznie goni, / Niech nas Pan Bóg od tego zabroni. / Pan wie, co to?… Pierwsze i drugie — to jest: ko–za; pierwsze i trzecie — to jest ko–ki, a wszystkie — to są: Ko–za–ki"
                                            }
