                    {
                        "sense_id": "dcfe0c75-5b29-3fd2-871e-9e05dd719c26",
                        "entry_id": "c49f1d74-bbd1-3281-b092-1059b81391db",
                        "glosses": [
                            "Raton laveur."
                        ],
                        "tags": [
                            "Guadeloupe"
                        ],
                        "examples": [
                            {
                                "example_id": "ab1179de-768c-4deb-a2da-21d16421e397",
                                "sense_id": "dcfe0c75-5b29-3fd2-871e-9e05dd719c26",
                                "text": "Cette controverse concerne également le racoon dont le caractère endémique est aujourd’hui remis en question."
                            },
                            {
                                "example_id": "668cb561-3cd0-47a7-a718-f0dd838be5d6",
                                "sense_id": "dcfe0c75-5b29-3fd2-871e-9e05dd719c26",
                                "text": "Vous pourrez y trouver des racoons (petits ratons-laveurs), des agoutis, le plus gros insecte du monde : le scieur de long, 11 espèces de chauves souris dont 2 uniques au monde, une multitude d’oiseaux dont la célèbre grive pattes-jaunes et le Pic de la Guadeloupe, endémique à notre île."
                            }
                        ]
                    }
                ],
