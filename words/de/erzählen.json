                        "die Wahrheit erzählen"
                    ]
                },
                {
                    "sense_id": "64634a7e-60aa-30a6-8b20-ac1aeaf62f32",
                    "sense_definition": "Unsinn reden oder lange und belanglos über etwas sprechen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "talk_nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Glaube ihm kein einziges Wort, denn er <w>erzählt</w> den ganzen Tag nur großen Blödsinn."
                        },
                        {
                            "text": "Wir saßen gemütlich zusammen und haben einfach den ganzen Nachmittag <w>erzählt</w>."
