                                                "sense_id": "5a899008-a0b8-3ba6-a108-20134cf9786d",
                                                "text": "Der Freimaurer ist ein Anhänger der Freimaurerei."
                                            },
                                            {
                                                "example_id": "3a8d9515-17ae-4807-9266-b9fd8b788dd6",
                                                "sense_id": "5a899008-a0b8-3ba6-a108-20134cf9786d",
