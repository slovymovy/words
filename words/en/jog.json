{
    "word_family": [
        "jogger",
        "jogging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79d268b0-2d19-38d9-81a2-4697dcd78283",
                    "sense_definition": "To run at a slow, steady, and leisurely pace as a form of exercise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "running",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>jog</w> in the park every morning to stay healthy.",
                            "target_lang_translations": {
                                "zh": "我每天早上都在公园<w>慢跑</w>以保持健康。"
                            }
                        },
                        {
                            "text": "She likes to <w>jog</w> along the beach when the weather is nice.",
                            "target_lang_translations": {
                                "zh": "天气好的时候，她喜欢沿着海滩<w>慢跑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a jog"
                    ],
                    "target_lang_definitions": {
                        "zh": "以缓慢、平稳且悠闲的速度跑步作为锻炼方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢跑",
                                "target_lang_sense_clarification": "指以轻松的速度进行跑步锻炼。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fb8fa6d-c09f-3b69-9e49-1eb5de64b3f2",
                    "sense_definition": "To stimulate or rouse someone's memory or thoughts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Looking at old photos helped to <w>jog</w> my memory about that trip.",
                            "target_lang_translations": {
                                "zh": "看旧照片有助于<w>唤起</w>我对那次旅行的记忆。"
                            }
                        },
                        {
                            "text": "The detective asked questions to <w>jog</w> the witness's memory of the event.",
                            "target_lang_translations": {
                                "zh": "侦探通过提问来<w>唤起</w>目击者对事件的记忆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jog memory"
                    ],
                    "target_lang_definitions": {
                        "zh": "刺激或唤起某人的记忆或想法。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唤起",
                                "target_lang_sense_clarification": "指使记忆或想法重新浮现。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e4482e2-f258-34ba-b060-1c9fbaf45584",
                    "sense_definition": "To push or shake someone slightly to get their attention.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>jog</w> her elbow to wake her up from her daydream.",
                            "target_lang_translations": {
                                "zh": "他不得不<w>轻推</w>她的手肘，把她从白日梦中唤醒。"
                            }
                        },
                        {
                            "text": "I felt someone <w>jog</w> my arm while I was trying to write.",
                            "target_lang_translations": {
                                "zh": "我写字时感觉到有人<w>轻推</w>了我的手臂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jog elbow"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻推或摇晃某人以引起其注意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻推",
                                "target_lang_sense_clarification": "指用手轻轻触碰或推动某人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5a975e0-5921-36ea-8fbb-fae6ce7ff30c",
                    "sense_definition": "To align stacks of paper by tapping them against a flat surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>jog</w> the papers before putting them into the printer.",
                            "target_lang_translations": {
                                "zh": "请在放入打印机前把纸张<w>理齐</w>。"
                            }
                        },
                        {
                            "text": "The machine will <w>jog</w> the documents to ensure they are perfectly aligned.",
                            "target_lang_translations": {
                                "zh": "机器会自动<w>理齐</w>文件，确保它们完全对齐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "refresh"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过在平坦表面上敲击来对齐纸叠。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "理齐",
                                "target_lang_sense_clarification": "指将纸张边缘整理整齐。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "496bf0c8-89a4-37e1-a026-336f8bb7d06a",
                    "sense_definition": "To move forward at a slow, steady, or heavy pace.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old horse continued to <w>jog</w> along the dusty country road.",
                            "target_lang_translations": {
                                "zh": "那匹老马继续沿着尘土飞扬的乡村道路<w>缓慢行进</w>。"
                            }
                        },
                        {
                            "text": "We decided to <w>jog</w> on despite the heavy rain and wind.",
                            "target_lang_translations": {
                                "zh": "尽管风大雨急，我们还是决定<w>缓慢行进</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or older contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以缓慢、平稳或沉重的步伐向前移动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缓慢行进",
                                "target_lang_sense_clarification": "指以缓慢且持续的节奏移动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cad11ca-bf6c-30b4-9dfa-828cba0d5492",
                    "sense_definition": "To cause a horse to move at a slow, steady trot.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "running",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer began to <w>jog</w> the horse around the training ring.",
                            "target_lang_translations": {
                                "zh": "训练员开始让马在训练场里<w>慢跑</w>。"
                            }
                        },
                        {
                            "text": "It is important to <w>jog</w> the horse gently to warm up its muscles.",
                            "target_lang_translations": {
                                "zh": "让马温和地<w>慢跑</w>以热身肌肉是很重要的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使马以缓慢、平稳的小跑速度行进。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢跑",
                                "target_lang_sense_clarification": "指马匹的慢速小跑。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72bca816-5347-37e5-a3e0-a7cc936299fa",
                    "sense_definition": "A slow, steady run performed as a form of exercise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "running",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went for a quick <w>jog</w> before breakfast this morning.",
                            "target_lang_translations": {
                                "zh": "今天早饭前我进行了一次快速的<w>慢跑</w>。"
                            }
                        },
                        {
                            "text": "Going for a <w>jog</w> is a great way to clear your mind.",
                            "target_lang_translations": {
                                "zh": "去<w>慢跑</w>是清空思绪的好方法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a jog"
                    ],
                    "target_lang_definitions": {
                        "zh": "作为锻炼方式进行的缓慢、平稳的跑步。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢跑",
                                "target_lang_sense_clarification": "指作为运动项目的慢跑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb179c5-7773-3d1f-9bd3-36732bee27c9",
                    "sense_definition": "A sudden, light push or nudge.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a <w>jog</w> to get his attention in the crowded room.",
                            "target_lang_translations": {
                                "zh": "在拥挤的房间里，她<w>轻推</w>了他一下以引起他的注意。"
                            }
                        },
                        {
                            "text": "A sudden <w>jog</w> from behind made him drop his coffee.",
                            "target_lang_translations": {
                                "zh": "背后突然的<w>轻推</w>让他把咖啡掉在了地上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "突然的轻推或轻触。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻推",
                                "target_lang_sense_clarification": "指动作轻微的推搡。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6e4b239-0010-3502-a532-6ae2ab99289b",
                    "sense_definition": "A card that is slightly pushed out from the deck to help a magician locate it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician used a <w>jog</w> to keep track of the chosen card.",
                            "target_lang_translations": {
                                "zh": "魔术师用一张突出的牌来追踪选定的牌。"
                            }
                        },
                        {
                            "text": "He secretly placed a <w>jog</w> in the deck to perform the trick.",
                            "target_lang_translations": {
                                "zh": "他偷偷在牌堆里放了一张突出的牌来表演魔术。"
                            }
                        }
                    ],
                    "synonyms": [
                        "return piece"
                    ],
                    "target_lang_definitions": {
                        "zh": "魔术师为了定位而从牌堆中稍微推出的一张牌。"
                    },
                    "translations": {
                        "zh": []
                    }
                },
                {
                    "sense_id": "8ca1fcc7-9b5e-3b2f-a847-4f82b4fd4db6",
                    "sense_definition": "A flat surface or part of a wall that is set at an angle to another surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stage design featured a <w>jog</w> to create depth in the scenery.",
                            "target_lang_translations": {
                                "zh": "舞台设计中加入了一个折角，以营造布景的深度感。"
                            }
                        },
                        {
                            "text": "The wall was broken up by a <w>jog</w> to make the room look more interesting.",
                            "target_lang_translations": {
                                "zh": "墙壁上有一个折角，使房间看起来更有趣。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "墙壁上与另一表面成一定角度的平坦部分或折角。"
                    },
                    "translations": {
                        "zh": []
                    }
                }
            ]
        }
    ]
}