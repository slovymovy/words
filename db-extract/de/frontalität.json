                "senses": [
                    {
                        "sense_id": "09d5fd62-bcb2-3216-82ac-f559379cfcbc",
                        "entry_id": "592d7a2e-4060-32c5-ab0e-400c1f6c5666",
                        "glosses": [
                            "Eigenschaft/Prinzip/Gesetzmäßigkeit, dass die Wiedergabe des Menschen stets von vorne (frontal) erfolgte, unabhängig davon, wie sich der Körper in der dargestellten Bewegung eigentlich im Raum befunden haben muss"
                        ],
                        "tags": [
                            "Kunstgeschichte",
                            "archaische Darstellungen, besonders aus Ägypten, Vorderasien"
                        ],
                        "examples": [
                            {
                                "example_id": "0256454b-6139-45a8-a83d-57474e056bfa",
                                "sense_id": "09d5fd62-bcb2-3216-82ac-f559379cfcbc",
                                "text": "„Zum altbabylonischen Bildrepertoire gehört neu die nackte Frau in ihrer stereotypen Ausprägung: Frontalität, die Arme angewinkelt und auf Taillehöhe zusammengelegt, die Füsse nach aussen gedreht.“"
                            },
                            {
                                "example_id": "2e9a23e0-cd0c-496e-8988-20be5cf854d1",
                                "sense_id": "09d5fd62-bcb2-3216-82ac-f559379cfcbc",
                                "text": "„Der Kopf ist vor allem auf strenge fassadenhafte Frontalität hin ausgerichtet, das Gesichtsrelief ist ganz flach, nichts führt in die Tiefe des Kopfes. Dennoch ist es keine starre Frontalität, sondern die leichte Drehung bewirkt eine Belebung.“"
                            },
                            {
                                "example_id": "a1d31676-9e48-418f-bbac-fe1b1364757a",
                                "sense_id": "09d5fd62-bcb2-3216-82ac-f559379cfcbc",
                                "text": "„[…] daß hier zum ersten Male die Hüftstellung in allen Einzelheiten physiologisch richtig wiedergegeben und damit die Frontalität überwunden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
