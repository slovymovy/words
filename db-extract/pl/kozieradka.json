                ],
                "senses": [
                    {
                        "sense_id": "2b3c4137-00c2-3f3f-adba-f204f79bb198",
                        "entry_id": "7110fedd-4658-3c57-b496-f246996790b8",
                        "glosses": [
                            "Trigonella, rodzaj aromatycznych roślin z rodziny bobowatych, używanych jako przyprawa i w celach leczniczych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e1306318-699f-32fb-abf3-f3eb8caa05d9",
                        "entry_id": "7110fedd-4658-3c57-b496-f246996790b8",
                        "glosses": [
                            "przyprawa z nasion kozieradki pospolitej (Trigonella foenum-graecum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2ee110-ea9e-421c-8587-25e1ecd35639",
                                "sense_id": "e1306318-699f-32fb-abf3-f3eb8caa05d9",
                                "text": "Dodawana do potraw, kozieradka wzbogaca ich smak i pobudza trawienie, działając przy tym regenerująco, przeciwzapalnie i przeciwalergicznie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f06669cf-5531-448a-9231-6a1795a0c98c",
                        "source_entry_id": "7110fedd-4658-3c57-b496-f246996790b8",
                        "source_sense_id": "2b3c4137-00c2-3f3f-adba-f204f79bb198",
                        "target_lang_word": "fenugreek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fenugreek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc548f5a-060b-315d-be49-c81f28167fa4",
                                        "entry_id": "8882d89c-2c17-3698-a156-3499efe7dff8",
                                        "glosses": [
                                            "Any of the species leguminous plant, Trigonella foenum-graecum, eaten as a vegetable and with seeds used as a spice."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1446a69b-df9c-4b27-a746-4936e750b8c4",
                                                "sense_id": "cc548f5a-060b-315d-be49-c81f28167fa4",
                                                "text": "Fenugreek plant was introduced to Central Europe by Benedictine monks, and it is promoted in the 9th century by Charlemagne. It was grown extensively in the imperial gardens of Charlemagne (Popova, 2017)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ff1802-ff6b-36a6-8659-0e8f84a24947",
                                        "entry_id": "8882d89c-2c17-3698-a156-3499efe7dff8",
                                        "glosses": [
                                            "The seeds of this plant, used as a spice (especially in Indian and Thai cooking)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7315b280-dd32-4360-a68e-7cb72c03c531",
                                                "sense_id": "94ff1802-ff6b-36a6-8659-0e8f84a24947",
                                                "text": "Fenugreek’s nutritional and tonic properties have also been tapped since ancient times. […] Fenugreek-based preparations stimulate the appetite and promote weight gain in people with anemia, anorexia, tuberculosis or asthenia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf66320-f86e-4415-9264-2deaadaf8a37",
                        "source_entry_id": "7110fedd-4658-3c57-b496-f246996790b8",
                        "source_sense_id": "2b3c4137-00c2-3f3f-adba-f204f79bb198",
                        "target_lang_word": "řecké seno",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bdeed8e5-7cc0-4834-8c64-3ed5293afc2e",
                        "source_entry_id": "7110fedd-4658-3c57-b496-f246996790b8",
                        "source_sense_id": "2b3c4137-00c2-3f3f-adba-f204f79bb198",
                        "target_lang_word": "fenugrec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fenugrec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "963255b9-4050-38aa-8b75-3b9bcb7acae3",
                                        "entry_id": "3eac0bd0-407b-337a-9bba-ba129654cdfd",
                                        "glosses": [
                                            "Nom usuel de Trigonella foenum-graecum, plante herbacée, annuelle, de la famille des Fabacées, originaire d’une zone allant de l’Irak au Pakistan, dont la graine mucilagineuse, odorante — qui contient, entre autres, de la diosgénine de la coumarine et de la sotolone —, est émolliente et adoucissante, elle fait partie de la pharmacopée traditionnelle de la Méditerranée, de l’Inde et de la Chine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a727a1-32e9-4fd1-98ea-0e980c46ba55",
                                                "sense_id": "963255b9-4050-38aa-8b75-3b9bcb7acae3",
                                                "text": "Dans l'énumération des graines dont l'utilisation est interdite pour les usages autres que la semence, il [le Journal officiel du 12.11] fait figurer, entre le sainfoin et le fenugrec, le soya."
                                            },
                                            {
                                                "example_id": "cb52efc9-4aee-4a72-b5ff-95e0cb0339a1",
                                                "sense_id": "963255b9-4050-38aa-8b75-3b9bcb7acae3",
                                                "text": "La femme et l’homme avaient disparu, mais sur la table il y avait un bouquet de fleurs, de ces longues tiges que les paysans garnissent de minuscules immortelles dont ils avivent les couleurs par des encres et qui gardent une odeur de fenugrec et de paille."
                                            },
                                            {
                                                "example_id": "c069ea5c-1215-4bcd-af3c-db957e1aa31d",
                                                "sense_id": "963255b9-4050-38aa-8b75-3b9bcb7acae3",
                                                "text": "Dans les brumes de ses rêves, il humait la cardamone et le fenugrec, croquait des graines de cumin et de moutarde noire, savourait la trace qu’une feuille de cari laissait dans du beurre clarifié…"
                                            },
                                            {
                                                "example_id": "5d81435f-f9ec-42f8-9902-184d9cde24bc",
                                                "sense_id": "963255b9-4050-38aa-8b75-3b9bcb7acae3",
                                                "text": "Le fenugrec est aussi utilisé aujourd’hui comme fixateur efficace de l’azote et restaurateur des sols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df2c4495-7567-408f-8f27-833ed5caf677",
                        "source_entry_id": "7110fedd-4658-3c57-b496-f246996790b8",
                        "source_sense_id": "2b3c4137-00c2-3f3f-adba-f204f79bb198",
                        "target_lang_word": "Bockshornklee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bockshornklee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "683148ae-a3dc-3ccf-a1ab-e0251499a82d",
                                        "entry_id": "6e57c301-d955-38bb-9832-0d82be09a792",
                                        "glosses": [
                                            "Pflanze, die zur Gattung Trigonella und der Familie der Hülsenfrüchtler (Unterfamilie Schmetterlingsblütler) zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4abcc2-6918-4b9b-92c9-05e8a4e0fafd",
                                                "sense_id": "683148ae-a3dc-3ccf-a1ab-e0251499a82d",
                                                "text": "Die Samen des Bockshornklees sind ein bewährtes Naturheilmittel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
