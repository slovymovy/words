                                            {
                                                "example_id": "02e567ae-18fc-47af-9a08-6159c002d3ad",
                                                "sense_id": "9669d8cc-c5f3-3a9a-ab9d-0a81bc757ade",
                                                "text": "« Allons à la librairie pour acheter les livres ! »"
                                            },
                                            {
                                                "example_id": "b3f4aef7-a014-48e7-be60-56734f7ccd63",
                                                "sense_id": "9669d8cc-c5f3-3a9a-ab9d-0a81bc757ade",
                                                "text": "Il a ouvert une librairie d’occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9230661b-9b84-3269-b25b-91833f18beb4",
                                        "entry_id": "5a1a7d89-e58f-37d1-b56c-30d359214ef5",
                                        "glosses": [
                                            "Profession de libraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99447d27-41e0-41c5-b1bf-271932f3dcaf",
                                                "sense_id": "9230661b-9b84-3269-b25b-91833f18beb4",
                                                "text": "Il a fait toute sa carrière dans la librairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a69b8c0e-3be6-32e7-bda0-2ccbc396fafa",
                                        "entry_id": "5a1a7d89-e58f-37d1-b56c-30d359214ef5",
                                        "glosses": [
                                            "Bibliothèque. Cette acception s’est conservée longtemps dans les actes publics."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c7b124-ec38-4bfb-ae73-8b30e74b3d8b",
                                                "sense_id": "a69b8c0e-3be6-32e7-bda0-2ccbc396fafa",
                                                "text": "La librairie du roi."
                                            },
                                            {
                                                "example_id": "5981423b-be46-4a9e-89e4-21252aa5ca1e",
                                                "sense_id": "a69b8c0e-3be6-32e7-bda0-2ccbc396fafa",
                                                "text": "Malgré l’opposition de M. Paul, qui voulait que je m’allasse coucher, j’entrai dans ce que j’appellerai, en vieux langage, « la librairie », et je me mis au travail, à la lumière de la lampe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8368bf-03cc-32a4-a1f8-13b6c2e34184",
                                        "entry_id": "5a1a7d89-e58f-37d1-b56c-30d359214ef5",
                                        "glosses": [
                                            "Bibliothèque de sous-programmes."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202df6e2-1c96-4e04-9fb7-35de159398bd",
                                                "sense_id": "1c8368bf-03cc-32a4-a1f8-13b6c2e34184",
                                                "text": "JNI est une librairie permettant au programmeur Java d’intégrer du code natif développé en C ou C++, et également d’exécuter du code Java depuis une application en C ou C++."
                                            }
                                        ]
                                    }
