    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02d17345-b910-3715-b1cf-70f9b2ed3adc",
                    "sense_definition": "Septième jour de la semaine civile, qui suit le samedi et précède le lundi.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>dimanche</w> est le dernier jour de la semaine dans notre calendrier."
                        },
                        {
                            "text": "Nous passons souvent le <w>dimanche</w> après-midi en famille à la campagne."
                        }
                    ],
                    "common_phrases": [
                        "dimanche matin",
                        "dimanche après-midi",
                        "dimanche soir",
                        "tous les dimanches"
                    ]
                },
                {
                    "sense_id": "b85dc241-f036-3fa0-beb5-f4ba24b41210",
                    "sense_definition": "Ce jour considéré comme la période de repos ou de congé hebdomadaire.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La plupart des magasins de la ville restent fermés le <w>dimanche</w>."
                        },
                        {
                            "text": "Après une semaine fatigante, il profite pleinement de son <w>dimanche</w>."
                        }
                    ],
                    "common_phrases": [
                        "sortie du dimanche",
                        "promeneur du dimanche",
                        "conducteur du dimanche"
                    ]
                },
                {
                    "sense_id": "f2749498-5612-3b2d-b0d9-2a54af7b785b",
                    "sense_definition": "Jour saint et consacré au culte dans la tradition chrétienne.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles se rassemblent à l'église pour la messe du <w>dimanche</w>."
                        },
                        {
                            "text": "Dans la religion chrétienne, le <w>dimanche</w> est réservé à la prière."
                        }
                    ],
                    "common_phrases": [
                        "messe du dimanche",
                        "dimanche des Rameaux"
                    ]
                },
                {
                    "sense_id": "4735cde6-e923-374d-9e0a-8de80e5c5ecf",
                    "sense_definition": "Jour privilégié où l'on s'accorde un plaisir particulier ou une exception.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un repas pareil, ce n'est pas tous les jours <w>dimanche</w>, alors profitons-en !"
                        },
                        {
                            "text": "Pour ces enfants, chaque sortie au cirque était un vrai <w>dimanche</w>."
                        }
                    ],
                    "common_phrases": [
                        "repas du dimanche",
                        "ce n'est pas tous les jours dimanche"
                    ]
                },
                {
