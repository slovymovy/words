            {
                "entry_id": "6bed3ef1-8fae-31be-a762-a9746689bcd0",
                "word": "Besson",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb6be058-4087-3ddb-877d-b9ac812ca5b7",
                        "entry_id": "6bed3ef1-8fae-31be-a762-a9746689bcd0",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099840ce-c0ec-4d5d-bc5b-9833533fda81",
                                "sense_id": "bb6be058-4087-3ddb-877d-b9ac812ca5b7",
                                "text": "Quatre Français, un record, ont été choisis au cours de la même draft à trois reprises : Petro, Mahinmi, Turiaf, Gelabale en 2005 ; Yabusele, Luwawu-Cabarrot, Cordinier, Cornelie en 2016 ; O. Dieng, Diabaté, Kamagaté, H. Besson en 2022."
                            },
                            {
                                "example_id": "c2985116-202c-4549-a257-4eeaed7df18b",
                                "sense_id": "bb6be058-4087-3ddb-877d-b9ac812ca5b7",
                                "text": "Caleb Landry Jones incarne un homme handicapé et traumatisé dans DogMan, de Luc Besson, événement du dernier festival de Deauville qui débarque au cinéma, ce mercredi."
                            },
                            {
                                "example_id": "8a7538e0-1a41-48f6-8fb6-3b241380452a",
                                "sense_id": "bb6be058-4087-3ddb-877d-b9ac812ca5b7",
                                "text": "En partenariat avec d’autres noms vendéens comme Ivea, pour les vérins électriques, ou encore 4GL, pour le grenaillage et la peinture, Chabas et Besson œuvre pour ultrasécuriser le site ukrainien et isoler les matières radioactives encore largement présentes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b104b1da-772d-39e5-87fe-339ed7a85898",
                "word": "besson",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
