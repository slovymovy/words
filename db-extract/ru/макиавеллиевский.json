                "senses": [
                    {
                        "sense_id": "67f304d8-0398-3acd-8342-0699443e6cde",
                        "entry_id": "9b434fff-4c23-384c-bf68-087889e4fa41",
                        "glosses": [
                            "книжн. связанный, соотносящийся по значению с существительным макиавеллизм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f423b54-be10-40e0-8c0d-53f04807015d",
                                "sense_id": "67f304d8-0398-3acd-8342-0699443e6cde",
                                "text": "Затруднение было преодолено с чисто макиавеллиевской ловкостью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "226d8935-2511-4505-85a9-03d09e79e893",
                        "source_entry_id": "9b434fff-4c23-384c-bf68-087889e4fa41",
                        "source_sense_id": "67f304d8-0398-3acd-8342-0699443e6cde",
                        "target_lang_word": "Machiavellian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machiavellian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76c1ca5d-cde2-3cf7-9f37-7de780d41a13",
                                        "entry_id": "a73ec93e-aabc-388e-b720-da57418729e2",
                                        "glosses": [
                                            "Attempting to achieve goals by cunning, scheming, and unscrupulous methods, especially in politics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540a4e7e-c33c-45a6-92bc-001e4d468065",
                                                "sense_id": "76c1ca5d-cde2-3cf7-9f37-7de780d41a13",
                                                "text": "Iago is the Machiavellian antagonist in William Shakespeare's play Othello."
                                            },
                                            {
                                                "example_id": "4b073b9c-17ed-4261-8288-d22691eef535",
                                                "sense_id": "76c1ca5d-cde2-3cf7-9f37-7de780d41a13",
                                                "text": "The most common reason cited is a Machiavellian one: Police view perjury as a necessary means to achieve the ends of justice."
                                            },
                                            {
                                                "example_id": "c98fedae-a85f-46e8-8bb0-2d366efcc40b",
                                                "sense_id": "76c1ca5d-cde2-3cf7-9f37-7de780d41a13",
                                                "text": "These are the actions of a club flailing around to make things work, not the 4D chess moves of some Machiavellian puppet master."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "285ea4f7-dbf4-3c98-8123-b3f432609959",
                                        "entry_id": "a73ec93e-aabc-388e-b720-da57418729e2",
                                        "glosses": [
                                            "Related to the philosophical system of Niccolò Machiavelli."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d7aeed-82e9-4d11-8078-3b182c9b4fc7",
                                                "sense_id": "285ea4f7-dbf4-3c98-8123-b3f432609959",
                                                "text": "As Dr. Spalding notes, the connection that Washington drew \"between private morality and national character, between virtue and happiness, hardly seems Machiavellian.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Machiavellian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6b7bff-76c1-357d-a2f3-c37f52fba397",
                                        "entry_id": "1c3afbb7-482c-32ef-b4a4-3f7adb842a13",
                                        "glosses": [
                                            "An unscrupulous schemer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
