                        "form": "перепи́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74b0587a-8145-3aae-a26d-752831afe28b",
                        "entry_id": "45e71896-97ae-3a4b-91cc-a81b585670ad",
                        "glosses": [
                            "разг. выпить лишнего, слишком много (обычно о спиртных напитках)"
                        ],
                        "tags": [
                            "чего и без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "702db276-8c48-48a5-8095-92831a4854c5",
                                "sense_id": "74b0587a-8145-3aae-a26d-752831afe28b",
                                "text": "Кузнец Пантелей приказал долго жить; сгорел ― не от огня, сгорел, сказывали, вина много перепил."
                            },
                            {
                                "example_id": "fd0505ae-88a3-4013-9dda-6cc86f3176ce",
                                "sense_id": "74b0587a-8145-3aae-a26d-752831afe28b",
                                "text": "― Милый друг, если ты не пьян, то вчера перепил и бредишь."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5dced7b-542e-34bc-9570-4e2415736e13",
                        "entry_id": "45e71896-97ae-3a4b-91cc-a81b585670ad",
                        "glosses": [
                            "разг. выпить больше другого, других (обычно о спиртных напитках)"
                        ],
                        "tags": [
                            "кого"
                        ],
                        "examples": [
                            {
                                "example_id": "d05945f4-a380-412b-bd50-8ace09dd90b6",
                                "sense_id": "c5dced7b-542e-34bc-9570-4e2415736e13",
                                "text": "Другой ― победил силу веры силою вина: мало людей перепить его могут."
                            },
                            {
                                "example_id": "fa07390d-85cf-467c-948a-900e6c2e9dbb",
                                "sense_id": "c5dced7b-542e-34bc-9570-4e2415736e13",
                                "text": "Никто ещё не мог перепить Юру, и никто не видал его пьяным."
                            }
                        ]
                    }
                ],
