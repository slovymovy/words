                    {
                        "translation_id": "ce91aa57-0509-472e-8326-83cc97b7e888",
                        "source_entry_id": "be49b72c-21a9-3184-aaa6-a2e9f1d7d57e",
                        "source_sense_description": "stroke in tennis",
                        "target_lang_word": "revers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e8ea720-81c4-37af-9db3-c2d10006b2ff",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Côté d’une chose opposé au côté principal, à celui que l’on regarde ou qui se présente d’abord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e9440ca-cdc8-4d4a-8f1d-49de81c2fdc2",
                                                "sense_id": "1e8ea720-81c4-37af-9db3-c2d10006b2ff",
                                                "text": "Sur une glace, ils tracent des traits au diamant, collodionnent la face ainsi gravée et, après sensibilisation, exposent à la lumière par le revers de la plaque."
                                            },
                                            {
                                                "example_id": "bfc311b9-4580-4bee-aa3d-41380faf7a62",
                                                "sense_id": "1e8ea720-81c4-37af-9db3-c2d10006b2ff",
                                                "text": "Cette ville, située à une altitude de mille toises sur le revers oriental des Rocheuses, au bord d’un torrent tributaire du Missouri, forme un vaste entrepôt pour les produits miniers de la région, et compte de quatorze à quinze mille habitants."
                                            },
                                            {
                                                "example_id": "17e2ad90-617a-4817-b05d-a9f8a0a33153",
                                                "sense_id": "1e8ea720-81c4-37af-9db3-c2d10006b2ff",
                                                "text": "Tout ce qui est sur le revers de la colline est de peu d’attrait dans un récit."
                                            },
                                            {
                                                "example_id": "b0f9e77e-3756-4ad9-9710-e51670ef14f5",
                                                "sense_id": "1e8ea720-81c4-37af-9db3-c2d10006b2ff",
                                                "text": "Le revers de la main : Le dos de la main, le côté opposé à la paume."
                                            },
                                            {
                                                "example_id": "5fff5197-76cc-4048-b3a8-9c78267b4424",
                                                "sense_id": "1e8ea720-81c4-37af-9db3-c2d10006b2ff",
                                                "text": "Un coup de revers ou simplement coup d’arrière-main,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f9ccf3-069a-37d7-baff-a16c97e408d5",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Coup donné avec le dos de la main, ou avec une arme ou un instrument quelconque, de la gauche vers la droite dans le cas d’un droitier, de droite à gauche dans celui d’un gaucher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7604be-8a39-40d0-bf70-91955905d3d3",
                                                "sense_id": "86f9ccf3-069a-37d7-baff-a16c97e408d5",
                                                "text": "Et sans autre préambule, avant qu’elle s’y attendît, il la gifla si largement qu’il l’envoya culbuter contre le lit d’un seul revers de main."
                                            },
                                            {
                                                "example_id": "8b934457-3248-45bb-8206-c13f2075c10f",
                                                "sense_id": "86f9ccf3-069a-37d7-baff-a16c97e408d5",
                                                "text": "Revers à deux mains."
                                            },
                                            {
                                                "example_id": "19020692-96a4-45d5-b825-f2596811e59c",
                                                "sense_id": "86f9ccf3-069a-37d7-baff-a16c97e408d5",
                                                "text": "Ce joueur de paume, ce joueur de tennis excelle dans les coups de revers, il fait très bien les revers."
                                            },
                                            {
                                                "example_id": "d26c8db1-da53-4aad-9d7f-55571ba9b9c8",
                                                "sense_id": "86f9ccf3-069a-37d7-baff-a16c97e408d5",
                                                "text": "Frapper de revers, frapper de gauche à droite avec une arme, un bâton, une raquette, etc., que l’on tient de la main droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "640eb144-6da6-36bc-96dd-1f518a9e2b19",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Disgrâce ; échec ; accident qui change une bonne situation en une mauvaise."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "227f5b90-0817-4ca7-a60e-905eb13e7c43",
                                                "sense_id": "640eb144-6da6-36bc-96dd-1f518a9e2b19",
                                                "text": "L’UE a toutefois fait savoir qu’elle instaurerait automatiquement des droits de douane sur les produits de la pêche si Londres fermait l’accès à ses eaux – ce qui est un revers de taille pour les pêcheurs d’outre-Manche."
                                            },
                                            {
                                                "example_id": "0aebed69-1ffd-4180-af3a-64b81143693d",
                                                "sense_id": "640eb144-6da6-36bc-96dd-1f518a9e2b19",
                                                "text": "Il s’est laissé abattre par le premier revers."
                                            },
                                            {
                                                "example_id": "bd22cecd-71bb-42eb-b43c-6f4cd8734919",
                                                "sense_id": "640eb144-6da6-36bc-96dd-1f518a9e2b19",
                                                "text": "Il a eu tour à tour des succès et des revers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e40d11-99f6-3152-89ab-c3c48aff35bd",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Partie d’un vêtement qui est ou semble repliée en dessus, de manière à montrer une partie de l’envers ou de la doublure du vêtement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce99b3b-ffad-4d6b-a322-b57e0bb3add2",
                                                "sense_id": "46e40d11-99f6-3152-89ab-c3c48aff35bd",
                                                "text": "Il se leva tout à fait, passa la main entre l’échancrure de son gilet et le plastron de sa chemise qui godait, tira les revers de son habit, et s’assura que le nœud de sa cravate n’avait pas été dérangé."
                                            },
                                            {
                                                "example_id": "6203a351-8822-459a-bf6e-128d00e2f9ad",
                                                "sense_id": "46e40d11-99f6-3152-89ab-c3c48aff35bd",
                                                "text": "Une véritable épidémie de petits drapeaux et d’insignes pour boutonnières s’abattit sur les torrents de jeunesse laborieuse et pressée […]. Il était dangereux de ne pas avoir d’insignes patriotiques au revers de l’habit."
                                            },
                                            {
                                                "example_id": "57c99cab-3005-4680-95c5-4fe7aa5a1291",
                                                "sense_id": "46e40d11-99f6-3152-89ab-c3c48aff35bd",
                                                "text": "Il secoua la tête, jeta un soupir puis essuya son front avec le revers de sa manche de chemise : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3a8a06d-3839-3474-9d5f-c870752dc41c",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Haut de la tige d’une botte, lorsqu’il paraît se rabattre et montrer le côté du cuir qui n’est pas noirci."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f064ad-b5c7-423b-8ef3-ea494efa508a",
                                                "sense_id": "e3a8a06d-3839-3474-9d5f-c870752dc41c",
                                                "text": "Bottes à revers."
                                            },
                                            {
                                                "example_id": "272243b3-398a-4f62-8af5-355ab36a182e",
                                                "sense_id": "e3a8a06d-3839-3474-9d5f-c870752dc41c",
                                                "text": "Romero seul avait gardé son teint de revers de botte, et ses jambes de bronze, quoique nues, n’avaient pas éprouvé la plus petite altération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0415fbe-d53e-34d6-9736-14887771a54f",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Côté opposé à la face ou avers, portant une inscription, un sujet, etc., en parlant de monnaies ou de médailles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f7158a-b78e-4368-8e9b-ad671fae0acb",
                                                "sense_id": "f0415fbe-d53e-34d6-9736-14887771a54f",
                                                "text": "Cette médaille a sur l’avers la tête d’Auguste, et sur le revers une victoire."
                                            },
                                            {
                                                "example_id": "7cc5ef77-3bfb-4dcd-9a93-4e34efb3e134",
                                                "sense_id": "f0415fbe-d53e-34d6-9736-14887771a54f",
                                                "text": "Le monnayage attribué aux Aulerques Diablintes appartient stylistiquement à un ensemble armoricain, notamment par la présence au revers d’un cheval androcéphale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43741425-db21-3ea6-9a30-ec9d82b88925",
                                        "entry_id": "1cecde91-719c-3820-9ff8-1b29e1fc2537",
                                        "glosses": [
                                            "Nom donné au côté d’un drapeau opposé à l’avers quand celui-ci est différent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
