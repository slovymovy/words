                "senses": [
                    {
                        "sense_id": "4f37d1e4-1d26-3798-af00-4b47d6bcd58a",
                        "entry_id": "87911528-84d7-36f8-9a63-d89ec0e93e1a",
                        "glosses": [
                            "S’habiliter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "158f9a5c-2933-48b4-b50f-fd96cdf152d7",
                                "sense_id": "4f37d1e4-1d26-3798-af00-4b47d6bcd58a",
                                "text": "L'intervenant peut-il s'autohabiliter ?"
                            },
                            {
                                "example_id": "b6118816-0aa3-42be-9f87-a24f5780fffa",
                                "sense_id": "4f37d1e4-1d26-3798-af00-4b47d6bcd58a",
                                "text": "L'Appel de Gauck à s'autohabiliter, à s'engager en faveur d'une vie prospère et meilleure est toujours d'actualité."
                            },
                            {
                                "example_id": "dd8c961d-f9c2-4cf2-87d2-ab72be7e3055",
                                "sense_id": "4f37d1e4-1d26-3798-af00-4b47d6bcd58a",
                                "text": "C'est dire que le gouvernement en arrivait à s'autohabiliter et à s'autoratifier et à mettre ainsi lui-même ses propres actes à l'abri du contrôle juridictionnel !"
                            }
                        ]
                    }
