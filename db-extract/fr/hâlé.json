                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20f4e60-f986-43c2-a27a-cbd43db5e38a",
                                "sense_id": "695eef28-8a60-319f-bd84-8c81a4a582ff",
                                "text": "Des hoquets de dégoût convulsèrent de nouveau leurs faces hâlées, zébrées de rides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1c0e345-b09a-4f5e-ac7f-177f0b6c3ed5",
