                "senses": [
                    {
                        "sense_id": "792f7e9e-eaf4-34ae-803f-8a39d18086b7",
                        "entry_id": "d254dcba-e63d-3426-9f19-3a92189e30ed",
                        "glosses": [
                            "Stadt in der chinesischen Provinz Shandong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fa87c0-1ee2-44be-b599-a6bfca7c29e8",
                                "sense_id": "792f7e9e-eaf4-34ae-803f-8a39d18086b7",
                                "text": "„Die landwirtschaftlichen Erzeugnisse stammen aus den Privatparzellen der Bauern, die Konsumgüter aus Weifang, einer 35 Kilometer entfernten Stadt, in der einfallsreiche Bauern ihre Produkte verkaufen und dafür die Güter kaufen, die sie jetzt ihrer Branche anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15d16589-d772-4f54-ae9f-9427f2ce50e8",
                        "source_entry_id": "d254dcba-e63d-3426-9f19-3a92189e30ed",
                        "source_sense_id": "792f7e9e-eaf4-34ae-803f-8a39d18086b7",
                        "source_sense_description": "Stadt in der chinesischen Provinz Shandong",
                        "target_lang_word": "Weifang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weifang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87a8021b-871b-31cc-a4c6-b8ef5ce05cf0",
                                        "entry_id": "455b1d67-ccc7-3872-ae31-1aa111062f0d",
                                        "glosses": [
                                            "A prefecture-level city of Shandong, in northeastern China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d112706f-6860-4f4f-b054-0c8e091bbf3b",
                                                "sense_id": "87a8021b-871b-31cc-a4c6-b8ef5ce05cf0",
                                                "text": "The haste with which marriages are contracted by young people who are experimenting for the first time with unobstructed choice of mates is typified by such a current remark as that which Tzu Chi reports from Weifang, Shantung: “First let’s go to the movies and then let’s get married.”"
                                            },
                                            {
                                                "example_id": "9d052ec6-1811-4dc5-8bf4-293ce992d672",
                                                "sense_id": "87a8021b-871b-31cc-a4c6-b8ef5ce05cf0",
                                                "text": "Weifang officials knew the policy meant trouble for them. China has other concentrations of Falun Gong believers, such as in the northeast. But those areas are remote from the capital. Weifang is located just three hundred miles southeast of Beijing, making it easy for protesters to travel to the capital even after the city had taken the initial precaution of sending security agents to train and bus stations to head them off before they left town."
                                            },
                                            {
                                                "example_id": "3dacc87a-7d33-4b1d-97ed-2bf85eb838fb",
                                                "sense_id": "87a8021b-871b-31cc-a4c6-b8ef5ce05cf0",
                                                "text": "The wide new boulevards that cut across parts of Weifang in eastern China are largely free of traffic, a quiet reminder of the coastal city’s big ambitions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
