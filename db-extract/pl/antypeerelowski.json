                        "entry_id": "89921dda-41ae-36ba-bbe0-0d5af2cf5409",
                        "glosses": [
                            "skierowany przeciwko zasadom ustrojowym PRL-u oraz ówczesnej władzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667861b5-9af0-4d00-ad61-57094a60955a",
                                "sense_id": "6c69293d-5c69-3b12-9775-e88c987e171d",
                                "text": "Dzisiaj oczywiście, jak każdy, kto pełnymi garściami czerpał z PRL-u, stał się nad wyraz antypeerelowski"
                            },
                            {
                                "example_id": "7a6b48c6-2fa8-4981-9bea-6d12573e3e3e",
                                "sense_id": "6c69293d-5c69-3b12-9775-e88c987e171d",
                                "text": "W rezultacie powstała bardzo dobra komedia, łącząca absurdalny, antypeerelowski humor z lekkimi i łatwymi do przełknięcia gagami"
                            }
                        ],
