                                        "entry_id": "208b75e7-cb32-3341-a272-c398e5722ed6",
                                        "glosses": [
                                            "An aliphatic hydrocarbon, C₂H₆, gaseous at normal temperatures and pressures, being a constituent of natural gas."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
