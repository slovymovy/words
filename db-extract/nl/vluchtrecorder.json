                        "source_sense_id": "2a8d9d2f-01ae-3890-b796-b027ada99339",
                        "target_lang_word": "boîte noire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boîte noire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bef0afb-6b33-3c45-a719-b5b1bbc20ae9",
                                        "entry_id": "b316860e-146a-3bc6-9c1a-fc7f9ec96587",
                                        "glosses": [
                                            "Système (objet mécanique ou électronique, organisme, personne, mode d’organisation sociale, etc.) dont le fonctionnement interne est soit inaccessible, soit omis délibérément : on ne peut étudier que ses interactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ec2996-b4e0-4030-a7ca-97c8f8238a64",
                                                "sense_id": "1bef0afb-6b33-3c45-a719-b5b1bbc20ae9",
                                                "text": "Le contraire d'une boîte noire, dit boîte blanche, par exemple une bicyclette, est un système dont les mécanismes sont visibles au premier coup d’œil et permettent d’en comprendre le fonctionnement."
                                            },
                                            {
                                                "example_id": "b76386b4-9207-4f80-811f-137ec3413e60",
                                                "sense_id": "1bef0afb-6b33-3c45-a719-b5b1bbc20ae9",
                                                "text": "Peut-on (et comment) avertir les utilisateurs du fonctionnement d’un mécanisme doté d’une intelligence artificielle (qui sont souvent des boîtes noires) ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "360d0eaf-c37e-3a5f-b7be-fae5278c8694",
                                        "entry_id": "b316860e-146a-3bc6-9c1a-fc7f9ec96587",
                                        "glosses": [
                                            "Enregistreur de données de vol ou des conversations du cockpit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e6a7fd-3913-44a3-bf94-00cd49a38f8f",
                                                "sense_id": "360d0eaf-c37e-3a5f-b7be-fae5278c8694",
                                                "text": "Les deux boîtes noires de l’Airbus russe qui s’est écrasé dans le Sinaï samedi avec 224 personnes à bord ont commencé à parler."
                                            },
                                            {
                                                "example_id": "546057f9-a39d-4212-8607-faf400fb3de6",
                                                "sense_id": "360d0eaf-c37e-3a5f-b7be-fae5278c8694",
                                                "text": "L’analyse des boîtes noires de l’appareil, repêchées un mois plus tard, a confirmé que les pilotes, désorientés par le givrage des sondes de vitesse Pitot, n’ont pu rattraper le décrochage de l’appareil, qui a eu lieu en moins de cinq minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef198d94-6cc5-3edf-9b02-0b54089cae5e",
                                        "entry_id": "b316860e-146a-3bc6-9c1a-fc7f9ec96587",
                                        "glosses": [
                                            "Enregistreur de données du sol (logiciel) pour compléter l'analyse de l' Enregistreur de données de vol et des conversations du cockpit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87e4cc57-c299-33d3-bd76-c07633da6fba",
                                        "entry_id": "b316860e-146a-3bc6-9c1a-fc7f9ec96587",
                                        "glosses": [
                                            "Pour les véhicules automobiles et les bateaux, enregistreur de données du voyage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37b6dbd9-1f9f-30d6-b033-9bc7c2e40f29",
                                        "entry_id": "b316860e-146a-3bc6-9c1a-fc7f9ec96587",
                                        "glosses": [
                                            "Module d’un système dont on ne connaît pas du tout la structure interne lors de son test."
                                        ],
                                        "tags": [
                                            "Test logiciel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26dbd23b-bcef-3f86-9c5f-6dd574f3f54e",
                                        "entry_id": "b316860e-146a-3bc6-9c1a-fc7f9ec96587",
                                        "glosses": [
                                            "Dispositif réel ou théorique dont on ignore ou veut ignorer la structure et le fonctionnement."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666de6d5-3c33-4b7e-b914-3a663feb3110",
                                                "sense_id": "26dbd23b-bcef-3f86-9c5f-6dd574f3f54e",
                                                "text": "Les journaux scientifiques doivent ouvrir la boîte noire du processus éditorial à l’examen du public !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
