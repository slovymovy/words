                        "s'implanter dans la région"
                    ]
                },
                {
                    "sense_id": "5087e8e4-b7fc-3dba-8210-20123f9508b1",
                    "sense_definition": "Insérer chirurgicalement un organe, un tissu ou un dispositif médical dans un organisme vivant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a réussi à <w>implanter</w> une prothèse dans le genou du patient."
                        },
                        {
                            "text": "Les médecins ont décidé d'<w>implanter</w> un stimulateur cardiaque pour réguler son rythme."
                        }
                    ],
                    "common_phrases": [
                        "implanter une prothèse",
                        "implanter un stimulateur cardiaque"
                    ]
                },
                {
                    "sense_id": "58d2fe37-1ebb-337f-b940-5b31d349040e",
                    "sense_definition": "Fixer ou faire adopter durablement une idée, une habitude ou une coutume dans un groupe.",
