            "senses": [
                {
                    "sense_id": "edfd8abe-b9a4-3944-8423-26271dc9b2a2",
                    "sense_definition": "Een plat, cirkelvormig gebak met een opstaande rand, traditioneel gevuld met vruchten of pudding, vooral bekend uit Limburg.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gebak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de koffie kregen we een heerlijk stuk Limburgse <w>vlaai</w> aangeboden.",
                            "target_lang_translations": {
                                "en": "With the coffee, we were offered a delicious piece of Limburg <w>tart</w>."
                            }
                        },
                        {
                            "text": "Zij besloot een kersen <w>vlaai</w> te bakken voor de verjaardag van haar moeder.",
                            "target_lang_translations": {
                                "en": "She decided to bake a cherry <w>pie</w> for her mother's birthday."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Limburgse vlaai",
                        "een stuk vlaai"
                    ],
                    "target_lang_definitions": {
                        "en": "A flat, circular pastry with a raised edge, traditionally filled with fruit or pudding, especially famous from the Limburg region."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vlaai",
                                "target_lang_sense_clarification": "traditional Dutch regional pie/tart"
                            },
                            {
                                "target_lang_word": "tart",
                                "target_lang_sense_clarification": "sweet pastry with filling"
                            },
                            {
                                "target_lang_word": "pie",
                                "target_lang_sense_clarification": "baked dish of fruit or custard with pastry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5997a834-0658-35db-8a80-0babe2535832",
                    "sense_definition": "Platte, ronde hoop uitwerpselen van een koe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uitwerpselen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de wandeling door de wei stapte hij per ongeluk in een <w>vlaai</w>.",
                            "target_lang_translations": {
                                "en": "During the walk through the meadow, he accidentally stepped in a <w>cowpat</w>."
                            }
                        },
                        {
                            "text": "De weide lag vol met menige verse <w>vlaai</w> van de grazende koeien.",
                            "target_lang_translations": {
                                "en": "The meadow was full of many a fresh <w>cow pie</w> from the grazing cows."
                            }
                        }
                    ],
                    "synonyms": [
                        "koeienvlaai"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in landelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A flat, round pile of cow dung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cowpat",
                                "target_lang_sense_clarification": "dropping of cow dung"
                            },
                            {
                                "target_lang_word": "cow pie",
                                "target_lang_sense_clarification": "pile of cow excrement"
                            }
                        ]
                    }
                }
