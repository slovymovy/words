                        "tags": [
                            "comparative"
                        ],
                        "form": "more fetching"
                    },
                    {
                        "form_id": "3636cf83-9763-47b5-aeed-41cbeefdeefa",
                        "entry_id": "a0a2c5ea-dc33-3d1f-9cc4-0b428540c67e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most fetching"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a4c764e-44d5-3658-824a-f32f79c1efbd",
                        "entry_id": "a0a2c5ea-dc33-3d1f-9cc4-0b428540c67e",
                        "glosses": [
                            "Attractive; pleasant to regard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2473fbd5-223f-4139-950f-f91d3cacdbdf",
                                "sense_id": "8a4c764e-44d5-3658-824a-f32f79c1efbd",
                                "text": "Nurse Cramer had a cute nose and a radiant, blooming complexion dotted with fetching sprays of adorable freckles that Yossarian detested."
                            },
                            {
                                "example_id": "b2b98f33-5f94-4541-8292-918d356724dc",
                                "sense_id": "8a4c764e-44d5-3658-824a-f32f79c1efbd",
                                "text": "I am not, I regret to say, a discreet and fetching sleeper. Most people when they nod off look as if they could do with a blanket; I look as if I could do with medical attention."
                            },
                            {
                                "example_id": "36ba6db7-440b-4a78-9578-11592e317651",
                                "sense_id": "8a4c764e-44d5-3658-824a-f32f79c1efbd",
                                "text": "“The men in this town have a serious case of pussy affluenza,” says Amy Watanabe, 28, the fetching, tattooed owner of Sake Bar Satsko, a lively izakaya in New York’s East Village."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd716ba1-734f-4db3-9582-d472cbfdb38f",
                        "source_entry_id": "a0a2c5ea-dc33-3d1f-9cc4-0b428540c67e",
                        "source_sense_id": "8a4c764e-44d5-3658-824a-f32f79c1efbd",
                        "source_sense_description": "Attractive; pleasant to regard",
                        "target_lang_word": "attirant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attirant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4838bee-a348-365c-9507-db48017db44a",
                                        "entry_id": "eef37e6b-918c-3caf-8cb8-cc1657cca142",
                                        "glosses": [
                                            "Qui attire. Il ne s’emploie guère qu’au figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbbfd35-3a7c-40a5-b365-ed5df8687b63",
                                                "sense_id": "a4838bee-a348-365c-9507-db48017db44a",
                                                "text": "Souvent, histoire de passer le temps, les paléopathologistes entrent dans les églises dans l’espoir d’y repérer une tombe atypique, une relique extravagante, une inscription funéraire plus ou moins attirante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "attirant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccde9e90-aa9c-341b-bcec-2ea0d43f4767",
                                        "entry_id": "e4c14aec-2faf-32b5-b121-3b030e90642b",
                                        "glosses": [
                                            "Participe présent du verbe attirer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f5e1ffb-e8f1-468c-b361-8947be1e2129",
                                                "sense_id": "ccde9e90-aa9c-341b-bcec-2ea0d43f4767",
                                                "text": "Et elle se faisait caressante, l’attirant, levant ses lèvres pour qu’il les baisât."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b23ada6-d6ab-4ad8-86d4-99c5f3be85fa",
                        "source_entry_id": "a0a2c5ea-dc33-3d1f-9cc4-0b428540c67e",
                        "source_sense_id": "8a4c764e-44d5-3658-824a-f32f79c1efbd",
                        "source_sense_description": "Attractive; pleasant to regard",
                        "target_lang_word": "attraktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attraktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ceed40-88f9-3af2-bc93-375ea9baf421",
                                        "entry_id": "6a34c828-4721-3199-a24f-a2fad8737aac",
                                        "glosses": [
                                            "ansprechend in Aussehen und Verhalten"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0500f881-3270-408d-b85e-9c017322810f",
                                                "sense_id": "c8ceed40-88f9-3af2-bc93-375ea9baf421",
                                                "text": "Sie sah attraktiv aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6e6744c-950e-3e37-8849-0c25c118ded0",
                                        "entry_id": "6a34c828-4721-3199-a24f-a2fad8737aac",
                                        "glosses": [
                                            "mit ansprechenden Bedingungen ausgestattet"
                                        ],
                                        "tags": [
                                            "von Gegenständen",
                                            "Sachverhalten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3ba157-28f8-4ee7-bf1c-271cca096ff8",
                                                "sense_id": "e6e6744c-950e-3e37-8849-0c25c118ded0",
                                                "text": "Das Angebot schien ihm sehr attraktiv zu sein."
                                            },
                                            {
                                                "example_id": "fc4953af-ff66-46ea-ad35-6d850bb2b992",
                                                "sense_id": "e6e6744c-950e-3e37-8849-0c25c118ded0",
                                                "text": "Er konnte sich keinen für ihn attraktiveren Job vorstellen."
                                            },
                                            {
                                                "example_id": "164e1ed2-e593-4ef0-a02c-1716c290d1db",
                                                "sense_id": "e6e6744c-950e-3e37-8849-0c25c118ded0",
                                                "text": "„Die Verteidigungsministerin bekräftigte zugleich ihr Versprechen, den Dienst in der Truppe attraktiver und familienfreundlicher zu gestalten.“"
                                            },
                                            {
                                                "example_id": "64ea18de-e395-4fac-ab41-c338d620893c",
                                                "sense_id": "e6e6744c-950e-3e37-8849-0c25c118ded0",
                                                "text": "„Rom war als Siedlungsplatz wohl deshalb besonders attraktiv, weil es an einer Furt des Tiber lag, die wichtig war für die Verbindungen zwischen dem nördlich gelegenen Etrurien und dem südlich gelegenen Kampanien, und weil hier die Salzstraße vorbeiführte, auf der dieses schon in der Frühgeschichte wichtige Mineral von den Salzbuchten an der Tibermündung ins Landesinnere geschafft wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
