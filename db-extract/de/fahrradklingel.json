                "senses": [
                    {
                        "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                        "entry_id": "9a465291-195d-380b-baf8-a4a85a13899f",
                        "glosses": [
                            "meist am Lenker befestigte Vorrichtung, um ein akustisches Warnsignal geben zu können (= klingeln, läuten)"
                        ],
                        "tags": [
                            "Fahrrad"
                        ],
                        "examples": [
                            {
                                "example_id": "9c378cc3-f399-4197-bb34-61a52dd1ed5d",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "[Schlagzeile:] Viele Fahrradklingeln sind zu leise"
                            },
                            {
                                "example_id": "0e27e09c-0245-425d-b515-a9ac5191f19f",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "Ich ließ meine Fahrradklingel trillern, vielleicht etwas heftiger als sonst, da ich die Dame zum Aufschauen zwingen wollte, um sie grüßen zu können."
                            },
                            {
                                "example_id": "e9d3c346-3798-4483-aefa-4a58c730bcb8",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "Eine herkömmliche Fahrradklingel darf […] am Lenker eines [modernen] E-Bikes nicht fehlen."
                            },
                            {
                                "example_id": "f254d839-8ba9-40c6-93e5-4ea339c237fb",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "Jedes Fahrrad muss laut Straßenverkehrs-Zulassungsordnung (StVZO) mit einer „helltönenden Glocke“ ausgerüstet sein. […] Näher beschreibt die StVZO die Fahrradklingel jedoch nicht."
                            },
                            {
                                "example_id": "039f3e0b-2f49-4593-853b-3012f0bffa83",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "Die gute alte Fahrradklingel lässt sich zwar noch nicht aus recycelbarem Material herstellen, wohl aber viele andere Zubehör-Artikel […]"
                            },
                            {
                                "example_id": "cf88221c-95c2-47f9-aafe-f071b47b21ff",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "[…] die Fahrradklingel wird überflüssig, denn COBI kann mit 90 Dezibel elektronisch klingeln."
                            },
                            {
                                "example_id": "aae4f23a-689d-4d09-bb76-96e3271ca568",
                                "sense_id": "33e442be-2b0d-3ac5-991c-f89fff6f4172",
                                "text": "Beim Reparieren seines Fahrrades erkennt [der Schweizer DJ Cee-Roo], dass sich Speichen, Schutzblech und Fahrradklingel auch gut zum Musik machen eignen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
