                    {
                        "sense_id": "a99a7c31-7275-31ad-807d-ba0f3bb97abd",
                        "entry_id": "b29c1eef-bf76-30cd-90e4-534191828726",
                        "glosses": [
                            "Das Stockwerk oder eines der Stockwerke zwischen dem Dachgeschoss und dem Erdgeschoss"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "87782cff-c1d8-482d-bbc5-754b9ff7e830",
                                "sense_id": "a99a7c31-7275-31ad-807d-ba0f3bb97abd",
                                "text": "Wir wohnen im Obergeschoß."
                            },
                            {
                                "example_id": "925ec927-180d-4576-bd5e-9795f46e57a2",
                                "sense_id": "a99a7c31-7275-31ad-807d-ba0f3bb97abd",
                                "text": "„Als die Handwerker die Treppe zum Obergeschoß einbauten, war der Lärm beim Bohren so groß, daß man dachte, gleich kracht das Haus ein.“"
                            },
                            {
                                "example_id": "8da38766-96da-44f2-b5fb-2062867ea7f2",
                                "sense_id": "a99a7c31-7275-31ad-807d-ba0f3bb97abd",
                                "text": "„Im Obergeschoß ging ich den Korridor lang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
