                    {
                        "translation_id": "7eed835b-580d-4dad-84ea-02d44840fe12",
                        "source_entry_id": "5dafc4ff-e2e5-3205-b7d3-802a79b32015",
                        "source_sense_id": "36c73604-0db6-394a-bb79-c35dc2dc2002",
                        "source_sense_description": "Dermatologie: kleiner, bräunlicher oder schwarzer Fleck auf der Haut",
                        "target_lang_word": "grain de beauté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grain de beauté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7e0b4c-dffa-37f0-9687-f8199e5631ff",
                                        "entry_id": "dbd4a0fc-c490-33a3-aa3a-e3e439ab40f6",
                                        "glosses": [
                                            "Petite tache sur la peau humaine, souvent de couleur marron ou noire, qui évolue parfois en mélanomes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a87b5e6-9fba-46a6-8c87-1c4050268657",
                                                "sense_id": "0e7e0b4c-dffa-37f0-9687-f8199e5631ff",
                                                "text": "S’il était perplexe devant un beau cas, il tripotait d’une main nerveuse un grain de beauté velu qu’il avait au visage."
                                            },
                                            {
                                                "example_id": "a251bc72-5fad-4656-9d47-56fbacace93e",
                                                "sense_id": "0e7e0b4c-dffa-37f0-9687-f8199e5631ff",
                                                "text": "Mais Mistress Arline n’est que grande et n’est que belle. Elle n’a qu’un grain de beauté, de même que l’or pur n’a qu’un poinçon."
                                            },
                                            {
                                                "example_id": "a5d7742c-b289-43e7-874c-622848a61df9",
                                                "sense_id": "0e7e0b4c-dffa-37f0-9687-f8199e5631ff",
                                                "text": "Lentement il écarta l’étoffe. À droite, un grain de beauté, noir comme une de ces mouches que les coquettes se posaient autrefois, marquait la peau blanche et soyeuse et suivait le rythme égal de la respiration."
                                            },
                                            {
                                                "example_id": "efa83705-632f-47e4-9e4b-db8553d4376b",
                                                "sense_id": "0e7e0b4c-dffa-37f0-9687-f8199e5631ff",
                                                "text": "Elle avait de quoi les séduire, ainsi costumée en sultane, un petit fez rouge sur la tête, ou en duchesse emperruquée, toute de blanc vêtue avec son joli visage aux traits fins, ses grands yeux sombres et ses faux grains de beauté."
                                            },
                                            {
                                                "example_id": "fbc61d69-0b0b-4fb5-a471-9d8d063c4d44",
                                                "sense_id": "0e7e0b4c-dffa-37f0-9687-f8199e5631ff",
                                                "text": "C’est ainsi qu’on avait pu vérifier que Mémère avait sur les fesses ou aux cuisses le grain de beauté familial que ma mère avait transmis à ses trois enfants."
                                            }
                                        ]
                                    }
