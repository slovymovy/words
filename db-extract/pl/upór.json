                    {
                        "sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
                        "entry_id": "cc37f377-fe67-3e91-8a2d-d592f81e3667",
                        "glosses": [
                            "niezmienne zachowanie, ciągłe trwanie przy tych samych zasadach czy poglądach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1cc4a85-c7c8-4106-9f23-9828a8693159",
                                "sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
                                "text": "A z jak wielkim uporem Wandzia próbowała zjechać cały slalom i co rusz niestety upadała na stoku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d4120ba-0739-4ea3-bd6d-514f631a0565",
                        "source_entry_id": "cc37f377-fe67-3e91-8a2d-d592f81e3667",
                        "source_sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
                        "target_lang_word": "stubbornness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stubbornness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                        "entry_id": "864f6d6b-7b72-3d3b-8ea5-50cd3945b837",
                                        "glosses": [
                                            "The state of being stubborn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf384cd-7809-415a-aabb-b9dbbb274f55",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "[H]appy is your Grace / That can tranſlate the ſtubbornneſſe of fortune / Into ſo quiet and ſo ſweet a ſtile."
                                            },
                                            {
                                                "example_id": "3b38afaf-cca1-481b-b6fc-909e6574e7e6",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "Brant Rios and Eos Parish have been dating five years and experienced their state’s stubbornness firsthand Friday when they were the first couple to arrive at the Ouachita Parish Courthouse to be wed – and were the first to be turned away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c418306-7ad4-4731-a6d5-c540647a68d5",
                        "source_entry_id": "cc37f377-fe67-3e91-8a2d-d592f81e3667",
                        "source_sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
                        "target_lang_word": "obstinacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                        "entry_id": "d2ea0fe7-e2ea-3927-a3b1-7f35fd6ee269",
                                        "glosses": [
                                            "The state, or an act, of stubbornness or doggedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67bf7caf-e589-46ea-bc2d-75c26c3b33bc",
                                                "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                                "text": "He finished only through a mixture of determined obstinacy and ingenuity."
                                            },
                                            {
                                                "example_id": "dfc6d731-a558-40c0-bc9b-07448a4f8211",
                                                "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                                "text": "\"I don't know where,\" replied the girl.\n\"Then I do,\" said Sikes, more in the spirit of obstinacy than because he had any real objection."
                                            },
                                            {
                                                "example_id": "4d76158a-f755-4db9-aa0c-13dffecb96b2",
                                                "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                                "text": "1877, Leo Tolstoy (author), David Magarshack (translator), Anna Karenina, part 6, ch 12,\nHis hand closed, he drew back, and his face assumed a still more stubborn expression.\n\"For you it's a matter of obstinacy,\" she said, looking intently at him and suddenly finding the right word for the expression of his face which exasperated her so much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f100f97-ad51-3850-ae39-effa6cd571db",
                                        "entry_id": "d2ea0fe7-e2ea-3927-a3b1-7f35fd6ee269",
                                        "glosses": [
                                            "A group of bison; the collective noun for bison."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "552574b7-bcef-49c4-9507-b5640cd8c7d6",
                        "source_entry_id": "cc37f377-fe67-3e91-8a2d-d592f81e3667",
                        "source_sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
                        "target_lang_word": "obduracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obduracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                        "entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                                        "glosses": [
                                            "The state of being obdurate, intractable, or stubbornly inflexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9346fe4e-cc29-4c91-ab33-29a89c47664d",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "By this hand thou, thinkeſt me as farre in the diuels booke, as thou and Falſtaffe, for obduracie and perſiſtancie, let the end trie the man, [...]"
                                            },
                                            {
                                                "example_id": "24cdf459-20f8-4a65-a6bd-3652eece2565",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "It might also serve to condemn the obduracy and hard-heartedness of the Jews, who relented not, when even the earth trembled and the rocks rent."
                                            },
                                            {
                                                "example_id": "c9d9321e-e65c-4242-80c4-0b0ba996c639",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "True mountain Liberty alone may heal\nThe pain which Custom's obduracies bring."
                                            },
                                            {
                                                "example_id": "ba5b085f-ad93-46ff-9474-e482f69594eb",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "She snatched up a stick and hit Cora across the rump with it. The stick was rotten and broke, without having caused Cora to budge an inch. Exasperated at an image of obduracy, the old woman scrabbled up another stick and began whacking at Cora with it[.]"
                                            },
                                            {
                                                "example_id": "67aa3e0a-67ac-4b92-aea4-2e1bcc8e469c",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "Chanderpaul's obduracy might have broken lesser men, but Panesar more than matched him for relentlessness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "204eb7e6-041d-4df1-8afb-4c0e8ae0f160",
                        "source_entry_id": "cc37f377-fe67-3e91-8a2d-d592f81e3667",
                        "source_sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
                        "target_lang_word": "pertinacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pertinacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70bf4891-e351-3ba9-a75f-38621ab9716f",
                                        "entry_id": "b0bdf16c-98b8-3e08-b72e-56b30f4b13d5",
                                        "glosses": [
                                            "The state or characteristic of being pertinacious."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79d8ada-6e59-49c4-a80d-ef1983e7cf3d",
                                                "sense_id": "70bf4891-e351-3ba9-a75f-38621ab9716f",
                                                "text": "1846, Edgar Allen Poe, The Black Cat\nWith my aversion to this cat, however, its partiality for myself seemed to increase. It followed my footsteps with a pertinacity which it would be difficult to make the reader comprehend."
                                            },
                                            {
                                                "example_id": "d1894253-3618-4609-a21b-78a4eb8c8343",
                                                "sense_id": "70bf4891-e351-3ba9-a75f-38621ab9716f",
                                                "text": "Again and again, however, and half a dozen other agains, with the inexorable pertinacity of a child intent upon some object important to itself, did he renew his efforts for admittance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "318fedc6-39ae-4f54-873c-963d5c7e4310",
                        "source_entry_id": "cc37f377-fe67-3e91-8a2d-d592f81e3667",
                        "source_sense_id": "7c89208c-a6fe-3143-864c-ba139e633823",
