                        ],
                        "examples": [
                            {
                                "example_id": "080c6432-d647-492d-9a91-2b117b414678",
                                "sense_id": "7c4fa44a-b089-3116-8f70-051034fcb000",
                                "text": "Advisers are encouraged to engage with their clients on ESG issues rather than merely regard ESG matters as a discrete checkbox compliance requirement."
                            },
                            {
                                "example_id": "915f03b9-f636-4208-8ee1-3eb18967224a",
                                "sense_id": "7c4fa44a-b089-3116-8f70-051034fcb000",
                                "text": "New firms like Arabesque are making ESG data a core part of their strategy. Goldman Sachs has filed with the Securities and Exchange Commission to start an ESG-focused exchange-traded fund."
                            },
                            {
                                "example_id": "b100ff17-4674-47a2-9726-e06c1cee708d",
                                "sense_id": "7c4fa44a-b089-3116-8f70-051034fcb000",
                                "text": "ESG funds"
                            },
                            {
                                "example_id": "f8b4a8d6-147f-4d8f-9aeb-f1f74a52bb85",
                                "sense_id": "7c4fa44a-b089-3116-8f70-051034fcb000",
                                "text": "Much of this year’s letter was devoted to Mr. Fink’s belief that a focus on environmental, social and corporate governance issues — E.S.G., for short — does not conflict with making money."
                            },
                            {
                                "example_id": "3ec13daf-8e33-435b-a831-2c9fc9f34bd5",
                                "sense_id": "7c4fa44a-b089-3116-8f70-051034fcb000",
                                "text": "In a shift in tone from his previously more strident embrace of ESG, Fink emphasised that clients were responsible for their own investment decisions."
                            }
                        ]
