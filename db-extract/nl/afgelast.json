                                "sense_id": "bf949fb7-3e5e-3d06-8f53-86364353a377",
                                "text": "De lasser heeft de constructie afgelast."
                            },
                            {
                                "example_id": "bd4cb53b-a6d7-4e68-87a6-200a1a174558",
                                "sense_id": "bf949fb7-3e5e-3d06-8f53-86364353a377",
                                "text": "De diverse staalconstructies worden lasklaar samengebouwd en afgelast."
                            },
                            {
                                "example_id": "e8ca1760-28ba-430d-9607-586271a63fdd",
                                "sense_id": "bf949fb7-3e5e-3d06-8f53-86364353a377",
                                "text": "Het afgelaste hek werd direct na het lassen groen gespoten."
                            },
                            {
                                "example_id": "e157ac3e-00b1-48a9-8035-f576a9eaba42",
                                "sense_id": "bf949fb7-3e5e-3d06-8f53-86364353a377",
                                "text": "De romp van de boot is dubbelzijdig afgelast."
                            }
                        ]
                    }
