                                                "example_id": "c8e1de40-0232-4b6c-860f-44fe815f90fa",
                                                "sense_id": "17e98623-3926-3279-be30-03da511f50f4",
                                                "text": "This plant flowers in June."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbbfcfee-dde2-3890-820b-d5fb7f6db5a5",
                                        "entry_id": "0f89dc65-c72e-35f3-bc1c-bce62100fa74",
                                        "glosses": [
                                            "To decorate with pictures of flowers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e83c363-93f9-36d7-8915-541d8fc66dce",
                                        "entry_id": "0f89dc65-c72e-35f3-bc1c-bce62100fa74",
                                        "glosses": [
                                            "To reach a state of full development or achievement."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a1f163-132f-409c-8bb7-f1eb602e91c1",
                                                "sense_id": "6e83c363-93f9-36d7-8915-541d8fc66dce",
                                                "text": "when flowr'd my youthful spring"
                                            },
                                            {
                                                "example_id": "4a92cc8f-108f-4a56-8c0c-4cd71e26eb78",
                                                "sense_id": "6e83c363-93f9-36d7-8915-541d8fc66dce",
                                                "text": "It only needed watering to take root, to flower and to fructify, and the watering came in due course."
                                            },
                                            {
                                                "example_id": "1fec1600-f0dd-4d42-9d37-57022a097b3b",
                                                "sense_id": "6e83c363-93f9-36d7-8915-541d8fc66dce",
                                                "text": "In life after life of this now-expanded circle of women artists, writers and revolutionaries, the same appeared: a flowing of creative insight and vision seemed the follow a sexual flowering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b487faca-c02b-328a-b5c4-b54ac524805c",
                                        "entry_id": "0f89dc65-c72e-35f3-bc1c-bce62100fa74",
                                        "glosses": [
                                            "To froth; to ferment gently, as new beer."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93158323-a4cc-41c7-a125-005b3e9a8395",
                                                "sense_id": "b487faca-c02b-328a-b5c4-b54ac524805c",
                                                "text": "That beer did flower a little."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4c744d-1b83-3ee7-ab73-7d65ce77a377",
                                        "entry_id": "0f89dc65-c72e-35f3-bc1c-bce62100fa74",
                                        "glosses": [
                                            "To come off as flowers by sublimation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e31332-e850-4530-94a7-34942cf0a3e8",
                                                "sense_id": "dd4c744d-1b83-3ee7-ab73-7d65ce77a377",
                                                "text": "observations which have flowered off"
                                            }
                                        ]
                                    }
                                ]
                            },
