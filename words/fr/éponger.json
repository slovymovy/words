    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "809f58cf-e5f4-31e1-bcaa-3a9fd459e2ef",
                    "sense_definition": "Nettoyer ou absorber un liquide répandu avec une éponge ou un linge.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "nettoyage_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut vite <w>éponger</w> l'eau tombée sur la table avant qu'elle ne coule par terre."
                        },
                        {
                            "text": "Après l'inondation de la cuisine, nous avons passé des heures à <w>éponger</w> le sol carrelé."
                        }
                    ],
                    "synonyms": [
                        "essuyer",
                        "absorber",
                        "étancher"
                    ],
                    "common_phrases": [
                        "éponger un liquide"
                    ]
                },
                {
                    "sense_id": "3ae4eb8d-0ba5-3160-9838-da3ec43b067c",
                    "sense_definition": "Essuyer la sueur ou l'humidité sur son corps, en particulier sur le front ou le visage.",
