                    {
                        "sense_id": "df018b1d-81ba-3368-b309-2881588e1504",
                        "entry_id": "fe6682fa-3a7f-33e4-b5bb-b0a90646370b",
                        "glosses": [
                            "To load in advance (used especially in reference to software installed on a computer prior to sale)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4da9b747-5205-4a19-9d48-fbfd888d838b",
                                "sense_id": "df018b1d-81ba-3368-b309-2881588e1504",
                                "text": "My computer came preloaded with wordprocessor software."
                            }
                        ]
                    },
                    {
                        "sense_id": "57ceabd4-6131-3a01-8594-9c50a7100d6e",
                        "entry_id": "fe6682fa-3a7f-33e4-b5bb-b0a90646370b",
                        "glosses": [
                            "To drink (cheaper) alcohol at home before going out socially."
                        ],
                        "tags": [
                            "British",
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8447bb37-102e-400d-b313-d6f3a289eb62",
                                "sense_id": "57ceabd4-6131-3a01-8594-9c50a7100d6e",
                                "text": "That nightclub is so expensive. Let's preload at your flat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6358cbd2-5e0a-459b-bc04-4ccba4808eec",
                        "source_entry_id": "fe6682fa-3a7f-33e4-b5bb-b0a90646370b",
                        "source_sense_description": "to drink alcohol",
                        "target_lang_word": "vortrinken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b8bf36eb-d69d-43a8-8aa1-2acce7298bf9",
                        "source_entry_id": "fe6682fa-3a7f-33e4-b5bb-b0a90646370b",
                        "source_sense_description": "to drink alcohol",
                        "target_lang_word": "vorglühen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorglühen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e58736d0-e899-3bc1-9d53-18a4d5f6e4e1",
                                        "entry_id": "cd9b3d30-6430-386a-b3e4-728515913103",
                                        "glosses": [
                                            "bei Dieselmotoren das Erwärmen der Brennräume mit Hilfe von Glühkerzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8b7735-62c5-4d67-bd39-36483bfcbe0b",
                                                "sense_id": "e58736d0-e899-3bc1-9d53-18a4d5f6e4e1",
                                                "text": "Früher war es üblich, den Dieselmotor eine Weile vorzuglühen – bei vielen modernen Autos findet diese Aufwärmphase inzwischen vom Fahrer nahezu unbemerkt statt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d48cdcb-e91f-3673-97a9-6710cd26ba49",
                                        "entry_id": "cd9b3d30-6430-386a-b3e4-728515913103",
                                        "glosses": [
                                            "sich mit Alkohol zu Hause in Stimmung bringen, bevor man feiern geht/ausgeht, um Kosten in einer teuren Bar/Diskothek zu sparen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c6f2b1-c5b9-4d0b-b9fb-b4aa6897a4c1",
                                                "sense_id": "4d48cdcb-e91f-3673-97a9-6710cd26ba49",
                                                "text": "„Viele Besucher, die morgens an den Eingängen zum Festgelände [der Münchner Wiesn] auf Einlass warteten, hatten schon Bier in Dosen dabei – und damit gut vorgeglüht.“"
                                            },
                                            {
                                                "example_id": "80fbdf05-3558-4a76-a8e1-283680cbbc4a",
                                                "sense_id": "4d48cdcb-e91f-3673-97a9-6710cd26ba49",
                                                "text": "„Vor der ‚Cliv-Lounge‘ passt Margarete auf, wer hineinkommt und wer nicht: »Die feiern einfach, die trinken, haben schon vorher total vorgeglüht, sind schon mega-angetrunken.«“"
                                            },
                                            {
                                                "example_id": "e6b12d38-b280-48dc-804c-9d0aa291f089",
                                                "sense_id": "4d48cdcb-e91f-3673-97a9-6710cd26ba49",
                                                "text": "[Münchner Oktoberfest:] „Viele Wiesngäste hatten seit dem frühen Morgen ausgeharrt. Die ersten kamen schon in der Dunkelheit und hielten sich mit Kaffee oder Brotzeit unter den Regenschirmen warm - einige glühten mit mitgebrachtem Bier vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5e49cb0-0d05-3ae5-8263-13a763ef9dc9",
                                        "entry_id": "cd9b3d30-6430-386a-b3e4-728515913103",
                                        "glosses": [
                                            "hinter Wolken hervorscheinen (Sonne)"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
