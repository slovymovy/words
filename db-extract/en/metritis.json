                        "glosses": [
                            "Inflammation of the uterus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b85091b7-adb1-4d07-8d26-8b91db88c6e0",
                                "sense_id": "d6122543-be50-37ec-ad29-359abf06ca8d",
                                "text": "The conjunctive tissue, young and succulent, then becomes hard and fibrous, and the uterus, on section, is pale, indurated and devoid of blood; that is chronic metritis which has reached the second period, or period of induration."
                            },
                            {
                                "example_id": "ddbb868a-68a7-495e-a7c3-a3722632d383",
                                "sense_id": "d6122543-be50-37ec-ad29-359abf06ca8d",
                                "text": "The use of systemic antibiotics is justified and often required for metritis that causes systemic illness."
                            }
                        ]
                    }
