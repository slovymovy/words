                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e015f7db-4d32-44dc-bafe-c082c3af9d57",
                                "sense_id": "d7bb3323-a15a-3fbf-b128-82ce50c6eab2",
                                "text": "The Aspidosperma alkaloids are the largest group of indole alkaloids."
                            },
                            {
                                "example_id": "d0339c06-0ddf-495f-80fa-a5636098d88d",
                                "sense_id": "d7bb3323-a15a-3fbf-b128-82ce50c6eab2",
                                "text": "Xanthosine, the initial substrate of purine alkaloid synthesis, is supplied by at least four different pathways […]"
