                                "target_senses": [
                                    {
                                        "sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                                        "entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
                                        "glosses": [
                                            "α Ori, étoile alpha de la constellation d’Orion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8b05a1-5ff3-4805-9baa-55bab6daad9b",
                                                "sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                                                "text": "La fin de la journée se passa sans incident ; mais, vers le soir, après avoir admiré le fantastique coucher de Bételgeuse, dilatée à l'horizon au-delà de toute imagination humaine, nous eûmes l'impression d'un changement autour de nous."
                                            },
                                            {
                                                "example_id": "dc3bc51d-ae13-400b-9c61-e7af215294d8",
                                                "sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                                                "text": "J'ai dû lui donner l'impression de revenir de très loin, de Bételgeuse ou d'Alpha du Centaure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
