                "senses": [
                    {
                        "sense_id": "fcd3f4c0-6a8d-38da-a637-f6331e591ded",
                        "entry_id": "e62ee861-097b-386a-be65-417f606b8be3",
                        "glosses": [
                            "tweede vinger, gelegen tussen de middelvinger en de duim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9abcc9-7658-455c-951c-6b3d1fceac9e",
                                "sense_id": "fcd3f4c0-6a8d-38da-a637-f6331e591ded",
                                "text": "Tijdens zijn volgende verlof was Cécile er dromerig en betoverd met het puntje van haar wijsvinger overheen gegaan, wat Alberts stemming er niet beter op had gemaakt."
                            },
                            {
                                "example_id": "7584690c-4b34-4a9b-ab6e-6793d6c6c18c",
                                "sense_id": "fcd3f4c0-6a8d-38da-a637-f6331e591ded",
                                "text": "Ik veeg er met mijn wijsvinger over."
                            },
                            {
                                "example_id": "a3fe14e5-54d8-44f4-9e45-9adf5330b003",
                                "sense_id": "fcd3f4c0-6a8d-38da-a637-f6331e591ded",
                                "text": "Bibi pakt met duim en wijsvinger het slotje van de rits."
                            },
                            {
                                "example_id": "1552f236-5929-4e86-ac08-240b136146ab",
                                "sense_id": "fcd3f4c0-6a8d-38da-a637-f6331e591ded",
                                "text": "Ik hoorde de songtekst nog steeds toen ik terugdacht aan de schouderklop die ik Joy op Sicilië ter afscheid gaf, waarbij ik heel even stiekem met mijn wijsvinger over haar zachte nekvel aaide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec3190db-7484-4243-8c58-401760600dc5",
                        "source_entry_id": "e62ee861-097b-386a-be65-417f606b8be3",
                        "source_sense_id": "fcd3f4c0-6a8d-38da-a637-f6331e591ded",
                        "source_sense_description": "tweede vinger, gelegen tussen de middelvinger en de duim",
                        "target_lang_word": "Zeigefinger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeigefinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3666de66-214a-34e5-935d-13c03dcc2245",
                                        "entry_id": "7e464cba-6d2a-3211-b001-81d164445d90",
                                        "glosses": [
                                            "ein Teil der Hand, und zwar der zweite Finger der Hand, der zwischen dem Daumen und dem Mittelfinger liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc29b317-7002-4ab4-aa0e-408aa496bc06",
                                                "sense_id": "3666de66-214a-34e5-935d-13c03dcc2245",
                                                "text": "„In diesem Moment tauchte vor meiner Nase ein langer Zeigefinger auf.“"
                                            },
                                            {
                                                "example_id": "ca3be16b-47b4-41c4-959f-903c3e3ec951",
                                                "sense_id": "3666de66-214a-34e5-935d-13c03dcc2245",
                                                "text": "„Da kommt dann der erhobene Zeigefinger: „Du weißt doch ganz genau, dass du das nicht darfst“.“"
                                            },
                                            {
                                                "example_id": "94bb045d-5643-404e-9a35-60f249a6e046",
                                                "sense_id": "3666de66-214a-34e5-935d-13c03dcc2245",
                                                "text": "„Ein kleines Beispiel: wenn wir im Deutschen aufzählen, erstens, zweitens, drittens, beginnen wir zeigend mit dem Daumen der rechten Hand und machen dann mit dem Zeigefinger und dem Mittelfinger weiter und beginnen unter Umständen erneut mit dem Daumen derselben oder der anderen Hand.“"
                                            },
                                            {
                                                "example_id": "7cfcac94-f82e-4d94-83f5-74d262a7740e",
                                                "sense_id": "3666de66-214a-34e5-935d-13c03dcc2245",
                                                "text": "„Isabella legte den Zeigefinger an die Lippen, und schweigend horchten wir beide an der Tür.“"
                                            },
                                            {
                                                "example_id": "e0115b1e-97e3-487d-bb82-2195f6f7b6ed",
                                                "sense_id": "3666de66-214a-34e5-935d-13c03dcc2245",
                                                "text": "„Dann war ihr spitzer Zeigefinger wieder auf den Gedruckten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8573aa39-2afd-4438-9f11-8a4b68dd89b8",
                        "source_entry_id": "e62ee861-097b-386a-be65-417f606b8be3",
