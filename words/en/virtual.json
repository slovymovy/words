{
    "word_family": [
        "virtuality",
        "virtually",
        "virtualize",
        "virtualization"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "537bb555-612a-3526-898a-901acdca6882",
                    "sense_definition": "Simulated or existing within a computer system or online environment rather than in the physical world.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>virtual</w> world of his computer game allowed character interaction.",
                            "target_lang_translations": {
                                "ru": "<w>Виртуальный</w> мир его компьютерной игры позволял персонажам взаимодействовать."
                            }
                        },
                        {
                            "text": "Many companies now use a <w>virtual</w> private network to ensure secure remote access for employees.",
                            "target_lang_translations": {
                                "ru": "Многие компании сейчас используют <w>виртуальную</w> частную сеть для обеспечения безопасного удаленного доступа сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "cyberreal"
                    ],
                    "antonyms": [
                        "actual",
                        "real"
                    ],
                    "common_phrases": [
                        "virtual reality",
                        "virtual private network",
                        "virtual machine",
                        "virtual memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Симулированный или существующий внутри компьютерной системы или онлайн-среды, а не в физическом мире."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виртуальный",
                                "target_lang_sense_clarification": "существующий в цифровой среде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e22939c1-c5b4-3f10-8b6e-ff50dcb701ac",
                    "sense_definition": "Carried out, accessed, or operating by means of a computer or the internet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the pandemic, many students attended <w>virtual</w> classes from their homes.",
                            "target_lang_translations": {
                                "ru": "Во время пандемии многие студенты посещали <w>виртуальные</w> занятия из дома."
                            }
                        },
                        {
                            "text": "I hired a <w>virtual</w> assistant to help me manage my daily schedule and emails.",
                            "target_lang_translations": {
                                "ru": "Я нанял <w>виртуального</w> ассистента, чтобы он помогал мне управлять расписанием и почтой."
                            }
                        }
                    ],
                    "antonyms": [
                        "real"
                    ],
                    "common_phrases": [
                        "virtual assistant",
                        "virtual meeting",
                        "virtual tour",
                        "virtual classroom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществляемый, доступный или работающий с помощью компьютера или интернета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виртуальный",
                                "target_lang_sense_clarification": "проводимый через интернет"
                            },
                            {
                                "target_lang_word": "дистанционный",
                                "target_lang_sense_clarification": "удаленный, через средства связи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "415ca317-928f-3201-a302-2d22db6a8093",
                    "sense_definition": "Being so in practice or effect, though not formally or technically recognized as such.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain caused a <w>virtual</w> standstill in the city's morning traffic.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь привел к <w>фактической</w> остановке утреннего движения в городе."
                            }
                        },
                        {
                            "text": "After the scandal, the politician became a <w>virtual</w> prisoner in his own home.",
                            "target_lang_translations": {
                                "ru": "После скандала политик стал <w>настоящим</w> узником в собственном доме."
                            }
                        }
                    ],
                    "synonyms": [
                        "de facto"
                    ],
                    "antonyms": [
                        "actual",
                        "true"
                    ],
                    "common_phrases": [
                        "virtual certainty",
                        "virtual monopoly",
                        "virtual standstill",
                        "virtual prisoner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся таковым на практике или по результату, хотя формально или технически не признанный таковым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фактический",
                                "target_lang_sense_clarification": "действительный на деле"
                            },
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "по сути являющийся чем-либо"
                            },
                            {
                                "target_lang_word": "практически полный",
                                "target_lang_sense_clarification": "почти стопроцентный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                    "sense_definition": "Existing in essence or effect though not in actual fact or physical form.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two substances share a <w>virtual</w> identity in their chemical composition.",
                            "target_lang_translations": {
                                "ru": "Эти два вещества обладают <w>фактическим</w> сходством в своем химическом составе."
                            }
                        },
                        {
                            "text": "The oak tree exists <w>virtually</w> within the small acorn before it ever grows.",
                            "target_lang_translations": {
                                "ru": "Дуб <w>потенциально</w> существует внутри маленького желудя еще до того, как вырастет."
                            }
                        }
                    ],
                    "antonyms": [
                        "actual",
                        "real",
                        "veritable"
                    ],
                    "common_phrases": [
                        "virtual identity",
                        "virtual existence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий по сути или эффекту, хотя и не в виде реального факта или физической формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциальный",
                                "target_lang_sense_clarification": "скрытый, возможный"
                            },
                            {
                                "target_lang_word": "мнимый",
                                "target_lang_sense_clarification": "воображаемый, не материальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2946925a-7b57-3f14-80ec-6e7b7114b2fa",
                    "sense_definition": "Relating to a function or method in programming that can be overridden by a subclass.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to declare the method as <w>virtual</w> if you want to override it later.",
                            "target_lang_translations": {
                                "ru": "Вам нужно объявить метод как <w>виртуальный</w>, если вы хотите переопределить его позже."
                            }
                        },
                        {
                            "text": "The base class defines several <w>virtual</w> functions that the derived classes must implement.",
                            "target_lang_translations": {
                                "ru": "Базовый класс определяет несколько <w>виртуальных</w> функций, которые должны реализовать производные классы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "virtual function",
                        "virtual method"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in object-oriented programming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к функции или методу в программировании, который может быть переопределен подклассом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виртуальный",
                                "target_lang_sense_clarification": "в объектно-ориентированном программировании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e81f13bc-9209-3646-b341-a0b4b1efb604",
                    "sense_definition": "Relating to a point or image where light rays appear to diverge from, but do not actually meet.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A plane mirror always produces a <w>virtual</w> image that appears behind the glass.",
                            "target_lang_translations": {
                                "ru": "Плоское зеркало всегда создает <w>мнимое</w> изображение, которое кажется находящимся за стеклом."
                            }
                        },
                        {
                            "text": "The rays of light seem to emanate from a <w>virtual</w> focus point.",
                            "target_lang_translations": {
                                "ru": "Кажется, что лучи света исходят из точки <w>мнимого</w> фокуса."
                            }
                        }
                    ],
                    "antonyms": [
                        "real"
                    ],
                    "common_phrases": [
                        "virtual image",
                        "virtual focus"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in optics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к точке или изображению, где световые лучи кажутся расходящимися, но на самом деле не пересекаются."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнимый",
                                "target_lang_sense_clarification": "в оптике, о фокусе или изображении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1e44296-624e-3497-8559-022b994bc1c2",
                    "sense_definition": "Relating to particles that exist for a very short time and cannot be directly observed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quantum field theory describes forces as the exchange of <w>virtual</w> particles.",
                            "target_lang_translations": {
                                "ru": "Квантовая теория поля описывает силы как обмен <w>виртуальными</w> частицами."
                            }
                        },
                        {
                            "text": "These <w>virtual</w> fluctuations in the vacuum are allowed by the uncertainty principle.",
                            "target_lang_translations": {
                                "ru": "Эти <w>виртуальные</w> флуктуации в вакууме допускаются принципом неопределенности."
                            }
                        }
                    ],
                    "antonyms": [
                        "real"
                    ],
                    "common_phrases": [
                        "virtual particle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к частицам, которые существуют очень короткое время и не могут быть непосредственно зафиксированы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виртуальный",
                                "target_lang_sense_clarification": "в квантовой физике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5de6f4ac-6b8d-3492-993c-0c508755e05b",
                    "sense_definition": "A form of <w>virtuous</w>; having or showing high moral standards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the knight's <w>virtual</w> character as an example for all to follow.",
                            "target_lang_translations": {
                                "ru": "Поэт описал <w>добродетельный</w> характер рыцаря как пример для подражания."
                            }
                        },
                        {
                            "text": "She led a <w>virtual</w> life dedicated to helping the poor and the sick.",
                            "target_lang_translations": {
                                "ru": "Она вела <w>добродетельную</w> жизнь, посвященную помощи бедным и больным."
                            }
                        }
                    ],
                    "synonyms": [
                        "virtuous"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма слова virtuous; обладающий высокими моральными стандартами или проявляющий их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добродетельный",
                                "target_lang_sense_clarification": "высоконравственный (архаизм)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6eaaec6-ff23-3487-941a-edb32835cbf7",
                    "sense_definition": "A computer-simulated environment or a digital representation of something real.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gambler placed a bet on the <w>virtuals</w> at the local betting shop.",
                            "target_lang_translations": {
                                "ru": "Игрок сделал ставку на <w>виртуальные соревнования</w> в местной букмекерской конторе."
                            }
                        },
                        {
                            "text": "We are moving away from the physical world and deeper into the <w>virtual</w>.",
                            "target_lang_translations": {
                                "ru": "Мы уходим из физического мира всё глубже в <w>виртуальный</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерная симуляция среды или цифровое представление чего-то реального."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виртуальный мир",
                                "target_lang_sense_clarification": "цифровое пространство"
                            },
                            {
                                "target_lang_word": "виртуальное событие",
                                "target_lang_sense_clarification": "симулированное соревнование"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}