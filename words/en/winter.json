{
    "word_family": [
        "wintery",
        "wintry",
        "winterize",
        "wintertime",
        "wintertide",
        "midwinter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                    "sense_definition": "The coldest season of the year, occurring between autumn and spring.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "seasons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to play in the snow during the <w>winter</w> months.",
                            "target_lang_translations": {
                                "ru": "Дети обожают играть в снегу в <w>зимние</w> месяцы."
                            }
                        },
                        {
                            "text": "Many birds fly south to escape the <w>cold</w> <w>winter</w> and find food.",
                            "target_lang_translations": {
                                "ru": "Многие птицы улетают на юг, чтобы спастись от холодной <w>зимы</w> и найти пропитание."
                            }
                        }
                    ],
                    "synonyms": [
                        "wintertide",
                        "wintertime"
                    ],
                    "antonyms": [
                        "summer"
                    ],
                    "common_phrases": [
                        "cold winter",
                        "winter break",
                        "winter coat",
                        "middle of winter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самое холодное время года, наступающее между осенью и весной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зима",
                                "target_lang_sense_clarification": "время года"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42045cae-47b9-3f6a-b126-e25b85c57602",
                    "sense_definition": "The rainy season in certain tropical regions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seasons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this part of India, the <w>winter</w> brings heavy monsoon rains instead of snow.",
                            "target_lang_translations": {
                                "ru": "В этой части Индии <w>зима</w> приносит сильные муссонные дожди вместо снега."
                            }
                        },
                        {
                            "text": "The local farmers prepare their fields before the <w>winter</w> rains begin in May.",
                            "target_lang_translations": {
                                "ru": "Местные фермеры подготавливают свои поля до того, как в мае начнутся <w>зимние</w> дожди."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rainy winter"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in specific tropical contexts like India"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сезон дождей в определенных тропических регионах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зима",
                                "target_lang_sense_clarification": "сезон дождей в тропиках"
                            },
                            {
                                "target_lang_word": "период дождей",
                                "target_lang_sense_clarification": "климатический период"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc72b6a9-03a6-3bd7-9f82-268c4a1d6b25",
                    "sense_definition": "A period of decline, decay, or the final stages of life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_stages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old poet felt he had finally reached the <w>winter</w> of his life.",
                            "target_lang_translations": {
                                "ru": "Старый поэт чувствовал, что наконец достиг <w>зимы</w> своей жизни."
                            }
                        },
                        {
                            "text": "The company struggled to survive the economic <w>winter</w> that followed the market crash.",
                            "target_lang_translations": {
                                "ru": "Компания изо всех сил пыталась пережить экономическую <w>зиму</w>, последовавшую за крахом рынка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "winter of life",
                        "crypto winter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период упадка, заката или заключительный этап жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зима",
                                "target_lang_sense_clarification": "метафорически о закате жизни или упадке"
                            },
                            {
                                "target_lang_word": "закат",
                                "target_lang_sense_clarification": "финальный этап"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7751acb3-e410-3057-b6e4-7345d45fc2bd",
                    "sense_definition": "To spend the winter season in a specific place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "seasonal_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many retired couples choose to <w>winter</w> in Florida to avoid the snow.",
                            "target_lang_translations": {
                                "ru": "Многие пары пенсионеров предпочитают <w>зимовать</w> во Флориде, чтобы избежать снега."
                            }
                        },
                        {
                            "text": "The sheep usually <w>winter</w> in the valley where the weather is milder.",
                            "target_lang_translations": {
                                "ru": "Овцы обычно <w>зимуют</w> в долине, где погода мягче."
                            }
                        }
                    ],
                    "common_phrases": [
                        "winter in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить зимний сезон в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зимовать",
                                "target_lang_sense_clarification": "проводить зиму где-либо"
                            },
                            {
                                "target_lang_word": "проводить зиму",
                                "target_lang_sense_clarification": "находиться где-то в зимний период"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3d617fd-336a-39b1-8e63-2d0bd4faa40a",
                    "sense_definition": "To keep, feed, or manage something (like livestock) through the winter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seasonal_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer had to buy extra hay to <w>winter</w> the cattle properly.",
                            "target_lang_translations": {
                                "ru": "Фермеру пришлось закупить дополнительное сено, чтобы должным образом <w>прокормить</w> скот зимой."
                            }
                        },
                        {
                            "text": "It is expensive to <w>winter</w> horses when the grazing land is covered in ice.",
                            "target_lang_translations": {
                                "ru": "Дорого <w>содержать</w> лошадей зимой, когда пастбища покрыты льдом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "winter the livestock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержать, кормить или обеспечивать уход за кем-либо (например, скотом) в течение зимы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержать зимой",
                                "target_lang_sense_clarification": "обеспечивать уход в зимний период"
                            },
                            {
                                "target_lang_word": "прокармливать зимой",
                                "target_lang_sense_clarification": "обеспечивать кормом в течение зимы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d2e3fb2-b58f-3afa-8465-e97fc48a5a33",
                    "sense_definition": "Relating to, characteristic of, or occurring in winter.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "seasonal_attributes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trees were covered in a beautiful <w>winter</w> frost this morning.",
                            "target_lang_translations": {
                                "ru": "Этим утром деревья были покрыты прекрасным <w>зимним</w> инеем."
                            }
                        },
                        {
                            "text": "We need to buy new <w>winter</w> clothes before the temperature drops further.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новую <w>зимнюю</w> одежду, прежде чем температура упадет еще ниже."
                            }
                        }
                    ],
                    "synonyms": [
                        "wintertide",
                        "wintertime"
                    ],
                    "antonyms": [
                        "summer"
                    ],
                    "common_phrases": [
                        "winter clothes",
                        "winter weather",
                        "winter sports",
                        "winter solstice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к зиме, характерный для нее или происходящий в это время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зимний",
                                "target_lang_sense_clarification": "относящийся к зиме"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a6fb6ef6-5f7e-35dc-a827-6da235c4e885",
                    "sense_definition": "A surname of Germanic origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Winter</w> has been working at the local library for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уинтер</w> работает в местной библиотеке уже двадцать лет."
                            }
                        },
                        {
                            "text": "The <w>Winter</w> family moved to this neighborhood last summer.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Уинтер</w> переехала в этот район прошлым летом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Germanic origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия германского происхождения."
                    },
                    "translations": {
