                ],
                "senses": [
                    {
                        "sense_id": "7325a85d-17df-3fe2-98c8-8513656067ad",
                        "entry_id": "1a0c9203-e6b0-3679-84ff-eb8ff0ee7157",
                        "glosses": [
                            "Tag zu Ehren der Mutter und der Mutterschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed1e0f6-9e90-4b37-8ca6-8922ff2674b5",
                                "sense_id": "7325a85d-17df-3fe2-98c8-8513656067ad",
                                "text": "Am Muttertag ist es üblich, dass Kinder ihren Müttern Geschenke machen oder Gefallen tun."
                            },
                            {
                                "example_id": "e245c273-65e2-4826-ab70-81e4fb519632",
                                "sense_id": "7325a85d-17df-3fe2-98c8-8513656067ad",
                                "text": "In Deutschland findet der Muttertag am zweiten Sonntag im Mai statt."
                            },
                            {
                                "example_id": "1dad7eca-1c98-4cf1-99f2-1c3ac7a52123",
                                "sense_id": "7325a85d-17df-3fe2-98c8-8513656067ad",
                                "text": "„Zum Muttertag malte ich für Mama ein Bild mit Kuchen, Kaffeekanne und Kaffeetasse.“"
                            },
                            {
                                "example_id": "0c82406e-b724-42c9-9e57-5ba9881cc73b",
                                "sense_id": "7325a85d-17df-3fe2-98c8-8513656067ad",
                                "text": "Die Idee zum Muttertag hatte die US-Amerikanerin Anna Jarvis: Sie bewunderte ihre Mutter sehr, weil sie sich stets für andere Menschen einsetzte. […] In Deutschland gibt es den Muttertag seit 1923."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "263c0f32-598d-4933-9c3b-7e58d91cd270",
                        "source_entry_id": "1a0c9203-e6b0-3679-84ff-eb8ff0ee7157",
