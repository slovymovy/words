    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "6c7fc703-d87e-36a4-83eb-432a3db7877e",
                    "sense_definition": "Sert à exprimer l'indifférence, le manque d'enthousiasme ou la résignation face à une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enthousiasme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as envie de sortir ce soir ? — <w>Bof</w>, je préfère rester tranquillement chez moi."
                        },
                        {
                            "text": "La réunion s'est bien passée, mais pour le reste de la journée, <w>bof</w>."
                        }
                    ],
                    "synonyms": [
                        "mouais"
                    ],
                    "common_phrases": [
                        "ouais bof"
                    ],
                    "traits": [
                        {
