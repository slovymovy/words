                ],
                "senses": [
                    {
                        "sense_id": "0b93c60d-769a-3f28-ad60-22ee13d8c04e",
                        "entry_id": "38eaa29e-5034-339a-9a18-bb45cd73ec39",
                        "glosses": [
                            "Professor für Physik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0890545a-fc37-422e-b0fa-1987a7b40b43",
                                "sense_id": "0b93c60d-769a-3f28-ad60-22ee13d8c04e",
                                "text": "„Neil Gershenfeld, Physikprofessor am MIT in Boston, beobachtete damals, wie wenig ausgelastet die Hightech-Geräte des Instituts waren. Er beschloss daher, seinen Studierenden uneingeschränkten Zugang zu den vorhandenen Maschinen zu ermöglichen.“"
                            },
                            {
                                "example_id": "eb342d19-043c-4222-98cc-7ad0ae798002",
                                "sense_id": "0b93c60d-769a-3f28-ad60-22ee13d8c04e",
                                "text": "„Vor allem habe er natürlich gehofft, dass alles gutgehe, so erinnert sich der emeritierte Physikprofessor an der Universität Bern und Gründer des International Space Science Institute (ISSI) an jenen Moment.“"
                            },
                            {
                                "example_id": "f5e64d9c-bc79-4435-b1f1-ad089cef0d37",
                                "sense_id": "0b93c60d-769a-3f28-ad60-22ee13d8c04e",
                                "text": "„Der Grundgedanke stammt vom MIT in Boston, wo der Physikprofessor Neil Gershenfeld schon im Jahr 2002 ein Fab Lab einrichtete, eine offene Werkstatt, die für alle Studenten zugänglich sein sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
