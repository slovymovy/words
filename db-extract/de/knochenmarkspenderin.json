                                "example_id": "df86d7dc-5d8c-4cc0-ae6b-88f75a1c65b0",
                                "sense_id": "a44bba93-b4b3-3a04-ac44-7b7614251a8e",
                                "text": "Die Knochenmarkspenderin wird für die Operation vorbereitet."
                            },
