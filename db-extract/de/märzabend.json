                "senses": [
                    {
                        "sense_id": "c33bcbd0-3d76-3925-9457-607c4d36c388",
                        "entry_id": "a256b9d9-e3b3-32d0-9ee2-0cee2ff00648",
                        "glosses": [
                            "Abend im März"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e555b7-abac-4679-83eb-3d5186a7d353",
                                "sense_id": "c33bcbd0-3d76-3925-9457-607c4d36c388",
                                "text": "Evelin kam an einem Märzabend."
                            },
                            {
                                "example_id": "83e5e607-b76d-429d-a9e3-ea36bbf83e73",
                                "sense_id": "c33bcbd0-3d76-3925-9457-607c4d36c388",
                                "text": "„Es war kühl draußen, Märzabend, ich schlug den Rockkragen hoch, setzte den Hut auf, tastete nach meiner letzten Zigarette in der Tasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
