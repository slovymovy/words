                "senses": [
                    {
                        "sense_id": "a9514567-3953-35ad-b697-f1d7455de681",
                        "entry_id": "2f8864c5-1e4c-3998-aeaa-f57799567896",
                        "glosses": [
                            "hohe, senkrechte, pfeilerähnliche Konstruktion, deren Eckpfosten durch Querstreben gitterartig miteinander verbunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851f1b07-cc24-491a-b0fe-d55a6dcbfcb6",
                                "sense_id": "a9514567-3953-35ad-b697-f1d7455de681",
                                "text": "„In die Fundamente wird der ‚Mastfuß‘ einbetoniert, der neue Gittermast wird dann vor Ort zusammengebaut und auf den Mastfuß ‚aufgestockt‘, wie die Leitungsmonteure sagen.“"
                            },
                            {
                                "example_id": "e11010ab-bfc1-4cca-ac39-47a25865bdcf",
                                "sense_id": "a9514567-3953-35ad-b697-f1d7455de681",
                                "text": "„Der klassische Gittermast mit den ausgestellten Füßen und den markanten Auslegern dagegen hat den Praxistest längst bestanden.“"
                            },
                            {
                                "example_id": "8565ed73-106a-461f-ba84-744672a8972f",
                                "sense_id": "a9514567-3953-35ad-b697-f1d7455de681",
                                "text": "„Ein rot-weiß angestrichener Gittermast steht da mitten im Nichts, rund 30 Meter hoch, gehalten von dünnen Stahlseilen.“"
                            },
                            {
                                "example_id": "ecab344d-8871-47ca-b4c2-9f81690d1063",
                                "sense_id": "a9514567-3953-35ad-b697-f1d7455de681",
                                "text": "„Ein Pantograph senkt sich von einem Gittermast auf das Dach des Fahrzeugs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
