                                "sense_id": "5ef8ce45-cb41-3dd9-b9ce-84522a6a1365",
                                "text": "Toen hij als vanzelfsprekend haar koffer uit het bagagenet tilde, lachte ze en zei iets plagends over bourgeois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c09e3010-735f-4f4b-b802-7e4a0fb20ad0",
