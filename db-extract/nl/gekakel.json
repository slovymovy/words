        "nl-extract.jsonl": [
            {
                "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                "word": "gekakel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "656a9722-fede-36d8-ada4-491cb447abb9",
                        "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                        "glosses": [
                            "aanhoudend kakelen door kippen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a56ef08-a96a-4f52-8839-6ef04d8a4662",
                                "sense_id": "656a9722-fede-36d8-ada4-491cb447abb9",
                                "text": "Alles van de kip, in een kippenhok vol gekakel"
                            }
                        ]
                    },
                    {
                        "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                        "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                        "glosses": [
                            "aanhoudend babbelen door mensen / zinloos geklets"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5e43d2fc-22b3-4283-ae0a-d0692b63f823",
                                "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                "text": "Als ik onzeker word van dat gekakel, dan zeg ik dan naderhand tegen productie, dan spreken zij de anderen erop aan.’’"
                            },
                            {
                                "example_id": "d92c6716-b86b-40ef-816f-6be5b574bcb7",
                                "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                "text": "Wat blijven we als samenleving toch moeite houden met het overbruggen van verschillen tussen mensen; keer op keer schiet deze gedachte door mijn hoofd als ik de laatste populistische klaagzang over de 'mislukte integratie'met weerzin tot me neem. Leiders zouden juist het niveau van het oppervlakkige gekakel over de negatieve aspecten van culturele diversiteit moeten overstijgen. En dan vooral politieke leiders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42e5be0d-1299-446c-aa1f-9fec5f946a91",
                        "source_entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                        "source_sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                        "source_sense_description": "gebabbel",
                        "target_lang_word": "cackle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cackle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d460ddb0-d176-34de-8736-579dc6f47962",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "The cry of a hen or goose, especially when laying an egg."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a3d80b-b9c6-47ec-945c-645165cf461d",
                                                "sense_id": "d460ddb0-d176-34de-8736-579dc6f47962",
                                                "text": "I heard a grey hen cackling among the ling; I called and thought, \"If I could get a sight of you now, it would be your last cackle;\" just then I heard something moving behind me on the path."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60127db4-e837-32a0-b20b-56c029636201",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "A laugh resembling the cry of a hen or goose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "231e01ee-ba6f-36ae-b65b-b0752bdd3cad",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "Futile or excessively noisy talk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae366cb-eca0-4068-b551-c57179635c8c",
                                                "sense_id": "231e01ee-ba6f-36ae-b65b-b0752bdd3cad",
                                                "text": "There's no time to waste on silly cackle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faccbb09-55d5-351a-8076-26466fffc2da",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "A group of hyenas."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cackle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1d8ee1-c33e-3090-bb8f-f397fa12f15d",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To make a sharp, broken noise or cry, as a hen or goose does."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af05597-1b58-412c-81e2-cdce2ad5895d",
                                                "sense_id": "dc1d8ee1-c33e-3090-bb8f-f397fa12f15d",
                                                "text": "When every goose is cackling."
                                            },
                                            {
                                                "example_id": "2ed0100f-8c84-43f3-b03d-d7aa8ec7d606",
                                                "sense_id": "dc1d8ee1-c33e-3090-bb8f-f397fa12f15d",
                                                "text": "I heard a grey hen cackling among the ling; I called and thought, \"If I could get a sight of you now, it would be your last cackle;\" just then I heard something moving behind me on the path."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34274cf1-0505-3505-91a1-01de488d8c3a",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To laugh with a broken sound similar to a hen's cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b71f192-91d6-4dbc-ae2e-5ef05420958e",
                                                "sense_id": "34274cf1-0505-3505-91a1-01de488d8c3a",
                                                "text": "The witch cackled evilly."
                                            },
                                            {
                                                "example_id": "7bab737d-56a4-42d7-863a-bb779a2ed955",
                                                "sense_id": "34274cf1-0505-3505-91a1-01de488d8c3a",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd3b366-062d-393b-810f-d421fe8a598a",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To talk in a silly manner; to prattle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45abaa56-c214-4758-9383-76558982e38d",
                                                "sense_id": "8bd3b366-062d-393b-810f-d421fe8a598a",
                                                "text": "It is also the business of a sensible government, not to cackle on its discoveries"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae7db354-b401-32c2-a635-43df0ceb200a",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To pretend to rattle (dice) in one's hand while gripping them so that they maintain their orientation."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9422af8-3327-4226-b60d-eec6559a2316",
                                                "sense_id": "ae7db354-b401-32c2-a635-43df0ceb200a",
                                                "text": "Danny cackled the dice furiously in his cupped hand, then rolled them so they stopped inches from Slattery's hands. The result was the same as before – a seven."
                                            },
                                            {
                                                "example_id": "1eca3503-5549-4eb1-ab39-d1b4d5d28b48",
                                                "sense_id": "ae7db354-b401-32c2-a635-43df0ceb200a",
                                                "text": "[…] they spun all right, or so it seemed, and hit the wall all right, or so it seemed, but bottom line was this: The stirring of the dice was merely cackling, the cubes artfully framed so that the spots in the kid's fists showed 4‐4 up‐right and weren't really rattled but rather, held in control by the pinky, forefinger and thumb; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "238717a4-0918-4057-8215-3b661f354bd9",
                        "source_entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                        "source_sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                        "source_sense_description": "gebabbel",
                        "target_lang_word": "gab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd53dd0-c8c4-3236-959b-b2202ab3c90b",
                                        "entry_id": "a27591e8-3279-389d-b6fe-b3606e2dd807",
                                        "glosses": [
                                            "Idle chatter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf0c7cc9-eb6f-4504-8c92-ae8865c87735",
                                                "sense_id": "fdd53dd0-c8c4-3236-959b-b2202ab3c90b",
                                                "text": "Ah, find some chirk in ye, lad. Now is the time for gab and chatter. Y’best be enjoying it. Come a fortnight and the brace of us’ll be wantin’ to be ever silent as the tomb. Even to clap eyes on each other... It’ll make y’hotter than hell!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7634cd-ef62-3193-895e-aea886f6f29f",
                                        "entry_id": "a27591e8-3279-389d-b6fe-b3606e2dd807",
                                        "glosses": [
                                            "The mouth or gob."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7452a590-c149-39c1-9971-1a04ef7acb49",
                                        "entry_id": "a27591e8-3279-389d-b6fe-b3606e2dd807",
                                        "glosses": [
                                            "One of the open-forked ends of rods controlling reversing in early steam engines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a916d63-90b8-4ec3-941c-34e7f5a5019a",
                                                "sense_id": "7452a590-c149-39c1-9971-1a04ef7acb49",
                                                "text": "Loose eccentric reversing gear gave way about 1836 to the early forms of gab motion. [...] In 1840 Stephenson evolved a motion in which the gabs were connected directly to the valve spindle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c33fdd53-267e-3e8e-a500-4d85af8d0190",
                                        "entry_id": "0cbff556-cff6-3b5e-8932-6775a3745c9b",
                                        "glosses": [
                                            "To jest; to tell lies in jest; exaggerate; lie."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a893982-b297-4528-85f3-aec2efa08bb4",
                                                "sense_id": "c33fdd53-267e-3e8e-a500-4d85af8d0190",
                                                "text": "He would chant his own doughty deeds, and “gab,” as the Norman word was, in painful earnest, while they gabbed only in sport, and outvied each other in impossible fanfaronades”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3dca70b-7c22-3a8f-a1ed-b8cf6975ffb5",
                                        "entry_id": "0cbff556-cff6-3b5e-8932-6775a3745c9b",
                                        "glosses": [
                                            "To talk or chatter a lot, usually on trivial subjects."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe17fb10-3acf-441d-832c-c72da322db57",
                                                "sense_id": "a3dca70b-7c22-3a8f-a1ed-b8cf6975ffb5",
                                                "text": "\"That Mrs. Mender gives a bloke the ear-ache; thinks a bloke's got all day to waste listening to her gab.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ae8f146-119b-3a17-931e-7cd53b34b460",
                                        "entry_id": "0cbff556-cff6-3b5e-8932-6775a3745c9b",
                                        "glosses": [
                                            "To speak or tell falsely."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
