                        "entry_id": "9a720e99-aa6e-34af-abdf-cd8aea0ba017",
                        "glosses": [
                            "feuerfeste Masse, in die zahntechnische Werkstücke, wie Kronen, Brücken oder Modellguss, die aus Wachs oder Kunststoff modelliert worden sind, zum Gießen eingebettet werden"
                        ],
                        "tags": [
                            "Zahntechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d8d718-a009-4c87-9645-066ca790b2c9",
                                "sense_id": "e4387ea0-be90-3b57-be24-6932dc67df8b",
                                "text": "Durch eine Expansion der Einbettmasse wird der Hohlraum vor dem Gießen genau um den Faktor vergrößert, um den das Metall beim Erkalten schrumpft."
                            },
                            {
                                "example_id": "9175d2be-4b0f-40fc-913a-1298092e8a32",
                                "sense_id": "e4387ea0-be90-3b57-be24-6932dc67df8b",
                                "text": "Die Einbettmasse ist der zentrale Werkstoff für den wichtigsten Herstellungsprozess im zahntechnischen Labor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
