                    ],
                    "common_phrases": [
                        "forcer le type"
                    ]
                },
                {
                    "sense_id": "f7ee07bb-03a6-3caf-88d6-8ad749977334",
                    "sense_definition": "Poursuivre un gibier avec une meute de chiens jusqu'à son épuisement complet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une course de plusieurs heures, les chiens ont fini par <w>forcer</w> le cerf."
                        },
                        {
                            "text": "Le maître d'équipage a suivi la meute qui s'apprêtait à <w>forcer</w> le sanglier."
                        }
                    ],
                    "common_phrases": [
                        "cerf forcé",
                        "forcer le gibier"
                    ]
                },
                {
                    "sense_id": "e08e90ba-d4fc-336c-9f42-95878684cf32",
                    "sense_definition": "Aux jeux de cartes, surenchérir pour inciter ou contraindre les autres joueurs à déclarer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a décidé de <w>forcer</w> pour tester les limites de ses adversaires."
