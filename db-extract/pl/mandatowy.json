                                "example_id": "7d647f65-6f6b-493d-9a6a-9562fc9af176",
                                "sense_id": "57b3f48e-9c3b-3520-b728-4a7109e5ad2c",
                                "text": "Po II wojnie światowej terytoria mandatowe przekształcono w terytoria powiernicze ONZ"
