                        "glosses": [
                            "Of, pertaining to, or exhibiting henotheism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128ad546-20a7-4943-ad9f-e205265e1ba0",
                                "sense_id": "edb44d55-6b5a-3881-b932-157bd4e7ae88",
                                "text": "Both of the men in this study (Stewart, 2002) reflected more henotheistic identity commitments and understandings of spirituality."
                            },
                            {
                                "example_id": "230bad52-5749-48ad-b624-291d459305c0",
                                "sense_id": "edb44d55-6b5a-3881-b932-157bd4e7ae88",
                                "text": "After the exile, God's kingship changed from more henotheistic expressions to monotheistic ones. Nevertheless, there always remained a tension in ancient Judaism between the \"God of all\" and the \"God of Israel.\""
                            },
                            {
                                "example_id": "f21355fc-e83e-4a05-accb-e12cd0357421",
                                "sense_id": "edb44d55-6b5a-3881-b932-157bd4e7ae88",
                                "text": "The coins referring to the Roman gods and, if we may believe the author of the Historia Augusta, the collection of Roman cult objects in the Heliogabalium favor a more henotheistic approach by the priest-emperor."
                            }
                        ]
                    }
