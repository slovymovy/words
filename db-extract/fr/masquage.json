                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bdcce06-fce1-3770-8264-7b8b00450a92",
                                        "entry_id": "f70b3a85-5a5a-3d9e-84e0-8fb7b8af5470",
                                        "glosses": [
                                            "The act by which something is masked; the act of masking, of concealing or disguising."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a22b5da-cfdb-454d-91fd-69b084724822",
                                                "sense_id": "3bdcce06-fce1-3770-8264-7b8b00450a92",
                                                "text": "“To function effectively in any social situation,” writes Booth, “we all engage in masking of one kind or another: we do some prettying up: we adorn, […]\""
                                            },
                                            {
                                                "example_id": "68c844e6-f359-4597-b762-59077cb66bed",
                                                "sense_id": "3bdcce06-fce1-3770-8264-7b8b00450a92",
                                                "text": "African Americans, particularly those who have to work and live in predominantly white spaces, also engage in masking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b13d1176-8652-3843-a450-f6dac7108f87",
                                        "entry_id": "f70b3a85-5a5a-3d9e-84e0-8fb7b8af5470",
                                        "glosses": [
                                            "An entertainment at which the guests conceal their faces with masks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cf26884-523b-422d-b307-e2e310e78fb0",
                                                "sense_id": "b13d1176-8652-3843-a450-f6dac7108f87",
                                                "text": "The vassals or tenants collected in the hall for Christmas masking and mumming—the peasant gathering that May-day called out upon the green, drew together ranks whose distance, in our day, occasions forgetfulness on one side, and discontent on the other."
                                            },
                                            {
                                                "example_id": "26896ed2-cb30-4819-8d4c-cf7d7038ac16",
                                                "sense_id": "b13d1176-8652-3843-a450-f6dac7108f87",
                                                "text": "Such things, maskings, and disguisings, and dressing up, sometimes in incredible and wild fashions, are all part of the fun of carnival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "988eba21-77bb-39b2-8ec6-79911124e676",
                                        "entry_id": "f70b3a85-5a5a-3d9e-84e0-8fb7b8af5470",
                                        "glosses": [
                                            "The practice of wearing safety masks, such as face masks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdceaccd-94b6-4870-895a-98016222af6e",
                                                "sense_id": "988eba21-77bb-39b2-8ec6-79911124e676",
                                                "text": "For millions of American lives touched by the coronavirus, it was too late to correct the failure to stand up protocols for masking and social distancing, testing and contact-tracing. But negative consequences of the culture war around the pandemic could still lie ahead, damaging the national vaccination effort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
