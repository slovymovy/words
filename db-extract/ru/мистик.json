                                        "sense_id": "dbbe637b-e359-3257-8046-5000570cf9bb",
                                        "entry_id": "27c39e8d-7738-3998-ab86-6b1c9bccbfcc",
                                        "glosses": [
                                            "Anhänger oder Vertreter einer mystischen Religionslehre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "429fdf7f-0882-4e4e-8b68-41a0e4c0f25e",
                                                "sense_id": "dbbe637b-e359-3257-8046-5000570cf9bb",
                                                "text": "„Erst wenn der Mystiker eine religiöse oder philosophische Deutung seines mystischen Erlebnisses versucht, macht sich der kulturelle Hintergrund bemerkbar.“"
                                            },
                                            {
                                                "example_id": "efe1dc6e-4a20-4d9b-8d2f-8f15264b1cfe",
                                                "sense_id": "dbbe637b-e359-3257-8046-5000570cf9bb",
                                                "text": "„Anders die Anachoreten und Mystiker, die sich traditionell an einsame Orte zurückzuziehen pflegten und für die dem Berggang weiterhin die Bedeutung einer religiös motivierten Entrückung und Vereinzelung zukommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
