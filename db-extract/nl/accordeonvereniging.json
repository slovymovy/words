                            {
                                "example_id": "cae955b3-25a5-447a-b7d6-a192935d11a2",
                                "sense_id": "f89820e5-2b7b-3371-a7dd-2c3a237493a8",
                                "text": "Wethouder Harry Scholten heeft bemiddeld in het confict tussen De Reggehof en vier gebruikers van dit theater in Goor: zang en oratoriumvereniging Onze Stem, accordeonvereniging Kunst na Arbeid, muziekvereniging Apollo Goor en het Goors Mannenkoor. Zijn bemoeienis heeft er toe geleid dat beide partijen weer om tafel zitten."
                            },
                            {
                                "example_id": "9ddbf64e-b85a-43e9-9f1b-d1a1b0f43d41",
                                "sense_id": "f89820e5-2b7b-3371-a7dd-2c3a237493a8",
                                "text": "Deze conclusie trekt CDA-gemeenteraadslid Riekele Bijleveld uit de brief van Zang en Oratoriumvereniging Onze Stem, het Goors Mannenkoor, Accordeonvereniging Kunst na Arbeid en Muziekvereniging Apollo Goor aan de gemeenteraad over de voorgenomen fusie."
                            }
