                "senses": [
                    {
                        "sense_id": "3db003c2-87bd-3cd4-b114-13d2d02688b4",
                        "entry_id": "a5cc07f9-8e2d-33e7-9c31-353b204e806d",
                        "glosses": [
                            "Bouleau."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c8d7b175-8c97-4616-903e-3145828b76b2",
                                "sense_id": "3db003c2-87bd-3cd4-b114-13d2d02688b4",
                                "text": "Voici les principaux : […], le Bou ou le Bu (Bouleau), en vieux français, Boul : […]. A Paris, on dit Bouillard ; en Basse-Normandie, on dit encore Boulard : un balai de Boulard."
                            },
                            {
                                "example_id": "4e719333-1e8a-4714-811d-f865444746c9",
                                "sense_id": "3db003c2-87bd-3cd4-b114-13d2d02688b4",
                                "text": "Betula, bouleau, a été rendu en vieux français par boula, bole, et boult, bout. L'augmentatif boulard et le diminutif bouleau ont supplanté boule dans le français moderne."
                            }
                        ]
                    }
