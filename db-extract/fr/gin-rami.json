                                "example_id": "f0c5d4cd-ce7a-47c4-8ba9-9708d4dedc01",
                                "sense_id": "1105a1aa-ade9-31dd-ab96-72159956d647",
                                "text": "Lui faisait des mots-croisés, se plongeait dans des revues d’astronomie et d’histoire, tandis qu’elle préférait jouer au gin-rami avec un groupe d’amies de son âge, ou tricoter devant la télé."
                            },
                            {
                                "example_id": "9d7954e4-26b1-4972-bd09-ded9f368f1e5",
                                "sense_id": "1105a1aa-ade9-31dd-ab96-72159956d647",
                                "text": "Nous apprenons aux officiers australiens à jouer au gin-rami."
                            },
                            {
                                "example_id": "724ed0e8-590a-49a8-b4c7-dc3263f3e502",
                                "sense_id": "1105a1aa-ade9-31dd-ab96-72159956d647",
                                "text": "Je préfère le gin-rami."
                            }
                        ]
                    }
