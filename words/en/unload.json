{
    "word_family": [
        "unloader",
        "unloading",
        "load",
        "loader"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42a44ce1-f204-3d73-b390-7802aebc8e3d",
                    "sense_definition": "To remove cargo or contents from a vehicle, container, or beast of burden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cargo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers helped <w>unload</w> the truck after it arrived at the warehouse.",
                            "target_lang_translations": {
                                "pl": "Pracownicy pomogli <w>rozładować</w> ciężarówkę po jej dotarciu do magazynu.",
                                "ru": "Рабочие помогли <w>разгрузить</w> грузовик после того, как он прибыл на склад."
                            }
                        },
                        {
                            "text": "It took several hours to completely <w>unload</w> the cargo ship at the dock.",
                            "target_lang_translations": {
                                "pl": "Całkowite <w>rozładowanie</w> statku towarowego w doku zajęło kilka godzin.",
                                "ru": "Потребовалось несколько часов, чтобы полностью <w>разгрузить</w> сухогруз в доке."
                            }
                        }
                    ],
                    "synonyms": [
                        "offload"
                    ],
                    "antonyms": [
                        "load up"
                    ],
                    "common_phrases": [
                        "unload a truck",
                        "unload a ship",
                        "unload cargo"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozładowywać lub opróżniać pojazd, kontener lub zwierzę juczne z ładunku.",
                        "ru": "Снимать или выгружать груз с транспортного средства, контейнера или вьючного животного."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozładowywać",
                                "target_lang_sense_clarification": "pojazd, statek itp."
                            },
                            {
                                "target_lang_word": "rozładować",
                                "target_lang_sense_clarification": "dokonany: pojazd, statek"
                            },
                            {
                                "target_lang_word": "wyładowywać",
                                "target_lang_sense_clarification": "usuwać ładunek"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разгружать",
                                "target_lang_sense_clarification": "транспорт или контейнер (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "разгрузить",
                                "target_lang_sense_clarification": "транспорт или контейнер (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0dc342f-aa7c-3279-80ec-4ba2dc0a50be",
                    "sense_definition": "To take goods, packages, or materials out of a vehicle or container.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cargo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please help me <w>unload</w> the groceries from the back of the car.",
                            "target_lang_translations": {
                                "pl": "Pomóż mi, proszę, <w>wypakować</w> zakupy z bagażnika samochodu.",
                                "ru": "Пожалуйста, помоги мне <w>выгрузить</w> продукты из багажника машины."
                            }
                        },
                        {
                            "text": "They spent the morning <w>unloading</w> heavy boxes onto the loading dock.",
                            "target_lang_translations": {
                                "pl": "Spędzili poranek na <w>wyładowywaniu</w> ciężkich pudeł na rampę załadunkową.",
                                "ru": "Они провели всё утро, <w>сгружая</w> тяжёлые коробки на погрузочную платформу."
                            }
                        }
                    ],
                    "synonyms": [
                        "offload"
                    ],
                    "common_phrases": [
                        "unload the groceries",
                        "unload boxes"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyjmować towary, paczki lub materiały z pojazdu albo kontenera.",
                        "ru": "Вынимать товары, пакеты или вещи из транспортного средства либо контейнера."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyładowywać",
                                "target_lang_sense_clarification": "towary, zakupy, pudła"
                            },
                            {
                                "target_lang_word": "rozładowywać",
                                "target_lang_sense_clarification": "wyjmować ładunek"
                            },
                            {
                                "target_lang_word": "wypakowywać",
                                "target_lang_sense_clarification": "np. bagaże, zakupy z auta"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выгружать",
                                "target_lang_sense_clarification": "товары, вещи из транспорта (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "выгрузить",
                                "target_lang_sense_clarification": "товары, вещи из транспорта (совершенный вид)"
                            },
                            {
                                "target_lang_word": "сгружать",
                                "target_lang_sense_clarification": "снимать груз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "137c358d-b7b7-32ff-b040-f6555169321e",
                    "sense_definition": "To remove ammunition or cartridges from a firearm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weapons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always remember to <w>unload</w> your gun before cleaning it.",
                            "target_lang_translations": {
                                "pl": "Zawsze pamiętaj, aby <w>rozładować</w> broń przed jej czyszczeniem.",
                                "ru": "Всегда помните о том, что нужно <w>разрядить</w> оружие перед его чисткой."
                            }
                        },
                        {
                            "text": "The police officer carefully <w>unloaded</w> the pistol and placed it into evidence.",
                            "target_lang_translations": {
                                "pl": "Policjant ostrożnie <w>rozładował</w> pistolet i zabezpieczył go jako dowód.",
                                "ru": "Полицейский осторожно <w>разрядил</w> пистолет и приобщил его к уликам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unload a gun",
                        "unload a weapon"
                    ],
                    "target_lang_definitions": {
                        "pl": "Usuwać amunicję lub naboje z broni palnej.",
                        "ru": "Извлекать патроны или боеприпасы из огнестрельного оружия."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozładowywać",
                                "target_lang_sense_clarification": "broń palną"
                            },
                            {
                                "target_lang_word": "rozładować",
                                "target_lang_sense_clarification": "dokonany: broń palną"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разряжать",
                                "target_lang_sense_clarification": "оружие (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "разрядить",
                                "target_lang_sense_clarification": "оружие (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9787631-e59e-328c-95a6-9bd8f5f23fd2",
                    "sense_definition": "To express one's thoughts, feelings, or problems freely and intensely to another person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "venting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a stressful day at work, she just needed to <w>unload</w> on her friend.",
                            "target_lang_translations": {
                                "pl": "Po stresującym dniu w pracy po prostu musiała <w>wyładować się</w> przed przyjaciółką.",
                                "ru": "После напряжённого рабочего дня ей просто нужно было <w>выговориться</w> подруге."
                            }
                        },
                        {
                            "text": "He began to <w>unload</w> his frustration during the team meeting.",
                            "target_lang_translations": {
                                "pl": "Zaczął <w>wyrzucać z siebie</w> frustrację podczas spotkania zespołu.",
                                "ru": "Во время командного собрания он начал <w>выплёскивать</w> своё раздражение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unload on someone",
                        "unload feelings"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used when describing emotional venting or speaking angrily"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dawać upust swoim myślom, emocjom lub problemom, zwierzając się lub wyżywając na kimś.",
                        "ru": "Открыто и эмоционально высказывать кому-либо свои мысли, проблемы или чувства; изливать душу."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyładowywać się",
                                "target_lang_sense_clarification": "emocjonalnie, np. na kimś"
                            },
                            {
                                "target_lang_word": "wygadać się",
                                "target_lang_sense_clarification": "wyrzucić z siebie żale"
                            },
                            {
                                "target_lang_word": "wyrzucać z siebie",
                                "target_lang_sense_clarification": "frustrację, emocje"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выговориться",
                                "target_lang_sense_clarification": "высказать наболевшее"
                            },
                            {
                                "target_lang_word": "излить душу",
                                "target_lang_sense_clarification": "поделиться переживаниями"
                            },
                            {
                                "target_lang_word": "сорваться",
                                "target_lang_sense_clarification": "на кого-либо, выплеснуть эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd776981-0c9c-3c5c-8e36-13672b9ad683",
                    "sense_definition": "To get rid of unwanted goods, assets, or investments, often quickly or at a low price.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors rushed to <w>unload</w> their shares before the stock price fell further.",
                            "target_lang_translations": {
                                "pl": "Inwestorzy rzucili się, by <w>wyprzedać</w> swoje akcje, zanim kurs spadnie jeszcze bardziej.",
                                "ru": "Инвесторы бросились <w>сбрасывать</w> свои акции до того, как их цена упадёт ещё сильнее."
                            }
                        },
                        {
                            "text": "The company managed to <w>unload</w> excess inventory during the clearance sale.",
                            "target_lang_translations": {
                                "pl": "Firmie udało się <w>pozbyć</w> nadmiaru zapasów podczas wyprzedaży.",
                                "ru": "Компании удалось <w>распродать</w> излишки запасов во время ликвидации товаров."
                            }
                        }
                    ],
                    "synonyms": [
                        "offload"
                    ],
                    "common_phrases": [
                        "unload shares",
                        "unload stock",
                        "unload assets"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbywać się niechcianych towarów, aktywów lub inwestycji, często szybko lub po niskiej cenie.",
                        "ru": "Избавляться от ненужных товаров, акций или активов, часто быстро или по низкой цене."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyprzedawać",
                                "target_lang_sense_clarification": "towary, udziały"
                            },
                            {
                                "target_lang_word": "pozbywać się",
                                "target_lang_sense_clarification": "akcji, nadwyżek magazynowych"
                            },
                            {
                                "target_lang_word": "upłynniać",
                                "target_lang_sense_clarification": "aktywa, zapasy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "распродавать",
                                "target_lang_sense_clarification": "быстро или со скидкой (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "акции, активы"
                            },
                            {
                                "target_lang_word": "сбывать",
                                "target_lang_sense_clarification": "избавляться от излишков товара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e9ecbcd-9caa-3bd7-8a1c-3949bedb3ed4",
                    "sense_definition": "To deposit or discharge cargo, passengers, or contents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cargo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delivery trucks must <w>unload</w> at designated bays behind the store.",
                            "target_lang_translations": {
                                "pl": "Ciężarówki dostawcze muszą <w>rozładowywać się</w> w wyznaczonych dokach za sklepem.",
                                "ru": "Грузовики доставки должны <w>разгружаться</w> в специально отведённых зонах за магазином."
                            }
                        },
                        {
                            "text": "Collection vehicles usually <w>unload</w> onto the concrete floor before sorting begins.",
                            "target_lang_translations": {
                                "pl": "Pojazdy zwożące odpady zazwyczaj <w>dokonują rozładunku</w> na betonową posadzkę przed rozpoczęciem sortowania.",
                                "ru": "Мусоровозы обычно <w>разгружаются</w> на бетонный пол до начала сортировки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dokonywać rozładunku ładunku, pasażerów lub zawartości w wyznaczonym miejscu.",
                        "ru": "Производить разгрузку груза или высадку содержимого в определённом месте."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozładowywać się",
                                "target_lang_sense_clarification": "o pojeździe w punkcie rozładunku"
                            },
                            {
                                "target_lang_word": "dokonywać rozładunku",
                                "target_lang_sense_clarification": "oficjalnie"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разгружаться",
                                "target_lang_sense_clarification": "о транспорте (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "разгрузиться",
                                "target_lang_sense_clarification": "о транспорте (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a21cbc5f-fdbc-3ca2-b029-472d9634b1f2",
                    "sense_definition": "To deceitfully pass off or dispose of inferior or counterfeit goods to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest dealer attempted to <w>unload</w> fake antique paintings onto unsuspecting tourists.",
                            "target_lang_translations": {
                                "pl": "Nieuczciwy handlarz próbował <w>wcisnąć</w> podrobione zabytkowe obrazy niczego niepodejrzewającym turystom.",
                                "ru": "Нечистый на руку торговец попытался <w>спихнуть</w> поддельные старинные картины ничего не подозревающим туристам."
                            }
                        },
                        {
                            "text": "He managed to <w>unload</w> the damaged car on an inexperienced buyer.",
                            "target_lang_translations": {
                                "pl": "Udało mu się <w>wepchnąć</w> uszkodzony samochód niedoświadczonemu kupcowi.",
                                "ru": "Ему удалось <w>сбагрить</w> битую машину неопытному покупателю."
                            }
                        }
                    ],
                    "synonyms": [
                        "fob off",
                        "foist",
                        "palm off",
                        "pass off",
                        "pawn off"
                    ],
                    "target_lang_definitions": {
                        "pl": "Oszukańczo wciskać lub sprzedawać komuś towary gorszej jakości bądź podróbki.",
                        "ru": "Обманным путём сплавить или сбыть некачественные либо поддельные товары."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wciskać",
                                "target_lang_sense_clarification": "podstępem niechciany lub trefny towar"
                            },
                            {
                                "target_lang_word": "wepchnąć",
                                "target_lang_sense_clarification": "dokonany: wcisnąć coś komuś"
                            },
                            {
                                "target_lang_word": "wypychać",
                                "target_lang_sense_clarification": "pozbywać się oszukańczo"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спихивать",
                                "target_lang_sense_clarification": "неликвид или подделку (разг.)"
                            },
                            {
                                "target_lang_word": "спихнуть",
                                "target_lang_sense_clarification": "сбыть с рук обманом (разг.)"
                            },
                            {
                                "target_lang_word": "сбагрить",
                                "target_lang_sense_clarification": "избавиться от негодного (прост.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd7d0c26-2f76-3f23-88a8-37038eeabfac",
                    "sense_definition": "To remove data, a program, or a library from system memory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operating system will automatically <w>unload</w> the driver when the device is disconnected.",
                            "target_lang_translations": {
                                "pl": "System operacyjny automatycznie <w>odładuje</w> sterownik po odłączeniu urządzenia.",
                                "ru": "Операционная система автоматически <w>выгрузит</w> драйвер при отключении устройства."
                            }
                        },
                        {
                            "text": "Make sure to <w>unload</w> unnecessary modules to free up system memory.",
                            "target_lang_translations": {
                                "pl": "Upewnij się, że <w>zwolniłeś</w> niepotrzebne moduły, aby odzyskać pamięć systemową.",
                                "ru": "Обязательно <w>выгрузите</w> ненужные модули, чтобы освободить системную память."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unload a module",
                        "unload a driver"
                    ],
                    "target_lang_definitions": {
                        "pl": "Usuwać dane, program lub bibliotekę z pamięci operacyjnej komputera.",
                        "ru": "Удалять данные, программу или модуль из оперативной памяти системы."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyładowywać",
                                "target_lang_sense_clarification": "moduł z pamięci"
                            },
                            {
                                "target_lang_word": "odładowywać",
                                "target_lang_sense_clarification": "sterownik, bibliotekę z pamięci"
                            },
                            {
                                "target_lang_word": "zwalniać",
                                "target_lang_sense_clarification": "moduł, sterownik z pamięci"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выгружать",
                                "target_lang_sense_clarification": "из памяти (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "выгрузить",
                                "target_lang_sense_clarification": "из памяти (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac87fbcc-75d1-31dc-b26d-52af040c0baf",
                    "sense_definition": "To discharge, pour out, or expel a large quantity of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "discharge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm clouds began to <w>unload</w> torrential rain across the valley.",
                            "target_lang_translations": {
                                "pl": "Chmury burzowe zaczęły <w>zrzucać</w> ulewny deszcz na całą dolinę.",
                                "ru": "Грозовые тучи начали <w>обрушивать</w> проливной дождь на всю долину."
                            }
                        },
                        {
                            "text": "The machine suddenly broke down and <w>unloaded</w> hot steam into the room.",
                            "target_lang_translations": {
                                "pl": "Maszyna nagle się zepsuła i <w>wyrzuciła</w> gorącą parę do pomieszczenia.",
                                "ru": "Станок неожиданно сломался и <w>выбросил</w> горячий пар в помещение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyrzucać, wylewać lub uwalniać dużą ilość czegoś gwałtownie.",
                        "ru": "Выбрасывать, извергать или обрушивать большое количество чего-либо."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrzucać",
                                "target_lang_sense_clarification": "np. deszcz z chmur"
                            },
                            {
                                "target_lang_word": "wyrzucać",
                                "target_lang_sense_clarification": "parę, zawartość"
                            },
                            {
                                "target_lang_word": "uwalniać",
                                "target_lang_sense_clarification": "dużą ilość substancji"
                            }
                        ],
