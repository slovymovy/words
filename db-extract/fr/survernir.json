                "senses": [
                    {
                        "sense_id": "a751776b-2773-37ad-9d14-9399f3df3b25",
                        "entry_id": "a3c290c4-2694-3181-b21c-6576e33acb29",
                        "glosses": [
                            "Passer une couche de vernis par dessus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d492235-9a40-456c-a841-da9773218b87",
                                "sense_id": "a751776b-2773-37ad-9d14-9399f3df3b25",
                                "text": "Etant donné la facilité de retouche de cette composition, si l'on désire des finitions brillantes, il est possible de survernir avec notre finition Super Alafine® brillant Ref. PY-269."
                            },
                            {
                                "example_id": "6d4e3656-ddcf-4a1b-937e-a4598ca3f031",
                                "sense_id": "a751776b-2773-37ad-9d14-9399f3df3b25",
                                "text": "Il est GRIS et on peut le survernir par de couches nitro-synthétiques ou polyuréthaniques ou encore par des émails de finition."
                            },
                            {
                                "example_id": "084aee7e-f8d8-4e86-ae2c-40a8ee71504f",
                                "sense_id": "a751776b-2773-37ad-9d14-9399f3df3b25",
                                "text": "Si l'on désire des degrés de matité plus profonds que satiné, survernir avec une couche de vernis à deux couche OWEDUR DD 4126."
                            }
                        ]
                    }
