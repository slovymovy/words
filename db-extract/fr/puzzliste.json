                        "glosses": [
                            "Personne qui aime faire des puzzles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82169c00-86df-4f88-8f3e-156afedeb01c",
                                "sense_id": "f0910b2b-272c-3b6e-8878-4df76e4b8e28",
                                "text": "Il s’était installé le matin même sur le parquet de l’appartement et, avec l’application d’un puzzliste, il avait préparé ses papillons sans lésiner, un à un, en les étalant autour de lui comme s’il faisait un happening au musée de la Fleur d’Ollioules."
                            },
                            {
                                "example_id": "a5ec64d2-e6b6-47cd-b856-8f0249c95481",
                                "sense_id": "f0910b2b-272c-3b6e-8878-4df76e4b8e28",
                                "text": "Leur entraîneur disait encore ce matin que la Colombie exporterait bientôt plus de puzzlistes que de café !"
                            },
                            {
                                "example_id": "b7640f4f-cd5b-4e43-a483-197714ad47e0",
                                "sense_id": "f0910b2b-272c-3b6e-8878-4df76e4b8e28",
                                "text": "L’idée lui en est venue non parce qu’on organise à Zurich en été des concours publics auxquels se livrent les puzzleurs, puzzlistes, puzzlophiles et puzzlâtres, fondus de puzzlologie du monde entier."
                            }
                        ]
                    }
