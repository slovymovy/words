                "senses": [
                    {
                        "sense_id": "f723d9d0-7cc1-38b4-9bc0-6bfbec0e29f9",
                        "entry_id": "500482c4-b625-34b7-9658-7091f7155152",
                        "glosses": [
                            "französische Bezeichnung für die Sondersprache der Bettler und Gauner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0578ef4-8dbe-43db-93a6-1841fd72901d",
                                "sense_id": "f723d9d0-7cc1-38b4-9bc0-6bfbec0e29f9",
                                "text": "François Villon „lebte von 1431 bis nach 1463 (…), entstammte ärmlichsten Verhältnissen, wurde Mitglied einer Gaunerbande und benutzte deren Sprache, den Argot, in dem er - als eine Art Nachfahre der Vaganten des 12. und 13. Jahrhunderts - großartige Lieder und Balladen schrieb.“"
                            },
                            {
                                "example_id": "ecd32e63-8739-4508-ad2e-bbbabcb4939f",
                                "sense_id": "f723d9d0-7cc1-38b4-9bc0-6bfbec0e29f9",
                                "text": "„Ich sehe ihre Lachfalten, die Grübchen, das Augenblitzen und muß dann denken, wie sie mir Argot beibrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5046faca-3b5f-48cd-962e-4f9985c7762d",
                        "source_entry_id": "500482c4-b625-34b7-9658-7091f7155152",
                        "source_sense_id": "f723d9d0-7cc1-38b4-9bc0-6bfbec0e29f9",
                        "source_sense_description": "Linguistik: französische Bezeichnung für die Sondersprache der Bettler und Gauner",
                        "target_lang_word": "argot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11045725-2ea6-3194-a97c-3f90dcc9687a",
                                        "entry_id": "eb27fdd5-5b1c-3db2-bdfc-128cc5978a5c",
                                        "glosses": [
                                            "A secret language or conventional slang peculiar to thieves, tramps and vagabonds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5cb326-1154-43ba-a81a-4488fb4246fb",
                                                "sense_id": "11045725-2ea6-3194-a97c-3f90dcc9687a",
                                                "text": "Sadie had, in the argot of the day, a really good built."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2300089-fd81-3b7e-ade0-b72e5d81a8f4",
                                        "entry_id": "eb27fdd5-5b1c-3db2-bdfc-128cc5978a5c",
                                        "glosses": [
                                            "The specialized informal vocabulary and terminology used between people with special skill in a field, such as between doctors, mathematicians or hackers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d919c87-ca0a-4603-b6fe-6bbbf9318d82",
                                                "sense_id": "b2300089-fd81-3b7e-ade0-b72e5d81a8f4",
                                                "text": "The conversation was in the argot of the trade, full of acronyms and abbreviations that made no sense to the uninitiate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e848958a-f0d0-30ff-85c8-2a17cf548563",
                                        "entry_id": "eb27fdd5-5b1c-3db2-bdfc-128cc5978a5c",
                                        "glosses": [
                                            "A strongly marked style of speaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ab5dd0-2b11-4fae-8516-3f3f910c6b78",
                                                "sense_id": "e848958a-f0d0-30ff-85c8-2a17cf548563",
                                                "text": "Merle spoke in the thin nasal argot of this city's slums: \"This the fus toim yez been lobbed, oy, kiddow?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7a0b6c4-c2bf-4be2-ada8-54dba91e4ccd",
                        "source_entry_id": "500482c4-b625-34b7-9658-7091f7155152",
                        "source_sense_id": "f723d9d0-7cc1-38b4-9bc0-6bfbec0e29f9",
                        "source_sense_description": "Linguistik: französische Bezeichnung für die Sondersprache der Bettler und Gauner",
                        "target_lang_word": "argot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                        "entry_id": "060430ba-46fc-339c-bb26-6d3bf7dabce5",
                                        "glosses": [
                                            "Langage de convention utilisé à l’origine par les voleurs, les malfaiteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48453ff0-c8ea-4008-aa84-346e5dd11f46",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Dans l’argot du temps on appelait M. Louis un homme spécial ; sa spécialité financière l’avait conduit à entasser l’argent des contribuables dans le trésor, pour le faire prendre par Bonaparte."
                                            },
                                            {
                                                "example_id": "205ad304-9b77-4c3d-b4eb-f6bcaf723dd0",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "C'est un garçon fort agréable que Bernard. Soigné, rasé de près, le teint clair, il s'exprime dans une langue choisie et ne fait usage de l’argot qu'en d'exceptionnelles circonstances."
                                            },
                                            {
                                                "example_id": "2c81be9e-9557-4da6-a27f-a6d601452aeb",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Et, tout à l'heure, quand il s'était adressé à la prostituée enceinte, il avait usé d'un terme dont la grossièreté\nTirant son origine d'une langue moins noble et moins enveloppée que l’argot\nMe choquait encore secrètement."
                                            },
                                            {
                                                "example_id": "5766989d-b8c2-4f5a-8c8b-8bbcaee523e5",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Après une vie exemplaire de vigilance et d’autorité, il paraît que le pauvre homme est tombé en enfance, qu’il se promène par les chemins de Claquebue en disant des vilains mots d’argot et en prêchant la fraternité."
                                            },
                                            {
                                                "example_id": "84c54123-df73-449c-ac49-f7c46d961055",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Il convient de savoir qu'un « coq », dans l’argot d’avant guerre, signifiait un louis, car mon récit repose sur cette explication, […]."
                                            },
                                            {
                                                "example_id": "8eb789fe-fe41-44ec-990d-2905c6485de6",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Les jeunes Français parlent un mélange de français, de verlan, d’arabe, de tzigane, d’anglais, de vieil argot et d'expressions inventées. « J'ai le seum » tiré de l'arabe, veut dire « Je suis en colère »."
                                            },
                                            {
                                                "example_id": "d08a1e7d-6696-466b-90d2-474ce3a90d2b",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Si l’on met à part les simples témoignages d’argotiers proprement dits ou de personnes les fréquentant professionnellement (policiers, magistrats), ce qui frappe c’est le caractère relativement tardif des études consacrées aux argots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                        "entry_id": "060430ba-46fc-339c-bb26-6d3bf7dabce5",
                                        "glosses": [
                                            "Jargon ou sociolecte ; vocabulaire (et parfois autres traits de langage) utilisé au sein d'une profession ou bien d'un milieu ou classe sociale particulière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b5bf7e-d778-49d5-a1da-9c22daa16080",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des bouchers (Louchébem)"
                                            },
                                            {
                                                "example_id": "12278cdb-92ec-41a7-83c4-e5ab3721e2ce",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot de la Bourse."
                                            },
                                            {
                                                "example_id": "86967a18-d0d5-4dd0-b678-b783c19c0d11",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des cités."
                                            },
                                            {
                                                "example_id": "c1dc43d1-1560-46f8-a51b-f57c780a9421",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des peintres, des écoliers."
                                            },
                                            {
                                                "example_id": "bd44bf52-a675-471f-8bb9-1e1d99b5ce65",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des coulisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3de4c9f-a1f8-3861-bf5a-23d7054238dd",
                                        "entry_id": "060430ba-46fc-339c-bb26-6d3bf7dabce5",
                                        "glosses": [
                                            "Langage populaire, non académique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a894ca-cde9-4253-8a88-b16d43b73915",
                                                "sense_id": "b3de4c9f-a1f8-3861-bf5a-23d7054238dd",
                                                "text": "En argot français, si le hareng saur est appelé gendarme, c'est peut-être parce qu'on pense qu'un gendarme est raide comme un hareng saur."
                                            },
                                            {
                                                "example_id": "0d38f268-b019-4588-995c-dbe5ff78d105",
                                                "sense_id": "b3de4c9f-a1f8-3861-bf5a-23d7054238dd",
                                                "text": "La cuisine était la préfecture de police dans l’argot des voleurs qui redoutaient sans doute de s'y retrouver pour être cuisinés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "argot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d409218f-2060-356f-9bb2-866709c2b1ad",
                                        "entry_id": "f902119d-f6be-3777-aa6a-144be9de55af",
                                        "glosses": [
                                            "Bois qui est au-dessus de l'œil sur le rameau."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
