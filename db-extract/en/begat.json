                "senses": [
                    {
                        "sense_id": "34b78880-ce40-37e8-85d0-33eaeea184dc",
                        "entry_id": "3cb49c01-7f86-39ae-9d88-5b7fee2434e0",
                        "glosses": [
                            "beget 的簡單過去時"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e3fad428-2b40-490b-a27a-611ecd7ec0c7",
                                "sense_id": "34b78880-ce40-37e8-85d0-33eaeea184dc",
                                "text": "And Adam lived an hundred and thirty years, and begat a son in his own likeness, after his image; and called his name Seth:",
                                "translation": "亞當活到一百三十歲，生了一個兒子，形像樣式和自己相似，就給他起名叫塞特。"
                            },
                            {
                                "example_id": "ca2185f1-33db-46bc-8cc4-d7a559d7c848",
                                "sense_id": "34b78880-ce40-37e8-85d0-33eaeea184dc",
                                "text": "Abraham begat Isaac; and Isaac begat Jacob; and Jacob begat Judas and his brethren",
                                "translation": "亞伯拉罕生以撒，以撒生雅各，雅各生猶大和他的兄弟，"
                            },
                            {
                                "example_id": "8d8e3d09-ff98-4420-bb09-df5ac7c3f851",
                                "sense_id": "34b78880-ce40-37e8-85d0-33eaeea184dc",
                                "text": "Rugby football was created in the early 1800s at England’s all-boys Rugby School. The sport begat American football, Gaelic football, Australian rules football and Association football (aka soccer).",
                                "translation": "橄榄球运动起源于19世纪初英国的拉格比男子学校。这项运动衍生出了美式橄榄球、盖尔式橄榄球、澳式橄榄球和足球（又称英式足球）。"
                            }
                        ]
                    }
                ],
