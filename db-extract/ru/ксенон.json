                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b272ce0-f8c7-4502-8ba5-0562057b05c0",
                                                "sense_id": "da880888-04f9-3636-8504-5391c92728dc",
                                                "text": "Le xénon présente divers isotopes parmi lesquels nous retiendrons le ¹³⁰Xe, un isotope stable et non radiogénique, et le ¹²⁹Xe qui est un isotope du xénon produit par la désintégration radioactive de l’iode 129 (¹²⁹I), isotope contenu dans les supernova qui ont contribué à la formation de la planète Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89456dc1-056a-3def-8d75-c5546674ad9a",
                                        "entry_id": "dce0fee8-1a7d-3a29-a6b3-702c3433b707",
                                        "glosses": [
                                            "Gaz monoatomique de cet élément (Xe) incolore, inodore et peu réactif."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f321223-2e24-43e2-b0c0-1f0cf8580981",
                                                "sense_id": "89456dc1-056a-3def-8d75-c5546674ad9a",
                                                "text": "Un journal parisien signalait que Ramsay avait « découvert cinq nouveaux gaz dans l’atmosphère en moins de cinq ans : l’argon, l’hélium, le néon, le krypton et le xénon »."
                                            },
                                            {
                                                "example_id": "c82b865a-8d9d-40b9-92a6-b353098af61c",
                                                "sense_id": "89456dc1-056a-3def-8d75-c5546674ad9a",
                                                "text": "Les savants comprirent que le xénon perturbait la réaction en chaîne."
                                            }
