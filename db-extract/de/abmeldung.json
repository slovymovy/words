                "senses": [
                    {
                        "sense_id": "e3db2cc7-3163-35bf-bd13-d0c3ce06e7f0",
                        "entry_id": "a738e5ec-334d-3597-afa3-df3e6bc27aac",
                        "glosses": [
                            "ordnungsgemäße Bekanntgabe seines Weggangs, der Außerbetriebnahme von etwas oder der Nichtmehrteilnahme bei etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c6bdda-3ce1-4519-b6f4-e305b6c41f9d",
                                "sense_id": "e3db2cc7-3163-35bf-bd13-d0c3ce06e7f0",
                                "text": "Eine Abmeldung muss mindestens 48 Stunden vor Kursbeginn bei uns eingehen, wenn die Teilnahmegebühr erstattet werden soll."
                            },
                            {
                                "example_id": "af6e6beb-9e18-4c69-841a-64373beaec0e",
                                "sense_id": "e3db2cc7-3163-35bf-bd13-d0c3ce06e7f0",
                                "text": "Zur Abmeldung des Wohnsitzes müssen Sie oftmals persönlich bei der Meldestelle erscheinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c18ed6cb-49b9-4d6b-92bc-f4ad7b5bc878",
                        "source_entry_id": "a738e5ec-334d-3597-afa3-df3e6bc27aac",
                        "source_sense_id": "e3db2cc7-3163-35bf-bd13-d0c3ce06e7f0",
