                "senses": [
                    {
                        "sense_id": "9bf6d613-49f9-3c27-b8c8-ab855c681b26",
                        "entry_id": "f5d62283-480a-3bf1-a37c-5fd40782a3cf",
                        "glosses": [
                            "Verlust der zuvor vorhandenen Fähigkeit zu schreiben"
                        ],
                        "tags": [
                            "Sprachstörung"
                        ],
                        "examples": [
                            {
                                "example_id": "45fb9b83-7b13-4772-b234-cbc98f2ab8db",
                                "sense_id": "9bf6d613-49f9-3c27-b8c8-ab855c681b26",
                                "text": "„Neurologen nennen es Alexie ohne Agraphie und meinen damit, dass Engel zwar noch schreiben, aber nicht lesen konnte: Schriftblindheit.“"
                            },
                            {
                                "example_id": "aa15779b-ea66-4694-8614-66113da99db8",
                                "sense_id": "9bf6d613-49f9-3c27-b8c8-ab855c681b26",
                                "text": "„Eine Agraphie bedeutet zumeist den Verlust des Schreibvermögens des Patienten, obwohl dessen Intelligenz und Intellekt bei Hirnschädigungen beispielsweise in Folge eines Schlaganfalles nicht beeinträchtigt sind. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
