    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c6d012de-9529-3c39-bd80-4d695bd3d65b",
                "word": "ultramontane",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f0e78fd5-9479-43df-9074-c82657986480",
                        "entry_id": "c6d012de-9529-3c39-bd80-4d695bd3d65b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ultramontane"
                    },
                    {
                        "form_id": "78492bc2-9a06-4afc-a1ad-cbb777533065",
                        "entry_id": "c6d012de-9529-3c39-bd80-4d695bd3d65b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ultramontane"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4a430b5-30a7-3976-a6d7-8e7edbd57bc3",
                        "entry_id": "c6d012de-9529-3c39-bd80-4d695bd3d65b",
                        "glosses": [
                            "Promoting the supremacy of the Pope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6ade188-6107-4810-866c-f1166c8b94e5",
                                "sense_id": "e4a430b5-30a7-3976-a6d7-8e7edbd57bc3",
                                "text": "'Tis no wonder that a Council which had declar'd itſelf ſuperior to the Popes, which had undertaken to try, and even to depoſe them, and had given ſuch great Blows to the Privileges, and to the Authority of the Cardinals, was not relith'd by the Court of Rome, nor approv'd of by the Popes or tlieir Divines, nor by the Ultramontane Canonists."
                            },
                            {
                                "example_id": "b1b2415d-c7f1-4a32-acaf-cc96b728f76d",
                                "sense_id": "e4a430b5-30a7-3976-a6d7-8e7edbd57bc3",
                                "text": "It was by becoming a Catholic that I pacified the Vendee, and a Mussulman that I established myself in Egypt; it was by becoming ultramontane that I won over public opinion in Italy."
                            },
                            {
                                "example_id": "6994b744-0533-4adf-bc95-a79d7fcb4d91",
                                "sense_id": "e4a430b5-30a7-3976-a6d7-8e7edbd57bc3",
                                "text": "My friend, a Scottish newspaper chief, has spent half a lifetime gliding across some of Fleet Street's more ultramontane and unreasonable titles."
                            }
                        ]
                    },
                    {
                        "sense_id": "25fa7a99-764f-36b5-8ccb-d5bf9dd68904",
                        "entry_id": "c6d012de-9529-3c39-bd80-4d695bd3d65b",
                        "glosses": [
                            "From the other side of a mountain range, particularly the Alps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e580302-dfd8-4573-8b28-e99276ad5921",
                                "sense_id": "25fa7a99-764f-36b5-8ccb-d5bf9dd68904",
                                "text": "He was slenderly provided with means for his ultramontane journey; and he resolved to save all he could in Italy, that he might not be restricted when among foreigners."
                            },
                            {
                                "example_id": "00459c4e-9a4e-48f1-b716-704839cfe24e",
                                "sense_id": "25fa7a99-764f-36b5-8ccb-d5bf9dd68904",
                                "text": "A march of about forty miles from Sohar up wadys, with intermittent water in their beds, brought his party to the frontier of the Batina, and by a low pass (i860 feet) it crossed the dividing ridge into the ultramontane province, Dahira."
                            },
                            {
                                "example_id": "74b90e2a-3278-4d6e-9e06-c6da5147d2f9",
                                "sense_id": "25fa7a99-764f-36b5-8ccb-d5bf9dd68904",
                                "text": "Whatever their physics, the spectacular ultramontane sunsets are an important part of Seattle's claim to be \"a flower of geography\" — as Henry James called the city in 1907, placing it in the company of Cape Town, Rio de Janeiro, Naples, Sydney, and San Francisco."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c780ffd9-4048-4fae-9d57-03a31b240637",
                        "source_entry_id": "c6d012de-9529-3c39-bd80-4d695bd3d65b",
                        "source_sense_description": "respecting the supremacy of the Pope",
                        "target_lang_word": "ultramontain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultramontain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dae100cb-345b-31c2-807d-dbe21f87fa8f",
                                        "entry_id": "1f387b54-c741-3a83-895a-405f197e42d1",
                                        "glosses": [
                                            "Qui est situé, qui habite au-delà des montagnes (et spécialement des Alpes, depuis la France ou depuis l'Italie) par rapport à celui qui parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6baa6fb-301c-4275-80a8-640328fac86c",
                                                "sense_id": "dae100cb-345b-31c2-807d-dbe21f87fa8f",
                                                "text": "C’était le commandeur Aspertini, de Naples, philologue, agronome, député au Parlement italien, qui, depuis dix ans, entretenait avec M. Bergeret une docte correspondance, à la manière des grands humanistes de la Renaissance et du xviie siècle, et qui ne manquait pas d’aller voir son correspondant ultramontain à chaque voyage qu’il faisait en France."
                                            },
                                            {
                                                "example_id": "326d9455-c8d8-40b9-8fe2-87c1c7cee59b",
                                                "sense_id": "dae100cb-345b-31c2-807d-dbe21f87fa8f",
                                                "text": "À Lyon, l’écriture gothique, adaptée, manifeste une résistance plus forte qu’ailleurs — témoignage remarquable d’une double appartenance culturelle, rhénane et ultramontaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f9086d0-4a01-3690-99b8-7b3629ef3e27",
                                        "entry_id": "1f387b54-c741-3a83-895a-405f197e42d1",
                                        "glosses": [
                                            "Qualifie les maximes et revendications théologiques qui tendent à accentuer les droits du Saint-Siège sur la société civile et les prérogatives papales dans l’église de France."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8b0d917-9a70-4601-886b-d19bd3499af7",
                                                "sense_id": "3f9086d0-4a01-3690-99b8-7b3629ef3e27",
                                                "text": "Il y déclare en effet, avec les docteurs gallicans, que l’Église primitive ne reconnaissait nullement la suprématie et l’infaillibilité du Saint-Siège, et que ces doctrines ultramontaines constituent des nouveautés dangereuses, exclusivement fondées sur les fausses décrétales."
                                            },
                                            {
                                                "example_id": "97cfa1a4-bde9-41db-bdb2-eba0046cc609",
                                                "sense_id": "3f9086d0-4a01-3690-99b8-7b3629ef3e27",
                                                "text": "Ce qui m'aura le plus effrayé dans ma famille, c'est le ridicule. Se dire, dans la seconde moitié du XXᵉ siècle, qu'on sort de ce mélange de hobereaux ultramontains, de soutanes de couleur, de bedonnants à panonceaux dorés et aux estimes fondées sur des estimations, qu'on est le propre petit-fils d'un député conservateur dont l'étiquette lors des scrutins s'abrégeait si dignement dans les journaux (Ferdinand Rezeau, con., 37 489 voix, élu), que somme toute on est né à la traîne, dans une sorte d'enclave du siècle précédent… C'est décourageant."
                                            },
                                            {
                                                "example_id": "3e672aa8-501d-4793-8d2a-ce0700497207",
                                                "sense_id": "3f9086d0-4a01-3690-99b8-7b3629ef3e27",
                                                "text": "Au cours de la nonciature de Mgr Fornari en France (1843-1850) se développa dans tous les domaines ce qu'on a appelé « l'offensive ultramontaine »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ultramontain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21c73238-cb6a-3783-a64a-bb8bf449a1d3",
                                        "entry_id": "7655a741-5973-3ee3-a1a1-9fea4cd1b70f",
                                        "glosses": [
                                            "Partisan de l’ultramontanisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a8bcb9-2e1f-4566-9c92-c404254697b3",
                                                "sense_id": "21c73238-cb6a-3783-a64a-bb8bf449a1d3",
                                                "text": "Donc Biuet, dont je vais vous tracer la navrante histoire, Bluet était un catholique fervent, sincère, un ultramontain de la plus belle eau, un croyant qui possédait cette foi robuste, la classique foi du charbonnier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
