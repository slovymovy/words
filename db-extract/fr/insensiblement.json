        "fr-extract.jsonl": [
            {
                "entry_id": "a20e0bcd-ae51-3a79-8e4d-36517b11543e",
                "word": "insensiblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                        "entry_id": "a20e0bcd-ae51-3a79-8e4d-36517b11543e",
                        "glosses": [
                            "D’une manière peu sensible, peu perceptible, peu à peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c72bc7-60d5-4799-916a-4e790c30a01d",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "Il voyait bien qu'il devenait peu à peu, insensiblement, enclin à une moindre activité, mais il s'abandonnait voluptueusement..."
                            },
                            {
                                "example_id": "4b97498e-ca42-44d6-9eb6-e2167326e066",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "La région que nous parcourons est une vaste plaine monotone, sans arbres et presque sans reliefs, qui s'élève insensiblement à fur et à mesure que nous avançons."
                            },
                            {
                                "example_id": "90e0d9ed-4368-4e99-9900-d42cda42c9f9",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "Il ne parvenait pas à s’imaginer qu’il avançât, tant le ballon voguait insensiblement dans le vent."
                            },
                            {
                                "example_id": "b2534934-d688-45da-8e3e-2fa5f5f46de7",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "Jeannin était joueur et même tricheur, entraîné à cela par un autre ; et insensiblement ils se mirent à tenir tripot, entendez qu'ils attiraient des inconnus à la table de nuit ; on passait du tarot au baccara pendant que nous dormions, et les étrangers étaient plumés."
                            },
                            {
                                "example_id": "6a3a15b8-c84d-49b9-86a2-caccc5b925c7",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "Leur appas dangereux, chaque fois qu’il surprend,\n Forme insensiblement un obstacle plus grand."
                            },
                            {
                                "example_id": "28e4287c-493b-4c1d-ae8d-613af8854f24",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "Cette conversation nous est si naturelle que nous y tombons insensiblement."
                            },
                            {
                                "example_id": "8039f587-cb34-4d6f-ad9d-4ccd1d524587",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "La douceur de sa voix, son enfance, sa grâce Font insensiblement à mon inimitié Succéder […] je serais sensible à la pitié ?"
                            },
                            {
                                "example_id": "cc95d122-1ce1-448d-8ba1-4d18205b1cc6",
                                "sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                                "text": "Mais le divertissement nous trompe, nous amuse, et nous fait arriver insensiblement à la mort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d60da92f-9d16-44bf-9d57-5e860a512912",
                        "source_entry_id": "a20e0bcd-ae51-3a79-8e4d-36517b11543e",
                        "source_sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                        "target_lang_word": "unbedeutend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbedeutend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06a0a48b-06ac-3d98-bb7e-ba14388d3a9c",
                                        "entry_id": "fbb684a2-e8f6-3933-944a-5c28e1b5f17c",
                                        "glosses": [
                                            "unwichtig; nicht von Bedeutung; nicht bedeutsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e737aa1-f042-4114-9af1-f7fea46aafbc",
                                                "sense_id": "06a0a48b-06ac-3d98-bb7e-ba14388d3a9c",
                                                "text": "Unsere Probleme wirken dagegen völlig unbedeutend und trivial."
                                            },
                                            {
                                                "example_id": "8ca822e3-1e18-40f9-9ef0-b839b6cd8af9",
                                                "sense_id": "06a0a48b-06ac-3d98-bb7e-ba14388d3a9c",
                                                "text": "[Weimarer Republik:] „Während sie [Anm.: die NSDAP] in anderen Teilen Deutschlands noch lange eine unbedeutende Splittergruppe blieb, wurde sie hier [Anm.: in Thüringen] immer größer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "572b6e28-ba45-42f0-b3b6-73129a54eeb9",
                        "source_entry_id": "a20e0bcd-ae51-3a79-8e4d-36517b11543e",
                        "source_sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                        "target_lang_word": "imperceptibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperceptibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                        "entry_id": "394599ed-d4f6-357f-a8d9-a677679cbecd",
                                        "glosses": [
                                            "Not noticeably; such that it cannot be detected, through being too small or too fast, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8662868a-cf7d-41a0-abfe-76d6b9caf7a9",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "No one noticed that he had moved imperceptibly backwards."
                                            },
                                            {
                                                "example_id": "674d77cb-a296-4197-9731-6c161b39ed2e",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "It often happens that the most important results in the natural world are brought about by causes which operate silently, if not imperceptibly."
                                            },
                                            {
                                                "example_id": "f12bc0fb-c7e2-4b50-b40a-918a19a5f68b",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "The moon moved imperceptibly towards setting."
                                            },
                                            {
                                                "example_id": "b855e3c0-a64a-474d-b68e-a8c1b3964cb0",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "Which means that at the moment Raven entered her, a very small hypodermic needle slipped imperceptibly into the engorged frontal vein of his penis, automatically shooting a cocktail of powerful narcotics and depressants into his bloodstream."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3296558-e109-4bd8-85be-66d3bf913adc",
                        "source_entry_id": "a20e0bcd-ae51-3a79-8e4d-36517b11543e",
                        "source_sense_id": "77facbc3-7113-3867-9aa1-654f92c03ee8",
                        "target_lang_word": "insensibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insensibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56d68694-e118-30d8-9d5e-15845b33378f",
                                        "entry_id": "c729e772-37c6-3047-82df-0b0a34bc3019",
                                        "glosses": [
                                            "In an insensible manner; without feeling or noticing something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce2f78d-c5b6-4193-9e57-2e707e70f521",
                                                "sense_id": "56d68694-e118-30d8-9d5e-15845b33378f",
                                                "text": "St. Peters ſeldom anſvvers Expectation at firſt entering it, but enlarges it ſelf on all Sides inſenſibly, and mends upon the Eye every Moment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
