                        "glosses": [
                            "die Farbe eines Knochens habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347287ea-8389-4a3d-876b-6b8e4a093f8f",
                                "sense_id": "653bfc31-1daf-3867-bba2-f25866d536d0",
                                "text": "„Allein in der leeren Hülle eines Hauses sah der Bewohner durch das staubige Glas zu, wie die Randscherbe eines knochenfarbenen Mondes sich über den schwarzen Tannen auf dem Kamm emporschob, über Tintenbäumen, die eine geschickte Hand vor das fahlere Dunkel des Winterhimmels getuscht hatte.“"
                            }
                        ],
