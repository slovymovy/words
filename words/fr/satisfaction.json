                        "exiger satisfaction"
                    ]
                },
                {
                    "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                    "sense_definition": "Dans la doctrine religieuse chrétienne, acte ou pénitence accompli pour réparer l'offense faite à Dieu par le péché.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a rappelé aux fidèles que la <w>satisfaction</w> fait partie intégrante du sacrement de réconciliation."
                        },
                        {
                            "text": "Cette prière imposée par le confesseur servait de <w>satisfaction</w> pour les fautes commises."
