{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "351dfa78-ed75-3700-b639-ab06bdf4bb5a",
                    "sense_definition": "A tiny puncture made by a pin or other sharp point, or the brief, sharp pain it causes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "puncture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She barely felt the small needle except for a sharp <w>pinprick</w>."
                        },
                        {
                            "text": "He jumped when he received a sudden <w>pinprick</w> on his thumb while sewing."
                        }
                    ],
                    "synonyms": [
                        "prick"
                    ],
                    "common_phrases": [
                        "sharp pinprick",
                        "mere pinprick"
                    ]
                },
                {
                    "sense_id": "d53d94fc-0c18-39e0-8142-29244fa8948b",
                    "sense_definition": "A very small dot or spot, especially of light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_dot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant stars looked like tiny <w>pinpricks</w> of light in the vast sky."
                        },
                        {
                            "text": "From the airplane window, cars on the ground appeared as mere <w>pinpricks</w>."
                        }
                    ],
                    "synonyms": [
                        "speck",
                        "dot"
                    ],
                    "common_phrases": [
                        "pinpricks of light"
                    ]
                },
                {
                    "sense_id": "2039644e-ae83-391d-8e2e-9de1ac7fcd93",
                    "sense_definition": "A minor irritation, grievance, or petty annoyance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These petty bureaucratic delays are just another <w>pinprick</w> in our daily routine."
                        },
                        {
                            "text": "She tried not to let minor administrative <w>pinpricks</w> distract her from the main goal."
                        }
                    ],
                    "synonyms": [
                        "annoyance",
                        "irritation",
                        "nuisance"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccf3997b-b39d-3128-939a-ed5795a965b7",
                    "sense_definition": "To cause a tingling or jabbing sensation reminiscent of a pinprick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cold rain began to <w>pinprick</w> her cheeks as the sudden storm arrived."
                        },
                        {
                            "text": "A cold sensation seemed to <w>pinprick</w> the back of his neck when he heard the noise."
                        }
                    ],
                    "synonyms": [
                        "prickle",
                        "tingle",
                        "sting"
                    ]
                },
                {
                    "sense_id": "e4b04fbf-3faa-361c-a2b3-b281754268f6",
                    "sense_definition": "To puncture with tiny holes, or to dot or mark something as if pierced with tiny spots.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "puncture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark velvet curtain was <w>pinpricked</w> by dozens of tiny holes that let the light through."
                        },
                        {
                            "text": "City lights <w>pinpricked</w> the darkness as their plane descended through the clouds."
                        }
                    ],
                    "synonyms": [
                        "puncture",
                        "perforate",
                        "dot"
                    ]
                }
            ]
        }
    ]
}