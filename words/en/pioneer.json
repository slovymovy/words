                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первопроходец",
                                "target_lang_sense_clarification": "исследователь новых земель"
                            },
                            {
                                "target_lang_word": "пионер",
                                "target_lang_sense_clarification": "первопоселенец"
                            },
                            {
                                "target_lang_word": "первооткрыватель",
                                "target_lang_sense_clarification": "открывающий новые территории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88748a9b-7ecd-37f2-b3bb-13d3cb0b9f8a",
                    "sense_definition": "A person born on or before 31 December 1949 who contributed to Singapore's early development.",
