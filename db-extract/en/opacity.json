                ],
                "senses": [
                    {
                        "sense_id": "a4c90bd2-5419-3369-884e-679720a2902c",
                        "entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "glosses": [
                            "The state or quality of being opaque, not allowing light to pass through."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "39243253-8c18-4573-b7f9-0b8d0556544a",
                                "sense_id": "a4c90bd2-5419-3369-884e-679720a2902c",
                                "text": "We could not see the sandbar due to the opacity of the muddy water."
                            }
                        ]
                    },
                    {
                        "sense_id": "b798e3e6-b622-35ed-b858-9d82886f79ee",
                        "entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "glosses": [
                            "The state or quality of being inaccessible to understanding."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f3cc82e-56e5-4154-906c-9345acb0a29a",
                                "sense_id": "b798e3e6-b622-35ed-b858-9d82886f79ee",
                                "text": "The opacity of these decisions is troubling."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e3b46bd-fb46-378b-a06e-d226a5053eeb",
                        "entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "glosses": [
                            "A measure of relative impenetrability to electromagnetic radiation such as light."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "c339152a-8915-4cb3-9cf3-e8fabe60f781",
                                "sense_id": "3e3b46bd-fb46-378b-a06e-d226a5053eeb",
                                "text": "The opacity of a clean glass window is near zero."
                            }
                        ]
                    },
                    {
                        "sense_id": "23f4d5a3-9830-3dc3-9a91-57991ccfb2a3",
                        "entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "glosses": [
                            "An opaque area."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d107673-d149-4a6b-aa22-f9088e566a39",
                                "sense_id": "23f4d5a3-9830-3dc3-9a91-57991ccfb2a3",
                                "text": "This report concerns a child with Down's syndrome (mongolism) and bilateral congenital corneal opacities born into a family affected through three generations by Rieger's anomaly."
                            },
                            {
                                "example_id": "de242bfc-9ecb-4e2c-b3b4-6635a04ff09c",
                                "sense_id": "23f4d5a3-9830-3dc3-9a91-57991ccfb2a3",
                                "text": "Scanty irregular opacities are not uncommonly observed on the chest roentgenogram in the absence of interstitial fibrosis of the lungs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0534cc0-3136-4b5f-a628-ea28f532cdc3",
                        "source_entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "source_sense_description": "state of being opaque; blocking light",
                        "target_lang_word": "neprůhlednost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9c9b603b-3304-483f-9dc2-89e0edcbd551",
                        "source_entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "source_sense_description": "state of being opaque; blocking light",
                        "target_lang_word": "opacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8c0352-716b-304e-bcee-ef0fdecee7ea",
                                        "entry_id": "8c8bb214-91ce-3a00-8f2f-59d6d78858b9",
                                        "glosses": [
                                            "Qualité de ce qui est opaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3924e8-f5c8-4a25-ab5d-2db52497561b",
                                                "sense_id": "ba8c0352-716b-304e-bcee-ef0fdecee7ea",
                                                "text": "Quant à la durée nécessaire au cristallin pour se décataracter, elle peut varier entre des limites considérables qu’on ne saurait apprécier d’une manière générale ; la résorption peut être très-lente, manquer même absolument pendant des mois et des années, et se faire alors avec une rapidité réellement surprenante, et amener en peu de temps une diminution très-appréciable et même complète des opacités."
                                            },
                                            {
                                                "example_id": "9d70dc51-a5d5-4aea-a19c-dbb62b43b246",
                                                "sense_id": "ba8c0352-716b-304e-bcee-ef0fdecee7ea",
                                                "text": "Le bitcoin est défini comme une donnée informatique qui passe directement de l’ordinateur du vendeur à celui de l’acheteur en P2P (peer to peer, d’ordinateur à ordinateur). Ces monnaies virtuelles représentent donc l’outil rêvé pour les transactions qui nécessitent une opacité extrême et une discrétion totale comme celles qui participent au blanchiment de l’argent sale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d23790d-c7c2-4ce5-a646-23b6047237e2",
                        "source_entry_id": "515a35b3-df81-3eee-9956-ed951875c0f8",
                        "source_sense_description": "state of being opaque; blocking light",
                        "target_lang_word": "Opazität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Opazität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "528ca59c-5d03-3eb9-8e55-84d491cf050a",
                                        "entry_id": "50a9248f-8689-315c-be9d-f56eaf590ec7",
                                        "glosses": [
                                            "Eigenschaft, zum Beispiel der Hornhaut des Auges, getrübt, undurchsichtig (opak) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bc6af7-bb52-46b9-a452-2f6b35bbdfd8",
                                                "sense_id": "528ca59c-5d03-3eb9-8e55-84d491cf050a",
                                                "text": "„Mit dem Alter nehmen – das lehrt ebenfalls die Spaltlampe – Opazität von Hornhaut, Linse und Glaskörper zu.“"
                                            },
                                            {
                                                "example_id": "105a7a31-83d2-4b0f-a736-bfae9ee7b8bc",
                                                "sense_id": "528ca59c-5d03-3eb9-8e55-84d491cf050a",
                                                "text": "„Wie bereits oben angeführt, ist es oft schwierig, die Pathogenese von scharf begrenzten Opazitäten alleine mit einem Trauma zu erklären, insbesondere bei symmetrischem Befall der ersten bleibenden Molaren.“"
                                            },
                                            {
                                                "example_id": "906899f3-243c-48ab-ae45-e92a618c8230",
                                                "sense_id": "528ca59c-5d03-3eb9-8e55-84d491cf050a",
                                                "text": "„Der Begriff Dentikel bezeichnet zwei von Morphologie und Entstehung her völlig unterschiedliche Hartsubstanzbildungen, die in oder am Rande der Zahnpulpa vorkommen, bei größerer Ausdehnung im Röntgenbild als Opazitäten erkennbar werden und Wurzelkanalbehandlungen erheblich behindern können.“"
                                            },
                                            {
                                                "example_id": "acb5f726-59b1-4519-805b-8e73ec1e1e80",
                                                "sense_id": "528ca59c-5d03-3eb9-8e55-84d491cf050a",
                                                "text": "„Verschattungen oder Opazitäten (hell) entstehen dort, wo der Röntgenstrahl den Film (Bildempfänger) nicht belichten kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bee4142-065a-35cc-8725-b4f9a9667f65",
                                        "entry_id": "50a9248f-8689-315c-be9d-f56eaf590ec7",
                                        "glosses": [
                                            "Eigenschaft, für Licht undurchdringlich, lichtundurchlässig (opak) zu sein"
                                        ],
                                        "tags": [
                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377700c0-5753-4a55-bb1f-370bf7f7b2ba",
                                                "sense_id": "7bee4142-065a-35cc-8725-b4f9a9667f65",
                                                "text": "„Die Begriffe Opazität, Transparenz und Transluzenz beschreiben die Lichtdurchlässigkeit eines Gegenstands: Absolut lichtundurchlässig sind Metalle.“"
                                            },
                                            {
                                                "example_id": "423a5f86-c02d-4cf6-a56d-02215ca458e4",
                                                "sense_id": "7bee4142-065a-35cc-8725-b4f9a9667f65",
                                                "text": "„Die gemessenen Opazitäten (Galvanometerablesung für die Emulsion/Galvanometerablesung für die Linie) für die zwei schwachen Stufen der Standardlinie werden als gerade Linie gegen die relativen Belichtungen der Stufen eingetragen.“"
                                            },
                                            {
                                                "example_id": "13b7009a-d303-4b65-8cec-0991e21dc55c",
                                                "sense_id": "7bee4142-065a-35cc-8725-b4f9a9667f65",
                                                "text": "„Aber auch beliebig hohe Opazitäten sind in der drucktechnischen Realität kaum zu erzielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
