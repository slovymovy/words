                        ]
                    },
                    {
                        "translation_id": "d06700d4-81ed-4f86-8996-5787e2d6465d",
                        "source_entry_id": "bc38db1c-9621-32bc-af41-c6a8aed1f903",
                        "source_sense_id": "0c9ce467-ac3a-36f8-8ed5-53649da30bcd",
                        "target_lang_word": "introverted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introverted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d86f7a7-f0a7-369a-93db-dbe5f8180006",
                                        "entry_id": "11cb20bf-38e6-3d40-84cb-680368aaf14a",
                                        "glosses": [
                                            "simple past and past participle of introvert"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "introverted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91a66b7d-ba72-304e-acf3-3197cea38798",
                                        "entry_id": "0573ff2b-df70-33e5-b42f-9f410847e4a5",
                                        "glosses": [
                                            "Turned or thrust inward",
                                            "Thinking about internal or spiritual matters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a90e409d-226c-46a6-ad93-7567df3d8055",
                                                "sense_id": "91a66b7d-ba72-304e-acf3-3197cea38798",
                                                "text": "...Self-searching with an introverted eye..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                        "entry_id": "0573ff2b-df70-33e5-b42f-9f410847e4a5",
                                        "glosses": [
                                            "Turned or thrust inward",
                                            "Of or characteristic of the personality of an introvert: thoughtful, reflective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c0d6ed-b3a0-497e-b83b-f24d663155b6",
                                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                                "text": "An extraverted individual can hardly understand the necessity that forces the introverted to accomplish his adaptation by first formulating a general conception."
                                            },
                                            {
                                                "example_id": "99cb6450-6b3a-4fc6-bf97-fd490977147e",
                                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                                "text": "The introverted type is characterised by the fact that his libido is turned towards his own personality to a certain extent."
                                            },
                                            {
                                                "example_id": "2a8eae35-5ed3-48ab-94af-9726266a8fbe",
                                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                                "text": "There is a tendency to equate ‘introverted’ with ‘withdrawn’ or ‘schizoid’."
                                            },
                                            {
                                                "example_id": "7a77e2d7-5049-412d-9853-a73e42f0a2b6",
                                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                                "text": "This subtle but important distinction means otroverts can blend into both introverted and extroverted environments without fully belonging to either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bfffa25-9a89-3913-881c-54c6977cb2d7",
                                        "entry_id": "0573ff2b-df70-33e5-b42f-9f410847e4a5",
                                        "glosses": [
                                            "Turned or thrust inward",
                                            "Arranged so that two similar words, lines, etc. form the middle of the structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b75a9e-ab52-4cc0-844c-32269e85cb56",
                                                "sense_id": "2bfffa25-9a89-3913-881c-54c6977cb2d7",
                                                "text": "In the Quatrain Reversed or Introverted, the first line corresponds with the fourth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f738e3fc-ed7a-4c82-8fd5-cdfb68a0563b",
                        "source_entry_id": "bc38db1c-9621-32bc-af41-c6a8aed1f903",
                        "source_sense_id": "0c9ce467-ac3a-36f8-8ed5-53649da30bcd",
                        "target_lang_word": "introverti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introverti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ae14e66-f372-3530-b62b-f13ff4971423",
                                        "entry_id": "40e4ce0f-3973-3501-8395-fd17cf1b83c9",
                                        "glosses": [
                                            "Replié sur lui-même, pensif, réfléchi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb9ddda7-942e-46be-96db-2ea4ba835968",
                                                "sense_id": "7ae14e66-f372-3530-b62b-f13ff4971423",
                                                "text": "Si j’étais plutôt introverti, ne dévoilant pas mes sentiments dans l’immédiat, lui était si bavard qu’il avait mérité le surnom de « Mange-Coton », du nom de ces oiseaux qui rapportaient dans l’orphelinat des boules de coton grâce auxquelles ils bâtissaient leurs nids dans la toiture de notre dortoir."
                                            },
                                            {
                                                "example_id": "e6911dc3-5234-41a3-84a3-15cedbad6387",
                                                "sense_id": "7ae14e66-f372-3530-b62b-f13ff4971423",
                                                "text": "Pierrot, le cadet, était un être beaucoup plus introverti, taiseux, avare de sentiments. Au contraire de son aîné, il était doté d’un corps malingre qui semblait l’empêcher de s’épanouir. Et comme si la nature s’était acharnée sur son sort, il bégayait chaque fois qu’il devait s’exprimer en public. Il devenait alors ombrageux et taciturne. Mais tout le monde lui reconnaissait néanmoins un grand cœur, il n’aurait jamais fait le mal autour de lui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "introverti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f10f7be1-0774-3fc3-bbea-c5748188e4b5",
                                        "entry_id": "35d22d21-b2ff-35b1-8863-069d8d47d405",
                                        "glosses": [
                                            "Personne qui communique peu avec les autres, qui a tendance à se suffire de sa vie spirituelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b58bd503-8ba4-3f63-a031-751665993915",
                                        "entry_id": "35d22d21-b2ff-35b1-8863-069d8d47d405",
                                        "glosses": [
                                            "Type de profil psychologique défini par Jung."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c4040f-0973-4514-88f4-e3da5dfdd8ee",
                                                "sense_id": "b58bd503-8ba4-3f63-a031-751665993915",
                                                "text": "Un introverti est souvent assimilé à un craintif, un inhibé, un timide, un réservé, un placide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "introverti",
