                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07566423-4bf7-33ee-b49d-0a37c92902c0",
                        "entry_id": "bdca688a-0fc2-3015-bd77-04d610c78ce4",
                        "glosses": [
                            "Anwender eines Absicherungsgeschäftes; Hedger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e77a66c-98ef-42a1-a671-8fbffca5dcf9",
                                "sense_id": "07566423-4bf7-33ee-b49d-0a37c92902c0",
                                "text": "\"These four types of risks prevent the hedger from forming a perfect hedge (which would have zero risk). Even though the hedger is reducing the amount if risk, it has not been reduced to zero, it is often said that hedging replaces price risk with basis risk.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "54043fa7-f1a1-3096-8933-1c92d811801f",
                        "entry_id": "bdca688a-0fc2-3015-bd77-04d610c78ce4",
