                ],
                "senses": [
                    {
                        "sense_id": "3f724b5f-044c-3b85-a786-09954f0dd6f2",
                        "entry_id": "4a2d5c80-8f64-336b-bd2d-8a3e82a2a324",
                        "glosses": [
                            "pädagogische Einflussnahme mit der Zielsetzung, ein verträgliches gesellschaftliches Miteinander und eine gewaltfreie Völkergemeinschaft zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e47371-2f27-4c1a-a85a-6369d20f78c2",
                                "sense_id": "3f724b5f-044c-3b85-a786-09954f0dd6f2",
                                "text": "„Zielsetzung der Friedenserziehung ist, Kinder, Jugendliche und Erwachsene zu friedensorientiertem Handeln anzuleiten.“"
                            },
                            {
                                "example_id": "d58937c7-9b27-43ef-b9c3-5fd4d55b976a",
                                "sense_id": "3f724b5f-044c-3b85-a786-09954f0dd6f2",
                                "text": "„Sie konkurriert dabei mit anderen übergreifenden Bildungsaufgaben wie der Umwelterziehung, der Gesundheitserziehung, der Sexualerziehung oder der Friedenserziehung.“"
                            },
                            {
                                "example_id": "da11fcac-13fa-439a-bd64-890e4d1819e9",
                                "sense_id": "3f724b5f-044c-3b85-a786-09954f0dd6f2",
                                "text": "„Am selben Tag erklärte der deutsche Lehrerverband in Berlin, Schulen müssten eine globalisierte Werte- und Friedenserziehung betreiben.“"
                            },
                            {
                                "example_id": "70ae8727-754c-4cc7-9b04-3940dca13674",
                                "sense_id": "3f724b5f-044c-3b85-a786-09954f0dd6f2",
                                "text": "„Unter dem Motto Kultur des Friedens wollen die rund 800 Teilnehmer aus Europa, Asien, Afrika und Amerika bis zum Sonntag eine Bilanz der Kriege auf dem Balkan und im Kaukasus ziehen sowie über Rechtsextremismus und Friedenserziehung sprechen.“"
                            },
                            {
                                "example_id": "78f2c9e3-0857-4af9-814f-14cef5882e86",
                                "sense_id": "3f724b5f-044c-3b85-a786-09954f0dd6f2",
                                "text": "„Wenn wir uns wirklich um eine nachhaltige Friedenssicherung bemühen wollen, dann müssen wir viel mehr in eine bewusste Friedenserziehung investieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
