                                "target_senses": [
                                    {
                                        "sense_id": "ab267d11-d175-3329-8fee-35fc3a6ca88c",
                                        "entry_id": "8d731a47-0025-3cc9-b4ed-4154224fca03",
                                        "glosses": [
                                            "Dar, brindar u ofrecer algo, especialmente una gracia, una merced, un premio o un honor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3fcb9ea-5beb-4e8e-8228-9a9f0eb5c2ed",
                                                "sense_id": "ab267d11-d175-3329-8fee-35fc3a6ca88c",
