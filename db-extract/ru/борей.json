                        "examples": [
                            {
                                "example_id": "aa602e0d-21ab-4f80-855f-63f1ddd48e8b",
                                "sense_id": "2ac0fc6d-5a3b-369f-a7ef-7daff0a2ce6b",
                                "text": "Чтобы почтить север, я возьму для капителей не классический лист аканфа, как принято строителями, а листья дуба, вырезанные с таким изяществом природой. Резец запечатлеет в них трепет борея, воздух степных пространств."
                            }
                        ]
                    }
