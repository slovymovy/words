                ],
                "senses": [
                    {
                        "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                        "entry_id": "09ab3b86-7a9b-3a36-a508-9123f02bb5b5",
                        "glosses": [
                            "To find fault (with)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "89962bf2-599f-44eb-9b3a-4034aae1d68f",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "Be not always faultfinding, even when your husband should once in a while stay a little too long from home, or commit some other impropriety, according to your standard of moral measures."
                            },
                            {
                                "example_id": "7f86db00-c050-4a63-873f-05c270564ce4",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "We've fault-found enough for one even."
                            },
                            {
                                "example_id": "a97eebc2-8ec3-45fd-a7ee-2e556dc8531d",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "Do not allow any one to enter your congregation who faultfinds the brethren in the publishing-work and insinuates against the ministry; who says, “The work is drifting into a compromise, and The Gospel Trumpet, which once brought us such inspiring messages, has also compromised.” […]"
                            },
                            {
                                "example_id": "3fc09d8e-5ad6-42a2-bc01-33bca7f499ae",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "How the little ones and I would do the many chores about the house and make all bright and cheery, hoping to please \"Papa,\" but he had always a grievance, was always faultfinding, and if there could be no possible complaint made about thing at home, […]"
                            },
                            {
                                "example_id": "58e6e21d-a2c5-4f2b-a850-2af5945f2338",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "He always seemed angry and needlessly rough with his work as he fumed and fault-found."
                            },
                            {
                                "example_id": "53888d13-058c-40ea-b8bb-dd16a9107863",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "It is normal for politicians to faultfind each other including character smearing."
                            },
                            {
                                "example_id": "22123615-f5fd-4fb5-ac39-4f728da8062b",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "The early adopters, chiefly the semiconductor community, used the instruments to check their production processes and to fault-find when things had gone wrong."
                            },
                            {
                                "example_id": "9fd7e4aa-6a7c-4602-b2ec-795bdaade5a3",
                                "sense_id": "fb925426-e6cf-3bd8-ad39-8bde385b17a9",
                                "text": "No matter what you do, they are prone to fault-find."
                            }
                        ]
                    }
                ],
