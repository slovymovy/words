                    {
                        "translation_id": "93ad2bae-5aca-4abe-9ed0-bc1da288f208",
                        "source_entry_id": "ca0ea649-0e98-393b-a7e5-5edbbb527e57",
                        "source_sense_id": "2ccb8917-2da6-3972-81bf-b25acc103022",
                        "source_sense_description": "physics: a frequency that is a fraction of a fundamental frequency",
                        "target_lang_word": "Unterton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                        "entry_id": "aa2b14bb-b820-3875-90e1-d8a845d778f7",
                                        "glosses": [
                                            "unterschwellige Bedeutung einer Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954c25c3-668c-44b5-86e8-222c952fce68",
                                                "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                                "text": "„Ihnen unterstellt man wohl, dass sie dazu neigen, andere zu diskriminieren. Daher der tadelnde Unterton, der diesem Ausdruck anhaftet.“"
                                            },
                                            {
                                                "example_id": "3938d5f4-78fa-44bd-b4e7-3bfb7a873c9c",
                                                "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                                "text": "Mit drohendem Unterton wurde er aufgefordert zu gehen."
                                            },
                                            {
                                                "example_id": "04985832-39d0-4b3d-940b-72179926bbd6",
                                                "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                                "text": "„Ich empfand das nicht als Spott, obwohl jeder ihrer Sätze einen spöttischen Unterton hatte, ich war glücklich, daß sie etwas sagte, das so genau meiner Stimmung entsprach.“"
                                            },
                                            {
                                                "example_id": "196c1b96-2b43-44d2-9ead-32d2419d66cf",
                                                "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                                "text": "„Die Stimme, die aus der Sprechanlage kam, klang reizend, wenn auch mit einem Unterton von Härte.“"
                                            },
                                            {
                                                "example_id": "032a58b6-4642-467e-9cc3-bc9bf23056d8",
                                                "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                                "text": "„Brian erkundigte sich noch mit scherzhaftem Unterton bei Tom, ob er mit dem Freiheitsgrad seines Schreibtisches zufrieden gewesen sei, es hätte nämlich eine ganze Weile gedauert, die ganzen Bücher und Ordner von dort anderweitig so unterzubringen, dass man sie auch nachher wiederfinden würde, was bei dem Tohuwabohu in diesem Büro gar nicht so einfach gewesen sei.“"
                                            },
                                            {
                                                "example_id": "10448132-9027-4f6a-afe4-d97d3908a2ad",
                                                "sense_id": "e4adcf5f-fad0-3738-bc4f-50e527e6d50e",
                                                "text": "„Auch der Sultan von Bengalen hatte Kanonen, doch er wusste nicht mit ihnen umzugehen, wie Baber mit ironischem Unterton berichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62962001-2b89-3551-a24d-99c6f9033deb",
                                        "entry_id": "aa2b14bb-b820-3875-90e1-d8a845d778f7",
                                        "glosses": [
                                            "„als Spiegelung des Obertons mit dem Grundton mitschwingender Ton“"
                                        ],
