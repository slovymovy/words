    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74d8b707-0a09-38f3-a1fb-dfc1b145d9d1",
                    "sense_definition": "Хватать, захватывать руками или инструментом; принимать в руки, поднимать или перемещать к себе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я всегда <беру> ключи, когда выхожу из дома.",
                            "target_lang_translations": {
                                "en": "I always <take> my keys when I leave the house.",
                                "de": "Ich <nehme> immer meine Schlüssel mit, wenn ich das Haus verlasse."
                            }
                        },
                        {
                            "text": "Не забудь <брать> с собой зонт, сегодня будет дождь.",
                            "target_lang_translations": {
                                "en": "Don't forget to <take> an umbrella with you, it will rain today.",
                                "de": "Vergiss nicht, einen Regenschirm mitzu<nehmen>, heute wird es regnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "хватать",
                        "поднимать"
                    ],
                    "antonyms": [
                        "класть",
                        "бросать",
                        "отпускать"
                    ],
                    "common_phrases": [
                        "брать в руки",
                        "брать с собой",
                        "брать трубку"
                    ],
                    "target_lang_definitions": {
                        "en": "To grab, seize, or accept into one's hands; to pick up or carry.",
                        "de": "Etwas greifen, in die Hand nehmen, aufheben oder zu sich bewegen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "general action"
                            },
                            {
                                "target_lang_word": "pick up",
                                "target_lang_sense_clarification": "lift"
                            },
                            {
                                "target_lang_word": "grab",
                                "target_lang_sense_clarification": "seize quickly"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "allgemeine Handlung"
                            },
                            {
                                "target_lang_word": "mitnehmen",
                                "target_lang_sense_clarification": "bei sich tragen"
                            },
                            {
                                "target_lang_word": "greifen",
                                "target_lang_sense_clarification": "packen, fassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01ce6bea-ea06-3032-a4eb-633d4c8f910f",
                    "sense_definition": "Приобретать что-либо за деньги; покупать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где вы обычно <берёте> свежие овощи и фрукты?",
                            "target_lang_translations": {
                                "en": "Where do you usually <get> fresh vegetables and fruits?",
                                "de": "Wo <kaufen> Sie normalerweise frisches Gemüse und Obst?"
                            }
                        },
                        {
                            "text": "Мы решили не <брать> этот дорогой телевизор.",
                            "target_lang_translations": {
                                "en": "We decided not to <buy> this expensive TV.",
                                "de": "Wir haben beschlossen, diesen teuren Fernseher nicht zu <kaufen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "покупать",
                        "приобретать"
                    ],
                    "common_phrases": [
                        "брать билеты",
                        "брать в кредит",
                        "брать продукты"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление вместо слова «покупать»"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To acquire something in exchange for money; to buy.",
                        "de": "Etwas gegen Geld erwerben; kaufen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "buy",
                                "target_lang_sense_clarification": "purchase"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "acquire/buy"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "purchase (informal)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kaufen",
                                "target_lang_sense_clarification": "erwerben"
                            },
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "auswählen und bezahlen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c47aac3-571f-347f-b374-5b97fbe7e035",
                    "sense_definition": "Получать плату или вознаграждение за работу, услугу или товар.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот адвокат <берёт> за свои услуги очень дорого.",
                            "target_lang_translations": {
                                "en": "This lawyer <charges> a lot for his services.",
                                "de": "Dieser Anwalt <verlangt> sehr viel für seine Dienste."
                            }
                        },
                        {
                            "text": "С детей в этом музее денег за вход не <берут>.",
                            "target_lang_translations": {
                                "en": "They do not <charge> children for admission in this museum.",
                                "de": "Von Kindern wird in diesem Museum kein Eintritt <verlangt>."
                            }
                        }
                    ],
                    "synonyms": [
                        "получать"
                    ],
                    "common_phrases": [
                        "брать деньги",
                        "брать дорого",
                        "брать налог"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To receive payment or demand a price for a service or product.",
                        "de": "Eine Bezahlung oder Gebühr für eine Dienstleistung oder Ware verlangen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "demand payment"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "accept money"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verlangen",
                                "target_lang_sense_clarification": "Geld verlangen"
                            },
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "Geld fordern oder akzeptieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f54ae87-886f-35a2-9250-74783972b81b",
                    "sense_definition": "Охватывать, овладевать (о чувствах, состояниях или эмоциях).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Меня <берёт> сомнение в правильности этого решения.",
                            "target_lang_translations": {
                                "en": "Doubt <seizes> me regarding the correctness of this decision.",
                                "de": "Zweifel <befallen> mich bezüglich der Richtigkeit dieser Entscheidung."
                            }
                        },
                        {
                            "text": "Иногда <берёт> такая тоска, что хочется просто молчать.",
                            "target_lang_translations": {
                                "en": "Sometimes such melancholy <overcomes> me that I just want to be silent.",
                                "de": "Manchmal <packt> einen solche Sehnsucht, dass man einfach nur schweigen möchte."
                            }
                        }
                    ],
                    "synonyms": [
                        "овладевать"
                    ],
                    "antonyms": [
                        "отпускать"
                    ],
                    "common_phrases": [
                        "злость берет",
                        "страх берет",
                        "сон берет"
                    ],
                    "target_lang_definitions": {
                        "en": "To overwhelm, possess, or grip (referring to emotions or states).",
                        "de": "Von Gefühlen, Emotionen oder Zuständen ergriffen oder überwältigt werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overcome",
                                "target_lang_sense_clarification": "emotions"
                            },
                            {
                                "target_lang_word": "seize",
                                "target_lang_sense_clarification": "sudden emotion"
                            },
                            {
                                "target_lang_word": "grip",
                                "target_lang_sense_clarification": "hold firmly"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "befallen",
                                "target_lang_sense_clarification": "von Gefühlen erfasst werden"
                            },
                            {
                                "target_lang_word": "packen",
                                "target_lang_sense_clarification": "plötzliches Gefühl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01acd0c5-73d4-3fc3-87a9-0e02ae62991c",
                    "sense_definition": "Захватывать силой, овладевать контролем над вражеским объектом, городом или крепостью.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генерал приказал армии <брать> город штурмом.",
                            "target_lang_translations": {
                                "en": "The general ordered the army to <take> the city by storm.",
                                "de": "Der General befahl der Armee, die Stadt im Sturm einzu<nehmen>."
                            }
                        },
                        {
                            "text": "Наши войска умеют <брать> укрепления противника без больших потерь.",
                            "target_lang_translations": {
                                "en": "Our troops know how to <capture> enemy fortifications without heavy losses.",
                                "de": "Unsere Truppen verstehen es, feindliche Befestigungen ohne große Verluste einzu<nehmen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "захватывать",
                        "овладевать"
                    ],
                    "antonyms": [
                        "сдавать",
                        "отдавать"
                    ],
                    "common_phrases": [
                        "брать штурмом",
                        "брать в плен",
                        "брать город"
                    ],
                    "target_lang_definitions": {
                        "en": "To gain control of a location or enemy object by force.",
                        "de": "Mit Gewalt die Kontrolle über ein feindliches Objekt, eine Stadt oder eine Festung erlangen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "capture control"
                            },
                            {
                                "target_lang_word": "capture",
                                "target_lang_sense_clarification": "seize by force"
                            },
                            {
                                "target_lang_word": "seize",
                                "target_lang_sense_clarification": "take possession"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einnehmen",
                                "target_lang_sense_clarification": "Stadt oder Festung besetzen"
                            },
                            {
                                "target_lang_word": "erobern",
                                "target_lang_sense_clarification": "durch Gewalt unter Kontrolle bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a822007-c51b-3765-a9a7-04e1a5460cee",
                    "sense_definition": "Снимать фигуру или фишку противника с доски в играх (шахматы, шашки).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой позиции лучше не <брать> коня, а защитить короля.",
                            "target_lang_translations": {
                                "en": "In this position, it is better not to <take> the knight, but to protect the king.",
                                "de": "In dieser Position ist es besser, den Springer nicht zu <schlagen>, sondern den König zu schützen."
                            }
                        },
                        {
                            "text": "Игрок решил <брать> пешку своим слоном.",
                            "target_lang_translations": {
                                "en": "The player decided to <take> the pawn with his bishop.",
                                "de": "Der Spieler beschloss, den Bauern mit seinem Läufer zu <schlagen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "бить",
                        "рубить"
                    ],
                    "common_phrases": [
                        "брать пешку",
                        "брать фигуру",
                        "брать ферзя"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove an opponent's piece from the board in games like chess.",
                        "de": "Eine Figur des Gegners in Brettspielen (z. B. Schach) vom Spielbrett entfernen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "capture a piece"
                            },
                            {
                                "target_lang_word": "capture",
                                "target_lang_sense_clarification": "remove from board"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schlagen",
                                "target_lang_sense_clarification": "eine Spielfigur nehmen"
                            },
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "Spielfigur entfernen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb27b806-ff2f-3746-865b-a0bc3ed37ff9",
                    "sense_definition": "Извлекать звуки на музыкальном инструменте или голосом; исполнять ноту или аккорд.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот оперный певец может легко <брать> очень высокие ноты.",
                            "target_lang_translations": {
                                "en": "This opera singer can easily <hit> very high notes.",
                                "de": "Dieser Opernsänger kann sehr hohe Töne leicht <treffen>."
                            }
                        },
                        {
                            "text": "Гитарист чисто <брал> сложные аккорды на новой гитаре.",
                            "target_lang_translations": {
                                "en": "The guitarist <played> complex chords cleanly on the new guitar.",
                                "de": "Der Gitarrist <griff> die schwierigen Akkorde auf der neuen Gitarre ganz sauber."
                            }
                        }
                    ],
                    "synonyms": [
                        "извлекать"
                    ],
                    "common_phrases": [
                        "брать аккорд",
                        "брать ноту",
                        "брать высокие ноты"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce a specific musical sound, note, or chord.",
                        "de": "Töne auf einem Musikinstrument oder mit der Stimme erzeugen; eine Note oder einen Akkord anstimmen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "a note"
                            },
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "a high note"
                            },
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "a chord"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "treffen",
                                "target_lang_sense_clarification": "einen Ton korrekt singen/spielen"
                            },
                            {
                                "target_lang_word": "greifen",
                                "target_lang_sense_clarification": "einen Akkord auf dem Instrument spielen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf2b2e1-ac87-3e20-97c8-159b368586b9",
                    "sense_definition": "Арестовывать, задерживать преступника.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Оперативники планировали <брать> банду на рассвете.",
                            "target_lang_translations": {
                                "en": "The operatives planned to <bust> the gang at dawn.",
                                "de": "Die Ermittler planten, die Bande im Morgengrauen festzu<nehmen>."
                            }
                        },
                        {
                            "text": "Полиция приехала <брать> подозреваемого прямо в его офисе.",
                            "target_lang_translations": {
                                "en": "The police arrived to <arrest> the suspect right in his office.",
                                "de": "Die Polizei kam, um den Verdächtigen direkt in seinem Büro festzu<nehmen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "арестовывать"
                    ],
                    "antonyms": [
                        "отпускать"
                    ],
                    "common_phrases": [
                        "брать с поличным",
                        "брать живым"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргон правоохранительных органов или криминальный"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To detain or arrest a suspect or criminal.",
                        "de": "Einen Kriminellen oder Verdächtigen festnehmen oder verhaften."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrest",
                                "target_lang_sense_clarification": "legal detention"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "take into custody"
                            },
                            {
                                "target_lang_word": "bust",
                                "target_lang_sense_clarification": "slang"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "festnehmen",
                                "target_lang_sense_clarification": "polizeilich arretieren"
                            },
                            {
                                "target_lang_word": "schnappen",
                                "target_lang_sense_clarification": "umgangssprachlich festnehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8982e2a4-1d53-3e7f-987b-994b4b288ad8",
                    "sense_definition": "Совершать половой акт (часто с оттенком грубости или силы).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старых романах часто описывали, как герои страстно <берут> своих возлюбленных.",
                            "target_lang_translations": {
                                "en": "Old novels often described how heroes passionately <take> their lovers.",
                                "de": "In alten Romanen wurde oft beschrieben, wie die Helden leidenschaftlich ihre Geliebten <nehmen>."
                            }
                        },
                        {
                            "text": "Он пытался <брать> её силой, но получил отпор.",
                            "target_lang_translations": {
                                "en": "He tried to <take> her by force but met resistance.",
                                "de": "Er versuchte, sie mit Gewalt zu <nehmen>, stieß aber auf Widerstand."
                            }
                        }
                    ],
                    "synonyms": [
                        "овладевать"
                    ],
                    "common_phrases": [
                        "брать силой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое или экспрессивное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To perform a sexual act with someone (often implying force or dominance).",
                        "de": "Den Geschlechtsakt vollziehen (oft mit einem Ton von Macht oder Gewalt)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "sexual act"
                            },
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "possess sexually"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nehmen",
                                "target_lang_sense_clarification": "sexuell besitzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}