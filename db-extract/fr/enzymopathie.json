                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903cc860-f0d8-4675-bdb4-a19dcf398de0",
                                "sense_id": "d5946497-9c9e-306b-a3ff-98dfdbce92ff",
                                "text": "Le déficit en G6PD (favisme) est l’enzymopathie la plus répandue dans le monde."
                            },
                            {
                                "example_id": "6d45d9d7-b2e3-4e94-9ad4-46300d885b84",
                                "sense_id": "d5946497-9c9e-306b-a3ff-98dfdbce92ff",
                                "text": "L’atteinte concomitante de tissus d’origine embryologique différente indique qu’elle n’est pas la conséquence d’une embryopathie, mais plutôt celle d’une enzymopathie congénitale."
                            }
                        ]
                    }
