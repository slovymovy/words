                        ]
                    },
                    {
                        "translation_id": "643986fc-67a0-4731-a9a3-1e9442654de4",
                        "source_entry_id": "7ce2a3fe-242a-37d6-ac66-161d4250ed7e",
                        "source_sense_description": "Any mollusc of taxonomic class Bivalvia",
                        "target_lang_word": "bivalve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bivalve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "492bd20a-a160-327e-bddc-c2497414d0ac",
                                        "entry_id": "d98bdd58-e3a9-3193-9eb7-139841a7f721",
                                        "glosses": [
                                            "Qui est formé de deux pièces ou valves."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb29e55-9b02-4e21-8ae9-3d9cb2e28be2",
                                                "sense_id": "492bd20a-a160-327e-bddc-c2497414d0ac",
                                                "text": "Coquille, coquillage bivalve."
                                            },
                                            {
                                                "example_id": "2dfab807-dcf3-48c4-9148-67901e4b393b",
                                                "sense_id": "492bd20a-a160-327e-bddc-c2497414d0ac",
                                                "text": "La capsule du lilas, le noyau de la pêche sont bivalves."
                                            },
                                            {
                                                "example_id": "594256fc-a8bb-4631-9913-2bd7e8092f60",
                                                "sense_id": "492bd20a-a160-327e-bddc-c2497414d0ac",
                                                "text": "La petite troupe foula un sable composé de débris de coquilles bivalves, d’os de seiche, et mélangé dans une grande proportion de peroxyde et de protoxyde de fer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bivalve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                        "entry_id": "ded8e684-e4f3-3ac7-9de4-651c279fd983",
                                        "glosses": [
                                            "Mollusque qui a la particularité d’avoir une coquille à charnière composée de deux valves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ddbc92e-9dea-4b47-a96c-3c0c072734b8",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "Les huîtres, les moules sont des bivalves."
                                            },
                                            {
                                                "example_id": "60863ac7-798b-4815-acca-6d5e6dd43142",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "Beaucoup moins connue que la moule de bouchot, que l’on savoure à l’arrivée des beaux jours sur la terrasse d’un restaurant face à la mer, la moule ou mulette perlière d’eau douce fait partie de la trentaine d’espèces de bivalves présente dans nos rivières."
                                            },
                                            {
                                                "example_id": "5fabd067-4278-430d-8276-093721817b2f",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "Comme les Mollusques du groupe des Bivalves (moules, huîtres, palourdes, etc.), les Brachiopodes dissimulent leur corps mou dans une coquille calcaire possédant deux valves articulées. Cette similarité frappante avec les Bivalves constitue un exemple célèbre de convergence évolutive."
                                            },
                                            {
                                                "example_id": "6a50e1c7-b883-4db7-9da4-2e0a5b271db2",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "La coque est un des bivalves les plus connus en Europe. On en trouve les coquilles depuis l’Islande jusqu’en Afrique occidentale, ou encore sur les bords de la mer Caspienne."
                                            },
                                            {
                                                "example_id": "4c787be9-c927-463a-889a-f30817a07497",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "Certains bivalves, comme les coquilles Saint-Jacques, peuvent se déplacer par une propulsion à réaction: ils expulsent l’eau vers l’arrière en refermant fortement leurs valves ce qui déplace l’animal vers l'avant, comme un avion à réaction."
                                            },
                                            {
                                                "example_id": "d35a7362-65ec-42b7-b3c5-fecf2a86fc3e",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "Les Mayas de Tikal ont aussi été séduits par les spondyles des deux océans. Le dieu du maïs porte un spondyle à la ceinture, reprenant la vieille association entre le bivalve et la fertilité."
                                            },
                                            {
                                                "example_id": "06cbdd97-8a84-46e2-b785-37a5e07e9139",
                                                "sense_id": "b971cdb3-7ca8-3974-a8fc-f43f5a128162",
                                                "text": "De nombreux bivalves ont par exemple une mobilité nulle ou presque dès la métamorphose larvaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
