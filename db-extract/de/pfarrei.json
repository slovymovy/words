                ],
                "senses": [
                    {
                        "sense_id": "048bed19-67ea-31b3-aa3b-5655ad06a0cb",
                        "entry_id": "498a3711-af40-3380-aec8-7f090c7c6b9d",
                        "glosses": [
                            "von einem Pfarrer geleitete, unterste kirchliche Behörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9d9dcc-0eee-436d-9eb5-72507fac6b14",
                                "sense_id": "048bed19-67ea-31b3-aa3b-5655ad06a0cb",
                                "text": "„Um 1500 bestanden in dem Raum der heutigen Kreise 112 Mutterkirchen mit Pfarreien und außerdem noch ca. 80 Filialkirchen.“"
                            },
                            {
                                "example_id": "5cc654d9-ffa3-47de-aa3b-85255cca8454",
                                "sense_id": "048bed19-67ea-31b3-aa3b-5655ad06a0cb",
                                "text": "„In jeder der zweiundsiebzig Pfarreien der Stadt Venedig gibt es eine große Weinstube, die man Magazzeno nennt, wo man die ganze Nacht hindurch Wein ausschenkt und billiger trinken kann, als in den anderen Weinstuben der Stadt, in denen man auch zu essen erhält.“"
                            },
                            {
                                "example_id": "0200164f-3f29-468b-8d08-d0a867e08cee",
                                "sense_id": "048bed19-67ea-31b3-aa3b-5655ad06a0cb",
                                "text": "„In Bayern hat die CSU-Staatsregierung längst angefangen, aufmüpfige Pfarreien an die Kandare zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff62e4db-4f0a-3cb8-92ac-858f28efbbf2",
                        "entry_id": "498a3711-af40-3380-aec8-7f090c7c6b9d",
                        "glosses": [
                            "Haus mit der Dienstwohnung und den Amtsräumen eines Pfarrers"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e771fdb-fe44-4f1a-ac33-9f977921dd1c",
                        "source_entry_id": "498a3711-af40-3380-aec8-7f090c7c6b9d",
                        "source_sense_id": "048bed19-67ea-31b3-aa3b-5655ad06a0cb",
                        "source_sense_description": "von einem Pfarrer geleitete, unterste kirchliche Behörde",
                        "target_lang_word": "parish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b016cfb5-5f6b-32f2-b820-9dafdd884a26",
                                        "entry_id": "51ca4cb4-964a-332c-81bf-3bf429d8bc45",
                                        "glosses": [
                                            "An administrative part of a diocese that has its own church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af60377d-9948-42eb-a15f-97717870c2aa",
                                                "sense_id": "b016cfb5-5f6b-32f2-b820-9dafdd884a26",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "caadc24b-8b6d-4d56-81f5-2b1d81f0237d",
                                                "sense_id": "b016cfb5-5f6b-32f2-b820-9dafdd884a26",
                                                "text": "Near-synonym: vicarate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb9f8b5-543a-3018-9641-eb872528da8e",
                                        "entry_id": "51ca4cb4-964a-332c-81bf-3bf429d8bc45",
                                        "glosses": [
                                            "The community attending that church; the members of the parish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc428728-e852-341a-afd4-b742d2c92709",
                                        "entry_id": "51ca4cb4-964a-332c-81bf-3bf429d8bc45",
                                        "glosses": [
                                            "An ecclesiastical society, usually not bounded by territorial limits, but composed of those persons who choose to unite under the charge of a particular priest, clergyman, or minister; also, loosely, the territory in which the members of a congregation live."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "571e3138-2cb7-36a1-8a0e-4c6e69aab982",
                                        "entry_id": "51ca4cb4-964a-332c-81bf-3bf429d8bc45",
                                        "glosses": [
                                            "A civil subdivision of a British county, often corresponding to an earlier ecclesiastical parish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be7cc41-d821-49d5-8d39-b5cc9b4e2241",
                                                "sense_id": "571e3138-2cb7-36a1-8a0e-4c6e69aab982",
                                                "text": "Atlantic gales constantly buffet Morwenstow, whose seven hamlets together constitute Cornwall's most northerly parish. The village is dotted with trees moulded into weird shapes by the wind, and above the trees rise the vicarage chimneystacks resembling miniature church towers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5e697d-4ce0-3cc5-ac67-77841c2e2e5b",
                                        "entry_id": "51ca4cb4-964a-332c-81bf-3bf429d8bc45",
                                        "glosses": [
                                            "In some countries, an administrative subdivision of an area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80797695-49ac-32aa-b157-93a35746167a",
                                        "entry_id": "51ca4cb4-964a-332c-81bf-3bf429d8bc45",
                                        "glosses": [
                                            "In some countries, an administrative subdivision of an area.",
                                            "An administrative subdivision in the U.S. state of Louisiana that is equivalent to a county in other U.S. states."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "parish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61d6f3b2-d09c-3525-8115-e1b14947e000",
                                        "entry_id": "79aa5613-685a-3b44-91f5-0523628db3c3",
                                        "glosses": [
                                            "To place (an area, or rarely a person) into one or more parishes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a03fd9b-f5ca-4ca9-a755-3c0f879a3969",
                                                "sense_id": "61d6f3b2-d09c-3525-8115-e1b14947e000",
                                                "text": "[…] [m]akes possible, through the aid of the rural ministers, the development of the various phases of the District program, such as (a) Parishing of the District; (b) Interdenominational adjustment in the interest of rural religious advance […]"
                                            },
                                            {
                                                "example_id": "31f6b2b7-7ffa-42fe-81f4-73f388c04ab5",
                                                "sense_id": "61d6f3b2-d09c-3525-8115-e1b14947e000",
                                                "text": "Father Malachy, a distant cousin, who was parished somewhere in the depths of Co. Monaghan, sat firmly in the chair in the corner, sipping his tea from a china cup."
                                            },
                                            {
                                                "example_id": "855c8cfe-55ea-4bd2-a42f-6010c69f50fd",
                                                "sense_id": "61d6f3b2-d09c-3525-8115-e1b14947e000",
                                                "text": "Consequently, approaching half of the non-metropolitan population of England is parished (Table 2.2).\n[…]\nThe South West and East Midlands are also particularly well parished while the North West, West Midlands and South East are poorly parished."
                                            },
                                            {
                                                "example_id": "fc97fe7b-fda4-4f18-b800-dc8d828fca0d",
                                                "sense_id": "61d6f3b2-d09c-3525-8115-e1b14947e000",
                                                "text": "Dr Whitehead: In your written evidence, you have all in different ways made the distinction between NDOs in parished areas and NDOs in non-parished areas, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3e47a6-613a-324e-892a-80834cc5b671",
                                        "entry_id": "79aa5613-685a-3b44-91f5-0523628db3c3",
                                        "glosses": [
                                            "To visit residents of a parish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a0409b-f1c2-44c5-9115-be4699a5cfce",
                                                "sense_id": "4a3e47a6-613a-324e-892a-80834cc5b671",
                                                "text": "[…] a chair immediately opposite to Tressady's place remained vacant. It was being kept for the eldest son of the house, his mother explaining carelessly to Lord Fontenoy that she believed he was \"Out parishing somewhere, as usual.\""
                                            },
                                            {
                                                "example_id": "ba96801d-551e-4525-a36b-7ed6511900e9",
                                                "sense_id": "4a3e47a6-613a-324e-892a-80834cc5b671",
                                                "text": "\"You will take pleasure in parishing. Mother used to parish.\"\n\"How do you know I like parishing?\"\n\"Your uncle said so.\"\n\"Oh! did he?\"\n\"And you may like the rectory people; it's a fine old house, and often full of visitors.\""
                                            },
                                            {
                                                "example_id": "805eb5a2-e5d8-497e-85d1-55a855aa68b0",
                                                "sense_id": "4a3e47a6-613a-324e-892a-80834cc5b671",
                                                "text": "\"Are you going ‘parishing’ this morning?\" inquired Diana, as she watched him fill and light his pipe."
                                            },
                                            {
                                                "example_id": "57d2af58-a576-47b1-b00a-9a651e6b15ff",
                                                "sense_id": "4a3e47a6-613a-324e-892a-80834cc5b671",
                                                "text": "In 1916 he was Rector of Hampton Bishop, a village on the River Wye outside Hereford, and one day while “parishing”, as he called visiting his flock, a farmers' wife, a Mrs. Christopher Field, gave him an account of her father's death-bed; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d98456d-1e9a-33e1-b3fa-0517491a54f3",
                                        "entry_id": "00c2ff0a-6e39-3478-ac84-a98d8fd1dc0f",
                                        "glosses": [
                                            "Pronunciation spelling of perish, representing Mary–marry–merry merger English."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a2e2f01-786f-4c6b-bd78-13022050c735",
                        "source_entry_id": "498a3711-af40-3380-aec8-7f090c7c6b9d",
                        "source_sense_id": "048bed19-67ea-31b3-aa3b-5655ad06a0cb",
                        "source_sense_description": "von einem Pfarrer geleitete, unterste kirchliche Behörde",
                        "target_lang_word": "paroisse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paroisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55475aa3-6aa5-3ba0-be74-75fd188e8894",
                                        "entry_id": "c66e7226-3d8d-3d0f-aabb-8c5e2dffd363",
                                        "glosses": [
                                            "Division ecclésiastique où s’exerce le ministère d’un curé ou d'un pasteur."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985e887e-64c7-44d3-9525-32d04226c059",
                                                "sense_id": "55475aa3-6aa5-3ba0-be74-75fd188e8894",
                                                "text": "Les habitants de la paroisse de Valroufié, chef-lieu de section de la commune de Laroque-des-Arcs, ont formé une demande, reproduite plusieurs fois depuis 1813, pour obtenir que leur territoire soit séparé de cette commune et érigé en commune distincte, comme il était en 1800."
                                            },
                                            {
                                                "example_id": "12990a9b-7da1-4b51-9b1f-a0373ad92ac2",
                                                "sense_id": "55475aa3-6aa5-3ba0-be74-75fd188e8894",
                                                "text": "Une occasion pour nous de découvrir le label Église Verte qui propose d’accompagner les paroisses et associations vers plus d’écologie au quotidien. !"
                                            },
                                            {
                                                "example_id": "5e785d9e-0f94-489a-8dae-8abf5e8e05de",
                                                "sense_id": "55475aa3-6aa5-3ba0-be74-75fd188e8894",
                                                "text": "Le curé de Melotte était donc encore universellement aimé et respecté : n’était-il pas un des plus vieux du village et des plus anciens de la paroisse !"
                                            },
                                            {
                                                "example_id": "59a6689d-98bc-477c-957e-f13e5286e389",
                                                "sense_id": "55475aa3-6aa5-3ba0-be74-75fd188e8894",
                                                "text": "La paroisse compte une trentaine de feux, assez peu de fidèles."
                                            },
                                            {
                                                "example_id": "30525def-3015-4f48-86b9-19fb5b377281",
                                                "sense_id": "55475aa3-6aa5-3ba0-be74-75fd188e8894",
                                                "text": "Pour l’élection du député direct, la municipalité […] obtint du Garde des sceaux l’autorisation de réunir indistinctement dans les paroisses tous les membres du tiers, corporés ou non corporés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5343266a-5446-39f0-aaaf-1e9814a6af5d",
                                        "entry_id": "c66e7226-3d8d-3d0f-aabb-8c5e2dffd363",
                                        "glosses": [
                                            "Église paroissiale."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8818fcdc-a6e4-4f44-8f8e-68ab8b1c4838",
                                                "sense_id": "5343266a-5446-39f0-aaaf-1e9814a6af5d",
                                                "text": "Le jour où j’ai visité cet établissement, on célébrait la première communion à la paroisse de Vaugirard. Les enfants sortaient de l’église; les rues étaient remplies de petites filles en robes blanches, et de petits garçons avec un ruban au bras […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "767ed65f-6d82-3749-a758-63c0f9581af2",
                                        "entry_id": "c66e7226-3d8d-3d0f-aabb-8c5e2dffd363",
                                        "glosses": [
                                            "Communauté des paroissiens."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf90856d-7e4e-45d0-a8d0-84becc95d0e0",
                                                "sense_id": "767ed65f-6d82-3749-a758-63c0f9581af2",
                                                "text": "En troisième lieu, viendra la communauté ecclésiastique ou paroisse, avec ses divers officiers et son assemblée, avec les affaires de l’église et celles des pauvres."
                                            },
                                            {
                                                "example_id": "45096397-1071-4bf4-9cd8-3adbf3ec17ff",
                                                "sense_id": "767ed65f-6d82-3749-a758-63c0f9581af2",
                                                "text": "Le plus important devenait, pour Marie, son intégration dans sa nouvelle paroisse, faire connaissance tant avec les grenouilles de bénitiers qu’avec les paroissiens plus ou moins occasionnels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
