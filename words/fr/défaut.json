    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52cbb9d2-f7c1-3190-8228-0f0eded0a660",
                    "sense_definition": "Imperfection liée au caractère, à la personnalité ou aux habitudes d'une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imperfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chacun a ses petits <w>défauts</w>, mais il faut apprendre à vivre ensemble."
                        },
                        {
                            "text": "Pendant l'entretien d'embauche, il a dû citer trois qualités et trois <w>défauts</w>."
                        }
                    ],
                    "synonyms": [
                        "imperfection",
                        "travers"
                    ],
                    "antonyms": [
                        "qualité"
                    ],
                    "common_phrases": [
                        "qualités et défauts",
                        "petits défauts"
                    ]
                },
                {
                    "sense_id": "ffb90003-26a2-3b20-9912-3e83ace23c15",
                    "sense_definition": "Imperfection ou altération qui nuit à la forme, à l'aspect ou à la solidité d'un objet matériel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imperfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette veste neuve a un léger <w>défaut</w> de fabrication sur la manche droite."
                        },
                        {
                            "text": "Le mécanicien a vérifié la carrosserie pour s'assurer qu'elle était sans <w>défaut</w>."
                        }
                    ],
                    "synonyms": [
                        "anomalie",
                        "imperfection",
                        "vice"
                    ],
                    "antonyms": [
                        "perfection"
                    ],
                    "common_phrases": [
                        "défaut de fabrication",
                        "sans défaut"
                    ]
                },
                {
                    "sense_id": "b730da29-d8db-3c08-a0c0-a455a9994246",
                    "sense_definition": "Absence, privation ou manque de quelque chose qui serait nécessaire ou utile.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le courage lui a fait <w>défaut</w> au moment d'annoncer la mauvaise nouvelle."
                        },
                        {
                            "text": "À <w>défaut</w> de beurre, nous pouvons utiliser un peu d'huile d'olive pour la recette."
