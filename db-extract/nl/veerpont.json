                                        "sense_id": "31ba3416-4bd7-36e8-9eb1-509ef3f9d913",
                                        "entry_id": "6f5471b4-1311-352d-aa4d-abf1f7ddc151",
                                        "glosses": [
                                            "spezielles Schiff, das der (gewerbsmäßigen) Beförderung von Personen und/oder Transportmitteln von Ufer zu Ufer dient"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e62017-172e-4753-b68c-1494642b5a59",
                                                "sense_id": "31ba3416-4bd7-36e8-9eb1-509ef3f9d913",
                                                "text": "Wir fuhren mit der Fähre über den Bodensee."
                                            },
                                            {
                                                "example_id": "4aab2bf2-b6dd-491d-8f95-27fa31fb31c2",
                                                "sense_id": "31ba3416-4bd7-36e8-9eb1-509ef3f9d913",
                                                "text": "„Die Leute fanden sich langsam am Kai ein, und kurz darauf legte die Fähre an.“"
                                            },
                                            {
                                                "example_id": "6ace47d8-fa6d-4b0f-93a4-2e9dae4100cf",
                                                "sense_id": "31ba3416-4bd7-36e8-9eb1-509ef3f9d913",
                                                "text": "„Die Fähre kommt herüber.“"
                                            },
                                            {
                                                "example_id": "cf7d380a-02fc-4ded-ac1a-333838fed769",
                                                "sense_id": "31ba3416-4bd7-36e8-9eb1-509ef3f9d913",
                                                "text": "„Ich wollte mit der Fähre von Stockholm nach Turku übersetzen.“"
                                            },
                                            {
                                                "example_id": "c665d96f-f5e0-4050-a63c-09fdeb6f7fd5",
                                                "sense_id": "31ba3416-4bd7-36e8-9eb1-509ef3f9d913",
                                                "text": "„Die große Fähre im Hafen von Tarifa hatte ihre Fracht aufgenommen und legte ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
