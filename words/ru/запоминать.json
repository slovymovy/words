{
    "word_family": [
        "память",
        "памятный",
        "памятник",
        "запоминание",
        "запоминающийся"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db1f2cf5-6d9e-3b39-8ef4-7d43e3563f3c",
                    "sense_definition": "Удерживать информацию в памяти, сохранять в сознании.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старайся <w>запоминать</w> важные детали во время лекции.",
                            "target_lang_translations": {
                                "en": "Try to <w>remember</w> important details during the lecture."
                            }
                        },
                        {
                            "text": "Мне трудно <w>запоминать</w> новые иностранные слова без практики.",
                            "target_lang_translations": {
                                "en": "It is difficult for me to <w>remember</w> new foreign words without practice."
                            }
                        }
                    ],
                    "synonyms": [
                        "помнить"
                    ],
                    "antonyms": [
                        "забывать"
                    ],
                    "common_phrases": [
                        "запоминать детали",
                        "запоминать слова"
                    ],
                    "target_lang_definitions": {
                        "en": "To retain information in one's memory or keep it in one's consciousness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remember",
                                "target_lang_sense_clarification": "To keep information in one's mind or recall it naturally."
                            },
                            {
                                "target_lang_word": "keep in mind",
                                "target_lang_sense_clarification": "To hold information in one's thoughts for future reference."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e9e713d-dcf1-3430-90b1-8465ffb29a17",
                    "sense_definition": "Учить наизусть, прилагать усилия для фиксации информации в памяти.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты должны <w>запоминать</w> даты исторических событий для экзамена.",
                            "target_lang_translations": {
                                "en": "Students must <w>memorize</w> the dates of historical events for the exam."
                            }
                        },
                        {
                            "text": "Чтобы лучше <w>запоминать</w> стихи, нужно читать их вслух несколько раз.",
                            "target_lang_translations": {
                                "en": "To <w>memorize</w> poems better, you need to read them aloud several times."
                            }
                        }
                    ],
                    "synonyms": [
                        "заучивать"
                    ],
                    "antonyms": [
                        "забывать"
                    ],
                    "common_phrases": [
                        "запоминать даты",
                        "запоминать текст"
                    ],
                    "target_lang_definitions": {
                        "en": "To learn by heart or make a conscious effort to fix information in one's memory."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "memorize",
                                "target_lang_sense_clarification": "To commit something to memory through study or repetition."
                            },
                            {
                                "target_lang_word": "learn by heart",
                                "target_lang_sense_clarification": "To study something until it can be repeated from memory."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}