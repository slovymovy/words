                ],
                "senses": [
                    {
                        "sense_id": "50d39824-14b3-313f-a159-21bfcf52ebc2",
                        "entry_id": "721e3bdb-5ceb-3bdc-8edf-e4626f79006a",
                        "glosses": [
                            "Faire cesser d’être ravi, d'être très content."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b37e96cd-c604-4217-9278-4004411d80d0",
                                "sense_id": "50d39824-14b3-313f-a159-21bfcf52ebc2",
                                "text": "Durtal s’installa pour entendre la messe que l’on sonnait ; il avait beau la connaître par cœur, cette messe ne parvenait pas à le déravir."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1bcaeae-f676-3f48-8d88-9ffb6f990134",
                        "entry_id": "721e3bdb-5ceb-3bdc-8edf-e4626f79006a",
                        "glosses": [
                            "Parfois plus proche de mécontenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a515cda-aadb-4161-9d71-2897adff425b",
                                "sense_id": "b1bcaeae-f676-3f48-8d88-9ffb6f990134",
                                "text": "Faut que je précise quelque chose qui va vous ravir et déravir !"
                            },
                            {
                                "example_id": "f9e26463-3b6c-43d0-857c-d2ef3ed1b44a",
                                "sense_id": "b1bcaeae-f676-3f48-8d88-9ffb6f990134",
                                "text": "Cependant, Drannok se morfondait dans sa cage et il reçut une visite qui le déravit (c’est comme « ravit » mais à l’envers) au plus haut point."
                            }
                        ]
                    }
                ],
