                "senses": [
                    {
                        "sense_id": "c9fb7af1-6285-3a53-9c49-bd2f53899aae",
                        "entry_id": "d1ae048a-0ccc-3e4b-9f2d-94cd119f468d",
                        "glosses": [
                            "vernoemd naar Erasmus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbcf185-a3a4-4e84-be6a-25b575623c8e",
                                "sense_id": "c9fb7af1-6285-3a53-9c49-bd2f53899aae",
                                "text": "Het ziekenhuis Erasmus MC, de Hogeschool Rotterdam en het Erasmiaans Gymnasium lieten in augustus weten zo'n rookverbod rond hun panden bij de Wytemaweg te willen instellen."
                            },
                            {
                                "example_id": "84110c15-9b87-42ac-84ee-5ef82f67994d",
                                "sense_id": "c9fb7af1-6285-3a53-9c49-bd2f53899aae",
                                "text": "Ook de plaatsingwijzer die Rotterdamse scholen gebruiken doet veel stof opwaaien. Vijf scholen zouden de regels hebben overtreden. Sommige scholen, zoals het Erasmiaans Gymnasium, maken daar geen geheim van. Zij vragen op hun website openlijk om eerdere toetsresultaten."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6078ad1-36ed-3975-8e09-b62442cccf69",
                        "entry_id": "d1ae048a-0ccc-3e4b-9f2d-94cd119f468d",
                        "glosses": [
                            "in de stijl en geest van Erasmus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814a56a4-214f-41f0-9fe0-d76d7bc85536",
                                "sense_id": "c6078ad1-36ed-3975-8e09-b62442cccf69",
                                "text": "De Zuid-Afrikaanse komiek Trevor Noah krijgt dit najaar de Erasmusprijs. Volgens de jury van de Nederlandse Stichting Praemium Erasmianum handelt Noah ‘met zijn enorme talent voor spottende, talige en verbindende politieke humor in Erasmiaanse geest’. Hij draagt daarmee bij aan het thema ‘Lof der Zotheid’ naar het beroemdste boek van Erasmus."
                            }
                        ]
                    }
