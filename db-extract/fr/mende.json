                            {
                                "example_id": "014b5fa5-d6e9-474e-99c6-5628c4b10c19",
                                "sense_id": "1fe48461-c8a0-321e-a13e-153551d1d88e",
                                "text": "La carte me disait qu’avant d’arriver à Clermont, la ville la plus importante qui se trouvait sur notre route était Mende. Mende était-elle vraiment une ville importante, c’était ce que je ne savais pas, mais comme le caractère dans lequel son nom était écrit sur la carte lui donnait cette importance, je ne pouvais que croire ma carte."
                            },
                            {
                                "example_id": "4e800061-ff04-4614-82d5-a60800201b41",
                                "sense_id": "1fe48461-c8a0-321e-a13e-153551d1d88e",
                                "text": "Si vous aviez pris le temps d’attraper une carte, puis de tracer une ligne droite entre Alès et Mende, vous seriez à coup sûr passé par ce coin paumé des Cévennes."
                            }
                        ]
