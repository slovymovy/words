                                    {
                                        "sense_id": "3d18d10c-055a-3e9e-a94e-a36161632806",
                                        "entry_id": "4aada266-0689-37b0-9ccd-8113c0628d8d",
                                        "glosses": [
                                            "Friedhof"
                                        ],
