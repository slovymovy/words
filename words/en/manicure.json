{
    "word_family": [
        "manicurist",
        "manicured"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0a61636-cec8-362e-8327-f288aacab6c9",
                    "sense_definition": "A cosmetic treatment for the fingernails and hands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gets a fresh <w>manicure</w> at the beauty salon every two weeks.",
                            "target_lang_translations": {
                                "pl": "Co dwa tygodnie robi sobie świeży <w>manicure</w> w salonie kosmetycznym."
                            }
                        },
                        {
                            "text": "I need to get a <w>manicure</w> before the wedding ceremony this Saturday.",
                            "target_lang_translations": {
                                "pl": "Muszę zrobić <w>manicure</w> przed sobotnią ceremonią ślubną."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a manicure"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zabieg kosmetyczny polegający na pielęgnacji dłoni i paznokci u rąk."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "manicure",
                                "target_lang_sense_clarification": "najczęściej używane określenie zabiegu"
                            },
                            {
                                "target_lang_word": "manikiur",
                                "target_lang_sense_clarification": "poprawna forma spolszczona"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad01db79-b9ee-3976-b3d3-e4b5dbd34b52",
                    "sense_definition": "A person whose job is to give cosmetic treatments to people's hands and nails.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salon hired a new <w>manicure</w> to help handle the weekend rush.",
                            "target_lang_translations": {
                                "pl": "Salon zatrudnił nową <w>manikiurzystkę</w>, aby pomogła obsłużyć weekendowy ruch."
                            }
                        },
                        {
                            "text": "She decided to work as a <w>manicure</w> after finishing her cosmetology training.",
                            "target_lang_translations": {
                                "pl": "Po ukończeniu szkolenia kosmetycznego zdecydowała się pracować jako <w>manikiurzystka</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "manicurist"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba zajmująca się profesjonalną pielęgnacją dłoni i paznokci."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "manikiurzystka",
                                "target_lang_sense_clarification": "osoba wykonująca zabieg"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ea2f64a-8fc3-34f9-8c96-6d78acbad5c4",
                    "sense_definition": "To care for, shape, and polish someone's fingernails and hands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves to <w>manicure</w> her nails while watching her favorite TV show.",
                            "target_lang_translations": {
                                "pl": "Uwielbia <w>robić manicure</w>, oglądając swój ulubiony serial."
                            }
                        },
                        {
                            "text": "The esthetician carefully <w>manicured</w> her client's hands before applying the red polish.",
                            "target_lang_translations": {
                                "pl": "Kosmetyczka starannie <w>wypielęgnowała</w> dłonie klientki przed nałożeniem czerwonego lakieru."
                            }
                        }
                    ],
                    "common_phrases": [
                        "manicure nails"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dbać o paznokcie i dłonie, nadawać im kształt i malować je."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "robić manicure",
                                "target_lang_sense_clarification": "wykonywać zabieg pielęgnacyjny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fbb6e51-b7f5-35e9-a632-67c91f4eecad",
                    "sense_definition": "To trim or care for something, like a lawn or garden, very precisely and neatly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener works hard every morning to <w>manicure</w> the lawn.",
                            "target_lang_translations": {
                                "pl": "Ogrodnik ciężko pracuje każdego ranka, aby <w>przystrzyc</w> trawnik."
                            }
                        },
                        {
                            "text": "They spent hours taking care of the estate to maintain the <w>manicured</w> lawn.",
                            "target_lang_translations": {
                                "pl": "Spędzili godziny na dbaniu o posiadłość, aby utrzymać <w>wypielęgnowany</w> trawnik."
                            }
                        }
                    ],
                    "synonyms": [
                        "trim",
                        "groom"
                    ],
                    "common_phrases": [
                        "manicure the lawn"
                    ],
                    "target_lang_definitions": {
                        "pl": "Precyzyjnie przycinać lub pielęgnować coś, np. trawnik lub ogród."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "strzyc",
                                "target_lang_sense_clarification": "w odniesieniu do trawnika"
                            },
                            {
                                "target_lang_word": "pielęgnować",
                                "target_lang_sense_clarification": "w odniesieniu do ogrodu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}