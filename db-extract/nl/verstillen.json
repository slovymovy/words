        "nl-extract.jsonl": [
            {
                "entry_id": "de38bd0e-4934-3322-8ac2-faf8979947db",
                "word": "verstillen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be837410-e382-3f8d-8317-b02005f7f809",
                        "entry_id": "de38bd0e-4934-3322-8ac2-faf8979947db",
                        "glosses": [
                            "steeds minder luid worden totdat het helemaal stil is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1e6b5a-440c-484c-9d03-ee5f9236d88d",
                                "sense_id": "be837410-e382-3f8d-8317-b02005f7f809",
                                "text": "Het theater- en muziektweetal speelde haar slotakkoorden in grootse vorm, met een programma waarin wel wat grappen en anekdotes zaten, maar waar vooral muziek werd gemaakt. Gesteund door hun vaste band swingen de twee waar gewenst, rocken ze waar moeten. Verstillen, versnellen, eenvoudig of fantasierijk: allemaal geen enkel probleem na bijna twintig jaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb908b01-3fc4-3fcb-8c8e-ac7227f46d1c",
                        "entry_id": "de38bd0e-4934-3322-8ac2-faf8979947db",
                        "glosses": [
                            "tot stilstand komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e7f30c8-f42a-4279-919d-c2185c7e3f65",
                                "sense_id": "cb908b01-3fc4-3fcb-8c8e-ac7227f46d1c",
                                "text": "De groepsvariaties zijn hectisch, sprankelend, energiek en verstillen in een freeze: de choreografie Memory of a Shape is een aanwinst. De dansers zijn lichamen die in samenklonteringen tot hun uiteindelijke positie komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44d3eaf0-680b-4aa9-9f81-491bcc9e5a07",
                        "source_entry_id": "de38bd0e-4934-3322-8ac2-faf8979947db",
                        "source_sense_id": "be837410-e382-3f8d-8317-b02005f7f809",
                        "source_sense_description": "minder luid worden",
                        "target_lang_word": "become silent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6b7a156e-b84d-435e-a8f4-6bf5ef995567",
                        "source_entry_id": "de38bd0e-4934-3322-8ac2-faf8979947db",
                        "source_sense_id": "cb908b01-3fc4-3fcb-8c8e-ac7227f46d1c",
                        "source_sense_description": "tot stilstand komen",
                        "target_lang_word": "freeze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "285d5ee9-a20f-339a-88fc-c5e2b7e2e912",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "Especially of a liquid, to become solid due to low temperature."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4986c4e-e63a-435e-a819-89ffeaba8681",
                                                "sense_id": "285d5ee9-a20f-339a-88fc-c5e2b7e2e912",
                                                "text": "The lake froze solid."
                                            },
                                            {
                                                "example_id": "cb31f194-f8e2-4e79-887c-11bc0c7137e4",
                                                "sense_id": "285d5ee9-a20f-339a-88fc-c5e2b7e2e912",
                                                "text": "1855, Henry Wadsworth Longfellow, The Song of Hiawatha, Book XX: The Famine,\nEver thicker, thicker, thicker / Froze the ice on lake and river,"
                                            },
                                            {
                                                "example_id": "928211d9-d6a4-42ad-a555-b1fe0d0be6a3",
                                                "sense_id": "285d5ee9-a20f-339a-88fc-c5e2b7e2e912",
                                                "text": "He got to Dawson before the river froze, and now I suppose I won't hear any more until spring."
                                            },
                                            {
                                                "example_id": "c3fa11ad-bc0d-41ec-97f2-6f2c96f0d8f6",
                                                "sense_id": "285d5ee9-a20f-339a-88fc-c5e2b7e2e912",
                                                "text": "1915, Eleanor Stackhouse Atkinson, The How and Why Library: Wonders, Section II: Water,\nRunning water does not freeze as easily as still water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd10a16-4620-3cca-99f0-c23b8f3f38aa",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To lower something's temperature to the point that it freezes or becomes hard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7388ca89-a29b-434d-8c64-2c6c939a1116",
                                                "sense_id": "5bd10a16-4620-3cca-99f0-c23b8f3f38aa",
                                                "text": "Don't freeze meat twice."
                                            },
                                            {
                                                "example_id": "b2f13320-4f48-4b6c-9d2c-28ff9051027b",
                                                "sense_id": "5bd10a16-4620-3cca-99f0-c23b8f3f38aa",
                                                "text": "1888, Elias Lönnrot, John Martin Crawford (translator, from German), The Kalevala, Rune XXX: The Frost-fiend,\nFreeze the wizard in his vessel, / Freeze to ice the wicked Ahti, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e507ac13-4458-3a5a-bddb-8b45ddd35b5b",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To drop to a temperature below zero degrees celsius, where water turns to ice."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d414d922-3571-4a74-8aea-0739d9d304a3",
                                                "sense_id": "e507ac13-4458-3a5a-bddb-8b45ddd35b5b",
                                                "text": "It didn't freeze this winter, but last winter was very harsh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7b72e8c-2cd5-3fda-a8c4-5aac15fee91c",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To be affected by extreme cold."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad8a0a17-3edb-4a39-a30f-d4a9c69e7d4b",
                                                "sense_id": "c7b72e8c-2cd5-3fda-a8c4-5aac15fee91c",
                                                "text": "It's freezing in here!"
                                            },
                                            {
                                                "example_id": "ed64c01a-d538-4919-ac01-0999e1382448",
                                                "sense_id": "c7b72e8c-2cd5-3fda-a8c4-5aac15fee91c",
                                                "text": "Don't go outside wearing just a t-shirt; you'll freeze!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42165251-5bad-3f3c-b882-ab88f5781b7f",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "(of machines and software) To come to a sudden halt, stop working (functioning)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7d5855-25e3-4600-8671-d2cee0f841f6",
                                                "sense_id": "42165251-5bad-3f3c-b882-ab88f5781b7f",
                                                "text": "Since the last update, the program freezes after a few minutes of use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798ae929-c012-3e6f-acb0-f2b9dbe46d0d",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "(of people and other animals) To stop (become motionless) or be stopped due to attentiveness, fear, surprise, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6bcfb1-52c4-4e28-b20f-f99cf9560499",
                                                "sense_id": "798ae929-c012-3e6f-acb0-f2b9dbe46d0d",
                                                "text": "Despite all of the rehearsals, I froze as soon as I got on stage."
                                            },
                                            {
                                                "example_id": "4470edf8-ce85-4a99-ae14-5382f27f10cb",
                                                "sense_id": "798ae929-c012-3e6f-acb0-f2b9dbe46d0d",
                                                "text": "As Tarzan rose upon the body of his kill to scream forth his hideous victory cry into the face of the moon the wind carried to his nostrils something which froze him to statuesque immobility and silence."
                                            },
                                            {
                                                "example_id": "19db1bd1-8b53-4dcf-a29e-295d8176bbb7",
                                                "sense_id": "798ae929-c012-3e6f-acb0-f2b9dbe46d0d",
                                                "text": "They froze on their knees, their faces turned upward with a ghastly blue hue in the sudden glare of a weird light that burst blindingly up near the lofty roof and then burned with a throbbing glow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfdd9812-9636-3968-a903-e2492bafccaa",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To cause someone to become motionless."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6ee9b9-3aa1-4247-ac2a-26563be0cb33",
                                                "sense_id": "dfdd9812-9636-3968-a903-e2492bafccaa",
                                                "text": "Dr Constantine sniggered and Mrs Hubbard immediately froze him with a glance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d97e86-2274-3360-a631-6ee1c21f8a02",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To lose or cause to lose warmth of feeling; to shut out; to ostracize."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0af76a-10d4-4498-bd18-74125195aab4",
                                                "sense_id": "35d97e86-2274-3360-a631-6ee1c21f8a02",
                                                "text": "Over time, he froze towards her, and ceased to react to her friendly advances."
                                            },
                                            {
                                                "example_id": "bb4ec245-e510-46eb-95bc-722251f4273b",
                                                "sense_id": "35d97e86-2274-3360-a631-6ee1c21f8a02",
                                                "text": "The other side to this sunny gladness of natural love is his pity for their sufferings when their own mother's heart seems to freeze towards them."
                                            },
                                            {
                                                "example_id": "fc61a567-ccfe-43e1-9f82-467d4a438ca0",
                                                "sense_id": "35d97e86-2274-3360-a631-6ee1c21f8a02",
                                                "text": "His friends begin to freeze towards him, the pillars of society cut him publicly, his clients cool off, big business deals no longer come his way, he is increasingly conscious of social ostracism and the puzzled misgivings of his wife."
                                            },
                                            {
                                                "example_id": "cc5155ee-78aa-4875-b6d9-47182fa916b3",
                                                "sense_id": "35d97e86-2274-3360-a631-6ee1c21f8a02",
                                                "text": "If you cheat them, they don't say anything but after that they freeze towards you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f44cbb7a-1067-33d9-9add-4ea52ef4b209",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To cause loss of animation or life in, from lack of heat; to give the sensation of cold to; to chill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4857853a-d217-46fd-894c-6a6b60d48cb8",
                                                "sense_id": "f44cbb7a-1067-33d9-9add-4ea52ef4b209",
                                                "text": "A faint, cold fear runs through my veins, / That almost freezes up the heat of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c687d893-f06b-3853-baeb-70e0c9702303",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To prevent the movement or liquidation of a person's financial assets"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea35bb4-bc2d-4fc6-93cd-ab1d7130009b",
                                                "sense_id": "c687d893-f06b-3853-baeb-70e0c9702303",
                                                "text": "The court froze the criminal's bank account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c239af53-293d-3704-afb0-eda03453942a",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "Of prices, spending etc., to keep at the same level, without any increase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec7567f-e1d6-44e2-aed1-9aba5033037b",
                                                "sense_id": "c239af53-293d-3704-afb0-eda03453942a",
                                                "text": "The headline promise in the Liberal Democrat manifesto is to freeze rail fares for commuters and season ticket holders for the duration of a Parliament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59820125-e617-3d5a-bad4-f1123b610d9f",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To prevent from showing any visible change."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c60dd50-da7d-4fd2-89b3-3226b6e9cba9",
                                                "sense_id": "59820125-e617-3d5a-bad4-f1123b610d9f",
                                                "text": "Pressing the pause button will freeze the video playback."
                                            },
                                            {
                                                "example_id": "a993bcfb-83ad-46a7-9664-91047b529871",
                                                "sense_id": "59820125-e617-3d5a-bad4-f1123b610d9f",
                                                "text": "Playback will freeze if you pause the video."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2b7797c-f3e6-32e6-947f-d0d1e22a02de",
                                        "entry_id": "41b5a107-1d7e-33ff-b279-df70cc6568e1",
                                        "glosses": [
                                            "To trap (the puck) so that it cannot be played."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "freeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2327ddeb-8a68-3d6a-b39b-e35534ac971a",
                                        "entry_id": "7704c834-78c4-362a-b157-c5d3bc3ce54c",
                                        "glosses": [
                                            "A period of intensely cold weather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e20ce505-e7e4-4438-afeb-02d919a0fb81",
                                                "sense_id": "2327ddeb-8a68-3d6a-b39b-e35534ac971a",
                                                "text": "In order to work properly, the cotton stripper required that the plant be brown and brittle, as happened after a freeze, so that the cotton bolls could snap off easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce10293-5507-3cca-acbb-64516475ca74",
                                        "entry_id": "7704c834-78c4-362a-b157-c5d3bc3ce54c",
                                        "glosses": [
                                            "A halt of a regular operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c5d085a-3b57-4d6e-b2a5-ac02d7cd1569",
                                                "sense_id": "3ce10293-5507-3cca-acbb-64516475ca74",
                                                "text": "Without a freeze it might be possible to proceed with the production and deployment of such destabilizing systems as the MX, Trident II, cruise missiles and SS-18s, -19s and -20s."
                                            },
                                            {
                                                "example_id": "e33205bd-ac3a-4462-a8bc-0a4fd18b7f18",
                                                "sense_id": "3ce10293-5507-3cca-acbb-64516475ca74",
                                                "text": "1983 October 3, Ted Kennedy, speech, Truth and Tolerance in America,\nCritics may oppose the nuclear freeze for what they regard as moral reasons."
                                            },
                                            {
                                                "example_id": "c71bb624-787a-4bd7-9e46-6b8bf18de8db",
                                                "sense_id": "3ce10293-5507-3cca-acbb-64516475ca74",
                                                "text": "Many of our opponents in Congress are advocating a freeze in Federal spending and an increase in taxes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a2f0bf8-de7e-3752-91eb-2dd405c09b7d",
                                        "entry_id": "7704c834-78c4-362a-b157-c5d3bc3ce54c",
                                        "glosses": [
                                            "The state when either a single computer program, or the whole system ceases to respond to inputs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "404bd21d-c7f3-318b-b3ff-9ba03d947526",
                                        "entry_id": "7704c834-78c4-362a-b157-c5d3bc3ce54c",
                                        "glosses": [
                                            "A precise draw weight shot where a delivered stone comes to a stand-still against a stationary stone, making it nearly impossible to knock out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d50e8b8-9c42-406f-9914-d123411b38f2",
                                                "sense_id": "404bd21d-c7f3-318b-b3ff-9ba03d947526",
                                                "text": "The reason I said the guard wasn't the toughest shot in curling is because, in my book, that's a shot called the freeze. A stone thrown as a freeze comes perfectly to rest directly in front of another stone, without moving it (see Figure 10-5)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bbb6aa-6e4e-313b-8449-162fd9de9445",
                                        "entry_id": "7704c834-78c4-362a-b157-c5d3bc3ce54c",
                                        "glosses": [
                                            "A block on pay rises or on the hiring of new employees etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52ce336d-c0b5-4795-acfc-514ae46e6681",
                                                "sense_id": "85bbb6aa-6e4e-313b-8449-162fd9de9445",
                                                "text": "a hiring freeze;  a pay freeze"
                                            },
                                            {
                                                "example_id": "b18a0d2f-c650-4577-bb32-b574971e1514",
                                                "sense_id": "85bbb6aa-6e4e-313b-8449-162fd9de9445",
                                                "text": "\"We need a different understanding of revenues and public expenditure. The 15-year freeze on fuel duty and lack of tax on aviation fuel are effectively a huge subsidy to those forms of travel, but they are not described as subsidy because they are foregone revenue. Yet if you invest to hold rail fares, it's seen as subsidy.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freeze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba4130c2-eb17-39b5-b07d-e49845648f36",
                                        "entry_id": "0eada5e6-3867-3874-b390-37d91e9fd480",
                                        "glosses": [
                                            "Obsolete form of frieze."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da28218d-cf5c-434b-8a40-54d2b0af2e42",
                                                "sense_id": "ba4130c2-eb17-39b5-b07d-e49845648f36",
                                                "text": "[I]f a plaine fellow well and cleanely apparelled, either in home-ſpun ruſſet or freeze (as the ſeaſon requires) with a five pouch at his girdle, happen to appeare in his ruſticall likenes: there is a Cozen ſaies one, At which word out flies the Taker, and thus giues the onſet vpon my olde Pennyfather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
