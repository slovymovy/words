                "senses": [
                    {
                        "sense_id": "f11f166f-9e9c-3a05-8895-50cf8bc7e22c",
                        "entry_id": "1f76d4c3-d6d0-399a-8480-31bcee78d6fd",
                        "glosses": [
                            "dauerhafte und häufig institutionalisierte Kritik an Ausprägungen der aktuellen Kultur, die in Hinsicht auf menschliche Bedürfnisse als unpassend, nicht mehr passend oder veränderungswürdig empfunden werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856da39d-3b25-4710-9de3-f3a0aa4628e9",
                                "sense_id": "f11f166f-9e9c-3a05-8895-50cf8bc7e22c",
                                "text": "„Die moderne Kultur ist ganz entschieden eine Kultur der Kulturkritik und, konsequenterweise, eine Kultur ohne Leitkultur.“"
                            },
                            {
                                "example_id": "2b9811c5-47f8-48c3-b9b5-7f2525670744",
                                "sense_id": "f11f166f-9e9c-3a05-8895-50cf8bc7e22c",
                                "text": "„Die Fülle der Phänomene, die der Ausdruck Kulturkritik im einzelnen umfaßt, sind geläufig und allgemein bekannt. Kulturkritik, das ist der Sammelbegriff für die zahllosen Kommentare, mit denen die Intellektuellen von jeher das Geschehen ihrer Zeit begleitet haben […] Die Kulturkritik ist ein fächerübegreifendes, medienübergreifendes, sprach- und nationenübergreifendes, allerdings offenbar nicht in der gleichen Weise auch ein kulturübergreifendes Phänomen. […] Spätestens seit der Generation der Coleridge, Heine und Saint-Beuve und damit seit jener Zeit, da selbst der greise Goethe Journale und Zeitschriften für unentbehrlich zu halten begann, hat die Kulturkritik ihren Platz im Feuilleton und speziell in der Karikatur.“"
                            },
                            {
                                "example_id": "05a31cf5-e3f3-4432-86a1-79e488ab0997",
                                "sense_id": "f11f166f-9e9c-3a05-8895-50cf8bc7e22c",
                                "text": "Die Kulturkritik hat sich als Spezifikum der westlichen Welt entwickelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
