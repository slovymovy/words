                    {
                        "translation_id": "1eeee8e2-0b45-4e53-9212-af62b3bd101c",
                        "source_entry_id": "831395e1-37e7-35de-94e0-b4f0baba0e55",
                        "source_sense_description": "the act of electrifying, or the state of being charged with electricity",
                        "target_lang_word": "électrification",
