            "senses": [
                {
                    "sense_id": "e20b61b2-02da-33f5-a086-c0c1c30976e8",
                    "sense_definition": "Gefühlloser menschlicher Charakterzug oder eine Haltung, die darauf abzielt, anderen Lebewesen willentlich Schmerz, Leid oder Tod zuzufügen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charakterzug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine herzlosen Worte zeugten von einer erschreckenden <w>Grausamkeit</w>."
                        },
                        {
                            "text": "Für eine solche unmenschliche <w>Grausamkeit</w> fehlte ihm jedes Verständnis."
                        }
                    ],
                    "synonyms": [
                        "Erbarmungslosigkeit",
                        "Gefühlskälte",
                        "Gnadenlosigkeit",
                        "Härte"
                    ],
                    "antonyms": [
                        "Barmherzigkeit",
                        "Freundlichkeit",
                        "Milde",
                        "Mildtätigkeit",
                        "Nachsichtigkeit"
                    ],
                    "common_phrases": [
                        "unmenschliche Grausamkeit",
                        "an Grausamkeit nicht zu überbieten"
                    ]
                },
                {
                    "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                    "sense_definition": "Eine erschreckende, brutale Handlung, die jemandem schweres körperliches oder seelisches Leid zufügt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "handlung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Soldaten begingen während des Krieges unzählige furchtbare <w>Grausamkeiten</w>."
                        },
                        {
                            "text": "Jede sinnlose <w>Grausamkeit</w> gegen Tiere sollte vor Gericht streng bestraft werden."
                        }
                    ],
                    "synonyms": [
                        "Barbarei",
                        "Gewalt",
                        "Gräuel",
                        "Tortur"
                    ],
                    "antonyms": [
                        "gute Tat"
                    ],
                    "common_phrases": [
                        "Grausamkeit gegen Tiere",
                        "Grausamkeiten an Unschuldigen"
                    ]
                }
            ]
        }
