                        "glosses": [
                            "unconcealed, undisguised"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c856dcd-7db8-4cb3-8f22-ba54dd1ffdd1",
                                "sense_id": "d0b5ac3a-2b27-3f40-a4a7-93cf0fa3d863",
                                "text": "И прислу́га, и портны́е, и все, с кем приходи́лось ста́лкиваться Сара́нину, на́чали относи́ться к нему́ с нескрыва́емым презре́нием.",
                                "translation": "And the servants, and the tailors, and all with whom Saranin had to come in contact, treated him with unconcealed contempt.",
                                "english": "And the servants, and the tailors, and all with whom Saranin had to come in contact, treated him with unconcealed contempt."
                            }
                        ]
                    }
