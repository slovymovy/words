{
    "word_family": [
        "zakken",
        "onderuit",
        "afzakken",
        "uitzakken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a18c013-f2ca-30f1-b74c-f0bf2c1ce62e",
                    "sense_definition": "van een zittende houding overgaan naar een meer liggende of hangende houding",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag werken <w>zakte</w> hij heerlijk <w>onderuit</w> op de bank.",
                            "target_lang_translations": {
                                "en": "After a long day of work, he <w>slumped down</w> comfortably on the couch."
                            }
                        },
                        {
                            "text": "De leerlingen <w>zakken onderuit</w> in hun stoelen omdat de tafels te hoog zijn.",
                            "target_lang_translations": {
                                "en": "The students are <w>slouching</w> in their chairs because the tables are too high."
                            }
                        }
                    ],
                    "synonyms": [
                        "hangen"
                    ],
                    "antonyms": [
                        "rechtop zitten"
                    ],
                    "common_phrases": [
                        "onderuitzakken op de bank",
                        "in een stoel onderuitzakken"
                    ],
                    "target_lang_definitions": {
                        "en": "To shift from a sitting position to a more reclining or slouching posture."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slump down",
                                "target_lang_sense_clarification": "to sit in a loose, drooping way"
                            },
                            {
                                "target_lang_word": "slouch",
                                "target_lang_sense_clarification": "to sit with a lazy or drooping posture"
                            },
                            {
                                "target_lang_word": "sink back",
                                "target_lang_sense_clarification": "to lean back deeply into a seat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a02cbb34-0f20-3b70-a4fc-203a3bc4e401",
                    "sense_definition": "zich ontspannen door niets te doen of lui te zitten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de vakantie kun je eindelijk eens lekker <w>onderuitzakken</w> en een boek lezen.",
                            "target_lang_translations": {
                                "en": "During the vacation, you can finally <w>lounge</w> and read a book."
                            }
                        },
                        {
                            "text": "Hij besloot even te <w>onderuitzakken</w> voor de televisie na het eten.",
                            "target_lang_translations": {
                                "en": "He decided to <w>kick back</w> in front of the television for a bit after dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "luieren",
                        "hangen"
                    ],
                    "antonyms": [
                        "inspannen",
                        "werken"
                    ],
                    "common_phrases": [
                        "lekker onderuitzakken",
                        "even onderuitzakken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in een informele context van ontspanning"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To relax by doing nothing or sitting lazily."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lounge",
                                "target_lang_sense_clarification": "to lie or sit in a relaxed or lazy way"
                            },
                            {
                                "target_lang_word": "veg out",
                                "target_lang_sense_clarification": "to relax completely and do nothing"
                            },
                            {
                                "target_lang_word": "kick back",
                                "target_lang_sense_clarification": "to relax and take it easy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}