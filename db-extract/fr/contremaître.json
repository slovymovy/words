                        "entry_id": "85567a21-7a31-36b0-bb76-0fdcb0474717",
                        "glosses": [
                            "Ouvrier qui dirige et surveille les autres ouvriers dans un atelier, sur un chantier, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949e4e05-e37d-4d1f-bfb7-5c0b4373749e",
                                "sense_id": "243ee1e3-a013-3ca8-8fbb-efd2dd0f5477",
                                "text": "Le contremaître est le patron de l'atelier pendant huit heures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bed712f-53ad-425f-8890-2b04bde7aad5",
                        "source_entry_id": "85567a21-7a31-36b0-bb76-0fdcb0474717",
                        "source_sense_id": "243ee1e3-a013-3ca8-8fbb-efd2dd0f5477",
                        "target_lang_word": "Vorarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b89d7fe0-c6aa-3c81-95aa-1fa51f6c03fb",
                                        "entry_id": "9862edd9-b31c-3e3d-8542-599ad1eb69a4",
                                        "glosses": [
                                            "Person, die eine Gruppe aus Arbeitern/Arbeiterinnen oder Handwerkern/Handwerkerinnen anführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd35a0c7-b614-4db0-95c5-022d63f44a09",
                                                "sense_id": "b89d7fe0-c6aa-3c81-95aa-1fa51f6c03fb",
                                                "text": "„Aufregung beim deutschen Automobilhersteller BMW: Ein Vorarbeiter soll seinen Mitarbeitern verboten haben, sich untereinander auf Türkisch zu unterhalten.“"
                                            },
                                            {
                                                "example_id": "f236cfb4-a7b4-407d-8b20-12c7f535e28e",
                                                "sense_id": "b89d7fe0-c6aa-3c81-95aa-1fa51f6c03fb",
                                                "text": "„Aber sie war auch in einen Witwer verliebt, der als Vorarbeiter in einer in der Nähe gelegenen Fabrik beschäftigt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11f6d005-7f84-40d6-8d9a-e8df7daebc95",
