                    "sense_id": "b812bece-ea16-3d35-bd21-55160524b5af",
                    "sense_definition": "Een mannelijk lid van een koninklijke familie, meestal de zoon van een koning of koningin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "royalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge <w>prins</w> zwaaide naar het publiek vanaf het balkon.",
                            "target_lang_translations": {
                                "en": "The young <w>prince</w> waved to the crowd from the balcony.",
                                "ru": "Молодой <w>принц</w> помахал публике с балкона.",
                                "pl": "Młody <w>książę</w> pomachał do tłumu z balkonu.",
                                "de": "Der junge <w>Prinz</w> winkte dem Publikum vom Balkon aus zu.",
                                "fr": "Le jeune <w>prince</w> a salué la foule depuis le balcon.",
                                "it": "Il giovane <w>principe</w> salutò la folla dal balcone.",
                                "cs": "Mladý <w>princ</w> mával davu z balkonu.",
                                "tr": "Genç <w>prens</w> balkondan kalabalığa el salladı.",
                                "es": "El joven <w>príncipe</w> saludó a la multitud desde el balcón."
                            }
                        },
                        {
                            "text": "Zij wacht nog steeds op haar <w>prins</w> op het witte paard.",
                            "target_lang_translations": {
                                "en": "She is still waiting for her <w>prince</w> on the white horse.",
                                "ru": "Она всё ещё ждёт своего <w>принца</w> на белом коне.",
                                "pl": "Ona wciąż czeka na swojego <w>księcia</w> na białym koniu.",
                                "de": "Sie wartet immer noch auf ihren <w>Prinzen</w> auf dem weißen Pferd.",
                                "fr": "Elle attend toujours son <w>prince</w> charmant.",
                                "it": "Lei sta ancora aspettando il suo <w>principe</w> azzurro.",
                                "cs": "Stále ještě čeká na svého <w>prince</w> na bílém koni.",
                                "tr": "O hâlâ beyaz atlı <w>prensini</w> bekliyor.",
                                "es": "Ella todavía está esperando a su <w>príncipe</w> azul."
                            }
                        }
