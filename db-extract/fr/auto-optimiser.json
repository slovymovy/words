                        "glosses": [
                            "S’optimiser par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea7e2358-7e85-43fe-94d1-a5b95003645f",
                                "sense_id": "0dcf3d35-ceca-3cd0-ad18-1c366ae6881c",
                                "text": "“ Il faut que les réseaux apprennent à se débrouiller tout seuls. Ils devront s’autodétecter, s’auto-organiser, s’autoconfigurer, s’auto-optimiser mais aussi s’autoréparer et analyser eux-mêmes leurs vulnérabilités ”, précise Olivier Audouin, directeur opérationnel du laboratoire commun."
                            },
                            {
                                "example_id": "083a696e-c4e0-4567-aab4-e8ea1a7fb48f",
                                "sense_id": "0dcf3d35-ceca-3cd0-ad18-1c366ae6881c",
                                "text": "Les recherches dans les dernières années ont permis d’augmenter le spectre des applications du contrôle flou, comme la capacité pour résoudre des problèmes de contrôle, s’autorégler et s’auto-optimiser."
                            },
                            {
                                "example_id": "2e99b6db-766b-4179-9b91-6f84a2f0dd65",
                                "sense_id": "0dcf3d35-ceca-3cd0-ad18-1c366ae6881c",
                                "text": "Un réseau est dit autonome s’il est capable de s’auto-configurer, s’auto-optimiser, s’auto-protéger et s’auto-restaurer."
                            }
                        ]
                    }
