                        "entry_id": "22aba09d-210b-3590-a7a1-ff47dcfe5d1b",
                        "glosses": [
                            "Ensemble de petits plats constituant une tradition culinaire levantine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d74eb10-b6bf-476e-b153-d399b974a6bb",
                                "sense_id": "bd2c1cec-0b43-3486-96ee-74196e5656a1",
                                "text": "Ce mezzé traditionnel comptait une trentaine de plats."
                            },
                            {
                                "example_id": "f119b4dc-c9f3-4d0b-a286-fa2547f1bba6",
                                "sense_id": "bd2c1cec-0b43-3486-96ee-74196e5656a1",
                                "text": "Si la gastronomie libanaise est loin de pouvoir être résumée au mezzé, il en est tout de même un beau symbole !"
                            },
                            {
                                "example_id": "435a4743-23df-4876-9d03-0345a878026a",
                                "sense_id": "bd2c1cec-0b43-3486-96ee-74196e5656a1",
                                "text": "Au menu de ce livre goutu : pâtes orzo, mezzés, cafés glacés…"
                            }
                        ]
