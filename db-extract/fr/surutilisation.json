                        "glosses": [
                            "Utilisation excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "602fb461-5f8d-45ac-b3f0-2fc34a21b3e9",
                                "sense_id": "19b23401-bcc3-3989-a3e3-7a0ed83f1594",
                                "text": "Aux États-Unis, la généralisation des OGM aboutirait à une surutilisation de pesticides."
