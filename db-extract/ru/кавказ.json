                "senses": [
                    {
                        "sense_id": "e546fd1a-7e6c-37d7-9d31-b5c261a3796d",
                        "entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                        "glosses": [
                            "геогр. регион, расположенный к югу от Восточно-Европейской равнины на границе Европы и Азии, преимущественно горная страна между Чёрным, Азовским и Каспийским морями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47270763-b8ff-4e3c-a6ee-2c090becab54",
                                "sense_id": "e546fd1a-7e6c-37d7-9d31-b5c261a3796d",
                                "text": "Главный Кавказский хребет принято делить на Центральный Кавказ ― от Казбека до Эльбруса, Восточный ― к востоку от Казбека и Западный ― к западу от Эльбруса."
                            }
                        ]
                    },
                    {
                        "sense_id": "c39889bd-6643-391d-979a-8509b93d8e8b",
                        "entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                        "glosses": [
                            "полит. историко-географический и экономический регион на границе Европы и Азии, на территории Кавказа [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e62dd3d7-d011-4e52-8f58-de73613cd345",
                                "sense_id": "c39889bd-6643-391d-979a-8509b93d8e8b",
                                "text": "Вскоре перевели меня на Кавказ: это самое счастливое время моей жизни."
                            }
                        ]
                    },
                    {
                        "sense_id": "833c10b2-66b5-350d-9286-416c416895d9",
                        "entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                        "glosses": [
                            "село в России"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "481d2ae4-a9d9-4ac7-98ac-99cfee9188a6",
                        "source_entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                        "source_sense_description": "регион, расположенный к югу от Восточно-Европейской равнины на границе Европы и Азии, преимущественно горная страна между Чёрным, Азовским и Каспийским морями",
                        "target_lang_word": "Caucasus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caucasus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                        "entry_id": "bce24e08-b003-357a-9fa6-dbd2b8f17df7",
                                        "glosses": [
                                            "A mountain range in Eastern Europe between the Black Sea and the Caspian Sea, on territory of Russia, Georgia, Armenia and Azerbaijan, which includes the ranges of Greater Caucasus and Lesser Caucasus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c993bf-7a32-4c4a-95a4-4af707b82173",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Oh who can hold a fire in his hand / By thinking on the froſtie Caucaſus? / Or cloy the hungry edge of appetite, / by bare imagination of a Feaſt?"
                                            },
                                            {
                                                "example_id": "b74f08f7-7969-4c4f-84f3-4479ffb3007b",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "[…] from the long and rugged ravines of the Caucasus, […]"
                                            },
                                            {
                                                "example_id": "f4e5c499-0503-4d56-8812-2afad6ae7c13",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Driven with that weak blast which Winter leaves, / Closing his palace gates on Caucasus, / […]"
                                            },
                                            {
                                                "example_id": "09c49ae9-6d64-4ce0-b255-f77724707bbe",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Germany, Italy, Spain and Belgium writhed in the throes of Anarchy, while Russia, watching from the Caucasus, stooped and bound them one by one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd53359d-cbac-3ce2-8292-57062a060a52",
                                        "entry_id": "bce24e08-b003-357a-9fa6-dbd2b8f17df7",
                                        "glosses": [
                                            "A geopolitical region in Eastern Europe and Western Asia, deriving its name from the aforementioned mountains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
