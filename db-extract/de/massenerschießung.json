                "senses": [
                    {
                        "sense_id": "096c5aa1-15b7-3b25-9d73-e0740d87819c",
                        "entry_id": "06217af7-dd0c-3361-9fd6-35110b341350",
                        "glosses": [
                            "Hinrichtung einer großen Zahl von Personen durch Erschießen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db007c4-4647-4182-96c8-1fb51deedf88",
                                "sense_id": "096c5aa1-15b7-3b25-9d73-e0740d87819c",
                                "text": "„Woher, in aller Welt, sollte ich einen Bürgen nehmen, der dem Konsul beschwor, daß mein Toter nie vorher, nie nachher etwas Ähnliches geschrieben habe, der beschwor, daß mein Toter nie mehr über die Massenerschießungen von Roten in welcher Arena immer schreiben würde?“"
                            },
                            {
                                "example_id": "a6ff0daf-625e-488c-a66c-da86c822783f",
                                "sense_id": "096c5aa1-15b7-3b25-9d73-e0740d87819c",
                                "text": "„Insbesondere die Armee spielte mit Massakern, Vergewaltigungen und Massenerschießungen von Zivilisten eine unrühmliche Rolle.“"
                            },
                            {
                                "example_id": "7bf40783-3dc2-4396-b550-a3f0eed9f162",
                                "sense_id": "096c5aa1-15b7-3b25-9d73-e0740d87819c",
                                "text": "„Man hört von Massenerschießungen von Juden im Osten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
