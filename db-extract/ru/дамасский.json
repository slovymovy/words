                    {
                        "translation_id": "e5a060a6-b2af-41d7-aac8-4b3fe96ba3bd",
                        "source_entry_id": "6f69c98a-79d7-34ec-bb47-0a5273eaacfc",
                        "target_lang_word": "damaszenisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damaszenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa89e3e0-6789-3dd9-82ae-448d7ce44da6",
                                        "entry_id": "bc041453-aad8-3a0e-a732-6edbabf41b68",
                                        "glosses": [
                                            "Damaskus und/oder dessen Einwohner betreffend, aus Damaskus und/oder von dessen Einwohnern stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1fa864-3b76-4f84-89bc-fc0491d37c81",
                                                "sense_id": "aa89e3e0-6789-3dd9-82ae-448d7ce44da6",
                                                "text": "„Der Anlaß war, daß der damaszenische Gouverneur von Bosra, der in Damaskus in Ungnade gefallen war, die Stadt zusammen mit Ṣalḫad auszuliefern versprochen hatte.“"
                                            },
                                            {
                                                "example_id": "e8c2a2c8-16ab-495a-a618-aba04b6898aa",
                                                "sense_id": "aa89e3e0-6789-3dd9-82ae-448d7ce44da6",
                                                "text": "„Diese sind nicht derart verteilt, daß die ältere Generation einen arabischen Lokaldialekt spricht, die jüngere damaszenisch.“"
                                            },
                                            {
                                                "example_id": "b481c040-0bb3-472c-bb92-d5a3d43bf1f8",
                                                "sense_id": "aa89e3e0-6789-3dd9-82ae-448d7ce44da6",
                                                "text": "„Als das damaszenisch-allepinische Heer im Rabīʿ 1872 (Oktober 1467) von Sawwār vernichtet wurde, geriet der Statthalter von Damaskus, Bard Bak al-Baǧmaqdār, in Gefangenschaft […].“"
                                            },
                                            {
                                                "example_id": "e4d770f8-2d89-4c03-a5de-344cd9b43336",
                                                "sense_id": "aa89e3e0-6789-3dd9-82ae-448d7ce44da6",
                                                "text": "„Die Frage, ob stattdessen auch die yā-Konstruktion, in diesem Falle also ˀyārētni ʾaʿṭiʰ yākī, möglich ist, läßt sich ohne Befragung damaszenischer Muttersprachler nicht beantworten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
