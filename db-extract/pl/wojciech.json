                "translations": [
                    {
                        "translation_id": "66c6928d-3ba6-429f-9818-37e17de2ed4f",
                        "source_entry_id": "00b0606e-74ac-3ff0-99eb-a9d6cc86b3c0",
                        "source_sense_id": "0ce9c9c7-52f4-30e0-8dd6-9bb1ab805bd8",
                        "target_lang_word": "Adalbert",
