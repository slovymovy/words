                "senses": [
                    {
                        "sense_id": "128b29a6-e5cd-3109-bc23-b9a4239e0149",
                        "entry_id": "3fe1cc61-2538-3927-9f21-b7876ecf4e5c",
                        "glosses": [
                            "das Entwaffnen und Festsetzen einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37ca279-b052-4d81-b8ee-e5885dacc668",
                                "sense_id": "128b29a6-e5cd-3109-bc23-b9a4239e0149",
                                "text": "„Ein Spion, der heimlich und ohne Teilnahme an Kriegshandlungen im Gebiet des Kriegsgegners Informationen beschafft hat und in den Herrschaftsbereich seiner Kriegspartei zurückgekehrt ist, darf nach seiner Gefangennahme nicht bestraft werden und hat Anspruch auf Behandlung als Kriegsgefangener.“"
                            },
                            {
                                "example_id": "f964a378-3f24-4eaf-891a-4e89b4ccb8f0",
                                "sense_id": "128b29a6-e5cd-3109-bc23-b9a4239e0149",
                                "text": "„Die Gefangennahme oder der Tod einzelner Anführer bedeutete meist auch das Ende des jeweiligen Aufruhrs.“"
                            },
                            {
                                "example_id": "3a4a3eba-d3a1-48fb-8c4c-990fa0022796",
                                "sense_id": "128b29a6-e5cd-3109-bc23-b9a4239e0149",
                                "text": "„Erst Wochen später erzählte er ihr, dass es schon wenige Tage nach seiner Gefangennahme begonnen hatte.“"
                            },
                            {
                                "example_id": "56e7c7ae-9374-4cbc-afb0-8dd4ede7c128",
                                "sense_id": "128b29a6-e5cd-3109-bc23-b9a4239e0149",
                                "text": "„Zum ersten Mal seit seiner Gefangennahme kroch Bond die Angst das Rückgrat hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
