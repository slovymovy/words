                    {
                        "translation_id": "3f7544db-480c-4afc-b1ae-d1a424bde34a",
                        "source_entry_id": "559fdcc5-b4b3-3a31-8c0b-a53a9d15131f",
                        "source_sense_id": "f6816477-d58c-3789-a128-367d9aaf843f",
