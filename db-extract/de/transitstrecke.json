                "senses": [
                    {
                        "sense_id": "f042488b-c0fc-3b2a-baa7-2544ab1554ca",
                        "entry_id": "7a0c4594-73e2-369c-bf3e-fc4cd37f30cd",
                        "glosses": [
                            "Streckenverlauf, auf dem ein Transitverkehr möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8319a75-8216-42e6-9832-8ffb2abd2fb3",
                                "sense_id": "f042488b-c0fc-3b2a-baa7-2544ab1554ca",
                                "text": "„»Fast schon in Hamburg« hieß es, bis die Mauer fiel und sich das wüste Niemandsland links und rechts der Transitstrecke über Nacht in wertvolle Immobilien verwandelte.“"
                            },
                            {
                                "example_id": "42cf20bd-e1bd-4a2c-adec-56a8cfc4e41b",
                                "sense_id": "f042488b-c0fc-3b2a-baa7-2544ab1554ca",
                                "text": "„Man glaubt auf einer Transitstrecke zu sein, wie früher, obwohl das längst nicht mehr stimmt.“"
                            },
                            {
                                "example_id": "97001625-3fb9-4c95-b3be-d1bbecacf237",
                                "sense_id": "f042488b-c0fc-3b2a-baa7-2544ab1554ca",
                                "text": "„Wir scherzen, dass es die Transitstrecke zwischen der Schweiz und Frankreich sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
