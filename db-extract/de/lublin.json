                                        "sense_id": "6cc4ba90-8a01-30e2-9f00-9a1a52bdcd98",
                                        "entry_id": "2246fe88-5184-31ed-9899-b78573f4341f",
                                        "glosses": [
                                            "геогр. город на востоке Польши"
