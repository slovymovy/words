                        ],
                        "examples": [
                            {
                                "example_id": "d11851e1-f0d2-4db2-a3f3-51f722667fa8",
                                "sense_id": "d0b21d16-7ed0-3208-87cb-708414f3f132",
                                "text": "Hij had een vreemd voorgevoel dat er iets mis was.",
                                "translation": "He had a strange presentiment that something was wrong.",
                                "english": "He had a strange presentiment that something was wrong."
                            },
                            {
                                "example_id": "2c2a5c82-f03c-46df-b670-241c3a70701f",
                                "sense_id": "d0b21d16-7ed0-3208-87cb-708414f3f132",
                                "text": "Haar voorgevoelens hebben haar vaak gewaarschuwd voor gevaar.",
                                "translation": "Her premonitions have often warned her of danger.",
                                "english": "Her premonitions have often warned her of danger."
                            },
                            {
                                "example_id": "87f03635-6075-4333-aa45-0b8ff4999ebc",
                                "sense_id": "d0b21d16-7ed0-3208-87cb-708414f3f132",
                                "text": "Toen ik het ongeluk zag gebeuren, kreeg ik een klein voorgevoeltje dat er iets ergs zou gebeuren.",
                                "translation": "When I saw the accident happen, I had a little premonition that something bad would happen.",
                                "english": "When I saw the accident happen, I had a little premonition that something bad would happen."
                            }
                        ]
                    }
