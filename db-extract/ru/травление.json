                                        "glosses": [
                                            "The art of producing an image from a metal plate into which an image or text has been etched with acid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5663b9c7-f4b5-3aa2-b981-3501e0e93f22",
                                        "entry_id": "59cc3f0f-9d80-34c0-b0f0-78dc9b986db4",
                                        "glosses": [
                                            "The image created by this process."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2171f9ff-8283-4260-809c-23920a4cdb47",
                                                "sense_id": "5663b9c7-f4b5-3aa2-b981-3501e0e93f22",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            }
                                        ]
                                    }
                                ]
