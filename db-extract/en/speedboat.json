                                                "example_id": "1b1fa19a-39c9-4485-84b1-dfb3c77eeb54",
                                                "sense_id": "845c2088-f145-3999-a9a7-37286ab03f14",
                                                "text": "Mot vedette."
                                            }
                                        ]
                                    }
                                ]
