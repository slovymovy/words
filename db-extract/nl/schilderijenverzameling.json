                        "examples": [
                            {
                                "example_id": "4dd52044-601d-4489-99d3-649832e7048a",
                                "sense_id": "5fd51b69-a048-35f1-bfb5-396b47cb00ef",
                                "text": "In de jaren vijftig moest hij zijn eigen schilderijenverzameling van de hand doen en nog had hij bij zijn overlijden in 1656 een schuld van maar liefst 18 000 gulden, naar we mogen aannemen als gevolg van zijn roekeloze ondernemingen."
                            },
                            {
                                "example_id": "9318085f-0971-4b69-b7ac-c682785d2a51",
                                "sense_id": "5fd51b69-a048-35f1-bfb5-396b47cb00ef",
                                "text": "In de inventaris van Rimingtons schilderijenverzameling krijgt het om onduidelijke redenen de titel Grumbo, mogelijk omdat men een gelijkenis zag met een gelijknamige Duitse generaal."
                            },
                            {
                                "example_id": "74df461f-cad6-4aab-9e05-2a7b41a192d7",
                                "sense_id": "5fd51b69-a048-35f1-bfb5-396b47cb00ef",
                                "text": "Volgens de aanklagers betaalde Wildenstein jarenlang geen belasting over zijn kapitale schilderijenverzameling en vastgoedportefeuille. De miljardair bezit veel werken van rococo-schilder Jean-Honoré Fragonard en van post-impressionist Pierre Bonnard. Ook heeft hij onder meer een stoeterij met racepaarden en een landgoed in Kenia waar de film Out of Africa werd opgenomen."
                            }
                        ]
                    }
