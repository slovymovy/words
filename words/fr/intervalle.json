            "senses": [
                {
                    "sense_id": "37df5af9-39f8-336b-97d5-3d33c97b4f7e",
                    "sense_definition": "Espace de temps qui sépare deux événements ou deux moments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train de banlieue passe à <w>intervalles</w> réguliers tout au long de la matinée."
                        },
                        {
                            "text": "Après un court <w>intervalle</w> de silence, l'orateur a poursuivi son discours captivant."
                        }
                    ],
                    "synonyms": [
                        "laps de temps",
                        "pause"
                    ],
                    "common_phrases": [
                        "à intervalles réguliers",
                        "par intervalles"
                    ]
                },
                {
                    "sense_id": "b34ddc32-5890-30a2-9e55-d52bede20ca7",
                    "sense_definition": "Espace ou distance qui sépare deux objets, deux lieux ou deux personnes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jardiniers ont planté des arbres en ménageant un <w>intervalle</w> de trois mètres."
                        },
                        {
                            "text": "Il a réussi à glisser sa lettre dans le mince <w>intervalle</w> sous la porte."
                        }
                    ],
                    "synonyms": [
                        "distance",
                        "écart",
                        "espacement"
                    ],
                    "common_phrases": [
                        "laisser un intervalle"
                    ]
                },
                {
                    "sense_id": "2cc45b84-8e94-3cda-a2ab-aaa4ba864b97",
                    "sense_definition": "Ensemble des valeurs comprises entre deux limites ou deux bornes déterminées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La température de l'eau doit impérativement rester dans cet <w>intervalle</w> de mesure."
                        },
                        {
                            "text": "Les élèves doivent déterminer si la fonction est continue sur cet <w>intervalle</w> fermé."
