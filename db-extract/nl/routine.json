                                    {
                                        "sense_id": "1e88545b-9ae7-30ce-ab6f-5ff00574fbf0",
                                        "entry_id": "f1ef4bd0-d748-35df-9637-1ec00775a8df",
                                        "glosses": [
                                            "A course of action to be followed regularly; a standard procedure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed674ceb-2ad5-35f4-a1bd-f74cdf4789f2",
                                        "entry_id": "f1ef4bd0-d748-35df-9637-1ec00775a8df",
                                        "glosses": [
                                            "A set of normal procedures, often performed mechanically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3d7b3e-4dcd-4f66-9ea1-9d1587335768",
                                                "sense_id": "ed674ceb-2ad5-35f4-a1bd-f74cdf4789f2",
                                                "text": "Connie was completely robotic and emotionless by age 12; her entire life had become one big routine."
                                            },
                                            {
                                                "example_id": "15b8f738-7218-47d3-9b71-929485bdc271",
                                                "sense_id": "ed674ceb-2ad5-35f4-a1bd-f74cdf4789f2",
                                                "text": "It is never possible to settle down to the ordinary routine of life at sea until the screw begins to revolve. There is an hour or two, after the passengers have embarked, which is disquieting and fussy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f96e12-f5b3-39e8-b18e-c9eaa92634a9",
                                        "entry_id": "f1ef4bd0-d748-35df-9637-1ec00775a8df",
                                        "glosses": [
                                            "A set piece of an entertainer's act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e45b840-ec28-4065-962e-2d0185811eab",
                                                "sense_id": "c0f96e12-f5b3-39e8-b18e-c9eaa92634a9",
                                                "text": "stand-up comedy routine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c1e02d6-42df-3451-a83a-e5338c2a1abd",
                                        "entry_id": "f1ef4bd0-d748-35df-9637-1ec00775a8df",
                                        "glosses": [
                                            "A performance, execution of gymnastics for one of the apparatus."
                                        ],
