                        "glosses": [
                            "Sélectionneur qui partage cette responsabilité avec une ou plusieurs autres personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a9a6ab-5d79-4efb-8e24-847ce7b613d1",
                                "sense_id": "d0c20ced-ea10-3596-8c62-878c23e27d5c",
                                "text": "Après le bronze obtenu au Mondial, Gaëlle Mignot et David Ortiz, les cosélectionneurs ont fait appel a des nouvelles têtes, comme Carla Arbez (photo) ou Maëlle Picut."
                            },
                            {
                                "example_id": "89f716b1-50a2-4af9-be0e-6176694ceeae",
                                "sense_id": "d0c20ced-ea10-3596-8c62-878c23e27d5c",
                                "text": "Devenu journaliste (de talent), il invente notamment l’expression « gros pardessus » pour désigner les dirigeants fédéraux, avant de devenir un temps cosélectionneur du XV de France."
                            },
                            {
                                "example_id": "5ad338f3-4505-49cf-bacc-e1ba2d821b13",
                                "sense_id": "d0c20ced-ea10-3596-8c62-878c23e27d5c",
                                "text": "Il a été cosélectionneur de l’équipe de France avec l’entraîneur de Saint-Étienne, Jean Snella, pendant quatre matches en 1966."
                            }
                        ]
                    }
