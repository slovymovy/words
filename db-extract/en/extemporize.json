                    {
                        "translation_id": "ff3b11b2-a066-4abc-a055-a244a85b4724",
                        "source_entry_id": "0336db00-d0d3-3087-8e64-528ec126ecd9",
                        "source_sense_description": "to act, particularly to perform or speak, without prior planning or thought",
                        "target_lang_word": "импровизи́ровать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "импровизи́ровать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0547121f-22b9-3dcb-963a-c2c5d9a61b42",
                                        "entry_id": "e292a559-37eb-31f9-8693-222a5b5f4c10",
                                        "glosses": [
                                            "создавать (реже — создать) какое-либо художественное произведение (мелодию, стихотворение и т. д.) в момент исполнения, без предварительной подготовки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7e1a67-d318-49df-b6c5-c474793cad68",
                                                "sense_id": "0547121f-22b9-3dcb-963a-c2c5d9a61b42",
                                                "text": "Он великолепно импровизирует, играет с листа всё, что угодно, и обнаруживает непостижимое для его лет понимание музыки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb665d16-f5f8-399e-9274-c5801c5b8b15",
                                        "entry_id": "e292a559-37eb-31f9-8693-222a5b5f4c10",
                                        "glosses": [
                                            "говорить то, что приходит в голову; придумывать, выдумывать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c91801-22e2-421e-ab62-006519938baa",
                                                "sense_id": "eb665d16-f5f8-399e-9274-c5801c5b8b15",
                                                "text": "Я окончил вечер у княгини. Я был в духе, импровизировал разные необыкновенные истории."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06673b3b-4d8a-3f84-9058-3a78611a60c3",
                                        "entry_id": "e292a559-37eb-31f9-8693-222a5b5f4c10",
                                        "glosses": [
                                            "перен. делать, устраивать, выдумывать (реже — сделать, устроить, выдумать) что-либо наскоро, без предварительных приготовлений, неожиданно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22998d5a-fa17-44ab-965d-1eb33b2f5514",
                                                "sense_id": "06673b3b-4d8a-3f84-9058-3a78611a60c3",
                                                "text": "На возвратном пути наш общий друг Рольстон импровизировал для меня обед."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
