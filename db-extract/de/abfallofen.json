                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80221c3d-a95e-4876-9c09-218f0de864df",
                                "sense_id": "08bc3966-6f70-3574-a454-b28c9d65180d",
                                "text": "„Der wohl wichtigste Betriebsteil wird »nach 1995« in Betrieb gehen: ein gewaltiger Abfallofen.“"
                            },
                            {
                                "example_id": "baa39c00-d57b-4b50-8e45-4078a1b53df6",
                                "sense_id": "08bc3966-6f70-3574-a454-b28c9d65180d",
                                "text": "„Die Kapazitätsgrenze für den Abfallofen wird um 5000 Tonnen nach oben gesetzt.“"
                            },
                            {
                                "example_id": "1e75f84e-c709-4259-8465-fb06dd81c37d",
                                "sense_id": "08bc3966-6f70-3574-a454-b28c9d65180d",
                                "text": "„Bislang wurden Dämmmaterialien aus EPS in einem Abfallofen durch Verbrennung bei hoher Temperatur verbrannt.“"
                            },
                            {
                                "example_id": "52569f46-9f49-4f23-88e5-0621ec19b120",
                                "sense_id": "08bc3966-6f70-3574-a454-b28c9d65180d",
                                "text": "„Der umstrittene Abfallofen soll auf dem Gelände der Großgaserei im Industriegebiet Rothensee entstehen und unter anderem verseuchte Böden verheizen.“"
                            }
                        ],
