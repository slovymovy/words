                                                "sense_id": "4956c0ad-059a-3a86-82f9-224b0dbb8907",
                                                "text": "Eine vorherige Anmeldung zur Prüfung ist unumgänglich."
                                            },
                                            {
                                                "example_id": "6289370a-9e44-4bb5-8a06-c5aadc4bad0b",
                                                "sense_id": "4956c0ad-059a-3a86-82f9-224b0dbb8907",
                                                "text": "Diese unumgängliche Hürde wurde auch noch genommen."
                                            },
                                            {
                                                "example_id": "fb1079b3-8b9f-4bc6-8ee6-91fdfac4347c",
                                                "sense_id": "4956c0ad-059a-3a86-82f9-224b0dbb8907",
                                                "text": "Eine Entschuldigung erscheint mir in diesem Falle unumgänglich."
