                                                "sense_id": "72e280ef-c54b-31c6-ad75-ffcedbb6c00b",
                                                "text": "Die Suchmaschine Google wurde von zwei Informatikern entwickelt."
                                            },
                                            {
                                                "example_id": "9afbfa41-459f-4bd0-a3d1-a3d87e60a01c",
