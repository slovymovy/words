                "senses": [
                    {
                        "sense_id": "7aee5bbd-f92a-3a34-9f05-64680214c481",
                        "entry_id": "b18f8046-bfb3-3d70-88bd-b68876c5828a",
                        "glosses": [
                            "относящийся к ткачеству, тканью изделий из льна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ed9eb9-7a91-4ebd-81f4-29e9db6466bc",
                                "sense_id": "7aee5bbd-f92a-3a34-9f05-64680214c481",
                                "text": "Человек с высоким задумчивым челом, вытянутым иконописно-северным лицом, удлиненной бородой, с непропорционально длинными ногами, Третьяков ежедневно по-прорабски вставал в шесть утра, трудился над своим льноткацким мануфактурным производством, стоял за конторкой до конца рабочего дня и лишь после всего на санях с медвежьей полостью застенчиво объезжал мастерские художников."
                            }
                        ]
                    }
