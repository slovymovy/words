                                        "sense_id": "88693557-2d15-36cd-b20a-6fe2658acd8c",
                                        "entry_id": "e21cbe2d-0677-36eb-a3b4-7a8f53490f8a",
                                        "glosses": [
                                            "To cover (meat or game) with a thin slice of fat bacon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bae4e71-687e-49fe-ade6-760512cd0a2d",
                        "source_entry_id": "d5d6440f-acb0-386c-a61c-7582701643cb",
                        "source_sense_id": "7c448a1d-cb26-3fae-90ec-0df9381556f1",
                        "source_sense_description": "middeleeuws dichter en zanger bij de Kelten",
                        "target_lang_word": "barde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1726126c-fe9a-388b-9f3f-661c2076842c",
                                        "entry_id": "78ee5b08-87e3-3445-9ae3-a7ae7047f600",
                                        "glosses": [
                                            "Longue selle faite uniquement de grosses toiles piquées et bourrées. On dit aussi bardelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1218ae6-f890-3165-94b5-c97fcf647211",
                                        "entry_id": "78ee5b08-87e3-3445-9ae3-a7ae7047f600",
                                        "glosses": [
                                            "Ancienne armure faite de lames de fer, qu’on plaçait sur le poitrail d’un cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbe1e0d-b437-45a1-96ea-f1eb1898a982",
                                                "sense_id": "b1218ae6-f890-3165-94b5-c97fcf647211",
                                                "text": "On lit dans l'article 11 de ces statuts : « Les armuriers feront tous harnais pour hommes, comme corcelets, cuirasses, haussecols, gorgerins, etc., et toutes bardes pour chevaux comme frontails, chanfreins, flanquois et collières. »"
                                            },
                                            {
                                                "example_id": "c3ceec6e-98bf-4ed7-abb0-904a280e0c1d",
                                                "sense_id": "b1218ae6-f890-3165-94b5-c97fcf647211",
                                                "text": "J’y vois de gros gardes, cuirassés de bardes, portant hallebardes de sucre candi."
                                            },
                                            {
                                                "example_id": "f9e17ae9-daa0-4e70-9390-79ed4d1ade72",
                                                "sense_id": "b1218ae6-f890-3165-94b5-c97fcf647211",
                                                "text": "« De grâce, Scapin, cercle-moi avec des bardes de fer ; je crève de fureur, je vais éclater comme une bombe ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1868ab5a-5fe0-3321-a8e0-bfa548dc3cf4",
                                        "entry_id": "78ee5b08-87e3-3445-9ae3-a7ae7047f600",
                                        "glosses": [
                                            "Fine tranche de lard dont on entoure les chapons, les bécasses, les perdrix, les rosbifs etc. que l’on va faire rôtir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103b8c63-2158-4d25-88da-084d42459d48",
                                                "sense_id": "1868ab5a-5fe0-3321-a8e0-bfa548dc3cf4",
                                                "text": "j’allais oublier d’acheter du lard… Madame Quenu, coupez-moi douze bardes, mais bien minces, n’est-ce pas ?"
                                            },
                                            {
                                                "example_id": "85ef80fe-1c7b-4116-bbe3-740f6e32456a",
                                                "sense_id": "1868ab5a-5fe0-3321-a8e0-bfa548dc3cf4",
                                                "text": "Piquez votre foie de veau de gros lard assaisonné ; foncez une braisière de bardes de lard ; mettez-y le foie avec des carottes, un bouquet garni, des oignons, […]."
                                            },
                                            {
                                                "example_id": "c9ed480f-fb20-4643-8ee5-e9d459effb01",
                                                "sense_id": "1868ab5a-5fe0-3321-a8e0-bfa548dc3cf4",
                                                "text": "Faîtes rôtir des poulardes bien tendres avec une barde de lard sur l’estomac ; …"
                                            },
                                            {
                                                "example_id": "782a910a-de26-4db5-ac6d-35f96c53dfa3",
                                                "sense_id": "1868ab5a-5fe0-3321-a8e0-bfa548dc3cf4",
                                                "text": "Quoique un peu rustaud, il était si bien tiré à quatre épingles, il prenait si richement son tabac, il le humait en homme si sûr de toujours avoir sa tabatière pleine de macouba, que le jour où monsieur Goriot s’installa chez elle, madame Vauquer se coucha le soir en rôtissant, comme une perdrix dans sa barde, au feu du désir qui la saisit de quitter le suaire du Vauquer pour renaître en Goriot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b20b3dc5-c37b-3aba-a0ba-e72fdeaea5b8",
                                        "entry_id": "e1d64125-8b6d-35af-b7ef-42448809a763",
                                        "glosses": [
                                            "Membre de la classe sacerdotale, celte ou gauloise, spécialisé dans la poésie orale et chantée."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a23d4a-9e3d-47ac-9ad7-780aaaa070d6",
                                                "sense_id": "b20b3dc5-c37b-3aba-a0ba-e72fdeaea5b8",
                                                "text": "D’où nous viennent donc, messieurs, les matériaux de notre littérature, […]. Serait-il vrai que le chant des trouvères fût un dernier écho de la harpe des bardes ?"
                                            },
                                            {
                                                "example_id": "5f239877-235a-451f-9144-d245d4687fbe",
                                                "sense_id": "b20b3dc5-c37b-3aba-a0ba-e72fdeaea5b8",
                                                "text": "Vêtus de feuilles, les derniers bardes folklorisaient à l’envi, mais le goût des mythes, la mise en place des aventures, des épopées, l’instinct d’aller voir dans les âmes désertaient la lande […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b8e721-4e95-3071-8367-fa20f7b0bd02",
                                        "entry_id": "e1d64125-8b6d-35af-b7ef-42448809a763",
                                        "glosses": [
                                            "Chanteur, poète."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2759b5-4d1f-47d4-bd19-12e62772b98d",
                                                "sense_id": "14b8e721-4e95-3071-8367-fa20f7b0bd02",
                                                "text": "Or, Canalis, crayonné dans une pose assez byronienne, offrait à l’admiration publique ses cheveux en coup de vent, son cou nu, le front démesuré que tout barde doit avoir."
                                            },
                                            {
                                                "example_id": "b0cae380-8c37-4e7b-b127-46a2471d76ff",
                                                "sense_id": "14b8e721-4e95-3071-8367-fa20f7b0bd02",
                                                "text": "Ces hauts faits chevaleresques fournirent des sujets de chants aux bardes et aux ménestrels, …."
                                            },
                                            {
                                                "example_id": "e885894d-13e3-4273-b3a9-856254a5dc55",
                                                "sense_id": "14b8e721-4e95-3071-8367-fa20f7b0bd02",
                                                "text": "De chaumières en tavernes, il écoute les bardes et les vieux rhapsodes qui lui récitent des chants populaires remontant à la nuit des temps."
                                            }
                                        ]
                                    }
                                ]
                            },
