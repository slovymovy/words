                                                "sense_id": "3c1c3beb-b202-3d4c-8d56-3879941a68e8",
                                                "text": "„Es sind winzige Siedlungen, kaum je ist die Einwohnerzahl dreistellig.“"
                                            },
                                            {
                                                "example_id": "09524e7f-195d-48c5-8824-63381a753481",
                                                "sense_id": "3c1c3beb-b202-3d4c-8d56-3879941a68e8",
                                                "text": "Die erste Siedlung entstand an der Flussmündung."
                                            }
