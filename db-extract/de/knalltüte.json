                                "target_senses": [
                                    {
                                        "sense_id": "576b0a6f-cd26-3351-934b-947255df271f",
                                        "entry_id": "01fd15fc-26bf-32ed-88be-a4c1ab31c7f6",
                                        "glosses": [
                                            "S’emploie substantivement au sens 2 et 3 de l’adjectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4d83b64-70c7-4023-a8a8-7c495f5d7387",
                                                "sense_id": "576b0a6f-cd26-3351-934b-947255df271f",
                                                "text": "Il y a, repris le petit homme, les meurtris, les vaincus, les tarés, ceux que la malchance a fleurdelysés à jamais et qui se réfugient dans ce bagne moral […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1342f61b-c8c0-3c07-85e6-e1af3726ce37",
                                        "entry_id": "5d01d459-a0bb-314a-a191-3ddbedfd4a08",
                                        "glosses": [
                                            "Participe passé masculin singulier de tarer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "taré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2df492cf-179d-3cdf-8048-323dfe5af41f",
                                        "entry_id": "b42b6cf2-72e8-3e32-9c5f-fcb897e5a7d8",
                                        "glosses": [
                                            "Qui a été comparé à une référence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "977d590c-2908-4939-93cf-eaca07e0f2f6",
                                                "sense_id": "2df492cf-179d-3cdf-8048-323dfe5af41f",
                                                "text": "Des marchandises tarées."
                                            },
                                            {
                                                "example_id": "8577e77c-6009-4d2c-aad4-83c3617d1997",
                                                "sense_id": "2df492cf-179d-3cdf-8048-323dfe5af41f",
                                                "text": "Un cheval taré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61b1886-bdde-3672-b0e0-65130c61bbac",
                                        "entry_id": "b42b6cf2-72e8-3e32-9c5f-fcb897e5a7d8",
                                        "glosses": [
                                            "Se dit d'un arbre dont le bois est défectueux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761d7e79-e3e7-4a3b-8a4e-53877f11cc35",
                                                "sense_id": "e61b1886-bdde-3672-b0e0-65130c61bbac",
                                                "text": "– Le branchage a été fabriqué, mais je n’ai pas pu vendre les troncs qui sont tarés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8dddcc-cc8c-36b4-96e5-76b0fca1245d",
                                        "entry_id": "b42b6cf2-72e8-3e32-9c5f-fcb897e5a7d8",
                                        "glosses": [
                                            "Qui est corrompu, qui est perdu de réputation."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d43d2375-2d5a-4954-ae72-5e6762e2cc01",
                                                "sense_id": "5f8dddcc-cc8c-36b4-96e5-76b0fca1245d",
                                                "text": "Un homme taré"
                                            },
                                            {
                                                "example_id": "84f13496-e3c6-4290-b749-5bf8cf6d842f",
                                                "sense_id": "5f8dddcc-cc8c-36b4-96e5-76b0fca1245d",
                                                "text": "Alors elle fit à Valentine une réponse foudroyante, lui conseilla de chercher désormais son refuge dans la protection de cette sœur tarée comme elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e19bbe-d6eb-353c-ab41-03d9d56b0a81",
                                        "entry_id": "b42b6cf2-72e8-3e32-9c5f-fcb897e5a7d8",
                                        "glosses": [
                                            "Dangereux, sans vergogne, un peu fou."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c189fe-9ebe-4b5c-968a-dbc120f60bac",
                                                "sense_id": "62e19bbe-d6eb-353c-ab41-03d9d56b0a81",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "3fd3c96b-369e-4dd2-a461-485bde6ff815",
                                                "sense_id": "62e19bbe-d6eb-353c-ab41-03d9d56b0a81",
                                                "text": "Une peste de psychologue, que mes parents m'avaient emmené voir sur le conseil d'une prof complètement tarée, avait parlé de « nonchaloir oriental » pour expliquer ces accès de paresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9e58331-059e-32da-958c-ab4f27f58b41",
                                        "entry_id": "b42b6cf2-72e8-3e32-9c5f-fcb897e5a7d8",
                                        "glosses": [
                                            "Taré, en termes de Blason, se dit de la position du heaume ou timbre de l’écu. Taré de front. Taré de côté ou de profil. (5e édition du dictionnaire de l'Académie française)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab38521-a044-402b-9d53-97243d2833ae",
                                                "sense_id": "c9e58331-059e-32da-958c-ab4f27f58b41",
                                                "text": "L'écu est timbré du casque, taré de front ; et certes le heaume a onze grilles. (Voyage du condottière, vers Venise, Holbein, par André Suarès)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
