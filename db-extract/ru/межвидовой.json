                ],
                "senses": [
                    {
                        "sense_id": "69f93cf7-35d5-3264-b397-e434d035e317",
                        "entry_id": "81e15220-223b-3e79-a05d-c15c371fc4cb",
                        "glosses": [
                            "биол. относящийся к взаимодействию между биологическими видами, представителями разных видов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0c958d-83b0-47a7-a3b4-4145f5da58cf",
                                "sense_id": "69f93cf7-35d5-3264-b397-e434d035e317",
                                "text": "Российские города не приспособлены для бесконфликтного присутствия множества безнадзорных собак, в том числе и в аспекте межвидовых отношений и в аспекте социально-культурном."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "867d0326-0757-4b86-afa2-5b1c5546eaef",
                        "source_entry_id": "81e15220-223b-3e79-a05d-c15c371fc4cb",
                        "source_sense_id": "69f93cf7-35d5-3264-b397-e434d035e317",
                        "target_lang_word": "interspecific",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interspecific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce18e1d-6637-3d03-bdc4-79bb2f14042d",
                                        "entry_id": "f7c9e6ab-4745-37c6-a5b8-9b1658127699",
                                        "glosses": [
                                            "occurring among members of different species; interspecies"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac75a59-2584-37d4-88fb-88d231885b4d",
                                        "entry_id": "f7c9e6ab-4745-37c6-a5b8-9b1658127699",
                                        "glosses": [
                                            "Existing or occurring between different species"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe52dc4b-8fb8-4b93-946b-e42422b5633e",
                                                "sense_id": "6ac75a59-2584-37d4-88fb-88d231885b4d",
                                                "text": "Interspecific crossing in the wild appears to be limited as well, at least partly due to geographic isolation. However, I. wallerana and I. usambarensis are known to have naturally hybridized in the wild (Grey-Wilson, 1980a; Grey-Wilson, 1980b). With the wonderful horticulture discovery of the New Guinea group of impatiens in the early 1970's, there was significant interest in attempting controlled interspecific pollinations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
