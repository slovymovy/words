{
    "word_family": [
        "prefixation",
        "prefixal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c88a56d-0e5d-3034-a005-b797676790b0",
                    "sense_definition": "A letter or group of letters added to the beginning of a word to change its meaning.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "linguistics_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can change the meaning of the word by adding a negative <w>prefix</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить значение слова, добавив отрицательную <w>приставку</w>.",
                                "zh": "你可以通过添加否定<w>前缀</w>来改变词义。",
                                "es": "Puedes cambiar el significado de la palabra añadiendo un <w>prefijo</w> negativo."
                            }
                        },
                        {
                            "text": "The <w>prefix</w> 're-' usually indicates that an action is being repeated.",
                            "target_lang_translations": {
                                "ru": "<w>Приставка</w> «re-» обычно указывает на то, что действие повторяется.",
                                "zh": "<w>前缀</w>“re-”通常表示动作正在重复。",
                                "es": "El <w>prefijo</w> «re-» suele indicar que una acción se repite."
                            }
                        }
                    ],
                    "antonyms": [
                        "suffix"
                    ],
                    "common_phrases": [
                        "common prefix",
                        "add a prefix",
                        "negative prefix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Буква или группа букв, добавляемая в начало слова для изменения его значения.",
                        "zh": "加在词首以改变词义的字母或字母组合。",
                        "es": "Una letra o grupo de letras que se añade al principio de una palabra para cambiar su significado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приставка",
                                "target_lang_sense_clarification": "грамматика"
                            },
                            {
                                "target_lang_word": "префикс",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前缀",
                                "target_lang_sense_clarification": "语言学"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "prefijo",
                                "target_lang_sense_clarification": "lingüística"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79f8410f-7a4b-350f-860a-efc615136d7d",
                    "sense_definition": "A set of numbers placed before a telephone number to indicate the region or country.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "telecom_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to dial the country <w>prefix</w> if you are calling from abroad.",
                            "target_lang_translations": {
                                "ru": "Вам нужно набрать <w>код</w> страны, если вы звоните из-за границы.",
                                "zh": "如果你在国外拨打电话，需要加拨国家<w>区号</w>。",
                                "es": "Debes marcar el <w>prefijo</w> del país si llamas desde el extranjero."
                            }
                        },
                        {
                            "text": "Numbers with the 0800 <w>prefix</w> are usually free to call.",
                            "target_lang_translations": {
                                "ru": "Номера с <w>кодом</w> 0800 обычно бесплатны для звонков.",
                                "zh": "以0800为<w>区号</w>的号码通常是免费电话。",
                                "es": "Los números con el <w>prefijo</w> 0800 suelen ser gratuitos."
                            }
                        }
                    ],
                    "common_phrases": [
                        "country prefix",
                        "dialling prefix",
                        "area prefix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор цифр перед телефонным номером, указывающий на регион или страну.",
                        "zh": "电话号码前用于表示地区或国家的数字序列。",
                        "es": "Un conjunto de números que se coloca antes de un número de teléfono para indicar la región o el país."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "код",
                                "target_lang_sense_clarification": "телефонный"
                            },
                            {
                                "target_lang_word": "префикс",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区号",
                                "target_lang_sense_clarification": "电话"
                            },
                            {
                                "target_lang_word": "代码",
                                "target_lang_sense_clarification": "电话"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "prefijo",
                                "target_lang_sense_clarification": "telecomunicaciones"
                            },
                            {
                                "target_lang_word": "código",
                                "target_lang_sense_clarification": "telefónico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "221b3bca-09f7-387c-a6b8-ba3c238b1d20",
                    "sense_definition": "A title added before a person's name, such as Mr., Dr., or Mrs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "titles_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please select the appropriate <w>prefix</w> for your name on the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выберите подходящее <w>обращение</w> к вашему имени в форме.",
                                "zh": "请在表格中为你的姓名选择合适的<w>称谓</w>。",
                                "es": "Por favor, selecciona el <w>tratamiento</w> adecuado para tu nombre en el formulario."
                            }
                        },
                        {
                            "text": "He prefers to use the <w>prefix</w> 'Doctor' in professional settings.",
                            "target_lang_translations": {
                                "ru": "В профессиональной среде он предпочитает использовать <w>титул</w> «Доктор».",
                                "zh": "在职业场合，他更喜欢使用“博士”这一<w>头衔</w>。",
                                "es": "Él prefiere usar el <w>título</w> de «Doctor» en entornos profesionales."
                            }
                        }
                    ],
                    "common_phrases": [
                        "honorific prefix",
                        "name prefix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул или форма вежливости, добавляемая перед именем человека (например, г-н, д-р).",
                        "zh": "加在人名前的称谓或礼貌用语，如先生、博士或女士。",
                        "es": "Un título o tratamiento que se añade antes del nombre de una persona, como Sr., Dra. o Sra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращение",
                                "target_lang_sense_clarification": "форма вежливости"
                            },
                            {
                                "target_lang_word": "титул",
                                "target_lang_sense_clarification": "звание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "称谓",
                                "target_lang_sense_clarification": "礼貌用语"
                            },
                            {
                                "target_lang_word": "头衔",
                                "target_lang_sense_clarification": "身份"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tratamiento",
                                "target_lang_sense_clarification": "forma de cortesía"
                            },
                            {
                                "target_lang_word": "título",
                                "target_lang_sense_clarification": "honorífico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5babd5e8-d62d-373e-911c-d8ac02425c32",
                    "sense_definition": "An initial segment of a string of characters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm checks if the string contains a specific <w>prefix</w>.",
                            "target_lang_translations": {
                                "ru": "Алгоритм проверяет, содержит ли строка определенный <w>префикс</w>.",
                                "zh": "该算法会检查字符串是否包含特定的<w>前缀</w>。",
                                "es": "El algoritmo comprueba si la cadena contiene un <w>prefijo</w> específico."
                            }
                        },
                        {
                            "text": "In this code, 'abra' is a <w>prefix</w> of the word 'abracadabra'.",
                            "target_lang_translations": {
                                "ru": "В этом коде «abra» — это <w>префикс</w> слова «abracadabra».",
                                "zh": "在这段代码中，“abra”是单词“abracadabra”的<w>前缀</w>。",
                                "es": "En este código, «abra» es un <w>prefijo</w> de la palabra «abracadabra»."
                            }
                        }
                    ],
                    "antonyms": [
                        "suffix"
                    ],
                    "common_phrases": [
                        "string prefix",
                        "file prefix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начальный сегмент строки символов.",
                        "zh": "字符串的起始部分。",
                        "es": "Un segmento inicial de una cadena de caracteres."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "префикс",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前缀",
                                "target_lang_sense_clarification": "计算机"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "prefijo",
                                "target_lang_sense_clarification": "informática"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0ec6c1e-72a1-343d-aa3c-f9d57a72f72f",
                    "sense_definition": "To place something at the beginning of a word, phrase, or identifier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>prefixed</w> the chapter with a short quotation.",
                            "target_lang_translations": {
                                "ru": "Автор <w>предварил</w> главу короткой цитатой.",
                                "zh": "作者在这一章开头<w>加</w>了一段简短的引语。",
                                "es": "El autor <w>antepuso</w> una breve cita al capítulo."
                            }
                        },
                        {
                            "text": "You should <w>prefix</w> the variable name with an underscore to indicate it is private.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>начать</w> имя переменной с символа подчеркивания, чтобы указать, что она приватная.",
                                "zh": "你应该在变量名前<w>加</w>下划线，以表明它是私有的。",
                                "es": "Deberías <w>anteponer</w> un guion bajo al nombre de la variable para indicar que es privada."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prefix with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать что-либо в начало слова, фразы или идентификатора.",
                        "zh": "将某物置于词语、短语或标识符的开头。",
                        "es": "Colocar algo al principio de una palabra, frase o identificador."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварять",
                                "target_lang_sense_clarification": "чем-либо"
                            },
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "с чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加前缀",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "置于……之前",
                                "target_lang_sense_clarification": "动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "anteponer",
                                "target_lang_sense_clarification": "colocar delante"
                            },
                            {
                                "target_lang_word": "prefijar",
                                "target_lang_sense_clarification": "añadir un prefijo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3dd8fef-9d24-3e00-9f3b-c9a00488a33a",
                    "sense_definition": "To determine or set something in advance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>prefixed</w> a day for the final meeting.",
                            "target_lang_translations": {
                                "ru": "Они <w>заранее назначили</w> день для заключительной встречи.",
                                "zh": "他们<w>预定</w>了一天作为最终会议的时间。",
                                "es": "Ellos <w>prefijaron</w> un día para la reunión final."
                            }
                        },
                        {
                            "text": "Fate seemed to have <w>prefixed</w> the limits of his ambition.",
                            "target_lang_translations": {
                                "ru": "Казалось, судьба <w>предопределила</w> границы его амбиций.",
                                "zh": "命运似乎早已<w>预定</w>了他野心的界限。",
                                "es": "El destino parecía haber <w>predeterminado</w> los límites de su ambición."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять или устанавливать что-либо заранее.",
                        "zh": "预先确定或设定某事。",
                        "es": "Determinar o establecer algo de antemano."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "заранее"
                            },
                            {
                                "target_lang_word": "предопределять",
                                "target_lang_sense_clarification": "о судьбе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预先设定",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "预定",
                                "target_lang_sense_clarification": "时间"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "prefijar",
                                "target_lang_sense_clarification": "establecer de antemano"
                            },
                            {
                                "target_lang_word": "predeterminar",
                                "target_lang_sense_clarification": "establecer con antelación"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}