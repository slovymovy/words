                        ],
                        "examples": [
                            {
                                "example_id": "882d7381-15f2-4489-bc3a-459af7bfd024",
                                "sense_id": "eda01c9e-c788-346e-9020-7410215576e8",
                                "text": "Actually, having been denied the right to employment in my chosen occupation, makin' chemicals, and being now a milko, i can give you the inside information on this story."
                            },
                            {
                                "example_id": "6993ea4f-bf96-48fc-afc2-3156f8fb44e0",
                                "sense_id": "eda01c9e-c788-346e-9020-7410215576e8",
                                "text": "In the resulting commotion dogs barked and the milko's horse shied, leaving broken bottles and spilt milk all over Hayes St."
                            },
                            {
                                "example_id": "0600008f-f111-4d18-83d7-46c7829d3b88",
                                "sense_id": "eda01c9e-c788-346e-9020-7410215576e8",
                                "text": "(As a child, I used to love hearing the \"clip clop clip clop\" of the milko′s horse as he arrived in our street in the morning)."
                            }
                        ]
                    }
