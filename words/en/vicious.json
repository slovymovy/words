                                "target_lang_sense_clarification": "в устойчивом выражении 'замкнутый круг'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17124271-6dc1-308e-956c-59af209cf828",
                    "sense_definition": "Characterized by immorality, depravity, or being full of <w>vice</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher warned the congregation against leading a <w>vicious</w> life filled with greed and dishonesty.",
                            "target_lang_translations": {
                                "ru": "Проповедник предостерег прихожан от <w>порочной</w> жизни, полной жадности и нечестности."
                            }
                        },
                        {
                            "text": "Even the most noble intentions can become <w>vicious</w> if they are pursued with excessive and violent desire.",
                            "target_lang_translations": {
                                "ru": "Даже самые благородные намерения могут стать <w>порочными</w>, если следовать им с чрезмерным и неистовым желанием."
                            }
                        }
                    ],
