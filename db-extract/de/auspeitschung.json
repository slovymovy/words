                "translations": [
                    {
                        "translation_id": "42094c50-bdb9-4192-8c6b-fa7e9bbf30ac",
                        "source_entry_id": "bb746b44-10f5-3996-af1d-ed2ba2a18ffc",
                        "source_sense_id": "a8f22a40-f617-3808-a449-74e81364cd44",
                        "source_sense_description": "Schlagen mit einer Peitsche",
                        "target_lang_word": "flogging",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flogging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "833f1849-ccca-3d2f-9fae-13c4bb0c7c33",
                                        "entry_id": "dd5125db-6d26-36be-8c1d-e81945ca67d9",
                                        "glosses": [
                                            "Infliction of punishment by dealing blows or whipping."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "821c1d8d-b0c0-4d39-994f-50b8d0d5c76c",
                                                "sense_id": "833f1849-ccca-3d2f-9fae-13c4bb0c7c33",
                                                "text": "What lawbreakers like that need is a good flogging. Do that and watch the crime rate plummet."
                                            },
                                            {
                                                "example_id": "641ed413-b21a-4adf-86b7-e9fa11f97a46",
                                                "sense_id": "833f1849-ccca-3d2f-9fae-13c4bb0c7c33",
                                                "text": "However, brutal floggings, increased terms of katorga, starvation diets, permanent chaining to a wheelbarrow and other fearsome sanctions failed to staunch the flow."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flogging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66093d8f-60bc-361c-99ed-613be9130476",
                                        "entry_id": "f2c223da-9bc5-377f-b52c-629f9e9e16e4",
                                        "glosses": [
                                            "A minced oath of \\\"fucking\\\" as an intensifier."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "colloquial",
                                            "euphemistic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820f718c-c239-4157-9159-98d79bdd2fcc",
                                                "sense_id": "66093d8f-60bc-361c-99ed-613be9130476",
                                                "text": "Will you get out of the flogging bathroom? We're already running late."
                                            },
                                            {
                                                "example_id": "c80f33e5-f1ff-4a4a-8648-a02867dc716f",
                                                "sense_id": "66093d8f-60bc-361c-99ed-613be9130476",
                                                "text": "Cripes, this floggin’ rain’d make you cry, wouldn’t it?"
                                            }
                                        ]
                                    }
