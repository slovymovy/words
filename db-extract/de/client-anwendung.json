                "senses": [
                    {
                        "sense_id": "5946ddb1-6672-3b3a-bdd1-9c1fb81295b7",
                        "entry_id": "807b39e6-ebb0-3e36-a311-765fd012d291",
                        "glosses": [
                            "Anwendungsprogramm, das kommuniziert, um von einem Server Dienstleistungen entgegenzunehmen oder Daten auf ihn zu übertragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588a3e40-71b2-4095-b785-348bdf2e540a",
                                "sense_id": "5946ddb1-6672-3b3a-bdd1-9c1fb81295b7",
                                "text": "„Im einfachsten Fall wird diese Client-Anwendung so konfiguriert, dass sie alle Windows-Events auf dem Desktop überwacht und die Userinformationen in die entsprechenden Felder sich öffnender Authentisierungsfenster einfügt (Windows watching).“"
                            },
                            {
                                "example_id": "9054fdc9-3cca-4ce3-8c71-3749f755d2c0",
                                "sense_id": "5946ddb1-6672-3b3a-bdd1-9c1fb81295b7",
                                "text": "„In diesem Abschnitt geht es darum, was für Funktionen grundlegend verwendet werden, um eine Client-Anwendung zu erstellen“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
