                                                "sense_id": "b0b93c19-5772-3cf9-a1b6-65e9c1fef961",
                                                "text": "EKG steht für Elektrokardiographie und bezeichnet eine Untersuchungsmethode, bei der die elektrische Aktivität des Herzens gemessen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
