                "senses": [
                    {
                        "sense_id": "dba8c012-7536-3a5c-b75b-55140809e627",
                        "entry_id": "4e246f94-6c39-3dad-949d-97a5c88d02aa",
                        "glosses": [
                            "Gespür für die eigene Ehre und das Bedürfnis, sie zu bewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62373c61-f839-46e2-9912-a2503122ce72",
                                "sense_id": "dba8c012-7536-3a5c-b75b-55140809e627",
                                "text": "„Und nun gesellte sich zu ihrem Herzenskummer noch gekränktes Ehrgefühl, um das Mass ihres Unglücks voll zu machen.“"
                            },
                            {
                                "example_id": "7b68613f-b7f3-47ab-8da8-9b5f6a303f9b",
                                "sense_id": "dba8c012-7536-3a5c-b75b-55140809e627",
                                "text": "„Da ich erst zwölf Jahre alt war, hatte mein Geist noch nicht die Kaltblütigkeit erlangt, Pläne für eine heroische Rache zu schmieden, wie sie das eingebildete Ehrgefühl ausheckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
