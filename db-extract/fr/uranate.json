                "senses": [
                    {
                        "sense_id": "08c3124a-77c2-3799-9d14-158adbef35b8",
                        "entry_id": "e812149c-6a53-34a0-8dd0-9ab66703b63b",
                        "glosses": [
                            "Anion d’uranium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405a6a91-6d9e-4a3e-ba29-e57ea8bd878d",
                                "sense_id": "08c3124a-77c2-3799-9d14-158adbef35b8",
                                "text": "Les uranates alcalins s’obtiennent par la précipitation d’un sel uranique par un alcali, ceux des métaux alcalino-terreux et autres par la précipitation d’un mélange d’un sel uranique et du sel métallique correspondant par l’ammoniaque."
                            },
                            {
                                "example_id": "5b1610f7-2823-45bf-aadb-a59ffd91a2b3",
                                "sense_id": "08c3124a-77c2-3799-9d14-158adbef35b8",
                                "text": "Les cristaux d’uranate de soude (U²O³NaO) [sic ; la notation moderne est U₂O₃NaO], qui font l’objet de cette note, proviennent de la décomposition du molybdate d’urane en présence du sel marin."
                            }
                        ]
                    }
