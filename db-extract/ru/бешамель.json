                        "source_entry_id": "f35420aa-2697-3167-ae57-dc0fe3c4172c",
                        "source_sense_id": "6ad6cc0c-3e5e-3d32-84c5-7312cc9b78ba",
                        "target_lang_word": "béchamel",
