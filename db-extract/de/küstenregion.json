                ],
                "senses": [
                    {
                        "sense_id": "0e6d9046-8200-3af5-84df-d332438db4f9",
                        "entry_id": "7d39201e-6459-3887-ac73-13084bf6f766",
                        "glosses": [
                            "räumlicher Bereich in direkter Nähe zum Ufer eines Sees, Meeres oder Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea6928e-7e8f-4dc5-89e5-28b7641b22a7",
                                "sense_id": "0e6d9046-8200-3af5-84df-d332438db4f9",
                                "text": "„Die Kolonie erhielt ebenfalls den Namen Tripolitanien, und die fruchtbaren Küstenregionen wurden rasch von italienischen Siedlern in Besitz genommen.“"
                            },
                            {
                                "example_id": "15f2f0af-a9e5-478f-bda8-090b4f2f869a",
                                "sense_id": "0e6d9046-8200-3af5-84df-d332438db4f9",
                                "text": "„Einen frühen Höhepunkt seiner Macht erlebte Vijayanagar unter dem König Deva Raya II. (1406–1422), der die tamilische Küstenregion eroberte, die einst der Mittelpunkt der Herrschaft der Cholas gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
