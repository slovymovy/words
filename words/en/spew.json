{
    "word_family": [
        "spewer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51460ec3-cdfa-320b-8d99-76d288a55633",
                    "sense_definition": "The act of vomiting or the matter that is vomited.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sick child was covered in <w>spew</w> after eating something bad.",
                            "target_lang_translations": {
                                "ru": "Больной ребенок был весь в <w>рвотных массах</w> после того, как съел что-то не то."
                            }
                        },
                        {
                            "text": "He felt nauseous and could not stop the <w>spew</w> from coming up.",
                            "target_lang_translations": {
                                "ru": "Его тошнило, и он не мог остановить <w>рвоту</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vomit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and often considered crude."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт рвоты или рвотные массы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвота",
                                "target_lang_sense_clarification": "процесс или результат извержения содержимого желудка"
                            },
                            {
                                "target_lang_word": "рвотные массы",
                                "target_lang_sense_clarification": "вещество, которое было извергнуто из желудка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea35606e-aade-37d7-8fb7-f32968fe2ef0",
                    "sense_definition": "Nonsensical, offensive, or worthless speech or writing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I refuse to listen to that political <w>spew</w> any longer.",
                            "target_lang_translations": {
                                "ru": "Я больше не желаю слушать этот политический <w>бред</w>."
                            }
                        },
                        {
                            "text": "The internet is full of hateful <w>spew</w> that serves no purpose.",
                            "target_lang_translations": {
                                "ru": "Интернет полон ненавистной <w>чуши</w>, которая не имеет никакого смысла."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "rubbish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to express strong disapproval of speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессмысленная, оскорбительная или бесполезная речь или писанина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "бессмыслица, нелепость"
                            },
                            {
                                "target_lang_word": "бред",
                                "target_lang_sense_clarification": "бессвязная или нелепая речь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e874f3ae-0443-3966-a4c7-7580da0036c6",
                    "sense_definition": "To eject something forcibly in a continuous stream.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volcano began to <w>spew</w> hot ash into the dark sky.",
                            "target_lang_translations": {
                                "ru": "Вулкан начал <w>извергать</w> горячий пепел в темное небо."
                            }
                        },
                        {
                            "text": "Old factories often <w>spew</w> thick smoke into the surrounding air.",
                            "target_lang_translations": {
                                "ru": "Старые заводы часто <w>извергают</w> густой дым в окружающий воздух."
                            }
                        }
                    ],
                    "synonyms": [
                        "eject",
                        "gush",
                        "spout"
                    ],
                    "common_phrases": [
                        "spew smoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрасывать что-либо с силой непрерывным потоком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извергать",
                                "target_lang_sense_clarification": "выбрасывать что-либо из себя (о вулканах, трубах)"
                            },
                            {
                                "target_lang_word": "изрыгать",
                                "target_lang_sense_clarification": "выбрасывать с силой, часто используется в переносном смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b0af4ea-0323-357a-8426-a45233d80bf3",
                    "sense_definition": "To vomit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of the rotten food made him want to <w>spew</w>.",
                            "target_lang_translations": {
                                "ru": "От запаха тухлой еды его начало <w>рвать</w>."
                            }
                        },
                        {
                            "text": "He had to run to the bathroom to <w>spew</w> after the long boat ride.",
                            "target_lang_translations": {
                                "ru": "После долгой поездки на лодке ему пришлось бежать в туалет, чтобы <w>блевать</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vomit",
                        "throw up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and blunt."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рвать, тошнить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блевать",
                                "target_lang_sense_clarification": "грубое, разговорное обозначение процесса рвоты"
                            },
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "разговорный вариант, означающий процесс рвоты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28139915-ddfb-35e7-bdb9-5bd09e92d1e2",
                    "sense_definition": "To speak or write a large amount of information, often in a thoughtless or aggressive manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician continued to <w>spew</w> lies to the angry crowd.",
                            "target_lang_translations": {
                                "ru": "Политик продолжал <w>изрыгать</w> ложь перед разгневанной толпой."
                            }
                        },
                        {
                            "text": "He just <w>spews</w> out facts without really understanding what they mean.",
                            "target_lang_translations": {
                                "ru": "Он просто <w>выпаливает</w> факты, не понимая их истинного значения."
                            }
                        }
                    ],
                    "synonyms": [
                        "rant",
                        "babble"
                    ],
                    "common_phrases": [
                        "spew out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать много информации, часто бездумно или агрессивно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изрыгать",
                                "target_lang_sense_clarification": "выкрикивать бранные или агрессивные слова"
                            },
                            {
                                "target_lang_word": "выпаливать",
                                "target_lang_sense_clarification": "говорить что-то быстро, бездумно или агрессивно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}