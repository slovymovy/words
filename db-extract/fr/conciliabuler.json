                        "glosses": [
                            "Parler à voix basse, chuchoter en réunion, à plusieurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a9423b-a49b-4396-ad8e-e534e1058230",
                                "sense_id": "e08cd2d1-043d-317f-85be-dadfe417f75a",
                                "text": "Elles pilent devant le rayon maquillage, conciliabulent avec vivacité, les têtes rapprochées."
                            },
                            {
                                "example_id": "55e5cb07-8d00-479b-b32d-0f08c0018ea3",
                                "sense_id": "e08cd2d1-043d-317f-85be-dadfe417f75a",
                                "text": "Ils s’éloignèrent, têtes proches, conciliabulant ou devisant simplement, allez savoir ?"
                            },
                            {
                                "example_id": "5253b05a-4e98-4f76-aea1-ced79bb0222a",
                                "sense_id": "e08cd2d1-043d-317f-85be-dadfe417f75a",
                                "text": "Des patibulaires conciliabulent avec le patron."
