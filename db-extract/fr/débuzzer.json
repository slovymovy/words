                "senses": [
                    {
                        "sense_id": "a5b9c584-1a88-3b7d-a791-bda9fc1a864a",
                        "entry_id": "4c435cca-6aaa-31db-b06e-fea8d51bce0e",
                        "glosses": [
                            "Revenir à son état normal après une consommation de drogue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35848fac-ca4e-4866-8044-17ab976846e8",
                                "sense_id": "a5b9c584-1a88-3b7d-a791-bda9fc1a864a",
                                "text": "Je suis restée dans la loge pendant à peu près une demi-heure à me préparer puis à essayer de débuzzer… à essayer de dégeler, parce que j’étais pas capable de sortir de la loge."
                            },
                            {
                                "example_id": "87e0e653-9b7b-4b2b-b952-0c57d418b40e",
                                "sense_id": "a5b9c584-1a88-3b7d-a791-bda9fc1a864a",
                                "text": "Comment débuzzer? Repose-toi, bois de l’eau, n’oublie pas d’aller aux toilettes à intervalles réguliers et laisse-toi le temps de revenir à ton état normal."
                            },
                            {
                                "example_id": "1f2299da-2319-471c-bfa7-738fec6df96c",
                                "sense_id": "a5b9c584-1a88-3b7d-a791-bda9fc1a864a",
                                "text": "Boire du lait ça ne fait pas débuzzer."
                            }
                        ]
                    }
