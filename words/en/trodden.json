                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступал",
                                "target_lang_sense_clarification": "о ходьбе, перемещении пешком"
                            },
                            {
                                "target_lang_word": "втаптывал",
                                "target_lang_sense_clarification": "вминал ногами во что-либо"
