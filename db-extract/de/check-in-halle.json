                "senses": [
                    {
                        "sense_id": "3970388e-7f73-37bb-a2cc-102ebb085099",
                        "entry_id": "c00b6f08-f385-3821-bf22-2e237303d7a6",
                        "glosses": [
                            "Halle, in welcher der Check-in beziehungsweise die Anmeldung des Reisegastes erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999d332e-b150-43f1-ab20-eb5b8d719a27",
                                "sense_id": "3970388e-7f73-37bb-a2cc-102ebb085099",
                                "text": "„In Ebene 4 des Hauptgebäudes von Terminal 2 werden die Inlands- und Schengenflüge abgefertigt. Deshalb befinden sich dort auch Check-In-Halle und Sicherheitskontrolle.“"
                            },
                            {
                                "example_id": "3ef6ccf3-cc62-4cf0-a18b-6deade050a7d",
                                "sense_id": "3970388e-7f73-37bb-a2cc-102ebb085099",
                                "text": "„Das Dach der Check-In-Halle im internationalen Flughafen von Faro im Süden Portugals ist inmitten eines heftigen Unwetters teilweise eingestürzt.“"
                            },
                            {
                                "example_id": "1a96ec1f-e2c2-4cc5-b5a5-17be5043f1c0",
                                "sense_id": "3970388e-7f73-37bb-a2cc-102ebb085099",
                                "text": "„Die Fotoausstellung ‚Spiegel der Seele‘ ist noch bis 27. August auf der Ausstellungsfläche in der Check-In-Halle im südlichen Abflugbereich von Terminal 2 zu sehen.“"
                            },
                            {
                                "example_id": "6fee8053-6433-4638-92f2-12d66cd08b8a",
                                "sense_id": "3970388e-7f73-37bb-a2cc-102ebb085099",
                                "text": "„Die Abfertigung abgehenden Großgepäcks erfolgte seit 1986 über ein Rundlauf-Sortier-band in der Gepäckhalle, die unmittelbar südlich an die Check-In-Halle anschließt.“"
                            },
                            {
                                "example_id": "11f77570-a7ef-46ee-a032-6f29ea58a758",
                                "sense_id": "3970388e-7f73-37bb-a2cc-102ebb085099",
                                "text": "„Um die Gepäckaufgabe den Bedürfnissen der Fluggäste anzupassen, sollten zukünftig Service-Points eingerichtet werden, an denen das Gepäck sowohl automatisch als auch von Personal unterstützt abgefertigt werden kann. Durch dieses Konzept könnten sich grundlegende Veränderungen in den Check-In-Hallen ergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
