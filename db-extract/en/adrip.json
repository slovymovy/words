                    {
                        "sense_id": "14a692e8-3c37-3185-8c23-024d02f25e0e",
                        "entry_id": "bc350172-f690-3be6-9df6-6f7c12beb49c",
                        "glosses": [
                            "Covered (with a liquid) to the point that it drips; having a liquid dripping off it."
