                "senses": [
                    {
                        "sense_id": "f9d756b4-fa8b-3eb2-b685-85256c2eedf4",
                        "entry_id": "b4a29146-f2c8-3e1e-a487-db9cb6aaea29",
                        "glosses": [
                            "związany z Siedmiogrodu, dotyczący Siedmiogrodu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8c6267-8727-41c3-9d38-cd524d01f585",
                                "sense_id": "f9d756b4-fa8b-3eb2-b685-85256c2eedf4",
                                "text": "Wieczór był cichy, słońce z mogił dackich / Na siedmiogrodzkich gór szczyty się toczy, / Kiedy Iwonia z okopów kozackich / Szedł w tabor pogan, łzami rosząc oczy"
                            },
                            {
                                "example_id": "9bf81dce-8c3f-45f9-9aa0-7253de08c602",
                                "sense_id": "f9d756b4-fa8b-3eb2-b685-85256c2eedf4",
                                "text": "Chociaż trzeba przyznać, że w krainie Siedmiogrodzkiej lud wierzy jeszcze w zabobony i w średniowieczne czary"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
