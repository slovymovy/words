{
    "word_family": [
        "hunt",
        "hunter",
        "hunting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "215a5a4c-baf3-36f7-9b0b-0af58bd52294",
                    "sense_definition": "Being the target of a hunt or pursuit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pursuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hunted</w> animals fled into the deep forest to escape the predators.",
                            "target_lang_translations": {
                                "ru": "<w>Преследуемые</w> животные скрылись в глубине леса, чтобы спастись от хищников."
                            }
                        },
                        {
                            "text": "Local villagers protect the <w>hunted</w> species from illegal poachers.",
                            "target_lang_translations": {
                                "ru": "Местные жители защищают <w>преследуемые</w> виды животных от незаконных браконьеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "pursued",
                        "chased"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся объектом охоты или преследования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследуемый",
                                "target_lang_sense_clarification": "тот, за кем охотятся или кого гонят"
                            },
                            {
                                "target_lang_word": "объект охоты",
                                "target_lang_sense_clarification": "животное или существо, на которое ведется охота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "750ead86-c245-3d3c-a5d7-b83bdc07f00e",
                    "sense_definition": "Appearing nervous, anxious, or fearful, as if being chased.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pursuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She glanced around with a <w>hunted</w> look in her eyes.",
                            "target_lang_translations": {
                                "ru": "Она огляделась по сторонам с <w>затравленным</w> взглядом."
                            }
                        },
                        {
                            "text": "The suspect had a <w>hunted</w> expression while waiting for the police.",
                            "target_lang_translations": {
                                "ru": "У подозреваемого было <w>затравленное</w> выражение лица, пока он ждал полицию."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxious",
                        "panicked",
                        "fearful"
                    ],
                    "antonyms": [
                        "calm",
                        "relaxed"
                    ],
                    "common_phrases": [
                        "hunted expression",
                        "hunted look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядящий нервным, встревоженным или испуганным, как будто его преследуют."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затравленный",
                                "target_lang_sense_clarification": "выражающий страх и тревогу, как у преследуемого зверя"
                            },
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "выражающий сильное беспокойство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3751cda4-3dda-3890-a3ef-6812950b1670",
                    "sense_definition": "Simple past and past participle of <w>hunt</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pursuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tribe <w>hunted</w> for food in the nearby valley.",
                            "target_lang_translations": {
                                "ru": "Древнее племя <w>охотилось</w> ради пропитания в близлежащей долине."
                            }
                        },
                        {
                            "text": "They have <w>hunted</w> in these woods for many generations.",
                            "target_lang_translations": {
                                "ru": "Они <w>охотились</w> в этих лесах на протяжении многих поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «охотиться»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охотился",
                                "target_lang_sense_clarification": "прошедшее время глагола охотиться"
                            },
                            {
                                "target_lang_word": "охотившийся",
                                "target_lang_sense_clarification": "причастие от глагола охотиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}