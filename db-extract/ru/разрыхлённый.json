                "senses": [
                    {
                        "sense_id": "31c38883-cf8e-3771-98bc-8f1b82b4e5da",
                        "entry_id": "c890280c-57b9-327d-8d39-26430d265805",
                        "glosses": [
                            "страд. прич. прош. вр. от разрыхлить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "daf63c5f-9884-410e-be08-2cc0ea02605b",
                                "sense_id": "31c38883-cf8e-3771-98bc-8f1b82b4e5da",
                                "text": "Все зеленело и лезло из разрыхлённой, сырой земли."
                            },
                            {
                                "example_id": "f912aafa-0b3d-4419-abb2-e6eeea9e3c2d",
                                "sense_id": "31c38883-cf8e-3771-98bc-8f1b82b4e5da",
                                "text": "Теперь уже не только грачи, но жаворонки прилетели, дороги грязны, снег разрыхлён (экое, однако, выскочило слово!), вода журчит везде и надуваются почки."
                            }
                        ]
                    }
