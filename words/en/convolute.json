{
    "word_family": [
        "convoluted",
        "convolution",
        "convolutedly",
        "convolutedness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9769caf5-47ca-3f41-9ea9-76c98ba78076",
                    "sense_definition": "to make something unnecessarily complex or difficult to follow",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author tends to <w>convolute</w> the plot with too many minor characters and subplots.",
                            "target_lang_translations": {
                                "ru": "Автор склонен <w>запутывать</w> сюжет слишком большим количеством второстепенных персонажей и побочных линий."
                            }
                        },
                        {
                            "text": "Please do not <w>convolute</w> the issue by bringing up unrelated problems from the past.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>усложняйте</w> вопрос, поднимая не связанные с делом проблемы из прошлого."
                            }
                        }
                    ],
                    "synonyms": [
                        "complicate",
                        "overcomplicate"
                    ],
                    "antonyms": [
                        "simplify",
                        "clarify"
                    ],
                    "common_phrases": [
                        "convolute the issue",
                        "convolute the plot"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо излишне сложным или трудным для понимания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутывать",
                                "target_lang_sense_clarification": "делать сложным для понимания"
                            },
                            {
                                "target_lang_word": "усложнять",
                                "target_lang_sense_clarification": "делать более комплексным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a271513-a770-3ad5-873e-70bf4f739a1e",
                    "sense_definition": "to confuse or mix up one thing with another",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>convolute</w> these two distinct legal concepts if you are not careful.",
                            "target_lang_translations": {
                                "ru": "Легко <w>спутать</w> эти две разные юридические концепции, если не быть осторожным."
                            }
                        },
                        {
                            "text": "The witness began to <w>convolute</w> the facts of the case during the intense cross-examination.",
                            "target_lang_translations": {
                                "ru": "Свидетель начал <w>перепутывать</w> факты дела во время напряженного перекрестного допроса."
                            }
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "muddle",
                        "jumble"
                    ],
                    "antonyms": [
                        "distinguish",
                        "separate"
                    ],
                    "common_phrases": [
                        "convolute the facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "путать или смешивать одну вещь с другой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "путать понятия или факты"
                            },
                            {
                                "target_lang_word": "перепутывать",
                                "target_lang_sense_clarification": "вносить неразбериху"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e61cc02f-7221-3d54-ac87-70064686fe5b",
                    "sense_definition": "to fold, twist, or coil into numerous overlapping layers",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internal membranes <w>convolute</w> to create a larger surface area for chemical reactions.",
                            "target_lang_translations": {
                                "ru": "Внутренние мембраны <w>сворачиваются</w>, чтобы создать большую площадь поверхности для химических реакций."
                            }
                        },
                        {
                            "text": "The artist watched the metal strips <w>convolute</w> as they were heated in the furnace.",
                            "target_lang_translations": {
                                "ru": "Художник наблюдал, как металлические полоски <w>скручиваются</w> при нагревании в печи."
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "twist",
                        "spiral"
                    ],
                    "antonyms": [
                        "unroll",
                        "unfold"
                    ],
                    "common_phrases": [
                        "convolute into layers"
                    ],
                    "target_lang_definitions": {
                        "ru": "складывать, скручивать или сворачивать во множество перекрывающихся слоев"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сворачивать",
                                "target_lang_sense_clarification": "в спираль или слои"
                            },
                            {
                                "target_lang_word": "скручивать",
                                "target_lang_sense_clarification": "придавать извилистую форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e1150604-5361-32a6-a977-c7a92cd87018",
                    "sense_definition": "having a very complicated or involved structure; <w>convoluted</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>convolute</w> reasoning behind the decision left most of the committee members confused.",
                            "target_lang_translations": {
                                "ru": "<w>Запутанная</w> аргументация, стоящая за этим решением, привела большинство членов комитета в замешательство."
                            }
                        },
                        {
                            "text": "He presented a <w>convolute</w> argument that was nearly impossible for the audience to track.",
                            "target_lang_translations": {
                                "ru": "Он представил <w>заковыристый</w> аргумент, за которым аудитории было почти невозможно уследить."
                            }
                        }
                    ],
                    "synonyms": [
                        "convoluted",
                        "intricate",
                        "complex"
                    ],
                    "antonyms": [
                        "simple",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "convolute reasoning",
                        "convolute argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий очень сложную или запутанную структуру"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "сложный для восприятия"
                            },
                            {
                                "target_lang_word": "заковыристый",
                                "target_lang_sense_clarification": "излишне сложный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b54a8fe2-182d-31a7-a215-9efb72a7361a",
                    "sense_definition": "coiled such that one edge is inside and the other is outside, creating a spiral effect",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist identified the plant by its <w>convolute</w> leaves that spiraled tightly around the stem.",
                            "target_lang_translations": {
                                "ru": "Ботаник идентифицировал растение по его <w>свернутым</w> листьям, которые плотно закручивались вокруг стебля."
                            }
                        },
                        {
                            "text": "In cross section, the shell showed a <w>convolute</w> pattern typical of that specific species.",
                            "target_lang_translations": {
                                "ru": "В поперечном сечении раковина имела <w>спиралевидный</w> узор, типичный для этого конкретного вида."
                            }
                        }
                    ],
                    "synonyms": [
                        "spiral",
                        "coiled"
                    ],
                    "common_phrases": [
                        "convolute leaves",
                        "convolute shell"
                    ],
                    "target_lang_definitions": {
                        "ru": "свернутый так, что один край находится внутри, а другой снаружи, создавая эффект спирали"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свернутый",
                                "target_lang_sense_clarification": "спиралевидный"
                            },
                            {
                                "target_lang_word": "скрученный",
                                "target_lang_sense_clarification": "о форме листьев или раковин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
