                        "target_lang_word": "distance de freinage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distance de freinage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77eb8fb1-2a6f-3840-966b-ff2ad43d7510",
                                        "entry_id": "3d6edd28-5915-3f53-b97c-1ea56f51f49c",
                                        "glosses": [
                                            "Distance dont a besoin un véhicule en marche pour s’arrêter."
                                        ],
                                        "tags": [
                                            "Sécurité routière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1b165e-408f-48d3-b18f-ccd7fb97eeab",
                                                "sense_id": "77eb8fb1-2a6f-3840-966b-ff2ad43d7510",
                                                "text": "On a proposé de majorer de 25 % la distance de freinage, pour tenir compte de ces circonstances, lorsque le véhicule parcourt une courbe dont le rayon n’est pas supérieur à 4 ou 5 fois le rayon minimal."
                                            },
                                            {
                                                "example_id": "ff330067-6db7-4dda-b2d7-db2d638d2628",
                                                "sense_id": "77eb8fb1-2a6f-3840-966b-ff2ad43d7510",
                                                "text": "Le trafic sur cette ligne est énorme : 150 trains par heure. La longueur des sections est 250 m. : une fois et demie la distance de freinage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
