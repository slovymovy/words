                "senses": [
                    {
                        "sense_id": "32dc85d5-917c-33cd-883c-6c718cca34d6",
                        "entry_id": "5b311c86-0baf-3948-a550-5efebc0c046d",
                        "glosses": [
                            "der Herrschaftssicherung dienende Burg, die besonders stark befestigt war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b09340f3-7c17-48f1-8cf1-b4b0fcdec817",
                                "sense_id": "32dc85d5-917c-33cd-883c-6c718cca34d6",
                                "text": "„Immer wieder waren fränkische Heere über die Jahre hinweg nach Sachsen eingedrungen, hatten das Land verheert, die Heiligtümer zerstört, die sächsischen Burgen gebrochen und Zwingburgen an ihre Stelle gesetzt.“"
                            },
                            {
                                "example_id": "3e831b26-3d80-438c-9f86-c41a73f2f060",
                                "sense_id": "32dc85d5-917c-33cd-883c-6c718cca34d6",
                                "text": "„Der Comte de Mazan alias Marquis de Sade wurde also schnellstens verhaftet und am 9. Dezember in die sichere Zwingburg Miolans in Savoyen gesperrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
