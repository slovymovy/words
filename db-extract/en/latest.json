                "senses": [
                    {
                        "sense_id": "a9141351-124e-31d4-b341-f9513f1823a2",
                        "entry_id": "2ae6d01c-b075-354c-9a2d-614c4ab08504",
                        "glosses": [
                            "The most recent thing, particularly information or news."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da31bbf-1018-47e1-b24e-061120d34980",
                                "sense_id": "a9141351-124e-31d4-b341-f9513f1823a2",
                                "text": "Have you heard the latest?"
                            },
                            {
                                "example_id": "04517f5a-b755-48c3-b8f5-fa1f908ea670",
                                "sense_id": "a9141351-124e-31d4-b341-f9513f1823a2",
                                "text": "What's the latest on the demonstrations in New York?"
                            },
                            {
                                "example_id": "e60eb6ae-101f-41e7-b7fb-a605c346553e",
                                "sense_id": "a9141351-124e-31d4-b341-f9513f1823a2",
                                "text": "Have you met Jane's latest? I hear he's a hunk."
                            },
                            {
                                "example_id": "1805acff-7129-4548-82a0-cb8e730eb3f8",
                                "sense_id": "a9141351-124e-31d4-b341-f9513f1823a2",
                                "text": "And like other futile edifices of man these are inhabited for a brief space giving glory to the proprietor of the most unusual or striking and then left to melt back to dust and be forgotten, or worse yet, to become curiosities for generations with other \"latests\"."
                            },
                            {
                                "example_id": "9112089f-0c7a-4f2f-bc08-cdfd6cb04f71",
                                "sense_id": "a9141351-124e-31d4-b341-f9513f1823a2",
                                "text": "It has often been said that Philadelphia is the city of firsts, Boston of bests, and New York of latests."
                            }
                        ]
                    }
                ],
