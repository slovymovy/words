                "forms": [],
                "senses": [
                    {
                        "sense_id": "de4df7b6-b9c3-31ec-b4a3-a41a1ff4d067",
                        "entry_id": "c42a9a6d-753c-3eda-b3eb-f9b102fa9ffa",
                        "glosses": [
                            "stan w USA położony na środkowym zachodzie kraju, ze stolicą w Springfield"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd3c030-3a4a-4d02-86ff-2b86ecef339f",
                                "sense_id": "de4df7b6-b9c3-31ec-b4a3-a41a1ff4d067",
                                "text": "Jako senator Illinois prezydent Obama napisał, że \"Stany Zjednoczone nie powinny tolerować\" szkaradnej rzezi fok w Kanadzie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1b79a8a8-cf8e-355c-a962-80325b9898bd",
                        "entry_id": "c42a9a6d-753c-3eda-b3eb-f9b102fa9ffa",
                        "glosses": [
                            "rzeka w USA w Illinois (1.1), dopływ Missisipi"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b65e90ec-3e4e-3145-9cf2-fccef114ec23",
                        "entry_id": "c42a9a6d-753c-3eda-b3eb-f9b102fa9ffa",
