                    },
                    {
                        "sense_id": "7910df59-e082-38a4-a516-aa55d475f2ca",
                        "entry_id": "77924e97-f41e-32fd-95ec-9d3db0d0513d",
                        "glosses": [
                            "Stabsoffizier im Range eines SS-Oberführers"
                        ],
                        "tags": [
                            "Schutzstaffel"
                        ],
                        "examples": [
                            {
                                "example_id": "31074b0c-e06b-495c-9c48-1606757429a0",
                                "sense_id": "7910df59-e082-38a4-a516-aa55d475f2ca",
                                "text": "„Zeitweise stehen auf der Gehaltsliste des ÚS-Nachrichtendienstes [sic] so prominente Alt- Nazis wie Klaus Barbie, Chef der Gestapo in Lyon, SS- [sic]Obergruppenführer Franz Alfred Six, einst im Reichssicherheitshauptamt tätig, oder SS-Oberführer Willi Krichbaum, vormals zuständig für Aktivitäten der Gestapo in Südosteuropa.“"
                            },
                            {
                                "example_id": "a8eb3ce6-474d-4556-860d-3a2d19877ea2",
                                "sense_id": "7910df59-e082-38a4-a516-aa55d475f2ca",
                                "text": "„Die SPD wollte der nach dem SS-Oberführer Karl Hoefer benannten Straße den Namen der von den Nazis ermordeten jüdischen Ärztin Berta Jacoby geben.“"
                            },
                            {
                                "example_id": "97ca47b8-8ccc-4f64-9091-5ca9d4632bc8",
                                "sense_id": "7910df59-e082-38a4-a516-aa55d475f2ca",
                                "text": "„Unter ihrem Anführer, dem aus Halle an der Saale gebürtigen SS-Oberführer Ludolf von Alvensleben, hatte sich die Miliz zu einer gnadenlosen Terrororganisation entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
