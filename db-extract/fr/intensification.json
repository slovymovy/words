                "senses": [
                    {
                        "sense_id": "f1adab4d-98b7-3cf0-b9b6-7a49a15f938c",
                        "entry_id": "403860c3-de04-3e04-8b6b-6efa734d7581",
                        "glosses": [
                            "Fait de devenir plus intense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fb1784-a3e0-4638-bc59-22d3e21d6aaf",
                                "sense_id": "f1adab4d-98b7-3cf0-b9b6-7a49a15f938c",
                                "text": "En premier lieu, la capacité des sols à valoriser l’intensification des techniques varie largement en fonction de leur nature."
                            }
                        ]
                    },
                    {
                        "sense_id": "c976ad76-ceb6-3771-b5f0-b70e0987cbf6",
                        "entry_id": "403860c3-de04-3e04-8b6b-6efa734d7581",
                        "glosses": [
                            "Action d’intensifier quelque chose, de rendre quelque chose plus intense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b3b9f5-1bc8-4ee9-b9cf-5fa88ab36165",
                                "sense_id": "c976ad76-ceb6-3771-b5f0-b70e0987cbf6",
                                "text": "L’intensification a conduit également à une simplification et à une uniformisation des paysages. La suppression des éléments semi-naturels (prairies extensives, haies, arbres) a eu pour conséquence une réduction de la variété spécifique. Si les effectifs peuvent être encore nombreux, les espèces les plus rares disparaissent au profit des plus banales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "755927aa-c090-4655-8bcb-cff31cf65174",
                        "source_entry_id": "403860c3-de04-3e04-8b6b-6efa734d7581",
