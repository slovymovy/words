                "senses": [
                    {
                        "sense_id": "a9e22929-87d5-3d2f-af71-b7d11a0bbae3",
                        "entry_id": "994f41cb-edc8-3929-ab6b-905b49548c6d",
                        "glosses": [
                            "Au sens originel de Ernst Haeckel (1866) : issu d'un seul ancêtre, d'une seule espèce."
                        ],
                        "tags": [
                            "Moins courant"
                        ],
                        "examples": [
                            {
                                "example_id": "fc117934-ab60-439d-b776-e0f44709a355",
                                "sense_id": "a9e22929-87d5-3d2f-af71-b7d11a0bbae3",
                                "text": "Cette constatation est en quelque sorte frappante et pourrait éveiller des doutes sur la valeur phylogénétique et sur l’origine monophylétique de notre genre à constituer, puisque le L. Nestleri ressemble beaucoup plus, par son port, au L. Krapffii (= marginatum), avec lequel il a jadis été confondu et même réuni, qu’au L. Siler."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f8dacea-cccd-3b75-beb7-d3df985fe309",
                        "entry_id": "994f41cb-edc8-3929-ab6b-905b49548c6d",
                        "glosses": [
                            "Au sens amendé par Willi Hennig (1950) : comprenant tous les descendants d'un unique ancêtre, constituant un clade."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": []
                    }
