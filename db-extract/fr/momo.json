                ],
                "senses": [
                    {
                        "sense_id": "40d9b858-101c-3339-bdcd-dabd61338b1b",
                        "entry_id": "8a62657a-28ad-3187-bffd-7086033c2007",
                        "glosses": [
                            "Ravioli originaire du Tibet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ff0a79b-d2f9-4adf-bbf5-a8373268d56b",
                                "sense_id": "40d9b858-101c-3339-bdcd-dabd61338b1b",
                                "text": "Renzing soulève le couvercle de la marmite, y pique avec une longue fourchette un momo, sorte de ravioli rond, et le mâche en se promenant devant les moines qui continuent leur musique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41988e48-0917-4560-95e5-6ba143106f3a",
                        "source_entry_id": "8a62657a-28ad-3187-bffd-7086033c2007",
                        "source_sense_id": "40d9b858-101c-3339-bdcd-dabd61338b1b",
                        "target_lang_word": "momo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7eeda15-ecf3-3a0b-937a-30f4587514a5",
                                        "entry_id": "32694509-bcea-319e-937b-fd9d6b9570c2",
                                        "glosses": [
                                            "A type of dumpling from Nepal, Ladakh or Tibet made with a simple flour and water dough and filled with meat, vegetables or cheese."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3843202-e5c7-478c-baab-283a9e93dca0",
                                                "sense_id": "c7eeda15-ecf3-3a0b-937a-30f4587514a5",
                                                "text": "Many dishes show a direct influence of China or India; for example, momos, or Tibetan dumplings, look like Chinese pot-stickers."
                                            },
                                            {
                                                "example_id": "3a362639-24e0-4961-8208-26683c2ffe3f",
                                                "sense_id": "c7eeda15-ecf3-3a0b-937a-30f4587514a5",
                                                "text": "She heated handpies and tofu in her off-campus apartment, and at her home in India, she heats momos, dehydrates mangoes and cooks whole, shelled peanuts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67303117-9d99-3765-a79d-2be10efaaadd",
                                        "entry_id": "32694509-bcea-319e-937b-fd9d6b9570c2",
                                        "glosses": [
                                            "A person from Northeast India."
                                        ],
                                        "tags": [
                                            "India",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a2f02d-d5e4-4227-9722-c8078dd9c254",
                                                "sense_id": "67303117-9d99-3765-a79d-2be10efaaadd",
                                                "text": "Since I come from the North-eastern part of India myself and belong to a minority race, I too have suffered from racism, at least in its milder forms. I’ve been called \"chinky\", \"momo\", \"chowmein\", and more."
                                            },
                                            {
                                                "example_id": "f9c427f0-06d6-4d94-a14e-f25ce061133b",
                                                "sense_id": "67303117-9d99-3765-a79d-2be10efaaadd",
                                                "text": "Now, it is a well-known fact that many Northeast Indians are derogatorily called 'momos' after the dish by mainland Indians for their round-ish features."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "momo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43280b7c-de73-3f91-86ab-78cae5ba4b84",
                                        "entry_id": "f0fd9429-ccb0-3170-a51a-31e6f667b79d",
                                        "glosses": [
                                            "A moron."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb8d1763-2c65-4095-8378-f327b3b46230",
                                                "sense_id": "43280b7c-de73-3f91-86ab-78cae5ba4b84",
                                                "text": "The probability on one-four-reel machine is a million and a half to one. On three machines in a row, it's in the billions. It cannot happen… would not happen, you fuckin' momo!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
