                "senses": [
                    {
                        "sense_id": "d75876ce-051c-35d6-a537-7040da3a6012",
                        "entry_id": "b90935ac-11e6-3876-ae34-4af485a710f8",
                        "glosses": [
                            "Enlever sa soutane à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95823cc5-70bc-40f4-8a4e-a35fa18552ee",
                                "sense_id": "d75876ce-051c-35d6-a537-7040da3a6012",
                                "text": "À vrai dire, je n’avais qu’un seul regret : j’aurais voulu casser la baraque, désoutaner les moines, aller jusqu’au bout de ma révolte…"
                            },
                            {
                                "example_id": "2d8985cc-664d-42c8-a889-fd0aa4cf5f47",
                                "sense_id": "d75876ce-051c-35d6-a537-7040da3a6012",
                                "text": "Vous étiez d’abord apprehendé, ensuite fouillé, déboursé, puis de la tête aux pieds deshabillé, C’est à sçavoir, débonneté, décapuchonné, décaloté, décasaqué, désoutané, décamisolé, dépantalonné, déchemisé, débragué, décalsonné, débâté, enfin meurtri, contusionné, navré, occis, & en cet état votre ennemi vent coulis pouvant vous souffler au derriere en toute liberté."
                            }
                        ]
                    }
                ],
