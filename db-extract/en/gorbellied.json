                        "glosses": [
                            "having a gorbelly; fat; potbellied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cfd5de8-83e7-42e5-b6df-a89c93d3d3cd",
                                "sense_id": "e0160872-a448-380e-940d-6fb5c6659756",
                                "text": "O, 'tis an unconscionable vast gorbellied volume, bigger bulked than a Dutch hoy, & far more boisterous and cumbersome than a pair of Swissers' omnipotent galiass-breeches."
                            },
                            {
                                "example_id": "cdc58118-865b-4516-9feb-26a9e4303c9d",
                                "sense_id": "e0160872-a448-380e-940d-6fb5c6659756",
                                "text": "Hang ye, gorbellied knaves, are ye undone? / No, ye fat chuffs I would your store were here!"
                            },
                            {
                                "example_id": "37f09c87-22eb-457b-a82e-92f7692c3cd1",
                                "sense_id": "e0160872-a448-380e-940d-6fb5c6659756",
                                "text": "Some of your gorbellied country chuffes have cast themselves into their frieze jerkins, with great tin buttons silver'd o'r."
                            },
                            {
                                "example_id": "624572c1-e05c-4c1f-9b49-82b978cd4a3f",
                                "sense_id": "e0160872-a448-380e-940d-6fb5c6659756",
                                "text": "\"Get tha gone out on't, tha gurt guttling gor-bellied mazy-jack!\" she observed acrimoniously."
                            }
                        ]
                    }
                ],
