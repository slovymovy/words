                                "target_lang_sense_clarification": "ataque mediante palabras"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "693a5938-88c0-327b-a97f-0026aa76f1f5",
