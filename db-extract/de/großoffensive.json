                "senses": [
                    {
                        "sense_id": "b82d73e9-aab3-3312-8db9-550b0e4c9795",
                        "entry_id": "4bab54e6-e645-33bd-b241-38668bdcde47",
                        "glosses": [
                            "Angriff mit sehr starken militärischen Mitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c70c82-c89c-48ab-ae1e-79b557a7bcab",
                                "sense_id": "b82d73e9-aab3-3312-8db9-550b0e4c9795",
                                "text": "„Ungewöhnlich früh im Jahr, für Mitte Februar 1916, war die erste deutsche Großoffensive geplant, bei der Festungsstadt Verdun in Lothringen.“"
                            },
                            {
                                "example_id": "23051bf6-9053-4153-89af-0ee6b6c745cf",
                                "sense_id": "b82d73e9-aab3-3312-8db9-550b0e4c9795",
                                "text": "„Im Herbst 1919 startete die Weiße Armee eine Großoffensive auf Moskau, die aber unter anderem wegen Meinungsverschiedenheiten zwischen den Generälen scheiterte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
