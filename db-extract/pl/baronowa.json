                    },
                    {
                        "translation_id": "231ee4b1-6cb9-4a1f-806b-614fcfdca2cd",
                        "source_entry_id": "9caf7561-5d6e-3b30-8e9e-5668bf97ce25",
                        "source_sense_id": "f5581263-74e7-301f-bdf2-6ec87a99137d",
                        "target_lang_word": "Baronin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baronin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39ac0805-7032-322f-b56c-3adbedd52a3f",
                                        "entry_id": "c4d14bc2-cdbd-3b41-a7ca-7ad729ac6eef",
                                        "glosses": [
                                            "französischer Adelstitel, der dem deutschen Titel Freifrau gleichwertig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7e1b05-eb3c-49a0-9899-b448df47cdf0",
                                                "sense_id": "39ac0805-7032-322f-b56c-3adbedd52a3f",
                                                "text": "Die Baronin Bertha von Suttner war eine österreichische Pazifistin und Schriftstellerin."
                                            },
                                            {
                                                "example_id": "482d093a-21ca-436d-ab4b-ac4e69c4ee35",
                                                "sense_id": "39ac0805-7032-322f-b56c-3adbedd52a3f",
                                                "text": "„Die fabelhafte Baronin von Hündeberg war in ihren aktiven Tagen Redakteurin beim Bayerischen Rundfunk gewesen.“"
                                            },
                                            {
                                                "example_id": "522cdcc8-71d5-4506-80a2-e19bf1912116",
                                                "sense_id": "39ac0805-7032-322f-b56c-3adbedd52a3f",
                                                "text": "„Die Baronin beschwert sich bei meiner Mutter im Laden.“"
                                            },
                                            {
                                                "example_id": "37c975e5-269a-477c-b2fe-7c8b60a38ca0",
                                                "sense_id": "39ac0805-7032-322f-b56c-3adbedd52a3f",
                                                "text": "„Aber Mutter, mehr denn je die Frau Baronin, besteht unerbittlich auf ihrer Anordnung.“"
                                            },
                                            {
                                                "example_id": "9103a84a-e1e9-4487-950b-c1ce07840c48",
                                                "sense_id": "39ac0805-7032-322f-b56c-3adbedd52a3f",
                                                "text": "„Die Baronin gab mir ohne Hemmungen zu verstehen, daß ich ihr gefiele und daß sie mir erlauben würde, ihr den Hof zu machen; ich machte ihr am nächsten Tag einen Besuch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
