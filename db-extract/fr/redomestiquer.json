                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c006dd-7e87-4486-9d3f-520aa434958d",
                                "sense_id": "e4636139-d32b-3bf2-97a8-cf64051a1e90",
                                "text": "Il faut simplement acheter un animal jeune facile à redomestiquer sans difficulté."
                            },
                            {
                                "example_id": "8d89c2b8-2435-4286-a5eb-50066f537ae3",
                                "sense_id": "e4636139-d32b-3bf2-97a8-cf64051a1e90",
                                "text": "Arthur Spurlock eut donc l’idée de redomestiquer ces animaux jadis habitués à l’homme et dont l’atavisme devait pouvoir aisément se réveiller."
                            }
                        ]
