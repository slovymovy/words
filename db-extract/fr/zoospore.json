                ],
                "senses": [
                    {
                        "sense_id": "385debc7-f6c0-3c9e-b151-46c75af6224d",
                        "entry_id": "d3c18444-ebc4-3d56-95e3-12d9111fb2c3",
                        "glosses": [
                            "Spore portant des cils vibratiles, chez certaines algues ou chez les Oomycètes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c882bbfa-6bf8-436c-bf41-0439e8ca85e8",
                                "sense_id": "385debc7-f6c0-3c9e-b151-46c75af6224d",
                                "text": "Ainsi, les zoospores sont très sensibles au fosétyl-al et au bénalaxyl mais moins sensibles aux autres fongicides actifs contre les oomycètes (métalaxyl, furalaxyl, propamocarbe, ofurace, cymoxanil), même après une exposition prolongée."
                            },
                            {
                                "example_id": "cdbe13c3-35e3-45aa-b8e2-55df5d6f4659",
                                "sense_id": "385debc7-f6c0-3c9e-b151-46c75af6224d",
                                "text": "Les zoospores pénètrent en effet la face inférieure des feuilles, les vrilles et les pousses tendres par de petites ouvertures dans les tissus, appelées stomates, qui rendent possibles les échanges gazeux."
                            }
                        ]
                    }
                ],
