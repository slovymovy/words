                                        "sense_id": "5a513045-7ef5-3fdb-9ad7-5ee6856cd28f",
                                        "entry_id": "ad015b9d-d435-3606-b1da-f136d43e971d",
                                        "glosses": [
                                            "reclame die gebaseerd is op hersenonderzoek"
