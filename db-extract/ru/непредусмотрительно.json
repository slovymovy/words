                        "source_entry_id": "a7ee2c84-3ab4-3beb-8d26-176a72d32c01",
                        "target_lang_word": "imprudently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                        "entry_id": "202019c9-1dfb-333b-aa93-7ac54565a607",
                                        "glosses": [
                                            "Without prudence; in an imprudent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8f03b2-632e-46fd-a2c7-b32dada80665",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "He imprudently invested all his savings into a shady scheme and lost."
                                            },
                                            {
                                                "example_id": "b7a3cd06-7ceb-4f32-bec6-27f437c19f8e",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "She spoke imprudently during the meeting, criticizing her boss without evidence."
                                            },
                                            {
                                                "example_id": "2be3f157-8479-44ff-b78a-9daaeaf209dd",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "The thinker imprudently dismissed the ontological premises of the argument without engaging in dialectical scrutiny, thereby undermining the epistemic integrity of the discourse."
                                            },
                                            {
                                                "example_id": "bf1e0bd7-a34e-4000-b624-50162b2bb447",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "The minister imprudently disclosed classified information, thereby compromising national security."
                                            },
                                            {
                                                "example_id": "ffe4579e-116b-4b9a-b1ab-664424c24a44",
                                                "sense_id": "9214bd45-7664-363d-80c8-f66ec6901939",
                                                "text": "The executive imprudently authorized the capital reallocation without conducting a due diligence audit, thereby exposing the firm to significant fiduciary risk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e4f65f3-9037-4599-9de7-e8d1b1a8e2ac",
                        "source_entry_id": "a7ee2c84-3ab4-3beb-8d26-176a72d32c01",
                        "target_lang_word": "short-sightedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "short-sightedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2726982e-d1b2-3236-9c07-8dd54deba51c",
                                        "entry_id": "390adbbc-44cc-305d-b516-f4450deb25fb",
                                        "glosses": [
                                            "in a short-sighted manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537aa9e9-fe6c-4e89-ac77-48b28256d655",
                                                "sense_id": "2726982e-d1b2-3236-9c07-8dd54deba51c",
                                                "text": "'She peered short-sightedly at Poirot through her glasses, but was quite calm.'"
                                            },
                                            {
                                                "example_id": "f24ca5ad-190c-4dd0-8a1e-a9c4ff500638",
                                                "sense_id": "2726982e-d1b2-3236-9c07-8dd54deba51c",
                                                "text": "My next stop is Oxford, which has also grown with the addition of new platforms to accommodate the Chiltern Railways service to London via Bicester - although, short sightedly, the planned electrification from Paddington was canned. Evidence of the volte-face can be seen along the line at places such as Radley, where mast piles are already sunk or lie discarded at the lineside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
