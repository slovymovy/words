                "entry_id": "9cc90fb2-f72d-3c6e-90f3-643df652a923",
                "word": "cyanoacrylate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1c1525e9-91fc-4344-bbf6-f2250fbcf312",
                        "entry_id": "9cc90fb2-f72d-3c6e-90f3-643df652a923",
                        "tags": [
                            "plural"
                        ],
                        "form": "cyanoacrylates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f85f505-3dcd-33d6-89ac-b2d7bc0b68ed",
                        "entry_id": "9cc90fb2-f72d-3c6e-90f3-643df652a923",
                        "glosses": [
                            "Ester d’acide cyanoacrylique, utilisé comme adhésif puissant et rapide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32518eb1-4803-4c47-b9ad-5d79b7d15f36",
                                "sense_id": "4f85f505-3dcd-33d6-89ac-b2d7bc0b68ed",
                                "text": "Les cyanoacrylates sont des esters de formule semi-développée CH2=C(CN)COOR qui sont des monomères qui forment par polymérisation des colles fortes, et soudent entre elles des interfaces solides."
                            },
                            {
                                "example_id": "3a6681ac-8662-423e-8ca4-abf4089f0454",
                                "sense_id": "4f85f505-3dcd-33d6-89ac-b2d7bc0b68ed",
                                "text": "Ce mélange est administré en injections successives en sandwich entre du glucosé à 5 p. 100 car le cyanoacrylate polymérise au contact de toute substance ionique, et un cathéter imparfaitement rincé avec une substance ionique aboutirait à l’occlusion complète du cathéter."
                            },
                            {
                                "example_id": "4e957a61-69b6-4e01-975e-4ee71df9e78e",
                                "sense_id": "4f85f505-3dcd-33d6-89ac-b2d7bc0b68ed",
                                "text": "Les cyanoacrylates donnent des forces de collage élevées, mais les assemblages sont cassants."
                            }
                        ]
                    }
                ],
