    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98d413b1-aede-3153-a624-370c507ed0ad",
                    "sense_definition": "A hole in a tooth caused by decay or caries.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dentistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jim got two <w>cavities</w> filled at the dentist's office yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера Джиму запломбировали две <w>дырки</w> в кабинете стоматолога."
                            }
                        },
                        {
                            "text": "If you do not brush your teeth regularly, you might develop a painful <w>cavity</w>.",
                            "target_lang_translations": {
                                "ru": "Если не чистить зубы регулярно, может развиться болезненный <w>кариес</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hole"
                    ],
                    "common_phrases": [
                        "dental cavity",
                        "fill a cavity",
                        "prevent cavities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дырка в зубе, возникшая в результате гниения или кариеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кариес",
                                "target_lang_sense_clarification": "стоматологическое заболевание"
                            },
                            {
                                "target_lang_word": "дырка",
                                "target_lang_sense_clarification": "разговорное обозначение отверстия в зубе"
                            },
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "медицинский термин для обозначения углубления в зубе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0edade7-cb75-3376-b23b-4b437e3482f1",
                    "sense_definition": "A hollow space or opening inside a solid object or a body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hollow space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully examined the abdominal <w>cavity</w> for any signs of internal bleeding.",
                            "target_lang_translations": {
                                "ru": "Хирург тщательно осмотрел брюшную <w>полость</w> на наличие признаков внутреннего кровотечения."
                            }
                        },
                        {
                            "text": "The wall <w>cavity</w> was filled with insulation to keep the house warm during winter.",
                            "target_lang_translations": {
                                "ru": "Стенная <w>пустота</w> была заполнена изоляцией, чтобы в доме было тепло зимой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "abdominal cavity",
                        "nasal cavity",
                        "wall cavity",
                        "chest cavity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустое пространство или отверстие внутри твердого объекта или тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "анатомическое или техническое пустое пространство"
                            },
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "углубление на поверхности или внутри чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "487ee964-df56-3980-aefe-57e2d2497437",
                    "sense_definition": "The hollow part of a mold into which liquid is poured to create a specific shape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The molten plastic is injected into the mold <w>cavity</w> to form the final product.",
                            "target_lang_translations": {
                                "ru": "Расплавленный пластик впрыскивается в <w>полость</w> формы для создания конечного продукта."
                            }
                        },
                        {
                            "text": "Engineers must ensure the <w>cavity</w> is perfectly smooth to avoid defects in the casting.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны убедиться, что <w>выемка</w> идеально гладкая, чтобы избежать дефектов при литье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mold cavity",
                        "injection cavity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in manufacturing and engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полая часть формы, в которую заливается жидкость для создания определенной фигуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "внутреннее пространство литейной формы"
                            },
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "отдельная ячейка в многоместной форме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
