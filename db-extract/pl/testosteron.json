                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bab2fe71-9256-4e28-ad68-8c290488ebbb",
                        "source_entry_id": "f7f760de-6f49-3384-a291-260a655012cf",
                        "source_sense_id": "60362dc9-186b-329e-9b53-aaed456279da",
                        "target_lang_word": "Testosteron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Testosteron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                        "entry_id": "ae386f12-75a8-3b24-b0d4-9cfc62269124",
                                        "glosses": [
                                            "Hormon, das für die männlichen Eigenschaften einer Person verantwortlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d46615-f787-4602-b08e-2e61be5db8a5",
                                                "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                                "text": "„Vor vielen Jahrhunderten, als das Leben noch Sinn hatte, da zog der junge Mann voller Energie und Testosteron in den Krieg und reagierte sich dort ab, während die Frauen daheim ihm drohten, er solle entweder siegreich oder tot nach Hause kommen.“"
                                            },
                                            {
                                                "example_id": "212d74e7-ecaf-40b5-ae53-8b079c66e9c0",
                                                "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                                "text": "„Dass Männer sich in jungen Jahren deutlich risikobereiter verhalten und dementsprechend häufiger in tödliche Autounfälle verwickelt sind, führen Wissenschaftler zwar teilweise auf die Wirkung des Testosterons zurück, das die Risikobereitschaft steigert. Aber das ist nur ein Teil der Wahrheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9331bf16-292f-465f-8596-99003c2aa6d2",
                        "source_entry_id": "f7f760de-6f49-3384-a291-260a655012cf",
                        "source_sense_id": "60362dc9-186b-329e-9b53-aaed456279da",
                        "target_lang_word": "тестостерон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тестостерон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bfcc0967-280d-3a1a-83ae-ee0ff8d7d239",
                                        "entry_id": "94b29e3c-a618-38cb-af8c-ffed80196be7",
                                        "glosses": [
                                            "биол., мед. основной мужской половой гормон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db074513-57f8-4230-a01c-d1c099e12f45",
                                                "sense_id": "bfcc0967-280d-3a1a-83ae-ee0ff8d7d239",
                                                "text": "Тестостерон против облысения ¶ Американские дерматологи Кристофер Папа и Альберт Клигмен сообщают об успешном применении мужского полового гормона тестостерона для борьбы с облысением."
                                            },
                                            {
                                                "example_id": "4d442d4f-625c-4854-ab9e-158ccb535daf",
                                                "sense_id": "bfcc0967-280d-3a1a-83ae-ee0ff8d7d239",
                                                "text": "Интерстициальные эндокриноциты яичка выделяют мужской половой гормон тестостерон."
                                            },
                                            {
                                                "example_id": "7370dd44-4b58-4062-b12a-5b7c32ba2e8a",
                                                "sense_id": "bfcc0967-280d-3a1a-83ae-ee0ff8d7d239",
                                                "text": "Мы просто-напросто свидетели «суеверной», как сказал поэт, «и угодливой любви пожилого человека». И в том-то и дело, что система несвободы в нашем любезном отечестве предоставляет ему полную свободу разрушать значимую вещь во имя остатков своего тестостерона."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
