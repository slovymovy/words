{
    "word_family": [
        "point",
        "pointy",
        "pointless",
        "checkpoint",
        "endpoint",
        "viewpoint"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84dbc5ce-b57b-3824-b8eb-3a8146b66a14",
                    "sense_definition": "A small but useful piece of practical advice or a tip.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "advice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructor gave me some <w>pointers</w> on writing a good paper.",
                            "target_lang_translations": {
                                "ru": "Инструктор дал мне несколько <w>советов</w> по написанию хорошей работы."
                            }
                        },
                        {
                            "text": "I can give you a few helpful <w>pointers</w> before you start your first day at the new job.",
                            "target_lang_translations": {
                                "ru": "Я могу дать тебе несколько полезных <w>подсказок</w> перед твоим первым рабочим днем на новом месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "advice"
                    ],
                    "common_phrases": [
                        "helpful pointers",
                        "give some pointers",
                        "useful pointers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, но полезный практический совет или подсказка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "практическая рекомендация"
                            },
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "полезное указание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8762c1ca-ff9f-3ab6-8569-9af387405e07",
                    "sense_definition": "A small symbol or icon on a computer screen that moves when you move the mouse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indicator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system notifies the user of the progress of a task by changing the appearance of the <w>pointer</w>.",
                            "target_lang_translations": {
                                "ru": "Система уведомляет пользователя о ходе выполнения задачи, изменяя внешний вид <w>указателя</w>."
                            }
                        },
                        {
                            "text": "Move the mouse <w>pointer</w> to the top of the screen to see the menu.",
                            "target_lang_translations": {
                                "ru": "Переместите <w>курсор</w> мыши в верхнюю часть экрана, чтобы увидеть меню."
                            }
                        }
                    ],
                    "synonyms": [
                        "cursor"
                    ],
                    "common_phrases": [
                        "mouse pointer",
                        "screen pointer",
                        "move the pointer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой символ или значок на экране компьютера, который перемещается при движении мыши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "курсор мыши"
                            },
                            {
                                "target_lang_word": "курсор",
                                "target_lang_sense_clarification": "графический маркер на экране"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "981c894b-3e2f-3c81-9644-ac76c7272b68",
                    "sense_definition": "A long, thin stick used by a teacher to direct attention to something on a map or blackboard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indicator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor used a wooden <w>pointer</w> to show the different countries on the map.",
                            "target_lang_translations": {
                                "ru": "Профессор использовал деревянную <w>указку</w>, чтобы показать разные страны на карте."
                            }
                        },
                        {
                            "text": "She tapped the chalkboard with her <w>pointer</w> to get the students' attention.",
                            "target_lang_translations": {
                                "ru": "Она постучала по доске своей <w>указкой</w>, чтобы привлечь внимание студентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "laser pointer",
                        "wooden pointer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная тонкая палочка, используемая учителем для привлечения внимания к чему-либо на карте или доске."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указка",
                                "target_lang_sense_clarification": "инструмент учителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb4a0f9f-89a0-31d9-872e-366005dd73ba",
                    "sense_definition": "A needle or hand on a clock, scale, or measuring instrument that shows a specific value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indicator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pointer</w> on the scale moved slowly as I added more flour to the bowl.",
                            "target_lang_translations": {
                                "ru": "<w>Стрелка</w> на весах медленно двигалась, пока я добавлял муку в миску."
                            }
                        },
                        {
                            "text": "When the <w>pointer</w> reaches the red zone, you must stop the machine immediately.",
                            "target_lang_translations": {
                                "ru": "Когда <w>указатель</w> достигнет красной зоны, вы должны немедленно остановить машину."
                            }
                        }
                    ],
                    "synonyms": [
                        "needle",
                        "hand"
                    ],
                    "common_phrases": [
                        "dial pointer",
                        "scale pointer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игла или стрелка на часах, весах или измерительном приборе, показывающая определенное значение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелка",
                                "target_lang_sense_clarification": "индикатор прибора"
                            },
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "контрольно-измерительный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "796153cf-836f-3987-ab6f-550d460969aa",
                    "sense_definition": "A breed of large hunting dog that is trained to stand still and point its nose toward game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter took his English <w>Pointer</w> into the field to help find the birds.",
                            "target_lang_translations": {
                                "ru": "Охотник взял своего английского <w>пойнтера</w> в поле, чтобы тот помог найти птиц."
                            }
                        },
                        {
                            "text": "A <w>pointer</w> is known for its athletic build and its ability to stay perfectly still.",
                            "target_lang_translations": {
                                "ru": "<w>Пойнтер</w> известен своим атлетическим телосложением и способностью оставаться совершенно неподвижным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "English pointer",
                        "German shorthaired pointer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порода крупных охотничьих собак, обученных замирать и указывать носом на дичь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пойнтер",
                                "target_lang_sense_clarification": "порода легавых собак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "051227d7-3685-3574-98ae-f8709876ab61",
                    "sense_definition": "In sports, a shot or score that is worth a specific number of points.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basketball player made a crucial <w>three-pointer</w> in the final seconds of the game.",
                            "target_lang_translations": {
                                "ru": "Баскетболист забросил решающий <w>трехочковый</w> на последних секундах игры."
                            }
                        },
                        {
                            "text": "He celebrated after hitting a <w>three-pointer</w> from the corner of the court.",
                            "target_lang_translations": {
                                "ru": "Он праздновал после того, как забил <w>трехочковый</w> из угла площадки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "three-pointer",
                        "two-pointer"
                    ],
                    "target_lang_definitions": {
                        "ru": "В спорте: бросок или очко, приносящее определенное количество баллов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очковый бросок",
                                "target_lang_sense_clarification": "в баскетболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c41b66e3-96eb-300c-b930-56663994aad7",
                    "sense_definition": "A variable in computer programming that stores the memory address of another value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do consider assignment statements and <w>pointer</w> variables to be among computer science's most valuable treasures.",
                            "target_lang_translations": {
                                "ru": "Я действительно считаю операторы присваивания и переменные-<w>указатели</w> одними из самых ценных сокровищ информатики."
                            }
                        },
                        {
                            "text": "If you do not initialize the <w>pointer</w> correctly, the program might crash when it tries to access the memory.",
                            "target_lang_translations": {
                                "ru": "Если вы неправильно инициализируете <w>указатель</w>, программа может завершиться сбоем при попытке доступа к памяти."
                            }
                        }
                    ],
                    "synonyms": [
                        "reference"
                    ],
                    "common_phrases": [
                        "null pointer",
                        "pointer variable",
                        "memory pointer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переменная в программировании, которая хранит адрес памяти другого значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "адрес в памяти"
                            },
                            {
                                "target_lang_word": "пойнтер",
                                "target_lang_sense_clarification": "жаргон программистов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f53c61dd-a24e-36fa-b5e0-34c9d62c764d",
                    "sense_definition": "A person who points at something with their finger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sidled closer and heard the <w>pointer</w> accuse the other man of cheating.",
                            "target_lang_translations": {
                                "ru": "Я подошел ближе и услышал, как <w>указывающий</w> обвиняет другого человека в мошенничестве."
                            }
                        },
                        {
                            "text": "The finger <w>pointer</w> continued to gesture aggressively while shouting at the crowd.",
                            "target_lang_translations": {
                                "ru": "Человек, <w>показывающий пальцем</w>, продолжал агрессивно жестикулировать, крича на толпу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "finger pointer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который указывает на что-то пальцем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывающий",
                                "target_lang_sense_clarification": "тот, кто показывает пальцем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "be807400-35a5-3ab1-862c-27fece019d6a",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Pointer</w> family has lived in this small village for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Пойнтер</w> живет в этой небольшой деревне уже несколько поколений."
                            }
                        },
                        {
                            "text": "We are meeting with Mr. <w>Pointer</w> tomorrow to discuss the legal details of the contract.",
                            "target_lang_translations": {
                                "ru": "Завтра мы встречаемся с мистером <w>Пойнтером</w>, чтобы обсудить юридические детали контракта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пойнтер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}