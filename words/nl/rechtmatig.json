    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df824ee8-0084-34fd-8881-5914589f648a",
                    "sense_definition": "in overeenstemming met de wet of geldende regels",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat betoogde dat de aanhouding van zijn cliënt niet <w>rechtmatig</w> was.",
                            "target_lang_translations": {
                                "fr": "L'avocat a soutenu que l'arrestation de son client n'était pas <w>légale</w>."
                            }
                        },
                        {
                            "text": "De gemeente is verantwoordelijk voor een <w>rechtmatige</w> uitvoering van de regeling.",
                            "target_lang_translations": {
                                "fr": "La commune est responsable de l'application <w>légale</w> du règlement."
                            }
                        }
                    ],
                    "synonyms": [
                        "wettig"
                    ],
                    "antonyms": [
                        "onrechtmatig"
                    ],
                    "common_phrases": [
                        "rechtmatige eigenaar",
                        "rechtmatige eigenares"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui est conforme à la loi ou aux règles en vigueur"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "légal",
                                "target_lang_sense_clarification": "conforme à la loi"
                            },
                            {
                                "target_lang_word": "légitime",
                                "target_lang_sense_clarification": "conforme au droit ou à l'autorité établie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e1a2c6-eae3-3fc6-a0e6-3b34b8ea2321",
                    "sense_definition": "gebaseerd op rechtvaardigheid of goede redenen; gerechtvaardigd",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moreel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De werknemers hadden een <w>rechtmatige</w> reden om te staken tegen de bezuinigingen.",
                            "target_lang_translations": {
                                "fr": "Les employés avaient une raison <w>légitime</w> de faire grève contre les coupes budgétaires."
                            }
                        },
                        {
                            "text": "Haar woede over het oneerlijke besluit was volkomen <w>rechtmatig</w>.",
                            "target_lang_translations": {
                                "fr": "Sa colère face à cette décision injuste était tout à fait <w>légitime</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "fondé sur la justice, l'équité ou de bonnes raisons ; justifié"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "légitime",
                                "target_lang_sense_clarification": "moralement justifié, fondé"
                            },
                            {
                                "target_lang_word": "justifié",
                                "target_lang_sense_clarification": "qui a de bonnes raisons d'être"
                            }
                        ]
                    }
                }
            ]
        }
    ]
