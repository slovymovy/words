                "senses": [
                    {
                        "sense_id": "774f7f2b-20d5-3a88-9cda-0fd3dc755f58",
                        "entry_id": "b51aaa3c-1f9e-33da-92c4-c0b82379dc58",
                        "glosses": [
                            "angeborene oder erworbene Störung der Wahrnehmung von Farben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe371d49-afa8-46ef-b02f-bc92965942d3",
                                "sense_id": "774f7f2b-20d5-3a88-9cda-0fd3dc755f58",
                                "text": "„Die Ausprägung der Störungen ist unterschiedlich und reicht von einer im Alltag kaum merklichen Farbenschwäche bis zur vollständigen Farbenblindheit.“"
                            },
                            {
                                "example_id": "c32d6deb-3eb3-46e8-977b-12c04ca4ec8c",
                                "sense_id": "774f7f2b-20d5-3a88-9cda-0fd3dc755f58",
                                "text": "„Dabei ist es wirklich ein Glück, dass ich eine Farbenschwäche habe und daher völlig inkompetent bin, was Bekleidungsfragen betrifft.“"
                            },
                            {
                                "example_id": "536ffc5c-5f69-4363-8aa2-65a8cdf28c14",
                                "sense_id": "774f7f2b-20d5-3a88-9cda-0fd3dc755f58",
                                "text": "„Dieser Befund läßt den Schluß auf das Vorhandensein einer Farbenschwäche oder Farbenblindheit zu.“"
                            },
                            {
                                "example_id": "a1287e16-ce5e-41d5-af24-73398e82dccb",
                                "sense_id": "774f7f2b-20d5-3a88-9cda-0fd3dc755f58",
                                "text": "„Hering sah seine Hypothese unterstützt durch die ihm bekannten Fälle der Farbenblindheit (Farbenschwäche), mehr noch durch das Phänomen der Farbkontraste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
