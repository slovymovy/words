                "senses": [
                    {
                        "sense_id": "abd5649d-76ad-30f6-a46b-258f310b9fe4",
                        "entry_id": "7d123c87-8f91-36a8-bacd-770dad8646e2",
                        "glosses": [
                            "Assimiler à de la viande de porc, du point de vue des principes religieux musulmans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7344d3-80fb-4868-9d63-0cf7c03f2220",
                                "sense_id": "abd5649d-76ad-30f6-a46b-258f310b9fe4",
                                "text": "Tes ondes occultes ont haloufisé mon téléphone !"
                            },
                            {
                                "example_id": "02ffea63-86f6-4e46-a6bf-ad463a6c4ce7",
                                "sense_id": "abd5649d-76ad-30f6-a46b-258f310b9fe4",
                                "text": "Ca fait flipper toutes ses histoires de lait entre le lait chinois, le lait haloufisé."
                            },
                            {
                                "example_id": "bceabd9b-a173-445c-9c67-820ea4c8322c",
                                "sense_id": "abd5649d-76ad-30f6-a46b-258f310b9fe4",
                                "text": "Et si oui, est-ce que si cette cuisse de poulet haloufisé touche un steak haché, ce steak haché devient haram ?"
                            }
                        ]
                    }
