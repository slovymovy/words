                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cd02e2b-6b19-3f81-8cae-700441e89c45",
                        "entry_id": "0db931cb-77a7-331d-bd31-599635c40ffa",
                        "glosses": [
                            "hormon płciowy o działaniu maskulinizującym, fizjologicznie występujący u mężczyzn i w małych stężeniach u kobiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9547de42-91d0-4ec7-9ddc-67f7beca64b4",
                                "sense_id": "3cd02e2b-6b19-3f81-8cae-700441e89c45",
                                "text": "Nadmierny łojotok występuje w okresie pokwitania, przy zaburzeniach czynności hormonalnych, przy stosowaniu niektórych leków hormonalnych, w tym androgenów i testosteronu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0af335f4-deb4-40cb-ba90-2d8b5be40fda",
                        "source_entry_id": "0db931cb-77a7-331d-bd31-599635c40ffa",
                        "source_sense_id": "3cd02e2b-6b19-3f81-8cae-700441e89c45",
                        "target_lang_word": "androgen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "androgen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5610206b-d0a6-3f03-af19-686cd2e580bf",
                                        "entry_id": "12863fcf-e9a5-3c13-9a21-fd1c7891f622",
                                        "glosses": [
                                            "Any natural or synthetic compound, usually a steroid hormone, that stimulates or controls the development and maintenance of masculine characteristics in vertebrates. A male sex hormone such as testosterone or anabolic steroids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ecb75bb-2ff6-40c2-bc22-ce385cac243b",
                                                "sense_id": "5610206b-d0a6-3f03-af19-686cd2e580bf",
                                                "text": "It is known as Hatschek's pit and has been found to react positively to antibodies against substance P, met-enkephalin, cholecystokinin (CCK), mammalian luteinizing hormone (LH), and the enzyme aromatase (P450ₐᵣₒ), which converts certain androgens into estrogens (see Chapter 3)."
                                            },
                                            {
                                                "example_id": "0a45d009-dac1-4d3b-a2fa-b097b3417cde",
                                                "sense_id": "5610206b-d0a6-3f03-af19-686cd2e580bf",
                                                "text": "However, high levels of the nonaromatizable androgen dihydrotestosterone and of sex-hormone binding globulin that inhibit fat accumulation in the abdomen might also contribute to reducing the waist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0a2e9e2-1a9b-469e-8239-3e91fc3403ea",
                        "source_entry_id": "0db931cb-77a7-331d-bd31-599635c40ffa",
                        "source_sense_id": "3cd02e2b-6b19-3f81-8cae-700441e89c45",
                        "target_lang_word": "androgène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "androgène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1eb3a564-5ee0-3089-b229-49743ff91dad",
                                        "entry_id": "2113b210-a9a7-358b-a6ea-111564c64c5a",
                                        "glosses": [
                                            "Qui provoque l’apparition des caractères sexuels masculins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855c8e6c-7003-4bd1-909d-6b23388b089e",
                                                "sense_id": "1eb3a564-5ee0-3089-b229-49743ff91dad",
                                                "text": "Les hormones androgènes sont des hormones sexuelles responsables de la formation et du maintien des caractères sexuels mâles primaires et secondaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "androgène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf13e0ba-8fc8-30b5-8e9c-14d2c1a0b56c",
                                        "entry_id": "01f73bb3-c9f8-33af-af7c-4dc46a53cbd6",
                                        "glosses": [
                                            "Hormone stéroïdienne favorisant le développement et le maintien des caractères sexuels masculins, telle que la testostérone ou la dihydrotestostérone, présente chez les mâles et en plus faible quantité chez les femelles."
                                        ],
                                        "tags": [
                                            "Endocrinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3999f74-e2e4-47a2-b142-54bec5bedd46",
                                                "sense_id": "bf13e0ba-8fc8-30b5-8e9c-14d2c1a0b56c",
                                                "text": "Seules la testostérone et la dihydrotestostérone sont des androgènes actifs qui se lient spécifiquement aux récepteurs des androgènes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71a8ebf8-cb3f-46ec-9cad-f65279a9d478",
                        "source_entry_id": "0db931cb-77a7-331d-bd31-599635c40ffa",
                        "source_sense_id": "3cd02e2b-6b19-3f81-8cae-700441e89c45",
                        "target_lang_word": "andrógeno",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "andrógeno",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "13b97e3d-8595-3952-bd01-e83f810df73d",
                                        "entry_id": "e246bcf1-9e0e-3954-8f6b-6e60debfb500",
                                        "glosses": [
                                            "Nombre que agrupa a las hormonas sexuales masculinas siendo las principales: testosterona, la androsterona y la androstendiona. Los andrógenos son hormonas esteroideas, cuya función principal es estimular el desarrollo de los caracteres sexuales masculinos en los vertebrados."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e837f02-17d5-405c-a917-ae56da5f69b3",
                        "source_entry_id": "0db931cb-77a7-331d-bd31-599635c40ffa",
                        "source_sense_id": "3cd02e2b-6b19-3f81-8cae-700441e89c45",
