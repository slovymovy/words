        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "63f764a5-140f-3091-84d3-a7db40eca0ae",
                "word": "blowout",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "694ec1c0-c871-46a9-b51f-fd77afb554cb",
