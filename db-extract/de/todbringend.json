                    {
                        "form_id": "9576d24e-a68a-4763-8c34-7fc577713810",
                        "entry_id": "4d598118-b622-3986-839e-2d98f2279c63",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind todbringend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0344acee-c5b8-3108-ba87-17698cc7b3c2",
                        "entry_id": "4d598118-b622-3986-839e-2d98f2279c63",
                        "glosses": [
                            "zum Tod führend, tödlich endend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2771403-1196-45b9-8d5b-eee40570e955",
                                "sense_id": "0344acee-c5b8-3108-ba87-17698cc7b3c2",
                                "text": "„Und erst der Feuerbrunnen selbst – was ist das Geheimnis seiner Verlockung, was steckt hinter seinem todbringenden Gesang?“"
                            },
                            {
                                "example_id": "74acb3a8-7d46-484d-a601-b14a583a3cc3",
                                "sense_id": "0344acee-c5b8-3108-ba87-17698cc7b3c2",
                                "text": "„Dewey warf einen Blick in den Helm auf die aus den Höhlen getretenen Augen. Er sah zu, wie dieser sich mit Blut und unter todbringendem Druck stehendem Meerwasser füllte.“"
                            },
                            {
                                "example_id": "f0ef2d32-1d1a-4cae-8efe-60d4b9208a8d",
                                "sense_id": "0344acee-c5b8-3108-ba87-17698cc7b3c2",
                                "text": "„An der Schwelle zu dieser großartigen, todbringenden Landschaft, in der Gesellschaft dieser Männer, die angeblich seine Landsleute sind, fühlt sich K.D. Yadav vollkommen allein.“"
                            },
                            {
