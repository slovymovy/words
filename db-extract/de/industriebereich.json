                ],
                "senses": [
                    {
                        "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                        "entry_id": "7c6ec034-c3bb-3026-b9fe-3890d14d24b5",
                        "glosses": [
                            "Gruppe von Unternehmen, die nah verwandte Produkte, Güter, Waren und Dienstleistungen herstellen und anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba7de3f-145d-4ba6-830e-574b88082b74",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„Papiere aus dem Finanz-, Einzelhandels- und Industriebereich kommen auf einen Anteil von etwa 50 Prozent im Portfolio, wenn man die einzelnen Werte gleich gewichtet.“"
                            },
                            {
                                "example_id": "a26ef169-1a4d-4978-921a-b35dd4da129c",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„‚Investitionszeiträume im Energie- und Industriebereich betragen oft 30 bis 50 Jahre: Was heute gebaut wird, wird im Jahr 2050 noch in Betrieb sein‘, schreiben die Professoren.“"
                            },
                            {
                                "example_id": "5e2f943e-c06a-4367-8c57-a36f424676f0",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„Der 26-Jährige machte nach seiner Schulzeit eine Ausbildung als Mechatroniker im Industriebereich beim Automobilhersteller Opel in Kaiserslautern.“"
                            },
                            {
                                "example_id": "3e4324ef-9761-4ebd-ab10-2dcfbdd1e9b6",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„Aber auch im Industriebereich gelang zum Beispiel Heidelberg Cement eine Kapitalerhöhung.“"
                            },
                            {
                                "example_id": "99e9bce9-afd2-4471-8ca3-0582f0b6d8ca",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„In den Sektoren Schiffbau mit einem Weltmarktanteil von 55 bis 60 Prozent, Verteidigung (80 Prozent) und dem klassischen Industriebereich (30 Prozent) sieht man kein großes Expansionspotential mehr.“"
                            },
                            {
                                "example_id": "342589c9-ed29-466a-8289-ec780ca38b44",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„Sie dürften stärker Einzug auch in den Industriebereich halten.“"
                            },
                            {
                                "example_id": "de92d1d4-3be8-482e-a607-e10c29ce8fc5",
                                "sense_id": "77ad51d8-5594-3be1-8852-6c0a4e24d994",
                                "text": "„Leichte Abkühlung in der Industrie Leichte Abkühlungstendenzen zeigten sich zuletzt vor allem im Industriebereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
