                        "cross_references": [
                            {
                                "target_word": "orphan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38d3639a-8c52-3062-a4d0-5e0d568f4b03",
                                        "entry_id": "6fcd0d2a-536c-3b02-98db-b0599859b249",
                                        "glosses": [
                                            "A person, especially a minor, both or (rarely) one of whose parents have died."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e72635a-3884-4357-b620-1d98ac8f335f",
                                                "sense_id": "38d3639a-8c52-3062-a4d0-5e0d568f4b03",
                                                "text": "Rudolf was the bold, bad Baron of traditional melodrama. Irene was young, as pretty as a picture, fresh from a music academy in England. He was the scion of an ancient noble family; she an orphan without money or friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "512e083a-e1c9-3a18-a62c-d69c0d0455de",
                                        "entry_id": "6fcd0d2a-536c-3b02-98db-b0599859b249",
                                        "glosses": [
                                            "A person, especially a minor, whose parents have permanently abandoned them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "349de2bb-33a5-3109-a8e8-bbf60c6615fe",
                                        "entry_id": "6fcd0d2a-536c-3b02-98db-b0599859b249",
                                        "glosses": [
                                            "A young animal with no mother."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2c96d3e-eacf-3b08-acc6-4963c993ef46",
                                        "entry_id": "6fcd0d2a-536c-3b02-98db-b0599859b249",
                                        "glosses": [
                                            "Anything that is unsupported, as by its source, provider or caretaker, by reason of the supporter's demise or decision to abandon."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e6c29b2-b97c-34e3-aee6-2d35be0c085c",
                                        "entry_id": "6fcd0d2a-536c-3b02-98db-b0599859b249",
                                        "glosses": [
                                            "A single line of type, beginning a paragraph, at the bottom of a column or page."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51a40179-75fb-398e-905a-2e82b87b9aa6",
                                        "entry_id": "6fcd0d2a-536c-3b02-98db-b0599859b249",
                                        "glosses": [
                                            "Any unreferenced object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab04adc8-262a-4c28-b6c0-844a146a9131",
                                                "sense_id": "51a40179-75fb-398e-905a-2e82b87b9aa6",
                                                "text": "An orphan isn't harmful in a language that has garbage collection, such as Java. However, reducing the number of orphans can be expected to improve code performance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orphan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2b5702-6ee6-3fdf-a548-78c7cfeda8aa",
                                        "entry_id": "7f212e98-1ff1-3c2b-827f-ea4418664bd4",
                                        "glosses": [
                                            "Deprived of parents (also orphaned)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7ac83ca-a9a1-4147-800e-40c969b73c4c",
                                                "sense_id": "3e2b5702-6ee6-3fdf-a548-78c7cfeda8aa",
                                                "text": "She is an orphan child."
