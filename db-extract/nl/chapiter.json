        "nl-extract.jsonl": [
            {
                "entry_id": "49e4176b-70a0-3c96-a3be-8bc19498a283",
                "word": "chapiter",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d69b3eb4-a8ad-43f3-a144-dd58176dc4d8",
                        "entry_id": "49e4176b-70a0-3c96-a3be-8bc19498a283",
                        "tags": [
                            "plural"
                        ],
                        "form": "chapiters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7304d32-8fba-3bfe-9112-59a2cd110993",
                        "entry_id": "49e4176b-70a0-3c96-a3be-8bc19498a283",
                        "glosses": [
                            "hoofdstuk van een boek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238f1be6-80ea-4e54-bdbf-cd9553790d08",
                                "sense_id": "c7304d32-8fba-3bfe-9112-59a2cd110993",
                                "text": "Anders dan haar vader wist Otten te herstellen van haar burn-out. In 1995 gaf ze haar door de aandoening van haar vader verpeste jeugd een glorieuze herkansing met haar romandebuut Blauw Metaal. Daarop volgden succesvolle literaire non-fictie boeken zoals De laatste dichters (2004) en romans als In wonderland (2010), waarin ze in bedekte vorm haar eigen angsten bezweert. Die bedekking is in Om adem te kunnen halen verdwenen, alles is direct aan de werkelijkheid ontleend. Het boek is dan ook onmogelijk als roman te bestempelen, alhoewel er fictieve elementen in zitten, waarbij de schrijfster in het hoofd van de vader kruipt. Dat zijn ook meteen de zwakste chapiters."
                            }
                        ]
                    },
                    {
                        "sense_id": "7147b7c6-34cf-3c75-81d8-d76d0bf154af",
                        "entry_id": "49e4176b-70a0-3c96-a3be-8bc19498a283",
                        "glosses": [
                            "onderwerp van een gesprek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026d1d16-2ef8-47c7-a06c-9367f89bb101",
                                "sense_id": "7147b7c6-34cf-3c75-81d8-d76d0bf154af",
                                "text": "Wie de Europese wijk in Brussel binnenrijdt, ziet geen crisis. Overal staan bouwkranen. Het hoofdkwartier van president Herman Van Rompuy van de Europese Unie, geraamd op 240 miljoen euro, staat in de steigers. Deze bouwwoede kan de fragiele fundamenten van de EU niet verbloemen. De begrotingscrisis is het volgende chapiter in de permanente geldruzie. De EU bespreekt een meerjarenbegroting voor de periode 2014 tot 2020, maar regeringsleiders blijven verdeeld. Tegelijk haalden enkele correspondenten in Brussel uit naar de bestedingscultuur van de Europese instellingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcb2789b-2ad4-44c6-924b-0d211583537c",
                        "source_entry_id": "49e4176b-70a0-3c96-a3be-8bc19498a283",
                        "source_sense_id": "c7304d32-8fba-3bfe-9112-59a2cd110993",
                        "source_sense_description": "hoofdstuk van een boek",
                        "target_lang_word": "chapter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac4b971-c1b9-327c-b331-ce9a25adb024",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "One of the main sections into which a published work is divided, especially a book."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b2dc96-31e7-44ae-bee2-c97baa4ee2df",
                                                "sense_id": "0ac4b971-c1b9-327c-b331-ce9a25adb024",
                                                "text": "Detective novel writers try to keep up the suspense until the last chapter."
                                            },
                                            {
                                                "example_id": "2bb8203f-2627-42f0-a550-6a618be78bb1",
                                                "sense_id": "0ac4b971-c1b9-327c-b331-ce9a25adb024",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            },
                                            {
                                                "example_id": "76186a6b-b5f2-4b69-9760-6fb41c48a0c0",
                                                "sense_id": "0ac4b971-c1b9-327c-b331-ce9a25adb024",
                                                "text": "The story that unfolds through 70 chapters featuring intense tactical battles is full of plot twists and turns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "One of the main sections into which a published work is divided, especially a book.",
                                            "A section of a work, a collection of works, or fragments of works, often manuscripts or transcriptions, created by scholars or advocates, not the original authors, to aid in finding portions of the texts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5737d4-962f-43ca-8741-96eb926b8e81",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "CHAPTER - One of the principal divisions of a book, and, in reference to the Bible, one of the larger sections into which its books are divided. This division, as well as that consisting of verses, was introduced to facilitate reference, and not to indicate any natural or accurate division of the subjects treated in the books."
                                            },
                                            {
                                                "example_id": "174496aa-02f6-43d8-89d9-3d6bb2ac0ee3",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "At least thirty-two of the first forty-seven decretal chapters were received by English ecclesiastics,"
                                            },
                                            {
                                                "example_id": "04c8c429-43a5-4593-b945-b9c2e6d89c9a",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "il conclut: « No pope, no collection but the masters who served the one and commented on the other ultimately determined the content of this decretal chapter»."
                                            },
                                            {
                                                "example_id": "82a30b6f-349b-4f13-baf9-c2fecb1bca41",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "But unlike a similar annotation, it has not been turned into a chapter title because the annotation “de quodam hermita” (Of a certain hermit) immediately preceded it. If a scribe had also turned Liberauit Dominus hermitam into a chapter title, he would have created a chapter that consisted of a single sentence, which even for a rather dull scribe would seem unacceptable. […] While scribe A wrote the body of the text of the De nugis curialium, scribe X contributed the rubricated chapter headings."
                                            },
                                            {
                                                "example_id": "f6f5590d-b59f-4dde-954d-10d2f0ebf2c7",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "While rubrics do not appear in paper manuscripts, eight paper manuscripts contain chapter titles, which serve the same function as the medieval rubrics."
                                            },
                                            {
                                                "example_id": "69a53497-271e-4453-8380-06da0e00a2b5",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "Characteristics: parchment; 92 fols.; 260 × 180 mm.; 32 lines; Italy; ca. 1430; two hands: humanistic rotunda with some Gothic features; marginal notes by first hand and names by a second hand; space left for initials; rubric inscriptions; superscript variants by first hand; chapters marked in margin; horizontal catchwords; quaternions."
                                            },
                                            {
                                                "example_id": "c88eac0e-6542-40d8-92e7-139b04451830",
                                                "sense_id": "e1bb713b-b9f3-37ed-8402-25a8e04f6ca8",
                                                "text": "From canon law, he cited Gratian's Decretum, Gregory's Decretales, the Sexto and Clementines Decretales, and the Extravagantes, and specifically referred to “the rules for understanding the Law” in a decretal chapter on Propterea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c22246d-e05c-3b04-8a9f-55ddb07282bb",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "Certain ecclesiastical bodies (under canon law)",
                                            "An assembly of monks, prebendaries and/or other clergymen connected with a cathedral, conventual or collegiate church, or of a diocese, usually presided over by the dean."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d998e988-84f5-36f4-b854-a676438a4bfe",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "Certain ecclesiastical bodies (under canon law)",
                                            "A community of canons or canonesses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca47d018-0e87-3a3f-8ccb-645cebd4ec78",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "Certain ecclesiastical bodies (under canon law)",
                                            "A bishop's council."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e44e34b-d0d7-3e2e-bffd-ddce61db6fb0",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A section of a social body.",
                                            "An administrative division of an organization, usually local to a specific area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cffd8e2f-f609-37bc-ab81-c18df67903e2",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A section of a social body.",
                                            "An organized branch of some society or fraternity, such as the Freemasons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7875611b-83e5-4eae-bae3-93aac46c274c",
                                                "sense_id": "cffd8e2f-f609-37bc-ab81-c18df67903e2",
                                                "text": "If the By-Law which admits honorary members is silent upon their rights, they may perhaps be determined by a consideration of which of these classes was intended by the Chapter in admitting them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454cc080-c23d-3b81-b5d6-1cb3bfd35f5a",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A meeting of a chapter of certain organized societies or orders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "674b2011-d9d2-3b22-ab92-ee8cb7e56d1f",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A chapter house"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1fa3b17-e01d-3a0d-9bab-0ee207a273d8",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A sequence (of events), especially when presumed related and likely to continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f81230e-1330-4801-ab7a-9acc2491ee39",
                                                "sense_id": "b1fa3b17-e01d-3a0d-9bab-0ee207a273d8",
                                                "text": "1866, Wilkie Collins, Armadale, Book the Last, Chapter I,\n\"You know that Mr. Armadale is alive,\" pursued the doctor, \"and you know that he is coming back to England. Why do you continue to wear your widow's dress?\" ¶ She answered him without an instant's hesitation, steadily going on with her work. ¶ \"Because I am of a sanguine disposition, like you. I mean to trust to the chapter of accidents to the very last. Mr. Armadale may die yet, on his way home.\""
                                            },
                                            {
                                                "example_id": "aad2ce7c-4776-48b8-a600-96397dbafa79",
                                                "sense_id": "b1fa3b17-e01d-3a0d-9bab-0ee207a273d8",
                                                "text": "[…]she determined to go on slowly towards Castra Regis, and trust to the chapter of accidents to pick up the trail again."
                                            },
                                            {
                                                "example_id": "749fd218-e226-4847-9e6a-9333e6c7ad1d",
                                                "sense_id": "b1fa3b17-e01d-3a0d-9bab-0ee207a273d8",
                                                "text": "With the entry into service of the '777s', a new chapter opens in the long history of Merseyside's electric suburban railwsys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b12d94f-d212-3bbf-abda-f4c9d325f75c",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A location or compartment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4bac727-2196-4861-a7a2-f013d8f31501",
                                                "sense_id": "4b12d94f-d212-3bbf-abda-f4c9d325f75c",
                                                "text": "In his bosom! In what chapter of his bosom?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "818d73b0-d784-35b9-b125-0ca77ec6c4ec",
                                        "entry_id": "4fa7d917-23fe-328f-9d8b-8b82737110e1",
                                        "glosses": [
                                            "A prescribed reading at one of the canonical hours."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
