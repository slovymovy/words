                        "glosses": [
                            "De Mercure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54f7616-d681-4321-a725-4b39dfed3ade",
                                "sense_id": "34821f39-4986-39ca-a520-a6708871f9e3",
                                "text": "Miel mercurial, miel tiré de la mercuriale."
                            }
