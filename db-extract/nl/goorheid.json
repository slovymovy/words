                    },
                    {
                        "translation_id": "a0d213da-dc78-4f18-8fee-474d0a2fde7b",
                        "source_entry_id": "d7b1e714-3e37-34b4-bde2-aa7371c3820d",
                        "source_sense_id": "7e3777c3-3180-3baf-bb32-bd8e24afca0a",
                        "target_lang_word": "dinginess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dinginess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                        "entry_id": "9259527f-c41d-37f2-a0ec-3390e985adfe",
                                        "glosses": [
                                            "The state or quality of being dingy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4464ba-2696-4f1b-83fc-f4824e32cb3a",
                                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                                "text": "His nether garments were of a blueish gray—violent in its colours once, but sobered now by age and dinginess—and were so stretched and strained in a tough conflict between his braces and his straps, that they appeared every moment in danger of flying asunder at the knees."
                                            },
                                            {
                                                "example_id": "e70a2b81-10aa-4024-a329-b459ec484d9f",
                                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                                "text": "He was a pitiful image of shabby gentility and the dinginess of “reduced circumstances.”"
                                            },
                                            {
                                                "example_id": "825c247c-6f61-459b-9ed2-cb9ccb24732d",
                                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                                "text": "The streets were thunderous; a vast energy heaved under the universal coating of dinginess."
                                            },
                                            {
                                                "example_id": "2aba8afa-70d9-4aa3-b2fb-6d9fbdad2fb2",
                                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                                "text": "The cramped dinginess of such important stations as Grantham and Peterborough has to be experienced to be believed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf61e0e0-39a1-49a1-a9e3-2aeaceb63e6b",
                        "source_entry_id": "d7b1e714-3e37-34b4-bde2-aa7371c3820d",
                        "source_sense_id": "7e3777c3-3180-3baf-bb32-bd8e24afca0a",
                        "target_lang_word": "dirtiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dirtiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56fa6e25-095f-3ed9-a42b-57d80f0984ea",
                                        "entry_id": "89ecfd45-55a4-3906-8a6e-c6451adf6017",
                                        "glosses": [
                                            "The state or quality of being dirty."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef07a04-3c29-485e-b9d5-f4550212f633",
                                                "sense_id": "56fa6e25-095f-3ed9-a42b-57d80f0984ea",
                                                "text": "Paul was distressingly clean, but Babbitt reveled in a good sound dirtiness, in not having to shave till his spirit was moved to it."
                                            },
                                            {
                                                "example_id": "65df1e02-3b15-4799-b0d7-9cec8969e54f",
                                                "sense_id": "56fa6e25-095f-3ed9-a42b-57d80f0984ea",
                                                "text": "Dirtiness is inherent in hotels and restaurants, because sound food is sacrificed to punctuality and smartness."
                                            },
                                            {
                                                "example_id": "5d378f96-5753-4317-a092-9b65821182fe",
                                                "sense_id": "56fa6e25-095f-3ed9-a42b-57d80f0984ea",
                                                "text": "So they walked till they came to Claremont and Kumalo was shocked by its shabbiness and dirtiness, and the closeness of the houses, and the filth in the streets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
