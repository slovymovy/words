                "senses": [
                    {
                        "sense_id": "52775d5d-694b-31c0-84b7-8e41cb3d31ee",
                        "entry_id": "d89c003f-c0a0-31f1-9a2c-b95bd95706ea",
                        "glosses": [
                            "Groupe des quatre entreprises les plus puissantes de l’Internet : Google, Apple, Facebook et Amazon."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "00db1bfc-7316-4156-936b-aa7f76c642bb",
                                "sense_id": "52775d5d-694b-31c0-84b7-8e41cb3d31ee",
                                "text": "Car il est rare, en France, qu’une journée se passe sans que le terme GAFA (le plus souvent « Les GAFA ») ne soit employé."
                            },
                            {
                                "example_id": "0b11c2b7-4041-4abc-a001-4c57b6b6a8a4",
                                "sense_id": "52775d5d-694b-31c0-84b7-8e41cb3d31ee",
                                "text": "Ce jeudi soir, les GAFA (Google, Apple, Facebook et Amazon) ont dû sentir leurs oreilles siffler. Les chefs d’État et de gouvernement, réunis jeudi et vendredi en Conseil européen à Bruxelles, ont consacré leur dîner de travail à la proposition française d’imposer leurs super-profits."
                            },
                            {
                                "example_id": "d427c492-a5d3-47dc-9576-9c7ca192795a",
                                "sense_id": "52775d5d-694b-31c0-84b7-8e41cb3d31ee",
                                "text": "Pour une fiscalité planétaire équitable en éliminant les paradis fiscaux et en taxant les transactions financières. C’est au tour des transnationales, y incluant les GAFA, de faire leur juste part !"
                            },
                            {
                                "example_id": "ebf2aa58-359a-414f-b3cd-abe9b0b3045e",
                                "sense_id": "52775d5d-694b-31c0-84b7-8e41cb3d31ee",
                                "text": "Il refuse d'être à la merci des GAFA et de la modernité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66ed297a-07bd-47ae-b451-202d8abd4271",
                        "source_entry_id": "d89c003f-c0a0-31f1-9a2c-b95bd95706ea",
