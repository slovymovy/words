                                            {
                                                "example_id": "15351c13-417c-4cfd-b3be-d32019b18fac",
                                                "sense_id": "5b06c950-f0a8-3996-838f-8a32b69e80a0",
                                                "text": "Ce n’est point Homère, Montaigne, ni Hugo, ni même M. André Theuriet de l’Académie française, qu’il nous lit, le Parisien exilé au pays des mange-raves, mais un roman-feuilleton, dans le genre de ceux que publiaient un Pierre Frondaie ou un Maurice Dekobra."
                                            },
                                            {
                                                "example_id": "9bc232eb-12e7-4180-9b9b-f96a35035021",
                                                "sense_id": "5b06c950-f0a8-3996-838f-8a32b69e80a0",
                                                "text": "Le présentateur rencontre Maxime Chattam, qui publie Lux, Christophe Galfard, qui évoque Voyage vers l’infini, mais aussi Hélène Dorion, Marion Montaigne, Mathieu Simonet et Thomas Pesquet."
                                            }
                                        ]
