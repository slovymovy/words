                "translations": [
                    {
                        "translation_id": "7df08725-b432-4089-b80f-d279ef2438ee",
                        "source_entry_id": "727c6f56-358d-3f99-8e75-0c165d83d09d",
                        "source_sense_id": "cc09535c-93a2-3b27-b518-deba9a0a6506",
                        "target_lang_word": "stalagmite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalagmite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                        "entry_id": "ed2939a6-bff0-35ad-a93c-1ef8a1be4265",
                                        "glosses": [
                                            "A secondary mineral deposit of calcium carbonate or other mineral, in shapes similar to icicles, that lies on the ground of a cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5040d334-0aa2-4118-83ac-6cceddd77624",
                                                "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                                "text": "In one place, near at hand, a stalagmite had been slowly growing up from the ground for ages, builded by the water-drip from a stalactite overhead."
                                            },
                                            {
                                                "example_id": "d699b336-0b37-439c-aaab-b0444d42b515",
                                                "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                                "text": "Molten roofing north, lead dripping down south, stand like those immobilized columns of arctic water west, stalagmites, monked and housed or stamped and dudleyed east, in school texts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e570a02-c75b-4150-9c2e-a2a87a3e546d",
                        "source_entry_id": "727c6f56-358d-3f99-8e75-0c165d83d09d",
                        "source_sense_id": "cc09535c-93a2-3b27-b518-deba9a0a6506",
