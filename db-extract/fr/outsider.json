            {
                "entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                "word": "outsider",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c9bfbac-7846-47ef-a256-615df402c5e4",
                        "entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "tags": [
                            "plural"
                        ],
                        "form": "outsiders"
                    },
                    {
                        "form_id": "c4614b8a-69a7-49b7-91ee-39c518862d23",
                        "entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "tags": [
                            "rare"
                        ],
                        "form": "outsideur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07553fbc-83ee-3fb1-b53d-fb291a2cd148",
                        "entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "glosses": [
                            "Personne qui appartient par son activité à un groupe social, culturel ou professionnel donné sans généralement se mêler à lui, soit par tempérament, soit parce qu'on l'exclut."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "20117f45-b2e7-49aa-b704-797aed0fe16f",
                                "sense_id": "07553fbc-83ee-3fb1-b53d-fb291a2cd148",
                                "text": "Al Ruddy était un outsider, à qui l’on a confié ce qui est devenu le plus grand film de tous les temps, se réjouit Nikki Toscano, la productrice de la minisérie."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fd07e4a-5a0e-3de2-b034-ba28924e4020",
                        "entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "glosses": [
                            "Personne qui ne s'inscrit pas dans les principales activités matérielles d'une société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc24646-13a1-42ac-abfd-753fbfd71663",
                                "sense_id": "1fd07e4a-5a0e-3de2-b034-ba28924e4020",
                                "text": "L’outsider (le poète, l'artiste, le philosophe) a en outre un rôle essentiel à jouer dans la culture bourgeoise. Il est comme une sentinelle qui lui rappelle les plus hautes valeurs de la culture qu'elle tend à oublier et a négliger par complaisance et par paresse intellectuelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fbc6479-d3a7-34df-bb15-9445a074a5a8",
                        "entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "glosses": [
                            "Dans une course hippique, cheval qui affiche une cote élevée."
                        ],
                        "tags": [
                            "Sports hippiques"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d66f61dc-3bed-4917-a1cb-12c4e550ebed",
                        "source_entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "target_lang_word": "underdog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underdog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa4351d-0f89-3a5a-8534-46eb020e8fbc",
                                        "entry_id": "60344e08-f913-3ca0-95b6-73a3e886076b",
                                        "glosses": [
                                            "A competitor thought unlikely to win."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9163c99-677d-4e73-b8f5-a351f29934af",
                                                "sense_id": "4aa4351d-0f89-3a5a-8534-46eb020e8fbc",
                                                "text": "They were the underdogs in the basketball competition."
                                            },
                                            {
                                                "example_id": "3e698ddc-0c68-4fa2-a52f-9b3efacc3144",
                                                "sense_id": "4aa4351d-0f89-3a5a-8534-46eb020e8fbc",
                                                "text": "In Athens, the Americans are underdogs to the Chinese and the Canadians (the Canadians!)"
                                            },
                                            {
                                                "example_id": "fb5ffc24-0cfb-46e3-803e-aca9f1c0ab5b",
                                                "sense_id": "4aa4351d-0f89-3a5a-8534-46eb020e8fbc",
                                                "text": "The visit of a Championship side would not normally send a shiver down their spine but they knew that Wigan were underdogs who would snap at their heels and that they possessed a potent bite if they were not kept on a firm leash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128214b6-6d6a-37e5-8293-29559743c169",
                                        "entry_id": "60344e08-f913-3ca0-95b6-73a3e886076b",
                                        "glosses": [
                                            "Somebody at a disadvantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61757af-0c40-49d7-bbdb-6d0cad35238e",
                                                "sense_id": "128214b6-6d6a-37e5-8293-29559743c169",
                                                "text": "Laszlo: Isn't it strange that you always happened to be fighting on the side of the underdog?\nRick: Yes. I found that a very expensive hobby, too. But then I never was much of a businessman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "735e50a6-2bba-3854-bf57-cb1360668291",
                                        "entry_id": "60344e08-f913-3ca0-95b6-73a3e886076b",
                                        "glosses": [
                                            "A high swing wherein the person pushing the swing runs beneath the swing while the person being pushed is at the forward limit of the arc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02dd89d7-77bb-4e6c-8c80-71ab45e02480",
                        "source_entry_id": "b0f928ad-3b32-39f0-8221-34f6ea33f2f4",
                        "target_lang_word": "outsider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outsider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "One who is not part of a community or organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f416cb-c88d-45e5-9273-f675bc01caa9",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "While the initiated easily understand the symbols, they are wholly inaccessible to outsiders."
                                            },
                                            {
                                                "example_id": "d64df32d-c943-488b-8e9f-78d85c7a9be0",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "I'm an outsider by choice, but not truly. It's the unpleasantness of the system that keeps me out. I'd rather be in, in a good system. That's where my discontent comes from: being forced to choose to stay outside."
                                            },
                                            {
                                                "example_id": "158ede05-9eb0-4fec-9601-e4c36e76644d",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "We were not a big huggie family so I was very, very encased in a little stay-away-from-me shell growing-up, and here I got to open up and feel safe and able to touch and hold and be able to be with another human being, which was really a big relief, a very positive part of my understanding of myself that I wasn't just this outcast evil outsider of everything."
                                            },
                                            {
                                                "example_id": "bbb8e400-9cda-479a-bd6f-743b4a0be290",
                                                "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                                                "text": "We are the only outsiders here, granted exclusive access and a private tour as the first major US news organization allowed inside Cecot late last month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "A newcomer with little or no experience in an organization or community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f278783b-9387-4cb5-8a6d-6a868b2672d0",
                                                "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                                                "text": "Seeing the mess professional politicians have made of things is it any wonder the electorate is beginning to prefer outsiders?"
                                            },
                                            {
                                                "example_id": "ded7366f-6c02-4799-9d74-78e963a2ff34",
                                                "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                                                "text": "These worlds have always belonged to us, from the moment our ancestors saw them through ancient telescopes. We claimed them when our first explorers reached the stars, and they remained our worlds even after the Scourge divided us in darkness. Outsiders have no right to these treasures, and true angara must stand ready to defend our birthright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "462f6ab1-da5c-39ff-9010-443b338f87fc",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "A competitor or contestant who has little chance of winning; a long shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27fafb5-80da-41cd-93a9-fa13ddb30e4f",
                                                "sense_id": "462f6ab1-da5c-39ff-9010-443b338f87fc",
                                                "text": "Johnny was an outsider at this year's karate tournament, but he still managed to win second place out of sheer determination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03492aba-131b-3045-910f-d41d69039882",
                                        "entry_id": "683a71e4-8d45-3af7-acc3-6609b737c075",
                                        "glosses": [
                                            "The heel or end piece of a loaf of bread."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
