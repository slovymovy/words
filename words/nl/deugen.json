            "senses": [
                {
                    "sense_id": "f09bd157-df2f-3a3b-a756-035534a0ed9f",
                    "sense_definition": "van goede kwaliteit zijn of betrouwbaar functioneren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sloten van dat merk <w>deugen</w> en zijn erg veilig.",
                            "target_lang_translations": {
                                "en": "The locks of that brand <w>are good</w> and are very safe."
                            }
                        },
                        {
                            "text": "Ik weet niet of die technische oplossing wel echt <w>deugt</w>.",
                            "target_lang_translations": {
                                "en": "I don't know if that technical solution <w>is</w> really <w>sound</w>."
                            }
                        },
                        {
                            "text": "Het wetenschappelijk onderzoek <w>deugde</w> van geen kant.",
                            "target_lang_translations": {
                                "en": "The scientific research <w>wasn't right</w> at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "voldoen",
                        "kloppen"
                    ],
                    "antonyms": [
                        "mankeren"
                    ],
                    "common_phrases": [
                        "van geen kant deugen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be of good quality or to function reliably"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be good",
                                "target_lang_sense_clarification": "referring to quality or reliability"
                            },
                            {
                                "target_lang_word": "be sound",
                                "target_lang_sense_clarification": "referring to logic, research, or construction"
                            },
                            {
                                "target_lang_word": "be up to scratch",
                                "target_lang_sense_clarification": "meeting the required standard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "233dfc18-0ea3-30f4-9b9c-829a31e7605d",
                    "sense_definition": "moreel goed of fatsoenlijk zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moraliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die corrupte agent <w>deugt</w> voor geen meter.",
                            "target_lang_translations": {
                                "en": "That corrupt officer <w>is no good</w> at all."
                            }
                        },
                        {
                            "text": "Hij is een eerlijke man die echt <w>deugt</w>.",
                            "target_lang_translations": {
                                "en": "He is an honest man who <w>is</w> truly <w>decent</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deugdzaam zijn"
                    ],
                    "antonyms": [
                        "slecht zijn"
                    ],
                    "common_phrases": [
                        "voor geen meter deugen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be morally good, decent, or trustworthy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be decent",
                                "target_lang_sense_clarification": "referring to a person's character"
                            },
                            {
                                "target_lang_word": "be honest",
                                "target_lang_sense_clarification": "referring to integrity"
                            },
                            {
                                "target_lang_word": "be no good",
                                "target_lang_sense_clarification": "often used in the negative to describe a bad person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
