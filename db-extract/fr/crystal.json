                ],
                "senses": [
                    {
                        "sense_id": "3f0409c8-8b83-3461-9ecc-2f1f8d605055",
                        "entry_id": "bb635e33-828d-3280-98eb-eebebe8a9c45",
                        "glosses": [
                            "Orthographe ancienne de cristal."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cac6fa1a-0482-4b0a-ad32-57f838b2407c",
                                "sense_id": "3f0409c8-8b83-3461-9ecc-2f1f8d605055",
                                "text": "Il n’est pas même nécessaire que le vaisseau qui tient la liqueur à crystalliser, soit dans la plus grande proximité du sel qui doit attirer ou repousser les crystaux prêts à se former."
                            },
                            {
                                "example_id": "11fe0e83-2a19-43fa-b6ca-1a816e3ad525",
                                "sense_id": "3f0409c8-8b83-3461-9ecc-2f1f8d605055",
                                "text": "Chaque coin de la rue m’offroit une belle fontaine, qui laissoit couler une eau pure & transparente : elle retomboit d’une nappe d’or, & son crystal donnoit envie d’y boire."
                            }
                        ]
                    }
