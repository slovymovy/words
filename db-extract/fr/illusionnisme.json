                "senses": [
                    {
                        "sense_id": "9ee081d8-0261-3b20-8dd7-30507eb524da",
                        "entry_id": "e463123b-ff01-3c7c-abd4-ebd099f2f617",
                        "glosses": [
                            "Art de l'illusionniste."
                        ],
                        "tags": [
                            "Prestidigitation"
                        ],
                        "examples": [
                            {
                                "example_id": "616e7818-f0b6-4b49-a3f3-ab467e384fba",
                                "sense_id": "9ee081d8-0261-3b20-8dd7-30507eb524da",
                                "text": "Ce Parisien de trente-cinq ans [Méliès] dirigeait alors, depuis une dizaine d’années, le théâtre Robert Houdin, petite salle consacrée à l’illusionnisme et fondée par l’illustre prestidigitateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a74a847-8723-3555-8ec6-3b1c55217e8c",
                        "entry_id": "e463123b-ff01-3c7c-abd4-ebd099f2f617",
                        "glosses": [
                            "Art de l'illusionniste.",
                            "Art, fait de créer l’illusion."
                        ],
                        "tags": [
                            "Prestidigitation"
                        ],
                        "examples": [
                            {
                                "example_id": "1827faae-3d5b-4350-b219-c899de077ace",
                                "sense_id": "7a74a847-8723-3555-8ec6-3b1c55217e8c",
                                "text": "M. Mauriac utilise, à cette fin d’illusionnisme, l’ambiguïté romanesque de la « troisième personne. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "68d203b1-a5da-35e9-ab46-99d56aba4b5e",
                        "entry_id": "e463123b-ff01-3c7c-abd4-ebd099f2f617",
                        "glosses": [
                            "Art de l'illusionniste.",
                            "Création d’illusion, action de faire voir la réalité de manière erronée."
                        ],
                        "tags": [
                            "Prestidigitation"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b79ede9f-5154-4099-9c28-99d249d687a4",
                        "source_entry_id": "e463123b-ff01-3c7c-abd4-ebd099f2f617",
                        "target_lang_word": "Zauberkunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zauberkunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc994dd-f996-395d-8951-8d5ed3f1a03c",
                                        "entry_id": "b93fc02b-e0ef-3cd4-9ac1-b8e13e562651",
                                        "glosses": [
                                            "Fähigkeit, mit magischen Mitteln zu handeln, zu zaubern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8531df-3620-40ef-9628-23a27dcf0713",
                                                "sense_id": "0dc994dd-f996-395d-8951-8d5ed3f1a03c",
                                                "text": "„Es bedurfte wohl einer ›Disposition‹, um den Teufel zum Vorführen seiner Zauberkünste zu bewegen, und es bedurfte eines Vertrags.“"
                                            },
                                            {
                                                "example_id": "a81f400f-485c-4072-a98c-6678c12272ef",
                                                "sense_id": "0dc994dd-f996-395d-8951-8d5ed3f1a03c",
                                                "text": "„Den Griechen vermittelten sie die Kenntnis der Metaphysik, den Persern die Zauberkünste, den Etruskern die Opferschau – und den Römern das Verzinnen des Kupfers und den Schinkenhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1d32de5-7d6b-38ee-a999-99f3cdce3494",
                                        "entry_id": "b93fc02b-e0ef-3cd4-9ac1-b8e13e562651",
                                        "glosses": [
                                            "Fähigkeit zu/Vollzug von Zauberkunststücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f2a082-9c83-4987-91eb-5b46e5cb16e9",
                                                "sense_id": "d1d32de5-7d6b-38ee-a999-99f3cdce3494",
                                                "text": "„So vertrieb ich mir durch höchst angenehme Zauberkünste in diesem Wartesaal die Zeit, die wie im Fluge verfloß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
