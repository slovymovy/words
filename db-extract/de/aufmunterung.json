                "senses": [
                    {
                        "sense_id": "cd1bd3ee-ab54-36c1-bb8a-0396cda9270b",
                        "entry_id": "f1166b7f-bbf9-3e12-a8fe-3186cd63c4a8",
                        "glosses": [
                            "Versuch, jemandem mehr Freude, Mut zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86164a09-71d3-42cd-9fcc-6a306f9f2318",
                                "sense_id": "cd1bd3ee-ab54-36c1-bb8a-0396cda9270b",
                                "text": "„Seine 155 Mitarbeiter können Aufmunterung gebrauchen – sie haben viele Turbulenzen mitgemacht.“"
                            },
                            {
                                "example_id": "df428ac7-bf99-4d5b-870b-965d4bcdd189",
                                "sense_id": "cd1bd3ee-ab54-36c1-bb8a-0396cda9270b",
                                "text": "„Er fördert die schwachen Schüler durch Nachsicht und Aufmunterungen und stärkt die guten durch Lob und Anerkennung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
