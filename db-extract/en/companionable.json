                    {
                        "translation_id": "80b8a031-4f91-4e90-be9a-058e5f371dba",
                        "source_entry_id": "241bbd9c-c8c6-3abd-a45c-f69379208893",
                        "source_sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
