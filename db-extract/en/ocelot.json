                                        "glosses": [
                                            "Fell dieses Tieres"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ec5c4cf-331b-3f18-b020-763c841b9554",
                                        "entry_id": "d36e93cf-1d5d-3c95-9fcc-c4ef8ae07401",
                                        "glosses": [
                                            "Pelz, der aus dem Fell dieses Tiers gefertigt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2cbb1b6-f5bb-469e-8b89-9e89423ff7cf",
                                                "sense_id": "4ec5c4cf-331b-3f18-b020-763c841b9554",
                                                "text": "„Als Accessoires zu einer der beliebten kleinen »robes élégantes« sah ich bei einer französischen Diplomatengattin einen Hut aus Ozelot und eine auf der Hüfte weit ausgebreitete Schleife aus dem gleichen Pelz; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
