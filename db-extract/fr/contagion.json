                        ],
                        "form": "contagions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16828e06-315e-3cd9-a834-5f6a0231f4bb",
                        "entry_id": "fa79d1b5-b764-38f0-a19b-459d62a3ba21",
                        "glosses": [
                            "Propagation d’une maladie transmissible par un contact direct ou différé, infection, contamination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b280587e-6210-446e-b55a-ced5a0ec7a1c",
                                "sense_id": "16828e06-315e-3cd9-a834-5f6a0231f4bb",
                                "text": "Ce mal se prend par contagion."
                            },
                            {
                                "example_id": "7bce44a3-6714-4699-ac94-a11ff3063922",
                                "sense_id": "16828e06-315e-3cd9-a834-5f6a0231f4bb",
                                "text": "Pendant la contagion."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0cd702d-694b-3d38-9456-790d71b06a19",
                        "entry_id": "fa79d1b5-b764-38f0-a19b-459d62a3ba21",
                        "glosses": [
                            "La maladie qui se communique par ce contact."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4d2800b7-e5b2-407c-bc07-8802b1bfacfe",
                                "sense_id": "e0cd702d-694b-3d38-9456-790d71b06a19",
                                "text": "Il y a de la contagion en tel pays."
                            },
                            {
                                "example_id": "4923fbc6-e63b-4c92-a1db-2c13b5f2dab5",
                                "sense_id": "e0cd702d-694b-3d38-9456-790d71b06a19",
                                "text": "Les ravages de la contagion."
                            }
                        ]
                    },
                    {
                        "sense_id": "812bec84-1501-370b-a304-dcfe62838d24",
                        "entry_id": "fa79d1b5-b764-38f0-a19b-459d62a3ba21",
                        "glosses": [
                            "Habitude commune considérée comme néfaste."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "82b8c8a1-a7d1-4214-b246-fcf3a582dc0e",
                                "sense_id": "812bec84-1501-370b-a304-dcfe62838d24",
                                "text": "Une étrange contagion, en ces contrées, s’était emparée des esprits. Pas d’enfants ! Aujourd’hui, tous les biens, ici, tombent en déshérence !"
                            }
                        ]
                    },
                    {
                        "sense_id": "dcd5f1c7-7b5a-35eb-a3f9-734fb2362d6b",
                        "entry_id": "fa79d1b5-b764-38f0-a19b-459d62a3ba21",
                        "glosses": [
                            "Communication (d'un comportement bon ou mauvais) par la fréquentation ou par l’exemple."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5b008832-b9fa-4e58-8b85-02e6fdc27022",
                                "sense_id": "dcd5f1c7-7b5a-35eb-a3f9-734fb2362d6b",
                                "text": "Les premières communautés ont sans doute grandi par « contagion » : la manière de vivre des croyants donnait envie de les rejoindre."
                            }
                        ]
                    }
                ],
                "translations": [
