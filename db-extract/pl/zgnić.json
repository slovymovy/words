        "pl-extract.jsonl": [
            {
                "entry_id": "addd739f-862f-3eab-8802-d92e09f07c9b",
                "word": "zgnić",
                "pos": "verb",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c6b83d41-801f-36a7-ab48-3174bce972a5",
                        "entry_id": "addd739f-862f-3eab-8802-d92e09f07c9b",
                        "glosses": [
                            "ulec rozkładowi w procesie gnilnym, przy udziale bakterii gnilnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "736fd7cc-36a8-4b65-88e4-df479772bf51",
                                "sense_id": "c6b83d41-801f-36a7-ab48-3174bce972a5",
                                "text": "Kalafior zgnił, bo ważniejsza była ogórkowa, której żaden gość hotelowy nie zamawiał."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "666b870a-e865-3244-84d5-c09c5250dc49",
                        "entry_id": "addd739f-862f-3eab-8802-d92e09f07c9b",
                        "glosses": [
                            "zakończyć życie w zamknięciu, niewoli lub w niegodziwych warunkach"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b62bcf4c-8340-4e12-bdd2-3584b065d66d",
                        "source_entry_id": "addd739f-862f-3eab-8802-d92e09f07c9b",
                        "source_sense_id": "c6b83d41-801f-36a7-ab48-3174bce972a5",
                        "target_lang_word": "сгнить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сгнить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4f80e8c1-dc16-33cd-93a0-7ca7b82d0cb5",
                                        "entry_id": "a07fb301-409a-300c-ac09-04ff55b51a49",
                                        "glosses": [
                                            "разложиться, разрушиться, подвергнувшись гниению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecd146ae-3330-474b-aadd-bb937179d577",
                                                "sense_id": "4f80e8c1-dc16-33cd-93a0-7ca7b82d0cb5",
                                                "text": "Богатство ваше сгнило, и одежды ваши изъедены молью."
                                            },
                                            {
                                                "example_id": "dd6483c8-6197-40cb-bd78-d626747e086d",
                                                "sense_id": "4f80e8c1-dc16-33cd-93a0-7ca7b82d0cb5",
                                                "text": "Стол, скамейки внутри грота давно уже сгнили и рассыпались."
                                            },
                                            {
                                                "example_id": "0e8a8861-2499-453c-8936-7b7f156020cf",
                                                "sense_id": "4f80e8c1-dc16-33cd-93a0-7ca7b82d0cb5",
                                                "text": "— Чёрное-то в могиле — это материн гроб? — Да, — сказала она сердито. — Пёс неумный… Года ещё нет, а сгнила Варя-то! Это всё от песку, — он воду пропускает. Кабы глина была, лучше бы… — Все гниют? — Все. Только святых минует это… — Ты — не сгниёшь!"
                                            },
                                            {
                                                "example_id": "de87ee23-2112-4242-8c72-07e8025a730c",
                                                "sense_id": "4f80e8c1-dc16-33cd-93a0-7ca7b82d0cb5",
                                                "text": "Вся рыба сгнила, теперь её потихоньку закапывают в землю, чтобы не видел народ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00871f5a-77c0-3b28-b964-ac74f07624e0",
                                        "entry_id": "a07fb301-409a-300c-ac09-04ff55b51a49",
                                        "glosses": [
                                            "перен. погибнуть от долгого пребывания в тяжёлых, невыносимых условиях жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d8581a-2597-41db-83ab-9d1196df797e",
                                                "sense_id": "00871f5a-77c0-3b28-b964-ac74f07624e0",
                                                "text": "Не хочу спасать изверга, пусть сгниёт в каторге!"
                                            },
                                            {
                                                "example_id": "f2972424-3d8c-4bc7-ae19-058ae7863d83",
                                                "sense_id": "00871f5a-77c0-3b28-b964-ac74f07624e0",
                                                "text": "Я мужик богатый, сильный, у заседателя руку имею и могу вот этого самого хозяина завтра же обидеть: он у меня в тюрьме сгниёт, и дети его по миру пойдут."
                                            },
                                            {
                                                "example_id": "8f67331d-a4e0-448e-8806-c3438d1a5301",
                                                "sense_id": "00871f5a-77c0-3b28-b964-ac74f07624e0",
                                                "text": "— Ну, а ты, Кирюшкин, помни, — продолжал старший офицер, подойдя вплотную к Кирюшкину, — если опять напьёшься, под суд отдам… Сгниёшь в арестантских ротах… Не забудь этого, разбойник!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
