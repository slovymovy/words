                                "target_senses": [
                                    {
                                        "sense_id": "898c8993-4e23-371b-9815-59cfb44b3892",
                                        "entry_id": "ca8cd019-60c9-3bb7-b825-a99d277ce19a",
                                        "glosses": [
                                            "A closed box in which the body of a dead person is placed for burial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b815b694-bb67-4069-9779-87a45eafef8c",
                                                "sense_id": "898c8993-4e23-371b-9815-59cfb44b3892",
                                                "text": "[…] Passing the apple-tree blows of white and pink in the orchards, / Carrying a corpse to where it shall rest in the grave, / Night and day journeys a coffin."
                                            },
                                            {
                                                "example_id": "42a70889-c7c3-47f8-839c-369dead52691",
                                                "sense_id": "898c8993-4e23-371b-9815-59cfb44b3892",
                                                "text": "20 May 2018, Hadley Freeman in The Guardian, Is Meghan Markle the American the royals have needed all along?\nI’d always found the royals a cold proposition, Diana excepted, but the sight of that little boy, his head bent, not daring to look up at his mother’s coffin in front of him was, and remains, genuinely heartbreaking."
                                            },
                                            {
                                                "example_id": "b67dda88-158e-458b-afa8-dc603f2d3399",
                                                "sense_id": "898c8993-4e23-371b-9815-59cfb44b3892",
                                                "text": "Plans to carry the Queen's coffin from Edinburgh to London by rail were scrapped in favour of travel in a Royal Air Force cargo aircraft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "657852ed-11be-30a4-b8fa-2b6f32f22b0a",
                                        "entry_id": "ca8cd019-60c9-3bb7-b825-a99d277ce19a",
                                        "glosses": [
                                            "The eighth Lenormand card."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbdc3d24-13a7-30dd-a056-87d53359af22",
                                        "entry_id": "ca8cd019-60c9-3bb7-b825-a99d277ce19a",
                                        "glosses": [
                                            "A casing or crust, or a mold, of pastry, as for a pie."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d83c7c43-13f8-43c9-b5d9-4dd8957b341a",
                                                "sense_id": "bbdc3d24-13a7-30dd-a056-87d53359af22",
                                                "text": "Of the paste a coffin I will rear."
                                            },
                                            {
                                                "example_id": "f2857a65-2665-4e7a-9331-e4f733cb26c5",
                                                "sense_id": "bbdc3d24-13a7-30dd-a056-87d53359af22",
                                                "text": "Take your mallard and put him into the iuyce of the sayde Onyons, and season him with pepper, and salte, cloues and mace, then put your Mallard into the coffin with the saide iuyce of the onyons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496f682a-42fa-3a5c-a4b9-1962f9629180",
                                        "entry_id": "ca8cd019-60c9-3bb7-b825-a99d277ce19a",
                                        "glosses": [
                                            "A conical paper bag, used by grocers."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b86ada01-f7d7-4227-b623-399f55062c6f",
                                                "sense_id": "496f682a-42fa-3a5c-a4b9-1962f9629180",
                                                "text": "The smoke of this Hearbe, which they receaue at the mouth through certaine coffins, suche as the Grocers do vse to put in their Spices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37633f67-550e-3012-8895-a00eaa88e15e",
                                        "entry_id": "ca8cd019-60c9-3bb7-b825-a99d277ce19a",
                                        "glosses": [
                                            "The hollow crust or hoof of a horse's foot, below the coronet, in which is the coffin bone."
                                        ],
                                        "tags": [],
