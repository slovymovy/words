                                        "sense_id": "342f1407-9350-3692-bf53-132edb92d6d3",
                                        "entry_id": "483e70cc-2af5-3054-92ce-b90102bece05",
                                        "glosses": [
                                            "moeilijke keuze uit drie alternatieven waarbij iedere keus die je kunt maken voordelen én nadelen heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "866b5722-3eec-4fa0-8b08-935dea709577",
                                                "sense_id": "342f1407-9350-3692-bf53-132edb92d6d3",
                                                "text": "Dani Rodrik noemt dat het trilemma van de wereldeconomie: democratie, globalisering en soevereiniteit kunnen niet alle drie samengaan. Een van de drie zal er altijd bekaaid afkomen."
                                            }
                                        ]
