                    {
                        "sense_id": "a023c218-c55a-3503-a5da-8b788155d3f4",
                        "entry_id": "f41bb10a-81cf-3a80-accc-656d4b6af6d3",
                        "glosses": [
                            "Méthode empirique proposant à tout analyste une démarche de travail fondée sur un questionnement systématique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e937e9-ceeb-4a17-8db5-f8dcda89e816",
                                "sense_id": "a023c218-c55a-3503-a5da-8b788155d3f4",
                                "text": "Le QQOQCCP est un outil qui permet la collecte exhaustive et rigoureuse de données précises. […] L’objectif du QQOQCCP est d’aider à appréhender tous les aspects d’un problème, à analyser une situation sous tous ses angles."
                            },
                            {
                                "example_id": "b9fea3fe-a872-46ea-b620-e5a086b19fce",
                                "sense_id": "a023c218-c55a-3503-a5da-8b788155d3f4",
                                "text": "C’est un support de communication qui peut se questionner par un QQOQCCP (Qui ? Quoi ? Où ? Quand ? Comment ? Combien ? Pourquoi ?)."
                            }
                        ]
                    }
                ],
