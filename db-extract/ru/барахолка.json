                    {
                        "translation_id": "7ff43125-97f3-4254-8dfd-4fa0a5d39b61",
                        "source_entry_id": "791ecec5-bb7f-34dc-a969-fca05fb95891",
                        "source_sense_id": "2e01c658-3a2c-3d33-b8af-ead2326f934b",
                        "target_lang_word": "vide-grenier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vide-grenier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb65d06-9e02-3a7d-b0af-05c94d34b03e",
                                        "entry_id": "562bd358-1ae9-3c16-a786-6e35ca4364e3",
                                        "glosses": [
                                            "Sorte de marché occasionnel où les particuliers mettent en vente des meubles ou objets superflus."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ba9d25-5098-408e-8772-b6e1385f66b7",
                                                "sense_id": "bfb65d06-9e02-3a7d-b0af-05c94d34b03e",
                                                "text": "Lucile aimait les brocantes, les marchés aux puces, les vide-grenier, dénichait pour ses petits-enfants d’invraisemblables cadeaux (bibelots, boîtes, gourmettes, barrettes, Opinel, porte-crayons, santons…) aussi saugrenus qu’inutiles, qu’elle leur offrait, triomphante, à chacune de ses visites."
                                            },
                                            {
