                "senses": [
                    {
                        "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                        "entry_id": "8c32c1a9-b223-36ba-ba8a-ea362bec3fa7",
                        "glosses": [
                            "ein Medikament, das den Schlafvorgang fördert und unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1041a645-3c01-4908-8317-d1219b4c5317",
                                "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                                "text": "Um nachts einschlafen zu können, braucht er Schlaftabletten."
                            },
                            {
                                "example_id": "3e649bde-522a-42e5-a39f-10e9451a2f28",
                                "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                                "text": "Eine Überdosis an Schlaftabletten kann zum Tod führen."
                            },
                            {
                                "example_id": "3964e3fb-c145-464d-813e-e621b62c4f89",
                                "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                                "text": "„Nikolai kapitulierte und schluckte eine Schlaftablette.“"
                            },
                            {
                                "example_id": "c1a6ef34-dee2-454a-bc78-79fc59403f56",
                                "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                                "text": "„Dann ging er ins Bad und nahm eine halbe Schlaftablette aus der Packung.“"
                            },
                            {
                                "example_id": "7d811b9f-8430-4718-99fa-fe576baa3512",
                                "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                                "text": "„Sie nahm eine Schlaftablette.“"
                            },
                            {
                                "example_id": "8a6481b7-f9d2-4575-abc9-df99029c5f16",
                                "sense_id": "5e8b5c17-8966-35ec-84e2-27bca1adb9d7",
                                "text": "„Sie wollte Schlaftabletten kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
