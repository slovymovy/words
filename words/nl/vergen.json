{
    "word_family": [
        "verging",
        "gevergd"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "183184ec-3cfe-3532-93bc-68274c915d6d",
                    "sense_definition": "iets als noodzakelijke voorwaarde hebben of nodig hebben om een resultaat te bereiken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vereisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit project zal veel tijd en energie <w>vergen</w> van het hele team.",
                            "target_lang_translations": {
                                "en": "This project will <w>require</w> a lot of time and energy from the whole team."
                            }
                        },
                        {
                            "text": "Het leren van een nieuwe taal <w>vergt</w> veel geduld en dagelijkse oefening.",
                            "target_lang_translations": {
                                "en": "Learning a new language <w>demands</w> a lot of patience and daily practice."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereisen",
                        "benodigen",
                        "verlangen"
                    ],
                    "common_phrases": [
                        "veel geduld vergen",
                        "veel tijd vergen",
                        "inspanning vergen"
                    ],
                    "target_lang_definitions": {
                        "en": "To have something as a necessary condition or to need it in order to achieve a result."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "require",
                                "target_lang_sense_clarification": "to need something as a condition"
                            },
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "to need a lot of effort or time"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "to involve or necessitate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f060c4c-476c-308d-840a-94e6cd605217",
                    "sense_definition": "met klem vragen of een eis stellen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De situatie <w>vergt</w> een onmiddellijke reactie van de directie.",
                            "target_lang_translations": {
                                "en": "The situation <w>calls for</w> an immediate response from the management."
                            }
                        },
                        {
                            "text": "Zij <w>vergden</w> volledige medewerking van alle betrokken partijen.",
                            "target_lang_translations": {
                                "en": "They <w>demanded</w> full cooperation from all parties involved."
                            }
                        }
                    ],
                    "synonyms": [
                        "eisen",
                        "verlangen"
                    ],
                    "common_phrases": [
                        "een reactie vergen",
                        "medewerking vergen"
                    ],
                    "target_lang_definitions": {
                        "en": "To ask urgently or to set a firm requirement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "to insist on something"
                            },
                            {
                                "target_lang_word": "require",
                                "target_lang_sense_clarification": "to command or make mandatory"
                            },
                            {
                                "target_lang_word": "exact",
                                "target_lang_sense_clarification": "to demand and obtain by force or authority"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "613c1baa-c6cd-3fb5-ab6a-0d2a699ef5f6",
                    "sense_definition": "naar iets informeren of een vraag stellen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten kan men het werkwoord <w>vergen</w> nog tegenkomen in de betekenis van vragen.",
                            "target_lang_translations": {
                                "en": "In old texts, one can still encounter the verb 'vergen' in the sense of <w>asking</w>."
                            }
                        },
                        {
                            "text": "Hij <w>vergde</w> naar de weg die hij moest inslaan.",
                            "target_lang_translations": {
                                "en": "He <w>inquired</w> about the path he had to take."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis is in het modern Nederlands nagenoeg verdwenen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To inquire about something or to ask a question."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inquire",
                                "target_lang_sense_clarification": "to ask for information (archaic)"
                            },
                            {
                                "target_lang_word": "ask",
                                "target_lang_sense_clarification": "to request information (archaic)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}