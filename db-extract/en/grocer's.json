                        "target_lang_word": "Lebensmittelladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensmittelladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                        "entry_id": "8ac96ba0-51fa-372c-a3b3-f29603a9d886",
                                        "glosses": [
                                            "ein Geschäft, in dem hauptsächlich Lebensmittel verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e06e93-66ce-4fbf-b2b7-fb987110ead5",
                                                "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                                "text": "„Sie führt den Lebensmittelladen und die Kreativwerkstatt.“"
                                            },
                                            {
                                                "example_id": "cbc31915-15f5-476d-8f97-5968dcac0d49",
                                                "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                                "text": "„Ein Bewaffneter hat in einem Lebensmittelladen im US-Bundesstaat Indiana zwei Frauen erschossen.“"
                                            },
                                            {
                                                "example_id": "3aa6b009-b878-4b8e-b40b-c7e913c7387c",
                                                "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                                "text": "„Sofort fuhr ich weiter und parkte 200 Meter weiter vor einem kleinen Lebensmittelladen und ließ den Autoschlüssel unter der Fußmatte verschwinden.“"
                                            },
                                            {
                                                "example_id": "65ea1323-b042-43a3-b246-cd1cd45345f9",
                                                "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                                "text": "„Es gibt kaum Geschäfte, nur einen großen Lebensmittelladen und das Cafe Filsbach, getragen von dem gemeinnützigen Verein Begegnungsstätte Westliche Unterstadt.“"
                                            },
                                            {
                                                "example_id": "6c69ab79-23bf-4bca-958f-653f2e24cad7",
                                                "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                                "text": "„War Putzkau bisher mit Lebensmittelläden nicht gerade reich gesegnet, kommt nun sogar ein ganz spezieller dazu.“"
                                            },
                                            {
                                                "example_id": "20474b16-3517-4085-9bcb-75e223ca5b00",
                                                "sense_id": "f2878053-8bdb-35ac-b8c1-a8438a632480",
                                                "text": "„Die Regale in den Lebensmittelläden waren leerer noch als vor ihrer Abreise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352625a6-9408-4bd0-9272-ace42fc8de8b",
                        "source_entry_id": "a08cf5c9-3299-3efe-ad8b-8c3121eee572",
                        "source_sense_id": "dbcf944b-1ba5-3b88-9f6d-920e5281ba9b",
                        "source_sense_description": "shop selling groceries",
                        "target_lang_word": "Krämer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krämer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                        "entry_id": "554b8fa8-03c6-3c14-b4fe-4d392634f35f",
                                        "glosses": [
                                            "jemand, der ein kleines Geschäft betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744efd26-f164-4d04-8388-4ec00fdaa828",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "Das kann man beim Krämer kaufen."
                                            },
                                            {
                                                "example_id": "a77fe37a-35a9-4ef7-bfee-a94c5fadb4ea",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Unter den Leuten, die sich jetzt herzudrängten, befand sich auch ein Krämer, der in Helena mit allerhand Sachen handelte.“"
                                            },
                                            {
                                                "example_id": "7b1fc1af-e361-48cb-8c1d-32f6b0de8c99",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Doch Vater Busch war nicht nur der einfache, rührige Krämer, wie ihn sein Sohn Wilhelm später beschrieb; er war ein umsichtiger Geschäftsmann, der den kleinen, von der Schwiegermutter übernommenen Kramladen in ein gut gehendes, vielseitiges Unternehmen ausbaute und den Ertrag in Grundstücken anlegte.“"
                                            },
                                            {
                                                "example_id": "6984054d-71ba-4fa4-8307-1780ef476bc2",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Sie machten sich den Krämer zum Feind, indem sie behaupteten, er verfälsche seine Schokolade.“"
                                            },
                                            {
                                                "example_id": "ff95b295-3704-4b3b-9aca-a923883f7ff0",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Durch die Gartentür sah man Monsieur Girbal, den Steureinnehmer, mit dem Hauptmann und Gutsbesitzer Heurteaux eintreten; und der Gastwirt Beljambe kam Arm in Arm mit dem Krämer Langlois, der wegen seines Katarrhs nur mühsam vorankam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "131d7e41-6626-3be5-b649-151e9ba9483c",
                                        "entry_id": "554b8fa8-03c6-3c14-b4fe-4d392634f35f",
                                        "glosses": [
                                            "ein engstirniger Mensch"
                                        ],
                                        "tags": [
                                            "figurativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfa0a2f9-2369-472a-bb6f-60f09fb3bc08",
                                                "sense_id": "131d7e41-6626-3be5-b649-151e9ba9483c",
                                                "text": "Du bist ein richtiger Krämer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Krämer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                        "entry_id": "84faa9e5-ea3b-3571-9739-949ec1f7e394",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8a8d99-ec63-473e-9288-f8c8625148b2",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Frau Krämer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b77fa8bd-8d53-44cf-bdcc-2c0a5c133fd3",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Herr Krämer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "035086bc-3dff-473a-a549-055c1e6a8f33",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Die Krämers kommen heute aus der Altmark."
                                            },
                                            {
                                                "example_id": "b115e10d-85e3-4cb9-914d-af32152b8441",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Der Krämer trägt nie die Schals, die die Krämer ihm strickt."
                                            },
                                            {
                                                "example_id": "44cca2b6-7820-4838-9135-62b919b87f91",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krämer kommt, geht der Herr Krämer.“"
                                            },
                                            {
                                                "example_id": "86c30c93-28ee-49f3-af29-cc34107a17e5",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Krämer kommt und geht."
                                            },
                                            {
                                                "example_id": "a5650374-38ad-47d0-99d7-67e917dbead2",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Krämers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "9598a054-5a5d-484b-a98c-ac0a8918db39",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "An verregneten Herbsttagen ist Familie Krämers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "9b764b45-2c74-4a19-a428-7081008b950c",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Krämer das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
