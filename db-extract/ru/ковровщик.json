                ],
                "senses": [
                    {
                        "sense_id": "c345ee4f-f481-3ec2-8b08-b1c49ad8a315",
                        "entry_id": "7e1d7e67-9d88-3469-a1b6-287a6333da53",
                        "glosses": [
                            "мастер, создающий оригинальные авторские ковры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52054dcc-4e8b-427f-a107-e877fa44979f",
                                "sense_id": "c345ee4f-f481-3ec2-8b08-b1c49ad8a315",
                                "text": "Советник спорить не стал, и призвал лучшего во всем царстве ковровщика."
                            }
                        ]
                    },
                    {
                        "sense_id": "fccfb23e-5614-32bd-86b7-185d3589553b",
                        "entry_id": "7e1d7e67-9d88-3469-a1b6-287a6333da53",
                        "glosses": [
                            "предприниматель, занимающийся производством или продажей ковров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a901bd-e6b0-479e-bf31-d77f2a632e31",
                                "sense_id": "fccfb23e-5614-32bd-86b7-185d3589553b",
                                "text": "Отец Мольера, королевский ковровщик, отдал сына в коллеж Клермон, где будущий драматург получил образование."
                            }
                        ]
                    },
                    {
                        "sense_id": "6baa0470-baf9-30b0-97e3-3f5fa9bd0eb2",
                        "entry_id": "7e1d7e67-9d88-3469-a1b6-287a6333da53",
                        "glosses": [
                            "рабочий, занятый на производстве ковров и ковровых покрытий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f6b78aa-45d6-4a73-b406-797f92360b67",
                                "sense_id": "6baa0470-baf9-30b0-97e3-3f5fa9bd0eb2",
                                "text": "Типовая должностная инструкция ковровщика 4-го разряда."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0595a420-516a-44fa-a653-99c54a19bac1",
                        "source_entry_id": "7e1d7e67-9d88-3469-a1b6-287a6333da53",
                        "source_sense_description": "автор",
                        "target_lang_word": "carpet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c15a2ed-d20e-3962-be90-a52d183a659f",
                                        "entry_id": "1cf260ee-bd42-346b-a44c-19bd831431a1",
                                        "glosses": [
                                            "A fabric used as a complete floor covering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f4fbae1-294b-4a54-88d7-6b934a1b2f26",
                                                "sense_id": "2c15a2ed-d20e-3962-be90-a52d183a659f",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire."
                                            },
                                            {
                                                "example_id": "420af650-20b8-4bf6-be88-076813109de9",
                                                "sense_id": "2c15a2ed-d20e-3962-be90-a52d183a659f",
                                                "text": "The railways are anxious to refurbish their stations and rolling stock when they can get labour and materials, although it is unlikely that they contemplate deep carpets in wayside waiting rooms. Lack of carpets at present is not confined to railways, and roaring fires in the present fuel scarcity would probably be considered anti-social in wayside waiting rooms."
                                            },
                                            {
                                                "example_id": "ed1d24cc-86ea-4290-99b6-6def4da83d84",
                                                "sense_id": "2c15a2ed-d20e-3962-be90-a52d183a659f",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07313be6-2a41-3688-8c6e-92f6b5d35e7c",
                                        "entry_id": "1cf260ee-bd42-346b-a44c-19bd831431a1",
                                        "glosses": [
                                            "Any surface or cover resembling a carpet or fulfilling its function."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ba28b22-bb1c-4107-930b-5a7c89c52c45",
                                                "sense_id": "07313be6-2a41-3688-8c6e-92f6b5d35e7c",
                                                "text": "the grassy carpet of this plain"
                                            },
                                            {
                                                "example_id": "a91df9d6-b6a1-40b4-b895-636b6d7cfaf6",
                                                "sense_id": "07313be6-2a41-3688-8c6e-92f6b5d35e7c",
                                                "text": "Way deep in left field, where the carpet of green sloped upward to a terrace and greeted the thick line of trees, he reached out his glove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f541fece-17bd-3dc9-ba02-a80f0f272e0b",
                                        "entry_id": "1cf260ee-bd42-346b-a44c-19bd831431a1",
                                        "glosses": [
                                            "Any of a number of moths in the geometrid subfamily Larentiinae"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0cad482-fb01-3351-a61c-927a4c369273",
                                        "entry_id": "1cf260ee-bd42-346b-a44c-19bd831431a1",
                                        "glosses": [
                                            "A wrought cover for tables."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f25ce49f-3882-47de-9ef5-129301f3da66",
                                                "sense_id": "f0cad482-fb01-3351-a61c-927a4c369273",
                                                "text": "Tables and beds covered with copes instead of carpets and coverlets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7074a9c2-a9fe-34a7-9598-2031a8eb4e8f",
                                        "entry_id": "1cf260ee-bd42-346b-a44c-19bd831431a1",
                                        "glosses": [
                                            "A woman's pubic hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "carpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b624ac8a-3627-3c88-b974-b307671dd3b3",
                                        "entry_id": "48b639d6-3467-3380-84b5-c80d9788ace6",
                                        "glosses": [
                                            "To lay carpet, or to have carpet installed, in an area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a54bb8a-d72a-4395-a8c8-ea280fb44270",
                                                "sense_id": "b624ac8a-3627-3c88-b974-b307671dd3b3",
                                                "text": "After the fire, they carpeted over the blackened hardwood flooring."
                                            },
                                            {
                                                "example_id": "c07c00f1-edf4-4b37-ac59-ea37aa966ad7",
                                                "sense_id": "b624ac8a-3627-3c88-b974-b307671dd3b3",
                                                "text": "The builders were carpeting in the living room when Zadie inspected her new house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef49eff-b8e8-30e6-aa62-cb80e4acb832",
                                        "entry_id": "48b639d6-3467-3380-84b5-c80d9788ace6",
                                        "glosses": [
                                            "To substantially cover something, as a carpet does; to blanket something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c337af-f403-42a4-9db9-2ad6e4a7d660",
                                                "sense_id": "fef49eff-b8e8-30e6-aa62-cb80e4acb832",
                                                "text": "Popcorn and candy wrappers carpeted the floor of the cinema."
                                            },
                                            {
                                                "example_id": "15a80763-516d-473a-ac53-07432af0535f",
                                                "sense_id": "fef49eff-b8e8-30e6-aa62-cb80e4acb832",
                                                "text": "Georgian and Regency houses cluster picturesquely around the sloping village green, which in springtime is carpeted with daffodils."
                                            },
                                            {
                                                "example_id": "7a4dfc30-42d4-441d-aeb9-d270a66bb695",
                                                "sense_id": "fef49eff-b8e8-30e6-aa62-cb80e4acb832",
                                                "text": "2017, Jennifer S. Holland, For These Monkeys, It’s a Fight for Survival., National Geographic (March 2017)http://www.nationalgeographic.com/magazine/2017/03/macaques-monkeys-indonesia-endangered-pet-trade/\nThe town of Tompasobaru, a six-hour drive from Tangkoko, is known for the fragrant cloves that carpet the front yards of homes, drying on tarps in the sun. But in the town’s open market, the air hung heavy with the metallic smell of the butcher’s wares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0de560-1de4-3a69-98f0-8ba384e41578",
                                        "entry_id": "48b639d6-3467-3380-84b5-c80d9788ace6",
                                        "glosses": [
                                            "To reprimand."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28195b72-374c-432f-b96e-47322a32f9a3",
                                                "sense_id": "0d0de560-1de4-3a69-98f0-8ba384e41578",
                                                "text": "Even Colonel Yakov, so recently carpeted by St Petersburg, was reported to be back in the Pamirs."
                                            },
                                            {
                                                "example_id": "91596817-cc98-48f6-849d-b6c8f7f5ee98",
                                                "sense_id": "0d0de560-1de4-3a69-98f0-8ba384e41578",
                                                "text": "At 4pm, the phone went. It was The Sun: 'We hear your daughter's been expelled for cheating at her school exams...'\nShe'd made a remark to a friend at the end of the German exam and had been pulled up for talking.\nAs they left the exam room, she muttered that the teacher was a 'twat'. He heard and flipped—a pretty stupid thing to do, knowing the kids were tired and tense after exams. Instead of dropping it, the teacher complained to the Head and Deb was carpeted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
