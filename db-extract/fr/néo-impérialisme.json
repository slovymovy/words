        "fr-extract.jsonl": [
            {
                "entry_id": "ed84cdb2-1012-3107-8263-e1a64a299d04",
                "word": "néo-impérialisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "231f1261-c3b9-4150-ba4f-572a484b6279",
                        "entry_id": "ed84cdb2-1012-3107-8263-e1a64a299d04",
                        "tags": [
                            "plural"
                        ],
                        "form": "néo-impérialismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "048808e9-3312-37bc-b5a6-5e972158c22f",
                        "entry_id": "ed84cdb2-1012-3107-8263-e1a64a299d04",
                        "glosses": [
                            "Concept politique désignant une forme de domination économique et politique exercée par certaines puissances sur d'autres pays, souvent sous couvert de développement ou de coopération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd24e53-f5ac-45c7-ae9a-999730e2e34d",
                                "sense_id": "048808e9-3312-37bc-b5a6-5e972158c22f",
                                "text": "Le néo-impérialisme des Etats-Unis renouvelle la conception romaine d’une domination morale — fondée sur la conviction que le libre-échange, la mondialisation et la diffusion de la civilisation occidentale sont bonnes pour tout le monde -, mais aussi militaire et médiatique, exercée sur des peuples considérés plus ou moins comme inférieurs."
                            },
                            {
                                "example_id": "feb5c1f9-6b69-4a9b-bde1-06a98b25916c",
                                "sense_id": "048808e9-3312-37bc-b5a6-5e972158c22f",
                                "text": "Une analyse des menaces pesant sur le patrimoine arménien, dans le Haut-Karabakh et en Azerbaïdjan, dans un contexte de néo-impérialisme panturquiste et de guerre froide entre l'Occident et la Russie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df4e29eb-a37c-4b17-a2b3-780f341f14e2",
                        "source_entry_id": "ed84cdb2-1012-3107-8263-e1a64a299d04",
                        "source_sense_id": "048808e9-3312-37bc-b5a6-5e972158c22f",
                        "target_lang_word": "neo-imperialism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neo-imperialism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2637df26-6e4d-335d-b7cd-f9e2e07b414c",
                                        "entry_id": "91a07f5e-7f27-39c9-9374-d5446e8ad9c1",
                                        "glosses": [
                                            "Alternative form of neoimperialism."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a7410c-fc31-4090-b74e-8fe0cb168744",
                                                "sense_id": "2637df26-6e4d-335d-b7cd-f9e2e07b414c",
                                                "text": "[T]he Turkish Government should from now on recognize and act upon the assumption that Russian neo-imperialism is a definite threat to the safety and independence of Turkey."
                                            },
                                            {
                                                "example_id": "931d85c1-8b2d-4352-b72b-e522c81cab53",
                                                "sense_id": "2637df26-6e4d-335d-b7cd-f9e2e07b414c",
                                                "text": "In Bosnia-Herzegovina, the Western powers put aside the indirect forms of neo-imperialism and opted for direct colonialism."
                                            },
                                            {
                                                "example_id": "0926a9c2-d49d-43b0-93ed-d66b87e1d69e",
                                                "sense_id": "2637df26-6e4d-335d-b7cd-f9e2e07b414c",
                                                "text": "In his 1958 autobiography, he [Edgar Snow] described Marxism as a 'heretical' descendant of Western Judeo-Christianity that was an imperfect fit as an ideology for anti-colonial revolutions in Asia. The old empires were crumbling but were being replaced by neo-imperialisms."
                                            },
                                            {
                                                "example_id": "9c5dab85-bcd5-4ce2-b7fa-a6bff8395776",
                                                "sense_id": "2637df26-6e4d-335d-b7cd-f9e2e07b414c",
                                                "text": "To survive Russia's neo-imperialism, Europe's democracies must find a balance between their desire for peace and their own defence[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3befb3a3-7a91-4a9e-909b-2c8483b94d57",
                        "source_entry_id": "ed84cdb2-1012-3107-8263-e1a64a299d04",
                        "source_sense_id": "048808e9-3312-37bc-b5a6-5e972158c22f",
                        "target_lang_word": "neoimperialism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoimperialism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                        "entry_id": "517560ee-536a-3e6c-bb48-0375ea8ad620",
                                        "glosses": [
                                            "A contemporary form of imperialism; modern imperialistic practices by a country, such as using influence and power to dominate smaller countries."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65854b4c-ff16-4166-9786-b7c8489f39ab",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "[T]he Turkish Government should from now on recognize and act upon the assumption that Russian neo-imperialism is a definite threat to the safety and independence of Turkey."
                                            },
                                            {
                                                "example_id": "1745e0d1-d28d-4b7d-8b50-43cc098e379e",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "From the moment this word [Geopolitik] was seized by the Germans, it became the best descriptive term of the guiding philosophy of German neoimperialism."
                                            },
                                            {
                                                "example_id": "24758753-a208-41d9-8122-eb23f489fe72",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "[T]he Afro-Asian peoples common basic mission is to continue their present battle against the old and neoimperialisms and to win and secure national independence."
                                            },
                                            {
                                                "example_id": "15caa637-5a34-4de8-a999-908dd4521529",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "After World War II, European powers like Britain and France adopted a strategy of neoimperialism. Financially depleted by years of warfare, and facing intensified popular resistance from within the Third World itself, they reluctantly decided that indirect economic hegemony was less costly and politically more expedient than outright colonial rule. […] Furthermore, under neoimperialism the native government takes up the costs of administering the country while the imperialist interests are free to concentrate on accumulating capital, which is all they really want to do."
                                            },
                                            {
                                                "example_id": "f66d0aa0-1549-4dc0-8329-199497ff01e5",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "In Bosnia-Herzegovina, the Western powers put aside the indirect forms of neo-imperialism and opted for direct colonialism."
                                            },
                                            {
                                                "example_id": "906e9303-c2d7-4885-a65f-52578094d2d0",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "In his 1958 autobiography, he [Edgar Snow] described Marxism as a 'heretical' descendant of Western Judeo-Christianity that was an imperfect fit as an ideology for anti-colonial revolutions in Asia. The old empires were crumbling but were being replaced by neo-imperialisms."
                                            },
                                            {
                                                "example_id": "28f04092-4e5f-4142-b047-7fd61fccba1f",
                                                "sense_id": "251492e4-05d0-3269-8f47-03d0cfe67786",
                                                "text": "To survive Russia's neo-imperialism, Europe's democracies must find a balance between their desire for peace and their own defence[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
