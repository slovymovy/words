                "senses": [
                    {
                        "sense_id": "4b906372-6b31-3bcc-8105-94c1bcb81f78",
                        "entry_id": "035daea0-4cab-37ca-8f51-944575adcc4b",
                        "glosses": [
                            "Having a derivative, said of a function whose domain and codomain are manifolds."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a39902c-d4b1-481e-ad21-942171908272",
                                "sense_id": "4b906372-6b31-3bcc-8105-94c1bcb81f78",
                                "text": "A function which is differentiable wherever it is continuous is said to possess ordinary continuity."
                            }
                        ]
                    },
                    {
                        "sense_id": "6401d253-f815-39f4-a589-20c4a04cbe26",
                        "entry_id": "035daea0-4cab-37ca-8f51-944575adcc4b",
                        "glosses": [
                            "able to be differentiated; distinguishable, as for example by differing appearance or measurable characteristics."
                        ],
                        "tags": [
                            "comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "31c40d1b-0ea0-4fe2-9479-feeacbc099e7",
                                "sense_id": "6401d253-f815-39f4-a589-20c4a04cbe26",
                                "text": "It would, in that case, have been as real as it now is, and would have been differentiable from its Maker as an effect is differentiable from its cause."
                            }
                        ]
                    }
                ],
                "translations": [
