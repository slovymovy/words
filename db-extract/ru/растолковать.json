                    }
                ],
                "senses": [
                    {
                        "sense_id": "c115e84f-2356-36af-975c-c092db6e434b",
                        "entry_id": "641a1254-4455-3853-9201-3ff3a3e4057c",
                        "glosses": [
                            "хорошо, толково объяснив, сделать понятным"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d7e2525-d004-42ee-9ddd-ef2b99b6f4de",
                        "source_entry_id": "641a1254-4455-3853-9201-3ff3a3e4057c",
                        "source_sense_id": "c115e84f-2356-36af-975c-c092db6e434b",
                        "target_lang_word": "explain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To make plain, manifest, or intelligible; to clear of obscurity; to illustrate the meaning of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67686e4f-b7e9-4517-9d83-269b594f98e7",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "The issue was explained to the governor in detail."
                                            },
                                            {
                                                "example_id": "405eb740-21ad-489c-b4a8-83d6ad58db82",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "The boy became volubly friendly and bubbling over with unexpected humour and high spirits. He tried to persuade Cicely to stay away from the ball-room for a fourth dance. Nobody would miss them, he explained."
                                            },
                                            {
                                                "example_id": "030c7e56-d7e6-44b2-8aa6-bcae2130334a",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            },
                                            {
                                                "example_id": "21a6438a-0267-41f1-b010-80a30b16b456",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "He concisely explains that Whig histories tend to \"praise revolutions [for history of science, we could read novelties, ideas or individuals] provided they have been successful, emphasise certain principles of progress in the past and produce a story which is the ratification if not the glorification of the present\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c47708-73d2-3bb8-b353-c567eec57c92",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To give the reason for, justification for, or cause of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30b82073-8666-4039-b664-804fe4701f5f",
                                                "sense_id": "e8c47708-73d2-3bb8-b353-c567eec57c92",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af93fad-a6cc-3555-b4ea-75360622fc15",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To make flat, smooth out."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46c94989-b5f9-397b-a6a7-58bbb709752e",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To unfold or make visible."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d27ff4-a8a6-442f-9270-f2b996998079",
                                                "sense_id": "46c94989-b5f9-397b-a6a7-58bbb709752e",
                                                "text": "April 14, 1684, John Evelyn, a letter sent to the Royal Society concerning the damage done to his gardens by the preceding winter\nThe horse-chestnut is […] ready to explain its leaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To make something plain or intelligible."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9fec27-33d2-49a5-9001-0b07b3ba6ebb",
                                                "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                                "text": "She tried to explain but he wouldn’t listen."
                                            },
                                            {
                                                "example_id": "264eb55e-2870-46fb-a780-d233a2a83ce3",
                                                "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                                "text": "It is easy to modify the account to take this into account, by explaining not just in terms of a set of reasons but in terms of a set of reason–weight pairs."
                                            },
                                            {
                                                "example_id": "e2ea84d3-fdff-4959-8a2f-1726841142db",
                                                "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                                "text": "Like their Western counterparts, local media engages in shorthand - it reports rather than explains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
