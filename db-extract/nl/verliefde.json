                                "example_id": "25514347-e32a-455e-857b-f017cb4f54f6",
                                "sense_id": "886107f4-66ed-3402-9bfd-014bbf145a8c",
                                "text": "De grootste bioscoop van Twente, Kinepolis, bestaat deze maand 20 jaar. Door de jaren heen hebben oneindig veel verliefde stelletjes en bioscoopfanaten er hun ogen de kost gegeven."
                            },
                            {
                                "example_id": "aa8681aa-e9f4-46d4-ab45-74f580b75163",
                                "sense_id": "886107f4-66ed-3402-9bfd-014bbf145a8c",
                                "text": "Hij moet de keuze maken tussen een veilig huwelijk met de verliefde Marion of voor een homoseksuele relatie met zijn grote liefde, wat in die tijd niet werd geaccepteerd."
                            }
                        ]
                    }
