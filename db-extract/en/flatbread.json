                    {
                        "translation_id": "b01d439c-4db2-483c-ba32-79eb37eee69f",
                        "source_entry_id": "979d5e2f-0a27-3b16-8d1f-7b119f93732f",
                        "source_sense_id": "81aecd3b-9cb1-3137-a08b-90e32022904b",
                        "source_sense_description": "thin, flat bread",
                        "target_lang_word": "Fladenbrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fladenbrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2d83e7-2ddc-38fa-948a-fb97a3c679d2",
                                        "entry_id": "dae09542-79d1-3b9f-9646-4b43c055ca8c",
                                        "glosses": [
                                            "flaches, meist rundes Brot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e621377e-128e-47f7-afed-55d465d88a74",
                                                "sense_id": "3b2d83e7-2ddc-38fa-948a-fb97a3c679d2",
                                                "text": "Das Fladenbrot ist lecker."
                                            },
                                            {
                                                "example_id": "370b1260-488f-44b5-ba56-a47864f17351",
                                                "sense_id": "3b2d83e7-2ddc-38fa-948a-fb97a3c679d2",
                                                "text": "„Die Menschen der Westküste lebten als Wildbeuter: Sie fingen Lachse, sammelten Muscheln, jagten Wild und zerrieben Eicheln zu Mehl, um daraus Fladenbrote zu backen.“"
                                            },
                                            {
                                                "example_id": "da3fc329-c348-44cd-a0af-3a8ede40d3c6",
                                                "sense_id": "3b2d83e7-2ddc-38fa-948a-fb97a3c679d2",
                                                "text": "„Das Fladenbrot wurde aus einem ungesäuerten Teig aus Mehl, Wasser und Salz gebacken.“"
                                            },
                                            {
                                                "example_id": "288a4a70-2a2c-4cff-a43f-c12d479b8819",
                                                "sense_id": "3b2d83e7-2ddc-38fa-948a-fb97a3c679d2",
                                                "text": "„Darauf stellte sie Teller mit Fladenbrot, Butter, geräuchertem Lammfleisch, vier Stück Blechkuchen, zwei Weingläser und eine Flasche Rotwein, die sie mich zu öffnen bat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e1974f-94e1-44f1-b06a-adcdf5b30afb",
                        "source_entry_id": "979d5e2f-0a27-3b16-8d1f-7b119f93732f",
                        "source_sense_id": "81aecd3b-9cb1-3137-a08b-90e32022904b",
