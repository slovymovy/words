                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97af0928-7215-4965-978c-2c04d8014abc",
                                                "sense_id": "945f4c01-162a-368c-b1f0-5ebef30c1e18",
                                                "text": "Mam na imię Cyryl i pracuję w Instytucie Slawistyki Polskiej Akademii Nauk jako slawista."
                                            },
                                            {
                                                "example_id": "c6e87f5a-c5df-4fa1-a60f-5ff5a6851b88",
                                                "sense_id": "945f4c01-162a-368c-b1f0-5ebef30c1e18",
                                                "text": "14 lutego, 18 marca i 27 czerwca przypadają imieniny Cyryla."
                                            },
                                            {
                                                "example_id": "8d6e4758-326c-4000-9495-4017bb93185e",
                                                "sense_id": "945f4c01-162a-368c-b1f0-5ebef30c1e18",
                                                "text": "Panie Cyrylu, proszę nas jutro odwiedzić."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89b2eb0e-a7d8-4452-89ec-d26b54a1aae6",
                        "source_entry_id": "dfb10e81-da13-3c0f-ac9a-8e210a852dce",
                        "source_sense_id": "f05ba3d4-75cf-30d2-9d66-0c625812967c",
