                        "sense_id": "dce2c4eb-f648-3089-aad3-797b33bfef3a",
                        "entry_id": "f75b0704-0d81-3962-8539-afe26e698f20",
                        "glosses": [
                            "Qui a reçu plusieurs médailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c145ea-6238-4ebc-b1c5-4bf597603762",
                                "sense_id": "dce2c4eb-f648-3089-aad3-797b33bfef3a",
                                "text": "Après trois ans d’absence, la nageuse française multimédaillée olympique et mondiale refait parler d’elle dans les bassins."
                            },
                            {
                                "example_id": "7d9fb04c-6dad-4288-b5df-4b7f3317d2d9",
                                "sense_id": "dce2c4eb-f648-3089-aad3-797b33bfef3a",
                                "text": "L’honneur de porter le drapeau revient donc souvent à un sportif familier des JO, parfois multimédaillé."
                            },
                            {
                                "example_id": "0957997e-9103-452d-9917-51544ed82993",
                                "sense_id": "dce2c4eb-f648-3089-aad3-797b33bfef3a",
                                "text": "Après avoir perdu en route le hurdler multimédaillé Pascal Martinot-Lagarde, devancé par trois concurrents, et Renaud Lavillenie, blessé, l’équipe de France manque cruellement de piliers."
                            }
                        ]
                    }
