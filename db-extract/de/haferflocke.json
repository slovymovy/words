                    {
                        "form_id": "6a621bf0-1fed-4eae-b2de-f7d63c5598ca",
                        "entry_id": "97bd8d45-135b-3e22-949c-3a60754c987b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Haferflocken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                        "entry_id": "97bd8d45-135b-3e22-949c-3a60754c987b",
                        "glosses": [
                            "behandeltes Korn vom Hafer"
                        ],
                        "tags": [
                            "Gebrauch meist im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f68e19db-f167-4bb6-ba02-4b51af85b592",
                                "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                                "text": "Aufgekocht ergeben die Haferflocken den Haferschleim."
                            },
                            {
                                "example_id": "07814ff6-b713-415a-bf13-09ac603efca8",
                                "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                                "text": "„Haferflocken gelten als gesunde Sattmacher. In ihnen stecken viele Vitamine und Eiweiß.“"
                            },
                            {
                                "example_id": "ea2da916-4fcd-494f-a8c6-f4fe58294685",
                                "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                                "text": "„Haferflocken machen sich gut in Müsli und Smoothies, aber auch in Bratlingen oder Pfannkuchen.“"
                            },
                            {
                                "example_id": "62f562f6-b54f-4de3-b5e4-4210ad9fe9d7",
                                "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                                "text": "„Haferflocken können auch gern regelmäßig auf dem Speiseplan stehen, schließlich gilt Hafer als eine der gesündesten Getreidesorten.“"
                            },
                            {
                                "example_id": "33fc097a-bf89-411a-8d23-a611b819a7e4",
                                "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                                "text": "„Kernig oder zart? Für beide Sorten von Haferflocken werden ganze Körner verwendet, sowohl zarte als auch kernige Flocken sind Vollkornprodukte – egal ob das ausdrücklich auf der Verpackung steht.“"
                            },
                            {
                                "example_id": "dc3ed9e6-a524-4336-9f37-382bdecd3638",
                                "sense_id": "b27f4b4a-bcf3-347b-a6ef-f5ec1dbb4a31",
                                "text": "„Für etwas Geld oder kostenlos für Mütter, die kein Geld haben, und ohne Lebensmittelmarken können sie etwas warme Haferflocken oder Brei für ihre Kinder bekommen, Magermilch und heiße Suppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
