                {
                    "sense_id": "f6bfe998-dd86-3ab4-b728-9c4e4e5992fe",
                    "sense_definition": "Zwięzły; zawierający mało słów, ale wyrażający treść",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Napisz proszę <w>krótką</w> notatkę ze spotkania dla szefa.",
                            "target_lang_translations": {
