                                        "glosses": [
                                            "Any of many parasites, of the class Microsporidia, considered to be fungi or close relatives of fungi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e5ad76-c918-4be5-af4f-dd152f455a51",
                                                "sense_id": "af76ddf1-7741-3535-8755-1940e6f4429f",
                                                "text": "Bulnheim subsequently observed that either of two parasitic microsporidians, Octosporea effeminans and Thelohania herediteria, were invariably associated with the thelygeny."
                                            },
                                            {
                                                "example_id": "84969e4d-044b-41c3-9a35-20323db95979",
                                                "sense_id": "af76ddf1-7741-3535-8755-1940e6f4429f",
                                                "text": "Moreover , the sequence of ribosomal RNA suggests that the microsporidia are extremely ancient eukaryotes and had separated very early from other eukaryotes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
