                "senses": [
                    {
                        "sense_id": "2821fb52-1d5a-3d39-b3dd-f546af466af6",
                        "entry_id": "6be5f11c-316d-31d1-876f-005e36daf0fe",
                        "glosses": [
                            "kommerzielle Seite des Laufsports, einschließlich aller Akteure, die mit dem Laufen Geld verdienen oder kommerzielle Angebote rund ums Laufen bereitstellen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "0e6afe1c-5579-4c17-a912-0201330cf0f5",
                                "sense_id": "2821fb52-1d5a-3d39-b3dd-f546af466af6",
                                "text": "„Sie sagt, es gebe noch immer zahlreiche patriarchale Machtungleichgewichte im Sport – gerade auch beim Laufen, was vielen Menschen nicht bewusst ist, da sehr viele Frauen im Laufbusiness auf Instagram aktiv sind und der Sport daher von Frauen dominiert scheint.“"
                            },
                            {
                                "example_id": "82274663-c6c6-49ac-9698-5631c484338f",
                                "sense_id": "2821fb52-1d5a-3d39-b3dd-f546af466af6",
                                "text": "„Andreas sieht das Laufbusiness aus der Brille eines Profis und kann WEMOVE damit mit neuen, innovativen Ansätzen weiterhelfen."
                            },
                            {
                                "example_id": "49309375-d980-441c-bde3-c0fea168ebb5",
                                "sense_id": "2821fb52-1d5a-3d39-b3dd-f546af466af6",
                                "text": "„Eine weitere Beobachtung im Laufbusiness: Adidas kauft runtastic, Asics kauft Runkeeper – kann man eigentlich noch von Sportartikel-Herstellern sprechen oder entwickeln sich diese nicht vielmehr zu Infrastruktur-Anbietern?“"
                            },
                            {
                                "example_id": "680b6c1e-b131-4312-8883-578f12f12b41",
                                "sense_id": "2821fb52-1d5a-3d39-b3dd-f546af466af6",
                                "text": "„Während die Läufer starten oder ankommen können sich die Besucher nur wenige Meter weiter über die Angebote von 25 Aussteller aus dem Laufbusiness informieren.“"
                            },
                            {
                                "example_id": "ab9dc86b-cf96-4559-bcd7-e9ad2103333b",
                                "sense_id": "2821fb52-1d5a-3d39-b3dd-f546af466af6",
                                "text": "„Denn solche Aktionstage zeigen auf interessante Weise, wie das Laufbusiness sich durch die Digitalisierung verändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
