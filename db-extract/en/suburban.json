                                        "glosses": [
                                            "Qui est situé tout près d’une ville, qui l’entoure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593ef283-c32d-4e2e-8b2c-abd84e0b3006",
                                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                                "text": "Ce pavillon [d'Issy] fut la résidence suburbaine de Marguerite de Valois, la première femme de Henri IV, depuis 1606 jusqu’à sa mort en 1615."
                                            },
                                            {
                                                "example_id": "5de4eb28-0001-4942-8b31-afe639b498bf",
                                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                                "text": "Devenu le mâle dominant du clan, il avait réussi à fédérer les familles de la pègre suburbaine."
                                            },
                                            {
                                                "example_id": "51022298-e621-41a2-9666-eec9ec8651c9",
                                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                                "text": "Selon la loi sur la défusion des municipalités suburbaines qui a structuré le conseil d’agglomération, […]."
                                            },
                                            {
                                                "example_id": "8b7d603f-bf78-4912-beb9-7e1a72d89968",
                                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                                "text": "Les communes suburbaines de Paris."
                                            },
                                            {
                                                "example_id": "e38d1831-8b02-49bc-bd32-7424d912b3f7",
                                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                                "text": "La population suburbaine."
                                            }
                                        ]
                                    }
                                ]
                            }
