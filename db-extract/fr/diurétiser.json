                "senses": [
                    {
                        "sense_id": "ed02772d-2459-3c2a-9e4f-840b448b478a",
                        "entry_id": "26e95465-ecd4-3bd3-86a8-7863965d3990",
                        "glosses": [
                            "Traiter par un médicament diurétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0007b957-b09d-49d5-a713-008811467662",
                                "sense_id": "ed02772d-2459-3c2a-9e4f-840b448b478a",
                                "text": "En français, très communément, on entend les verbes « diurétiser » de « diurétique », « mastectomiser » de « mastectomie », « antibio-corticothéraper » de « antibiothérapie » et « corticothérapie », « tachycarder » de « tachycardie » ou encore « épisiotomiser » de « épisiotomie »."
                            },
                            {
                                "example_id": "079d7f5b-cfca-4661-9227-2b4b4eb90b37",
                                "sense_id": "ed02772d-2459-3c2a-9e4f-840b448b478a",
                                "text": "Voilà, il est ré-hospitalisé, drainé et diurétisé!"
                            },
                            {
                                "example_id": "1e5adfa7-6c68-42fb-ba24-5db401728774",
                                "sense_id": "ed02772d-2459-3c2a-9e4f-840b448b478a",
                                "text": "On a fait de grosses économies de Lasilix, on n'avait même plus besoin de les diurétiser."
                            },
                            {
                                "example_id": "277e0d28-82c8-49cd-b27f-fdf44d0e2aa3",
                                "sense_id": "ed02772d-2459-3c2a-9e4f-840b448b478a",
                                "text": "Comme DAB, deux grands bols de café pour \"diurétiser\" le transit, tartine grillées beurre - confiote : elle est pas belle la vie"
                            }
                        ]
                    }
                ],
