                        "examples": [
                            {
                                "example_id": "ae3e72d1-5fc2-461f-a7a6-0b2f32939e99",
                                "sense_id": "d3f15408-4b2e-31c4-a0a0-2603802d1989",
                                "text": "„Er war ein recht kleiner Mann von großem Leibesumfang, der erstaunlich behende unsere Gangway ansteuerte.“"
                            },
                            {
                                "example_id": "5fd18f29-34ca-4988-86b4-53ca80bfbead",
                                "sense_id": "d3f15408-4b2e-31c4-a0a0-2603802d1989",
                                "text": "„Als er sich wieder erheben wollte, brachte er es angesichts seines Leibesumfanges und seiner Altersschwäche lange Zeit nicht zustande.“"
                            }
                        ],
