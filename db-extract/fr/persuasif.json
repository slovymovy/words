                                        "entry_id": "deb8fbe5-9e62-3d0c-97a2-a83799efb604",
                                        "glosses": [
                                            "That which persuades; incitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f004b58-5105-420d-ae11-42a156f10a57",
                                                "sense_id": "cf6662b5-3553-3d51-81b8-2944257ffede",
                                                "text": "He smiled a very knowing smile, and setting up a halloo, and shaking his leathern thong, away we went at the rate of seven or eight miles an hour. I had no occasion to go further with my persuasives; the pace was kept up, […]"
                                            }
                                        ]
