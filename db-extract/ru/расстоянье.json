                        "sense_id": "9af0d9bb-6386-3b64-b7ae-f62979c1ee17",
                        "entry_id": "c5cf1d9d-cf49-3246-b6a3-4fa021bf648a",
                        "glosses": [
                            "устар., поэт. расстояние; промежуток времени или отрезок пути"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f654cd9b-5451-48c8-80bc-1ca5e6240e20",
                                "sense_id": "9af0d9bb-6386-3b64-b7ae-f62979c1ee17",
                                "text": "Начал даже сам аршином размерять расстоянье от пары до пары."
                            },
                            {
                                "example_id": "8a5b9b09-37f7-4e06-b234-98edc4775d91",
                                "sense_id": "9af0d9bb-6386-3b64-b7ae-f62979c1ee17",
                                "text": "Ольга останавливается в некотором расстоянье и стоит к нему боком."
                            },
                            {
                                "example_id": "f7216047-6b7f-4079-9c1d-15d82a173b04",
                                "sense_id": "9af0d9bb-6386-3b64-b7ae-f62979c1ee17",
                                "text": "Расстоянья сделались короче, // Стали ближе дальние места."
                            }
                        ]
                    }
