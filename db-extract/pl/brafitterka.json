                        "sense_id": "ccd1da4c-1719-3068-a29b-206317e1f966",
                        "entry_id": "a32a52dd-a163-3569-8b2d-d3a760ee5279",
                        "glosses": [
                            "specjalistka w zakresie doboru właściwego biustonosza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a96c58-18bd-40ed-acda-e405d9144835",
                                "sense_id": "ccd1da4c-1719-3068-a29b-206317e1f966",
                                "text": "Nie wyobrażam sobie w roli brafitterki kobiety, która ma trudności z nawiązywaniem kontaktów, jest introwertyczna, bardzo nieśmiała – lub przeciwnie – agresywna i zawsze przekonana o swojej racji"
                            },
                            {
                                "example_id": "8caf6667-f26e-4197-8c7b-8ba933c52a8d",
                                "sense_id": "ccd1da4c-1719-3068-a29b-206317e1f966",
                                "text": "Przeszkolona brafitterka umie określić rozmiar, jaki powinna nosić klientka, a także zaproponować jej najkorzystniejszy model biustonosza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
