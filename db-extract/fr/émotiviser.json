                "senses": [
                    {
                        "sense_id": "9e3e1f50-feec-3062-8179-1ebc7cf24152",
                        "entry_id": "9f84c99c-cf64-3428-9dea-97df0f212b52",
                        "glosses": [
                            "Donner un caractère d’émotion à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac543d4-785c-4b0b-aa7d-b637bc9c2d14",
                                "sense_id": "9e3e1f50-feec-3062-8179-1ebc7cf24152",
                                "text": "Donc, tous ces mécanismes d'imprégnation se logent dans notre cerveau qui ramasse tout ce qu'il a pu voir, observer, émotiviser ou vibrer."
                            },
                            {
                                "example_id": "ad882fdc-2377-433c-b11c-56a2fd6e9512",
                                "sense_id": "9e3e1f50-feec-3062-8179-1ebc7cf24152",
                                "text": "Nous gardons une mémoire fonctionnelle, mais celle qui ne peut émotiviser quoique ce soit et tout ce qui est nécessaire dans notre quotidien."
                            },
                            {
                                "example_id": "50af499c-7572-438c-89d7-b0faa8bcb4e1",
                                "sense_id": "9e3e1f50-feec-3062-8179-1ebc7cf24152",
                                "text": "De cette façon, nous serons aptes à subir des changements vibratoires sans en émotiviser leur arrivée soudaine."
                            }
                        ]
                    }
                ],
