                        ],
                        "examples": [
                            {
                                "example_id": "3b46c502-d988-4158-9710-d8a1c14a9039",
                                "sense_id": "651828b9-e2b4-34e4-b7d5-eaf7eacf3f90",
                                "text": "Voyant que l'amant au membre de gladiateur se redresse à demi, je le refoudroie d'un coup de bouddha en ivoire imitation."
                            },
                            {
                                "example_id": "42812e4a-61ad-4af5-8c68-d3f567bd0b60",
                                "sense_id": "651828b9-e2b4-34e4-b7d5-eaf7eacf3f90",
                                "text": "Son oncle avance vers elle d'un pas décidé, la foudroie du regard, jette un coup d'œil au tableau et la refoudroie. « Non, Véro, c'est non et cent fois non !"
                            }
                        ]
                    }
