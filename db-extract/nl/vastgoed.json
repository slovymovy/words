                "senses": [
                    {
                        "sense_id": "ba6e8c55-504a-3880-942e-20cde0cb11d9",
                        "entry_id": "074d2bd0-7758-34dc-8575-cc3149a8bdc3",
                        "glosses": [
                            "goed [2] dat niet verplaatsbaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c8faf4-37f7-459a-84b0-307e8873aa9c",
                                "sense_id": "ba6e8c55-504a-3880-942e-20cde0cb11d9",
                                "text": "Het vastgoed werd tegen te hoge prijzen verkocht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6d259fd-e280-49ae-91e5-e23dce1884b1",
                        "source_entry_id": "074d2bd0-7758-34dc-8575-cc3149a8bdc3",
                        "source_sense_id": "ba6e8c55-504a-3880-942e-20cde0cb11d9",
                        "target_lang_word": "Immobilie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Immobilie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb65eb0-ea64-3c56-9f51-2ccd99b9e5e7",
                                        "entry_id": "9e96c314-dc39-3eef-b3b3-f85e57edfbe1",
                                        "glosses": [
                                            "unbewegliche Sachanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ec414e-bb73-4612-bfdd-dec2b539c3de",
                                                "sense_id": "dfb65eb0-ea64-3c56-9f51-2ccd99b9e5e7",
                                                "text": "Die ungenutzte Immobilie könnte sofort veräußert werden."
                                            },
                                            {
                                                "example_id": "1124584e-5e64-4486-9384-99ec23d11116",
                                                "sense_id": "dfb65eb0-ea64-3c56-9f51-2ccd99b9e5e7",
                                                "text": "„‚Immobilien gelten als krisensichere Altersvorsorge und gerade vor dem Hintergrund historisch günstiger Baugeldzinsen kann es sich lohnen, über eine vermietete Immobilie langfristig Vermögen aufzubauen‘, sagt Michiel Goris, Vorstandsvorsitzender der Interhyp, des derzeit größten Vermittlers privater Baufinanzierungen in Deustchland.“"
                                            },
                                            {
                                                "example_id": "6163c21d-e832-4e3b-aa1c-7d23454ca3ac",
                                                "sense_id": "dfb65eb0-ea64-3c56-9f51-2ccd99b9e5e7",
                                                "text": "„Wie hoch ist die ortsübliche Miete, was zahlen andere Mieter in ähnlichen Objekten, ist das Viertel eine beliebte Wohngegend oder wechseln die Mieter dort sehr häufig? All diese Fragen muss der Käufer beantworten können, um die Vermietbarkeit der Immobilie realistisch einschätzen zu können.“"
                                            },
                                            {
                                                "example_id": "d3cafd3f-956f-4cfb-91cd-34093b1fc416",
                                                "sense_id": "dfb65eb0-ea64-3c56-9f51-2ccd99b9e5e7",
                                                "text": "„Verkäufer von Immobilien erleben goldene Zeiten.“"
                                            },
                                            {
                                                "example_id": "5697fecb-6c81-4dee-b7df-88ace6f5112e",
                                                "sense_id": "dfb65eb0-ea64-3c56-9f51-2ccd99b9e5e7",
                                                "text": "„Für das Geld bekommen Sie immerhin eine sehr schöne Immobilie in Brandenburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "288399c2-4a7c-48c3-bec3-c0e5803b742b",
                        "source_entry_id": "074d2bd0-7758-34dc-8575-cc3149a8bdc3",
                        "source_sense_id": "ba6e8c55-504a-3880-942e-20cde0cb11d9",
