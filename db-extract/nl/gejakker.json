                                "target_senses": [
                                    {
                                        "sense_id": "c7fc8074-4ba9-3ab8-b761-ba44bd9b1294",
                                        "entry_id": "fb1bae68-f802-376b-ab77-b8c09555bcb3",
                                        "glosses": [
                                            "present participle and gerund of hurry"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ce5d56-3ade-4706-a52c-275893ec90d9",
                                                "sense_id": "c7fc8074-4ba9-3ab8-b761-ba44bd9b1294",
                                                "text": "With a little manœuvring they contrived to meet on the doorstep which was […] in a boiling stream of passers-by, hurrying business people speeding past in a flurry of fumes and dust in the bright haze."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hurrying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19473036-d85f-35fa-bd2e-e2ce5b874bd7",
                                        "entry_id": "34192522-489e-3007-b2d1-def80dafefe3",
                                        "glosses": [
                                            "The act of one who hurries; hasty motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d808800-4631-44da-a44b-19274b7635fa",
                                                "sense_id": "19473036-d85f-35fa-bd2e-e2ce5b874bd7",
                                                "text": "Consider the hurryings of Jesus from Caiaphas to Pilate; now he stands before Pilate where he was accused of sedition, seduction and usurpation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
