                "senses": [
                    {
                        "sense_id": "44ef9fa3-baab-3e26-8ab5-285ba973a171",
                        "entry_id": "e066d690-f4da-3e81-9d95-0d07a1a75c9b",
                        "glosses": [
                            "extrem kleine Risse auf der Haut, wodurch Krankheiten übertragen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba3b8f0-2051-4bb4-bc95-1c762789c988",
                                "sense_id": "44ef9fa3-baab-3e26-8ab5-285ba973a171",
                                "text": "Eine Mikroläsion ist eine sehr kleine Verletzung."
                            },
                            {
                                "example_id": "91258364-b1b8-42bd-990a-c41004aaf7fc",
                                "sense_id": "44ef9fa3-baab-3e26-8ab5-285ba973a171",
                                "text": "„So wurden in der vorliegenden Arbeit neuronale und neuromuskuläre Synchronisation zwischen Nucleus subthalamicus / Nucleus ventralis intermedius thalami (STN / Vim), Kortex (M1) und den Effektoren Musculus abductor pollicis brevis / Musculus interosseus dorsalis primus (APB / FDI) beschrieben und deren gezielte Modulation durch therapeutische Stimulation und operative Mikroläsion in vier perioperativen Untersuchungsbedingungen untersucht:“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad745425-addb-32ec-852d-f052f8adbd29",
                        "entry_id": "e066d690-f4da-3e81-9d95-0d07a1a75c9b",
                        "glosses": [
                            "kleine Risse in den Muskeln, wobei einzelne Muskelfasern verletzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e42220b5-9848-43c7-beea-db40c8b1df11",
                                "sense_id": "ad745425-addb-32ec-852d-f052f8adbd29",
                                "text": "Eine Mikroläsion ist eine sehr kleine Verletzung."
                            },
                            {
                                "example_id": "64edcc17-ef00-4275-bf58-6bccb85d3a79",
                                "sense_id": "ad745425-addb-32ec-852d-f052f8adbd29",
                                "text": "„Abbauprodukte der Mikroläsionen sind wahrscheinlich osmotisch aktiv und erhöhen dadurch den Druck in den Muskelfasern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
