                "entry_id": "6e0ea214-dbb8-3349-b64c-ef5645b3fd86",
                "word": "académicienne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43d2e9f1-6af4-409c-b9db-15a69a19479e",
                        "entry_id": "6e0ea214-dbb8-3349-b64c-ef5645b3fd86",
                        "tags": [
                            "plural"
                        ],
                        "form": "académiciennes"
                    },
                    {
                        "form_id": "20a86efd-c6d8-4eb8-b634-eaf6f95e2329",
                        "entry_id": "6e0ea214-dbb8-3349-b64c-ef5645b3fd86",
                        "tags": [
                            "masculine"
                        ],
                        "form": "académicien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "449d4d00-f5e2-3e31-9b20-c055cce14c0e",
                        "entry_id": "6e0ea214-dbb8-3349-b64c-ef5645b3fd86",
                        "glosses": [
                            "Femme qui fait partie d’une compagnie de gens de lettres, de savants ou d’artistes, nommée Académie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713a9401-ba95-4f2a-944b-42bb3017e626",
                                "sense_id": "449d4d00-f5e2-3e31-9b20-c055cce14c0e",
                                "text": "Ces réflexions mettraient une femme en état de travailler en Académicienne à la perfection de sa langue naturelle"
                            },
                            {
                                "example_id": "78a086ad-cd11-443a-b35d-e7281df5277a",
                                "sense_id": "449d4d00-f5e2-3e31-9b20-c055cce14c0e",
                                "text": "Eh bien, tu collectionnerais tous les diplômes de la création : licenciée, doctoresse, agrégée, académicienne… et même décorée, tu ne pourrais pas enseigner la grammaire."
                            },
                            {
                                "example_id": "ee91e8a8-5586-46f9-8cdc-10ae50eddd93",
                                "sense_id": "449d4d00-f5e2-3e31-9b20-c055cce14c0e",
                                "text": "Trois académiciens français, ou plus précisément deux académiciens et une académicienne, détail qui vaut son pesant non seulement de cacahuètes mais des chimpanzés qui vont avec, ont, début 1998, pris une de ces initiatives qui marquent l’histoire pourtant surchargée de la grosse bêtise réactionnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47bfb19e-c408-40bf-ae78-b3a18a344d85",
                        "source_entry_id": "6e0ea214-dbb8-3349-b64c-ef5645b3fd86",
                        "source_sense_id": "449d4d00-f5e2-3e31-9b20-c055cce14c0e",
                        "target_lang_word": "Akademikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akademikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dac1d33e-ba77-384e-a95d-b4e1a84d5987",
                                        "entry_id": "7cdd646f-9034-362e-9abd-69edaa3358cf",
                                        "glosses": [
                                            "Frau, die eine Hochschule erfolgreich besucht und mit Examen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e266cc5f-07fb-4cf3-a63c-f30c021a33b7",
                                                "sense_id": "dac1d33e-ba77-384e-a95d-b4e1a84d5987",
                                                "text": "Akademikerin kann man nur durch eine Ausbildung an einer Hochschule werden."
                                            },
                                            {
                                                "example_id": "0410e548-e181-44a3-b499-227a10bc9f7b",
                                                "sense_id": "dac1d33e-ba77-384e-a95d-b4e1a84d5987",
                                                "text": "„Er betrieb jetzt eine eigene Firma für Luxus-Safaris und war mit einer Akademikerin verheiratet, mit der er zwei kleine Söhne hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19ec3bf4-d2ba-3ad5-9d9f-ddac4d1738eb",
                                        "entry_id": "7cdd646f-9034-362e-9abd-69edaa3358cf",
                                        "glosses": [
                                            "weibliches Mitglied einer Akademie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68033e1b-dada-4d6a-ad38-ff95d07c4a38",
                                                "sense_id": "19ec3bf4-d2ba-3ad5-9d9f-ddac4d1738eb",
                                                "text": "Sie ist eine berühmte Akademikerin und auch eine der reichsten Personen in ihrem Land."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00197d89-2281-45f1-a3dd-2a145c85cf89",
                        "source_entry_id": "6e0ea214-dbb8-3349-b64c-ef5645b3fd86",
                        "source_sense_id": "449d4d00-f5e2-3e31-9b20-c055cce14c0e",
                        "target_lang_word": "academician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "academician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72e914cd-0bef-3cac-813d-2bb8d65f2063",
                                        "entry_id": "5df32ba6-0153-39f2-8ff0-e1951c1807cf",
                                        "glosses": [
                                            "A member (especially a senior one) of the faculty at a college or university; an academic."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8156ce3f-5bcd-48d6-bd79-5a4d58851c00",
                                                "sense_id": "72e914cd-0bef-3cac-813d-2bb8d65f2063",
                                                "text": "One can learn more about the nature of our society by sharing in a small way the life of its victims than by interacting intellectually with its privileged academicians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11cf7d0d-5d1c-3b55-b893-0259977d2d8c",
                                        "entry_id": "5df32ba6-0153-39f2-8ff0-e1951c1807cf",
                                        "glosses": [
                                            "A member or follower of an academy, or society for promoting science, art, or literature, such as the French Academy, or the Royal Academy of Arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1956852-15ed-434b-ac1c-88647af2aac9",
                                                "sense_id": "11cf7d0d-5d1c-3b55-b893-0259977d2d8c",
                                                "text": "‘Well, after I had been in the room about ten minutes, talking to huge overdressed dowagers and tedious Academicians, I suddenly became conscious that some one was looking at me.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
