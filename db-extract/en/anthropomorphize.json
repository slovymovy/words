                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd8e7b0f-aad2-350d-8628-fd3b5f713f15",
                        "entry_id": "a0508702-0705-31fd-893a-ebbb67a8e67b",
                        "glosses": [
                            "To endow with human qualities."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8a7892da-ba27-3990-9abb-c6fedafa2f4f",
                        "entry_id": "a0508702-0705-31fd-893a-ebbb67a8e67b",
                        "glosses": [
                            "To attribute human-like characteristics to (something that is non-human)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7fe33832-d22a-44b9-beb0-e0871e229e60",
                                "sense_id": "8a7892da-ba27-3990-9abb-c6fedafa2f4f",
                                "text": "Bonnie Lucas further anthropomorphizes the flower in her watercolors, combining it surreally with the human female figure[…]"
                            },
                            {
                                "example_id": "6f564b5b-7842-47ad-bbf9-721fc623ab54",
                                "sense_id": "8a7892da-ba27-3990-9abb-c6fedafa2f4f",
                                "text": "A month away from twenty-six and there you are, in the middle of a Monday afternoon, genuinely engaged in the madcap antics of a slope-headed, claymated man and his anthropomorphized horse."
                            },
                            {
                                "example_id": "1f10c425-a9ea-427b-9e3e-55b7e9eb4fd9",
                                "sense_id": "8a7892da-ba27-3990-9abb-c6fedafa2f4f",
                                "text": "It has been two months since I last checked my feed, during which time Facebook has sent me notifications I didn't sign up for, informing me every time someone posts, and invited me to attend locally organised focus groups. […] Of course, I am anthropomorphising a machine; no one is in charge of all this."
                            },
                            {
                                "example_id": "ee453d52-35f6-4f38-af23-c28a24721ba2",
                                "sense_id": "8a7892da-ba27-3990-9abb-c6fedafa2f4f",
                                "text": "But for some animal-obsessive ceramists, anthropomorphizing as a sculptural approach is a zany (and speedy) joy."
                            },
                            {
                                "example_id": "6bff9020-0232-468e-a1df-44a46144a766",
                                "sense_id": "8a7892da-ba27-3990-9abb-c6fedafa2f4f",
                                "text": "I do think that this perspective offers a useful corrective to the tendency to anthropomorphize large-language models, but there is another aspect to the compression analogy that is worth considering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "919df195-abdd-4ce3-b6f1-fde0085de1d2",
                        "source_entry_id": "a0508702-0705-31fd-893a-ebbb67a8e67b",
                        "source_sense_description": "attribute human qualities",
                        "target_lang_word": "antropomorfiseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antropomorfiseren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "071b0367-2098-36e3-9c86-1e41977474b5",
                                        "entry_id": "cee045a5-8fa6-3e3f-9bae-77b9eb9f3b59",
                                        "glosses": [
                                            "een dier of object als mens behandelen of menselijke eigenschappen toedichten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c813408-72f4-42ff-86ac-6e7edc43138c",
                                                "sense_id": "071b0367-2098-36e3-9c86-1e41977474b5",
                                                "text": "En bovendien ergert men zich aan het antropomorfiseren van niet-menselijke wezens door het gebruik van bovengenoemde werkwoorden."
                                            },
                                            {
                                                "example_id": "884b9e39-e789-4c73-9727-57d73a4bc7d9",
                                                "sense_id": "071b0367-2098-36e3-9c86-1e41977474b5",
                                                "text": "We antropomorfiseren ook als we dingen niet begrijpen. “We schrijven dan menselijke karaktertrekken aan die dingen toe, want dat is wel bekend terrein.”"
                                            },
                                            {
                                                "example_id": "230a140e-6b39-46df-87e9-fc7888bac1a1",
                                                "sense_id": "071b0367-2098-36e3-9c86-1e41977474b5",
                                                "text": "De hele natuur verdient ons respect, maar niet door haar te antropomorfiseren. Dat helpt niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59563464-9882-4825-9259-b78d120434d4",
                        "source_entry_id": "a0508702-0705-31fd-893a-ebbb67a8e67b",
                        "source_sense_description": "attribute human qualities",
                        "target_lang_word": "anthropomorphiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropomorphiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8981ac-d6d8-36ae-8dab-a916858360f0",
                                        "entry_id": "9374aae3-aa03-31e4-9fcd-83f7ef61a8ad",
                                        "glosses": [
                                            "Se représenter ou représenter comme un être humain, ou d’un point de vue purement humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d128cee1-63e1-4829-adc9-23f6b2fcb972",
                                                "sense_id": "1f8981ac-d6d8-36ae-8dab-a916858360f0",
                                                "text": "On fera à Baader le reproche d’anthropomorphiser Dieu."
                                            },
                                            {
                                                "example_id": "d9f7fc1f-3c4f-4e8b-8260-35b326464253",
                                                "sense_id": "1f8981ac-d6d8-36ae-8dab-a916858360f0",
                                                "text": "Dans son désir d’anthropomorphiser les conceptions de sa pensée l’homme voulut donner une figure palpable au dieu qu’il avait enfanté."
                                            },
                                            {
                                                "example_id": "37019d10-7ad3-4a58-886c-a0d5b18149d9",
                                                "sense_id": "1f8981ac-d6d8-36ae-8dab-a916858360f0",
                                                "text": "Les esprits de la nature, les seuls que pouvaient concevoir l’homme du Paléolithique, cessent de dominer l’ensemble du paysage religieux, la religion s’anthropomorphise, elle se modèle à l’image de l’homme, et les premiers dieux émergent, créés à cette image."
                                            },
                                            {
                                                "example_id": "0db8b563-2884-4745-9272-dfe175b1e616",
                                                "sense_id": "1f8981ac-d6d8-36ae-8dab-a916858360f0",
                                                "text": "Le jour où il avait assisté à la générale de Chantecler, la fable burlesque de Rostand peuplée de toute une faune anthropomorphisée, il avait bien vu et entendu que les gens autour de lui le reconnaissaient dans le personnage du Paon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71046d5b-495c-4bf1-8afc-5574ab0ca4c7",
                        "source_entry_id": "a0508702-0705-31fd-893a-ebbb67a8e67b",
                        "source_sense_description": "attribute human qualities",
                        "target_lang_word": "vermenschlichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermenschlichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2caaa00-2b77-31b7-999c-1ae3e8d9a47f",
                                        "entry_id": "41e18a04-d684-348b-921c-a294b4896737",
                                        "glosses": [
                                            "menschliche Eigenschaften auf nichtmenschliche Dinge oder Wesen übertragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac534d0-6236-43f8-a206-a5ea314d4090",
                                                "sense_id": "f2caaa00-2b77-31b7-999c-1ae3e8d9a47f",
                                                "text": "„Ein Problem ist, dass wir dazu neigen, die Katzen zu vermenschlichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b928fe8c-fed8-3f95-a638-b62e89594048",
                                        "entry_id": "41e18a04-d684-348b-921c-a294b4896737",
                                        "glosses": [
                                            "humaner durchführen; so anpassen, dass es den Bedürfnissen und Vorlieben des Menschen besser entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da0d436-3615-4e27-a798-a90f20683fe1",
                                                "sense_id": "b928fe8c-fed8-3f95-a638-b62e89594048",
                                                "text": "Im vergangenen Jahrhundert ist es in den meisten Ländern gelungen, den Strafvollzug zu vermenschlichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6da62535-3fe1-3f5e-812e-daa59f2c7b10",
                                        "entry_id": "41e18a04-d684-348b-921c-a294b4896737",
                                        "glosses": [
                                            "mit Zügen ausstatten, die etwas Hartes/Kompromissloses weicher, nachvollziehbarer und zugänglicher macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07dfc5e4-38a6-4a63-ac07-928e19afba17",
                                                "sense_id": "6da62535-3fe1-3f5e-812e-daa59f2c7b10",
                                                "text": "Ihm ist es zuzuschreiben, dass er das höchste Amt der Kirche vermenschlicht hat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5796ae3-e100-45e5-8fd1-c6d43b27342f",
                        "source_entry_id": "a0508702-0705-31fd-893a-ebbb67a8e67b",
                        "source_sense_description": "attribute human qualities",
                        "target_lang_word": "anthropomorphisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropomorphisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae3e8720-dd53-3a03-8158-c414d934c9e2",
                                        "entry_id": "2b81fd45-48ac-3828-90f4-8f4aa00151de",
                                        "glosses": [
                                            "menschliche Eigenschaften auf nichtmenschliche Dinge oder Wesen übertragen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f75cc453-0243-4414-a0a1-5927701a6374",
                                                "sense_id": "ae3e8720-dd53-3a03-8158-c414d934c9e2",
                                                "text": "„Im Veda tritt es leicht anthropomorphisiert als Agni auf, als Hauspriester der Götter.“"
                                            },
                                            {
                                                "example_id": "e541ecc9-04b0-401b-906b-2c32f2c744b5",
                                                "sense_id": "ae3e8720-dd53-3a03-8158-c414d934c9e2",
                                                "text": "„Man glaube ja nicht, daß wir falsch vermenschlichen - »anthropomorphisieren« -, wir haben sehr gründlich und systematisch gelernt, das nicht zu tun.“"
                                            },
                                            {
                                                "example_id": "7368cfb4-cb78-4561-a382-a0a4a909cf08",
                                                "sense_id": "ae3e8720-dd53-3a03-8158-c414d934c9e2",
                                                "text": "„Wie die Steine so sind auch die Fliegen hier anthropomorphisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
