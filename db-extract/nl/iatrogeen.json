                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iatrogénique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60fc206a-77eb-3ca8-bd54-c6128f7fd7d4",
                                        "entry_id": "d6fdab0b-7d1a-30b9-a1aa-8f07a4420e41",
                                        "glosses": [
                                            "Se dit d’une infection ou affection due à l’intervention d’un médecin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ac446a-6e29-473b-aded-ca4aa159f5d8",
                                                "sense_id": "60fc206a-77eb-3ca8-bd54-c6128f7fd7d4",
                                                "text": "Le mécanisme iatrogénique est le même que celui qui poussait les philanthropes du XIXᵉ siècle à sortir les jeunes des prisons : les comportements déviants sont contagieux, particulièrement pour les déviants."
                                            }
                                        ]
                                    }
                                ]
