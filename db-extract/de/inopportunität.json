                "senses": [
                    {
                        "sense_id": "56960134-1982-3cea-9659-69d475f72019",
                        "entry_id": "6c0049ac-53e3-328a-a921-e9adf5e35ccd",
                        "glosses": [
                            "Eigenschaft/Umstand, gerade jetzt und hier in der Situation ungeeignet, unzweckmäßig (inopportun) zu sein"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1b0fa5ea-72ab-4df8-9403-d952c746b54e",
                                "sense_id": "56960134-1982-3cea-9659-69d475f72019",
                                "text": "„Immerhin hoffen wir, das Ministerium von der Inopportunität überzeugt zu haben, einen Vertreter zur Begrüssung nach Nürnberg oder Kassel zu schicken.“"
                            },
                            {
                                "example_id": "c9ade35e-55f4-4e1a-997f-898e1a34738b",
                                "sense_id": "56960134-1982-3cea-9659-69d475f72019",
                                "text": "„Sie erklärt das angesichts der Thatsache, daß selbst die verbündeten Regierungen sich um die Inopportunität einer Verfassungsänderung gar nicht scheren, sondern beantragen, daß der Artikel 8 der Verfassung geändert werde.“ (1871)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
