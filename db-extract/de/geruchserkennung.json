                "senses": [
                    {
                        "sense_id": "a5470fc0-dcfb-39c3-a020-ff2a43aa4cb4",
                        "entry_id": "acec0bb7-e099-3eec-aa68-7d843ee084bd",
                        "glosses": [
                            "das Erkennen eines Geruches und dessen eindeutige Zuordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a030c1b7-c8f9-483d-8d6f-5ad12ac65b93",
                                "sense_id": "a5470fc0-dcfb-39c3-a020-ff2a43aa4cb4",
                                "text": "„Ein Forschungsprojekt am Institut für Werkstofftechnik der Universität Kassel erforscht die menschliche Geruchserkennung mit Hilfe der Messung von Hirnströmen.“"
                            },
                            {
                                "example_id": "2aa0c1a2-e5bc-4c48-90b0-9b90c5ed0f25",
                                "sense_id": "a5470fc0-dcfb-39c3-a020-ff2a43aa4cb4",
                                "text": "„Die ASC-Sensorautomatik zur Geruchserkennung ist ein vollautomatisches System, das die Lüfterleistung von BEST Dunstabzugshauben selbstständig steuert.“"
                            },
                            {
                                "example_id": "782b9259-3e00-47f1-9d3d-54c3d5e885b9",
                                "sense_id": "a5470fc0-dcfb-39c3-a020-ff2a43aa4cb4",
                                "text": "„Das Risiko einer beeinträchtigten Gedächtnisleistung steige in dem Maße, in dem die Fähigkeit zur Geruchserkennung abnehme, stellten die Forscher vom fest.“"
                            },
                            {
                                "example_id": "d7bcbc4c-ca72-4dc4-90ca-9de2aa9c5935",
                                "sense_id": "a5470fc0-dcfb-39c3-a020-ff2a43aa4cb4",
                                "text": "„Die Aufgaben, die Hunde in der Geruchserkennung für den Menschen übernehmen, sind zahlreich.“"
                            },
                            {
                                "example_id": "8099f6ca-a42c-41b2-b638-3e54349756dc",
                                "sense_id": "a5470fc0-dcfb-39c3-a020-ff2a43aa4cb4",
                                "text": "„In Übereinstimmung mit Dr. Lavidis, stehen die Stress abbauenden Effekte bestimmter Gerüche, wie z.B. von frisch gemähtem Gras, nicht in Beziehung zur Geruchserkennung und der Erinnerung, die damit verbunden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
