                "translations": [
                    {
                        "translation_id": "8e476647-fe0a-47f0-b9ba-cc85b2477480",
                        "source_entry_id": "21138a45-906d-3987-a950-2678e427ede4",
                        "source_sense_id": "9c4213a6-5b3d-3e30-8ae1-e1e0942c270d",
                        "target_lang_word": "chutzpah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chutzpah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d97416-56e4-30de-a500-72fee811eead",
                                        "entry_id": "ade870a0-9cae-3758-8b22-6b8e17a3bcbd",
                                        "glosses": [
                                            "Nearly arrogant courage; utter audacity, effrontery or impudence; supreme self-confidence; exaggerated self-opinion."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8cd5663-d7ac-481d-af97-d0bf4b68de62",
                                                "sense_id": "e3d97416-56e4-30de-a500-72fee811eead",
                                                "text": "If the service is rotten and the meal a disaster, we should withhold a tip and explain why we are doing so. Few of us have the chutzpah to do this."
                                            },
                                            {
                                                "example_id": "b645ddf4-324d-4b4f-a450-2d0662721eb8",
                                                "sense_id": "e3d97416-56e4-30de-a500-72fee811eead",
                                                "text": "But seriously, the ability to just come out and put on a placard that the Jurassic era is temporally contiguous with the Fifth Dynasty of the Old Kingdom of Egypt — well, there’s a word for that, and that word is chutzpah."
                                            },
                                            {
                                                "example_id": "c36fabfe-89d4-4f32-9ebb-bdc872418dee",
                                                "sense_id": "e3d97416-56e4-30de-a500-72fee811eead",
                                                "text": "Okay, okay, okay… First of all, “shutspah” is actually pronounced “khootspah”. But, but-but-but the idea, the idea that daily fantasy sites are using this law to claim they’re not gambling is not chutzpah, it’s khorseshit!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dc10a78-252c-4cf8-b213-048d6b91e45b",
                        "source_entry_id": "21138a45-906d-3987-a950-2678e427ede4",
                        "source_sense_id": "9c4213a6-5b3d-3e30-8ae1-e1e0942c270d",
