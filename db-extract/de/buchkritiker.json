                "senses": [
                    {
                        "sense_id": "83c9baf0-fa12-3e65-bbb5-5ab2b34dc369",
                        "entry_id": "1a0408d5-49b9-356d-98f7-38996ae1e9b9",
                        "glosses": [
                            "Person, welche Druckwerke von mehr als 49 Seiten nach ihrer (inhaltlichen) Qualität beurteilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f077f239-95f1-4610-80a6-b31bc03ffbc4",
                                "sense_id": "83c9baf0-fa12-3e65-bbb5-5ab2b34dc369",
                                "text": "„Hubert Winkels, Buchkritiker und Juror in Leipzig, gewährt Einblicke in die Arbeit der Jury.“"
                            },
                            {
                                "example_id": "745fe36f-d63e-4070-8328-5414cba00645",
                                "sense_id": "83c9baf0-fa12-3e65-bbb5-5ab2b34dc369",
                                "text": "„Kleine Buchkritiker empfehlen Bücher zu Weihnachten“"
                            },
                            {
                                "example_id": "fca8df7f-be39-45ac-8bef-dffcaeec75f5",
                                "sense_id": "83c9baf0-fa12-3e65-bbb5-5ab2b34dc369",
                                "text": "„Langjähriger Sat.1-Buchkritiker Peter Hetzel ist tot“"
                            },
                            {
                                "example_id": "58dc8ea1-6941-4695-8f6e-f6311c4101ca",
                                "sense_id": "83c9baf0-fa12-3e65-bbb5-5ab2b34dc369",
                                "text": "„Während sich viele \"Selfish\"-Leser ihre Mäuler über das Buch zerreißen, kann sich Kardashian über die Anerkennung vieler Buchkritiker aber auch freuen.“"
                            },
                            {
                                "example_id": "f2a4ad0c-9854-41c2-9a23-2bf29c9befc0",
                                "sense_id": "83c9baf0-fa12-3e65-bbb5-5ab2b34dc369",
                                "text": "\"Buchkritiker Denis Scheck empört sich über die Verlage Oetinger und Thienemann, die Worte wie \"Neger\" aus Kinderbüchern tilgen wollen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
