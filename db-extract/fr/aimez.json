                        "entry_id": "7e2af9b8-55d2-313e-9055-72f955c4ae3d",
                        "glosses": [
                            "Deuxième personne du pluriel de l’indicatif présent du verbe aimer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ad2c9990-390d-4095-b1b4-037c4cb28b7d",
                                "sense_id": "73444f6b-6856-34b7-ba89-6b2e5e6c1581",
                                "text": "Si vous aimez les sortilèges, venez par un beau clair de lune d’une nuit de mai évoquer la nixe de Vaucluse, et peut-être à votre appel la verrez-vous sortir de cet abîme de cristal qui lui sert de palais."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3ff2f03-5f00-3682-91c3-0c43fbc31b7f",
                        "entry_id": "7e2af9b8-55d2-313e-9055-72f955c4ae3d",
                        "glosses": [
                            "Deuxième personne du pluriel de l’impératif du verbe aimer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "815b0009-5bb4-47e8-bb20-a1ab71288c16",
                                "sense_id": "d3ff2f03-5f00-3682-91c3-0c43fbc31b7f",
                                "text": "Aimez-le donc, ma chère, disait tout bas la Vulpato à la duchesse en la rencontrant dans l’escalier à la sortie."
                            }
                        ]
                    }
                ],
