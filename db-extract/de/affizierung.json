                "senses": [
                    {
                        "sense_id": "d1bf7f57-d5cb-3a20-ae27-e2664ef04345",
                        "entry_id": "aafe770f-828c-3018-9558-19be9de3fd7d",
                        "glosses": [
                            "das Einwirken, Beeinflussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd43526c-1eb5-4bca-9d52-52253310ac46",
                                "sense_id": "d1bf7f57-d5cb-3a20-ae27-e2664ef04345",
                                "text": "„Die Affizierung durch Neigungen wird deswegen in der Unendlichkeit ausgeschlossen, weil die Vernunftordnung all das abwirft, was das Naturgesetz diktiert.“"
                            },
                            {
                                "example_id": "60f467bd-ed25-4207-92cc-d6f954ae0925",
                                "sense_id": "d1bf7f57-d5cb-3a20-ae27-e2664ef04345",
                                "text": "„Wer sich langweilt, hat die Affizierung der Sinne weitgehend an andere delegiert.“"
                            },
                            {
                                "example_id": "94407a93-3431-4345-906b-c9db6c2db906",
                                "sense_id": "d1bf7f57-d5cb-3a20-ae27-e2664ef04345",
                                "text": "„Grundsätzlich geht es um eine Benennung nach der Technik der Affizierung, also um eine technologische Benennung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9824645c-c080-4ce3-9c14-421a9e6978fc",
