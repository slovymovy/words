    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                    "sense_definition": "Presser fermement contre soi, dans sa main ou comprimer étroitement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de commencer la réunion, le directeur avance pour lui <w>serrer</w> la main chaleureusement."
                        },
                        {
                            "text": "La mère éperdue <w>serre</w> tendrement son enfant dans ses bras pour le consoler après sa chute."
                        }
                    ],
                    "antonyms": [
                        "desserrer",
                        "lâcher"
                    ],
                    "common_phrases": [
                        "serrer la main",
                        "serrer dans ses bras"
                    ]
                },
                {
                    "sense_id": "f3e63376-86a0-35df-99b3-d05c46760bde",
                    "sense_definition": "Rendre plus tendu ou bloquer fermement un lien, une vis ou un nœud.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à bien <w>serrer</w> la vis pour que la table ne bouge plus du tout."
                        },
                        {
                            "text": "Il tire fort sur les deux lacets afin de <w>serrer</w> le nœud de ses chaussures de course."
                        }
                    ],
                    "antonyms": [
                        "desserrer",
                        "dévisser"
                    ],
                    "common_phrases": [
                        "serrer la vis",
                        "serrer un nœud"
                    ]
                },
                {
                    "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                    "sense_definition": "Rapprocher étroitement des personnes ou des éléments les uns contre les autres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rapprochement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le métro bondé du matin, les passagers doivent se <w>serrer</w> pour laisser entrer d'autres personnes."
                        },
                        {
                            "text": "Le photographe demande aux invités de se <w>serrer</w> un peu pour tenir tous sur la photo."
                        }
                    ],
                    "antonyms": [
                        "écarter",
                        "espacer"
                    ],
                    "common_phrases": [
                        "serrer les rangs",
                        "se serrer les coudes"
                    ]
                },
                {
                    "sense_id": "26bba3b9-3a0d-31f7-b46f-117927a49378",
                    "sense_definition": "Produire une sensation d'oppression douloureuse ou d'émotion vive dans la poitrine ou la gorge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette triste nouvelle lui <w>serre</w> le cœur depuis qu'il l'a apprise ce matin."
                        },
                        {
                            "text": "Une vive angoisse lui <w>serrait</w> la gorge au moment de monter sur la scène du théâtre."
                        }
                    ],
                    "antonyms": [
                        "soulager"
                    ],
                    "common_phrases": [
                        "serrer le cœur",
                        "serrer la gorge"
                    ]
                },
                {
                    "sense_id": "68d2f8ef-2378-3f6b-9dd5-85dcc0191ae1",
                    "sense_definition": "Interpeller ou capturer quelqu'un, en parlant des forces de police.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont réussi à <w>serrer</w> le suspect juste après son infraction dans le quartier."
                        },
                        {
                            "text": "Le voleur s'est fait <w>serrer</w> en flagrant délit à la sortie de la bijouterie hier soir."
                        }
                    ],
                    "synonyms": [
                        "appréhender",
                        "arrêter"
                    ],
                    "antonyms": [
                        "relâcher"
                    ],
                    "common_phrases": [
                        "se faire serrer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot policier ou familier"
                        }
                    ]
                },
                {
                    "sense_id": "182ace9f-d6e8-32cb-bcc8-2a6c0e234f27",
                    "sense_definition": "Séduire une personne et entamer une relation amoureuse ou intime avec elle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe toutes ses soirées en boîte à essayer de <w>serrer</w> une fille sans grand succès."
                        },
                        {
                            "text": "Son ami prétend avoir <w>serré</w> la nouvelle voisine dès le premier soir de fête."
                        }
                    ],
                    "synonyms": [
                        "emballer",
                        "pécho",
                        "séduire"
                    ],
                    "common_phrases": [
                        "serrer une fille"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot jeune"
                        }
                    ]
                },
                {
                    "sense_id": "2593ba78-478e-358a-922f-14dcb3e9313e",
                    "sense_definition": "Perdre son calme, son sang-froid ou craquer sous la pression nerveuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enervement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec toute cette pression au travail et ce manque de repos, il va bientôt <w>serrer</w>."
                        },
                        {
                            "text": "Après des heures bloqué dans les embouteillages d'été, le conducteur a fini par <w>serrer</w> complètement."
                        }
                    ],
                    "synonyms": [
                        "craquer",
                        "péter"
                    ],
                    "common_phrases": [
                        "finir par serrer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "familier ou argot"
                        }
                    ]
                },
                {
                    "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                    "sense_definition": "Mettre quelque chose à l'abri ou en sécurité dans un meuble ou un rangement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ranger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grand-mère préférait toujours <w>serrer</w> ses bijoux précieux au fond d'un vieux tiroir fermé à clé."
                        },
                        {
                            "text": "Avant de partir en voyage, elle <w>serrait</w> soigneusement son linge propre dans la grande armoire normande."
                        }
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
