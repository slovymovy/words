                ],
                "senses": [
                    {
                        "sense_id": "b344f648-4528-380b-9cab-33c1d75b5bc3",
                        "entry_id": "524abb00-b536-35c2-9d02-950a8a5338a5",
                        "glosses": [
                            "vielfaches, vielfältiges Vorhandensein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38c8313-11a0-4466-8d12-fede373b8350",
                                "sense_id": "b344f648-4528-380b-9cab-33c1d75b5bc3",
                                "text": "Den Buddhismus zeichnet die Akzeptanz der Pluralität von Glaubensrichtungen aus."
                            },
                            {
                                "example_id": "b5104684-a8ab-4798-9643-278621ec40b4",
                                "sense_id": "b344f648-4528-380b-9cab-33c1d75b5bc3",
                                "text": "„Fontenelles Unterhaltungen über die Pluralität der Welten handeln daher nicht allein von der kosmologischen Spekulation über eine Vielzahl von Sonnensystemen, sondern sie bereiten auch die Einsicht in die Mehrzahl der von Menschen.“"
                            },
                            {
                                "example_id": "7e95ecf0-16b7-416f-9172-10652ae41573",
                                "sense_id": "b344f648-4528-380b-9cab-33c1d75b5bc3",
                                "text": "„Tatsächlich hat die AfD mit gesellschaftlicher Pluralität ein großes Problem, Pluralität und völkisches Denken schließen einander nämlich aus.“"
                            },
                            {
                                "example_id": "1994246d-bc28-4fe9-808c-edc980fd3a44",
                                "sense_id": "b344f648-4528-380b-9cab-33c1d75b5bc3",
                                "text": "„Aufgrund dieser Pluralität entwickelt sich hier eine Sprachrealität nicht aus offiziell getroffenen Sprachregelungen, sondern aus dem politischen Meinungsaustausch, aus dem Kampf um das Besetzen von Begriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
