                        "form": "frazzled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66040488-a08a-366e-a683-f3520dd51226",
                        "entry_id": "339fb1f8-2524-32a9-b2a9-7ac29291da62",
                        "glosses": [
                            "To fray or wear down, especially at the edges."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "65201234-8d1a-4621-b7d0-44fcebe65788",
                                "sense_id": "66040488-a08a-366e-a683-f3520dd51226",
                                "text": "The new puppy has been chewing on everything, and my favorite afghan has become frazzled."
                            },
                            {
                                "example_id": "21213249-f721-43f6-b536-ac224a394d75",
                                "sense_id": "66040488-a08a-366e-a683-f3520dd51226",
                                "text": "Frazle, to unravel or rend cloth. Frazlings, threads of cloth, torn or unravelled."
                            },
                            {
                                "example_id": "9c5ae3eb-59ec-48eb-938b-140e29ade3a7",
                                "sense_id": "66040488-a08a-366e-a683-f3520dd51226",
                                "text": "One’s garments get frazzled in the grass; one’s mind and body and spiritual sense sometimes become frazzled, torn to pieces, good-for-nothing."
                            },
                            {
                                "example_id": "ed40f989-26be-4b03-a409-51e5b566e3f5",
                                "sense_id": "66040488-a08a-366e-a683-f3520dd51226",
                                "text": "Her hair was of a reddish-gray color, and its frazzled and tangled condition suggested that the woman had recently passed through a period of extreme excitement."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c41d4ae-ff93-36c0-a967-4c861c1c70ca",
                        "entry_id": "339fb1f8-2524-32a9-b2a9-7ac29291da62",
                        "glosses": [
                            "To drain emotionally or physically."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "85b1841e-23ab-4472-988c-409917213d22",
                                "sense_id": "8c41d4ae-ff93-36c0-a967-4c861c1c70ca",
                                "text": "After dealing with the children all day, I just can’t help feeling frazzled."
                            },
                            {
                                "example_id": "579ea4a2-85ef-4e09-91ee-76ff197adba9",
                                "sense_id": "8c41d4ae-ff93-36c0-a967-4c861c1c70ca",
                                "text": "One’s garments get frazzled in the grass; one’s mind and body and spiritual sense sometimes become frazzled, torn to pieces, good-for-nothing."
                            }
                        ]
                    }
