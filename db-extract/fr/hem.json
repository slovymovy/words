                        "entry_id": "06a31a18-9d78-3085-b95c-988a4ddb1ca6",
                        "glosses": [
                            "Dont on se sert pour attirer l’attention, pour appeler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9342ca7-322c-4f56-b39f-dbfb85fc65bf",
                                "sense_id": "f6c659e6-6c66-39af-b1b1-60bfd1c3ed15",
                                "text": "Hem, hem, venez ici."
                            },
                            {
                                "example_id": "cf2ba488-053b-408d-8920-60158bb17f8c",
                                "sense_id": "f6c659e6-6c66-39af-b1b1-60bfd1c3ed15",
                                "text": "Un léger hem ! hem ! de la fée les tira de leur sommeil ; le prince fut le premier à ouvrir les yeux : il se jeta aux genoux de la fée et lui adressa des remerciements tellement vifs qu’elle en fut attendrie."
                            }
                        ]
                    },
                    {
                        "sense_id": "19eef3fe-3fbb-31ba-94fb-4567ef179a23",
                        "entry_id": "06a31a18-9d78-3085-b95c-988a4ddb1ca6",
                        "glosses": [
                            "Exprime aussi le doute, l’hésitation, la défiance."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
