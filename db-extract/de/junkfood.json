                        "sense_id": "b29f3cec-9860-3541-a7b4-a72ca2b74d94",
                        "entry_id": "bac8928b-424e-36f1-8e2d-373a33cf84bd",
                        "glosses": [
                            "minderwertige, ungesunde, besonders kalorienhaltige Nahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c75a1d8a-4781-4cac-b7ef-6008654752e2",
                                "sense_id": "b29f3cec-9860-3541-a7b4-a72ca2b74d94",
                                "text": "Wer nur Junkfood isst und sich nicht bewegt, braucht sich über sein Übergewicht nicht zu wundern."
                            },
                            {
                                "example_id": "80d24e1c-6198-4791-8034-66d9d931b451",
                                "sense_id": "b29f3cec-9860-3541-a7b4-a72ca2b74d94",
                                "text": "„Sie essen Junkfood und zu viel raffinierten Zucker und betäuben sich mit Alkohol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
