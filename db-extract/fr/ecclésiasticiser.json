                "senses": [
                    {
                        "sense_id": "5e006d42-13bd-35a7-94f5-12f84d749608",
                        "entry_id": "7bc7c924-27f2-3d7a-8c55-cde81bc857cf",
                        "glosses": [
                            "Rendre ecclésiastique."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b98f11a6-3f63-4abe-baa3-93713af8a10a",
                                "sense_id": "5e006d42-13bd-35a7-94f5-12f84d749608",
                                "text": "Pour Gogarten, l’espérance est que l’autonomie ne se détache pas de Dieu, que la sécularisation ne dégénère pas en coupant ses racines chrétiennes; mais en même temps, que l’Église renonce à christianiser ou à ecclésiasticiser le monde, qu’elle devienne une Église de l’intériorité qui vit de la parole, […]."
                            },
                            {
                                "example_id": "b387b759-9d32-4d72-ad9a-23f22e8fb5eb",
                                "sense_id": "5e006d42-13bd-35a7-94f5-12f84d749608",
                                "text": "Une Église qui veut « ecclésiasticiser » le monde se mondanise."
                            }
                        ]
                    }
                ],
