                        "glosses": [
                            "The quality of being pacific; peacefulness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bee97a17-3dea-407b-8b77-9bb21338a616",
                                "sense_id": "707942bb-5165-302a-ad14-6f8c0c800b5b",
                                "text": "One of the quintessential values of the indigenous Ewe society is pacificity."
                            },
                            {
                                "example_id": "006d3a32-6e11-4b94-a33d-243f55084b94",
                                "sense_id": "707942bb-5165-302a-ad14-6f8c0c800b5b",
                                "text": "In addition, in FPHWP, I proposed “the multifaceted theory of war and peace” to understand war and peace, in a small sense—or aggression and pacificity, in a broad sense."
                            },
                            {
                                "example_id": "22c87083-4aa3-47d4-82c6-806d2629a59c",
                                "sense_id": "707942bb-5165-302a-ad14-6f8c0c800b5b",
                                "text": "In the Alto Xingu, there is strong moral emphasis on respect for others, on self-control, and on pacificity."
                            },
                            {
                                "example_id": "e13c8afc-174a-40e4-b623-28d9f411cc33",
                                "sense_id": "707942bb-5165-302a-ad14-6f8c0c800b5b",
                                "text": "Hume's pacificity and neutrality contrast with Gibbon's combative attitude and his interest in subjective, personalized experience."
                            }
                        ]
                    }
