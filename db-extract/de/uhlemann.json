                ],
                "senses": [
                    {
                        "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                        "entry_id": "58e852fc-8c74-3dac-86bb-217687574a9c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53fb9aa9-e627-43e2-ad8c-f644424312b1",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Frau Uhlemann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2412f1a3-a5ac-41ef-8868-b6669f9ed634",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Herr Uhlemann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ebcc2c8d-bdab-4a52-9bdd-3d5db3af2695",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Die Uhlemanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4809f3d8-a00c-4617-9e25-11062ac66455",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Der Uhlemann trägt nie die Schals, die die Uhlemann ihm strickt."
                            },
                            {
                                "example_id": "e8c71d23-a0e4-498b-9c15-45f9769377e5",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Uhlemann kommt, geht der Herr Uhlemann.“"
                            },
                            {
                                "example_id": "893a55ff-d2ea-493f-8df4-d40793f941fe",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Uhlemann kommt und geht."
                            },
                            {
                                "example_id": "fc1c13db-3670-469d-808f-9bcb218b7e39",
                                "sense_id": "ff94bd7b-bcbb-36d1-8f9f-f8bfa9f463ce",
                                "text": "Uhlemanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
