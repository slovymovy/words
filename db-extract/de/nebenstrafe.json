                "senses": [
                    {
                        "sense_id": "1641141f-e18d-338d-bf9c-ff1e3968a0a2",
                        "entry_id": "da12d6de-08e6-3512-a12f-ab54ce6e9fb2",
                        "glosses": [
                            "begleitende unangenehme Konsequenz einer Verurteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81af5a6-91db-4b32-b39f-0e39468a4ab3",
                                "sense_id": "1641141f-e18d-338d-bf9c-ff1e3968a0a2",
                                "text": "„Beim Amtsverlust nach § 27 Abs 1 StGB handelt es sich nicht um eine Nebenstrafe, die von den Gerichten ausgesprochen werden kann, sondern um eine gesetzliche Rechtsfolge der Verurteilung, die im Urteil nicht eigens auszusprechen ist.“"
                            },
                            {
                                "example_id": "23e6bbe6-c483-4066-bc2d-61ee1ff07ea5",
                                "sense_id": "1641141f-e18d-338d-bf9c-ff1e3968a0a2",
                                "text": "„Bislang kann das Verbot nur als Nebenstrafe und auch nur im Zusammenhang mit einer Verkehrssünde erteilt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
