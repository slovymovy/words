                        "glosses": [
                            "A kind of Russian croquette wrapped in bacon before deep-frying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d804425-f9fe-4b7f-a5e7-b452531c5f3f",
                                "sense_id": "b64d1509-2ef0-3e8d-9a01-4ece3ec40958",
                                "text": "The Engineer Lieutenant pushed his head inside his neighbour's cabin: “Come along—come along! You'll be late for dinner. Fresh grub to-night: no more ‘Russian Kromeskis’ and ‘Fanny Adams’!”"
                            },
                            {
                                "example_id": "1158c004-f266-4029-8ea4-14c6c4863482",
                                "sense_id": "b64d1509-2ef0-3e8d-9a01-4ece3ec40958",
                                "text": "I suspect Queen Marie would not have found my school catering very regal. Our kromeskies were made from leftover minced meat, wrapped in bacon and fried in batter."
                            }
                        ]
                    }
