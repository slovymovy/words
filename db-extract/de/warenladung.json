                "senses": [
                    {
                        "sense_id": "d095ce27-e979-33c9-b561-f0f984351808",
                        "entry_id": "f7694541-2f32-39c6-a658-21089e9996dd",
                        "glosses": [
                            "Gesamtheit der Waren, die jemand in einem Transportfahrzeug mit sich führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493600fc-2a04-4801-ad9b-803efd13e6e3",
                                "sense_id": "d095ce27-e979-33c9-b561-f0f984351808",
                                "text": "„Wir führten eine beachtliche Warenladung mit, weshalb wir dort Aufsehen erregten und achtungsvoll empfangen wurden.“"
                            },
                            {
                                "example_id": "b099e147-cabb-4244-a3a8-faf62e8d038a",
                                "sense_id": "d095ce27-e979-33c9-b561-f0f984351808",
                                "text": "„Auf Rheinschiffen an Köln vorbeischippernde Warenladungen konnten im Mittelalter auf Wunsch des städtischen Zolls \"gestapelt\" werden.“"
                            },
                            {
                                "example_id": "80c67e7c-bbe8-4c5b-bb1e-bb769894fe61",
                                "sense_id": "d095ce27-e979-33c9-b561-f0f984351808",
                                "text": "„Es handelt sich um ein so genanntes „Durchhaus“ nach Leipziger Vorbild, mit zwei Höfen und Durchfahrt für Warenladungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
