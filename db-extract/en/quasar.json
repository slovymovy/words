                        "translation_id": "125a60b9-aad8-4cee-a32c-95c762e46e80",
                        "source_entry_id": "bc25dbd1-aa8d-3589-a9c7-fac43df6a082",
                        "source_sense_id": "41f012fc-08e8-3df6-b9dc-54f5b2d2461a",
