    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "72534844-d595-34f2-ba80-5f213f61a259",
                "word": "coverlet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "752985ac-0e08-4e1f-a546-afd776e34942",
                        "entry_id": "72534844-d595-34f2-ba80-5f213f61a259",
                        "tags": [
                            "plural"
                        ],
                        "form": "coverlets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c130b5ee-9cb9-3059-a8a7-9948d35e897f",
                        "entry_id": "72534844-d595-34f2-ba80-5f213f61a259",
                        "glosses": [
                            "A blanket used as a bed covering, usually quilted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc94325-e878-4564-998f-d03977eaa31f",
                                "sense_id": "c130b5ee-9cb9-3059-a8a7-9948d35e897f",
                                "text": "Near-synonyms: bedspread, bedcover, counterpane"
                            },
                            {
                                "example_id": "21a4fa85-cc97-4d83-bc43-eaafd86fa5ff",
                                "sense_id": "c130b5ee-9cb9-3059-a8a7-9948d35e897f",
                                "text": "Year after year unto her feet,\n She lying on her couch alone,\n Across the purpled coverlet,\n The maiden's jet-black hair has grown, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dc0ecec-0fff-4c9c-ad47-545bbc448803",
                        "source_entry_id": "72534844-d595-34f2-ba80-5f213f61a259",
                        "source_sense_id": "c130b5ee-9cb9-3059-a8a7-9948d35e897f",
                        "source_sense_description": "blanket used as a bed covering",
                        "target_lang_word": "couvre-lit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couvre-lit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ce2774-2262-32a2-8783-3af16ab7a6bb",
                                        "entry_id": "1ed494c9-7e9f-35ec-a4ee-a49dd9ca5093",
                                        "glosses": [
                                            "Pièce d’étoffe, de broderie, etc., dont on recouvre un lit."
                                        ],
                                        "tags": [
                                            "Chambre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13269015-0f81-448e-b511-42a0f22ceb66",
                                                "sense_id": "e0ce2774-2262-32a2-8783-3af16ab7a6bb",
                                                "text": "Dans la chambre, les rideaux étaient tirés, ils étaient en satin bleu, à fleurs bleues, le large lit-divan avait un couvre-lit de ce même satin bleu, et le tapis par terre était bleu, lui aussi…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6bca6c9-5fc5-43f1-9a09-407b2de7699d",
                        "source_entry_id": "72534844-d595-34f2-ba80-5f213f61a259",
                        "source_sense_id": "c130b5ee-9cb9-3059-a8a7-9948d35e897f",
                        "source_sense_description": "blanket used as a bed covering",
                        "target_lang_word": "Tagesdecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tagesdecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55f2616b-9236-320a-8684-9d2fa7312f97",
                                        "entry_id": "21fe0f67-6a89-3301-b5cf-d3291d7c0669",
                                        "glosses": [
                                            "dünne Decke, mit der das Bett tagsüber abgedeckt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc86d971-a89e-4dd2-84da-b30a1b538472",
                                                "sense_id": "55f2616b-9236-320a-8684-9d2fa7312f97",
                                                "text": "Tagesdecken sind nicht zu empfehlen, da sich Hausstaubmilben darunter besonders wohl fühlen."
                                            },
                                            {
                                                "example_id": "2e7be933-ac77-4e8a-84a9-0e7a560d62bd",
                                                "sense_id": "55f2616b-9236-320a-8684-9d2fa7312f97",
                                                "text": "„Über der dicken Tagesdecke leuchtet ihr Gesicht wie das eines Kindes.“"
                                            },
                                            {
                                                "example_id": "c367243d-3db6-4cbb-a70e-3a5bd0b2cf14",
                                                "sense_id": "55f2616b-9236-320a-8684-9d2fa7312f97",
                                                "text": "„Inzwischen ist auch Dietrich eingetroffen, mit angelaufenen Brillengläsern, Poposcheitel und so stark pomadisiertem Haar, dass ich um meine Tagesdecke fürchte.“"
                                            },
                                            {
                                                "example_id": "1fd5580e-2d75-4aed-a3e6-01e370396a49",
                                                "sense_id": "55f2616b-9236-320a-8684-9d2fa7312f97",
                                                "text": "„Sie schlägt die Tagesdecke zurück und streckt sich auf dem Bett aus, um das Home Shopping Network zu verfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a288aa9f-53ed-4b26-87a8-4dbbc26d18dd",
                        "source_entry_id": "72534844-d595-34f2-ba80-5f213f61a259",
                        "source_sense_id": "c130b5ee-9cb9-3059-a8a7-9948d35e897f",
                        "source_sense_description": "blanket used as a bed covering",
                        "target_lang_word": "покрыва́ло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "покрыва́ло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f1862b38-6725-315c-be53-d2223b33043c",
                                        "entry_id": "610923b5-fbef-3d29-9262-0686c0d21b66",
                                        "glosses": [
                                            "кусок ткани, предназначенный для покрывания чего-либо, покрывающий что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aeff73c-ab26-4517-ae30-daf0f6ff2747",
                                                "sense_id": "f1862b38-6725-315c-be53-d2223b33043c",
                                                "text": "Намитка — белое покрывало из жидкого полотна, носимое на голове женщинами, с откинутыми назад концами."
                                            },
                                            {
                                                "example_id": "e3d2d82a-f04b-49ad-9440-6391f53d4d38",
                                                "sense_id": "f1862b38-6725-315c-be53-d2223b33043c",
                                                "text": "Мудрый человек явился на чёрном коне и был при свете факелов приведён к тому месту, где положили покойника, завернув его в большое покрывало."
                                            },
                                            {
                                                "example_id": "4c7aa85c-c7a0-4036-ae77-0601c028117a",
                                                "sense_id": "f1862b38-6725-315c-be53-d2223b33043c",
                                                "text": "Помню, как будто видел это вчера, сани его, запряжённые парою красивых коней и светлой белизны покрывало, которым был обтянут передок саней."
                                            },
                                            {
                                                "example_id": "cd069db6-c0c8-4196-b472-886d3b84b71b",
                                                "sense_id": "f1862b38-6725-315c-be53-d2223b33043c",
                                                "text": "Трактирный служитель снял покрывало с небольшого стола, на который вначале никто не обратил внимания, и подставил стул."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ad9545-e1f2-3227-b9ad-38dc45e714f9",
                                        "entry_id": "610923b5-fbef-3d29-9262-0686c0d21b66",
                                        "glosses": [
                                            "лёгкое одеяло, обычно служащее для покрывания постели днём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8225952-d90f-4e48-9d2d-9deae445f9f8",
                                                "sense_id": "c7ad9545-e1f2-3227-b9ad-38dc45e714f9",
                                                "text": "Он неумело сдёрнул пикейное покрывало с одной постели, обнажив красивое плюшевое одеяло — белое с зелёными ёлками и оленями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639fc53b-6835-3aff-ac38-855d95723526",
                                        "entry_id": "610923b5-fbef-3d29-9262-0686c0d21b66",
                                        "glosses": [
                                            "женская одежда в виде накидки, покрывающая фигуру с головы до ног"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55f65a6-c32a-4eaf-854d-0a651ee7767b",
                                                "sense_id": "639fc53b-6835-3aff-ac38-855d95723526",
                                                "text": "Подле этого простого памятника, спиною ко мне, стояла на коленях, по-видимому, молодая девушка, в белом платье с распущенными по плечам волосами; у ног её лежало голубое покрывало."
                                            },
                                            {
                                                "example_id": "40e6986c-da10-4cfe-87df-8124afc06ceb",
                                                "sense_id": "639fc53b-6835-3aff-ac38-855d95723526",
                                                "text": "Молча Зара вышла; он долго следовал за нею взором и мечтою; луна озаряла её длинное покрывало, которое как белый туман обвивалось вокруг её гибкого стана; она как призрак неслышно скользила по траве… вот скрылась вдали за палаткой, вот мелькнула и снова скрылась… прощай, Зара!"
                                            },
                                            {
                                                "example_id": "b2cebf88-3ff0-4776-a399-bc363b7d83de",
                                                "sense_id": "639fc53b-6835-3aff-ac38-855d95723526",
                                                "text": "Один юноша, завернувшись по нагому телу в покрывало, следовал за Ним; и воины схватили его. Но он, оставив покрывало, нагой убежал от них."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6d277d-adb0-35be-ab79-ad91e1aeb784",
                                        "entry_id": "610923b5-fbef-3d29-9262-0686c0d21b66",
                                        "glosses": [
                                            "то, что покрывает, окутывает что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393246bc-f02f-41f4-b6de-8b4d9a143afc",
                                                "sense_id": "ec6d277d-adb0-35be-ab79-ad91e1aeb784",
                                                "text": "Кора на стволе есть внешнее покрывало, отличающееся трухавым своим веществом, содержащимся между лубом и берестою."
                                            },
                                            {
                                                "example_id": "60f86184-f273-4d96-b983-a773fafc4bcc",
                                                "sense_id": "ec6d277d-adb0-35be-ab79-ad91e1aeb784",
                                                "text": "Чичиков только заметил сквозь густое покрывало лившего дождя что-то похожее на крышу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "покрыва́ло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8e8ff82c-1dde-3dd3-94b2-d921f4046649",
                                        "entry_id": "b21d4b27-2766-3fb0-bd55-69af772d101c",
                                        "glosses": [
                                            "форма прошедшего времени среднего рода третьего лица единственного числа изъявительного наклонения глагола покрывать"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
