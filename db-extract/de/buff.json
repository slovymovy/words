                                                "sense_id": "2ef3e313-50ce-3579-8e87-0d57fbfb0f79",
                                                "text": "[…]; but is in a ſuite of buffe […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5723cfc-c328-3de0-8568-f0157ed04a9f",
