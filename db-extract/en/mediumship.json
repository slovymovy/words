                        "entry_id": "3d4f64a2-d1fe-35b9-8280-eac3213eca91",
                        "glosses": [
                            "The state of being a medium (psychic conduit); purported ability to mediate communication between spirits of the dead and living human beings."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "58eb5468-50ac-4606-9163-be6c0697d192",
                                "sense_id": "bb46db99-5dc9-3c40-a770-9f978bf10f64",
                                "text": "The mother is a spiritualist—has been for years—and, being on the lookout for it, naturally discovered what she calls 'mediumship' in Viola when a child."
                            },
                            {
                                "example_id": "15009bf1-eb63-4d14-97ee-12bd1b261863",
                                "sense_id": "bb46db99-5dc9-3c40-a770-9f978bf10f64",
                                "text": "\"I may add that in my own domestic circle, under my wife's mediumship, we have been privileged to bring hope and knowledge to some of these unhappy beings.\""
                            },
                            {
                                "example_id": "95bd0e7e-c1fe-41a9-bbb3-d0caca28f50c",
                                "sense_id": "bb46db99-5dc9-3c40-a770-9f978bf10f64",
                                "text": "But for myself I do not regard mediumship very favourably."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "897f266a-16eb-430e-a394-2e4d8116047e",
                        "source_entry_id": "3d4f64a2-d1fe-35b9-8280-eac3213eca91",
                        "source_sense_id": "bb46db99-5dc9-3c40-a770-9f978bf10f64",
                        "source_sense_description": "ability to mediate communication between spirits",
                        "target_lang_word": "médiumnité",
