                        "sense_id": "f548c88d-6808-382f-843d-10416b195ff1",
                        "entry_id": "2f9f14de-2d43-3a28-991a-d85569743ecd",
                        "glosses": [
                            "Deceitful, with hidden malice."
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7fdca4f3-ff97-41c3-8000-0a8ce98c1a6b",
                                "sense_id": "f548c88d-6808-382f-843d-10416b195ff1",
                                "text": "That having been obtained, everything should be restored to the former position, and the dolose party be condemned."
                            },
                            {
                                "example_id": "9c469b3d-c222-4579-96bf-301734b77797",
                                "sense_id": "f548c88d-6808-382f-843d-10416b195ff1",
                                "text": "Several texts tell us, however, that when the owner was a minor, there is a remedy against the dolose slave."
                            },
                            {
                                "example_id": "f6527cbd-6bad-479f-9208-75d87b6e8528",
                                "sense_id": "f548c88d-6808-382f-843d-10416b195ff1",
                                "text": "A dolose act was an act committed with a view to causing damage. […] a dolose act will by construction always be culpable; on the other hand, a culpable act might either be dolose, if the occurrence of the harm was intended, or not, if it was not."
                            }
                        ]
                    }
