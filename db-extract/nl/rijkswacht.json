                        "source_sense_id": "ce5dfcd9-18cc-3cad-aed2-c674d1a07b93",
                        "source_sense_description": "voormalige, landelijke, op militaire leest gestoelde, politiedienst van het Koninkrijk België",
                        "target_lang_word": "gendarmerie",
