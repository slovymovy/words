                        "entry_id": "91bfdf91-5ad7-3900-b36e-bcad65cbd596",
                        "tags": [
                            "plural"
                        ],
                        "form": "occasionnalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7b0c1d4-44ac-377e-82cd-67b3aa127a3d",
                        "entry_id": "91bfdf91-5ad7-3900-b36e-bcad65cbd596",
                        "glosses": [
                            "Théorie selon laquelle toutes les actions des créatures vivantes sont dues à l’intervention de Dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1791b0c-77b6-4309-9f3d-3122ce8db7f0",
                                "sense_id": "e7b0c1d4-44ac-377e-82cd-67b3aa127a3d",
                                "text": "[Euler] Il n’aime d’ailleurs pas le système de l’occasionalisme^([sic]), développé par Descartes et ses successeurs, d’après lequel Dieu exécute à chaque instant le mouvement répondant à l’intention de l’âme, celle-ci étant par elle-même incapable de l’exécuter."
                            }
                        ]
                    },
                    {
                        "sense_id": "45831586-7fa7-3ac9-837b-fd0a0bd5d80a",
                        "entry_id": "91bfdf91-5ad7-3900-b36e-bcad65cbd596",
                        "glosses": [
                            "Mot peu fréquent, attesté occasionnellement mais ne donnant pas lieu à de nouvelles dérivations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf1fc33-113e-4baf-9ed1-e89da569555c",
                                "sense_id": "45831586-7fa7-3ac9-837b-fd0a0bd5d80a",
                                "text": "La notion d’occasionnalisme a à voir avec la question de l’innovation lexicale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e80a89a3-9dae-43f6-a1d2-51c33efc84fc",
                        "source_entry_id": "91bfdf91-5ad7-3900-b36e-bcad65cbd596",
                        "source_sense_description": "philosophie",
                        "target_lang_word": "occasionalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occasionalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d170d5e8-4bb0-3302-8b0b-60026f1aa6d0",
                                        "entry_id": "c0728908-112b-330b-bacf-b5b5c873fe9c",
                                        "glosses": [
                                            "A metaphysical doctrine that holds that all events are occasioned (caused) by God."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9ec67e9-4617-35c4-b9e7-e451d4181f0a",
                                        "entry_id": "c0728908-112b-330b-bacf-b5b5c873fe9c",
                                        "glosses": [
                                            "A nonce word."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b6be9cb-b080-4c2d-99f0-e9a7ff70daa0",
                                                "sense_id": "f9ec67e9-4617-35c4-b9e7-e451d4181f0a",
                                                "text": "This measure stems from the observation that productive morphological rules are likely to produce occasionalisms, whereas unproductive rules are not likely to do so. Occasionalisms are thus particularly important for determining productivity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
