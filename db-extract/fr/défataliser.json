                "senses": [
                    {
                        "sense_id": "70d96b7f-86a3-3428-a26d-8716b17d1aa0",
                        "entry_id": "f8e5d3ed-d824-32d6-88ae-6b177ed4a84a",
                        "glosses": [
                            "Faire perdre son caractère fatal, inévitable, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6435793-4bb1-4b82-9ee4-cc01198d7087",
                                "sense_id": "70d96b7f-86a3-3428-a26d-8716b17d1aa0",
                                "text": "La reconnaissance des enjeux permet de ne pas en être dupe, lorsqu’il s’agit de défataliser l’histoire et les processus historiques, lorsqu’il est fondamental de déchromatiser l’écriture de l’histoire."
                            },
                            {
                                "example_id": "728ae926-47b2-48e9-a8f4-0d0f07832f06",
                                "sense_id": "70d96b7f-86a3-3428-a26d-8716b17d1aa0",
                                "text": "L’avenir ne peut être défatalisé (c’est-à-dire conçu comme une ouverture sur plusieurs possibles que nous avons la responsabilité d’écarter ou d’élire) que si l’on a défatalisé l'histoire."
                            }
                        ]
                    }
