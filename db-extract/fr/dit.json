                                "sense_id": "eb3e6429-89ce-3bc1-9231-ca31c3fd2191",
                                "text": "Arriver à l’heure dite",
                                "translation": "đến vào giờ đã giao hẹn"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                        "entry_id": "ad811d30-3848-3571-80aa-734ea0574a77",
                        "glosses": [
                            "Gọi là, được gọi là; tức là, hiểu là."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b3f047-9390-4fc0-8b47-44569800bb77",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "Que de choses dites l’œuvre du génie",
                                "translation": "bao nhiêu sự việc được gọi là sự nghiện của thiên tài"
                            },
                            {
                                "example_id": "c31b0fae-a74f-4c6f-b37a-949b3d123bab",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "Nguyen Tat Thanh dit Nguyen le Patriote",
                                "translation": "Nguyễn Tất Thành tức Nguyễn ái Quốc"
                            },
                            {
                                "example_id": "83697a39-2e77-4647-a7a0-09f651712cd6",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "aussitôt dit, aussitôt fait",
                                "translation": "xem aussitôt"
                            },
                            {
                                "example_id": "b71da5ea-67fd-4066-a577-0d97cbc03a2d",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "autrement dit",
                                "translation": "nói cách khác"
                            },
                            {
                                "example_id": "6ec09168-5534-4051-92c8-302696160b5d",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "bien dit; c’est bien dit",
                                "translation": "đúng đấy, nói thế là đúng"
                            },
                            {
                                "example_id": "5d4a70b3-3417-46aa-8be4-0b84c3e61477",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "cela dit; (thân mật) ceci dit",
                                "translation": "nói thế xong thì"
                            },
                            {
                                "example_id": "30d0c79c-6e49-4c5c-8811-c3a820bb1963",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "cela soit dit en passant; soit dit en passant",
                                "translation": "nói qua thế thôi"
                            },
                            {
                                "example_id": "81f63c88-21c2-4cad-a05b-a01e333ec5d6",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "cela est bientôt dit",
                                "translation": "nói thì dễ thôi (như) g làm thì khó"
                            },
                            {
                                "example_id": "3866f255-f1d2-45e3-bada-c031338233b5",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "c’est dit; voilà qui est dit",
                                "translation": "đồng ý thế, nhất định thế"
                            },
                            {
                                "example_id": "4105ab1a-5749-406f-82eb-cf370a776f60",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "ce qui fut dit fut fait",
                                "translation": "đã nói là làm ngay"
                            },
                            {
                                "example_id": "e517f559-7390-4e0f-86c8-fd3e45bbbd06",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "il est dit que",
                                "translation": "số mệnh đã định là, trời đã bảo là"
                            },
                            {
                                "example_id": "09a50c53-99a2-48c3-aa93-6953b457f6a7",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "il ne sera pas dit que...",
                                "translation": "tôi không chịu là..., tôi không đồng ý là..."
                            },
                            {
                                "example_id": "ccdd11d3-6540-4196-ad5c-6eaf84b4d0ed",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "proprement dit",
                                "translation": "với nghĩa sát sao nhất; thực sự"
                            },
                            {
                                "example_id": "ba412e51-93d5-482f-8c6e-658a56592185",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "se le tenir pour dit",
                                "translation": "tin chắc như thế, không nói lại nữa"
                            },
                            {
                                "example_id": "791d072a-3d94-4fe2-9cec-f6c1952978ff",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "soit dit entre nous",
                                "translation": "nói riêng giữa chúng ta với nhau thôi"
                            },
                            {
                                "example_id": "66e7dcfa-9113-4f83-a7d7-acc5bdf8ef7b",
                                "sense_id": "2ea2fe51-ff14-30eb-a781-3176f6f0bdd9",
                                "text": "tout est dit",
                                "translation": "đã bàn kỹ rồi, đã xong rồi"
                            }
                        ]
                    }
                ],
