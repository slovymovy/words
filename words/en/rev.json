                                "target_lang_word": "преподобный",
                                "target_lang_sense_clarification": "священник"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ksiądz",
                                "target_lang_sense_clarification": "tytuł duchownego"
                            },
                            {
                                "target_lang_word": "wielebny",
                                "target_lang_sense_clarification": "tytuł honorowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37898a5c-03a2-3544-a157-0cb33fd6a46c",
                    "sense_definition": "Initialism of range-extended vehicle or range extender vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>REV</w> utilizes a small combustion engine to recharge its battery while driving.",
                            "target_lang_translations": {
                                "ru": "<w>Электромобиль с увеличенным запасом хода</w> использует небольшой ДВС для подзарядки батареи во время движения.",
                                "pl": "<w>Pojazd typu REV</w> wykorzystuje mały silnik spalinowy do ładowania akumulatora podczas jazdy."
                            }
                        },
                        {
                            "text": "Many manufacturers are exploring the <w>REV</w> as a bridge to fully electric transport.",
                            "target_lang_translations": {
                                "ru": "Многие производители рассматривают <w>электромобиль с увеличенным запасом хода</w> как мост к полностью электрическому транспорту.",
                                "pl": "Wielu producentów bada <w>pojazdy typu REV</w> jako pomost do w pełni elektrycznego transportu."
                            }
                        }
                    ],
                    "synonyms": [
                        "EREV",
                        "REX",
                        "REx",
                        "REEV"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для электромобиля с увеличенным запасом хода.",
                        "pl": "Akronim dla pojazdu elektrycznego o zwiększonym zasięgu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электромобиль с увеличенным запасом хода",
                                "target_lang_sense_clarification": "тип транспорта"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "samochód elektryczny o zwiększonym zasięgu",
                                "target_lang_sense_clarification": "typ pojazdu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "96de9187-3144-3d6b-add3-958fe5015a1f",
                    "sense_definition": "Alternative form of Rev. (a title for a member of the clergy).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clergy_title",
                    "name_type": "title_or_honorific_name",
                    "examples": [
