                "senses": [
                    {
                        "sense_id": "aad74f17-5781-3c21-8113-435991e111c4",
                        "entry_id": "6bdaa7f7-70b6-306e-bde2-c8f129e3a6c4",
                        "glosses": [
                            "gedrag volgens geldende normen en waarden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093d1f19-f06e-4299-986a-b384341d7f3c",
                                "sense_id": "aad74f17-5781-3c21-8113-435991e111c4",
                                "text": "Dit verstoot tegen de zedelijkheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59bd5469-a119-4e64-bc47-4dc1a44486c5",
                        "source_entry_id": "6bdaa7f7-70b6-306e-bde2-c8f129e3a6c4",
                        "source_sense_id": "aad74f17-5781-3c21-8113-435991e111c4",
                        "target_lang_word": "Moral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moral",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beb526a6-8dcc-32c4-acdb-9261559468a2",
                                        "entry_id": "0c404076-ea16-3c85-8337-86362b1ae3ca",
                                        "glosses": [
                                            "die Wertvorstellungen und guten Sitten einer Gesellschaft oder einer Person"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05398474-38ab-47d1-a340-220061bf4e68",
                                                "sense_id": "beb526a6-8dcc-32c4-acdb-9261559468a2",
                                                "text": "„Erst kommt das Fressen, dann kommt die Moral.“"
                                            },
                                            {
                                                "example_id": "b994d239-9860-47ae-9c50-17c060e8432c",
                                                "sense_id": "beb526a6-8dcc-32c4-acdb-9261559468a2",
                                                "text": "„Über die Moral des Schmuggelns möchte ich gar nicht weiter sprechen.“"
                                            },
                                            {
                                                "example_id": "6a390f25-3f6c-4693-961c-d36c0f8418da",
                                                "sense_id": "beb526a6-8dcc-32c4-acdb-9261559468a2",
                                                "text": "„Ich verstehe die amerikanische Moral nicht.“"
                                            },
                                            {
                                                "example_id": "d18e7e1f-c366-4899-b852-77c0eaa68a54",
                                                "sense_id": "beb526a6-8dcc-32c4-acdb-9261559468a2",
                                                "text": "„Er glaubt nicht, daß die Wissenschaft in der Lage sei, den Menschen Moral zu lehren.“"
                                            },
                                            {
                                                "example_id": "a1ac656d-2bca-48e9-bf0f-c6fd5406fe58",
                                                "sense_id": "beb526a6-8dcc-32c4-acdb-9261559468a2",
                                                "text": "„Moralen sind ebenso der Vergänglichkeit und dem Wechsel unterworfen wie Kleidermoden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c38242b1-3fd0-3cf2-a702-6f763fd947fb",
                                        "entry_id": "0c404076-ea16-3c85-8337-86362b1ae3ca",
                                        "glosses": [
                                            "daraus zu ziehende Lehre"
                                        ],
                                        "tags": [
                                            "meist Singular",
                                            "von einer Erzählung, einem Geschehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "932ead25-00f9-42a9-8e85-679b9268e6fc",
                                                "sense_id": "c38242b1-3fd0-3cf2-a702-6f763fd947fb",
                                                "text": "Und die Moral von der Geschicht? — Trau niemals einem Wolf, wenn Du ein Schaf bist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "56da4abd-c953-3594-a16c-360b3e1bab98",
                                        "entry_id": "0c404076-ea16-3c85-8337-86362b1ae3ca",
                                        "glosses": [
                                            "innere Kampfbereitschaft der Truppe"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79460730-872a-4585-bfe1-dc661b171b21",
                                                "sense_id": "56da4abd-c953-3594-a16c-360b3e1bab98",
                                                "text": "Nach der soundsovielten sogenannten „Frontbegradigung“ hatte die Moral etwas gelitten"
                                            },
                                            {
                                                "example_id": "23ae1881-6434-4e86-968b-dd7236836969",
                                                "sense_id": "56da4abd-c953-3594-a16c-360b3e1bab98",
                                                "text": "„Hitler hatte nicht die Niederlage der Sowjets und den totalen Sieg verkündet, um Propaganda zu machen und die Moral der Heimatfront zu stärken, sondern weil er glaubte, es verhalte sich wirklich so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9aea511-6f8d-4eaf-993e-4aa0a22210b6",
                        "source_entry_id": "6bdaa7f7-70b6-306e-bde2-c8f129e3a6c4",
                        "source_sense_id": "aad74f17-5781-3c21-8113-435991e111c4",
                        "target_lang_word": "morality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ffb99a-57a0-3a66-8cc9-e86ae37de5d7",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "Recognition of the distinction between good and evil or between right and wrong; respect for and obedience to the rules of right conduct; the mental disposition or characteristic of behaving in a manner intended to produce morally good results."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da1234f-8032-429a-b181-6546f1a1236a",
                                                "sense_id": "c9ffb99a-57a0-3a66-8cc9-e86ae37de5d7",
                                                "text": "Without morality, intellect were impossible for him; a thoroughly immoral man could not know anything at all! To know a thing, what we can call knowing, a man must first love the thing, sympathize with it: that is, be virtuously related to it."
                                            },
                                            {
                                                "example_id": "7bf163b5-a79e-4283-ba61-346cc7e765b6",
                                                "sense_id": "c9ffb99a-57a0-3a66-8cc9-e86ae37de5d7",
                                                "text": "Ellery Jackson-Hubbard. […] A man radiating prosperity, optimism and selfishness. Has no morality whatever. Is a conscious individualist, cold-blooded, pitiless, working only for himself, and believing in nothing but himself."
                                            },
                                            {
                                                "example_id": "e6f7d2e2-8ab2-4b4b-9037-b03fe39ffc8f",
                                                "sense_id": "c9ffb99a-57a0-3a66-8cc9-e86ae37de5d7",
                                                "text": "Science and art without morality are not dangerous in the sense commonly supposed. They are not dangerous like a fire, but dangerous like a fog."
                                            },
                                            {
                                                "example_id": "af134e63-5ba1-4169-b69b-59e771e89af6",
                                                "sense_id": "c9ffb99a-57a0-3a66-8cc9-e86ae37de5d7",
                                                "text": "It may be true that you cannot legislate morality, but behavior can be regulated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4253c064-0b3f-3451-ad89-504d8f96dae5",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "A set of social rules, customs, traditions, beliefs, or practices which specify proper, acceptable forms of conduct."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e90e93b-2be3-4cf4-b8e7-0f0e0c4ac75f",
                                                "sense_id": "4253c064-0b3f-3451-ad89-504d8f96dae5",
                                                "text": "I have to live for others and not for myself: thats middle class morality."
                                            },
                                            {
                                                "example_id": "07a8988c-edde-4612-96f7-d62decd16705",
                                                "sense_id": "4253c064-0b3f-3451-ad89-504d8f96dae5",
                                                "text": "He smiled a little. \"Morality is the average conduct of the average man at a given time and place. It is based on custom and expediency.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c11396e-d285-38c6-8f8f-181ac3246064",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "A set of personal guiding principles for conduct or a general notion of how to behave, whether respectable or not."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89551d84-0434-40d0-8fc3-6fac30df5c3c",
                                                "sense_id": "6c11396e-d285-38c6-8f8f-181ac3246064",
                                                "text": "His morality was such as naturally proceeds from loose opinions."
                                            },
                                            {
                                                "example_id": "a5573b53-5e45-422b-b58d-69f957108681",
                                                "sense_id": "6c11396e-d285-38c6-8f8f-181ac3246064",
                                                "text": "Deputy District Attorney Bill Tingle called Jones \"the devil's right-hand man\" and said he should be punished for his \"atrocious morality.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf7f77b-016e-379a-9c3b-2a3695588dcd",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "A lesson or pronouncement which contains advice about proper behavior."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d5f00bf-733c-4a76-83d3-ddd634ad9919",
                                                "sense_id": "bdf7f77b-016e-379a-9c3b-2a3695588dcd",
                                                "text": "\"She had done her duty\"—\"she left the matter to them that had a charge anent such things\"—and \"Providence would bring the mystery to light in his own fitting time\"—such were the moralities with which the good dame consoled herself."
                                            },
                                            {
                                                "example_id": "659a2948-dadc-4d58-8a83-d563f4bdf951",
                                                "sense_id": "bdf7f77b-016e-379a-9c3b-2a3695588dcd",
                                                "text": "What mean these stale moralities, / Sir Preacher, from your desk you mumble?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "229f095b-afbf-3b51-b709-728444d67812",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "A morality play."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b0f9cb-efa1-41b1-83b9-a237c9d4c47c",
                                                "sense_id": "229f095b-afbf-3b51-b709-728444d67812",
                                                "text": "The Moralities displayed something more of art and invention than the Mysteries; in them virtues, vices and qualities were personified, and something like a plot was frequently to be discovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edde3b4f-70e1-3a93-9666-e1d83fe5d226",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "Moral philosophy, the branch of philosophy which studies the grounds and nature of rightness, wrongness, good, and evil."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a6186fd-374c-4a21-a065-13898666e374",
                                                "sense_id": "edde3b4f-70e1-3a93-9666-e1d83fe5d226",
                                                "text": "Robinson sums up the conclusion of the first part of his book as being \"that the task of the moralist is to set in their proper relation to one another the three different types of moral judgment . . . and so reveal the field of morality as a single self-coherent system\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc90fe66-002a-366e-a66c-3b561b926656",
                                        "entry_id": "9a267daa-199b-3c72-8c31-75c58c022921",
                                        "glosses": [
                                            "A particular theory concerning the grounds and nature of rightness, wrongness, good, and evil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d5df1f6-50eb-40fb-9b03-28e0bfcef629",
                                                "sense_id": "cc90fe66-002a-366e-a66c-3b561b926656",
                                                "text": "Hume's morality which ‘implies some sentiment common to all mankind’; Kant's morality for all rational beings; Butler's morality with its presupposition of ‘uniformity of conscience’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ef3177c-4f98-428d-a1fe-e8efa2c248dc",
                        "source_entry_id": "6bdaa7f7-70b6-306e-bde2-c8f129e3a6c4",
                        "source_sense_id": "aad74f17-5781-3c21-8113-435991e111c4",
                        "target_lang_word": "morale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20db5d75-4f8a-3a60-9a3c-d4d145494ea2",
                                        "entry_id": "80b586a6-44a2-3cd4-a816-72552ea4d158",
                                        "glosses": [
                                            "Science de la séparation du bien et du mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebbba242-577c-4e5c-9fc8-2dde2d84f8fc",
                                                "sense_id": "20db5d75-4f8a-3a60-9a3c-d4d145494ea2",
                                                "text": "Nous sommes arrivés, de critique en critique, à cette triste conclusion : […] ; que tous ces mots Droit, Devoir, Morale, Vertu, etc., dont la chaire et l'école font tant de bruit, ne servent à couvrir que de pures hypothèses, de vaines utopies, d'indémontrables préjugés; […]."
                                            },
                                            {
                                                "example_id": "c0c62d7b-b6e0-46a1-a45b-8c341e0906a8",
                                                "sense_id": "20db5d75-4f8a-3a60-9a3c-d4d145494ea2",
                                                "text": "La morale n'est point dans la superstition, elle n'est pas dans la cérémonie, elle n'a rien de commun avec les dogmes. On ne peut trop répéter que tous les dogmes sont différents, et que la morale est la même chez tous les hommes qui font usage de leur raison."
                                            },
                                            {
                                                "example_id": "d9d28b19-4a8f-401b-a02e-9d2e817c3d80",
                                                "sense_id": "20db5d75-4f8a-3a60-9a3c-d4d145494ea2",
                                                "text": "Pour décrire le rapport des filles à la route, David Le Breton évoque \"L'Ethique du care\" de Carol Gilligan : un ouvrage sociologique décrivant, entre autres, l'idée que les femmes ont une autre manière de penser la morale que les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                        "entry_id": "80b586a6-44a2-3cd4-a816-72552ea4d158",
                                        "glosses": [
                                            "Ensemble de doctrines, de règles de conduite, de relations sociales qu'une société se donne et qui varient selon la culture, les croyances, les conditions de vie et les besoins de la société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8247abba-0ab4-429b-82ea-3dfaed5b4f21",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "Sans doute cette morale est ferme et pure, mais elle manque entièrement d'enthousiasme et d'onction, et par là elle est inférieure à la morale antique et plus encore à la morale chrétienne."
                                            },
                                            {
                                                "example_id": "96ff52f8-debf-42a8-bcdf-e328626d9950",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "Le livre de M. Charles Baudelaire intitulé Les Fleurs du Mal est un défi jeté aux lois qui protègent la religion et la morale. […]. A côté de ces pièces et de quelques autres où l’immortalité de l’âme les plus chères croyances du christianisme sont mises à néant, il en est d’autres qui sont l’expression de la lubricité la plus révoltante: […]."
                                            },
                                            {
                                                "example_id": "126c581f-86d7-4687-acf3-e9a55c2a3ae3",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "Certainement la morale ne change pas, elle est une ; mais ses obligations varient selon les sphères."
                                            },
                                            {
                                                "example_id": "dde233c8-d081-4f86-83f8-6316e77ec689",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "[…]; le respect de la personne humaine, la fidélité sexuelle et le dévouement pour les faibles constituent les éléments de moralité dont sont fiers tous les hommes d'un cœur élevé; - c'est même très souvent à cela que l'on réduit la morale."
                                            },
                                            {
                                                "example_id": "4d5c513c-34e0-4a51-8291-2e2ac6aed817",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "Toutes les religions et toutes les morales ont tendu à jeter un voile sur la gesticulation fornicatoire qui est, cependant, à la base de la vie […]."
                                            },
                                            {
                                                "example_id": "59be049e-6e6d-431e-83ea-8aefa59388bd",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "La littérature érotique embrasse plus de réalités psychologiques que la morale bourgeoise ne voulait en connaître, et que le puritanisme n'en tolère. Or ces réalités, quoiqu'on en juge, sont au moins aussi quotidiennes et obsédantes que les réalités économiques, […]."
                                            },
                                            {
                                                "example_id": "d1d4e8ed-bc2c-430a-a2f3-262fb7d4cbae",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "Pourtant je tiens jalousement à l'avertissement lancé par Homère aux Grecs dans L'Iliade et par Tyrtée dans les Élégies: « C'est une faiblesse déraisonnable que de se décharger sur la divinité de la responsabilité d'une morale et d'un ordre public » — Dieu, Allah ou quel qu'il soit."
                                            },
                                            {
                                                "example_id": "900e8e63-76ca-4ec6-9e01-41d8a1d76fa9",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "Toute morale est fondée sur la prise en considération de ce qui est juste et souhaitable pour autrui."
                                            },
                                            {
                                                "example_id": "b6d199a1-e20a-4b97-8335-1ca1d2fd99ca",
                                                "sense_id": "1a3f3473-d8f0-3f92-a126-6a798b330ef3",
                                                "text": "La morale des surveillants se bornait à menacer de leurs cannes, tantôt tirant le revolver pour donner plus de force aux locutions d’arsouille dont ils avaient l'habitude de se servir. Voilà la vie du bagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d18c8bf-60a2-35aa-9ffc-b4fbbadeae89",
                                        "entry_id": "80b586a6-44a2-3cd4-a816-72552ea4d158",
                                        "glosses": [
                                            "Traité de morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f61977c-9afa-4401-bd75-8e635f16615d",
                                                "sense_id": "2d18c8bf-60a2-35aa-9ffc-b4fbbadeae89",
                                                "text": "La morale d’Aristote. On dit aussi Les Morales d’Aristote, parce que ce philosophe a fait plusieurs traités sous ce titre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3447e2-5ff3-3809-b221-1ed5b587c150",
                                        "entry_id": "80b586a6-44a2-3cd4-a816-72552ea4d158",
                                        "glosses": [
