                                                "sense_id": "79ad5c29-b4ea-3dda-afd8-95949d23bb01",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Renner kommt, geht der Herr Renner.“"
                                            },
                                            {
                                                "example_id": "169f05ef-05bc-44d7-8e89-56f55359edbc",
                                                "sense_id": "79ad5c29-b4ea-3dda-afd8-95949d23bb01",
                                                "text": "Renner kommt und geht."
                                            },
