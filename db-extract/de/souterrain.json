                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                        "entry_id": "13d16dbe-3f30-3cdb-98dd-49b291e61740",
                        "glosses": [
                            "unter der Erde befindlicher Teil eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eed19c0-94d3-4054-97a5-49a71388af29",
                                "sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                                "text": "„Das Tiroler Landestheater steht in Innsbruck, in unmittelbarer Nähe der historischen Altstadt, umgeben von Hofburg, Hofgarten und SOWI-Fakultät der Universität Innsbruck. Das große Haus fasst gegen 800 Sitzplätze und die Kammerspiele im Souterrain rund 250.“"
                            },
                            {
                                "example_id": "d9a1300d-ff98-4ab1-bedb-536050c986b9",
                                "sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                                "text": "„Sein Souterrain ist hoch, und in zwei Absätzen führt eine Außentreppe zu den Schalterräumen hinauf.“"
                            },
                            {
                                "example_id": "d1f9c875-bf25-42b7-b6d4-c08b0a876f94",
                                "sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                                "text": "„Gustav, der im Souterrain schlafende Zerberus, erwachte von undefinierbaren Geräuschen, die aus dem Konferenzraum kamen, und vom Geruch nach beißendem Rauch.“"
                            },
                            {
                                "example_id": "4b405dfb-f964-4840-85fd-2e398284dfeb",
                                "sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                                "text": "„Per Handy muss man um Einlass bitten und steigt hinunter in das Souterrain.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a017031-57f7-4c66-9bc5-13436fb1724c",
                        "source_entry_id": "13d16dbe-3f30-3cdb-98dd-49b291e61740",
                        "source_sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                        "source_sense_description": "unter der Erde befindlicher Teil eines Gebäudes",
                        "target_lang_word": "souterrain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souterrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4976caf4-5646-3b91-a7f5-a15e9db4ef21",
                                        "entry_id": "501f3363-2546-3618-97f4-f095d5f50d78",
                                        "glosses": [
                                            "An underground chamber or passage sometimes used as a store, especially one associated with Iron Age settlements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e509e7-95ef-4a75-9177-306e2f47edaa",
                                                "sense_id": "4976caf4-5646-3b91-a7f5-a15e9db4ef21",
                                                "text": "Now when my son saw that I separated them, he secretly built this souterrain and furnished it and transported to it victuals, even as thou seest; and, when I had gone out a-sporting, came here with his sister and hid from me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8398b847-4f55-4e2a-ba53-3fe2574adbec",
                        "source_entry_id": "13d16dbe-3f30-3cdb-98dd-49b291e61740",
                        "source_sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                        "source_sense_description": "unter der Erde befindlicher Teil eines Gebäudes",
                        "target_lang_word": "souterrain",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souterrain",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "59928a94-f2c4-3714-a6c9-2b1553f3e6c7",
                                        "entry_id": "e3b07a20-316a-3dfc-b9ef-f2796bc48dcf",
                                        "glosses": [
                                            "gedeelte van een gebouw dat gedeeltelijk onder de grond ligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a726766a-0705-4fdb-898a-85ef469aa0d3",
                                                "sense_id": "59928a94-f2c4-3714-a6c9-2b1553f3e6c7",
                                                "text": "Ik weet nog dat je de hele dag een soort gerommel hoorde... Invaliden reden rond op zelfgebouwde gelagerde karretjes, maar de wegen waren met kasseien geplaveid. Ze woonden in souterrains en kelders. Ze zopen en lagen in de goot. Ze bedelden. Ze ruilden hun medailles voor wodka."
                                            },
                                            {
                                                "example_id": "6dd7996d-959d-44a3-9af2-219ac273b8ae",
                                                "sense_id": "59928a94-f2c4-3714-a6c9-2b1553f3e6c7",
                                                "text": "Samen met een vriendin trok hij in een souterrain hier ter stede, dat werd verhuurd door Bart. Zo was de vriendschap ontstaan."
                                            },
                                            {
                                                "example_id": "9f2ab003-72b9-4b15-9600-f443428db014",
                                                "sense_id": "59928a94-f2c4-3714-a6c9-2b1553f3e6c7",
                                                "text": "\"Waarom niet\", dacht visagiste Xelly Cabau van Kasbergen toen ze zich gisteren opmaakte voor een evenement van de Amsterdamse high-end club Mad Fox in het souterrain van het W-hotel. Xelly was onherkenbaar met haar groene haar, dat volgens de zus van Yolanthe snel weer bruin wordt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "926610ab-fead-47dc-8094-4929e8f632af",
                        "source_entry_id": "13d16dbe-3f30-3cdb-98dd-49b291e61740",
                        "source_sense_id": "2a7032d9-099d-3705-9bd6-d378a3f8071a",
                        "source_sense_description": "unter der Erde befindlicher Teil eines Gebäudes",
                        "target_lang_word": "suterena",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suterena",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "165051b7-3eb3-355f-be7d-fd1d1fd2de0a",
                                        "entry_id": "330e3c28-24b3-37f6-945d-d7185ce9ff87",
                                        "glosses": [
                                            "część budynku znajdująca się pod parterem, często poniżej poziomu terenu, przystosowana do celów mieszkalnych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda6f10c-c883-4864-ad7e-2fbdeb2f63c9",
                                                "sense_id": "165051b7-3eb3-355f-be7d-fd1d1fd2de0a",
                                                "text": "Podczas wojny cała nasza rodzina mieszkała w suterenie kamienicy na Targówku."
                                            },
                                            {
                                                "example_id": "42ef6530-6ca5-4d88-b8d6-f9a20b03e740",
                                                "sense_id": "165051b7-3eb3-355f-be7d-fd1d1fd2de0a",
                                                "text": "Ale oto staje mu w oczach inny dom: suterena, wilgotny grób, pełen śmierdzącej pary"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
