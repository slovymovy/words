        "fr-extract.jsonl": [
            {
                "entry_id": "7639fcf9-0165-3c02-9131-997ad7aeffcc",
                "word": "frissonnement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fdabeddc-db4b-45da-ab2c-ba0a0cb0ac63",
                        "entry_id": "7639fcf9-0165-3c02-9131-997ad7aeffcc",
                        "tags": [
                            "plural"
                        ],
                        "form": "frissonnements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c913841-0735-36b6-a3ff-ddce7569fcf6",
                        "entry_id": "7639fcf9-0165-3c02-9131-997ad7aeffcc",
                        "glosses": [
                            "Action de frissonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08810b72-2b3a-459a-933c-28f0dc0cb4b8",
                                "sense_id": "9c913841-0735-36b6-a3ff-ddce7569fcf6",
                                "text": "Il va avoir la fièvre, il sent déjà un frissonnement."
                            },
                            {
                                "example_id": "d547ad13-a9b1-49ee-bcd1-3bca6a7ec70e",
                                "sense_id": "9c913841-0735-36b6-a3ff-ddce7569fcf6",
                                "text": "Les yeux fermés, elle écouta le bruit de la nature, le frissonnement des feuilles sur lesquelles crépitaient les gouttes, les craquements du sous-bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "baf6b357-fa7b-334f-9f8a-29c3da43744b",
                        "entry_id": "7639fcf9-0165-3c02-9131-997ad7aeffcc",
                        "glosses": [
                            "Action de frissonner.",
                            "Frémissement, frisson, tremblement causé par quelque émotion très vive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e35a48-8741-4191-a4bd-dfdf5582080a",
                                "sense_id": "baf6b357-fa7b-334f-9f8a-29c3da43744b",
                                "text": "Quand je pense à cela, il me prend un frissonnement."
                            },
                            {
                                "example_id": "687f7543-2a12-4def-a6f3-3e22dc91b58b",
                                "sense_id": "baf6b357-fa7b-334f-9f8a-29c3da43744b",
                                "text": "En proie aux mille frissonnements que cette enveloppante main dardait à mon corps tout entier, je craignais de trahir ce que j’éprouvais devant ce père et cette mère, dont la fille, sous leurs yeux, osait…"
                            },
                            {
                                "example_id": "b8f7ca57-25e6-45bf-9a9d-a9025d1f3a6b",
                                "sense_id": "baf6b357-fa7b-334f-9f8a-29c3da43744b",
                                "text": "À cette tristesse, à ces larmes, à ces baisers, à ces paroles plus tendres, à ces frissonnements, je n’ai rien compris…"
                            },
                            {
                                "example_id": "b0a331ac-46e7-469d-b5c2-81df812cc9cc",
                                "sense_id": "baf6b357-fa7b-334f-9f8a-29c3da43744b",
                                "text": "Mon père, qui n’est pas domestique, ménage, avec des frissonnements qui font mal, un pantalon de casimir noir, qui a avalé déjà dix écheveaux de fil, tué vingt aiguilles, mais qui reste grêlé, fragile et mou !\nÀ peine il peut se baisser, à peine pourra-t-il saluer demain…"
                            },
                            {
                                "example_id": "c2de3595-783c-4137-8c0e-e9bcbc265554",
                                "sense_id": "baf6b357-fa7b-334f-9f8a-29c3da43744b",
                                "text": "Quand elle danse, elle a un certain mouvement de hanches indescriptible, qui donne à tout son corps un frissonnement d’ineffable langueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc01973e-9327-3cba-8285-c9a63d10769e",
                        "entry_id": "7639fcf9-0165-3c02-9131-997ad7aeffcc",
                        "glosses": [
                            "(Figuré)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd81afee-cd11-4b88-be1b-17fca6aedbf3",
                                "sense_id": "cc01973e-9327-3cba-8285-c9a63d10769e",
                                "text": "Avant de partir, nous prenions un verre de kirsch dans ces grandes cuisines d’hôtellerie où le feu s’allume de bonne heure, avec ces frissonnements de sarments qui font rêver de brouillards et de vitres humides. Puis en route !"
                            },
                            {
                                "example_id": "47c96f63-fa59-4ce7-8fbd-37e9cc339be9",
                                "sense_id": "cc01973e-9327-3cba-8285-c9a63d10769e",
                                "text": "Elle avait peur quand un coup de vent passait, éveillant dans la profondeur des taillis un frissonnement de feuilles sèches, terrifiée par la crainte des grands loups, dont on lui parlait les soirs de veillée, quand elle refusait d’aller dormir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79940fd6-9cd1-46bc-bdc1-59de7baae2f5",
                        "source_entry_id": "7639fcf9-0165-3c02-9131-997ad7aeffcc",
                        "target_lang_word": "arrepio",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrepio",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "76274311-58ed-34c7-9a42-023bb8b0b9d2",
                                        "entry_id": "5cb2cee2-6a45-325d-a053-d697cde40a32",
                                        "glosses": [
                                            "tremor passageiro causado por frio ou medo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1946ea-7917-4a0a-abf0-6bf70b341218",
                                                "sense_id": "76274311-58ed-34c7-9a42-023bb8b0b9d2",
                                                "text": "\"Na maior parte das vezes, o arrepio é uma tática do nosso corpo para amenizar a sensação de frio.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6f0b6e-567d-36d2-a575-933195cd1533",
                                        "entry_id": "5cb2cee2-6a45-325d-a053-d697cde40a32",
                                        "glosses": [
                                            "estado no qual por contração, a pele fica com poros dilatados e os pelos que dela pendem ficam eriçados por diferentes estímulos, como o sexual como pelo toque, pela fala próxima aos ouvidos ou ainda pelo estímulo do medo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a06d203f-3da1-4e91-8d38-f6141ddd099d",
                                                "sense_id": "ee6f0b6e-567d-36d2-a575-933195cd1533",
                                                "text": "Sabia que quando a tocava e via todo aquele arrepio, era tesão."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b51002c7-3481-3d37-bade-65bdfd9423d7",
                                        "entry_id": "5cb2cee2-6a45-325d-a053-d697cde40a32",
                                        "glosses": [
                                            "medo"
                                        ],
                                        "tags": [
                                            "Por extensão de sentido, figurado"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4b154ae-597c-43fe-950d-e047239ef9d9",
                                                "sense_id": "b51002c7-3481-3d37-bade-65bdfd9423d7",
                                                "text": "\"…o modo como os ex-membros das seitas falam das suas experiências até dá arrepios!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e3a3f92-d4e8-39c4-9e5e-cef2f366a447",
                                        "entry_id": "5cb2cee2-6a45-325d-a053-d697cde40a32",
                                        "glosses": [
                                            "estado no qual os pelos ou cabelos estão eriçados, na direção contrária aos fios"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad438f4-e39d-45c4-902b-4148c2625feb",
