                                "target_senses": [
                                    {
                                        "sense_id": "827dade0-86fb-3846-ab56-a135a46cd655",
                                        "entry_id": "62986551-2581-313d-b6d9-536e880c49d1",
                                        "glosses": [
                                            "A device for making things sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133e8d99-c39f-4754-b9c7-4d721b0a6501",
                                                "sense_id": "827dade0-86fb-3846-ab56-a135a46cd655",
                                                "text": "There was a pencil sharpener at the front of the classroom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61c0914-cb19-3532-a3d2-062d3cc13d52",
                                        "entry_id": "62986551-2581-313d-b6d9-536e880c49d1",
                                        "glosses": [
                                            "That which makes something sharp."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d08f36-ce32-46e5-a98f-152fc0867b26",
                                                "sense_id": "d61c0914-cb19-3532-a3d2-062d3cc13d52",
                                                "text": "“Sir,” said the shepherd, “poverty is a great sharpener of the wits. […]"
                                            },
                                            {
                                                "example_id": "44f7fe0b-fba2-4950-9cd8-e673485cd18b",
                                                "sense_id": "d61c0914-cb19-3532-a3d2-062d3cc13d52",
                                                "text": "The snuff-box, knife, and chicken-bones were again in requisition, and a pen was successfully formed. The ink, or at least its substitute, was rather more difficult, but necessity is always a sharpener of intellect, and even this was accomplished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1134d66-b4d3-36f6-9fd9-9ab5d4e292d6",
                                        "entry_id": "62986551-2581-313d-b6d9-536e880c49d1",
                                        "glosses": [
                                            "An alcoholic drink taken at the start of the day, or just before a meal."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
