                "senses": [
                    {
                        "sense_id": "5a53f7b7-0d83-3826-8b25-6305dee2d5cc",
                        "entry_id": "9d1f44fa-49d7-3c07-b7b5-711593192ff3",
                        "glosses": [
                            "female equivalent of швец (švec): seamstress"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "57fc63de-bb41-473c-8605-9fcb64e4c217",
                                "sense_id": "5a53f7b7-0d83-3826-8b25-6305dee2d5cc",
                                "text": "По малоле́тству моему́ я боя́лся подава́ть своему́ учи́телю сове́ты в его́ поэти́ческих о́пытах, но счита́л его́ наме́рение деклами́ровать стихи́ пе́ред швеёю риско́ванным.",
                                "translation": "Being very young, I was afraid to give my teacher advice in his poetic experiments, but I considered his plan to declaim verses before the seamstress risky.",
                                "english": "Being very young, I was afraid to give my teacher advice in his poetic experiments, but I considered his plan to declaim verses before the seamstress risky."
                            }
                        ]
                    }
                ],
