                ],
                "senses": [
                    {
                        "sense_id": "83707912-d438-3c8f-b08b-98a1c2e89a84",
                        "entry_id": "9ea6e516-27c3-3de7-884b-8360eb0399c9",
                        "glosses": [
                            "Sportuhr, die speziell für Läufer entwickelt wurde; Uhr, die den Läufer unterstützt, indem sie Daten wie Zeit, Distanz, Tempo und Herzfrequenz anzeigt und aufzeichnet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "701f696b-ca13-4a25-aeb3-a9e7c44d46b3",
                                "sense_id": "83707912-d438-3c8f-b08b-98a1c2e89a84",
                                "text": "„Wenn Sie eine Laufuhr suchen, die mehrere Tage mit einer Akkuladung auskommt, Ihr Training mühelos verfolgt, aufschlussreiche Daten liefert und Sie nicht mit Benachrichtigungen nervt, dann ist der Polar Pacer genau das richtige Modell.“"
                            },
                            {
                                "example_id": "15d5ac60-5335-4499-8096-46259366da80",
                                "sense_id": "83707912-d438-3c8f-b08b-98a1c2e89a84",
                                "text": "„16 Läufe und 213,4 Kilometer stand im November auf der Laufuhr.“"
                            },
                            {
                                "example_id": "ad98385c-b4c2-4462-866d-b219750c8c95",
                                "sense_id": "83707912-d438-3c8f-b08b-98a1c2e89a84",
                                "text": "„Eine Laufuhr wird speziell für Läufer entwickelt, die ihre Fortschritte verfolgen, ihre Leistung verbessern und motiviert bleiben möchten, aber nicht gleich ein riesiges Budget in die Laufausrüstung investieren wollen.“"
                            },
                            {
                                "example_id": "7409a111-8797-4662-89c4-4c5ec17f4e69",
                                "sense_id": "83707912-d438-3c8f-b08b-98a1c2e89a84",
                                "text": "„Die Laufuhr verfügt über einen Vibrationsmotor, Blutdruckmesser, Pedometer sowie 3D-G-Sensor und ist wasserdicht mit dem IP-67 Standard.“"
                            },
                            {
                                "example_id": "10b66f56-da83-49c2-b45c-952d3599c09c",
                                "sense_id": "83707912-d438-3c8f-b08b-98a1c2e89a84",
                                "text": "„Aufgrund des Dauerregen waren die Streckenmarkierungen teils nicht mehr vorhanden und ohne auf der Laufuhr gespeicherten Track kaum zu finden, sodass sich einige Läuferinnen und Läufer teilweise verlaufen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
