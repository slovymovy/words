                },
                {
                    "sense_id": "aac52372-d098-367b-9723-b2e6c85f115c",
                    "sense_definition": "Préparation liquide, souvent médicinale, magique ou suspecte ; potion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "potion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le conte, la sorcière prépare un étrange <w>breuvage</w> au fond de sa marmite."
                        },
                        {
                            "text": "Le malade a refusé d'avaler cet affreux <w>breuvage</w> au goût amer."
                        }
                    ],
                    "common_phrases": [
