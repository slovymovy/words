                                    {
                                        "sense_id": "bfcb478b-e7df-365a-944d-b4e2fd2febb8",
                                        "entry_id": "88e0e664-c715-3d0a-86ca-6183f566e426",
                                        "glosses": [
                                            "in Briefwechsel mit jemandem stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
