                        "examples": [
                            {
                                "example_id": "3967fcd1-5879-4324-878c-c6f6a5267066",
                                "sense_id": "33c0ead2-15dd-3b43-99cf-b0975b0852ff",
                                "text": "Il y a quatre timbres, imprimés en rotogravure et calcographie combinées ou en rotogravure à plusieurs couleurs."
                            },
                            {
                                "example_id": "7b7432c7-8794-41f8-b4ae-0d5241c7294b",
                                "sense_id": "33c0ead2-15dd-3b43-99cf-b0975b0852ff",
                                "text": "Derrière la chaire de chêne brut, une bannière en soie d’un rose fané proclamait que Dieu était Amour, c’était l’unique décoration de l’église en dehors d’une rotogravure de La Lumière du Monde de Hunt. Pas de trace de piano, d’orgue, de livres de chant, de programme de l’office et autres impedimenta ecclésiastiques que nous voyions chaque dimanche."
                            }
                        ]
                    }
