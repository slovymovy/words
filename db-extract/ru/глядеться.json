                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1d2ec4-2eb8-4744-810d-c0606ea5a87d",
                                                "sense_id": "934b3040-b232-39c1-a4b7-021abd2b2e96",
                                                "text": "¡Pedro! Te buscan."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0fae5221-1ec6-3b47-aeb4-03414bde219b",
                                        "entry_id": "ea88ecd7-efb4-3b2a-a67f-45fee8a5f51c",
                                        "glosses": [
                                            "Crear o causar una situación que produce cierto resultado, especialmente relacionado con enojo, riña o contrariedad."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afac696c-039d-4a75-87ae-f5604a5f718f",
                                                "sense_id": "0fae5221-1ec6-3b47-aeb4-03414bde219b",
                                                "text": "¡No me busques porque me voy a enojar!"
                                            },
                                            {
                                                "example_id": "73f059ac-14f0-4f94-84b3-94a56007347f",
                                                "sense_id": "0fae5221-1ec6-3b47-aeb4-03414bde219b",
                                                "text": "(pronominal) ¿Lo metieron a la cárcel? Bueno, él se lo buscó por andar buscando pelea."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7acb9430-33fb-3bdf-8ef3-4a4ee5e54dcb",
