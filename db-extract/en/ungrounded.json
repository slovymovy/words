                "senses": [
                    {
                        "sense_id": "8336c7e4-7ef0-3579-bb1e-4817e1d903d0",
                        "entry_id": "26f7b62d-f9ed-32e6-8948-b58a3ace8871",
                        "glosses": [
                            "Not grounded; without ground or basis, unreal, false."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2fd014b-97c1-401b-98ca-830beafdaa30",
                                "sense_id": "8336c7e4-7ef0-3579-bb1e-4817e1d903d0",
                                "text": "The defendant's claims are fictitious; they are entirely ungrounded in fact."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1a9fabe-85a0-3dfb-95e9-4f0f2e4d1bc5",
                        "entry_id": "26f7b62d-f9ed-32e6-8948-b58a3ace8871",
                        "glosses": [
                            "Not connected to ground potential"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7472f906-ad7b-459f-950a-badb482d1994",
                                "sense_id": "c1a9fabe-85a0-3dfb-95e9-4f0f2e4d1bc5",
                                "text": "Unlike coaxial cable where the outer conductor is grounded, twisted pair is usually ungrounded."
                            },
                            {
                                "example_id": "c31e2597-ca0b-4902-9f30-02af740e9175",
                                "sense_id": "c1a9fabe-85a0-3dfb-95e9-4f0f2e4d1bc5",
                                "text": "If the charge is allowed to build, the core will discharge into the hull of a ship. All ungrounded crew members are fried to a crisp, all electronic system are burned out, and metal bulkheads may be melted and fused together."
                            }
                        ]
                    }
                ],
