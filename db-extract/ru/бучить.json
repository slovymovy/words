                "senses": [
                    {
                        "sense_id": "6c048656-c5f8-33c1-8cf1-d2bcbdb1f5ed",
                        "entry_id": "79d603e3-2571-36fa-911d-8a369cfd3d1e",
                        "glosses": [
                            "текст. кипятить бельё или ткань в щёлоке для очистки и подготовки к белению, крашению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53674d63-a7cf-4c0d-81e8-13d05fcf2c63",
                                "sense_id": "6c048656-c5f8-33c1-8cf1-d2bcbdb1f5ed",
                                "text": "Вас надо учить и золою золить, и бучить, и мучить, да как придет время вас из бука вынимать, так вот тогда вы станете что-нибудь понимать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edba243c-2ef1-43a2-8541-b38700188c2f",
                        "source_entry_id": "79d603e3-2571-36fa-911d-8a369cfd3d1e",
                        "source_sense_id": "6c048656-c5f8-33c1-8cf1-d2bcbdb1f5ed",
                        "target_lang_word": "bauchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bauchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d628133-6a0d-349e-b0d2-954c10a1a751",
                                        "entry_id": "8e3c77a2-3f3d-3b64-b473-f55d44e47f9c",
                                        "glosses": [
                                            "sich wölben"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e0c7e6-e487-4436-bdcb-cc5e1bf3a9dc",
                                                "sense_id": "8d628133-6a0d-349e-b0d2-954c10a1a751",
                                                "text": "„Seine Weste war nur mit einem Knopf zugeknöpft und verschoben, sie bauchte sich über seinem starken Leib.“"
                                            },
                                            {
                                                "example_id": "e0ddd4d7-88aa-4998-828d-858a3aa0dcab",
                                                "sense_id": "8d628133-6a0d-349e-b0d2-954c10a1a751",
                                                "text": "„Das Großsegel bauchte sich im Wind, der Wind kam seitlich an.“"
                                            },
                                            {
                                                "example_id": "e69fe768-3e26-425a-993a-142198d0fb0c",
                                                "sense_id": "8d628133-6a0d-349e-b0d2-954c10a1a751",
                                                "text": "Einige bauchten sich oder hingen über anderen, einige liefen ihren Mitgeschöpfen zwischen den Füßen herum."
                                            },
                                            {
                                                "example_id": "7958d268-2c64-42e7-a601-b1b6d2c9338b",
                                                "sense_id": "8d628133-6a0d-349e-b0d2-954c10a1a751",
                                                "text": "Die Sonne schien, weiße Haufenwolken bauchten sich im Himmelblau, …"
                                            },
                                            {
                                                "example_id": "22e34ce8-7bab-4e97-9662-482b3e69c177",
                                                "sense_id": "8d628133-6a0d-349e-b0d2-954c10a1a751",
                                                "text": "Der architektonische Aufbau der Tische löst sich in geschwungenen Formen auf, die Stützen der Tische bauchen sich unter der Platte hervor und nehmen jene S-Formen an, die im Verlaufe des 18. Jahrh. zu allgemeiner Herrschaft kommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
