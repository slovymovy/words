                    "sense_id": "3aaebcf2-5d08-3268-a93d-1e94127bc0bc",
                    "sense_definition": "Слово, которое добавляют к просьбе, вопросу или предложению, чтобы они звучали вежливо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politeness_request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дайте мне, <w>пожалуйста</w>, чашку горячего чая.",
                            "target_lang_translations": {
                                "en": "Give me a cup of hot tea, <w>please</w>.",
                                "de": "Geben Sie mir <w>bitte</w> eine Tasse heißen Tee.",
                                "zh": "<w>请</w>给我一杯热茶。",
                                "nl": "Geef mij, <w>alstublieft</w>, een kop hete thee.",
                                "pl": "Proszę mi dać <w>proszę</w> filiżankę gorącej herbaty.",
                                "fr": "Donnez-moi, <w>s'il vous plaît</w>, une tasse de thé chaud.",
                                "it": "Mi dia, <w>per favore</w>, una tazza di tè caldo.",
                                "cs": "Dejte mi, <w>prosím</w>, šálek horkého čaje.",
                                "tr": "Bana bir fincan sıcak çay verir misiniz, <w>lütfen</w>?",
                                "es": "Dame, <w>por favor</w>, una taza de té caliente."
                            }
                        },
                        {
                            "text": "Скажите, <w>пожалуйста</w>, как пройти в библиотеку?",
                            "target_lang_translations": {
                                "en": "Could you tell me, <w>please</w>, how to get to the library?",
                                "de": "Sagen Sie mir <w>bitte</w>, wie komme ich zur Bibliothek?",
                                "zh": "<w>请</w>问，去图书馆怎么走？",
                                "nl": "Kunt u mij, <w>alstublieft</w>, vertellen hoe ik bij de bibliotheek kom?",
                                "pl": "Czy może mi pan/pani <w>proszę</w> powiedzieć, jak dojść do biblioteki?",
                                "fr": "Dites-moi, <w>s'il vous plaît</w>, comment aller à la bibliothèque ?",
                                "it": "Mi dica, <w>per favore</w>, come si arriva alla biblioteca?",
                                "cs": "Řekněte mi, <w>prosím</w>, jak se dostanu do knihovny?",
                                "tr": "Kütüphaneye nasıl gideceğimi söyler misiniz, <w>lütfen</w>?",
                                "es": "¿Me podría decir, <w>por favor</w>, cómo llegar a la biblioteca?"
                            }
                        },
                        {
                            "text": "Закройте, <w>пожалуйста</w>, окно, здесь очень холодно.",
                            "target_lang_translations": {
                                "en": "Close the window, <w>please</w>, it is very cold here.",
                                "de": "Schließen Sie <w>bitte</w> das Fenster, es ist sehr kalt hier.",
                                "zh": "<w>请</w>把窗户关上，这里太冷了。",
                                "nl": "Doe, <w>alstublieft</w>, het raam dicht, het is hier erg koud.",
                                "pl": "Proszę <w>proszę</w> zamknąć okno, jest tu bardzo zimno.",
                                "fr": "Fermez la fenêtre, <w>s'il vous plaît</w>, il fait très froid ici.",
                                "it": "Chiuda, <w>per favore</w>, la finestra, qui fa molto freddo.",
                                "cs": "Zavřete, <w>prosím</w>, okno, je tu velká zima.",
                                "tr": "Pencereyi kapatır mısınız <w>lütfen</w>, burası çok soğuk.",
                                "es": "Cierre la ventana, <w>por favor</w>, hace mucho frío aquí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "скажите пожалуйста",
                        "проходите пожалуйста"
