                "senses": [
                    {
                        "sense_id": "a64d21e1-4088-358b-8579-b02e987792af",
                        "entry_id": "956d6ac4-b865-3cfd-a389-927577902c92",
                        "glosses": [
                            "Qui ne peut pas se dégonfler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04ebc174-24b4-4aad-8df2-f23181f15cb0",
                                "sense_id": "a64d21e1-4088-358b-8579-b02e987792af",
                                "text": "Leur assurance indéconcertable d’être les premiers d’entre les mortels, leur sempiternelle vantardise, l’indégonflable vessie de leur bavardage et, surtout, l’exacerbante chaudronnerie de leur accent, les rendent à peu près abominables à tout le reste du genre humain."
                            },
                            {
                                "example_id": "f69849c0-5962-492e-b843-9d957a67a3cc",
                                "sense_id": "a64d21e1-4088-358b-8579-b02e987792af",
                                "text": "Le pneumatique que nous allons décrire, et dont nous donnerons ultérieurement le dessin en coupe, donne des résultats vraiment surprenants et paraît réaliser le pneu increvable, - ou mieux, indégonflable - tant cherché."
                            },
                            {
                                "example_id": "6e059062-1ca1-4a66-8933-8f805a4bd360",
                                "sense_id": "a64d21e1-4088-358b-8579-b02e987792af",
                                "text": "Vous pouvez, d’ailleurs, y piquer des épingles: c’est indégonflable, comme le pneu idéal."
                            }
                        ]
                    }
                ],
