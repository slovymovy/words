                                "sense_id": "19881553-2e40-3068-8ab8-e19ab5d05162",
                                "text": "[Jemand niest.] — “Hatschi!”",
                                "translation": "[Someone sneezes.] — “Bless you!”",
                                "english": "[Someone sneezes.] — “Bless you!”"
                            }
