                        "sense_id": "48f189ee-2bc2-3681-aeb3-d29c0f9e5a34",
                        "entry_id": "74e81f2c-a322-39f7-b364-5500152e0fe9",
                        "glosses": [
                            "alleen van dichtbij scherp kunnen zien"
