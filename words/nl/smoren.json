{
    "word_family": [
        "smoor",
        "smoring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e841b51-c350-3293-9419-860166e80a01",
                    "sense_definition": "voedsel zachtjes gaar laten worden in een gesloten pan met vet en weinig vocht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben het lamsvlees urenlang <w>gesmoord</w> met witte wijn en verse kruiden.",
                            "target_lang_translations": {
                                "en": "We <w>braised</w> the lamb for hours with white wine and fresh herbs."
                            }
                        },
                        {
                            "text": "Je kunt groenten heerlijk <w>smoren</w> in een beetje boter.",
                            "target_lang_translations": {
                                "en": "You can <w>stew</w> vegetables wonderfully in a little butter."
                            }
                        }
                    ],
                    "synonyms": [
                        "braiseren",
                        "sudderen"
                    ],
                    "common_phrases": [
                        "vlees smoren",
                        "zachtjes smoren"
                    ],
                    "target_lang_definitions": {
                        "en": "To cook food slowly in a closed pan with fat and a small amount of liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "braise",
                                "target_lang_sense_clarification": "to cook meat or vegetables slowly in a covered pot with a little liquid"
                            },
                            {
                                "target_lang_word": "stew",
                                "target_lang_sense_clarification": "to cook slowly in liquid"
                            },
                            {
                                "target_lang_word": "simmer",
                                "target_lang_sense_clarification": "to cook gently just below the boiling point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c340ddf2-4076-305d-be83-147d2665997c",
                    "sense_definition": "iemand of iets de adem afsnijden of verstikken door gebrek aan zuurstof",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verstikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dader probeerde het slachtoffer te <w>smoren</w> met een kussen.",
                            "target_lang_translations": {
                                "en": "The perpetrator tried to <w>smother</w> the victim with a pillow."
                            }
                        },
                        {
                            "text": "Het vuur werd snel <w>gesmoord</w> door er een deken overheen te gooien.",
                            "target_lang_translations": {
                                "en": "The fire was quickly <w>smothered</w> by throwing a blanket over it."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstikken"
                    ],
                    "common_phrases": [
                        "in de kiem smoren"
                    ],
                    "target_lang_definitions": {
                        "en": "To cut off someone's or something's breath, or to suffocate due to a lack of oxygen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smother",
                                "target_lang_sense_clarification": "to suffocate or extinguish by covering"
                            },
                            {
                                "target_lang_word": "suffocate",
                                "target_lang_sense_clarification": "to die or kill from lack of air"
                            },
                            {
                                "target_lang_word": "choke",
                                "target_lang_sense_clarification": "to prevent breathing by squeezing or blocking the windpipe"
                            },
                            {
                                "target_lang_word": "strangle",
                                "target_lang_sense_clarification": "to kill by squeezing the throat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "104deb20-7cfa-3d5e-8c62-07c41b0395d8",
                    "sense_definition": "een gevoel, geluid of opstand onderdrukken of tegenhouden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderdrukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeerde haar tranen te <w>smoren</w> toen ze het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "She tried to <w>stifle</w> her tears when she heard the bad news."
                            }
                        },
                        {
                            "text": "De politie wist de opstand direct in de kiem te <w>smoren</w>.",
                            "target_lang_translations": {
                                "en": "The police managed to <w>nip</w> the rebellion in the bud immediately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een opstand smoren",
                        "een geeuw smoren"
                    ],
                    "target_lang_definitions": {
                        "en": "To suppress, hold back, or stifle a feeling, sound, or rebellion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stifle",
                                "target_lang_sense_clarification": "to suppress a yawn, laugh, or feeling"
                            },
                            {
                                "target_lang_word": "smother",
                                "target_lang_sense_clarification": "to suppress or conceal a feeling or rebellion"
                            },
                            {
                                "target_lang_word": "suppress",
                                "target_lang_sense_clarification": "to forcibly put an end to something"
                            },
                            {
                                "target_lang_word": "nip in the bud",
                                "target_lang_sense_clarification": "to suppress something at an early stage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ff281b0-4dfb-3b1b-8fc3-69a58ec4530e",
                    "sense_definition": "het roken van cannabis of wiet",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "roken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zaten de hele avond op de bank wiet te <w>smoren</w>.",
                            "target_lang_translations": {
                                "en": "They sat on the couch <w>smoking</w> weed all evening."
                            }
                        },
                        {
                            "text": "Wat wij hier <w>smoren</w> is biologisch gekweekt.",
                            "target_lang_translations": {
                                "en": "What we <w>smoke</w> here is organically grown."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wiet smoren"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "voornamelijk gebruikt in informele straattaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To smoke cannabis or weed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smoke",
                                "target_lang_sense_clarification": "to inhale cannabis smoke"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "slang for smoking weed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a0b4d95-87af-3447-a671-14ec3c67d000",
                    "sense_definition": "kleien voorwerpen zoals dakpannen grijs kleuren door ze te bakken met een tekort aan zuurstof",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fabriek besloot de dakpannen te <w>smoren</w> voor een authentieke grijze kleur.",
                            "target_lang_translations": {
                                "en": "The factory decided to <w>blue</w> the roof tiles for an authentic grey color."
                            }
                        },
                        {
                            "text": "Deze traditioneel <w>gesmoorde</w> pannen zijn erg populair bij restauraties.",
                            "target_lang_translations": {
                                "en": "These traditionally <w>blued</w> tiles are very popular for restorations."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de pottenbakkers- en bouwindustrie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To color clay objects, such as roof tiles, grey by baking them in an oxygen-deprived kiln."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blue",
                                "target_lang_sense_clarification": "to fire clay tiles in a reduction kiln to turn them blue-grey"
                            },
                            {
                                "target_lang_word": "smother",
                                "target_lang_sense_clarification": "to reduce oxygen during the firing process of ceramics"
                            }
                        ]
                    }
                }
            ]
        }
    ]
