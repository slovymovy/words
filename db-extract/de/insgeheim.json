        "de-extract.jsonl": [
            {
                "entry_id": "d47a08ef-d68c-3a19-b0b1-76e540de7214",
                "word": "insgeheim",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "744c72fa-c57a-3db5-b4e9-3cbf0de3f3b2",
                        "entry_id": "d47a08ef-d68c-3a19-b0b1-76e540de7214",
                        "glosses": [
                            "im Geheimen, im Heimlichen, im Verborgenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c7fe69-f9dc-43d9-a447-a99471c23ba1",
                                "sense_id": "744c72fa-c57a-3db5-b4e9-3cbf0de3f3b2",
                                "text": "„Insgeheim hatte Roosevelt in der Tat Churchill versprochen, die US-Marine werde britischen Konvois zumindest auf der Hälfte der Strecke über den Atlantik Geleitschutz geben.“"
                            },
                            {
                                "example_id": "463571b0-01a7-40d0-8906-b7c53a7340ff",
                                "sense_id": "744c72fa-c57a-3db5-b4e9-3cbf0de3f3b2",
                                "text": "„Aber ich wusste, was ich wollte, und ich wusste insgeheim auch, dass ich es durchsetzen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bd31f6f-22be-44fd-976f-55dd2093cc1e",
                        "source_entry_id": "d47a08ef-d68c-3a19-b0b1-76e540de7214",
                        "source_sense_id": "744c72fa-c57a-3db5-b4e9-3cbf0de3f3b2",
