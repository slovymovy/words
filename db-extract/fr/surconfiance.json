                "word": "surconfiance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8cea29d-667d-3060-80a0-b85a67f404f6",
                        "entry_id": "e4d446e3-337b-3f24-a77b-4b7c859f1e38",
                        "glosses": [
                            "Excès de confiance en soi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a844964-ab70-4b44-a584-9acbbd9b51f4",
                                "sense_id": "f8cea29d-667d-3060-80a0-b85a67f404f6",
                                "text": "Dunning et Kruger mènent une enquête auprès d’étudiants, et parviennent à expliquer cet « effet de surconfiance »."
                            },
                            {
                                "example_id": "60a84bca-d0b6-44a3-97b1-a6e7b0551666",
                                "sense_id": "f8cea29d-667d-3060-80a0-b85a67f404f6",
                                "text": "Un sondage américain, devenu viral, révèle que près de la moitié des hommes pensent réussir l’atterrissage d’un avion en cas d’urgence. D’où vient cette apparente surconfiance masculine ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6a840d6-a6f2-4fe1-ae75-2d90869bbc5e",
                        "source_entry_id": "e4d446e3-337b-3f24-a77b-4b7c859f1e38",
                        "source_sense_id": "f8cea29d-667d-3060-80a0-b85a67f404f6",
                        "target_lang_word": "overconfidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overconfidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71cb3080-680e-363d-adf1-f1dc51060e09",
                                        "entry_id": "01a7ddbd-d276-3511-8f27-7fb9c61d093d",
                                        "glosses": [
                                            "An excessive or unwarranted degree of confidence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9668df-31a3-4b2c-813d-fe529a3bb7d5",
                                                "sense_id": "71cb3080-680e-363d-adf1-f1dc51060e09",
                                                "text": "My case is, as I have told you, almost complete; but we must not err on the side of over-confidence."
                                            },
                                            {
                                                "example_id": "8b439c9a-345b-4781-aca0-c28af52f45cd",
                                                "sense_id": "71cb3080-680e-363d-adf1-f1dc51060e09",
                                                "text": "Yet United may have paid the price for overconfidence as they completely lost their concentration after 10 minutes to let Wolves back in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
