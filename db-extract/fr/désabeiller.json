                "senses": [
                    {
                        "sense_id": "72d91173-accd-32de-9c90-74578a404da4",
                        "entry_id": "5705a1d5-a310-3d33-9fe7-dbcaf150509b",
                        "glosses": [
                            "Enlever les abeilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77dabccc-71ff-440f-b04f-f64342f77d7d",
                                "sense_id": "72d91173-accd-32de-9c90-74578a404da4",
                                "text": "Pour désabeiller plus vite que son ombre: poser la hausse et lancer le souffleur, pratique le tube rallonge!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c4af99f0-e10c-3803-86ce-0fcbe7790add",
                        "entry_id": "5705a1d5-a310-3d33-9fe7-dbcaf150509b",
                        "glosses": [
                            "Déshabiller."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "4da8fac9-f231-4da6-8b48-58c9ba3e6b62",
                                "sense_id": "c4af99f0-e10c-3803-86ce-0fcbe7790add",
                                "text": "Papa abeille rencontre maman abeille, Papa abeille la désabeille."
                            },
                            {
                                "example_id": "940807c9-bbfd-493e-8309-48d87ce7dc8d",
                                "sense_id": "c4af99f0-e10c-3803-86ce-0fcbe7790add",
                                "text": "Et le poète ne se contente pas de jouer sur les mots à des fins ludiques, il les déshabille – désabeille – comme une femme, il saisit, au-delà de ces jambes croisées, l'ouverture, l'abîme d'un regard et ménage par ses césures ou ses blancs l'accès à un ailleurs."
                            }
                        ]
                    }
                ],
