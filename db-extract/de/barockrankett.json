                        "examples": [
                            {
                                "example_id": "0be48b27-fb38-4990-9393-7b3b79965f67",
                                "sense_id": "d40fe9d2-3ad5-3105-bb27-3f6f7d4eff39",
                                "text": "Das Groß-Baßrankett hat mit 35 cm Länge denselben Tonumfang wie unser Kontrabaß. Nach dem Vorbild der Renaissance-Rankette wird gegen 1700 das sogenannte Barockrankett, Wurstfagott, Büchsenfagott oder Cervelat konstruiert, wegen seiner konischen Bohrung ist es aber eigentlich ein Fagott in Rankettform."
                            },
                            {
                                "example_id": "04bf2f91-07cf-40df-a13f-1c30c7c9d336",
                                "sense_id": "d40fe9d2-3ad5-3105-bb27-3f6f7d4eff39",
                                "text": "Einige der Oboen und deutschen Schalmeien sowie ein anonymes Barockrankett in der Sammlung des Haags Gemeentemuseum sind in gutem Spielzustand, andere sind weniger gut oder gar nicht spielbar."
                            },
                            {
                                "example_id": "8ce48c04-c7cf-41ca-8df0-4ce6e3ff37a7",
                                "sense_id": "d40fe9d2-3ad5-3105-bb27-3f6f7d4eff39",
                                "text": "Hallo,\nhabe ein Barockrankett (Moeck - 85/11 - 440 Hz.) VB 1000 DM zu verkaufen."
                            }
                        ]
                    }
