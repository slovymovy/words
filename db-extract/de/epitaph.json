                        ],
                        "form": "das Epitaph"
                    },
                    {
                        "form_id": "d702e2a4-5a19-4f15-84b0-c7589ec26823",
                        "entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Epitaphe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                        "entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                        "glosses": [
                            "Grabschrift, Grabinschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7636bebe-52c3-4c72-91a8-a3bbe89212af",
                                "sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                                "text": "Auf dem Grabstein stand ein Epitaph: \"Hier ruht …\"."
                            },
                            {
                                "example_id": "10005b62-6162-4a5e-83ff-60a825e8dfa9",
                                "sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                                "text": "„Ihn faszinierten die geheimnisvolle Atmosphäre, die seltsamen Epitaphe in hebräischer Sprache, das Gebüsch und der Nebel, der über den Matzewas schwebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3266221f-b7c9-382e-810a-61c42e4290ac",
                        "entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                        "glosses": [
                            "Gedenktafel für einen Verstorbenen an der Kirchenwand, ohne Verbindung zu einem Grab"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a929cd-919b-4f49-ab2d-bf759234204a",
                                "sense_id": "3266221f-b7c9-382e-810a-61c42e4290ac",
                                "text": "„Viele der barocken Grabsteine stammen noch aus dem alten Kirchhof der Dreikönigskirche; einige der Epitaphe aus der alten Kirche selbst.“"
                            },
                            {
                                "example_id": "c48b52a9-9770-499f-9a51-b64e0f59e707",
                                "sense_id": "3266221f-b7c9-382e-810a-61c42e4290ac",
                                "text": "„Es schien mir ein passendes Epitaph für meine Anstrengungen zu sein, wenn ich sie denn irgendwann würde aufgeben müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fed64ad-7889-44bc-8d18-43a2aa27c19f",
                        "source_entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                        "source_sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                        "source_sense_description": "Grabschrift, Grabinschrift",
                        "target_lang_word": "epitaph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epitaph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f09de21a-e971-36ed-a91f-f47807a3ff79",
                                        "entry_id": "81ceb619-888b-31bd-82ba-7924549b9b9e",
                                        "glosses": [
                                            "An inscription on a gravestone in memory of the deceased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f85c7f-aafa-4492-83f8-3a6ba32c49ce",
                                                "sense_id": "f09de21a-e971-36ed-a91f-f47807a3ff79",
                                                "text": "The church itself, or at all events the squat and tiny tower, has not altered much since Lamb saw it. But the epitaphs have gone. Search among the ivies and yews of the shady little churchyard will discover a number of flat, weatherworn slabs of stone, but the verses and the signatures have vanished."
                                            },
                                            {
                                                "example_id": "8a7a9208-1bcc-45f2-b119-5017fdb78802",
                                                "sense_id": "f09de21a-e971-36ed-a91f-f47807a3ff79",
                                                "text": "Ayot St Lawrence's most famous inhabitant, George Bernard Shaw, moved into the New Rectory in 1906 because, it is said, of a gravestone epitaph in the churchyard. This recorded the death of a woman who lived to be 70 with the comment 'Her time was short'. Shaw thought that a place that considered a life of 70 years short was the right place for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "218f2d74-9fa6-3dd4-a907-c47100341f18",
                                        "entry_id": "81ceb619-888b-31bd-82ba-7924549b9b9e",
                                        "glosses": [
                                            "A poem or other short text written in memory of a deceased person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80979d30-8694-46a1-9432-7d3f55520fd9",
                                                "sense_id": "218f2d74-9fa6-3dd4-a907-c47100341f18",
                                                "text": "Nam vinci in amore turpissimum putant, not only living, but when their friends are dead, with tombs and monuments, nenias, epitaphs, elegies, inscriptions, pyramids, obelisks, statues, images, pictures, histories, poems, annals, feasts, anniversaries, many ages after (as Plato's scholars did) they will parentare still, omit no good office that may tend to the preservation of their names, honours, and eternal memory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "epitaph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a5703be-0b29-34be-b6e8-106239d5f887",
                                        "entry_id": "02367114-cd7f-3b45-ad43-2da28cc19f87",
                                        "glosses": [
                                            "To write or speak after the manner of an epitaph."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9312406c-263f-4d5a-8549-45a2d74f9c3d",
                                                "sense_id": "0a5703be-0b29-34be-b6e8-106239d5f887",
                                                "text": "The Commons in their speeches epitaph upon him […] \"He lived as a wolf and died as a dog.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5238d5a6-244e-37f2-b30c-9391443b201b",
                                        "entry_id": "02367114-cd7f-3b45-ad43-2da28cc19f87",
                                        "glosses": [
                                            "To commemorate by an epitaph."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca038fa-b18e-4ce2-ab44-0ad3512ba4a8",
                                                "sense_id": "5238d5a6-244e-37f2-b30c-9391443b201b",
                                                "text": "Let me rather be epitaphed the inventor of the English Hexameter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a609762-7db8-4fbf-85c5-e3d3795a4c21",
                        "source_entry_id": "9383fe32-0772-3bc5-b95c-d8db2ccd6426",
                        "source_sense_id": "026c151d-9dea-3be2-a28b-c6e1e1574e43",
                        "source_sense_description": "Grabschrift, Grabinschrift",
                        "target_lang_word": "épitaphe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épitaphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad0c8f7e-2b9f-3dc4-aca9-f468df85b004",
                                        "entry_id": "06e1868d-9436-3338-8de6-1c208f0ab7f4",
                                        "glosses": [
                                            "Inscription sur un tombeau qui célèbre, ou simplement désigne, la personne qui y est ensevelie."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617e2a7d-8301-42c8-b788-590d0f4e4a67",
                                                "sense_id": "ad0c8f7e-2b9f-3dc4-aca9-f468df85b004",
                                                "text": "Cette inscription est pour la jeune fille ce qu’une épitaphe est pour beaucoup de morts, la table des matières d’un livre inconnu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e28415ae-6937-3195-a2bd-056182b86d07",
                                        "entry_id": "06e1868d-9436-3338-8de6-1c208f0ab7f4",
                                        "glosses": [
                                            "Oraison funèbre, petit poème à vocation nécrologique."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeaa61c9-fcfd-4fe0-a09b-9924b385b0fc",
                                                "sense_id": "e28415ae-6937-3195-a2bd-056182b86d07",
                                                "text": "L’Épitaphe de Rabelais, composée par Ronsard"
                                            },
                                            {
                                                "example_id": "8d999057-0e35-4255-8dd7-fb9ad6e8a0d7",
                                                "sense_id": "e28415ae-6937-3195-a2bd-056182b86d07",
                                                "text": "Au bout de cinq minutes, le premier acte du Vengeur était joué et Rodolphe avait écrit trois vers de son épitaphe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "657000fe-44e6-30c4-85e0-af58363c73d7",
                                        "entry_id": "06e1868d-9436-3338-8de6-1c208f0ab7f4",
                                        "glosses": [
                                            "Tablette portant une inscription funéraire."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
