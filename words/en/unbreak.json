    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11dca090-c84c-3947-b9bc-fd258b1730e1",
                    "sense_definition": "To undo the act of breaking; to restore, mend, or make whole again something that was broken.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wished she could <w>unbreak</w> the antique vase, but the delicate pieces were shattered beyond repair.",
                            "target_lang_translations": {
                                "ru": "Она желала бы вернуть старинной вазе целостность и <w>склеить</w> её, но хрупкие осколки разбились без шанса на восстановление."
                            }
                        },
                        {
                            "text": "No simple apology could <w>unbreak</w> the trust that had taken years to build.",
                            "target_lang_translations": {
                                "ru": "Никакие простые извинения не могли <w>восстановить</w> доверие, строившееся годами."
                            }
                        }
                    ],
                    "synonyms": [
                        "mend",
                        "repair",
                        "restore"
                    ],
                    "antonyms": [
                        "break",
                        "shatter"
                    ],
                    "common_phrases": [
                        "unbreak my heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обратить вспять поломку или разрушение; восстановить, починить или сделать снова целым то, что было разбито или сломано."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановить",
                                "target_lang_sense_clarification": "вернуть в прежнее целое состояние"
                            },
                            {
                                "target_lang_word": "склеить",
                                "target_lang_sense_clarification": "соединить разбитые части"
                            },
                            {
                                "target_lang_word": "починить",
                                "target_lang_sense_clarification": "исправить сломанное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
