                "translations": [
                    {
                        "translation_id": "c90d4074-562a-4c37-9b23-296922ec304a",
                        "source_entry_id": "084262b6-355a-3351-be42-c925958e87d9",
                        "target_lang_word": "chevreau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevreau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "158ffb63-d125-3a56-8ca9-39686ee65d19",
                                        "entry_id": "66de2ae5-51a2-3a86-9565-b17aa7ac4d67",
                                        "glosses": [
                                            "Petit d’une chèvre."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f440b67-fe03-4068-ba49-d51100791875",
                                                "sense_id": "158ffb63-d125-3a56-8ca9-39686ee65d19",
                                                "text": "Parmi tous ceux qui vinrent serrer la main du jeune chef de parti, l’abbé de Gondi bondissait comme un chevreau. , 1826"
                                            },
                                            {
                                                "example_id": "0a8faecd-fb51-4a20-a0e3-32e3e187710e",
                                                "sense_id": "158ffb63-d125-3a56-8ca9-39686ee65d19",
                                                "text": "Le visiteur songe avec tendresse au beau dessin que Navez, le meilleur élève du vieux David exilé à Bruxelles, fit autrefois du gracieux Louis, pareil à un enfant de bas-relief antique, serrant contre soi son chevreau familier…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61f55a4-a129-3353-9533-ee27f374f19c",
                                        "entry_id": "66de2ae5-51a2-3a86-9565-b17aa7ac4d67",
                                        "glosses": [
                                            "Peau de chèvre ou de chevreau préparée."
                                        ],
                                        "tags": [
                                            "Mégisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d8f694-2682-4646-8d79-f2d87952295a",
                                                "sense_id": "d61f55a4-a129-3353-9533-ee27f374f19c",
                                                "text": "Déjà il avait vendu à madame Desforges douze paires de gants de chevreau."
                                            },
                                            {
                                                "example_id": "67701f9e-5a63-4c1f-844f-dd2cf0c570af",
                                                "sense_id": "d61f55a4-a129-3353-9533-ee27f374f19c",
                                                "text": "[…], il venait d'apercevoir, penchée sur un morceau de chevreau auquel elle cousait des élastiques, la silhouette invraisemblable, mais trop connue pour qu'il s'y trompât, d'une ancienne greloteuse haut cotée sur l’asphalte parisien."
                                            },
                                            {
                                                "example_id": "146bfd72-bae1-44c2-9b02-8163502b50a5",
                                                "sense_id": "d61f55a4-a129-3353-9533-ee27f374f19c",
                                                "text": "Maigret n’avait pas vu l’homme du train en face. Il ne connaissait de lui qu’une vague silhouette, des chaussures en chevreau verni et des chaussettes de laine grise…"
                                            },
                                            {
                                                "example_id": "87d6f3b2-db69-450c-aafe-8833b1175510",
                                                "sense_id": "d61f55a4-a129-3353-9533-ee27f374f19c",
                                                "text": "Il l’avait d’abord trouvée si gourmée qu’il lui avait dit en riant : « Vous prenez la vie avec des gants de chevreau glacé. » Elle en avait été très mortifiée : elle avait décidé d’ôter ses gants."
                                            },
                                            {
                                                "example_id": "eb466e65-42db-4001-bad8-67d77fe47d0b",
                                                "sense_id": "d61f55a4-a129-3353-9533-ee27f374f19c",
                                                "text": "Le capitaine badin jusqu’au bout de sa badine passa son doigt ganté de chevreau blanc sur la culasse luisante de graisse de son pistolet-mitrailleur démonté et le considéra souillé en demandant d’un ton où l’insolence le disputait à la perplexité : « C’est ça que vous appelez un pistolet-mitrailleur propre ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e47127a3-6c11-34ba-8212-90c11e4ee7b9",
                                        "entry_id": "66de2ae5-51a2-3a86-9565-b17aa7ac4d67",
                                        "glosses": [
                                            "Viande de cet animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6623c02f-3da1-4850-9a4a-29aa34b7c6dc",
                                                "sense_id": "e47127a3-6c11-34ba-8212-90c11e4ee7b9",
                                                "text": "[…] ; puis il prit sur la grande table une portion de soupe et de chevreau bouilli, la plaça sur la petite table où il avait soupé lui-même, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
