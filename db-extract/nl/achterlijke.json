                                "sense_id": "c75ec139-5fcb-35b2-95c6-32ed0423ca01",
                                "text": "Het zijn een stelletje achterlijken, daar in Hilversum."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb9aaf2a-3a97-3644-851d-50e61534cd5c",
                        "entry_id": "074d3c80-fb7f-323b-aed0-106f2cbadd8d",
                        "glosses": [
                            "ouderwets, niet voldoend aan de huidige eisen"
