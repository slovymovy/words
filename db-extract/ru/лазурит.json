                "translations": [
                    {
                        "translation_id": "5f595173-48cb-4444-8779-119c89d92915",
                        "source_entry_id": "fb5e11be-78b2-3494-9c0f-200136f188cf",
                        "target_lang_word": "lapis lazuli",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapis lazuli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c525de89-ec74-3917-9a86-ed1122d5d34d",
                                        "entry_id": "7dc004b5-8bf6-38f6-8ac2-78883a2a94f0",
                                        "glosses": [
                                            "A deep blue stone, used in making jewelry, and traditionally used to make the pigment ultramarine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2d3752a-797a-42a3-b90f-c9003f73ee7f",
                                                "sense_id": "c525de89-ec74-3917-9a86-ed1122d5d34d",
                                                "text": "He saw the amber silk curtains wave to and fro: the middle window was open; in it stood a pillar of lapis lazuli, which supported an alabaster figure, Canova's Dansatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba62064-7b07-3b94-a95b-1029fa013a23",
                                        "entry_id": "7dc004b5-8bf6-38f6-8ac2-78883a2a94f0",
                                        "glosses": [
                                            "A deep, bright blue, like that of the stone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lapis lazuli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f767bce-2077-376f-ae58-7de74598d062",
                                        "entry_id": "f21cbcb1-666e-3fc6-9c0b-2c3691c7e497",
                                        "glosses": [
                                            "Of a deep, bright blue, like that of the stone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63618a59-8871-4710-8d99-58e5d8ccc25e",
                                                "sense_id": "1f767bce-2077-376f-ae58-7de74598d062",
                                                "text": "I cannot convey to you the sheer and surreal scale of everything: the towering ship, the ropes, the ties, the anchor, the pier, the vast lapis lazuli dome of the sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7835724-d629-4234-ad0b-a3e678c72c13",
