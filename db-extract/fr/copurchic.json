            {
                "entry_id": "38b82680-d98e-3e04-a4fe-bf8037395d77",
                "word": "copurchic",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9cc17fcf-7b2c-4c79-8f58-394baaf53348",
