                            {
                                "example_id": "b553afbf-f952-4d02-8240-1a49e842702f",
                                "sense_id": "debb488f-aae7-388c-a4e7-fa74d9d09ced",
                                "text": "Neem Koos Konijn, de pluche mascotte van Roompot Vakanties. Op zijn fanweekend – dit jaar georganiseerd op vakantiepark Weerterbergen – komen meer dan tweeduizend bezoekers af. Koos Konijn danst, knuffelt, knutselt en geen kind blijft ongeschminkt."
                            },
                            {
                                "example_id": "db1b29bd-b92d-49ea-8635-cb404ca484aa",
                                "sense_id": "debb488f-aae7-388c-a4e7-fa74d9d09ced",
                                "text": "Als ik me extravagant voel, wil ik mijn lippen paars kunnen stiften. Als ik me ingetogen voel, wil ik met ongeschminkte wangen naar buiten kunnen lopen zonder daar een opmerking over te hoeven verwachten."
                            }
                        ]
