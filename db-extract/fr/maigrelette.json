                                "sense_id": "946587d1-7c82-39aa-8fc0-294ec3f84dcc",
                                "text": "Ses petits pas secs, le claquement de ses jupes contre ses cannes maigrelettes."
                            },
                            {
                                "example_id": "9d0a08e5-636b-49f3-bfda-63977e284eaa",
                                "sense_id": "946587d1-7c82-39aa-8fc0-294ec3f84dcc",
                                "text": "- Bon allez, à table, tout le monde ! Il faut que tu te remplumes, toi. Que tu vas devenir toute maigrelette !"
                            }
                        ]
                    }
