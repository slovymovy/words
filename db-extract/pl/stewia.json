                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d5d8390-98d9-3d2a-9c33-6ce3ed439092",
                        "entry_id": "f75f6575-4b05-39c8-9ba2-b2985ce89e88",
                        "glosses": [
                            "Stevia Cavanilles, jeden z rodzajów roślin z rodziny astrowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca41145-c2f0-4407-92dc-e65d6918f39b",
                                "sense_id": "8d5d8390-98d9-3d2a-9c33-6ce3ed439092",
                                "text": "Liczne gatunki stewii występują w Ameryce od Chile po północny Meksyk."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4d555c34-f4f5-38a0-9007-358cf8f5397b",
                        "entry_id": "f75f6575-4b05-39c8-9ba2-b2985ce89e88",
                        "glosses": [
                            "naturalna substancja słodząca w postaci sproszkowanych liści i pąków albo skrystalizowanego ekstraktu ze Stevia rebaudiana, uprawnego gatunku stewii (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c19286e-5bb4-49af-ad22-fa23c2bffa32",
                                "sense_id": "4d555c34-f4f5-38a0-9007-358cf8f5397b",
                                "text": "Stewia jest około 300 razy słodsza od białego cukru."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85172f25-add9-41a7-8e98-e822d331b446",
                        "source_entry_id": "f75f6575-4b05-39c8-9ba2-b2985ce89e88",
                        "source_sense_id": "8d5d8390-98d9-3d2a-9c33-6ce3ed439092",
                        "target_lang_word": "stevia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stevia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ca5dc82-b62c-38de-8498-639fb03f1439",
                                        "entry_id": "eb674a80-4e66-303a-994a-76dee04f2cf0",
                                        "glosses": [
                                            "Any of the sweet herbs of genus Stevia, native to tropical and subtropical regions of South America and western North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea470bc3-b5ad-4ff9-831b-e8a42c20b5e2",
                                                "sense_id": "2ca5dc82-b62c-38de-8498-639fb03f1439",
                                                "text": "A naturally sweet herb called stevia is gaining in popularity as a sugar substitute, especially in beverages. Food additives must provide evidence of their safety and effectiveness before receiving FDA approval, and stevia lacks this approval for use as a sweetener because so little is known about its effects on human health, save that it can be absorbed by the human digestive tract."
                                            },
                                            {
                                                "example_id": "c8ec7f71-a19f-4979-acb4-ae40cac776b6",
                                                "sense_id": "2ca5dc82-b62c-38de-8498-639fb03f1439",
                                                "text": "Another natural sweetener comes from the stevia plant. In December 2008, the Food and Drug Administration (FDA) gave a “generally recognized as safe” status to Truvia and PureVia, both of which are wholly derived from the stevia plant and have no calories."
                                            },
                                            {
                                                "example_id": "de0e95a3-ab1a-4ede-8400-8a1cfcb3e89b",
                                                "sense_id": "2ca5dc82-b62c-38de-8498-639fb03f1439",
                                                "text": "My absolute preference for a sweetener is the herb stevia—not the white crystalline extract, but the chopped green leaves. Stevia has no calories and does not cause any insulin response."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb1a1dc-44cc-3af3-a820-094df0f0887a",
                                        "entry_id": "eb674a80-4e66-303a-994a-76dee04f2cf0",
                                        "glosses": [
                                            "A sweetener, many times sweeter than an equal amount of sugar, extracted from Stevia rebaudiana, that can be substituted for sugar for some purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fea009-c99b-412e-ba6b-dbf63a732ce2",
                                                "sense_id": "deb1a1dc-44cc-3af3-a820-094df0f0887a",
                                                "text": "Stevia is a natural, non-fattening sweetener that is 30 to 100 times sweeter than sugar and without any of the aftertaste that is common in many sugar substitutes."
                                            },
                                            {
                                                "example_id": "540b38f8-51b2-453f-b0a3-c75863cd8db4",
                                                "sense_id": "deb1a1dc-44cc-3af3-a820-094df0f0887a",
                                                "text": "Around 1970, Japan approved stevia as a sweetener and flavor enhancer, and, in the last 35 years of Japanese employment, not a single case of toxic or deleterious effect has been brought to light."
                                            },
                                            {
                                                "example_id": "1940e84f-dc9b-4137-b86e-32c09738b3bb",
                                                "sense_id": "deb1a1dc-44cc-3af3-a820-094df0f0887a",
                                                "text": "Stevia is made from the leaves of a small shrub found largely in South America and China, and has been used by indigenous peoples for hundreds of years. It is considered one of the healthiest sweeteners available, and often used as a tonic for healing wounds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0181518-55b6-4c7a-b330-cc2befab7cc6",
                        "source_entry_id": "f75f6575-4b05-39c8-9ba2-b2985ce89e88",
                        "source_sense_id": "8d5d8390-98d9-3d2a-9c33-6ce3ed439092",
