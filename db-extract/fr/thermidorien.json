                "senses": [
                    {
                        "sense_id": "83f1157c-740b-3cb1-a779-eb9df5e03532",
                        "entry_id": "dc380e9a-7366-3f3a-aa95-82ed92c302fd",
                        "glosses": [
                            "Relatif au parti qui, le 9 thermidor de l’an II (27 juillet 1794), renversa le gouvernement de Robespierre et mit fin à la Terreur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f045cf66-50e2-42bf-9f06-5e5c52820ceb",
                                "sense_id": "83f1157c-740b-3cb1-a779-eb9df5e03532",
                                "text": "L’opposition y dénonce le péril thermidorien ; le mot est sans cesse sur toutes les bouches. Le souvenir de la fin de Robespierre hante tous ces hommes."
                            },
                            {
                                "example_id": "469e9bc6-5777-44bb-91b4-41cb2a829070",
                                "sense_id": "83f1157c-740b-3cb1-a779-eb9df5e03532",
                                "text": "Beaucoup plus sagement exécutée, l’histoire de M. Laponneraye mérite d’être rangée au nombre des ouvrages qui ont défendu la cause populaire. Ce qu’on peut reprocher à l’auteur, c’est d’avoir montré trop de faiblesse pour le parti ultrarévolutionnaire, dont l’exagération et le caractère indisciplinable fut une des principales causes du succès de la réaction thermidorienne."
                            }
                        ]
                    }
                ],
