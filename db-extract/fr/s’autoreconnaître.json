                ],
                "senses": [
                    {
                        "sense_id": "d1d17fe6-5920-3841-8b79-fe37e75799c6",
                        "entry_id": "74889687-cd74-3d27-a6c1-e3d7fdfe619d",
                        "glosses": [
                            "Se reconnaître soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80217469-9907-4121-bdfa-36f7d3c2a6c4",
                                "sense_id": "d1d17fe6-5920-3841-8b79-fe37e75799c6",
                                "text": "Quand il cesse de s’autoreconnaître, de réfléchir sur lui-même, l’imaginaire collectif se cristallise et donne lieu à des institutions oppressives."
                            },
                            {
                                "example_id": "a5a27ceb-376b-45f6-b2a8-5596206c19fb",
                                "sense_id": "d1d17fe6-5920-3841-8b79-fe37e75799c6",
                                "text": "Massage qui touche le Ciel et la Terre, il recentre la personne, il l’aide aussi à s’autoreconnaître et à prendre conscience d’elle-même."
                            },
                            {
                                "example_id": "d3c01504-f6e7-4a65-8197-077bcbe60aec",
                                "sense_id": "d1d17fe6-5920-3841-8b79-fe37e75799c6",
                                "text": "L’être humain ne peut pas s’autoreconnaître, l’autonomie ne peut exister que si la personne existe pour d’autres sujets, dans d’autres groupes."
                            }
                        ]
                    }
                ],
