                                    },
                                    {
                                        "sense_id": "43b0f9bb-9558-3f3c-93c1-478f4676ea66",
                                        "entry_id": "2edc10b7-fc27-3b7b-bd98-8b5601ec20d2",
                                        "glosses": [
                                            "A recording of such music for sale."
