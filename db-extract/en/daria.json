                    {
                        "translation_id": "893b83f6-0227-4913-82ee-00115226219a",
                        "source_entry_id": "dce68465-c64d-3ae9-baf9-e48350b553a5",
                        "source_sense_id": "ce4e7313-f13e-3704-8a6b-5fc910881a07",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Дарья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Дарья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "166e08ee-764c-323d-bf7a-e62d318f4e17",
                                        "entry_id": "69a19345-029e-39ca-a178-c1377ba449d9",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf38927-209a-45b3-b856-0109a377c24d",
                                                "sense_id": "166e08ee-764c-323d-bf7a-e62d318f4e17",
                                                "text": "— Дарья Александровна приказали доложить, что они уезжают."
                                            },
                                            {
                                                "example_id": "b9d23246-08aa-4369-9b46-745cc1dfbc04",
                                                "sense_id": "166e08ee-764c-323d-bf7a-e62d318f4e17",
                                                "text": "Отворила Дарья дверцу и чуть не убилась ― в глазах помутнело: в огромной клети кипело настоящее золото. И захотелось Дарье потрогать золото, сунула она палец, и стал палец золотым. Пришёл Медведь, принёс малины. Сели за стол. Пьют чай."
                                            },
                                            {
                                                "example_id": "68a679fa-36b8-44ca-b5b3-ddd14f0e62f1",
                                                "sense_id": "166e08ee-764c-323d-bf7a-e62d318f4e17",
                                                "text": "«Ты позови Наталью, Матрёну, Дарью, Алёну, Аксинью, а Аграфену не зови, она к нашему голосу не подладит» ― говорили колхозницы-певицы участнику бригады, записывавшей песни в деревне Муняково Старожиловского района, Московской области."
                                            },
                                            {
                                                "example_id": "3debd50d-74cd-4ecf-9004-ba4324952eba",
                                                "sense_id": "166e08ee-764c-323d-bf7a-e62d318f4e17",
                                                "text": "А дочь моей дочери, моя внучка, стала именоваться Дарьей, как мать бабули."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
