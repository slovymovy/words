                    "sense_id": "fc26db0d-8833-3c40-b621-c3b8e2d58289",
                    "sense_definition": "Ergens genoeg van hebben en het niet langer willen verdragen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fed_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben jouw eindeloze smoesjes nu echt helemaal <w>zat</w>.",
                            "target_lang_translations": {
                                "en": "I am really completely <w>fed up</w> with your endless excuses now.",
                                "ru": "Я уже <w>сыт по горло</w> твоими бесконечными отговорками.",
                                "fr": "J'<w>en ai</w> vraiment complètement <w>marre</w> de tes excuses sans fin maintenant."
                            }
                        },
                        {
                            "text": "Na een uur wachten was ze het <w>zat</w> en ging ze naar huis.",
                            "target_lang_translations": {
                                "en": "After waiting for an hour, she was <w>fed up</w> with it and went home.",
                                "ru": "Прождав час, ей это <w>надоело</w>, и она пошла домой.",
                                "fr": "Après une heure d'attente, elle <w>en a eu marre</w> et est rentrée chez elle."
