                        "glosses": [
                            "Reconnaissance d'un personnage après une longue séparation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6ba6e7-8241-4325-978e-21805876fe7a",
                                "sense_id": "6b43766e-8039-32f3-9c27-747e189ffd44",
                                "text": "Une agnition peut être un enfant enlevé à ses parents à la naissance, une famille séparée par un naufrage des années auparavant, etc."
                            },
                            {
                                "example_id": "6c641323-cac6-403e-8b6e-bc694f95296c",
                                "sense_id": "6b43766e-8039-32f3-9c27-747e189ffd44",
                                "text": "Face à l’agnition, soit on réagit avec simplicité, en jouant le jeu du narrateur, soit on y réfléchit à partir des modes de la narratologie."
                            }
                        ]
                    }
