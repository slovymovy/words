    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9d22284-cc30-38a9-b155-5f50bd7ec58a",
                    "sense_definition": "Een kleverige vloeistof die door de slijmvliezen van mensen of dieren wordt uitgescheiden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologische_vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij een verkoudheid produceren de luchtwegen vaak veel extra <w>slijm</w>.",
                            "target_lang_translations": {
                                "en": "With a cold, the airways often produce a lot of extra <w>mucus</w>."
                            }
                        },
                        {
                            "text": "Het ophoesten van <w>slijm</w> kan pijnlijk zijn als je een zware keelontsteking hebt.",
                            "target_lang_translations": {
                                "en": "Coughing up <w>phlegm</w> can be painful if you have a severe throat infection."
                            }
                        }
                    ],
                    "synonyms": [
                        "flegma"
                    ],
                    "common_phrases": [
                        "ophoesten van slijm",
                        "taai slijm"
                    ],
                    "target_lang_definitions": {
                        "en": "A sticky fluid secreted by the mucous membranes of humans or animals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mucus",
                                "target_lang_sense_clarification": "biological secretion"
                            },
                            {
                                "target_lang_word": "phlegm",
                                "target_lang_sense_clarification": "thick mucus in the respiratory passages"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f61e1e-5dc0-35e6-b572-b309f9ab7716",
                    "sense_definition": "Een algemene benaming voor een dikke, kleverige of glibberige substantie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bodem van de oude vijver was bedekt met een dikke laag groen <w>slijm</w>.",
                            "target_lang_translations": {
                                "en": "The bottom of the old pond was covered with a thick layer of green <w>slime</w>."
                            }
                        },
                        {
                            "text": "Kinderen vinden het vaak leuk om met zelfgemaakt <w>slijm</w> te spelen.",
                            "target_lang_translations": {
                                "en": "Children often enjoy playing with homemade <w>slime</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drab",
                        "smurrie"
                    ],
                    "common_phrases": [
                        "laag slijm",
                        "groen slijm"
                    ],
                    "target_lang_definitions": {
                        "en": "A general term for a thick, sticky, or slippery substance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slime",
                                "target_lang_sense_clarification": "slippery or gooey substance"
                            },
                            {
                                "target_lang_word": "goo",
                                "target_lang_sense_clarification": "informal term for sticky matter"
                            },
                            {
                                "target_lang_word": "gunk",
                                "target_lang_sense_clarification": "unpleasant sticky substance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b593fbe-dc36-34a8-8005-d7ad62b03c28",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>slijmen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>slijm</w> nooit bij mijn baas om een loonsverhoging te krijgen.",
                            "target_lang_translations": {
                                "en": "I never <w>suck up</w> to my boss to get a raise."
                            }
                        },
                        {
                            "text": "Als ik <w>slijm</w>, dan doe ik dat alleen omdat ik echt iets nodig heb.",
                            "target_lang_translations": {
                                "en": "If I <w>brown-nose</w>, I only do it because I really need something."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'slijmen' (to suck up to someone)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suck up",
                                "target_lang_sense_clarification": "to flatter someone for personal gain"
                            },
                            {
                                "target_lang_word": "brown-nose",
                                "target_lang_sense_clarification": "informal term for excessive flattery"
                            },
                            {
                                "target_lang_word": "butter up",
                                "target_lang_sense_clarification": "to be nice to someone to get a favor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}