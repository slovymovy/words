                        "examples": [
                            {
                                "example_id": "bf035744-32ee-4905-976c-223f5bcf976a",
                                "sense_id": "6167bdd8-afbb-31e0-8777-663a5e45f949",
                                "text": "Jack was een kale man van in de zestig die 35 jaar geleden zelf de PCT had gelopen."
                            },
                            {
                                "example_id": "181ef0a6-8fff-4037-aaf4-5288d0b3a8f8",
                                "sense_id": "6167bdd8-afbb-31e0-8777-663a5e45f949",
                                "text": "De man en de vrouw kwamen naar het huis gelopen, allebei met de zekere pas van berggeiten, terwijl ze konijnenholen en kleine stenen ontweken in hun ogenschijnlijk onwrikbare verlangen dichterbij te komen."
                            }
                        ]
                    }
