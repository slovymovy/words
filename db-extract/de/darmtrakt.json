                ],
                "senses": [
                    {
                        "sense_id": "2adcfcc4-7b19-3b79-b8b6-ec774531a137",
                        "entry_id": "b4c8caa9-185c-33f8-bcc0-8ed88c751b99",
                        "glosses": [
                            "gesamter Strang des Darms vom Magenausgang bis zum After"
                        ],
                        "tags": [
                            "beim Menschen und bei Wirbeltieren"
                        ],
                        "examples": [
                            {
                                "example_id": "bd5ec86b-a1a5-40aa-bed1-6896407448db",
                                "sense_id": "2adcfcc4-7b19-3b79-b8b6-ec774531a137",
                                "text": "Oft ist mangelnde Hygiene schuld an der Keimübertragung - etwa, wenn beim Schlachten des Geflügels das Fleisch mit Gefieder oder Darmtrakt in Berührung kommt."
                            },
                            {
                                "example_id": "9833585b-3f9b-4daa-ae04-df0fe7d912b8",
                                "sense_id": "2adcfcc4-7b19-3b79-b8b6-ec774531a137",
                                "text": "Salmonellen werden meist über Lebensmittel aufgenommen und machen sich vor allem im Darmtrakt breit."
                            },
                            {
                                "example_id": "32359529-b59b-4ae3-a830-2651222036a7",
                                "sense_id": "2adcfcc4-7b19-3b79-b8b6-ec774531a137",
                                "text": "1962 behauptet John Gurdon von der Universität Oxford, er habe voll ausdifferenzierte Zellen aus dem Darmtrakt von südafrikanischen Fröschen geklont."
                            },
                            {
                                "example_id": "e5678831-e53f-429b-ae56-09b44497b3ae",
                                "sense_id": "2adcfcc4-7b19-3b79-b8b6-ec774531a137",
                                "text": "Bei komplizierten entzündlichen Darmerkrankungen, bei Darmkrebs oder bei immer wiederkehrenden Entzündungen im Darmtrakt sind operative Eingriffe notwendig."
                            },
                            {
                                "example_id": "ba65acc1-c17f-48e1-b768-bf46101ecc32",
                                "sense_id": "2adcfcc4-7b19-3b79-b8b6-ec774531a137",
                                "text": "Meist bezieht man sich dabei auf den Darmtrakt, wo die meisten für unsere Gesundheit so wichtigen Bakterien zu finden sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
