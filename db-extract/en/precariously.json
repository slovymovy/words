                                "target_senses": [
                                    {
                                        "sense_id": "f3333775-5442-3325-8ea1-361a64e80e18",
                                        "entry_id": "176d434e-5b81-3e59-9006-525726070af4",
                                        "glosses": [
                                            "D’une manière précaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d76412-bcf3-40e1-9394-0d11d47243ae",
                                                "sense_id": "f3333775-5442-3325-8ea1-361a64e80e18",
                                                "text": "La princesse des Ursins, voyant échouer son projet de souveraineté personnelle, ne songe plus qu’à régner précairement à Madrid,"
                                            },
                                            {
                                                "example_id": "769411ea-cce5-431b-ac33-330560c15f5b",
                                                "sense_id": "f3333775-5442-3325-8ea1-361a64e80e18",
                                                "text": "Un jeune héros de Mauriac considérait ses amitiés et ses plaisirs comme des « branches » qui le soutenaient précairement au-dessus du néant : je lui empruntai ce mot."
                                            },
                                            {
                                                "example_id": "1ca09a7d-922e-4181-8bc1-30eb09e2baeb",
                                                "sense_id": "f3333775-5442-3325-8ea1-361a64e80e18",
                                                "text": "Monsieur de C. ne se lasse pas de voir les belles mains manier la porcelaine translucide, fabriquée jadis à Canton pour les acheteurs d’outre-mer, et qui a précairement traversé les océans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edd73304-960e-4764-9518-a96a2f26c36c",
                        "source_entry_id": "3adbe250-c5ec-3331-8efa-cc9232c2264e",
                        "source_sense_id": "d58cf7da-db50-306e-b899-dae927d228b1",
                        "source_sense_description": "in a precarious manner",
                        "target_lang_word": "unsicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "803d919a-5796-3c21-bf33-756881cf6394",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "eine Gefahr drohend, in sich bergend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4681ad1f-cfb8-47ec-90ff-f70d2b770766",
                                                "sense_id": "803d919a-5796-3c21-bf33-756881cf6394",
                                                "text": "Diese Gegend ist mir zu unsicher."
                                            },
                                            {
                                                "example_id": "0c03141e-e5d1-4b76-89aa-2a52b739bfba",
                                                "sense_id": "803d919a-5796-3c21-bf33-756881cf6394",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62383ea9-f99a-366d-9c40-829d0b425325",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "der Ausgang die Zukunft ist fraglich oder zweifelhaft, nicht klar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a770257-c2cc-4e0f-a0a3-f8ab545d74a3",
                                                "sense_id": "62383ea9-f99a-366d-9c40-829d0b425325",
                                                "text": "Der Autokonzern will den Händler Müller schlucken – Übernahme aller Angestellten unsicher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bae6d26d-2a32-33fb-a9a7-3303ceba2365",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "kein Selbstbewusstsein, seiner selbst nicht sicher sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163ad52a-68f3-48dd-b283-725ff4c56b29",
                                                "sense_id": "bae6d26d-2a32-33fb-a9a7-3303ceba2365",
                                                "text": "Ich bin mir jetzt unsicher, ob wir von hier oder von dort drüben gekommen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0c0d55a5-431d-360f-b48b-71b7275ff645",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "man kann sich auf etwas nicht verlassen, darauf vertrauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdf6410-52df-40b6-926d-2804708f4485",
                                                "sense_id": "0c0d55a5-431d-360f-b48b-71b7275ff645",
                                                "text": "Dieses Verfahren ist mir zu unsicher, da kann ich mich nicht darauf verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc51d0e0-7e86-4d7b-b486-f530a7c5da82",
                        "source_entry_id": "3adbe250-c5ec-3331-8efa-cc9232c2264e",
                        "source_sense_id": "d58cf7da-db50-306e-b899-dae927d228b1",
                        "source_sense_description": "in a precarious manner",
                        "target_lang_word": "prekär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prekär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dde97787-22ee-3060-a83b-7dfce956fd6d",
                                        "entry_id": "965712d9-f23e-301b-9156-ef440178f7ef",
                                        "glosses": [
                                            "widerruflich, unsicher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8137e7c-86b5-488f-9f07-1030f85aef24",
                                                "sense_id": "dde97787-22ee-3060-a83b-7dfce956fd6d",
                                                "text": "Das Beschäftigungsverhältnis als Leiharbeiter ist prekär."
                                            },
                                            {
                                                "example_id": "e760eb05-8a29-4ac5-b676-b7178a6d62a1",
                                                "sense_id": "dde97787-22ee-3060-a83b-7dfce956fd6d",
                                                "text": "„Und zwar prekär nicht im Sinne von niedrigem Einkommen, sondern als Ausdruck von Unsicherheit. Das Prekäre an dieser Generation ist, dass die Lebensverhältnisse instabil sind und sich jederzeit ändern können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26f8d8c4-fd3c-39ed-9ad5-e56b59470041",
                                        "entry_id": "965712d9-f23e-301b-9156-ef440178f7ef",
                                        "glosses": [
                                            "heikel, schwierig, problematisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7049c6-190c-480f-bf99-073305dfc004",
                                                "sense_id": "26f8d8c4-fd3c-39ed-9ad5-e56b59470041",
                                                "text": "Die Situation ist prekär."
                                            },
                                            {
                                                "example_id": "3c0bd332-03d3-4734-9189-15a2caa1f68d",
                                                "sense_id": "26f8d8c4-fd3c-39ed-9ad5-e56b59470041",
                                                "text": "Am Dienstag ließ sich Ametsreiter vor Journalisten bestätigen: Die prekäre Situation des Festnetzes sei „zu einem relevanten Teil regulierungsbedingt“, nicht marktbedingt, sagte Karl-Heinz Neumann, Chef des Wissenschaftlichen Instituts für Infrastruktur und Kommunikationsdienste (WIK)."
                                            },
                                            {
                                                "example_id": "416532f9-091e-4d89-b601-73d5f0539d49",
                                                "sense_id": "26f8d8c4-fd3c-39ed-9ad5-e56b59470041",
                                                "text": "„Die praktische Folge der Herabstufung liegt darin, dass Kredite an die USA künftig nur noch zu höheren Zinsen vergeben werden - was die prekäre Finanzlage der Supermacht weiter verschleiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
