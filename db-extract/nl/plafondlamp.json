                        "glosses": [
                            "verlichting die aan het plafond is bevestigd; verlichting die aan het plafond is opgehangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fdc3a80-e30e-4f9c-8f36-0656143b7190",
                                "sense_id": "4eda1323-bcff-3a57-9215-e85a4dca127d",
                                "text": "Een van de laatst overgebleven vliegen zoemde onder de plafondlamp en daalde vervolgens neer op mijn bovenarm."
                            },
                            {
                                "example_id": "4aa36893-30ff-4c29-90c8-b3567cb45be6",
                                "sense_id": "4eda1323-bcff-3a57-9215-e85a4dca127d",
                                "text": "Mensen die een plafondlamp van de IKEA van het merk LOCK, RINNA of HYBY hebben, kunnen die het beste terugbrengen naar de winkel. Bij het woonwarenhuis zijn meerdere meldingen binnengekomen dat de glazen lampenkap loslaat en naar beneden valt. Dit heeft in enkele gevallen geleid tot lichte verwondingen. IKEA heeft daardoor dinsdag besloten tot een terugroepactie."
                            }
                        ]
                    }
