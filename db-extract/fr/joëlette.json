                "senses": [
                    {
                        "sense_id": "caed110f-fa6e-3ffe-bbd6-2deebaaba06f",
                        "entry_id": "47ceb4d2-1dda-3764-993a-070f604f342b",
                        "glosses": [
                            "Fauteuil monté sur une roue et muni de brancards à l'avant et à l'arrière permettant de transporter une personne en situation de handicap dans tout type de chemin."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "d7d4c25d-57f2-408f-8117-492eccfb77f9",
                                "sense_id": "caed110f-fa6e-3ffe-bbd6-2deebaaba06f",
                                "text": "[…] les jeunes triathlètes avaient décidé de répondre présent au défi lancé par leur professeur et entraineur qui consistait à se mobiliser pour permettre à une petite fille handicapée moteur — Anaëlle — de vivre un événement unique (participer au Marathon de Paris le 7 avril 2013 avec les pompiers de Chartres) et surtout de réunir les fonds indispensables (plus de 3.000 € !) à l’acquisition d’une « Joëlette », matériel qui lui permettra d’accéder à une autonomie inespérée."
                            },
                            {
                                "example_id": "7601dbd0-3adc-4c56-bedf-8333793ccfb8",
                                "sense_id": "caed110f-fa6e-3ffe-bbd6-2deebaaba06f",
                                "text": "Elle propose des circuits spéciaux pour les personnes à mobilité réduite, avec des Joëlettes (fauteuils tout-terrain)."
                            },
                            {
                                "example_id": "2155ddb5-32a3-49e1-a088-7d5124b2a288",
                                "sense_id": "caed110f-fa6e-3ffe-bbd6-2deebaaba06f",
                                "text": "Les randonnées sont accessibles à tous dont les personnes à mobilité réduite dans le cadre de sorties « Joëlettes » qui ont lieu chaque trimestre."
                            }
                        ]
                    }
                ],
