                                "es": "Este plato es una <w>nueva versión</w> de una receta familiar tradicional."
                            }
                        }
                    ],
                    "synonyms": [
                        "re-creation"
                    ],
                    "common_phrases": [
                        "complete remake",
                        "modern remake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новая версия чего-либо, созданная заново.",
                        "zh": "对某事物进行重新创作或改造后的新版本。",
                        "es": "Una nueva versión de algo creado de nuevo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переделка",
                                "target_lang_sense_clarification": "обновление, реконструкция"
