                    {
                        "sense_id": "3f80a8c2-f457-3ebd-b91d-2a2875ced10a",
                        "entry_id": "132036b7-82e9-32dd-9f32-ba370448068f",
                        "glosses": [
                            "A gathering place for Sufis, especially in the Ottoman Empire and South Asia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048df810-0f91-4531-9d07-619d18212869",
                                "sense_id": "3f80a8c2-f457-3ebd-b91d-2a2875ced10a",
                                "text": "The presence of the Hindiler Tekkesi or the Indian takya in Istanbul since the time of Tipu's mission is another indication but it was not until the 1840s that the position of the Indian Muslims with regard to the Ottoman caliphate was fully crystallized."
                            },
                            {
                                "example_id": "83a26798-7f9f-49ac-af95-3023bd31599e",
                                "sense_id": "3f80a8c2-f457-3ebd-b91d-2a2875ced10a",
                                "text": "The younger shaykh, Baba Musafir, turned to the task of establishing a takya or khanqah at Awrangabad"
                            }
                        ]
                    },
                    {
                        "sense_id": "49110e88-2037-383b-b66b-354d21c6c6c4",
                        "entry_id": "132036b7-82e9-32dd-9f32-ba370448068f",
                        "glosses": [
                            "The cemetery or graveyard of Sufis, especially in South Asia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa941bb2-7256-4fdc-9f34-15ca80eb1bcc",
                                "sense_id": "49110e88-2037-383b-b66b-354d21c6c6c4",
                                "text": "takyas (graveyards)"
                            },
                            {
                                "example_id": "9a6676a0-f3f2-4669-9b7a-9e5b34e9c5e5",
                                "sense_id": "49110e88-2037-383b-b66b-354d21c6c6c4",
                                "text": "Takya, a pillow, a resting-place of Faqīrs"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8ee8bc7-7e63-3db8-aa38-7cba68ae191d",
                        "entry_id": "132036b7-82e9-32dd-9f32-ba370448068f",
                        "glosses": [
                            "Synonym of husayniyya."
                        ],
                        "tags": [
                            "Iran",
                            "Shia"
                        ],
                        "examples": [
                            {
                                "example_id": "47ff1cbd-f8e1-48e9-9c9c-9b044f11075d",
                                "sense_id": "f8ee8bc7-7e63-3db8-aa38-7cba68ae191d",
                                "text": "The takya was often endowed with several stores, the profits from which would help to defray the cost of maintaining the takya."
                            }
                        ]
                    }
