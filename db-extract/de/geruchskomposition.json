                ],
                "senses": [
                    {
                        "sense_id": "f2f65210-f2c7-3c9f-ab12-60c5209001d4",
                        "entry_id": "472e1ebe-429d-3c15-be9f-c1ae41b0ac2e",
                        "glosses": [
                            "aufeinander abgestimmte Zusammensetzung der Zutaten (zum Beispiel eines Parfüm)"
                        ],
                        "tags": [
                            "(gehobene) Geruchsstoffe"
                        ],
                        "examples": [
                            {
                                "example_id": "0193e9ff-010d-4a89-8cd6-b271b96c6165",
                                "sense_id": "f2f65210-f2c7-3c9f-ab12-60c5209001d4",
                                "text": "„Die Bildkomposition bildet so die Geruchskomposition ab.“"
                            },
                            {
                                "example_id": "22f61ffa-a2e7-4113-86db-1068d55ba889",
                                "sense_id": "f2f65210-f2c7-3c9f-ab12-60c5209001d4",
                                "text": "„Unter den Blicken von Gottes Sohn wechselt der in Business-Anzug und Krawatte gekleidete Menschensohn seinem jammernden, immer wieder weinenden Vater wiederholt die Windeln - was infolge einer täuschend echten Geruchskomposition auch die Magennerven der Besucher strapazierte.“"
                            },
                            {
                                "example_id": "8ca45e8f-de48-43dd-bcd7-2fa9e7c3dd16",
                                "sense_id": "f2f65210-f2c7-3c9f-ab12-60c5209001d4",
                                "text": "„Wäre Beethoven ein Hund gewesen, dann hätte er seine Neunte Sinfonie vielleicht als Geruchskomposition erschaffen.“"
                            },
                            {
                                "example_id": "23c755b5-f4ab-405f-9074-42eecf89bbd1",
                                "sense_id": "f2f65210-f2c7-3c9f-ab12-60c5209001d4",
                                "text": "„Doch der verkaufsfördernde Effekt geht dabei offenbar nicht auf die Anmut einer raffinierten Geruchskomposition zurück, zeigt nun eine Untersuchung: Vielmehr sind es eher simple Düfte aus nur einer Komponente, die Raum für Kauflaune zu schaffen scheinen, sagen die Forscher um Andreas Herrmann von der Universität von St. Gallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aceb2477-d095-3a15-8029-6f6eef75c3d9",
                        "entry_id": "472e1ebe-429d-3c15-be9f-c1ae41b0ac2e",
                        "glosses": [
                            "Verfahren und Ergebnis der Bildung von Geruchs-Wörtern, die zwei oder mehr freie lexikalische Morpheme oder Konfixe enthalten (zum Beispiel Chanel No. 7)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdee3783-7265-4125-91ea-88b9cc9f6b5a",
                                "sense_id": "aceb2477-d095-3a15-8029-6f6eef75c3d9",
                                "text": "„Wir finden uns im Seminarraum ein, wo wir von einer guten Geruchskomposition von \"Young Living Ölen\" empfangen werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
