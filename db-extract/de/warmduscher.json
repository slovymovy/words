                "senses": [
                    {
                        "sense_id": "a246cb97-5896-3c4f-918e-5e2f6beaa003",
                        "entry_id": "29768b0b-5798-3652-aeb3-21b1b652da26",
                        "glosses": [
                            "sensible, ängstliche Person"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "8f3b90e1-5f99-4e35-8d4c-290b764f3659",
                                "sense_id": "a246cb97-5896-3c4f-918e-5e2f6beaa003",
                                "text": "Die Stars von Aggro-Berlin werden inzwischen von einigen Rappern selbst als Warmduscher und Schlappschwänze verspottet."
                            },
                            {
                                "example_id": "0cc2cb68-a798-461d-b303-479457b12276",
                                "sense_id": "a246cb97-5896-3c4f-918e-5e2f6beaa003",
                                "text": "„Elektrisch wäre noch einiges zu sparen, aber als bekennender Warmduscher und Gegner der Kaltlichtenergiesparlampen rüste ich jetzt langsam auf LED um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b07db8ee-cc7c-4e47-9f06-4acd62e829ea",
                        "source_entry_id": "29768b0b-5798-3652-aeb3-21b1b652da26",
                        "source_sense_id": "a246cb97-5896-3c4f-918e-5e2f6beaa003",
                        "source_sense_description": "umgangssprachlich, abwertend: sensible, ängstliche Person",
                        "target_lang_word": "milksop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milksop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "150c5797-4b35-3996-93a7-fc0996da2bd3",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "A piece of bread sopped in milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae5aadcf-2ea7-37f7-be30-b124c2d3077e",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "A dish consisting of bread pieces in a bowl, sprinkled with sugar and covered in hot milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "An easily frightened, ineffectual, or weak person."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e002abb7-0ac5-443c-a13b-c7039f3380eb",
                                                "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                                "text": "And vvho doth lead them but a paltrey fellovv,? / Long kept in Brittaine at our mothers coſt, / A milkeſopt, one that neuer in his life / Felt ſo much colde as ouer ſhooes in ſnovv: […]"
                                            },
                                            {
                                                "example_id": "804068f6-ebf0-4553-89f6-3d1d90a84154",
                                                "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                                "text": "“That milksop of a creature pretend to be worthy of such a woman as Mrs. Pendennis,” broke out the Doctor: “where will impudence stop next!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4175fb12-1cd8-475e-b37d-5c7cdc9cf2a9",
                        "source_entry_id": "29768b0b-5798-3652-aeb3-21b1b652da26",
                        "source_sense_id": "a246cb97-5896-3c4f-918e-5e2f6beaa003",
