                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c850754-b243-484b-9fa8-ba7dbad63ca8",
                                                "sense_id": "fdacd2ff-d52c-3087-b8cf-cf5c74e9b9e0",
                                                "text": "I've been spoilered, so I doubt I'll be able to enjoy the final episode."
                                            }
