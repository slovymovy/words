                        ]
                    },
                    {
                        "translation_id": "9bcc80cd-23f8-406e-93ed-a0873e1a7dcf",
                        "source_entry_id": "2968b4f5-db7e-3c6a-a5da-ba5b60ea2a14",
                        "source_sense_id": "e8499977-3443-3686-bcb7-36c369599133",
                        "target_lang_word": "werething",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "werething",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e54d9f70-4464-3941-908c-aed62bbdb638",
                                        "entry_id": "462bc356-ebbe-3515-891a-fc22839964c9",
                                        "glosses": [
                                            "A werecreature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb5226a-d650-4b02-93d1-4c7970f03a1c",
                                                "sense_id": "e54d9f70-4464-3941-908c-aed62bbdb638",
                                                "text": "\"He is a demon — a werething! By day he moves among humanity in the guise of men, and by night he takes on his true aspect.\""
                                            },
                                            {
                                                "example_id": "c72a5bd9-71dd-44a4-9ea7-e8c82b64d607",
                                                "sense_id": "e54d9f70-4464-3941-908c-aed62bbdb638",
                                                "text": "Galavance takes a step closer to Zilch. \"Level with me. Have you ever been able to avoid killing a person who's a werething?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
