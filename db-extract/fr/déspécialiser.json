                "senses": [
                    {
                        "sense_id": "c2e6f630-2222-3c5c-bdc2-4efcc3a051ad",
                        "entry_id": "c8fcb087-7f07-3665-aad6-c585f54fb3e2",
                        "glosses": [
                            "Faire perdre son caractère spécialisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e063004e-38a1-49d0-8230-3a3d44140ded",
                                "sense_id": "c2e6f630-2222-3c5c-bdc2-4efcc3a051ad",
                                "text": "Pour affronter l'avenir et non plus simplement satisfaire les exigences à court terme des patronats locaux, il faut déspécialiser les CAP."
                            },
                            {
                                "example_id": "c789cf83-bc19-434d-bea5-b4013a806252",
                                "sense_id": "c2e6f630-2222-3c5c-bdc2-4efcc3a051ad",
                                "text": "Pour que l'économie politique favorise le progrès, il s'agit donc de l'élargir, de la déspécialiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff6c9591-df14-3f1b-8110-98d1fb781cfc",
                        "entry_id": "c8fcb087-7f07-3665-aad6-c585f54fb3e2",
                        "glosses": [
                            "Utiliser un mot réservé en tant que caractère normal."
                        ],
