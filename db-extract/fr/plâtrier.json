                                "target_senses": [
                                    {
                                        "sense_id": "1ba0f1c4-5b4a-3bd6-be98-79354ad2aa35",
                                        "entry_id": "ced06a92-f91c-37cd-b2ff-ae6ad87e268c",
                                        "glosses": [
                                            "A person whose occupation is to plaster walls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488172c5-e236-479f-ae79-109da3f86b83",
                                                "sense_id": "1ba0f1c4-5b4a-3bd6-be98-79354ad2aa35",
                                                "text": "Villain, thy father was a plasterer; / And thou thyself a shearman, art thou not?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46165fd8-a6bc-3fb4-9db0-1958d3223cfd",
                                        "entry_id": "ced06a92-f91c-37cd-b2ff-ae6ad87e268c",
                                        "glosses": [
                                            "One who makes plaster casts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19330017-934a-4413-b47a-48e108b3bd2b",
                                                "sense_id": "46165fd8-a6bc-3fb4-9db0-1958d3223cfd",
                                                "text": "The plasterer doth make his figures by addition, and the carver by substraction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
