{
    "word_family": [
        "invocation",
        "invocatory",
        "invoker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b93462d-d154-3804-b496-d1bc67e54d8d",
                    "sense_definition": "To cause a computer program, procedure, or subroutine to begin its execution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The user can <w>invoke</w> the search function by pressing a specific keyboard shortcut.",
                            "target_lang_translations": {
                                "ru": "Пользователь может <w>вызвать</w> функцию поиска, нажав определенную комбинацию клавиш."
                            }
                        },
                        {
                            "text": "The system will <w>invoke</w> a script to back up all files every night at midnight.",
                            "target_lang_translations": {
                                "ru": "Система будет <w>запускать</w> скрипт для резервного копирования всех файлов каждую ночь в полночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "execute",
                        "launch",
                        "run",
                        "call"
                    ],
                    "common_phrases": [
                        "invoke a script",
                        "invoke a function",
                        "invoke a command"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запустить выполнение компьютерной программы, процедуры или подпрограммы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "функцию или скрипт"
                            },
                            {
                                "target_lang_word": "запускать",
                                "target_lang_sense_clarification": "процесс выполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dfc1eef-6d60-3305-8566-82905c3766e0",
                    "sense_definition": "To refer to a law, rule, or authority as a reason for an action or to support an argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer decided to <w>invoke</w> the fifth amendment to protect his client from self-incrimination.",
                            "target_lang_translations": {
                                "ru": "Адвокат решил <w>сослаться</w> на пятую поправку, чтобы защитить своего клиента от самообвинения."
                            }
                        },
                        {
                            "text": "The president may <w>invoke</w> emergency powers if the country faces a major natural disaster.",
                            "target_lang_translations": {
                                "ru": "Президент может <w>воспользоваться</w> чрезвычайными полномочиями, если страна столкнется с крупным стихийным бедствием."
                            }
                        }
                    ],
                    "synonyms": [
                        "cite",
                        "reference",
                        "appeal"
                    ],
                    "common_phrases": [
                        "invoke a law",
                        "invoke a rule",
                        "invoke emergency powers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ссылаться на закон, правило или авторитет в качестве основания для действия или аргумента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "на закон или правило"
                            },
                            {
                                "target_lang_word": "прибегать",
                                "target_lang_sense_clarification": "к использованию права или полномочий"
                            },
                            {
                                "target_lang_word": "апеллировать",
                                "target_lang_sense_clarification": "к авторитету или норме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f38a395c-0255-3817-9368-13b8369e0661",
                    "sense_definition": "To call upon a deity, spirit, or higher power for help, protection, or inspiration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spiritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient sailors would <w>invoke</w> the gods of the sea before starting a long voyage.",
                            "target_lang_translations": {
                                "ru": "Древние моряки <w>взывали</w> к морским богам перед началом долгого плавания."
                            }
                        },
                        {
                            "text": "The priest began the ceremony to <w>invoke</w> divine blessing upon the new congregation.",
                            "target_lang_translations": {
                                "ru": "Священник начал церемонию, чтобы <w>призвать</w> божье благословение на новый приход."
                            }
                        }
                    ],
                    "synonyms": [
                        "invocate",
                        "summon",
                        "petition"
                    ],
                    "common_phrases": [
                        "invoke a deity",
                        "invoke divine blessing",
                        "invoke the spirits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться к божеству, духу или высшим силам за помощью, защитой или вдохновением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взывать",
                                "target_lang_sense_clarification": "к богам или высшим силам"
                            },
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "духов или благословение"
                            },
                            {
                                "target_lang_word": "молить",
                                "target_lang_sense_clarification": "о помощи свыше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a1bc40b-fd71-3654-b7c5-5f701ea87852",
                    "sense_definition": "To call to mind or bring forth a particular feeling, memory, or image.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old photographs <w>invoke</w> memories of a childhood spent in the countryside.",
                            "target_lang_translations": {
                                "ru": "Старые фотографии <w>вызывают</w> воспоминания о детстве, проведенном в деревне."
                            }
                        },
                        {
                            "text": "The author's vivid descriptions <w>invoke</w> a sense of nostalgia in the readers.",
                            "target_lang_translations": {
                                "ru": "Живые описания автора <w>пробуждают</w> у читателей чувство ностальгии."
                            }
                        }
                    ],
                    "synonyms": [
                        "evoke",
                        "call to mind",
                        "bring to mind"
                    ],
                    "common_phrases": [
                        "invoke memories",
                        "invoke a sense",
                        "invoke an image"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать в воображении или пробуждать определенное чувство, воспоминание или образ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "воспоминания или чувства"
                            },
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "ощущения или образы"
                            },
                            {
                                "target_lang_word": "навевать",
                                "target_lang_sense_clarification": "мысли или ностальгию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d085f0b-3fb5-3724-8735-89cfd9c051da",
                    "sense_definition": "To bring about or cause something to happen as an inevitable result.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "causality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such reckless behavior will surely <w>invoke</w> the wrath of the local authorities.",
                            "target_lang_translations": {
                                "ru": "Такое безрассудное поведение наверняка <w>навлечет</w> гнев местных властей."
                            }
                        },
                        {
                            "text": "The new policy might <w>invoke</w> a strong reaction from the labor unions.",
                            "target_lang_translations": {
                                "ru": "Новая политика может <w>вызвать</w> резкую реакцию со стороны профсоюзов."
                            }
                        }
                    ],
                    "synonyms": [
                        "provoke",
                        "induce",
                        "bring about",
                        "instigate"
                    ],
                    "common_phrases": [
                        "invoke wrath",
                        "invoke a reaction",
                        "invoke consequences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спровоцировать или вызвать что-либо как неизбежный результат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "гнев или реакцию"
                            },
                            {
                                "target_lang_word": "навлекать",
                                "target_lang_sense_clarification": "неприятности или последствия"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "ответные действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}