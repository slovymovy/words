                "senses": [
                    {
                        "sense_id": "826f2619-52e9-3d78-a085-40845cc0a8d1",
                        "entry_id": "8460d6b6-64dc-3e8c-b68f-e7d80df9094d",
                        "glosses": [
                            "To overly humanize a nonhuman or subhuman entity."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7e9ff76c-7760-4c9a-89bb-f5e92c5dce7e",
                                "sense_id": "826f2619-52e9-3d78-a085-40845cc0a8d1",
                                "text": "Here's what I don't like: overhumanized TFs (eg: fleshy faces, Primus theory), and unrealistic humans."
                            },
                            {
                                "example_id": "58bf58d8-a84e-4a53-9165-a25044e54eda",
                                "sense_id": "826f2619-52e9-3d78-a085-40845cc0a8d1",
                                "text": "Ironically, Americans have been bitching for years about \"man in a rubber suit\" Toho Godzilla, and then when an American version finally materializes, it looks more like a man in a suit (thanks to the overhumanized anatomy) than any previous Godzilla."
                            },
                            {
                                "example_id": "c65ae4ee-9c33-4183-8da6-674b3516699c",
                                "sense_id": "826f2619-52e9-3d78-a085-40845cc0a8d1",
                                "text": "How can you overhumanize something that is already simply human?"
                            }
                        ]
                    }
