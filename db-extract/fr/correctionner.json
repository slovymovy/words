                "senses": [
                    {
                        "sense_id": "9939b0d1-e770-3901-a8b9-fec314cf0681",
                        "entry_id": "a5f20e67-6a65-391b-ab63-b38b8f953a95",
                        "glosses": [
                            "Administrer une correction à quelqu’un."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1a9367d0-0708-4818-bdbb-1a789aeb6a2a",
                                "sense_id": "9939b0d1-e770-3901-a8b9-fec314cf0681",
                                "text": "Moi, quand on m’en fait trop, je correctionne plus, je dynamite, je disperse, je ventile !"
                            },
                            {
                                "example_id": "02d61f54-71d3-4e9a-9a97-c9d359211a3e",
                                "sense_id": "9939b0d1-e770-3901-a8b9-fec314cf0681",
                                "text": "Je veux les correctionner..."
                            },
                            {
                                "example_id": "40080e4e-3c3e-4196-8aa8-828475fe0b31",
                                "sense_id": "9939b0d1-e770-3901-a8b9-fec314cf0681",
                                "text": "Toute moulue encore des jetons que le grand lui a filés, elle compare. Comme un vrai voyou, il l’a satanée, ce grand hotu chéri, et le Mexicain, qui correctionnait fort pourtant, n'aurait pu mieux faire."
                            },
                            {
                                "example_id": "084ddb48-ae15-4a10-a17b-b295f8bc7bef",
                                "sense_id": "9939b0d1-e770-3901-a8b9-fec314cf0681",
                                "text": "[…], Wynn commence à compter lorsqu'il passe le seuil d'un gymnase et, plus précisément, lorsqu'il appuie ses coudes aux cordes d'un ring où deux abrutis se correctionnent."
                            }
                        ]
                    }
                ],
