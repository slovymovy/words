                ],
                "senses": [
                    {
                        "sense_id": "80acea5b-285a-3343-a2f0-91c773637c16",
                        "entry_id": "5588654f-bff4-37ef-8689-e205b66e54db",
                        "glosses": [
                            "vom Wind zerzaust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d56be7-883e-4902-9590-4fe6d28d5014",
                                "sense_id": "80acea5b-285a-3343-a2f0-91c773637c16",
                                "text": "„Ihr Haar, hat sie gesagt, sei windzerzaust.“"
                            },
                            {
                                "example_id": "c5dbd08e-5903-4a6d-a7f4-2f4b9f45d6d5",
                                "sense_id": "80acea5b-285a-3343-a2f0-91c773637c16",
                                "text": "„Sie sah auf einen Abhang hinaus, der sich zu ihrer Rechten befand. Auf ihm wuchs ein Gewirr von windzerzausten graugrünen Büschen mit staubbedeckten Zweigen und vertrocknet aussehenden Blättern.“"
                            },
                            {
                                "example_id": "edd2b88f-e8bc-404b-b643-c3ed41686031",
                                "sense_id": "80acea5b-285a-3343-a2f0-91c773637c16",
                                "text": "„Sie waren bezaubert von den inmitten windzerzauster Eichen gelegenen Stein-Cottages, sie waren entzückt von den Tauben in den Kirchhof-Eiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
