                        "cross_references": [
                            {
                                "target_word": "pain in the ass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2eff44ea-9571-35e3-adde-45d4857c8f9c",
                                        "entry_id": "6f157bf5-b2e1-3199-abb0-5e15e0efa329",
                                        "glosses": [
                                            "Something or someone that causes discomfort or frustration."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "351e962d-e638-4234-bfac-6a46cbcaf981",
                                                "sense_id": "2eff44ea-9571-35e3-adde-45d4857c8f9c",
                                                "text": "Strangely enough, the days I spent at this pain-in-the-ass job were some of my most memorable and valuable."
                                            },
                                            {
                                                "example_id": "c59c9af9-aba9-4e06-b2bd-7f7e4d62ec4d",
                                                "sense_id": "2eff44ea-9571-35e3-adde-45d4857c8f9c",
                                                "text": "His one obligation is that, every day, he must gather $10,000 worth of items from the store – stuff he doesn’t need: electronics, nappies, pet food and so forth – and exchange them for the cash. This is both an acute pain in the ass, and the one thing that prevents him from going insane with boredom. )"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
