                    },
                    {
                        "translation_id": "40bf498d-b284-4fa1-b10e-609bcda89ce0",
                        "source_entry_id": "2fd52e9d-66d3-326e-af23-55fb270b92a6",
                        "source_sense_id": "5ab099b6-b9b0-325b-9d63-e17ee39ac56f",
                        "source_sense_description": "einundeinhalb",
                        "target_lang_word": "полтора",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "полтора",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "294eec0b-2a35-339b-b0d1-b2bedc459232",
                                        "entry_id": "be2b1881-092f-3b89-9fdb-c513732d645a",
                                        "glosses": [
                                            "дробное число, количество чего-либо, равное единице с половиной"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6512276-aa0a-432c-89e2-dcd86408a8fe",
                                                "sense_id": "294eec0b-2a35-339b-b0d1-b2bedc459232",
                                                "text": "Часа полтора посидели в трактире, выпили для блезиру по стакану чаю и опять пошли к Стручкову."
                                            },
                                            {
                                                "example_id": "885ae198-9b4b-403b-b9a5-8e6ef0e5c10c",
                                                "sense_id": "294eec0b-2a35-339b-b0d1-b2bedc459232",
                                                "text": "— Во сколько времени можете достигнуть Владивостока? — В по́лтора суток, — ответил Баранов."
                                            },
                                            {
                                                "example_id": "dc06908f-6222-45b1-9296-6307c065ddbd",
                                                "sense_id": "294eec0b-2a35-339b-b0d1-b2bedc459232",
                                                "text": "По́лтора суток без перерыву лил дождь. Шоссейная дорога стала, как в весеннюю распутицу."
                                            },
                                            {
                                                "example_id": "4a812552-06d8-43b1-ba6f-461637f63bb1",
                                                "sense_id": "294eec0b-2a35-339b-b0d1-b2bedc459232",
                                                "text": "Прилежно, не пропуская ни одного слова, он прочёл полторы страницы и с огорчением увидел, что ровно ничего не понял."
                                            },
                                            {
                                                "example_id": "1f665e20-698e-4b53-837e-e9fd1327e8bd",
                                                "sense_id": "294eec0b-2a35-339b-b0d1-b2bedc459232",
                                                "text": "Роскошный кейс с номерным замком, стоивший напротив полторы тысячи крон, здесь предлагался за сто пятьдесят."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
