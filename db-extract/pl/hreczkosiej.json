                        "entry_id": "5b93c7cc-9722-354a-be19-431acb8a305e",
                        "glosses": [
                            "zasiedziały na swej roli gospodarz, ubogi zaściankowy szlachcic samodzielnie zajmujący się rolą"
                        ],
                        "tags": [
                            "ironic",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "93b8b57c-29d9-47ee-834f-18b3474d712c",
                                "sense_id": "ab7639b5-8cc7-3de2-9a2e-51db9b5935a1",
                                "text": "Kto by jednak wnosił z prostego ubrania i nie mniej prostej powierzchowności jego, przypuściłby raczej, że szlachcic, hreczkosiej, myśli o tym, ile z każdego morga będzie miał tego żyta, śród którego stoi"
                            },
                            {
                                "example_id": "5bdd6878-b325-48cd-a150-fb19a286b107",
                                "sense_id": "ab7639b5-8cc7-3de2-9a2e-51db9b5935a1",
                                "text": "„Z notatek hreczkosieja”"
                            },
                            {
                                "example_id": "919f362d-e79c-40b1-b5ad-f3dd3c91459a",
                                "sense_id": "ab7639b5-8cc7-3de2-9a2e-51db9b5935a1",
                                "text": "„Chłopska dola: z notatek hreczkosieja”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
