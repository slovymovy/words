                ],
                "senses": [
                    {
                        "sense_id": "1be84364-030e-33f7-8e1b-5ec4cd97d8f3",
                        "entry_id": "dee3e329-e188-37bf-a5a7-e3dc877c6064",
                        "glosses": [
                            "истор. член студенческой корпорации или другого студенческого объединения, участники которого отличались склонностью к участию в дуэлях, кутежах и т. п. (в Германии)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc6886e-b77c-4d62-98c4-2fb832cb7e61",
                                "sense_id": "1be84364-030e-33f7-8e1b-5ec4cd97d8f3",
                                "text": "Он рассказал мне странную историю, в которой сам играл роль жалкую, а моя мать, по обыкновению, святую и миссионерскую: он был дерптский студент, бурш, кутила и демократ; мать ― христианка."
                            },
                            {
                                "example_id": "a7ac91af-1e8d-4ab6-85db-c79927b51cb3",
                                "sense_id": "1be84364-030e-33f7-8e1b-5ec4cd97d8f3",
                                "text": "― Давайте выпьем сегодня основательно, ― продолжал Сергей Сергеич, закусывая лимоном. ― Я старый бурш, люблю иногда встряхнуться. Это необходимо."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ba1b5c3-5c13-4a2f-bbeb-5a0e31898155",
                        "source_entry_id": "dee3e329-e188-37bf-a5a7-e3dc877c6064",
                        "source_sense_id": "1be84364-030e-33f7-8e1b-5ec4cd97d8f3",
                        "target_lang_word": "Bursche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bursche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                        "entry_id": "05c969e4-1a8b-3cb1-99c1-0326bfe5df76",
                                        "glosses": [
                                            "junger Mann; Junge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81437e8e-fc52-470c-a1af-cec20ae09450",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "Der Bursche spielt mal wieder in der Matsche."
                                            },
                                            {
                                                "example_id": "dd9103ff-b189-40a9-b57f-29b27ac36688",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "Das blaue Hemd gehört dem Burschen."
                                            },
                                            {
                                                "example_id": "60e42f10-7336-4d05-8a4a-0c4c43656f77",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "Mach Dir keine Sorgen, er ist ein zäher Bursche."
                                            },
                                            {
                                                "example_id": "bce1ee3f-b4b9-4405-9777-1b8ea3b2c685",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "„Ich begleitete ihn auf drei oder vier Fahrten und wuchs zu einem großen, kräftigen Burschen heran; da kaperte uns auf der Heimfahrt von der Neufundlandbank ein algerischer Seeräuber oder ein Kriegsschiff.“"
                                            },
                                            {
                                                "example_id": "8630a3ab-485d-4257-a9b0-89f9554b5338",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "„Der zweite Bursche kam auf mich zu.“"
                                            },
                                            {
                                                "example_id": "586b6834-bd95-4ea9-b731-c8501ca11f44",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "„Der Fahrer, ein hagerer Bursche mit einer Pelzmütze auf dem Schädel, öffnet dienstbeflissen die Autotür, um seinen Fahrgast einsteigen zu lassen.“"
                                            },
                                            {
                                                "example_id": "ab8563d2-4e6f-478f-beef-c972e5141257",
                                                "sense_id": "2952e1d8-05ce-33aa-becd-46bb565fb92b",
                                                "text": "„Damals war Tóvó ein verwahrloster Bursche gewesen, und seit 1857 oder 1858 war er, soweit Obram wusste, ein Vierteljahrhundert nicht mehr auf den Färöern gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad9a6283-cf17-3cd4-800b-ebd9013624b9",
                                        "entry_id": "05c969e4-1a8b-3cb1-99c1-0326bfe5df76",
                                        "glosses": [
                                            "Mitglied einer Studentenverbindung, einer Burschenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b5847f-aa0e-4dc8-88cd-72c62670589f",
                                                "sense_id": "ad9a6283-cf17-3cd4-800b-ebd9013624b9",
                                                "text": "„Die Mädchen trugen die kleinen Fähnchen der Fabrikarbeiterinnen, viele Burschen hatten die Mützen auf dem Kopf.“"
                                            },
                                            {
                                                "example_id": "20e5065e-7589-4aa5-9363-cf7efeed91a9",
                                                "sense_id": "ad9a6283-cf17-3cd4-800b-ebd9013624b9",
                                                "text": "Bei der Mensur erhielt der Bursche seinen Schmiss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae51dc9c-5a1b-3da7-8c8f-b1b662c602b3",
                                        "entry_id": "05c969e4-1a8b-3cb1-99c1-0326bfe5df76",
                                        "glosses": [
                                            "Soldat in der Funktion eines Dieners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4b64b9-51a2-4f3a-bafd-307ec5a29141",
                                                "sense_id": "ae51dc9c-5a1b-3da7-8c8f-b1b662c602b3",
                                                "text": "„Wir wohnten mit in seinem Hause, mit seinem Burschen Eilitz zusammen.“"
                                            },
                                            {
                                                "example_id": "66198a56-8596-4266-91e6-fee9db2f9e30",
                                                "sense_id": "ae51dc9c-5a1b-3da7-8c8f-b1b662c602b3",
                                                "text": "„Vermutlich ist es der Bursche des Offiziers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
