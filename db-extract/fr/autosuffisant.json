                ],
                "senses": [
                    {
                        "sense_id": "d0fe1b36-9fea-368d-9cb7-008731dcfd75",
                        "entry_id": "2bcce8b3-0a57-33b7-a9fd-8389ed46e2fc",
                        "glosses": [
                            "Qui se suffit à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d1518a-40b4-462b-a492-ae5b4fb0ff4c",
                                "sense_id": "d0fe1b36-9fea-368d-9cb7-008731dcfd75",
                                "text": "Un tiers de la population vit en zone rurale, mais le pays n’est pas autosuffisant en denrées alimentaires."
                            },
                            {
                                "example_id": "3af0c358-0025-457b-9aaa-f600afc6f2dd",
                                "sense_id": "d0fe1b36-9fea-368d-9cb7-008731dcfd75",
                                "text": "Cet éleveur est un ami de l’environnement : il se vante de produire lui-même une partie de la nourriture de ses animaux, de forer lui-même le sol pour les abreuver, d’être autosuffisant en paille, de mettre un filtre pour le fuel et de fabriquer plein d’électricité grâce à des panneaux photovoltaïques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9abb86f9-f6bf-4a3f-9cbc-2e63a72a2355",
                        "source_entry_id": "2bcce8b3-0a57-33b7-a9fd-8389ed46e2fc",
                        "source_sense_id": "d0fe1b36-9fea-368d-9cb7-008731dcfd75",
                        "target_lang_word": "self-sufficient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-sufficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0f1cb1c-dc09-3b29-a90e-ad76cfd2e0e6",
                                        "entry_id": "477f6141-1092-3f87-a6af-a105d571444c",
                                        "glosses": [
                                            "Able to provide for oneself independently of others; not needing external support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea96199-0f46-4748-8c94-1d07fa3125b9",
                                                "sense_id": "d0f1cb1c-dc09-3b29-a90e-ad76cfd2e0e6",
                                                "text": "Over the next few decades, several million humans immigrated to Eden Prime and a primarily agrarian culture developed. The new colony quickly became not only self-sufficient, but began exporting goods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9882c6e7-de4b-381d-8142-381b1a18f33f",
                                        "entry_id": "477f6141-1092-3f87-a6af-a105d571444c",
                                        "glosses": [
                                            "Overconfident in one's own abilities; arrogant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b9eeb66-46b6-4689-a33f-38b9aa8a54ad",
                                                "sense_id": "9882c6e7-de4b-381d-8142-381b1a18f33f",
                                                "text": "In spite of these conscientious reflections, he was too self-sufficient to think he should find any difficulty in obtaining forgiveness for these sins of omission […]."
                                            },
                                            {
                                                "example_id": "44a2cc80-ea5c-4a2f-a64a-b46201b5cd92",
                                                "sense_id": "9882c6e7-de4b-381d-8142-381b1a18f33f",
                                                "text": "To rescue London from this short-termism, Byford has put forward a deal that would fill the current gap of £500m annually, explaining: \"If we can fill that gap, we can get back to being self-sufficient by 2023.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "656fedd0-487e-4442-83a0-762fab880e37",
                        "source_entry_id": "2bcce8b3-0a57-33b7-a9fd-8389ed46e2fc",
                        "source_sense_id": "d0fe1b36-9fea-368d-9cb7-008731dcfd75",
                        "target_lang_word": "self-supporting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-supporting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40f4f066-908a-3f85-b2ad-af7d5e2745f7",
                                        "entry_id": "33b21f53-b9be-3b52-8aa9-b47a3a8b53b9",
                                        "glosses": [
                                            "Characterized by self-support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0250295f-7e59-4c76-b8c0-298cd14e00c0",
                                                "sense_id": "40f4f066-908a-3f85-b2ad-af7d5e2745f7",
                                                "text": "With a self-supporting body and without separate underframe, this design offers scope for improved sound insulation; [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "498b8f8b-75b2-4d0f-8d12-550128189073",
                        "source_entry_id": "2bcce8b3-0a57-33b7-a9fd-8389ed46e2fc",
                        "source_sense_id": "d0fe1b36-9fea-368d-9cb7-008731dcfd75",
                        "target_lang_word": "autarkic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autarkic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                                        "entry_id": "b8656677-abf8-3e44-b1c2-d61c31487008",
                                        "glosses": [
                                            "Pertaining to an autarky; self-sufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9089cea-30fd-4538-bbc6-239945c5bd04",
                                                "sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                                                "text": "The countryside, in short, was becoming more archaic and more autarkic."
                                            },
                                            {
                                                "example_id": "e878ad6d-cdda-4a10-b427-edb75b5a0315",
                                                "sense_id": "b590ab8e-f114-3165-b857-1009362be31d",
                                                "text": "Fascists had no particular economic doctrine aside from preparing for war. They wanted to build autarkic economies that could withstand blockade and did not rely on foreign trade except for bilateral deals with weaker countries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dedb175-beba-4223-8194-f306fc23b577",
                        "source_entry_id": "2bcce8b3-0a57-33b7-a9fd-8389ed46e2fc",
