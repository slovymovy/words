            "senses": [
                {
                    "sense_id": "d5ae0428-5994-3de2-93ea-dfc009df8545",
                    "sense_definition": "A short form of <w>automobile</w>; a passenger vehicle designed for operation on ordinary roads.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_generic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>auto</w> industry has seen significant technological changes in recent years.",
                            "target_lang_translations": {
                                "ru": "<w>Автомобильная</w> промышленность претерпела значительные технологические изменения в последние годы.",
                                "de": "Die <w>Automobilindustrie</w> hat in den letzten Jahren erhebliche technologische Veränderungen erlebt.",
                                "zh": "近年来，<w>汽车</w>工业经历了重大的技术变革。"
                            }
                        },
                        {
                            "text": "He works as an <w>auto</w> mechanic at a local garage.",
                            "target_lang_translations": {
                                "ru": "Он работает <w>автомехаником</w> в местной мастерской.",
                                "de": "Er arbeitet als <w>Kfz-Mechaniker</w> in einer örtlichen Werkstatt.",
                                "zh": "他在当地一家修车厂当<w>汽车</w>修理工。"
                            }
                        }
                    ],
                    "synonyms": [
                        "car",
                        "automobile",
                        "motorcar",
                        "vehicle"
                    ],
                    "common_phrases": [
                        "auto industry",
                        "auto mechanic",
                        "auto parts",
                        "auto repair"
                    ],
