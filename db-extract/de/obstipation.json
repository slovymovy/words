                        "form": "die Obstipationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                        "entry_id": "904b5083-5c51-3016-8ff6-6ec3f5196ea0",
                        "glosses": [
                            "erschwerte oder verminderte Stuhlentleerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b428f3e-d3d3-413b-a115-ea310b4dbc85",
                                "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                                "text": "Eine akute Obstipation tritt kurzfristig und meist in bestimmten Situationen auf, zum Beispiel während der Schwangerschaft, auf einer Reise oder bei erheblichem Stress."
                            },
                            {
                                "example_id": "990e8c86-b77b-4be3-93de-1514882a5211",
                                "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                                "text": "Eine chronische Obstipation hält länger als drei Monate an."
                            },
                            {
                                "example_id": "dd0ba77b-7634-41b8-915e-940bf432e0d4",
                                "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                                "text": "Ein Viertel aller Betroffenen unternimmt laut einer 2006 veröffentlichten Studie zur \"Epidemiologie der Obstipation\" nichts und wartet lediglich auf eine Verbesserung ihres Zustandes."
                            },
                            {
                                "example_id": "6f936091-7c87-4e0e-b24f-452f21f92dcc",
                                "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                                "text": "Eine chronische Obstipation liegt vor, wenn der Stuhl über mehr als drei Monate regelmäßig vier Tage lang ausbleibt, starkes Pressen erforderlich ist und ein Gefühl der unvollständigen Darmentleerung bestehen bleibt."
                            },
                            {
                                "example_id": "366b9bf9-a3d4-44d7-91e4-7bcf500c0221",
                                "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                                "text": "Zu den häufigsten erkennbaren Auslösern von Obstipation zählen die zweite Zyklushälfte und die Schwangerschaft, sowie Erkrankungen des Nervensystems wie M. Parkinson und Multiple Sklerose."
                            },
                            {
                                "example_id": "97653fac-3b8d-4eae-acc2-61b65b53192f",
                                "sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
                                "text": "Obstipation ist nicht selten die unerwünschte Folge einer medikamentösen Therapie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa854838-3449-404c-af8a-12ee9707af8d",
                        "source_entry_id": "904b5083-5c51-3016-8ff6-6ec3f5196ea0",
                        "source_sense_id": "050a5a98-a450-327d-99e9-4b5511bc85a2",
