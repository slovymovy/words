{
    "word_family": [
        "scold",
        "scolding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "893c6694-e767-3336-b4bc-837a86526888",
                    "sense_definition": "A person who constantly or harshly reprimands and finds fault with others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old woman was known as a habitual <w>scolder</w> who yelled at children playing on the street.",
                            "target_lang_translations": {
                                "tr": "Yaşlı kadın, sokakta oynayan çocuklara bağıran alışkanlık edinmiş bir <w>azarlayıcı</w> olarak tanınırdı."
                            }
                        },
                        {
                            "text": "No one wanted to work with the persistent <w>scolder</w> because of his negative attitude.",
                            "target_lang_translations": {
                                "tr": "Olumsuz tavrı nedeniyle hiç kimse bu ısrarcı <w>azarlayıcı</w> ile çalışmak istemiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "castigator",
                        "censurer",
                        "vituperator"
                    ],
                    "common_phrases": [
                        "habitual scolder",
                        "persistent scolder"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sürekli veya sert bir şekilde başkalarını azarlayan ve kusur bulan kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "azarlayıcı",
                                "target_lang_sense_clarification": "sürekli azarlayan kişi"
                            },
                            {
                                "target_lang_word": "dırlamacı",
                                "target_lang_sense_clarification": "dırdır eden kişi"
                            },
                            {
                                "target_lang_word": "şikayetçi",
                                "target_lang_sense_clarification": "sürekli kusur bulan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "594e38a1-b48d-34e2-8d68-e1bf9910311d",
                    "sense_definition": "A coastal wading bird, specifically the oystercatcher, named for its loud and shrill call.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birdwatcher spotted a <w>scolder</w> calling loudly along the rocky shoreline.",
                            "target_lang_translations": {
                                "tr": "Kuş gözlemcisi, kayalık kıyı boyunca yüksek sesle öten bir <w>poyraz kuşu</w> fark etti."
                            }
                        },
                        {
                            "text": "A noisy <w>scolder</w> flew overhead while we were searching for marine life.",
                            "target_lang_translations": {
                                "tr": "Biz deniz canlılarını ararken başımızın üstünden gürültücü bir <w>poyraz kuşu</w> uçtu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noisy scolder"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used as a local name for the bird"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüksek ve tiz sesiyle tanınan, özellikle deniz papağanı/poyraz kuşu gibi bir kıyı kıyı kuşu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "poyraz kuşu",
                                "target_lang_sense_clarification": "ötücü bir kıyı kuşu türü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5410068f-393f-3346-9c42-e324b248e0aa",
                    "sense_definition": "A sea duck, specifically the long-tailed duck (formerly oldsquaw).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the winter, the coastal waters are frequented by the migratory <w>scolder</w>.",
                            "target_lang_translations": {
                                "tr": "Kışın, kıyı sularına göçmen <w>telkuyruk ördek</w> sıkça uğrar."
                            }
                        },
                        {
                            "text": "Local hunters often refer to the long-tailed duck as a <w>scolder</w>.",
                            "target_lang_translations": {
                                "tr": "Yerel avcılar, telkuyruk ördeğe genellikle <w>scolder</w> derler."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoldenore"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "regional bird name"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle telkuyruk ördek (Clangula hyemalis) olarak bilinen bir deniz ördeği türü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "telkuyruk ördek",
                                "target_lang_sense_clarification": "bir deniz ördeği türü"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}