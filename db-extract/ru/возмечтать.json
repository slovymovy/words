                "senses": [
                    {
                        "sense_id": "1b3b726e-7d00-3fc5-9d29-3093f9f1010f",
                        "entry_id": "2050361e-5f77-336a-b700-ac93887b5919",
                        "glosses": [
                            "высок. начать мечтать, замечтать, загрезить; предаться мечте (мечтам) (как правило о чём-либо неосуществимом, несбыточном, бесплодном)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c54b9e-cce0-445b-86cb-e8d446949043",
                                "sense_id": "1b3b726e-7d00-3fc5-9d29-3093f9f1010f",
                                "text": "Любуясь тихим Доном, стоял я у моста и возмечтал о нашем будущем достатке."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5e1982f-ddc8-3a5f-8f8b-90343f56405e",
                        "entry_id": "2050361e-5f77-336a-b700-ac93887b5919",
                        "glosses": [
                            "разг. возомнить о себе, возыметь неоправданно высокое самомнение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f777c57-54b0-405d-8284-e7f07be5334c",
                                "sense_id": "b5e1982f-ddc8-3a5f-8f8b-90343f56405e",
                                "text": "Возмечтал он о себе, что умнее всех на свете."
                            }
                        ]
                    }
