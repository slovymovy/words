                "senses": [
                    {
                        "sense_id": "9d8c6d6a-2405-350d-8040-d77440eb5341",
                        "entry_id": "b95d6c49-e737-3515-a0e3-e614fb6ac43e",
                        "glosses": [
                            "jemand, der beruflich Fußbodenteppiche oder Wandteppiche knüpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ad8d6d-a637-4cd5-8e4c-de4173136927",
                                "sense_id": "9d8c6d6a-2405-350d-8040-d77440eb5341",
                                "text": "Teppichknüpfer/innen sind Experten für den Entwurf und die Herstellung von handgefertigten Teppichen, Matten sowie Boden- und Wandläufern."
                            },
                            {
                                "example_id": "a65fb87c-2143-4e4e-9884-e607210da787",
                                "sense_id": "9d8c6d6a-2405-350d-8040-d77440eb5341",
                                "text": "Auch Teppichreparaturen gehören in den Zuständigkeitsbereich von Teppichknüpfern und Teppichknüpferinnen."
                            },
                            {
                                "example_id": "292f396c-54e4-43b1-8cef-c160622a08ac",
                                "sense_id": "9d8c6d6a-2405-350d-8040-d77440eb5341",
                                "text": "Auf eine überregionale Zeitungsanzeige, in der ein erfahrener Anleiter für die künftigen Teppichknüpfer gesucht wurde, meldete sich der österreichische Textilfachmann Rudolf Stundl."
                            },
                            {
                                "example_id": "a290ca87-ad0b-41b2-ae47-85a5d1a5bd1e",
                                "sense_id": "9d8c6d6a-2405-350d-8040-d77440eb5341",
                                "text": "Zehn Jahre seien die jüngsten der Teppichknüpfer alt, sagen Campbewohner."
                            },
                            {
                                "example_id": "42c8fb44-e9ad-4559-8bba-47c2e033a4bc",
                                "sense_id": "9d8c6d6a-2405-350d-8040-d77440eb5341",
                                "text": "Der Name „al-Halladsch“ bedeutet der Teppichknüpfer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
