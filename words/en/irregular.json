{
    "word_family": [
        "regular",
        "regularity",
        "irregularity",
        "regularly",
        "regulate",
        "regulation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd543950-fa5e-3566-83e1-2be3d658588c",
                    "sense_definition": "Not following the standard patterns of grammar, such as verb endings or plurals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "English has many <w>irregular</w> verbs that students must memorize.",
                            "target_lang_translations": {
                                "ru": "В английском языке много <w>неправильных</w> глаголов, которые студенты должны выучить.",
                                "zh": "英语中有许多学生必须背诵的<w>不规则</w>动词。"
                            }
                        },
                        {
                            "text": "The word \"children\" is an <w>irregular</w> plural form of \"child\".",
                            "target_lang_translations": {
                                "ru": "Слово «children» — это <w>неправильная</w> форма множественного числа слова «child».",
                                "zh": "单词“children”是“child”的一种<w>不规则</w>复数形式。"
                            }
                        }
                    ],
                    "antonyms": [
                        "regular"
                    ],
                    "common_phrases": [
                        "irregular verb",
                        "irregular plural"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не следующий стандартным грамматическим правилам (например, в образовании форм глаголов или множественного числа).",
                        "zh": "不遵循标准语法规则，例如动词变位或名词复数形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправильный",
                                "target_lang_sense_clarification": "грамматический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不规则",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a371c451-1f15-3705-b7cb-ef26d40a8bb7",
                    "sense_definition": "Happening at times or intervals that are not fixed or predictable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor was concerned about the patient's <w>irregular</w> heartbeat.",
                            "target_lang_translations": {
                                "ru": "Врач был обеспокоен <w>нерегулярным</w> сердцебиением пациента.",
                                "zh": "医生对病人<w>不规律</w>的心跳感到担忧。"
                            }
                        },
                        {
                            "text": "Trains on this line run at <w>irregular</w> intervals during the weekend.",
                            "target_lang_translations": {
                                "ru": "Поезда на этой линии ходят с <w>нерегулярными</w> интервалами в выходные.",
                                "zh": "周末期间，这条线路的列车运行时间<w>不固定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unsteady",
                        "unstable",
                        "uneven",
                        "inconsistent"
                    ],
                    "antonyms": [
                        "regular"
                    ],
                    "common_phrases": [
                        "irregular intervals",
                        "irregular heartbeat",
                        "irregular hours"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий через неодинаковые или непредсказуемые промежутки времени.",
                        "zh": "发生在不固定或不可预测的时间或间隔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерегулярный",
                                "target_lang_sense_clarification": "о времени или событиях"
                            },
                            {
                                "target_lang_word": "неравномерный",
                                "target_lang_sense_clarification": "о ритме или пульсе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不定期",
                                "target_lang_sense_clarification": "关于时间或事件"
                            },
                            {
                                "target_lang_word": "不规律",
                                "target_lang_sense_clarification": "关于节奏或脉搏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72c829aa-2acd-37ab-bfab-530eb12ece68",
                    "sense_definition": "Having a shape or surface that is not even, smooth, or symmetrical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house was built with <w>irregular</w> stones of different sizes.",
                            "target_lang_translations": {
                                "ru": "Старый дом был построен из <w>неровных</w> камней разного размера.",
                                "zh": "这座老房子是用大小不一的<w>不规则</w>石块建造的。"
                            }
                        },
                        {
                            "text": "She traced the <w>irregular</w> outline of the island on the map.",
                            "target_lang_translations": {
                                "ru": "Она обвела <w>неправильный</w> контур острова на карте.",
                                "zh": "她在地图上描绘了该岛<w>不规则</w>的轮廓。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rough",
                        "coarse"
                    ],
                    "antonyms": [
                        "regular"
                    ],
                    "common_phrases": [
                        "irregular shape",
                        "irregular surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий неровную, негладкую или несимметричную форму или поверхность.",
                        "zh": "形状或表面不平整、不光滑或不对称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправильный",
                                "target_lang_sense_clarification": "о форме"
                            },
                            {
                                "target_lang_word": "неровный",
                                "target_lang_sense_clarification": "о поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不规则",
                                "target_lang_sense_clarification": "关于形状"
                            },
                            {
                                "target_lang_word": "凹凸不平",
                                "target_lang_sense_clarification": "关于表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a661dd03-1216-3dee-8bec-b2843946fd51",
                    "sense_definition": "Not conforming to official rules, laws, or standard customs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rules_conduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is highly <w>irregular</w> for a lawyer to speak to a witness without permission.",
                            "target_lang_translations": {
                                "ru": "Для адвоката крайне <w>недопустимо</w> разговаривать со свидетелем без разрешения.",
                                "zh": "律师在未经许可的情况下与证人交谈是极度<w>违规</w>的。"
                            }
                        },
                        {
                            "text": "The auditor found several <w>irregular</w> payments in the company accounts.",
                            "target_lang_translations": {
                                "ru": "Аудитор обнаружил несколько <w>неправомерных</w> платежей на счетах компании.",
                                "zh": "审计员在公司账目中发现了多笔<w>违规</w>付款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abnormal",
                        "strange",
                        "singular"
                    ],
                    "antonyms": [
                        "regular"
                    ],
                    "common_phrases": [
                        "highly irregular",
                        "most irregular"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не соответствующий официальным правилам, законам или общепринятым нормам.",
                        "zh": "不符合官方规则、法律或标准习俗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправомерный",
                                "target_lang_sense_clarification": "о действиях или финансах"
                            },
                            {
                                "target_lang_word": "нарушающий правила",
                                "target_lang_sense_clarification": "о поведении"
                            },
                            {
                                "target_lang_word": "нестандартный",
                                "target_lang_sense_clarification": "отклоняющийся от нормы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "违规",
                                "target_lang_sense_clarification": "关于行为或财务"
                            },
                            {
                                "target_lang_word": "不合常规",
                                "target_lang_sense_clarification": "偏离标准"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad1254bb-3bcc-3447-a606-a10b9febcf47",
                    "sense_definition": "A soldier who is not a member of an official military force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army faced attacks from armed <w>irregulars</w> hiding in the mountains.",
                            "target_lang_translations": {
                                "ru": "Армия столкнулась с атаками вооруженных <w>партизан</w>, скрывающихся в горах.",
                                "zh": "军队遭到了躲藏在山中的武装<w>游击队员</w>的袭击。"
                            }
                        },
                        {
                            "text": "A group of <w>irregulars</w> defended the village until help arrived.",
                            "target_lang_translations": {
                                "ru": "Группа <w>бойцов иррегулярных войск</w> защищала деревню, пока не подоспела помощь.",
                                "zh": "一群<w>非正规军</w>保卫了村庄，直到援军赶到。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдат, не являющийся членом официальных регулярных вооруженных сил.",
                        "zh": "非正规军事力量的成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партизан",
                                "target_lang_sense_clarification": "участник неофициального отряда"
                            },
                            {
                                "target_lang_word": "боец иррегулярных войск",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游击队员",
                                "target_lang_sense_clarification": "非正规武装人员"
                            },
                            {
                                "target_lang_word": "非正规军",
                                "target_lang_sense_clarification": "军事术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}