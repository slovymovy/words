                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a840495f-b9d0-4f02-8e5a-a1585a09d4e8",
                                "sense_id": "438dccfb-2ffc-3419-9ce4-83b697bfc43a",
                                "text": "Michał ma upierdolony palec, bo ciął metal i brzeszczot mu się ześlizgnął."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "9586eaa1-0ca9-38dc-a507-e2620be84931",
