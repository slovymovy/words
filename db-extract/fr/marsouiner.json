                                        "sense_id": "ce3866c3-2d1d-3e8a-a4dd-b8ff066b449d",
                                        "entry_id": "d181eed8-8a50-3d16-b64f-d33ee1844e60",
                                        "glosses": [
                                            "Any small cetacean of the family Phocoenidae, related to dolphins and whales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffc6010-0920-4c11-80ac-b67781008984",
                                                "sense_id": "ce3866c3-2d1d-3e8a-a4dd-b8ff066b449d",
                                                "text": "They captured 25 porpoises and set them free back into the Yangtze after raising them for a month in Puqi County, Hubei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5378c3-7676-380c-82b4-d4133b34e403",
                                        "entry_id": "d181eed8-8a50-3d16-b64f-d33ee1844e60",
                                        "glosses": [
                                            "Any small dolphin."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "porpoise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14ee33ad-127a-394d-9303-db152f95561e",
                                        "entry_id": "ec02bab6-2911-3390-a8e2-6446186393c5",
                                        "glosses": [
                                            "Said of an air-breathing aquatic animal such as a porpoise or penguin: To repeatedly jump out of the water to take a breath and dive back in a continuous motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e911e8-45e7-45b7-8acb-33b096090701",
                                                "sense_id": "14ee33ad-127a-394d-9303-db152f95561e",
                                                "text": "Urging them to join me, I raced in circles through the surging water, chased my tail for the children, blew spouts of foam through the sunfilled spray, porpoised to and fro across the river in shallow leaps that stitched the air and water into a table-lace of foam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f591fc78-d9c0-3618-809b-626bd31ccc7d",
                                        "entry_id": "ec02bab6-2911-3390-a8e2-6446186393c5",
                                        "glosses": [
                                            "Said of an aircraft: to make a series of plunges when taking off or landing; or of a watercraft: to successively plunge up and down in the water."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
