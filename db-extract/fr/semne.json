                        "glosses": [
                            "Secte de philosophes gymnosophistes qui prétendaient pouvoir prédire l'avenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668eb09f-16ed-496a-b24e-1b0d2ef672a1",
                                "sense_id": "a674ca0c-541f-3610-92a0-d9f2a3baaf79",
                                "text": "Parce que les semnes des Indes convenaient en tout avec nos druides ; les semnes, dit S. Clément d'Alexandrie font leur étude de la vérité, se piquent de lire l'avenir."
                            },
                            {
                                "example_id": "bbfe8f64-9220-4a1c-ac51-5bd6ff21e35d",
                                "sense_id": "a674ca0c-541f-3610-92a0-d9f2a3baaf79",
                                "text": "Il existe encore chez les gymnosophistes de l'Inde une secte nommée les Semnes, chez lesquels les femmes conservent leur virginité et prédisent les choses futures."
                            }
                        ]
                    }
