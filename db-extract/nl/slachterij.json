        "nl-extract.jsonl": [
            {
                "entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                "word": "slachterij",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8778a394-e24c-47da-84f9-75d957039a6c",
                        "entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                        "tags": [
                            "plural"
                        ],
                        "form": "slachterijen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                        "entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                        "glosses": [
                            "bedrijf waar vee wordt gedood voor consumptie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af2451e6-1fc3-4a27-a500-a562005e1d9f",
                                "sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                                "text": "Er waren ook geschenken van twijfelachtig allooi: Jan Orthensen, de schapenboer van op de Smorenhoek, kwam met een dood lam aanzetten; een jonge moeder uit het dorp wilde per se een plastic zak vol volgepoepte luiers van haar pasgeboren baby verbranden; en slagersvrouw Gemma Holst schonk een kalfshoofd, een delicatesse die ze speciaal voor de gelegenheid bij de slachterij had besteld."
                            },
                            {
                                "example_id": "b1928033-f55e-4a4b-8a07-e14b2ff3bbf6",
                                "sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                                "text": "De vrouw die vrijdagmiddag gewond raakte bij een incident bij slachterij Van Kooten in Montfoort blijkt Saskia van Rooy te zijn. De dierenactiviste uit Stolwijk zegt bijna vermoord te zijn door medewerkers van de slachterij, omdat zij foto’s stond te maken. Volgens de directeur van het Montfoortse bedrijf is dat ‘volkomen onzin’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "688510cf-386a-40ef-8eb2-7899cd46f6fa",
                        "source_entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                        "source_sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                        "source_sense_description": "slachthuis",
                        "target_lang_word": "Schlachterei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachterei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd57d3a7-1609-36a8-834e-595717e9b4c1",
                                        "entry_id": "439ee5f0-d279-30b1-894c-3454beb7b371",
                                        "glosses": [
                                            "Betrieb, in dem Fleisch- und Wurstwaren hergestellt und verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd930b30-56be-4272-a83a-d72ad05d2a31",
                                                "sense_id": "dd57d3a7-1609-36a8-834e-595717e9b4c1",
                                                "text": "„Später beherbergte das Haus eine koschere Schlachterei, überstand die Bombardements und wurde 1959 abgerissen, um für die Erweiterung einer Brauerei in der Nähe Platz zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a01089e-f5ef-4f41-858d-3a4a1ac935d2",
                        "source_entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                        "source_sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                        "source_sense_description": "slachthuis",
                        "target_lang_word": "Schlachthaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachthaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                        "entry_id": "9dd57976-53cf-3a32-9573-87ff4346d979",
                                        "glosses": [
                                            "Haus, in dem geschlachtet werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761cfd85-8210-43d9-acf7-e60dc4682f7d",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Sie schmeckte mir so vorzüglich, dass ich mir fest vornahm, an einer jener mystischen privaten Hausschlachtungen teilzunehmen, die der Klaus nur wenige Schritte vom »Klausenhof« entfernt in einem eigens dafür hergerichteten historischen Schlachthaus zelebriert.“"
                                            },
                                            {
                                                "example_id": "b7db47ca-1d5b-4955-bf0a-11a361d05909",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Schnell ließen sie die Viehbörse hinter sich und durchquerten ein Labyrinth von Ställen, Schlachthäusern und Verwaltungsgebäuden.“"
                                            },
                                            {
                                                "example_id": "a86fa4b2-d963-4662-b404-234258cbe5e0",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Unsere Lóa ist in Wirklichkeit so harmlos und gutherzig, dass sie sich vor Sorge und Kummer ins Bett legt, wenn sie im Herbst die Schafe ins Schlachthaus schicken muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c4e4144-9f03-46e1-aee6-37967af09754",
                        "source_entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                        "source_sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                        "source_sense_description": "slachthuis",
                        "target_lang_word": "Schlachthof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachthof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                        "entry_id": "e8407251-0dd2-3470-89b3-c000f79f3a66",
                                        "glosses": [
                                            "Einrichtung, in welcher Tieren das Leben genommen werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d898fc-b27f-4555-b564-69f81b243026",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "In Schlachthöfen werden Tiere geschlachtet."
                                            },
                                            {
                                                "example_id": "3023c2d2-b413-4f4a-b93f-bc4dba1afd0b",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "„Viehhof, Schlachthof und Fleischgroßmarkt bilden ein untrennbares wirtschaftliches Ganzes.“"
                                            },
                                            {
                                                "example_id": "aca2b31e-34b2-4abd-aea7-d3d7c798f6ff",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "„Man hätte sie für eine berühmte Schauspielerin halten können, doch in Fritze Grails Kneipe gegenüber dem Schlachthof verirrten sich keine Ufa-Stars.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f328f13-7438-4517-9306-da5318998414",
                        "source_entry_id": "de57187a-e082-3c3c-b207-9c9e4a9e8420",
                        "source_sense_id": "44af7f05-ae96-3d84-9eb4-2e223f27d17d",
                        "source_sense_description": "slachthuis",
                        "target_lang_word": "Metzgerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metzgerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                        "entry_id": "ca33aa90-93df-3a39-b031-d2fc4a8074d5",
                                        "glosses": [
                                            "Betrieb, in dem Fleisch- und Wurstwaren hergestellt und verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867492b4-d4ff-4399-bb84-e5f1f759dc62",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "Fleisch und Wurst kauft man am besten in der Metzgerei."
                                            },
                                            {
                                                "example_id": "27020961-77d2-4164-925a-64cadf43268b",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„In die Metzgerei Blonski auf der anderen Seite des Platzes muss sie auch.“"
                                            },
                                            {
                                                "example_id": "bd56f47f-ddcb-4f58-9971-7f67fcfca5be",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„Bisweilen haben es die Deutschen untereinander schwer genug, sich auf ihren Speisekarten richtig zu verständigen und ihre Provinzialismen in Bäckerläden und Metzgereien zu entflechten.“"
                                            },
                                            {
                                                "example_id": "0f589662-5c20-4239-a043-27ca1d2ff4c6",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„Er sah aus wie eine hygienische Metzgerei.“"
                                            },
                                            {
                                                "example_id": "3807ef42-37ba-41f3-aff1-3c485e85e254",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„Zu jener Zeit besaß ihr Vater ein Lebensmittelgeschäft und eine Metzgerei und war wohlhabend genug, um eine russische Einwanderin namens Anna als Hausmädchen zu beschäftigen, das unter einem Dach mit der Familie wohnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b5ea2f2-707f-4476-b8b9-3b7364d7488c",
