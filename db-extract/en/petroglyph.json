                                        "glosses": [
                                            "Trace de dessin ou d’écriture sur de la pierre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0b4a76e-de6f-435b-8b34-31b096823807",
                                                "sense_id": "88666e9c-664e-3aad-93f2-54f2f326da61",
                                                "text": "Les idéogrammes d’origine de ce pétroglyphe ont été écrits en - 42 527 par un Atlante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "061b71da-1fa6-4367-8f06-15340b51480d",
                        "source_entry_id": "8df1c4a9-4c13-3a72-b5b8-f82ce3569e35",
                        "source_sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                        "source_sense_description": "a rock carving, especially one made in prehistoric times",
                        "target_lang_word": "Petroglyphe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petroglyphe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                                        "entry_id": "9290ab2c-cd01-32c3-a9c8-0b784ef693d0",
                                        "glosses": [
                                            "in Stein geritzte bildliche und grafische Darstellungen aus prähistorischer Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1bd855-5dd9-4546-afb8-2aa0a74a99a0",
                                                "sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                                                "text": "„Als Sonnensteine werden drei Steine bezeichnet, die in Beckstedt bei Colnrade, Harpstedt und Horsten in Niedersachsen gefunden wurden. […] Die Steine zeigen die Petroglyphen konzentrischer Kreise auf der Vorderseite, die um einen vertieften Mittelpunkt verlaufen.“"
                                            },
                                            {
                                                "example_id": "cc324df5-26c6-44c4-97a4-f6ce9ec1d84a",
                                                "sense_id": "ce90a917-9e3e-3cc4-b1a0-d8f3a936143b",
                                                "text": "„Doch auch die uralten Petroglyphen (Felsritzungen) der Fezzan und Tassili in Libyen und Algerien und die jungsteinzeitlichen Felsmalereien in Marokko gehören zu dem reichen Schatz an Inspirationen, dessen sich zeitgenössische Maler im Maghreb bedienen und in ihrer eigenen Kunst verarbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
