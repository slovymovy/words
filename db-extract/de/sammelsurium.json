                                "example_id": "dfd18c04-6e2c-452a-ba18-f179250946eb",
                                "sense_id": "fcdc1ed8-5a31-32ec-a65d-d7266c8c0b67",
                                "text": "Das Gesetz selbst ist Stückwerk, dauernd wurde es verändert, ein verwirrendes Sammelsurium.",
                                "translation": "The law itself is patchwork, it has been changed continuously, a confusing hodgepodge.",
                                "english": "The law itself is patchwork, it has been changed continuously, a confusing hodgepodge."
                            },
                            {
                                "example_id": "283e56da-32d4-494b-b1f3-48edd06639df",
                                "sense_id": "fcdc1ed8-5a31-32ec-a65d-d7266c8c0b67",
                                "text": "Manche Länder haben dabei einen zentralen Auftritt, andere ein Sammelsurium aus vielen Einzelanbietern; es sind aber ohnehin nicht alle Länder da, nicht einmal alle Bundesländer.",
                                "translation": "Some countries have a single centralised presence, others a hodgepodge of many individual sellers; but not all countries are participating anyway, not even all states.",
                                "english": "Some countries have a single centralised presence, others a hodgepodge of many individual sellers; but not all countries are participating anyway, not even all states."
                            }
                        ]
                    }
