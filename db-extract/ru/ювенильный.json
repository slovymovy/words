                "senses": [
                    {
                        "sense_id": "9881f9e0-7fdf-3a59-aca0-60225187dbce",
                        "entry_id": "60bd1d88-e1dc-3e2c-9c17-0ac8412c9e22",
                        "glosses": [
                            "книжн. то же, что ювенальный; неполовозрелый; свойственный неполовозрелому организму"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb7010f9-a1d0-344a-b834-94bb5185ac66",
                        "entry_id": "60bd1d88-e1dc-3e2c-9c17-0ac8412c9e22",
                        "glosses": [
                            "книжн., перен. свойственный молодёжи; молодой, юношеский"
                        ],
                        "tags": [],
