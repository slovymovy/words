                "senses": [
                    {
                        "sense_id": "16b38268-0123-32e9-88e9-cd29574a6ec1",
                        "entry_id": "821bed52-1d11-3ad6-a35b-e205b88e1e6e",
                        "glosses": [
                            "Gastwirtschaft, in der Bier ausgeschenkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df14313-ceb3-48c6-b9d0-5c19af252672",
                                "sense_id": "16b38268-0123-32e9-88e9-cd29574a6ec1",
                                "text": "Die Fahrradfahrer gönnten sich in der Bierwirtschaft ein paar Krüge Schwarzbier."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                        "entry_id": "821bed52-1d11-3ad6-a35b-e205b88e1e6e",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit der Herstellung und dem Vertrieb von Bier beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8258c17-4d27-4c6b-aee0-01664d290555",
                                "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                                "text": "„Offensichtlich kann aber auch die deutsche Bierwirtschaft damit gut leben, weil sich das deutsche Reinheitsgebot als ein durchaus erfolgreiches Werbeargument vermarkten läßt.“"
                            },
                            {
                                "example_id": "6a3f2ced-c823-4f8f-997b-bed46a71fa86",
                                "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                                "text": "„Die Schauenburger Grafen, seinerzeit die Stadtherren, nutzten zur Entwicklung der Bierwirtschaft alle Vorzüge des Standorts.“"
                            },
                            {
                                "example_id": "db8aaa7e-cb53-4e4d-ac9c-f0bcf2c512a6",
                                "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                                "text": "„Wegen der Auswirkungen der Bierwirtschaft auf die städtischen, provinziellen und fürstlichen Finanzen hatten diese Spannungen auch unmittelbar eine politische Resonanz.“"
                            },
                            {
                                "example_id": "c9072362-6f68-4990-b315-51a8c4117342",
                                "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                                "text": "„Dabei hatte Südtirol früher eine florierende Bierwirtschaft.“"
                            },
                            {
                                "example_id": "65e4269c-a7ef-4554-94a4-c5726778db4b",
                                "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                                "text": "„In ihrer Verzweiflung findet sie einen Verbündeten: die bayerische Bierwirtschaft.“"
                            },
                            {
                                "example_id": "27b463a0-8d86-411f-97b0-5e8b3134d627",
                                "sense_id": "d4ec760e-f2cb-32d9-bc34-28f0050cc768",
                                "text": "„Bei aller regionalen Differenz der Regelungen läßt sich für den hier interessierenden räumlichen Bereich doch bei der Bierwirtschaft am stärksten von allen Zweigen der Alkoholwirtschaft der Charakter des bürgerlichen Gewerbes bemerken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
