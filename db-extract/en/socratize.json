                "senses": [
                    {
                        "sense_id": "662f611f-7235-30ca-837c-696f6130b89a",
                        "entry_id": "0a985734-7b1e-3dea-980a-40a0aa22ef69",
                        "glosses": [
                            "To be like Socrates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e548740c-be87-4ead-9772-3e083adc8139",
                                "sense_id": "662f611f-7235-30ca-837c-696f6130b89a",
                                "text": "...they started up a-stare At the half-helot captain and his crew —Spartans, \"men used to let their hair grow long, To fast, be dirty, and just — Socratize \" — Whose word was \"Trample on Themistokles!\""
                            },
                            {
                                "example_id": "2ce4dea2-e3fa-4297-a71c-9cae5f4545b4",
                                "sense_id": "662f611f-7235-30ca-837c-696f6130b89a",
                                "text": "In this case the principle fails because there is (to put the anti-Fregean's case in Fregean terms) nothing that does not Socratize if and only if wisdom does Socratize."
                            }
                        ]
                    },
                    {
                        "sense_id": "70377706-7839-3a47-b8f6-96774e1c0652",
                        "entry_id": "0a985734-7b1e-3dea-980a-40a0aa22ef69",
                        "glosses": [
                            "To be like Socrates.",
                            "To explore an idea by probing questions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb3f8ce-5b8e-4750-a5a6-127c5f88ba55",
                                "sense_id": "70377706-7839-3a47-b8f6-96774e1c0652",
                                "text": "Socrates is satisfied to discuss with good sense, and is willing to examine, and to appeal to reason rather than to authority.” Then he asks himself if he cannot “Socratize” too, and the revolutionary standard is unfurled."
                            },
                            {
                                "example_id": "ea0756f0-f127-4188-bd6e-24da6b3c90e4",
                                "sense_id": "70377706-7839-3a47-b8f6-96774e1c0652",
                                "text": "It is the teacher's duty to assign tasks to warn and to chastise; one favorite Pestalozzian method was to \"Socratize,\" or, catechizing for cultivation of intellect and spiritual exercise."
                            },
                            {
                                "example_id": "dfdaab30-ce06-4823-bc64-47fdf69c1397",
                                "sense_id": "70377706-7839-3a47-b8f6-96774e1c0652",
                                "text": "It is impossible to Socratize five-hundred students all at once."
                            },
                            {
                                "example_id": "398a702e-a65a-4192-9fe3-a6ba26bd301f",
                                "sense_id": "70377706-7839-3a47-b8f6-96774e1c0652",
                                "text": "Everyone was unwinding after the weekly tensions of our final year—from the professor before us (who would Socratize in a bantering, conversational tone with teenagers) to the gang at the back of the room, half-heartedly following the dialogued chain of ideas in this majeutical formulation."
                            },
                            {
                                "example_id": "b3e4713f-de0f-475a-be88-c54491b61722",
                                "sense_id": "70377706-7839-3a47-b8f6-96774e1c0652",
                                "text": "It just so happens that coffeehouses are particularly good places to Socratize."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e3f75d2-fcec-3be4-87cd-e8c2700db300",
                        "entry_id": "0a985734-7b1e-3dea-980a-40a0aa22ef69",
                        "glosses": [
                            "To be like Socrates.",
                            "To sodomize."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ba4203ca-474a-4342-b066-691ada8a8811",
                                "sense_id": "8e3f75d2-fcec-3be4-87cd-e8c2700db300",
                                "text": "Turning both side ways, our genitals in a heap, the sight overwhelmed me, yet lust, a desire to Socratize him – as nearly as I can define my sensations – scarcely entered into the confused and lustful combinations, caused by my clasping him as if he were a woman."
                            },
                            {
                                "example_id": "9fd1650c-0348-48b0-81ca-313b105c6135",
                                "sense_id": "8e3f75d2-fcec-3be4-87cd-e8c2700db300",
                                "text": "After he had done considerable sucking, I took up another whip, laid on a second time and socratized him again, he knelt as before and returned to his licking, and so it went, each of us doing his part at least fifteen times over."
                            },
                            {
                                "example_id": "53108caf-7ed7-4ea9-9fba-b557a4c954c1",
                                "sense_id": "8e3f75d2-fcec-3be4-87cd-e8c2700db300",
                                "text": "Get real man, I know / quality when I see it, each / sixpack brings you closer to / divinity. Laid back now that / I’m 36 & middle-aged, even so / I like to Socratize with / youngmen."
                            }
                        ]
                    }
