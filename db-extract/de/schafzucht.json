                "senses": [
                    {
                        "sense_id": "25a50ff3-a1d4-3d56-b7d5-ff5b6ee31349",
                        "entry_id": "226fb97e-8dc5-313e-9c80-8393ca31e91f",
                        "glosses": [
                            "die kontrollierte Vermehrung und Aufzucht von Schafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5695fb7-5c20-473b-a3b5-b4cdfed575b2",
                                "sense_id": "25a50ff3-a1d4-3d56-b7d5-ff5b6ee31349",
                                "text": "„Was letztendlich dazu führte, dass sich die Bauern der Schafzucht zuwandten, die zu ihrer wichtigsten Einnahmequelle wurde.“"
                            },
                            {
                                "example_id": "d61aea10-a56a-41f4-8770-6f175bf0e075",
                                "sense_id": "25a50ff3-a1d4-3d56-b7d5-ff5b6ee31349",
                                "text": "„Des Weiteren gelang dem Adel die allmähliche Aneignung der Allmende, des vom Dorf gemeinschaftlich genutzten Weidelands, für die gutsherrliche Schafzucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
