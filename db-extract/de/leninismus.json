                                "sense_id": "a4b61c08-2e89-36ef-882d-9f5a88b77aa6",
                                "text": "„Mugabe übernahm die Verschleierung, jedoch ohne den ideologischen Gehalt des Leninismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
