                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c55b8cd-07fe-4450-bfe3-1ef46054d5d4",
                                "sense_id": "22fd05e6-4378-3abd-a500-23f05f3ab4bf",
                                "text": "„Gleichzeitig wird auch das ins Wasser fallende Laub etwas effektiver zersetzt, denn auch die gewässereigenen Abfallentsorger profitieren vom Desinteresse der heuschreckengesättigten Fische.“"
                            },
                            {
                                "example_id": "86255c26-bb7c-4f69-bd2d-e311f1650470",
                                "sense_id": "22fd05e6-4378-3abd-a500-23f05f3ab4bf",
                                "text": "„Dem neuen bakteriellen Abfallentsorger spendierten die Forscher zudem ein Protein, welches an Zellulose bindet und das Bakterium damit an Oberflächen fixieren kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
