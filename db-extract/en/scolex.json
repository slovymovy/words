                                            {
                                                "example_id": "abff60c1-2a60-4cb0-8db2-5f9256ef8083",
                                                "sense_id": "e5f85e7f-b78e-3f76-9aaf-bfab99d23fee",
                                                "text": "Oddałem do naprawy starą gitarę z pęknięta główką."
