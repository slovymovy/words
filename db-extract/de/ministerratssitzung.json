                "senses": [
                    {
                        "sense_id": "0d438810-17b6-30dd-950a-571dff2b9ea4",
                        "entry_id": "bd3b79fe-6803-3cf3-8ed3-192d6e690fe9",
                        "glosses": [
                            "Sitzung, an der die Mitglieder des Ministerrates teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b778738-8fc3-48ed-b526-d283c1cedd5a",
                                "sense_id": "0d438810-17b6-30dd-950a-571dff2b9ea4",
                                "text": "„Mit der ersten Ministerratssitzung unter seiner Leitung will Staatschef Erdogan offensichtlich die politischen Agenden noch deutlicher an sich ziehen und Partei und Regierung auf Kurs zu den Parlamentswahlen im Juni bringen.“"
                            },
                            {
                                "example_id": "824df601-9fa4-4bc9-a331-cb962b54addb",
                                "sense_id": "0d438810-17b6-30dd-950a-571dff2b9ea4",
                                "text": "„Diese möglichen Schritte seien in der Ministerratssitzung am Dienstag diskutiert worden, heißt es aus Teilnehmerkreisen.“"
                            },
                            {
                                "example_id": "fca3efcb-2268-4676-8d12-fd496ede089b",
                                "sense_id": "0d438810-17b6-30dd-950a-571dff2b9ea4",
                                "text": "„Deshalb sei an einer Ministerratssitzung der Beschluss gefasst worden, dass die Regierung die volle Verantwortung für die Vorlage übernehme und diese ohne formelle Zustimmung der Assemblée durchsetzen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
