                "senses": [
                    {
                        "sense_id": "dc8c0059-e4f3-3868-b866-fd9432281c7b",
                        "entry_id": "bf3ec08d-3319-3f30-a880-f118623cd220",
                        "glosses": [
                            "persoon die op last van de regering zijn eigen land heeft moeten verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97554127-6e0b-4776-ba82-5fbce33f14f2",
                                "sense_id": "dc8c0059-e4f3-3868-b866-fd9432281c7b",
                                "text": "De Dalai Lama verblijft als banneling in India."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fffc7560-a97f-4127-a523-6026cd1723fb",
                        "source_entry_id": "bf3ec08d-3319-3f30-a880-f118623cd220",
                        "source_sense_id": "dc8c0059-e4f3-3868-b866-fd9432281c7b",
                        "source_sense_description": "iemand die verbannen is",
                        "target_lang_word": "Exilant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exilant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "713e4e34-c164-3091-92c0-4a39884b74bf",
                                        "entry_id": "65a90341-b480-3ae8-b96c-ea3049533525",
                                        "glosses": [
                                            "jemand, der im Exil lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbcc863-8760-4f8c-b4dc-f62f72de1e99",
                                                "sense_id": "713e4e34-c164-3091-92c0-4a39884b74bf",
                                                "text": "Der Exilant lebt schon lange im Exil."
                                            },
                                            {
                                                "example_id": "f0de4bb5-5573-47ab-935e-f9da2782d0bb",
                                                "sense_id": "713e4e34-c164-3091-92c0-4a39884b74bf",
                                                "text": "„Eingeladen wurden vor allem Exilanten: Schriftsteller und Journalisten, Schauspieler und Regisseure, Komponisten und Musiker.“"
                                            },
                                            {
                                                "example_id": "e382b56d-d285-4606-aa52-dc3304c1e477",
                                                "sense_id": "713e4e34-c164-3091-92c0-4a39884b74bf",
                                                "text": "„Doch auch der wichtigste Radiosender der Exilanten in Miami trägt Martís Namen; Castros Gegner beanspruchen sein Erbe ebenso für sich.“"
                                            },
                                            {
                                                "example_id": "dfa00ea5-5a0e-4aa5-b911-a3e495182618",
                                                "sense_id": "713e4e34-c164-3091-92c0-4a39884b74bf",
                                                "text": "„Was er zu sagen hat, was er in diesen Jahren denkt und empfindet, läßt er in seine Romane einfließen, in denen er das Leben der Exilanten in einer sie ablehnenden Welt mitfühlend beschreibt.“"
                                            },
                                            {
                                                "example_id": "ee61029f-724f-4cce-a328-e63b4187ccf7",
                                                "sense_id": "713e4e34-c164-3091-92c0-4a39884b74bf",
                                                "text": "„Im Konsens mit der Majorität führten Max Brauer und Herbert Weichmann, zwei Exilanten, den Stadtstaat Hamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "768533e9-223a-4cea-a074-ae097b2cb6e4",
                        "source_entry_id": "bf3ec08d-3319-3f30-a880-f118623cd220",
                        "source_sense_id": "dc8c0059-e4f3-3868-b866-fd9432281c7b",
                        "source_sense_description": "iemand die verbannen is",
                        "target_lang_word": "exile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "The state of being banished from one's home or country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf95d16-de8e-4f3e-a7bd-003ca5fa4825",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "He lived in exile."
                                            },
                                            {
                                                "example_id": "eb50e641-0cac-4b7d-80ac-a494020503c7",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "They chose exile rather than assimilation."
                                            },
                                            {
                                                "example_id": "17cd259e-ddeb-4cb8-9022-ea5f3c2fe97c",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "Let them be recalled from their exile."
                                            },
                                            {
                                                "example_id": "3dbce57f-9ea8-4caf-b4fe-da514d06f81b",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "Someone who is banished from his home or country."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114ace20-b0e7-47f3-bfdf-5ef2eb2283db",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "She lived as an exile, and did her best to make the most out of such life."
                                            },
                                            {
                                                "example_id": "d3ffce3f-a27d-437b-a365-4cbb94bf6a54",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "Thou art an exile, and thou must not stay."
                                            },
                                            {
                                                "example_id": "48e6b175-21bc-4ffd-b95e-7481a745b37f",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                        "entry_id": "8b58734b-4757-3c88-96bc-30e33853883e",
                                        "glosses": [
                                            "To send (someone or something) into exile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cd5c73-0037-4b82-97a4-bd6c1a20c07e",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "Calling home our exiled friends abroad."
                                            },
                                            {
                                                "example_id": "e906013b-93c6-4eaa-9b2d-b4260c1034e8",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "She, mouldering with the dull earth's mouldering sod, / Inwrapt tenfold in slothful shame, / Lay there exiled from eternal God, / Lost to her place and name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fcf01a5-0a29-4cb0-9941-bf37fbf6a7b7",
                        "source_entry_id": "bf3ec08d-3319-3f30-a880-f118623cd220",
                        "source_sense_id": "dc8c0059-e4f3-3868-b866-fd9432281c7b",
                        "source_sense_description": "iemand die verbannen is",
                        "target_lang_word": "exilé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                        "entry_id": "8a96186a-4d7c-3206-bd12-d6f393fea43c",
                                        "glosses": [
                                            "Personne qui quitte volontairement ou non son lieu de vie original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06586091-4a9a-4d79-aeda-af541d38141c",
                                                "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                                "text": "Il a été un exilé, comme moi, puisqu’il a choisi l’exil à Crotone, pour fuir les abus du tyran Polycrate."
                                            },
                                            {
                                                "example_id": "7601e372-dcf8-4ead-afda-6f530a16b6b4",
                                                "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                                "text": "Nous vivons en exilés sans point de départ ni d’arrivée, avec pour seul appui cette ligne de diamants tendue au-dessus du vide, la route, que nous parcourons en acrobate."
                                            },
                                            {
                                                "example_id": "12965286-a3a6-4e70-9db9-a368bd963bf1",
                                                "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                                "text": "On rappela les exilés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5c2b2b-1092-310c-bd9f-ae2125c257e3",
                                        "entry_id": "7ccd34d8-a0cc-306b-bc94-181510933244",
                                        "glosses": [
                                            "Qui vit en exil, loin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "exilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "741781ea-4d4d-3636-946a-c8621f881aa7",
                                        "entry_id": "412f197c-f6ac-3231-bf28-c1dee594664d",
                                        "glosses": [
                                            "Participe passé masculin singulier de exiler."
                                        ],
                                        "tags": [
