{
    "word_family": [
        "gekrioel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ba86e00-2148-37d3-ab26-e16dbbdba6a7",
                    "sense_definition": "vol zijn met een grote hoeveelheid bewegende mensen of dieren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drukte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De straten <w>krioelen</w> hier van de toeristen.",
                            "target_lang_translations": {
                                "en": "The streets here are <w>swarming</w> with tourists."
                            }
                        },
                        {
                            "text": "Het <w>krioelde</w> hier van de mieren.",
                            "target_lang_translations": {
                                "en": "It was <w>teeming</w> with ants here."
                            }
                        }
                    ],
                    "synonyms": [
                        "krielen",
                        "wemelen"
                    ],
                    "common_phrases": [
                        "krioelen van de mensen",
                        "krioelen van de mieren"
                    ],
                    "target_lang_definitions": {
                        "en": "to be full of a large number of moving people or animals"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to swarm",
                                "target_lang_sense_clarification": "to be crowded with moving things"
                            },
                            {
                                "target_lang_word": "to teem",
                                "target_lang_sense_clarification": "to be full of or swarming with"
                            },
                            {
                                "target_lang_word": "to crawl",
                                "target_lang_sense_clarification": "to be covered or filled with something unpleasant or small"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc2f676-0feb-3111-ab1d-40a5ecf87b3a",
                    "sense_definition": "in grote aantallen willekeurig door elkaar heen bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De talrijke wandelaars <w>krioelen</w> in hun bonte kledij dooreen op het plein.",
                            "target_lang_translations": {
                                "en": "The numerous hikers are <w>milling about</w> in their colorful clothes on the square."
                            }
                        },
                        {
                            "text": "Ik zag de insecten door elkaar <w>krioelen</w> in het gras.",
                            "target_lang_translations": {
                                "en": "I saw the insects <w>scurrying</w> around each other in the grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "krielen",
                        "wemelen"
                    ],
                    "common_phrases": [
                        "door elkaar krioelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move around randomly in large numbers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to mill about",
                                "target_lang_sense_clarification": "to move around in a confused or aimless way"
                            },
                            {
                                "target_lang_word": "to scurry",
                                "target_lang_sense_clarification": "to move quickly with short steps, often in groups"
                            },
                            {
                                "target_lang_word": "to throng",
                                "target_lang_sense_clarification": "to move in a large, dense crowd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}