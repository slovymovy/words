{
    "word_family": [
        "exuberant",
        "exuberantly",
        "exuberate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4602d7b8-a0ba-3b6e-a59a-d488bd9a7832",
                    "sense_definition": "The state or quality of being full of cheerful energy, excitement, and vigorous enthusiasm.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran through the playground with unmistakable youthful <w>exuberance</w>.",
                            "target_lang_translations": {
                                "ru": "Дети бегали по игровой площадке с безошибочно узнаваемой юношеской <w>жизнерадостностью</w>."
                            }
                        },
                        {
                            "text": "Her natural warmth and <w>exuberance</w> made her an engaging speaker at the conference.",
                            "target_lang_translations": {
                                "ru": "Её естественная теплота и <w>жизнерадостность</w> сделали её ярким и увлекательным докладчиком на конференции."
                            }
                        }
                    ],
                    "synonyms": [
                        "ebullience",
                        "enthusiasm",
                        "liveliness",
                        "verve",
                        "vigor"
                    ],
                    "antonyms": [
                        "apathy",
                        "lethargy"
                    ],
                    "common_phrases": [
                        "youthful exuberance",
                        "boundless exuberance",
                        "natural exuberance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество человека, полное жизнерадостной энергии, воодушевления и бьющего через край энтузиазма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнерадостность",
                                "target_lang_sense_clarification": "оптимистичная энергия"
                            },
                            {
                                "target_lang_word": "живость",
                                "target_lang_sense_clarification": "подвижность и живость характера"
                            },
                            {
                                "target_lang_word": "воодушевление",
                                "target_lang_sense_clarification": "прилив душевного подъёма и сил"
                            },
                            {
                                "target_lang_word": "бьющий через край энтузиазм",
                                "target_lang_sense_clarification": "бурная энергия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f8ed1e2-066e-3739-97aa-1d4d1baff6af",
                    "sense_definition": "An individual display or act of exuberant, unrestrained, or energetic behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gently forgave their occasional noisy <w>exuberances</w> after the holidays.",
                            "target_lang_translations": {
                                "ru": "Учительница снисходительно прощала им периодические шумные <w>выходки</w> после каникул."
                            }
                        },
                        {
                            "text": "Such wild <w>exuberance</w> in a formal meeting surprised most of the directors.",
                            "target_lang_translations": {
                                "ru": "Столь бурное <w>проявление эмоций</w> на официальном собрании удивило большинство директоров."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное проявление или всплеск неудержимого, бурного или чрезмерно энергичного поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "озорной поступок от избытка энергии"
                            },
                            {
                                "target_lang_word": "всплеск чувств",
                                "target_lang_sense_clarification": "проявление бурных эмоций"
                            },
                            {
                                "target_lang_word": "бурное проявление",
                                "target_lang_sense_clarification": "неудержимое поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8f9e408-95bc-3451-a10c-836fb0d0527b",
                    "sense_definition": "An overflowing, lush, or superfluous quantity, especially of plant growth or ornament.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild garden showcased an <w>exuberance</w> of colorful blossoms and winding vines.",
                            "target_lang_translations": {
                                "ru": "Дикий сад поражал <w>буйством</w> ярких цветов и вьющихся лоз."
                            }
                        },
                        {
                            "text": "Critics noted the architectural <w>exuberance</w> displayed on the cathedral facade.",
                            "target_lang_translations": {
                                "ru": "Критики отметили архитектурную <w>пышность</w>, проявившуюся в оформлении фасада собора."
                            }
                        }
                    ],
                    "synonyms": [
                        "profusion",
                        "superabundance"
                    ],
                    "antonyms": [
                        "scarcity",
                        "sparseness"
                    ],
                    "common_phrases": [
                        "exuberance of foliage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пышность, бурное разрастание растительности или чрезмерное богатство убранства, деталей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пышность",
                                "target_lang_sense_clarification": "о растительности или декоративных элементах"
                            },
                            {
                                "target_lang_word": "буйство",
                                "target_lang_sense_clarification": "о красках, зелени или цветении"
                            },
                            {
                                "target_lang_word": "изобилие",
                                "target_lang_sense_clarification": "богатство растительности или форм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff341b99-11e7-3b4a-b761-53e5a07b1e2d",
                    "sense_definition": "An excessive or overflowing abundance, especially of money, wealth, or resources.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic boom created an <w>exuberance</w> of capital in the region.",
                            "target_lang_translations": {
                                "ru": "Внезапный экономический подъем создал в регионе <w>избыток</w> капитала."
                            }
                        },
                        {
                            "text": "Investors were cautioned against misjudging an apparent <w>exuberance</w> of funds.",
                            "target_lang_translations": {
                                "ru": "Инвесторов предостерегли от ошибочной оценки кажущегося <w>изобилия</w> средств."
                            }
                        }
                    ],
                    "synonyms": [
                        "affluence",
                        "opulence",
                        "plenty"
                    ],
                    "antonyms": [
                        "poverty",
                        "destitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерное или бьющее через край изобилие, особенно в отношении денег, богатства или ресурсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобилие",
                                "target_lang_sense_clarification": "большое количество ресурсов или денег"
                            },
                            {
                                "target_lang_word": "избыток",
                                "target_lang_sense_clarification": "чрезмерное количество капитала"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}