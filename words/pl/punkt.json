                    "sense_definition": "Wyznaczone miejsce, placówka usługowa lub lokalizacja służąca do określonego celu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location_services",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W centrum miasta otwarto nowy <punkt> informacyjny dla turystów.",
                            "target_lang_translations": {
                                "ru": "В центре города открыли новый информационный <пункт> для туристов.",
                                "cs": "V centru města bylo otevřeno nové informační <w>místo</w> pro turisty."
