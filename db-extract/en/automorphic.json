                        "entry_id": "cf861c2f-e734-3797-914c-6e4801fe1f9b",
                        "glosses": [
                            "Describing a number whose square ends in the number itself; circular."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ad0a32b-93f3-4385-a701-3bd708aaed48",
                                "sense_id": "1fb0882b-270b-313f-a304-5d8c624b57b7",
                                "text": "5 is an automorphic number because 5² = 25, which ends in 5; similarly 625² = 390625, ends in 625."
                            }
                        ]
                    },
                    {
                        "sense_id": "67723fe5-936f-3a23-ac54-7dd8df0e5178",
                        "entry_id": "cf861c2f-e734-3797-914c-6e4801fe1f9b",
                        "glosses": [
                            "Of or pertaining to automorphy or an automorphism."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e7ece509-2b06-3232-9325-3c0d75272b36",
                        "entry_id": "cf861c2f-e734-3797-914c-6e4801fe1f9b",
                        "glosses": [
                            "Marked by automorphism, the ascription to others of one's own characteristics."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "68ab58c6-701a-4b5e-8b7b-5001b90ebb8e",
                                "sense_id": "e7ece509-2b06-3232-9325-3c0d75272b36",
                                "text": "1895 Hiram M. Stanley: Studies in the Evolutionary Psychology of Feeling. MacMillan\nThis automorphic interpretation is, however, extremely common, especially in lower psychism. The child and the savage judge inevitably and naturally that they are giving you the greatest pleasure when they share their dainties with you."
                            }
                        ]
                    }
