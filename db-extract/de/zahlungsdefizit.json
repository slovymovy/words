                ],
                "senses": [
                    {
                        "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                        "entry_id": "3b204afc-2d9d-3b0c-8d5d-bac804828bf2",
                        "glosses": [
                            "negative Zahlungsbilanz eines Landes, dessen Importe mehr kosten als die Exporte einbringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e938bf1e-22ef-423b-9082-375dd3e9ffac",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "„Wenn das Land mit den niederen Zinssätzen (Großbritannien) nicht nur eine Depression zu bekämpfen hat, sondern auch gleichzeitig an einem Zahlungsdefizit leidet, so vergrößert ein Kapitalabfluß seine Schwierigkeiten, […]“"
                            },
                            {
                                "example_id": "17a28757-1f4d-425d-b199-4209bd7d26fe",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "„Das wachsende Zahlungsdefizit der Vereinigten Staaten deutete auf eine Überbewertung des Dollar im Vergleich mit Währungen, die noch vor kurzem amerikanische Hilfe benötigt hatten.“"
                            },
                            {
                                "example_id": "a801a7ad-95c1-45ed-83bd-21d6f6c9173c",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "„Duisenberg wies auf das amerikanische Zahlungsdefizit von derzeit 400 Mrd. Dollar jährlich hin und sagte: «Auf Dauer ist ein solches Defizit nicht aufrecht zu erhalten und wird zu einer Korrektur an den Märkten führen. Wann, weiss ich nicht.»“"
                            },
                            {
                                "example_id": "8dee7595-d7e0-4b60-a18b-5a62207e0b16",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "„Die Hälfte der Bevölkerung darbt unterhalb der Armutsgrenze, die Arbeitslosigkeit nimmt zu, das Land importiert dreimal soviel wie es ausführt und hat ein von Jahr zu Jahr wachsendes Zahlungsdefizit.“"
                            },
                            {
                                "example_id": "8af9246d-3afd-4ebf-aa68-8bcd4f5a5fff",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "„Wir sind ein Land mit einem laufenden Zahlungsdefizit von achtzehn Prozent, und das muss man irgendwie finanzieren.“"
                            },
                            {
                                "example_id": "66b3f2fa-e830-40ef-a862-828a932eac61",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "„Dank des entschiedenen Eingreifens der Notenbanken, rückläufiger Importe und steigender Exporte hat sich die Lage in Indien trotz eines anhaltenden Zahlungsdefizits, einer Inflationsrate von über 11 % wie auch einer im Oktober deutlich gefallenen Industrieproduktion wieder beruhigt.“"
                            },
                            {
                                "example_id": "400b1896-6696-4878-94b6-bcf1ace7dcc2",
                                "sense_id": "535cf337-7351-3e93-ae11-a3a3ab67918e",
                                "text": "Das Zahlungsdefizit dieses Schuldners ist mittlerweile unerträglich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
