                    {
                        "translation_id": "e67d7ed1-0d7a-4e18-ae3e-9c4b7b047ea7",
                        "source_entry_id": "114bd6b6-846a-3e57-8502-3fcec50c3502",
                        "source_sense_id": "763eb0a5-9a83-3096-9580-15d80eadd1ca",
                        "target_lang_word": "fiscus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiscus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30f29d3b-eec4-31c5-8730-d989e81150f1",
                                        "entry_id": "49233b0d-6a5f-390c-bee5-d3885ee44ef2",
                                        "glosses": [
                                            "A government treasury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0033519-d66a-4305-9af0-5df858381b6f",
                                                "sense_id": "30f29d3b-eec4-31c5-8730-d989e81150f1",
                                                "text": "It generally applies to all taxes, stamp duties or other compulsory payments to state funds or local governments as well as any subsidies received from the central fiscus or state funds as long as the administration thereof is provided by the Tax and Financial Supervision Authority."
                                            },
                                            {
                                                "example_id": "cb37fc92-ca7c-4c4b-a198-60916ecb0646",
                                                "sense_id": "30f29d3b-eec4-31c5-8730-d989e81150f1",
                                                "text": "Furthermore, it is shown by the fact that the State treasury (\" fiscus \") could not be made a party to an action, and also, later, by the absolute power of the emperor."
                                            },
                                            {
                                                "example_id": "eb000a4a-16f1-4b4e-9180-0ac3af04a7f8",
                                                "sense_id": "30f29d3b-eec4-31c5-8730-d989e81150f1",
                                                "text": "For the first time in more than 30 years, the American fiscus was in a healthy state in the Fall of 2000."
                                            },
                                            {
                                                "example_id": "c8ac5c0d-d1e6-44a4-ae13-5690a25a56e3",
                                                "sense_id": "30f29d3b-eec4-31c5-8730-d989e81150f1",
                                                "text": "The soundness of the fiscal position enabled government to respond aggressively to the recent global financial crisis by raising spending and debt without compromising the long run sustainability of the fiscus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a439ed37-7e63-45d9-9621-4385c6c9a0be",
                        "source_entry_id": "114bd6b6-846a-3e57-8502-3fcec50c3502",
                        "source_sense_id": "763eb0a5-9a83-3096-9580-15d80eadd1ca",
                        "target_lang_word": "Fiskus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fiskus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                        "entry_id": "1e8f4299-36f0-325a-aa05-df2d6fa00fa8",
                                        "glosses": [
                                            "gesamtes Barvermögen eines Staates; Staatskasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370870e3-89be-4446-9fc3-4cbbc236cfe8",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "Dieses Jahr mussten wir schon wieder mehr Steuern an den Fiskus zahlen."
                                            },
                                            {
                                                "example_id": "f8ee6bec-74c8-4a7e-afaa-7878d1c4ea5c",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "„Schmenger und andere Fahnder befürchteten Millionenverluste für den Fiskus.“"
                                            },
                                            {
                                                "example_id": "47216f75-823d-4c67-bb47-52a59354419c",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "„Weil keine Erben dafür da waren, zog der Fiskus ihn ein und forstete ihn auf.“"
                                            },
                                            {
                                                "example_id": "e7b771f7-0bad-4d02-8322-aaa01cd37446",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "„Strafbar waren natürlich Geschäfte unter dem Ladentisch und am Fiskus vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
