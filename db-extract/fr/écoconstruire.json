                        "glosses": [
                            "Construire (une maison, etc.) en fonction de critères écologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1782ceef-0e0d-4925-9604-bcf599e2eb2b",
                                "sense_id": "a7f249ec-2bd9-3304-bc81-ebfdb8fe4ac2",
                                "text": "Si \"écoconstruire\" n'est plus un problème aujourd'hui, rénover une maison de caractère en respectant les normes environnementales ne va pas de soi."
                            },
                            {
                                "example_id": "86e4541d-c1f5-4247-b0b6-d783f405ec57",
                                "sense_id": "a7f249ec-2bd9-3304-bc81-ebfdb8fe4ac2",
                                "text": "Vous avez envie d'apprendre à écoconstruire ?"
                            },
                            {
                                "example_id": "a7a47698-22f5-4527-81fc-67a3d9a7f35b",
                                "sense_id": "a7f249ec-2bd9-3304-bc81-ebfdb8fe4ac2",
                                "text": "Écohabiter et écoconstruire autour du monde \"édition 2011\"."
