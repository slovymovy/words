                "senses": [
                    {
                        "sense_id": "dc170c70-cc2a-3643-8c6c-cd88d1fa669c",
                        "entry_id": "e590f803-de86-3580-9412-be16bb97c1d6",
                        "glosses": [
                            "The scientific and cultural community engaged in higher education and research, taken as a whole."
                        ],
                        "tags": [
                            "collective",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e63ea23-b48e-426b-8ff4-0180abe7458d",
                                "sense_id": "dc170c70-cc2a-3643-8c6c-cd88d1fa669c",
                                "text": "Academia continues to provide scientific education, despite attempts to turn it into a system of professional schooling."
                            },
                            {
                                "example_id": "101c5105-9a6e-42d6-be16-22419c32ca3a",
                                "sense_id": "dc170c70-cc2a-3643-8c6c-cd88d1fa669c",
                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e4bfb5d-3093-32c4-8b1e-928af044d20b",
                        "entry_id": "e590f803-de86-3580-9412-be16bb97c1d6",
                        "glosses": [
                            "Continuous study at higher education institutions; scholarship."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ed9a5c09-0b3c-4670-9a70-09fd51c238b2",
                                "sense_id": "4e4bfb5d-3093-32c4-8b1e-928af044d20b",
                                "text": "Not every university graduate wishes to pursue academia."
                            }
                        ]
                    }
