                        "glosses": [
                            "Femme spécialiste de la physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f234434-361e-4831-bb99-8cbbed098596",
                                "sense_id": "cc2dfebc-111c-3684-9ed4-09d58877b97f",
                                "text": "Pourquoi Donna Strickland n’a-t-elle été que la troisième femme physicienne à recevoir un prix Nobel ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bae3b507-b01e-350b-82d7-b3516fe6a19d",
                        "entry_id": "a7b3fe14-2029-33f8-95f8-6afa52b7baf3",
                        "glosses": [
                            "Professionnelle de santé chargée de guérir et soigner les maladies, les pathologies, les blessures."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "362e6fcd-566b-4143-8e49-b8360861e803",
                                "sense_id": "bae3b507-b01e-350b-82d7-b3516fe6a19d",
                                "text": "Sur la foi seule du ms. 2022, Chéreau a cru pouvoir le compter au nombre des médecins de saint Louis, ce qui est probable, mais nullement démontré, et cet auteur le cite entre Robert de Douai, Dude de Laon, Roger de Fournival et cette maîtresse Hèrsend qui, à titre de physicienne, accompagna en Palestine le roi saint Louis et la reine Marguerite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c0e886c-94a3-4589-89e8-ebb244eeb674",
                        "source_entry_id": "a7b3fe14-2029-33f8-95f8-6afa52b7baf3",
                        "source_sense_description": "spécialiste en physique",
                        "target_lang_word": "Physikerin",
                        "target_lang_code": "de",
