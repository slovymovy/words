                        "entry_id": "9c777e29-d90e-3451-b61b-6ef73f5c281d",
                        "glosses": [
                            "Mûr, qui fait preuve de maturité (morale et psychologique)."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1b8fa195-213a-46a3-aa10-8a79cc04dea8",
                                "sense_id": "7a388162-05b1-3113-b532-2e1e7bae3aac",
                                "text": "Elle est mature pour son âge, bien qu’elle n’ait que 15 ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "89ff25f6-6a5a-365d-b370-fb7e48235933",
                        "entry_id": "9c777e29-d90e-3451-b61b-6ef73f5c281d",
                        "glosses": [
                            "Qui a atteint les caractéristiques d'un adulte."
                        ],
