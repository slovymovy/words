                        "glosses": [
                            "Having a quantity or amount that is generous or plentiful; ample."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d53484a-dbc1-4453-8915-a5fe93c38b42",
                                "sense_id": "4e40cc41-b868-3e5c-a7e8-02064e3893e1",
                                "text": "They enjoyed a wet summer and a bountiful harvest."
                            },
                            {
                                "example_id": "1a7c2bb8-bb25-4d46-a17f-473fe5494cbc",
                                "sense_id": "4e40cc41-b868-3e5c-a7e8-02064e3893e1",
                                "text": "The vile person shall be no more called liberal, nor the churl said to be bountiful."
                            },
                            {
                                "example_id": "70a3b122-a759-4402-a586-bce7d0a96792",
                                "sense_id": "4e40cc41-b868-3e5c-a7e8-02064e3893e1",
                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                            }
                        ]
                    }
                ],
