                        "source_sense_description": "Schrank, in dem Geschirr aufbewahrt wird",
                        "target_lang_word": "vaisselier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaisselier",
