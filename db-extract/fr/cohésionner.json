                "senses": [
                    {
                        "sense_id": "702d394b-196a-346a-92c6-532621a49634",
                        "entry_id": "b1f1cf64-7457-380c-ae16-e02443afa21a",
                        "glosses": [
                            "Apporter de la cohésion à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54822243-23a3-45b9-a748-dbc5777f4eeb",
                                "sense_id": "702d394b-196a-346a-92c6-532621a49634",
                                "text": "Une enfant qui croit en Dieu et qui a besoin d'un homme fort, défiant l'ordre établi, qui ne croit à rien qu'il ne veuille d'abord comprendre ou cohésionner."
                            },
                            {
                                "example_id": "e35faced-b4c5-4f6c-a6bd-cadf01b6e280",
                                "sense_id": "702d394b-196a-346a-92c6-532621a49634",
                                "text": "Tant que l'irréparable n'est pas fait, nous devons à notre poste nous préoccuper de cohésionner les efforts pacifiques."
                            },
                            {
                                "example_id": "10b27757-7a96-4b20-a513-a267e33fd299",
                                "sense_id": "702d394b-196a-346a-92c6-532621a49634",
                                "text": "Lorsque je saisis le timon des affaires, j'avais déjà des idées arrêtées sur les éléments qui cohésionnent la société. J'avais pesé toute l'importance de la religion. J'étais persuadé et j'avais résolu de la rétablir."
                            }
                        ]
                    }
                ],
