                    {
                        "sense_id": "98375cc4-9edd-3cbc-ad86-ad529a3a65a8",
                        "entry_id": "a623ea75-73bc-3f4c-917f-e7266ec69d91",
                        "glosses": [
                            "Maschine, deren einziger Zweck das Töten ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "cd58971d-e351-4907-b71c-7ade0b829ab4",
                                "sense_id": "98375cc4-9edd-3cbc-ad86-ad529a3a65a8",
                                "text": "„Nach ihrem Selbstverständnis sind die Kaibiles durch harte körperliche Prüfungen gestählte ›Tötungsmaschinen‹, die ihre Tapferkeit täglich mit neuen Grausamkeiten unter Beweis stellen.“"
                            },
                            {
                                "example_id": "425ac4bd-b51b-4a6a-8a3d-a56805741b45",
                                "sense_id": "98375cc4-9edd-3cbc-ad86-ad529a3a65a8",
                                "text": "„Aber offenbar hatten die Ex-Kommis, die diese Tötungsmaschine steuerten, in dieser Nacht noch nicht viel zu tun bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
