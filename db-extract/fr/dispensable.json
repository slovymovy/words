        "fr-extract.jsonl": [
            {
                "entry_id": "77c3dd8f-a3cf-3ac9-b323-8b6b99eb44cc",
                "word": "dispensable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d226b71-5255-3ef3-8248-eef5e594eff3",
                        "entry_id": "77c3dd8f-a3cf-3ac9-b323-8b6b99eb44cc",
                        "glosses": [
                            "Pour lequel on peut accorder dispense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c230b915-9397-4d80-b713-adb03fd57bff",
                                "sense_id": "3d226b71-5255-3ef3-8248-eef5e594eff3",
                                "text": "Cas dispensable."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d70fd42-35f5-3698-8131-6180502e1f89",
                        "entry_id": "77c3dd8f-a3cf-3ac9-b323-8b6b99eb44cc",
                        "glosses": [
                            "Dont on peut se dispenser, se passer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b824c866-c2e8-4a1d-a206-e877b95b4a0a",
                                "sense_id": "6d70fd42-35f5-3698-8131-6180502e1f89",
                                "text": "Un an après le très dispensable Raditude, Weezer se ressaisit et prouve avec Hurley, son huitième album studio, qu'il reste le maître dans le domaine"
                            },
                            {
                                "example_id": "7397eb8a-e2e6-4837-b2ed-125bc5b196e7",
                                "sense_id": "6d70fd42-35f5-3698-8131-6180502e1f89",
                                "text": "L’ensemble est hélas parasité par une intrigue policière dispensable, prétexte à des gags moins réussis, voire lourdingues. Dommage."
                            },
                            {
                                "example_id": "c7f5ae7c-c6d9-49f5-a038-3f219fd4a747",
                                "sense_id": "6d70fd42-35f5-3698-8131-6180502e1f89",
                                "text": "Elle avait tenté un dernier coup minable, en lui suggérant de publier sous pseudonyme. Elle n’osait pas lui dire, à son âge, il prenait le risque que son tout dernier livre, ça soit ça, cette chose-là, provocatrice et dispensable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f814536c-aff4-4f1e-aaf9-2342687c7c66",
                        "source_entry_id": "77c3dd8f-a3cf-3ac9-b323-8b6b99eb44cc",
                        "source_sense_description": "Pour lequel on peut accorder dispense",
                        "target_lang_word": "erlässlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5992e8dc-7188-4c8e-a694-200793c3506d",
                        "source_entry_id": "77c3dd8f-a3cf-3ac9-b323-8b6b99eb44cc",
                        "source_sense_description": "Pour lequel on peut accorder dispense",
                        "target_lang_word": "dispensable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dispensable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17bbf811-68b8-39aa-8936-5bb9b5a2d0e4",
                                        "entry_id": "85250b27-2f0c-3986-af19-713b7726b2b0",
                                        "glosses": [
                                            "Able to be done without; easily replaced."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb7428e3-0d94-3d57-8a20-cfaa5810ffe7",
                                        "entry_id": "85250b27-2f0c-3986-af19-713b7726b2b0",
                                        "glosses": [
                                            "Capable of being dispensed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014bc574-078c-428f-825e-c3f9d7e90566",
                                                "sense_id": "fb7428e3-0d94-3d57-8a20-cfaa5810ffe7",
                                                "text": "The reward could be a preferred food, a sticker, blowing some bubbles, a noisemaker the child enjoys, a pat on the back, or some other easily dispensable reward that does not take the child away from the task at hand for more than a moment or two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe2b3dd-dd1e-3f75-83ac-b6d1c0eaa776",
                                        "entry_id": "85250b27-2f0c-3986-af19-713b7726b2b0",
                                        "glosses": [
                                            "Subject to dispensation; possible to relax, exempt from, or annul."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4233f4d-9999-4bc4-9c45-7683af462344",
                                                "sense_id": "bfe2b3dd-dd1e-3f75-83ac-b6d1c0eaa776",
                                                "text": "Jones' use of the term 'Ecclesiastical Law' in his definition of dispensations in Roman Catholic canon law points to the Roman Catholic distinction between divine law, from which no dispensation is possible, and merely ecclesiastical law, which is dispensable in certain circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "452e0ec2-ef0f-37b3-b9e9-597550815aff",
                                        "entry_id": "85250b27-2f0c-3986-af19-713b7726b2b0",
                                        "glosses": [
                                            "Not essential to be taken in as part of an organism's diet, as it can be synthesized de novo."
                                        ],
                                        "tags": [
                                            "of an amino acid"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b233c6-214b-494a-9497-91f30846875f",
                                                "sense_id": "452e0ec2-ef0f-37b3-b9e9-597550815aff",
                                                "text": "The difference in absorption rate is not surprising since whey has a high percentage of indispensable amino acids, which are absorbed more rapidly than dispensable amino acids."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dispensable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7c4f24-afe4-3d44-a9ba-156440ea7e6f",
                                        "entry_id": "d7803986-d7f1-3984-b37c-31eada086a79",
