                "entry_id": "ea79696b-402c-3c14-ba72-640904ad73fd",
                "word": "buitenlui",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cccbbe77-8073-3af3-ba8e-7bd91efe7340",
                        "entry_id": "ea79696b-402c-3c14-ba72-640904ad73fd",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord buitenman"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "051a0266-2444-473d-abc6-5a27baa68ec7",
                                "sense_id": "cccbbe77-8073-3af3-ba8e-7bd91efe7340",
                                "text": "Natuurbeschermers zijn blij met de komst van wolven naar Nederland maar ook boeren, jagers en buitenlui zullen met het streng beschermde dier moeten leren leven."
                            },
                            {
                                "example_id": "f169ec75-b81a-4fe3-a7e8-b3a06397b0ea",
                                "sense_id": "cccbbe77-8073-3af3-ba8e-7bd91efe7340",
                                "text": "Van april tot en met september is de gemeenschap van vijftig caravans een hecht clubje van arbeiders, burgers en buitenlui uit het hele land."
                            }
                        ]
                    },
                    {
                        "sense_id": "9536ca88-c4af-3597-8627-50dccac04e9b",
                        "entry_id": "ea79696b-402c-3c14-ba72-640904ad73fd",
                        "glosses": [
                            "verzamelterm voor mensen die niet in de stad wonen"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "00a247f5-2230-4c2d-aefb-806f449376b9",
                                "sense_id": "9536ca88-c4af-3597-8627-50dccac04e9b",
                                "text": "Veel geld verdienen is allang niet meer een typische Shanghaise karaktertrek, maar feit is dat Shanghaise stadsmensen zich verheven voelen boven de ‘waidiren’, de ‘boeren’ van buiten. Shanghaise mannen zijn in de ogen van de buitenlui ‘watjes’, omdat zij koken en de afwas doen."
                            },
                            {
                                "example_id": "f253014a-a08a-4619-b0ca-029459ce13d0",
                                "sense_id": "9536ca88-c4af-3597-8627-50dccac04e9b",
                                "text": "Maar lui die buiten wonen zitten met fruit. Wat te doen met al die pruimen van de boom achter het huis? De peren, de appels, de bessen en druiven? Jam van maken. (…) Er wordt onder buitenlui enorm met potjes jam geschoven."
                            }
                        ]
                    }
