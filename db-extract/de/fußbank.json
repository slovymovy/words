                "senses": [
                    {
                        "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                        "entry_id": "cde32d8b-983e-3530-9e11-c4faf0fcc922",
                        "glosses": [
                            "kleine niedrige Bank, die als Fußstütze dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4019b50a-cb5e-4369-9c61-8eea7a836e59",
                                "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                "text": "Weil er so klein war, nutzte er eine Fußbank, um an das Buch zu gelangen."
                            },
                            {
                                "example_id": "09ef2e76-5cf7-4cf7-9b58-0ff5fbead85f",
                                "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                "text": "„Sie stellte sich auf eine Fußbank und spielte eine Weile mit den Tieren.“"
                            },
                            {
                                "example_id": "44af201d-ffd7-4d60-975f-992be97393da",
                                "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                "text": "„Pécuchet hatte eine Fußbank unter den Stiefeln und las mit seiner hohlen Stimme laut vor, ohne müde zu werden, und hielt nur inne, um seine Finger in die Schnupftabaksdose zu stecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b820efd-e161-4c3d-a977-f1bbe4258171",
                        "source_entry_id": "cde32d8b-983e-3530-9e11-c4faf0fcc922",
                        "source_sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                        "source_sense_description": "kleine niedrige Bank, die als Fußstütze dient",
                        "target_lang_word": "footstool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "footstool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e51bc70-4d97-359f-8996-877efdf9eb53",
                                        "entry_id": "10d92152-68ac-353b-8b2b-4391d8382db8",
                                        "glosses": [
                                            "A low stool for supporting the feet while seated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47138859-ffc9-4e86-a034-d0db935d194c",
                                                "sense_id": "8e51bc70-4d97-359f-8996-877efdf9eb53",
                                                "text": "In Christianity, the world is called the footstool of Christ; in this Sumerian vision, the awakened body would be called the bed of the Queen of Heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b725043-83ca-3628-909c-b7062953ccf8",
                                        "entry_id": "10d92152-68ac-353b-8b2b-4391d8382db8",
                                        "glosses": [
                                            "Anything trodden upon or treated as subservient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c22ba510-8fba-4be4-bfba-bb54b0df5e3a",
                                                "sense_id": "0b725043-83ca-3628-909c-b7062953ccf8",
                                                "text": "Thereafter, when I have eaten and drunken and made merry in my royal palace at Carcë, I will sail with my armies over the teeming deep to many-mountained Demonland. And it shall be my footstool, and these other Demons the slaves of me, yea, and the slaves of my slaves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a00dab16-1299-4778-81c8-a441c83dc86d",
                        "source_entry_id": "cde32d8b-983e-3530-9e11-c4faf0fcc922",
                        "source_sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                        "source_sense_description": "kleine niedrige Bank, die als Fußstütze dient",
                        "target_lang_word": "repose-pieds",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repose-pieds",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "675912c7-3dac-3e2f-8ccf-cbe9031f7e5a",
                                        "entry_id": "28e17df9-b0a6-383f-9eb8-47cd99bff6a2",
                                        "glosses": [
                                            "Dispositif bas pour poser un pied ou les pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37da89ce-0f11-4cf2-903f-dcffa9716cf2",
                                                "sense_id": "675912c7-3dac-3e2f-8ccf-cbe9031f7e5a",
                                                "text": "Marcel s’est installé sur un repose-pieds en forme de balancelle, petit meuble démodé, prétentieux, encombrant."
                                            },
                                            {
                                                "example_id": "4dc195e7-276d-488e-a469-507447a9be52",
                                                "sense_id": "675912c7-3dac-3e2f-8ccf-cbe9031f7e5a",
                                                "text": "Tommy sirota un whiskey-sour au bar, un mocassin lustré posé sur le repose-pieds, le sourire toujours en place, le visage tourné vers la foule, à croire que le brouhaha qui s’en levait était une extension de l’adulation qui l’avait baigné comme une houle, tant d’années auparavant, lorsque montaient, en crescendo justificateur, dans quelque salle moite de sueur, les clameurs psalmodiées par des milliers de gorges : « Croche-le, Bobalouba ! Croche-le, Bobalouba ! Croche-le, Bobalouba ! »"
                                            }
                                        ]
                                    }
                                ]
                            },
