    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "211ed3f3-6ccc-363d-8fca-59a0fe06232f",
                    "sense_definition": "To find out or calculate something exactly by analyzing or investigating.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ascertain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are working hard to <w>determine</w> the exact cause of the new virus.",
                            "target_lang_translations": {
                                "ru": "Ученые усердно работают над тем, чтобы <w>определить</w> точную причину нового вируса.",
                                "tr": "Bilim insanları yeni virüsün kesin nedenini <w>belirlemek</w> için yoğun bir şekilde çalışıyorlar.",
                                "zh": "科学家们正在努力<w>查明</w>这种新病毒的确切病因。"
                            }
                        },
                        {
                            "text": "It is often difficult to <w>determine</w> the cause of such a complex problem.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>установить</w> причину такой сложной проблемы.",
                                "tr": "Böylesine karmaşık bir sorunun nedenini <w>tespit etmek</w> genellikle zordur.",
                                "zh": "通常很难<w>确定</w>如此复杂问题的起因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ascertain",
                        "establish",
                        "identify",
                        "verify"
                    ],
                    "common_phrases": [
                        "determine the cause",
                        "determine the outcome",
                        "determine the value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точно выяснить или рассчитать что-либо путем анализа или исследования.",
                        "tr": "Analiz veya araştırma yaparak bir şeyi tam olarak tespit etmek veya hesaplamak.",
                        "zh": "通过分析或调查准确地找出或计算出某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определить",
                                "target_lang_sense_clarification": "выяснить, установить"
                            },
                            {
                                "target_lang_word": "установить",
                                "target_lang_sense_clarification": "выявить факт или причину"
                            },
                            {
                                "target_lang_word": "выяснить",
                                "target_lang_sense_clarification": "сделать ясным в результате исследования"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "belirlemek",
                                "target_lang_sense_clarification": "analiz ederek tespit etmek"
                            },
                            {
                                "target_lang_word": "tespit etmek",
                                "target_lang_sense_clarification": "bir durumu veya nedeni ortaya çıkarmak"
                            },
                            {
                                "target_lang_word": "saptamak",
                                "target_lang_sense_clarification": "bir şeyi kesin olarak belirlemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确定",
                                "target_lang_sense_clarification": "查明事实或原因"
                            },
                            {
                                "target_lang_word": "查明",
                                "target_lang_sense_clarification": "通过调查弄清楚"
                            },
                            {
                                "target_lang_word": "测定",
                                "target_lang_sense_clarification": "通过测量或计算得出数值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b671be3e-6700-3e78-b7d2-2b679595ee2c",
                    "sense_definition": "To make a firm decision to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After much thought, she <w>determined</w> to succeed despite the many obstacles.",
                            "target_lang_translations": {
                                "ru": "После долгих раздумий она <w>решила</w> добиться успеха, несмотря на многочисленные препятствия.",
                                "tr": "Uzun uzun düşündükten sonra, birçok engele rağmen başarılı olmaya <w>karar verdi</w>.",
                                "zh": "经过深思熟虑，她<w>决定</w>克服重重障碍取得成功。"
                            }
                        },
                        {
                            "text": "He <w>determined</w> to succeed in his new career no matter how long it took.",
                            "target_lang_translations": {
                                "ru": "Он <w>вознамерился</w> преуспеть в своей новой карьере, сколько бы времени это ни заняло.",
                                "tr": "Ne kadar sürerse sürsün yeni kariyerinde başarılı olmaya <w>azmetti</w>.",
                                "zh": "他<w>决心</w>要在新事业中取得成功，无论需要花多长时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resolve",
                        "decide",
                        "conclude"
                    ],
                    "antonyms": [
                        "hesitate",
                        "waver"
                    ],
                    "common_phrases": [
                        "determined to succeed",
                        "determined to find",
                        "determined to win"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принять твердое решение сделать что-либо.",
                        "tr": "Bir şeyi yapmak için kesin bir karar vermek.",
                        "zh": "下定决心做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решить",
                                "target_lang_sense_clarification": "принять твердое решение"
                            },
                            {
                                "target_lang_word": "постановить",
                                "target_lang_sense_clarification": "официально или твердо решить"
                            },
                            {
                                "target_lang_word": "вознамериться",
                                "target_lang_sense_clarification": "твердо решить что-то сделать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kararlaştırmak",
                                "target_lang_sense_clarification": "yapmaya karar vermek"
                            },
                            {
                                "target_lang_word": "karar vermek",
                                "target_lang_sense_clarification": "kesin bir tutum sergilemek"
                            },
                            {
                                "target_lang_word": "azmetmek",
                                "target_lang_sense_clarification": "bir şeyi yapmaya kesin olarak niyetlenmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "做出明确的选择"
                            },
                            {
                                "target_lang_word": "决心",
                                "target_lang_sense_clarification": "坚定地打算做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "690d80ee-5768-309e-8cfa-a4c8b251f34c",
                    "sense_definition": "To be the main factor that influences or decides a result or character.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your hard work and attitude will <w>determine</w> your future success in this company.",
                            "target_lang_translations": {
                                "ru": "Ваше трудолюбие и отношение к делу <w>определят</w> ваш будущий успех в этой компании.",
                                "tr": "Sıkı çalışmanız ve tutumunuz, bu şirketteki gelecekteki başarınızı <w>belirleyecek</w>.",
                                "zh": "你的努力和态度将<w>决定</w>你在这家公司未来的成功。"
                            }
                        },
                        {
                            "text": "Social factors often <w>determine</w> your future in ways that are hard to see.",
                            "target_lang_translations": {
                                "ru": "Социальные факторы часто <w>обуславливают</w> ваше будущее так, что это трудно заметить.",
                                "tr": "Sosyal faktörler, geleceğinizi genellikle fark edilmesi zor yollarla <w>şekillendirir</w>.",
                                "zh": "社会因素往往以难以察觉的方式<w>左右</w>着你的未来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shape",
                        "govern",
                        "regulate",
                        "dictate"
                    ],
                    "common_phrases": [
                        "determine your future",
                        "determine the price",
                        "determine the character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть основным фактором, который влияет на результат или характер чего-либо или определяет их.",
                        "tr": "Bir sonucun veya karakterin oluşmasında ana etken olmak, yön vermek.",
                        "zh": "作为影响或决定结果或性质的主要因素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "обуславливать, задавать ход"
                            },
                            {
                                "target_lang_word": "обуславливать",
                                "target_lang_sense_clarification": "быть условием или причиной"
                            },
                            {
                                "target_lang_word": "диктовать",
                                "target_lang_sense_clarification": "навязывать, предопределять"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "belirlemek",
                                "target_lang_sense_clarification": "sonucu veya geleceği etkilemek/şekillendirmek"
                            },
                            {
                                "target_lang_word": "şekillendirmek",
                                "target_lang_sense_clarification": "yön vermek, etki etmek"
                            },
                            {
                                "target_lang_word": "tayyin etmek",
                                "target_lang_sense_clarification": "etkileyerek sonuca bağlamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "起决定性作用"
                            },
                            {
                                "target_lang_word": "左右",
                                "target_lang_sense_clarification": "对事物的发展起支配作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15a18c9f-07fd-35f1-a418-b36852716fed",
                    "sense_definition": "To officially or formally settle a question, controversy, or legal case.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "settle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supreme court will <w>determine</w> the case by the end of the month.",
                            "target_lang_translations": {
                                "ru": "Верховный суд <w>вынесет решение</w> по делу до конца месяца.",
                                "tr": "Yüksek mahkeme ay sonuna kadar davayı <w>karara bağlayacak</w>.",
                                "zh": "最高法院将在月底前对该案做出<w>裁决</w>。"
                            }
                        },
                        {
                            "text": "The committee met to <w>determine</w> the issue once and for all.",
                            "target_lang_translations": {
                                "ru": "Комитет собрался, чтобы <w>разрешить</w> этот вопрос раз и навсегда.",
                                "tr": "Komite, konuyu bir kez ve kesin olarak <w>çözüme kavuşturmak</w> için toplandı.",
                                "zh": "委员会开会旨在彻底<w>解决</w>这一问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adjudicate",
                        "settle",
                        "resolve"
                    ],
                    "common_phrases": [
                        "determine the issue",
                        "determine the case",
                        "determine the matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально или формально разрешить вопрос, спор или судебное дело.",
                        "tr": "Bir konuyu, anlaşmazlığı veya hukuki davayı resmi olarak çözüme kavuşturmak.",
                        "zh": "正式或官方地解决问题、争议或法律案件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешить",
                                "target_lang_sense_clarification": "урегулировать спор или вопрос"
                            },
                            {
                                "target_lang_word": "вынести решение",
                                "target_lang_sense_clarification": "официально постановить"
                            },
                            {
                                "target_lang_word": "определить",
                                "target_lang_sense_clarification": "установить меру или исход дела"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karara bağlamak",
                                "target_lang_sense_clarification": "resmi olarak sonuca ulaştırmak"
                            },
                            {
                                "target_lang_word": "çözüme kavuşturmak",
                                "target_lang_sense_clarification": "bir anlaşmazlığı bitirmek"
                            },
                            {
                                "target_lang_word": "hükme bağlamak",
                                "target_lang_sense_clarification": "hukuki karara varmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裁决",
                                "target_lang_sense_clarification": "对争议做出正式决定"
                            },
                            {
                                "target_lang_word": "解决",
                                "target_lang_sense_clarification": "处理并终结问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a93213a-0441-3219-b2ed-7277c9163b50",
                    "sense_definition": "To set the boundaries, limits, or extent of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treaty was signed to <w>determine</w> the borders between the two nations.",
                            "target_lang_translations": {
                                "ru": "Договор был подписан, чтобы <w>установить</w> границы между двумя государствами.",
                                "tr": "Antlaşma, iki ulus arasındaki sınırları <w>belirlemek</w> amacıyla imzalandı.",
                                "zh": "签署该条约是为了<w>划定</w>两国之间的边界。"
                            }
                        },
                        {
                            "text": "We must <w>determine</w> the boundaries of the project before we begin working.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>определить</w> рамки проекта до того, как начнем работу.",
                                "tr": "Çalışmaya başlamadan önce projenin sınırlarını <w>belirlemeliyiz</w>.",
                                "zh": "在开始工作之前，我们必须<w>限定</w>项目的范围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "bound",
                        "circumscribe",
                        "define"
                    ],
                    "common_phrases": [
                        "determine the boundaries",
                        "determine the limits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установить границы, пределы или объем чего-либо.",
                        "tr": "Bir şeyin sınırlarını veya kapsamını belirlemek.",
                        "zh": "设定某事物的边界、限度或范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "устанавливать границы или пределы"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "назначать рамки или сроки"
                            },
                            {
                                "target_lang_word": "очерчивать",
                                "target_lang_sense_clarification": "обозначать контуры или пределы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sınırlandırmak",
                                "target_lang_sense_clarification": "sınırlarını çizmek"
                            },
                            {
                                "target_lang_word": "sınırlarını belirlemek",
                                "target_lang_sense_clarification": "kapsamını netleştirmek"
                            },
                            {
                                "target_lang_word": "saptamak",
                                "target_lang_sense_clarification": "çerçevesini çizmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "划定",
                                "target_lang_sense_clarification": "设定界限"
                            },
                            {
                                "target_lang_word": "限定",
                                "target_lang_sense_clarification": "规定范围或限度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7eab69c-a62b-338b-aa20-6f22f1e5590e",
                    "sense_definition": "To bring to an end or to come to an end, especially in a legal context like a contract or lease.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agreement will <w>determine</w> automatically if the conditions are not met within thirty days.",
                            "target_lang_translations": {
                                "ru": "Действие соглашения <w>прекратится</w> автоматически, если условия не будут выполнены в течение тридцати дней.",
                                "tr": "Otuz gün içinde şartlar yerine getirilmezse sözleşme otomatik olarak <w>sona erecektir</w>.",
                                "zh": "如果三十天内条件未得到满足，协议将自动<w>终止</w>。"
                            }
                        },
                        {
                            "text": "The landlord has the right to <w>determine</w> the lease if the rent is not paid.",
                            "target_lang_translations": {
                                "ru": "Арендодатель имеет право <w>расторгнуть</w> договор аренды, если арендная плата не внесена.",
                                "tr": "Kira ödenmezse ev sahibinin kira sözleşmesini <w>feshetme</w> hakkı vardır.",
                                "zh": "如果租金未付，房东有权<w>解除</w>租赁合同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminate",
                        "expire",
                        "finish",
                        "cease"
                    ],
                    "antonyms": [
                        "commence",
                        "initiate",
                        "start"
                    ],
                    "common_phrases": [
                        "determine the lease",
                        "determine the contract"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить или закончиться, особенно в юридическом контексте, таком как контракт или аренда.",
                        "tr": "Özellikle sözleşme veya kira gibi hukuki bağlamda son bulmak veya sona erdirmek.",
                        "zh": "使结束或终止，尤指在合同或租赁等法律语境下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "расторгать договор или обязательство"
                            },
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "заканчиваться (о сроке действия)"
                            },
                            {
                                "target_lang_word": "расторгать",
                                "target_lang_sense_clarification": "официально прекращать действие контракта"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fesh etmek",
                                "target_lang_sense_clarification": "sözleşmeyi sonlandırmak"
                            },
                            {
                                "target_lang_word": "sonlandırmak",
                                "target_lang_sense_clarification": "geçerliliğini bitirmek"
                            },
                            {
                                "target_lang_word": "sona ermek",
                                "target_lang_sense_clarification": "otomatik olarak bitmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终止",
                                "target_lang_sense_clarification": "使合同或协议停止生效"
                            },
                            {
                                "target_lang_word": "解除",
                                "target_lang_sense_clarification": "废除合同或关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a45666-f00e-3fe1-b6e0-a70bffef17e2",
                    "sense_definition": "To define a concept or group by adding specific distinguishing characteristics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "define",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In logic, one must <w>determine</w> a genus by its specific difference to reach a definition.",
                            "target_lang_translations": {
                                "ru": "В логике нужно <w>определить</w> род через его видовое отличие, чтобы прийти к определению.",
                                "tr": "Mantıkta, bir tanıma ulaşmak için bir cinsi kendi özgül farkıyla <w>tanımlamak</w> gerekir.",
                                "zh": "在逻辑学中，必须通过种差来<w>定义</w>一个属，从而得出定义。"
                            }
                        },
                        {
                            "text": "The philosopher sought to <w>determine</w> the concept by narrowing its scope.",
                            "target_lang_translations": {
                                "ru": "Философ стремился <w>конкретизировать</w> понятие, сужая его объем.",
                                "tr": "Filozof, kapsamını daraltarak kavramı <w>somutlaştırmaya</w> çalıştı.",
                                "zh": "这位哲学家试图通过缩小范围来<w>界定</w>这一概念。"
                            }
                        }
                    ],
                    "synonyms": [
                        "define",
                        "specify",
                        "differentiate"
