                        "entry_id": "b7bb2c35-219c-3205-907a-a5c2c796b10f",
                        "glosses": [
                            "A residential area beyond the suburbs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4c7e37-4617-4c6c-8b4b-aa8f43dbecba",
                                "sense_id": "87da6d6b-3539-38b6-9838-a89c832cf9c0",
                                "text": "I had my first taste of a collapsing exurb last night."
                            },
                            {
                                "example_id": "7696e425-0abc-4e51-b054-b04882ebd385",
                                "sense_id": "87da6d6b-3539-38b6-9838-a89c832cf9c0",
                                "text": "Lots of cities are exurbs of other cities for reasons of finance or infrastructure."
                            },
                            {
                                "example_id": "e1145a46-212d-4359-970b-a3e1fcd4cae7",
                                "sense_id": "87da6d6b-3539-38b6-9838-a89c832cf9c0",
                                "text": "Miles of exurbs bristle with hundreds—no, thousands—of apartment towers. These monoliths soar like gigantic dominoes into a dust-whitened sky. The area was hand-tilled cornfields when Lui grew up in Xi’an in the 1980s."
                            }
                        ]
                    }
