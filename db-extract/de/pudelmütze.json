                        "sense_id": "5c69fcbf-6087-347c-845a-e46c79d05a12",
                        "entry_id": "32a8407f-ab4b-32c7-b863-7121439a8ccf",
                        "glosses": [
                            "gestrickte Kopfbedeckung, die die Ohren bedeckt und meist mit einer Bommel aus Wolle verziert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e057d1f-8b1e-40c7-a378-8c4d567864d5",
                                "sense_id": "5c69fcbf-6087-347c-845a-e46c79d05a12",
                                "text": "Mit meiner Pudelmütze kriege ich im Winter nie kalte Ohren."
                            },
                            {
                                "example_id": "62b3d139-4a17-4c8f-8a21-b86cbce984e5",
                                "sense_id": "5c69fcbf-6087-347c-845a-e46c79d05a12",
                                "text": "„Mikaela Shiffrin steht in der Sporthalle der Volkshochschule Flachau, Salzburger Land, und lächelt unter ihrer weißen Pudelmütze hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
