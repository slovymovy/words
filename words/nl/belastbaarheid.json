    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "186f2084-9d37-35ab-b670-b71ac6fe3b56",
                    "sense_definition": "de mate waarin iemand lichamelijke of geestelijke inspanning kan verdragen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "capaciteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts onderzocht de fysieke <w>belastbaarheid</w> van de patiënt na de operatie.",
                            "target_lang_translations": {
                                "en": "The doctor examined the patient's physical <w>resilience</w> after the surgery."
                            }
                        },
                        {
                            "text": "Door de aanhoudende stress is de mentale <w>belastbaarheid</w> van het personeel flink afgenomen.",
                            "target_lang_translations": {
                                "en": "Due to ongoing stress, the staff's mental <w>stamina</w> has decreased significantly."
                            }
                        }
                    ],
                    "synonyms": [
                        "draagkracht",
                        "uithoudingsvermogen"
                    ],
                    "common_phrases": [
                        "mentale belastbaarheid",
                        "fysieke belastbaarheid",
                        "grens van belastbaarheid"
                    ],
                    "target_lang_definitions": {
                        "en": "the degree to which someone can tolerate physical or mental exertion or stress"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resilience",
                                "target_lang_sense_clarification": "mental or physical ability to recover or endure"
                            },
                            {
                                "target_lang_word": "load-bearing capacity",
                                "target_lang_sense_clarification": "in a psychological or physical health context"
                            },
                            {
                                "target_lang_word": "stamina",
                                "target_lang_sense_clarification": "physical or mental endurance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cdadd41-17a5-3895-9029-2b99757ae3a6",
                    "sense_definition": "het maximale gewicht of de kracht die een object of constructie kan dragen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "capaciteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De maximale <w>belastbaarheid</w> van deze lift is achthonderd kilogram.",
                            "target_lang_translations": {
                                "en": "The maximum <w>load capacity</w> of this elevator is eight hundred kilograms."
                            }
                        },
                        {
                            "text": "Controleer altijd de <w>belastbaarheid</w> van de vloer voordat je zware machines plaatst.",
                            "target_lang_translations": {
                                "en": "Always check the <w>load-bearing capacity</w> of the floor before placing heavy machinery."
                            }
                        }
                    ],
                    "synonyms": [
                        "draagvermogen"
                    ],
                    "common_phrases": [
                        "maximale belastbaarheid",
                        "belastbaarheid van de vloer"
                    ],
                    "target_lang_definitions": {
                        "en": "the maximum weight or force that an object or structure can support"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "load capacity",
                                "target_lang_sense_clarification": "maximum weight a structure can hold"
                            },
                            {
                                "target_lang_word": "carrying capacity",
                                "target_lang_sense_clarification": "the amount a vehicle or floor can carry"
                            },
                            {
                                "target_lang_word": "weight limit",
                                "target_lang_sense_clarification": "the maximum weight allowed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba90ff2-e4d1-3414-9a93-adecd11d1b94",
                    "sense_definition": "de maximale hoeveelheid elektrische stroom die veilig door een geleider kan gaan",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het ontwerpen van het stroomnet moet men rekening houden met de <w>belastbaarheid</w> van de kabels.",
                            "target_lang_translations": {
                                "en": "When designing the power grid, one must take into account the <w>current-carrying capacity</w> of the cables."
                            }
                        },
                        {
                            "text": "De technische <w>belastbaarheid</w> van de transformator mag niet worden overschreden.",
                            "target_lang_translations": {
