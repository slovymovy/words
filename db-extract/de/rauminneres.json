                        "examples": [
                            {
                                "example_id": "f34391b8-5c62-4bd4-9f13-3a479037b4cb",
                                "sense_id": "3ae0cad6-c422-39f1-9909-6dfd19de0b54",
                                "text": "„Die Farbe des Holzes ändert sich im Rauminneren mit der Zeit durch Oxydation.“"
                            },
                            {
                                "example_id": "6fc4119b-8771-45a3-9dd8-4e6deedfbf89",
                                "sense_id": "3ae0cad6-c422-39f1-9909-6dfd19de0b54",
                                "text": "„Es dauerte eine Weile, bis sich seine Augen an das Dämmerlicht des Rauminneren gewöhnt hatten.“"
                            },
                            {
                                "example_id": "0683b6bb-9cc2-4146-a213-787fc386ca3d",
                                "sense_id": "3ae0cad6-c422-39f1-9909-6dfd19de0b54",
                                "text": "„Wasserdampf und aggressive Produktionsdämpfe aus dem Rauminneren sowie stark wechselnde Temperaturen können der Dachkonstruktion ebenfalls zusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
