                    {
                        "sense_id": "8869bc9d-0579-390f-8ea2-18f304655fb2",
                        "entry_id": "aa29f184-b819-3f41-b427-9ac25236c8bf",
                        "glosses": [
                            "To give an archaic quality or character to; make archaic, to suggest the past."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "55b6ad0a-23cd-4a30-a42b-b2c8cee89f50",
                                "sense_id": "8869bc9d-0579-390f-8ea2-18f304655fb2",
                                "text": "The statue had an archaized quality to it."
                            },
                            {
                                "example_id": "79754338-9ae0-4f50-bbdc-836cbe41ff53",
                                "sense_id": "8869bc9d-0579-390f-8ea2-18f304655fb2",
                                "text": "An Egyptologist's mind immediately turns to the ancient Egyptian counterpart to such an imagined protosactuary: a reed hut that all late Egyptian temples, in their archaizing longing to return to the origins, sought to emulate in stone through the typically Egyptian temple features of inward-sloping walls, torus and corvetto cornice."
                            }
                        ]
                    },
