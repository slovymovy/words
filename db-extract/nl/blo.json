                                        "glosses": [
                                            "Embarrassed, disconcerted, or ashamed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab316eb1-3242-4ba3-8802-89917e1deb4f",
                                                "sense_id": "aa300274-2ad0-36d8-9207-c22d10f9f680",
                                                "text": "So spake the Lord Goldry Bluszco, standing in great pride and splendour beneath the starry canopy, and scowling terribly on the Ambassador from Witchland, so that the Ambassador was abashed and his knees smote together."
