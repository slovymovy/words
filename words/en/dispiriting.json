    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8eb2da2-186d-3cc2-b85a-8a30c3ef82ee",
                    "sense_definition": "Causing a loss of hope, enthusiasm, or morale; disheartening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Finding another rejection letter in the mailbox was a deeply <w>dispiriting</w> experience for the young author.",
                            "target_lang_translations": {
                                "nl": "Het vinden van nog een afwijzingsbrief in de brievenbus was een diep <w>ontmoedigende</w> ervaring voor de jonge auteur."
                            }
                        },
                        {
                            "text": "It was <w>dispiriting</w> to see all their hard work undone in just a few minutes.",
                            "target_lang_translations": {
                                "nl": "Het was <w>ontmoedigend</w> om te zien hoe al hun harde werk in slechts een paar minuten teniet werd gedaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "disheartening",
                        "discouraging",
                        "demoralizing",
                        "depressing"
                    ],
                    "antonyms": [
                        "heartening",
                        "encouraging",
                        "uplifting",
                        "inspiring"
                    ],
                    "common_phrases": [
                        "dispiriting experience",
                        "dispiriting effect",
                        "dispiriting news"
                    ],
                    "target_lang_definitions": {
                        "nl": "Leidend tot een verlies van hoop, enthousiasme of moreel; ontmoedigend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontmoedigend",
                                "target_lang_sense_clarification": "het meest gangbare woord voor het ontnemen van moed of hoop"
                            },
                            {
                                "target_lang_word": "demoraliserend",
                                "target_lang_sense_clarification": "het moreel ondermijnend"
                            },
                            {
                                "target_lang_word": "neerdrukkend",
                                "target_lang_sense_clarification": "een sombere of deprimerende invloed hebbend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "627a3890-fb4b-387a-b378-a6a32caf0495",
                    "sense_definition": "present participle and gerund of <w>dispirit</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By constantly criticizing every minor flaw, the coach was <w>dispiriting</w> the entire squad before the championship game.",
                            "target_lang_translations": {
                                "nl": "Door voortdurend kritiek te leveren op elk klein foutje was de coach het hele team aan het <w>ontmoedigen</w> vóór de kampioenswedstrijd."
                            }
                        },
                        {
                            "text": "The relentless rain seemed intent on <w>dispiriting</w> the travelers on their long journey across the mountains.",
                            "target_lang_translations": {
                                "nl": "De aanhoudende regen leek erop gebrand de reizigers te <w>demoraliseren</w> tijdens hun lange tocht over de bergen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord van 'dispirit'; het ontnemen van moed of hoop."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontmoedigen",
                                "target_lang_sense_clarification": "de moed ontnemen"
                            },
                            {
                                "target_lang_word": "demoraliseren",
                                "target_lang_sense_clarification": "het moreel van iemand breken"
                            }
                        ]
                    }
                }
            ]
        }
