                "senses": [
                    {
                        "sense_id": "863dd48c-a0c0-317c-8c26-e1e24ef8611b",
                        "entry_id": "bd5300b3-9ac4-39fa-8cce-25390e6999d6",
                        "glosses": [
                            "Stadt im Nordosten von Rumänien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ca35cc-0faa-4b1c-bd99-08d7cd127ff1",
                                "sense_id": "863dd48c-a0c0-317c-8c26-e1e24ef8611b",
                                "text": "„Der Flughafen von Iaşi wird u. a. von München, Köln oder Wien aus direkt angeflogen. Weitere internationale Flughäfen in der Nordmoldau sind Bacău und Suceava.“"
                            },
                            {
                                "example_id": "875b0c4c-cd6f-40cf-89a6-d9e0182a8ac9",
                                "sense_id": "863dd48c-a0c0-317c-8c26-e1e24ef8611b",
                                "text": "„Laut Nobel stammen die Bettler in einer Stadt oftmals alle aus derselben Region. So liege etwa das Herkunftsdorf vieler rumänischer Bettler, die sich in Basel aufhalten, 20 Kilometer von der Stadt Bacău im Nordosten Rumäniens entfernt.“"
                            }
                        ],
