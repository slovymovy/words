                    },
                    {
                        "form_id": "9afecc48-739b-485b-b499-38d6149d56e4",
                        "entry_id": "66ddb9b2-b174-3e56-b0d7-527dcb397b75",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Schlaraffenland"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                        "entry_id": "66ddb9b2-b174-3e56-b0d7-527dcb397b75",
                        "glosses": [
                            "märchenhaftes Land, in dem nach Art der Schlaraffen gelebt wird (Den sich dort aufhaltenden äußerst trägen Leuten flogen nach volkstümlicher Vorstellung z. B. gebratene Tauben und Spezereien im Überfluss in den Mund, es flossen Wein, Milch und Honig; Faulheit und Nichtstun galten als Tugenden, Hässliche und Alte verwandelte ein Jungbrunnen in Schöne beziehungsweise Junge und vieles mehr.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14050442-ee0a-4548-ae10-5c9856cc7e17",
                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                "text": "„Schlaraffenland gibt es nirgendwo, und die Faulheit ist überall verdächtig.“"
                            },
                            {
                                "example_id": "f62c0813-367e-4b71-be72-65c140f48fd1",
                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                "text": "Im Vergleich zu meiner Heimat lebt man hier wie im Schlaraffenland."
                            },
                            {
                                "example_id": "3407881d-66e6-48ee-a962-e88019c32b5d",
                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                "text": "„Ich trete durch die Tür und komme in ein Schlaraffenland.“"
                            },
                            {
                                "example_id": "426ce71b-52d9-4ab7-a731-bf0eeca2c2f4",
                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                "text": "„Deren Witzfiguren flogen aus dem Schlaraffenland der ‚tüchtigen Deutschen‘ gewissermaßen wie gebratene Tauben in den Volksmund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5a5729a-dfeb-441b-a136-af212228bd84",
                        "source_entry_id": "66ddb9b2-b174-3e56-b0d7-527dcb397b75",
                        "source_sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                        "source_sense_description": "das imaginäre Land der Faulenzer, das Schlaraffenland",
                        "target_lang_word": "Cockaigne",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cockaigne",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a04ad32-e211-3e0d-9235-f1d118f14e5c",
                                        "entry_id": "b90c2989-b6db-3448-a999-2c991a2a5673",
                                        "glosses": [
                                            "A land of plenty, luxury and idleness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292bae5e-f3f3-45d1-a999-2ce72d85277d",
                                                "sense_id": "1a04ad32-e211-3e0d-9235-f1d118f14e5c",
                                                "text": "In Cockaigne, the Land of Plenty, people never argued. Instead, they partied, they danced, they drank, and they slept around."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f705a411-9ac1-426c-9d76-4869a6174317",
                        "source_entry_id": "66ddb9b2-b174-3e56-b0d7-527dcb397b75",
                        "source_sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                        "source_sense_description": "das imaginäre Land der Faulenzer, das Schlaraffenland",
                        "target_lang_word": "pays de cocagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pays de cocagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                        "entry_id": "881530e8-fec5-3144-90f8-966057aac8fd",
                                        "glosses": [
                                            "Pays imaginaire où l’on trouve de tout en abondance."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7e9d09-2850-4c9d-b6b2-1eb5a0c67ad6",
                                                "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                                "text": "Paris est pour un riche un pays de cocagne :\nSans sortir de la ville, il trouve la campagne ;"
                                            },
                                            {
                                                "example_id": "1b51683a-61cf-48b6-9b3f-30cc6fe1758f",
                                                "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                                "text": "Ils touchèrent les côtes d’Afrique en baie de Bône. Gabriel Morange foulait pour la première fois un sol étranger. De ces pays de cocagne qu’il imaginait au cœur de ses rêves d’enfant."
                                            },
                                            {
                                                "example_id": "6877eae4-7380-4f46-96bd-70e7a383bf3c",
                                                "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                                "text": "Ce pays, mes amis, n’a rien à envier\nAux Flandres, au Languedoc, ou même à la Bretagne.\nC’est sans forfanterie que je puis vous confier\nQu’il est assurément un pays de cocagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "208ae5be-c886-4727-afe7-d83ffac2f788",
                        "source_entry_id": "66ddb9b2-b174-3e56-b0d7-527dcb397b75",
                        "source_sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                        "source_sense_description": "das imaginäre Land der Faulenzer, das Schlaraffenland",
                        "target_lang_word": "pays de Cocagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pays de Cocagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61167b00-e753-3bad-b821-cc80fbbb98d8",
                                        "entry_id": "431b631d-c9ed-34bf-9170-a11a44a7682d",
                                        "glosses": [
                                            "Variante orthographique de pays de cocagne."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c325f29e-f064-493f-9900-8175c942b4c4",
                                                "sense_id": "61167b00-e753-3bad-b821-cc80fbbb98d8",
                                                "text": "C’est probablement en raison des affinités psychologiques profondes résultant de ces ma­nières d’opérer, que les uns et les autres s’entendent si parfaitement : la démocratie est le pays de Cocagne rêvé par les financiers sans scrupules."
                                            },
                                            {
                                                "example_id": "9a115c66-2d0f-4deb-aabe-ae74526bb021",
                                                "sense_id": "61167b00-e753-3bad-b821-cc80fbbb98d8",
                                                "text": "Il est un pays superbe, un pays de Cocagne, dit-on, que je rêve de visiter avec une vieille amie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3caff07a-1bcc-3288-8d01-7d72609edeb5",
                                        "entry_id": "431b631d-c9ed-34bf-9170-a11a44a7682d",
                                        "glosses": [
                                            "Surnom du Lauragais, une contrée jadis spécialisée dans la fabrication des coques ou cocagnes (boules ou petits pains de pastel)."
                                        ],
                                        "tags": [
                                            "Midi toulousain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9128482-c876-465f-a488-a70151906cf0",
                                                "sense_id": "3caff07a-1bcc-3288-8d01-7d72609edeb5",
                                                "text": "Selon les uns, ce pays de Cocagne est la partie du Languedoc qui composait l'ancien duché du Lauraguais."
                                            },
                                            {
                                                "example_id": "363d30ee-de90-4b98-8681-8ce1365455b6",
                                                "sense_id": "3caff07a-1bcc-3288-8d01-7d72609edeb5",
                                                "text": "Du commerce des « coques » de pastel est née l’appellation de « Pays de Cocagne ». Ces coques transitaient dans les ports français de Bordeaux, Marseille et Bayonne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb869b91-18f6-44c6-b7f1-25a5b34c3f33",
