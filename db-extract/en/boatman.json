                    {
                        "sense_id": "614d1566-c408-34b1-8f78-a3c8a3477ee5",
                        "entry_id": "61497117-d2ab-3a85-bce4-f1eab3de3d84",
                        "glosses": [
                            "A sailor on a small vessel (boat), particularly its captain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ba4af9-a2db-45bc-8889-fb72e7b2b9d2",
                                "sense_id": "614d1566-c408-34b1-8f78-a3c8a3477ee5",
