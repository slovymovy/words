                ],
                "senses": [
                    {
                        "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                        "entry_id": "2b227d72-f4a2-3223-9b1e-e67cd271410a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5e783c-2e9d-443b-8cee-b6dae0d92f83",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Frau Geyling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e5c52990-5ec3-4b60-b1ff-eb0df0be291a",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Herr Geyling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e90e8f4-4362-4543-992f-e023161ea53c",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Die Geylings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8e6cdf3a-8c9e-4ec7-9d43-358a63ceea60",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Der Geyling trägt nie die Schals, die die Geyling ihm strickt."
                            },
                            {
                                "example_id": "de234612-f9fc-4241-9a1e-8ffd0e2732cf",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geyling kommt, geht der Herr Geyling.“"
                            },
                            {
                                "example_id": "764c5b16-188b-4ab1-bbbc-5b76af2a1327",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Geyling kommt und geht."
                            },
                            {
                                "example_id": "a5a74371-317b-4135-a09e-b413b9e11c54",
                                "sense_id": "eeb24292-3639-3368-a0fc-f6bb8fa48f0c",
                                "text": "Geylings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
