        "nl-extract.jsonl": [
            {
                "entry_id": "7669d9cd-0f15-3a3a-9898-66f6d17ac772",
                "word": "courage",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ca105cf4-fd04-32f3-89b9-2f654fe7c2d6",
                        "entry_id": "7669d9cd-0f15-3a3a-9898-66f6d17ac772",
                        "glosses": [
                            "moed, kracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92aff081-b59b-46d5-967f-8ee0c8a147b4",
                                "sense_id": "ca105cf4-fd04-32f3-89b9-2f654fe7c2d6",
                                "text": "Het mag een wonder heten dat het kleine meisje het overleefde: haar huid en schedel waren niet gesloten, waardoor haar hersenen geen enkele bescherming hadden. Mama Ellen en papa Alexander Corne (38) raapten al hun courage bijeen en een team van chirurgen 'sloot' het hoofdje van hun drie dagen oude oogappel."
                            },
                            {
                                "example_id": "3dd0b02d-39bd-4d4e-8898-158ca833ad45",
                                "sense_id": "ca105cf4-fd04-32f3-89b9-2f654fe7c2d6",
                                "text": "De actie geeft hem duidelijk courage en toverde zelfs een glimlach op z'n gezicht."
                            },
                            {
                                "example_id": "c70f3767-31fe-4cb2-8b7e-fe363410eae9",
                                "sense_id": "ca105cf4-fd04-32f3-89b9-2f654fe7c2d6",
                                "text": "Alle dagen belt boer Backaert met zijn koersende zoon. \"Om hem courage te geven.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a4f70a8-a60d-4f29-a3f8-e87639227067",
                        "source_entry_id": "7669d9cd-0f15-3a3a-9898-66f6d17ac772",
                        "source_sense_id": "ca105cf4-fd04-32f3-89b9-2f654fe7c2d6",
                        "target_lang_word": "strength",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strength",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The quality or degree of being strong."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df294d46-6f40-4d19-9e1e-18aa218c807c",
                                                "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                                "text": "It requires great strength to lift heavy objects."
                                            },
                                            {
                                                "example_id": "e11da1eb-0cf8-4d73-aa3f-67bd6369cb68",
                                                "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                                "text": "Our castle’s strength will laugh a siege to scorn."
                                            },
                                            {
                                                "example_id": "80894fcd-14c3-4b79-b56f-4df35485a865",
                                                "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The intensity of a force or power; potency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c0cdef7-3902-48f5-b941-d079e67a0182",
                                                "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                                                "text": "He had the strength of ten men."
                                            },
                                            {
                                                "example_id": "8e628716-2e77-464b-9dbb-21c2ba1f5124",
                                                "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d004da12-b103-3390-a88a-a97ba4b42d65",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The strongest part of something; that on which confidence or reliance is based."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb62489-b14d-45e2-914c-d4f1be5034a8",
                                                "sense_id": "d004da12-b103-3390-a88a-a97ba4b42d65",
                                                "text": "God is our refuge and strength, a very present help in trouble."
                                            },
                                            {
                                                "example_id": "724af0e9-c233-4cf3-b922-256758c8758b",
                                                "sense_id": "d004da12-b103-3390-a88a-a97ba4b42d65",
                                                "text": "[…] certainly there is not in the world a greater strength against temptations, then is deposited in an obedient understanding […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "A positive attribute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc33dcd-11eb-4170-a7c6-b60e26d21acf",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "to play to one's strengths"
                                            },
                                            {
                                                "example_id": "5002f008-cfe9-46dc-b6ea-0322881cf6ef",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "We all have our own strengths and weaknesses."
                                            },
                                            {
                                                "example_id": "784792e4-6f4f-46c1-a18a-eb63f6d1a814",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "The compulsion to expose, renegotiate, or reinvent the strengths and weaknesses of dance tradition offers little in its final outcome to attract the average dance-goer."
                                            },
                                            {
                                                "example_id": "f981f79b-5fa4-4336-875b-b866e4051851",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "Career diplomat Conrad Tribble said on Twitter that multiculturalism “is one of our greatest strengths as a country, and I go to that well often as an American diplomat. It’s hard to overstate the global soft power impact of America’s cultural diversity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91f70b2-cbaf-3bfd-93f1-6e9c039cfcfe",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "An armed force, a body of troops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e189e6d8-a6cd-4d07-88fb-7a71f86fdfab",
                                                "sense_id": "c91f70b2-cbaf-3bfd-93f1-6e9c039cfcfe",
                                                "text": "Thou princely leader of our English strength,\nNever so needful on the earth of France,"
                                            },
                                            {
                                                "example_id": "0b71fb22-9425-4a48-ac03-011deb3f5a09",
                                                "sense_id": "c91f70b2-cbaf-3bfd-93f1-6e9c039cfcfe",
                                                "text": "That done, dissever your united strengths,\nAnd part your mingled colours once again;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7e4c36-1ec8-3a3a-bc1c-93da5f07ba6d",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "A strong place; a stronghold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd6807a-048d-4da0-8011-db99ea4b1496",
                                                "sense_id": "ef7e4c36-1ec8-3a3a-bc1c-93da5f07ba6d",
                                                "text": "All like himself rebellious, by whose aid\nThis inaccessible high strength, the seat\nOf Deitie supream, us dispossest,\nHe trusted to have seis’d […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f7499d-f85b-3506-b24b-9602a9223cc0",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The minimum ratio of the number of edges removed from a given graph to components created, over all possible removals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "strength",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                        "entry_id": "eeadaa95-45ce-3496-bc8b-5417bd3cfcdb",
                                        "glosses": [
                                            "To strengthen (all senses)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208be12b-2bf7-4de1-b26e-d817e8e20a9a",
                                                "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                                "text": "ſtrengthed with all myght / thꝛowe hys gloꝛious power / vnto all pacience / and longe ſufferynge with ioyfulnes"
                                            },
                                            {
                                                "example_id": "18b3e966-019f-4ddf-b60b-40e9e551b1fa",
                                                "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                                "text": "Then ſhalt thow perceave what it meaneth that the power of this wretched monſtre / muſt be ſtrengthed / by anothers power and not by his awne."
                                            },
                                            {
                                                "example_id": "3bc6bcd4-1a3b-4ae5-8e63-c635e0b308ad",
                                                "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                                "text": "In witnes wherof we haue cauſed this pꝛeſent wꝛiting to be ſtrengthed with the ſeal of our facultie[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c357ef37-af43-4514-835e-f8dd49ed8bee",
                        "source_entry_id": "7669d9cd-0f15-3a3a-9898-66f6d17ac772",
                        "source_sense_id": "ca105cf4-fd04-32f3-89b9-2f654fe7c2d6",
                        "target_lang_word": "courage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Capacité d'un humain ou un autre animal de vaincre sa peur pour braver le danger, supporter la souffrance, entreprendre des choses effrayantes, douloureuses ou difficiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea1c7d7-3fc3-4774-a987-afc1f2cb20d7",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Le courage, ce n’est pas de laisser aux mains de la force la solution des conflits que la raison peut résoudre ; car le courage est l’exaltation de l’homme et ceci en est l’abdication. Le courage pour vous tous, courage de toutes les heures, c'est de supporter sans fléchir les épreuves de tout ordre, physiques et morales, que prodigue la vie. Le courage, c’est de ne pas livrer sa volonté au hasard des impressions et des forces ; c’est de garder dans les lassitudes inévitables, l’habitude du travail et de l’action."
                                            },
                                            {
                                                "example_id": "a4cdb5a7-e9b0-4134-976b-b3bb056b5622",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Ce ne sont pas des considérations sur l’harmonie de l’Univers (même en personnifiant l’Univers), qui pourront donner aux hommes ce courage que Renan comparait à celui que possède le soldat montant à l’assaut."
                                            },
                                            {
                                                "example_id": "ec4e5ba5-b704-4736-85b1-9ea1414da6e0",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Acceptons que le courage militaire demeure l'apanage d'une caste enfantine et bruyante, et ne se répande pas, comme l'a fait la Légion d’honneur, son insigne, parmi les professeurs, les contrôleurs, les peintres..."
                                            },
                                            {
                                                "example_id": "7f508c04-bd2a-4777-a35d-d7a00fa38f9d",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Le curé de Gross-Aspern nous introduisit dans ce fameux cimetière où Français et Autrichiens se battirent ayant du sang jusqu’à mi-jambe, avec un courage et une persistance également glorieuses de part et d'autre."
                                            },
                                            {
                                                "example_id": "bc295733-b3b3-4f51-904a-85eb6cb2b54d",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Les généraux sont des gens qui manquent le plus complètement de courage qu'il y ait."
                                            },
                                            {
                                                "example_id": "c4b0d5de-cfee-447b-a14e-fd208def26fc",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Moi, j’étais ratatiné au fond de la voiture. Eux, mes compagnons, restaient d’un calme forcené. Ils tiraient par la portière avec une témérité insensée. J’ai compris, là, ce qu’était le courage : cette tranquillité absolue qui te fait vivre de tels instants comme un éblouissement."
                                            },
                                            {
                                                "example_id": "c06822bd-2be2-4c4d-95a7-3c095696ad0d",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Si, comme on le dit, le courage est l'art du commencement, la persévérance, elle, c'est l'art du recommencement."
                                            },
                                            {
                                                "example_id": "aa875763-f035-49e2-b5e5-e9244c3527d6",
                                                "sense_id": "1658485b-7479-3b6f-84a8-e3487da71886",
                                                "text": "Le courage se situe toujours quelque part entre l'audace et la couardise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669806ba-0643-3cd7-9759-9e563eccfa09",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "(Moderne) Capacité de ne pas avoir peur, face à une situation potentiellement effrayante (contraster avec sens nᵒ 1)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66687f1c-f1db-3e16-9763-f4123b319a3f",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Personnes courageuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6419db72-4582-4b25-8d3f-5c68c4fad5d2",
                                                "sense_id": "66687f1c-f1db-3e16-9763-f4123b319a3f",
                                                "text": "Enflammer les courages."
                                            },
                                            {
                                                "example_id": "8fa4de2d-f6e7-4d79-bd85-51114f9f724c",
                                                "sense_id": "66687f1c-f1db-3e16-9763-f4123b319a3f",
                                                "text": "Les grands courages ne se laissent point abattre par l’adversité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "162d5a9b-1e8d-3562-a1ab-f959f042c6b7",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Dureté de cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71c4520-824e-4035-a797-e19372368d20",
                                                "sense_id": "162d5a9b-1e8d-3562-a1ab-f959f042c6b7",
                                                "text": "Elle se dit qu'il fallait montrer aujourd'hui tout son courage, être comme ces femmes de la ville, ces grandes dames qui savent mépriser les hommes peu fidèles et regarder avec hauteur leur légèreté oublieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6f8a53-6902-3ee9-a902-fe71904ef984",
                                        "entry_id": "617b34e4-5152-3542-b7e2-0ad971b1358c",
                                        "glosses": [
                                            "Capacité d'agir, de se donner à ce qu'on fait ou doit faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0c7ed6-d66f-4e4a-b2a4-824c7c20686e",
                                                "sense_id": "2d6f8a53-6902-3ee9-a902-fe71904ef984",
                                                "text": "On entend souvent les personnes fatiguées déclarer : « Je suis sans courage. » Le mot est ici synonyme d'énergie : pour en disposer, il faut que le corps soit en état. Sinon, le courage requis pour l'acte le plus simple devient disproportionné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                        "entry_id": "9c70c90c-4b58-3a0c-a4b7-c2764237131e",
                                        "glosses": [
                                            "Interjection servant à animer, à exciter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610fb0c0-22ef-407e-bfc1-52839197ca5f",
                                                "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                                "text": "Allons, courage !"
                                            },
                                            {
                                                "example_id": "ab4aaee2-951b-41a7-bbe0-826f1aa770b0",
                                                "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                                "text": "Courage, mes amis !"
                                            },
                                            {
                                                "example_id": "d04f134a-81b1-4c4e-b5e6-8687b0bbe054",
                                                "sense_id": "f73036f8-1f06-3230-94a8-2b5fe9550e91",
                                                "text": "Bon courage !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
