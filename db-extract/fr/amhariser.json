                ],
                "senses": [
                    {
                        "sense_id": "c561885d-327b-3cbd-a9f4-76da94f63c60",
                        "entry_id": "63a2e111-a3e7-31e1-8797-ae6c890bc9f6",
                        "glosses": [
                            "Donner un caractère amharique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96315894-e5bf-4e1c-b632-a6b28e6e1677",
                                "sense_id": "c561885d-327b-3cbd-a9f4-76da94f63c60",
                                "text": "On pourrait penser qu’ayant le soutien du pouvoir central et de l’évêque d’Arba-Mintch ils aient pu amhariser leurs voisins."
                            },
                            {
                                "example_id": "d949fd8e-48ba-4322-b510-5ceef7a3371d",
                                "sense_id": "c561885d-327b-3cbd-a9f4-76da94f63c60",
                                "text": "Ensuite Voice affirme qu’au cours des siècles suivants (et surtout à l’époque où les Oromo dominèrent le royaume de Gondar et où l’oromo était même devenu la langue de la cour de Gondar), les « éléments abyssins » intriguèrent pour maintenir les Oromo dans des positions subalternes et pour les convertir au christianisme, c'estwà-dire pour les amhariser (voir Getahun Dilebo: 57-42)."
                            }
                        ]
                    }
