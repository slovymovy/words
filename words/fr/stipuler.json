                    "frequency": "Middle",
                    "semantic_group_id": "reglement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le règlement intérieur de l'école <w>stipule</w> clairement que les téléphones portables sont interdits en classe."
