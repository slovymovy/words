                ],
                "senses": [
                    {
                        "sense_id": "74fafa37-8449-3775-8b2b-9cb93f8049cf",
                        "entry_id": "ceb5c8d4-9035-3ecc-9e36-9218efe6b88b",
                        "glosses": [
                            "Gruppe von Leuten, die eng beisammenstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64bf17b-d188-4761-b1c9-e6b2f760c6e3",
                                "sense_id": "74fafa37-8449-3775-8b2b-9cb93f8049cf",
                                "text": "„Und da, mitten in dieser Menschentraube, wurde Elisabeth traurig.“"
                            },
                            {
                                "example_id": "bbfb6924-7613-4978-bec3-26ddaa0a6439",
                                "sense_id": "74fafa37-8449-3775-8b2b-9cb93f8049cf",
                                "text": "„Am Bus drängelt sich eine Menschentraube mit mürrischen Gesichtern.“"
                            },
                            {
                                "example_id": "b6925fe8-3a9e-411a-b237-9f6fec1ae7b9",
                                "sense_id": "74fafa37-8449-3775-8b2b-9cb93f8049cf",
                                "text": "„Er freut sich, dass sich endlich mal jemand für ihn interessiert, aber er will nicht mehr erzählen, weil sich mittlerweile eine neugierige Menschentraube um uns gebildet hat.“"
                            },
                            {
                                "example_id": "4da7e384-e920-4ea0-be2e-58db58875c39",
                                "sense_id": "74fafa37-8449-3775-8b2b-9cb93f8049cf",
                                "text": "„An einer Stelle der Reling verdichtete sich die Menschentraube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
