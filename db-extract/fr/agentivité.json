                "entry_id": "7d2933a6-4173-3e22-aa3b-9f5f6603f6d0",
                "word": "agentivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f6c75fa4-555c-4bb7-a824-9b76ed72d53d",
