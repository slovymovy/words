                "senses": [
                    {
                        "sense_id": "f7386ccd-9884-336c-ac4d-cc1e20ef8c52",
                        "entry_id": "0363823a-6811-3baa-bd91-70b87ab96e4a",
                        "glosses": [
                            "het snel boos en driftig kunnen worden; het prikkelbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ec703c-6b40-4a58-9b6b-eef5b2ffbe2d",
                                "sense_id": "f7386ccd-9884-336c-ac4d-cc1e20ef8c52",
                                "text": "Cameron onderging het spervuur van vragen zo goed mogelijk, met opeengeklemde lippen, en hield zijn eigen opvliegendheid in bedwang, maar het leven werd ondraaglijk."
                            },
                            {
                                "example_id": "e25f6b2d-3fcf-4c2b-b129-43ee72c39362",
                                "sense_id": "f7386ccd-9884-336c-ac4d-cc1e20ef8c52",
                                "text": "Bovendien verwijten de demonstranten Erdogan een autoritaire regeerstijl. Zijn charisma, opvliegendheid en soms agressieve toon hebben hem populair gemaakt, bijvoorbeeld bij zijn opstelling tegenover Israël, maar ook in het binnenland houdt hij niet van tegenspraak en dat gaat veel Turken nu te ver."
                            }
                        ]
                    }
