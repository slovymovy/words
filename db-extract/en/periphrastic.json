{
    "word": "periphrastic",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                "word": "periphrastic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                        "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                        "glosses": [
                            "Expressed in more words than are necessary."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "da978b32-cfd3-48ed-ba24-b7bc76d691d2",
                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                "text": "He wrote a periphrastic love letter to his wife to patch up their relationship."
                            },
                            {
                                "example_id": "381e8e7f-793c-4e34-94b7-76d79edd888c",
                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                "text": "She was simply asked to express how she felt, but her response was periphrastic."
                            },
                            {
                                "example_id": "95969eef-5691-4d6d-9c32-4447d3b8c4d2",
                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                "text": "As poetry it does not measure up to Aasen; as translation it is periphrastic, arbitrary, not at all faithful."
                            },
                            {
                                "example_id": "b9b169ca-3ebb-40a6-a89b-7cb665a56460",
                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                "text": "That was a way of putting it—not very satisfactory/ A periphrastic study in a worn-out poetical fashion/ Leaving one still with the intolerable wrestle / With words and meanings."
                            }
                        ]
                    },
                    {
                        "sense_id": "5769c501-f7a6-305d-ad1a-d2b626ba8853",
                        "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                        "glosses": [
                            "Indirect in naming an entity; circumlocutory."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bac1942c-8963-4a11-bb69-efbabf758328",
                                "sense_id": "5769c501-f7a6-305d-ad1a-d2b626ba8853",
                                "text": "In writing, they deem it irreverent to express the Supreme Being [and] in conversation they generally use a periphrastic epithet, such as the All-Good."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a28f82b-f307-3b40-9fa6-4a08bf6225e0",
                        "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                        "glosses": [
                            "Characterized by periphrasis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9eb5679-6703-44b5-9811-4c939a2ee549",
                                "sense_id": "3a28f82b-f307-3b40-9fa6-4a08bf6225e0",
                                "text": "“The daughter of the man” may be used as a periphrastic synonym for “the man’s daughter”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
