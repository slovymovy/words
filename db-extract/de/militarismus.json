                                "target_senses": [
                                    {
                                        "sense_id": "427012e3-9a88-3dc9-9477-31723c62b95d",
                                        "entry_id": "2cc2c228-ca7c-3756-b3c0-175462e40c22",
                                        "glosses": [
                                            "An ideology which claims that the military is the foundation of a society's security, and thereby its most important aspect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07c32142-6b64-301f-bc52-49c900816f41",
                                        "entry_id": "2cc2c228-ca7c-3756-b3c0-175462e40c22",
                                        "glosses": [
                                            "A focus on, or excessive use of, military force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "720a2d2f-2a76-4a44-ab95-003e1597e4b0",
                        "source_entry_id": "72ae64a8-eeca-3078-87af-6a184f4f1e01",
                        "source_sense_id": "3777ed2c-c426-3f82-9c18-3eb1c9d510fa",
                        "source_sense_description": "abwertend: Dominanz militärisch geprägter Denkkultur in einer Gesellschaft",
                        "target_lang_word": "militarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c7ef2a8-96fc-321a-be4a-ed739e891f15",
                                        "entry_id": "ef798e4d-3c64-3d6a-bfd8-acf49794d16f",
                                        "glosses": [
                                            "Système qui promeut tout ce qui est militaire dans le fonctionnement d'une société humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7185fc3a-dee4-46b9-842a-bafbf4b8a52f",
                                                "sense_id": "2c7ef2a8-96fc-321a-be4a-ed739e891f15",
                                                "text": "On pourrait se servir de cet exemple pour démontrer tout ce que le militarisme peut d’ignoble et de ridicule."
                                            },
                                            {
                                                "example_id": "5f62ec8f-cd7a-4f7d-a92d-f895e9bf333e",
                                                "sense_id": "2c7ef2a8-96fc-321a-be4a-ed739e891f15",
                                                "text": "Le militarisme s'est vu le maître de la République. Il ne veut pas renoncer à l'asservir. Il s'obstine."
                                            },
                                            {
                                                "example_id": "78581f9b-b8ec-4f8c-828e-e35b8ca9c3e7",
                                                "sense_id": "2c7ef2a8-96fc-321a-be4a-ed739e891f15",
                                                "text": "Confusion : le kaiser s'est enfui en Hollande, mais le militarisme demeure et les chefs sociaux-démocrates du nouveau régime, républicain, font alliance avec les généraux monarchistes et les corps francs à croix gammée contre les spartakistes."
                                            },
                                            {
                                                "example_id": "0edf9af1-6e46-4ae1-bb24-e546f0c84a8d",
                                                "sense_id": "2c7ef2a8-96fc-321a-be4a-ed739e891f15",
                                                "text": "Des questions ne se posent plus ou n'ont plus droit au premier rang dans l'urgence révolutionnaire: ce sont d'abord les questions petit-bourgeoises, héritages des révolutions partielles qui parsemèrent le XIXᵉ siècle : cléricalisme, militarisme, parlementarisme."
                                            },
                                            {
                                                "example_id": "a13d25ba-f0dd-4d2d-966f-e3579096cd34",
                                                "sense_id": "2c7ef2a8-96fc-321a-be4a-ed739e891f15",
                                                "text": "Le zimmerwaldien Bourderon en tient lui-même pour une « paix de conciliation » mais après la « victoire sur le militarisme prussien » qui joue son va-tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
