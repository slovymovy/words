                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language_name_group",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He managed to pick up a smattering of <w>Arab</w> while traveling.",
