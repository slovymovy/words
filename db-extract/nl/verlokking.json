                    },
                    {
                        "translation_id": "6bee4654-62e8-41c7-881d-70a86fb5c412",
                        "source_entry_id": "851332dc-8ec8-38aa-a4f9-dddd9aa4eaab",
                        "source_sense_id": "d8aee12e-0c24-3bf5-b321-6c54f7844df4",
                        "source_sense_description": "iets wat veel aantrekkingskracht uitoefent en wat goed is",
                        "target_lang_word": "charm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc72e2c-7c35-326c-b045-2c997533dfd6",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "An object, act or words believed to have magic power (usually carries a positive connotation)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9498a3f-02a0-4e3a-bbe8-5a1f27521abd",
                                                "sense_id": "1bc72e2c-7c35-326c-b045-2c997533dfd6",
                                                "text": "a charm against evil"
                                            },
                                            {
                                                "example_id": "a109b957-6d47-427b-b238-335ca35336ac",
                                                "sense_id": "1bc72e2c-7c35-326c-b045-2c997533dfd6",
                                                "text": "It works like a charm."
                                            },
                                            {
                                                "example_id": "9b1cecdf-65be-4c4e-84c1-54306255f707",
                                                "sense_id": "1bc72e2c-7c35-326c-b045-2c997533dfd6",
                                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "The ability to persuade, delight or arouse admiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63743273-66a7-45f9-9614-42e107201e4a",
                                                "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                                "text": "He had great personal charm."
                                            },
                                            {
                                                "example_id": "8c238c97-e428-4ba7-9dd9-6ceb15de5721",
                                                "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                                "text": "She tried to win him over with her charms."
                                            },
                                            {
                                                "example_id": "e9854077-ca77-439f-9752-309803647711",
                                                "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                                "text": "[…]the charm of Beauties powerful glance."
                                            },
                                            {
                                                "example_id": "1ede2630-4e44-4148-944c-608f68244fbc",
                                                "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                                "text": "Muſick has Charms to ſooth a ſavage Breaſt,\n To ſoften Rocks, or bend a knotted Oak."
                                            },
                                            {
                                                "example_id": "7d81e489-3108-48a6-90bc-8c912c090d0f",
                                                "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                                "text": "Charms ſtrike the ſight, but merit wins the ſoul."
                                            },
                                            {
                                                "example_id": "bc7b0067-b4ab-4016-bf84-fcd7ebbe79a8",
                                                "sense_id": "9aacf1ee-5bae-323f-8ed4-9ad495ac6049",
                                                "text": "Her coyneſs was conquered by aſſiduity, and at laſt ſhe conſented to reſign the treaſure of her charms to my paſſion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b50148-4bc6-382b-910a-790767e1ac69",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "A small trinket on a bracelet or chain, etc., traditionally supposed to confer luck upon the wearer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12047efe-cb90-4d90-b0a0-871bd6aa4328",
                                                "sense_id": "64b50148-4bc6-382b-910a-790767e1ac69",
                                                "text": "She wears a charm bracelet on her wrist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5cc80b-3edc-397b-913f-3635159852a0",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "The collective noun for a group of goldfinches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a5d3a7-0479-3f11-8bcb-bfbbf703d969",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "A quantum number of hadrons determined by the number of charm quarks and antiquarks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "particle",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2afa456-b9f6-437f-ad86-5d286de93c1f",
                                                "sense_id": "04a5d3a7-0479-3f11-8bcb-bfbbf703d969",
                                                "text": "In trying to understand the long life of the psi particle, physicists postulated the notion of “charm.” Charm, they say, prevents the “easy” decay of particles and thus prolongs their lifetimes. U particles, Dr. Pert said, may carry the property of charm."
                                            },
                                            {
                                                "example_id": "4f3d1518-f5c1-46fe-bfd4-36b5d4af8aca",
                                                "sense_id": "04a5d3a7-0479-3f11-8bcb-bfbbf703d969",
                                                "text": "Mesons which combine the charmed quark with the up or down antiquarks are denoted the D mesons. These mesons carry explicit charm (i.e. have a non-zero charm quantum number), just as the K mesons carry strangeness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fc48bf4-fdd0-3acd-9821-ac000ff82ebc",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "A second-order measure of derivative price sensitivity, expressed as the instantaneous rate of change of delta with respect to time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0eb2a34-9eb6-30e2-852c-b329340c14bb",
                                        "entry_id": "988f2dfc-5c8e-3466-b6a7-00e0006b89a4",
                                        "glosses": [
                                            "An icon providing quick access to a command or setting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b73cbb43-6782-4354-a937-0c2634776d5d",
                                                "sense_id": "e0eb2a34-9eb6-30e2-852c-b329340c14bb",
                                                "text": "Undoubtedly one of the most important pieces to navigating Windows 8, charms are actually not visible until a command to show them is given."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "839177d8-8d2b-3833-97c4-3565c35cf88a",
                                        "entry_id": "3beeb95f-e1db-3edd-a038-7b886c92b66a",
                                        "glosses": [
                                            "To seduce, persuade or fascinate someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f8fad7-4369-4256-b115-002be741ec70",
                                                "sense_id": "839177d8-8d2b-3833-97c4-3565c35cf88a",
                                                "text": "He charmed her with his dashing tales of his days as a sailor."
                                            },
                                            {
                                                "example_id": "58f4dc22-b90d-4102-ae1c-98c0054a3ae8",
                                                "sense_id": "839177d8-8d2b-3833-97c4-3565c35cf88a",
                                                "text": "[…]they, on thir mirth & dance / Intent, with jocond Muſic charm his ear;"
                                            },
                                            {
                                                "example_id": "03fae53e-f052-4401-92d0-4f615f8b67bf",
                                                "sense_id": "839177d8-8d2b-3833-97c4-3565c35cf88a",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track. The three returned wondering and charmed with Mrs. Cooke; they were sure she had had no hand in the furnishing of that atrocious house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32cf99f-f6c8-3603-9a55-cab0625cc110",
                                        "entry_id": "3beeb95f-e1db-3edd-a038-7b886c92b66a",
                                        "glosses": [
                                            "To use a magical charm upon; to subdue, control, or summon by incantation or supernatural influence; to ensorcel or exert a magical effect on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6666e50-9a7b-499f-9296-4363165d26a0",
                                                "sense_id": "a32cf99f-f6c8-3603-9a55-cab0625cc110",
                                                "text": "After winning three games while wearing the chain, Dan began to think it had been charmed."
                                            },
                                            {
                                                "example_id": "6d0fc6ec-75e2-4f98-88d5-062dc7c2b282",
                                                "sense_id": "a32cf99f-f6c8-3603-9a55-cab0625cc110",
                                                "text": "Nor no witch-craft charme thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75bf3d31-0497-37d0-9390-0b939ba0e5e1",
                                        "entry_id": "3beeb95f-e1db-3edd-a038-7b886c92b66a",
                                        "glosses": [
                                            "To protect with, or make invulnerable by, spells, charms, or supernatural influences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dae8331-5fa4-4c7d-811d-d12e18e5a889",
                                                "sense_id": "75bf3d31-0497-37d0-9390-0b939ba0e5e1",
                                                "text": "She led a charmed life."
                                            },
                                            {
                                                "example_id": "6f3f861b-ba66-46ae-ad77-855c1fe7c32b",
                                                "sense_id": "75bf3d31-0497-37d0-9390-0b939ba0e5e1",
                                                "text": "I, in mine owne woe charm’d, / Could not finde death,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49213bf-9d44-3853-804b-6c0182c14157",
                                        "entry_id": "3beeb95f-e1db-3edd-a038-7b886c92b66a",
                                        "glosses": [
                                            "To make music upon."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ab82ed-d8ba-42dc-9269-37031d4e0ebb",
                                                "sense_id": "a49213bf-9d44-3853-804b-6c0182c14157",
                                                "text": "But ah my corage cooles ere it be warme, / For thy, content vs in thys humble ſhade: / Where no ſuch troublous tydes han vs aſſayde, / Here we our ſlender pipes may ſafely charme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c577cc-a8c2-30bb-b778-27a0a92c732d",
                                        "entry_id": "3beeb95f-e1db-3edd-a038-7b886c92b66a",
                                        "glosses": [
                                            "To subdue or overcome by some secret power, or by that which gives pleasure; to allay; to soothe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7842b43-7a98-4474-98a6-d27afeb9dc82",
                                                "sense_id": "45c577cc-a8c2-30bb-b778-27a0a92c732d",
                                                "text": "Music the fierceſt griefs can charm, / And fate's ſevereſt rage diſarm: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d80559d5-9277-3640-8275-67ad2841efc9",
                                        "entry_id": "164de9b2-8517-3a27-af65-ac3328e11951",
                                        "glosses": [
                                            "The mixed sound of many voices, especially of birds or children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb4c09d-aed9-401a-9094-ad6149768089",
                                                "sense_id": "d80559d5-9277-3640-8275-67ad2841efc9",
                                                "text": "[…]Free libertie to chaunt our charmes at will:[…]"
                                            },
                                            {
                                                "example_id": "90283f65-3002-4542-8185-a1553a3ac934",
                                                "sense_id": "d80559d5-9277-3640-8275-67ad2841efc9",
                                                "text": "Sweet is the breath of morn, her riſing ſweet,\n With charm of earlieſt Birds;"
                                            },
                                            {
                                                "example_id": "312edf4c-bd59-41bd-941d-274d1ff36475",
                                                "sense_id": "d80559d5-9277-3640-8275-67ad2841efc9",
                                                "text": "The laughter rose like the charm of starlings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c617d0e1-045c-3693-be96-97ba5b3f01ac",
                                        "entry_id": "164de9b2-8517-3a27-af65-ac3328e11951",
                                        "glosses": [
                                            "A flock, group (especially of finches)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423014da-0e37-420a-b951-9e93a8e9a914",
                                                "sense_id": "c617d0e1-045c-3693-be96-97ba5b3f01ac",
                                                "text": "A charm of finches flew overhead, singing into the vivid afternoon sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
