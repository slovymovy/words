                                        "entry_id": "c56141c5-76bf-3e54-a05c-13ea658aaa98",
                                        "glosses": [
                                            "To wrap someone or something up like a burrito."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a1e1cc-bb03-4fb0-b1f2-b06340c530ec",
                                                "sense_id": "185c8425-b1d4-395c-ab88-8ae1d9f21cb7",
                                                "text": "“You're stealing the blankets,” Zack complained, tugging at the duvet that, somehow, Aaron had completely burritoed himself in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd10c1a-1c52-463f-a5d5-187eb8d50303",
                        "source_entry_id": "393f6fef-7942-36b2-b3f1-60a9c0239e81",
                        "source_sense_id": "bb1a9512-ed41-3a21-95c7-f6f8b47af884",
