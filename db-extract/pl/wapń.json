                    {
                        "sense_id": "b9b82265-0767-363e-8597-c66bf4e82983",
                        "entry_id": "19fdf749-0083-3280-96fd-ccf851a01fb3",
                        "glosses": [
                            "pierwiastek chemiczny o symbolu Ca i liczbie atomowej 20"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8469840e-9bd8-4edb-ba7c-7736e36f544a",
                                "sense_id": "b9b82265-0767-363e-8597-c66bf4e82983",
                                "text": "Jakie właściwości chemiczne ma wapń?"
                            },
                            {
                                "example_id": "692c3ed8-399b-438f-89dc-6254a7a782ca",
                                "sense_id": "b9b82265-0767-363e-8597-c66bf4e82983",
                                "text": "Mleko owsiane zwykle robi się z owsa, wody i oleju słonecznikowego, ale można je też wzbogacić wapniem, wanilią i witaminami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4b2f71d-b7e1-4fa7-ab92-b6cf61d25f47",
                        "source_entry_id": "19fdf749-0083-3280-96fd-ccf851a01fb3",
