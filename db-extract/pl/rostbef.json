                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a3c6c31-c8b5-4133-aeb8-d56b994d40a5",
                        "source_entry_id": "f21dfcb3-9475-3548-a2be-faad15ed60a7",
                        "source_sense_id": "7a113396-4d0f-390f-b12a-81448b5447ce",
                        "target_lang_word": "ростбиф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ростбиф",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5f63d8e4-8d70-355e-9132-bd2698193d48",
                                        "entry_id": "891758b1-db4b-313f-b02f-68ef8bd2a9c3",
                                        "glosses": [
                                            "гастрон. поджаренный кусок говядины, вырезанный из филейной части туши"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea02a567-c602-40d5-8639-2382a66fa17a",
                                                "sense_id": "5f63d8e4-8d70-355e-9132-bd2698193d48",
                                                "text": "Секрет ростбифа состоит в том, что мясо должно зажариться сразу со всех сторон."
                                            },
                                            {
                                                "example_id": "e6a3b810-7859-49f5-9bf2-822a8c6f20a3",
                                                "sense_id": "5f63d8e4-8d70-355e-9132-bd2698193d48",
                                                "text": "Если печь слишком жарка, и при этом мала, как, напр., духовая печь для ростбифа, то, чтобы сверху не подгорело, надо прикрывать ростбиф бумагой и поливать стёкшим на противень мясным соком."
                                            },
                                            {
                                                "example_id": "0192d708-09bc-4137-89bb-9c26790102d7",
                                                "sense_id": "5f63d8e4-8d70-355e-9132-bd2698193d48",
                                                "text": "Пообедали: артишоки, гигантский ростбиф, рокфор, изумительное шампанское."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
