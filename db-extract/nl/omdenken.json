                        "glosses": [
                            "to flip-think, to rethink, to look at the problem differently so that it transforms in an opportunity"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09894d28-63e7-4a7c-9f20-8c262f1ab905",
                                "sense_id": "43c45376-48a3-3f76-8f5b-ba3d4c9e4fae",
                                "text": "Door om te denken ga je anders tegen de dingen aankijken dan je in eerste instantie zou doen.",
                                "translation": "By flip-thinking you will look at things differently than you would initially.",
                                "english": "By flip-thinking you will look at things differently than you would initially."
