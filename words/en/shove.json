                    "sense_definition": "An act of betting all of one's chips in a poker game.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>shove</w> surprised everyone at the table.",
                            "target_lang_translations": {
                                "ru": "Его внезапный <w>ва-банк</w> удивил всех за столом.",
