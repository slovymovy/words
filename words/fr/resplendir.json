                    "sense_definition": "Émettre une lumière très vive ; briller d'un éclat intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au sommet de la montagne, la neige blanche <w>resplendissait</w> sous les premiers rayons du matin."
                        },
                        {
                            "text": "Le lustre en cristal de la salle de bal faisait <w>resplendir</w> la pièce tout entière."
                        }
                    ],
                    "synonyms": [
                        "briller",
                        "rayonner",
                        "scintiller",
                        "étinceler"
                    ],
                    "antonyms": [
                        "s'assombrir",
                        "s'éteindre",
                        "ternir"
                    ],
                    "common_phrases": [
                        "resplendir de mille feux",
                        "resplendir au soleil"
                    ]
                },
                {
                    "sense_id": "f2d5ac68-89fe-3fb2-854b-e650d3ac3542",
                    "sense_definition": "Manifester de façon éclatante et remarquable un sentiment, un état ou une qualité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mariée <w>resplendissait</w> de bonheur au milieu de sa famille et de ses amis."
                        },
                        {
                            "text": "Après ce long séjour au grand air, il <w>resplendit</w> véritablement de santé."
                        }
                    ],
                    "synonyms": [
