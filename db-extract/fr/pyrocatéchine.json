        "fr-extract.jsonl": [
            {
                "entry_id": "a6ca2a66-791c-36da-af23-443a36f3c881",
                "word": "pyrocatéchine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "717b329e-6d0d-3c18-9a62-2a86935b952b",
                        "entry_id": "a6ca2a66-791c-36da-af23-443a36f3c881",
                        "glosses": [
                            "Agent chimique, issu de la distillation sèche du cachou et composé d'orthodioxybenzène, qui fut utilisé jadis en photographie comme révélateur des clichés en noir et blanc."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ff57e240-fd03-43bd-adf7-56907c616830",
                                "sense_id": "717b329e-6d0d-3c18-9a62-2a86935b952b",
                                "text": "Le gaïacol C₆H₄.OH.OCH₃ est un éther monométhylique d'un phénol diatomique la pyrocatéchine C₆H₄(OH)₂."
                            },
                            {
                                "example_id": "f15f7e14-4c9c-4f0f-82ad-bd915c6de2fd",
                                "sense_id": "717b329e-6d0d-3c18-9a62-2a86935b952b",
                                "text": "Il n'a donné par la distillation aucun indice ni d'acide pyrogallique ni de pyrocatéchine. La catéchine qui forme la portion du cachou insoluble dans l'eau froide, a fourni en quantité notable par la distillation la pyrocatéchine de M. Zwenger."
                            },
                            {
                                "example_id": "b881c8b4-6b30-4c0e-8440-40b87782333c",
                                "sense_id": "717b329e-6d0d-3c18-9a62-2a86935b952b",
                                "text": "Pour un développement d’une durée comprise entre 45 minutes et une heure, il convient d’employer un révélateur peu oxydable, ne produisant pas de voile chimique et ne colorant pas la gélatine. La pyrocatéchine et l’iconyl (glycin) remplissent parfaitement ces conditions."
                            }
                        ]
                    }
                ],
