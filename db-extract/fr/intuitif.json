                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fb102dc-8e8b-3083-be0f-24c9a1ffdcc2",
                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                        "glosses": [
                            "Qui fait appel à l’intuition, qui est automatique ou inné et ne fait pas ou peu appel à la raison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e678760-f794-40ce-af91-20478f4ea22f",
                                "sense_id": "2fb102dc-8e8b-3083-be0f-24c9a1ffdcc2",
                                "text": "Cette panoplie de données objectives et quantifiées permet de dépasser largement l’approche intuitive, pifométrique et incertaine qui reste la plus souvent celle de la psychologie historique."
                            },
                            {
                                "example_id": "b09c1fd8-3e18-430b-83c2-4c97221d647a",
                                "sense_id": "2fb102dc-8e8b-3083-be0f-24c9a1ffdcc2",
                                "text": "Elle est très intuitive dans ses jugements sur les gens."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e09e9c9-933d-3978-8404-f836fb5602d9",
                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                        "glosses": [
                            "Qui résulte de l’intuition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2a0442-1e5c-478e-a987-27b218d34ca8",
                                "sense_id": "3e09e9c9-933d-3978-8404-f836fb5602d9",
                                "text": "Les bienheureux ont la vision intuitive de Dieu."
                            },
                            {
                                "example_id": "ed2e6d01-70a5-4fad-b042-0244c067b33e",
                                "sense_id": "3e09e9c9-933d-3978-8404-f836fb5602d9",
                                "text": "Connaissance intuitive."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6b11263-869e-3af5-8b9a-2c95404b4ed4",
                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                        "glosses": [
                            "Qui fait appel au sens plutôt qu’au raisonnement ou à la mémoire de celui qui apprend."
                        ],
                        "tags": [
                            "Pédagogie"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc945ff-4aab-400e-83b4-6a116c141297",
                                "sense_id": "e6b11263-869e-3af5-8b9a-2c95404b4ed4",
                                "text": "Méthode intuitive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f16543e0-2e7f-4ff2-99b4-e1413ce70dcd",
                        "source_entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                        "target_lang_word": "intuitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intuitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                                        "glosses": [
                                            "Spontaneous, without requiring conscious thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fae3462-89a5-42ad-ae0c-8a4ac9f036dd",
                                                "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                                "text": "The intuitive response turned out to be correct."
                                            },
                                            {
                                                "example_id": "25e27ed5-98a0-414a-951b-27acb171597e",
                                                "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            },
                                            {
                                                "example_id": "d752381a-d409-46e0-9863-171a2ae04d0a",
                                                "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                                "text": "These impressions [of potential papal candidates], collected from interviews with a variety of church officials and experts, may influence the very intuitive, often unpredictable process the cardinals will use to decide who should lead the world’s largest church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abf6aa49-868b-3a8a-9d08-94265644e6a9",
                                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                                        "glosses": [
                                            "Easily understood or grasped by intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba9a90d-f972-4dd5-8714-f85882e43b0b",
                                                "sense_id": "abf6aa49-868b-3a8a-9d08-94265644e6a9",
                                                "text": "Designing software with an intuitive interface can be difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4b9a044-c039-3fc5-9100-865e6d4236ea",
                                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                                        "glosses": [
                                            "Having a marked degree of intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29fd67a-40d0-4521-824b-57ee9dcb2354",
                                                "sense_id": "c4b9a044-c039-3fc5-9100-865e6d4236ea",
                                                "text": "I'm real intuitive, everyone is, we're just conditioned not to trust it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intuitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdeadfbb-8d2b-3df6-b158-a3abdeba2862",
