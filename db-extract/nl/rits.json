                ],
                "translations": [
                    {
                        "translation_id": "d81f8d54-d9b1-4530-910e-148939e7fe79",
                        "source_entry_id": "c8197ee9-b3d9-3525-bf84-f08933d90a82",
                        "source_sense_id": "a62eba43-bdfc-3959-ab44-0e5d52064652",
                        "source_sense_description": "ritssluiting",
                        "target_lang_word": "Reißverschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reißverschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "924a402d-5b9c-3e60-875c-e730c191d336",
                                        "entry_id": "63676c0d-8699-3b01-bb00-446eea5e2236",
                                        "glosses": [
                                            "zum Beispiel an Taschen und Kleidungsstücken angebrachte Art des Verschlusses, bei der zwei gegenüberliegende Seiten von Krampen durch einen Schieber miteinander verhakt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6efc7a-7215-4101-bbb9-e3ea3f3711d4",
                                                "sense_id": "924a402d-5b9c-3e60-875c-e730c191d336",
                                                "text": "Leider ist der Reißverschluss kaputt."
                                            },
                                            {
                                                "example_id": "f36674f7-e716-44e8-82f5-068df6863ad1",
                                                "sense_id": "924a402d-5b9c-3e60-875c-e730c191d336",
                                                "text": "„Er hatte den Reißverschluss an seiner Hose geöffnet, und ein gelber Urinrand hatte sich in den weißen Schneeteppich gegraben.“"
                                            },
                                            {
                                                "example_id": "ebcbde7a-b70f-42aa-a374-5a1f73846620",
                                                "sense_id": "924a402d-5b9c-3e60-875c-e730c191d336",
                                                "text": "„Stefan war gerade dabei, den Reißverschluss seiner Umhängetasche zu öffnen, Elisabeth hielt mitten im Schritt inne.“"
                                            },
                                            {
                                                "example_id": "b94048af-71d1-4924-ae50-e4f528d0dd36",
                                                "sense_id": "924a402d-5b9c-3e60-875c-e730c191d336",
                                                "text": "„Fabiola tastete nach ihrer kleinen Umhängetasche, öffnete den Reißverschluss und kramte nach ihrem Schlüssel.“"
                                            },
                                            {
                                                "example_id": "400f199d-8364-47e7-8dc9-289f97d998da",
                                                "sense_id": "924a402d-5b9c-3e60-875c-e730c191d336",
                                                "text": "„Am nächsten Morgen sitzt sie auf dem Koffer und zerrt am Reißverschluss, als Sima den Kopf zur Tür hereinsteckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3e24e1-4ac4-4506-80bb-b61b9cbd7e16",
                        "source_entry_id": "c8197ee9-b3d9-3525-bf84-f08933d90a82",
                        "source_sense_id": "a62eba43-bdfc-3959-ab44-0e5d52064652",
                        "source_sense_description": "ritssluiting",
                        "target_lang_word": "zipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "331c66b7-147f-3288-9009-56be84e8d0b4",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A zip fastener."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e2fab4-e29f-42af-826c-00a8d0844b17",
                                                "sense_id": "331c66b7-147f-3288-9009-56be84e8d0b4",
                                                "text": "He got his T-shirt stuck in the zipper of his jacket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f5b47a-f0d2-3a85-99eb-a3941eed67f5",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A pressure-sensitive plastic closure, as on a Ziploc bag."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "452563df-330c-3833-87f3-cfb49f2e19d9",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A leucine zipper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34f75abc-53cc-3aa3-8e0c-b7f853544ea8",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A scar on a person's body."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07f6deea-180f-450a-b882-dbb6c47746a0",
                                                "sense_id": "34f75abc-53cc-3aa3-8e0c-b7f853544ea8",
                                                "text": "I also competed in track and field at Idaho, and it's all because of putting the shot that I've got my long scar, my zipper, down the back of my neck."
                                            },
                                            {
                                                "example_id": "149694a6-d49e-4bf0-9918-c02af01b9221",
                                                "sense_id": "34f75abc-53cc-3aa3-8e0c-b7f853544ea8",
                                                "text": "Making the transition from high school to college teams, for instance, he could not believe the scars his new players were sporting. \"So many athletes had zippers down the side of their knee, or knees; they thought nothing of it and called this or that a Band-Aid operation. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb831d6b-3472-3f85-9c8b-05ec22eee99e",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "An air patrol carried out at dawn or dusk."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697154c8-cab7-41a2-a72e-d9c05e900ae6",
                                                "sense_id": "fb831d6b-3472-3f85-9c8b-05ec22eee99e",
                                                "text": "[…] the usual gap between the time the last strike of the day departed and the first night hecklers arrived was closed with \"zippers\" — night fighters who, using day fighter tactics, proceeded to the target in daylight in time to relieve the last day blanket patrol."
                                            },
                                            {
                                                "example_id": "cb8a8662-49f1-4542-a5fe-004b6b21163d",
                                                "sense_id": "fb831d6b-3472-3f85-9c8b-05ec22eee99e",
                                                "text": "They would handle all the night combat air patrols, the night hecklers who would go over the enemy airfields, and we formed a new little gimmick called \"zippers\" to help close that gap between the time the daylight strikes left the target and darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62cd061c-7e98-3ee5-a446-1c6e7d8f1c0d",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A string of clothes pegs or clips attached to the body and then quickly pulled off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2ca7bea-7766-34fe-abf7-ca3cd94b9b02",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A technique for arbitrarily traversing an aggregate data structure and updating its contents. See zipper (data structure)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d80e9270-06d2-3446-8f7a-3f314e00f3d0",
                                        "entry_id": "de5d5f1d-679b-3506-8ea2-8b60f6f6f351",
                                        "glosses": [
                                            "A zipline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d65e5db-b100-4c50-9802-6023c42b8605",
                                                "sense_id": "d80e9270-06d2-3446-8f7a-3f314e00f3d0",
                                                "text": "Skills acquired include learning the \"Flea Hop\" and the \"Tarzan Swing\" as well as \"Riding the Zipper\" (sliding 400 feet on a cable between two mountain peaks), canoeing in white-water rapids, bushwacking and learning to \"rappel\" hundreds of feet down sheer rock cliffs on a rope."
                                            }
                                        ]
                                    }
                                ]
                            },
