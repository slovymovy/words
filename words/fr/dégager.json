                },
                {
                    "sense_id": "b5f78cca-8096-3db0-95f3-4c7723819b9f",
                    "sense_definition": "Reprendre un bien ou un objet déposé en gage ou sous hypothèque après avoir remboursé sa dette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ressources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il a touché son salaire, il est allé au mont-de-piété pour <w>dégager</w> la montre familiale."
                        },
                        {
                            "text": "Le commerçant espérait <w>dégager</w> ses terres hypothéquées grâce à une excellente récolte annuelle."
