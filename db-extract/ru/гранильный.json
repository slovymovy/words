                ],
                "senses": [
                    {
                        "sense_id": "abb27395-1b94-391c-a8cc-090b4f8bd7ed",
                        "entry_id": "ae80d63f-2c4d-364e-b9d6-8cf1f5898817",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным гранение"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cb196146-1cff-3ebb-a788-d8dac8515605",
                        "entry_id": "ae80d63f-2c4d-364e-b9d6-8cf1f5898817",
                        "glosses": [
                            "предназначенный, используемый для гранения, огранки"
                        ],
                        "tags": [],
