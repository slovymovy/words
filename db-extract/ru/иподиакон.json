                                "target_senses": [
                                    {
                                        "sense_id": "e170e792-af05-3a3e-86c4-02d3085e6d21",
                                        "entry_id": "c1b98356-74b6-38a8-8ed5-99e0affa002d",
                                        "glosses": [
                                            "A Catholic clerical rank in the major orders below that of a deacon."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc8e5692-82dc-3b90-bf12-dc96dc1aabf2",
                                        "entry_id": "c1b98356-74b6-38a8-8ed5-99e0affa002d",
                                        "glosses": [
                                            "A Catholic cleric who assists the deacon at High Mass and normally reads the Epistle at the Eucharist."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "485d81a0-fcf7-3c53-bd23-ea01a33c1b88",
                                        "entry_id": "c1b98356-74b6-38a8-8ed5-99e0affa002d",
                                        "glosses": [
                                            "A layperson who acts as an assistant to the deacon during the celebration of mass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc93ed7-7de3-3117-83ad-a0da7b5a7db0",
                                        "entry_id": "c1b98356-74b6-38a8-8ed5-99e0affa002d",
                                        "glosses": [
                                            "The highest of the minor orders below that of a deacon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfedc10d-31ec-435f-abf2-fcf91542a69a",
                        "source_entry_id": "865251d6-6f81-39f0-9885-88acf0e4d7dd",
                        "source_sense_id": "ecfbe0b3-b14a-3798-98ec-52de85d033b5",
                        "target_lang_word": "Subdiakon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Subdiakon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                        "entry_id": "fc5898fc-6e82-3d7d-880e-fba6eb1facc2",
                                        "glosses": [
                                            "jemand, der die erste der höheren Weihen empfangen hat und damit auf der Weihestufe unter der des Diakons steht (vom 3. Jahrhundert bis 1972)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fde8789-6c0c-4d91-b29f-53bf367ae5da",
                                                "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                                "text": "Der Subdiakon trug bei der Feier der Heiligen Messe zum Zeichen seines Amtes den Manipel."
                                            },
                                            {
                                                "example_id": "84e40226-06bb-4fce-b8a6-567b379ea45d",
                                                "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                                "text": "„3. Während der Oktav wird die Messe feierlich gehalten mit zwei Altardienern, Diakon und Subdiakon, und Weihrauch wird verwendet zur Opferung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a177b6de-bdbc-3c4d-8295-045724490b23",
                                        "entry_id": "fc5898fc-6e82-3d7d-880e-fba6eb1facc2",
                                        "glosses": [
                                            "Amtsträger einer Stufe der niederen Weihen"
                                        ],
                                        "tags": [
                                            "Ostkirchen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f474bb-c47d-4572-af6e-edc54eb37e17",
                                                "sense_id": "a177b6de-bdbc-3c4d-8295-045724490b23",
                                                "text": "„Immer wieder öffnet sich die Tür und nacheinander erscheinen Diakone, Subdiakone und mehrere Frauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
