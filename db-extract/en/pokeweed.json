                                    {
                                        "sense_id": "57f978f3-587e-3bee-bc7b-6d20277fdeae",
                                        "entry_id": "3c95f1bf-6f35-3896-8296-33de66dc1075",
                                        "glosses": [
                                            "Vertreter aus der Gattung der Kermesbeerengewächse (Phytolaccaceae); Pflanze, deren Beeren für Färbungen verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d86829-86bf-4161-ac7f-401ffc1027ea",
                                                "sense_id": "57f978f3-587e-3bee-bc7b-6d20277fdeae",
                                                "text": "„Die Kermesbeere ist eigentlich in Amerika und Asien zu Hause und kommt dort vor allem in tropischen und subtropischen Gebieten vor.“"
                                            },
                                            {
                                                "example_id": "c2ddee01-dfc0-4ce6-8163-15c0d5a8f240",
                                                "sense_id": "57f978f3-587e-3bee-bc7b-6d20277fdeae",
                                                "text": "Der dunkelrote Saft der Kermesbeere wird im Mittelmeergebiet als Färbemittel für Rotwein verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b62461d-804b-3643-a692-6ed1fe3a9122",
                                        "entry_id": "3c95f1bf-6f35-3896-8296-33de66dc1075",
                                        "glosses": [
                                            "die Kermesschildlaus, die vor allen Dingen in Südeuropa auf den Blättern der Kermeseiche sitzt und als Lieferant für den roten Farbstoff Kermes dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9eac57f-752d-472c-b526-e0390ffde360",
                                                "sense_id": "4b62461d-804b-3643-a692-6ed1fe3a9122",
                                                "text": "Die erbsengroßen Weibchen der Kermeslaus – auch Kermesbeeren genannt – wurden früher getrocknet und als Lieferant des roten Farbstoffes Kermes in den Handel gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
