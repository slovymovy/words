                                        "entry_id": "7594d59b-d420-35ea-aa12-cda7ee2a88b1",
                                        "glosses": [
                                            "een regelmatig veelvlak bestaande uit twaalf vijfhoeken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd29c8d-73af-4031-bb74-06006d006f8d",
                                                "sense_id": "14bbec17-21f9-3c5d-bfce-fd468efbb6f5",
                                                "text": "Het is niet ongebruikelijk dat een chemisch complex de vorm van een dodecaëder aanneemt."
                                            }
