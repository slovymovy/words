                ],
                "translations": [
                    {
                        "translation_id": "07a42e8e-d5f7-4965-a485-1d35634b4a7f",
                        "source_entry_id": "498317bf-3145-3d18-9d4d-f14091d49ac7",
                        "source_sense_id": "88d05aa3-2d4d-392e-bf6b-8fda7085f9aa",
                        "target_lang_word": "hurdle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurdle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6f40d5-e66c-33eb-acb3-8d67512992ff",
                                        "entry_id": "6929e5b8-fb9b-3fe2-b234-7f3b8506b2e7",
                                        "glosses": [
                                            "An artificial barrier, variously constructed, over which athletes or horses jump in a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b09af04-f057-4540-bb42-ff7c00971a9b",
                                                "sense_id": "fb6f40d5-e66c-33eb-acb3-8d67512992ff",
                                                "text": "He ran in the 100 metres hurdles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23553ce6-e0b5-3622-9a97-c03fe6fddae5",
                                        "entry_id": "6929e5b8-fb9b-3fe2-b234-7f3b8506b2e7",
                                        "glosses": [
                                            "An obstacle, real or perceived, physical or abstract."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e85c77-27b6-4623-9e70-a5f351f32e44",
                                                "sense_id": "23553ce6-e0b5-3622-9a97-c03fe6fddae5",
                                                "text": "My last stop was an outdoor speech to a huge crowd of Ukrainians whom I urged to stay on the course of freedom and economic reform. Kiev was beautiful in the late spring sunshine, and I hoped its people could keep up the high spirits I had observed in the crowd. They still had many hurdles to clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992e3d30-6e91-3fb1-923f-f2f9f6bb9158",
                                        "entry_id": "6929e5b8-fb9b-3fe2-b234-7f3b8506b2e7",
                                        "glosses": [
                                            "A movable frame of wattled twigs, osiers, or withes and stakes, or sometimes of iron, used for enclosing land, for folding sheep and cattle, for gates, etc.; also, in fortification, used as revetments, and for other purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b23594e9-7678-40c1-bacd-5273a4b29a49",
                                                "sense_id": "992e3d30-6e91-3fb1-923f-f2f9f6bb9158",
                                                "text": "The practice of folding sheep was general, and the purchase of hurdles was a regular charge in the shepherd's account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d006b34-d831-3bf7-8415-3948457955b0",
                                        "entry_id": "6929e5b8-fb9b-3fe2-b234-7f3b8506b2e7",
                                        "glosses": [
                                            "A sled or crate on which criminals were drawn to the place of execution."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ec8e375-6267-4472-967a-c428bb420129",
                                                "sense_id": "1d006b34-d831-3bf7-8415-3948457955b0",
                                                "text": "In treason, the corporal punishment is by drawing on hurdle from the place of the prison to the place of execution, and by hanging and being cut down alive, bowelling, and quartering: and in women by burning."
                                            },
                                            {
                                                "example_id": "a875b042-1a10-4ecf-b1ad-f45be02e7cd1",
                                                "sense_id": "1d006b34-d831-3bf7-8415-3948457955b0",
                                                "text": "Such a crew! Ah! many a wretch has rid on hurdles who has done less mischief than these utterers of forged Tales, coiners of Scandal, and clippers of Reputation."
                                            },
                                            {
                                                "example_id": "b9d6b5b5-6744-4f59-ae97-1e902b8296a1",
                                                "sense_id": "1d006b34-d831-3bf7-8415-3948457955b0",
                                                "text": "Hurdles, with four, five, six wretches convicted of counterfeiting or mutilating the money of the realm, were dragged month after month up Holborn Hill. On one morning seven men were hanged and a woman burned for clipping"
                                            },
                                            {
                                                "example_id": "68c55fd4-09ed-4796-88d6-5e83b42ceac9",
                                                "sense_id": "1d006b34-d831-3bf7-8415-3948457955b0",
                                                "text": "Behind flock'd wrangling up a piteous crew, / Greeted of none, disfeatur'd and forlorn— / Cowards, who were in sloughs interr'd alive: / And round them still the wattled hurdles hung / Wherewith they stamp'd them down, and trod them deep, / To hide their shameful memory from men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db26947-7640-3e3e-8f9b-8c85a377d219",
                                        "entry_id": "6929e5b8-fb9b-3fe2-b234-7f3b8506b2e7",
                                        "glosses": [
                                            "A piece that is jumped over by a hopper piece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c6ccd2-e193-4332-950e-f37943a4719e",
                                                "sense_id": "9db26947-7640-3e3e-8f9b-8c85a377d219",
                                                "text": "Pieces that can move only by hopping over other pieces are termed Hoppers. It should be noted that hoppers capture in the usual way by eviction, they do not capture the hurdles over which they hop.\nThe most popular hoppers are: The Equihopper (G. Leathem FCR 1938) which hops to the same distance beyond the hurdle as it is from it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hurdle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70be18c8-4013-3dd1-8652-4b3125807ac3",
                                        "entry_id": "adb13014-86aa-367d-81fa-1df2576d86ad",
                                        "glosses": [
                                            "To jump over something while running."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac8c770-9b78-448f-a5a9-7cef62469c02",
                                                "sense_id": "70be18c8-4013-3dd1-8652-4b3125807ac3",
                                                "text": "He hurdled the bench in his rush to get away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e3e715-e21a-3d72-a7be-9dabbed11cb0",
                                        "entry_id": "adb13014-86aa-367d-81fa-1df2576d86ad",
                                        "glosses": [
                                            "To compete in the track and field events of hurdles (e.g. high hurdles)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bd21d51-0989-34ee-af8f-5fab9f06bd8e",
                                        "entry_id": "adb13014-86aa-367d-81fa-1df2576d86ad",
                                        "glosses": [
                                            "To overcome an obstacle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a3f2a3c-799b-3dee-8d97-6a97f9938fda",
                                        "entry_id": "adb13014-86aa-367d-81fa-1df2576d86ad",
                                        "glosses": [
                                            "To hedge, cover, make, or enclose with hurdles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefd3c57-4ec2-43dc-9d26-17f5c460279e",
                                                "sense_id": "7a3f2a3c-799b-3dee-8d97-6a97f9938fda",
                                                "text": "Watching where shepherds pen their flocks at eve\nIn hurdled cotes amid the field secure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6833e05-feeb-3f63-a155-f10d81694cd8",
                                        "entry_id": "adb13014-86aa-367d-81fa-1df2576d86ad",
                                        "glosses": [
                                            "To jump over another piece without capturing it."
                                        ],
                                        "tags": [
                                            "of a hopper piece"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e68bc0e7-5b16-4e78-bf70-54fd9ad75277",
                                                "sense_id": "c6833e05-feeb-3f63-a155-f10d81694cd8",
                                                "text": "Kangaroo (KA): as G, but hurdles over any two units to land on the first square beyond the second unit (the two units need not be adjacent). […] Saltador (SA): can move without capturing to the same squares as an S, whenever either of the intermediate squares is occupied (by hurdling); can capture on the same squares as an S whenever either of the intermediate squares is empty."
                                            }
                                        ]
                                    }
                                ]
                            },
