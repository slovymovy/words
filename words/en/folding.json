                {
                    "sense_id": "f4f405c0-4dc3-34e4-a888-d54c86ac165e",
                    "sense_definition": "A source code display technique that can hide the contents of methods or classes for easier navigation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Code <w>folding</w> allows developers to focus on specific parts of the script.",
                            "target_lang_translations": {
                                "ru": "<w>Сворачивание</w> кода позволяет разработчикам сосредоточиться на конкретных частях скрипта.",
