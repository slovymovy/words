                                        "sense_id": "c2f3e46f-f172-3aee-a324-ad62f2f290ba",
                                        "entry_id": "e43c041d-29b2-3698-bb0a-af493ecbfdcf",
                                        "glosses": [
                                            "(Fabiana imbricata) Arbusto perenne de la familia de las solanáceas, nativo de Centro y Sudamérica, de hasta 2.5 m de altura, hojas pequeñas y flores blancas, tubulares, que aparecen a comienzos de verano; se emplea en medicina tradicional como diurético"
                                        ],
                                        "tags": [
                                            "Argentina",
                                            "Chile"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8bc0148-669e-4d45-affd-4c66f9a35693",
                                                "sense_id": "c2f3e46f-f172-3aee-a324-ad62f2f290ba",
                                                "text": "Un buen arbusto de aislar en los puntos más en vista del jardín es la Fabiana imbricata, de la Patagonia, llamado vulgarmente Pichi, Palo pichi. Es muy ramificado, con hojas aovadas, imbricadas, y flores blancas o blanco-violáceas, solitarias, terminales, de las que se cubre literalmente en primavera-verano."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
