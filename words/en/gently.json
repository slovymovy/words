    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ee2a41f7-907e-3052-8525-03b402ed0d4a",
                    "sense_definition": "In a soft or light manner, without using strong force or speed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "softness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>gently</w> stir the mixture so the ingredients do not break apart.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>осторожно</w> перемешивать смесь, чтобы ингредиенты не распались.",
                                "zh": "你应该<w>轻轻地</w>搅拌混合物，以免食材散开。",
                                "fr": "Vous devriez <w>doucement</w> mélanger la préparation pour que les ingrédients ne se cassent pas."
                            }
                        },
                        {
                            "text": "The nurse <w>gently</w> touched the patient's arm to comfort them during the procedure.",
                            "target_lang_translations": {
                                "ru": "Медсестра <w>нежно</w> коснулась руки пациента, чтобы успокоить его во время процедуры.",
                                "zh": "护士<w>温柔地</w>触碰了病人的手臂，以在治疗过程中安抚他们。",
                                "fr": "L'infirmière a <w>délicatement</w> touché le bras du patient pour le réconforter pendant l'intervention."
                            }
                        }
                    ],
                    "synonyms": [
                        "softly",
                        "lightly"
                    ],
                    "antonyms": [
                        "roughly"
                    ],
                    "common_phrases": [
                        "stir gently",
                        "touch gently",
                        "push gently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягко или легко, без применения большой силы или скорости.",
                        "zh": "以轻柔或轻微的方式，不使用强力或过快的速度。",
                        "fr": "D'une manière douce ou légère, sans utiliser une force excessive ou une vitesse rapide."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осторожно",
                                "target_lang_sense_clarification": "аккуратно, чтобы не повредить"
                            },
                            {
                                "target_lang_word": "нежно",
                                "target_lang_sense_clarification": "с лаской или очень мягко"
                            },
                            {
                                "target_lang_word": "аккуратно",
                                "target_lang_sense_clarification": "бережно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻轻地",
                                "target_lang_sense_clarification": "动作轻柔，不费力"
                            },
                            {
                                "target_lang_word": "温柔地",
                                "target_lang_sense_clarification": "带有感情色彩的轻柔"
                            },
                            {
                                "target_lang_word": "小心地",
                                "target_lang_sense_clarification": "谨慎、仔细地处理"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "doucement",
                                "target_lang_sense_clarification": "de manière tendre ou sans brusquerie"
                            },
                            {
                                "target_lang_word": "délicatement",
                                "target_lang_sense_clarification": "avec soin et précaution"
                            },
                            {
                                "target_lang_word": "avec précaution",
                                "target_lang_sense_clarification": "en faisant attention à ne pas abîmer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64d7ab71-8b3a-356a-b521-5c963fb5fbed",
                    "sense_definition": "To a moderate or mild degree; gradually rather than steeply or suddenly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gradualness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road leads through <w>gently</w> rolling hills and beautiful green farmlands.",
                            "target_lang_translations": {
                                "ru": "Дорога ведет через <w>пологие</w> холмы и красивые зеленые фермерские угодья.",
                                "zh": "这条路穿过<w>平缓的</w>丘陵和美丽的绿色农田。",
                                "fr": "La route traverse des collines <w>légèrement</w> vallonnées et de magnifiques terres agricoles verdoyantes."
                            }
                        },
                        {
                            "text": "The ground slopes <w>gently</w> down toward the river at the edge of the park.",
                            "target_lang_translations": {
                                "ru": "Земля <w>плавно</w> спускается к реке на краю парка.",
                                "zh": "地面在公园边缘向河流方向<w>平缓地</w>倾斜。",
                                "fr": "Le terrain descend <w>en pente douce</w> vers la rivière à la lisière du parc."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradually",
                        "mildly"
                    ],
                    "common_phrases": [
                        "gently rolling hills",
                        "slope gently"
                    ],
                    "target_lang_definitions": {
                        "ru": "В умеренной или легкой степени; постепенно, а не круто или внезапно.",
                        "zh": "程度适中或温和；逐渐地，而非陡峭或突然地。",
                        "fr": "À un degré modéré ou léger ; de manière graduelle plutôt que raide ou soudaine."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полого",
                                "target_lang_sense_clarification": "о склоне или спуске"
                            },
                            {
                                "target_lang_word": "плавно",
                                "target_lang_sense_clarification": "без резких переходов"
                            },
                            {
                                "target_lang_word": "постепенно",
                                "target_lang_sense_clarification": "незначительно нарастая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平缓地",
                                "target_lang_sense_clarification": "指坡度或地形不陡峭"
                            },
                            {
                                "target_lang_word": "逐渐地",
                                "target_lang_sense_clarification": "缓慢地发生变化"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "légèrement",
                                "target_lang_sense_clarification": "de façon peu marquée"
                            },
                            {
                                "target_lang_word": "en pente douce",
                                "target_lang_sense_clarification": "pour un terrain ou une inclinaison"
                            },
                            {
                                "target_lang_word": "progressivement",
                                "target_lang_sense_clarification": "de manière graduelle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d966c84a-13e4-328e-bb03-a5575124cf77",
                    "sense_definition": "In a quiet way, without making much noise or causing a disturbance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "softness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind blew <w>gently</w> through the trees, making a very peaceful sound.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>тихо</w> дул сквозь деревья, создавая очень мирный звук.",
                                "zh": "微风<w>轻轻地</w>吹过树林，发出非常宁静的声音。",
                                "fr": "Le vent soufflait <w>doucement</w> à travers les arbres, créant un son très paisible."
                            }
                        },
                        {
                            "text": "She closed the door <w>gently</w> so she would not wake the sleeping baby.",
                            "target_lang_translations": {
                                "ru": "Она <w>мягко</w> закрыла дверь, чтобы не разбудить спящего ребенка.",
                                "zh": "她<w>轻轻地</w>关上门，以免吵醒熟睡的婴儿。",
                                "fr": "Elle a fermé la porte <w>silencieusement</w> pour ne pas réveiller le bébé qui dormait."
                            }
                        }
                    ],
                    "synonyms": [
                        "quietly",
                        "peacefully"
                    ],
                    "common_phrases": [
                        "blow gently",
                        "weep gently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихо, не производя шума и не создавая беспокойства.",
                        "zh": "安静地，不制造噪音或引起干扰。",
                        "fr": "De manière calme, sans faire beaucoup de bruit ou causer de dérangement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихо",
                                "target_lang_sense_clarification": "без шума"
                            },
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "спокойно и легко"
                            },
                            {
                                "target_lang_word": "бесшумно",
                                "target_lang_sense_clarification": "почти не слышно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安静地",
                                "target_lang_sense_clarification": "没有声音或干扰"
                            },
                            {
                                "target_lang_word": "轻声地",
                                "target_lang_sense_clarification": "声音很小"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "doucement",
                                "target_lang_sense_clarification": "sans bruit ou sans brusquerie"
                            },
                            {
                                "target_lang_word": "silencieusement",
                                "target_lang_sense_clarification": "sans émettre de son"
                            },
                            {
                                "target_lang_word": "calmement",
                                "target_lang_sense_clarification": "de façon paisible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fe58991-9b3f-3ebc-bf06-f286c1acce3d",
                    "sense_definition": "In a polite, courteous, or noble manner, reflecting high social standing or good breeding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>gently</w> bred and always behaved with the utmost courtesy toward others.",
                            "target_lang_translations": {
                                "ru": "Он был <w>благородно</w> воспитан и всегда вел себя с предельной вежливостью по отношению к окружающим.",
                                "zh": "他出身<w>名门</w>，对他人总是表现得极其礼貌。",
                                "fr": "Il était <w>noblement</w> éduqué et se comportait toujours avec la plus grande courtoisie envers les autres."
                            }
                        },
                        {
                            "text": "The knight spoke <w>gently</w> to the queen, showing his noble upbringing.",
                            "target_lang_translations": {
                                "ru": "Рыцарь <w>учтиво</w> разговаривал с королевой, демонстрируя свое благородное воспитание.",
                                "zh": "骑士<w>文雅地</w>与女王交谈，展现了他高贵的教养。",
                                "fr": "Le chevalier s'est adressé <w>courtoisement</w> à la reine, démontrant sa noble éducation."
                            }
                        }
                    ],
                    "synonyms": [
                        "courteously",
                        "nobly",
                        "politely"
                    ],
                    "common_phrases": [
                        "gently born",
                        "gently bred"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливо, учтиво или благородно, отражая высокое социальное положение или хорошее воспитание.",
                        "zh": "以礼貌、客气或高贵的方式，体现出良好的教养或社会地位。",
                        "fr": "D'une manière polie, courtoise ou noble, reflétant un statut social élevé ou une bonne éducation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородно",
                                "target_lang_sense_clarification": "согласно правилам чести и воспитания"
                            },
                            {
                                "target_lang_word": "учтиво",
                                "target_lang_sense_clarification": "с изысканной вежливостью"
                            },
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "без грубости в манерах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文雅地",
                                "target_lang_sense_clarification": "举止有教养"
                            },
                            {
                                "target_lang_word": "有礼貌地",
                                "target_lang_sense_clarification": "表现出良好的社交礼仪"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avec distinction",
                                "target_lang_sense_clarification": "avec une élégance naturelle"
                            },
                            {
                                "target_lang_word": "courtoisement",
                                "target_lang_sense_clarification": "avec une politesse raffinée"
                            },
                            {
                                "target_lang_word": "noblement",
                                "target_lang_sense_clarification": "avec une dignité liée à l'éducation"
                            }
                        ]
