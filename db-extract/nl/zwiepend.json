                "senses": [
                    {
                        "sense_id": "f1867b88-6be3-365b-aaf9-953d93fbe7ff",
                        "entry_id": "2a019f38-f8c8-3f93-9632-5f8128a3c2a0",
                        "glosses": [
                            "ongecontroleerde zwaaiende bewegingen makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64aab00d-a887-4a30-aa2d-4b9336616ca3",
                                "sense_id": "f1867b88-6be3-365b-aaf9-953d93fbe7ff",
                                "text": "Dirk Hut, van oorsprong Groninger, stond beneden op het platform en kon het zwiepende gevaarte maar nét ontwijken. Daarbij kwam hij hard tussen afgebroken onderdelen van het reuzenrad terecht."
                            },
                            {
                                "example_id": "b8f06a93-19a8-4ffe-acf3-423be4cb5b15",
                                "sense_id": "f1867b88-6be3-365b-aaf9-953d93fbe7ff",
                                "text": "Zwiepende hoogspanningskabels leidden tot knipperende lampen in huizen. De stroomonderbrekingen werden veroorzaakt door een fenomeen dat 'lijndansen' heet."
                            },
                            {
                                "example_id": "e43c1963-bda3-4b87-885f-820b849bef38",
                                "sense_id": "f1867b88-6be3-365b-aaf9-953d93fbe7ff",
                                "text": "' Ze liet Rebecca's hand los en deed de zaak verder af met een zwiepend gebaar."
                            }
                        ]
                    }
