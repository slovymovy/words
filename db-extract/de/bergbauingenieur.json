                ],
                "senses": [
                    {
                        "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                        "entry_id": "910830d1-1f98-326a-ac27-d3e79e0ecb94",
                        "glosses": [
                            "Ingenieur beim Bergbau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32c2d3d-0b1c-4e5d-9c09-0afd3edda351",
                                "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                                "text": "Leibniz war ein Bergbauingenieur."
                            },
                            {
                                "example_id": "a26b54aa-d25e-4c13-98a1-3f44612fd353",
                                "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                                "text": "„Der BF1 hat im Jahr XXXX in seinem Heimatland die technische Universität als Bergbauingenieur abgeschlossen.“"
                            },
                            {
                                "example_id": "757e7934-556f-4e1f-b552-5e3194dbc394",
                                "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                                "text": "„Waren die Großväter noch als Hauer unter Tage, ist der Arbeitsplatz des hochqualifizierten Bergbauingenieurs mit Doktortitel eigentlich im Büro angesiedelt.“"
                            },
                            {
                                "example_id": "928b8b4b-cef5-4870-be6c-68a3f17e52b9",
                                "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                                "text": "„Der deutsche Bergbauingenieur weiss, wovon er spricht.“"
                            },
                            {
                                "example_id": "e2a711c8-81b9-4eb2-9a1d-9176dfaeaab5",
                                "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                                "text": "„Der Beschwerdeführer habe in der Ukraine acht Jahre die Grundschule besucht, dann vier Jahre die Berufsschule (Bergbauingenieur) und an der Technischen Universität in der Ukraine habe er eine fünfjährige Ausbildung zum Ingenieur für Elektronik absolviert.“"
                            },
                            {
                                "example_id": "a51fd6f4-2f27-4085-ba42-d80bae65afab",
                                "sense_id": "b1eef8e2-0019-36d8-aee9-874f7bf08701",
                                "text": "„Politisch aktiv war der Bergbauingenieur [Olaf Jung] seit 2004 zunächst in der WASG, dann in der fusionierten Partei DIE LINKE.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
