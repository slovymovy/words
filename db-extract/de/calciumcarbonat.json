                "translations": [
                    {
                        "translation_id": "944278bd-a681-496d-8af8-9367048a0dde",
                        "source_entry_id": "a41e38f6-81c2-323d-a3dc-956990263d1d",
                        "source_sense_id": "5eebbd59-e371-3132-ae4c-c52bf1824df4",
                        "source_sense_description": "Ionenverbindung aus einem Calcium-Kation und einem Carbon-Anion",
                        "target_lang_word": "calcium carbonate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calcium carbonate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "781aab3b-7b7f-33e7-a30f-dfce9bebf96b",
                                        "entry_id": "06079471-c600-327b-9272-881f76dfba2c",
                                        "glosses": [
                                            "A colourless or white inorganic compound, CaCO₃, occurring as chalk, limestone, marble etc. Reacts with acids to liberate carbon dioxide."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3992cec-0c28-4b0d-89b0-312903c30ebd",
                        "source_entry_id": "a41e38f6-81c2-323d-a3dc-956990263d1d",
                        "source_sense_id": "5eebbd59-e371-3132-ae4c-c52bf1824df4",
                        "source_sense_description": "Ionenverbindung aus einem Calcium-Kation und einem Carbon-Anion",
                        "target_lang_word": "carbonate de calcium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbonate de calcium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f72b5ea-4d27-3a61-a801-822fc273c8d6",
                                        "entry_id": "e8d92361-5624-3a2e-8152-96f33dcd81fa",
                                        "glosses": [
                                            "Composé ionique formé par la combinaison d’un ion carbonate (CO₃²⁻) avec un ion calcium (Ca²⁺)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0818dbd-9744-4216-b680-345452cc44e4",
                                                "sense_id": "3f72b5ea-4d27-3a61-a801-822fc273c8d6",
                                                "text": "L’ouverture e sert pour le nettoyage de l'appareil à déchauler, notamment pour enlever le carbonate de calcium séparé."
                                            },
                                            {
                                                "example_id": "23c99ce6-48f2-4f05-8bbc-18e0f234bebd",
                                                "sense_id": "3f72b5ea-4d27-3a61-a801-822fc273c8d6",
                                                "text": "L’apatite, qui constitue le tissu minéralisé des vertébrés, est un minéral plus résistant aux processus de diagenèse, car elle est beaucoup moins soluble que les carbonates de calcium."
                                            },
                                            {
                                                "example_id": "7ec205a3-3ec4-444f-91ad-9d70d71ecf0a",
                                                "sense_id": "3f72b5ea-4d27-3a61-a801-822fc273c8d6",
                                                "text": "Vous connaissez le carbonate de calcium ? C’est le composant principal de la craie. Sans le carbonate, tu peux rien faire. La technologie moderne, le high-tech en réclame toujours plus. Indispensable pour le verre optique, le béton, l’asphalte, le caoutchouc, les détergents, les lubrifiants, les cosmétiques, la peinture, le mastic… et j’en passe !"
                                            },
                                            {
                                                "example_id": "95f287b6-b93d-449b-8873-d65c4ab8b640",
                                                "sense_id": "3f72b5ea-4d27-3a61-a801-822fc273c8d6",
                                                "text": "Le calcium est véhiculé par le sang jusqu'à la glande nidamentaire (dite aussi coquillière). Là, le carbonate de calcium quitte le sang et se dépose en couches sur l'œuf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
