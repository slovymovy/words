                "senses": [
                    {
                        "sense_id": "71d644f0-5c2b-3169-9381-0ca15edd09ed",
                        "entry_id": "9e1d1f05-033b-37cf-a06d-5fc9530c3574",
                        "glosses": [
                            "Donner un caractère haïtien à quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b055b43-b031-4005-9e69-9336505bb6b4",
                                "sense_id": "71d644f0-5c2b-3169-9381-0ca15edd09ed",
                                "text": "Son Dessalines s’efforce d’haïtianiser ceux de son peuple qui viennent d’Afrique."
                            },
                            {
                                "example_id": "930e66ad-ef78-4ae8-9540-6021c3be3b5e",
                                "sense_id": "71d644f0-5c2b-3169-9381-0ca15edd09ed",
                                "text": "Mais une chose est sûre, il faut rester loin de cette tendance qui veut « haïtianiser » l'après-Collat"
                            },
                            {
                                "example_id": "c94ff8b6-222d-4d65-b31c-88abe22d55e1",
                                "sense_id": "71d644f0-5c2b-3169-9381-0ca15edd09ed",
                                "text": "La loi minière permet de réviser les clauses d'une concession, a-t-il dit, assurant que la loi fait obligation à une firme de « s'haïtianiser », de fonctionner sous l'égide du droit haïtien avec un actionnariat ouvert à des étrangers pour avoir un permis de recherche."
                            }
                        ]
                    }
