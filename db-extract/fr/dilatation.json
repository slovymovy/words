                                        "sense_id": "c28c6d08-34ca-34b2-a643-026c1e967ca4",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "Ellipsis of expansion pack."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "An increase in the market value of an economy over time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f162068-143b-4d54-923d-7cc401afc3cd",
                                                "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                                                "text": "Secondly, the cyclical expansion now taking shape in the United States is starting from a relatively high level; it has much less headroom than earlier expansions that began from a deeply deflated recession base."
                                            },
                                            {
                                                "example_id": "d0668d91-cf74-483a-899a-c885f58a2629",
                                                "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                                                "text": "In addition, new technologies are adopted which are less labour-using, thus unemploying workers. Over the postwar years, factors of this sort have contributed to a gradual upward drift in unemployment rates, even during expansions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0e1f61-1c0b-3beb-b7fa-76d0f7332dc7",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
