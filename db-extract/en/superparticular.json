                "forms": [],
                "senses": [
                    {
                        "sense_id": "463456bf-5ec3-37d3-ba44-add9176d7411",
                        "entry_id": "ad5e7359-0e0a-3cc7-9395-ace788c64f2c",
                        "glosses": [
                            "Of a natural number, being larger than another natural number by a unit fraction of that smaller number."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "74f19249-53f6-4fe6-b994-99ba28bba65f",
                                "sense_id": "463456bf-5ec3-37d3-ba44-add9176d7411",
                                "text": "'Tis superparticular, sesquialtera, sesquitertia […] all those geometric proportions are too little to express it."
                            },
                            {
                                "example_id": "4b10fa39-4c10-4b9a-a1a0-430fb60e9119",
                                "sense_id": "463456bf-5ec3-37d3-ba44-add9176d7411",
                                "text": "When a number contains the whole of another in itself, and some part of it besides, it is called superparticular. And if the part of the less it contains is the half, it is called sesquialter; if the third part, sesquitertian; if the fourth, sesquiquartan; if the fifth, sesquiquintan. And the like names being employed to infinity, the form of superparticular numbers will also proceed infinitely."
                            }
                        ]
                    },
                    {
                        "sense_id": "0276bcc1-21d0-3f6d-b9ce-61d75225ab58",
                        "entry_id": "ad5e7359-0e0a-3cc7-9395-ace788c64f2c",
                        "glosses": [
                            "Pertaining to a ratio of any whole number to the next below it (e.g. tfrac 3 2, tfrac 8 7, etc.)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
