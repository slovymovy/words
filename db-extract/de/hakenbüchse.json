                        "sense_id": "961d544e-9cda-3868-b618-7231f36fdb39",
                        "entry_id": "a55b4633-a47c-362c-a751-06df37568971",
                        "glosses": [
                            "Vorderlader des 15. und 16. Jahrhundert mit Luntenschloss"
                        ],
                        "tags": [
                            "Waffenkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "3e253118-d751-4262-a75c-8eecb207d187",
                                "sense_id": "961d544e-9cda-3868-b618-7231f36fdb39",
                                "text": "„Vor einem guten Stoß mit einem solchen Spieß schützt der Harnisch übrigens nur zum Teil und vor Armbrustpfeilen und Kugeln aus Hakenbüchsen nur dann, wenn sie aus größerer Entfernung kommen und sich ihre Durchschlagskraft vermindert hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
