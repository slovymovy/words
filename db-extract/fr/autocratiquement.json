        "fr-extract.jsonl": [
            {
                "entry_id": "56c00203-df83-3870-9176-5ffbd98fad4f",
                "word": "autocratiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ca4cb05-5e9b-350e-a6ca-a37aed5481f3",
                        "entry_id": "56c00203-df83-3870-9176-5ffbd98fad4f",
                        "glosses": [
                            "D’une façon autocratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8950f76-d6a6-44e5-835b-346669fadf43",
                                "sense_id": "6ca4cb05-5e9b-350e-a6ca-a37aed5481f3",
                                "text": "Depuis ce moment, l’Église russe, schismatique dans le schisme oriental, est gouvernée par un synode, où le czar commande aussi autocratiquement que dans une caserne."
                            },
                            {
                                "example_id": "0edd7ae5-6d37-45dd-961a-ec6ce1663bdf",
                                "sense_id": "6ca4cb05-5e9b-350e-a6ca-a37aed5481f3",
                                "text": "Derrière leurs murailles crénelées, défendues encore par un fossé profond, ils régnaient autocratiquement et avaient droit de basse, moyenne et haute justice."
                            },
                            {
                                "example_id": "5d64d43d-6a94-4124-ae8f-d503b8168541",
                                "sense_id": "6ca4cb05-5e9b-350e-a6ca-a37aed5481f3",
                                "text": "Le héros de l’histoire est un capitaine russe, c’est-à-dire un gradé d’une armée puissante, dans un pays gouverné autocratiquement, où le knout est d’institution constante, où les suspects ne demeurent point libres."
                            }
                        ]
                    }
                ],
