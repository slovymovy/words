                                "sense_id": "9462cf98-b4f7-36a0-bca8-bd1ed6bece72",
                                "text": "Yves Betiso, adjoint à la culture, s’y caféinait en compagnie de Christine Saubiette, adjointe à la fibre sociale."
                            },
                            {
                                "example_id": "48eaa914-b848-46f1-b7a7-7dc3b2f4fecf",
                                "sense_id": "9462cf98-b4f7-36a0-bca8-bd1ed6bece72",
                                "text": "Et si la musique vous fatigue, vous aurez la possibilité de vous « caféiner » au coffee spot pour vous revitaliser."
                            }
                        ]
                    }
