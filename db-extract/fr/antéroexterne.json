                        "sense_id": "5b64119d-cfef-3798-9c2a-c13bce6558bb",
                        "entry_id": "1aa92e6d-6db4-32d1-9fdb-030ee5d879d1",
                        "glosses": [
                            "Situé dans la partie avant du corps, côté extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a15d2f-303a-49fd-b54d-c88b732c17f7",
                                "sense_id": "5b64119d-cfef-3798-9c2a-c13bce6558bb",
                                "text": "LA POLYNÉVRITE se traduit par une paralysie flasque, bilatérale, prédominant aux muscles antéroexternes de la jambe."
                            },
                            {
                                "example_id": "2634a634-4156-4c11-ad92-458a7b7f0a01",
                                "sense_id": "5b64119d-cfef-3798-9c2a-c13bce6558bb",
                                "text": "La faiblesse musculaire, en particulier des loges antéroexternes des jambes, se traduisant par un steppage."
                            },
                            {
                                "example_id": "7c2ab27c-d889-4015-80f1-e8bba00db560",
                                "sense_id": "5b64119d-cfef-3798-9c2a-c13bce6558bb",
                                "text": "Alors la douleur siège à la fesse, à la face postéroexterne de la cuissen à la face antéroexterne de la jambe, au cou-de-pied, en avant de la malléole externe, sur le dos du pied en direction du gros orteil."
                            }
                        ]
                    }
