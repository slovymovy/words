                        "glosses": [
                            "прост. быстро сбегать, сходить, съездить куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c963e96b-7441-4362-8dea-0282b8d70043",
                                "sense_id": "e706e6d6-0f25-39ba-bcfa-f6ed792cb503",
                                "text": "Илья успел смахать в город за доктором."
                            },
                            {
                                "example_id": "9ee977a0-37ef-408f-9a7a-b9def30dffb2",
                                "sense_id": "e706e6d6-0f25-39ba-bcfa-f6ed792cb503",
                                "text": "― Да ты, дядя жиган, про Сибирь расскажи, потому, ― не ровно кому туды в гости на побывку смахать придется, ― так чтобы, по крайности, знатье было, ― заметил кто-то из слушателей"
                            }
                        ]
                    }
