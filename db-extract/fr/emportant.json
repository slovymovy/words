                "senses": [
                    {
                        "sense_id": "1b9db3c1-194c-3f4d-b9ec-c2d31f129144",
                        "entry_id": "f262f5fe-126a-391e-9df2-abc6ace093a8",
                        "glosses": [
                            "Qui emporte, qui entraîne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fe940e-4794-44fe-b2c0-27aa42612559",
                                "sense_id": "1b9db3c1-194c-3f4d-b9ec-c2d31f129144",
                                "text": "Dans sa vacuité même, son dépouillement et sa règle sévère, elle semblait appeler et mériter la récompense d’un émoi plus emportant que tout ce que la vie de fêtes d’Orsenna m’avait offert de médiocre et de raffiné."
                            },
                            {
                                "example_id": "9d1fc2c7-b9dd-4633-94c1-98a91e0aae83",
                                "sense_id": "1b9db3c1-194c-3f4d-b9ec-c2d31f129144",
                                "text": "La manière emportante qu’a Mme Guilloux d’expliquer Iphigénie nous fait presque comprendre qu’on puisse sacrifier une fille pour du vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "a636b0ec-6bcd-3d1b-abaf-66d65b3cb889",
                        "entry_id": "f262f5fe-126a-391e-9df2-abc6ace093a8",
                        "glosses": [
                            "Qui est emporté, sujet à la colère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8ed62c-0208-4f59-baa5-75ff5e31f749",
                                "sense_id": "a636b0ec-6bcd-3d1b-abaf-66d65b3cb889",
                                "text": "D'un caractère très emportant, il s'emballait à fond quand nous n'étions pas sages ou quand nous répondions de travers à ses questions : — Sac à papier ! jurait-il. Voleur de grain !"
                            }
                        ]
                    }
