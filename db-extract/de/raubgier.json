                "senses": [
                    {
                        "sense_id": "84a9126f-ca63-3fd9-a2c0-ea97962945a4",
                        "entry_id": "3e2ef165-6d66-37f5-aaf8-a9186e4599ed",
                        "glosses": [
                            "Gier danach, anderen etwas zu rauben, sich durch Rauben zu bereichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3441dbd-cdcd-4929-9339-48c39de39a36",
                                "sense_id": "84a9126f-ca63-3fd9-a2c0-ea97962945a4",
                                "text": "„Die Europäer vernichteten aus Raubgier oder Unverstand die Grundlagen für alles, was die Eingeborenen dächten, fühlten und glaubten.“"
                            },
                            {
                                "example_id": "25c4a645-6ffb-49bf-b1de-5972ce315f49",
                                "sense_id": "84a9126f-ca63-3fd9-a2c0-ea97962945a4",
                                "text": "„Die übrigen drei lagen da wie Hunde und wärmten sich in der Sonne, plumpe Formen von primitiver Raubgier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d6fda6c-7880-4e2e-b1ef-a969d4aa76cd",
                        "source_entry_id": "3e2ef165-6d66-37f5-aaf8-a9186e4599ed",
                        "source_sense_id": "84a9126f-ca63-3fd9-a2c0-ea97962945a4",
                        "source_sense_description": "Gier danach, anderen etwas zu rauben, sich durch Rauben zu bereichern",
                        "target_lang_word": "rapacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c14c969d-ba93-340b-9f60-c676ed6bf4e9",
                                        "entry_id": "a97d5a8d-edfe-3a7d-876e-0f7839c5ba48",
                                        "glosses": [
                                            "The quality of being rapacious; voracity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf87b93-e3b1-4a3e-8cc1-c7c62d36d2ec",
                                                "sense_id": "c14c969d-ba93-340b-9f60-c676ed6bf4e9",
                                                "text": "Animals of the hare kind, like all others that feed entirely upon vegetables, are inoffenſive and timorous. As Nature furniſhes them vvith a moſt abundant ſupply, they have not that rapacity after food remarkable in ſuch as are often ſtinted in their proviſion."
                                            },
                                            {
                                                "example_id": "5accfb61-d25b-442e-8288-082868a758d4",
                                                "sense_id": "c14c969d-ba93-340b-9f60-c676ed6bf4e9",
                                                "text": "A taint of imbecile rapacity blew through it all, like a whiff from some corpse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e62429e8-b647-47eb-bbab-94644d5b9caa",
                        "source_entry_id": "3e2ef165-6d66-37f5-aaf8-a9186e4599ed",
                        "source_sense_id": "84a9126f-ca63-3fd9-a2c0-ea97962945a4",
                        "source_sense_description": "Gier danach, anderen etwas zu rauben, sich durch Rauben zu bereichern",
                        "target_lang_word": "rapacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2cfcb9-70dc-31ba-b8b4-a61e094bbbd5",
                                        "entry_id": "6ab3c826-fdd5-33ae-b930-8e885a247f01",
                                        "glosses": [
                                            "Avidité avec laquelle l’animal se jette sur sa proie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb0540a-4ed6-4e21-bb5a-5599b1c392a3",
                                                "sense_id": "cb2cfcb9-70dc-31ba-b8b4-a61e094bbbd5",
                                                "text": "La rapacité d’un oiseau de proie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2683fbf7-431f-3e56-88ce-a1df73e98316",
                                        "entry_id": "6ab3c826-fdd5-33ae-b930-8e885a247f01",
                                        "glosses": [
                                            "Avidité pour s’emparer du bien d’autrui."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "635b6cea-9c5c-42a4-a855-e233a641957a",
                                                "sense_id": "2683fbf7-431f-3e56-88ce-a1df73e98316",
                                                "text": "La rapacité de la loi sur les portes et fenêtres expire ’'sub dio’'."
                                            },
                                            {
                                                "example_id": "d88db648-ae3f-48e5-b1cd-8f19134d9f8e",
                                                "sense_id": "2683fbf7-431f-3e56-88ce-a1df73e98316",
                                                "text": "La Compagnie faisait donc sagement en allant exploiter plus au nord des territoires nouveaux, qui eussent encore échappé à la rapacité de l'homme."
                                            },
                                            {
                                                "example_id": "a4d3336c-d587-466e-9053-86b0944f37c6",
                                                "sense_id": "2683fbf7-431f-3e56-88ce-a1df73e98316",
                                                "text": "Cependant le ferment qui a produit l’insurrection dans le Nord existe également dans le Sud : l’exaspération créée par la rapacité des Glaoua qui règnent aujourd'hui en maîtres incontestés sur le Maroc méridional."
                                            },
                                            {
                                                "example_id": "cbd3064f-d8b8-489a-95b9-ac8da4737fd0",
                                                "sense_id": "2683fbf7-431f-3e56-88ce-a1df73e98316",
                                                "text": "Cerise sur le gâteau, les soldes venaient de lui être confiées. Les budgets étaient colossaux et il y puisait avec constance et rapacité pour redistribuer une grande partie aux gradés qui vivaient sur la bête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
