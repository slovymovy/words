                ],
                "senses": [
                    {
                        "sense_id": "ca5d7c68-8257-3467-ad60-fe54a4743564",
                        "entry_id": "5b6ae49e-5ff8-35f0-81f8-5e6506043d45",
                        "glosses": [
                            "Donner les caractéristiques du tiers-monde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa370d3-96a5-4c3a-bc71-40a44d6529fb",
                                "sense_id": "ca5d7c68-8257-3467-ad60-fe54a4743564",
                                "text": "Certains d’entre eux qui se reconnaîtront dans la description du colonisé humilié, vont « politiser » et « tiers-mondiser » leur regard sur leur situation d’humiliés."
                            },
                            {
                                "example_id": "6fbd3f85-a7ee-4864-83b4-4ea702714d48",
                                "sense_id": "ca5d7c68-8257-3467-ad60-fe54a4743564",
                                "text": "Tant que les Argentins auront peur de leur propre Etat, peur de sa violence potentielle, de ses violations du droit, de son mépris pour l'épargne et la propriété, les capitaux continueront de fuir, et l'Argentine de se « tiers-mondiser »."
                            }
                        ]
                    }
