                "senses": [
                    {
                        "sense_id": "302da3bc-1765-3db8-97d8-aa4545123cb0",
                        "entry_id": "fd9623ed-ff71-3afd-bc48-283dc6d0f0e1",
                        "glosses": [
                            "to sniff out; to get wind of (to hear about; to learn of, especially with respect to facts intended to have been kept confidential or secret)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d185e3f9-cea3-4868-8afe-f179bf652284",
                                "sense_id": "302da3bc-1765-3db8-97d8-aa4545123cb0",
                                "text": "— Ну, а тепе́рь ты иди́ уставля́й угоще́ние, а я за дья́конами пое́ду. Они́ проси́ли, чтоб в су́мерки, — потому́ что наш наро́д, говоря́т, ше́льма: всё проню́хает.",
                                "translation": "“Well, and now you go and set out some refreshments, and I’ll fetch the deacons. They asked to do it in the evening—‘because,’ they say, ‘our people are rascals, they may get wind of it.’ ”",
                                "english": "“Well, and now you go and set out some refreshments, and I’ll fetch the deacons. They asked to do it in the evening—‘because,’ they say, ‘our people are rascals, they may get wind of it.’ ”"
                            }
                        ]
                    }
                ],
