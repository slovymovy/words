                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e971d5-3da7-4ac4-be22-ab9075712f1d",
                                "sense_id": "e9e09e6a-da27-3c30-831f-4a809a103db7",
                                "text": "Treffen wir uns am Donnerstagnachmittag auf dem Marktplatz.",
                                "translation": "Retrouvons nous jeudi après-midi sur la place du marché."
                            },
                            {
                                "example_id": "8503bb41-3688-4a98-b715-650fcc79164e",
                                "sense_id": "e9e09e6a-da27-3c30-831f-4a809a103db7",
                                "text": "Robert Hoffmeister, Nienburger Bürgermeister, Verlagsdirektor der »Hannoverschen Presse« und SPD-Fraktionsvorsitzender, brachte am Donnerstagnachmittag im Niedersachsen-Landtag den Fall Gereke zur Diskussion."
                            }
                        ]
                    }
