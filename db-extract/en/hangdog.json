    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "df95595b-f214-3154-b652-b658592722c0",
                "word": "hangdog",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7ea5fa9-dffc-3686-a63f-6853e77a3ede",
                        "entry_id": "df95595b-f214-3154-b652-b658592722c0",
                        "glosses": [
                            "Low; sneaking; ashamed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e536bff7-24cf-4424-bdd9-fbc1aabfe4c2",
                                "sense_id": "b7ea5fa9-dffc-3686-a63f-6853e77a3ede",
                                "text": "The poor colonel went out of the room with a hangdog look."
                            },
                            {
                                "example_id": "5fced581-8ca7-4019-8e0c-60a7e0b560dc",
                                "sense_id": "b7ea5fa9-dffc-3686-a63f-6853e77a3ede",
                                "text": "Asper Argo, the Well-Beloved, Commdor of the Korellian Republic greeted his wife’s entry by a hangdog lowering of his scanty eyebrows. To her at least, his self-adopted epithet did not apply. Even he knew that."
                            },
                            {
                                "example_id": "479e0ce8-ab0c-48a8-a388-e96d8441894b",
                                "sense_id": "b7ea5fa9-dffc-3686-a63f-6853e77a3ede",
                                "text": "He looked at them in a kind of dread, not daring to ask for details; and he observed that they, too, looked as though they had been in a battle; something hangdog in their looks suggested that they had been put to flight."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0b3dfef-5a79-4d97-bed5-1f97c8f35d4f",
                        "source_entry_id": "df95595b-f214-3154-b652-b658592722c0",
                        "source_sense_id": "b7ea5fa9-dffc-3686-a63f-6853e77a3ede",
