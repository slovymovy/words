                                "target_senses": [
                                    {
                                        "sense_id": "9cefeef8-3a95-338c-811f-6d8b6aa04516",
                                        "entry_id": "d7b6eca3-337e-3ed1-84bc-f30695ceb878",
                                        "glosses": [
                                            "Occurring once every quarter year (three months); taking place quarter-yearly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb047574-d5c9-4c65-88d0-1dde17ad953b",
                                                "sense_id": "9cefeef8-3a95-338c-811f-6d8b6aa04516",
                                                "text": "quarterly rent payments"
                                            },
                                            {
                                                "example_id": "04299009-04e9-45bf-8a39-7cbed7c10d44",
                                                "sense_id": "9cefeef8-3a95-338c-811f-6d8b6aa04516",
                                                "text": "The FBI began publishing national quarterly crime reports last year, but has not done so for the first two quarters of 2021, stating that they require at least 60% of agencies to submit NIBRS data in order to publish quarterly data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efec621c-441f-3ec2-b998-863db9f7a840",
                                        "entry_id": "d7b6eca3-337e-3ed1-84bc-f30695ceb878",
                                        "glosses": [
                                            "(of a coat of arms) Divided into four parts crosswise."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc089d1f-f9ee-4cd7-8329-2ce8e3902f47",
                                                "sense_id": "efec621c-441f-3ec2-b998-863db9f7a840",
                                                "text": "The arms of Hohenzollern is quarterly argent and sable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarterly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424f9259-c8cb-3ca7-a026-07bd8846d3ba",
                                        "entry_id": "9ab4b251-ad4b-3939-875b-c6e7f97067f2",
                                        "glosses": [
                                            "A periodical publication that appears four times per year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f20744-89ec-4dde-8a02-11136833d482",
                                                "sense_id": "424f9259-c8cb-3ca7-a026-07bd8846d3ba",
                                                "text": "“We’re hoping (that) getting the message out in the quarterlies is going to teach people, as well as their supervisors … you can’t do this stuff,” FBI assistant director Candice Will told CNN this week."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarterly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eba91ccb-c748-30fb-bab3-11643ee9af75",
                                        "entry_id": "6c1e1d73-91e2-345a-b0d6-27b5b279c95d",
                                        "glosses": [
                                            "Once every quarter year (three months)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc3f26d0-7957-3ed0-a3ab-327276fed768",
                                        "entry_id": "6c1e1d73-91e2-345a-b0d6-27b5b279c95d",
                                        "glosses": [
                                            "In the four, or in two diagonally opposite, quarters of a shield."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8b1af4-715f-4d51-9f6b-1f783cbe6b40",
                                                "sense_id": "cc3f26d0-7957-3ed0-a3ab-327276fed768",
                                                "text": "It consisted of the arms of the City of London, Middlesex (three seaxes, or Saxon swords), Buckingham (a swan), and Hertford (a hart), arranged quarterly, on a background of crimson and ermine mantling […]."
                                            },
                                            {
                                                "example_id": "f0e3e594-fb3b-4f1d-8dbd-a7ead614bac7",
                                                "sense_id": "cc3f26d0-7957-3ed0-a3ab-327276fed768",
                                                "text": "Within a blue garter inscribed \"Great Northern Railway Ireland\" is a shield, on which are marshalled the arms of the principal towns in the company's area. The shield is divided quarterly with the arms of Dublin in the first quarter, Londonderry in the second quarter, Enniskillen in the third, and Belfast in the fourth; and overall is a gold inescutcheon (a small shield placed in the centre of the large shield) charged with the red left hand of Ulster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
