            {
                "entry_id": "b57da6ca-eb3f-3bdc-a2ff-737ad625df54",
                "word": "lutein",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "98dbc3ba-d703-4ba4-aa17-36a85af0b4bf",
                        "entry_id": "b57da6ca-eb3f-3bdc-a2ff-737ad625df54",
                        "tags": [
                            "plural"
                        ],
                        "form": "luteins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03773841-8dd1-353b-bda4-0df3f8d31c33",
                        "entry_id": "b57da6ca-eb3f-3bdc-a2ff-737ad625df54",
                        "glosses": [
                            "A yellow carotenoid pigment, widely distributed in both plants and animals."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c651d4e-290a-43f7-aa89-cbeec0b5c156",
                        "source_entry_id": "b57da6ca-eb3f-3bdc-a2ff-737ad625df54",
                        "source_sense_id": "03773841-8dd1-353b-bda4-0df3f8d31c33",
                        "source_sense_description": "yellow carotenoid pigment",
                        "target_lang_word": "lutéine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lutéine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86df1d66-2182-3ce7-97ac-44860d27125e",
                                        "entry_id": "f34ba408-92db-397b-b518-ae2b9ba98490",
                                        "glosses": [
                                            "Pigment caroténoïde, xanthophylle, antioxydant, que l’on trouve dans le jaune d’œuf, le beurre, le maïs, la carotte, le sérum sanguin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cedef10-e5ed-4093-bf52-76785c17dec9",
                                                "sense_id": "86df1d66-2182-3ce7-97ac-44860d27125e",
                                                "text": "Lutéine et zéaxanthine, deux pigments présents dans les yeux et dans les choux, les épinards, le céleri, la citrouille, le maïs, les olives vertes… ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d0e0247-00c9-358a-ad9e-b677b1aebb16",
                                        "entry_id": "f34ba408-92db-397b-b518-ae2b9ba98490",
                                        "glosses": [
                                            "Hormone sécrétée par le corps jaune de l’ovaire des mammifères qui modifie le tractus génital afin de le rendre apte à la nidation et conditionne la gestation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6027bf37-bd6d-4ec4-a142-2d037e623f8d",
                                                "sense_id": "5d0e0247-00c9-358a-ad9e-b677b1aebb16",
                                                "text": "Au cas où l’œuf est fécondé, le corps jaune ne dégénère pas et continue à sécréter de la lutéine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3866cea-4635-4514-88e4-224f1b4c4b91",
                        "source_entry_id": "b57da6ca-eb3f-3bdc-a2ff-737ad625df54",
                        "source_sense_id": "03773841-8dd1-353b-bda4-0df3f8d31c33",
                        "source_sense_description": "yellow carotenoid pigment",
                        "target_lang_word": "Lutein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lutein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6def0b-0047-3cb3-8bc6-bf4003f3249d",
                                        "entry_id": "cc2ebb27-5ffd-3e3d-8245-01462efef818",
                                        "glosses": [
                                            "gelber, lipophiler (fettlöslicher) Farbstoff, der unter anderem in grünen Pflanzen, im Getreide und im Eidotter vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d48aaf-2389-415f-8867-050cc3dda8eb",
                                                "sense_id": "1c6def0b-0047-3cb3-8bc6-bf4003f3249d",
                                                "text": "Lutein wird als einer von der EU zugelassener Lebensmittelfarbstoff eingesetzt."
                                            },
                                            {
                                                "example_id": "a01870c9-a018-438b-9e65-431e91752732",
                                                "sense_id": "1c6def0b-0047-3cb3-8bc6-bf4003f3249d",
                                                "text": "Wegen des Vorkommens von Lutein in der Netzhaut des Auges und besonders im Gelben Fleck (Macula lutea) wird Lutein Nahrungsmittelergänzungen als möglicher Wirkstoff gegen die Makuladegeneration zugegeben."
                                            },
                                            {
                                                "example_id": "eaaf72ff-cce7-4280-9145-d16835c2bd91",
                                                "sense_id": "1c6def0b-0047-3cb3-8bc6-bf4003f3249d",
                                                "text": "Lutein wird industriell mittels Extraktion aus Tagetes, Luzerne, Gras und Nesseln gewonnen."
                                            },
                                            {
                                                "example_id": "a7b18b01-234d-4633-ad10-fd00a14943c3",
                                                "sense_id": "1c6def0b-0047-3cb3-8bc6-bf4003f3249d",
                                                "text": "„Die neuen Stars auf dem Teller tragen Namen wie Sulphoraphan, Fisetin, Lutein oder Capsaicin. Sie fangen Radikale ein, stoppen Zellgifte, manipulieren biochemische Prozesse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
