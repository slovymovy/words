                                                "example_id": "f6d9c0ff-e384-4eec-9f56-7af0fd03e059",
                                                "sense_id": "487e0df1-4ccf-3045-acb8-ba6342d138d1",
                                                "text": "Po pracy zawsze śmierdzę rybami i tłuszczem."
