                "senses": [
                    {
                        "sense_id": "2d244924-1838-30a2-b620-f9214a457d54",
                        "entry_id": "9abe6a28-fcbc-3c11-82b4-09364dadde68",
                        "glosses": [
                            "Zusammenschluss mehrerer Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4e66f5-5251-48d0-8e1c-ffa789c7897b",
                                "sense_id": "2d244924-1838-30a2-b620-f9214a457d54",
                                "text": "„Deutschland setzt seinen Einfluss in den maßgeblichen internationalen und supranationalen Organisationen […] ein, um Kohärenz und Handlungsfähigkeit der Staatengemeinschaft zu verbessern.“"
                            },
                            {
                                "example_id": "2b654612-7e95-4cc1-a29d-0411cd6e03f7",
                                "sense_id": "2d244924-1838-30a2-b620-f9214a457d54",
                                "text": "„Ein erstaunlicher Wandel hat sich vollzogen: Ein schuldiges, verachtetes Täterland ist zu einem verantwortungsbewussten Führungsstaat in einer Staatengemeinschaft geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
