                "senses": [
                    {
                        "sense_id": "c319554b-cc40-385b-be62-9caad40a559c",
                        "entry_id": "df24c62c-02ff-3d72-a97b-36662463f073",
                        "glosses": [
                            "Ladestation, an der die Batterien von Elektrofahrzeugen aufgeladen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5723d43e-4a4a-4613-b2b5-c79ce3fcb3a6",
                                "sense_id": "c319554b-cc40-385b-be62-9caad40a559c",
                                "text": "„Den \"Sustainability Award\" der Raiffeisen Klimaschutz Initiative erhielten Florian Lederer und Paul Stichaller von der HTL Mössingerstraße in Klagenfurt für die Entwicklung einer intelligenten Elektrotankstelle.“"
                            },
                            {
                                "example_id": "d7e752b4-721e-4a0e-a56a-2b3e946844fb",
                                "sense_id": "c319554b-cc40-385b-be62-9caad40a559c",
                                "text": "„Die Ebersberger Elektrotankstelle war die erste, die von Eon in der Modellregion München aufgestellt wurde, das war im Dezember 2010.“"
                            },
                            {
                                "example_id": "bf94c836-044e-4d95-8848-cd450853c2cc",
                                "sense_id": "c319554b-cc40-385b-be62-9caad40a559c",
                                "text": "„Und an diesem Tag bemerkten Mitarbeiter von Autolib, dass sich unbekannte Techniker mit Laptop und Messgeräten an einer Elektrotankstelle von Autolib zu schaffen machten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
