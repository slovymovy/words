                "forms": [
                    {
                        "form_id": "7cea9d40-256b-4664-9fac-2ec2d70cc3e1",
                        "entry_id": "d63c922e-9797-3eaf-b482-868195826199",
                        "tags": [
                            "plural"
                        ],
                        "form": "pliés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59f57bb2-5c49-3030-90dc-68ab76e54a52",
                        "entry_id": "d63c922e-9797-3eaf-b482-868195826199",
                        "glosses": [
                            "Mouvement des genoux quand on les plie."
                        ],
                        "tags": [
                            "Gymnastique"
                        ],
                        "examples": [
                            {
                                "example_id": "6cd63e91-973d-40d7-ba97-5aa4cd62fc4e",
                                "sense_id": "59f57bb2-5c49-3030-90dc-68ab76e54a52",
                                "text": "Ils allaient poser un peu sous des épées croisées, faire des pliés. « Allez, messieurs ! »"
                            },
                            {
                                "example_id": "9d18f0ca-97d3-4cc7-964f-48327739847e",
                                "sense_id": "59f57bb2-5c49-3030-90dc-68ab76e54a52",
                                "text": "— Je suis à croquer ! se dit-elle en repassant ses attitudes dans la glace, absolument comme une danseuse fait ses pliés."
                            },
                            {
                                "example_id": "415a1004-0d02-4456-a0c2-4351be4087f8",
                                "sense_id": "59f57bb2-5c49-3030-90dc-68ab76e54a52",
                                "text": "Çà, dégainons l’épée ; vous, brandissez votre massue, et que Scapin fasse un plié de jarret pour se rendre la jambe souple."
                            },
                            {
                                "example_id": "a299bc9f-1fac-400d-8623-6ad2ee0ab597",
                                "sense_id": "59f57bb2-5c49-3030-90dc-68ab76e54a52",
                                "text": "Trompant l’empressement de Hervé, la chanoinesse s’élança sur le rivage en faisant un plié Pompadour, puis elle se retourna en toute hâte et offrit tour à tour la main à chacune de ses compagnes d’exil."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "54ae327f-4894-3a97-be0f-07b3190b34ce",
                "word": "plié",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4971bfb1-8645-3108-91df-f0355ca4b095",
                        "entry_id": "54ae327f-4894-3a97-be0f-07b3190b34ce",
                        "glosses": [
                            "Participe passé masculin singulier de plier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "84f7002a-5e8f-400c-a643-7cbcf668789c",
                                "sense_id": "4971bfb1-8645-3108-91df-f0355ca4b095",
                                "text": "Le longeron posé est suivi, dans ce demi-moule, du bord de fuite en nid d’abeille en Nomex, tissus de nylon et de résine qui a, sur le nid d’abeille en alliage léger, l’avantage de se «décloquer» si, au cours des manipulations, on a plié localement les parois des cellules."
                            },
                            {
                                "example_id": "0e5f8521-0558-4682-8c4c-64dcc6aa69fc",
                                "sense_id": "4971bfb1-8645-3108-91df-f0355ca4b095",
                                "text": "Il en venaient au fait sans verbiage. Quelques coups de reins, une ou deux jérémiades et le tout était plié."
                            }
                        ]
                    }
                ],
