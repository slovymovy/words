                "senses": [
                    {
                        "sense_id": "611ce02c-d06d-36e5-ae7c-fb0416d1ed34",
                        "entry_id": "7aadfe83-db5f-3ddb-9347-cc5ae4c27773",
                        "glosses": [
                            "Marke, die aus Wörtern, Zahlen, Buchstaben oder weiteren Schriftzeichen besteht, in normaler Schriftart ohne spezifische grafische Elemente"
                        ],
                        "tags": [
                            "Markenrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "351db2f7-eb99-4fc5-b2b9-70903c433401",
                                "sense_id": "611ce02c-d06d-36e5-ae7c-fb0416d1ed34",
                                "text": "Der nebenberufliche Schlagersänger Frank Wendler hatte sich „Der Wendler“ als Wortmarke schützen lassen und wollte dem Schlagersänger Michael Wendler gerichtlich untersagen, sich so zu nennen."
                            },
                            {
                                "example_id": "292b0a04-e130-4c1a-9571-02f7534ce5ff",
                                "sense_id": "611ce02c-d06d-36e5-ae7c-fb0416d1ed34",
                                "text": "„Tiptronic ist eine eingetragene Wortmarke der Porsche AG für einen Handschaltmodus bei Automatikgetrieben.“"
                            },
                            {
                                "example_id": "ae55819e-6c4c-432c-8a23-2aa0aa431804",
                                "sense_id": "611ce02c-d06d-36e5-ae7c-fb0416d1ed34",
                                "text": "Neben Wortmarken gibt es unter anderem Bild- und Hörmarken."
                            }
                        ],
                        "sense_index_json": "\"1\""
