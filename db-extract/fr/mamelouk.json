                ],
                "senses": [
                    {
                        "sense_id": "0a474c78-638c-37b9-bb2b-00a05421f220",
                        "entry_id": "b13416a0-f6d4-30e6-b49d-56393e8a063e",
                        "glosses": [
                            "Relatif aux mamelouks, en particulier à leur domination sur l'Égypte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf0e6b9-78e4-4705-97e6-aa8a6a5dbe3c",
                                "sense_id": "0a474c78-638c-37b9-bb2b-00a05421f220",
                                "text": "L’aqueduc de Magra Al-Oyoun a été fondé par le sultan mamelouk Al-Ghouri en l’an 800 de l’Hégire dans le but d’acheminer l’eau du Nil vers la citadelle de Saladin, siège du pouvoir à l’époque des Ayyubides."
                            },
                            {
                                "example_id": "fca530c0-0e5b-4f2c-a52d-855c2a28b24e",
                                "sense_id": "0a474c78-638c-37b9-bb2b-00a05421f220",
                                "text": "Un décor polychrome sur un fond rouge vif orné d'inscriptions en cursif, imitant les titulatures mameloukes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "184e68fe-fbfc-4888-9369-0c519c40690b",
                        "source_entry_id": "b13416a0-f6d4-30e6-b49d-56393e8a063e",
                        "source_sense_id": "0a474c78-638c-37b9-bb2b-00a05421f220",
                        "target_lang_word": "mameluke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mameluke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb7216e5-6acb-3044-8221-6723436577e8",
                                        "entry_id": "ca0653d4-8e67-3267-9a48-a20ff6b83c50",
                                        "glosses": [
                                            "A fool."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52da77bf-a163-49a8-b06a-3e51214a0888",
                                                "sense_id": "cb7216e5-6acb-3044-8221-6723436577e8",
                                                "text": "Kabikov: “Hey, I’m setting a mood.” Mad Sal: “I’ll mood you, you mameluke."
                                            },
                                            {
                                                "example_id": "3536a029-ca08-4fde-a748-5fbd8fc6ad5b",
                                                "sense_id": "cb7216e5-6acb-3044-8221-6723436577e8",
                                                "text": "My goddamn son-in-law, my right-hand man, acting like a fucking mameluke in front of all those people.” “Maybe he acted that way on purpose,” Tozzi said, “To make you think he was a mameluke.” “He was a mameluke!”"
                                            },
                                            {
                                                "example_id": "1be1f877-c96b-4d81-9de0-1031900e0ade",
                                                "sense_id": "cb7216e5-6acb-3044-8221-6723436577e8",
                                                "text": "“I’m saying there are some asshole cops who take their ‘collar’ out to the desert and bury him. […] There is nothing I would enjoy more than to put that mameluke Mikey Esposito in the ground . . . but that’s not going to happen.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84f426f8-dc16-303f-a815-3a297af9188a",
                                        "entry_id": "ca0653d4-8e67-3267-9a48-a20ff6b83c50",
                                        "glosses": [
                                            "Alternative letter-case form of Mameluke."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "7b72d0cd-9cec-34eb-a23e-eccd388a1ede",
