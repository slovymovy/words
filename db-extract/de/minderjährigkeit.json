                                "example_id": "f9c37db5-e7ec-4537-9460-77a37767339b",
                                "sense_id": "b7d43436-5964-3eed-9882-d2da03904b15",
                                "text": "„Während der Minderjährigkeit des heute regierenden Kurfürsten führte Prinz Xavier, der älteste seiner Onkel, die Geschäfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
