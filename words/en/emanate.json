{
    "word_family": [
        "emanation",
        "emanative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7c87a24-d121-3663-8adf-09f0813abfd0",
                    "sense_definition": "To come or flow out from a source",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sweet scent <w>emanates</w> from the blooming jasmine flowers in the garden.",
                            "target_lang_translations": {
                                "nl": "Er <w>gaat</w> een zoete geur <w>uit</w> van de bloeiende jasmijn in de tuin."
                            }
                        },
                        {
                            "text": "The warmth <w>emanating</w> from the fireplace made the room feel very cozy.",
                            "target_lang_translations": {
                                "nl": "De warmte die van de open haard <w>uitging</w>, maakte de kamer erg gezellig."
                            }
                        }
                    ],
                    "synonyms": [
                        "originate",
                        "emerge",
                        "issue"
                    ],
                    "common_phrases": [
                        "emanate from"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voortkomen of stromen uit een bepaalde bron (zoals geur, warmte of geluid)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voortkomen uit",
                                "target_lang_sense_clarification": "afkomstig zijn van een bron"
                            },
                            {
                                "target_lang_word": "uitgaan van",
                                "target_lang_sense_clarification": "zich verspreiden vanuit een bron"
                            },
                            {
                                "target_lang_word": "opstijgen uit",
                                "target_lang_sense_clarification": "naar boven komen (geur of damp)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a53b9469-2bda-3b45-867d-9ce365d3acee",
                    "sense_definition": "To produce or give off something such as a smell, light, or feeling",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house seemed to <w>emanate</w> a sense of mystery and history.",
                            "target_lang_translations": {
                                "nl": "Het oude huis leek een gevoel van mysterie en geschiedenis <w>uit te stralen</w>."
                            }
                        },
                        {
                            "text": "She <w>emanated</w> confidence as she walked onto the stage to give her speech.",
                            "target_lang_translations": {
                                "nl": "Ze <w>straalde</w> zelfvertrouwen <w>uit</w> toen ze het podium op liep om haar toespraak te houden."
                            }
                        }
                    ],
                    "synonyms": [
                        "emit",
                        "radiate",
                        "exude"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets produceren of afgeven, zoals een geur, licht, of een bepaalde sfeer of emotie"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitstralen",
                                "target_lang_sense_clarification": "een gevoel, sfeer of eigenschap verspreiden"
                            },
                            {
                                "target_lang_word": "verspreiden",
                                "target_lang_sense_clarification": "een geur of sfeer doen rondgaan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}