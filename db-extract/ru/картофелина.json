                    {
                        "translation_id": "cfc627ee-7eb4-4a0f-ada3-af7886b8d3db",
                        "source_entry_id": "dad88048-1dd9-39e5-9b3d-02f7be5f4a3f",
                        "source_sense_id": "0476d18d-61d5-36ef-9b55-d64df9ba0371",
                        "target_lang_word": "potato",
