    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                "word": "roughneck",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "547b3a9d-a69d-4dea-99d1-84a2ec8e00be",
                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                        "tags": [
                            "plural"
                        ],
                        "form": "roughnecks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8025ae92-81eb-3564-bad2-4084f4116ad6",
                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                        "glosses": [
                            "Someone with rough manners; a rowdy or uncouth person."
                        ],
                        "tags": [
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9a681681-ea4c-4b38-9e65-784c44f3864a",
                                "sense_id": "8025ae92-81eb-3564-bad2-4084f4116ad6",
                                "text": "LaTisha has long wanted to show Carole sheʼs not the roughneck she used to be, the roughneck who wasnʼt good enough to be her friend."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d67fc06-ae11-37ae-8795-645365eff893",
                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                        "glosses": [
                            "An ironworker; a dirty or low-paid worker, a labourer."
                        ],
                        "tags": [
                            "US",
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "76186293-8ce2-3ced-9fc3-7ac1109ad9e9",
                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                        "glosses": [
                            "A labourer on an oil rig."
                        ],
                        "tags": [
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "026e553b-70d3-4d57-8f7c-acc57b3d2cb0",
                                "sense_id": "76186293-8ce2-3ced-9fc3-7ac1109ad9e9",
                                "text": "This first ship had a small geophysical-type drilling rig mounted over the side of the ship with a steel grid runround for the roughnecks, who stood in knee-deep water while making connections or pulling the drill string."
                            },
                            {
                                "example_id": "33637872-ad17-429b-aeb6-bca760bd778c",
                                "sense_id": "76186293-8ce2-3ced-9fc3-7ac1109ad9e9",
                                "text": "As for the minerals, there has been a good deal of drilling along the big river; trucks and roughnecks no longer garner any notice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "201a8008-913a-4f97-aab1-94138f3a319e",
                        "source_entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                        "source_sense_description": "someone with rough manners; a rowdy or uncouth person",
                        "target_lang_word": "ours mal léché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ours mal léché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd7aeb1-6287-3525-8f8f-7b5847d26f32",
                                        "entry_id": "9e4801b3-7f29-3233-9e91-7769eca61ab8",
                                        "glosses": [
                                            "Individu aux manières grossières et d’aspect rébarbatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6908ff7c-e698-42e8-918e-9421a6dbaaae",
                                                "sense_id": "8bd7aeb1-6287-3525-8f8f-7b5847d26f32",
                                                "text": "Honnête homme, cela ne faisait pas de doute, cœur excellent, caractère élevé, mais un ours et un ours fort mal léché ; bon dans les Landes, embarrassant à Bordeaux."
                                            },
                                            {
                                                "example_id": "7bd496dd-35bc-4f99-a435-fb1ac1c6565c",
                                                "sense_id": "8bd7aeb1-6287-3525-8f8f-7b5847d26f32",
                                                "text": "Le métro, le bus ou le RER modifie nos êtres. Nous devenons un autre, souvent un ours mal léché ou un loup solitaire qui s’enferme dans sa bulle, écouteur sur les oreilles."
                                            },
                                            {
                                                "example_id": "f3d8a7e1-2197-434b-9291-8a017410e4b3",
                                                "sense_id": "8bd7aeb1-6287-3525-8f8f-7b5847d26f32",
                                                "text": "Sorte de gros ours mal léché, la veste ouverte exposant son ventre rond et les cheveux en bataille, Boris Johnson a fait une étrange impression au milieu de la cérémonie de clôture empesée des Jeux olympiques de Pékin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1073b647-fa33-44cc-8d2a-52efe26e5203",
                        "source_entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                        "source_sense_description": "someone with rough manners; a rowdy or uncouth person",
                        "target_lang_word": "arriéré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arriéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8443f2-81b5-3685-b793-96d6fc1f5187",
                                        "entry_id": "6768a123-7a8a-3802-9e02-1ff31e3991ee",
                                        "glosses": [
                                            "Qui est en retard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb1e48d-9b8a-4130-8021-25da427c228d",
                                                "sense_id": "7c8443f2-81b5-3685-b793-96d6fc1f5187",
                                                "text": "Réclamer un traitement arriéré."
                                            },
                                            {
                                                "example_id": "e37bc671-2b02-46d6-831a-c8bce7732908",
                                                "sense_id": "7c8443f2-81b5-3685-b793-96d6fc1f5187",
                                                "text": "Des affaires arriérées — Des affaires qui n’ont pu être examinées ou expédiées à temps."
                                            },
                                            {
                                                "example_id": "661e21ba-f0f3-4bb3-84e3-93d4eb41c9d8",
                                                "sense_id": "7c8443f2-81b5-3685-b793-96d6fc1f5187",
                                                "text": "Je m’en vais essayer de gagner quelques pistoles au jeu du roi. Autant de pris sur ma solde arriérée."
                                            },
                                            {
                                                "example_id": "2051651f-33f7-4f91-a2f5-137a0526fbfb",
                                                "sense_id": "7c8443f2-81b5-3685-b793-96d6fc1f5187",
                                                "text": "Dès le soir, elle pressa Bovary d’écrire à sa mère pour qu’elle leur envoyât bien vite tout l’arriéré de l’héritage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef2dcf47-596d-3f24-9d34-874ce180ad5d",
                                        "entry_id": "6768a123-7a8a-3802-9e02-1ff31e3991ee",
                                        "glosses": [
                                            "Qui ne correspond plus aux idées courantes, qui est d’une autre époque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "724bf733-df54-4a72-97fa-c55cfca44bbb",
                                                "sense_id": "ef2dcf47-596d-3f24-9d34-874ce180ad5d",
                                                "text": "Idées arriérées."
                                            },
                                            {
                                                "example_id": "37aa2746-0d7b-4e4e-9b39-ee95828df479",
                                                "sense_id": "ef2dcf47-596d-3f24-9d34-874ce180ad5d",
                                                "text": "— N’est-ce pas une observation curieuse à faire sur les mœurs de nos campagnes ? Vous avez voyagé dans des pays lointains et sauvages ; vous ne vous doutiez pas, je parie, qu’il y eût au centre de la France des superstitions si arriérées !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b184c9-7a16-329b-9058-5efb7a2ef215",
                                        "entry_id": "6768a123-7a8a-3802-9e02-1ff31e3991ee",
                                        "glosses": [
                                            "Qui a fait moins de progrès que les autres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fbc50b-92fa-4366-8bd0-2370960bdabe",
                                                "sense_id": "98b184c9-7a16-329b-9058-5efb7a2ef215",
                                                "text": "C'est la preuve d'un État qui est très arriéré sur le plan des libertés publiques et des droits de la défense."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arriéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2426fc6-9b55-3bcf-938c-374c12eca5ce",
                                        "entry_id": "914eec4e-1fde-3797-8948-1088f6280d49",
                                        "glosses": [
                                            "Dettes de l’État dont le paiement est retardé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df596ad2-4d88-43a1-9b14-9bc0b7f4dc6d",
                                                "sense_id": "a2426fc6-9b55-3bcf-938c-374c12eca5ce",
                                                "text": "On ne paie pas ce fournisseur, il a été mis à l’arriéré."
                                            },
                                            {
                                                "example_id": "84397598-49ba-4d48-91ec-1f68ce4c44f7",
                                                "sense_id": "a2426fc6-9b55-3bcf-938c-374c12eca5ce",
                                                "text": "Ma créance a été mise dans l’arriéré, portée à l’arriéré."
                                            },
                                            {
                                                "example_id": "b9da705c-3240-489a-af54-11922fb74abb",
                                                "sense_id": "a2426fc6-9b55-3bcf-938c-374c12eca5ce",
                                                "text": "Liquider l’arriéré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9b96d0-5a80-3000-a408-66faddcdd62b",
                                        "entry_id": "914eec4e-1fde-3797-8948-1088f6280d49",
                                        "glosses": [
                                            "Toute portion d’une dette quelconque dont le paiement a été retardé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db259e3-8db4-4877-af06-2ddd4d39f14a",
                                                "sense_id": "bd9b96d0-5a80-3000-a408-66faddcdd62b",
                                                "text": "Voilà le 1ᵉʳ janvier qui arrive. Vous recevrez beaucoup d’argent à l’occasion des étrennes, et vous serez, alors, en mesure de me régler mon petit arriéré !"
                                            },
                                            {
                                                "example_id": "6c942d04-588e-4cf8-a0ef-c4d68a542adb",
                                                "sense_id": "bd9b96d0-5a80-3000-a408-66faddcdd62b",
                                                "text": "Trois jours plus tard, toutes les vieilles dettes de la maison, y compris l’arriéré des gages du serviteur, étaient payées jusqu’au dernier denier : il restait quatorze cents livres au chevalier."
                                            },
                                            {
                                                "example_id": "641121aa-e05b-465a-8540-cf1e179b7464",
                                                "sense_id": "bd9b96d0-5a80-3000-a408-66faddcdd62b",
                                                "text": "[…], je mettrai ma main à couper qu'ils t'arrêtent si tu tentes de retourner aux États-Unis. Ne serait-ce que pour les arriérés d'impôts – avec intérêts et pénalités cumulés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea4deb11-9e5e-3beb-bf85-bc3664901371",
                                        "entry_id": "914eec4e-1fde-3797-8948-1088f6280d49",
                                        "glosses": [
                                            "Partie d’un travail, d’une tâche, que l’on n’a pu faire à temps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a91443-fbbf-4148-8563-727200ac4fc8",
                                                "sense_id": "ea4deb11-9e5e-3beb-bf85-bc3664901371",
                                                "text": "J’ai beaucoup d’arriéré dans ma correspondance."
                                            },
                                            {
                                                "example_id": "583d533a-b5d5-4b4d-a1b6-1c8a6f69f14d",
                                                "sense_id": "ea4deb11-9e5e-3beb-bf85-bc3664901371",
                                                "text": "Et, sous les ruches de la capote, je sentais le long regard d’amour dont elle l’enveloppait des pieds à la tête, dans une pluie de baisers, de larmes, de petits rires ; un arriéré de trois mois de tendresse maternelle qu’elle lui payait tout en une fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "160038c1-a244-33a1-a6ab-d2e66990ef94",
                                        "entry_id": "914eec4e-1fde-3797-8948-1088f6280d49",
                                        "glosses": [
                                            "Personne dont le développement intellectuel ne correspond pas à son âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffff1bef-2ee4-4eaa-9297-bf42fe26339e",
                                                "sense_id": "160038c1-a244-33a1-a6ab-d2e66990ef94",
                                                "text": "Quand son axe croisa le regard de Rémy, ce dernier lui lança un regard de mépris profond puis lorgna ailleurs des fois que la bêtise de cet arriéré soit « contamineuse »."
                                            },
                                            {
                                                "example_id": "0771d397-356d-41ec-92f3-4f3216b36093",
                                                "sense_id": "160038c1-a244-33a1-a6ab-d2e66990ef94",
                                                "text": "Un Zoulou aux traits grossiers, plus près du primate : menton en galoche, front bas, arcades d’arriéré congénital, et ces yeux marronnasses, tremblant de fièvre… Terreblanche fit claquer sa cravache dans la paume de sa main."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arriéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32bca98d-861b-3f79-b543-a03f6691adc9",
                                        "entry_id": "8c9926a2-0843-345d-8afa-70a93d0bc83e",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe arriérer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
