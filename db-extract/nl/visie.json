                        ],
                        "form": "visies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b1e8e50-3af0-3b57-8982-69eb72d24b6b",
                        "entry_id": "71b4787c-39f9-35d0-83bc-abcc69af55c4",
                        "glosses": [
                            "de wijze waarop men zaken beoordeelt of beschouwt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddae98cf-f16a-4fa2-ae20-cfad6fcb4923",
                                "sense_id": "9b1e8e50-3af0-3b57-8982-69eb72d24b6b",
                                "text": "Maar het is vooral de culinaire visie van Boer die door Van de Laar wordt geroemd. \"Hij wist heel veel over de natuur en dan kwam hij weer met een plant binnen die ik niet kende, en vertelde hij wat je er mee kon maken.\""
                            },
                            {
                                "example_id": "d049a397-f322-437c-ab64-bbe191785e6c",
                                "sense_id": "9b1e8e50-3af0-3b57-8982-69eb72d24b6b",
                                "text": "De jury, onder leiding van schrijver Nelleke Noordervliet, prijst het boek om zijn visie, gedegenheid en toegankelijkheid. \"Ondanks de vele details en wetenswaardigheden verliest het het grote verhaal van de taal nooit uit het oog.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e2405cf-27a7-4819-8e81-90eaea452075",
                        "source_entry_id": "71b4787c-39f9-35d0-83bc-abcc69af55c4",
                        "source_sense_id": "9b1e8e50-3af0-3b57-8982-69eb72d24b6b",
                        "source_sense_description": "de wijze waarop men zaken beoordeelt of beschouwt",
                        "target_lang_word": "Sicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84527cea-4a08-327f-a314-3aa0f31dc333",
                                        "entry_id": "adadd20e-db6c-33f6-afd5-20bfa5d87001",
                                        "glosses": [
                                            "das, was man von einem bestimmten Punkt aus sehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5757dc4a-6452-42fa-a3b1-188e22c89300",
                                                "sense_id": "84527cea-4a08-327f-a314-3aa0f31dc333",
                                                "text": "Von diesem Standort aus hat man eine hervorragende Sicht in die Landschaft."
                                            },
                                            {
                                                "example_id": "088e7429-f395-4420-aa4f-8a48681ae164",
                                                "sense_id": "84527cea-4a08-327f-a314-3aa0f31dc333",
                                                "text": "„Dafür kann man weit gucken, zwar nicht bis zum Horizont, aber nichts stört die Sicht bis zur nächsten Schneewehe.“"
                                            },
                                            {
                                                "example_id": "28f2b545-2b3b-4506-a218-679d9e7a0883",
                                                "sense_id": "84527cea-4a08-327f-a314-3aa0f31dc333",
                                                "text": "„Die Sicht war schlecht, die See durch Sturm aufgepeitscht, hoher Wellengang machte der Besatzung und insbesondere der Wache auf der Brücke das Leben schwer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "021b487b-de67-3345-9bac-b9ccc00eeb8f",
                                        "entry_id": "adadd20e-db6c-33f6-afd5-20bfa5d87001",
                                        "glosses": [
                                            "Perspektive, persönliche Einstellung oder Wahrnehmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c093e5ff-9c61-4169-a0ec-f418bc22a9f5",
                                                "sense_id": "021b487b-de67-3345-9bac-b9ccc00eeb8f",
                                                "text": "Die Probleme stellen sich aus meiner Sicht ganz anders dar."
                                            },
                                            {
                                                "example_id": "1d96446c-f053-489c-bdfa-687d3b4443c7",
                                                "sense_id": "021b487b-de67-3345-9bac-b9ccc00eeb8f",
                                                "text": "„Über die vorliegende Diplomarbeit möchte ich versuchen, einen Beitrag zu der Frage zu leisten, welche Sicht die Teams auf ihr medikationsbezogenes Handeln haben bzw. welche Themen in diesem Kontext für sie von Bedeutung sind.“"
                                            },
                                            {
                                                "example_id": "0ee1f413-a9fe-4e07-8db3-82bc9d45e163",
                                                "sense_id": "021b487b-de67-3345-9bac-b9ccc00eeb8f",
                                                "text": "„Nur dann wäre in dieser Sicht ein wissenschaftlicher Gottesbeweis gelungen, wenn der Unterschied empirisch feststellbar wäre, den seine Existenz bzw. Nichtexistenz für eine naturwissenschaftliche Beschreibung der Wirklichkeit machen würde.“"
                                            },
                                            {
                                                "example_id": "98ae9b22-444f-49b3-8e22-6073021d093e",
                                                "sense_id": "021b487b-de67-3345-9bac-b9ccc00eeb8f",
                                                "text": "„Die Prohibition, Sumners Tugendwächtertrupp, die Feindseligkeit gegenüber den Immigranten, die Unterdrückung von anarchistischen und anderen »ausländischen« Ideen – all das waren aus Sylvias Sicht Aspekte ein und desselben grundsätzlichen Problems in Amerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5071aa1-0cd3-3663-ad39-49bd7e76983e",
                                        "entry_id": "adadd20e-db6c-33f6-afd5-20bfa5d87001",
                                        "glosses": [
                                            "Dauer, Frist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e211222-7cef-4276-99e5-bda137355b49",
                                                "sense_id": "a5071aa1-0cd3-3663-ad39-49bd7e76983e",
                                                "text": "Die Sache lässt sich nur auf lange Sicht bewältigen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7d221d2e-402c-3540-b0d9-b94c8a320aa7",
                                        "entry_id": "adadd20e-db6c-33f6-afd5-20bfa5d87001",
                                        "glosses": [
                                            "eine virtuelle Tabelle in einem Datenbanksystem"
                                        ],
                                        "tags": [
                                            "Datenbanken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7723f57f-32ca-49f2-8a7a-f0768e6f859d",
                                                "sense_id": "7d221d2e-402c-3540-b0d9-b94c8a320aa7",
                                                "text": "\"Sichten oder virtuelle Relationen (im englischen: View) sind von Basisrelationen abgeleitete Relationen, wobei in der Datenbank nicht deren Inhalt, sondern nur die Ableitungsregeln gespeichert werden!\""
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b832f92-0671-40b7-816b-deec62e19be2",
                        "source_entry_id": "71b4787c-39f9-35d0-83bc-abcc69af55c4",
                        "source_sense_id": "9b1e8e50-3af0-3b57-8982-69eb72d24b6b",
                        "source_sense_description": "de wijze waarop men zaken beoordeelt of beschouwt",
                        "target_lang_word": "Ansicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ansicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c8fd2d-7263-353e-9ba5-9bb2be374f94",
                                        "entry_id": "4767cc0d-16b9-3c46-be64-4e62228c9a4d",
                                        "glosses": [
                                            "Art und Weise, wie man etwas versteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3555482-6338-4dba-a41a-01ee8d918467",
                                                "sense_id": "d9c8fd2d-7263-353e-9ba5-9bb2be374f94",
                                                "text": "Meiner Ansicht nach verhält sich der Sachverhalt ganz anders."
                                            },
                                            {
                                                "example_id": "c9ddefbe-6b1a-4081-ab1b-14e20e55efdc",
                                                "sense_id": "d9c8fd2d-7263-353e-9ba5-9bb2be374f94",
                                                "text": "„Ich hatte andere Ansichten darüber als Raoul, aber ich verzichtete darauf, sie ihm zu erklären.“"
                                            },
                                            {
                                                "example_id": "4ba53992-f80f-4095-985d-aad73818bf6c",
                                                "sense_id": "d9c8fd2d-7263-353e-9ba5-9bb2be374f94",
                                                "text": "„Diese Klarstellung sive Reservatio nützte nicht überall, in der Schweiz wurde der »Agathon« wegen der unmoralischen/unchristlichen Ansichten des Hippias verboten.“"
                                            },
                                            {
                                                "example_id": "2b99e245-c901-42b3-8b45-10de525cd5f7",
                                                "sense_id": "d9c8fd2d-7263-353e-9ba5-9bb2be374f94",
                                                "text": "„Schon fühlten sich einige Kommentatoren, Journalisten und Redakteure in ihrer Rolle als Meinungsmacher angegriffen, denn die Inhalte widersprachen ihren eigenen Ansichten und der Erfolg von Frau Herman war so etwas wie eine persönliche Beleidigung.“"
                                            },
                                            {
                                                "example_id": "8a717b59-7b62-4979-af54-0cc865deea92",
                                                "sense_id": "d9c8fd2d-7263-353e-9ba5-9bb2be374f94",
                                                "text": "„Nach Ansicht des Naturschutzbundes Deutschland (NABU) sollte sich die Höhe der Steuer nach der Klimabelastung der Verpackungsproduktion und der Anzahl ihrer Nutzungen richten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df6fd218-add3-3c87-ab4a-48af29ec471c",
                                        "entry_id": "4767cc0d-16b9-3c46-be64-4e62228c9a4d",
                                        "glosses": [
                                            "Darstellung, optische Wiedergabe von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1c20f1-3318-4050-9e38-ad948384fa0e",
                                                "sense_id": "df6fd218-add3-3c87-ab4a-48af29ec471c",
                                                "text": "Ich werde dir eine schöne Ansicht unseres Hotels mitbringen."
                                            },
                                            {
                                                "example_id": "94e3c7ff-9d1b-4609-bc7c-3721f71ccead",
                                                "sense_id": "df6fd218-add3-3c87-ab4a-48af29ec471c",
                                                "text": "In der Ansicht von oben sieht man die Struktur viel besser."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "94b768e3-ae6a-3f04-85b7-ca8cd42d81b8",
                                        "entry_id": "4767cc0d-16b9-3c46-be64-4e62228c9a4d",
                                        "glosses": [
                                            "zum prüfenden/beurteilenden Betrachten"
                                        ],
                                        "tags": [
                                            "zur Ansicht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60f8f0cb-f29f-496b-8415-e4a2081be5cb",
                                                "sense_id": "94b768e3-ae6a-3f04-85b7-ca8cd42d81b8",
                                                "text": "Ich gebe Ihnen diese Brille zur Ansicht nach Hause mit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
