                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37309212-e09e-4e36-a9d1-633b397e0a80",
                                "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                                "text": "Husum liegt in Deutschlands Norden."
                            },
                            {
                                "example_id": "6bddb0da-6c49-404d-aa0e-a34b07e48c51",
                                "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                                "text": "Ich bin in Husum geboren."
                            },
                            {
                                "example_id": "c570622f-c72f-4e3b-a4cf-5832d17436f4",
                                "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                                "text": "Wir haben in Husum unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "c856708a-1cd6-446a-a5a3-944df699dff0",
                                "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                                "text": "Nach Husum führen viele Wege."
                            },
                            {
                                "example_id": "ab679840-b23c-4b30-bc5e-62c29355cecd",
                                "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                                "text": "Husum liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "0190212e-0999-4868-a3ac-f2145bc6ea3f",
                                "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                                "text": "Das Husum des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                            }
                        ],
