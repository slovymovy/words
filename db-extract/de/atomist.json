                "senses": [
                    {
                        "sense_id": "5fb5df1e-85cb-3e13-89f3-7cb1487d9899",
                        "entry_id": "8f82188a-714f-30be-9f17-60b4c65b095a",
                        "glosses": [
                            "Vertreter der Lehre des Atomismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8397b67-615e-488c-99d4-081531f849d2",
                                "sense_id": "5fb5df1e-85cb-3e13-89f3-7cb1487d9899",
                                "text": "„Im Weltbild der Atomisten ist es weitaus schwieriger, einen Gott unterzubringen. Entsprechend hat man den Atomisten wie Demokrit auch vorgeworfen, sie seien Atheisten gewesen.“"
                            }
