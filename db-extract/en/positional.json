    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c2d9bf17-5a64-3736-ada3-bb97db4aa2a1",
                "word": "positional",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d7df156-7c80-3ac3-8d1d-c70efcbd382b",
                        "entry_id": "c2d9bf17-5a64-3736-ada3-bb97db4aa2a1",
                        "glosses": [
                            "Relating to the position of something."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "563123f1-a134-4490-a2cc-c9e7e6c682a5",
                                "sense_id": "8d7df156-7c80-3ac3-8d1d-c70efcbd382b",
                                "text": "The mattress platform on Davey’s bed fell unexpectedly, “trapping her neck against the upper surface of the side panel of the bed’s base,” Chipperfield explained. “Unable to free herself, she died of positional asphyxia. One of the two gas-lift pistons was defective.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "3f0f0c59-5014-32a9-97e9-4cfd9e302ad6",
                        "entry_id": "c2d9bf17-5a64-3736-ada3-bb97db4aa2a1",
                        "glosses": [
                            "Having or pertaining to a value that is a function of its social desirability, as opposed to its utility."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a62a30c1-b117-45fa-9e7a-35deeeeb3917",
                                "sense_id": "3f0f0c59-5014-32a9-97e9-4cfd9e302ad6",
                                "text": "Of course, this ex post problem may have a negative feedback on the ex ante desirability of having market transactions for positional goods."
                            },
                            {
                                "example_id": "7cc7e0dc-604b-40ac-8761-94e77d0ead1f",
                                "sense_id": "3f0f0c59-5014-32a9-97e9-4cfd9e302ad6",
                                "text": "Since economics is about scarcity, its study must be based on positional conflict, as indicated by the behaviour of the nouveau riche, or of poor people, who proudly demonstrate their latest smartphones or plasma TV sets."
                            },
                            {
                                "example_id": "a433529c-8733-46bb-b549-31dd6a0c87d1",
                                "sense_id": "3f0f0c59-5014-32a9-97e9-4cfd9e302ad6",
                                "text": "Regarding saving and consumption, nonpositional and positional consumption are distinguished."
                            },
                            {
                                "example_id": "f89cc8a5-ecce-49dd-b14b-a75f401ea256",
                                "sense_id": "3f0f0c59-5014-32a9-97e9-4cfd9e302ad6",
                                "text": "Max Weber was also aware of positional considerations when he defined social status as \"an effective claim to social esteem in terms of positive or negative privileges\" (Weber, 1922: 305)."
                            }
                        ]
                    },
                    {
                        "sense_id": "62b87292-3d3e-308d-be97-9b27cce0ae36",
                        "entry_id": "c2d9bf17-5a64-3736-ada3-bb97db4aa2a1",
                        "glosses": [
                            "Based on long-term strategy, on gaining and exploiting small advantages, and on analyzing the larger position, rather than calculating more immediate tactics."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "53ab14a2-6fb7-365f-9fc0-3bccb485b2e8",
                        "entry_id": "c2d9bf17-5a64-3736-ada3-bb97db4aa2a1",
                        "glosses": [
                            "An argument that is passed to a subroutine according to its position in the invocation code, rather than on its name; compare with named."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
