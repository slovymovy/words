                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bd7f578-b5a9-3184-b892-e798d5da2e5a",
                        "entry_id": "c30104c3-2823-3023-819a-3bee6da27d17",
                        "glosses": [
                            "Qui a le vice de l’intempérance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e129517-b03e-492f-92d7-69363b64310f",
                                "sense_id": "5bd7f578-b5a9-3184-b892-e798d5da2e5a",
                                "text": "C’est un homme intempérant."
                            }
                        ]
                    },
                    {
                        "sense_id": "1271bbe3-efae-365f-98cd-5b0d5616655c",
                        "entry_id": "c30104c3-2823-3023-819a-3bee6da27d17",
                        "glosses": [
                            "Qui manque de modération."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6b9a4a25-8771-4367-9a3c-6017bb3aed76",
                                "sense_id": "1271bbe3-efae-365f-98cd-5b0d5616655c",
                                "text": "Un esprit intempérant."
                            },
                            {
                                "example_id": "897d792f-f066-4f8f-9aa3-b4d9efff4b77",
                                "sense_id": "1271bbe3-efae-365f-98cd-5b0d5616655c",
                                "text": "D'abord, il faut agir vite. Sinon, des envieux, des langues intempérantes pourraient dire que, secrètement, nous poussons les conspirateurs, et alors c'est notre tête que nous risquerions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22f97893-236f-4bc0-9e4a-1487beb65825",
                        "source_entry_id": "c30104c3-2823-3023-819a-3bee6da27d17",
                        "target_lang_word": "intemperant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intemperant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73f6e6a8-e013-33c2-939e-cd5878d50485",
                                        "entry_id": "4a49e594-8aec-396f-b8de-4d4659b8d2c2",
                                        "glosses": [
                                            "intemperate"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c39a7e54-a74f-4447-9c86-cac49e80f6d8",
                                                "sense_id": "73f6e6a8-e013-33c2-939e-cd5878d50485",
                                                "text": "I know in Monterey, from my own experience, the court places the question before the alleged intemperant person and asks them if they want to go to a hospital."
                                            },
                                            {
                                                "example_id": "6b6f684b-d1ef-4dc9-8af5-4bfc8f04ebf6",
                                                "sense_id": "73f6e6a8-e013-33c2-939e-cd5878d50485",
                                                "text": "In particular, supporters of nativist policies decried the tendency to permit intemperant (or any other) newcomers to vote in American elections."
                                            },
                                            {
                                                "example_id": "50cb7f64-064f-4ce1-bd92-5c69077f868a",
                                                "sense_id": "73f6e6a8-e013-33c2-939e-cd5878d50485",
                                                "text": "Having positioned this deficiency within this illustration and bearing in mind that the intemperant person is an individual who cannot either control or regulate his passionate appetites, it is easily found among all people whether educated or not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24c786f4-d479-4518-9bde-2cd05685374f",
                        "source_entry_id": "c30104c3-2823-3023-819a-3bee6da27d17",
                        "target_lang_word": "intemperate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intemperate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "726a3ea5-5fcb-34a4-bf9c-f8396e1a2db5",
                                        "entry_id": "6dcbcd6f-9dfc-3cad-83b2-59ec1975a2ca",
                                        "glosses": [
                                            "Lacking moderation, temper or control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db654f1d-2a8c-4499-9efa-ec1bd0b55416",
                                                "sense_id": "726a3ea5-5fcb-34a4-bf9c-f8396e1a2db5",
                                                "text": "intemperate language"
                                            },
                                            {
                                                "example_id": "3e30fce1-2360-49b8-87d8-48bf0c2b170b",
                                                "sense_id": "726a3ea5-5fcb-34a4-bf9c-f8396e1a2db5",
                                                "text": "intemperate zeal"
                                            },
                                            {
                                                "example_id": "96f62460-6b9e-4ade-88b0-328737d488f5",
                                                "sense_id": "726a3ea5-5fcb-34a4-bf9c-f8396e1a2db5",
                                                "text": "Constantine engaged himself, by a solemn promise, to deliver Italy from the Goths; advanced as far as the banks of the Po; and after alarming, rather than assisting, his pusillanimous ally, hastily returned to the palace of Arles, to celebrate, with intemperate luxury, his vain and ostentatious triumph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80a512d5-2457-3848-b034-85349cc6b35c",
                                        "entry_id": "6dcbcd6f-9dfc-3cad-83b2-59ec1975a2ca",
                                        "glosses": [
                                            "Indulging any appetite or passion to excess, especially the drinking of alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "intemperate",
                                "target_lang_code": "en",
                                "target_senses": [
