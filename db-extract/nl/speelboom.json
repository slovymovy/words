                "senses": [
                    {
                        "sense_id": "11ce0b38-7133-3d52-b3f2-f37938bef485",
                        "entry_id": "37091a6d-bf61-3213-aae7-357ee6653b10",
                        "glosses": [
                            "een boom waarin kinderen kunnen klimmen en spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91afe695-104e-4956-a3f3-8deb2e83541e",
                                "sense_id": "11ce0b38-7133-3d52-b3f2-f37938bef485",
                                "text": "Sinds 1933 komen bezoekers naar de Sunland Bar in deze enorme Baobab-boom voor een drankje en uitzicht. Het is eigenlijk een grote magische speelboom uit je kindertijd, maar dan met drank. Kom niet met een groep want in deze gezellige bar kunnen slechts vijftien personen tegelijk terecht."
                            },
                            {
                                "example_id": "4b2ba05f-15e9-44be-9ccd-9784ab09aba1",
                                "sense_id": "11ce0b38-7133-3d52-b3f2-f37938bef485",
                                "text": "Toevallig komen Tes en Tom er achter dat de gemeente van plan is om hun speelboom om te laten hakken. Dat mag niet gebeuren, vinden ze. Margriet de Graaf beschrijft in ”De boomredders” hun succesvolle actie."
                            }
                        ]
                    }
