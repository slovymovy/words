                                        "entry_id": "00c1c3b8-70c6-3343-b2d4-ee2d1f305f89",
                                        "glosses": [
                                            "etwas durch Zugabe von Chlor keimfrei machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39f4527c-0daa-4b75-900c-ac9936dbbec2",
                                                "sense_id": "aa3f01a4-798d-37b5-b7f3-6e2d9b08102c",
                                                "text": "Die Regierung in Ankara entsandte inzwischen Spezialteams ins Erdbebengebiet, die Müll einsammeln, Trinkwasser chlorieren und Tote begraben sollen."
                                            },
                                            {
                                                "example_id": "3baef88b-2bd2-4803-9717-355691f34b9f",
                                                "sense_id": "aa3f01a4-798d-37b5-b7f3-6e2d9b08102c",
                                                "text": "Wenn Sie vorhaben, den Pool zu benutzen, sollten Sie nicht direkt zuvor den Pool chlorieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5f42155-f8a1-37f3-8857-17110f3387c8",
                                        "entry_id": "00c1c3b8-70c6-3343-b2d4-ee2d1f305f89",
                                        "glosses": [
                                            "Moleküle in einer chemischen Verbindung durch Chloratome ersetzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862d3913-fd52-4c9e-9c45-df4ac417de24",
                                                "sense_id": "d5f42155-f8a1-37f3-8857-17110f3387c8",
                                                "text": "Latexkleidung würde auch chloriert werden, wenn man sie längere Zeit in Wasser mit Chloranteil liegen lassen würde."
                                            },
                                            {
                                                "example_id": "b5edfeb3-b992-4520-a273-c394f0f7a60c",
                                                "sense_id": "d5f42155-f8a1-37f3-8857-17110f3387c8",
                                                "text": "In den gasförmigen Zustand übergeführte organische Verbindungen lassen sich durch Chlor in Gegenwart eines Katalysators chlorieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
