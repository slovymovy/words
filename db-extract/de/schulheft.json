                "senses": [
                    {
                        "sense_id": "40c1d163-2cc2-328c-93e6-c75c002794a7",
                        "entry_id": "f61b0034-77f7-3713-aa3a-d3daec3c9d90",
                        "glosses": [
                            "Heft, das für Schulzwecke verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4fe826-2ef2-4e79-a004-74d9f21e037b",
                                "sense_id": "40c1d163-2cc2-328c-93e6-c75c002794a7",
                                "text": "„Ich habe meine Erlebnisse und Gedanken festgehalten, zunächst in Schulheften, dann auf einzelnen Blättern.“"
                            },
                            {
                                "example_id": "df79d63d-7cd6-4be8-99ab-3d1b4f305342",
                                "sense_id": "40c1d163-2cc2-328c-93e6-c75c002794a7",
                                "text": "„Dann streckt sie mir ein Blatt Papier entgegen, aus einem Schulheft herausgerissen, wie man an der gezackten Perforierung sieht.“"
                            },
                            {
                                "example_id": "d57bb9b7-1650-4e95-b34d-b0977630da0a",
                                "sense_id": "40c1d163-2cc2-328c-93e6-c75c002794a7",
                                "text": "„Manchmal zeigt sie uns ihre Schulhefte und Zeichenblöcke.“"
                            },
                            {
                                "example_id": "ecb7f6f3-3f72-4116-9a19-fdc0f365b02a",
                                "sense_id": "40c1d163-2cc2-328c-93e6-c75c002794a7",
                                "text": "„Sie kritzelten in seine Schulhefte, und Schwester Angelika schlug ihn dafür mit dem Lineal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
