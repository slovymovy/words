                                                "text": "Национальная валюта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8adecf6-7ecc-3e71-ad5e-b89b0fd42c4d",
                                        "entry_id": "0fee61b6-6290-3bb8-8230-dc2b6d2d4503",
                                        "glosses": [
