                "senses": [
                    {
                        "sense_id": "a2998975-9842-3c38-b0f4-db2216837dfd",
                        "entry_id": "81fe28c5-0252-3cd8-a611-1135632655ef",
                        "glosses": [
                            "Vertreter der Gattung der Birken aus der Familie der Birkengewächse mit hängenden Zweigen"
                        ],
                        "tags": [
                            "Betula",
                            "Betulaceae"
                        ],
                        "examples": [
                            {
                                "example_id": "75cf0111-b2de-4740-9711-d53d0edce61c",
                                "sense_id": "a2998975-9842-3c38-b0f4-db2216837dfd",
                                "text": "„Bei der Hängebirke ist die Krone des älteren Baumes durch die schlaff überhängenden Äste viel dichter und zierlicher als bei der Moorbirke, deren Äste besenartig aufrecht stehen.“"
                            },
                            {
                                "example_id": "d1193593-0004-427a-94af-c56befd5118a",
                                "sense_id": "a2998975-9842-3c38-b0f4-db2216837dfd",
                                "text": "„Ich ging zum Fenster und schaute hinab auf den Park, wo ein Gärtner damit beschäftigt war, unter einer Hängebirke ein Loch auszuheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
