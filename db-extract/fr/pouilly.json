                        "entry_id": "337816bd-8b7d-3b02-8f2f-cf6fb5632962",
                        "glosses": [
                            "Origine non précisée d’un vin blanc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec1bec1-7b35-41c0-94fd-298d6fabb164",
                                "sense_id": "1c2c87eb-2293-3f88-8355-28b4728bc00c",
                                "text": "Le vin blanc était rudement bon tout de même. C’était un petit vin blanc que Monsel faisait venir « de du côté de Pouilly ». Il possédait une telle chaleur que Bordeaux n’y put tenir et se leva d’un seul coup."
                            },
                            {
                                "example_id": "f5fcb46b-1604-4566-899a-477a0fa4a8aa",
                                "sense_id": "1c2c87eb-2293-3f88-8355-28b4728bc00c",
                                "text": "Un chaud contentement lui venait, grâce à cette demi-bouteille de Pouilly."
                            }
                        ]
                    }
