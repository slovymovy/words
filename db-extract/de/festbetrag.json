                        "examples": [
                            {
                                "example_id": "f71b7287-eadd-4e1a-a09d-17e8cef731eb",
                                "sense_id": "a9af691a-7cc6-31cf-9995-8986b354f96a",
                                "text": "„Verordnet ein Arzt ein Arznei- oder Hilfsmittel, dessen Preis über dem Festbetrag liegt, muss der Patient diese Differenz selbst übernehmen.“"
                            },
                            {
                                "example_id": "d65607ed-dc83-40a5-8e51-c362752e2b13",
                                "sense_id": "a9af691a-7cc6-31cf-9995-8986b354f96a",
                                "text": "„Sehhilfen gehören zu den Hilfsmitteln, deren Kosten von den gesetzlichen Krankenkassen nach bestimmten Richtlinien anteilig getragen werden, z. B. bis zu einem Festbetrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
