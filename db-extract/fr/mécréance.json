                "senses": [
                    {
                        "sense_id": "73e9d465-985c-3d50-be90-d54db8074357",
                        "entry_id": "3be54a33-2256-3ed0-a584-39f7ff7cb163",
                        "glosses": [
                            "Absence de croyance, de foi, en matière religieuse."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7ccf7e5f-54f2-4b2f-8c2d-09ac97300fde",
                                "sense_id": "73e9d465-985c-3d50-be90-d54db8074357",
                                "text": "Il me dit : comment la foi et la mécréance, le vrai et le faux peuvent-ils être réunis dans un seul cœur ?"
                            },
                            {
                                "example_id": "d2f408dc-b6a3-4c58-9da4-7b25692d893d",
                                "sense_id": "73e9d465-985c-3d50-be90-d54db8074357",
                                "text": "La France n’est-elle pas terre de la mécréance ? Nombril de la laïcité attentatoire à Dieu, selon les islamistes ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa9dc815-d0af-4e10-bea8-72abdf68ef34",
                        "source_entry_id": "3be54a33-2256-3ed0-a584-39f7ff7cb163",
                        "source_sense_id": "73e9d465-985c-3d50-be90-d54db8074357",
                        "source_sense_description": "Absence de croyance",
                        "target_lang_word": "Unglaube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unglaube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4553efba-f539-3b5d-9450-e01803e52205",
                                        "entry_id": "ca472cb6-3ec0-3103-9b0c-1253508e6787",
                                        "glosses": [
                                            "Ablehnung religiösen Glaubens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30726986-40a0-4a2f-bd7d-077c6a6d1743",
                                                "sense_id": "4553efba-f539-3b5d-9450-e01803e52205",
                                                "text": "„Er brauchte etwas Großes, Weites, in das er sich hinein begeben könnte, nachdem er in dem Zustand des Unglaubens kein Glück gefunden hatte.“"
                                            },
                                            {
                                                "example_id": "8b11debb-9177-4aca-bfe8-afa433845f07",
                                                "sense_id": "4553efba-f539-3b5d-9450-e01803e52205",
                                                "text": "„Nicht wenige bezahlten ihren Unglauben sogar mit dem Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "890fee71-a8fe-394e-8703-0e243deacbae",
                                        "entry_id": "ca472cb6-3ec0-3103-9b0c-1253508e6787",
                                        "glosses": [
                                            "Annahme, dass eine Aussage/Behauptung wahrscheinlich nicht zutrifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bbe27da-8bd8-40c9-aa7c-3f7ff64a3a0e",
                                                "sense_id": "890fee71-a8fe-394e-8703-0e243deacbae",
                                                "text": "„Sie spürte seine Nachgiebigkeit und seinen Unglauben; es waren die Spinngewebe, die sie wieder umwickeln und lähmen wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9cf163f-22b9-46d9-8a32-f086560a8ebe",
                        "source_entry_id": "3be54a33-2256-3ed0-a584-39f7ff7cb163",
