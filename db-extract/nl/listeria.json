                                        "sense_id": "495b962f-77d9-34f6-b5a6-e2afc30a84c6",
                                        "entry_id": "fafc8bcb-df18-3531-a97e-cd5473396a21",
                                        "glosses": [
                                            "Any rod-shaped, gram-positive bacterium, of the genus Listeria, especially those responsible for the bacterial infection listeriosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5940909b-daf5-4ff3-9f4b-ee70a1855dc6",
                                                "sense_id": "495b962f-77d9-34f6-b5a6-e2afc30a84c6",
                                                "text": "One of the main reasons fridge temperatures are recommend to be set at 5ºC is because of listeria. Listeria is a food poisoning bacterium that is psychrotrophic – in other words it likes cold temperatures. From the growth models, we know that listeria grows nearly twice as fast at 8°C as it does at 5°C, hence the recommended 5ºC, which helps keep us safe from listeria."
                                            },
                                            {
                                                "example_id": "440ec8b6-25d4-4724-8639-e11ccf572501",
                                                "sense_id": "495b962f-77d9-34f6-b5a6-e2afc30a84c6",
                                                "text": "Listeriosis is a foodborne disease caused by listeria bacteria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
