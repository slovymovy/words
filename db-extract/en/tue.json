    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e5296865-3f1b-3966-9482-5d15ce13d4b0",
                "word": "Tue",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "120cac74-a07c-3c90-99d0-1cee595a4c21",
                        "entry_id": "e5296865-3f1b-3966-9482-5d15ce13d4b0",
                        "glosses": [
                            "Alternative form of Tiu (the god Tyr)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "acaead2f-0121-46b5-86d8-49f9b54c82bf",
                                "sense_id": "120cac74-a07c-3c90-99d0-1cee595a4c21",
                                "text": "One feels that here the old pagan gods have come into their own again, the ones we acknowledge every day of the week without thinking — Tue, Woden, Thor and Freia; and certainly nature herself has reclaimed what was once a site cleared of vegetation."
                            },
                            {
                                "example_id": "ba3b4ebb-16d8-431a-83f4-08c4ac8f397f",
                                "sense_id": "120cac74-a07c-3c90-99d0-1cee595a4c21",
                                "text": "I remember this all took place on a Tuesday; the day of the great god 'Tue'. Honestly, that's who it's named after. If you don't believe me, go look it up. I have no idea what it was that Tue did exactly, but I'd say he or she was pretty lucky […]"
                            },
                            {
                                "example_id": "88ff5859-58d2-43bc-83ab-41a60196f29c",
                                "sense_id": "120cac74-a07c-3c90-99d0-1cee595a4c21",
                                "text": "\"If he can't mention Tue, Woden, Thor and Frig, how is he going to pronounce the days of the week?\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
