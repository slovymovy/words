                                            {
                                                "example_id": "50fdbeff-c8a5-4995-9793-5dd0e5362728",
                                                "sense_id": "c598a5d0-32d3-341b-b0f5-bb99ac67ac73",
                                                "text": "Puis montons sur le pèse-personne, à cadran-loupe, toujours rangé sous la lucarne et qui depuis des années contrôle les kilos de la famille comme la toise, en forme de girafe, clouée en face sur le Ripolin, en a contrôlé les tailles."
                                            },
                                            {
                                                "example_id": "606222c6-6c8e-49b7-9877-bba5d79b1f7c",
                                                "sense_id": "c598a5d0-32d3-341b-b0f5-bb99ac67ac73",
                                                "text": "Paul Lalanne, le colosse soudeur, s'est fait mettre à l'ordre par son pèse-personne qui lui a dit: « Une seule personne à la fois sur la balance, SVP. »"
                                            }
