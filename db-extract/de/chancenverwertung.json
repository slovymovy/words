                "senses": [
                    {
                        "sense_id": "e12c90e8-d899-318b-892d-44831723a410",
                        "entry_id": "0b9d0e97-d172-3ca3-b2fb-691ad18e7621",
                        "glosses": [
                            "das erfolgreiche Nutzen von Möglichkeiten"
                        ],
