            "senses": [
                {
                    "sense_id": "44b3c72e-748c-3464-a21d-a6d9735fae07",
                    "sense_definition": "The direct line of descent from an ancestor to an individual, representing pedigree or ancestry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lineage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was proud of his royal <w>bloodline</w> and often spoke of his noble ancestors.",
                            "target_lang_translations": {
                                "es": "Estaba orgulloso de su <w>linaje</w> real y a menudo hablaba de sus nobles antepasados."
                            }
                        },
                        {
                            "text": "Historians were fascinated by the ancient family's unbroken <w>bloodline</w> over centuries.",
                            "target_lang_translations": {
                                "es": "Los historiadores estaban fascinados por la <w>línea de sangre</w> ininterrumpida de la antigua familia a lo largo de los siglos."
                            }
                        }
                    ],
                    "synonyms": [
                        "lineage",
                        "ancestry",
                        "pedigree"
                    ],
                    "common_phrases": [
                        "ancient bloodline",
                        "royal bloodline",
                        "family bloodline"
                    ],
                    "target_lang_definitions": {
