                "senses": [
                    {
                        "sense_id": "99477129-f59f-3105-b082-97f608579778",
                        "entry_id": "c97d0a9a-d050-31c9-bc55-3a2c7d3fa652",
                        "glosses": [
                            "weibliche Person, die einem Teilnehmer an einem Duell beratend und als Zeugin zur Seite steht"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "23496324-bd6a-44d8-92de-59aa5546f441",
                                "sense_id": "99477129-f59f-3105-b082-97f608579778",
                                "text": "Da niemand anderes zur Verfügung steht, übernimmt Rosa die Rolle der Sekundantin. Für das Schusstraining muss nun noch ein geeigneter Platz gefunden werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70344684-25c6-34c6-8c24-99e9d1935d4d",
                        "entry_id": "c97d0a9a-d050-31c9-bc55-3a2c7d3fa652",
                        "glosses": [
                            "Beraterin, Betreuerin bei einem Wettkampf"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "aed987c3-dd25-457f-b700-e2b7f02a5d1d",
                                "sense_id": "70344684-25c6-34c6-8c24-99e9d1935d4d",
                                "text": "Der Schachweltmeister spielte eine Übungspartie nach und ließ sich von seiner Freundin und Sekundantin, einer geborenen Ungarin, die Zeitungsberichte vorlesen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "24bf2a4b-491a-37c1-8ddb-4482fe8aa00e",
                        "entry_id": "c97d0a9a-d050-31c9-bc55-3a2c7d3fa652",
                        "glosses": [
                            "helfende Kraft"
                        ],
