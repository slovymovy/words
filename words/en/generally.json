                                "nl": "Ze beschreef het project <w>in grote lijnen</w> zonder in te gaan op de technische kosten.",
                                "pl": "Opisała projekt <w>ogólnie</w>, nie wchodząc w szczegóły kosztów technicznych.",
                                "de": "Sie beschrieb das Projekt <w>allgemein</w>, ohne auf die technischen Kosten einzugehen.",
                                "fr": "Elle a décrit le projet <w>dans l'ensemble</w> sans entrer dans les détails des coûts techniques.",
                                "it": "Ha descritto il progetto <w>a grandi linee</w> senza entrare nei costi tecnici.",
                                "cs": "Projekt popsala <w>v hrubých rysech</w>, aniž by zacházela do technických nákladů.",
                                "tr": "Projeyi teknik maliyetlere girmeden <w>genel hatlarıyla</w> anlattı.",
                                "es": "Ella describió el proyecto <w>a grandes rasgos</w> sin entrar en los costes técnicos."
                            }
                        },
                        {
