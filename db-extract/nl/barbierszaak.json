                "senses": [
                    {
                        "sense_id": "0d1a64b4-ba82-33ca-a4f5-70836465773a",
                        "entry_id": "b45119e9-7995-3bcb-a764-c8c994209d23",
                        "glosses": [
                            "kapsalon voor heren"
