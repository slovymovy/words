                "senses": [
                    {
                        "sense_id": "002f45b0-1ec0-371f-a24b-fe3cebc5e1a6",
                        "entry_id": "89495c0d-7dd1-334a-8393-cccd739d2453",
                        "glosses": [
                            "Déclin du jour, crépuscule."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "fc08b732-7319-466f-a9db-b7585c409536",
                                "sense_id": "002f45b0-1ec0-371f-a24b-fe3cebc5e1a6",
                                "text": "Assis à même le sol parmi les ombres qui s'allongeaient dans la brunante, le trio réchauffait quelques lanières de viande d'orignal séchée au-dessus des flammes."
                            },
                            {
                                "example_id": "a9af4666-e6f0-48a8-9ab0-eb997986713c",
                                "sense_id": "002f45b0-1ec0-371f-a24b-fe3cebc5e1a6",
                                "text": "Dans la brunante, les amas d’ordures prennent des formes étranges."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4692bfe0-5dd3-4084-b430-636ccc57267b",
                        "source_entry_id": "89495c0d-7dd1-334a-8393-cccd739d2453",
                        "source_sense_id": "002f45b0-1ec0-371f-a24b-fe3cebc5e1a6",
                        "target_lang_word": "dusk",
                        "target_lang_code": "en",
