                ],
                "senses": [
                    {
                        "sense_id": "84029615-0a1f-3d62-b24a-888092ecd190",
                        "entry_id": "893ba159-f855-3c62-b1b2-aa9cc8df6ac4",
                        "glosses": [
                            "in der Hoffnung, es wird gut werden"
                        ],
                        "tags": [
                            "aufs Geratewohl"
                        ],
                        "examples": [
                            {
                                "example_id": "c4dedf3c-2e28-4733-9aae-8dede37ec381",
                                "sense_id": "84029615-0a1f-3d62-b24a-888092ecd190",
                                "text": "Aufs Geratewohl wählte er einen Beruf, nur weil seine Mutter wollte, dass er sich jetzt entscheidet."
                            },
                            {
                                "example_id": "03c44f7d-2bb5-40a2-bbf9-eeeb55caa71b",
                                "sense_id": "84029615-0a1f-3d62-b24a-888092ecd190",
                                "text": "„Sie gingen aufs Geratewohl weiter, aber es dauerte eine ganze Weile, sich durchzuschlängeln, und sie mussten viele Umwege nehmen, wenn es plötzlich nicht mehr weiterging.“"
                            },
                            {
                                "example_id": "da29821a-190f-4a8b-91f7-63e9e9e0aa16",
                                "sense_id": "84029615-0a1f-3d62-b24a-888092ecd190",
                                "text": "„Ich ging aufs Geratewohl die Straße entlang, um ein Wäschegeschäft zu suchen; denn nach einem solchen mich erkundigen wollte ich nicht; schließlich fand ich das Gewünschte.“"
                            },
                            {
                                "example_id": "4b036664-b454-4b56-bc1b-7047967cd200",
                                "sense_id": "84029615-0a1f-3d62-b24a-888092ecd190",
                                "text": "„Man nimmt aufs Geratewohl einen Titel her und leitet ein Ereignis davon ab; man entwickelt ein Sprichwort; man verflicht mehrere Abenteuer zu einem einzigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
