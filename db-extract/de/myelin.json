                                    {
                                        "sense_id": "36c9899a-0b4b-3911-9875-ceefa579063b",
                                        "entry_id": "64240b26-050d-38f3-b5be-d509ccd8ef5c",
                                        "glosses": [
                                            "A white, fatty material, composed of lipids and lipoproteins, that surrounds the axons of nerves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fae1748-1e4e-4db4-b5c6-1a293f3649fc",
                                                "sense_id": "36c9899a-0b4b-3911-9875-ceefa579063b",
                                                "text": "As the result of prolonged action of water upon myelin, bird's-nests-cells are also said to be produced, and we are certain we have seen, as the result of such prolonged action of water, the appearances thus compared."
                                            },
                                            {
                                                "example_id": "a54f255e-6b24-4dc3-90da-fbd8089b6330",
                                                "sense_id": "36c9899a-0b4b-3911-9875-ceefa579063b",
                                                "text": "This gene controls the production of an insulating sleeve that wraps around neurons. Known as myelin, it is crucial for long-range communication in the brain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ae73de9-4e83-4877-b55c-383e17485fe3",
                        "source_entry_id": "c0155c70-49ba-3306-a6d7-4c599cb11be9",
