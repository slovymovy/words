{
    "word_family": [
        "bespeak"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76c5887c-3d65-3fc4-be90-9e95a2894f89",
                    "sense_definition": "Made or done in a way adjusted to the needs of a specific person or group, often specialized or unique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "customization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy businessman ordered a <w>bespoke</w> suit from a famous tailor in London.",
                            "target_lang_translations": {
                                "ru": "Богатый бизнесмен заказал костюм, <w>сшитый на заказ</w>, у известного портного в Лондоне."
                            }
                        },
                        {
                            "text": "Our company provides <w>bespoke</w> software solutions tailored to the specific needs of each client.",
                            "target_lang_translations": {
                                "ru": "Наша компания предоставляет <w>индивидуальные</w> программные решения, адаптированные под конкретные нужды каждого клиента."
                            }
                        }
                    ],
                    "synonyms": [
                        "custom"
                    ],
                    "antonyms": [
                        "mass-produced",
                        "ready-made",
                        "standard"
                    ],
                    "common_phrases": [
                        "bespoke suit",
                        "bespoke software",
                        "bespoke service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный или выполненный с учетом потребностей конкретного человека или группы, часто специализированный или уникальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделанный на заказ",
                                "target_lang_sense_clarification": "индивидуально изготовленный"
                            },
                            {
                                "target_lang_word": "индивидуальный",
                                "target_lang_sense_clarification": "адаптированный под конкретные нужды"
                            },
                            {
                                "target_lang_word": "эксклюзивный",
                                "target_lang_sense_clarification": "уникальный и специализированный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af3b40c7-64c5-364f-99a6-24184ab0dec1",
                    "sense_definition": "Relating to a person or business that makes custom-made products, especially high-quality clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "customization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He visited a <w>bespoke</w> tailor to ensure his wedding outfit would fit perfectly.",
                            "target_lang_translations": {
                                "ru": "Он посетил портного, <w>шьющего на заказ</w>, чтобы его свадебный наряд сидел идеально."
                            }
                        },
                        {
                            "text": "The city is known for its <w>bespoke</w> shoemakers who have practiced the craft for generations.",
                            "target_lang_translations": {
                                "ru": "Город известен своими сапожниками, работающими по <w>индивидуальным заказам</w>, которые занимаются этим ремеслом на протяжении многих поколений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bespoke tailor",
                        "bespoke shoemaker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к человеку или бизнесу, который производит товары на заказ, особенно высококачественную одежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шьющий на заказ",
                                "target_lang_sense_clarification": "о портном или ателье"
                            },
                            {
                                "target_lang_word": "индивидуального пошива",
                                "target_lang_sense_clarification": "о мастере или мастерской"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12d387a0-b940-3b88-8c07-2f20949c0a30",
                    "sense_definition": "Simple past of <w>bespeak</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bespeak_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His elegant manners <w>bespoke</w> a very sophisticated upbringing in the countryside.",
                            "target_lang_translations": {
                                "ru": "Его элегантные манеры <w>свидетельствовали</w> о весьма утонченном воспитании в сельской местности."
                            }
                        },
                        {
                            "text": "The quiet atmosphere in the room <w>bespoke</w> a sense of deep sadness among the guests.",
                            "target_lang_translations": {
                                "ru": "Тихая атмосфера в комнате <w>говорила</w> о чувстве глубокой печали среди гостей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола bespeak (свидетельствовать о чем-либо, указывать на что-либо)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельствовал",
                                "target_lang_sense_clarification": "указывал на наличие какого-либо качества"
                            },
                            {
                                "target_lang_word": "говорил о",
                                "target_lang_sense_clarification": "служил признаком чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65788f53-eb05-301b-be3c-b0942018465e",
                    "sense_definition": "Past participle of <w>bespeak</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bespeak_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quality of the work had <w>bespoke</w> his dedication to the project long before it was finished.",
                            "target_lang_translations": {
                                "ru": "Качество работы <w>свидетельствовало</w> о его преданности проекту задолго до его завершения."
                            }
                        },
                        {
                            "text": "Every detail of the house had <w>bespoke</w> the architect's unique vision and style.",
                            "target_lang_translations": {
                                "ru": "Каждая деталь дома <w>отражала</w> уникальное видение и стиль архитектора."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени глагола bespeak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельствовал",
                                "target_lang_sense_clarification": "в контексте завершенного указания на признак"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}