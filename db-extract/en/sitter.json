                    {
                        "sense_id": "720612be-89de-3b5a-8720-b3807a5fc728",
                        "entry_id": "c5f4e395-e55e-36b7-a74e-4768b5bd8857",
                        "glosses": [
                            "Modèle, sujet, personne posant pour un portrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b62be7-8a98-4698-88b5-06f437dabb20",
                                "sense_id": "720612be-89de-3b5a-8720-b3807a5fc728",
                                "text": "She always hopes to imbue a portrait with the sitter’s character.",
                                "translation": "Elle espère toujours imprégner un portrait de la personnalité de son modèle."
                            }
                        ]
                    },
                    {
                        "sense_id": "b010f029-0b39-3020-8863-c7e154670cb4",
                        "entry_id": "c5f4e395-e55e-36b7-a74e-4768b5bd8857",
                        "glosses": [
                            "Personne qui s’occupe d’une personne malade ou des biens, des enfants, des animaux de compagnie d’une personne absente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450d4504-e9c4-4177-be79-7718c1ce33ce",
                                "sense_id": "b010f029-0b39-3020-8863-c7e154670cb4",
                                "text": "It's always such a pain to get a sitter on short notice.",
                                "translation": "C’est toujours si dur de trouver une nourrice au dernier moment."
                            }
                        ]
                    }
