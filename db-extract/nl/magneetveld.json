                    },
                    {
                        "translation_id": "e5b39a19-3975-412a-94f9-22b508606e09",
                        "source_entry_id": "c922a03a-8ce8-30a3-be7f-750609b46f37",
                        "source_sense_id": "517816be-a0b2-345f-867d-a38962058e7f",
                        "target_lang_word": "Magnetfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnetfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c072aa9-f1a4-354c-94a5-ca6755ce4ddc",
                                        "entry_id": "48000a66-76bd-3e7b-83e3-d3f02f2dc8df",
                                        "glosses": [
                                            "magnetisches Feld, das durch Magneten, elektrische Ströme oder durch zeitliche Änderung eines elektrischen Feldes entstehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e3540a-e2e0-42c2-9a9a-dbaae9369fa4",
                                                "sense_id": "6c072aa9-f1a4-354c-94a5-ca6755ce4ddc",
                                                "text": "„Normalerweise sind die Nordlichter wegen des gebogenen Magnetfeldes nur in der Nähe der Pole, also zum Beispiel über Schweden und Norwegen, zu sehen.“"
                                            },
                                            {
                                                "example_id": "17b887ce-751f-430f-91fc-36524c4f9038",
                                                "sense_id": "6c072aa9-f1a4-354c-94a5-ca6755ce4ddc",
                                                "text": "„Seit den Apollo-Missionen kennt man magnetisiertes Mondgestein, der Mond muss also in seiner Anfangszeit vor rund vier Milliarden Jahren ein Magnetfeld besessen haben.“"
                                            },
                                            {
                                                "example_id": "a998c277-5aec-4de2-8948-b913cdb253a3",
                                                "sense_id": "6c072aa9-f1a4-354c-94a5-ca6755ce4ddc",
                                                "text": "„Diese explodierten, sobald sie eine bestimmte Wassertiefe erreicht hatten, bei manchen sprach der Zünder auch auf das Magnetfeld des Unterseebootes an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fbd4717-387b-4562-8e0c-750ee04ec44b",
                        "source_entry_id": "c922a03a-8ce8-30a3-be7f-750609b46f37",
                        "source_sense_id": "517816be-a0b2-345f-867d-a38962058e7f",
                        "target_lang_word": "magnetic field",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetic field",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2575cdf8-41f5-35f2-aec8-c5cf8459fc38",
                                        "entry_id": "e291e925-4894-3d01-bdde-6a176420ed25",
                                        "glosses": [
                                            "A condition in the space around a magnet or electric current in which there is a detectable magnetic force and two magnetic poles are present."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "824745f6-696d-4e0e-9be4-39e9ff060a69",
                                                "sense_id": "2575cdf8-41f5-35f2-aec8-c5cf8459fc38",
                                                "text": "David (1904) and Brunhes (1906) first observed magnetizations in lava flows that were roughly opposed to that of the present earth's magnetic field."
                                            },
                                            {
                                                "example_id": "fdb5dc9f-f25e-43dd-a797-bc5f2a344956",
                                                "sense_id": "2575cdf8-41f5-35f2-aec8-c5cf8459fc38",
                                                "text": "1996, V. R. Khalilov, Electron Strong Magnetic Field, [1988, V. R. Khalilov, Elektroni v silnom magnetom poli, Energoatomizdat, Moscow], Gordon and Breach Science Publishers, page 123,\nIn contrast to the IQHE, the fractional quantum Hall effect occurs in much stronger magnetic fields, and in this case electrons cannot be considered as noninteracting ones."
                                            },
                                            {
                                                "example_id": "e01c5616-925c-451f-9109-8ab9984a1000",
                                                "sense_id": "2575cdf8-41f5-35f2-aec8-c5cf8459fc38",
                                                "text": "The magnetic field B bears the same relation to a hypothetical magnetic charge m as the electric field bears to the electric charge q, so the development of the previous chapter can be taken over completely. The stress tensor for a magnetic field Bᵢ is identical in form to that for the electric field. The energy density is obviously B²/8π and the magnetic field is a physical reality just like the electric field. Electric and magnetic fields superpose linearly[…]. This is perhaps a convenient place to remark that a magnetic field exerts no force whatever on an electric charge."
                                            },
                                            {
                                                "example_id": "f9697f3c-8f33-4b11-b8cc-ff8c2b69b8bf",
                                                "sense_id": "2575cdf8-41f5-35f2-aec8-c5cf8459fc38",
                                                "text": "The turian homeworld, Palaven, has a metal-poor core, generating a weak magnetic field and allowing more solar radiation into the atmosphere."
                                            },
                                            {
                                                "example_id": "e13d7672-3fd8-4b56-9384-0fbb7482d178",
                                                "sense_id": "2575cdf8-41f5-35f2-aec8-c5cf8459fc38",
                                                "text": "The scientific instruments of the day recorded rapid fluctuations in the Earth's magnetic field, as powerful electrical currents flowed through the upper atmosphere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dac1a4-96bc-3b10-8d82-db1a7dcaf1be",
                                        "entry_id": "e291e925-4894-3d01-bdde-6a176420ed25",
                                        "glosses": [
                                            "A condition in the space around a magnet or electric current in which there is a detectable magnetic force and two magnetic poles are present.",
                                            "B-field."
                                        ],
                                        "tags": [
                                            "modern"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "227d56cf-8490-3af5-8c10-caa3fcbe7ff1",
                                        "entry_id": "e291e925-4894-3d01-bdde-6a176420ed25",
                                        "glosses": [
                                            "A condition in the space around a magnet or electric current in which there is a detectable magnetic force and two magnetic poles are present.",
                                            "H-field."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6d51105-a241-4282-b065-5ec3adffaea3",
                        "source_entry_id": "c922a03a-8ce8-30a3-be7f-750609b46f37",
                        "source_sense_id": "517816be-a0b2-345f-867d-a38962058e7f",
                        "target_lang_word": "champ magnétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "champ magnétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6df652c-5844-317c-84b4-e40f5091ca76",
                                        "entry_id": "36bcf22b-161a-306b-a9af-0e3915a39843",
                                        "glosses": [
                                            "Espace où s’exercent des actions magnétiques."
                                        ],
                                        "tags": [
                                            "Magnétisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "941e1fd6-2a62-349f-b106-157ea5d27a9d",
                                        "entry_id": "36bcf22b-161a-306b-a9af-0e3915a39843",
                                        "glosses": [
                                            "Espace où s’exercent des actions magnétiques.",
                                            "Champ B. Champ de force exprimé en teslas (T), qui donne la force de Lorentz sur les charges électriques en mouvement."
                                        ],
                                        "tags": [
                                            "Magnétisme",
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185fe494-18d4-47fb-921d-ff8a777b666a",
                                                "sense_id": "941e1fd6-2a62-349f-b106-157ea5d27a9d",
                                                "text": "Nous allons maintenant définir un vecteur champ magnétique B (parfois appelé induction magnétique ou densité du flux magnétique) en un point de l’espace au moyen de la force magnétique exercée sur un corps-test approprié."
                                            },
                                            {
                                                "example_id": "4289a254-5417-4c8b-b6d1-f69c5a244cad",
                                                "sense_id": "941e1fd6-2a62-349f-b106-157ea5d27a9d",
                                                "text": "Dans ces régions, le champ magnétique terrestre est presque vertical, et par convention internationale, on considère que lorsque la composante horizontale de ce champ magnétique est inférieure à 6 microteslas, les boussoles et compas magnétiques ne doivent pas être utilisés, car trop peu fiables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "565460d1-06d8-3178-920d-5bb4da0f29d0",
                                        "entry_id": "36bcf22b-161a-306b-a9af-0e3915a39843",
                                        "glosses": [
                                            "Espace où s’exercent des actions magnétiques.",
                                            "Champ H. Champ de force exprimé en ampères par mètre (A/m), historiquement considéré comme champ créé par le charge magnétique et aujourd’hui considéré comme différence du champ B et la magnétisation du matériau."
                                        ],
                                        "tags": [
                                            "Magnétisme",
                                            "Moins courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a6867c-968f-41f9-bf7f-aaf9580f8d8a",
                                                "sense_id": "565460d1-06d8-3178-920d-5bb4da0f29d0",
                                                "text": "L’effet galvanomagnétique, appelé aussi effet Goldhammer-Thomson, se traduit par un accroissement de la résistance électrique de la substance ferromagnétique placée dans un champ magnétique longitudinal et par une diminution de cette résistance électrique lorsque le champ magnétique est transversal."
                                            },
                                            {
                                                "example_id": "d86d18ee-551e-412e-ac87-478f5cc7a82a",
                                                "sense_id": "565460d1-06d8-3178-920d-5bb4da0f29d0",
                                                "text": "La description macroscopique des phénomènes magnétiques requiert deux champs de vecteurs, le champ magnétique H et l’induction magnétique B."
                                            },
                                            {
                                                "example_id": "7419c4e4-4868-4eaa-b79b-6d30639377fe",
                                                "sense_id": "565460d1-06d8-3178-920d-5bb4da0f29d0",
                                                "text": "La Commission Électrotechnique Internationale recommande de désigner par B l’induction magnétique et par H le champ magnétique. Dans cet ouvrage, nous utiliserons également les termes de « champ B » et de « champ H » pour désigner ces deux quantités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "941856ab-3a4b-34e7-b2b5-2293f8dc4c5a",
                                        "entry_id": "36bcf22b-161a-306b-a9af-0e3915a39843",
                                        "glosses": [
                                            "Entourage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582bd9d4-18ee-4b88-abbc-77ec373f4b12",
                                                "sense_id": "941856ab-3a4b-34e7-b2b5-2293f8dc4c5a",
                                                "text": "On sait que les familles Rousseau et Jarry, lavaloises toutes deux, étaient liées de longue date quand le jeune Alfred, khâgneux du lycée Henry-IV, polygraphe génial, entra dans le champ magnétique d'un peintre qui avait l’âge de son père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
