                    }
                ],
                "senses": [
                    {
                        "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                        "entry_id": "5f2a2652-1521-3ff3-ae9f-8a35c75a910f",
                        "glosses": [
                            "Druckwesen: Person, die einen vorgegebenen Text für den Druck vorbereitet, Kurzwort für Schriftsetzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e15adb9a-77b9-4d39-9447-ceba9c835155",
                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                "text": "„Münzer hatte sich von einem Setzer, der nach Hause ging, das Blatt bringen lassen, um zu prüfen, ob alles in Ordnung sei.“"
                            },
                            {
                                "example_id": "f7061d82-6299-4818-96a8-9526da9dafcb",
                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                "text": "„Stuff selbst hatte berichten müssen von dem Angriff auf Gareis, der auf einer Wiese explodierten Bombe, von dem vorläufig unaufgeklärten Überfall auf einen Setzer in der Redaktion der »Bauernschaft«, von den Bauernverhaftungen.“"
                            },
                            {
                                "example_id": "1f2bbcf7-363f-496a-8a24-c2b89e90c612",
                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                "text": "„Dies ist leicht erklärlich, hatte der Setzer doch den Satzspiegel stets vor Augen, so dass Umbruchfehler nur bei grober Nachlässigkeit hätten vorkommen können.“"
                            },
                            {
                                "example_id": "4542f8f8-e765-40d2-a017-17cc41949ade",
                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                "text": "„Der Hintergrund war der, dass die Kollekte eines gesamten Monats auf Abwege geraten war, während sie sich in der Obhut des Setzers befand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52620927-4bac-4dad-8abe-e5ede18157ea",
                        "source_entry_id": "5f2a2652-1521-3ff3-ae9f-8a35c75a910f",
                        "source_sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                        "source_sense_description": "Person, die einen vorgegebenen Text für den Druck vorbereitet",
                        "target_lang_word": "typesetter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typesetter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f2effa-c26d-31a5-9fea-793f1fd80eac",
                                        "entry_id": "943a2e44-a723-36bb-a862-741d3be072b3",
                                        "glosses": [
                                            "A person who sets type; an employee in a printshop who manually selected pieces of movable type and assembled them for printing."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "575fc9ea-57f8-4af8-b25f-b0e04389633d",
                                                "sense_id": "f8f2effa-c26d-31a5-9fea-793f1fd80eac",
                                                "text": "It’s hard to say who has the longest name in history, but a Philadelphia-area typesetter from the early 1900s chose a very long name for himself. Known, among other things, as Hubert Blaine Wolfe+590, Sr., his name has been published in many different forms since."
                                            },
                                            {
                                                "example_id": "a994dd29-c874-4378-88a3-c532e7cc0726",
                                                "sense_id": "f8f2effa-c26d-31a5-9fea-793f1fd80eac",
                                                "text": "My writing all took place over weekends, and because I only lived about ten miles away, Peter would hot-foot it to my home on a Monday morning to collect a large parcel of hand-typed sheets of copy, for despatch to the typesetters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e32b93-fb67-3ba9-afe4-1db9c0c6191f",
                                        "entry_id": "943a2e44-a723-36bb-a862-741d3be072b3",
                                        "glosses": [
                                            "A machine that combines type in the correct order for printing."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99b101d1-a0eb-46ac-816c-b0a586f8125b",
                        "source_entry_id": "5f2a2652-1521-3ff3-ae9f-8a35c75a910f",
                        "source_sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                        "source_sense_description": "Person, die einen vorgegebenen Text für den Druck vorbereitet",
                        "target_lang_word": "compositor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compositor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b912d578-ee26-36d7-9473-586a3f95635c",
                                        "entry_id": "8702336d-9102-38d2-b16d-3f89fd3fe561",
                                        "glosses": [
                                            "A person who sets type; a typesetter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97438efc-4aa9-48f8-859c-119ab2e7617f",
                                                "sense_id": "b912d578-ee26-36d7-9473-586a3f95635c",
                                                "text": "Thus, when he drew up instructions in lawyer language […] his clerks […] understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there."
                                            },
                                            {
                                                "example_id": "3ce0a0fb-b802-4c82-8a1e-eb39afd5c86d",
                                                "sense_id": "b912d578-ee26-36d7-9473-586a3f95635c",
                                                "text": "All Spaniards, we discovered, knew two English expressions. One was 'O.K., baby', the other was a word used by the Barcelona whores in their dealings with English sailors, and I am afraid the compositors would not print it."
                                            },
                                            {
                                                "example_id": "6eab2e57-75f5-4504-a74c-5091ea280fad",
                                                "sense_id": "b912d578-ee26-36d7-9473-586a3f95635c",
                                                "text": "However late medieval copyists were supervised — and controls were much more lax than many accounts suggest — scribes were incapable of committing the sort of \"standardized\" error that was produced by a compositor who dropped the word \"not\" from the Seventh Commandment and thus created the \"wicked\" Bible of 1631."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612dee49-0ce7-3daa-b66b-dacf28bbdd72",
                                        "entry_id": "8702336d-9102-38d2-b16d-3f89fd3fe561",
                                        "glosses": [
                                            "One who, or that which, composes or sets in order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16685826-282e-425e-801a-b81ae1265f1b",
                                                "sense_id": "612dee49-0ce7-3daa-b66b-dacf28bbdd72",
                                                "text": "I work as an image compositor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b09dff6f-1dc8-3ae3-829f-613fcf446a69",
                                        "entry_id": "8702336d-9102-38d2-b16d-3f89fd3fe561",
                                        "glosses": [
                                            "A system that puts images together in a buffer (such as individual windows on a desktop) to generate a final display image."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1488cd36-2265-4b3f-95d2-e918e177c8fc",
                        "source_entry_id": "5f2a2652-1521-3ff3-ae9f-8a35c75a910f",
                        "source_sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                        "source_sense_description": "Person, die einen vorgegebenen Text für den Druck vorbereitet",
                        "target_lang_word": "typographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9475f87-bbff-3f8a-a431-cafafae6db70",
                                        "entry_id": "d7d5ce44-e5f6-3f1a-8436-7fa20f00e329",
                                        "glosses": [
                                            "Celui ou celle qui connaît, qui exerce l’art de la typographie."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1dd5bf0-5ca8-4cff-afd7-706b7d570065",
                                                "sense_id": "a9475f87-bbff-3f8a-a431-cafafae6db70",
                                                "text": "il s’agissait d’une typographe qui vint se plaindre à lui d’une douleur dans le côté qui, lorsqu’elle en souffrait, lui semblait devoir la faire mourir."
                                            },
                                            {
                                                "example_id": "9b247edc-7f52-4ced-8935-a9f2e5443fb9",
                                                "sense_id": "a9475f87-bbff-3f8a-a431-cafafae6db70",
                                                "text": "À sa propagande de quartier, il alliait une action incessante dans les ateliers du boulevard Masséna. Il avait puissamment resserré les liens moraux qui unissaient à la C. G. T. les typographes, les minervistes et les relieurs de Delaborde."
                                            },
                                            {
                                                "example_id": "bd2c167d-ef4e-40c7-93f2-809405e6ab9e",
                                                "sense_id": "a9475f87-bbff-3f8a-a431-cafafae6db70",
                                                "text": "Un jour, un copain lui conseille de se faire engager comme linotypiste – metteur en pages dans un journal. Sa formation de typographe lui sera utile. Il lui faudra seulement maîtriser une machine révolutionnaire, venue des États-Unis, qui réalise instantanément les lignes de plomb fondu qui seront imprimées sur le papier […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "typographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bc156f3-596c-3bfb-98cc-6570d6c2ded5",
                                        "entry_id": "dab45fd1-1f26-377f-9a9b-ef36f7b755d5",
                                        "glosses": [
                                            "Scolyte (Ips typographus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dc8947-5d29-4d32-a336-0953728a2525",
                                                "sense_id": "0bc156f3-596c-3bfb-98cc-6570d6c2ded5",
                                                "text": "L’hylésine est un scolyte, tout comme le typographe, dont on connaît les ravages sur les épicéas."
                                            },
                                            {
                                                "example_id": "e8f8ba7b-e34e-4ffd-862a-c7ac07c341e6",
                                                "sense_id": "0bc156f3-596c-3bfb-98cc-6570d6c2ded5",
                                                "text": "Elle fait partie de la dynamique normale de la forêt et participe à sa régénération. Białowieża constitue une des limites sud de l’aire de peuplement naturel de l’épicéa, qui est poussé vers le nord par le réchauffement climatique. Le stress hydrique prédispose les arbres à l’invasion des « typographes » : c’est donc hors de l’aire de peuplement naturel de l’épicéa que les attaques des scolytes sont les plus virulentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
