                    {
                        "translation_id": "078e3334-37ec-4a5e-9937-e10fef66a690",
                        "source_entry_id": "addabce0-2f41-3cb3-87fe-fac5a999199b",
                        "source_sense_id": "23d2f7d8-8c29-3ef8-89f9-d22d6f5131b1",
                        "source_sense_description": "mosque tower",
                        "target_lang_word": "minaret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                        "entry_id": "9c44e287-c9e1-3b53-b897-b5d8fcd8e715",
                                        "glosses": [
                                            "Tour d’une mosquée, d'une medersa du haut de laquelle les musulmans sont appelés à la prière par le muezzin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e1278d6-92f0-45fb-bb8c-6c00a508a89c",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Je demeurai une heure dans la grande rue, ayant pour récréation la vue d’un nid de cigogne planté sur une cheminée comme sur un minaret d’Athènes […]"
                                            },
                                            {
                                                "example_id": "41658e27-c91d-4ab5-90c2-abbb3c328b97",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Dominant tout, au sommet de la colline, une grande tour carrée, d’une blancheur tranchant sur les transparences ambiantes et qui scintillait au milieu du jour, aveuglante, gardant le soir les derniers rayons rouges du couchant : le minaret de la zaouïya de Sidi Salem."
                                            },
                                            {
                                                "example_id": "43c309c9-1d8a-4770-b859-07ae06fe5f6c",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Les petites bannières blanches viennent de grimper au sommet des minarets, annonçant l’heure méridienne de l’oûli, quand nous passons sous la voûte sombre de la grande porto de Casablanca."
                                            },
                                            {
                                                "example_id": "41c2c095-b6fd-4b5d-ba76-cf2fe2350514",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Un minaret carré et trapu, qui se termine par une coupole reposant sur une base octogonale, domine la ville du Caire du haut de la montagne de Mokattam."
                                            },
                                            {
                                                "example_id": "5cdcb8d1-0b73-4e30-a0eb-d9567a0efadf",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Ils restèrent près de dix jours dans ce camp et, pour la plupart des hommes, l’oisiveté était devenue une drogue dure, rythmée par la litanie des appels à la prière qui s’élevaient du grand minaret de la médina."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7c38561-d699-3736-8836-490b411b7eeb",
                                        "entry_id": "6b18256c-fd80-3c6d-9257-9623099097f6",
                                        "glosses": [
                                            "Ancien terme qui désignait un puits de mine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada9786a-7234-462f-bbe1-58772ab8ea61",
                                                "sense_id": "e7c38561-d699-3736-8836-490b411b7eeb",
                                                "text": "Minaret : Puits ou trou qu’on a creusé pour tirer de la mine de fer."
                                            },
                                            {
                                                "example_id": "b11ff5a8-806e-4a00-ad9e-c91d9eb42083",
                                                "sense_id": "e7c38561-d699-3736-8836-490b411b7eeb",
                                                "text": "Ouvrier qui transporte la mine (minerai) au moyen d’une brouette sous le puits du minaret, par lequel on en doit faire l’extraction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a354ecc-8bf0-4766-9be9-1eca83ebb0cb",
                        "source_entry_id": "addabce0-2f41-3cb3-87fe-fac5a999199b",
                        "source_sense_id": "23d2f7d8-8c29-3ef8-89f9-d22d6f5131b1",
                        "source_sense_description": "mosque tower",
                        "target_lang_word": "Minarett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minarett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                        "entry_id": "436f6be5-1baa-303b-b87a-24fa55fa4e0c",
                                        "glosses": [
                                            "Turm an oder bei einer Moschee, von dem aus (früher) der Muezzin fünfmal täglich zum Gebet ruft (und der in modernen Moscheen heutzutage nur noch der traditionellen Zierde dient)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f7c7df-7098-44b1-bb5c-b9f6d9d784b2",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "Vom Minarett erklang der Ruf des Muezzins."
                                            },
                                            {
                                                "example_id": "61bffbc8-72d6-4313-902e-67e3951f8950",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Wir stiegen uns aufs Dach und sahen hinunter auf Damaskus mit seinen Minaretts und seinem Moscheegekuppel, und dies war es, was wir sahen:[…]“"
                                            },
                                            {
                                                "example_id": "6dd20105-affc-4dac-86ca-3271f1ab45df",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Vom nahen Minarett ertönt der Gesang des bärtigen Moslems, der dort Allah ehrt, und die zarten Wölkchen der Zigaretten kräuseln sich um die entschleierten Angesichter schwarzäugiger Türkinnen.“"
                                            },
                                            {
                                                "example_id": "70243c6c-81f1-4853-a67f-08d915b4a50f",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Die Grüppchen der Händler vermengen sich noch mit der Halqa (dem Zuschauerkreis) inmitten der umherstreichenden, einladenden Dampfschwaden aus den Küchen; das Minarett der Kutubiya wacht standhaft über die ewige Seligkeit der Toten und das getriebene Dasein der Lebenden.“"
                                            },
                                            {
                                                "example_id": "268f8f82-0af0-48d8-b405-7a1e65dcb35b",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Ein historisches Minarett in der irakischen Stadt Samarra ist nach Berichten von Augenzeugen durch eine Explosion beschädigt worden.“"
                                            },
                                            {
                                                "example_id": "908703ac-8b12-4579-9cc3-b8b455d50d97",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Der französische Außenminister Bernard Kouchner hat sich am Montag schockiert über das Ergebnis der Schweizer Volksabstimmung zum Bau von Minaretten gezeigt. \"Wenn man keine Minarette mehr bauen kann, dann bedeutet es, dass man eine Religion unterdrückt\", sagte Kouchner dem Sender […].“"
                                            },
                                            {
                                                "example_id": "0d730ec5-b19b-408d-b680-485b203c4499",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Die Schweizer hatten der Forderung nach einem Bauverbot für Minarette von zwei rechtspopulistischen Parteien am Sonntag mit mehr als 57 Prozent zugestimmt.“"
                                            },
                                            {
                                                "example_id": "fdff519d-b40b-4fda-a082-31ae2e1f2caa",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Entscheidungen wie der Schweizer Volksentscheid gegen den Bau neuer Minarette schürten eine krankhafte Furcht vor dem Islam und Vorurteile gegen Fremde in Europa, zitierte die amtliche Nachrichtenagentur IRNA das Außenministerium in Teheran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
