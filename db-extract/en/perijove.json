                        "glosses": [
                            "Periapsis around Jupiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2236b004-0d82-4112-9f73-64ca40a6e630",
                                "sense_id": "1d37dc45-fb52-3d3e-958e-dfce2ff7cad8",
                                "text": "It results, however, from what has been proved, that if the perijove be in conjunction, the disturbing force of s\" will render the apsides of s' regressive, and if the apojove be in conjunction, it will render that motion progressive. But since the motion of the apsides of s' is regressive, the perijove must be in conjunction."
                            },
                            {
                                "example_id": "3cee7e04-77b5-4fc9-a17b-a99ac44f7ad9",
                                "sense_id": "1d37dc45-fb52-3d3e-958e-dfce2ff7cad8",
                                "text": "It is interesting to integrate the orbit solutions backward to the 1992 perijove to see how closely the fragments come together."
                            },
                            {
                                "example_id": "c9035b2d-2a5e-4104-bec3-a4658b6a8dac",
                                "sense_id": "1d37dc45-fb52-3d3e-958e-dfce2ff7cad8",
                                "text": "Flybys that change the orbital period also rotate the line of apsides and change the perijove distance."
                            }
                        ]
                    }
