                                "target_lang_sense_clarification": "Dutch dairy dessert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b51f9af-cfa5-3d66-89ba-efccb4992cd7",
                    "sense_definition": "Verkorte vorm voor <w>vlaai</w>, een soort traditionele Limburgse taart",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gebak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het zuiden van het land trakteren ze graag op een stuk verse <w>vla</w> bij de koffie.",
                            "target_lang_translations": {
                                "en": "In the south of the country, they like to treat you to a slice of fresh <w>vlaai</w> with coffee."
                            }
                        },
                        {
                            "text": "Mijn oma bakt ieder weekend een heerlijke kersen <w>vla</w> voor de hele familie.",
                            "target_lang_translations": {
                                "en": "Every weekend, my grandma bakes a delicious cherry <w>tart</w> for the whole family."
                            }
                        }
                    ],
                    "traits": [
                        {
