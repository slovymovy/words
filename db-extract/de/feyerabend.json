                ],
                "senses": [
                    {
                        "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                        "entry_id": "501fbfaf-bfe1-3908-a506-c5c2e62e4b1c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2747e11c-dcf3-4c6d-8274-debe45b925e4",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Feyerabends kamen, sahen und siegten."
                            },
                            {
                                "example_id": "7db0e94b-273b-440a-80b4-4e1d79f3d5a3",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Frau Feyerabend ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ddf5dc8b-76c2-43d9-91ca-cc9a4db48e9e",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Herr Feyerabend wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0c41029a-c2c1-4512-8874-8603249a7d0b",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Die Feyerabends fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "04ac5acf-d6fb-4ce1-9d53-29a684188ab1",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Der Feyerabend trägt nie die Pullover, die die Feyerabend ihm strickt."
                            },
                            {
                                "example_id": "6a616da6-f9f7-4f26-b697-af32fed6b053",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feyerabend kommt, geht der Herr Feyerabend.“"
                            },
                            {
                                "example_id": "3fb2b75c-19a7-4f5e-bcd1-ccb0dfcfa53f",
                                "sense_id": "4d2d5b35-129f-3c9e-956b-2eb037600187",
                                "text": "Feyerabend kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
