        "nl-extract.jsonl": [
            {
                "entry_id": "39610a82-eb82-3e81-be0c-f899dd737fa0",
                "word": "retireren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0628f845-3b0b-397c-b0bc-8f43ee85fc07",
                        "entry_id": "39610a82-eb82-3e81-be0c-f899dd737fa0",
                        "glosses": [
                            "terugtrekken of vluchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e3a4388-e3a0-4c7a-bdb7-7b8cd0b6f330",
                                "sense_id": "0628f845-3b0b-397c-b0bc-8f43ee85fc07",
                                "text": "In het debat moest Van der Steur retireren, zoals hij dat in zijn eerste jaar aan het bewind al driemaal heeft moeten doen. Bij zijn kritiek op forensisch anatoom Maat, bij de kwalificatie van de foto van Volkert van der G., bij het debat over de Teevendeal; steeds was hij te snel en te stellig in zijn oordeel. Volgende week weer een Kamerdebat met Van der Steur. Hij moet niet nog eens klunzen."
                            }
                        ]
                    },
                    {
                        "sense_id": "608ae2a9-51c4-34fd-a8e9-d6a12d41407b",
                        "entry_id": "39610a82-eb82-3e81-be0c-f899dd737fa0",
                        "glosses": [
                            "zich terugtrekken"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "51d2bd97-7231-4de3-be44-41ffc3dee5c7",
                                "sense_id": "608ae2a9-51c4-34fd-a8e9-d6a12d41407b",
                                "text": "Enerzijds gispt hij het militair-industriële complex, dat onverdroten naar uitbreiding van de NAVO blijft streven, al heeft Europa meer belang bij een omzichtige houding tegenover Rusland. Anderzijds spreekt hij laatdunkend over de Russen die nu eens het Westen imiteren en zich dan weer retireren in slavofiele eigendunk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7157d06-23ca-40bf-a789-3923f256047f",
                        "source_entry_id": "39610a82-eb82-3e81-be0c-f899dd737fa0",
                        "target_lang_word": "retirer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retirer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325d37f7-c8bf-3ea8-82b5-e7891efa99dc",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Tirer à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32dad758-f146-4364-8a80-723ceddefeec",
                                                "sense_id": "325d37f7-c8bf-3ea8-82b5-e7891efa99dc",
                                                "text": "Le livre a été retiré à 5 000 exemplaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32188b70-1060-3fc8-b4b8-90a8515e42b7",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Ramener en arrière, ramener à soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f551b6dd-c803-4664-92a0-757c00ab2567",
                                                "sense_id": "32188b70-1060-3fc8-b4b8-90a8515e42b7",
                                                "text": "Retirer sa main, son bras, sa tête pour éviter un coup."
                                            },
                                            {
                                                "example_id": "fbe5abc1-6ed9-4da6-ab93-60952c1160cf",
                                                "sense_id": "32188b70-1060-3fc8-b4b8-90a8515e42b7",
                                                "text": "L’assassin retira son poignard ruisselant de sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Tirer une personne, une chose d’un lieu où elle avait été mise, où elle était entrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2441a0df-c6f1-48fb-b64f-6a96eba4a656",
                                                "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                                                "text": "Retirer un enfant du collège."
                                            },
                                            {
                                                "example_id": "07108354-acb1-40a1-9d6d-22594f6e9dd8",
                                                "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                                                "text": "Retirer un seau du puits."
                                            },
                                            {
                                                "example_id": "e7c00c19-3cb3-46bf-95d1-d3d47b5b2fdd",
                                                "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                                                "text": "Retirer de l’argent d’une banque."
                                            },
                                            {
                                                "example_id": "5bbff2ea-3aa8-489a-b64b-21b5aa754cb6",
                                                "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                                                "text": "Retirer la clef de la serrure."
                                            },
                                            {
                                                "example_id": "1b7c03fd-ea5a-4c02-a3c3-502591581da9",
                                                "sense_id": "7b1c81c0-639a-3559-b372-39190af15d6e",
                                                "text": "Retirer quelqu’un d’un mauvais pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Reprendre, enlever."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8752e9-fc11-476d-be6b-96b9c98b413d",
                                                "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                                                "text": "Ils avaient retiré leur tunique, posé leur épée à terre, et ils s’acharnaient superbement à la besogne."
                                            },
                                            {
                                                "example_id": "414ad589-24cd-4789-8fd4-0196e348c2c0",
                                                "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                                                "text": "Retirer quelque chose à quelqu’un."
                                            },
                                            {
                                                "example_id": "4fe40136-8d71-4d7f-974b-d0114cca5046",
                                                "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                                                "text": "Il lui a retiré sa confiance."
                                            },
                                            {
                                                "example_id": "4c06b870-be06-4e7d-826f-cc60bc3e8ebb",
                                                "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                                                "text": "Je retire ce que j’ai dit."
                                            },
                                            {
                                                "example_id": "bcf6c642-b79e-4705-ba0c-f2a9269d25b7",
                                                "sense_id": "10ec885b-e52f-3314-9527-e90b4562b9ca",
                                                "text": "Un récent rapport du Comité des parlementaires sur la sécurité nationale et le renseignement met en lumière les tentatives de la Chine et de l’Inde de manipuler le contenu médiatique canadien. Ces pays ont été accusés de financer des articles de presse non attribués, de payer des voyages pour des journalistes, de faire pression pour retirer certains articles, et de créer de faux comptes sur les réseaux sociaux pour diffuser de la désinformation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0eb02db-c848-3b12-81a0-55eecdfef59b",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Faire sortir de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332b22e0-7af2-4482-b685-3da6e8cda417",
                                                "sense_id": "b0eb02db-c848-3b12-81a0-55eecdfef59b",
                                                "text": "Retirer la paire de lunette de son étui."
                                            },
                                            {
                                                "example_id": "70a96f1c-b99c-4b4b-9445-23aef6210ffa",
                                                "sense_id": "b0eb02db-c848-3b12-81a0-55eecdfef59b",
                                                "text": "Retirer l’épée de son fourreau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f612bf5-2fc4-3e2a-8aa6-5fb81957684a",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "S’en aller ou s’éloigner d’un lieu."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608e1c17-2a71-49aa-9d9a-84714ceec451",
                                                "sense_id": "9f612bf5-2fc4-3e2a-8aa6-5fb81957684a",
                                                "text": "Le Saufconduit donné pour un tems marqué expire au bout du terme; & si le porteur ne s’est point retiré avant ce tems là, il peut être arrêté, & même puni."
                                            },
                                            {
                                                "example_id": "38086345-0b1d-4ec5-ac14-2757836fe5c6",
                                                "sense_id": "9f612bf5-2fc4-3e2a-8aa6-5fb81957684a",
                                                "text": "Puis, quand il me croit endormi, il se retire à pas de loup pour aller continuer son concert dans la tente de mes gens."
                                            },
                                            {
                                                "example_id": "eddaca2c-562e-4c5b-a0e9-1e9b8663da77",
                                                "sense_id": "9f612bf5-2fc4-3e2a-8aa6-5fb81957684a",
                                                "text": "Une jeune soubrette, […], emplit les verres, déposa sur le guéridon deux cendriers, une boite vierge d’abdullahs et se retira discrètement."
                                            },
                                            {
                                                "example_id": "3f00b2a0-52fc-4322-af6e-fadb054e414c",
                                                "sense_id": "9f612bf5-2fc4-3e2a-8aa6-5fb81957684a",
                                                "text": "D’ordinaire, à la fin de nos soupers frugaux (ce soir-là, soupe à l'oignon, les oignons de printemps étant de saison, et en dessert un pain perdu à sa manière), je me contentais de la remercier d'un signe de tête et me retirais dans ma chambre […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d6bdb5-7502-3b71-8137-311638f989a1",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Quitter la profession qu’on exerçait, le genre de vie qu’on menait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d695ff1-a33b-498c-be1a-534c9f6ab952",
                                                "sense_id": "64d6bdb5-7502-3b71-8137-311638f989a1",
                                                "text": "Il s’est retiré du barreau."
                                            },
                                            {
                                                "example_id": "88873aba-85c9-4cfc-9f1c-7bba9232a329",
                                                "sense_id": "64d6bdb5-7502-3b71-8137-311638f989a1",
                                                "text": "Il s’est retiré du monde."
                                            },
                                            {
                                                "example_id": "cd403a63-cb71-41e3-984c-f54d922895e7",
                                                "sense_id": "64d6bdb5-7502-3b71-8137-311638f989a1",
                                                "text": "Il s’est retiré des affaires."
                                            },
                                            {
                                                "example_id": "8c4a6d05-9dc8-48f8-bbbe-4ebef3ae7a78",
                                                "sense_id": "64d6bdb5-7502-3b71-8137-311638f989a1",
                                                "text": "Il avait travaillé là jusqu’à la cinquantaine, dans le dessein unique et fervent, comme presque tous les Français, en ce temps-là, de « se retirer », mot dont je suis bien surpris que si peu de gens perçoivent la résonance lugubre : démission, fuite, suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691425f2-a639-3afe-9d1d-ca220c990989",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Aller dans un lieu pour y établir sa retraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034f8379-433e-4158-9043-f5f40390daa0",
                                                "sense_id": "691425f2-a639-3afe-9d1d-ca220c990989",
                                                "text": "Arnhem est une très jolie ville d’environ soixante mille habitants, […]. C’était là que se retiraient avant la guerre et depuis longtemps les commerçants hollandais qui avaient fait fortune aux Indes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "252bf3f9-8c7c-34ad-8ddd-7a083b4ff9a1",
                                        "entry_id": "327df99c-dc73-3dcf-ad17-7e5dc0a93b34",
                                        "glosses": [
                                            "Se dit des eaux qui rentrent dans leur lit après avoir monté, après avoir débordé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a39c2a-cb33-41f4-a40f-f5220fe6bb78",
                                                "sense_id": "252bf3f9-8c7c-34ad-8ddd-7a083b4ff9a1",
                                                "text": "La rivière se retire."
                                            },
                                            {
                                                "example_id": "2318d4fc-b134-4f64-8ab8-8ae9afc11bb5",
                                                "sense_id": "252bf3f9-8c7c-34ad-8ddd-7a083b4ff9a1",
                                                "text": "Les eaux commencent à se retirer."
                                            },
                                            {
                                                "example_id": "65cea8db-73ee-4434-bb5a-dfe2e075686e",
                                                "sense_id": "252bf3f9-8c7c-34ad-8ddd-7a083b4ff9a1",
                                                "text": "La mer se retire fort loin dans cette baie à marée basse."
                                            },
                                            {
                                                "example_id": "0b352dfc-7990-4652-ba9b-4f8eb2e88ae1",
                                                "sense_id": "252bf3f9-8c7c-34ad-8ddd-7a083b4ff9a1",
                                                "text": "La mer se retire, elle est dans le reflux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
