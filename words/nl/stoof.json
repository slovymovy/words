                {
                    "sense_id": "bd9a39db-d45e-3234-9f33-5300627cba32",
                    "sense_definition": "Een toestel waarin een vuur brandt om een ruimte te verwarmen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verwarming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de hoek van de kamer stond een oude, gietijzeren <w>stoof</w> die de hele ruimte warm hield.",
                            "target_lang_translations": {
                                "en": "In the corner of the room stood an old, cast-iron <w>stove</w> that kept the entire space warm."
                            }
                        },
                        {
                            "text": "We moesten hout halen om de <w>stoof</w> brandend te houden tijdens de koude winternacht.",
                            "target_lang_translations": {
                                "en": "We had to fetch wood to keep the <w>stove</w> burning during the cold winter night."
                            }
                        }
                    ],
                    "synonyms": [
                        "kachel"
                    ],
                    "common_phrases": [
                        "warme stoof",
                        "oude stoof"
                    ],
                    "target_lang_definitions": {
                        "en": "An appliance in which a fire burns to heat a room."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stove",
                                "target_lang_sense_clarification": "heating appliance"
                            },
                            {
                                "target_lang_word": "heater",
                                "target_lang_sense_clarification": "device for warming a room"
                            }
                        ]
                    }
                },
                {
