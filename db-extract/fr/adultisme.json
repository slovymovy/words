                "senses": [
                    {
                        "sense_id": "6d81fa7d-ea09-3f71-a490-cd445aa58224",
                        "entry_id": "ac80d7cd-7422-373d-aabb-b89fb67e92e4",
                        "glosses": [
                            "Fait, pour un enfant ou un adolescent de se comporter comme un adulte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a18d93fc-ea28-4ca3-8686-e79ef6fec01f",
                                "sense_id": "6d81fa7d-ea09-3f71-a490-cd445aa58224",
                                "text": "L’adultisme conduit l'enfant maltraité à protéger le parent irresponsable et violent et à se donner ainsi une identité positive."
                            },
                            {
                                "example_id": "a7f83a1b-7c86-4190-8065-cf8a8faccdc0",
                                "sense_id": "6d81fa7d-ea09-3f71-a490-cd445aa58224",
                                "text": "L'adultisme de Nicolas devenait pour lui un souterrain lentement creusé, mais qui, de jour en jour, le menait à l'air libre."
                            }
                        ]
                    },
                    {
                        "sense_id": "349ae781-8dde-36b2-8162-551ee226e185",
                        "entry_id": "ac80d7cd-7422-373d-aabb-b89fb67e92e4",
                        "glosses": [
                            "Système d'oppression fondé sur l'appartenance aux catégories d'âge de l'enfance et de l'adolescence et exercé par les personnes adultes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d679614-c84b-4d82-a796-4ae30aea157c",
                                "sense_id": "349ae781-8dde-36b2-8162-551ee226e185",
                                "text": "Je m’oppose à l’adultisme et à l’âgisme, ces formes de domination qui considèrent les enfants comme des sous humains, avant leurs 18 ans."
                            }
                        ]
                    }
                ],
                "translations": [
