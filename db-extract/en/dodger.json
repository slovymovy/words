                                    {
                                        "sense_id": "8a50f778-2f08-3ac1-8d1f-9db88c7006c3",
                                        "entry_id": "583c3576-5248-3466-a7bc-b58ab7b55042",
                                        "glosses": [
                                            "Person, die – in positiver oder oft in negativ bewerteter Weise – mit ihrem Verhalten gewisse Grenzen überschreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affce1cd-de32-4f78-a372-586eef859b0e",
                                                "sense_id": "8a50f778-2f08-3ac1-8d1f-9db88c7006c3",
                                                "text": "Der Junge ist ein kleiner Schlawiner; man weiß nie, was er gerade im Schilde führt."
                                            },
                                            {
                                                "example_id": "803811ad-ab8c-4f9a-a829-1e65c952f432",
                                                "sense_id": "8a50f778-2f08-3ac1-8d1f-9db88c7006c3",
                                                "text": "„Kein Wunder, daß die Beerdigungsbruderschaft von Schlawinern als der »lebendigste Verein« in ganz Buenos Aires bezeichnet wurde!“"
                                            },
                                            {
                                                "example_id": "a8c21058-6846-4008-b8fe-c5d8151d577f",
                                                "sense_id": "8a50f778-2f08-3ac1-8d1f-9db88c7006c3",
                                                "text": "„Dieser Schlawiner hatte seinen Diebstahl einfach Volker in die Schuhe geschoben.“"
                                            },
                                            {
                                                "example_id": "eb7b9efa-0910-4814-8b80-7565c3846370",
                                                "sense_id": "8a50f778-2f08-3ac1-8d1f-9db88c7006c3",
                                                "text": "„Nein, mit Schlawinern wollte der alte ehrsame Münchner Bürger nichts zu tun haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3383124-3c66-41d3-9c4b-f0f4a89abebf",
                        "source_entry_id": "e5bded0e-a2ea-3a78-b9fc-8d17ebf73489",
                        "source_sense_description": "person full of tricks or street smarts",
                        "target_lang_word": "Drückeberger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drückeberger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                        "entry_id": "0e596b6a-0a06-365a-bc83-cc6fb203096c",
                                        "glosses": [
                                            "jemand, der sich der Ausführung einer Aufgabe entzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee226764-875c-4e93-8abd-28a069f743d6",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "Er ist ein richtiger Drückeberger, immer wenn er einen Eintrag belegen soll, verschwindet er."
                                            },
                                            {
                                                "example_id": "b5b51f27-a36b-4310-bf16-f4d195e99179",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "„Die Stimmung in der Kompanie wurde immer schärfer gegen die Banden hinter der Front, vor allem, als die Nachricht kam, dass in Brüssel die Drückeberger aus den Spelunken gekrochen wären, in denen sie sich bei den Einwohnern verborgen gehalten hätten.“"
                                            },
                                            {
                                                "example_id": "798aa86e-42fe-4a8d-9fc5-1e9f3c08fbce",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "„Ich habe keinen Grund dazu, aber ich fühle mich wie ein Drückeberger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
