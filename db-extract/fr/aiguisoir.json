        "fr-extract.jsonl": [
            {
                "entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                "word": "aiguisoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "066be9bc-94af-4998-8314-1fd9fb255931",
                        "entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "aiguisoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                        "entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                        "glosses": [
                            "Instrument servant à aiguiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22cd790a-51a7-4c09-a2a9-4a6a90a3b33e",
                                "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                "text": "Le vent le flagelle, siffle à ses oreilles avec la stridence du couteau sur l’aiguisoir."
                            },
                            {
                                "example_id": "c2f8e470-c075-42a2-8c6a-544dc41ddf71",
                                "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                "text": "Selon les traces de travail visibles, les objets polis se présentaient probablement sous une forme rectangulaire, la lame d'un ciseau droit par exemple. Dans ce cas, le tranchant du ciseau devait encore être affûté à l'aide d'un aiguisoir."
                            },
                            {
                                "example_id": "0407aa59-38d5-48e6-8ed2-14b041862656",
                                "sense_id": "f9c72d8d-8d98-38b5-af4f-5b5cc80b5494",
                                "text": "Le temps de courir à la ferme, et de mettre en sûreté ses outils, sa faux, son aiguisoir, d'éponger son torse trempé de sueur, de changer de chemise et de boire un grand coup d'eau fraîche, il était près de six heures lorsqu'il arriva tout essoufflé […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "db2e0576-bd11-3ac1-985d-aa672aa8335c",
                        "entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                        "glosses": [
                            "Taille-crayon."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "f619e954-d5c3-4336-9f04-6e2eadf395c5",
                                "sense_id": "db2e0576-bd11-3ac1-985d-aa672aa8335c",
                                "text": "Aiguisoir à crayon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "843f7262-4b13-49e9-8d20-2da53ab46870",
                        "source_entry_id": "40b6fb63-8c58-3620-b50a-67b15a67ca2a",
                        "target_lang_word": "sharpener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharpener",
