                    {
                        "translation_id": "c28d3962-5b2f-4873-86ee-c9bb6a83f8eb",
                        "source_entry_id": "26510965-9d6d-3f13-b3b1-d91c8937b8bd",
                        "source_sense_id": "1362b4fc-5077-3056-b922-a11c00cb37f9",
