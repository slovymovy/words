                        "translation_id": "f77c06fc-94ab-400b-84bc-6b099edaa839",
                        "source_entry_id": "1c4ec424-0a07-370b-ba46-a9b3dbcf32ae",
                        "source_sense_id": "6854e8b9-bddd-39f5-8e4b-4466ebb85def",
