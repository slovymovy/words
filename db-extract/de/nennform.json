                        ],
                        "form": "die Nennform"
                    },
                    {
                        "form_id": "24ce816c-0db0-4177-ab90-15f4ba6e4cd0",
                        "entry_id": "98c1589e-406b-3a06-b2a5-7bf2d9ae5050",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nennformen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bb7d6e3-e8c2-34ec-9ce5-7ac418f7c0b3",
                        "entry_id": "98c1589e-406b-3a06-b2a5-7bf2d9ae5050",
                        "glosses": [
                            "Infinitiv des Verbs in Sprachen (zum Beispiel dem Deutschen), in denen er [2] ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ab1d773-b087-49b4-be13-42f5f046feee",
                                "sense_id": "9bb7d6e3-e8c2-34ec-9ce5-7ac418f7c0b3",
                                "text": "„Zu den Modi rechnet man auch die Nennform (Infinitiv), z. B. loben und das Mittelwort (Particip), z. B. lobend, gelobt.“"
                            },
                            {
                                "example_id": "c8ba04ac-8c0e-4156-8617-e496a08d3327",
                                "sense_id": "9bb7d6e3-e8c2-34ec-9ce5-7ac418f7c0b3",
                                "text": "In einigen sprachwissenschaftlichen Lexika wird mit Nennform nur auf den Infinitiv verwiesen."
                            },
                            {
                                "example_id": "c2dfb807-1dfb-4c18-a8b5-75f4e2a01f83",
                                "sense_id": "9bb7d6e3-e8c2-34ec-9ce5-7ac418f7c0b3",
                                "text": "„Zu den einfachen infiniten Verbformen gehören in erster Linie (a) das Partizip II (»Partizip Perfekt«) und (b) der Infinitiv (die Nennform des Verbs).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                        "entry_id": "98c1589e-406b-3a06-b2a5-7bf2d9ae5050",
                        "glosses": [
                            "die Wortform aus dem Paradigma eines Wortes, die man benutzt, um das Wort zu nennen oder im Lexikon zu suchen; Zitierform im Lexikon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a31f3179-6577-4cd2-89cd-7e4ab5f708e7",
                                "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                                "text": "„Zu den einfachen infiniten Verbformen gehören in erster Linie (a) das Partizip II (»Partizip Perfekt«) und (b) der Infinitiv (die Nennform des Verbs).“"
                            },
                            {
                                "example_id": "dbd192fa-0706-4ae7-bc2b-09295f86cd68",
                                "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                                "text": "Verben werden in Lexika des Deutschen im Infinitiv als Nennform aufgeführt."
                            },
                            {
                                "example_id": "5fdeb956-7e4e-4930-9fa7-e20c202471dd",
                                "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                                "text": "Die Nennform der Substantive ist im Deutschen der endunglose Nominativ Singular."
                            },
                            {
                                "example_id": "66b6d69a-cd40-419f-91ea-05c275b93d62",
                                "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                                "text": "Die Nennform der Adjektive ist im Deutschen die endungslose Form."
                            },
                            {
                                "example_id": "46d4c0fc-0527-4ede-9be6-770830a70501",
                                "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                                "text": "„Die Nennform = Zitierform des Lexems Haus…ist dabei nicht als identisch zu betrachten mit der Wortform Haus…“"
                            },
                            {
                                "example_id": "0e32a045-b2e1-4d13-8820-678f9396a235",
                                "sense_id": "1a7a2eec-3982-3a89-b2fe-bc468b7b3339",
                                "text": "„Als sogenannte Nennform fungiert in der Regel die Grundform, also beispielsweise der Infinitiv bei Verben, der Nominativ Singular bei Substantiven, der Positiv bei Adjektiven.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36ae8f5c-7816-412c-acd4-b15d621e3e72",
                        "source_entry_id": "98c1589e-406b-3a06-b2a5-7bf2d9ae5050",
                        "source_sense_id": "9bb7d6e3-e8c2-34ec-9ce5-7ac418f7c0b3",
