                ],
                "senses": [
                    {
                        "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                        "entry_id": "191274d4-3864-3abd-91e7-673787ad9ff8",
                        "glosses": [
                            "leitender Ausschuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c657fdec-70aa-41b8-a3d1-d5a6911df5b2",
                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                "text": "Die Untersuchung der Frage wurde dem zuständigen Komitee übertragen."
                            },
                            {
                                "example_id": "79203e24-533f-442a-9896-68d9163b07c2",
                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                "text": "Wir haben jetzt ein Komitee für die Vorbereitung der 100-Jahr-Feier gebildet."
                            },
                            {
                                "example_id": "0a6491f7-2764-4a51-b49a-7ea33dba19fd",
                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                "text": "„Das Komitee hielt jedoch nur eine Sitzung ab und verschwand danach von der Bildfläche.“"
                            },
                            {
                                "example_id": "0609d0c7-2dda-4aa7-a5a1-41b45c1d8c13",
                                "sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
                                "text": "„Am 8. August aber wurde aus dem Generalfeldmarschall Saltykow, Araktschejew, Wjasmitinow, Lopuchin und Kotschubej ein Komitee gebildet, das sich über die militärische Lage gutachtlich äussern sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86013bf2-404f-4bfa-a5b3-6079cc94b9ab",
                        "source_entry_id": "191274d4-3864-3abd-91e7-673787ad9ff8",
                        "source_sense_id": "8f5d2cea-da48-3c2d-a3ab-58c1884974ca",
