                        "entry_id": "17e8d764-b9fd-3a94-9bfe-93f5bc80c7e8",
                        "glosses": [
                            "To play a xylophone or to play something else as though it was a xylophone."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                        "entry_id": "17e8d764-b9fd-3a94-9bfe-93f5bc80c7e8",
                        "glosses": [
                            "To move above a ridged surface or series of surfaces so as to hit every ridge, in a manner similar to playing quickly and sequentially on a xylophone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd61f08-7ac3-4db5-8250-00c0073f2b49",
                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                "text": "my eager fingers xylophoning over the memories"
                            },
                            {
                                "example_id": "9cac74ea-71ec-4941-acf6-bd4bc80f3fce",
                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                "text": "Like a cat, I arch into the back of the bench, my spine xylophoning along the slats while the tension of the day slowly drains out of me. I'm totally chill and mellow."
                            },
                            {
                                "example_id": "bd58b1e8-42b4-4329-9fe1-4dc4af2ff9ad",
                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                "text": "The others waged active war, claws xylophoning across Jack's pinwheeling swords."
                            },
                            {
                                "example_id": "bede3f35-4c7b-4670-9214-68b626c117be",
                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                "text": "His right hand, the good one, found one of Glass's ankles, pulled. Glass fell, her ulna, clavicle, pevis, and kneecap xylophoning along stair edges."
                            }
                        ]
                    }
                ],
