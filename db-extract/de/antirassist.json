                        ]
                    },
                    {
                        "translation_id": "74108d53-d44a-4420-a310-20ef35fb31d8",
                        "source_entry_id": "ff163ce0-10b0-3a12-aa99-78b1fce209ff",
                        "source_sense_id": "1339cb66-faf8-33be-bf76-8e1e48800406",
                        "source_sense_description": "(männliche) Person, die den Rassismus ablehnt und ihn bekämpfte",
                        "target_lang_word": "antiraciste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiraciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03dd25f8-133d-31cd-9e24-ee381ea0040f",
                                        "entry_id": "76740e1b-55e1-3d08-8c06-1c9c3b374853",
                                        "glosses": [
                                            "Opposé au racisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "895dc9f5-34d3-4d17-acf4-cc37c3d45d73",
                                                "sense_id": "03dd25f8-133d-31cd-9e24-ee381ea0040f",
                                                "text": "Antitotalitaire, antiraciste, attentif au sort des minorités, il prônait une révolution continentale contre les nationalismes et les oligarchies économiques pour aboutir à la construction, une fois le IIIe Reich vaincu, d’une Europe unifiée et démocratique dotée de sa propre armée."
                                            },
                                            {
                                                "example_id": "4b861fb6-55d5-4120-87f3-d855f9c71be7",
                                                "sense_id": "03dd25f8-133d-31cd-9e24-ee381ea0040f",
                                                "text": "La lutte antiraciste."
                                            },
                                            {
                                                "example_id": "b62ec714-ebc4-40d1-9fa8-d456d3595cdb",
                                                "sense_id": "03dd25f8-133d-31cd-9e24-ee381ea0040f",
                                                "text": "il faut renforcer les lois antiracistes."
                                            },
                                            {
                                                "example_id": "91411e29-df87-458d-bb8a-5ffcbd9f77be",
                                                "sense_id": "03dd25f8-133d-31cd-9e24-ee381ea0040f",
                                                "text": "La statue d’un soldat confédéré a été abattue, lundi, par des manifestants en Caroline du Nord suite au décès d’une manifestante antiraciste à Charlottesville."
                                            },
                                            {
                                                "example_id": "837d1ec1-2f24-40c6-b74e-3a5c677d9954",
                                                "sense_id": "03dd25f8-133d-31cd-9e24-ee381ea0040f",
                                                "text": "Face à ce « néoracisme » qui manie avec habileté le vocabulaire des modes de vie, les associations antiracistes « classiques » et « généralistes » comme la Ligue des droits de l’homme (LDH), la Ligue internationale contre le racisme et l’antisémitisme (Licra) ou le Mouvement contre le racisme et pour l’amitié entre les peuples (MRAP) sont vite dépassées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiraciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d5f62d2-99a7-380e-94e6-c11489eaf181",
                                        "entry_id": "ca415eca-d204-37dc-8815-3f4bd61c4bb2",
                                        "glosses": [
                                            "Celui ou celle qui s’oppose au racisme, qui fait partie du mouvement antiraciste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b62bc29-b6a1-4e2e-81f8-963f472512d7",
                                                "sense_id": "1d5f62d2-99a7-380e-94e6-c11489eaf181",
                                                "text": "Le contexte dans lequel les antiracistes situent leur action a une grande importance."
                                            },
                                            {
                                                "example_id": "14677481-e59e-4dfc-8349-8a7563d11814",
                                                "sense_id": "1d5f62d2-99a7-380e-94e6-c11489eaf181",
                                                "text": "Si l’on prend au mot les antiracistes militants dont le fonds de commerce consiste à nous condamner parce que nous ne sommes pas noirs mais blancs, l’on devrait leur demander pardon en tant que membres de la majorité blanche, qui les discrimine, selon eux, à travers toutes nos institutions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
