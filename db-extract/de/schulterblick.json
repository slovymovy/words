                ],
                "senses": [
                    {
                        "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                        "entry_id": "b7778984-7c24-34cf-ac6e-3ca7611d8433",
                        "glosses": [
                            "Blick über die linke oder rechte Schulter beim Spurwechsel oder Abbiegen, um andere Verkehrsteilnehmer, die sich im toten Winkel befinden, zu erkennen und nicht zu gefährden"
                        ],
                        "tags": [
                            "Straßenverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "154e2e72-703d-4e51-a048-4910a039b3be",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "Generationen von Fahrschülern wurde in den Fahrschulen der Schulterblick eingetrichtert."
                            },
                            {
                                "example_id": "2391561d-9773-45d5-8123-8bb98c15990e",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Blinker links, Schulterblick – Ansgar gibt Gas.“"
                            },
                            {
                                "example_id": "26439237-8930-4d09-b6ed-6cda76c0fe84",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Wer ohne Schulterblick abbiegt und dadurch einen Radler gefährdet, zahlt bis zu 140 Euro plus einen Monat Fahrverbot.“"
                            },
                            {
                                "example_id": "7f2c575b-267c-4b04-bda8-7645ea860431",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Eine Übung beim Fahrsicherheitstraining ist der Schulterblick, damit die Senioren auch den Toten Winkel im Blick haben.“"
                            },
                            {
                                "example_id": "6a51942e-a94d-4f9b-a341-1349d434fd65",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„»Und was jetzt ganz, ganz wichtig ist: Man sollte hier den Schulterblick machen, damit man Fußgänger oder Radfahrer, die überqueren wollen, rechtzeitig sieht.« Und vor dem Abbiegen dann noch ein zweites Mal Schulterblick.“"
                            },
                            {
                                "example_id": "70d553a0-0e2d-4b98-a628-f200f36d458e",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Der Schulterblick überbrückt den toten Winkel, den man beim Abbiegen oder Fahrstreifenwechsel nicht einsehen kann. In der Reihenfolge vergewissert ihr euch: Innenspiegel, Außenspiegel, Blinker, Schulterblick.“"
                            },
                            {
                                "example_id": "790055e2-19d4-4f3b-a381-0d8da8028bf5",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "[\"Holländischer Griff\":] „Dieser Griff hat automatisch zur Folge, dass sich der Körper nach hinten dreht, beim Öffnen der Tür ein Schulterblick stattfindet und Radfahrerinnen und Radfahrer rechtzeitig gesehen werden.“"
                            },
                            {
                                "example_id": "7b4ff3d3-3aa8-4d4c-81fd-5fea39c43a52",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Gewöhnt euch einfach an und macht es zu eurer Routine, dass ihr die Autotür beim Aussteigen nicht mit der linken, sondern mit der rechten Hand öffnet! Und als Beifahrer mit der linken - und nicht mehr der rechten - Hand. Der Grund: Bei dieser zunächst vielleicht etwas ungewohnten Bewegung dreht ihren euren gesamten Oberkörper und zwingt euch so zum Schulterblick auf die Straße.“"
                            },
                            {
                                "example_id": "1610a13e-dd88-44d2-ab8e-dd527fe59ded",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Beim Abbiegen eine Hand vom Lenker lösen, um die Richtung anzuzeigen und gleichzeitig den Schulterblick nach hinten durchführen.“"
                            },
                            {
                                "example_id": "76075a20-f5c5-413c-8669-91343756e3d1",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„»Wenn Sie häufig trainieren, zwei oder drei Aufgaben gemeinsam zu machen, dann kommt es zur Automatisierung. Die meisten von uns kennen das vom Lernen beim Autofahren. Am Anfang ist es sehr, sehr schwierig, einen Schulterblick zu machen und die Kupplung zu treten, während man schaltet. Nach ein paar Jahren Fahrpraxis ist das so automatisiert, dass es uns wirklich mühelos gelingt.«“"
                            },
                            {
                                "example_id": "aab02094-e2d5-4ac4-b1ce-7a20a0add9d8",
                                "sense_id": "3c3bc100-3472-3c4f-839b-54bc2bee9315",
                                "text": "„Gerade beim Rückwärtsfahren ist der Schulterblick von entscheidender Wichtigkeit. Nur so können Sie den Bereich hinter Ihrem Gabelstapler vollständig einsehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
