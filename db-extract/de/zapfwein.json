                "senses": [
                    {
                        "sense_id": "0db5b0dd-ecc7-3575-99ac-a0da1b61093e",
                        "entry_id": "8695e6a0-05b8-3f34-a7fb-3a00084b9c21",
                        "glosses": [
                            "fehlerloser einfacher Wein ohne besondere Qualität, der direkt aus dem Fass gezapft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a78d59-f1e9-453d-9d4d-2998a2b4dc8f",
                                "sense_id": "0db5b0dd-ecc7-3575-99ac-a0da1b61093e",
                                "text": "„Werde dagegen der Wein aus dem Fasse verzapft und dem Gaste, wie dies vielfach üblich, in offenen Flaschen vorgesetzt (Zapfwein), so müßten diese Flaschen markirt sein und finde also bei ihnen die Ausnahme des §. 6 nicht statt.“"
                            },
                            {
                                "example_id": "2308f989-5254-4db0-b7fc-79f90b1f1ea7",
                                "sense_id": "0db5b0dd-ecc7-3575-99ac-a0da1b61093e",
                                "text": "„Weil der Rebsaft dabei mit Sauerstoff in Berührung kommt, sind Zapfweine nur einige Tage haltbar.“"
                            },
                            {
                                "example_id": "21543763-8ed0-430a-a7e3-baa2c562d206",
                                "sense_id": "0db5b0dd-ecc7-3575-99ac-a0da1b61093e",
                                "text": "„Angeboten werden Zapfweine direkt aus Italien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
