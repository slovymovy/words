                    },
                    {
                        "translation_id": "6ed14037-36bd-4156-bdd0-f31a8239b8c5",
                        "source_entry_id": "7c989abe-fc6f-3221-8df9-9726d510db4c",
                        "target_lang_word": "sécurité sociale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sécurité sociale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a35dc929-1911-360f-8465-17b8e408251a",
                                        "entry_id": "57ce5d72-896d-355c-8af9-748e4cb25025",
                                        "glosses": [
                                            "Garantie de la satisfaction des droits économiques, sociaux et culturels indispensables à sa dignité et au libre développement de la personnalité d’un être humain, grâce à l'effort national et à la coopération internationale, compte tenu de l'organisation et des ressources de chaque pays."
                                        ],
                                        "tags": [
                                            "Droit international"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a817b7f-bb44-4a44-b01e-93475fb9dfc7",
                                                "sense_id": "a35dc929-1911-360f-8465-17b8e408251a",
                                                "text": "Toute personne, en tant que membre de la société, a droit à la sécurité sociale ; elle est fondée à obtenir la satisfaction des droits économiques, sociaux et culturels indispensables à sa dignité et au libre développement de sa personnalité, grâce à l'effort national et à la coopération internationale, compte tenu de l'organisation et des ressources de chaque pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e64194-beb2-3a04-8854-3be53a46fe83",
                                        "entry_id": "57ce5d72-896d-355c-8af9-748e4cb25025",
                                        "glosses": [
                                            "Système d’indemnisation par les administrations publiques des citoyens victimes des aléas de la vie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d897562-d592-41d6-a012-61e7411bc7a7",
                                                "sense_id": "21e64194-beb2-3a04-8854-3be53a46fe83",
                                                "text": "En prescrivant des antibiotiques sophistiqués ou à large spectre, il cherche à « écraser une mouche avec un marteau », enrichit les laboratoires et contribue au pillage de la Sécurité sociale."
                                            },
                                            {
                                                "example_id": "b8cf9e80-fab4-453d-a07a-3c4d53f883fc",
                                                "sense_id": "21e64194-beb2-3a04-8854-3be53a46fe83",
                                                "text": "Le plafond de la Sécurité sociale est le montant maximum en euros des rémunérations ou gains à prendre en compte pour le calcul de certaines cotisations (…). Chaque année, ce plafond est actualisé conformément aux règles prévues dans l’article D242-17 du Code de la Sécurité sociale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
