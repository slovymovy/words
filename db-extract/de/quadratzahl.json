                "senses": [
                    {
                        "sense_id": "18442492-d90d-3cc6-a990-2dd527864953",
                        "entry_id": "e7930677-690d-32be-a210-801027f685e4",
                        "glosses": [
                            "Zahl, die das Produkt zweier gleicher ganzer Zahlen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478df9ae-2475-4cb0-b8dc-5a23650e21a9",
                                "sense_id": "18442492-d90d-3cc6-a990-2dd527864953",
                                "text": "Die ersten vier Quadratzahlen sind 0, 1, 4 und 9."
                            },
                            {
                                "example_id": "59d8b2a2-f930-4479-9618-9c30c821e29a",
                                "sense_id": "18442492-d90d-3cc6-a990-2dd527864953",
                                "text": "„So behauptete Goldbach in einem späteren Brief an Euler, jede ungerade Zahl lasse sich als die Summe aus einer Primzahl und dem Doppelten einer Quadratzahl schreiben.“"
                            },
                            {
                                "example_id": "0cb4727a-53cd-4291-b15c-31a0a0de03ec",
                                "sense_id": "18442492-d90d-3cc6-a990-2dd527864953",
                                "text": "„Die Zahlen auf der Kette erfüllen folgende Eigenschaft: Die Summe von zwei benachbarten Zahlen ist stets eine Quadratzahl.“"
                            },
                            {
                                "example_id": "fe81c057-0e29-4b6d-a27d-fd7b2b660dfd",
                                "sense_id": "18442492-d90d-3cc6-a990-2dd527864953",
                                "text": "„Die ersten Quadratzahlen sind 1, 4, 9, 16, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
