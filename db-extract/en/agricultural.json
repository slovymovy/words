                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agrarisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a86806c-73bf-34d3-bc3e-5cbd471cf854",
                                        "entry_id": "cac80b3a-2b95-3f8c-bbbb-9d5304ce0721",
                                        "glosses": [
                                            "auf die Landwirtschaft bezogen, ihr dienend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03121d06-3991-420c-a62a-e20d2a93c06f",
                                                "sense_id": "5a86806c-73bf-34d3-bc3e-5cbd471cf854",
                                                "text": "„Doch je mehr Geld, Sklaven und Güter aller Art aus den eroberten Gebieten nach Rom strömten, desto entscheidender veränderte sich das ökonomische und soziale Gleichgewichte in der agrarisch geprägten Stadt.“"
