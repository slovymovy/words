                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a2b3caf-14f7-4675-acef-3778b9b014a0",
                                                "sense_id": "e9d84364-4924-324d-95b4-3aee37203440",
                                                "text": "Le raclage de l’encollage et de l’enduit, à chaud, était expressément recommandé dans la plupart des vieilles recettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623ea26b-1dad-30ea-a62f-4bf649b23ccf",
