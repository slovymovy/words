                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through <w>Springer</w> while traveling across the state of New Mexico.",
                            "target_lang_translations": {
                                "ru": "Мы проезжали через <w>Спрингер</w>, путешествуя по штату Нью-Мексико."
                            }
