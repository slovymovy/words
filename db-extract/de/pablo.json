                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f3dbdfb-a80d-45a0-b35a-b9fe51b64330",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Frau Pablo ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "62fd17e8-e86d-4479-9eda-b06681907d1e",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Herr Pablo wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "72ea279a-614e-44fc-a400-de0fcbc9a48a",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Die Pablos fahren heute nach München."
                            },
                            {
                                "example_id": "e3303a74-b3f7-44e3-912f-47a6ebe7b84f",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Der Pablo trägt nie die Pullover, die die Pablo ihm strickt."
                            },
                            {
                                "example_id": "f75c546b-7555-49ea-8951-352fbf0b66d3",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pablo kommt, geht der Herr Pablo.“"
                            },
                            {
                                "example_id": "7beda6b5-e291-41c8-86c6-799a2d0c77e3",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Pablo kommt und geht."
                            },
                            {
                                "example_id": "bfefe217-accc-440c-86df-6e53d3ed48c2",
                                "sense_id": "96dbf584-f384-39d9-9fd8-a916d080481e",
                                "text": "Pablos kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
