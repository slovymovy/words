            {
                "entry_id": "0136bbd3-6b26-309a-aeab-4a67f5da5ee9",
                "word": "dang",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3d1fca08-d97b-4dcb-96d4-d0f70e820194",
                        "entry_id": "0136bbd3-6b26-309a-aeab-4a67f5da5ee9",
                        "tags": [
                            "plural"
                        ],
                        "form": "dangs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01341c3d-6b44-3290-af37-6588b5fee44c",
                        "entry_id": "0136bbd3-6b26-309a-aeab-4a67f5da5ee9",
                        "glosses": [
                            "A damn, a negligible quantity, minimal consideration."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "ebcd8570-900b-4680-bfb2-224e0845dda5",
                                "sense_id": "01341c3d-6b44-3290-af37-6588b5fee44c",
                                "text": "I don't give a dang."
                            }
                        ]
                    },
                    {
                        "sense_id": "043d6f5f-bb53-3866-b6b7-c113ae7434f6",
                        "entry_id": "0136bbd3-6b26-309a-aeab-4a67f5da5ee9",
                        "glosses": [
                            "A dam (structure placed around a body of water), used because of the homophony between dam and damn."
                        ],
                        "tags": [
                            "humorous",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e5f5bfa5-797b-4d77-9c0a-bc1ab6129437",
                                "sense_id": "043d6f5f-bb53-3866-b6b7-c113ae7434f6",
                                "text": "I don't often yell at my players or officials--I've never once thrown a chair, the best I ever did was a clipboard--and I never curse. People like to joke that I once went on vacation to the Hoover Dang."
                            },
                            {
                                "example_id": "e0a023bd-4f93-4785-a8f8-45887d57f3cd",
                                "sense_id": "043d6f5f-bb53-3866-b6b7-c113ae7434f6",
                                "text": "“Momma, Keisha says we have to call it the 'Hoover Dang'.” Monique laughed, and it felt good. “No, honey. You don't have to call it that.[…]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
