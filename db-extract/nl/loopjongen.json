                        "entry_id": "255b39f0-257d-3574-8545-7a431621470c",
                        "glosses": [
                            "jonge ongeschoolde mannelijke bediende die vooral boodschapjes doet voor zijn baas tegenwoordig met een negatieve bijklank"
                        ],
