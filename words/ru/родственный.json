    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd9b1e9b-acd0-35cb-8a1a-24ecadbc73ba",
                    "sense_definition": "Основанный на родстве, связанный с родством.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "родство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они поддерживают <w>родственные</w> отношения на протяжении многих лет.",
                            "target_lang_translations": {
                                "pl": "Utrzymują oni <w>pokrewne</w> relacje przez wiele lat."
                            }
                        },
                        {
                            "text": "У них обнаружились неожиданные <w>родственные</w> связи.",
                            "target_lang_translations": {
                                "pl": "Odkryto u nich nieoczekiwane <w>pokrewne</w> więzi."
                            }
                        }
                    ],
                    "synonyms": [
                        "кровный",
                        "семейный"
                    ],
                    "common_phrases": [
                        "родственные связи",
                        "родственные отношения"
                    ],
                    "target_lang_definitions": {
                        "pl": "Oparty na pokrewieństwie, związany z więzami krwi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pokrewny",
                                "target_lang_sense_clarification": "odnoszący się do więzów rodzinnych"
                            },
                            {
                                "target_lang_word": "rodzinny",
                                "target_lang_sense_clarification": "dotyczący rodziny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba80ad8c-da21-3881-91cd-879ef489620f",
                    "sense_definition": "Близкий по происхождению, характеру или содержанию.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сходство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эти два языка имеют <w>родственные</w> корни.",
                            "target_lang_translations": {
                                "pl": "Te dwa języki mają <w>pokrewne</w> korzenie."
                            }
                        },
                        {
                            "text": "В своих творческих поисках художники сразу почувствовали друг в друге <w>родственные</w> души.",
                            "target_lang_translations": {
                                "pl": "Artyści poczuli, że są <w>pokrewnymi</w> duszami w swoich twórczych poszukiwaniach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "родственные души"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bliski pod względem pochodzenia, charakteru lub treści."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pokrewny",
                                "target_lang_sense_clarification": "mający wspólne cechy lub pochodzenie"
                            },
                            {
                                "target_lang_word": "bliski",
                                "target_lang_sense_clarification": "podobny w charakterze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00a69f77-9068-3d9d-9ab5-2d0ca4837537",
                    "sense_definition": "Свойственный родственникам, характерный для семьи.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "родство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он оказал мне <w>родственную</w> поддержку в трудную минуту.",
                            "target_lang_translations": {
                                "pl": "Okazał mi <w>rodzinną</w> pomoc w trudnej chwili."
                            }
                        },
                        {
                            "text": "За годы дружбы между нашими семьями установились почти <w>родственные</w> отношения.",
                            "target_lang_translations": {
                                "pl": "Przez lata przyjaźni między naszymi domami wytworzyły się niemal <w>rodzinne</w> więzi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Właściwy krewnym, charakterystyczny dla rodziny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rodzinny",
                                "target_lang_sense_clarification": "charakterystyczny dla atmosfery w rodzinie"
                            },
                            {
                                "target_lang_word": "braterski",
                                "target_lang_sense_clarification": "wspierający, pełen życzliwości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}