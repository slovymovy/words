{
    "word_family": [
        "medial",
        "Mediathek",
        "Mediation",
        "Mediator",
        "Medienlandschaft"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63d17f6d-6d9c-35c1-9184-5dc7e30190df",
                    "sense_definition": "Kommunikationsmittel zur Übertragung und Verbreitung von Informationen an die Öffentlichkeit, wie Fernsehen, Rundfunk, Presse oder das Internet",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kommunikation_information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Internet hat sich in den letzten Jahrzehnten zum wichtigsten <w>Medium</w> für Nachrichten entwickelt."
                        },
                        {
                            "text": "Die Berichterstattung in den <w>Medien</w> beeinflusst die öffentliche Meinung sehr stark."
                        }
                    ],
                    "common_phrases": [
                        "klassische und moderne Medien",
                        "Berichterstattung in den Medien",
                        "Nutzung digitaler Medien"
                    ]
                },
                {
                    "sense_id": "17aab9b3-dd4c-37a9-bd9e-3afdad9ddd4b",
                    "sense_definition": "Einzelner Datenträger oder Träger von Inhalten wie ein Buch, eine CD oder eine Festplatte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kommunikation_information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Bibliothek kann man verschiedene <w>Medien</w> wie Bücher, Zeitschriften und CDs ausleihen."
                        },
                        {
                            "text": "Wichtige Dokumente sollten immer auf einem externen <w>Medium</w> gesichert werden."
                        }
                    ],
                    "synonyms": [
                        "Datenträger",
                        "Publikation"
                    ],
                    "common_phrases": [
                        "digitale und analoge Medien",
                        "Speichern auf einem Medium"
                    ]
                },
                {
                    "sense_id": "457987ee-115a-331d-b9c8-9fbcdf1477a2",
                    "sense_definition": "Stoff oder physikalische Umgebung, in der sich Wellen, Teilchen oder chemische Vorgänge ausbreiten und ablaufen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Schallwellen benötigen ein materielles <w>Medium</w> wie Luft oder Wasser, um sich fortzupflanzen."
                        },
                        {
                            "text": "Im Vakuum breitet sich Licht auch ohne ein materielles <w>Medium</w> ungehindert aus."
                        }
                    ],
                    "common_phrases": [
                        "ein gasförmiges Medium",
                        "Schallausbreitung in einem Medium"
                    ]
                },
                {
                    "sense_id": "45eb95d3-4d49-3095-86d2-16c10331fc66",
                    "sense_definition": "Person, die angeblich spirituelle Kontakte zu Geistern oder Verstorbenen aufnehmen und Botschaften übermitteln kann",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Teilnehmer der Sitzung hofften, über das <w>Medium</w> mit ihren Verstorbenen zu sprechen."
                        },
                        {
                            "text": "Sie behauptete fest, als <w>Medium</w> übersinnliche Stimmen aus einer anderen Welt zu hören."
                        }
                    ],
                    "common_phrases": [
                        "Kontakt durch ein Medium",
                        "als spiritistisches Medium arbeiten"
                    ]
                },
                {
                    "sense_id": "d63616ad-4f97-32b5-919e-add45a3cf953",
                    "sense_definition": "Genus des Verbs in manchen Sprachen, das eine Handlung beschreibt, die das Subjekt selbst betrifft oder auf es zurückwirkt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Altgriechischen drückt das <w>Medium</w> oft eine reflexive oder einbezogene Handlung des Subjekts aus."
                        },
                        {
                            "text": "Linguisten vergleichen gern die Formen von Aktiv, Passiv und <w>Medium</w> in indogermanischen Sprachen."
                        }
                    ],
                    "synonyms": [
                        "Mediopassiv"
                    ],
                    "common_phrases": [
                        "das griechische Medium",
                        "Verben im Medium"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
