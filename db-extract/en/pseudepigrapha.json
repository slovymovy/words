                                "target_senses": [
                                    {
                                        "sense_id": "69915533-17a2-344b-920f-53c8a9195aaf",
                                        "entry_id": "bfcb9aae-4893-32ab-ab49-a1d3b09fabfa",
                                        "glosses": [
                                            "Nom donné aux livres bibliques qui portent de faux titres, de faux noms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa23d9b5-0d99-485d-bbc7-ab02a020aa4a",
                                                "sense_id": "69915533-17a2-344b-920f-53c8a9195aaf",
                                                "text": "Donc de ne pas enfermer la vérité dans l’Antiquité, mais prenant en compte le flux créateur de la durée, voir comment un pseudépigraphe a pu faire autorité, comment l’erreur a une histoire et fait partie de l’Histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8938201-2555-31ca-b3ed-791ef4cff2a6",
