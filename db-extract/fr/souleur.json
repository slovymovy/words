            {
                "entry_id": "6a9823f0-e768-35fb-8aac-3020bf602104",
                "word": "souleur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1552cbfb-b7b6-4692-8936-e03db5351341",
                        "entry_id": "6a9823f0-e768-35fb-8aac-3020bf602104",
                        "tags": [
                            "plural"
                        ],
                        "form": "souleurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                        "entry_id": "6a9823f0-e768-35fb-8aac-3020bf602104",
                        "glosses": [
                            "Frayeur subite, saisissement, serrement de cœur."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "428ad1da-5ed5-4c22-89ce-e7015ef51856",
                                "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                                "text": "Cependant ma vue s'éclaircit peu à peu, et mes pieds, que la souleur tenait comme chevilles en terre"
                            },
                            {
                                "example_id": "65557cb6-c834-490c-b70e-ac885f22102e",
                                "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                                "text": "Son apparition subite m’a fait, m’a causé, m’a donné une souleur."
                            },
                            {
                                "example_id": "4e9b8343-d3ad-415a-b417-d67cef9dda78",
                                "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                                "text": "En apprenant cette nouvelle, il eut une grande souleur."
                            },
                            {
                                "example_id": "c9fe756b-50c1-476b-9354-7529e332be77",
                                "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                                "text": "Le travail auquel je me livre, outre qu'il est fort difficile en soi, me donne de telles souleurs, que j'ai perpétuellement comme un sanglot dans la gorge."
                            },
                            {
                                "example_id": "83a910d1-fdf3-4d85-aabc-9d78e8d8ba48",
                                "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                                "text": "Le Prussien était toujours sous ses copeaux ; il y avait même deux gros rats en train de lui travailler son casque, et ça me fit une fière souleur de sentir cette mentonnière remuer."
                            },
                            {
                                "example_id": "63d72a45-a70e-4842-a63e-93eeb13b5d82",
                                "sense_id": "dc1a4158-1aac-3d3b-81f8-97ad239e6d88",
                                "text": "Duchotel, remontant. — Tenez, par ici. (Il fait passer le commissaire, puis le suivant. ) Oh ! j’ai eu une souleur !"
                            }
                        ]
                    }
                ],
