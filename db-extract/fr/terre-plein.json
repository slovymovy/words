                    },
                    {
                        "form_id": "adb0d0a4-73b3-4709-b4ce-9c0633f3cc67",
                        "entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "terreplein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93de5ed5-7ca7-3b52-a938-45fee047d185",
                        "entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "glosses": [
                            "Surface plate et unie d’un ouvrage de fortification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3ffcb5-e7a8-49f3-9114-b9be0f28ccff",
                                "sense_id": "93de5ed5-7ca7-3b52-a938-45fee047d185",
                                "text": "Le terre-plein d’un rempart, d’un bastion."
                            },
                            {
                                "example_id": "4381e85c-8501-44bf-8d09-1d5660bb37be",
                                "sense_id": "93de5ed5-7ca7-3b52-a938-45fee047d185",
                                "text": "Le terre-plein d’un cavalier."
                            }
                        ]
                    },
                    {
                        "sense_id": "87b5306c-a922-38b3-9906-06c74071a1a1",
                        "entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "glosses": [
                            "Terrain élevé que soutiennent des murailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27bbe566-b9d6-412c-8bf7-442a732885e0",
                                "sense_id": "87b5306c-a922-38b3-9906-06c74071a1a1",
                                "text": "Le terre-plein du Pont-Neuf."
                            },
                            {
                                "example_id": "5fba8e9f-3b3a-4260-bb71-8974744a353f",
                                "sense_id": "87b5306c-a922-38b3-9906-06c74071a1a1",
                                "text": "Des terre-pleins."
                            },
                            {
                                "example_id": "9bb813c1-a79d-43dc-a0d5-f7da515755a2",
                                "sense_id": "87b5306c-a922-38b3-9906-06c74071a1a1",
                                "text": "Comme je traversais le Pont-Neuf pour rentrer dans mon vieux faubourg désert, je vis sur le terre-plein, au pied du socle sur lequel s’élevait naguère la statue de Henri IV, un chanteur de l’Académie de musique qui disait l’hymne des Marseillais d’une voix pathétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b65e36d-ca4b-360a-9d3a-baa554cba099",
                        "entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "glosses": [
                            "Refuge légèrement surélevé occupant le milieu de la chaussée, permettant aux piétons d’interrompre leur traversée en toute sécurité."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ab2a0de5-669b-49f2-948a-7c0849be1b2a",
                                "sense_id": "4b65e36d-ca4b-360a-9d3a-baa554cba099",
                                "text": "Pendant plus d'une demi-heure, Didier arpenta les terre-pleins du boulevard de Clichy et finit par s'asseoir sur un banc proche de la place Pigalle."
                            },
                            {
                                "example_id": "1c1069cf-a5db-4cb6-84e4-e6112e43a57e",
                                "sense_id": "4b65e36d-ca4b-360a-9d3a-baa554cba099",
                                "text": "Son statut d’avenue aurait pu paraître usurpé s’il n’y avait eu sa surprenante, son inutile largeur, et le terre-plein planté d’arbres qui séparait les deux voies de circulation à présent désertes."
                            },
                            {
                                "example_id": "f44ed954-5256-4e42-8cff-3460239ecf0d",
                                "sense_id": "4b65e36d-ca4b-360a-9d3a-baa554cba099",
                                "text": "En septembre dernier, une jeune femme d’une vingtaine d’années, qui venait d’inhaler du \"proto\", a perdu le contrôle de son véhicule sur les Champs-Élysées, heurtant quatre piétons sur le terre-plein central d’un passage protégé."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dbf5b50-e99a-3d45-89f9-6aa81b63a49f",
                        "entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "glosses": [
                            "Étendue artificielle de terre acquise sur la mer par remblaiement."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77b84e20-4396-396c-aa98-5f1f3a3e8237",
                        "entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "glosses": [
                            "Terre rapportée, pour servir de terrasse ou de chemin (d'après Littré)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0d9c8d-9c4f-4ba5-84d8-7aeed9e615f6",
                                "sense_id": "77b84e20-4396-396c-aa98-5f1f3a3e8237",
                                "text": "On allait inaugurer au milieu de la place la statue équestre de Vercingétorix.\nLa chose avait traîné longtemps. Une première souscription nationale, organisée sept ans plus tôt, n’avait produit que la somme de soixante-seize francs vingt. Avec cette somme, le Comité d’initiative fit établir un modeste terre-plein sur la place Sainte-Ursule.\nLa vue de ce terre-plein finit par provoquer, au bout d’un an, l’ouverture d’une souscription régionale. L’élan de la région fut tel que l’on recueillit huit cent trente-deux francs. Avec cette somme, le nouveau Comité fit construire sur le terre-plein un socle de granit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e021c84c-5b02-4a55-be66-5955142304f1",
                        "source_entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "source_sense_id": "93de5ed5-7ca7-3b52-a938-45fee047d185",
                        "source_sense_description": "Surface",
                        "target_lang_word": "embankment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embankment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2886b443-43f0-3d26-97f0-b87e1c675812",
                                        "entry_id": "b3b164d4-4f35-38dc-81b7-4c3bd7962be4",
                                        "glosses": [
                                            "a long mound of earth, stone, or similar material, usually built for purposes such as to hold back or store water, for protection from weather or enemies, or to support a road or railway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03089805-ee97-4a07-901d-49f965c9f875",
                                                "sense_id": "2886b443-43f0-3d26-97f0-b87e1c675812",
                                                "text": "The work to be done under these specifications consists in furnishing all materials and erecting a stone embankment, an earth embankment, and a wharf. The stone embankment will contain about 216,000 tons of stone; the earth embankment about 285,000 cubic yards of broken stone, sand, or other suitable material; and the wharf will contain 501,320 feet of timber, and 802 piles, together with the requisite quantity of cast iron mooring bits, wrought iron spikes, bolts, etc."
                                            },
                                            {
                                                "example_id": "42210376-6076-4e9a-b321-29e15fa09fe4",
                                                "sense_id": "2886b443-43f0-3d26-97f0-b87e1c675812",
                                                "text": "Sink a trench so the pipe of your water-works will be below ground; have the pump and the mules which work it at such a point and so defended by an epaulement or traverse, or some other defensive embankment, as to shield them."
                                            },
                                            {
                                                "example_id": "fdd656dc-3bfa-4ae7-8d99-d9c8ee3da14a",
                                                "sense_id": "2886b443-43f0-3d26-97f0-b87e1c675812",
                                                "text": "For thousands of years, societies have stored water, altered river flow, and transformed environments to increase food production or achieve other social or economic goals. The oldest known dam, a small earth embankment structure built about six thousand years ago at Jawa in present-day Jordan, was designed to capture rainfall and increase agricultural production."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02f20bc4-bd4a-498e-97ec-02b5ba6aac76",
                        "source_entry_id": "7cead870-0f51-35c0-97e5-aaddbe4fde9d",
                        "source_sense_id": "93de5ed5-7ca7-3b52-a938-45fee047d185",
                        "source_sense_description": "Surface",
                        "target_lang_word": "binnenplaats",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "binnenplaats",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a60a9469-cff3-38ac-bc27-0ad7cd842822",
                                        "entry_id": "9234e34a-0bac-38ab-a43a-6a86048f73d5",
                                        "glosses": [
                                            "een open ruimte omringd door gebouwen, vaak tussen voor- en achterhuis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30628127-7b25-4456-ad0e-c62f4eb321af",
                                                "sense_id": "a60a9469-cff3-38ac-bc27-0ad7cd842822",
                                                "text": "In de zomer konden we uren op de binnenplaats zitten."
                                            },
                                            {
                                                "example_id": "a4eb0625-c230-4f5a-bc15-0225ca9f5753",
                                                "sense_id": "a60a9469-cff3-38ac-bc27-0ad7cd842822",
                                                "text": "Tijdens Quicks afwezigheid vroeg Pamela me om samen met haar op de binnenplaats onze boterhammen op te eten, waardoor de receptie even onbemand was."
                                            },
                                            {
                                                "example_id": "705808a7-2866-45a1-9cb1-63aa313e0a99",
                                                "sense_id": "a60a9469-cff3-38ac-bc27-0ad7cd842822",
                                                "text": "Ik bereik de boerderij en loop de binnenplaats op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
