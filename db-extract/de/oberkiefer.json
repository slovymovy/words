                        ],
                        "form": "die Oberkiefer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85d64a6e-9f21-3c16-9da6-c35bdc631707",
                        "entry_id": "7fd022d2-4620-30c6-ad5f-d6e90fde1d2b",
                        "glosses": [
                            "Teil des vorderen Gesichtsschädels, in dessen Alveolarfortsatz die oberen Zähne sitzen und der die Kieferhöhle enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0b36e7-7da9-4b03-98d9-217bfe80f2dd",
                                "sense_id": "85d64a6e-9f21-3c16-9da6-c35bdc631707",
                                "text": "Beim Aufprall auf die Tischkante brach sich das Opfer den Oberkiefer."
                            },
                            {
                                "example_id": "30f36fbc-9d75-4852-86c8-91b99eca1185",
                                "sense_id": "85d64a6e-9f21-3c16-9da6-c35bdc631707",
                                "text": "Wegen der Vereiterung im Oberkiefer mussten einige sonst gesunde Zähne gezogen werden."
                            },
                            {
                                "example_id": "1f02647e-a06f-418e-800d-19c36bae5abb",
                                "sense_id": "85d64a6e-9f21-3c16-9da6-c35bdc631707",
                                "text": "„Die bei Weitem häufigste Fehlstellung ist der Rückbiss, wobei entweder das Unterkiefer zu weit hinten oder das Oberkiefer zu weit vorn steht.“"
                            },
                            {
                                "example_id": "2397ba4b-9c61-4507-aaec-eaf24e807275",
                                "sense_id": "85d64a6e-9f21-3c16-9da6-c35bdc631707",
                                "text": "„Der Mann hatte einen gewaltigen Unterkiefer, und er vermochte ihn ohne Mühe mit seinem seit langem zahnlosen Oberkiefer abzulecken, und das Kinn war mit zunehmendem Alter immer mehr imstande, die Nasenspitze zu küssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
