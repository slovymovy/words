                        "glosses": [
                            "To lead excessively or too much."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "643e1ebd-1f4b-43f4-82e9-781a50ab5a69",
                                "sense_id": "3d6c22b5-bf0b-3196-b7e1-f8c5cb8bd1eb",
                                "text": "If you overlead this question with too binding absoluteness requirements I am afraid that a satisfactory and not dogmatic answer will be rather difficult to find."
                            }
                        ]
