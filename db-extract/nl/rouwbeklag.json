                        "sense_id": "5eb70c61-8df8-3d4d-9a8e-79bf7dbd52b8",
                        "entry_id": "e265aff5-a9b3-3793-b42c-0341e17c88e2",
                        "glosses": [
                            "uiting van droevige emoties bij het overlijden van iemand; uiten van medeleven bij het overlijden van iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a754121-eb40-41e3-8351-28b279a557b3",
                                "sense_id": "5eb70c61-8df8-3d4d-9a8e-79bf7dbd52b8",
                                "text": "Een drakerig vervolg op Who's afraid of Virginia Woolf, met George en Martha in de echtelijke sponde, elkaar de blijken van rouwbeklag doorgevend die waren binnengekomen na het dodelijk verongelukken van hun twintigjarige zoon, die ze zelf verzonnen hadden."
                            },
                            {
                                "example_id": "3438a263-bb2e-4630-958c-e2b544962fa0",
                                "sense_id": "5eb70c61-8df8-3d4d-9a8e-79bf7dbd52b8",
                                "text": "SP-Kamerlid Van Bommel wil ook dat Rutte naar de Kamer komt. Hij noemt het \"volkomen misplaatst dat de koning en minister Koenders naar Saoedi-Arabie afreizen voor rouwbeklag\"."
                            }
                        ]
                    }
