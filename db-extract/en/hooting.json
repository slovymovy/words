                        "glosses": [
                            "The sound of a hoot, or the occasion of producing this sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d952be3c-46e5-4341-8e7e-e1f0a28cf7f0",
                                "sense_id": "58605ac0-25f8-3106-b629-78fcb0420a95",
                                "text": "One small species, which is known to them by its melancholy nocturnal hootings (for as it never appears in the day few even of the hunters have ever seen it) is particularly ominous."
                            },
                            {
                                "example_id": "0fa718ce-99c5-402f-9003-6d8aaea9fe3a",
                                "sense_id": "58605ac0-25f8-3106-b629-78fcb0420a95",
                                "text": "Popanilla is found \"not guilty, and kicked out of court, amidst the hootings of the mob, without a stain upon his reputation.\""
                            },
                            {
                                "example_id": "b81f08d4-a780-49be-9036-746b4d5df0d3",
                                "sense_id": "58605ac0-25f8-3106-b629-78fcb0420a95",
                                "text": "The hootings of this unhappy gentleman may generally be heard in the still evenings, when the rooks are all at rest; and I have often listened to them of a moonlight night with a kind of mysterious gratification."
                            }
                        ]
                    }
                ],
