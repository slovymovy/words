                        "entry_id": "5a957df1-51c4-3875-8769-2af43f064381",
                        "glosses": [
                            "Artiste se produisant sur scène (ou encore, par analogie, personnalité publique, sportif…) qui a le sens du spectacle et la capacité d’enflammer son public."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "35a8cf55-f33b-4bf2-9f57-0c3b8c21c506",
                                "sense_id": "4316f7ec-eb0b-3454-b133-0d0638804405",
                                "text": "Sobtchak, elle est vraiment un show-man, ou plutôt une show-woman, commente Artiom, admiratif."
                            },
                            {
                                "example_id": "a4e807e6-546f-45da-ad6f-899b4e655b94",
                                "sense_id": "4316f7ec-eb0b-3454-b133-0d0638804405",
                                "text": "Il doit avoir des ennuis, car il n’arrête pas de me « dérider » tout au long du trajet, comme un show-man qui a ses vingt minutes de prestation à fournir…"
                            }
                        ]
                    }
