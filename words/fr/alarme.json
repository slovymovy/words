    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b8bda54-0bca-3af6-8e87-63f60831d8eb",
                    "sense_definition": "Signal sonore ou visuel qui avertit d'un danger imminent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "signal_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gardien a immédiatement déclenché l'<w>alarme</w> quand la fumée a envahi le couloir."
                        },
                        {
                            "text": "Tout le personnel a quitté le bâtiment dès qu'une fausse <w>alarme</w> a retenti ce matin."
                        }
                    ],
                    "synonyms": [
                        "alerte"
                    ],
                    "common_phrases": [
                        "fausse alarme",
                        "alarme incendie",
                        "alarme sonore"
                    ]
                },
                {
                    "sense_id": "e87a95e8-978c-305b-bbbb-2b67913aee73",
                    "sense_definition": "Signal sonore ou visuel programmé sur un appareil pour réveiller ou rappeler un événement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "horloge_rappel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de programmer une <w>alarme</w> pour ne pas rater ton train demain matin."
                        },
                        {
                            "text": "Son <w>alarme</w> matinale a sonné plusieurs fois avant qu'il ne se réveille enfin."
                        }
                    ],
                    "synonyms": [
                        "réveil",
                        "rappel"
                    ],
                    "common_phrases": [
                        "programmer une alarme",
                        "mettre une alarme"
                    ]
                },
                {
                    "sense_id": "96cd4c0f-8fa6-308f-bd57-0a92754b7504",
                    "sense_definition": "Dispositif ou appareil technique conçu pour déclencher un signal d'alerte en cas d'incident ou d'intrusion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signal_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les propriétaires ont fait installer une <w>alarme</w> moderne pour sécuriser leur maison de campagne."
                        },
                        {
                            "text": "Un technicien qualifié vérifie l'<w>alarme</w> antivol du magasin au moins une fois par an."
                        }
                    ],
                    "synonyms": [
