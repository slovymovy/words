                "senses": [
                    {
                        "sense_id": "fdaf2b90-0992-324a-9a7a-ba13fb00f489",
                        "entry_id": "914d6f21-1be0-3dc5-a57f-d478bfa55ab2",
                        "glosses": [
                            "ein quaderförmiges Stück Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba0cf4bc-fbc4-457d-b777-9aa3c9af9413",
                                "sense_id": "fdaf2b90-0992-324a-9a7a-ba13fb00f489",
                                "text": "„Die Chancen auf eine Klärung werden daher steigen, wenn das Kilogramm so wie die anderen Maßeinheiten auch, etwa der Meter oder die Sekunde, völlig anders definiert wird: über ein objektives Messverfahren, das keinen schwindsüchtigen Metallblock aus dem 19. Jahrhundert mehr braucht.“"
                            },
                            {
                                "example_id": "a3f2ae8f-f38d-466f-a7ea-32abae98c203",
                                "sense_id": "fdaf2b90-0992-324a-9a7a-ba13fb00f489",
                                "text": "„Diese Formen werden mit einer computergesteuerten Bohr- und Fräsmaschine auf den hundertstel Millimeter genau aus einem Metallblock gesägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
