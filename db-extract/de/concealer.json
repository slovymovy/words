                "senses": [
                    {
                        "sense_id": "5832919d-0931-366d-8d46-ce016dce66fa",
                        "entry_id": "2f6fffe9-df5b-36ea-9d5f-d27219076aa7",
                        "glosses": [
                            "cremige oder flüssige Substanz, die auf die Gesichtshaut aufgetragen wird, um Unebenheiten, Unreinheiten oder störende Farben abzudecken"
                        ],
                        "tags": [
                            "Kosmetik"
                        ],
                        "examples": [
                            {
                                "example_id": "d8b9c78e-965c-47e6-adbf-a763f9ef8f91",
                                "sense_id": "5832919d-0931-366d-8d46-ce016dce66fa",
                                "text": "Ein Concealer deckt kleine Schönheitsfehler im natürlichen Farbton ab."
                            },
                            {
                                "example_id": "db56b67b-1913-45c7-b4be-52f8b6c72310",
                                "sense_id": "5832919d-0931-366d-8d46-ce016dce66fa",
                                "text": "„Um ungeliebte Augenschatten zu verstecken kann man zu sogenannten Concealern greifen. Concealer sind stark pigmentierte Gesichtsabdeckcremes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
