                    "frequency": "Middle",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le matin, les brins d'herbe du jardin étaient couverts d'une brillante <w>rosée</w>."
                        },
                        {
                            "text": "Une fine perle de <w>rosée</w> scintillait sur les pétales de la fleur blanche."
                        }
                    ],
                    "common_phrases": [
