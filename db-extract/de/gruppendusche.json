                "senses": [
                    {
                        "sense_id": "3caacb5f-6fca-3c88-aa93-b8059d2e6bb4",
                        "entry_id": "dcf71f04-d64f-3e34-bd85-3fdee5f6f92b",
                        "glosses": [
                            "Raum mit mehreren Duschen, die von verschiedenen Personen genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a419d8b3-fdae-4c6d-85ba-43281654e17d",
                                "sense_id": "3caacb5f-6fca-3c88-aa93-b8059d2e6bb4",
                                "text": "„Am Anfang sind wir natürlich erst mal eingerückt, durchs Kasernentor hindurch, dreifach gesichert in diesen Wochen, und hinein ins Einzelzimmer mit Spind, Waschbecken und zwei DIN-A4-Handtüchern, mit minenfreiem Klo auf dem Gang und Gruppendusche im Erdgeschoss.“"
                            },
                            {
                                "example_id": "f46b17bb-90ed-4a99-b7d8-b4af38393fa0",
                                "sense_id": "3caacb5f-6fca-3c88-aa93-b8059d2e6bb4",
                                "text": "„Gruppenduschen und kratzige Bettwäsche waren früher - heute ist jedes Zimmer behindertengerecht und mit eigener Sanitärzelle ausgestattet.“"
                            },
                            {
                                "example_id": "b2434528-13f8-47f7-a081-6ab058875be0",
                                "sense_id": "3caacb5f-6fca-3c88-aa93-b8059d2e6bb4",
                                "text": "„Männer und Frauen drängelten sich in den engen Mehrbettzimmern und Gruppenduschen.“"
                            },
                            {
                                "example_id": "ff650756-b346-45f7-96ba-c9e5b57c996b",
                                "sense_id": "3caacb5f-6fca-3c88-aa93-b8059d2e6bb4",
                                "text": "„Nasse Klamotten, schlammige Schuhe und kalte Gruppenduschen gehören einfach dazu.“"
                            },
                            {
                                "example_id": "81200a14-d170-48d1-8e8f-ed6be183a44e",
                                "sense_id": "3caacb5f-6fca-3c88-aa93-b8059d2e6bb4",
                                "text": "„Unter den 19 Millionen Einwohnern in Schanghai sind Gruppenduschen, wie sie in Sportvereinen und Schwimmhallen in Deutschland zur Normalität gehören, und Umarmungen undenkbar, denn in China wird darauf geachtet, dass die Distanz gewahrt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
