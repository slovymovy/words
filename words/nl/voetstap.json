            "pos": "noun",
            "senses": [
                {
                    "sense_id": "466439ef-534d-3629-a011-3f9924595543",
                    "sense_definition": "De beweging of het geluid van een voet die op de grond wordt gezet tijdens het lopen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde een zware <w>voetstap</w> op de houten trap in de gang.",
                            "target_lang_translations": {
                                "en": "I heard a heavy <w>footstep</w> on the wooden stairs in the hallway."
                            }
                        },
                        {
                            "text": "Zij liep met een snelle <w>voetstap</w> naar de bushalte om de bus niet te missen.",
                            "target_lang_translations": {
                                "en": "She walked with a quick <w>step</w> to the bus stop so as not to miss the bus."
                            }
                        }
                    ],
                    "synonyms": [
                        "stap",
                        "pas"
                    ],
                    "common_phrases": [
                        "snelle voetstap",
                        "zware voetstap",
                        "geluid van voetstappen"
                    ],
                    "target_lang_definitions": {
                        "en": "The movement or sound of a foot being placed on the ground while walking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "footstep",
                                "target_lang_sense_clarification": "the sound or act of walking"
                            },
                            {
                                "target_lang_word": "step",
                                "target_lang_sense_clarification": "a single movement of the foot"
                            },
                            {
                                "target_lang_word": "pace",
                                "target_lang_sense_clarification": "a single step or manner of walking"
                            },
                            {
                                "target_lang_word": "stride",
                                "target_lang_sense_clarification": "a long or decisive step"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97df60d3-604b-36f9-a9de-cbf4b6ff155d",
                    "sense_definition": "De afdruk die een voet achterlaat in een zachte ondergrond zoals zand of sneeuw.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afdruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het verse zand was elke <w>voetstap</w> van de wandelaar duidelijk te zien.",
                            "target_lang_translations": {
                                "en": "In the fresh sand, every <w>footprint</w> of the hiker was clearly visible."
                            }
                        },
                        {
                            "text": "De detective volgde de <w>voetstap</w> in de modder om de dief te vinden.",
                            "target_lang_translations": {
                                "en": "The detective followed the <w>footstep</w> in the mud to find the thief."
                            }
                        }
                    ],
                    "synonyms": [
                        "voetafdruk",
                        "spoor"
                    ],
                    "common_phrases": [
                        "voetstap in het zand",
                        "diepe voetstap"
                    ],
                    "target_lang_definitions": {
                        "en": "The print left by a foot in a soft surface such as sand or snow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "footprint",
                                "target_lang_sense_clarification": "an impression left by a foot"
                            },
                            {
                                "target_lang_word": "footstep",
                                "target_lang_sense_clarification": "a mark or track left by a foot"
                            },
                            {
                                "target_lang_word": "track",
                                "target_lang_sense_clarification": "a series of marks left by a person or animal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
