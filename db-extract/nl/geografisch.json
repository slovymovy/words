                    {
                        "sense_id": "0140280c-81ab-355a-b66a-1c968fda58c7",
                        "entry_id": "a477d0ff-c1e2-3ec1-bd54-b5f302f09fd8",
                        "glosses": [
                            "aardrijkskundig, met betrekking tot de aardrijkskunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8947e524-12fe-49f1-a9e3-35bf342fbadd",
                                "sense_id": "0140280c-81ab-355a-b66a-1c968fda58c7",
                                "text": "Dit geografische begrip is mij volkomen duidelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4590218-cfed-4e0f-bb61-025c3479d0ee",
                        "source_entry_id": "a477d0ff-c1e2-3ec1-bd54-b5f302f09fd8",
                        "source_sense_id": "0140280c-81ab-355a-b66a-1c968fda58c7",
                        "source_sense_description": "aardrijkskundig, met betrekking tot de aardrijkskunde",
                        "target_lang_word": "geographisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geographisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70f39336-848c-3701-aa14-b34debb649f1",
                                        "entry_id": "806df7b9-02eb-3286-9bef-7ec19f8cf30e",
                                        "glosses": [
                                            "die Geographie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e61924-8eed-4f90-9584-bf2a9a35e6d0",
                                                "sense_id": "70f39336-848c-3701-aa14-b34debb649f1",
                                                "text": "„Um die Zeit, in der sich Beke, Cooley und andere wegen des Kilimandscharo auf teilweise unfeine englische Art und Weise befehden, entstehen im deutschen Sprachraum wichtige geographische Zeitschriften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "548b83d6-8dbf-4105-8da0-2c15aa4e353b",
                        "source_entry_id": "a477d0ff-c1e2-3ec1-bd54-b5f302f09fd8",
                        "source_sense_id": "0140280c-81ab-355a-b66a-1c968fda58c7",
                        "source_sense_description": "aardrijkskundig, met betrekking tot de aardrijkskunde",
                        "target_lang_word": "geographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7abedf66-7487-3a93-9967-e73274f6e0c0",
                                        "entry_id": "0b75ea48-3949-30d6-b16f-47069efaafe0",
                                        "glosses": [
                                            "Pertaining to geography (or to geographics)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b23640e-ea00-4c82-a28f-6f018162c345",
                                                "sense_id": "7abedf66-7487-3a93-9967-e73274f6e0c0",
                                                "text": "In his book, Polystate: A Thought Experiment in Distributed Government, Zach Weinersmith speculates about what governments would look like if they didn’t rule over geographic locations, but instead ruled over minds."
                                            },
                                            {
                                                "example_id": "b178399a-84eb-4cff-a021-2961321686a4",
                                                "sense_id": "7abedf66-7487-3a93-9967-e73274f6e0c0",
                                                "text": "The player is free to create their own narrative within a much larger set of possible designed narrative options, or, given the geographic and dialogical openness of Morrowind, to refuse the creation of any narrative but their own and wander aimlessly through the game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab0cfaa-c0f7-3302-9f32-b14d843315d7",
                                        "entry_id": "0b75ea48-3949-30d6-b16f-47069efaafe0",
                                        "glosses": [
                                            "Determined by geography, as opposed to magnetic (i.e. North)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "631e36d5-f0c0-4864-9480-3e6fc1350d5c",
                        "source_entry_id": "a477d0ff-c1e2-3ec1-bd54-b5f302f09fd8",
                        "source_sense_id": "0140280c-81ab-355a-b66a-1c968fda58c7",
                        "source_sense_description": "aardrijkskundig, met betrekking tot de aardrijkskunde",
                        "target_lang_word": "geographical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geographical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2019f24-1d21-3d15-9ea8-0879fb86de64",
                                        "entry_id": "4fa3281b-8690-3077-880b-560fc49eefa2",
                                        "glosses": [
                                            "Of or relating to geography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498c9067-8415-47f8-9d19-70265ae6f150",
                                                "sense_id": "f2019f24-1d21-3d15-9ea8-0879fb86de64",
                                                "text": "Morality knows nothing of geographical boundaries, or distinctions of race."
                                            },
                                            {
                                                "example_id": "81fc468e-b501-404a-8e4d-35201536b00e",
                                                "sense_id": "f2019f24-1d21-3d15-9ea8-0879fb86de64",
                                                "text": "ONE OF the facts which define the United States is that its national and its imperial boundaries are the same. Another is that it is a political unit which occupies a remarkably compact geographical unit of continental extent."
                                            },
                                            {
                                                "example_id": "dbe17b72-abdd-433b-958c-0bdf1ef71ea1",
                                                "sense_id": "f2019f24-1d21-3d15-9ea8-0879fb86de64",
                                                "text": "Clearly, the plane of the frame must be dominant, since that is the only plane that actually exists on the screen. Composition for this plane, however, is often influenced by factors in the geographical plane since, unless we are dealing with animation, a photographer or cinematographer must compose for the frame plane in the geographical plane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geographical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79e73b0b-f0c7-32f4-9c8c-8b607f11076e",
                                        "entry_id": "ae2c8d52-bdc1-34be-8138-68f6875ba70c",
                                        "glosses": [
                                            "A move to another place in the hope of curing an addiction etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b68468e-7757-4e15-88b9-3cb234907809",
                                                "sense_id": "79e73b0b-f0c7-32f4-9c8c-8b607f11076e",
                                                "text": "At QA they called these 'Geographicals'. It was a common tactic of the alcoholic type to think that a move would make all the difference."
                                            },
                                            {
                                                "example_id": "fcf853d9-1f29-4b22-8258-21c52fc0771c",
                                                "sense_id": "79e73b0b-f0c7-32f4-9c8c-8b607f11076e",
                                                "text": "There were always too many geographicals. That is a change of address."
                                            },
                                            {
                                                "example_id": "18317e6a-f1c4-4892-aa22-0f88a97f78fc",
                                                "sense_id": "79e73b0b-f0c7-32f4-9c8c-8b607f11076e",
                                                "text": "'Doing Geographicals'\nThe word 'geographical' comes from the recovery community. It refers to one of the actions that an alcoholic mistakenly takes in order to 'fix' their problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0875c284-1656-4e48-9ac9-bf5945b45b03",
                        "source_entry_id": "a477d0ff-c1e2-3ec1-bd54-b5f302f09fd8",
                        "source_sense_id": "0140280c-81ab-355a-b66a-1c968fda58c7",
                        "source_sense_description": "aardrijkskundig, met betrekking tot de aardrijkskunde",
                        "target_lang_word": "géographique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géographique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f34ef3f-b591-34db-bf61-bfef6cd7e138",
                                        "entry_id": "1f0f055d-9186-350c-9fb3-2b0ce304c358",
                                        "glosses": [
                                            "Relatif à la géographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8195de6f-59d5-4f3e-b521-7cc9ddc79544",
                                                "sense_id": "7f34ef3f-b591-34db-bf61-bfef6cd7e138",
                                                "text": "S’il fallait dans un intérêt purement géographique vous élever jusqu’au pôle, je suis assurée que vous n’hésiteriez pas."
                                            },
                                            {
                                                "example_id": "b9e24f80-2ee9-4912-af88-62f6e112a8ea",
                                                "sense_id": "7f34ef3f-b591-34db-bf61-bfef6cd7e138",
                                                "text": "Dès l’année 1808, au début même de notre carrière géographique, nous n’avons pas hésité à rejeter comme inadmissible l’évaluation de lord Macartney."
                                            },
                                            {
                                                "example_id": "108e9657-7ec2-4604-9a28-559362ef4d2a",
                                                "sense_id": "7f34ef3f-b591-34db-bf61-bfef6cd7e138",
                                                "text": "J’étais studieusement préparé, pourtant, largement approvisionné de documents géographiques et ethnologiques, relatifs à la région transcaucasienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d77d6cde-fcd5-306b-8f3a-bc0dc9f428ef",
                                        "entry_id": "1f0f055d-9186-350c-9fb3-2b0ce304c358",
                                        "glosses": [
                                            "Relatif à la répartition spatiale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "698a7f78-7cb2-496d-9a6b-079f54d87ebd",
                                                "sense_id": "d77d6cde-fcd5-306b-8f3a-bc0dc9f428ef",
                                                "text": "La répartition géographique des planctons, dont la connaissance est si utile aux pêcheries, conditionne la présence des dépôts sous-marins comme ces boues à Diatomées origine du tripoli."
                                            },
                                            {
                                                "example_id": "8b2d5848-a2e7-4118-bb8f-0a4b0dd8eb0e",
                                                "sense_id": "d77d6cde-fcd5-306b-8f3a-bc0dc9f428ef",
                                                "text": "Une étude du Cépii suggère qu’une meilleure représentation des salariés au conseil d’administration et une plus grande proximité géographique entre les sièges sociaux et les usines expliquent, en partie, pourquoi l’Allemagne a moins désindustrialisé que la France."
                                            },
                                            {
                                                "example_id": "a1313714-7e58-4d5e-87db-dcc0ac6a485c",
                                                "sense_id": "d77d6cde-fcd5-306b-8f3a-bc0dc9f428ef",
                                                "text": "La disposition géographique de l’Avonne, flottable pendant environ quatre lieues, avait, depuis l’invention de Jean Rouvet, donné toute leur valeur aux forêts des Aigues, de Soulanges et de Ronquerolles situées sur la crête des collines au bas desquelles coule cette charmante rivière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14533d20-0fa7-3162-82b5-d22876d9825a",
                                        "entry_id": "1f0f055d-9186-350c-9fb3-2b0ce304c358",
                                        "glosses": [
                                            "Relatif aux géographes."
                                        ],
                                        "tags": [
                                            "Beaucoup moins courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b642308c-c7be-4fe3-9043-1332032fa931",
                                                "sense_id": "14533d20-0fa7-3162-82b5-d22876d9825a",
                                                "text": "Le monde géographique vient de faire une nouvelle perte dans la personne de notre compatriote, Edmond Musy, né à Viriat (Ain), en 1851, mort au mois de février, dans le département de l’Isère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
