                                "target_senses": [
                                    {
                                        "sense_id": "27001bb8-6c71-3e28-9f0f-19b9828e5421",
                                        "entry_id": "47b6cbac-7be7-3166-b381-570526558392",
                                        "glosses": [
                                            "Of or relating to the volition or will."
                                        ],
                                        "tags": [
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3abf09e-f28a-47b6-a227-5693e6e9447a",
                                                "sense_id": "27001bb8-6c71-3e28-9f0f-19b9828e5421",
                                                "text": "Little by little the whole subject population of the world was fitted with the instruments of volitional control. The government was now practically omnipotent."
                                            },
                                            {
                                                "example_id": "59f7e7d8-4c43-4572-8262-6b7632234741",
                                                "sense_id": "27001bb8-6c71-3e28-9f0f-19b9828e5421",
                                                "text": "Stern and Karl Bühler noticed independently that a child’s first “No” has a volitional meaning and that the significance as a simple denial of fact appears several months afterwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca3b875-5c23-3645-a548-0e6cd65b8b15",
                                        "entry_id": "47b6cbac-7be7-3166-b381-570526558392",
                                        "glosses": [
                                            "Done by conscious, personal choice; not based on external principles; not accidental."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64142ff5-8f2c-4553-ad3d-a3c43169df7e",
                                                "sense_id": "fca3b875-5c23-3645-a548-0e6cd65b8b15",
                                                "text": "A man of genius makes no mistakes. His errors are volitional and are the portals to discovery."
                                            },
                                            {
                                                "example_id": "e911e636-cd17-4bce-9b84-1fe74527fee5",
                                                "sense_id": "fca3b875-5c23-3645-a548-0e6cd65b8b15",
                                                "text": "“Loving on” someone—whether he likes it or not—posits love as a volitional activity, an act not of passion but of will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d95aa5-8c85-31e9-a554-f766bfee33d8",
                                        "entry_id": "47b6cbac-7be7-3166-b381-570526558392",
                                        "glosses": [
                                            "Expressing intention, hortation, supposition, or inclusive invitation."
                                        ],
