                    },
                    {
                        "form_id": "c1123327-0a09-4c1c-8a04-447ea9d1ee9f",
                        "entry_id": "1a92a172-f429-37f7-88ce-7c3a14f154d6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Odium"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6214372-0ed2-3739-bc1a-3f461acb8495",
                        "entry_id": "1a92a172-f429-37f7-88ce-7c3a14f154d6",
                        "glosses": [
                            "übler Beigeschmack"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "da636cc9-c367-4b16-b06c-6c8f04cfd972",
                                "sense_id": "b6214372-0ed2-3739-bc1a-3f461acb8495",
                                "text": "„Durch die lange Karenzzeit seit dem Austritt aus der CDU war das Odium des Parteiwechslers zudem weitgehend vergessen.“"
                            },
                            {
                                "example_id": "f44761e3-435a-43ab-a92e-c539106b0293",
                                "sense_id": "b6214372-0ed2-3739-bc1a-3f461acb8495",
                                "text": "„Dieser bedenkliche Vergleich versprühte nicht nur das Odium des Kalten Krieges, sondern zeugte zugleich von einer wachsenden Gereiztheit der französischen Diplomatie, von der auch der Außenminister nicht ganz frei war.“"
                            },
                            {
                                "example_id": "901031e6-158d-4f2a-af1b-1d0b5df581e9",
                                "sense_id": "b6214372-0ed2-3739-bc1a-3f461acb8495",
                                "text": "„Andere Ansichten als die seinen duldete er nicht, er versah sie sofort mit dem Odium des Kriminellen, und nun erst begann sich sein zügelloser Widerspruchsgeist voll und entsetzlich auszutoben.“"
                            },
                            {
                                "example_id": "3e9fabd8-3e3c-4f0a-836e-5b1edb0da9ed",
                                "sense_id": "b6214372-0ed2-3739-bc1a-3f461acb8495",
                                "text": "„Wir, die wir berufen gewesen wären, entgegenzuwirken, haben zu lange gezögert, uns mit dem profanen Odium der Tagespolitik zu belasten, wir lebten zu sehr in der ›splendid isolation‹ des Geistes und der Künste: und so tragen wir, auch wenn wir dann zu Opfern der Gewalt oder zu Heimatvertriebenen wurden, genauso wie alle Deutschen an jener Kollektiv-Scham, die Theodor Heuss dem sinnlosen Anathema einer ›Kollektiv-Schuld‹ entgegengesetzt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "962a2be2-41a6-4740-a9ce-d40a7b51979f",
                        "source_entry_id": "1a92a172-f429-37f7-88ce-7c3a14f154d6",
                        "source_sense_id": "b6214372-0ed2-3739-bc1a-3f461acb8495",
                        "source_sense_description": "gehoben: übler Beigeschmack",
                        "target_lang_word": "odium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                        "entry_id": "11da9cb3-ee7b-3e84-a93b-48f299448649",
                                        "glosses": [
                                            "Hatred; dislike."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d767af-cf7f-4a2b-81c3-24f678828213",
                                                "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                                "text": "His conduct brought him into odium, or, brought odium upon him."
                                            },
                                            {
                                                "example_id": "3470403e-d6a5-4ced-a3fe-dbdbb8965c64",
                                                "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                                "text": "And it gives to ambitious, corrupted, or deluded citizens, (who devote themselves to the favorite nation,) facility to betray or sacrifice the interests of their own country, without odium, sometimes even with popularity; gilding, with the appearances of a virtuous sense of obligation, a commendable deference for public opinion, or a laudable zeal for public good, the base or foolish compliances of ambition, corruption, or infatuation."
                                            },
                                            {
                                                "example_id": "7720b502-ecee-4971-8ac4-148d9494f4f0",
                                                "sense_id": "e2c37934-1b9d-34cd-a4df-7ac12576931b",
                                                "text": "‘I warned you, if you give evidence against your husband, you will be shunned. You will be held in odium. You will be alone.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88d2ffda-2818-3d05-853d-dba1b259e6d5",
                                        "entry_id": "11da9cb3-ee7b-3e84-a93b-48f299448649",
                                        "glosses": [
                                            "The quality that provokes hatred; offensiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564c8d60-27e7-4d16-925a-492d554170e3",
                                                "sense_id": "88d2ffda-2818-3d05-853d-dba1b259e6d5",
                                                "text": "She threw the odium of the fact on me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
