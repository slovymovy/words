                                                "sense_id": "79cde082-dbc2-32b2-9df7-0c8baff7e61b",
                                                "text": "„Er liebt die Kneipen, die Maskenbälle, die Redouten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1ddb4c4-4667-330b-9c86-3b3951765aa2",
