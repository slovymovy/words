                    "frequency": "High",
                    "semantic_group_id": "entite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>être</w> vivant a un rôle crucial dans cet écosystème fragile."
                        },
                        {
                            "text": "Cet homme consacre toute son énergie à protéger les <w>êtres</w> vulnérables."
                        }
                    ],
                    "synonyms": [
                        "créature",
                        "individu",
                        "organisme"
                    ],
                    "common_phrases": [
                        "être humain",
                        "être vivant",
                        "être cher"
                    ]
