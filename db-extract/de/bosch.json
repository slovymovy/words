                ],
                "senses": [
                    {
                        "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                        "entry_id": "1e4ce626-05b1-3230-b14c-0f3af6c007de",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada58a19-a1c2-4cdb-a271-889c5659f580",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Die Boschs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0accbe4e-ebbc-413c-b97e-5558aa6d71d5",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Der Bosch trägt nie die Schals, die die Bosch ihm strickt."
                            },
                            {
                                "example_id": "0acecbc4-8a72-4d2d-a85a-849078b865fa",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bosch kommt, geht der Herr Bosch.“"
                            },
                            {
                                "example_id": "9b2aee90-4c08-4e39-9a8d-7a77d8ea6117",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Bosch kommt und geht."
                            },
                            {
                                "example_id": "71866b09-2915-46b4-bf2b-728feea434cf",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Boschs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "bb96262d-a4ac-4580-ac41-1e631f623721",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Frau Bosch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cc5ded69-0569-4d0d-bfc7-27f25106fbb5",
                                "sense_id": "5065203b-d124-334a-b3b7-389ed958234c",
                                "text": "Herr Bosch wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
