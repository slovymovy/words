                "senses": [
                    {
                        "sense_id": "2a35c0f4-62ce-395e-8067-06bcb98b92d7",
                        "entry_id": "f2bd2bde-8d95-3b1c-b0c5-860472e0cb08",
                        "glosses": [
                            "Qui ne peut pas être évalué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4178603-9c5e-4f5e-997c-a838121f92bd",
                                "sense_id": "2a35c0f4-62ce-395e-8067-06bcb98b92d7",
                                "text": "Cinquante comptables ont failli : l’on peut évaluer cette perte à quarante millions pour votre trésor ; elle est inévaluable pour vos sujets."
                            },
                            {
                                "example_id": "4e00520b-7fd4-4ad0-9d7e-d2174b9141ff",
                                "sense_id": "2a35c0f4-62ce-395e-8067-06bcb98b92d7",
                                "text": "Refuser d’indemniser un élément inévaluable, ou très difficilement évaluable, correspond à l’idée de ne pas faire supporter au responsable une charge supérieure au préjudice qu’il a réellement causé, mais fait matériellement supporter cette incertitude à la victime du dommage."
                            },
                            {
                                "example_id": "10b5db44-f819-4442-bed1-14ccad1a6098",
                                "sense_id": "2a35c0f4-62ce-395e-8067-06bcb98b92d7",
                                "text": "Ce qui est affiché comme une nouveauté, une « innovation » ou même une « révolution » est valorisant pour une carrière. Ces critères de reconnaissance professionnelle l’emportent sur tous les autres, par ailleurs réputés inévaluables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "941a3404-1bdd-4a48-88e8-89a3da96bc67",
                        "source_entry_id": "f2bd2bde-8d95-3b1c-b0c5-860472e0cb08",
                        "source_sense_id": "2a35c0f4-62ce-395e-8067-06bcb98b92d7",
                        "target_lang_word": "unbewertbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbewertbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eae2463c-6cff-3152-b591-61f5842f4542",
                                        "entry_id": "2781493a-f96a-3dc9-bd9e-269fe07558af",
                                        "glosses": [
                                            "so, dass es nicht bewertet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd332157-e4a7-44f8-ad7d-2b296060a2bf",
                                                "sense_id": "eae2463c-6cff-3152-b591-61f5842f4542",
                                                "text": "„Wir halten uns an den Buchstaben. Der Buchstabe allein hat Wert und Bestimmtheit. Der Geist ist unbewertbar, unbestimmt, Trugbilder sind die Ideen. Wer Geschichte schreibt, muß höchst eitel sein und Freude am Erfinden haben.“"
                                            },
                                            {
                                                "example_id": "4ba014b8-0bc1-4d66-8866-57c0d94d31a1",
                                                "sense_id": "eae2463c-6cff-3152-b591-61f5842f4542",
                                                "text": "„Der Berliner hatte sein Kunststudium mit dem als »unbewertbar« benoteten »Experiment« eines bis zur Decke mit Blättern und Bildern seiner aktionistischen Kunst angefüllten Arbeitsraumes abgeschlossen.“"
                                            },
                                            {
                                                "example_id": "5ddefa55-0b7a-40e0-8b35-8ec3c0c58b8b",
                                                "sense_id": "eae2463c-6cff-3152-b591-61f5842f4542",
                                                "text": "„Noch ist nicht (öffentlich) bekannt, wie viel von den potenziell offenen Forderungen von bis zu 19 Millionen Euro auch von Sturms Masseverwalter Norbert Scherbaum anerkannt werden, die Chance des Ausgleichs (20 Prozent) plus Superquote (bis zu fünf Prozent zusätzlich) ist unbewertbar.“"
                                            },
                                            {
                                                "example_id": "be947b35-bfa4-4486-82fe-42e2abde68c0",
                                                "sense_id": "eae2463c-6cff-3152-b591-61f5842f4542",
                                                "text": "„Schier unüberblickbar, unerfassbar und unbewertbar die Flut neuer Mode-, Slang-, Jugend-, Werbe- und Fachwörter – ganz zu schweigen vom Zustrom immer neuer, oft verballhornter Fremd- und Lehnwörter.“"
                                            },
                                            {
                                                "example_id": "5b1cc54c-bd80-4cc1-afe2-f32a40fe2a6f",
                                                "sense_id": "eae2463c-6cff-3152-b591-61f5842f4542",
                                                "text": "„Obwohl vieles dafür spricht, Design als im Prinzip unbewertbar zu sehen, versuchen Designinstitutionen mittels Designpreisen zu vermitteln, was gutes Design sein könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
