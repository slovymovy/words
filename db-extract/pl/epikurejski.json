                        ]
                    },
                    {
                        "translation_id": "3ad6247f-6346-4608-a46b-97eb87685050",
                        "source_entry_id": "606df56b-6443-3c69-95e6-a55492f323bd",
                        "source_sense_id": "1304398a-c043-3a19-8721-d4e8d7a3e650",
                        "target_lang_word": "epikurejský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bae33d57-efb4-424b-b507-ed8b308e67f7",
                        "source_entry_id": "606df56b-6443-3c69-95e6-a55492f323bd",
                        "source_sense_id": "1304398a-c043-3a19-8721-d4e8d7a3e650",
                        "target_lang_word": "épicurien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épicurien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                        "entry_id": "be444f46-4ad3-31f9-8889-7f059a6337f7",
                                        "glosses": [
                                            "Qui est partisan de la doctrine d’Épicure ; qui est conforme à cette doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a664a7-f333-433e-a2a6-836a5e586823",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "Le moment semble venu où l'on peut avec plus de justice apprécier la doctrine épicurienne, et chercher la part de vérité qu'elle renferme."
                                            },
                                            {
                                                "example_id": "4f1c0696-6779-4b2f-8b5d-7871fbb3a836",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "La clé de la sagesse épicurienne consiste à comprendre que nous pouvons être heureux si nos désirs, au lieu d'être illimités, se ramènent à la dimension restreinte des besoins de notre corps."
                                            },
                                            {
                                                "example_id": "00ef2ea5-9fd5-4176-bcde-9e49d1d89566",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "Il semble au contraire que, dans l’épistémologie de la physique épicurienne, l'observation du monde, sa connaissance empirique, soit non seulement légitime, mais encore nécessaire."
                                            },
                                            {
                                                "example_id": "03069d3e-4348-4af8-a4bb-28207fca5d30",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "En questionnant : « Dites-moi si vous avez jamais vu ou lu des philosophes pensant que le monde a été fait par hasard », Spinoza qui, quelques lignes après, fera l'éloge des Atomistes, affirme, par là même implicitement que telle n'est pas, selon lui, la conception épicurienne du clinamen."
                                            },
                                            {
                                                "example_id": "c31f3d02-a6a4-40e4-ada0-700eb69157c1",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "Il demeurait cependant, dans le bouquet SFR, bien des pépites, sur le plan culinaire en particulier, je devenais maintenant un bon vieux gros bonhomme, un philosophe épicurien pourquoi pas, qu’est-ce qu’Épicure avait d’autre en tête, au juste ? En même temps un quignon de pain rassis et un filet d’huile d’olive c’était un peu limité, il me fallait des médaillons de homard et des Saint-Jacques avec leurs petits légumes, j’étais un décadent moi, pas un pédé rural grec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4235e9b5-dc02-3041-8651-46ddd0518002",
                                        "entry_id": "be444f46-4ad3-31f9-8889-7f059a6337f7",
                                        "glosses": [
                                            "Hédoniste, qui ne songe qu’au plaisir."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d01ae90-60d9-4f0b-9e51-9123c2573407",
                                                "sense_id": "4235e9b5-dc02-3041-8651-46ddd0518002",
                                                "text": "[…] ; on aurait pu dire de ses traits qu’ils étaient beaux, s’il ne s’était niché sous l’arcade de son œil le sentiment rare et épicurien qui indique l’homme des brûlantes voluptés."
                                            },
                                            {
                                                "example_id": "fcccc2ea-9c0b-4d5f-93a2-619df179c219",
                                                "sense_id": "4235e9b5-dc02-3041-8651-46ddd0518002",
                                                "text": "En voyant ses mauvais mœurs, ses goûts épicuriens, l'impiété même dont il faisait profession ouverte, sauf à s'en défendre tant bien que mal, soupçonnerait-on que Costar était d'église ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épicurien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                                        "glosses": [
                                            "Celui qui est partisan de la doctrine d’Épicure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe2161e-a6dc-48b8-b5f4-09a75685e2f9",
                                                "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                                "text": "Vivre comme un dieu exige que l'on cesse de croire aux dieux. Ainsi, la leçon des épicuriens est que la philosophie change les hommes en dieux en leur enseignant qu'il n'y a pas sur cette terre d'autres dieux qu'eux-mêmes dès lors qu'ils auront cessé de croire et vainement d'espérer."
                                            },
                                            {
                                                "example_id": "64208465-de81-4f0d-b037-0b649dc057c5",
                                                "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                                "text": "On s’aperçoit que les épicuriens était d'une grande culture ; ils n'étaient absolument pas les rustres que les stoïciens aimaient à décrire, ces fameux « pourceaux d’Épicure » comme on a dit pour les discréditer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6cd4382-3872-3bf0-a5db-37827739bd25",
                                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                                        "glosses": [
                                            "Celui qui aime le plaisir, la jouissance."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9244b635-c9a2-4f85-af51-b2d16480938a",
                        "source_entry_id": "606df56b-6443-3c69-95e6-a55492f323bd",
                        "source_sense_id": "1304398a-c043-3a19-8721-d4e8d7a3e650",
                        "target_lang_word": "epicúreo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7bb24360-69cf-4290-825f-1c6bcab97073",
                        "source_entry_id": "606df56b-6443-3c69-95e6-a55492f323bd",
                        "source_sense_id": "1304398a-c043-3a19-8721-d4e8d7a3e650",
                        "target_lang_word": "эпикурейский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эпикурейский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "82a12d70-42fa-34bb-beee-20d550fdb3c0",
                                        "entry_id": "d3829aa7-e070-3938-b3bf-92b31ba9e117",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительными эпикуреец, эпикуреизм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e4760e-bf25-4f3d-bc72-a8be31bdbd6e",
                                                "sense_id": "82a12d70-42fa-34bb-beee-20d550fdb3c0",
                                                "text": "Некоторые из эпикурейских и стоических философов стали спорить с ним; и одни говорили: «что хочет сказать этот суеслов?», а другие: «кажется, он проповедует о чужих божествах», потому что он благовествовал им Иисуса и воскресение."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01f44bc1-4fa0-4ebb-bb86-e58f2448eaa4",
                        "source_entry_id": "606df56b-6443-3c69-95e6-a55492f323bd",
                        "source_sense_id": "0fb0751c-2dea-3b23-9d01-315c5bd39968",
                        "target_lang_word": "epicurean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epicurean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3515eb4c-ac09-37fc-8065-6afe2e7d71e2",
                                        "entry_id": "c3a9eac0-9314-32e1-ab15-7903f7d52fb1",
                                        "glosses": [
                                            "Pursuing pleasure, especially in reference to food or comfort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61aabf0c-6986-4e22-90fb-8ab2add4ee55",
                                                "sense_id": "3515eb4c-ac09-37fc-8065-6afe2e7d71e2",
                                                "text": "The powers of the Canadian voyageurs and hunters in the consumption of meat strike the greenhorn with wonder and astonishment; and are only equalled by the gastronomical capabilities exhibited by Indian dogs, both following the same plan in their epicurean gorgings."
                                            },
                                            {
                                                "example_id": "51d89a87-0577-418e-9a7c-d4b5f1cbae12",
                                                "sense_id": "3515eb4c-ac09-37fc-8065-6afe2e7d71e2",
                                                "text": "Though a list of the great writers contain all the constituents of an Epicurean feast, yet to most of us it resembles the menu of a Gargantuan banquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479f36e5-b827-36c5-b1d3-1dac80f919ed",
                                        "entry_id": "c3a9eac0-9314-32e1-ab15-7903f7d52fb1",
                                        "glosses": [
                                            "Devoted to luxurious living."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "epicurean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f26fac1b-ba16-36ce-a78e-0b501e320907",
                                        "entry_id": "4e5ef5a8-b721-317b-97d6-6a4b9c81f9ff",
                                        "glosses": [
                                            "One who is devoted to pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1e73260-c2b8-4331-897c-a9c42567b8e0",
                                                "sense_id": "f26fac1b-ba16-36ce-a78e-0b501e320907",
                                                "text": "I keep but a man and a maid, ever ready to slander and steal ; / I know it, and smile a hard-set smile, like a stoic, or like / A wiser epicurean, and let the world have its way."
                                            },
                                            {
                                                "example_id": "09c394e6-ce5e-4dc1-9a57-5d6855686538",
                                                "sense_id": "f26fac1b-ba16-36ce-a78e-0b501e320907",
                                                "text": "Other eras have had their epicureans or hedonists, of course, who lived and sometimes died for the ideal of simplicity or pleasure in an epic kind of way. But today’s gazillion-strong influencer community has zero intellectual underpinning to it, which is why it’s so often the unwitting butt of its own joke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e128bc0-6280-4b21-84e8-31de44cb50cf",
                        "source_entry_id": "606df56b-6443-3c69-95e6-a55492f323bd",
                        "source_sense_id": "0fb0751c-2dea-3b23-9d01-315c5bd39968",
                        "target_lang_word": "épicurien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épicurien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                        "entry_id": "be444f46-4ad3-31f9-8889-7f059a6337f7",
                                        "glosses": [
                                            "Qui est partisan de la doctrine d’Épicure ; qui est conforme à cette doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a664a7-f333-433e-a2a6-836a5e586823",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "Le moment semble venu où l'on peut avec plus de justice apprécier la doctrine épicurienne, et chercher la part de vérité qu'elle renferme."
                                            },
                                            {
                                                "example_id": "4f1c0696-6779-4b2f-8b5d-7871fbb3a836",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "La clé de la sagesse épicurienne consiste à comprendre que nous pouvons être heureux si nos désirs, au lieu d'être illimités, se ramènent à la dimension restreinte des besoins de notre corps."
                                            },
                                            {
                                                "example_id": "00ef2ea5-9fd5-4176-bcde-9e49d1d89566",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "Il semble au contraire que, dans l’épistémologie de la physique épicurienne, l'observation du monde, sa connaissance empirique, soit non seulement légitime, mais encore nécessaire."
                                            },
                                            {
                                                "example_id": "03069d3e-4348-4af8-a4bb-28207fca5d30",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "En questionnant : « Dites-moi si vous avez jamais vu ou lu des philosophes pensant que le monde a été fait par hasard », Spinoza qui, quelques lignes après, fera l'éloge des Atomistes, affirme, par là même implicitement que telle n'est pas, selon lui, la conception épicurienne du clinamen."
                                            },
                                            {
                                                "example_id": "c31f3d02-a6a4-40e4-ada0-700eb69157c1",
                                                "sense_id": "f8c1a757-0a40-3ec5-95fd-fcb1d722ad17",
                                                "text": "Il demeurait cependant, dans le bouquet SFR, bien des pépites, sur le plan culinaire en particulier, je devenais maintenant un bon vieux gros bonhomme, un philosophe épicurien pourquoi pas, qu’est-ce qu’Épicure avait d’autre en tête, au juste ? En même temps un quignon de pain rassis et un filet d’huile d’olive c’était un peu limité, il me fallait des médaillons de homard et des Saint-Jacques avec leurs petits légumes, j’étais un décadent moi, pas un pédé rural grec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4235e9b5-dc02-3041-8651-46ddd0518002",
                                        "entry_id": "be444f46-4ad3-31f9-8889-7f059a6337f7",
                                        "glosses": [
                                            "Hédoniste, qui ne songe qu’au plaisir."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d01ae90-60d9-4f0b-9e51-9123c2573407",
                                                "sense_id": "4235e9b5-dc02-3041-8651-46ddd0518002",
                                                "text": "[…] ; on aurait pu dire de ses traits qu’ils étaient beaux, s’il ne s’était niché sous l’arcade de son œil le sentiment rare et épicurien qui indique l’homme des brûlantes voluptés."
                                            },
                                            {
                                                "example_id": "fcccc2ea-9c0b-4d5f-93a2-619df179c219",
                                                "sense_id": "4235e9b5-dc02-3041-8651-46ddd0518002",
                                                "text": "En voyant ses mauvais mœurs, ses goûts épicuriens, l'impiété même dont il faisait profession ouverte, sauf à s'en défendre tant bien que mal, soupçonnerait-on que Costar était d'église ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épicurien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                                        "glosses": [
                                            "Celui qui est partisan de la doctrine d’Épicure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe2161e-a6dc-48b8-b5f4-09a75685e2f9",
                                                "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                                "text": "Vivre comme un dieu exige que l'on cesse de croire aux dieux. Ainsi, la leçon des épicuriens est que la philosophie change les hommes en dieux en leur enseignant qu'il n'y a pas sur cette terre d'autres dieux qu'eux-mêmes dès lors qu'ils auront cessé de croire et vainement d'espérer."
                                            },
                                            {
                                                "example_id": "64208465-de81-4f0d-b037-0b649dc057c5",
                                                "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                                "text": "On s’aperçoit que les épicuriens était d'une grande culture ; ils n'étaient absolument pas les rustres que les stoïciens aimaient à décrire, ces fameux « pourceaux d’Épicure » comme on a dit pour les discréditer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6cd4382-3872-3bf0-a5db-37827739bd25",
                                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                                        "glosses": [
                                            "Celui qui aime le plaisir, la jouissance."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
