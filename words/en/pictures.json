                    "sense_definition": "Plural of <w>picture</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She likes to draw <w>pictures</w> of flowers and trees in her sketchbook.",
