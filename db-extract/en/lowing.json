                                "example_id": "088287c0-37d6-4685-9d06-189faa3e187e",
                                "sense_id": "e68becfc-46a3-3d51-a38d-3d3fae835a1a",
                                "text": "Nor is Oſiris seen\nIn Memphian Grove, or Green,\nTrampling the unſhower'd Graſſe with lowings loud:"
                            },
                            {
                                "example_id": "d6c765e9-9c6f-4da1-8d22-0dccd8c3ff96",
                                "sense_id": "e68becfc-46a3-3d51-a38d-3d3fae835a1a",
                                "text": "[…] the herd of four or five hundred cattle trotting homewards with loud lowings and bellowings […]"
                            }
                        ]
