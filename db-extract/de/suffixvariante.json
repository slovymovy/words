                "senses": [
                    {
                        "sense_id": "3d8fa441-eaac-31ba-a204-982c34153d0b",
                        "entry_id": "dd0c8a18-3896-381d-8cb6-c43aec464111",
                        "glosses": [
                            "Endung am Wortstamm, die durch Erweiterung, Umlautung oder Verkürzung verändert ist"
                        ],
                        "tags": [
                            "Morphologie"
                        ],
                        "examples": [
                            {
                                "example_id": "284c8e09-0ece-43ba-bf72-a581acbc05e6",
                                "sense_id": "3d8fa441-eaac-31ba-a204-982c34153d0b",
                                "text": "„Die Suffixvariante [von -ieren] -ifizieren kommt nur bei wenigen desubsantivischen Verben vor: […]“ (kursiv im Original)"
                            },
                            {
                                "example_id": "2b791143-d4e3-496b-b60c-978a41503024",
                                "sense_id": "3d8fa441-eaac-31ba-a204-982c34153d0b",
                                "text": "„[…] das Suffix -ščik im Russischen [verlangt] konsonantischen Stammauslaut […]. Lautet der Stamm vokalisch aus, so wird er entweder verkürzt […] oder das Suffix wird um ein -l-’ erweitert, wodurch die Suffixvariante -l’ščik entsteht […].“"
                            },
                            {
                                "example_id": "90d220a0-26a8-4f6f-99e4-1ec09fbaba6b",
                                "sense_id": "3d8fa441-eaac-31ba-a204-982c34153d0b",
                                "text": "„[…] die Wahl der Suffixvariante richtet sich nach dem Vokalismus des Stamms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
