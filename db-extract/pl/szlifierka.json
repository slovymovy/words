                                        "examples": [
                                            {
                                                "example_id": "67285971-5236-443a-9da1-c5e130eaafe6",
                                                "sense_id": "aea2a839-04b5-3eab-8a4b-35e82a4526b7",
                                                "text": "I am going to the deli to get a grinder for lunch."
                                            },
                                            {
                                                "example_id": "dcab9245-2853-4054-b6bb-3cc940d2a29e",
                                                "sense_id": "aea2a839-04b5-3eab-8a4b-35e82a4526b7",
                                                "text": "It was reported that the recipes for the secret sauce and grinder sandwiches were proprietary, known only to the current president of the corporation and the former owner of the restaurant."
