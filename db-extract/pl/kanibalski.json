                        "sense_id": "de697319-5fff-3f36-b4eb-15dad1003ad6",
                        "entry_id": "4a827ecb-fbc2-3ce8-a818-16da23b8d1a1",
                        "glosses": [
                            "cannibal, cannibalistic"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "cf820782-9312-496e-903b-7e4345d9444d",
                                "sense_id": "de697319-5fff-3f36-b4eb-15dad1003ad6",
                                "text": "Napastnicy kolejnymi strzałami pozbawili życia Kahaleka. Nie zdecydowali się jednak na zabranie jego ciała, by powtórzyć kanibalski zwyczaj – ze zbocza wzgórza tłumnie nadbiegała już pomoc z wioski.",
                                "translation": "The attackers took Kahalek's life with a series of shots. However, they decided not to take his body away to repeat the cannibalistic custom – help from the village was already rushing down the hillside in droves.",
                                "english": "The attackers took Kahalek's life with a series of shots. However, they decided not to take his body away to repeat the cannibalistic custom – help from the village was already rushing down the hillside in droves."
                            }
                        ]
                    }
