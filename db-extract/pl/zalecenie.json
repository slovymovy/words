                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "625c4815-6290-410b-9ca1-bb3c0aba13b6",
                                                "sense_id": "d2bacc09-ee0e-377b-9a94-adced39a5ebb",
                                                "text": "για τη σύσταση του συμβουλίου έγινε πολύ λόγος",
                                                "translation": "≈ συνώνυμα: σύνθεση"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f7b0d5-c3d1-3b0e-ad8e-5483c72dc2fe",
                                        "entry_id": "a5363711-44d6-360b-bef4-dd879c2da77e",
                                        "glosses": [
                                            "η οργάνωση ανθρώπων σε ένα σύνολο με σκοπό την επίτευξη συγκεκριμένων σκοπών"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1649d7f-cb82-4baa-b89b-fa7b6d711df4",
                                                "sense_id": "54f7b0d5-c3d1-3b0e-ad8e-5483c72dc2fe",
                                                "text": "αποφασίστηκε η σύσταση εταιρείας",
                                                "translation": "≈ συνώνυμα: συγκρότηση"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04338a7d-772a-3caf-bed7-cb7c7cf38d76",
                                        "entry_id": "a5363711-44d6-360b-bef4-dd879c2da77e",
                                        "glosses": [
                                            "η ανοργάνωτη κι άτακτη συσπείρωση στρατιωτών γύρω από ένα σημείο ή πρόσωπο με σκοπό την απόκρουση μιας αιφνιδιαστικής επίθεσης"
                                        ],
                                        "tags": [
                                            "στρατιωτικός όρος"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea77c030-28bb-3e36-88ee-7e2f507b26e5",
                                        "entry_id": "a5363711-44d6-360b-bef4-dd879c2da77e",
                                        "glosses": [
                                            "η γνωστοποίηση από κάποιον του ονόματος, του επαγγέλματος ή κάθε άλλης ιδιότητας ενός προσώπου που θεωρείται απαραίτητη στην πρώτη συνάντησή του με κάποιον τρίτο"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71710c52-40be-479a-9d4a-8b9fac6d7780",
                                                "sense_id": "ea77c030-28bb-3e36-88ee-7e2f507b26e5",
                                                "text": "θα κάνεις τις συστάσεις; Δεν τους γνωρίζω όλους εδώ",
                                                "translation": "≈ συνώνυμα: γνωριμία"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dccfe0aa-8e70-3384-9ae9-f14e6e9db8bb",
                                        "entry_id": "a5363711-44d6-360b-bef4-dd879c2da77e",
                                        "glosses": [
                                            "έγγραφο, που παρέχεται από τον εργοδότη συνήθως, το οποίο πιστοποιεί τις ικανότητες ενός ατόμου και την προηγούμενη επαγγελματική ή άλλου είδους εμπειρία του"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb333eba-0185-455e-ad2f-91f9fbe6a717",
                                                "sense_id": "dccfe0aa-8e70-3384-9ae9-f14e6e9db8bb",
                                                "text": "πήρε τις καλύτερες συστάσεις για τον μελλοντικό του ενοικιαστή",
                                                "translation": "≈ συνώνυμα: συστατική επιστολή"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a5a6685-68a4-332d-ad8e-3637b4b69c61",
                                        "entry_id": "a5363711-44d6-360b-bef4-dd879c2da77e",
                                        "glosses": [
                                            "προτροπή ή συμβουλή σε κάποιον, για να ενεργήσει σε κάτι ή να υιοθετήσει μια συγκεκριμένη συμπεριφορά"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e5ec44-5788-46f7-a37a-5376d34d7161",
