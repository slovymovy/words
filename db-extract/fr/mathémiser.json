                "senses": [
                    {
                        "sense_id": "8ea6e9d3-fc66-3616-b0bd-55c0de6d771d",
                        "entry_id": "f81b4233-4cb2-37cb-879a-a648f09258fa",
                        "glosses": [
                            "Considérer à la manière d’un problème mathématique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0614588-aa08-48cc-bfbb-ff37b33115dd",
                                "sense_id": "8ea6e9d3-fc66-3616-b0bd-55c0de6d771d",
                                "text": "Par contre, à partir du moment où l’on peut graphiciser et mathémiser, on a alors des repères."
                            },
                            {
                                "example_id": "75f0c87b-39cb-454a-87bd-29f2dcc9ab3b",
                                "sense_id": "8ea6e9d3-fc66-3616-b0bd-55c0de6d771d",
                                "text": "Lacan, ainsi, va chercher à « mathémiser » la femme, à la résoudre comme un problème soluble, mais il y a parfois peu entre résoudre et dissoudre…"
                            },
                            {
                                "example_id": "58dd6076-2bee-41b5-b480-b0f99271b124",
                                "sense_id": "8ea6e9d3-fc66-3616-b0bd-55c0de6d771d",
                                "text": "Ce qui se trouve dès lors \" mathémisé \" doit exister en germe dans les premières recherches freudiennes visant à fixer une clinique utilisable dans la pratique."
                            }
                        ]
                    }
