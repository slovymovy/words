                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "fiasco",
                                "target_lang_sense_clarification": "een totale mislukking"
                            },
                            {
                                "target_lang_word": "chaos",
                                "target_lang_sense_clarification": "een toestand van totale verwarring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "747e92fa-4b19-3cb8-8618-9d44dca4a96f",
                    "sense_definition": "A scene of extreme violence, bloodshed, or destruction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The battlefield was a <w>shambles</w> of broken equipment and fallen soldiers.",
                            "target_lang_translations": {
                                "nl": "Het slagveld was een <w>bloedbad</w> van kapotte uitrusting en gevallen soldaten."
                            }
                        },
                        {
                            "text": "The aftermath of the explosion left the street a <w>shambles</w>.",
                            "target_lang_translations": {
                                "nl": "De nasleep van de explosie liet de straat achter als een <w>puinhoop</w>."
                            }
