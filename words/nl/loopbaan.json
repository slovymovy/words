                        {
                            "text": "Zij heeft een indrukwekkende <w>loopbaan</w> in de medische wereld opgebouwd.",
                            "target_lang_translations": {
                                "en": "She has built an impressive <w>career</w> in the medical world."
                            }
                        },
                        {
                            "text": "Aan het einde van zijn <w>loopbaan</w> werd hij benoemd tot directeur van het bedrijf.",
                            "target_lang_translations": {
                                "en": "At the end of his <w>career</w>, he was appointed director of the company."
