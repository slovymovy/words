                        "form": "einen Schwächsten"
                    },
                    {
                        "form_id": "20d73c2d-ce51-425b-86b5-484db1f0ddd8",
                        "entry_id": "ae379906-b041-3a01-bedd-d80a051a3c24",
                        "tags": [
                            "accusative",
