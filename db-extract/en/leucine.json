                                    {
                                        "sense_id": "0a84f377-b1ff-38db-ba90-8e11000be6a0",
                                        "entry_id": "c7ceb7cb-82c5-3319-a3cf-aa3edac5b290",
                                        "glosses": [
                                            "Acide aminé dont la chaîne latérale est (-CH₂-CH(CH₃)₂)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f66a460-9dc7-419d-9805-29a681a9e44e",
                                                "sense_id": "0a84f377-b1ff-38db-ba90-8e11000be6a0",
                                                "text": "Il constate la présence d’une molécule de tyrosine (C₉H11AzO₃), et de toute la série homologue des sucres de gélatine, depuis la leucine (C₆H₁₃AzO₂), jusqu’à l’alanine (C₃H₇AzO₂) ; tous à base d’acide gras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c440ee6e-6107-3720-900d-f719a354abd2",
                                        "entry_id": "c7ceb7cb-82c5-3319-a3cf-aa3edac5b290",
                                        "glosses": [
                                            "Principe existant dans le tissu pulmonaire et dans le sang."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59e00bfd-6665-4a1f-8961-f6c424e1b193",
                        "source_entry_id": "fc618f09-25c3-3894-ab1e-f00f93108691",
                        "source_sense_id": "45d386de-03a7-3dbd-a4b9-895eeaf99ae7",
