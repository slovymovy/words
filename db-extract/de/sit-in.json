                "senses": [
                    {
                        "sense_id": "2783b245-cc3f-3c43-99b5-478d0a4cda98",
                        "entry_id": "a876353f-bd6b-31cb-a0a9-0ab1427055fe",
                        "glosses": [
                            "Sitzstreik, um Protest zu demonstrieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeca5e9b-0501-4583-939b-c20a07e5a1fa",
                                "sense_id": "2783b245-cc3f-3c43-99b5-478d0a4cda98",
                                "text": "„Vertretern dieser Art konnte man auf jedem Teach-in, Sit-in, Go-in begegnen.“"
                            },
                            {
                                "example_id": "ec59c172-f2c1-43aa-8351-85585ad15f70",
                                "sense_id": "2783b245-cc3f-3c43-99b5-478d0a4cda98",
                                "text": "„In den Vereinigten Staaten jedenfalls kam es zu einer ernsteren Radikalisierung der Studentenbewegung anfänglich nur, wo die Polizei, oft mit großer Brutalität, gegen gewaltlose Demonstrationen, Besetzungen von Gebäuden, Sit-ins, usw. eingriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b811f97e-8973-4881-87be-f7e8f69dc01a",
                        "source_entry_id": "a876353f-bd6b-31cb-a0a9-0ab1427055fe",
                        "source_sense_id": "2783b245-cc3f-3c43-99b5-478d0a4cda98",
                        "source_sense_description": "Sitzstreik, um Protest zu demonstrieren",
                        "target_lang_word": "sit-in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sit-in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89cc9690-2643-3909-a3c8-59de39414f7d",
                                        "entry_id": "da49fc56-f90a-3ab2-9cc5-ce8f4ba0ec59",
                                        "glosses": [
                                            "A peaceful form of protest in which people occupy an area and refuse to leave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff5b364-5f97-42a8-b51d-ad241a560e99",
                                                "sense_id": "89cc9690-2643-3909-a3c8-59de39414f7d",
                                                "text": "Thousands of students marched in the streets and staged a sit-in at T’ien-an-men Square, chanting “Long live democracy! Long live freedom! Down with corruption!”"
                                            },
                                            {
                                                "example_id": "a4d42006-5a66-4b9c-9dcc-82b627a8e974",
                                                "sense_id": "89cc9690-2643-3909-a3c8-59de39414f7d",
                                                "text": "Local sources said a sit-in protest by hundreds of ethnic Hui Muslims took place on Friday to defend the huge new mosque, which was built last year in the northern region of Ningxia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sit-in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe9eb39f-dd3d-3f54-94a6-e914b02cef4a",
                                        "entry_id": "581338ef-259a-313c-9ad1-da4052797d3a",
                                        "glosses": [
                                            "Designed to be sat in."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac1f2b2-4f2c-40c3-b141-f09bf74fd915",
                                                "sense_id": "fe9eb39f-dd3d-3f54-94a6-e914b02cef4a",
                                                "text": "a sit-in kayak"
                                            },
                                            {
                                                "example_id": "80026b63-b437-4146-8e67-fc3cf4fd0319",
                                                "sense_id": "fe9eb39f-dd3d-3f54-94a6-e914b02cef4a",
