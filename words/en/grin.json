                            },
                            {
                                "target_lang_word": "усмешка",
                                "target_lang_sense_clarification": "краткая улыбка, выражающая эмоцию"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "široký úsměv",
                                "target_lang_sense_clarification": "velmi radostný úsměv"
                            },
                            {
                                "target_lang_word": "ušklíbnutí",
                                "target_lang_sense_clarification": "ironický nebo neupřímný úsměv"
                            },
                            {
                                "target_lang_word": "škleb",
                                "target_lang_sense_clarification": "výraz obličeje s odhalenými zuby"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咧嘴笑",
                                "target_lang_sense_clarification": "指宽大的笑容"
                            },
                            {
                                "target_lang_word": "露齿笑",
                                "target_lang_sense_clarification": "指露出牙齿的表情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efacd85a-f8e0-3ab7-b039-ac704307ff64",
                    "sense_definition": "A trap or snare used for catching animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "traps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter set a <w>grin</w> in the woods to catch the rabbit.",
                            "target_lang_translations": {
                                "ru": "Охотник поставил <w>силок</w> в лесу, чтобы поймать кролика.",
                                "cs": "Lovec v lese nastražil <w>past</w>, aby chytil králíka.",
                                "zh": "猎人在树林里设下了一个<w>陷阱</w>来捕捉兔子。"
                            }
                        },
                        {
                            "text": "The old text described how to build a <w>grin</w> from simple wire and wood.",
                            "target_lang_translations": {
                                "ru": "В старом тексте описывалось, как сделать <w>ловушку</w> из обычной проволоки и дерева.",
                                "cs": "Starý text popisoval, jak vyrobit <w>osidlo</w> z obyčejného drátu a dřeva.",
                                "zh": "古籍中描述了如何用简单的铁丝和木头制作一个<w>圈套</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snare",
                        "gin",
                        "trap"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловушка или силок, используемые для ловли животных.",
                        "cs": "Past nebo osidlo používané k chytání zvířat.",
                        "zh": "用于捕捉动物的陷阱或圈套。"
                    },
                    "translations": {
                        "ru": [
