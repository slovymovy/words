                "senses": [
                    {
                        "sense_id": "4079c23d-d92a-386f-9e6a-483320582e30",
                        "entry_id": "19fe1469-210b-3388-aaee-ba07248f49e0",
                        "glosses": [
                            "Qui est soumis à une précontrainte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd5868dc-867d-42ef-a513-87ebac31e2c9",
                                "sense_id": "4079c23d-d92a-386f-9e6a-483320582e30",
                                "text": "Dans l’étude de l’élément précontraint, il sera supposé dans ce qui suit que ses sections sont suffisamment éloignées des extrémités et étant planes avant déformation, restent planes après elles."
                            },
                            {
                                "example_id": "4980fe5c-6c9a-4030-8cf4-d29814541abe",
                                "sense_id": "4079c23d-d92a-386f-9e6a-483320582e30",
                                "text": "Le but que l’on se propose en disposant des armatures précontraintes est d’éliminer les tensions dans le béton."
                            },
                            {
                                "example_id": "b82e9335-7288-4e91-a131-ec6afb408d57",
                                "sense_id": "4079c23d-d92a-386f-9e6a-483320582e30",
                                "text": "La conduite principale est constituée d'un tuyau Bonna en béton précontraint radialement et longitudinalement de 35 km dont 3 km en aérien pour franchir les marigots ; les tuyaux sont fabriqués sur place par centrifugation et essayés à des pressions variant de 4 à 9 kg/cm2."
                            }
                        ]
                    }
