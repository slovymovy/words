                "senses": [
                    {
                        "sense_id": "423294b8-16f9-3c59-9efc-28a146051fa5",
                        "entry_id": "5d6f1a87-a01b-391f-9a05-b02178cadb1f",
                        "glosses": [
                            "разг. испачканный, засаленный или заношенный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c76eadc-be50-4ed6-9350-248e66eb30ba",
                                "sense_id": "423294b8-16f9-3c59-9efc-28a146051fa5",
                                "text": "Одетый в застиранную, вечно в масляных пятнах спецовку, прикрыв копну волос замызганной кепкой, парнишка со всей серьёзностью следил за подачей резца."
                            },
                            {
                                "example_id": "30a4325f-7d1c-4280-b3c3-59c0710045d8",
                                "sense_id": "423294b8-16f9-3c59-9efc-28a146051fa5",
                                "text": "Пацаны на замызганных улицах гоняли в футбол."
                            }
                        ]
                    }
