                "senses": [
                    {
                        "sense_id": "260b6c94-814e-3de6-a60b-3827f651fc07",
                        "entry_id": "ddfa07a1-deda-3272-88c3-61dafe65a993",
                        "glosses": [
                            "eine rechteckige oder quadratische Fußplatte unter einer Säule oder unter einer Statue"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b7b9d5-551a-41f1-aa9c-1008b4888b2f",
                                "sense_id": "260b6c94-814e-3de6-a60b-3827f651fc07",
                                "text": "\"Die Plinthe besteht aus einer in der Regel quadratischen Platte, die unter einer runden Säulenbasis angeordnet ist. Somit schafft die Plinthe einen optischen Übergang zwischen der runden Säule oder Säulenbasis und dem in der Regel rechteckigen Unterbau, dem Stylobat.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68ece7db-dda1-403f-a446-46594540afa0",
                        "source_entry_id": "ddfa07a1-deda-3272-88c3-61dafe65a993",
                        "source_sense_id": "260b6c94-814e-3de6-a60b-3827f651fc07",
                        "source_sense_description": "Fußplatte unter einer Säule oder unter einer Statue",
                        "target_lang_word": "plinth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plinth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                        "entry_id": "9f532119-4eea-3ecc-ae9e-c08804a2b984",
                                        "glosses": [
                                            "A block or slab upon which a column, pedestal, statue or other structure is based."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c4a9bd-65c4-4429-9488-9ff01ec8373a",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "The queen placed the vase on the plinth so the cupbearer could fill it with flowers."
                                            },
                                            {
                                                "example_id": "894ff4f8-6314-4565-b176-4be02813b519",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "There appears to be no definite information about the origin of the two large boulders, mounted on plinths, on the platforms of St. Anne's Park Station, Bristol."
                                            },
                                            {
                                                "example_id": "979898c0-6f76-4edd-9847-d3815dfe005f",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "The station building forms a street-level portal and ticket hall, connected by staircases and escalators to the sub-surface platforms. The whole structure is designed as a plinth for a future block of buildings above."
                                            },
                                            {
                                                "example_id": "77df8a0d-aac7-445b-a890-f88d86b9e4c0",
                                                "sense_id": "36c4995f-4986-3a73-b42a-c164d15ed322",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb673843-976d-30d0-83d1-24e6adb0072e",
                                        "entry_id": "9f532119-4eea-3ecc-ae9e-c08804a2b984",
                                        "glosses": [
                                            "The bottom course of a wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "320ca924-c472-3f04-b6a1-6d613d4ed7b6",
                                        "entry_id": "9f532119-4eea-3ecc-ae9e-c08804a2b984",
                                        "glosses": [
                                            "A base or pedestal beneath a cabinet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d88016e1-e47e-4b3e-b513-511b9cb2db7e",
                        "source_entry_id": "ddfa07a1-deda-3272-88c3-61dafe65a993",
                        "source_sense_id": "260b6c94-814e-3de6-a60b-3827f651fc07",
                        "source_sense_description": "Fußplatte unter einer Säule oder unter einer Statue",
                        "target_lang_word": "plinthe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plinthe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0c25b7-af78-3fd0-a19f-b25baed4fe8c",
                                        "entry_id": "c74ff1c6-2090-3644-8ed5-5145a09fe98a",
                                        "glosses": [
                                            "Pierre plate et carrée qui se trouve sous la colonne ou au-dessus du chapiteau."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b98e6b5-f9b4-4f76-b351-2eeabc914345",
                                                "sense_id": "1c0c25b7-af78-3fd0-a19f-b25baed4fe8c",
                                                "text": "Les rosaces, les plinthes, les moulures, les astragales, tous les détails de l’édifice offrent la même perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cbc0850-592b-3630-a7ec-7bf6538b477f",
                                        "entry_id": "c74ff1c6-2090-3644-8ed5-5145a09fe98a",
                                        "glosses": [
                                            "Tablette carrée formant un socle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3798506-d9b5-46c0-9876-1e02dc0ba123",
                                                "sense_id": "7cbc0850-592b-3630-a7ec-7bf6538b477f",
                                                "text": "À force de grimper, nous atteignîmes la crête supérieure, et nous nous assîmes sur la plinthe du socle d’un grand lion de granit qui marque au versant de la montagne les limites de la Vieille-Castille ; au delà, c’est la Castille-Nouvelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                        "entry_id": "c74ff1c6-2090-3644-8ed5-5145a09fe98a",
                                        "glosses": [
                                            "Bande ou saillie plate qui court au pied d’un bâtiment, au bas d’un mur d’appartement, d’un lambris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f052ee57-10ae-4496-838e-aa12621366a9",
                                                "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                                "text": "Autour de la chambre, le long de la plinthe, des belettes courent, bondissent, se poursuivent…"
                                            },
                                            {
                                                "example_id": "48058916-6b7f-4b5d-a2d9-c5ff77a81b5b",
                                                "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                                "text": "Et si vous entendez sourdre, à travers les plinthes\nDu boudoir de ces dames, des râles et des plaintes,\nNe dites pas : « C’est tonton Georges qui expire »,\nCe sont tout simplement les anges qui soupirent."
                                            },
                                            {
                                                "example_id": "bf93acd5-af6e-4ba2-b032-90916201015a",
                                                "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                                "text": "La tenture de cette pièce pose sur la plinthe."
                                            },
                                            {
                                                "example_id": "a6bd65fa-b28a-482f-9f71-2bee4970c69f",
                                                "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                                "text": "La plinthe du lambris."
                                            },
                                            {
                                                "example_id": "d9dfd603-191d-4fa0-958d-1fd4f0e5ad9c",
                                                "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                                "text": "Plinthe de mur : Sorte de plate-bande qui indique la ligne des planchers sur la façade d’un bâtiment, ou qui règne au sommet d’un mur de clôture."
                                            },
                                            {
                                                "example_id": "56735fbe-a947-4d88-b862-82daff63e64b",
                                                "sense_id": "6ead88a4-440e-3b97-a2fb-393c35064e39",
                                                "text": "D’une niche de chaume ruiné, abandonnée par la douane, Bel-Gazou embrasse, à droite, la Pointe-du-Nez, jaune de lichens, bardée de violet par la plinthe de moules que découvrent les basses marées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f47988c-f4ae-3c9f-90f6-316604620570",
                                        "entry_id": "c74ff1c6-2090-3644-8ed5-5145a09fe98a",
                                        "glosses": [
                                            "Protection consistant en une planche en bois ou en métal fixée sur le plancher d’un échafaudage afin d’empêcher la chute accidentelle d’outils ou de débris."
                                        ],
                                        "tags": [
                                            "Échafaudage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864b177f-991b-412f-adf6-001e74361b8b",
                                                "sense_id": "3f47988c-f4ae-3c9f-90f6-316604620570",
                                                "text": "Les plinthes longitudinales et transversales sont bloquées par les clavettes des têtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
