{
    "word_family": [
        "hassle-free",
        "unhassled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d68de153-2e7d-3d9b-8728-97aa1375d0a3",
                    "sense_definition": "A situation that causes difficulty, trouble, or annoyance, often involving complex or unwanted tasks.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "trouble_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went through a lot of <w>hassle</w> to get the tickets for the concert.",
                            "target_lang_translations": {
                                "ru": "Мне стоило немалой <w>мороки</w>, чтобы достать билеты на концерт.",
                                "es": "Pasé por muchas <w>complicaciones</w> para conseguir las entradas del concierto."
                            }
                        },
                        {
                            "text": "Cooking a big dinner is too much <w>hassle</w> after a long day at work.",
                            "target_lang_translations": {
                                "ru": "Готовить большой ужин — это лишняя <w>морока</w> после долгого рабочего дня.",
                                "es": "Cocinar una gran cena es demasiada <w>molestia</w> después de un largo día de trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "inconvenience",
                        "bother",
                        "nuisance",
                        "trouble",
                        "annoyance"
                    ],
                    "antonyms": [
                        "convenience",
                        "breeze"
                    ],
                    "common_phrases": [
                        "worth the hassle",
                        "too much hassle",
                        "save the hassle",
                        "without the hassle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, вызывающая трудности или раздражение, часто связанная со сложными или нежелательными задачами.",
                        "es": "Situación que causa dificultad, molestia o incomodidad, a menudo implicando tareas engorrosas o no deseadas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морока",
                                "target_lang_sense_clarification": "утомительная, неприятная работа или суета (разг.)"
                            },
                            {
                                "target_lang_word": "нервотрёпка",
                                "target_lang_sense_clarification": "сильное беспокойство, волнение, раздражающая ситуация (разг.)"
                            },
                            {
                                "target_lang_word": "хлопоты",
                                "target_lang_sense_clarification": "заботы, дела, требующие усилий и времени"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "molestia",
                                "target_lang_sense_clarification": "incomodidad o inconveniente que causa algo"
                            },
                            {
                                "target_lang_word": "lío",
                                "target_lang_sense_clarification": "situación complicada o enojosa (coloquial)"
                            },
                            {
                                "target_lang_word": "complicación",
                                "target_lang_sense_clarification": "dificultad adicional que entorpece un proceso"
                            },
                            {
                                "target_lang_word": "follón",
                                "target_lang_sense_clarification": "situación enredada, engorrosa o problemática (coloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec29faf2-8ce1-3baa-9719-103714143efe",
                    "sense_definition": "A brief argument, struggle, or disagreement between people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to get into a <w>hassle</w> with the neighbors about the noise.",
                            "target_lang_translations": {
                                "ru": "Я не хочу ввязываться в <w>ссору</w> с соседями из-за шума.",
                                "es": "No quiero meterme en una <w>bronca</w> con los vecinos por el ruido."
                            }
                        },
                        {
                            "text": "There was a bit of a <w>hassle</w> at the bar before the police arrived.",
                            "target_lang_translations": {
                                "ru": "В баре произошла небольшая <w>стычка</w> до приезда полиции.",
                                "es": "Hubo un pequeño <w>jaleo</w> en el bar antes de que llegara la policía."
                            }
                        }
                    ],
                    "synonyms": [
                        "argument",
                        "squabble",
                        "dispute",
                        "fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий спор, стычка или разногласие между людьми.",
                        "es": "Discusión breve, altercado o desacuerdo entre personas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссора",
                                "target_lang_sense_clarification": "состояние вражды, перебранка"
                            },
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "короткая ссора или драка"
                            },
                            {
                                "target_lang_word": "перебранка",
                                "target_lang_sense_clarification": "словесная ссора, обмен упреками"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "bronca",
                                "target_lang_sense_clarification": "discusión o disputa ruidosa"
                            },
                            {
                                "target_lang_word": "riña",
                                "target_lang_sense_clarification": "enfrentamiento verbal o pequeña pelea"
                            },
                            {
                                "target_lang_word": "pelea",
                                "target_lang_sense_clarification": "disputa o altercado"
                            },
                            {
                                "target_lang_word": "jaleo",
                                "target_lang_sense_clarification": "conflicto o alboroto entre personas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "350aaf71-787d-3df1-bcfb-db05e42a62d7",
                    "sense_definition": "To annoy, bother, or pester someone repeatedly, often to get them to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "annoy_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporters <w>hassled</w> the actor as he left the restaurant.",
                            "target_lang_translations": {
                                "ru": "Репортеры <w>донимали</w> актера, когда он выходил из ресторана.",
                                "es": "Los reporteros <w>acosaron</w> al actor cuando salía del restaurante."
                            }
                        },
                        {
                            "text": "Please stop <w>hassling</w> me about cleaning my room; I will do it later.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань <w>доставать</w> меня уборкой комнаты, я сделаю это позже.",
                                "es": "Por favor, deja de <w>fastidiarme</w> con limpiar mi habitación; lo haré más tarde."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "pester",
                        "annoy",
                        "harass",
                        "bug"
                    ],
                    "common_phrases": [
                        "stop hassling me",
                        "get hassled",
                        "don't hassle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надоедать, приставать к кому-либо, часто с целью заставить что-то сделать.",
                        "es": "Molestar, fastidiar o insistir repetidamente a alguien, a menudo para obligarlo a hacer algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "не давать покоя, выводить из терпения"
                            },
                            {
                                "target_lang_word": "доставать",
                                "target_lang_sense_clarification": "сильно надоедать, приставать (разг.)"
                            },
                            {
                                "target_lang_word": "надоедать",
                                "target_lang_sense_clarification": "причинять неудобство частыми обращениями"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "molestar",
                                "target_lang_sense_clarification": "causar incomodidad o fastidio"
                            },
                            {
                                "target_lang_word": "fastidiar",
                                "target_lang_sense_clarification": "importunar o irritar con insistencia"
                            },
                            {
                                "target_lang_word": "fregar",
                                "target_lang_sense_clarification": "molestar o importunar con frecuencia (coloquial, América)"
                            },
                            {
                                "target_lang_word": "dar la lata",
                                "target_lang_sense_clarification": "insistir pesadamente de forma continua (coloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4ccffc9-9762-35d0-8d94-7fea1fa43289",
                    "sense_definition": "To engage in a mock dogfight (practice combat between aircraft) for training purposes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilots were strictly forbidden from <w>hassling</w> during the transport mission.",
                            "target_lang_translations": {
                                "ru": "Пилотам было строго запрещено <w>устраивать учебные бои</w> во время транспортной миссии.",
                                "es": "Los pilotos tenían estrictamente prohibido <w>simular combates aéreos</w> durante la misión de transporte."
                            }
                        },
                        {
                            "text": "He almost lost his wings for <w>hassling</w> in a restricted airspace.",
                            "target_lang_translations": {
                                "ru": "Он чуть не лишился права летать за <w>имитацию боя</w> в запретной зоне.",
                                "es": "Casi pierde sus alas por <w>hacer combates simulados</w> en un espacio aéreo restringido."
                            }
                        }
                    ],
                    "synonyms": [
                        "dogfight"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в учебном воздушном бою в тренировочных целях.",
                        "es": "Participar en un combate aéreo simulado con fines de entrenamiento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имитировать воздушный бой",
                                "target_lang_sense_clarification": "проводить учебный бой на самолетах"
                            },
                            {
                                "target_lang_word": "устраивать учебный бой",
                                "target_lang_sense_clarification": "заниматься тренировочным боем"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "simular un combate aéreo",
                                "target_lang_sense_clarification": "realizar maniobras de combate de práctica"
                            },
                            {
                                "target_lang_word": "hacer un combate aéreo simulado",
                                "target_lang_sense_clarification": "entrenarse en combate aéreo cercano"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}