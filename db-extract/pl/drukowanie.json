                        "target_lang_word": "printing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "printing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a62af63-5aba-3a73-b388-3947450f4f62",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "The process or business of producing printed material by means of inked type and a printing press or similar technology."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b84e80-207a-410a-8748-89f3bf4531de",
                                                "sense_id": "6a62af63-5aba-3a73-b388-3947450f4f62",
                                                "text": "In those days, printing was big business in this city. Giant web-fed presses churned out countless tons of printed matter annually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592431f5-dae1-3d73-ae78-9c5832f7d6e8",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "Synonym of printed matter."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "447ef9c6-d7fc-4824-ae6f-19e20b4560b6",
                                                "sense_id": "592431f5-dae1-3d73-ae78-9c5832f7d6e8",
                                                "text": "They delivered a huge batch of printing yesterday, so you can expect an invoice shortly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "751f4a59-0683-3710-9d9e-f866d3d3bb54",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "Synonym of print run (“all the copies of a publication that have been printed in one batch”)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e8c318-2ee5-4e3e-a846-dd8ae7b6a78f",
                                                "sense_id": "751f4a59-0683-3710-9d9e-f866d3d3bb54",
                                                "text": "She owns a copy of the first printing, which is a favorite among book collectors because some of the typos in it seem like Freudian slips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ec0b3ee-9943-3505-b2e3-026e2f288342",
                                        "entry_id": "eb7f072e-c0d2-30cd-afdb-7cafe400895c",
                                        "glosses": [
                                            "Handwritten characters that are not joined up."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7c396c-ceec-4179-bc16-352307ae3a2e",
                                                "sense_id": "4ec0b3ee-9943-3505-b2e3-026e2f288342",
                                                "text": "The instructions said, \"Please sign your name and then print your name below your signature,\" so he wrote out his name underneath in the neatest printing that his hand could muster."
                                            }
                                        ]
                                    }
                                ]
                            },
