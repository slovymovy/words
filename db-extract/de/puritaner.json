                "senses": [
                    {
                        "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                        "entry_id": "2f965147-ccda-3068-9065-421b4630f631",
                        "glosses": [
                            "Anhänger des Puritanismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4982db1-24c3-48b5-8557-49e24546232f",
                                "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                "text": "„Der Puritaner wollte Berufsmensch sein, – wir müssen es sein.“"
                            },
                            {
                                "example_id": "adf886a7-7df9-4529-828e-6a4925fa47a8",
                                "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                "text": "„Digbys Privatbibliothek wurde unter dem parlamentarischen Regime Oliver Cromwells vermutlich beschlagnahmt und verbrannt, denn solches war bei den Puritanern die übliche Praxis.“"
                            },
                            {
                                "example_id": "021b0e30-f216-4ba4-b8f8-1dfd7852034f",
                                "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                "text": "„Für die Puritaner war er eine Quelle lüsterner Faszination.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
