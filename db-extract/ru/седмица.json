                    {
                        "form_id": "513af806-0305-43e3-825e-cca5d84be616",
                        "entry_id": "eec1558e-0c37-3421-944b-ddbdfaef845a",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "седми́цах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17e3d88e-4d12-3714-b551-45bea8f25fa1",
                        "entry_id": "eec1558e-0c37-3421-944b-ddbdfaef845a",
                        "glosses": [
                            "церк.-слав., книжн., устар. неделя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59a5487-8c00-4ae5-9b79-d824aa3a7348",
                                "sense_id": "17e3d88e-4d12-3714-b551-45bea8f25fa1",
                                "text": "Сверх же того, всякую субботу и среду, когда в седмице в учебные дни праздника не прилучится, после обеда не учить; ежели же в понедельник или другой учебный день праздник случится, то в среду и субботу по полудни учить…"
                            },
                            {
                                "example_id": "04e1671d-8461-496c-994c-099b6c1fd3bb",
                                "sense_id": "17e3d88e-4d12-3714-b551-45bea8f25fa1",
                                "text": "В страстную же седмицу от понедельника даже до субботнего вечера, дней шесть, хлеб с водою точию ясти и зелие не варено, и се с воздержанием; аще есть можно и не на всяк день приимати, но, яко же речено бысть, о первой седмице."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80b8034c-0363-4698-9cb6-191e3413a730",
                        "source_entry_id": "eec1558e-0c37-3421-944b-ddbdfaef845a",
                        "source_sense_id": "17e3d88e-4d12-3714-b551-45bea8f25fa1",
                        "target_lang_word": "week",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "week",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d04f733-b954-3473-b520-518e2d70f760",
                                        "entry_id": "4582784a-ff80-3f2f-beec-8a3353d155ef",
                                        "glosses": [
                                            "Any period of seven consecutive days."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962ac990-b7e7-4d5c-a4ff-96b0e2ce3ff1",
                                                "sense_id": "2d04f733-b954-3473-b520-518e2d70f760",
                                                "text": "Holonyms: megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "e5c83be4-2c2e-4ed9-ad68-c6058b3d8de4",
                                                "sense_id": "2d04f733-b954-3473-b520-518e2d70f760",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day, weekday < weekend"
                                            },
                                            {
                                                "example_id": "78065d9e-4b33-47be-b918-c3deaef5e6c1",
                                                "sense_id": "2d04f733-b954-3473-b520-518e2d70f760",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9d0059-ec5b-32c7-834d-0d57a427169b",
                                        "entry_id": "4582784a-ff80-3f2f-beec-8a3353d155ef",
                                        "glosses": [
                                            "A period of seven days beginning with Sunday or Monday."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f706200a-40c7-3d83-8589-9abef90cdee3",
                                        "entry_id": "4582784a-ff80-3f2f-beec-8a3353d155ef",
                                        "glosses": [
                                            "A period of five days beginning with Monday."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23055f69-639d-36e3-8a80-1ab1f866dd05",
                                        "entry_id": "4582784a-ff80-3f2f-beec-8a3353d155ef",
                                        "glosses": [
                                            "A subdivision of the month into longer periods of work days punctuated by shorter weekend periods of days for markets, rest, or religious observation such as a sabbath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d150a5-e3a2-4d59-8822-4b4311964dfd",
                                                "sense_id": "23055f69-639d-36e3-8a80-1ab1f866dd05",
                                                "text": "A 4-day week consists of Monday, Tuesday, Wednesday, and Thursday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc67e87e-a0e5-3694-a862-0a7c624ab115",
                                        "entry_id": "4582784a-ff80-3f2f-beec-8a3353d155ef",
                                        "glosses": [
                                            "A date seven days after (sometimes before) the specified day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc00b4d-5aa0-40b4-88d7-a9d0ef89db4a",
                                                "sense_id": "fc67e87e-a0e5-3694-a862-0a7c624ab115",
                                                "text": "I'll see you Thursday week. [a week on Thursday, i.e. Thursday after next]"
                                            },
                                            {
                                                "example_id": "c63af937-dd3f-42e7-ab90-0e7098b42540",
                                                "sense_id": "fc67e87e-a0e5-3694-a862-0a7c624ab115",
                                                "text": "The wedding is tomorrow week. [a week tomorrow, i.e. in eight days' time]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "week",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8295a9-e4ac-3706-9c15-491445d6859d",
                                        "entry_id": "126f14af-002c-386e-8659-a6948e37b9e3",
                                        "glosses": [
                                            "The squeal of a pig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23334be-7448-4aa1-9ea8-12708cd74c1b",
                                                "sense_id": "5c8295a9-e4ac-3706-9c15-491445d6859d",
                                                "text": "And ho, ho, ho, went Mister Pig, and week, week, week, went she; […]"
                                            },
                                            {
                                                "example_id": "2bb3770c-6b7b-4d28-b289-517508a23953",
                                                "sense_id": "5c8295a9-e4ac-3706-9c15-491445d6859d",
                                                "text": "[…] his head came a-top of one of a litter of young pigs that happened at that moment to be foraging about: week! week! week! week! week! cried little piggy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
