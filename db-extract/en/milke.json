                        ],
                        "examples": [
                            {
                                "example_id": "dcc75fad-39a7-46ec-ac5a-bf4809e1835a",
                                "sense_id": "7f72b6d3-6fd1-3665-8422-205d857eebdd",
                                "text": "Her vp they tooke, and with them home herled,\n With them as houſewife euer to abide,\n To milke their goates, and make them cheeſe & bred.\n And euery one as common good her haadeled ;"
                            },
                            {
                                "example_id": "4ec9aa91-94f2-4802-a914-0d4b53b2d817",
                                "sense_id": "7f72b6d3-6fd1-3665-8422-205d857eebdd",
                                "text": "Good Lady ſhee did ſeldome vſe to milke,\n Or touch ſuch things as were not clad in ſilke."
                            }
                        ]
                    }
