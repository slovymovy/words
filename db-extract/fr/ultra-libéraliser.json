                "senses": [
                    {
                        "sense_id": "bf0ec847-c166-3d7d-9972-8aa163895114",
                        "entry_id": "3b8759b5-a54c-302a-951f-2e8d209d7c30",
                        "glosses": [
                            "Donner un caractère ultra-libéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c4cd28-71b3-4434-aff4-3692e4739174",
                                "sense_id": "bf0ec847-c166-3d7d-9972-8aa163895114",
                                "text": "Je suis sûr que si l'agence de presse en question avait pu écrire ultra-libéraliser ils l'auraient fait."
                            },
                            {
                                "example_id": "2a56ef5b-679c-40c6-b880-92d32b460174",
                                "sense_id": "bf0ec847-c166-3d7d-9972-8aa163895114",
                                "text": "Ces attaques proviennent, et nous en avons l'habitude, de ceux qui veulent ultra-libéraliser."
                            },
                            {
                                "example_id": "6b05af9d-5c09-474a-83c8-93cd75ce0567",
                                "sense_id": "bf0ec847-c166-3d7d-9972-8aa163895114",
                                "text": "Je pense que le vrai travail à faire aujourd'hui n'est pas de défendre Uber pour permettre de tout ultra-libéraliser mais de défendre l'Etat et le modèle social qui nous permettra de nous serrer les coudes en tant que Nation."
                            }
                        ]
                    }
