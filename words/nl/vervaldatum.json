{
    "word_family": [
        "vervallen",
        "verval",
        "datum"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1586b07-2beb-3356-a583-111f9f106794",
                    "sense_definition": "De uiterste datum tot wanneer een product houdbaar is of een document geldig is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geldigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk altijd goed naar de <w>vervaldatum</w> op het pak melk voor je het koopt.",
                            "target_lang_translations": {
                                "en": "Always check the <w>expiration date</w> on the carton of milk carefully before buying it."
                            }
                        },
                        {
                            "text": "De <w>vervaldatum</w> van mijn paspoort is al verstreken, dus ik moet een nieuw aanvragen.",
                            "target_lang_translations": {
                                "en": "The <w>expiry date</w> of my passport has already passed, so I need to apply for a new one."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de vervaldatum controleren",
                        "tot de vervaldatum"
                    ],
                    "target_lang_definitions": {
                        "en": "The final date until which a product is fresh or a document remains valid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expiration date",
                                "target_lang_sense_clarification": "for perishable goods or official documents"
                            },
                            {
                                "target_lang_word": "expiry date",
                                "target_lang_sense_clarification": "UK English, for goods or documents"
                            },
                            {
                                "target_lang_word": "best before date",
                                "target_lang_sense_clarification": "primarily for food freshness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65e0f246-b39b-3821-bc8e-7a747b6d37d4",
                    "sense_definition": "De uiterste datum waarop een rekening of financiële verplichting moet zijn betaald.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U moet deze rekening voor de vermelde <w>vervaldatum</w> aan ons overmaken.",
                            "target_lang_translations": {
                                "en": "You must transfer this bill to us before the stated <w>due date</w>."
                            }
                        },
                        {
                            "text": "Als u na de <w>vervaldatum</w> betaalt, kunnen er extra kosten in rekening worden gebracht.",
                            "target_lang_translations": {
                                "en": "If you pay after the <w>due date</w>, additional fees may be charged."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervaldag"
                    ],
                    "common_phrases": [
                        "voor de vervaldatum",
                        "na de vervaldatum"
                    ],
                    "target_lang_definitions": {
                        "en": "The deadline by which an invoice or financial obligation must be settled."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "due date",
                                "target_lang_sense_clarification": "for bills, invoices, or payments"
                            },
                            {
                                "target_lang_word": "payment deadline",
                                "target_lang_sense_clarification": "the latest date to make a payment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}