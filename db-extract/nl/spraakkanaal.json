                                        "sense_id": "62b80d66-3913-301b-a4ae-24593feade67",
                                        "entry_id": "28ae711a-2143-3f50-ac75-43a53c360f0c",
                                        "glosses": [
                                            "(anatomy) Portion of the human body where speech sounds are articulated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae352cf-04f3-4af2-9383-273132a64b5f",
                                                "sense_id": "62b80d66-3913-301b-a4ae-24593feade67",
                                                "text": "The vocal tract. The further office which the nose performs, namely, that of contributing to the proper modulation of the voice, depends in great measure on the various cavities and sinuses contiguous to the nasal fossæ."
                                            },
                                            {
                                                "example_id": "455c937c-7484-415f-be2a-e67116589f62",
                                                "sense_id": "62b80d66-3913-301b-a4ae-24593feade67",
                                                "text": "...the tube of the throat between the larynx and the oral cavity, which is called the pharynx; the oral cavity; and the nasal cavity. These passages are collectively known as the vocal tract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60d7483-c17b-385c-b4a1-c3d79f618028",
                                        "entry_id": "28ae711a-2143-3f50-ac75-43a53c360f0c",
                                        "glosses": [
                                            "Portion of a bird's anatomy that filters or modifies sound; the syrinx, oral cavity, and beak, plus portions of the esophagus and trachea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d75d505-8f3e-4919-bd66-2d124588140c",
                                                "sense_id": "a60d7483-c17b-385c-b4a1-c3d79f618028",
                                                "text": "Beak motions are not necessarily the only means by which birds might vary the acoustic properties of the vocal tract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
