{
    "word_family": [
        "sinewy",
        "sinewless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9da999eb-582c-346a-9d22-88980f2c2342",
                    "sense_definition": "A piece of tough fibrous tissue uniting muscle to bone; a tendon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete tore a <w>sinew</w> in his leg while sprinting toward the finish line.",
                            "target_lang_translations": {
                                "es": "El atleta se desgarró un <w>tendón</w> de la pierna mientras esprintaba hacia la meta."
                            }
                        },
                        {
                            "text": "The cut of meat was tough and full of <w>sinew</w>, making it difficult to chew.",
                            "target_lang_translations": {
                                "es": "El corte de carne era duro y estaba lleno de <w>tendones</w>, lo que hacía difícil masticarlo."
                            }
                        }
                    ],
                    "synonyms": [
                        "tendon"
                    ],
                    "common_phrases": [
                        "bone and sinew"
                    ],
                    "target_lang_definitions": {
                        "es": "Tejido fibroso y resistente que une los músculos con los huesos; un tendón."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tendón",
                                "target_lang_sense_clarification": "estructura anatómica que une músculo y hueso"
                            },
                            {
                                "target_lang_word": "tendón fibroso",
                                "target_lang_sense_clarification": "en carne o músculo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65d50e4f-62c0-3e73-987f-08ca5a182aac",
                    "sense_definition": "Muscular power, physical strength, or vigorous energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers strained every <w>sinew</w> to reach the summit before nightfall.",
                            "target_lang_translations": {
                                "es": "Los escaladores tensaron cada <w>músculo</w> para alcanzar la cumbre antes de que anocheciera."
                            }
                        },
                        {
                            "text": "He exerted every muscle and <w>sinew</w> to lift the heavy stone off the path.",
                            "target_lang_translations": {
                                "es": "Hizo uso de cada músculo y <w>tendón</w> para levantar la pesada piedra del camino."
                            }
                        }
                    ],
                    "synonyms": [
                        "muscle",
                        "strength",
                        "vigor"
                    ],
                    "antonyms": [
                        "weakness"
                    ],
                    "common_phrases": [
                        "strain every sinew"
                    ],
                    "target_lang_definitions": {
                        "es": "Fuerza muscular, vigor físico o energía."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tendón",
                                "target_lang_sense_clarification": "en expresiones figuradas de esfuerzo físico"
                            },
                            {
                                "target_lang_word": "músculo",
                                "target_lang_sense_clarification": "fuerza o fibra muscular"
                            },
                            {
                                "target_lang_word": "vigor",
                                "target_lang_sense_clarification": "energía o fuerza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82f6ce8e-3f75-3189-82af-f0c365d3dec7",
                    "sense_definition": "The source of strength, power, or vital support for something; a mainstay.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A steady flow of funding forms the <w>sinews</w> of the scientific research program.",
                            "target_lang_translations": {
                                "es": "Un flujo constante de financiación constituye el <w>nervio</w> del programa de investigación científica."
                            }
                        },
                        {
                            "text": "The general reminded his staff that money and supplies are the essential <w>sinews</w> of war.",
                            "target_lang_translations": {
                                "es": "El general recordó a su Estado Mayor que el dinero y los suministros son los <w>nervios</w> vitales de la guerra."
                            }
                        }
                    ],
                    "synonyms": [
                        "mainstay",
                        "backbone"
                    ],
                    "common_phrases": [
                        "sinews of war"
                    ],
                    "target_lang_definitions": {
                        "es": "Fuente de fuerza, poder o soporte vital de algo; pilar o sustento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "nervio",
                                "target_lang_sense_clarification": "fuerza motriz, sostén o motor principal"
                            },
                            {
                                "target_lang_word": "pilar",
                                "target_lang_sense_clarification": "base o sustento vital"
                            },
                            {
                                "target_lang_word": "sustento",
                                "target_lang_sense_clarification": "apoyo fundamental"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fab421d8-bd7a-3337-93e8-92186b9eb4d8",
                    "sense_definition": "A cord or string made from animal sinew, especially for a musical instrument or bow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient harp was fitted with strings made of twisted <w>sinew</w>.",
                            "target_lang_translations": {
                                "es": "El arpa antigua estaba equipada con cuerdas hechas de <w>tendón</w> trenzado."
                            }
                        },
                        {
                            "text": "He carefully tied the animal <w>sinew</w> to both ends of the wooden bow.",
                            "target_lang_translations": {
                                "es": "Ató con cuidado la <w>cuerda de tendón</w> animal a ambos extremos del arco de madera."
                            }
                        }
                    ],
                    "synonyms": [
                        "cord",
                        "string"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly historical or traditional contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Cuerda o hilo elaborado a partir de tendón animal, especialmente para instrumentos musicales o arcos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tendón",
                                "target_lang_sense_clarification": "material usado como cuerda"
                            },
                            {
                                "target_lang_word": "cuerda de tendón",
                                "target_lang_sense_clarification": "para arcos o instrumentos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb600661-72fe-3529-98ff-d02a65318f4b",
                    "sense_definition": "A nerve.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In archaic anatomical texts, a nerve was often referred to as a <w>sinew</w>.",
                            "target_lang_translations": {
                                "es": "En textos anatómicos arcaicos, a menudo se llamaba <w>nervio</w> a un tendón."
                            }
                        },
                        {
                            "text": "The medieval physician struggled to distinguish a damaged <w>sinew</w> from a blood vessel.",
                            "target_lang_translations": {
                                "es": "El médico medieval tenía dificultades para distinguir un <w>nervio</w> dañado de un vaso sanguíneo."
                            }
                        }
                    ],
                    "synonyms": [
                        "nerve"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer used in modern anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Nervio (uso anatómico arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "nervio",
                                "target_lang_sense_clarification": "en textos médicos antiguos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d945c0e-5a54-3630-b464-bf4739375c24",
                    "sense_definition": "To knit together, strengthen, or bind firmly as if with sinews.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shared crisis served to <w>sinew</w> the diverse factions into a united front.",
                            "target_lang_translations": {
                                "es": "La crisis compartida sirvió para <w>fortalecer</w> a las diversas facciones en un frente unido."
                            }
                        },
                        {
                            "text": "Years of harsh physical labor had <w>sinewed</w> his frame and hardened his spirit.",
                            "target_lang_translations": {
                                "es": "Años de duro trabajo físico habían <w>robustecido</w> su complexión y endurecido su espíritu."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortify",
                        "strengthen"
                    ],
                    "antonyms": [
                        "weaken"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Unir firmemente, fortalecer o robustecer como con tendones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fortalecer",
                                "target_lang_sense_clarification": "hacer más fuerte o resistente"
                            },
                            {
                                "target_lang_word": "vigorizar",
                                "target_lang_sense_clarification": "dar vigor o fuerza"
                            },
                            {
                                "target_lang_word": "robustecer",
                                "target_lang_sense_clarification": "hacer fuerte y sólido"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}