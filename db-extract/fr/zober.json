                "senses": [
                    {
                        "sense_id": "d779e3c1-f462-3091-a18b-6beb2f382b45",
                        "entry_id": "385f74dc-e05a-3e33-a06f-4629976afae9",
                        "glosses": [
                            "Posséder charnellement."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a6740232-e720-490a-816e-d7ef1501ccc7",
                                "sense_id": "d779e3c1-f462-3091-a18b-6beb2f382b45",
                                "text": "Va te faire zober, cocotte."
                            },
                            {
                                "example_id": "a68d3a4b-e058-480a-9060-91f2d0a1b20d",
                                "sense_id": "d779e3c1-f462-3091-a18b-6beb2f382b45",
                                "text": "— C'est portenawaque, votre histoire de bi! arrête de m’faire golri ! Pour ouam, y'a pas d’timinik : ou t’aimes zober les teuches ou tu kiffes le zboub."
                            }
                        ]
                    },
                    {
                        "sense_id": "87a877fa-d523-3bd1-96e8-29b54fb27115",
                        "entry_id": "385f74dc-e05a-3e33-a06f-4629976afae9",
                        "glosses": [
                            "Avoir le dessus de manière déloyale, duper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dc23f664-1535-495f-95ed-543f3dae7013",
                                "sense_id": "87a877fa-d523-3bd1-96e8-29b54fb27115",
                                "text": "Cent euros pour cette came ? Tu t’es fait zober, mec."
                            },
                            {
                                "example_id": "5194c8be-f204-4012-ab22-3dbeb2d96438",
                                "sense_id": "87a877fa-d523-3bd1-96e8-29b54fb27115",
                                "text": "Si tu n’as pas du blanc et noir sur papier mat, tu t’es fait zober jusqu’à la moëlle"
                            }
                        ]
                    }
                ],
