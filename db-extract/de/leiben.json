                ],
                "senses": [
                    {
                        "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                        "entry_id": "7d4c495b-686c-3ec9-8911-46454678304a",
                        "glosses": [
                            "leben, eine leibliche Existenz haben, heute nurmehr in der Tautologie leiben und leben gebraucht"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "58c9378f-0672-426e-81ad-fd0a690f4b47",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "Da ist er, wie er leibt und lebt."
                            },
                            {
                                "example_id": "d11a2da5-b6cc-43ae-ad2b-ec46693f5da0",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "Der Leib erscheint zwar auch als res extensa, als materielles Sein, als fungierender aber ist er mein Leib, in dem ich „leibe und lebe\", und als dieser kann er nicht objektiviert werden."
                            },
                            {
                                "example_id": "5ff1380d-ee19-4443-b956-3562c4ac8b65",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "»… Von innen und außen! Wie du leibst und lebst! Du bist mein weiblicher Doppelgänger!«"
                            },
                            {
                                "example_id": "349b2717-e40d-468c-837a-a2a0284ece9d",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "Du sagst, das sollte ich sein, und ich meine, Du wärst es, wie Du leibst und lebst; und dann meinen wir beide, wir wären hungrig geworden über Tag, und …"
                            },
                            {
                                "example_id": "bd0d551f-f791-42a4-8a32-d8b0b49d5eb1",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "Nur den Deckel haben sie abgeschlagen, da sah ich unsern Herrn Götz, wie er leibte und lebte, die Hände so zusammen vorm Gesicht, ach, das liebe Gesicht, ganz weiß von Stein. …"
                            },
                            {
                                "example_id": "f3bdd546-d78b-4290-b125-2a683eec158a",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "»Wenn ich die Augen schließe und lange dasitze, sehe ich ihn deutlich vor mir, als wenn er leibte und lebte, nein, noch deutlicher. …«"
                            },
                            {
                                "example_id": "c6c3bdb4-6d42-4ef9-addd-537f51eadadd",
                                "sense_id": "9fc1af0e-cb78-3019-be49-badf3baa1819",
                                "text": "Was wohl leibt, das seelt übel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
