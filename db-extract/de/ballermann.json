                "senses": [
                    {
                        "sense_id": "2b902e01-d295-377e-b6b0-275f197cfb08",
                        "entry_id": "9e64af02-92fc-315f-9612-b2a35fced843",
                        "glosses": [
                            "the beach restaurant Beach Club Six (formerly Balneario Nº 6) in Palma"
                        ],
                        "tags": [
                            "colloquial",
                            "masculine",
                            "proper-noun",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "8b11b902-4084-4fea-b8ce-c6ca4e1dda42",
                                "sense_id": "2b902e01-d295-377e-b6b0-275f197cfb08",
                                "text": "Ihr habt für so'n kleinen Kerl allerhand Text / Aber wo soll das laufen, im Ballermann 6?",
                                "translation": "For a little guy like you, you've got a lot of text [to rap] / But where's that gonna play, at Ballermann 6?",
                                "english": "For a little guy like you, you've got a lot of text [to rap] / But where's that gonna play, at Ballermann 6?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bbb23f10-5362-327f-8933-141d0c56f84e",
                        "entry_id": "9e64af02-92fc-315f-9612-b2a35fced843",
                        "glosses": [
                            "the resorts El Arenal and Playa de Palma, often associated with unrestrained German party tourism"
                        ],
                        "tags": [
                            "colloquial",
                            "masculine",
                            "proper-noun",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a74f958b-f7d3-46ee-a7f9-f241f22f88ed",
                                "sense_id": "bbb23f10-5362-327f-8933-141d0c56f84e",
                                "text": "Seit Jahren kämpft Mallorca gegen den Massentourismus und die Saufgelage auf den Straßen, vor allem am Ballermann und der berühmten „Schinkenstraße“.",
                                "translation": "Mallorca has been fighting for years against mass tourism and binge parties in the streets, especially at the „Ballermann“ and in the famous „Schinkenstraße“ [lit. Ham Street, a row of well-frequented tourist bars].",
                                "english": "Mallorca has been fighting for years against mass tourism and binge parties in the streets, especially at the „Ballermann“ and in the famous „Schinkenstraße“ [lit. Ham Street, a row of well-frequented tourist bars]."
                            }
                        ]
                    }
                ],
