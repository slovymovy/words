{
    "word_family": [
        "smudge",
        "smudgy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4609ea46-3bce-3989-ad38-b9f9a4ee4255",
                    "sense_definition": "Blurred or marked by being rubbed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blurred",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist accidentally created a <w>smudged</w> effect on the charcoal portrait.",
                            "target_lang_translations": {
                                "zh": "艺术家不小心在炭笔画上制造出了一种<w>模糊</w>的效果。"
                            }
                        },
                        {
                            "text": "She tried to read the <w>smudged</w> ink on the old letter.",
                            "target_lang_translations": {
                                "zh": "她试图辨认旧信上那<w>模糊</w>的墨迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blurred",
                        "smeared"
                    ],
                    "antonyms": [
                        "clear",
                        "sharp"
                    ],
                    "common_phrases": [
                        "smudged ink",
                        "smudged writing"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因摩擦而变得模糊或留有污迹的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "模糊的",
                                "target_lang_sense_clarification": "指线条或字迹不清晰"
                            },
                            {
                                "target_lang_word": "有污迹的",
                                "target_lang_sense_clarification": "指表面留有脏痕或涂抹痕迹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18f4705a-1ad1-3312-b9af-58ce7cb51dfc",
                    "sense_definition": "Simple past and past participle of <w>smudge</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blurred",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>smudged</w> the wet paint while trying to move the canvas.",
                            "target_lang_translations": {
                                "zh": "他在移动画布时，不小心<w>弄脏</w>了未干的颜料。"
                            }
                        },
                        {
                            "text": "The document was <w>smudged</w> because someone touched it before the ink dried.",
                            "target_lang_translations": {
                                "zh": "这份文件因为有人在墨水干透前触碰过，所以被<w>弄脏</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "弄脏或擦模糊（smudge的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "指因接触而留下痕迹"
                            },
                            {
                                "target_lang_word": "擦模糊",
                                "target_lang_sense_clarification": "指因摩擦导致原本清晰的图像或文字变得模糊"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}