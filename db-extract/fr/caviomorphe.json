                                "target_senses": [
                                    {
                                        "sense_id": "31d7e7a5-e887-342f-a4bf-aade81e1587d",
                                        "entry_id": "45b4605a-7cdd-375b-89df-ccc0ac96e0bb",
                                        "glosses": [
                                            "Any rodent of the infraorder (sometimes parvorder) Caviomorpha, that unites all South American hystricognaths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24a356c9-3f3f-4206-b46f-d39bbbdb75e1",
                                                "sense_id": "31d7e7a5-e887-342f-a4bf-aade81e1587d",
                                                "text": "Cavies are caviomorphs. Caviomorphs are tailless South American rodents that are characterized by having one pair of mammae (teats), four digits on the forefoot, and three digits on the hind foot, as well as special anatomical features of the head and jaws."
                                            },
                                            {
                                                "example_id": "5d89481d-c84e-4ffb-ac76-2fbed218e11c",
                                                "sense_id": "31d7e7a5-e887-342f-a4bf-aade81e1587d",
                                                "text": "Platypittamys was a caviomorph that lived in southern South America around 30 million years ago.[…]Today caviomorphs are found in South America, but genetic studies show that they are descended from African rodents."
                                            },
                                            {
                                                "example_id": "6026a778-b2f8-4e00-b2f2-167e5000c183",
                                                "sense_id": "31d7e7a5-e887-342f-a4bf-aade81e1587d",
                                                "text": "In beds of Deseadan age caviomorphs are represented by 6 families (9 genera), in the Santacrucian by 7 families (17 genera), and in the Hayquerian by 8 families (21 genera) (Marshall et al. In press b)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
