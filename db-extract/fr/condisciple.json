        "fr-extract.jsonl": [
            {
                "entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                "word": "condisciple",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7bb1ceec-7f9a-40b4-b922-27f058fcebe5",
                        "entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "condisciples"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                        "entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "glosses": [
                            "Compagnon d’étude, dans la même école, dans la même classe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b232ba4d-793f-41bc-a951-54a53fbac784",
                                "sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                                "text": "Tout en causant, il emmena son ancien condisciple."
                            },
                            {
                                "example_id": "d1fa0711-fb4f-425c-8d92-9bf5bcd21d49",
                                "sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                                "text": "Plusieurs de mes condisciples, qui d’abord m’avaient brutalisé, se montraient maintenant un peu meilleurs pour moi ; j’étais si facile à contenter que j’en éprouvais une grande reconnaissance ; je pensais que je m’étais trompé et qu’ils n’étaient pas méchants."
                            },
                            {
                                "example_id": "1b7c7fbd-09ba-4bcb-afdb-f5e8243124f8",
                                "sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                                "text": "Il a été mon condisciple. Nous étions condisciples, votre père et moi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e010b731-3fdf-451a-891f-569340f3497e",
                        "source_entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "source_sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                        "target_lang_word": "Studienkollege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Studienkollege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c928eec3-a5eb-30ab-ac18-c7d67a26979c",
                                        "entry_id": "d466d4eb-57b1-3fea-b00e-7452119e4c35",
                                        "glosses": [
                                            "(männliche^☆) Person, mit der jemand zusammen studiert(e)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdc82e7-eb82-4572-972b-95edea3ca855",
                                                "sense_id": "c928eec3-a5eb-30ab-ac18-c7d67a26979c",
                                                "text": "Alexander kenne ich schon sehr lange. Er war im zweiten Studium mein Studienkollege."
                                            },
                                            {
                                                "example_id": "e10c6503-bff0-4244-93d0-04941be815bd",
                                                "sense_id": "c928eec3-a5eb-30ab-ac18-c7d67a26979c",
                                                "text": "„Bei Moser sperrte sich die bundesrepublikanische Seite jahrelang gegen einen Austausch. Ich wandte mich schließlich im Juni 1980 an den Bundesaußenminister, Hans-Dietrich Genscher, den ich als Studienkollegen aus gemeinsamer Göttinger Zeit kannte (»Ich hoffe, daß Du mich in (guter) Erinnerung hast«) und bat ihn, unter Darlegung der humanitären Gründe, die für eine Freilassung sprachen, etwas für Moser zu tun.“"
                                            },
                                            {
                                                "example_id": "c54b0aad-5df2-4020-86c4-fc73ed7a62ff",
                                                "sense_id": "c928eec3-a5eb-30ab-ac18-c7d67a26979c",
                                                "text": "„Letztes Wochenende heiratete Klaus, mein alter Studienkollege, Elena aus Griechenland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "850078d4-ea0b-48e4-83d9-6e9f5657ace3",
                        "source_entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "source_sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                        "target_lang_word": "Klassenkamerad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klassenkamerad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                        "entry_id": "cf1b8e2c-fbe9-34da-9dbc-4a7580988e65",
                                        "glosses": [
                                            "Person, mit der man in dieselbe Schulklasse geht oder ging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28833d01-cf52-4110-bacd-376762b5f09f",
                                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                                "text": "Morgen ist Klassentreffen. Ich bin ja so gespannt, was aus meinen Klassenkameraden geworden ist."
                                            },
                                            {
                                                "example_id": "5e97dbf9-7bdc-40ef-92f1-7c03bb7d2121",
                                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                                "text": "„Meine neuen Klassenkameraden waren ausnahmsweise mal wirklich nett.“"
                                            },
                                            {
                                                "example_id": "749639c2-d838-4474-b627-45cd0b746999",
                                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                                "text": "„Weil sie in Bad Schandau aus der Jugendherberge ausgebüxt waren, haben Floris alte Klassenkameraden Strafarbeiten bekommen.“"
                                            },
                                            {
                                                "example_id": "9ba8499f-66fe-4268-a767-7f246a6a4dd5",
                                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                                "text": "„Eines Abends aber, als der Junge und zwei Klassenkameraden bei ihm in seinem Internatszimmer zum Tee eingeladen waren, erzählte er Näheres darüber.“"
                                            },
                                            {
                                                "example_id": "0a76bfa1-702f-46a2-8852-9e6d26e2cb49",
                                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                                "text": "„Das alles wussten meine Klassenkameraden nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e352c59b-5009-47a8-9e6f-fffa6c50d076",
                        "source_entry_id": "4026e29d-6c72-3fb1-bc61-93a356afafcb",
                        "source_sense_id": "15ae62ad-1bd8-3f31-a47f-596eb9e95c1c",
                        "target_lang_word": "schoolmate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schoolmate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                        "entry_id": "9235123b-7a7e-3a62-a5a9-a0d738700730",
                                        "glosses": [
                                            "A person who was a fellow attendee at one's school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9f6a56a-df39-46ed-877c-c82ad32c0202",
                                                "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                                "text": "I've lost touch with all my old schoolmates: I only see them at class reunions."
                                            },
                                            {
                                                "example_id": "52a4bf9f-a273-4769-ac39-cca554fad459",
                                                "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                                "text": "The truth seems to be, however, that when he casts his leaves forth upon the wind, the author addresses, not the many who will fling aside his volume, or never take it up, but the few who will understand him better than most of his schoolmates or lifemates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
