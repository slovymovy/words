                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kauczuk",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e240369d-75c8-32ff-90b7-2d080f26b2c6",
                                        "entry_id": "a24da932-1059-3a81-9562-d2d8b1b7d5b6",
                                        "glosses": [
                                            "surowiec do produkcji gumy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de72e4d7-7f6f-4e58-8ca5-892bd7d0d747",
                                                "sense_id": "e240369d-75c8-32ff-90b7-2d080f26b2c6",
                                                "text": "W maszynach musi być jakiś feler, czy w samym wynalazku, dość, że ten kauczuk, to okazał się do niczego"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df016f7a-3a84-4466-aa59-dd8a04c5c2b9",
                        "source_entry_id": "a867dca7-bc73-394e-aab6-1d76262d5146",
                        "source_sense_id": "06f3116f-10a0-3ce0-9ab5-ba429af36d20",
                        "source_sense_description": "natural rubber",
                        "target_lang_word": "каучу́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "каучу́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2eda9fa9-560c-3edb-b8de-78a16cfc0e1e",
                                        "entry_id": "4d7cdff0-9cd9-3aec-a142-be1efc8139fb",
                                        "glosses": [
                                            "упругое вещество, получаемое из млечного сока некоторых (преимущественно тропических) растений, либо химическим путём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea034a0-6b64-4359-bbe6-da6c20d800c1",
                                                "sense_id": "2eda9fa9-560c-3edb-b8de-78a16cfc0e1e",
                                                "text": "Первоначально применение каучука было самое скромное, и ничто не позволяло предвидеть в будущем столь широкого его использования. Сначала он служил только для стирания карандаша с бумаги и чистки обоев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
