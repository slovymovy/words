                "senses": [
                    {
                        "sense_id": "efe48429-da9a-3cff-9d8a-08e7f495bd19",
                        "entry_id": "53bdc63a-c670-3ce2-9965-d80b09887fce",
                        "glosses": [
                            "de als een koepel ervaren atmosfeer overdag of sterrenhemel in de nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf6fa11-e099-4437-b4af-473e2f533fdf",
                                "sense_id": "efe48429-da9a-3cff-9d8a-08e7f495bd19",
                                "text": "En God zei: Laten er lichten zijn aan het hemelgewelf om scheiding te maken tussen de dag en de nacht; en laten zij zijn tot aanduiding van vaste tijden en van dagen en jaren!"
                            },
                            {
                                "example_id": "e6b8a5b7-0e50-4d40-8b7f-6d03e412c015",
                                "sense_id": "efe48429-da9a-3cff-9d8a-08e7f495bd19",
                                "text": "Wanneer de winterwolken wijken, is de komende weken een bijzonder verschijnsel te zien aan de sterrenhemel. De planeten Jupiter en Saturnus staan bijna tegen elkaar aan in het hemelgewelf. De afstand tussen de twee punten in de lucht is zo klein, dat ze bijna één ‘ster’ lijken te worden."
                            }
                        ]
                    }
