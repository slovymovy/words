                ],
                "senses": [
                    {
                        "sense_id": "f8973f9a-1681-3e3f-bdb9-8c0a743ebdb5",
                        "entry_id": "3f857680-af63-3407-a21e-390c4fa28fb9",
                        "glosses": [
                            "mężczyzna cierpiący na bigoreksję"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "f0d83ffd-8eae-422f-a900-b594a6393373",
                                "sense_id": "f8973f9a-1681-3e3f-bdb9-8c0a743ebdb5",
                                "text": "Niestety nie są w stanie zaakceptować swojego wyglądu i swojego ciała. W efekcie zaczynają sięgać po odżywki, a kiedy i one nie przynoszą oczekiwanych rezultatów, zaczynają stosować sterydy anaboliczne. Jednak i w tym przypadku nie uda się osiągnąć celu, ponieważ wymarzona sylwetka bigorektyka nie istnieje"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "487361ed-ecda-4c0d-8cb9-95aa47b06def",
                        "source_entry_id": "3f857680-af63-3407-a21e-390c4fa28fb9",
                        "source_sense_id": "f8973f9a-1681-3e3f-bdb9-8c0a743ebdb5",
                        "target_lang_word": "bigorexique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigorexique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05b34078-ed16-34ca-b166-c76b9de9a55d",
                                        "entry_id": "ff178825-5d90-353a-a267-7f0f462f7b48",
                                        "glosses": [
                                            "Qui est atteint de bigorexie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8333f77a-3b59-41a5-a7e8-d8bbef86cce0",
                                                "sense_id": "05b34078-ed16-34ca-b166-c76b9de9a55d",
                                                "text": "Le garçon était assis, le dos à la porte, concentré sur l’écran de son ordinateur, sur lequel on voyait une sorte de guerrier bigorexique anéantissant des squelettes avec une épée disproportionnée. Il ne nous accorda même pas un regard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bigorexique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4826f87-14b3-319c-9c6a-f805b8412b28",
                                        "entry_id": "a3a5c867-c2c9-3902-b9fb-a65cf45004c1",
                                        "glosses": [
                                            "Individu bigorexique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b06932-8cea-4a1d-8734-b45c97f24ca6",
                                                "sense_id": "b4826f87-14b3-319c-9c6a-f805b8412b28",
                                                "text": "La carnitine est également très appréciée des fanas du fitness et du culturisme, que certains médecins nomment « bigorexiques » – des malades atteints d'une nouvelle forme de trouble obsessionnel de l'alimentation et du comportement. Les bigorexiques sont poussés à prendre 2 à 4 grammes de carnitine par jour, en guise de potion brûleuse de graisses et constructrice de muscles."
                                            },
                                            {
                                                "example_id": "f98101f2-0413-4f50-b6d3-a45fbd4297c2",
                                                "sense_id": "b4826f87-14b3-319c-9c6a-f805b8412b28",
                                                "text": "Sans surprise, les bigorexiques sont particulièrement à risque d’être touchés par le syndrome de surentraînement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
