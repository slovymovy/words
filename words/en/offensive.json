{
    "word_family": [
        "offend",
        "offense",
        "offender",
        "offensively",
        "inoffensive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb56e515-69fe-3c17-9e98-e02334352389",
                    "sense_definition": "Causing someone to feel upset, annoyed, or insulted; also used to describe something very unpleasant, such as a smell.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people found his comments about the incident deeply <w>offensive</w>.",
                            "target_lang_translations": {
                                "ru": "Многие сочли его комментарии об инциденте глубоко <w>оскорбительными</w>.",
                                "zh": "许多人认为他关于那次事件的评论极其<w>冒犯</w>。"
                            }
                        },
                        {
                            "text": "There was an <w>offensive</w> smell coming from the garbage bin behind the restaurant.",
                            "target_lang_translations": {
                                "ru": "Из мусорного бака за рестораном доносился <w>отвратительный</w> запах.",
                                "zh": "餐馆后面的垃圾桶里散发出一种<w>令人作呕</w>的气味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unheard-of",
                        "invidious"
                    ],
                    "antonyms": [
                        "inoffensive"
                    ],
                    "common_phrases": [
                        "find offensive",
                        "deeply offensive",
                        "offensive language",
                        "offensive smell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий обиду, раздражение или оскорбление; также используется для описания чего-то очень неприятного, например, запаха.",
                        "zh": "引起他人不快、恼火或感到被侮辱；也用于描述非常令人不悦的事物，例如气味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорби́тельный",
                                "target_lang_sense_clarification": "содержащий оскорбление"
                            },
                            {
                                "target_lang_word": "оби́дный",
                                "target_lang_sense_clarification": "причиняющий обиду"
                            },
                            {
                                "target_lang_word": "отврати́тельный",
                                "target_lang_sense_clarification": "о запахе или вкусе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒犯的",
                                "target_lang_sense_clarification": "指言行举止令人感到被冒犯"
                            },
                            {
                                "target_lang_word": "令人作呕的",
                                "target_lang_sense_clarification": "指气味或感官上极度不悦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62177d67-d740-3090-8829-00aa5508a485",
                    "sense_definition": "Connected with the act of attacking rather than defending.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army prepared its <w>offensive</w> capabilities for the upcoming battle.",
                            "target_lang_translations": {
                                "ru": "Армия подготовила свои <w>наступательные</w> возможности к предстоящей битве.",
                                "zh": "军队为即将到来的战斗准备了<w>进攻性</w>力量。"
                            }
                        },
                        {
                            "text": "Carrying an <w>offensive</w> weapon in public is a serious crime.",
                            "target_lang_translations": {
                                "ru": "Ношение <w>наступательного</w> оружия в общественном месте является тяжким преступлением.",
                                "zh": "在公共场合携带<w>进攻性</w>武器是严重的犯罪行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aggressive"
                    ],
                    "antonyms": [
                        "defensive"
                    ],
                    "common_phrases": [
                        "offensive weapon",
                        "offensive action",
                        "offensive strategy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с действиями по нападению, а не защите.",
                        "zh": "与进攻而非防御相关的行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наступа́тельный",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进攻性的",
                                "target_lang_sense_clarification": "军事或战术上的主动攻击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31b27cbf-1bbc-3dd0-8762-0dd51cc5ffb2",
                    "sense_definition": "Relating to the team that has possession of the ball and is trying to score points in a game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>offensive</w> coordinator called for a pass play to surprise the defense.",
                            "target_lang_translations": {
                                "ru": "Координатор <w>нападения</w> назначил пас, чтобы застать защиту врасплох.",
                                "zh": "<w>进攻</w>协调员呼叫了一次传球战术，以出其不意地打击防守方。"
                            }
                        },
                        {
                            "text": "He is considered one of the most valuable <w>offensive</w> players in the league.",
                            "target_lang_translations": {
                                "ru": "Он считается одним из самых ценных <w>атакующих</w> игроков в лиге.",
                                "zh": "他被认为是联盟中最有价值的<w>进攻</w>球员之一。"
                            }
                        }
                    ],
                    "antonyms": [
                        "defensive"
                    ],
                    "common_phrases": [
                        "offensive player",
                        "offensive foul",
                        "offensive line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к команде, владеющей мячом и пытающейся набрать очки в игре.",
                        "zh": "指体育比赛中控球并试图得分的一方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атаку́ющий",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "нападе́ния",
                                "target_lang_sense_clarification": "родительный падеж, напр. линия нападения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进攻的",
                                "target_lang_sense_clarification": "体育比赛中负责得分的一方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aefc1ddf-a8a3-318a-a63d-26f260163986",
                    "sense_definition": "A planned military attack involving a large force.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general decided to launch an <w>offensive</w> against the enemy positions at dawn.",
                            "target_lang_translations": {
                                "ru": "Генерал решил начать <w>наступление</w> на позиции врага на рассвете.",
                                "zh": "将军决定在黎明时分对敌方阵地发起<w>进攻</w>。"
                            }
                        },
                        {
                            "text": "Their major <w>offensive</w> was successful in regaining the lost territory.",
                            "target_lang_translations": {
                                "ru": "Их крупное <w>наступление</w> успешно вернуло утраченные территории.",
                                "zh": "他们的大规模<w>进攻</w>成功收复了失地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "launch an offensive",
                        "major offensive",
                        "military offensive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированная военная операция с участием крупных сил.",
                        "zh": "涉及大规模兵力的计划性军事攻击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наступле́ние",
                                "target_lang_sense_clarification": "военная операция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进攻",
                                "target_lang_sense_clarification": "军事行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abc205e8-df02-36d0-a736-d2c1c8d60f4a",
                    "sense_definition": "A position of attacking or taking strong action to achieve a result.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate decided to take the <w>offensive</w> during the final debate.",
                            "target_lang_translations": {
                                "ru": "Кандидат решил перейти в <w>наступление</w> во время финальных дебатов.",
                                "zh": "候选人决定在最后一场辩论中<w>主动出击</w>。"
                            }
                        },
                        {
                            "text": "We need to go on the <w>offensive</w> if we want to capture the market share.",
                            "target_lang_translations": {
                                "ru": "Нам нужно перейти в <w>наступление</w>, если мы хотим захватить долю рынка.",
                                "zh": "如果我们想占领市场份额，就需要<w>主动出击</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take the offensive",
                        "go on the offensive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позиция атаки или принятия решительных действий для достижения результата.",
                        "zh": "采取主动攻击或强硬行动以达成目标的姿态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наступле́ние",
                                "target_lang_sense_clarification": "активные действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主动出击",
                                "target_lang_sense_clarification": "采取积极的行动姿态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
