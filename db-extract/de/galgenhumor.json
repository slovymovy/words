                            "singular"
                        ],
                        "form": "der Galgenhumor"
                    },
                    {
                        "form_id": "6c4ed574-f150-4fc3-a075-9cb52b2bd8a7",
                        "entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Galgenhumors"
                    },
                    {
                        "form_id": "de877b6d-cb60-4cc3-abd6-4449ee1b274f",
                        "entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Galgenhumor"
                    },
                    {
                        "form_id": "5a5d848e-14bd-4b61-8f9c-cc8cf8886698",
                        "entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Galgenhumor"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                        "entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "glosses": [
                            "bitterer, nicht zuerst unterhaltsamer, vorgespielter, erkennbar aufgesetzter Humor, mit dem man eine unangenehme Situation meistern möchte; ein Humor, bei dem man „trotzdem lacht“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a5ee908-60b7-45fd-8ff5-8e0ad1c216b1",
                                "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                                "text": "„Humor ist immer Galgenhumor, und nötigenfalls lernen Sie ihn eben am Galgen.“"
                            },
                            {
                                "example_id": "1aa4acec-1130-4b2e-b03d-578d5efe277a",
                                "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                                "text": "„Trotzdem besaß er einen seltsamen Galgenhumor.“"
                            },
                            {
                                "example_id": "a101451d-30ca-4a3a-acf3-65a064eba535",
                                "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                                "text": "„Galgenhumor ist das, spielt nicht die Helden.“"
                            },
                            {
                                "example_id": "96f878da-41f2-4f25-9ee5-c0b6cf7fab70",
                                "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                                "text": "„Die Einheimischen hätten das Galgenhumor genannt.“"
                            },
                            {
                                "example_id": "0b242a26-b64f-44d6-a40d-39df46c89932",
                                "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                                "text": "„Ich werde wieder Deltafliegen gehen, weil ich konnte meinen ersten Flug nicht geniessen, kommentierte der Amerikaner, nicht ohne Galgenhumor.“"
                            },
                            {
                                "example_id": "32577a56-1e66-43da-9583-8b2e54741fe4",
                                "sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                                "text": "[Coronakrise:] „Die Stadt sucht nach Räumlichkeiten. »Vielleicht kann der Bürgermeister einige der Milliardärswohnungen in Manhattan beschlagnahmen, die stehen ja sowieso leer«, sagt die Ärztin. Zumindest Galgenhumor gibt es im Überfluss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b4e018a-60f9-494b-9175-4b496e9734c7",
                        "source_entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "source_sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                        "source_sense_description": "vorgespielter, erkennbar aufgesetzter Humor, mit dem man eine unangenehme Situation meistern möchte",
                        "target_lang_word": "gallows humor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallows humor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f2ccea-0d18-3564-9fe2-89241e78f397",
                                        "entry_id": "d4c38033-3c8d-390b-bbd7-727ba2a7b4fc",
                                        "glosses": [
                                            "A form of comedy that still manages to be humorous in the face of, and in response to, a tragic or hopeless situation."
                                        ],
                                        "tags": [
                                            "US",
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ac647c-60e0-4f65-9fdb-758beb108431",
                                                "sense_id": "a1f2ccea-0d18-3564-9fe2-89241e78f397",
                                                "text": "1931, \"German Falstaff\" (review of The Mirror of Fools by Alfred Neumann), Time, 16 Jan.,\nAuthor Neumann defiantly admits why he wrote this historical-romantic farce: \"Because I wanted to fight against the general and my personal depression, and because in hard and bad times there is always one tragicomic feeling in place—gallows humor.\""
                                            },
                                            {
                                                "example_id": "419bcda5-fbb7-4860-b6a1-4c323e5f4f18",
                                                "sense_id": "a1f2ccea-0d18-3564-9fe2-89241e78f397",
                                                "text": "The term was part of the language before Freud wrote an essay on it -- 'gallows humour.' This is middle European humour, a response to hopeless situations. It's what a man says faced with a perfectly hopeless situation and he still manages to say something funny. Freud gives examples: A man being led out to be hanged at dawn says, 'Well, the day is certainly starting well.' It's generally called Jewish humour in this country. Actually it's humour from the peasants' revolt, the thirty years' war, and from the Napoleonic wars. It's small people being pushed this way and that way, enormous armies and plagues and so forth, and still hanging on in the face of hopelessness. Jewish jokes are middle European jokes. And the black humourists are gallows humourists, as they try to be funny in the face of situations which they see as just horrible."
                                            },
                                            {
                                                "example_id": "e18ffa8d-1369-46a5-b552-b22ea0a54c3c",
                                                "sense_id": "a1f2ccea-0d18-3564-9fe2-89241e78f397",
                                                "text": "True enough, there are such things as laughless jokes, what Freud called gallows humor. . . . While we were being bombed in Dresden, sitting in a cellar with our arms over our heads in case the ceiling fell, one soldier said as though he were duchess in a mansion on a cold and rainy night, \"I wonder what the poor people are doing tonight.\""
                                            },
                                            {
                                                "example_id": "4d974a0d-1ec2-4e88-9518-53a33837bb57",
                                                "sense_id": "a1f2ccea-0d18-3564-9fe2-89241e78f397",
                                                "text": "Mattis, it turned out, was meeting with Trudeau at NATO headquarters. Already engaging in gallows humor, I wondered if Mattis was defecting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8465355f-42b6-4379-a806-e278098eacab",
                        "source_entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "source_sense_id": "78771c53-ee0b-3cd6-abbb-d64a7e41ed84",
                        "source_sense_description": "vorgespielter, erkennbar aufgesetzter Humor, mit dem man eine unangenehme Situation meistern möchte",
                        "target_lang_word": "humour noir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humour noir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af376dd4-03ab-3b8a-8deb-ccdaf907fa86",
                                        "entry_id": "4078c412-fbaf-37ef-83bf-b2c03562ed1e",
                                        "glosses": [
                                            "Forme d’humour qui souligne avec cruauté, amertume et parfois désespoir l’absurdité du monde, face à laquelle il constitue une forme de défense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cc8a2d7-9567-4175-9039-f3e51c44a9ed",
                                                "sense_id": "af376dd4-03ab-3b8a-8deb-ccdaf907fa86",
                                                "text": "L’humour noir pointe parfois son nez dans The Killer, témoignant du génie du réalisateur, de l’acteur et du scénariste Andrew Kevin Walker, déjà coauteur de Seven."
                                            },
                                            {
                                                "example_id": "1f5c402b-d0b8-4aaa-a924-5bb52a33e1d2",
                                                "sense_id": "af376dd4-03ab-3b8a-8deb-ccdaf907fa86",
                                                "text": "L’humour noir c’est comme la nourriture, pas tout le monde en a."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
