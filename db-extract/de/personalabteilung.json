                        "sense_id": "97b08d8f-5730-3423-b034-885eb428181f",
                        "entry_id": "f472c1a9-d3a1-3617-8209-fb31fc60c5a8",
                        "glosses": [
                            "für die Mitarbeiter betreffende Angelegenheiten zuständige Einheit in einem Unternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec7f1ec-59ac-4f32-8954-c53a30279013",
                                "sense_id": "97b08d8f-5730-3423-b034-885eb428181f",
                                "text": "„Diese heiteren Workaholics sind eine Freude für ihre Vorgesetzten, aber eine Plage für die Personalabteilungen, die für jeden nicht genommenen Urlaubstag Rückstellungen bilden müssen.“"
                            },
                            {
                                "example_id": "6a814cdf-e1d3-45f1-a1a3-5676f86b968d",
                                "sense_id": "97b08d8f-5730-3423-b034-885eb428181f",
                                "text": "„Hierauf besuchten sie die Personalabteilung und alle in dieser Stelle Tätigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
