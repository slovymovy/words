                ],
                "senses": [
                    {
                        "sense_id": "2194ff70-6afb-3556-bb49-29653edde36f",
                        "entry_id": "737d545a-2052-3b21-b1ae-4e0f453d4d70",
                        "glosses": [
                            "Text, der in drei Sprachen verfasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56909040-590a-4739-9520-8834a6bc750a",
                                "sense_id": "2194ff70-6afb-3556-bb49-29653edde36f",
                                "text": "„Glücklicherweise boten die Triskripte von Behistun und Persepolis dafür ausreichend Material, in denen Darius und Xerxes ihre Namen und Leistungen außer in Persisch auch in Elamitisch und Babylonisch hatten aufzeichnen lassen.“"
                            },
                            {
                                "example_id": "9796830f-563a-45df-b1b5-e99b5140d483",
                                "sense_id": "2194ff70-6afb-3556-bb49-29653edde36f",
                                "text": "„Er stellt sogar ein Triskript dar und vereint Hieroglyphisch (die ägyptische Monumentalschrift), Demotisch (die ägyptische Kursiva) und Griechisch, da das Gebiet zum Zeitpunkt der Entstehung des Steins griechisch besetzt war.“"
                            },
                            {
                                "example_id": "6b4614a2-d209-4a10-b09b-8a2687516d28",
                                "sense_id": "2194ff70-6afb-3556-bb49-29653edde36f",
                                "text": "„W. Schenkel hat den Begriff »Triskript« für die Ägyptologie übernommen…“"
                            },
                            {
                                "example_id": "891ec7b4-1858-4899-80fa-054dd1baf23f",
                                "sense_id": "2194ff70-6afb-3556-bb49-29653edde36f",
                                "text": "„Dieser Stein ist ein Triskript, d.h. eine Inschrift in drei verschiedenen Schriften: Hieroglyphisch (=offizielle Monumentalschrift), Demotisch (=einheimische Schrift) und Griechisch (= Schrift und Sprache der Besatzer). “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
