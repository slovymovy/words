                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a88b630-ffbf-4f5d-96d8-e21fa2a024d6",
                                "sense_id": "51ffdfc4-40e7-381d-9c80-b337412874ae",
                                "text": "Vliegensvlug Bunco spelen en oeverloos kwekken gaan moeiteloos samen. Dat verklaart vermoedelijk de populariteit onder Amerikaanse vrouwen. Hier spelen er 21 miljoen regelmatig Bunco, volgens een onderzoek van Procter & Gamble, dat ook niet als al te serieus moet worden genomen, want de firma was vorig jaar hoofdsponsor van het Wereld Bunco Kampioenschap in Las Vegas."
                            }
                        ]
                    }
