                "senses": [
                    {
                        "sense_id": "d012f2a6-ed64-3236-bfb4-24e5d953650f",
                        "entry_id": "9df3f49d-56d1-342a-a5f9-5adbeafb9726",
                        "glosses": [
                            "Weg, der mit Kies belegt und befestigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d385436a-1298-4d15-966b-f76278447185",
                                "sense_id": "d012f2a6-ed64-3236-bfb4-24e5d953650f",
                                "text": "„Die ersten Kastanienblätter fallen auf die Kieswege des Jardin des Tuileries.“"
                            },
                            {
                                "example_id": "9ac4f3e8-e193-4759-b1e3-14ae76793455",
                                "sense_id": "d012f2a6-ed64-3236-bfb4-24e5d953650f",
                                "text": "„Der Garten ist groß, der Posten kann nicht überall sein, und durch die Stille der Nacht hört man ihn auf den Kieswegen auf und ab marschieren.“"
                            },
                            {
                                "example_id": "f8ced8ee-b42f-4756-9852-c72854a7d7f2",
                                "sense_id": "d012f2a6-ed64-3236-bfb4-24e5d953650f",
                                "text": "„Der Parkweg wurde zum Kiesweg und wir holperten an stattlichen Platanen vorbei, deren gefleckte Stämme ich besonders liebte.“"
                            },
                            {
                                "example_id": "2e66210a-8b63-450b-9b04-97ba54e6d0a9",
                                "sense_id": "d012f2a6-ed64-3236-bfb4-24e5d953650f",
                                "text": "„Zuletzt ruhte sein Blick auf dem Vordergrund und verfolgte hier die Kieswege, die sich in abwechselnd breiten und schmalen Schlängellinien durch die Parkwiese hinzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
