                        "glosses": [
                            "iemand die een kaartspel speelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2124e9-cb29-4715-ad20-87cc3126608e",
                                "sense_id": "2de79607-2b14-309b-af2b-ea6f1bb3f2f7",
                                "text": "Met zijn schoonzus en een ander echtpaar hebben ze een wekelijkse kaartmiddag die om en om bij een van de kaarters thuis wordt gehouden."
                            },
                            {
                                "example_id": "d99cbbe6-8804-4b2e-ad06-983099f97e8c",
                                "sense_id": "2de79607-2b14-309b-af2b-ea6f1bb3f2f7",
                                "text": "De enige tafel bij het raam in de kantine van voetbalvereniging Amstelveen-Heemraad doet elke zaterdagmiddag dienst als klaverjastafel, al tientallen jaren. Maar weinigen weten dat zich onder deze kaarters vier winnaars van de Kromhoutmotor bevinden."
                            },
                            {
                                "example_id": "95a6b0ac-e966-410e-a8ad-a57886d7bee0",
                                "sense_id": "2de79607-2b14-309b-af2b-ea6f1bb3f2f7",
                                "text": "Pokeraar Eric van den Burg verwacht geen GTST-taferelen in de items over de mens achter de kaarter. Er bestaat een eng beeld van pokeren. Pokeren om geld mag niet in Nederland, alleen in besloten kring."
                            }
                        ]
                    }
