                                "target_senses": [
                                    {
                                        "sense_id": "36eb4ab6-f41e-3c36-9edb-885832b97b8f",
                                        "entry_id": "85bc0c43-223b-3071-a244-7862265df663",
                                        "glosses": [
                                            "A robot intended to interact physically with humans in a shared workspace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200fcd6f-08ca-4378-987b-dc81f67cb4b1",
                                                "sense_id": "36eb4ab6-f41e-3c36-9edb-885832b97b8f",
                                                "text": "But then Mr. Kuzmin discovered Universal Robots, which makes collaborative robots, or cobots, which are small, affordable and designed to operate safely side by side with workers. They are easy to program to do multiple tasks and allow the company to crank out parts around the clock."
                                            }
                                        ]
                                    }
