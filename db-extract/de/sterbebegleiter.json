                "senses": [
                    {
                        "sense_id": "81e5eba6-c3bf-3816-a0ee-1d9eccfb05e6",
                        "entry_id": "e19ac745-16ca-3b8b-93d1-755e1124d92e",
                        "glosses": [
                            "Person, die einem sterbenden Menschen beisteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2a32b4-9c5a-4f2f-8bd2-f678af4b0427",
                                "sense_id": "81e5eba6-c3bf-3816-a0ee-1d9eccfb05e6",
                                "text": "„Alle Sterbebegleiter sind immer an den Bedürfnissen des Sterbenden orientiert.“"
                            },
                            {
                                "example_id": "320cdd1a-0e18-4385-ab32-f93c08d0d25c",
                                "sense_id": "81e5eba6-c3bf-3816-a0ee-1d9eccfb05e6",
                                "text": "„Im Anschluss daran soll der Sterbebegleiter den Kranken zum Gebet anhalten, in dem der Betroffene um Gottes Gnade und das Umgehen des Höllenfeuers bitten soll.“"
                            },
                            {
                                "example_id": "e8753b5b-925e-4f97-a5c9-0bedc107b193",
                                "sense_id": "81e5eba6-c3bf-3816-a0ee-1d9eccfb05e6",
                                "text": "„Die Überlegungen beziehen sich auf das eigene Sterben und richten sich auch an Sterbende, Sterbebegleiter und Angehörige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
