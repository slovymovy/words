                ],
                "senses": [
                    {
                        "sense_id": "0ea30ee3-7766-365e-84fb-d79f7222b73d",
                        "entry_id": "20f3df61-0b27-3bab-9318-2a1b912e1dd8",
                        "glosses": [
                            "Gastronomiebetrieb, der vor allem Steaks zum Essen serviert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa2ce58-0d61-42d1-a7d9-3e97a3f1e3d4",
                                "sense_id": "0ea30ee3-7766-365e-84fb-d79f7222b73d",
                                "text": "„Mariah hat gesagt, er könne so lange bei ihr bleiben, wie wir zu tun hätten, und deshalb wandern die beunruhigte Kimmer und ich, Turteltäubchen hin oder her, die K Street hinauf zu einem der vielen Steakhäuser Washingtons.“"
                            },
                            {
                                "example_id": "e120329d-b0e6-49d6-aaf4-270f962d6659",
                                "sense_id": "0ea30ee3-7766-365e-84fb-d79f7222b73d",
                                "text": "„Um seinen Lebensunterhalt zu bestreiten, wusch Jake Pope Autos in einer die ganze Nacht geöffneten Autowaschanlage und stellte sie anschließend auf einem Parkplatz ab, der zu einem Steakhaus an der La Cienega gehörte.“"
                            },
                            {
                                "example_id": "2545fcf6-4c32-4130-a041-0ddc9dbbbd6c",
                                "sense_id": "0ea30ee3-7766-365e-84fb-d79f7222b73d",
                                "text": "„Er betrat das Steakhaus im Erdgeschoss des Gebäudes und wurde dort wieder aus dem Gastraum und eine schmale Treppe neben dem Restaurant hinaufgeschickt.“"
                            },
                            {
                                "example_id": "9e5be71b-a3ae-4b4a-bd62-48a20d6e6156",
                                "sense_id": "0ea30ee3-7766-365e-84fb-d79f7222b73d",
                                "text": "„Sie tragen den Hauptteil der Steuerlast, bekommen aber im Steakhaus keine besondere Speisekarte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
