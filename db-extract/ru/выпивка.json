                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "вы́пивках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65f3fc51-cc8b-31f9-9004-e4333fbe97f8",
                        "entry_id": "553fc39d-7794-309e-9d1a-2c5b78be291e",
                        "glosses": [
                            "разг., собир., неисч. алкогольные напитки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d896c7d7-f1d2-41ab-b76a-9bd2edf7cb19",
                                "sense_id": "65f3fc51-cc8b-31f9-9004-e4333fbe97f8",
                                "text": "По самым скромным подсчётам, выпивка и закуска для каждого гостя обошлись в несколько сот долларов."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb8feebb-5827-3d85-9d36-cfa7c3ff94f3",
                        "entry_id": "553fc39d-7794-309e-9d1a-2c5b78be291e",
                        "glosses": [
                            "разг. собрание, встреча для совместного употребления алкоголя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b7da43d-8344-4f1e-b299-666ced6208f9",
                                "sense_id": "fb8feebb-5827-3d85-9d36-cfa7c3ff94f3",
                                "text": "Он был старше других офицеров, картам и выпивкам предпочитал книги, за что к нему относились с изрядной долей иронии."
                            },
                            {
                                "example_id": "986414c3-29bc-4799-a906-ef0c4604850f",
                                "sense_id": "fb8feebb-5827-3d85-9d36-cfa7c3ff94f3",
                                "text": "Приятели Самсона по выпивкам очень её хвалили: она долго жила в Египте и знала все искусства тамошней любви."
                            }
                        ]
                    }
                ],
