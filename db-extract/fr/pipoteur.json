                        "sense_id": "5f6b2737-de42-33ae-b528-f7ed4891fbe5",
                        "entry_id": "713c1d7b-8733-3aec-9990-3c3f8d19e95e",
                        "glosses": [
                            "Personne qui affabule, qui raconte des mensonges."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf232ab-4a3e-4280-bb47-46f6e080b007",
                                "sense_id": "5f6b2737-de42-33ae-b528-f7ed4891fbe5",
                                "text": "Le plaisir du mythomane ne réside pas seulement dans la joie de flouer son interlocuteur, il prend aussi sa source dans l’étonnement que le pipoteur éprouve à croire à ses propres affabulations."
                            },
                            {
                                "example_id": "74119dfe-1898-4ba1-9e60-e6d655e5bc55",
                                "sense_id": "5f6b2737-de42-33ae-b528-f7ed4891fbe5",
                                "text": "Comme autres pigistes, il y avait Jean-Joël, que je trouvais un pipoteur de première, je n'arrivais même pas à comprendre comment les gens pouvaient acheter ses bobards […]."
                            },
                            {
                                "example_id": "3cf35d8f-2c6f-49ed-be17-311937aa8416",
                                "sense_id": "5f6b2737-de42-33ae-b528-f7ed4891fbe5",
                                "text": "C’est un pipoteur ! Il vient d’inventer ça, j’en suis sûre."
                            }
                        ]
                    }
