                        "sense_id": "48cd086e-d0d7-3554-acbe-fe323f50afc6",
                        "entry_id": "6fd94da1-936f-30e9-b797-df26e749bce7",
                        "glosses": [
                            "narrow-brimmed type of felt hat, described as having a \\\"shorter brim which is angled down at the front and slightly turned up at the back\\\" in comparison to the fedora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c17f15e-c624-451e-9720-9870cea608c3",
                                "sense_id": "48cd086e-d0d7-3554-acbe-fe323f50afc6",
                                "text": "“Nothing very special, sir. He had a mack or coat over his arm, and a trilby hat. He wore a tweed suit, sir, I think.”"
                            },
                            {
                                "example_id": "edda8b6e-853e-499f-bc1a-0e8d2ddb660e",
                                "sense_id": "48cd086e-d0d7-3554-acbe-fe323f50afc6",
                                "text": "Billy was seventeen years old. He was wearing a new navy-blue overcoat, a new brown trilby hat, and a new brown suit, and he was feeling fine."
                            }
                        ]
                    }
                ],
                "translations": [
