        "nl-extract.jsonl": [
            {
                "entry_id": "05c611aa-ead3-317a-874a-7763b11da921",
                "word": "aanlichten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e6fb1b0c-fa0f-3f71-86a9-71531d7f33fa",
                        "entry_id": "05c611aa-ead3-317a-874a-7763b11da921",
                        "glosses": [
                            "voorwerpen met licht beschijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f2564d-93a1-444f-ac9b-ec2fc3e392d7",
                                "sense_id": "e6fb1b0c-fa0f-3f71-86a9-71531d7f33fa",
                                "text": "Het ontwerp is redelijk vergelijkbaar met de huidige opstelling van de lichtmasten. Er komen diverse lichtmasten op 8,5 meter van de gevels te staan, zoveel mogelijk op de scheiding tussen de terrassen. Daarnaast wordt er veel aandacht besteed aan het aanlichten van de panden."
                            },
                            {
                                "example_id": "014ee0a5-9163-485c-a3b6-63826359506e",
                                "sense_id": "e6fb1b0c-fa0f-3f71-86a9-71531d7f33fa",
                                "text": "Auto’s moeten we weer toelaten in de Steenstraat en Deurningerstraat, de rest moet compleet verkeersvrij worden. Alle binnenstadstuinen moeten met elkaar verbonden worden, professioneel aanlichten en vaker openstellen.Bij alle centrum-ondernemers zorgen voor nog meer eensgezindheid en saamhorigheid. Het is de hoogste tijd voor een stadsmanager anex bruggenbouwer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ea44fc2-8b50-4897-81c0-b833d3a0ed51",
                        "source_entry_id": "05c611aa-ead3-317a-874a-7763b11da921",
                        "source_sense_id": "e6fb1b0c-fa0f-3f71-86a9-71531d7f33fa",
                        "target_lang_word": "shine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3bbe63-1ab8-3b0b-b6ea-1ee070ee7a39",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To emit or reflect light so as to glow."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11631bbe-8126-422f-98c0-379bcff7fddd",
                                                "sense_id": "9c3bbe63-1ab8-3b0b-b6ea-1ee070ee7a39",
                                                "text": "The water shone pacifically; the sky, without a speck, was a benign immensity of unstained light; the very mist on the Essex marshes was like a gauzy and radiant fabric, hung from the wooded rises inland, and draping the low shores in diaphanous folds."
                                            },
                                            {
                                                "example_id": "a5b7e0d4-02ad-4d72-88d9-b1843e77ff00",
                                                "sense_id": "9c3bbe63-1ab8-3b0b-b6ea-1ee070ee7a39",
                                                "text": "‘No. I only opened the door a foot and put my head in. The street lamps shine into that room. I could see him. He was all right. Sleeping like a great grampus. Poor, poor chap.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac0813c-7457-3237-a4df-054f32f86980",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To reflect light."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14b024d8-0fc5-3b1f-adb2-31815dd2b1e2",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To distinguish oneself; to excel."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5909f79-a697-4130-ae86-a332cc73ae89",
                                                "sense_id": "14b024d8-0fc5-3b1f-adb2-31815dd2b1e2",
                                                "text": "My nephew tried other sports before deciding on football, which he shone at right away, quickly becoming the star of his school team."
                                            },
                                            {
                                                "example_id": "df77a153-d827-41ba-beca-fbdf62923f26",
                                                "sense_id": "14b024d8-0fc5-3b1f-adb2-31815dd2b1e2",
                                                "text": "“[…] I was grateful to you for giving him a year’s schooling—where he shined at it—and for putting him as a clerk in your counting-house, where he shined still more.”"
                                            },
                                            {
                                                "example_id": "a2b891d5-38b1-46c2-bb8c-3bdf24492a41",
                                                "sense_id": "14b024d8-0fc5-3b1f-adb2-31815dd2b1e2",
                                                "text": "It prompted an exchange of substitutions as Jermain Defoe replaced Palacios and Javier Hernandez came on for Berbatov, who had failed to shine against his former club."
                                            },
                                            {
                                                "example_id": "ad4835c6-23be-4044-86a1-76ef47b7173b",
                                                "sense_id": "14b024d8-0fc5-3b1f-adb2-31815dd2b1e2",
                                                "text": "I can take the heat, baby, best believe\nThat's the moment I shine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41697017-534d-36b1-bc43-0e0bf8c104b6",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To be effulgent in splendour or beauty."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d96e0e7-d655-43f0-9525-1e0ed7c8ebea",
                                                "sense_id": "41697017-534d-36b1-bc43-0e0bf8c104b6",
                                                "text": "So proud she shyned in her Princely state."
                                            },
                                            {
                                                "example_id": "d134a4de-8079-49dd-9dec-ca6c21c5e04b",
                                                "sense_id": "41697017-534d-36b1-bc43-0e0bf8c104b6",
                                                "text": "Once brightest shined this child of heat and air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5db435f-9578-30d3-8eab-6305bc0aaad8",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To be eminent, conspicuous, or distinguished; to exhibit brilliant intellectual powers."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d2cfc8-5a36-41ae-b86b-87dea19fca07",
                                                "sense_id": "a5db435f-9578-30d3-8eab-6305bc0aaad8",
                                                "text": "Few are qualified to shine in company; but it in most men's power to be agreeable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6432313b-615a-30ce-99f9-e1bb9603a24b",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To be immediately apparent."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ada1e15d-8cfe-30fe-a160-a442a10e4057",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To create light with (a flashlight, lamp, torch, or similar)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5281f78-80fc-4e4d-9353-75aabd685be7",
                                                "sense_id": "ada1e15d-8cfe-30fe-a160-a442a10e4057",
                                                "text": "I shone my light into the darkness to see what was making the noise."
                                            },
                                            {
                                                "example_id": "16913806-486a-49a7-b553-ec140cb38258",
                                                "sense_id": "ada1e15d-8cfe-30fe-a160-a442a10e4057",
                                                "text": "As Jenks shined the large spotlight on the water, he saw a few bubbles and four long wakes leading away from an expanding circle of blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f84358-b6b9-30ce-a250-3b72c82504d7",
                                        "entry_id": "a7db69fe-dadc-3dc6-b23e-fd196554d065",
                                        "glosses": [
                                            "To cause to shine, as a light or by reflected light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acde28dd-5f54-4689-8e19-267964f95296",
                                                "sense_id": "a1f84358-b6b9-30ce-a250-3b72c82504d7",
                                                "text": "in hunting, to shine the eyes of a deer at night by throwing a light on them"
                                            },
                                            {
                                                "example_id": "e1eb4e6f-78ae-4de4-b0c9-3c82b017fb8c",
                                                "sense_id": "a1f84358-b6b9-30ce-a250-3b72c82504d7",
                                                "text": "He [God] doth not rain wealth, nor shine honour and virtues, upon men equally."
                                            }
                                        ]
                                    }
                                ]
                            },
