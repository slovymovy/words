    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01e1ccb8-3f6b-3cad-bc9b-37363b214a38",
                    "sense_definition": "een mechanische arm met een rubberen strip die de voorruit van een voertuig schoonveegt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voertuigonderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zet de <w>ruitenwissers</w> even aan, want ik zie bijna niets door de harde regen!",
                            "target_lang_translations": {
                                "en": "Turn on the <w>windshield wipers</w> for a moment, because I can barely see anything through the heavy rain!"
                            }
                        },
                        {
                            "text": "De bestuurder moest de <w>ruitenwisser</w> vervangen omdat het rubber versleten was en strepen achterliet.",
                            "target_lang_translations": {
                                "en": "The driver had to replace the <w>wiper</w> because the rubber was worn out and left streaks."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruitenwissers aanzetten",
                        "elektrische ruitenwisser"
                    ],
                    "target_lang_definitions": {
                        "en": "a mechanical arm with a rubber strip that wipes the windshield of a vehicle clean"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "windscreen wiper",
                                "target_lang_sense_clarification": "British English"
                            },
                            {
                                "target_lang_word": "windshield wiper",
                                "target_lang_sense_clarification": "American English"
                            },
                            {
                                "target_lang_word": "wiper",
                                "target_lang_sense_clarification": "shortened form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "753e2012-c1a6-3837-9ad8-7036cb979872",
                    "sense_definition": "een handgereedschap met een rubberen strip dat wordt gebruikt om ramen handmatig droog te trekken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaakgereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De glazenwasser gebruikt een professionele <w>ruitenwisser</w> om de ramen streeploos droog te maken.",
                            "target_lang_translations": {
                                "en": "The window cleaner uses a professional <w>squeegee</w> to dry the windows without leaving streaks."
                            }
                        },
                        {
                            "text": "Na het wassen van de ramen moet je met een <w>ruitenwisser</w> het overtollige water verwijderen.",
                            "target_lang_translations": {
                                "en": "After washing the windows, you should remove the excess water with a <w>window wiper</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "raamtrekker",
                        "wisser",
                        "raamwisser"
                    ],
                    "common_phrases": [
                        "streeploze ruitenwisser"
                    ],
                    "target_lang_definitions": {
                        "en": "a hand tool with a rubber strip used to manually pull windows dry"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeegee",
                                "target_lang_sense_clarification": "tool for cleaning windows"
                            },
                            {
                                "target_lang_word": "window wiper",
                                "target_lang_sense_clarification": "general term"
                            }
                        ]
                    }
                }
            ]
        }
    ]
