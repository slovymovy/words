{
    "word_family": [
        "paciorkowy",
        "paciorkowiec",
        "pacierz"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8030ba8a-4b6a-396c-8c44-6c8bbdc12d3a",
                    "sense_definition": "Mała, zazwyczaj kulista cząstka z otworem, nawlekana na nitkę lub sznurek, stanowiąca element naszyjnika lub różańca.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koralik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczynka nawlekała kolorowe <w>paciorki</w> na cienki sznurek, aby zrobić bransoletkę.",
                            "target_lang_translations": {
                                "ru": "Девочка нанизывала разноцветные <w>бусинки</w> на тонкий шнурок, чтобы сделать браслет."
                            }
                        },
                        {
                            "text": "Zerwał się stary naszyjnik i drobne <w>paciorki</w> rozsypały się po całej podłodze.",
                            "target_lang_translations": {
                                "ru": "Старое ожерелье порвалось, и мелкие <w>бусины</w> рассыпались по всему полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "koralik"
                    ],
                    "common_phrases": [
                        "szklane paciorki",
                        "paciorki różańca",
                        "nawlekać paciorki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, обычно округлый предмет с отверстием, нанизываемый на нить или шнурок, элемент ожерелья или чёток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бусина",
                                "target_lang_sense_clarification": "отдельный элемент бус или чёток"
                            },
                            {
                                "target_lang_word": "бусинка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8098042-87ee-34ea-b27c-76ffe6eb0ce6",
                    "sense_definition": "Krótka modlitwa odmawiana rano lub wieczorem, zwłaszcza przez dzieci; zdrobnienie od słowa <w>pacierz</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "modlitwa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed pójściem spać mały chłopiec uklęknął przy łóżku i odmówił swój wieczorny <w>paciorek</w>.",
                            "target_lang_translations": {
                                "ru": "Перед сном маленький мальчик встал на колени у кровати и прочитал свою вечернюю <w>молитву</w>."
                            }
                        },
                        {
                            "text": "Mama przypomniała dzieciom, aby zmówiły <w>paciorek</w> przed snem.",
                            "target_lang_translations": {
                                "ru": "Мама напомнила детям прочитать <w>молитву</w> перед сном."
                            }
                        }
                    ],
                    "synonyms": [
                        "modlitwa",
                        "pacierz"
                    ],
                    "common_phrases": [
                        "odmówić paciorek",
                        "zmówić paciorek",
                        "wieczorny paciorek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая молитва, читаемая утром или вечером, особенно детьми; уменьшительное от слова «pacierz»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молитва",
                                "target_lang_sense_clarification": "краткая, утренняя или вечерняя"
                            },
                            {
                                "target_lang_word": "молитовка",
                                "target_lang_sense_clarification": "детская или краткая молитва"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013cecf8-742e-3a4a-bf4b-9b9c811631f3",
                    "sense_definition": "Sznur z nawleczonymi koralikami służący do odliczania modlitw; różaniec lub koronka.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dewocjonalia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starsza kobieta przesuwała w palcach drewniane <w>paciorki</w> podczas cichej modlitwy w kościele.",
                            "target_lang_translations": {
                                "ru": "Пожилая женщина перебирала в пальцах деревянные <w>чётки</w> во время тихой молитвы в костёле."
                            }
                        },
                        {
                            "text": "Zakonnik nosił przy pasie długie <w>paciorki</w> wykonane z suszonych nasion.",
                            "target_lang_translations": {
                                "ru": "Монах носил на поясе длинные <w>чётки</w>, сделанные из сушёных семян."
                            }
                        }
                    ],
                    "synonyms": [
                        "różaniec",
                        "koronka"
                    ],
                    "common_phrases": [
                        "drewniane paciorki",
                        "przesuwać paciorki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шнур с нанизанными бусинами, используемый для отсчитывания молитв; чётки или розарий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чётки",
                                "target_lang_sense_clarification": "шнур с бусинами для молитвы"
                            },
                            {
                                "target_lang_word": "розарий",
                                "target_lang_sense_clarification": "католические чётки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "36d43f8c-625e-3e31-a99f-a11c9bc5e1f8",
                    "sense_definition": "Polskie nazwisko męskie.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Paciorek</w> przyszedł dzisiaj punktualnie na umówione spotkanie w biurze.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Пачёрек</w> пришёл сегодня вовремя на назначенную встречу в офисе."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z doktorem <w>Paciorkiem</w> o wynikach moich ostatnich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я разговаривал с доктором <w>Пачёреком</w> о результатах моих последних анализов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Польская мужская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пачёрек",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0a8177d-a78e-3fdb-8d1b-d11e3f559f34",
                    "sense_definition": "Polskie nazwisko żeńskie.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Paciorek</w> została wybrana na nową przewodniczącą komitetu rodzicielskiego.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Пачёрек</w> была выбрана новым председателем родительского комитета."
                            }
                        },
                        {
                            "text": "W sekretariacie szkoły powiedziano mi, że pani <w>Paciorek</w> ma dzisiaj dyżur.",
                            "target_lang_translations": {
                                "ru": "В секретариате школы мне сказали, что госпожа <w>Пачёрек</w> сегодня дежурит."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Польская женская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пачёрек",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}