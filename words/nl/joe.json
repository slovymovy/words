        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a7449cf3-ae2a-38b7-86eb-44f8c0b5bb16",
                    "sense_definition": "Een jongensnaam.",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mijn nieuwe collega heet <w>Joe</w> en hij komt uit Engeland.",
                            "target_lang_translations": {
                                "ru": "Моего нового коллегу зовут <w>Джо</w>, и он из Англии.",
                                "en": "My new colleague is called <w>Joe</w> and he comes from England.",
