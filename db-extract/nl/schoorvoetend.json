                    }
                ],
                "senses": [
                    {
                        "sense_id": "aef4dbd2-acaa-3122-94d6-ce47e2062f94",
                        "entry_id": "1592d00d-2daf-33fe-bf40-51eb2615634d",
                        "glosses": [
                            "met enige aarzeling, tegenzin en angst iets toch doen wat men eigenlijk niet had willen of durven doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977500a4-1369-4df9-a60e-bb2cd010faed",
                                "sense_id": "aef4dbd2-acaa-3122-94d6-ce47e2062f94",
                                "text": "Maar zie: de gevallen troonopvolger en de door de publieke opinie gekruisigde royals veerden weer recht. Schoorvoetend werd Camilla aanvaard, schoorvoetend bekende het publiek dat de standvastigheid van Elisabeth ook wel iets heeft."
                            },
                            {
                                "example_id": "c6d0972d-cf9f-4954-b268-3d78ee2a41ee",
                                "sense_id": "aef4dbd2-acaa-3122-94d6-ce47e2062f94",
                                "text": "Schoorvoetend en keel schrapend nam ik mijn to-dolijst door ‘Schrijven opiniestuk TC Tubantia’ prijkte ergens op die lijst. Alle tandwielen in mijn hoofd kermden op zoek naar een onderwerp, waar ik gevat over kon schrijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7675ce9-69f7-4509-be6c-875d2cb962cb",
                        "source_entry_id": "1592d00d-2daf-33fe-bf40-51eb2615634d",
                        "source_sense_id": "aef4dbd2-acaa-3122-94d6-ce47e2062f94",
                        "source_sense_description": "aarzelend",
                        "target_lang_word": "hesitant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hesitant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff1be40-46e8-3fc9-abc6-b9752785e790",
                                        "entry_id": "471de537-3be8-3dbd-9e8c-bd0de6b8903e",
                                        "glosses": [
                                            "Tending to hesitate, wait, or proceed with caution or reservation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288682de-6f6f-4000-aefd-7802c33f9c26",
                                                "sense_id": "eff1be40-46e8-3fc9-abc6-b9752785e790",
                                                "text": "I am hesitant to recommend him as a manager because he has a short temper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3946d9bd-3896-4357-91e8-9bfac0c31c83",
                        "source_entry_id": "1592d00d-2daf-33fe-bf40-51eb2615634d",
                        "source_sense_id": "aef4dbd2-acaa-3122-94d6-ce47e2062f94",
                        "source_sense_description": "aarzelend",
                        "target_lang_word": "reluctant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reluctant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd883636-9c0a-3a61-9b79-0f31c3cb2162",
                                        "entry_id": "66195cc3-a7c3-3f95-8f35-365963d496c7",
                                        "glosses": [
                                            "Not wanting to take some action; unwilling to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1766b5-6e6b-4115-bf3c-c2560425aa3c",
                                                "sense_id": "dd883636-9c0a-3a61-9b79-0f31c3cb2162",
                                                "text": "She was reluctant to lend him the money"
                                            },
                                            {
                                                "example_id": "5e943713-f49c-4b83-970d-cea608b1d66b",
                                                "sense_id": "dd883636-9c0a-3a61-9b79-0f31c3cb2162",
                                                "text": "Surprisingly, our new dog is a reluctant ball-retriever."
                                            },
                                            {
                                                "example_id": "283adf2a-cafc-4631-a577-aef849395362",
                                                "sense_id": "dd883636-9c0a-3a61-9b79-0f31c3cb2162",
                                                "text": "They are reluctant to the inclusion of a necessity test, especially of a horizontal nature, and emphasize, instead, the importance of procedural disciplines [...]."
                                            },
                                            {
                                                "example_id": "5bcf53ce-8f11-4c3e-a3de-c076e57288ce",
                                                "sense_id": "dd883636-9c0a-3a61-9b79-0f31c3cb2162",
                                                "text": "That’s probably because you appear as someone who rarely puts himself forward, and is reluctant to teach the wisdom he has."
                                            },
                                            {
                                                "example_id": "3a9d6203-274d-4b2e-9ab6-31a74a8254e1",
                                                "sense_id": "dd883636-9c0a-3a61-9b79-0f31c3cb2162",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087f0643-2618-3239-9f24-c92309d134af",
                                        "entry_id": "66195cc3-a7c3-3f95-8f35-365963d496c7",
                                        "glosses": [
                                            "Contrary; defiant; refractory."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a34714-8557-468f-a8c0-2ed047709dc3",
                                                "sense_id": "087f0643-2618-3239-9f24-c92309d134af",
                                                "text": "Whence we must infer, that the least stir of tumult or rebellion against the Prince is reluctant to all the Ordinances of Heaven, is an abortive product of Hell against the pure dictates of nature […]"
                                            },
                                            {
                                                "example_id": "f5636282-ad9a-44a5-ad9d-732847da1feb",
                                                "sense_id": "087f0643-2618-3239-9f24-c92309d134af",
                                                "text": "If pride be allowed to cause you to envy or wound the characters of such as differ from, or outshine you, or to make you reluctant to Christian reproof from your inferiors, how fearful is your guilt and danger!"
                                            },
                                            {
                                                "example_id": "4bd7c58a-581c-42ca-9fc8-45b90bb53e96",
                                                "sense_id": "087f0643-2618-3239-9f24-c92309d134af",
                                                "text": "There, breathless, with his digging nails he clung / Fast to the sand, lest the returning wave, / From whose reluctant roar his life he wrung, / Should suck him back to her insatiate grave [...]."
                                            },
                                            {
                                                "example_id": "b65663c2-44cd-4e52-a69c-898829d48851",
                                                "sense_id": "087f0643-2618-3239-9f24-c92309d134af",
                                                "text": "Many of the inhabitants were reluctant against the measure, and are still so obstinate that they must be compelled to do their duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3637a15-3aac-31b4-a048-c20d8db00a80",
                                        "entry_id": "66195cc3-a7c3-3f95-8f35-365963d496c7",
                                        "glosses": [
                                            "Tending to match as little text as possible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
