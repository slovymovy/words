                "senses": [
                    {
                        "sense_id": "26ed1119-01cc-351d-8425-fe85c64109d2",
                        "entry_id": "9add6090-b677-3ea7-94e5-b0ca3dcde9af",
                        "glosses": [
                            "Gruppe, die eine gemeinsame Auffassung in Bezug auf den Glauben und die Weltauffassung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c536fd7-29a4-48ae-b2f8-17b7a8321bd7",
                                "sense_id": "26ed1119-01cc-351d-8425-fe85c64109d2",
                                "text": "„Der Begriff der Religionsgesellschaft ist ein zentraler Begriff des institutionellen Staatskirchenrechts. Er ist unter anderem tatbestandliche Voraussetzung für die Anerkennung als Körperschaft des öffentlichen Rechts sowie für die Erteilung von Religionsunterricht als ordentliches Schulfach.“"
                            },
                            {
                                "example_id": "84115817-7ec4-4a41-9452-c3ef310f30af",
                                "sense_id": "26ed1119-01cc-351d-8425-fe85c64109d2",
                                "text": "„In der Spalte „Erklärungen“ befindet sich eine Zeile mit der Überschrift „Rechtliche Zugehörigkeit zu einer Kirche, Religionsgesellschaft oder Weltanschauungsgemeinschaft“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
