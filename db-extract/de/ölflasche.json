                "senses": [
                    {
                        "sense_id": "80762f3b-4a01-372a-8bf3-5c02b109ccc0",
                        "entry_id": "2b2648fa-b674-3eef-ab2c-ae665ba505ef",
                        "glosses": [
                            "eine Flasche, in der Öl aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efec8f2-6da5-4d92-b14b-42d6651f069a",
                                "sense_id": "80762f3b-4a01-372a-8bf3-5c02b109ccc0",
                                "text": "Ölflaschen werden meist aus Glas oder Kunststoff hergestellt."
                            },
                            {
                                "example_id": "4fe2d6a7-c2ae-4d07-983c-66b1f6afe803",
                                "sense_id": "80762f3b-4a01-372a-8bf3-5c02b109ccc0",
                                "text": "„Steht auf der Ölflasche in der Küche als Inhaltsvermerk \"Vegetable Oil\", ist die Wahrscheinlichkeit groß, dass es sich um Palmöl handelt.“"
                            },
                            {
                                "example_id": "d3f1a4c3-ba96-4ba5-a0f8-6c349743dc32",
                                "sense_id": "80762f3b-4a01-372a-8bf3-5c02b109ccc0",
                                "text": "„Hastig zieht eine verschleierte Frau eine Ölflasche aus der Tasche, ergreift das Geld des Händlers, dreht sich verstohlen um und zieht ihre kleine Tochter weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
