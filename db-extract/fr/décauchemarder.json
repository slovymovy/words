                "senses": [
                    {
                        "sense_id": "d7446c55-7c5b-33e9-9e89-a952737aa868",
                        "entry_id": "bc397a58-1d2b-3b86-8e3c-d9d8e9dbaa9c",
                        "glosses": [
                            "Cesser de cauchemarder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73890de2-4df2-474a-b00d-15d0552067da",
                                "sense_id": "d7446c55-7c5b-33e9-9e89-a952737aa868",
                                "text": "Il \" décauchemarde \" difficilement des contractions de sa compagne et toujours la question du prénom à donner au bébé vient troubler son sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dd3cba8-7f57-34ed-b683-112939e7a490",
                        "entry_id": "bc397a58-1d2b-3b86-8e3c-d9d8e9dbaa9c",
                        "glosses": [
                            "Débarrasser des cauchemars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e64daf63-00fc-4e9f-86ff-dc13595ce4dd",
                                "sense_id": "2dd3cba8-7f57-34ed-b683-112939e7a490",
                                "text": "L’angoisse m’a saisi alors que je croyais que les perspectives de jouissances inédites m’exciteraient avant de m’emporter, fourbu mais comblé, dans un sommeil décauchemardé."
                            },
                            {
                                "example_id": "bebc4448-928d-46c2-9d29-25d5f6a6de48",
                                "sense_id": "2dd3cba8-7f57-34ed-b683-112939e7a490",
                                "text": "Je fis une longue marche pour me décauchemarder"
                            }
                        ]
                    }
                ],
