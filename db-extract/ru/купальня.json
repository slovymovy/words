                "senses": [
                    {
                        "sense_id": "3948c805-5dfa-3861-8155-e2c71885dfbf",
                        "entry_id": "8b717267-f5a4-32ac-ad45-3cfb680fca45",
                        "glosses": [
                            "bathhouse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78a2e06-abd7-46d7-94ac-e894e13b21da",
                                "sense_id": "3948c805-5dfa-3861-8155-e2c71885dfbf",
                                "text": "— Да, давно́ я уже́ не мы́лся, — говори́л он, раздева́ясь. — Купа́льня у меня́, как ви́дите, хоро́шая, оте́ц ещё́ стро́ил, но мы́ться ка́к-то всё не́когда.",
                                "translation": "\"Yes,\" he said, \"it is a long time since I had a bath. My bathing-shed is all right, as you see. My father and I put it up, but somehow I have no time to bathe.\"",
                                "english": "\"Yes,\" he said, \"it is a long time since I had a bath. My bathing-shed is all right, as you see. My father and I put it up, but somehow I have no time to bathe.\""
                            }
                        ]
                    }
