                    },
                    {
                        "translation_id": "3368d990-3a5d-45c4-a1ec-145dda6fc690",
                        "source_entry_id": "fd7b46ea-4012-3cdf-b46f-bfebe68c6354",
                        "source_sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                        "target_lang_word": "phagocyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phagocyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                        "entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
                                        "glosses": [
                                            "Cellule possédant le pouvoir d’absorber et souvent aussi de digérer des particules étrangères, inorganiques ou organiques (microorganismes notamment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3de553-e9c5-4466-a820-3b1e05e69a0a",
                                                "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                                "text": "Le macrophage activé dans sa nouvelle fonction se nomme « phagocyte », c’est-à-dire « cellule mangeuse », et va opérer la phagocytose (« action de manger les cellules » étrangères à l’organisme)."
                                            },
                                            {
                                                "example_id": "f50cabca-95da-41db-ab00-3feb61dea541",
                                                "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                                "text": "C'est le signe d'une réaction de l'organisme : le tissu lymphoïde fabrique des phagocytes en abondance pour pouvoir lutter contre l'invasion parasitaire, qui se produit au niveau de la muqueuse intestinale."
                                            }
                                        ]
                                    }
                                ]
                            },
