                    {
                        "translation_id": "4430f766-3c81-45e4-9010-b778cbb80be0",
                        "source_entry_id": "f1783bae-0c61-3f64-a64d-1fbd92e33fc5",
                        "source_sense_id": "3d4fffdf-db15-3da6-8930-66a62e45239b",
                        "source_sense_description": "Stadt im französischen Département Somme in der Picardie",
                        "target_lang_word": "Amiens",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
