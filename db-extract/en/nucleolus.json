                                        "entry_id": "96493214-0a9c-3771-aeb7-4f06caa6d800",
                                        "glosses": [
                                            "Petit nucléus présent dans le noyau de la cellule, en charge de la synthèse des ARN ribosomiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f57f5377-498b-476b-8d80-f8006927f99b",
                                                "sense_id": "e048adb1-c7a1-3322-8a00-2a78dea1b18a",
                                                "text": "Le nucléole est une structure sphérique dense visible au cœur des noyaux."
                                            },
                                            {
                                                "example_id": "244833ba-3248-4b76-b47d-3c45a8f862ed",
                                                "sense_id": "e048adb1-c7a1-3322-8a00-2a78dea1b18a",
                                                "text": "Finalement les nucléoles se vacuolarisent et disparaissent, sauf un petit nombre qui donnent par transformation les chromosomes du premier fuseau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
