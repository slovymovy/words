                ],
                "senses": [
                    {
                        "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                        "entry_id": "8ab30da2-a224-3cfa-8602-909f12edd11a",
                        "glosses": [
                            "Spaziergang am Nachmittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012345be-fdf2-49b3-a30e-25d46ae6bf41",
                                "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                                "text": "Lass uns einen Nachmittagsspaziergang machen."
                            },
                            {
                                "example_id": "b450c645-47ee-40e3-8619-c805fa4c9b65",
                                "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                                "text": "„Böse starrte Beatrice das zitternde Tier an, das auf dem Tisch in der Halle darauf wartete, für seinen Nachmittagsspaziergang fertig gemacht zu werden.“"
                            },
                            {
                                "example_id": "0293f242-c7ba-45a3-8cb8-6ee70abceae4",
                                "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                                "text": "„Den Nachmittagsspaziergang wollte ich aber genauso wenig absagen. Also beschloss ich, erst in aller Ruhe mit meiner Mutter Kaffee zu trinken, dann mit ihr spazieren zu gehen und anschließend zu laufen. In die Dämmerung hinein.“"
                            },
                            {
                                "example_id": "e3233318-d084-4e57-aebe-c7c52e771e28",
                                "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                                "text": "„Nur den Nachmittagsspaziergang wollte er mitmachen, schon um die Kameraden endlich zu treffen.“"
                            },
                            {
                                "example_id": "147ce7d1-7c61-43ed-92a3-de9b672bec68",
                                "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                                "text": "„Da wir wegen des anhaltenden warmen Sommerwetters unsere ausgedehnten Nachmittagsspaziergänge in die Abendstunden verlegen mussten, bot ich der Fellnase an manchem Abend, nach einer kleinen Runde die Einkehr in ein Gasthaus.“"
                            },
                            {
                                "example_id": "d8ec8a96-30b5-48e6-95d5-ce9a3f1bc6d6",
                                "sense_id": "0a5212e6-6e27-328e-836f-a38dfbc459cd",
                                "text": "„Auf seinem Nachmittagsspaziergange kam der Pfarrer, die Arbeit zu besichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
