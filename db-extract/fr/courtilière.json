                                "target_senses": [
                                    {
                                        "sense_id": "6cdd369d-c2c1-3093-9d98-156ff6464fa6",
                                        "entry_id": "8912a3ab-1f36-3737-b0bd-650b7b1ddca3",
                                        "glosses": [
                                            "insetto che assomiglia al grillo con zampe davanti ampie e resistenti tramite le quali scava gallerie"
