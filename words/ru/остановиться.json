{
    "word_family": [
        "остановить",
        "остановка",
        "остановочный",
        "безостановочный",
        "приостановить",
        "приостановка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "101e6602-23ad-32ab-b90c-6586ce64dd4e",
                    "sense_definition": "Прекратить двигаться, перестать идти или ехать",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автобус <остановился> прямо перед нами.",
                            "target_lang_translations": {
                                "en": "The bus <stopped> right in front of us.",
                                "es": "El autobús se <paró> justo delante de nosotros.",
                                "fr": "L'autobus <s'est arrêté> juste devant nous."
                            }
                        },
                        {
                            "text": "Ты должен <остановиться> у знака стоп.",
                            "target_lang_translations": {
                                "en": "You must <stop> at the stop sign.",
                                "es": "Tienes que <detenerte> en la señal de alto.",
                                "fr": "Tu dois <t'arrêter> au panneau stop."
                            }
                        }
                    ],
                    "synonyms": [
                        "встать",
                        "затормозить"
                    ],
                    "antonyms": [
                        "пойти",
                        "двинуться"
                    ],
                    "common_phrases": [
                        "резко остановиться",
                        "остановиться на светофоре",
                        "машина остановилась"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop moving, to cease walking or driving",
                        "es": "Dejar de moverse, dejar de caminar o conducir",
                        "fr": "Cesser de se déplacer, s'arrêter de marcher ou de rouler"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "cease moving"
                            },
                            {
                                "target_lang_word": "come to a halt",
                                "target_lang_sense_clarification": "stop completely"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pararse",
                                "target_lang_sense_clarification": "dejar de moverse"
                            },
                            {
                                "target_lang_word": "detenerse",
                                "target_lang_sense_clarification": "frenar el movimiento"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'arrêter",
                                "target_lang_sense_clarification": "cesser de se déplacer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091e1bd3-4151-3eb7-8d03-6adf6bf14907",
                    "sense_definition": "Временно поселиться где-либо, например в гостинице или у знакомых",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lodging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <остановиться> в недорогой гостинице.",
                            "target_lang_translations": {
                                "en": "We decided to <stay> at an inexpensive hotel.",
                                "es": "Decidimos <hospedarnos> en un hotel económico.",
                                "fr": "Nous avons décidé de <descendre> dans un hôtel bon marché."
                            }
                        },
                        {
                            "text": "В Москве они <остановились> у родственников.",
                            "target_lang_translations": {
                                "en": "In Moscow, they <stayed> with relatives.",
                                "es": "En Moscú se <quedaron> con unos familiares.",
                                "fr": "À Moscou, ils <ont logé> chez des parents."
                            }
                        }
                    ],
                    "common_phrases": [
                        "остановиться в отеле",
                        "остановиться у друзей",
                        "остановиться на ночлег"
                    ],
                    "target_lang_definitions": {
                        "en": "To stay temporarily somewhere, such as at a hotel or with friends",
                        "es": "Alojarse temporalmente en algún lugar, como un hotel o casa de conocidos",
                        "fr": "Loger temporairement quelque part, par exemple dans un hôtel ou chez des connaissances"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stay",
                                "target_lang_sense_clarification": "lodge temporarily"
                            },
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "stay briefly"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hospedarse",
                                "target_lang_sense_clarification": "alojarse en un hotel o lugar"
                            },
                            {
                                "target_lang_word": "quedarse",
                                "target_lang_sense_clarification": "permanecer temporalmente"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "descendre",
                                "target_lang_sense_clarification": "dans un hôtel"
                            },
                            {
                                "target_lang_word": "séjourner",
                                "target_lang_sense_clarification": "passer du temps quelque part"
                            },
                            {
                                "target_lang_word": "s'arrêter",
                                "target_lang_sense_clarification": "faire une halte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b7637ed-f0d1-3e4b-89c2-39246f16bac2",
                    "sense_definition": "Перестать делать что-либо, прекратить действие",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он хотел что-то сказать, но вдруг <остановился>.",
                            "target_lang_translations": {
                                "en": "He wanted to say something, but suddenly <stopped>.",
                                "es": "Quería decir algo, pero de repente se <detuvo>.",
                                "fr": "Il voulait dire quelque chose, mais il <s'est> soudainement <arrêté>."
                            }
                        },
                        {
                            "text": "Пожалуйста, <остановись> и послушай меня.",
                            "target_lang_translations": {
                                "en": "Please <stop> and listen to me.",
                                "es": "Por favor, <para> y escúchame.",
                                "fr": "S'il te plaît, <arrête-toi> et écoute-moi."
                            }
                        }
                    ],
                    "antonyms": [
                        "продолжить"
                    ],
                    "common_phrases": [
                        "вовремя остановиться",
                        "не могу остановиться"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop doing something, to cease an action",
                        "es": "Dejar de hacer algo, interrumpir una acción",
                        "fr": "Cesser de faire quelque chose, interrompre une action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "cease an activity"
                            },
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "stop temporarily"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "parar",
                                "target_lang_sense_clarification": "dejar de hacer una acción"
                            },
                            {
                                "target_lang_word": "detenerse",
                                "target_lang_sense_clarification": "pausar una actividad"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'arrêter",
                                "target_lang_sense_clarification": "interrompre ce qu'on fait"
                            },
                            {
                                "target_lang_word": "cesser",
                                "target_lang_sense_clarification": "arrêter une action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef78f358-991d-3a8f-a882-68b1479ed16b",
                    "sense_definition": "Уделить особое внимание чему-либо в разговоре или исследовании",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лектор предложил <остановиться> на этой проблеме подробнее.",
                            "target_lang_translations": {
                                "en": "The lecturer suggested <dwelling> on this problem in more detail.",
                                "es": "El profesor sugirió <detenerse> en este problema con más detalle.",
                                "fr": "Le conférencier a proposé de <s'attarder> plus en détail sur ce problème."
                            }
                        },
                        {
                            "text": "Я хочу отдельно <остановиться> на результатах работы.",
                            "target_lang_translations": {
                                "en": "I want to specifically <focus> on the results of the work.",
                                "es": "Quiero <centrarme> especialmente en los resultados del trabajo.",
                                "fr": "Je souhaite <m'arrêter> particulièrement sur les résultats du travail."
                            }
                        }
                    ],
                    "common_phrases": [
                        "подробно остановиться",
                        "остановиться на вопросе",
                        "остановиться на деталях"
                    ],
                    "target_lang_definitions": {
                        "en": "To dwell on or give special attention to a topic",
                        "es": "Prestar especial atención a algo en una conversación o estudio",
                        "fr": "Accorder une attention particulière à quelque chose dans une discussion ou une étude"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dwell on",
                                "target_lang_sense_clarification": "discuss in detail"
                            },
                            {
                                "target_lang_word": "focus on",
                                "target_lang_sense_clarification": "pay attention to"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "detenerse en",
                                "target_lang_sense_clarification": "analizar en detalle"
                            },
                            {
                                "target_lang_word": "centrarse en",
                                "target_lang_sense_clarification": "enfocar la atención"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'attarder sur",
                                "target_lang_sense_clarification": "analyser en détail"
                            },
                            {
                                "target_lang_word": "s'arrêter sur",
                                "target_lang_sense_clarification": "fixer son attention"
                            },
                            {
                                "target_lang_word": "se concentrer sur",
                                "target_lang_sense_clarification": "mettre l'accent sur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77720f5a-c69f-3d67-9e44-e8efbbc6350f",
                    "sense_definition": "Сделать выбор в пользу кого-либо или чего-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы долго спорили и <остановились> на компромиссе.",
                            "target_lang_translations": {
                                "en": "We argued for a long time and <settled> on a compromise.",
                                "es": "Discutimos mucho y nos <decidimos> por un acuerdo.",
                                "fr": "Nous avons discuté longtemps et nous <nous sommes arrêtés> sur un compromis."
                            }
                        },
                        {
                            "text": "Почему вы <остановились> именно на этой модели?",
                            "target_lang_translations": {
                                "en": "Why did you <settle> on this particular model?",
                                "es": "¿Por qué se <decidieron> precisamente por este modelo?",
                                "fr": "Pourquoi <avez-vous opté> précisément pour ce modèle ?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "остановиться на выборе",
                        "остановиться на варианте",
                        "остановиться на этом"
                    ],
                    "target_lang_definitions": {
                        "en": "To settle on or choose something after consideration",
                        "es": "Tomar una decisión a favor de alguien o algo",
                        "fr": "Faire un choix en faveur de quelqu'un ou de quelque chose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settle on",
                                "target_lang_sense_clarification": "decide on"
                            },
                            {
                                "target_lang_word": "choose",
                                "target_lang_sense_clarification": "select"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "decidirse por",
                                "target_lang_sense_clarification": "elegir una opción"
                            },
                            {
                                "target_lang_word": "optar por",
                                "target_lang_sense_clarification": "seleccionar entre alternativas"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'arrêter sur",
                                "target_lang_sense_clarification": "choisir une option"
                            },
                            {
                                "target_lang_word": "se fixer sur",
                                "target_lang_sense_clarification": "faire un choix définitif"
                            },
                            {
                                "target_lang_word": "opter pour",
                                "target_lang_sense_clarification": "sélectionner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
