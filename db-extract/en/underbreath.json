                        "entry_id": "6c5d2026-8965-36e5-a122-4ab18dce38d9",
                        "glosses": [
                            "Under one's breath; inaudibly or in a barely audible manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d42b426c-30e8-4f80-bf0d-ddea873b70d8",
                                "sense_id": "3a0d17ba-fd28-371a-a095-55594b02644a",
                                "text": "Muttering curses underbreath, he jabs the beast sharply with his training stick ; the elephant is hairy and it, like the clown, is ignoble."
                            },
                            {
                                "example_id": "1c9b7db4-1015-43f4-aadc-dfa4b5e42b72",
                                "sense_id": "3a0d17ba-fd28-371a-a095-55594b02644a",
                                "text": "The name, Night Stalker, seemed to find favor with Bo who repeated it underbreath several times."
                            },
                            {
                                "example_id": "d91d0724-3153-4bfa-9f5c-d5eb1b17a721",
                                "sense_id": "3a0d17ba-fd28-371a-a095-55594b02644a",
                                "text": "Here, on the contrary, we murmur underbreath."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e8ceec4c-bb60-319b-8c79-640c09df54d7",
