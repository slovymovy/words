                "senses": [
                    {
                        "sense_id": "ddf9809b-1243-3dd4-bd39-537d7ee95962",
                        "entry_id": "4358f219-1ab0-3142-811b-370f24908396",
                        "glosses": [
                            "Symbol (als Teil einer grafischen Benutzeroberfläche), das die Position der Maus auf dem Bildschirm anzeigt"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "d98a3263-095f-4a47-8a6d-63cdca325e83",
                                "sense_id": "ddf9809b-1243-3dd4-bd39-537d7ee95962",
                                "text": "Der Mauszeiger verändert sich, wenn man auf einen Link geht."
                            },
                            {
                                "example_id": "5a5baaeb-40ef-4982-aed6-08788432fc23",
                                "sense_id": "ddf9809b-1243-3dd4-bd39-537d7ee95962",
                                "text": "Während das Programm lädt, wird der Mauszeiger zu einer kleinen Sanduhr."
                            },
                            {
                                "example_id": "60e1b7b0-f9b4-4655-8cdb-a2a195103927",
                                "sense_id": "ddf9809b-1243-3dd4-bd39-537d7ee95962",
                                "text": "„Der Mauszeiger bewegte sich ohne ihr Zutun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
