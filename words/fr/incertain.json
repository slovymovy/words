                {
                    "sense_id": "1c17b676-d25c-3f75-9d92-e3264fa9deaa",
                    "sense_definition": "Qui change facilement ou manque de stabilité ; variable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons préféré reporter la randonnée car le temps était trop <w>incertain</w>.",
                            "target_lang_translations": {
                                "en": "We decided to postpone the hike because the weather was too <w>unsettled</w>.",
                                "ru": "Мы решили перенести поход, потому что погода была слишком <w>переменчивой</w>.",
                                "de": "Wir haben die Wanderung lieber verschoben, weil das Wetter zu <w>wechselhaft</w> war.",
                                "es": "Preferimos aplazar la excursión porque el tiempo estaba demasiado <w>inestable</w>.",
                                "zh": "我们宁愿把徒步推迟，因为天气太<w>多变</w>了。"
                            }
                        },
                        {
                            "text": "Les cours de la Bourse sont restés <w>incertains</w> toute la semaine, alternant hausses et baisses.",
                            "target_lang_translations": {
                                "en": "Share prices remained <w>volatile</w> all week, swinging between gains and losses.",
                                "ru": "Курсы акций всю неделю оставались <w>неустойчивыми</w>, чередуя подъёмы и спады.",
                                "de": "Die Börsenkurse blieben die ganze Woche <w>schwankend</w> und wechselten zwischen Gewinnen und Verlusten.",
                                "es": "Las cotizaciones de la Bolsa se mantuvieron <w>inestables</w> toda la semana, alternando subidas y bajadas.",
                                "zh": "整周股价都很<w>不稳定</w>，时涨时跌。"
                            }
                        }
                    ],
