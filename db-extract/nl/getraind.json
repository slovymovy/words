                        "examples": [
                            {
                                "example_id": "287d224a-b04a-4673-9de5-1c0dc79103d4",
                                "sense_id": "e153be2a-482b-3f23-99c5-fbaf0fd16491",
                                "text": "Vooraf had ik best aardig getraind, maar het vlakke Nederland had mij absoluut niet voorbereid op deze omstandigheden. Zelfs het hoogteverschil kon ik duidelijk aan mijn ademhaling merken."
                            },
                            {
                                "example_id": "27196970-2b23-4b6a-8e6b-15037c4c1b8b",
                                "sense_id": "e153be2a-482b-3f23-99c5-fbaf0fd16491",
                                "text": "De jongen was goed getraind als een atleet, met golven in het iets te lange roodblonde haar en een mond die net zo gevormd was als die van zijn moeder."
                            }
                        ]
                    }
