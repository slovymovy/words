                                        "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                        "entry_id": "b0a07dd0-6144-395f-bcff-2674a8e73e55",
                                        "glosses": [
                                            "Le plus gros des deux os de la jambe, qui se trouve à la partie antérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf05053f-0d03-490e-b8a3-327d1a87e4f2",
                                                "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                                "text": "Se casser le tibia."
                                            },
                                            {
                                                "example_id": "538ed75f-ebf5-4c8a-8862-c430b3b15ada",
                                                "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                                "text": "Il mâchait une petite branche de tilleul en guise de dessert, croisait l’un sur l’autre, avec une désinvolture de squelette frivole, ses tibias sans chair, et il lisait, sous son auvent de paille noire poussiéreuse."
                                            },
                                            {
                                                "example_id": "05e7ceeb-3f7f-4a02-a327-e14d5c53bc77",
                                                "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                                "text": "On connaît ses fringues extravagantes, la veste en lézard et le costume de 2 000 dollars en poulain mort-né, qu’il jeta un jour dans la poubelle d’un aéroport, son chapeau orné d’une superbe tête de mort, tibias croisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109801d0-2697-3fd0-b9a2-58e413e1ca72",
                                        "entry_id": "b0a07dd0-6144-395f-bcff-2674a8e73e55",
                                        "glosses": [
                                            "Face avant de la partie antérieure de la jambe."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92e40d9-629a-4388-a86d-8081903a469d",
                                                "sense_id": "109801d0-2697-3fd0-b9a2-58e413e1ca72",
                                                "text": "Recevoir un coup dans le tibia."
                                            }
                                        ]
                                    }
                                ]
                            }
