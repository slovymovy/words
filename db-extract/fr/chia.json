                    {
                        "sense_id": "83378133-9661-311a-9c15-774a7259c8c7",
                        "entry_id": "086cbc17-59f9-3c46-8fdc-cbbc8cc70fcf",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ac73f5c-b981-4e26-9584-418c97740423",
                                "sense_id": "83378133-9661-311a-9c15-774a7259c8c7",
                                "text": "L’année dernière, elle a découvert l’infidélité de son footballeur de mari, qui a officialisé, peu après leur rupture, sa relation avec Clara Chia."
                            }
                        ]
                    }
                ],
