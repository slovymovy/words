                        "glosses": [
                            "D’une matière figurative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b7b2f9-dc70-4b4e-afa1-b5e85d4480cf",
                                "sense_id": "1ab29c08-5ac7-3f85-ab09-252782749676",
                                "text": "Il semble que ce cavalier soit de peu de conséquence ; c'est cependant celui qui donne le coup de jarnac, ou, pour ne point parler figurativement, le coup décisif à la partie parce qu'il tient les pièces de votre adversaire renfermées jusqu'à ce que le mat soit prêt comme on va voir."
                            }
                        ]
                    }
                ],
