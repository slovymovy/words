                                            {
                                                "example_id": "0f761b25-bb39-4cf4-bdeb-f6387ea679d2",
                                                "sense_id": "35dc3250-97f5-33a5-9b37-58fd8ac6dbda",
                                                "text": "Eh bien ! les six clochers polyédriques qui orneront notre temple auront chacun une hauteur de 74 mètres."
                                            },
