                "entry_id": "496b9872-f999-3af1-bd8d-f9389917b4f5",
                "word": "valorous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d59d34e9-7a65-4982-9986-654b25ca1358",
                        "entry_id": "496b9872-f999-3af1-bd8d-f9389917b4f5",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more valorous"
                    },
                    {
                        "form_id": "c8816139-4277-40e9-bf7e-522451fd3882",
                        "entry_id": "496b9872-f999-3af1-bd8d-f9389917b4f5",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most valorous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                        "entry_id": "496b9872-f999-3af1-bd8d-f9389917b4f5",
                        "glosses": [
                            "Having or displaying valour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760dd8ec-eb62-4b8b-80ae-87fe312cca4c",
                                "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                                "text": "c. 1490, William Caxton (translator), The Boke of Eneydos, Westminster, Preface,\nthis present booke compyled by virgyle ryght subtyl and Ingenyous oratour & poete Intytuled Eneydos hath be translated oute of latyn in to comyn langage In whiche may alle valyaunt prynces and other nobles see many valorous fayttes of armes."
                            },
                            {
                                "example_id": "4c54a5ea-bfdd-4fd4-a969-8686b46b7c2c",
                                "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                                "text": "[…] he esteems himself happy that he hath fallen into the hands of one, as he thinks, the most brave, valorous, and thrice-worthy signieur of England."
                            },
                            {
                                "example_id": "3fe5fc69-3bfa-4f4b-9d7c-baeda30015b8",
                                "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                                "text": "[…] I shall be at York—at the head of my daring and valorous fellows, as ready to support any bold design as thy policy can be to form one."
                            },
                            {
                                "example_id": "b5158ca9-6304-4e53-97e8-4da8439ac2a1",
                                "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                                "text": "He held up the glass. ‘To your valorous wounds. To the silver medal. […]’"
                            },
                            {
                                "example_id": "eb7f9e15-2d70-4c80-82b6-a524c6426e2c",
                                "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                                "text": "There are many valorous stories told of her, which enthral grown men as well as children."
                            },
                            {
                                "example_id": "50504d4a-3c52-4a76-95e5-5a8f9ef0550e",
                                "sense_id": "5af120f0-c3be-35ea-b786-d392d371c259",
                                "text": "For all its pragmatic public-health spade work, the foundation has also served as a kind of valorous abstraction — the seeming embodiment of “the Golden Rule,” in a phrase that Bill Gates likes to use, and the face of an increasingly anachronistic era of elite optimism."
                            }
                        ]
                    }
                ],
