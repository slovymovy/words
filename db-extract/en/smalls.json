                "senses": [
                    {
                        "sense_id": "87373f0d-e86c-36e0-a4b8-368c46993a6f",
                        "entry_id": "c6f897c5-13b5-3bf8-9aef-6db7b3b67868",
                        "glosses": [
                            "Underwear."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "a9025002-fa43-4a88-bc9c-601979c20eb0",
                                "sense_id": "87373f0d-e86c-36e0-a4b8-368c46993a6f",
                                "text": "He's in the garden hanging his smalls on the washing line."
                            },
                            {
                                "example_id": "e6365c24-fcfb-4096-b22b-b68ed575f0ec",
                                "sense_id": "87373f0d-e86c-36e0-a4b8-368c46993a6f",
                                "text": "The smalls he was wearing were tight."
                            },
                            {
                                "example_id": "f58fdb8f-8caf-4e06-a5ad-9077756371ee",
                                "sense_id": "87373f0d-e86c-36e0-a4b8-368c46993a6f",
                                "text": "Unkempt, bearded to the eyes, there he stood clutching his shapeless old cabbage-tree, in mud-stained jumper and threadbare smalls—the very spit of the unsuccessful digger."
                            },
                            {
                                "example_id": "5c63927b-22c6-46ae-9a1e-5ab2e33f8ad0",
                                "sense_id": "87373f0d-e86c-36e0-a4b8-368c46993a6f",
                                "text": "[…]there are also some great B&Bs and guesthouses where you can unpack a toothbrush and fresh set of smalls for the morning."
                            },
                            {
                                "example_id": "da916828-cd55-4fbb-83d8-fa2e65492b46",
                                "sense_id": "87373f0d-e86c-36e0-a4b8-368c46993a6f",
                                "text": "They billowed in the sticky summer breeze, curved and enormous like the sails of the Sydney Opera House.\nJust when did my smalls become so impossibly large?"
                            }
                        ]
                    },
                    {
                        "sense_id": "95631067-2af1-325e-bc03-b68af01e6f39",
                        "entry_id": "c6f897c5-13b5-3bf8-9aef-6db7b3b67868",
                        "glosses": [
                            "Small goods."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "25f99370-682c-4e86-977c-fc02c18105b1",
                                "sense_id": "95631067-2af1-325e-bc03-b68af01e6f39",
                                "text": "He reassured another questioner that B.R. were still deeply interested in smalls traffic, but said that there would have to be substantial changes in the mode of operation and that concentration of the traffic was essential."
                            }
                        ]
                    },
                    {
                        "sense_id": "08909749-f32b-30ec-a738-9737f2064534",
                        "entry_id": "c6f897c5-13b5-3bf8-9aef-6db7b3b67868",
                        "glosses": [
                            "The preliminary examination for a degree."
                        ],
                        "tags": [
                            "dated",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "72819b6f-e0da-4557-b8d2-b2d6e196550a",
                                "sense_id": "08909749-f32b-30ec-a738-9737f2064534",
                                "text": "You see, Miss Dodd, an university examination consists of several items: neglect but one, and Crichton himself would be ploughed; because brilliancy in your other papers is not allowed to count; that is how the most distinguished man of our day got ploughed for Smalls."
                            }
                        ]
                    },
                    {
                        "sense_id": "6be7d0f7-2862-38b1-a5e3-8baea953cd42",
                        "entry_id": "c6f897c5-13b5-3bf8-9aef-6db7b3b67868",
                        "glosses": [
                            "Ellipsis of small ads."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis",
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "95879799-3391-462b-b142-72e3054c5af6",
                                "sense_id": "6be7d0f7-2862-38b1-a5e3-8baea953cd42",
                                "text": "Provincial English papers still carry their “smalls” — want ads — on the first page."
                            }
                        ]
                    }
