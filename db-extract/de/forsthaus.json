                "senses": [
                    {
                        "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                        "entry_id": "cf492b56-e42d-30b2-a10d-be8c657dea86",
                        "glosses": [
                            "Wohnsitz und Dienststelle eines Försters oder einer Försterin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2016c41-c3d1-43cb-b91d-028e3219b450",
                                "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                                "text": "Das Forsthaus lag völlig einsam, mitten im Walde."
                            },
                            {
                                "example_id": "eb86b211-7c6e-4ecc-90c6-355f60186bad",
                                "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                                "text": "Auch aus dem Forsthause Winkelhorst waren sie da: der alte Förster, seine Tochter Marianne, der Forsteleve Felsener und heute auch der Jäger Gottfried Wolf."
                            },
                            {
                                "example_id": "24381606-a70e-40bd-9cde-25347a74f977",
                                "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                                "text": "Das durch den Förster bewohnte Forsthaus gibt es immer seltener."
                            },
                            {
                                "example_id": "0a6bc865-c643-481c-ad02-c40d9dc4fb9e",
                                "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                                "text": "Das Forsthaus in der Jägerstraße 2 war das erste Gebäude in der Gemeinde Dießen, das zur Unterbringung von Asylbewerbern genutzt wurde: Zwölf Geflüchtete bezogen dort im Februar 2014 Quartier."
                            },
                            {
                                "example_id": "949c5ca9-7b8e-4bf1-8df1-4140f3c35fa6",
                                "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                                "text": "Ein Besuch am Halleiner Advent im alten Forsthaus trägt dazu bei, dass direkt und unkompliziert Projekte und Menschen im Tennengau unterstützt werden können."
                            },
                            {
                                "example_id": "4ba6e5d1-dae3-45e9-958d-a4221263ffaf",
                                "sense_id": "da623fe1-cd94-3166-9154-f7ad44206813",
                                "text": "Der Haupttäter, ein 56-jähriger Wiener, sowie seine 48-jährige Komplizin aus dem NÖ-Bezirk Tulln hatten in einem Forsthaus südlich von Mariazell jahrelang Cannabis im großen Stil angebaut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
