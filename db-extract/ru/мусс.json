                                        "entry_id": "fdaaca7b-5814-3af5-8ff9-bc404b4148ba",
                                        "glosses": [
                                            "mittels Kochen erzeugte feine, cremig bis zähflüssige Konsistenz von, oftmals zuvor zerkleinertem, Obst oder auch Kartoffeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd02c57-0e8b-4d6f-a863-85739d79550f",
                                                "sense_id": "c0feb86a-2340-388f-839a-5070cc28e403",
                                                "text": "Ich esse gern Reis mit Apfelmus, aber das Mus muss noch Stückchen enthalten."
                                            },
                                            {
                                                "example_id": "ec2699dc-fc9d-4497-a7c6-054b3e32d945",
                                                "sense_id": "c0feb86a-2340-388f-839a-5070cc28e403",
                                                "text": "Der Kleine kriegt ein Mus aus Birne und Erdbeeren."
                                            }
                                        ],
