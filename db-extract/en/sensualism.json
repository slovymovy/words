                "senses": [
                    {
                        "sense_id": "73cf4049-63bf-3602-a68d-adfdb193817f",
                        "entry_id": "146c5dcc-5043-372e-8f1f-10aaeb41afc6",
                        "glosses": [
                            "Addiction to or obsession with sensual pleasures or affairs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "74144aae-6ed9-3bbd-b8e0-8ea55efd6e77",
                        "entry_id": "146c5dcc-5043-372e-8f1f-10aaeb41afc6",
                        "glosses": [
                            "The doctrine that gratification of the senses is the highest good."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c18e086e-1ef0-3383-abb4-58b35c40a96c",
                        "entry_id": "146c5dcc-5043-372e-8f1f-10aaeb41afc6",
                        "glosses": [
                            "The doctrine that all knowledge not only originates in sensation, but are transformed sensations, copies or relics of sensations; sensationalism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9aec57e4-3a47-41d7-96f7-c451e86693e2",
                                "sense_id": "c18e086e-1ef0-3383-abb4-58b35c40a96c",
                                "text": "1858, The Atlantic Monthly, Volume 2, No. 1, Gottfried Wilhem von Leibnitz,\nHe [Locke] repudiated any supposed dowry of original truths or innate or connate ideas, and endeavored to show how, by acting on the report of the senses and personal experience, the understanding arrives at all the ideas of which it is conscious. The mode of procedure in this case is empiricism; the result with Locke was sensualism,--more fully developed by Condillac, [18] in the next century."
                            },
                            {
                                "example_id": "d8129473-f818-4854-a62f-b39011040447",
                                "sense_id": "c18e086e-1ef0-3383-abb4-58b35c40a96c",
                                "text": "For Sensualism the only source of human knowledge is sensation: everything reduces to transformed sensations."
                            }
                        ]
                    },
                    {
                        "sense_id": "05c181a1-28f3-3aa2-9bd7-37c0110aac36",
                        "entry_id": "146c5dcc-5043-372e-8f1f-10aaeb41afc6",
                        "glosses": [
                            "A sensual style or aesthetic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b57c534f-adc1-4fc0-a7b5-c2805c5e5240",
                        "source_entry_id": "146c5dcc-5043-372e-8f1f-10aaeb41afc6",
