                        "examples": [
                            {
                                "example_id": "c4cb9f93-23e0-4105-9dca-00950e781b43",
                                "sense_id": "8299e342-2672-379b-9c5c-61687161e407",
                                "text": "„Allein die Einnahmen aus dem Erdölverkauf deckten die gesamten Kosten des Krieges.“"
                            },
                            {
                                "example_id": "254859ee-a879-4e7b-97d5-ef28bfd73caa",
                                "sense_id": "8299e342-2672-379b-9c5c-61687161e407",
                                "text": "„Er nahm besorgt den Sparhaushalt des Südsudans und dessen Versuche zum Ausgleich des Öffentlichen Haushalts zur Kenntnis und unterstrich die Wichtigkeit der Erdölverkäufe für dessen Wirtschaft.“"
                            }
                        ],
