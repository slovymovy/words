                    {
                        "sense_id": "fd3fd324-9958-312e-804f-35ae63f9d8d7",
                        "entry_id": "bbc08f03-a7e6-337a-80c3-77e72c7b66cf",
                        "glosses": [
                            "wat groter is dan wat op grond van de toevallige fout verwacht kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51eade7-d330-4e94-a6f9-a433e83996d4",
                                "sense_id": "fd3fd324-9958-312e-804f-35ae63f9d8d7",
                                "text": "Gewoonlijk neemt men een zekerheid van 95% als grens bij het bepalen van wat men significant noemt of niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02c90183-f89c-4cf8-9002-c34f21b5fa8b",
                        "source_entry_id": "bbc08f03-a7e6-337a-80c3-77e72c7b66cf",
                        "source_sense_id": "c7360613-7885-3992-a67a-82f7094a13ed",
                        "source_sense_description": "belangrijk",
                        "target_lang_word": "signifikant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signifikant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad18df34-363e-3439-915c-ce8068abe21f",
                                        "entry_id": "6ab70f1d-0ff5-38a0-9f85-19f6cc493e41",
                                        "glosses": [
                                            "in deutlicher Weise als wesentlich, wichtig, bedeutend, erheblich, erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f349d0-a0d0-498e-899a-3de802e1575e",
                                                "sense_id": "ad18df34-363e-3439-915c-ce8068abe21f",
                                                "text": "Die letzten Wahlen erbrachten signifikante Mehrheitsverhältnisse."
                                            },
                                            {
                                                "example_id": "e18ecb1e-ce5d-4561-a09e-b74c762961e0",
                                                "sense_id": "ad18df34-363e-3439-915c-ce8068abe21f",
                                                "text": "Die finanziellen Einbrüche der Banken sind signifikant."
                                            },
                                            {
                                                "example_id": "fc7f2404-ff98-4ec6-afd7-188bd56e3293",
                                                "sense_id": "ad18df34-363e-3439-915c-ce8068abe21f",
                                                "text": "„Signifikant unterscheiden sich die Reden von Merkel und Steinmeier auch in der Verwendung von deiktischen Ausdrücken.“"
                                            },
                                            {
                                                "example_id": "a4314809-1b2b-4f9e-a203-7deeaf7eaabd",
                                                "sense_id": "ad18df34-363e-3439-915c-ce8068abe21f",
                                                "text": "„Signifikant hoch ist die Geburtenrate im September.“"
                                            },
                                            {
                                                "example_id": "eb6d528d-0d4c-4241-8e95-e20cee358f1d",
                                                "sense_id": "ad18df34-363e-3439-915c-ce8068abe21f",
                                                "text": "[Zemantproduktion:] „Mit einem Ausstoß von 800.000 Tonnen CO₂ pro Jahr leistet Heidelberg Materials einen signifikanten Beitrag zur Klimabelastung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3a35fdb-690c-330a-bbf0-d0bf7e616c43",
                                        "entry_id": "6ab70f1d-0ff5-38a0-9f85-19f6cc493e41",
                                        "glosses": [
                                            "unwahrscheinlich, dass ein derartiges Ergebnis durch Zufall zustande gekommen ist (siehe auch: Signifikanz)"
                                        ],
                                        "tags": [
                                            "Statistik",
                                            "Ergebnisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb39de0-6378-44d5-b534-b7c87d2ecd28",
                                                "sense_id": "c3a35fdb-690c-330a-bbf0-d0bf7e616c43",
                                                "text": "Es muss genau festgelegt werden, unter welchen Bedingungen ein Ergebnis als signifikant zu bewerten ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b8afc593-ab41-3ffc-9c88-8b58e47c9d09",
                                        "entry_id": "6ab70f1d-0ff5-38a0-9f85-19f6cc493e41",
                                        "glosses": [
                                            "eher signifikativ"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft (selten)"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10fdb0ee-120c-47cc-9044-f99fdc99bf0d",
                        "source_entry_id": "bbc08f03-a7e6-337a-80c3-77e72c7b66cf",
                        "source_sense_id": "c7360613-7885-3992-a67a-82f7094a13ed",
