{
    "word_family": [
        "commande",
        "commandement",
        "commander",
        "commanditaire",
        "commanditer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae7d7b58-e72c-3c89-9842-2f2d9976d905",
                    "sense_definition": "Personne qui exerce la direction ou le commandement d'un navire, d'un aéronef ou d'une formation militaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>commandant</w> de bord a annoncé que l'avion allait bientôt atterrir."
                        },
                        {
                            "text": "Tous les marins écoutent attentivement les ordres donnés par leur <w>commandant</w>."
                        }
                    ],
                    "synonyms": [
                        "capitaine",
                        "chef"
                    ],
                    "common_phrases": [
                        "commandant de bord"
                    ]
                },
                {
                    "sense_id": "62866039-2335-3264-ac07-fa75deceae5a",
                    "sense_definition": "Grade d'officier supérieur dans l'armée, situé entre capitaine et lieutenant-colonel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de service, cet officier a été promu au grade de <w>commandant</w>."
                        },
                        {
                            "text": "Le <w>commandant</w> a réuni les capitaines pour préparer la prochaine mission sur le terrain."
                        }
                    ],
                    "common_phrases": [
                        "grade de commandant"
                    ]
                },
                {
                    "sense_id": "6a85f3fd-7536-3365-ac6c-a31fe0e96a18",
                    "sense_definition": "Grade d'officier dans la police, situé hiérarchiquement sous un commissaire et au-dessus d'un capitaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>commandant</w> de police dirige l'enquête sur le cambriolage du grand musée."
                        },
                        {
                            "text": "Plusieurs inspecteurs rendent compte directement à la <w>commandante</w> chaque matin."
                        }
                    ],
                    "common_phrases": [
                        "commandant de police"
                    ]
                },
                {
                    "sense_id": "fb2bc197-5fda-3c83-ae8d-04be13004467",
                    "sense_definition": "Grade d'officier supérieur dans certains services civils, notamment chez les sapeurs-pompiers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>commandant</w> des sapeurs-pompiers coordonne les secours lors du violent incendie."
                        },
                        {
                            "text": "Cette officière est la première femme promue <w>commandante</w> dans cette caserne."
                        }
                    ],
                    "common_phrases": [
                        "commandant des sapeurs-pompiers"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4abab123-4025-3526-9a74-52a197e7c41c",
                    "sense_definition": "Participe présent du verbe <w>commander</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>commandant</w> son repas au serveur, il a précisé toutes ses allergies alimentaires."
                        },
                        {
                            "text": "Il est entré dans la pièce en <w>commandant</w> le silence absolu à tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "en commandant"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cba900a6-a5ab-32ae-bada-8f95ae4bf2bf",
                    "sense_definition": "Qui exerce effectivement le commandement d'une troupe ou d'une place militaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'officier <w>commandant</w> a immédiatement ordonné le repli stratégique de ses troupes."
                        },
                        {
                            "text": "Le général a désigné un capitaine <w>commandant</w> pour superviser la garnison."
                        }
                    ],
                    "common_phrases": [
                        "capitaine commandant",
                        "officier commandant"
                    ]
                }
            ]
        }
    ]
}