                        "sense_id": "08f28486-1379-3277-b985-65cc914b5eae",
                        "entry_id": "fe4673d2-90ba-3742-b5a1-d184c50db944",
                        "glosses": [
                            "Bref, pour résumer en peu de mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814a9f1b-17e5-4f2a-853f-ddb20509831c",
                                "sense_id": "08f28486-1379-3277-b985-65cc914b5eae",
                                "text": "Wegen fehlender Dokumente konnte ich bei der Botschaft keines Visum erhalten. Kurzum: reiner Zeitverlust!",
                                "translation": "À cause de documents manquants, je n'ai pas pu obtenir le visa à l'ambassade. Bref, une pure perte de temps !"
                            }
                        ]
                    }
                ],
