{
    "word_family": [
        "intricacy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90e8884b-2003-3423-9541-6c4911f5b2e0",
                    "sense_definition": "Having a great deal of fine detail or complexity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The watchmaker spent hours working on the <w>intricate</w> gears of the clock.",
                            "target_lang_translations": {
                                "zh": "钟表匠花了几个小时修理钟表里<w>复杂</w>的齿轮。",
                                "tr": "Saat ustası, saatin <w>karmaşık</w> dişlileri üzerinde çalışarak saatler harcadı."
                            }
                        },
                        {
                            "text": "She admired the <w>intricate</w> patterns on the handmade rug.",
                            "target_lang_translations": {
                                "zh": "她赞叹手工地毯上<w>精细</w>的图案。",
                                "tr": "El yapımı halıdaki <w>ince işçilikli</w> desenlere hayran kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "fancy"
                    ],
                    "common_phrases": [
                        "intricate design",
                        "intricate pattern",
                        "intricate detail"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物包含许多精细的细节或结构复杂。",
                        "tr": "Çok sayıda ince detay veya karmaşık bir yapıya sahip olma durumu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "指结构或构成要素繁多。"
                            },
                            {
                                "target_lang_word": "精细",
                                "target_lang_sense_clarification": "指细节处理得非常细致。"
                            },
                            {
                                "target_lang_word": "错综复杂",
                                "target_lang_sense_clarification": "形容交错综合，非常复杂。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karmaşık",
                                "target_lang_sense_clarification": "Yapısı veya bileşenleri çok sayıda olan durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "ince işçilikli",
                                "target_lang_sense_clarification": "Detayların çok özenli ve detaylı işlendiği durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "detaylı",
                                "target_lang_sense_clarification": "Çok fazla ayrıntı içeren nesneler veya tasarımlar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f967af80-c788-32eb-95f6-64b9bbd741e6",
                    "sense_definition": "Difficult to understand, solve, or resolve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective faced an <w>intricate</w> mystery that took weeks to solve.",
                            "target_lang_translations": {
                                "zh": "侦探面对一个花了数周才解开的<w>复杂</w>谜团。",
                                "tr": "Dedektif, çözülmesi haftalar süren <w>çetrefilli</w> bir gizemle karşı karşıyaydı."
                            }
                        },
                        {
                            "text": "He explained the <w>intricate</w> legal process in simple terms for the client.",
                            "target_lang_translations": {
                                "zh": "他用简单的语言为客户解释了<w>复杂</w>的法律程序。",
                                "tr": "Müvekkili için <w>karmaşık</w> hukuki süreci basit terimlerle açıkladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intricate problem",
                        "intricate system"
                    ],
                    "target_lang_definitions": {
                        "zh": "指难以理解、解决或理清。",
                        "tr": "Anlaşılması, çözülmesi veya sonuçlandırılması zor olan durumlar."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "指问题或过程难以处理。"
                            },
                            {
                                "target_lang_word": "深奥",
                                "target_lang_sense_clarification": "指道理或内容难以理解。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karmaşık",
                                "target_lang_sense_clarification": "Çözülmesi veya takip edilmesi zor olan süreçler veya problemler için kullanılır."
                            },
                            {
                                "target_lang_word": "çetrefilli",
                                "target_lang_sense_clarification": "İçinden çıkılması zor, karışık durumlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b3adfbc-0b78-323d-81a7-8fb5d35f0e41",
                    "sense_definition": "To become enmeshed or entangled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entanglement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long hair began to <w>intricate</w> in the brush bristles.",
                            "target_lang_translations": {
                                "zh": "长发开始在梳齿间<w>纠缠</w>在一起。",
                                "tr": "Uzun saçlar fırça kıllarına <w>dolanmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Loose threads will <w>intricate</w> if not trimmed properly.",
                            "target_lang_translations": {
                                "zh": "如果不及时修剪，松散的线头就会<w>缠绕</w>在一起。",
                                "tr": "Gevşek iplikler düzgün kesilmezse <w>birbirine girecektir</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "extricate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指变得纠缠在一起。",
                        "tr": "Birbirine dolanmak veya karışmak."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纠缠",
                                "target_lang_sense_clarification": "指物体或线状物缠绕在一起。"
                            },
                            {
                                "target_lang_word": "缠绕",
                                "target_lang_sense_clarification": "指绕在某物上或互相缠绕。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dolanmak",
                                "target_lang_sense_clarification": "İp veya saç gibi şeylerin birbirine karışması durumu."
                            },
                            {
                                "target_lang_word": "birbirine girmek",
                                "target_lang_sense_clarification": "Nesnelerin karmaşık bir şekilde birbirine geçmesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e7b2379-ff88-3766-b959-0331bab124bb",
                    "sense_definition": "To cause to become enmeshed or entangled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entanglement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy will <w>intricate</w> the military in a long conflict.",
                            "target_lang_translations": {
                                "zh": "这项新政策将使军队<w>卷入</w>一场长期的冲突中。",
                                "tr": "Yeni politika, orduyu uzun süreli bir çatışmaya <w>sürükleyecek</w>."
                            }
                        },
                        {
                            "text": "Do not <w>intricate</w> yourself in their personal arguments.",
                            "target_lang_translations": {
                                "zh": "不要让自己<w>卷入</w>他们的个人争吵中。",
                                "tr": "Kendini onların kişisel tartışmalarına <w>bulaştırma</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "extricate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指使陷入纠纷或困境中。",
                        "tr": "Birini veya bir şeyi karmaşık bir duruma veya çatışmaya sürüklemek."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卷入",
                                "target_lang_sense_clarification": "指被牵扯进某事或冲突中。"
                            },
                            {
                                "target_lang_word": "牵连",
                                "target_lang_sense_clarification": "指使人陷入某种不利的境地。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bulaştırmak",
                                "target_lang_sense_clarification": "Birini istenmeyen bir olaya veya duruma dahil etmek."
                            },
                            {
                                "target_lang_word": "sürüklemek",
                                "target_lang_sense_clarification": "Birini zor bir durumun veya çatışmanın içine çekmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}