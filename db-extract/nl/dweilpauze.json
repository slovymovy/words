                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b66931f-9ab2-42ad-b3ae-a89e74a8eade",
                                "sense_id": "13a5c5b9-ecef-3c67-8946-9f7301dfd364",
                                "text": "Verweij neemt het in de zestiende rit op tegen de Noor Allan Dahl Johannson. Ook Verweij begint in de buitenbaan. Beide Nederlandse favorieten komen na de dweilpauze in actie."
                            },
                            {
                                "example_id": "a06974a0-3b1a-49a8-ba3b-6057bd333833",
                                "sense_id": "13a5c5b9-ecef-3c67-8946-9f7301dfd364",
                                "text": "Zijn voornaamste concurrenten rijden in de ritten voor hem. Titelhouder Jorrit Bergsma komt na de dweilpauze in actie tegen de Italiaan Ghiotto en een rit later start wereldrecordhouder Ted-Jan Bloemen tegen Nicola Tumolero, ook uit Italië."
                            }
