    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1361d97f-ddfe-3b90-bc74-b7d49b705fec",
                    "sense_definition": "Fait d'accorder ou d'abandonner quelque chose à quelqu'un dans un débat ou un conflit afin de parvenir à un accord.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux parties ont dû faire une <w>concession</w> importante pour signer le contrat."
                        },
                        {
                            "text": "Le directeur refuse toute <w>concession</w> tant que la grève se poursuit."
                        }
                    ],
                    "synonyms": [
                        "compromis",
                        "accord"
                    ],
                    "antonyms": [
                        "intransigeance",
                        "refus"
                    ],
                    "common_phrases": [
                        "faire des concessions",
                        "obtenir des concessions",
                        "sans concession"
                    ]
                },
                {
                    "sense_id": "c97101b3-c665-3cde-a3a9-238820818c58",
                    "sense_definition": "Droit ou privilège accordé par une collectivité ou une entreprise d'exploiter un service ou de distribuer des produits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La commune a accordé la <w>concession</w> du réseau de transports publics à une société privée."
                        },
                        {
                            "text": "Il s'est rendu dans une <w>concession</w> pour faire réparer son véhicule."
                        }
                    ],
                    "synonyms": [
                        "octroi",
                        "privilège"
                    ],
                    "common_phrases": [
