                        "glosses": [
                            "officiële bijeenkomst in de avonduren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74531fe-59fb-4ccd-b70a-a338d51f2910",
                                "sense_id": "32b01440-290b-3584-8f87-a928c54172f4",
                                "text": "Na afloop van het vragenuurtje laste Van Rompuy een schorsing in. Toen de Kamerleden aan de avondzitting begonnen - met de start van het debat over de programmawet - probeerde Vlaams Belang-fractieleider Gerolf Annemans nog eens om een stemming te forceren over de CD&V-motie."
                            }
                        ]
