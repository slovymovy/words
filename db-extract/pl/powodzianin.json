                "translations": [
                    {
                        "translation_id": "cf869b99-1891-44c1-aa80-d53de56bbad3",
                        "source_entry_id": "9902ce12-990c-34f2-b380-e1fc3d41759a",
                        "source_sense_id": "dad58da4-7e2d-3f52-b5cc-39893e79290a",
                        "target_lang_word": "flood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1a917c5-726e-3921-8b5b-6e8c442f683c",
                                        "entry_id": "d3c99173-f604-3619-9ea1-947f49a6a09b",
                                        "glosses": [
                                            "An overflow of a large amount of water (usually disastrous) from a lake or other body of water due to excessive rainfall or other input of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd4340e-7803-4dd1-9231-f87cd23edd03",
                                                "sense_id": "c1a917c5-726e-3921-8b5b-6e8c442f683c",
                                                "text": "a covenant never to destroy the earth again by flood"
                                            },
                                            {
                                                "example_id": "8ac2d28a-561a-4421-aa02-d27a1b4b0cae",
                                                "sense_id": "c1a917c5-726e-3921-8b5b-6e8c442f683c",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations."
                                            },
                                            {
                                                "example_id": "84eab3e4-777b-49c4-a7ee-99a281b1d378",
                                                "sense_id": "c1a917c5-726e-3921-8b5b-6e8c442f683c",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            },
                                            {
                                                "example_id": "4a361d73-4c90-4e5f-9632-c5b240550f02",
                                                "sense_id": "c1a917c5-726e-3921-8b5b-6e8c442f683c",
                                                "text": "China's Ministry of Water Resources Saturday warned that floods are expected to hit the country and called on relevant departments to make preparation.\nHeavy rains have hit parts of southern, eastern and central China since Wednesday, pushing water levels in some rivers well above warning lines, the ministry said.\nChina entered its flood season on Saturday, four days earlier than previous years, and the country may suffer from more and stronger rain as well as floods with more extreme weather forecast for the flood season, the ministry warned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52cbfb86-7382-3830-a684-2cd002c905cc",
                                        "entry_id": "d3c99173-f604-3619-9ea1-947f49a6a09b",
                                        "glosses": [
                                            "A large number or quantity of anything appearing more rapidly than can easily be dealt with."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3ace4c4-124d-469e-8c21-cc7982c1b68f",
                                                "sense_id": "52cbfb86-7382-3830-a684-2cd002c905cc",
                                                "text": "a flood of complaints"
                                            },
                                            {
                                                "example_id": "73b09408-e458-4677-b9f3-28eebaa22f7d",
                                                "sense_id": "52cbfb86-7382-3830-a684-2cd002c905cc",
                                                "text": "Deregulation of financial markets laid the groundwork for the subprime crisis in the United States, while a badly designed euro contributed to the debt crisis in Greece, and the Schengen system of open borders made it difficult to control the flood of refugees in Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0979bb17-ce21-39c2-bf9f-e097804e88e0",
                                        "entry_id": "d3c99173-f604-3619-9ea1-947f49a6a09b",
                                        "glosses": [
                                            "The flowing in of the tide, opposed to the ebb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d69a0e-660f-4220-bdeb-4de7f4808fec",
                                                "sense_id": "0979bb17-ce21-39c2-bf9f-e097804e88e0",
                                                "text": "There is a tide in the affairs of men, / Which, taken at the flood, leads on to fortune."
                                            },
                                            {
                                                "example_id": "b7059852-1b27-4870-8efd-ebbc3c907a4e",
                                                "sense_id": "0979bb17-ce21-39c2-bf9f-e097804e88e0",
                                                "text": "It was ebb tide when she touched, and it was supposed that when the flood made she would float off again."
                                            },
                                            {
                                                "example_id": "6f64ee30-a8e4-4c0d-8299-3d2028099d66",
                                                "sense_id": "0979bb17-ce21-39c2-bf9f-e097804e88e0",
                                                "text": "The flood had made, the wind was nearly calm, and being bound down the river, the only thing for us was to come to and wait for the turn of the tide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df510aa-c76b-317e-a2c2-b96e342a3ad2",
                                        "entry_id": "d3c99173-f604-3619-9ea1-947f49a6a09b",
                                        "glosses": [
                                            "A floodlight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "417d0d25-96c0-3fa5-a205-c3a890c8bc1c",
                                        "entry_id": "d3c99173-f604-3619-9ea1-947f49a6a09b",
                                        "glosses": [
                                            "Menstrual discharge; menses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02444c8e-c856-3c7e-96df-cb72b61a7aab",
                                        "entry_id": "d3c99173-f604-3619-9ea1-947f49a6a09b",
                                        "glosses": [
                                            "Water as opposed to land."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13fcfa0-3c82-40e2-b428-2614ae12e95b",
                                                "sense_id": "02444c8e-c856-3c7e-96df-cb72b61a7aab",
                                                "text": "Who beheld from the safe shore their floating carcasses and broken chariot-wheels. So thick bestrown, abject and lost, lay these, covering the flood, under amazement of their hideous change."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4c8225-6114-379b-bd20-1bf94582adf9",
                                        "entry_id": "a8d94c83-0a8f-33fd-a51d-0bff85646de6",
                                        "glosses": [
                                            "To overflow, as by water from excessive rainfall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c68cb254-8e11-414d-8676-807094865d56",
                                                "sense_id": "bc4c8225-6114-379b-bd20-1bf94582adf9",
                                                "text": "People flooded into the streets in protest."
                                            },
                                            {
                                                "example_id": "bd6e8388-3c91-421c-9c06-bd691acfe991",
                                                "sense_id": "bc4c8225-6114-379b-bd20-1bf94582adf9",
                                                "text": "The basement flooded with rainwater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef1551e-148c-378d-8c8b-0d427003127c",
                                        "entry_id": "a8d94c83-0a8f-33fd-a51d-0bff85646de6",
                                        "glosses": [
                                            "To cover or partly fill as if by a flood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ee5b05-34d0-4d21-8e3d-3668779c0b54",
                                                "sense_id": "6ef1551e-148c-378d-8c8b-0d427003127c",
                                                "text": "The floor was flooded with beer."
                                            },
                                            {
                                                "example_id": "1a77a0e0-c336-4d4b-a03a-122a5ababa4d",
                                                "sense_id": "6ef1551e-148c-378d-8c8b-0d427003127c",
                                                "text": "They flooded the room with sewage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec4cfa6b-4c4e-3c9a-adb1-8835be216bc5",
                                        "entry_id": "a8d94c83-0a8f-33fd-a51d-0bff85646de6",
                                        "glosses": [
                                            "To provide (someone or something) with a larger number or quantity of something than can easily be dealt with."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e554b17-af91-4439-8fe3-cedb524f3fe3",
                                                "sense_id": "ec4cfa6b-4c4e-3c9a-adb1-8835be216bc5",
                                                "text": "The station's switchboard was flooded with listeners making complaints."
                                            },
                                            {
                                                "example_id": "08b16027-bde0-4582-9237-a03b72abf54e",
                                                "sense_id": "ec4cfa6b-4c4e-3c9a-adb1-8835be216bc5",
                                                "text": "Blackburn offered nothing going forward in the opening period and that continued after the break, encouraging City to flood forward."
                                            },
                                            {
                                                "example_id": "4d2c799d-5daf-473c-aeb1-6bd66350a7af",
                                                "sense_id": "ec4cfa6b-4c4e-3c9a-adb1-8835be216bc5",
                                                "text": "The iconic Glenfinnan Viaduct was flooded with blue light to show support for the National Health Service staff treating Coronavirus patients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b37bb6b-0d57-3b37-8f42-99b2483d21a1",
                                        "entry_id": "a8d94c83-0a8f-33fd-a51d-0bff85646de6",
                                        "glosses": [
                                            "To paste numerous lines of text to (a chat system) in order to disrupt the conversation."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb3f531-821b-4ae1-a879-d4369ee6ff75",
                                                "sense_id": "9b37bb6b-0d57-3b37-8f42-99b2483d21a1",
                                                "text": "There's also a spam filter in the code now, so if someone attempts to flood people's screens with macros or a bot, everything after the first few lines is thrown away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0e42e3-f6c7-3565-bf3e-15f27cd3d069",
                                        "entry_id": "a8d94c83-0a8f-33fd-a51d-0bff85646de6",
                                        "glosses": [
                                            "To bleed profusely, as after childbirth."
                                        ],
