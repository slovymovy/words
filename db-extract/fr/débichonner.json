                "senses": [
                    {
                        "sense_id": "ad7a7181-74ca-3a82-a1df-cbdd9de4524d",
                        "entry_id": "a0ffb8a8-e1a4-3372-873b-c32731ca40d9",
                        "glosses": [
                            "Revenir à son état normal après avoir été transformé en biche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5806bb66-f005-4e03-9e0f-bc238a4b258d",
                                "sense_id": "ad7a7181-74ca-3a82-a1df-cbdd9de4524d",
                                "text": "L’heure de se débichonner étant arrivée, la belle princesse reprit sa forme ordinaire."
                            },
                            {
                                "example_id": "39f86103-18d4-4ff1-857b-06b8cb280fde",
                                "sense_id": "ad7a7181-74ca-3a82-a1df-cbdd9de4524d",
                                "text": "En miroir de ces archaïsmes, des néologismes forgés par l’autrice viennent opportunément nommer les éléments merveilleux du conte : les personnages peuvent se débichonner ou se dégrillonner, telle créature magique se révèle étranglable, souriquoise ou encore ratonienne."
                            },
                            {
                                "example_id": "e2ccaafd-34f4-4cea-8f7b-024cf16131b2",
                                "sense_id": "ad7a7181-74ca-3a82-a1df-cbdd9de4524d",
                                "text": "Et la princesse changée en biche, elle se \"débichonne\" quand elle reprend forme humaine !"
                            }
                        ]
                    }
                ],
