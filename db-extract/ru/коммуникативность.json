                                "target_senses": [
                                    {
                                        "sense_id": "ed74af17-2bf3-3644-ac59-9b37ac556a1c",
                                        "entry_id": "6cdd86dd-a2cb-32a1-9412-e64410520d70",
                                        "glosses": [
                                            "The state or quality of being communicative."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f23943b-8bd6-42cf-8e02-c951b547d818",
                                                "sense_id": "ed74af17-2bf3-3644-ac59-9b37ac556a1c",
                                                "text": "Her brief spurt of communicativeness lapsed suddenly, as if these market-values of her goods might be telling too much about herself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
