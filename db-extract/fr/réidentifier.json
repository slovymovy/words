                        "glosses": [
                            "Retrouver l'identité réelle de la personne dont proviennent des données anonymées ou pseudonymisées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d889cbf9-af3e-4c9c-891b-c4878db4a16b",
                                "sense_id": "c6aef562-c6bc-321d-b311-4f19b78a2dbd",
                                "text": "Dans la poursuite de ces travaux et afin de sensibiliser les personnes aux risques pour leur vie privée, le Laboratoire d’innovation numérique de la CNIL montre comment il est techniquement possible de remonter la piste des données d’un internaute pour le réidentifier et d’apprendre beaucoup de choses à son sujet."
                            }
                        ]
                    },
                    {
                        "sense_id": "17d4b921-4a62-3c03-ac25-e5842d1ad38f",
