                        "source_sense_id": "58150952-a6cd-36c0-b68b-0cd98fa0c607",
                        "target_lang_word": "επαναφορά",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "επαναφορά",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "116dedeb-46f4-3c40-931c-c4d261f0e00a",
                                        "entry_id": "815254b8-9f88-36ba-b105-607e362a93e3",
                                        "glosses": [
                                            "η επιστροφή σε μια προηγούμενη κατάσταση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3feed1b-ab8f-4dfe-a187-57b0c689c271",
                                                "sense_id": "116dedeb-46f4-3c40-931c-c4d261f0e00a",
                                                "text": "※ Ζητοῦν μιὰν οἰαδήποτε λύση γιὰ τὴν επαναφορά τοῦ τόπου σὲ μιὰ σταθερὴ κατάσταση. (Περικλής Βυζάντιος 1893- 1972, Ἡ ζωὴ ἑνὸς ζωγράφου, Αθήνα 1994)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9441f91-815d-3928-b3ec-5d0c8ccf9138",
                                        "entry_id": "815254b8-9f88-36ba-b105-607e362a93e3",
                                        "glosses": [
                                            "η συνεχής επανάληψη της ίδιας λέξης, φράσης ή θέματος"
                                        ],
                                        "tags": [
                                            "σχήμα λόγου"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e575823b-4a02-4503-860c-56f7dbdbbf53",
                                                "sense_id": "f9441f91-815d-3928-b3ec-5d0c8ccf9138",
                                                "text": "Η επαναφορά του ίδιου θέματος στη Βουλή καταντάει κακοστημένο θέατρο."
                                            },
                                            {
                                                "example_id": "32097c86-de2a-471d-95fc-26107171c562",
                                                "sense_id": "f9441f91-815d-3928-b3ec-5d0c8ccf9138",
                                                "text": "Η επαναφορά του «Όλα στο φως». (Τίτλος άρθρου στο διαδίκτυο)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59005457-cfc7-382e-86e2-3ff87738c68e",
                                        "entry_id": "815254b8-9f88-36ba-b105-607e362a93e3",
                                        "glosses": [
                                            "η κατεργασία βαμμένων μετάλλων με αναθέρμανση, για να μαλακώσουν"
                                        ],
                                        "tags": [
                                            "επιστήμη"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7028cd0-1287-4703-9c81-bb59acd7a67a",
                                                "sense_id": "59005457-cfc7-382e-86e2-3ff87738c68e",
                                                "text": "Κατά την επαναφορά του χάλυβα, μειώνονται οι εσωτερικές τάσεις που προκάλεσε η βαφή."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e341b0-c91f-3e9a-bf3d-96cb16a2cabb",
                                        "entry_id": "815254b8-9f88-36ba-b105-607e362a93e3",
                                        "glosses": [
                                            "return: το πλήκτρο της επιστροφής του κυλίνδρου της γραφομηχανής (γνωστό παλιότερα και ως ἐπαναφορεύς), καθώς και το πλήκτρο της επιστροφής στην αρχή της γραμμής στον υπολογιστή (πιο γνωστό με τον αγγλικό όρο return)"
                                        ],
                                        "tags": [
                                            "πληροφορική"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29b89269-af00-3640-9fe3-dce3051c038d",
                                        "entry_id": "815254b8-9f88-36ba-b105-607e362a93e3",
                                        "glosses": [
                                            "revert: η επιστροφή λογισμικού ή γενικότερα δεδομένων σε προηγούμενη κατάσταση, όπως στην περίπτωση των συναλλαγών (transactions) σε βάσεις δεδομένων ή στις αναθεωρήσεις σε ένα σύστημα ελέγχου πηγαίου κώδικα (source control)"
                                        ],
                                        "tags": [
                                            "πληροφορική"
                                        ],
