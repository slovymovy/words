                ],
                "senses": [
                    {
                        "sense_id": "b4551d54-4a7c-3c52-9209-ec6f8f5ddfb7",
                        "entry_id": "b8856e12-d090-3c6c-91e2-2a186f98895b",
                        "glosses": [
                            "Unité de mesure de longueur (symbole arp) valant 180 pieds ou 10 perches."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                        "entry_id": "b8856e12-d090-3c6c-91e2-2a186f98895b",
                        "glosses": [
                            "Unité de mesure de la surface d’une terre qui valait un arpent carré, soit cent perches carrées, c'est à dire 0,51 hectare."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b15659c6-5c52-4e13-9377-91ddd2983f8d",
                                "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                                "text": "Quatre femmes peuvent semer un arpent ou un demi-hectare chaque jour."
                            },
                            {
                                "example_id": "cee9e6ea-02a9-4c76-930a-b29155c220e9",
                                "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                                "text": "ARPENT, en allemand et en hollandais morgen, en italien jugero, en espagnol yugada. Mesure agraire ou de superficie. On donne aussi le nom d’arpent à l’acre de Gotha."
                            },
                            {
                                "example_id": "3e928db6-c6bf-4f7b-8b98-3c4316103400",
                                "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                                "text": "Les deux ou trois mille arpents de terre qui forment son exploitation présentent une vaste plaine presque entièrement entourée de bois."
                            },
                            {
                                "example_id": "e5b42c8a-baca-4e7d-954e-41b37d2bb8e5",
                                "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                                "text": "Il exploitait cent arpents de vignes, qui , dans les années plantureuses, lui donnaient sept à huit cents poinçons de vin."
                            },
                            {
                                "example_id": "b621e96a-03cb-4669-930a-31c4094394bc",
                                "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                                "text": "Il y avait en outre, au finage de Launay, au lieu dit Vauvagis, 400 arpents de bois que divers habitants de Barrault, tenaient à bail emphytéotique de la commanderie, moyennant la redevance annuelle d’un bichet de blé, d’un bichet d’avoine, et d’un denier par chaque arpent."
                            },
                            {
                                "example_id": "ab26aed0-2edb-47bd-9dbd-c746fe524bf3",
                                "sense_id": "03cc6fbe-0a6e-3708-ba57-cc4a828b3443",
                                "text": "Oh ! une vraie cabane ! […] mais avec un bon demi-arpent de jardin."
                            }
                        ]
                    },
                    {
                        "sense_id": "863255ac-10f5-36c3-8dda-bff8b147f208",
                        "entry_id": "b8856e12-d090-3c6c-91e2-2a186f98895b",
                        "glosses": [
                            "Unité de longueur valant 58,47 mètres. Unité de surface équivalant à 3418,89 m² c'est à dire 0,342 hectare."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "957501c2-b2d2-34a0-9a21-d59c7871a0c2",
                        "entry_id": "b8856e12-d090-3c6c-91e2-2a186f98895b",
                        "glosses": [
                            "Unité de surface équivalant à 3424,77 m² c'est à dire 0,342 hectare."
