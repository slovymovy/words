                ],
                "senses": [
                    {
                        "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                        "entry_id": "a7a15837-f105-358b-a877-f85ad14ae15d",
                        "glosses": [
                            "mit einem Gewicht von bis zu sechzehn Kilogramm einer der schwersten flugfähigen Vögel der Welt mit einem braun gescheckten Gefieder und kräftigen Beinen (Otis tarda)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30bf2855-686b-4dee-ab07-8a2132d90f81",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "Großtrappen sind in Mitteleuropa vom Aussterben bedroht."
                            },
                            {
                                "example_id": "bc58ed60-ea30-459e-b675-ebe56faa9ea8",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Der Großtrappe oder die Trappgans (Otis tarda), welchen man wohl auch ‚europäiſchen Strauß‘ zu nennen beliebt hat, wurde neuerdings zum Vertreter einer eigenen Sippe erhoben, als deren wichtigſtes Merkmal der aus langen, mit ſchmalen Fahnen beſetzten Federn beſtehende Kinnbart des Männchens angeſehen werden muß, da dieſer andern Arten der Familie fehlt.“"
                            },
                            {
                                "example_id": "4d8f7060-7ebe-44be-aeb5-ba0c3355a618",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„So konnten beispielsweise einige Exemplare des Mittelelbe-Bibers und der Großtrappe wieder angesiedelt werden.“"
                            },
                            {
                                "example_id": "00dcdaf0-2e86-47e8-8031-2dc1f452abf1",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Besonders interessante Arten verzeichnet die Vogelwelt der DDR. Da ist die Großtrappe, der schwerste flugfähige Vogel Europas, der bei uns ausgestorben, ‚drüben‘ aber noch mit mehr als 200 Exemplaren zu finden ist.“"
                            },
                            {
                                "example_id": "33439bbe-cb5a-4f03-9f51-2c4602f37f0e",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Zur Frühlingszeit läßt sich im brandenburgischen Niedrigmoorgebiet ein eindrucksvolles Schauspiel beobachten: die Balz der Großtrappen.“"
                            },
                            {
                                "example_id": "48b82baf-4496-4092-aa96-3758ebbcdf1d",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Pußta – das klingt nach Piroschka, Gänsen, Pferden und Steppe. Kenner dieser ungarischen Landschaft wissen zudem von der Großtrappe, dem europäischen Strauß.“"
                            },
                            {
                                "example_id": "ee335036-dedc-41d7-86db-d0722cff3b6c",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Eine erhöhte Fuchsdichte kann sich äußerst negativ auf seltenere Arten, denen der rote Freibeuter habhaft werden kann, auswirken. Bodenbrüter wie Großtrappe, Großer Brachvogel und Birkhuhn, aber auch Hase und Kaninchen sind betroffen.“"
                            },
                            {
                                "example_id": "ed465095-8c57-45f9-80d7-bb4b9a6af141",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„In Europa leben nach Expertenangaben noch etwa 26 000 bis 32 000 Großtrappen.“"
                            },
                            {
                                "example_id": "e5d22778-df64-45d4-83b3-8360cfbf7316",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Großtrappen sind äußerst selten und sehr scheu.“"
                            },
                            {
                                "example_id": "0bdc326f-c392-4408-8c77-2ea02ca5002c",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Die imposante Balz der Großtrappen dauert von März bis Juni.“"
                            },
                            {
                                "example_id": "605393e9-7104-4ea1-8aa8-6a71289bdbd6",
                                "sense_id": "f27be1df-8f43-3477-9e20-bed4633a109e",
                                "text": "„Die Großtrappe ist in Deutschland vom Aussterben bedroht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
