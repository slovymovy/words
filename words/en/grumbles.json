{
    "word_family": [
        "grumble",
        "grumbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84d6616c-ccde-332d-b8c4-28aebca82588",
                    "sense_definition": "Third-person singular simple present indicative form of <w>grumble</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning he <w>grumbles</w> about having to wake up early for work.",
                            "target_lang_translations": {
                                "ru": "Каждое утро он <w>ворчит</w> из-за того, что приходится рано вставать на работу."
                            }
                        },
                        {
                            "text": "My stomach often <w>grumbles</w> when I skip breakfast.",
                            "target_lang_translations": {
                                "ru": "У меня часто <w>урчит</w> в животе, когда я пропускаю завтрак."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular simple present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа настоящего времени от глагола grumble (ворчит, урчит)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчит",
                                "target_lang_sense_clarification": "выражает недовольство"
                            },
                            {
                                "target_lang_word": "урчит",
                                "target_lang_sense_clarification": "о животе"
                            },
                            {
                                "target_lang_word": "жалуется",
                                "target_lang_sense_clarification": "высказывает претензии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd001a89-af63-3863-8590-e0b42ec27da0",
                    "sense_definition": "Plural form of <w>grumble</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite a few minor <w>grumbles</w>, the staff seemed generally pleased with the new policy.",
                            "target_lang_translations": {
                                "ru": "Несмотря на несколько мелких <w>жалоб</w>, сотрудники в целом казались довольными новыми правилами."
                            }
                        },
                        {
                            "text": "We listened patiently to all the customer <w>grumbles</w> during the meeting.",
                            "target_lang_translations": {
                                "ru": "Во время встречи мы терпеливо выслушали все <w>жалобы</w> клиентов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа существительного grumble (жалобы, ропот)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалобы",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "ропот",
                                "target_lang_sense_clarification": "тихое недовольство"
                            },
                            {
                                "target_lang_word": "ворчание",
                                "target_lang_sense_clarification": "брюзжание, придирки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "181cf20e-af3c-3677-b3bd-e6c8e1775293",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Grumbles</w> arrived at the office early to prepare the presentation.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Грамблс</w> пришел в офис пораньше, чтобы подготовить презентацию."
                            }
                        },
                        {
                            "text": "I met several members of the <w>Grumbles</w> family at the reunion.",
                            "target_lang_translations": {
                                "ru": "На встрече я познакомился с несколькими членами семьи <w>Грамблс</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грамблс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}