                        "cross_references": [
                            {
                                "target_word": "Varègue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f1469f2-4312-39e2-bc10-e106697549bb",
                                        "entry_id": "8025ea3c-61b5-3069-b89f-b3b3aad7df16",
                                        "glosses": [
                                            "Viking de Suède opérant à l’est entre le IXᵉ et le XIᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff11f61-3f27-4af6-8804-0176f3cb5791",
                                                "sense_id": "6f1469f2-4312-39e2-bc10-e106697549bb",
                                                "text": "Les Varègues étaient des conquérants ou des princes élus par les Slaves, constitués alors en une espèce de république, dont la capitale était Novgorod."
                                            },
                                            {
                                                "example_id": "266ab712-10e5-4dd7-a7db-89d411fbf442",
                                                "sense_id": "6f1469f2-4312-39e2-bc10-e106697549bb",
                                                "text": "Ce que suggère l’analyse du système familial russe, qui semble inclure simultanément des éléments scandinaves et centre-asiatiques, c’est que l’influence suédoise ne fut pas simplement politique et marginale, mais que les Varègues, pénétrant la Russie par la Baltique et la Volga, participèrent assez massivement à la formation même du peuple russe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
