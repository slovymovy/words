                "senses": [
                    {
                        "sense_id": "e0257c0d-9fbb-3cd6-bd8a-4aad4e814110",
                        "entry_id": "3cfe4814-94fa-31ea-8da4-f48ac63c7998",
                        "glosses": [
                            "ein Sternensystem in spiralig erscheinender Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63cb14e3-1edd-4624-815c-e71f50518097",
                                "sense_id": "e0257c0d-9fbb-3cd6-bd8a-4aad4e814110",
                                "text": "Der große Spiralnebel in der Andromeda ist die einzige mit bloßem Auge sichtbare Galaxie."
                            },
                            {
                                "example_id": "65644e36-a575-44e5-bbb8-019ba77a17df",
                                "sense_id": "e0257c0d-9fbb-3cd6-bd8a-4aad4e814110",
                                "text": "„Beim Aufspüren von Exoplaneten, fernen Galaxien oder einem Spiralnebel liefern Sternwarten immer wieder bombastische Farbbilder - obwohl das Weltall das Leuchten der Sterne verschluckt und die Astronomen bei ihren Entdeckungen nur trockenes Datenmaterial produzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
