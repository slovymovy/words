                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme <w>désirait</w> cette promotion plus que tout au monde."
                        },
                        {
                            "text": "Elle <w>désire</w> acquérir cette propriété depuis de nombreuses années."
                        }
                    ],
                    "synonyms": [
                        "convoiter"
                    ]
                },
                {
                    "sense_id": "fb87f3f9-54c3-3812-a269-5e63dedf1fee",
                    "sense_definition": "Éprouver une attirance charnelle ou physique envers quelqu'un.",
