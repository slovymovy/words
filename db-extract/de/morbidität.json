                    {
                        "translation_id": "d0f2861f-ad31-4128-801c-18ecda25d0f8",
                        "source_entry_id": "65e0183b-a71e-3444-bb9c-09edd3eb1a74",
                        "source_sense_id": "fc484e36-1518-3f96-bcc6-88968d349198",
