                "senses": [
                    {
                        "sense_id": "c150d686-0173-30d3-8ab5-c6d8d52e9566",
                        "entry_id": "89bd548c-e373-3739-b7cc-68eb9a8aec9a",
                        "glosses": [
                            "Fest der Verliebten, das am 14. Februar gefeiert wird; Valentinstag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbff86e1-2f0b-4782-ae2b-eefd1bc17106",
                                "sense_id": "c150d686-0173-30d3-8ab5-c6d8d52e9566",
                                "text": "„Dzień Kobiet był jednak w gruncie rzeczy świętem państwowym, podczas gdy walentynki są w istocie świętem biznesowym.“"
                            },
                            {
                                "example_id": "677436e4-bcca-478a-866b-a52017fb0843",
                                "sense_id": "c150d686-0173-30d3-8ab5-c6d8d52e9566",
                                "text": "„W walentynki uczucia wspieramy czułością, prezentami i wspólnym świętowaniem.“"
                            },
                            {
                                "example_id": "7ecb226e-0ffb-4281-b22c-2063ca9acbdb",
                                "sense_id": "c150d686-0173-30d3-8ab5-c6d8d52e9566",
                                "text": "„Może w ogóle krytycy walentynek jako święta (jakiego – wiadomo) rekrutują się po prostu z podstarzałych facetów, którzy nie dostali koperty z różowym serduszkiem i nie mają na to w przyszłych latach większych szans?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b857b4a5-1b8d-4ad9-a08d-16a1a24b24c8",
                        "source_entry_id": "89bd548c-e373-3739-b7cc-68eb9a8aec9a",
                        "source_sense_id": "c150d686-0173-30d3-8ab5-c6d8d52e9566",
                        "target_lang_word": "Valentinstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Valentinstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b60420f-656b-3e51-9b37-4f00941f4628",
                                        "entry_id": "90baa5e0-6256-3ce3-b142-4365f2129547",
                                        "glosses": [
                                            "Tag der Liebenden am 14. Februar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ad2f04-469c-4191-a2ea-d0b689f33a99",
                                                "sense_id": "6b60420f-656b-3e51-9b37-4f00941f4628",
                                                "text": "Sie hat ihm am Valentinstag ihre Liebe gestanden."
                                            },
                                            {
                                                "example_id": "1ee1c7a7-db92-4803-b1d9-eb57e0df7d6c",
                                                "sense_id": "6b60420f-656b-3e51-9b37-4f00941f4628",
                                                "text": "Er hat nicht mal versucht, sie am Valentinstag anzurufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
