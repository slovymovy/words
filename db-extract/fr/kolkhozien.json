                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba10c80-8931-48ca-85f2-792690975b50",
                                                "sense_id": "93355589-acfb-3946-9fad-c89cd5992d87",
                                                "text": "Среди крестьян имеется ещё немало таких людей, в том числе среди колхозников, которые сомневаются в правильности колхозного пути."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93dc901e-e9b2-30f1-9dd7-db6b17ab5abe",
                                        "entry_id": "80631156-7cde-30c9-9b32-e915a5aa635f",
                                        "glosses": [
                                            "разг. неодобр. житель сельской местности; деревенщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386c5854-22f2-4bd9-81da-43246f9f8284",
                                                "sense_id": "93dc901e-e9b2-30f1-9dd7-db6b17ab5abe",
                                                "text": "По выходным в город приезжали колхозники, чтобы закупиться на недельку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
