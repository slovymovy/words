                {
                    "sense_id": "4b9d910a-7dc8-301f-8dbd-19435ce7105f",
                    "sense_definition": "Словесное изложение событий, история о чём-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твой <w>рассказ</w> о поездке был очень интересным.",
                            "target_lang_translations": {
                                "en": "Your <w>story</w> about the trip was very interesting.",
                                "de": "Deine <w>Erzählung</w> über die Reise war sehr interessant."
                            }
                        },
                        {
                            "text": "Дети внимательно слушали <w>рассказ</w> учителя.",
                            "target_lang_translations": {
                                "en": "The children listened attentively to the teacher's <w>story</w>.",
                                "de": "Die Kinder hörten der <w>Erzählung</w> des Lehrers aufmerksam zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "повествование",
                        "история"
                    ],
                    "antonyms": [
                        "молчание"
                    ],
                    "common_phrases": [
                        "интересный рассказ",
                        "слушать рассказ",
                        "начать рассказ",
                        "долгий рассказ"
                    ],
                    "target_lang_definitions": {
                        "en": "A verbal account of events; a story about something.",
                        "de": "Mündliche oder schriftliche Darstellung von Ereignissen; eine Geschichte über etwas."
                    },
