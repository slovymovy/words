                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a2015b8-71c5-3c72-845f-bd35bfaa2db0",
                        "entry_id": "d709941a-4a9b-389d-a6ed-ba5cf3af0107",
                        "glosses": [
                            "The leaf of a fern, especially a compound leaf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257590f1-5cf8-4e10-8826-6d5542bbd60d",
                                "sense_id": "5a2015b8-71c5-3c72-845f-bd35bfaa2db0",
                                "text": "By the bank, fifty yards below Elm Island, stood the Master, looking into water six inches deep. A fern frond, knocked off the bank upstream, came down turning like a little green dragon in the clear water."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d36bd4-5724-33dd-b67b-3ae15fc34ba2",
                        "entry_id": "d709941a-4a9b-389d-a6ed-ba5cf3af0107",
                        "glosses": [
                            "Any fern-like leaf or other object resembling a fern leaf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3221a199-a795-4a2a-a245-a6dd41d29986",
                                "sense_id": "c3d36bd4-5724-33dd-b67b-3ae15fc34ba2",
                                "text": "palm frond"
                            },
                            {
                                "example_id": "1c8f7eeb-b9d9-44f5-b6c1-77b711d221fb",
                                "sense_id": "c3d36bd4-5724-33dd-b67b-3ae15fc34ba2",
                                "text": "Scores of coconut-shell fires blazed with their characteristic glaring white flame, throwing grotesque shadows on the brown thatched huts, dancing in fairylike shimmerings among the domes of coconut fronds, casting ghostly reaches of light through the adjacent graveyards, and silhouetting the forms of pareu-clad natives at work cleaning their fish or laying them on the live coals to broil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b4fbcfa-5942-44d0-85de-dfb68db56587",
                        "source_entry_id": "d709941a-4a9b-389d-a6ed-ba5cf3af0107",
                        "source_sense_description": "leaf of a fern",
                        "target_lang_word": "vějířovitý list",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8a71fbe2-76c3-4d51-8ec9-901559f20edc",
                        "source_entry_id": "d709941a-4a9b-389d-a6ed-ba5cf3af0107",
                        "source_sense_description": "leaf of a fern",
                        "target_lang_word": "varenblad",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e058a2a0-762f-461c-8146-e98b5f8aedc0",
                        "source_entry_id": "d709941a-4a9b-389d-a6ed-ba5cf3af0107",
                        "source_sense_description": "leaf of a fern",
                        "target_lang_word": "fronde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fronde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43e93531-c509-35c3-901d-bd3c846674ce",
                                        "entry_id": "277ceb69-4f21-3b38-84cf-4bfe9ebc6943",
                                        "glosses": [
                                            "Arme de trait individuelle composée d'une poche et de deux lanières."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05bfed88-bf36-4ce7-a7fd-068dd220c7ab",
                                                "sense_id": "43e93531-c509-35c3-901d-bd3c846674ce",
                                                "text": "Il se trouva, heureusement pour nous, que la hauteur que nous occupions était si escarpée, qu’elle ne pouvait être gravie à la fois que par un petit nombre d’hommes ; elle était en même temps trop élevée pour que les sauvages pussent nous incommoder beaucoup avec leurs javelots et leurs frondes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72aa472b-aacf-324d-b75b-5c3faedb476d",
                                        "entry_id": "277ceb69-4f21-3b38-84cf-4bfe9ebc6943",
                                        "glosses": [
                                            "Synonyme de frondibale, catapulte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a50fa0b-0ad0-3de5-bb95-7ebdb8e569f1",
                                        "entry_id": "277ceb69-4f21-3b38-84cf-4bfe9ebc6943",
                                        "glosses": [
                                            "Synonyme de lance-pierre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66bbde8b-54d9-4fea-8c91-960c62a62e46",
                                                "sense_id": "4a50fa0b-0ad0-3de5-bb95-7ebdb8e569f1",
                                                "text": "— Tapez pas, vous autres, ordonna Camus aux camarades qui prenaient déjà leurs cailloux, j’ai ma fronde, je vais y foutre."
                                            },
                                            {
                                                "example_id": "619f5fa4-6f9a-4c18-86fb-b30e227e168a",
                                                "sense_id": "4a50fa0b-0ad0-3de5-bb95-7ebdb8e569f1",
                                                "text": "Or, pour lui avoir accordé un seul instant de répit, de pouvoir, il sentait que la violence de sa jeunesse – pareille à une fronde soudain libérée, le lançait, malgré lui, droit en avant, comme une pierre aveugle."
                                            },
                                            {
                                                "example_id": "7edf1ca3-ae8d-43c8-88fa-d2b71025a3ae",
                                                "sense_id": "4a50fa0b-0ad0-3de5-bb95-7ebdb8e569f1",
                                                "text": "Si quelque gamin visait l’oiseau avec sa fronde c’était à la façon d’un astronome fou d’une étoile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc8bbb99-4612-33cf-9fbf-13498cf4f303",
                                        "entry_id": "277ceb69-4f21-3b38-84cf-4bfe9ebc6943",
                                        "glosses": [
                                            "Critique, révolte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10a2b19d-bf95-4e13-8c66-95d12c7f476f",
                                                "sense_id": "bc8bbb99-4612-33cf-9fbf-13498cf4f303",
                                                "text": "Déjà, le président sortant s’était permis un joyeux pied de nez au meneur républicain du Sénat Mitch McConnell en le laissant gérer des patates chaudes liées au budget ainsi qu’en animant la fronde de quelques sénateurs qui s’opposeront demain à la confirmation de la victoire de Joe Biden."
                                            },
                                            {
                                                "example_id": "07148cc0-3fae-45e6-8843-f399778f3646",
                                                "sense_id": "bc8bbb99-4612-33cf-9fbf-13498cf4f303",
                                                "text": "La fronde grandit dans le pays. Lundi, plusieurs centaines de milliers de personnes, d'après diverses estimations, se sont rassemblées à Rangoun."
                                            },
                                            {
                                                "example_id": "78c438d6-c4b5-423a-81df-881669fa857d",
                                                "sense_id": "bc8bbb99-4612-33cf-9fbf-13498cf4f303",
                                                "text": "Son leadership fortement ébranlé par la fronde des antivaccins, le chef du parti conservateur semble avoir décidé de mettre pied à terre."
                                            },
                                            {
                                                "example_id": "9b0dea75-35de-4e0a-baf4-5869af24d9e7",
                                                "sense_id": "bc8bbb99-4612-33cf-9fbf-13498cf4f303",
                                                "text": "Un esprit de fronde, un vent de fronde."
                                            },
                                            {
                                                "example_id": "603b7c13-1839-4f71-8325-ff169bc91356",
                                                "sense_id": "bc8bbb99-4612-33cf-9fbf-13498cf4f303",
                                                "text": "Il soufflait alors un vent de fronde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21800c2e-163b-3881-b2bd-2e2ea4e26d48",
                                        "entry_id": "277ceb69-4f21-3b38-84cf-4bfe9ebc6943",
                                        "glosses": [
                                            "Bande de tissu fendue dans sa longueur à chaque extrémité et servant à maintenir une compresse."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fronde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "105c49c3-7497-3676-9c05-0fdd9d0bafbd",
                                        "entry_id": "c794e3ce-1f13-32be-9232-6bdd6fb09b43",
                                        "glosses": [
                                            "Synonyme de frondaison."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7b628b-ddc9-44c1-8528-1ae81b5fd009",
                                                "sense_id": "105c49c3-7497-3676-9c05-0fdd9d0bafbd",
                                                "text": "Quelques frondes de houx béni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e86e1f24-07e6-32aa-a18a-e237bcddb217",
                                        "entry_id": "c794e3ce-1f13-32be-9232-6bdd6fb09b43",
                                        "glosses": [
                                            "Feuille des fougères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79afe045-3e04-4781-9adb-cc566ede09ec",
                                                "sense_id": "e86e1f24-07e6-32aa-a18a-e237bcddb217",
                                                "text": "Dès l’automne, la Fougère Aigle aux frondes desséchées attriste de sa teinte rouille la tonalité déjà grise de l’ensemble."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fronde",
                                "target_lang_code": "fr",
