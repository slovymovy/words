                ],
                "senses": [
                    {
                        "sense_id": "e5fa3eb0-418c-342e-ba09-725d0e7a3ebd",
                        "entry_id": "3bbd6df7-126c-395c-b9cb-9a9f718a3f29",
                        "glosses": [
                            "Arrêter de s’accouder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c023bf8f-65b5-41b5-a5c4-919419a8c99d",
                                "sense_id": "e5fa3eb0-418c-342e-ba09-725d0e7a3ebd",
                                "text": "Elle se désaccouda, remonta le drap jusqu’à son menton."
                            },
                            {
                                "example_id": "89cdc440-e7e6-48a8-abf0-df367ac4a402",
                                "sense_id": "e5fa3eb0-418c-342e-ba09-725d0e7a3ebd",
                                "text": "Iseult changea très légèrement de position, se désaccoudant des étagères de bois sombre pour s'y adosser entièrement et ainsi entamer plus confortablement son récit."
                            },
                            {
                                "example_id": "a73928c6-f923-4ab9-ae7e-d4e2c70ea05f",
                                "sense_id": "e5fa3eb0-418c-342e-ba09-725d0e7a3ebd",
                                "text": "Du balustre de marbre blanc désaccoudée Vers le parc, enchanté de vers luisants, guidée, Ma Mélancolie erre, en allée et de banc en banc, A ton côté, gentil Remy, ma Mélancolie erre, Dans le décor d'or clair du ciel crépusculaire Où s'érigent des marbres blancs."
                            },
                            {
                                "example_id": "ea2179cf-9124-4e72-8294-378f93200aee",
                                "sense_id": "e5fa3eb0-418c-342e-ba09-725d0e7a3ebd",
                                "text": "Un tremblement de terre désaccouda brusquement tous les clients du comptoir."
                            }
                        ]
                    }
                ],
