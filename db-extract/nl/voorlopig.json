                    {
                        "sense_id": "5a9495e2-001f-37c2-a6fe-44f5fb169990",
                        "entry_id": "2eda96a3-82bc-3c56-9873-9860c83f24b8",
                        "glosses": [
                            "tijdelijk in afwachting van iets definitiefs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df6ae59-31dd-4ae1-a804-2e960e2b5742",
                                "sense_id": "5a9495e2-001f-37c2-a6fe-44f5fb169990",
                                "text": "De voorlopige regering kwam er in afwachting van een volwaardige, waarin alle partijen zich konden vinden."
                            },
                            {
                                "example_id": "87ca1c09-d3bd-47fa-8c9e-7de4a10eb583",
                                "sense_id": "5a9495e2-001f-37c2-a6fe-44f5fb169990",
                                "text": "Ze zou net als haar voorgangers uit de 17de eeuw ook wel een frisse duik willen nemen, maar voorlopig volstaan gulzige slokken uit haar bidon. Een bijrolletje in de historie van La Planche is genoeg. Morgen mogen de mooie jongens."
                            },
                            {
                                "example_id": "670c37dc-8235-490b-91ca-b3feac4a6c72",
                                "sense_id": "5a9495e2-001f-37c2-a6fe-44f5fb169990",
                                "text": "Vooruit, voorlopig dan maar the ‘Best Breakfast in the World’ met een liter cola."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76b5f071-b5f7-41c7-b893-28aef8ff9ca3",
                        "source_entry_id": "2eda96a3-82bc-3c56-9873-9860c83f24b8",
                        "source_sense_id": "5a9495e2-001f-37c2-a6fe-44f5fb169990",
