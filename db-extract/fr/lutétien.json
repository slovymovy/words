                    {
                        "sense_id": "22b7d25a-a64b-3c52-868a-db354c04933e",
                        "entry_id": "51c64b9a-281f-3457-94dd-b32a34501d70",
                        "glosses": [
                            "Relatif au Lutétien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c299c7-be2b-4961-92b3-fa5589a88b9e",
                                "sense_id": "22b7d25a-a64b-3c52-868a-db354c04933e",
                                "text": "Plus au nord, des calcaires blancs et des argiles ligniteuses, du domaine lacustre lutétien, sont connus à l'est du Rhône (Nyons, synclinaux de Dieulefit et de Méouge, Drôme) et à l'ouest (synclinaux d'Uzès et de Brouzet-les-Alès, de Laval-Saint-Roman, Gard)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "147e575d-4634-3074-8051-9c8407a84467",
                "word": "Lutétien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd02bea7-985a-315a-8a97-0023cfa188bb",
                        "entry_id": "147e575d-4634-3074-8051-9c8407a84467",
                        "glosses": [
                            "Étage stratigraphique de l’Éocène dans le Cénozoïque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ec2af0-9088-41d9-8d0e-ac864f560648",
                                "sense_id": "fd02bea7-985a-315a-8a97-0023cfa188bb",
                                "text": "A Faucoucourt, continuer vers Anizy-le-Château ou tourner à droite et se rendre à Prémontré par Suzy. Après ce village, vers le sommet de la côte, observer le calcaire dolomitique à « têtes de chats » du Lutétien inférieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96da60b7-165b-4826-b976-51a9873e96b0",
                        "source_entry_id": "147e575d-4634-3074-8051-9c8407a84467",
                        "source_sense_id": "fd02bea7-985a-315a-8a97-0023cfa188bb",
                        "target_lang_word": "Lutetium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lutetium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d25b368a-50db-38bf-8315-c492064adfae",
                                        "entry_id": "5576f3e5-da50-3415-8ed0-e081e352105b",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 71, das zu den Lanthanoiden gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad9a08e-59c4-4760-a358-2f9abc7e2107",
                                                "sense_id": "d25b368a-50db-38bf-8315-c492064adfae",
                                                "text": "Lutetium kommt in der Natur nur in Verbindungen vor."
                                            },
                                            {
                                                "example_id": "9a93b715-46e7-4bf7-9a71-5ca52a200346",
                                                "sense_id": "d25b368a-50db-38bf-8315-c492064adfae",
                                                "text": "Die Produktion Lutetiums auf der Welt liegt bei etwa 10 Tonnen pro Jahr."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bb4873e-09ca-4f13-a639-a75c9aeec1da",
                        "source_entry_id": "147e575d-4634-3074-8051-9c8407a84467",
                        "source_sense_id": "fd02bea7-985a-315a-8a97-0023cfa188bb",
                        "target_lang_word": "Lutetian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lutetian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "882d71f5-03a4-3c27-97d7-10e515e9650e",
                                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                                        "glosses": [
                                            "Of or relating to ancient Lutetia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae1790f-ec48-476d-92bd-1adf0d93898c",
                                                "sense_id": "882d71f5-03a4-3c27-97d7-10e515e9650e",
                                                "text": "The activity of the Lutetian shippers and navigators covered the territory bathed by the Seine, the Marne, and the Oise, all of them quite navigable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf094ba6-2827-3635-b6c6-93b7556e01ba",
                                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                                        "glosses": [
                                            "Parisian."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679a8e1f-6f5b-4a07-8f0b-6cf9d399522c",
                                                "sense_id": "cf094ba6-2827-3635-b6c6-93b7556e01ba",
                                                "text": "[...] not long before I took him to the Aerogare, he gave the last of his Lutetian homilies [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e1570d-e010-3ed3-9f12-19946d952008",
                                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                                        "glosses": [
                                            "Of or pertaining to the Lutetian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13d453b5-ab4d-4a9a-9015-c587a62db44d",
                                                "sense_id": "d8e1570d-e010-3ed3-9f12-19946d952008",
                                                "text": "It is important to note that the Lutetian sediments occurring in the area under investigation were distinguished as limestone and flysch during previous studies also."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lutetian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34e7d1e4-f295-3c3b-b321-181053b6d358",
                                        "entry_id": "5efb66a2-3d84-39fa-989d-811da48131c7",
                                        "glosses": [
                                            "A native or inhabitant of Lutetia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa4712ec-afd0-46d6-a5e1-c33acbb1498a",
                                                "sense_id": "34e7d1e4-f295-3c3b-b321-181053b6d358",
                                                "text": "It is possible that, when they left their islands, a justifiable concern for their own safety in wartime led the Lutetians to settle at the points that were least exposed to aggression."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lutetian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "146c1a1a-7eff-34c2-9c39-72a992e91836",
                                        "entry_id": "cebdfd10-9029-3d5c-9886-bcb4fa9371d9",
                                        "glosses": [
                                            "A subdivision of the Eocene epoch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f85aa35-3c2d-4f3d-b6f0-90f07f1f69e5",
                                                "sense_id": "146c1a1a-7eff-34c2-9c39-72a992e91836",
                                                "text": "There are good reasons for believing that the “Paniselian” is a local shallow-water representative of the lower part of the Lutetian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
