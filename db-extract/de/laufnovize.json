                "senses": [
                    {
                        "sense_id": "1fc89000-edac-306f-8783-3c9c53622045",
                        "entry_id": "a5ce1fb9-173d-32ce-83ab-1ed1d7af7343",
                        "glosses": [
                            "Person, die neu beim Laufen ist und wenig bis keine Erfahrung im Laufsport hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "be11ab18-18a4-4c24-9d1d-c240ea920072",
                                "sense_id": "1fc89000-edac-306f-8783-3c9c53622045",
                                "text": "„So wurden Paare gebildet aus Laufnovizen und erfahrenen Läufern, die in gleichmäßigem Tempo die Halbmarathondistanz absolvieren können.“"
                            },
                            {
                                "example_id": "8576be7d-b9bc-43e3-8897-9443f8f80cbe",
                                "sense_id": "1fc89000-edac-306f-8783-3c9c53622045",
                                "text": "„Die zweimalige Olympia-Teilnehmerin bereitet zusammen mit einem Trainer-Team jedes Jahr viele Teilnehmer vom Laufnovizen bis zum Könner mit einem Marathon-Projekt (Beginn 26. April) auf einen Start über die klassischen 42,195 Kilometer im Herbst beim Frankfurt-Marathon vor.“"
                            },
                            {
                                "example_id": "e35fe750-38a8-46f3-bd5f-2c46d2d91bd1",
                                "sense_id": "1fc89000-edac-306f-8783-3c9c53622045",
                                "text": "„Ein buntes Team aus Laufnovizen und etlichen Wiederholungstätern stellte sich der Herausforderung, das Ziel gemeinsam als Gruppe zu erreichen.“"
                            },
                            {
                                "example_id": "ddee2a5d-71f5-45d9-93a0-8cd35b276f40",
                                "sense_id": "1fc89000-edac-306f-8783-3c9c53622045",
                                "text": "„Ich denke, es ist auch für Laufnovizen möglich diesen Ultramarathon zu absolvierten.“"
                            },
                            {
                                "example_id": "956dc2af-4821-4f9e-b122-f35fe9dc587e",
                                "sense_id": "1fc89000-edac-306f-8783-3c9c53622045",
                                "text": "„Auch Laufnovizen werden dabei in zwölf Wochen Schritt für Schritt darauf vorbereitet, eine Strecke von etwas mehr als vier Kilometern am Stück zu laufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
