                ],
                "senses": [
                    {
                        "sense_id": "ee1e03a9-a23d-333e-bb28-d1c53457d2d7",
                        "entry_id": "0a2d54ee-0ffe-3d41-89c1-3876025146e5",
                        "glosses": [
                            "The state or quality of being without clothing on the body; specifically, the quality of being without clothing on the genitals."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2403b7ac-c2ee-403b-841d-bb3ffd909984",
                                "sense_id": "ee1e03a9-a23d-333e-bb28-d1c53457d2d7",
                                "text": "In places such as Scandinavia, public nudity is legal."
                            }
                        ]
                    },
                    {
                        "sense_id": "54398542-2579-32cb-9202-fd35a44bdd77",
                        "entry_id": "0a2d54ee-0ffe-3d41-89c1-3876025146e5",
                        "glosses": [
                            "Something or someone without clothes."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "159204da-8612-4a08-ab16-c4e9de465b9d",
                                "sense_id": "54398542-2579-32cb-9202-fd35a44bdd77",
                                "text": "[…]he had divested himself of the incumbrance of dress[…] and although a nudity, he appeared before numbers of people unabashed, and with an unblushing composure of countenance, which envinces that the sense of shame in him is entirely abolished."
                            },
                            {
                                "example_id": "3e8ddb57-6dde-4130-9475-6e8c2c08c893",
                                "sense_id": "54398542-2579-32cb-9202-fd35a44bdd77",
                                "text": "M. PILS' battle-piece, representing Prince NAPOLEON leading his division at Alma, and some of M. GEROME's startling nudities."
                            }
                        ]
                    }
                ],
                "translations": [
