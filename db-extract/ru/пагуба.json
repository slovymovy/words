                "senses": [
                    {
                        "sense_id": "262fd998-4832-3e99-9791-d5e3a5a89220",
                        "entry_id": "f90c4856-79f3-37f4-831c-2391ba25e953",
                        "glosses": [
                            "устар. и высок. гибель; большой вред"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ec55e0-c131-48d0-b271-b2ca4a5f4eef",
                                "sense_id": "262fd998-4832-3e99-9791-d5e3a5a89220",
                                "text": "Может быть, она [тайна] сопряжена с ужасным грехом, с пагубою вечного блаженства, с дьявольским договором…"
                            },
                            {
                                "example_id": "42e3e895-b47d-4dae-bac1-c1a7ae75061f",
                                "sense_id": "262fd998-4832-3e99-9791-d5e3a5a89220",
                                "text": "Но в том-то и пагуба, что эта мудрёная выгода ни в какую классификацию не попада́ет, ни в один список не умещается."
                            }
                        ]
                    }
                ],
