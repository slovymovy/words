                                        "entry_id": "3c3db5db-4aab-3edd-9825-9f84a216e761",
                                        "glosses": [
                                            "een historische regio in Midden-Europa die zich uitstrekt aan weerszijden van de midden- en bovenloop van de Oder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b73b9d3-9a1f-45c2-999d-e4c39dd831ad",
                                                "sense_id": "39395407-cfdb-3041-83d5-08de4c46c950",
                                                "text": "Silezië wordt vaak onderverdeeld in het vlakke Neder-Silezië en het bergachtige Opper-Silezië."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "466fb6b4-ca9d-30de-ba64-44e1d94aba51",
                                        "entry_id": "3c3db5db-4aab-3edd-9825-9f84a216e761",
                                        "glosses": [
                                            "een woiwodschap in het zuiden van Polen, gelegen aan de Tsjechische en Slowaakse grens"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4477b15-87e2-4f65-805d-d24292a8eb0b",
                                                "sense_id": "466fb6b4-ca9d-30de-ba64-44e1d94aba51",
                                                "text": "Katowice is de hoofdstad van Silezië."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990ad8c4-448f-3bf4-8be5-7013764229dd",
                                        "entry_id": "3c3db5db-4aab-3edd-9825-9f84a216e761",
                                        "glosses": [
                                            "een provincie van Pruisen die bestond van 1815 tot 1919 en van 1938 tot 1941"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f66fe04-5754-472d-ae8a-3749ea4b14a0",
                                                "sense_id": "990ad8c4-448f-3bf4-8be5-7013764229dd",
                                                "text": "De Pruisische provincie Silezië ontstond na de verovering van Silezië door Frederik II tijdens de Silezische Oorlogen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08edc540-3bdb-3142-bb5a-375fc7e73394",
                                        "entry_id": "3c3db5db-4aab-3edd-9825-9f84a216e761",
                                        "glosses": [
                                            "een middeleeuws hertogdom in het huidige Polen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b066aca-ddf7-4d83-8ac8-437b3e9d56a8",
                                                "sense_id": "08edc540-3bdb-3142-bb5a-375fc7e73394",
                                                "text": "In 1833 werd het hertogdom Silezië bij testament toegewezen aan Wladislaus II de Balling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
