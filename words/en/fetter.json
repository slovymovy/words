{
    "word_family": [
        "unfetter",
        "unfettered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b13d6d7-1b73-37a3-93d2-e372c2d513b6",
                    "sense_definition": "A chain or shackle placed on the feet to bind a person or animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_binding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards placed heavy iron <w>fetters</w> around the prisoner's ankles before leading him away."
                        },
                        {
                            "text": "He could barely walk across the stone floor while his legs were locked in <w>fetters</w>."
                        }
                    ],
                    "synonyms": [
                        "leg irons"
                    ],
                    "common_phrases": [
                        "iron fetters"
                    ]
                },
                {
                    "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                    "sense_definition": "Something that confines, restricts, or hampers one's freedom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist felt that traditional rules were a <w>fetter</w> to her creative expression."
                        },
                        {
                            "text": "She finally managed to break the <w>fetters</w> of poverty and pursue her dreams."
                        }
                    ],
                    "common_phrases": [
                        "break the fetters",
                        "cast off the fetters"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd890b94-a7be-3806-8eaa-c2e829bb1d4f",
                    "sense_definition": "To bind or restrain someone with chains or shackles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_binding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards decided to <w>fetter</w> the captive to prevent any further escape attempts."
                        },
                        {
                            "text": "They were <w>fettered</w> together and marched down into the dark dungeon."
                        }
                    ]
                },
                {
                    "sense_id": "5e0df1a3-2f11-30a0-8a50-b130228cdcda",
                    "sense_definition": "To restrict the freedom or progress of someone or something; to hamper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excessive regulations continue to <w>fetter</w> economic growth across the region."
                        },
                        {
                            "text": "Her fear of failure seemed to <w>fetter</w> every decision she attempted to make."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
