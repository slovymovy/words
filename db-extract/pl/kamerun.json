                    {
                        "translation_id": "4bc0194f-634d-493c-84da-a71b66798a30",
                        "source_entry_id": "9ab7a24c-6c88-3cfd-8cfd-872ac566438b",
                        "source_sense_id": "e5ac0c5e-ba45-3a4f-8dc1-00881d577790",
