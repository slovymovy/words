                                                "sense_id": "c9a0fe61-f16b-3a5f-a042-a687be1521fa",
                                                "text": "„Wolfgang Amadeus Mozart wurde in Salzburg geboren.“"
                                            },
                                            {
                                                "example_id": "f5daa856-309a-41f8-8e44-0fb66e078c15",
                                                "sense_id": "c9a0fe61-f16b-3a5f-a042-a687be1521fa",
                                                "text": "„Sechs deutsche Segelflieger, unter ihnen Hanna Reitsch, überqueren von Salzburg aus die Alpen und landen bei Udine.“"
                                            }
                                        ],
