                            {
                                "example_id": "d7f9880b-bf14-47c3-90c8-d50ef2b6795b",
                                "sense_id": "70d633ae-0b5a-3a4d-9106-e6ff319c0b2b",
                                "text": "Mouvements respiratoires."
                            },
                            {
                                "example_id": "3e722ee4-4054-4553-8b8e-2e60b04c638f",
                                "sense_id": "70d633ae-0b5a-3a4d-9106-e6ff319c0b2b",
                                "text": "L’actinobacillose pharyngienne se traduit par des tumeurs plus ou moins volumineuses provoquant de la dysphagie et des difficultés respiratoires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7c7e2b2-f68f-413f-a09b-0a4ca29ee1cd",
                        "source_entry_id": "a50c9198-a222-3d7a-bc8b-1fdb5790118b",
