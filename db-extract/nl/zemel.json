                        "entry_id": "022edca4-f53c-3d15-84ab-c77b64a6d020",
                        "glosses": [
                            "huls en kiem van een graankorrel die bij het malen daarvan worden afgescheiden en fijngemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cec082d-b1d8-435e-8996-ddab81c2908a",
                                "sense_id": "308f4304-6068-30ff-a24d-a20280f3df5f",
                                "text": "Granen bestaan uit zetmeel met daaromheen een vliesje, de zemel, en een kiem met voedingsstoffen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9bce197-907e-3eb0-bcb8-aa62a88ec4c2",
                        "entry_id": "022edca4-f53c-3d15-84ab-c77b64a6d020",
                        "glosses": [
                            "iets of iemand die minderwaardig wordt gevonden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6f0045bc-ce99-4021-9bd7-96e78b93ae83",
                                "sense_id": "e9bce197-907e-3eb0-bcb8-aa62a88ec4c2",
                                "text": "Juffrouw Van Toossen was een dom stuk zemel."
                            }
                        ]
                    }
