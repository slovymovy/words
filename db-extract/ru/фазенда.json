                "senses": [
                    {
                        "sense_id": "bcae2598-8c31-3cdc-8328-cc2b2e891ecc",
                        "entry_id": "7be63255-1700-3cf1-96bf-ac45e53ec2bc",
                        "glosses": [
                            "в Бразилии: крупное землевладельческое или скотоводческое поместье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba66d716-a480-4735-ba18-d2ad9b165003",
                                "sense_id": "bcae2598-8c31-3cdc-8328-cc2b2e891ecc",
                                "text": "В соседней Бразилии фазенды располагаются всегда в нескольких километрах от шоссе (на удалении), под высокими деревьями, часто на берегу ручья или озерца, под высокими манговыми деревьями."
                            }
                        ]
                    },
                    {
                        "sense_id": "366f558c-f9d6-310c-8cd5-608f8bb00042",
                        "entry_id": "7be63255-1700-3cf1-96bf-ac45e53ec2bc",
                        "glosses": [
                            "разг., шутл. или ирон. дача, приусадебный садово-огородный участок, дом в деревне или подсобное хозяйство (например, в армии)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f737c1a5-742d-4d3b-839d-1b0053451d70",
                                "sense_id": "366f558c-f9d6-310c-8cd5-608f8bb00042",
                                "text": "Взял кусок земли в аренду // И построил там фазенду. // Посадил арбузы, дыни, // Только где мне взять рабыню?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4320d5a3-2f9a-453a-9f72-9e7ce6b1c012",
                        "source_entry_id": "7be63255-1700-3cf1-96bf-ac45e53ec2bc",
                        "source_sense_description": "в Бразилии: крупное землевладельческое или скотоводческое поместье",
