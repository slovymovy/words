                    {
                        "translation_id": "cdb4bc4f-727c-4637-82cb-dded47c39fa2",
                        "source_entry_id": "da5d8210-8c50-39bc-80bf-c086ba3c39dc",
                        "source_sense_id": "3eefcfe4-829b-3ad4-a61a-ab4a09cd1161",
