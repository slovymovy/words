                        "form": "die Friseuse"
                    },
                    {
                        "form_id": "8fa4a892-3726-4034-b28c-5e79a1edb1c2",
                        "entry_id": "c13e5465-d85f-32fe-8087-1e16adeaf084",
                        "tags": [
                            "accusative",
