                        "sense_id": "16c345d4-214e-34ee-8cee-228b99d621f8",
                        "entry_id": "fe98c609-1c1e-3bc4-a340-08174a50184d",
                        "glosses": [
                            "Sportlerin, die das Golfspiel ausübt"
