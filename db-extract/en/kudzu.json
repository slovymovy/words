                                        "entry_id": "e0603d8d-df82-3db9-8157-23a83b90ee5d",
                                        "glosses": [
                                            "Pflanzenart aus der Familie der Hülsenfrüchtler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f721f7f0-2a82-4726-85b3-b4bc401d98f2",
                                                "sense_id": "c78cf3bc-5dbf-3685-b9d5-385a5db68b26",
                                                "text": "„Hinter ihm wachsen russische Disteln und schottischer Ginster und Kudzu.“"
                                            },
                                            {
                                                "example_id": "a64e041f-4677-43a4-8fb4-b0083b41626a",
                                                "sense_id": "c78cf3bc-5dbf-3685-b9d5-385a5db68b26",
                                                "text": "„Die Straße verlief leicht abschüssig durch einen Dschungel von totem Kudzu.“"
                                            }
                                        ],
