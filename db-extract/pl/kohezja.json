                        "sense_id": "9460c900-c198-3c69-b542-9c3e49de3ec5",
                        "entry_id": "8fe8a530-39ce-34a0-a3e5-458f5b3fa772",
                        "glosses": [
                            "właściwość tekstu polegająca na tym, że jego części są ze sobą logicznie i formalnie powiązane za pomocą różnych środków językowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4d50a9-4ac1-4cab-8ac0-3b25e4c27dd1",
                                "sense_id": "9460c900-c198-3c69-b542-9c3e49de3ec5",
                                "text": "Dzięki kohezji tekst jest zrozumiały i tworzy logiczną całość."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f1cddf05-fc71-3e0f-b9a9-ef50aae829c5",
                        "entry_id": "8fe8a530-39ce-34a0-a3e5-458f5b3fa772",
                        "glosses": [
                            "siła wzajemnego przyciągania się cząsteczek tej samej substancji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e41b51e0-c19c-3e81-a4aa-5509ad4cf25a",
                        "entry_id": "8fe8a530-39ce-34a0-a3e5-458f5b3fa772",
                        "glosses": [
                            "siła więzi między ludźmi w danej grupie"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
