                "senses": [
                    {
                        "sense_id": "08271e53-675d-3745-9769-45baaf7639f0",
                        "entry_id": "c95fef2d-84d0-3cc6-9110-2e0f905e5db3",
                        "glosses": [
                            "Erhebung der Meinung einer Personengruppe, die die Meinung einer größeren Personengruppe repräsentieren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "507c1c45-8439-4de2-a725-a671b46d0c9d",
                                "sense_id": "08271e53-675d-3745-9769-45baaf7639f0",
                                "text": "„In einer Repräsentativerhebung (Sample 500) des Innsbrucker Instituts für Politikwissenschaft (Leitung Univ.-Doz. Ferdinand Karlhofer) wurde im ersten Halbjahr 1997 die Akzeptanz der ORF-Sendung \"Tirol heute\" untersucht.“"
                            },
                            {
                                "example_id": "cc589877-68be-4b4e-982c-793864415379",
                                "sense_id": "08271e53-675d-3745-9769-45baaf7639f0",
                                "text": "„Alcopops stellen nach einer aktuellen Repräsentativerhebung der Bundeszentrale für gesundheitliche Aufklärung eine zunehmende Gefahr für junge Menschen dar.“"
                            },
                            {
                                "example_id": "ca0e4532-9c0f-472e-9144-4b0448de6dfc",
                                "sense_id": "08271e53-675d-3745-9769-45baaf7639f0",
                                "text": "„Infratest führte eine Repräsentativerhebung durch.“"
                            },
                            {
                                "example_id": "539b8e32-ced8-41d7-b5d2-6d047bfb7f9b",
                                "sense_id": "08271e53-675d-3745-9769-45baaf7639f0",
                                "text": "„Die Repräsentativerhebung ‚Familien in Hannover‘ zeigt nach Stadtteilen aufgeschlüsselt viele Daten und Fakten, die bei künftigen politischen Entscheidungen helfen sollen.“"
                            },
                            {
                                "example_id": "620fbf24-6c7f-4589-ad32-4fe506854993",
                                "sense_id": "08271e53-675d-3745-9769-45baaf7639f0",
                                "text": "„Dies geht aus einer Repräsentativerhebung des B.A.T-Freizeit-Forschungsinstituts hervor, das erstmals seit Einführung des Euro die tatsächlichen Geldausgaben deutscher Urlauber ermittelt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
