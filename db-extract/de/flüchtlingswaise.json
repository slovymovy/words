                "senses": [
                    {
                        "sense_id": "bc49a61b-656a-397d-8a19-eff01f5b4d3b",
                        "entry_id": "fef7ef15-7a3e-3de2-9012-5860da288000",
                        "glosses": [
                            "Kind oder jugendlicher Flüchtling, der seine Eltern verloren hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0b50b87-47ea-44c5-b9c1-a8b039a16a20",
                                "sense_id": "bc49a61b-656a-397d-8a19-eff01f5b4d3b",
                                "text": "„Ein schwieriges Problem erhebt sich bei adoptierten Flüchtlingswaisen, wenn deren leibliche Eltern sich später plötzlich einfinden und ihr Kind zurückverlangen.“"
                            },
                            {
                                "example_id": "c8031bb6-8520-48c7-83a1-5239b03bf1de",
                                "sense_id": "bc49a61b-656a-397d-8a19-eff01f5b4d3b",
                                "text": "„Eine bekannte farbige Sängerin, Emilia Sagostini, die laut eigener Biographie aus den ärmsten Vierteln von New Orleans stammte, steckte einen großen Teil ihrer vielen verdienten Millionen in eine Stiftung, aus der verschiedene Kinderdörfer für Kriegs- und Flüchtlingswaisen in Afrika entstanden.“"
                            },
                            {
                                "example_id": "e7258daa-1aaa-49b7-bcec-5affe64f288e",
                                "sense_id": "bc49a61b-656a-397d-8a19-eff01f5b4d3b",
                                "text": "„Dabei stellten Ankunft und Aufnahme der Flüchtlingswaisen erst die Vorhut des Vertriebenenzustroms von 1946 dar, in dem auch Oldenburg besonders zahlreich Mütter mit Kindern aufnehmen mußte, deren Ehemänner bzw. Väter gefallen, vermißt oder in Kriegsgefangenschaft geraten waren.“"
                            },
                            {
                                "example_id": "d392d77a-32e9-42da-90f9-6c89201aff77",
                                "sense_id": "bc49a61b-656a-397d-8a19-eff01f5b4d3b",
                                "text": "„Ihr Roman Treibgut behandelt das Schicksal von zwei Flüchtlingswaisen nach dem Zweiten Weltkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
