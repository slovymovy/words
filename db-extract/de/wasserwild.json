                "senses": [
                    {
                        "sense_id": "32117970-81de-32f6-83cd-d76dd221c8a2",
                        "entry_id": "3621eb72-1ee0-3810-9891-f89d38f29f34",
                        "glosses": [
                            "Wild, das wasserbezogen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc35a1d-bccd-4972-8507-824ffdc38f49",
                                "sense_id": "32117970-81de-32f6-83cd-d76dd221c8a2",
                                "text": "„Sie wurden früher, bis Ende des 19. Jahrhunderts, zum Auffinden und Apportieren von erlegtem Wasserwild abgerichtet.“"
                            },
                            {
                                "example_id": "837215a5-174d-484f-bc57-dbe195537e90",
                                "sense_id": "32117970-81de-32f6-83cd-d76dd221c8a2",
                                "text": "„Das bedeutet, dass seine großen Talente vor allem in der Arbeit als Verlorenbringer in Feld, Wald und auch im Wasser, als auch bei der Schweißarbeit und jeder konzentrierten und anspruchsvollen Nasenarbeit liegen. Aber auch im Stöbereinsatz (vor allem bei der Jagd auf Wasserwild) leistet er vorzügliche Arbeit.“"
                            }
                        ],
