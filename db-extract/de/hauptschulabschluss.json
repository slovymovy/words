                "senses": [
                    {
                        "sense_id": "2f41aa4a-1f7e-3ffb-ab72-13d3784475eb",
                        "entry_id": "6f64f1aa-aeec-3fb3-9ca6-412f6eb017cf",
                        "glosses": [
                            "Schulabschluss, der in Deutschland an erfolgreiche Absolventen der Hauptschule oder der Mittelstufe weitergehender Schulen vergeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559b941b-164c-4a54-94a7-1c563299634b",
                                "sense_id": "2f41aa4a-1f7e-3ffb-ab72-13d3784475eb",
                                "text": "Nachdem ich meinen Hauptschulabschluss gemacht hatte, fing ich eine Lehre in einer KFZ-Werkstatt an."
                            },
                            {
                                "example_id": "337b8c15-395e-48bd-8573-a0a5332f2a68",
                                "sense_id": "2f41aa4a-1f7e-3ffb-ab72-13d3784475eb",
                                "text": "„Das Stuttgarter Landgericht urteilt über einen Hochstapler, der es mit Hauptschulabschluss bis an den Operationstisch schaffte.“"
                            },
                            {
                                "example_id": "11e2e1bb-b226-410e-9444-350eac175514",
                                "sense_id": "2f41aa4a-1f7e-3ffb-ab72-13d3784475eb",
                                "text": "„Der Mutter gelang es, Udo nach dem Hauptschulabschluss in einem Baugeschäft unterzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
