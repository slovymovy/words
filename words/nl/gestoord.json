                            "target_lang_translations": {
                                "en": "The severely <w>disturbed</w> perpetrator was sentenced to mandatory psychiatric treatment by the judge."
                            }
                        },
                        {
                            "text": "Het is duidelijk dat deze man een <w>gestoorde</w> indruk maakt op zijn omgeving.",
                            "target_lang_translations": {
