                        "examples": [
                            {
                                "example_id": "a629998c-c6f9-4390-b884-0a88c87feff6",
                                "sense_id": "9042bec6-a5d1-3071-ab4e-2df66fa86d3c",
                                "text": "Zowel de staat Oekraïne als de vier musea op de Krim vonden dat de kunst, voornamelijk gouden kunstvoorwerpen en sieraden, naar hen teruggestuurd moest worden. De Oekraïense staat meende dat zij de wettelijk eigenaar is, maar de musea die „operationeel beheerder” waren vonden dat ze in kunstcollecties op de Krim thuishoren."
                            }
                        ]
                    }
