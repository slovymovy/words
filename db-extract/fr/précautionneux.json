                                        "entry_id": "8663a679-2a7f-3a55-b975-ac4b9390acd6",
                                        "glosses": [
                                            "Using or exercising caution; careful; tentative"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610d99a8-9170-4e45-91f8-d132cbf093ed",
                                                "sense_id": "329bee8d-cb45-3324-b9d5-ddb190aeaf1d",
                                                "text": "He took a few cautious steps toward the cave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5562e6b4-f181-4acc-bdfb-c522e848f3d5",
                        "source_entry_id": "96f6555b-3f85-3280-9a78-d031a41c86b2",
                        "source_sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                        "target_lang_word": "careful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "careful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Taking care; attentive to potential danger, error or harm; cautious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0e0307-fe95-4e6e-9784-2c28720c19cc",
                                                "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                                "text": "He was a slow and careful driver."
                                            },
                                            {
                                                "example_id": "5ee3284a-d576-41b6-9b0d-2e2888cb51b7",
                                                "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                                "text": "Be very careful while trekking through the jungle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Conscientious and painstaking; meticulous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd90f9a-e845-4124-939b-646e2e278746",
                                                "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                                "text": "They made a careful search of the crime scene."
                                            },
                                            {
                                                "example_id": "d4eaaa64-c486-4df0-b413-c449c3ba1776",
                                                "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                                "text": "At the same time, we were cognisant that careful scholars should never solely rely on their own impressionistic observations, and, that our own impressions were inexact and not capable of being quantified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3f5b5c-0245-3a6b-8a41-221f1512b687",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Full of care or grief; sorrowful, sad."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Full of cares or anxiety; worried, troubled."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2baf3193-1792-4787-bbc4-e9cc9ece0e39",
                                                "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                                                "text": "Where through long watch, and late daies weary toile, / She soundly slept, and carefull thoughts did quite assoile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5336012-4d55-4b3b-b787-c094d05dc9fd",
                        "source_entry_id": "96f6555b-3f85-3280-9a78-d031a41c86b2",
                        "source_sense_id": "782f8745-a1a6-32e4-9449-e34f74075ba6",
                        "target_lang_word": "precautionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precautionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                                        "entry_id": "f5a7eb42-42fd-3042-adf5-c6b3ad89c7a8",
                                        "glosses": [
                                            "Of, pertaining to, or serving as a precaution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376b11b6-0fe5-4fbf-bb69-5593a7cc3d15",
                                                "sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                                                "text": "The port cities were quarantined as a precautionary measure, though no cases of the disease had been found."
                                            },
                                            {
                                                "example_id": "fa11b3da-e4e6-4611-9c69-47244a5dfdee",
                                                "sense_id": "efd1d092-cc6c-38a4-bcc6-c3ab25b21dcf",
                                                "text": "Fearing attack on the northern ports by the English, he even took precautionary measures by strengthening the defense of Shan-hai-kuan 山海關 and Ch‘in-huang-tao 秦皇島."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "precautionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e27507bc-ddf9-390c-b36d-9aa9c787b5a9",
                                        "entry_id": "aca6f0ff-966b-3210-bbe7-afd8debf2c5f",
                                        "glosses": [
                                            "A precaution."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c388e378-aaee-407a-a039-193315a3134c",
                                                "sense_id": "e27507bc-ddf9-390c-b36d-9aa9c787b5a9",
                                                "text": "Thou seest, Belford, by the above precautionaries, that I forget nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
