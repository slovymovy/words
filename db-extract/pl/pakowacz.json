                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Packer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3217dece-8da7-30b6-a695-bb64b14e288d",
                                        "entry_id": "0623b437-ff2c-3c10-a42d-1408eaf20709",
                                        "glosses": [
                                            "eine Person, die Waren einpackt oder verpackt, ein Hilfsberuf innerhalb der Logistik oder Produktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ef0b25-d314-4620-a06a-6fbdbbdf2868",
                                                "sense_id": "3217dece-8da7-30b6-a695-bb64b14e288d",
                                                "text": "Sag dem Packer, das Klavier kommt ins fünfte Obergeschoss."
                                            },
                                            {
                                                "example_id": "d2400e86-0929-4e79-b285-2cc4e06b8435",
                                                "sense_id": "3217dece-8da7-30b6-a695-bb64b14e288d",
                                                "text": "„Die Auslieferung der Kalender wurde immer in die Sommermonate gelegt, da waren Semesterferien, und als Packer wurden Studenten engagiert.“"
                                            },
                                            {
                                                "example_id": "ced26945-e69b-4b5d-8071-6f48cdeac3bb",
                                                "sense_id": "3217dece-8da7-30b6-a695-bb64b14e288d",
                                                "text": "„Die Packer erschienen mit einem Mahagonibüfett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2842c37-b40d-36eb-9f76-162bff008aba",
                                        "entry_id": "0623b437-ff2c-3c10-a42d-1408eaf20709",
                                        "glosses": [
                                            "Komprimierungsprogramm"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9610ed83-2c3e-471b-bf27-7e4cd3910154",
                                                "sense_id": "b2842c37-b40d-36eb-9f76-162bff008aba",
                                                "text": "Um die Dateien zu komprimieren benötigt man einen Packer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7c2f1d69-35b3-3e96-8754-511a12066963",
                                        "entry_id": "0623b437-ff2c-3c10-a42d-1408eaf20709",
                                        "glosses": [
                                            "ein muskulöser, durchtrainierter, kräftig, sportlich aussehender Mann"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120fcf7e-c123-4d12-8623-d52401e8b969",
                                                "sense_id": "7c2f1d69-35b3-3e96-8754-511a12066963",
                                                "text": "Der Packer vorm Eingang wirkte eher abschreckend als einladend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Packer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed41f1c7-f2ed-3b75-b752-2c9a38e43908",
                                        "entry_id": "a5daa5c7-b1d8-3ea3-b3c5-1c177daa4e16",
                                        "glosses": [
                                            "eine in der Unterhose getragene, Penis und Hoden nachahmende Prothese"
                                        ],
                                        "tags": [
                                            "LSBT"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2268b9ff-5d1e-4e19-96ef-81b29a56a902",
                                                "sense_id": "ed41f1c7-f2ed-3b75-b752-2c9a38e43908",
                                                "text": "„Ich habe eine sichere Methode, Komplimente für mein Aussehen zu angeln: Ich klebe mir einen Bart. Es braucht nichts weiter als das – keinen Dreiteiler, keinen in den Schritt gestopften Packer, nicht einmal einen Brustbinder.“"
                                            },
                                            {
                                                "example_id": "fd46808e-5d22-42b0-85a4-17f66c47f9ae",
                                                "sense_id": "ed41f1c7-f2ed-3b75-b752-2c9a38e43908",
                                                "text": "„Wieso ist der Packer, den ich doch nur bis zur OP zum Ausbeulen der Hose tragen will, so unnatürlich groß?“"
                                            },
                                            {
                                                "example_id": "522a1bf1-c8b3-4f2f-899b-1aaa4062b31d",
                                                "sense_id": "ed41f1c7-f2ed-3b75-b752-2c9a38e43908",
                                                "text": "„Er trägt einen Packer, einen Kunstpenis, er trägt ein Kompressionsshirt, das seine Brust flach macht.“"
                                            },
                                            {
                                                "example_id": "778e9be7-4510-40ab-9172-2502b48acb8d",
                                                "sense_id": "ed41f1c7-f2ed-3b75-b752-2c9a38e43908",
                                                "text": "„Ein Packer ist eine Penisnachbildung in Form einer Silikonprothese und wird als ‚Penisersatz‘ in der Unterwäsche getragen.“"
                                            },
                                            {
                                                "example_id": "bb657945-7b91-4e39-82d2-5494875cd77d",
                                                "sense_id": "ed41f1c7-f2ed-3b75-b752-2c9a38e43908",
                                                "text": "„Anfangs kann man Hilfsmittel wie Packer oder Penisprothesen benutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
