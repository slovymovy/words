                        "examples": [
                            {
                                "example_id": "c5a47c34-3b0a-4f9b-96e4-0dfb5a675b43",
                                "sense_id": "f4797e88-0eff-3444-ade4-d019c8e9e7e4",
                                "text": "En 1606, l'ordre de Malte, auto-exempté, finit par accepter de verser 30 000 livres annuelles à titre de décimes."
                            },
                            {
                                "example_id": "e5e6e3a4-dd39-4d81-9950-d8c7b41c8bce",
                                "sense_id": "f4797e88-0eff-3444-ade4-d019c8e9e7e4",
                                "text": "Il a réparti les tâches et s'est auto-exempté de débarrassage de table puisqu'il allait nous faire un bon gâteau !"
                            },
                            {
                                "example_id": "5e571698-7cf8-4ac9-b04e-eee60ab000fa",
                                "sense_id": "f4797e88-0eff-3444-ade4-d019c8e9e7e4",
                                "text": "Et surtout, trois grands pollueurs (Canada, Russie, Japon) s'en sont retirés, excédés de voir les deux plus gros, Chine et USA s'auto-exempter."
                            }
                        ]
                    }
