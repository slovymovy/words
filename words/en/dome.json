{
    "word_family": [
        "domed",
        "domical",
        "subdome",
        "semidome"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50b69f0e-d323-35e9-8352-e0e0be8a6b10",
                    "sense_definition": "A rounded roof or ceiling on a building that resembles the upper half of a sphere.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shape_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral is famous for its magnificent golden <w>dome</w>.",
                            "target_lang_translations": {
                                "ru": "Собор знаменит своим великолепным золотым <w>куполом</w>.",
                                "zh": "这座大教堂以其宏伟的金色<w>圆顶</w>而闻名。",
                                "es": "La catedral es famosa por su magnífica <w>cúpula</w> dorada."
                            }
                        },
                        {
                            "text": "We climbed the stairs to the top of the <w>dome</w> to see the city view.",
                            "target_lang_translations": {
                                "ru": "Мы поднялись по лестнице на вершину <w>купола</w>, чтобы увидеть панораму города.",
                                "zh": "我们爬上楼梯到了<w>圆顶</w>顶部，去看城市的景色。",
                                "es": "Subimos las escaleras hasta la parte superior de la <w>cúpula</w> para ver la ciudad."
                            }
                        }
                    ],
                    "synonyms": [
                        "cupola"
                    ],
                    "common_phrases": [
                        "golden dome",
                        "glass dome",
                        "cathedral dome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Округлая крыша или потолок здания, напоминающие верхнюю половину сферы.",
                        "zh": "建筑物上呈半球上半部形状的圆形屋顶或天花板。",
                        "es": "Techo o cubierta redondeada de un edificio que se asemeja a la mitad superior de una esfera."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купол",
                                "target_lang_sense_clarification": "архитектурное сооружение"
                            },
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "тип перекрытия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆顶",
                                "target_lang_sense_clarification": "建筑物顶部的半球形屋顶"
                            },
                            {
                                "target_lang_word": "穹顶",
                                "target_lang_sense_clarification": "较书面，多用于建筑"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cúpula",
                                "target_lang_sense_clarification": "elemento arquitectónico semiesférico"
                            },
                            {
                                "target_lang_word": "domo",
                                "target_lang_sense_clarification": "construcción hemisférica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "959b3b71-5aca-3c2e-8c76-0911f760794d",
                    "sense_definition": "An object or cover shaped like a rounded bowl turned upside down.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter lifted the silver <w>dome</w> to reveal the dinner.",
                            "target_lang_translations": {
                                "ru": "Официант поднял серебряный <w>колпак</w>, чтобы показать ужин.",
                                "zh": "服务员掀开银色<w>罩盖</w>，露出了晚餐。",
                                "es": "El camarero levantó la <w>campana</w> de plata para revelar la cena."
                            }
                        },
                        {
                            "text": "A <w>dome</w> of high pressure caused the heatwave to persist for days.",
                            "target_lang_translations": {
                                "ru": "<w>Купол</w> высокого давления стал причиной того, что жара держалась несколько дней.",
                                "zh": "高压<w>穹顶</w>使这场热浪持续了好几天。",
                                "es": "Un <w>domo</w> de alta presión hizo que la ola de calor persistiera durante días."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheese dome",
                        "cake dome",
                        "heat dome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или крышка в форме перевернутой круглой чаши.",
                        "zh": "形状像倒扣圆碗的物体或罩盖。",
                        "es": "Objeto o cubierta con forma de cuenco redondeado invertido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колпак",
                                "target_lang_sense_clarification": "крышка для еды или предметов"
                            },
                            {
                                "target_lang_word": "купол",
                                "target_lang_sense_clarification": "форма атмосферного явления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆罩",
                                "target_lang_sense_clarification": "像倒扣碗一样的罩子或盖子"
                            },
                            {
                                "target_lang_word": "罩盖",
                                "target_lang_sense_clarification": "尤指食物上方的盖子"
                            },
                            {
                                "target_lang_word": "穹顶",
                                "target_lang_sense_clarification": "比喻用法，如“热穹顶”"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "campana",
                                "target_lang_sense_clarification": "cubierta para mantener el calor de los alimentos"
                            },
                            {
                                "target_lang_word": "tapa",
                                "target_lang_sense_clarification": "cubierta protectora"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b81a2760-2a36-3a51-a145-af0dbb0eaa98",
                    "sense_definition": "A person's head or brain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bumped his <w>dome</w> on the low doorframe while walking in.",
                            "target_lang_translations": {
                                "ru": "Он ударился <w>башкой</w> о низкий дверной косяк, когда входил.",
                                "zh": "他进门时，<w>脑袋</w>撞到了低矮的门框。",
                                "es": "Se golpeó el <w>coco</w> con el marco bajo de la puerta al entrar."
                            }
                        },
                        {
                            "text": "You need to use your <w>dome</w> and think before you make a decision.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно пошевелить <w>котелком</w> и подумать, прежде чем принимать решение.",
                                "zh": "你得先动动<w>脑子</w>，再做决定。",
                                "es": "Necesitas usar la <w>cabeza</w> y pensar antes de tomar una decisión."
                            }
                        }
                    ],
                    "synonyms": [
                        "head",
                        "brain"
                    ],
                    "common_phrases": [
                        "off the dome"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Голова или мозг человека (сленг).",
                        "zh": "人的头或脑子；俚语说法。",
                        "es": "La cabeza o el cerebro de una persona (jerga)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "разговорное/грубое"
                            },
                            {
                                "target_lang_word": "котелок",
                                "target_lang_sense_clarification": "голова как орган мышления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脑袋",
                                "target_lang_sense_clarification": "口语，指头"
                            },
                            {
                                "target_lang_word": "脑子",
                                "target_lang_sense_clarification": "强调思考能力时常用"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cabeza",
                                "target_lang_sense_clarification": "término coloquial"
                            },
                            {
                                "target_lang_word": "coco",
                                "target_lang_sense_clarification": "jerga para referirse a la cabeza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec528529-7f62-3b3d-92bf-a30f347e3383",
                    "sense_definition": "A geological formation where rock layers slope downward from a central point, forming a rounded shape.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists discovered a large salt <w>dome</w> beneath the surface.",
                            "target_lang_translations": {
                                "ru": "Геологи обнаружили большой соляной <w>купол</w> под поверхностью.",
                                "zh": "地质学家在地表下发现了一个大型盐<w>穹丘</w>。",
                                "es": "Los geólogos descubrieron un gran <w>domo</w> salino bajo la superficie."
                            }
                        },
                        {
                            "text": "The volcanic <w>dome</w> was formed by viscous lava piling up near the vent.",
                            "target_lang_translations": {
                                "ru": "Вулканический <w>купол</w> образовался из вязкой лавы, скопившейся возле жерла.",
                                "zh": "这个火山<w>穹丘</w>是由火山口附近黏稠熔岩堆积形成的。",
                                "es": "El <w>domo</w> volcánico se formó por la acumulación de lava viscosa cerca del cráter."
                            }
                        }
                    ],
                    "common_phrases": [
                        "salt dome",
                        "lava dome"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "geology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Геологическое образование, в котором слои горных пород спускаются вниз от центральной точки, образуя округлую форму.",
                        "zh": "一种地质构造；岩层围绕中心形成圆拱状的隆起。",
                        "es": "Formación geológica donde las capas de roca se inclinan hacia abajo desde un punto central, formando una figura redondeada."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купол",
                                "target_lang_sense_clarification": "геология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穹丘",
                                "target_lang_sense_clarification": "地质学用语，指圆拱状隆起体"
                            },
                            {
                                "target_lang_word": "穹隆",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "domo",
                                "target_lang_sense_clarification": "formación geológica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81756594-e8e5-3231-a99e-3ea798a63aba",
                    "sense_definition": "A small metal snap fastener used on clothing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One of the <w>domes</w> on my jacket has come loose.",
                            "target_lang_translations": {
                                "ru": "Одна из <w>кнопок</w> на моей куртке разболталась.",
                                "zh": "我夹克上的一个<w>按扣</w>松了。",
                                "es": "Uno de los <w>corchetes</w> de mi chaqueta se ha soltado."
                            }
                        },
                        {
                            "text": "She pressed the <w>dome</w> until it clicked shut to secure the pocket.",
                            "target_lang_translations": {
                                "ru": "Она нажала на <w>кнопку</w> до щелчка, чтобы застегнуть карман.",
                                "zh": "她按下那个<w>按扣</w>，直到咔嗒一声扣上，把口袋固定好。",
                                "es": "Presionó el <w>botón</w> hasta que hizo clic para asegurar el bolsillo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly New Zealand and Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая металлическая застежка-кнопка на одежде.",
                        "zh": "衣物上使用的小型金属揿扣。",
                        "es": "Un pequeño cierre metálico a presión utilizado en la ropa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кнопка",
                                "target_lang_sense_clarification": "застежка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按扣",
                                "target_lang_sense_clarification": "衣物上的金属摁扣"
                            },
                            {
                                "target_lang_word": "摁扣",
                                "target_lang_sense_clarification": "口语常说法"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "corchete",
                                "target_lang_sense_clarification": "tipo de cierre metálico"
                            },
                            {
                                "target_lang_word": "botón a presión",
                                "target_lang_sense_clarification": "cierre de ropa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e9277a3-1869-3de2-83ca-afe7039021b6",
                    "sense_definition": "To shape something into a rounded, convex form.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker <w>domed</w> the top of the loaf before putting it in the oven.",
                            "target_lang_translations": {
                                "ru": "Пекарь <w>закруглил</w> верхушку буханки перед тем, как поставить её в печь.",
                                "zh": "面包师在把面包送进烤箱前，把顶部<w>拱起</w>了一些。",
                                "es": "El panadero <w>abombó</w> la parte superior de la hogaza antes de meterla en el horno."
                            }
                        },
                        {
                            "text": "Underground pressure <w>domed</w> the landscape over millions of years.",
                            "target_lang_translations": {
                                "ru": "Подземное давление <w>выгнуло куполом</w> ландшафт в течение миллионов лет.",
                                "zh": "地下压力在数百万年间使这片地貌<w>隆起</w>成穹顶状。",
                                "es": "La presión subterránea <w>arqueó</w> el paisaje a lo largo de millones de años."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо округлую, выпуклую форму.",
                        "zh": "使某物形成圆鼓鼓的凸起形状。",
                        "es": "Dar a algo una forma redondeada y convexa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закруглять",
                                "target_lang_sense_clarification": "делать круглым сверху"
                            },
                            {
                                "target_lang_word": "выгибать куполом",
                                "target_lang_sense_clarification": "деформировать вверх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拱起",
                                "target_lang_sense_clarification": "使表面鼓起或呈拱形"
                            },
                            {
                                "target_lang_word": "隆起",
                                "target_lang_sense_clarification": "使形成圆顶状的隆起"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "abombar",
                                "target_lang_sense_clarification": "dar forma convexa"
                            },
                            {
                                "target_lang_word": "arquear",
                                "target_lang_sense_clarification": "dar forma curva"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32d5b073-870a-3c47-9d32-029af566b653",
                    "sense_definition": "To shoot someone in the head.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sniper <w>domed</w> the enemy player from across the map.",
                            "target_lang_translations": {
                                "ru": "Снайпер <w>снес башку</w> вражескому игроку через всю карту.",
                                "zh": "狙击手隔着整张地图就把敌方玩家<w>爆头</w>了。",
                                "es": "El francotirador le <w>voló la cabeza</w> al jugador enemigo desde el otro lado del mapa."
                            }
                        },
                        {
                            "text": "He got <w>domed</w> instantly when he stepped out of cover.",
                            "target_lang_translations": {
                                "ru": "Ему мгновенно <w>прострелили голову</w>, когда он вышел из укрытия.",
                                "zh": "他一走出掩体就瞬间被<w>爆头</w>了。",
                                "es": "Le <w>dispararon en la cabeza</w> al instante cuando salió de su cobertura."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "video games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выстрелить кому-то в голову (игровой сленг).",
                        "zh": "朝某人的头部开枪；多见于电子游戏俚语。",
                        "es": "Disparar a alguien en la cabeza (jerga de videojuegos)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попасть в голову",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "снести башку",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆头",
                                "target_lang_sense_clarification": "游戏俚语，指打中头部并击杀"
                            },
                            {
                                "target_lang_word": "击中头部",
                                "target_lang_sense_clarification": "较中性说法"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dar un tiro en la cabeza",
                                "target_lang_sense_clarification": "sentido literal"
                            },
                            {
                                "target_lang_word": "volar la cabeza",
                                "target_lang_sense_clarification": "jerga agresiva"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "62c368ed-e517-3952-bed4-74715c32b538",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Dome</w> signed the guestbook at the reception.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Доум</w> расписался в гостевой книге на стойке регистрации.",
                                "zh": "<w>多姆</w>先生在前台的来宾簿上签了名。",
                                "es": "El señor <w>Dome</w> firmó el libro de visitas en la recepción."
                            }
                        },
                        {
                            "text": "We are looking for records of the <w>Dome</w> family in this town.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье <w>Доум</w> в этом городе.",
                                "zh": "我们正在寻找这个镇上<w>多姆</w>家族的记录。",
                                "es": "Estamos buscando registros de la familia <w>Dome</w> en este pueblo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。",
                        "es": "Un apellido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Доум",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多姆",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Dome",
                                "target_lang_sense_clarification": "apellido"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}