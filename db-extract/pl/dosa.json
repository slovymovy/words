                "senses": [
                    {
                        "sense_id": "4adb3638-4c26-30b7-bcc8-53000a764350",
                        "entry_id": "e9129e7e-9d4f-324b-b44c-b60d37efcc30",
                        "glosses": [
                            "kruchy i cienki naleśnik przygotowywany z soczewicy lub fasoli oraz fermentowanej mąki ryżowej; danie tradycyjnej kuchni indyjskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ddc3ecd-ce79-4e7f-a741-f01b22dd9c64",
                                "sense_id": "4adb3638-4c26-30b7-bcc8-53000a764350",
                                "text": "Tradycyjne dosy podawane w indyjskich restauracjach mają średnicę ponad 30 cm"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67613d9d-de77-44dc-ae89-a457e7539ef0",
                        "source_entry_id": "e9129e7e-9d4f-324b-b44c-b60d37efcc30",
                        "source_sense_id": "4adb3638-4c26-30b7-bcc8-53000a764350",
                        "target_lang_word": "dosa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dosa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                        "entry_id": "736abdd0-9b57-3fa7-b28b-1382a9037aa3",
                                        "glosses": [
                                            "A type of thin south Indian pancake made from fermented lentils and rice blended with water, typically served with chutney or sambar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df50fe7f-a60e-4162-ab1f-6d96afdd953a",
                                                "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                                "text": "Eric dipped a piece of the dosa in the coconut chutney."
                                            },
                                            {
                                                "example_id": "8b8cb4aa-1c29-4bc4-8134-815c581ed215",
                                                "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                                "text": "The restaurant's dosas were truly atrocious, so I stopped going there."
                                            },
                                            {
                                                "example_id": "69b58a92-67c4-4359-838d-5b3f122665bb",
                                                "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                                "text": "In those days she had admired his pluralistic openness of mind, and struggled, in her kitchen, towards a parallel eclecticism, learning to cook the dosas and uttapams of South India as well as the soft meatballs of Kashmir."
                                            },
                                            {
                                                "example_id": "d1242385-cf11-40e6-97ea-1f541d679131",
                                                "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                                "text": "I carried the Mongoose's bags to the right carriage of the train, then went to a stall and bought a dosa, wrapped in paper, for him."
                                            },
                                            {
                                                "example_id": "614b33cf-2bde-4719-aa22-333338d29bb1",
                                                "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                                "text": "These condiments are provided as something for you to dip your dosa into. The dosa wrap itself has a slight tang to it, as it is a fermented bread made from rice and lentils, and is light and delicious."
                                            },
                                            {
                                                "example_id": "3281dafe-8b54-4597-b5d5-d9a0c9a3be33",
                                                "sense_id": "d2a63b9c-7c9c-3dfb-8af3-5b5b91cad6bd",
                                                "text": "The dosas all came with coconut chutney and sambar, a lentil broth — good dipping condiments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
