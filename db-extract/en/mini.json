                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1277f40a-4e17-4643-bafa-734427227cec",
                                "sense_id": "3c926336-8f1d-3792-9f52-5abb78fdb25d",
                                "text": "All Normal Catholic Schoolgirls had creative ways of sluttifying our pure-as-the-driven-snow required attire. […] Most important is rolling your skirt so that it is a virtual mini […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "83b8bdb0-d00b-352e-8e67-55beb26658b0",
                        "entry_id": "7cfd85c2-43ec-3887-84f8-f819b567524e",
                        "glosses": [
                            "Abbreviation of minicomputer."
