    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad13bbd3-7f5f-32b4-8330-374017e6feeb",
                    "sense_definition": "Een oogziekte die gekenmerkt wordt door een vertroebeling van de ooglens (cataract).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oogziekte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude hond heeft last van <w>staar</w> en kan niet meer goed zien in het donker.",
                            "target_lang_translations": {
                                "en": "The old dog suffers from <w>cataracts</w> and can no longer see well in the dark."
                            }
                        },
                        {
                            "text": "De arts legde uit dat een operatie aan <w>staar</w> tegenwoordig heel snel en veilig verloopt.",
                            "target_lang_translations": {
                                "en": "The doctor explained that <w>cataract</w> surgery is very quick and safe nowadays."
                            }
                        }
                    ],
                    "synonyms": [
                        "cataract"
                    ],
                    "common_phrases": [
                        "operatie aan staar",
                        "last van staar"
                    ],
                    "target_lang_definitions": {
                        "en": "An eye disease characterized by a clouding of the lens of the eye (cataract)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cataract",
                                "target_lang_sense_clarification": "medical condition of the eye"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4397db-61a2-339a-ba58-915c24566285",
                    "sense_definition": "Een oogziekte die gekenmerkt wordt door een verhoogde druk van het glasvocht (groene <w>staar</w> of glaucoom).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oogziekte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de oogmeting werd een verhoogde oogdruk geconstateerd, wat kan wijzen op groene <w>staar</w>.",
                            "target_lang_translations": {
                                "en": "During the eye test, elevated eye pressure was detected, which may indicate <w>glaucoma</w>."
                            }
                        },
                        {
                            "text": "Als groene <w>staar</w> niet op tijd behandeld wordt, kan dit leiden tot blijvende schade aan de oogzenuw.",
                            "target_lang_translations": {
                                "en": "If <w>glaucoma</w> is not treated in time, it can lead to permanent damage to the optic nerve."
                            }
                        }
                    ],
                    "synonyms": [
                        "glaucoom"
                    ],
                    "common_phrases": [
                        "groene staar"
                    ],
                    "target_lang_definitions": {
                        "en": "An eye disease characterized by increased pressure of the vitreous humor (green cataract or glaucoma)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glaucoma",
                                "target_lang_sense_clarification": "medical condition of increased eye pressure"
                            }
                        ]
                    }
                },
                {
