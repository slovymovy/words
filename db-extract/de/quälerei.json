                ],
                "senses": [
                    {
                        "sense_id": "e4c92a22-4ecc-38be-834c-0ff7a7fee7b2",
                        "entry_id": "91812718-45ee-3a9f-ab00-84728e8307ba",
                        "glosses": [
                            "andauernde Verursachung von Qualen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08377a5a-283d-477c-97da-f47ab7aaa555",
                                "sense_id": "e4c92a22-4ecc-38be-834c-0ff7a7fee7b2",
                                "text": "Die Quälerei der Gefangenen machte ihm sogar Vergnügen."
                            },
                            {
                                "example_id": "66f2d19e-9d3e-42ed-94e9-35fd90dc96a6",
                                "sense_id": "e4c92a22-4ecc-38be-834c-0ff7a7fee7b2",
                                "text": "„Und trotzdem setzte sie sich dieser Quälerei immer wieder aus.“"
                            },
                            {
                                "example_id": "abb4510c-c2ed-469d-b6da-955d68e65cf8",
                                "sense_id": "e4c92a22-4ecc-38be-834c-0ff7a7fee7b2",
                                "text": "„Beim Nachtmahl sagte er mir, nur über eines sei er glücklich, daß er den Klauen der Mönche entronnen sei, deren Quälereien fünfzehn Jahre hindurch für ihn ein Fegefeuer gewesen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9038fa2d-ffb4-3a21-ba81-e1e3bda1981d",
                        "entry_id": "91812718-45ee-3a9f-ab00-84728e8307ba",
                        "glosses": [
                            "das Vorhandensein von Qualen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522049ab-4bd5-4834-8964-cea5bdd3a4de",
                                "sense_id": "9038fa2d-ffb4-3a21-ba81-e1e3bda1981d",
                                "text": "Das Leben im Alter ist manchmal eine Quälerei."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1b406481-7b77-354c-b505-5b26c6ff6749",
                        "entry_id": "91812718-45ee-3a9f-ab00-84728e8307ba",
                        "glosses": [
                            "eine Qualen verursachende Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d082f6c-7fde-4937-a57d-34c04b9c0cd9",
                                "sense_id": "1b406481-7b77-354c-b505-5b26c6ff6749",
                                "text": "Das Lernen auf die Abiturprüfungen war die reinste Quälerei."
                            },
                            {
                                "example_id": "dfa7c590-c6bd-48b6-b617-081897097571",
                                "sense_id": "1b406481-7b77-354c-b505-5b26c6ff6749",
                                "text": "„Aber es gab auch Quälereien genug; Stockschläge, wenn die Grußordnung verletzt wurde, und bewusste Demütigungen, wenn es den kleinen Göttern der SS oder der Lagerhierarchie gefiel.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
