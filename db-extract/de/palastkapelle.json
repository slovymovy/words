                ],
                "senses": [
                    {
                        "sense_id": "6726388e-7dc4-37af-9ea7-b0517a984e8b",
                        "entry_id": "efdb4481-4178-39e7-a360-a83253981141",
                        "glosses": [
                            "kirchliche Kapelle an einem Palast oder selbst wie ein Palast gebaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7803b7-0ef4-48e5-b9eb-f1977bcaebaa",
                                "sense_id": "6726388e-7dc4-37af-9ea7-b0517a984e8b",
                                "text": "„Der Älteste Teil, das Oktogon, war die Palastkapelle von Karl dem Großen und wurde im Zeitraum 790-800 n.Chr. im Karolingischem Stil errichtet.“"
                            },
                            {
                                "example_id": "93ed6bb9-25fc-47ee-a86c-851f3f11633a",
                                "sense_id": "6726388e-7dc4-37af-9ea7-b0517a984e8b",
                                "text": "„Nach der Eroberung Ravennas durch die Byzantiner wurde die Palastkapelle Theoderichs vom Bischof der Stadt konfisziert und im Zuge der Rekatholisierung offenbar stark umgestaltet.“"
                            },
                            {
                                "example_id": "641dfffb-c46f-42c4-b116-a44728347db9",
                                "sense_id": "6726388e-7dc4-37af-9ea7-b0517a984e8b",
                                "text": "„Als Ergebnis konnten sechs Bauphasen gegeneinander abgegrenzt werden, die von der Vorgängerbebauung über die Errichtungs- und Erweiterungsphasen der Palastkapelle bis hin zu den Umbau- und Restaurierungsmaßnahmen des 20./21. Jahrhunderts reichen.“"
                            },
                            {
                                "example_id": "3268472d-3213-449f-a529-53bb976bbbd3",
                                "sense_id": "6726388e-7dc4-37af-9ea7-b0517a984e8b",
                                "text": "„Es war eine ganz besondere Stunde in der 1200jährigen Geschichte der einstigen Palastkapelle Karls des Großen, ein Fixpunkt, der sich alle sieben Jahre wiederholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
