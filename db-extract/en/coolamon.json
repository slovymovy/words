                        "glosses": [
                            "A vessel with curved sides, typically of wood or bark, used by Australian Aboriginals for holding water, collecting berries etc."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "fc3bb371-6207-484d-8f57-b8510bba6706",
                                "sense_id": "742cccf1-3916-30cd-af6b-574b8208621a",
                                "text": "Yinti was perishing for a drink of water. He fell down on the sand, and put his mouth to the coolamon."
                            },
                            {
                                "example_id": "6256b680-bd2f-477a-9821-2ac8c9387279",
                                "sense_id": "742cccf1-3916-30cd-af6b-574b8208621a",
                                "text": "Wiradjuri people in New South Wales also built large dams, and then carried fish and yabbies in coolamons over large distances to stock the new waterholes."
                            }
                        ]
