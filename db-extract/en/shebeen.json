                "senses": [
                    {
                        "sense_id": "23ddb4e1-33c9-30d8-b0be-80167dd2e8c7",
                        "entry_id": "b264f501-22c7-330c-8bc9-d2d1248828e6",
                        "glosses": [
                            "An unlicensed drinking establishment, especially in Ireland, Scotland, and South Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74397a24-a019-4e02-b2d4-e3ffaa191748",
                                "sense_id": "23ddb4e1-33c9-30d8-b0be-80167dd2e8c7",
                                "text": "‘Well, let's line,’ he said to Ben. ‘We can fill up at a shebeen.’"
                            },
                            {
                                "example_id": "0bfc75aa-323a-441a-b2fd-3f7790d28927",
                                "sense_id": "23ddb4e1-33c9-30d8-b0be-80167dd2e8c7",
                                "text": "On almost every corner there were shebeens, illegal saloons that were shacks where home-brewed beer was served."
                            },
                            {
                                "example_id": "f2d40589-2ad5-4de5-aa11-4d830bdaa26c",
                                "sense_id": "23ddb4e1-33c9-30d8-b0be-80167dd2e8c7",
                                "text": "[…]while across Ladbroke Grove, on the mainly black side, the Rio cafe into which I self-consciously tiptoed occasionally became the Mangrove restaurant, and All Saints Road the shebeen and dope-dealing capital of London, under the hammer of the police."
                            },
                            {
                                "example_id": "764f3294-2025-4a77-bbb2-9ae41c530802",
                                "sense_id": "23ddb4e1-33c9-30d8-b0be-80167dd2e8c7",
                                "text": "Every night and day there were bombs and gunshots and riots and roundups, and it didn't take long to gain access to the bars and shebeens where these things were discussed with a certain knowingness."
                            }
                        ]
                    }
                ],
