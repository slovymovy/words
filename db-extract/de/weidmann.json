                                    {
                                        "sense_id": "4aa9f3be-77e2-335d-a40c-61a1c3fa3b51",
                                        "entry_id": "9011ffa5-d233-3b5f-bb40-8423530698a0",
                                        "glosses": [
                                            "A hunter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "884348b1-ffa0-32e4-8517-2616a762cbde",
                                        "entry_id": "9011ffa5-d233-3b5f-bb40-8423530698a0",
                                        "glosses": [
                                            "A fox hunter."
                                        ],
