{
    "word_family": [
        "constrain",
        "constraint",
        "constrainment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8682b359-3c59-3d68-b6de-19971e02b761",
                    "sense_definition": "Forced or compelled to act in a certain way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>constrained</w> to apologize for his earlier rude behavior.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich <w>gedwongen</w> om zijn excuses aan te bieden voor zijn eerdere onbeleefde gedrag."
                            }
                        },
                        {
                            "text": "The company was <w>constrained</w> by law to provide safer working conditions.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf was wettelijk <w>verplicht</w> om voor veiligere werkomstandigheden te zorgen."
                            }
                        }
                    ],
                    "synonyms": [
                        "compelled",
                        "obliged",
                        "forced"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gedwongen of verplicht om op een bepaalde manier te handelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gedwongen",
                                "target_lang_sense_clarification": "verplicht door omstandigheden of autoriteit"
                            },
                            {
                                "target_lang_word": "verplicht",
                                "target_lang_sense_clarification": "gehouden om iets te doen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ff2be06-b815-350f-be8d-9b551e297eb3",
                    "sense_definition": "Kept within close bounds or restricted in movement or expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird lived in a <w>constrained</w> space inside the small cage.",
                            "target_lang_translations": {
                                "nl": "De vogel leefde in een <w>beperkte</w> ruimte in de kleine kooi."
                            }
                        },
                        {
                            "text": "Her <w>constrained</w> movements showed that she was feeling very nervous.",
                            "target_lang_translations": {
                                "nl": "Haar <w>beperkte</w> bewegingen lieten zien dat ze erg nerveus was."
                            }
                        }
                    ],
                    "synonyms": [
                        "confined",
                        "restricted",
                        "limited"
                    ],
                    "antonyms": [
                        "free",
                        "unrestricted"
                    ],
                    "target_lang_definitions": {
                        "nl": "Binnen nauwe grenzen gehouden of beperkt in beweging of expressie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beperkt",
                                "target_lang_sense_clarification": "binnen bepaalde grenzen gehouden"
                            },
                            {
                                "target_lang_word": "beknopt",
                                "target_lang_sense_clarification": "niet vrij of ruim"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3434411c-62f4-36dc-8c09-09d82d9bd6ca",
                    "sense_definition": "Simple past and past participle of <w>constrain</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of funds severely <w>constrained</w> the project.",
                            "target_lang_translations": {
                                "nl": "Gebrek aan middelen <w>beperkte</w> de voortgang van het project."
                            }
                        },
                        {
                            "text": "The heavy rain <w>constrained</w> the hikers to stay in their tents.",
                            "target_lang_translations": {
                                "nl": "De zware regen <w>dwong</w> de wandelaars om in hun tenten te blijven."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van dwingen of beperken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dwong",
                                "target_lang_sense_clarification": "verleden tijd van dwingen"
                            },
                            {
                                "target_lang_word": "beperkte",
                                "target_lang_sense_clarification": "verleden tijd van beperken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}