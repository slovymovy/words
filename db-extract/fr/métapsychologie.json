                        "sense_id": "db4630ac-e715-3435-9182-568ca5afce37",
                        "entry_id": "b3434262-fc4d-3fd7-b2b8-d725fbe5209c",
                        "glosses": [
                            "Ensemble des concepts théoriques formulés par la psychanalyse freudienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d353a959-8ac2-49cd-bcde-7aa323b5ad8f",
                                "sense_id": "db4630ac-e715-3435-9182-568ca5afce37",
                                "text": "Hypnose, transfert et suggestion : contribution à une métapsychologie du transfert."
                            },
                            {
                                "example_id": "dde127f7-b4d8-494d-8ad0-97c4e59d6311",
                                "sense_id": "db4630ac-e715-3435-9182-568ca5afce37",
                                "text": "La métapsychologie n'est autre que ce qui élève l'expérience analytique à la portée d'un savoir."
                            },
                            {
                                "example_id": "a93fc357-612d-4655-9513-dabc8cbe24b1",
                                "sense_id": "db4630ac-e715-3435-9182-568ca5afce37",
                                "text": "La « métapsychologie » désigne l'exploration, l'observation et la dénomination des phénomènes inconscients ; elle est le propre de la recherche psychanalytique, l'essence de la psychanalyse."
                            }
                        ]
                    }
