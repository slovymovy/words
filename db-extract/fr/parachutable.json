                        "entry_id": "ea29339d-748f-3440-9c0f-975f8470e88e",
                        "glosses": [
                            "Qui est préparé pour pouvoir être parachuté."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "e4e7c67e-77eb-4ae6-a3cc-a0dcdca1c2e7",
                                "sense_id": "9616e28c-f94c-3076-9062-61d5e0dd441f",
                                "text": "Le matériel d’anesthésie et de réanimation doit être conçu afin de s’adapter aux conditions extrêmes que l’on rencontre dans certains pays ; il doit être parachutable."
                            },
                            {
                                "example_id": "66beeb7e-3aaf-410a-bfbe-517241d91b87",
                                "sense_id": "9616e28c-f94c-3076-9062-61d5e0dd441f",
                                "text": "Sur le plan technique, l’ampleur de la menace nucléaire conduit à utiliser au maximum le camion et l’avion, et particulièrement le véhicule parachutable ou transportable par avion."
                            }
                        ]
                    }
