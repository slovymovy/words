                ],
                "senses": [
                    {
                        "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                        "entry_id": "82d2c87c-ae8d-3143-ab8c-2bad1526e4d9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c175ee5-998a-4617-bc52-a7de8a7d05e9",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Frau Veigl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8671ea03-ad2c-4d89-9ecf-16f8f074b2d2",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Herr Veigl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4178bc87-fa17-46d9-bda7-8d44bec02eff",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Die Veigls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f30aa152-db65-4a3f-bde4-1e795bfe803d",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Der Veigl trägt nie die Schals, die die Veigl ihm strickt."
                            },
                            {
                                "example_id": "712993d3-3a7b-44d5-826c-87e2d49aa515",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Veigl kommt, geht der Herr Veigl.“"
                            },
                            {
                                "example_id": "1995d27e-d34f-437c-b442-dd7538417c42",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Veigl kommt und geht."
                            },
                            {
                                "example_id": "02732151-ee60-4de9-9712-f8749124a9b3",
                                "sense_id": "672ace98-045e-3dcb-980a-62adc7c418fc",
                                "text": "Veigls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
