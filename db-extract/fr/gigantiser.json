                "senses": [
                    {
                        "sense_id": "879466cd-aff0-354c-aacf-bce205f0ff47",
                        "entry_id": "14613127-7375-3f08-83d1-7108a705b007",
                        "glosses": [
                            "Rendre géant, donner des proportions gigantesques à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cd709c7e-6081-49cc-b74e-be8f14cda727",
                                "sense_id": "879466cd-aff0-354c-aacf-bce205f0ff47",
                                "text": "Dans le cas de Juliette, Paris semble n’être qu’un prolongement de la prostituée, ce qui a pour effet de la gigantiser."
                            },
                            {
                                "example_id": "c6aebb00-6433-493e-b0f0-9755438bf66d",
                                "sense_id": "879466cd-aff0-354c-aacf-bce205f0ff47",
                                "text": "De plus, gigantiser ces problèmes, c’est aussi prendre le risque de leur faire dépasser leurs dimensions critiques propres au-delà desquelles les thérapeutiques traditionnelles sont inopérantes."
                            }
                        ]
                    }
