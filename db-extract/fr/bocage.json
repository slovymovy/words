        "fr-extract.jsonl": [
            {
                "entry_id": "9b0449a4-5641-3216-8335-9cc7ade2a17f",
                "word": "bocage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3fd57ca5-fbbd-4ede-85b1-25c565d9a0ed",
                        "entry_id": "9b0449a4-5641-3216-8335-9cc7ade2a17f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bocages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31e6bf20-6dff-3237-b312-330ab112cc73",
                        "entry_id": "9b0449a4-5641-3216-8335-9cc7ade2a17f",
                        "glosses": [
                            "Petit bois ; lieu ombragé pittoresque."
                        ],
                        "tags": [
                            "literary",
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "629a4eb8-60a2-48c2-aabc-0e227a441e05",
                                "sense_id": "31e6bf20-6dff-3237-b312-330ab112cc73",
                                "text": "La scène de la réconciliation, où Béatrix fit rejurer haine à l’épouse qui jouait, dit-elle, la comédie du lait répandu, se passa dans un vrai bocage où elle minaudait environnée de fleurs ravissantes, de jardinières d’un luxe effréné."
                            },
                            {
                                "example_id": "d4af4e16-455e-4963-a330-83bf9fabe697",
                                "sense_id": "31e6bf20-6dff-3237-b312-330ab112cc73",
                                "text": "La reconversion des oublieux a eu, au début du siècle dernier, un introït esthétisant, sans lequel ce retour à la chlorophylle, aux papillons et au bocage, ne nous paraîtrait pas aujourd'hui couler de source."
                            }
                        ]
                    },
                    {
                        "sense_id": "b30967eb-ae15-34bd-b420-44d7919c3fbc",
                        "entry_id": "9b0449a4-5641-3216-8335-9cc7ade2a17f",
                        "glosses": [
                            "Type de paysage où les champs et les prés sont coupés de haies vives et de bois."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "095d4740-3cf6-4e55-8931-471821eb8207",
                                "sense_id": "b30967eb-ae15-34bd-b420-44d7919c3fbc",
                                "text": "Vous trouverez la ferme de l’Abondance à la sortie du petit village de Vaux-sur-Lunain dans le bocage gâtinais, à 30 kilomètres au sud de Fontainebleau."
                            },
                            {
                                "example_id": "5425b3fe-5dda-4b65-a3c6-b188c408eeb4",
                                "sense_id": "b30967eb-ae15-34bd-b420-44d7919c3fbc",
                                "text": "Contrairement aux régions à habitat dispersé comme le bocage vendéen, les zones à habitat aggloméré ont vécu très durement la modernité."
                            },
                            {
                                "example_id": "060de89e-9983-4440-9329-fa217494eddf",
                                "sense_id": "b30967eb-ae15-34bd-b420-44d7919c3fbc",
                                "text": "Le reste n’est que bocages et fondrières où les Médoquins têtus ont ouvert de minuscules vignes et champs de maïs plantés en rizières."
                            }
                        ]
                    },
                    {
                        "sense_id": "35708e71-9e70-39f5-a5e7-4605df53b24c",
                        "entry_id": "9b0449a4-5641-3216-8335-9cc7ade2a17f",
                        "glosses": [
                            "Type de paysage propre à la Normandie où les champs et les prés sont enclos par des levées de terre portant des haies ou des rangées d’arbres qui marquent les limites des parcelles."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cee9f9a0-2664-4f20-a80a-ccad4149bcfa",
                                "sense_id": "35708e71-9e70-39f5-a5e7-4605df53b24c",
                                "text": "Il en profite pour se jeter dans un buisson d’orties en contrebas de la route. D’enclos en enclos, à travers le bocage normand, il peut s’enfuir vers la liberté. Pour lui, la guerre n’est pas finie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c07ff4a3-c790-4172-b916-e6b6562c15dc",
                        "source_entry_id": "9b0449a4-5641-3216-8335-9cc7ade2a17f",
                        "target_lang_word": "grove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9542b6fc-ad60-32e8-9aea-72b7d5fae0ff",
                                        "entry_id": "6e95d0c9-a495-3026-bf82-ee9834814301",
                                        "glosses": [
                                            "A small forest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f055001-e4d6-4e74-8556-b0c7e1bdaaa9",
                                                "sense_id": "9542b6fc-ad60-32e8-9aea-72b7d5fae0ff",
                                                "text": "Religious sodomy was practised by male prostitutes in the Hebrew temple groves, which was one of the abominations of Israel that Josiah cleared away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c16d30-07ce-3af5-b1fe-6420ef438a2a",
                                        "entry_id": "6e95d0c9-a495-3026-bf82-ee9834814301",
                                        "glosses": [
                                            "A small forest with minimal undergrowth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01c320a-1a0f-43e6-94c5-b2879cb8d1c7",
                                                "sense_id": "47c16d30-07ce-3af5-b1fe-6420ef438a2a",
                                                "text": "Near-synonym: woodland"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e25d03a0-be2e-376f-a019-b09f01a31c8c",
                                        "entry_id": "6e95d0c9-a495-3026-bf82-ee9834814301",
                                        "glosses": [
                                            "An orchard of fruit trees."
                                        ],
                                        "tags": [],
