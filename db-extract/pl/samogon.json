                "translations": [
                    {
                        "translation_id": "1de2de12-d221-4d78-8b4a-44ad20dd3afd",
                        "source_entry_id": "5a06259b-7735-38a0-aded-fb1bfd8e586e",
                        "source_sense_id": "8eea2677-2c2d-3a4e-890c-94097c266b72",
                        "target_lang_word": "самогон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самогон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                        "entry_id": "359bd2cb-9795-3eba-9a3a-ac2df866c13a",
                                        "glosses": [
                                            "алкогольный напиток высокой крепости домашнего приготовления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38669c5e-cc29-498f-bca1-5e0ec7bc7651",
                                                "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                                "text": "Большевики всё время разъезжают по Лебяжьем пьют самогон и курей жарют и запалили квартиры служащих от казармы и до краю."
                                            },
                                            {
                                                "example_id": "6776c02b-ebb4-41cb-9868-08963394eb51",
                                                "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                                "text": "Удалось, наконец, повидать, как изготовляют самогон."
                                            },
                                            {
                                                "example_id": "702e1ab4-ca0e-4355-856d-8e6d8852de8c",
                                                "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                                "text": "Выпил комиссар чашку самогону и уехал: спасибо, говорит, товарищ Пашинцев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56f090df-7a7b-4867-bcbb-d1fda8e445c2",
                        "source_entry_id": "5a06259b-7735-38a0-aded-fb1bfd8e586e",
                        "source_sense_id": "8eea2677-2c2d-3a4e-890c-94097c266b72",
                        "target_lang_word": "самогонка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самогонка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dd05693f-18ff-3268-9bb8-7c16c62a5716",
                                        "entry_id": "a30a7161-29c3-3385-9399-6fbb6f91e2b0",
                                        "glosses": [
                                            "прост. то же, что самогон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296e8804-829b-400c-a7a0-131b5246b913",
                                                "sense_id": "dd05693f-18ff-3268-9bb8-7c16c62a5716",
                                                "text": "Так вот с недельку походил по селу Ванюшка, стал, сукин сын, на радостях самогонку хлебать, за речку ездить повадился…"
                                            },
                                            {
                                                "example_id": "36211f6f-69a3-4195-bc72-8a6665114008",
                                                "sense_id": "dd05693f-18ff-3268-9bb8-7c16c62a5716",
                                                "text": "Оттого-то вросла тужиль // В переборы тальянки звонкой. // И соломой пропахший мужик // Захлебнулся лихой самогонкой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
