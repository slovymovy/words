{
    "word_family": [
        "odgrzać",
        "odgrzanie",
        "podgrzewać",
        "ogrzewać",
        "grzać",
        "gorący"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00e5faa9-7993-3ce2-8e6c-65753a437a65",
                    "sense_definition": "czynić ponownie ciepłym lub gorącym, zwłaszcza jedzenie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdego dnia po powrocie ze szkoły <w>odgrzewam</w> wczorajszy obiad w kuchence mikrofalowej.",
                            "target_lang_translations": {
                                "ru": "Каждый день после возвращения из школы я <w>разогреваю</w> вчерашний обед в микроволновке."
                            }
                        },
                        {
                            "text": "Kiedy wrócisz do domu, po prostu <w>odgrzej</w> zupę na małym ogniu.",
                            "target_lang_translations": {
                                "ru": "Когда вернёшься домой, просто <w>разогрей</w> суп на медленном огне."
                            }
                        }
                    ],
                    "synonyms": [
                        "podgrzewać"
                    ],
                    "antonyms": [
                        "studzić",
                        "mrozić"
                    ],
                    "common_phrases": [
                        "odgrzewać obiad",
                        "odgrzewać w mikrofalówce",
                        "odgrzewać zupę"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать снова тёплым или горячим, особенно о еде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разогревать",
                                "target_lang_sense_clarification": "делать снова горячим (о еде)"
                            },
                            {
                                "target_lang_word": "подогревать",
                                "target_lang_sense_clarification": "делать тёплым или горячим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "547683be-74c9-353b-835e-6f6ad10ba7e6",
                    "sense_definition": "wracać do starych, zapomnianych lub nieaktualnych spraw bądź tematów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przenośnie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziennikarze znowu <w>odgrzewają</w> dawny skandal, chociaż nikt już o nim nie pamiętał.",
                            "target_lang_translations": {
                                "ru": "Журналисты снова <w>ворошат</w> старый скандал, хотя о нём уже никто не помнил."
                            }
                        },
                        {
                            "text": "Nie warto bez końca <w>odgrzewać</w> starych sporów rodzinnych przy świątecznym stole.",
                            "target_lang_translations": {
                                "ru": "Не стоит бесконечно <w>ворошить</w> старые семейные споры за праздничным столом."
                            }
                        }
                    ],
                    "synonyms": [
                        "wznawiać",
                        "przypominać"
                    ],
                    "common_phrases": [
                        "odgrzewać stare spory",
                        "odgrzewać stare kotlety"
                    ],
                    "target_lang_definitions": {
                        "ru": "возвращаться к старым, забытым или неактуальным делам либо темам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворошить",
                                "target_lang_sense_clarification": "возвращаться к прошлому, воспоминаниям, спорам"
                            },
                            {
                                "target_lang_word": "мусолить",
                                "target_lang_sense_clarification": "постоянно возвращаться к старой теме"
                            },
                            {
                                "target_lang_word": "воскрешать",
                                "target_lang_sense_clarification": "возобновлять старое (например, тему или скандал)"
                            },
                            {
                                "target_lang_word": "разогревать",
                                "target_lang_sense_clarification": "о старых темах (калька / переносное значение)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da6b2624-fc92-329a-ac36-c20c847d78e5",
                    "sense_definition": "o jedzeniu: stawać się ciepłym w trakcie podgrzewania",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsty sos powoli <w>odgrzewa</w> się w garnku, więc musimy jeszcze chwilę poczekać.",
                            "target_lang_translations": {
                                "ru": "Густой соус медленно <w>разогревается</w> в кастрюле, поэтому нам нужно ещё немного подождать."
                            }
                        },
                        {
                            "text": "Zupa już <w>odgrzewa</w> się na małym ogniu, zaraz możemy usiąść do obiadu.",
                            "target_lang_translations": {
                                "ru": "Суп уже <w>подогревается</w> на медленном огне, скоро сможем садиться обедать."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "о еде: становиться тёплым или горячим в процессе нагревания (в форме odgrzewać się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разогреваться",
                                "target_lang_sense_clarification": "становиться горячим (о еде)"
                            },
                            {
                                "target_lang_word": "подогреваться",
                                "target_lang_sense_clarification": "становиться тёплым (о еде)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}