                    {
                        "sense_id": "87e52641-a4e3-3179-8e2c-0507977d012e",
                        "entry_id": "2f1d44bb-0482-325d-a045-822c82f6de6c",
                        "glosses": [
                            "durch Einwirkung von starker Wärme entstandener Schaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d897659e-c7b1-40c9-b88c-00b2836cb273",
                                "sense_id": "87e52641-a4e3-3179-8e2c-0507977d012e",
                                "text": "„Wegen der wichtigen Rolle der Transpirationskühlung treten Hitzeschäden bei Pflanzen im Freiland nur bei großer Wasserknappheit auf und sind deshalb von Trockenschäden gewöhnlich nicht zu unterscheiden.“"
                            },
                            {
                                "example_id": "073bbc17-ed5a-4b62-8bc2-d4f93268b993",
                                "sense_id": "87e52641-a4e3-3179-8e2c-0507977d012e",
                                "text": "„Nach dem Hitzeschaden auf der Autobahn 9 fahren Autobahnmeisterei und Polizei rund um die Uhr Streife auf dem betroffenen Abschnitt zwischen Weißenfels und Naumburg.“"
                            }
                        ],
