            {
                "entry_id": "9915a814-2166-3654-a72d-8427a081cdd0",
                "word": "gyrovague",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "364cc0ff-3211-41be-8f14-c87b2044bc76",
                        "entry_id": "9915a814-2166-3654-a72d-8427a081cdd0",
                        "tags": [
