                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liczby porządkowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To już <w>jedenasty</w> raz, kiedy spóźnił się na zajęcia.",
                            "target_lang_translations": {
                                "en": "This is already the <w>eleventh</w> time he has been late for class.",
                                "ru": "Это уже <w>одиннадцатый</w> раз, когда он опоздал на занятия.",
                                "nl": "Het is al de <w>elfde</w> keer dat hij te laat op de les komt.",
                                "de": "Das ist schon das <w>elfte</w> Mal, dass er zu spät zum Unterricht kommt.",
                                "fr": "C'est déjà la <w>onzième</w> fois qu'il est en retard en cours.",
                                "it": "È già l'<w>undicesima</w> volta che arriva in ritardo a lezione.",
                                "cs": "To už je <w>pojedenácté</w>, co přišel pozdě na hodinu.",
                                "tr": "Bu, derse geç kaldığı <w>on birinci</w> sefer oldu.",
                                "es": "Ya es la <w>undécima</w> vez que llega tarde a clase.",
                                "zh": "这已经是他<w>第十一</w>次上课迟到了。"
                            }
                        },
                        {
                            "text": "Mieszkam w bloku na <w>jedenastym</w> piętrze.",
                            "target_lang_translations": {
                                "en": "I live in an apartment building on the <w>eleventh</w> floor.",
                                "ru": "Я живу в многоэтажке на <w>одиннадцатом</w> этаже.",
                                "nl": "Ik woon in een flat op de <w>elfde</w> verdieping.",
                                "de": "Ich wohne in einem Wohnblock im <w>elften</w> Stock.",
                                "fr": "J'habite dans un immeuble au <w>onzième</w> étage.",
                                "it": "Vivo in un condominio all'<w>undicesimo</w> piano.",
                                "cs": "Bydlím v paneláku v <w>jedenáctém</w> patře.",
                                "tr": "Apartmanın <w>on birinci</w> katında oturuyorum.",
                                "es": "Vivo en un bloque de pisos, en el <w>undécimo</w> piso.",
                                "zh": "我住在这栋公寓楼的<w>十一</w>层。"
                            }
                        }
