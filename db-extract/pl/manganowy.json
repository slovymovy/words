                                        "sense_id": "1f270dae-4e58-3bdb-bc3b-7ff5e84487bf",
                                        "entry_id": "6aa7a366-6c47-39bf-8b1e-f3223f36c7ae",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным марганец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c12f18-bd43-4105-915f-113cf928cb92",
                                                "sense_id": "1f270dae-4e58-3bdb-bc3b-7ff5e84487bf",
                                                "text": "Марганцевые ру́ды делят на химические и металлургические."
                                            },
                                            {
                                                "example_id": "f9587714-034a-4a0c-ad74-f6727b6c9db9",
                                                "sense_id": "1f270dae-4e58-3bdb-bc3b-7ff5e84487bf",
                                                "text": "Наконец, нашёлся человек, который рекомендовал марганцевые ванны."
                                            },
                                            {
                                                "example_id": "92dff69a-5d2c-418a-afeb-ffb732be5e76",
                                                "sense_id": "1f270dae-4e58-3bdb-bc3b-7ff5e84487bf",
                                                "text": "Вот тут неподалёку ходил, уголёк нашёл… ❬…❭ И марганцевую руду нашёл…"
                                            }
                                        ]
                                    }
                                ]
                            }
