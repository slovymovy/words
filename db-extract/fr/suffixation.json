                    {
                        "sense_id": "75388769-de0e-38ce-bd51-afef7429dd63",
                        "entry_id": "c205c4f9-b0bc-30b9-a99f-a37bcfaf9acb",
                        "glosses": [
                            "Mécanisme de dérivation par ajout d’un affixe à la fin du radical d’un morphème."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c055d686-2afd-4081-a2da-fc6dd847bbc6",
                                "sense_id": "75388769-de0e-38ce-bd51-afef7429dd63",
                                "text": "La dérivation est dite simple quand elle se fait soit par préfixation, soit par suffixation soit par les deux à la fois. Dans ce dernier cas elle est appelée dérivation parasynthétique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d44691-7b10-4bb3-b603-af56a5e886e7",
                        "source_entry_id": "c205c4f9-b0bc-30b9-a99f-a37bcfaf9acb",
                        "source_sense_id": "75388769-de0e-38ce-bd51-afef7429dd63",
                        "target_lang_word": "Suffigierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suffigierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "283dcbe2-52c4-340e-85b5-24e8485c760b",
                                        "entry_id": "a14e6651-4637-39d8-94c5-0c248a0d6180",
                                        "glosses": [
                                            "Anhängung eines Morphems an das hintere Ende eines anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ae3079-f265-4660-bbdb-00e56f6f699f",
                                                "sense_id": "283dcbe2-52c4-340e-85b5-24e8485c760b",
                                                "text": "Durch Suffigierung von „-ung“ kann man Wörter nominalisieren."
                                            },
                                            {
                                                "example_id": "ebf818e8-68e6-42f4-9850-511a284886c2",
                                                "sense_id": "283dcbe2-52c4-340e-85b5-24e8485c760b",
                                                "text": "„Anders entscheidet z. B. Schmidt, der davon ausgeht, daß sowohl bei der Präfigierung als auch bei der Suffigierung auf der ersten Analyseebene nur eine unmittelbare Konstituente ein Wort, die zweite ein Affix ist.“"
                                            },
                                            {
                                                "example_id": "ad6cbe7d-6eea-4355-a1f2-e816036b0a58",
                                                "sense_id": "283dcbe2-52c4-340e-85b5-24e8485c760b",
                                                "text": "„Suffigierungen stellen auch in der 3. Zeitscheibe den mit Abstand wichtigsten Derivationstyp dar.“"
                                            },
                                            {
                                                "example_id": "7f937731-cead-4ba2-b560-c8559bea4058",
                                                "sense_id": "283dcbe2-52c4-340e-85b5-24e8485c760b",
                                                "text": "„Neben den gerade vorgestellten Suffigierungen zählt im Deutschen auch die Präfigierung zu den Derivationsprozessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
