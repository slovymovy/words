                    "frequency": "High",
                    "semantic_group_id": "reconnaitre_verite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fini par <w>admettre</w> qu'il avait tort devant toute l'équipe.",
                            "target_lang_translations": {
                                "en": "He finally <w>admitted</w> that he was wrong in front of the whole team.",
                                "ru": "В конце концов он <w>признал</w>, что был неправ перед всей командой.",
                                "nl": "Uiteindelijk <w>gaf</w> hij <w>toe</w> dat hij ongelijk had, in het bijzijn van het hele team.",
                                "de": "Schließlich <w>gab</w> er vor dem ganzen Team <w>zu</w>, dass er unrecht hatte.",
                                "pl": "W końcu <w>przyznał</w>, że się mylił przed całym zespołem.",
                                "it": "Alla fine ha finito per <w>ammettere</w> di avere torto davanti a tutta la squadra.",
                                "cs": "Nakonec <w>přiznal</w>, že se mýlil před celým týmem.",
                                "tr": "Sonunda tüm takımın önünde haksız olduğunu <w>kabul etti</w>.",
                                "es": "Al final acabó por <w>admitir</w> que se había equivocado delante de todo el equipo.",
                                "zh": "他终于<w>承认</w>自己在全队面前错了。"
                            }
                        },
                        {
                            "text": "Elle refuse d'<w>admettre</w> la vérité malgré toutes les preuves présentées.",
                            "target_lang_translations": {
                                "en": "She refuses to <w>admit</w> the truth despite all the evidence presented.",
                                "ru": "Она отказывается <w>признавать</w> правду, несмотря на все представленные доказательства.",
                                "nl": "Zij weigert de waarheid te <w>erkennen</w>, ondanks al het voorgelegde bewijs.",
                                "de": "Sie weigert sich, die Wahrheit <w>anzuerkennen</w>, trotz aller vorgelegten Beweise.",
                                "pl": "Mimo wszystkich przedstawionych dowodów ona nie chce <w>przyznać</w> prawdy.",
                                "it": "Si rifiuta di <w>ammettere</w> la verità nonostante tutte le prove presentate.",
                                "cs": "Odmítá <w>uznat</w> pravdu navzdory všem předloženým důkazům.",
                                "tr": "Sunulan bütün kanıtlara rağmen gerçeği <w>kabul etmek</w> istemiyor.",
                                "es": "Se niega a <w>admitir</w> la verdad a pesar de todas las pruebas presentadas.",
                                "zh": "尽管摆出了所有证据，她还是拒绝<w>承认</w>真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "avouer",
                        "concéder",
                        "reconnaître"
                    ],
                    "antonyms": [
                        "contester",
                        "démentir",
                        "nier"
