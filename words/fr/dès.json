                        "dès maintenant",
                        "dès à présent"
                    ]
                },
                {
                    "sense_id": "2006eeda-6cde-320d-99f4-0701b8def2c6",
                    "sense_definition": "Indique le point de départ dans l'espace ; à partir d'un endroit déterminé.",
