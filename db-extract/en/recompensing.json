                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54201b56-3937-47c0-a65f-2fc226a00def",
                                "sense_id": "5cda0f21-6614-387e-8550-6e00d4f2dc10",
                                "text": "And such the recompensing Heav'n of those, / The happy few, who truly great of soul / Are masters of themselves [...]."
                            },
                            {
                                "example_id": "01e325ff-23a5-44f1-b7df-a1a67613179e",
                                "sense_id": "5cda0f21-6614-387e-8550-6e00d4f2dc10",
                                "text": "If the needy helper require regular protection, the recompensing employer must claim regular service [...]."
                            },
                            {
                                "example_id": "39c0de34-de30-4104-b9ce-45518d6e0647",
                                "sense_id": "5cda0f21-6614-387e-8550-6e00d4f2dc10",
                                "text": "The lack of explicit reference to God as the subject of the recompensing activity is not crucial in this instance."
                            }
                        ]
                    }
                ],
