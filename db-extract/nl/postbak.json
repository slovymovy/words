                    {
                        "sense_id": "73b5b4b6-38c4-3c08-a143-00cad7bb4a97",
                        "entry_id": "c8f7d714-d431-3ae8-b086-b7ad01749603",
                        "glosses": [
                            "bak waarin de post voor één persoon of organisatie gelegd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f279f86-bba7-403b-a0b9-1f7e6f949063",
                                "sense_id": "73b5b4b6-38c4-3c08-a143-00cad7bb4a97",
                                "text": "Concreet draait het systeem om vijf kernwoorden: verzamelen, beslissen, organiseren, doen en wekelijks onderhoud. In die volgorde. Oosterkamp: „Als het bij het verzamelen verkeerd gaat, gaat de rest ook verkeerd.” Het woord dat daarom het vaakst valt op de cursusdag, is waarschijnlijk ”stuffbakje”. Dat is de plaats waar alle ingekomen informatie in moet. Het kan een postbakje zijn, maar ook de e-mailinbox, een laptop, een mobieltje."
                            }
                        ]
                    },
                    {
                        "sense_id": "d097abec-89f1-3c9a-964e-3513360e2b9e",
                        "entry_id": "c8f7d714-d431-3ae8-b086-b7ad01749603",
                        "glosses": [
                            "bak waarin voorgesorteerde post zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c34993-143a-4929-a029-fe99aaad3107",
                                "sense_id": "d097abec-89f1-3c9a-964e-3513360e2b9e",
                                "text": "De avond valt. De Friese kerstkaart zit in een postbak, in een rolcontainer, in een vrachtwagen. Vanuit Zwolle, bij Utrecht rechtdoor, richting sorteercentrum Rotterdam. Daar vindt de overslag plaats van de post voor Zeeland."
                            }
                        ]
                    },
                    {
                        "sense_id": "47ce2bb5-33ff-3c22-a222-94f963897f39",
                        "entry_id": "c8f7d714-d431-3ae8-b086-b7ad01749603",
                        "glosses": [
                            "plaats waar de postbode de post in kan doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ff6e966-064b-4733-af4b-7216d7bbf0e5",
                                "sense_id": "47ce2bb5-33ff-3c22-a222-94f963897f39",
                                "text": "Mochten controleurs constateren dat de postbakken niet aan de eisen voldoen, dan delen ze een boete uit. Het is niet bekend hoe de gemeente de boete op het juiste adres wil laten bezorgen als de brievenbus te vol zit om de bon in te leggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3b0d849-06ae-3758-9593-08e451ea32f5",
                        "entry_id": "c8f7d714-d431-3ae8-b086-b7ad01749603",
                        "glosses": [
                            "plaats op de computer waar e-mail in bewaard kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f27c301-df81-463e-b000-55b9ee532908",
                                "sense_id": "a3b0d849-06ae-3758-9593-08e451ea32f5",
                                "text": "De elektronische postbak is het meest populaire onderdeel van internet. Bijna 60 procent van de ondervraagden zei zich het leven zonder e-mail niet te kunnen voorstellen."
                            }
                        ]
                    }
