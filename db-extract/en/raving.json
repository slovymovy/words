                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17808059-cc0f-4e7b-91ae-9f9728e25853",
                                "sense_id": "cf3eabaf-87d5-3e8d-b716-6a82a894ac4d",
                                "text": "Oh, what an extraordinary idea! I have served 11 governments in the past 30 years. If I'd believed in all their policies, [proceeds to describe contradictory policies by different parties], but above all, I would have been a stark-staring raving schizophrenic! (laugh track)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d6fc178-89ff-317b-a8db-b1206bdb83bf",
                        "entry_id": "1945d886-3ab1-349f-966e-3b554e41bbfa",
                        "glosses": [
                            "Causing excitement or wild praise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa13b6a6-617f-4fba-b8ac-9797b9f5a328",
                                "sense_id": "1d6fc178-89ff-317b-a8db-b1206bdb83bf",
                                "text": "She was not considered a raving beauty."
                            }
                        ]
                    }
                ],
