                        "entry_id": "2e4771e6-9eaf-3a07-9b24-0a08a4b470b0",
                        "glosses": [
                            "A weight of one hundred avoirdupois pounds."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7d533ff8-1b41-4e64-ab73-a6a39fa32b91",
                                "sense_id": "fbf77b50-4910-3dd9-824a-fba3e9b35607",
                                "text": "Thin native steers, dressing 56 pounds per cwt., $10.50 per cental;"
                            },
                            {
                                "example_id": "0b67499a-b57e-4931-b745-0c6da1495f30",
                                "sense_id": "fbf77b50-4910-3dd9-824a-fba3e9b35607",
                                "text": "The practice of buying or selling grain by the 100 pounds, or the cental system, is becoming almost universal, and has many advantages over the old practice of selling grain by the bushel."
                            },
                            {
                                "example_id": "1884f603-987a-418e-9d95-c596ac6f8bf5",
                                "sense_id": "fbf77b50-4910-3dd9-824a-fba3e9b35607",
                                "text": "John Hudson & Co. are prepared to undertake the business at a ½d. per cental advance on the price of wheat on 4th July 19000, which is 6s. 5½d. per cental, thus obtaining 6s. 6d. per cental as the contract price."
                            }
                        ]
                    }
