        "fr-extract.jsonl": [
            {
                "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                "word": "obédience",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1bfa2b8-03c5-47f9-8ce7-540b60d5ec06",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "obédiences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96de462f-6f8e-3727-b93d-b4a9a5ae7a00",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "glosses": [
                            "Obéissance."
                        ],
                        "tags": [],
                        "note": "il ne se dit ordinairement qu’en parlant des religieux",
                        "examples": [
                            {
                                "example_id": "cc4ebb42-2655-4730-8485-abff4a22f1b4",
                                "sense_id": "96de462f-6f8e-3727-b93d-b4a9a5ae7a00",
                                "text": "Le supérieur a commandé à ce religieux en vertu de la sainte obédience."
                            }
                        ]
                    },
                    {
                        "sense_id": "d518a122-cbaa-3a19-9d9d-45f2eb2cc042",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "glosses": [
                            "Ordre ou permission par écrit qu’un supérieur donne à un religieux ou à une religieuse pour aller en quelque endroit ou pour passer d’un couvent à un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e572b483-10b6-4c55-af6f-e0bd4545b204",
                                "sense_id": "d518a122-cbaa-3a19-9d9d-45f2eb2cc042",
                                "text": "Le curé Fortier avait décidé de ne pas rêver, de ne pas moisir dans le désœuvrement en attendant une autre obédience et de chercher un second métier en harmonie avec son caractère et son rôle de prêtre."
                            },
                            {
                                "example_id": "53b0f746-2b22-4368-a3e3-f93669d72674",
                                "sense_id": "d518a122-cbaa-3a19-9d9d-45f2eb2cc042",
                                "text": "Il ne saurait partir sans obédience, s’il n’a son obédience."
                            }
                        ]
                    },
                    {
                        "sense_id": "36582c21-5afd-3300-99e5-d322efcbc70c",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "glosses": [
                            "Emploi particulier qu’un religieux ou une religieuse a dans son couvent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "843dd194-e026-45cd-a742-0a6e863036a2",
                                "sense_id": "36582c21-5afd-3300-99e5-d322efcbc70c",
                                "text": "Cette religieuse est cellérière, c’est son obédience."
                            }
                        ]
                    },
                    {
                        "sense_id": "c86e5777-be5a-32af-8a63-315941289604",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "glosses": [
                            "Maison religieuse qui dépend d’une maison principale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce7f4346-1fed-3148-b913-14d8b07fe569",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "glosses": [
                            "Groupe de loges partageant (en principe) des orientations communes, et souvent un rite commun."
                        ],
                        "tags": [
                            "Franc-maçonnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "f6446117-b599-4c29-bc5c-e9bd69482f77",
                                "sense_id": "ce7f4346-1fed-3148-b913-14d8b07fe569",
                                "text": "La Grande Loge nationale française est actuellement l'une des plus grosses obédiences de France"
                            },
                            {
                                "example_id": "97081d45-9d17-433c-a562-951869bdc0d1",
                                "sense_id": "ce7f4346-1fed-3148-b913-14d8b07fe569",
                                "text": "La Grande Loge indépendante et souveraine des rites unis est une obédience qui fédère plusieurs rites"
                            },
                            {
                                "example_id": "d584804b-2fca-4cd7-940a-dbe1f9151b5a",
                                "sense_id": "ce7f4346-1fed-3148-b913-14d8b07fe569",
                                "text": "Le Grand Prieuré de Nouvelle France est une obédience basée au Québec, mais qui possède des loges en France."
                            }
                        ]
                    },
                    {
                        "sense_id": "654793a8-fe6b-3f88-b262-9d730fe42534",
                        "entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "glosses": [
                            "Rattachement à une doctrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd70b0fa-2946-4385-b029-7db4fc04c765",
                                "sense_id": "654793a8-fe6b-3f88-b262-9d730fe42534",
                                "text": "L'islam était alors divisé en deux obédiences religieuses, en deux « papautés » ennemies."
                            },
                            {
                                "example_id": "108e9d78-30db-4667-b550-4454b9c05884",
                                "sense_id": "654793a8-fe6b-3f88-b262-9d730fe42534",
                                "text": "Le problème vient plutôt du psychanalysme, théâtre mondain où s’affrontent les obédiences, auquel s’opposent les promoteurs de l’anti-psychanalyse qui récuse l’idée d’inconscient."
                            },
                            {
                                "example_id": "185170fe-c6c8-426a-83d5-4b3842bd6cb8",
                                "sense_id": "654793a8-fe6b-3f88-b262-9d730fe42534",
                                "text": "D’obédience socialiste, pionnier du mouvement coopératif, Turpain était aux antipodes d’un Branly encore présenté en 2012 par l’auteur de sa notice wikipédiesque comme « type même du savant travailleur, passionné, désintéressé et opiniâtre. »"
                            },
                            {
                                "example_id": "16e22d47-e158-4648-abbd-cbb8a9ab6411",
                                "sense_id": "654793a8-fe6b-3f88-b262-9d730fe42534",
                                "text": "Cette secte japonaise, dirigée par Daisaku Ikeda depuis le 3 mai 1960, est le pendant laïque de l’ordre des moines bouddhistes de l’obédience Nichiren Shoshu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae806966-b729-47dd-8fcd-229bfeab56c1",
                        "source_entry_id": "2ae3cf0a-0c82-3d8b-996a-7f0b0009db6f",
                        "target_lang_word": "obedience",
                        "target_lang_code": "en",
