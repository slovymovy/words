                    }
                ],
                "translations": [
                    {
                        "translation_id": "526f6018-bccb-48a3-8904-144ae7fa4835",
                        "source_entry_id": "050a6869-b0a0-3042-82ed-685f3fd86f18",
                        "source_sense_id": "2980dc0c-2fe1-3d78-b0b6-ca0b9b18472d",
                        "target_lang_word": "maintenir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maintenir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0211a58-446b-34ce-992a-d4a591485045",
                                        "entry_id": "cc43e334-1e70-3ccd-8cc3-e8207fd11df7",
                                        "glosses": [
                                            "Tenir ferme et fixe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2a2241-423d-45f2-b1ee-d7ddb07f5a06",
                                                "sense_id": "a0211a58-446b-34ce-992a-d4a591485045",
                                                "text": "Le gars aux biques portait, sous une limousine de roulier, un bourgeron bleu serré à la taille par une ceinture rouge qui maintenait un pantalon de velours à l'instar des charbonniers auvergnats, […]."
                                            },
                                            {
                                                "example_id": "b9edb75b-06dc-4e4b-b08d-84a6d7b6d069",
                                                "sense_id": "a0211a58-446b-34ce-992a-d4a591485045",
                                                "text": "Les cordelettes m’entraient dans la chair, les mains me faisaient mal et la position dans laquelle mes bras étaient maintenus me brisaient les épaules."
                                            },
                                            {
                                                "example_id": "e80230b0-b9fa-4e02-808f-365c2997dd7f",
                                                "sense_id": "a0211a58-446b-34ce-992a-d4a591485045",
                                                "text": "[…] ; l'armée permanente de l'Islande se réduit à deux policemen, dont les gourdins suffisent à maintenir l'ordre le plus parfait sur toute l'étendue du territoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                        "entry_id": "cc43e334-1e70-3ccd-8cc3-e8207fd11df7",
                                        "glosses": [
                                            "Conserver dans le même état."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b7bcba-1fb1-4c5b-86da-7254f83b3207",
                                                "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                                "text": "Les forces américaines maintiennent une base militaire à Al-Tanf (dans le sud du pays, à la frontière de la Syrie avec l’Irak et la Jordanie)."
                                            },
                                            {
                                                "example_id": "e084ad10-9080-4ed7-9ac2-d4cc2a71f826",
                                                "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                                "text": "Ayant réquisitionné une bicyclette dans une boutique abandonnée, Bert l’enfourcha, et, maintenant en équilibre son chargement pharmaceutique, il revint à l’hôtel-hôpital."
                                            },
                                            {
                                                "example_id": "318cb8e0-5865-4ba1-932d-068b5c8fdb93",
                                                "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                                "text": "Le soir, dédaignant les taxis, je rentrais à bord presque toujours en courant pour me maintenir en bonne condition physique."
                                            },
                                            {
                                                "example_id": "e2088a9c-836e-42ea-9093-5565e99584a4",
                                                "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                                "text": "Tant que l’homme est comprimé, tant que la contrainte des iniquités sociales le maintient prostré, l’on est en droit d’espérer beaucoup de l’inéclos qu'il porte en lui."
                                            },
                                            {
                                                "example_id": "3402463d-0a56-4ea5-b098-041966e1e15c",
                                                "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                                "text": "Or, nous devons tout essayer pour maintenir peuplés ces plateaux de sol ingrat et non chercher à éloigner la population, l’obligeant à vivre dans des usines malsaines, […]."
                                            },
                                            {
                                                "example_id": "27839100-dd4c-4574-a01c-4d5bba3ff6a6",
                                                "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                                                "text": "Je maintiendrai la vertu et noblesse.\nJe maintiendrai de mon nom la haultesse.\nJe maintiendrai l'honneur, la foy, la loy\nde Dieu, du Roy, de mes amys et moy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f4ee48-a169-3caf-b42d-420ccee0a3a2",
                                        "entry_id": "cc43e334-1e70-3ccd-8cc3-e8207fd11df7",
                                        "glosses": [
                                            "Affirmer ; soutenir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0989e524-d9c7-4973-8583-8a4993470da2",
                                                "sense_id": "75f4ee48-a169-3caf-b42d-420ccee0a3a2",
                                                "text": "Son monocle a l’air de ne servir qu’à maintenir son arrogance."
                                            },
                                            {
                                                "example_id": "816a1460-c797-41e1-bc60-0a760ecc1f6e",
                                                "sense_id": "75f4ee48-a169-3caf-b42d-420ccee0a3a2",
                                                "text": "Je maintiendrai partout que cela est vrai. Je maintiens que cette opinion est fausse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf41512-c6b0-30ab-8fdc-cee43e1effca",
                                        "entry_id": "cc43e334-1e70-3ccd-8cc3-e8207fd11df7",
                                        "glosses": [
                                            "Assurer la maintenance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ebb298-34b7-46a2-a9a8-d6a388beeee4",
                                                "sense_id": "ccf41512-c6b0-30ab-8fdc-cee43e1effca",
                                                "text": "Maintenir un logiciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
