                            {
                                "example_id": "adf44d9b-1013-47cd-9911-e899dca3f35a",
                                "sense_id": "c65da0a9-2579-3861-9569-324063c49f6d",
                                "text": "„Wichtiger Hinweis: Feiertagsbedingte Verschiebungen der Abfuhrtermine sind in den Abfuhrplänen bereits berücksichtigt.“"
                            },
                            {
                                "example_id": "d04eb403-69ff-4770-bb16-759985e907ec",
                                "sense_id": "c65da0a9-2579-3861-9569-324063c49f6d",
                                "text": "„Die im Abfallentsorgungsplan aufgeführten Abfuhrtermine sind verbindlich.“"
                            },
                            {
                                "example_id": "fd9a70d3-d159-4243-b3bb-fe1f0421038f",
                                "sense_id": "c65da0a9-2579-3861-9569-324063c49f6d",
                                "text": "„In der Abfallfibel stehen die Abfuhrtermine für alle Orte im Kreis Pinneberg.“"
                            }
