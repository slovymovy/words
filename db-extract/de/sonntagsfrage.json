                "senses": [
                    {
                        "sense_id": "972c26e7-0936-39c0-a320-9e02f6c4c1fb",
                        "entry_id": "7d24d7e7-c3d0-3864-998f-3c3009c454f9",
                        "glosses": [
                            "von Meinungsforschern gestellte Frage (Welche Partei würden sie wählen wenn am nächsten Sonntag Wahlen wären?), mit der die aktuelle Wahlabsicht erhoben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f51ac5a3-6cf6-4a4d-8c8c-5919c03f0bec",
                                "sense_id": "972c26e7-0936-39c0-a320-9e02f6c4c1fb",
                                "text": "„Laut einer für den \"Standard\" erstellten Erhebung des Market- Instituts kommt die SPÖ bei der Sonntagsfrage (\"Wen würden Sie wählen, wenn am kommenden Sonntag Nationalratswahlen wären?\") nur noch auf 22 Prozent, die ÖVP auf 19. Mit gemeinsam 41 Prozent wären die beiden Koalitionspartner damit weit von einer Mehrheit entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
