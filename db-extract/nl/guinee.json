                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645f377e-aedb-4a82-82d1-2e88eebe619c",
                                                "sense_id": "e9568631-9f2c-35f1-8675-97b2812510f0",
                                                "text": "Das Klima in Guinea ist tropisch, die Landschaften reichen von Savannen zu Regenwäldern."
                                            },
                                            {
                                                "example_id": "98ccae39-1b28-40f1-80d1-280c48dd0c69",
                                                "sense_id": "e9568631-9f2c-35f1-8675-97b2812510f0",
                                                "text": "Conakry ist die Hauptstadt von Guinea."
                                            },
                                            {
                                                "example_id": "88c64d8c-2ac6-48cf-bf85-1bc69f6fdfc9",
                                                "sense_id": "e9568631-9f2c-35f1-8675-97b2812510f0",
                                                "text": "Das Guinea der Kolonialzeit war unter anderem durch Zwangsarbeit für die französische Regierung geprägt."
                                            },
                                            {
                                                "example_id": "d04ecfd0-c27d-4f8a-a9f1-2c1f13f10789",
                                                "sense_id": "e9568631-9f2c-35f1-8675-97b2812510f0",
                                                "text": "Die Wirtschaft Guineas ist noch heute durch die Misswirtschaft von Touré, die bis in die 80er andauerte, geschädigt."
                                            },
                                            {
                                                "example_id": "8133f6b7-4002-4200-ab42-53288ee7aa8b",
                                                "sense_id": "e9568631-9f2c-35f1-8675-97b2812510f0",
                                                "text": "„Laye floh mit seiner Frau und vier Kindern nach Senegal und kehrte nicht mehr nach Guinea zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
