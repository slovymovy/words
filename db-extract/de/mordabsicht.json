                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18749e68-cc4d-403c-a5fa-a0165e0bd592",
                                "sense_id": "a1f12b61-cf46-3cbf-8d27-29afbc2634ab",
                                "text": "„Aus dem Umstand, dass er offen ein Schwert bei sich trug, folgerten sie, dass er kein Verbrecher mit Mordabsichten sein konnte.“"
                            },
                            {
                                "example_id": "75c37a34-6a1f-496c-961a-13d0fc5b9bd0",
                                "sense_id": "a1f12b61-cf46-3cbf-8d27-29afbc2634ab",
                                "text": "„Fünf sterben vor Prozessbeginn oder bei der Verhaftung (Drei begehen Selbstmord, eine Frau kommt in einem Feuer um, das sie in Mordabsicht selbst gelegt hat, einer kommt bei einem Schusswechsel mit der Polizei ums Leben.)“"
                            }
                        ],
