                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258db09d-f7fb-4ca5-88b1-a9abf3793eda",
                                "sense_id": "4b93ebfa-1ab5-3650-b099-d35298fb41d3",
                                "text": "Zarząd linii zatwierdził plan lotów transatlantyckich."
                            },
                            {
                                "example_id": "27d993d7-9b41-4134-8d12-50ce29751cbf",
                                "sense_id": "4b93ebfa-1ab5-3650-b099-d35298fb41d3",
                                "text": "Kabel transatlantycki był w tych dniach tematem niezliczonych kazań oraz równie ogromnej porcji okolicznościowych wierszy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
