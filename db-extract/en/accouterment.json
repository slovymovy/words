                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbf1872a-3e54-4a47-8354-0f88dc31dea4",
                        "source_entry_id": "62d8a5ef-b8fa-3b26-8071-2dfca5752097",
                        "source_sense_description": "trappings",
                        "target_lang_word": "accoutrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accoutrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                        "entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                                        "glosses": [
                                            "Habillement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1c0ac6-911c-4c70-b756-da6b70d17001",
                                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                                "text": "Enfin je n'y tins plus, je mis bas pantalon, bottes et chaussettes, je complétai mon accoutrement de pêcheur sur le modèle de celui de Maurice, […]."
                                            },
                                            {
                                                "example_id": "faccbed9-51c5-43fa-8a2e-aef1f9701b69",
                                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                                "text": "Des bonnets de fourrure, des ceintures de peau de daim complétaient l'accoutrement."
                                            },
                                            {
                                                "example_id": "9e58f2e7-1dd4-4010-83d4-0d3ebcfa6f32",
                                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                                "text": "[…], un accoutrement de voyage qui n’est de bon goût ni dans sa coupe démodée ni dans sa couleur tapageuse."
                                            },
                                            {
                                                "example_id": "f81eeb62-4e80-48e1-9607-44926e41a32a",
                                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                                "text": "Pensant à son accoutrement, il se défit de son faux-col et de sa casquette blanche d’aéronaute, qui pouvaient le trahir, […]."
                                            },
                                            {
                                                "example_id": "a3ee8d15-ad80-46f1-a6f1-81afaa71d132",
                                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                                "text": "Où donc était-il passé depuis le temps, car il n’avait assurément pu songer, dans l’accoutrement où il était, à descendre en ville ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414e670f-beef-3924-8b1c-e4889a598485",
                                        "entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                                        "glosses": [
                                            "Tenue vestimentaire surprenante."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72497fd9-8d3e-40aa-b087-28d9cf8e3c7e",
                                                "sense_id": "414e670f-beef-3924-8b1c-e4889a598485",
                                                "text": "On lui ordonna d’ôter la belle pelisse dont elle était revêtue, ce qu’elle refusa de faire, et si opiniâtrement que les valets du bourreau furent obligés de l’attacher au poteau dans cet accoutrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
