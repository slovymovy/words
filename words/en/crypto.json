{
    "word_family": [
        "cryptography",
        "cryptographic",
        "cryptogram",
        "cryptology",
        "cryptologist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7098a9d7-5683-34f1-9d75-d8cb84bfe4bd",
                    "sense_definition": "A digital currency that uses encryption for security.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many investors believe that <w>crypto</w> will eventually replace traditional banking systems.",
                            "target_lang_translations": {
                                "zh": "许多投资者认为<w>加密货币</w>最终会取代传统的银行系统。"
                            }
                        },
                        {
                            "text": "The value of <w>crypto</w> can change very quickly within a single day.",
                            "target_lang_translations": {
                                "zh": "<w>加密货币</w>的价值在一天之内可能会发生剧烈波动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cryptocurrency"
                    ],
                    "common_phrases": [
                        "crypto market",
                        "crypto assets",
                        "invest in crypto"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal and financial contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种利用加密技术确保安全的数字货币。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加密货币",
                                "target_lang_sense_clarification": "指代比特币等数字资产的通用术语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bb7c8f1-d14c-3b94-b54c-d6ef8fc21803",
                    "sense_definition": "The study or practice of secure communication techniques.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She studied advanced <w>crypto</w> to understand how to protect sensitive data online.",
                            "target_lang_translations": {
                                "zh": "她学习了高级<w>密码学</w>，以了解如何保护网上的敏感数据。"
                            }
                        },
                        {
                            "text": "Modern internet security relies heavily on complex <w>crypto</w> protocols.",
                            "target_lang_translations": {
                                "zh": "现代互联网安全在很大程度上依赖于复杂的<w>密码学</w>协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cryptography"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily by professionals and enthusiasts in the field."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "关于安全通信技术的研究或实践。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "密码学",
                                "target_lang_sense_clarification": "指代研究信息加密与解密的学科。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "692f9239-7237-3941-81b0-193424340d63",
                    "sense_definition": "A person who secretly supports a cause or group.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of being a <w>crypto</w> supporter of the radical movement.",
                            "target_lang_translations": {
                                "zh": "他被指控是该激进运动的<w>隐秘</w>支持者。"
                            }
                        },
                        {
                            "text": "The politician was labeled a <w>crypto</w> communist by his opponents.",
                            "target_lang_translations": {
                                "zh": "这位政客被对手贴上了<w>隐秘</w>共产主义者的标签。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sympathizer"
                    ],
                    "target_lang_definitions": {
                        "zh": "秘密支持某种事业或团体的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隐秘的",
                                "target_lang_sense_clarification": "形容某人暗中支持某种立场。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d231f355-e644-3a1b-bd98-51506eadeb7d",
                    "sense_definition": "A parasitic infection caused by a specific protozoan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patients with weakened immune systems are at higher risk of contracting <w>crypto</w>.",
                            "target_lang_translations": {
                                "zh": "免疫系统较弱的患者感染<w>隐孢子虫病</w>的风险更高。"
                            }
                        },
                        {
                            "text": "The hospital reported an outbreak of <w>crypto</w> linked to contaminated water.",
                            "target_lang_translations": {
                                "zh": "医院报告了一起与受污染水源有关的<w>隐孢子虫病</w>疫情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cryptosporidiosis"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in medical contexts as a shorthand for the disease."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "由特定原生动物引起的寄生虫感染。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隐孢子虫病",
                                "target_lang_sense_clarification": "医学上指代该寄生虫感染疾病。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d15ae3d-9959-3bf1-9859-c6cd3cede692",
                    "sense_definition": "Hidden or kept secret.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He maintained a <w>crypto</w> agenda that nobody else in the office knew about.",
                            "target_lang_translations": {
                                "zh": "他一直保持着一个办公室里没人知道的<w>隐秘</w>议程。"
                            }
                        },
                        {
                            "text": "The group held <w>crypto</w> meetings in the basement to avoid detection.",
                            "target_lang_translations": {
                                "zh": "该组织在地下室举行<w>隐秘</w>会议以避免被发现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "covert",
                        "secret"
                    ],
                    "antonyms": [
                        "overt",
                        "public"
                    ],
                    "target_lang_definitions": {
                        "zh": "隐藏的或保密的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隐秘的",
                                "target_lang_sense_clarification": "形容不公开的、秘密的性质。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}