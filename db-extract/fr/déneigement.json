                "senses": [
                    {
                        "sense_id": "4552129d-01d3-3bc1-be5d-867cc1fff5c7",
                        "entry_id": "21400781-602e-396c-bf69-3b822a2a375b",
                        "glosses": [
                            "Action d’enlever la neige, en particulier pour dégager les voies de circulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfedd476-744d-456b-831d-c40f4732054d",
                                "sense_id": "4552129d-01d3-3bc1-be5d-867cc1fff5c7",
                                "text": "La journée de samedi a été consacrée au déneigement dans plusieurs régions du Québec qui avaient reçu entre 20 et 50 cm de neige depuis vendredi."
                            },
                            {
                                "example_id": "b8cefcfe-db94-4c3a-a12a-f44372e729ae",
                                "sense_id": "4552129d-01d3-3bc1-be5d-867cc1fff5c7",
                                "text": "L’été n’est pas terminé qu’il est déjà temps de penser à engager un entrepreneur pour prendre en charge le déneigement de l’entrée."
                            },
                            {
                                "example_id": "256806d1-c693-4b8a-81e6-8e73e6105261",
                                "sense_id": "4552129d-01d3-3bc1-be5d-867cc1fff5c7",
                                "text": "Les Canadiens peuvent poursuivre leur ville pour des blessures liées au déneigement"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16de99c1-4f22-4a71-ae19-c79d11e455eb",
                        "source_entry_id": "21400781-602e-396c-bf69-3b822a2a375b",
                        "source_sense_id": "4552129d-01d3-3bc1-be5d-867cc1fff5c7",
                        "target_lang_word": "Winterdienst",
