                ],
                "translations": [
                    {
                        "translation_id": "bf0db462-2577-43f6-99d5-2d2b979f5063",
                        "source_entry_id": "1b0b87b7-1284-3bb1-affe-54de266a223b",
                        "source_sense_id": "19e121aa-9379-3028-8036-f08785e88019",
                        "target_lang_word": "Urwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "220ead0b-23cc-3dcc-9bbf-206baf5a03ea",
                                        "entry_id": "b583a5ee-80d8-3a52-9d45-8985f8c25e77",
                                        "glosses": [
                                            "natürlich gewachsener, ursprünglicher Wald, in dessen Bestand und intakter Ökologie keine massiven menschliche Eingriffe (etwa Forstwirtschaft, Brandrodung) erfolgt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572bd3fd-984e-423f-b872-2003d62b5724",
                                                "sense_id": "220ead0b-23cc-3dcc-9bbf-206baf5a03ea",
                                                "text": "Umgangssprachlich versteht man unter Urwald auch den tropischen Regenwald."
                                            },
                                            {
                                                "example_id": "451f2dac-4953-419d-ab4f-a39f0681ca1c",
                                                "sense_id": "220ead0b-23cc-3dcc-9bbf-206baf5a03ea",
                                                "text": "Beim Marsch durch den Urwald mit seinem Gewirr von Schlinggewächsen blieb kein Waffenrock, keine Hose, kein Stiefel ganz."
                                            },
                                            {
                                                "example_id": "89c20878-5ed1-4b8a-af67-f7a6cd4d5e72",
                                                "sense_id": "220ead0b-23cc-3dcc-9bbf-206baf5a03ea",
                                                "text": "Das dichte Unterholz vor ihm zerriß wie platzende Leinwand; die jungen Bäume rechts und links bogen sich zur Seite und peitschten zurückschlagend seine Flanken; die harten Ranken der Schlingpflanzen hingen in dichtem Gewirr an den wegbahnenden Hauern, während der schwere Schädel unaufhaltsam vorstieß und sich den Pfad durch den Urwald pflügte."
                                            },
                                            {
                                                "example_id": "e2f057f5-cceb-4d26-a702-1352041a56dc",
                                                "sense_id": "220ead0b-23cc-3dcc-9bbf-206baf5a03ea",
                                                "text": "Weil sämtliche internationalen Bemühungen erfolglos blieben, will Trittin mit einem nationalen Kontrollsystem für Besserung sorgen. Danach müssen die Vermarkter belegen, dass das Holz nicht illegal in Urwäldern geschlagen wurde."
                                            },
                                            {
                                                "example_id": "9b22813c-1ad8-4468-9f9d-2578391c6698",
                                                "sense_id": "220ead0b-23cc-3dcc-9bbf-206baf5a03ea",
                                                "text": "Nirgends auf dem Globus flattert, kriecht, hüpft, fliegt oder schlängelt sich so viel Getier durch das Grün wie im Amazonas-Urwald, und nur ein Bruchteil davon ist überhaupt erforscht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6974b6d3-70f5-4c6e-b002-0954cbfd61f7",
                        "source_entry_id": "1b0b87b7-1284-3bb1-affe-54de266a223b",
                        "source_sense_id": "19e121aa-9379-3028-8036-f08785e88019",
                        "target_lang_word": "jungle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jungle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "466ae83a-c0b2-3baa-be00-d6543aa8f2fe",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "A large, undeveloped, humid forest, especially in a tropical region, that is home to many wild plants and animals; a tropical rainforest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b296856f-17e2-4258-a98f-ef0acc1971fd",
                                                "sense_id": "466ae83a-c0b2-3baa-be00-d6543aa8f2fe",
                                                "text": "As Tarzan walked down the wild cañon beneath the brilliant African moon the call of the jungle was strong upon him. The solitude and the savage freedom filled his heart with life and buoyancy. Again he was Tarzan of the Apes—every sense alert against the chance of surprise by some jungle enemy—yet treading lightly and with head erect, in proud consciousness of his might."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b2e2dd-dd4c-39dd-9082-1aa7cb9d3302",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "Any uncultivated tract of forest or scrub habitat."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10cfeb8a-64a6-353e-a59c-470b5eae67a7",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "A place where people behave ruthlessly, unconstrained by law or morality."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93db060-6498-4d37-b1fd-383dea109391",
                                                "sense_id": "10cfeb8a-64a6-353e-a59c-470b5eae67a7",
                                                "text": "It’s a jungle out there."
                                            },
                                            {
                                                "example_id": "9a3a3ecc-3126-4f59-94cc-30e9ab52f964",
                                                "sense_id": "10cfeb8a-64a6-353e-a59c-470b5eae67a7",
                                                "text": "The first-timer just doesn't know what's going on when he gets to jail. […] It's a jungle, you've got to look after yourself first."
                                            },
                                            {
                                                "example_id": "d06abc1b-1dc1-4859-bac4-1b000384dbe2",
                                                "sense_id": "10cfeb8a-64a6-353e-a59c-470b5eae67a7",
                                                "text": "But of course, that excludes the narcissistic delusionals, the deliberate frauds, and the pathological cases of multiple personality. They are all out there in New Age Land, and it's a jungle!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "009f96f7-164e-36c2-b244-ef8ff218addb",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "A tangled mess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6690bab8-fd75-4dd4-adcb-bf17fc54af08",
                                                "sense_id": "009f96f7-164e-36c2-b244-ef8ff218addb",
                                                "text": "[…] lost in such a jungle of intrigues, pettifoggings, treacheries, diplomacies domestic and foreign […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ba4c83-0e4d-3fc6-822b-b791529382de",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "An area where hobos camp together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b7b5ff4-ef4d-3c90-854d-a1431fe33797",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "A style of electronic dance music and precursor of drum and bass."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "612c6942-b2d5-4e75-b701-74619158c2bc",
                                                "sense_id": "4b7b5ff4-ef4d-3c90-854d-a1431fe33797",
                                                "text": "Always more multiracial than other post-Rave scenes, Hardcore got “blacker” as hiphop, Ragga, dub and Soul influences kicked in, and by 93 it had evolved into Jungle. By this point, Hardcore/Jungle (the terms remain interchangeable) was universally scorned by dance hipsters and banished from the media."
                                            },
                                            {
                                                "example_id": "0d03cb5c-46f0-443a-8af1-d0aa1c540790",
                                                "sense_id": "4b7b5ff4-ef4d-3c90-854d-a1431fe33797",
                                                "text": "In large part, happycore was the result of an exodus of white ravers from the jungle scene, in reaction to the influx of black youth and the attendant mood change from bonhomie to surliness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6df06843-b1d2-31fb-a68f-f34b73127f83",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "Dense rough."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bb15ebc-22f7-4b83-abf2-e5f805bf6c80",
                                                "sense_id": "6df06843-b1d2-31fb-a68f-f34b73127f83",
                                                "text": "Hitting from the Jungle. The rough at some courses is just weeds and sparse grass, as often as not giving a player a decent lie to shoot from. But grass above four inches is nasty. It will grab your club and alter your shots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7200de-aef2-34e2-83e2-fbdceea55d69",
                                        "entry_id": "ba62ef08-ca06-3d6e-918a-e32e5a486606",
                                        "glosses": [
                                            "A dense mass of pubic hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jungle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a5bb03-6af2-3c50-b2f9-cfd204992841",
                                        "entry_id": "b3f1952e-f9b9-3a17-befb-18b52239daf4",
                                        "glosses": [
                                            "resembling the fast-paced drumming of traditional peoples of the jungle."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68bdaaae-ddf8-4b63-a174-29e41bf89057",
                                                "sense_id": "f0a5bb03-6af2-3c50-b2f9-cfd204992841",
                                                "text": "She gave her first performance at the Philharmonic Auditorium in Los Angeles, offering festival dances, Moro tribal rituals, primitive jungle rhythms and rice harvest ceremonials."
                                            },
                                            {
                                                "example_id": "c422b4e0-3792-4cf3-ab30-c2faf48f6bbe",
                                                "sense_id": "f0a5bb03-6af2-3c50-b2f9-cfd204992841",
                                                "text": "Somewhere further up the valley a bunch of hippies were getting back to nature by loading up on mind altering chemicals and overwhelming their senses with five million decibels of digital bass and jungle beats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eacc20fe-5b57-46b4-ab80-de576d17b13e",
                        "source_entry_id": "1b0b87b7-1284-3bb1-affe-54de266a223b",
                        "source_sense_id": "19e121aa-9379-3028-8036-f08785e88019",
                        "target_lang_word": "primeval forest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "primeval forest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0196bc1-cf52-338c-ab4f-132d1bb29a6f",
                                        "entry_id": "829cde82-b9bf-36d3-a97e-5530e271ec00",
                                        "glosses": [
                                            "A forest unaffected by humans, typically containing large live trees, large dead trees, and large logs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db0d2ac1-f1c8-4b16-a562-93cc3703c3aa",
                        "source_entry_id": "1b0b87b7-1284-3bb1-affe-54de266a223b",
                        "source_sense_id": "19e121aa-9379-3028-8036-f08785e88019",
                        "target_lang_word": "jungla",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jungla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cdefd06b-ce85-3610-9418-a5611d0c5734",
                                        "entry_id": "8cbbb787-b4fa-38ac-a552-42f858aeaf73",
                                        "glosses": [
                                            "Bosque denso tropical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abed0eb6-c6de-4504-80ec-e47ed0560c8c",
                                                "sense_id": "cdefd06b-ce85-3610-9418-a5611d0c5734",
                                                "text": "Por la noche descansaba en mi hamaca por horas, sin dormirme, disfrutando de la oscuridad aterciopelada de la jungla, la cual sólo parecía más intensa por las luces que intentaban atravesaría."
                                            },
                                            {
                                                "example_id": "402caeb3-1216-4220-8b4f-f4bcc0dbd8b5",
                                                "sense_id": "cdefd06b-ce85-3610-9418-a5611d0c5734",
                                                "text": "venció a pasodoble el reino de los leones muertos y esquivó en las junglas del trópico las emboscadas de los tigres carniceros."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42c8ea00-5610-30b4-8856-87aafba2998a",
                                        "entry_id": "8cbbb787-b4fa-38ac-a552-42f858aeaf73",
                                        "glosses": [
                                            "Por extensión, confusión o desorden resultante de la abundancia de alguna cosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9018ecf-d39a-429b-ba35-48f152b29467",
                                                "sense_id": "42c8ea00-5610-30b4-8856-87aafba2998a",
                                                "text": "Para muchos obreros, a no ser que hayan sido por él decepcionados, el sindicalismo no es sólo ni aun esencialmente la defensa de sus intereses; es una expresión visible, un símbolo concreto de solidaridad, una red de lazos humanos en la jungla industrial."
                                            },
                                            {
                                                "example_id": "b5e0ceba-6595-43c3-9dc7-fc02131057bc",
                                                "sense_id": "42c8ea00-5610-30b4-8856-87aafba2998a",
                                                "text": "Algo semejante se podría decir de Bruce Willis, que pasa de la violencia chapucera y paranoica de sus junglas de acrílico a la violencia paródica y ‘artística’ de ‘Pulp fiction’, previa escala en ‘El juego de Hollywood’, de Robert Altman, una película que no deja de tener algún parentesco con la que ahora comentamos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "02435dd9-0663-3dd2-9631-537cfe04c08a",
                                        "entry_id": "8cbbb787-b4fa-38ac-a552-42f858aeaf73",
                                        "glosses": [
                                            "Lugar o ambiente peligroso o muy competitivo."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea1e11c9-992c-461a-884d-61dde78ba857",
                                                "sense_id": "02435dd9-0663-3dd2-9631-537cfe04c08a",
                                                "text": "Este mundo es una jungla donde sobrevive el más fuerte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6642fe83-164a-4baf-b470-23f25448132d",
                        "source_entry_id": "1b0b87b7-1284-3bb1-affe-54de266a223b",
                        "source_sense_id": "19e121aa-9379-3028-8036-f08785e88019",
                        "target_lang_word": "selva",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selva",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "49d0a2ba-df6c-3c2e-aed9-7c467cb11019",
                                        "entry_id": "f810cf48-9dff-3f69-8476-03cd10f1182b",
                                        "glosses": [
                                            "Bosque espeso, especialmente el tropical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08598ed-d309-4c95-953f-b1ae75b1386d",
                                                "sense_id": "49d0a2ba-df6c-3c2e-aed9-7c467cb11019",
                                                "text": "Y partiendo de Athenas entraron en la mar, a dó ovieron buen viage y arribaron en tierra do Tereo con Filomena se apartó de la gente suya a una spantable y inhabitable selva de fieras bestias salvajes donde, ciego y gravemente apremiado del amor, forzó a su cuñada, corrunpiendo su limpia virginidad."
                                            },
                                            {
                                                "example_id": "d9b18a5a-4666-4351-855a-53bbe9279776",
                                                "sense_id": "49d0a2ba-df6c-3c2e-aed9-7c467cb11019",
                                                "text": "¿Qué bosque o selva umbrosa\nno fue de nuestra caza fatigada?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
