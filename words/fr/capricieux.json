{
    "word_family": [
        "caprice",
        "capricieusement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f56e5815-44e1-3dee-99ca-cd6ca5e81698",
                    "sense_definition": "Qui a des caprices, qui change soudainement d'humeur ou de volonté sans motif valable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant <w>capricieux</w> refuse de manger ses légumes et réclame des bonbons."
                        },
                        {
                            "text": "Son comportement <w>capricieux</w> rend toute collaboration très difficile au sein de l'équipe."
                        }
                    ],
                    "synonyms": [
                        "caractériel",
                        "fantasque",
                        "impulsif"
                    ],
                    "antonyms": [
                        "constant",
                        "raisonnable"
                    ],
                    "common_phrases": [
                        "enfant capricieux",
                        "humeur capricieuse"
                    ]
                },
                {
                    "sense_id": "4697e91d-770e-37de-b8bd-8fb388f47a61",
                    "sense_definition": "Qui est instable, changeant ou imprévisible en parlant d'éléments naturels ou de situations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La météo est particulièrement <w>capricieuse</w> en montagne au début du printemps."
                        },
                        {
                            "text": "Les marins doivent faire face à un vent <w>capricieux</w> qui change constamment de direction."
                        }
                    ],
                    "antonyms": [
                        "régulier",
                        "stable"
                    ],
                    "common_phrases": [
                        "météo capricieuse",
                        "vent capricieux"
                    ]
                },
                {
                    "sense_id": "1f91931e-b928-3507-af7c-7dfe57f3e7a6",
                    "sense_definition": "Qui fonctionne mal ou de manière intermittente, en parlant d'un appareil ou d'un mécanisme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma vieille voiture a un démarreur très <w>capricieux</w> en hiver."
                        },
                        {
                            "text": "Notre connexion internet devient <w>capricieuse</w> dès qu'un orage éclate."
                        }
                    ],
                    "antonyms": [
                        "fiable"
                    ],
                    "common_phrases": [
                        "connexion capricieuse",
                        "moteur capricieux"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2555309d-cda5-3bb4-9a81-366d4ae58b32",
                    "sense_definition": "Personne sujette aux caprices et aux changements d'humeur imprévisibles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne cède pas à toutes ses demandes, ce petit <w>capricieux</w> doit apprendre à attendre."
                        },
                        {
                            "text": "C'est un véritable <w>capricieux</w> qui boude dès qu'il n'obtient pas immédiatement ce qu'il souhaite."
                        }
                    ]
                }
            ]
        }
    ]
