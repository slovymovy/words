                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd0caea6-83f5-4218-b4cc-bc1a9734b6a5",
                        "source_entry_id": "1b7be1f2-78d0-3fd0-8a5d-81c61edf84ea",
                        "source_sense_id": "23977f81-a643-3b28-967d-776dee1880bc",
                        "target_lang_word": "luxurious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luxurious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b19a9982-9c90-33dd-9714-2444162d500f",
                                        "entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                                        "glosses": [
                                            "Very fine in quality and comfortable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fdcf1b2-da25-463a-a276-b01dae52bf00",
                                                "sense_id": "b19a9982-9c90-33dd-9714-2444162d500f",
                                                "text": "a luxurious hotel suite"
                                            },
                                            {
                                                "example_id": "847c8598-8ef3-4d6d-9d33-4c42eb69a2f0",
                                                "sense_id": "b19a9982-9c90-33dd-9714-2444162d500f",
                                                "text": "With her luxurious furnishings and spacious accommodation the Invicta, which is 350-ft. long and has a gross tonnage of 4,178, resembles a small liner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d740654-464d-31a7-9f1f-05f5771637b2",
                                        "entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                                        "glosses": [
                                            "Enjoying the pleasures of luxury, accustomed to luxury."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7e5bb0-0929-4267-8e4a-c6657aa5b12b",
                                                "sense_id": "7d740654-464d-31a7-9f1f-05f5771637b2",
                                                "text": "Invalids, and luxurious persons, require more artificial arrangements for travelling on the camel."
                                            },
                                            {
                                                "example_id": "0dbd8f66-e9fb-43cc-a550-adfcd08ca313",
                                                "sense_id": "7d740654-464d-31a7-9f1f-05f5771637b2",
                                                "text": "When one looks at the elegantly dressed people round the gaming table, who perhaps laugh at everything which impresses other people with awe, who scoff at the Church and the Bible, one could scarcely think it possible that these enlightened, pleasure-loving, luxurious men of the world, carry on in secret, cabalistic nonsense, turning over cards, fortune telling, studying the significance of signs and dreams […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49acd42f-8549-4e23-9e90-fd529eca686e",
                        "source_entry_id": "1b7be1f2-78d0-3fd0-8a5d-81c61edf84ea",
                        "source_sense_id": "23977f81-a643-3b28-967d-776dee1880bc",
                        "target_lang_word": "sumptuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sumptuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566664fd-3e60-3d1a-a501-59b8d4aa37f5",
                                        "entry_id": "10309c32-f9f9-3434-9e97-f6d4ecf1c63c",
                                        "glosses": [
                                            "Magnificent, luxurious, splendid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54f632d-c842-4d28-96ce-e5a1a9d49a63",
                                                "sense_id": "566664fd-3e60-3d1a-a501-59b8d4aa37f5",
                                                "text": "Though poor the peasant’s hut, his feasts though small,\nHe sees his little lot the lot of all;\nSees no contiguous palace rear its head\nTo shame the meanness of his humble shed;\nNo costly lord the sumptuous banquet deal\nTo make him loathe his vegetable meal;"
                                            },
                                            {
                                                "example_id": "a9eb9826-a292-4bea-b4ee-11960d032d67",
                                                "sense_id": "566664fd-3e60-3d1a-a501-59b8d4aa37f5",
                                                "text": "I wandered on until I came to a sumptuous palace with a garden adorned with fountains and fishponds, and groves and flowers, and orchards laden with delicious fruit."
                                            },
                                            {
                                                "example_id": "7c19bd97-51d6-4223-b229-c5bd5aa9e2ae",
                                                "sense_id": "566664fd-3e60-3d1a-a501-59b8d4aa37f5",
                                                "text": "It was a sumptuous nature, perhaps, that could not be brought to regard money; a natural generosity and kindness; and possibly a petty vanity that was pleased with praise, even with the praise of waiters and cabmen."
                                            },
                                            {
                                                "example_id": "ab131ddb-6511-4f98-8d7e-d131820b2d11",
                                                "sense_id": "566664fd-3e60-3d1a-a501-59b8d4aa37f5",
                                                "text": "There were some unofficial local rejoicings, but none of the elaborate junketings which marked the birth of earlier railways. The company had little cash to spend on sumptuous cold collations, and the like."
                                            },
                                            {
                                                "example_id": "5e0b5647-0886-44be-bad8-4e8bb5d0fee1",
                                                "sense_id": "566664fd-3e60-3d1a-a501-59b8d4aa37f5",
                                                "text": "Cabaye pulled all the strings in a dominant home performance and capped a majestic individual display with a sumptuous first-time finish into the far corner for his second goal of the afternoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a5afa6-fd76-4a57-89b9-8a71c11f6551",
                        "source_entry_id": "1b7be1f2-78d0-3fd0-8a5d-81c61edf84ea",
                        "source_sense_id": "a095e69a-08b1-3048-898e-b71767ca50a6",
                        "target_lang_word": "extravagant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b40cfb55-462a-38f2-a5cb-5249df08f0a3",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Exceeding the bounds of something; roving; hence, foreign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633e3966-3082-4b23-aaeb-bf8bbf76ede0",
                                                "sense_id": "b40cfb55-462a-38f2-a5cb-5249df08f0a3",
                                                "text": "The extravagant and erring spirit hies / To his confine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Extreme; wild; excessive; unrestrained."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4e24cb-efd9-4a6d-badc-658278580194",
                                                "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                                "text": "extravagant acts, praise, or abuse"
                                            },
                                            {
                                                "example_id": "15cbfc31-8e31-48eb-909b-b43e9ff7660e",
                                                "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                                "text": "There appears something nobly wild and extravagant in great natural geniuses."
                                            },
                                            {
                                                "example_id": "7ebcf61b-4eed-4dff-bad6-6f58e8e92012",
                                                "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923c975b-b48e-348c-b166-78a1da09f195",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Exorbitant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa3765b-6a39-4271-b613-057063046264",
                                                "sense_id": "923c975b-b48e-348c-b166-78a1da09f195",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Profuse in expenditure; prodigal; wasteful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ddbefb-534b-4646-b68d-69726337934f",
                                                "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                                "text": "an extravagant man"
                                            },
                                            {
                                                "example_id": "7ca541ec-47cf-4279-8ad4-b24a42c66310",
                                                "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                                "text": "extravagant expense"
                                            },
                                            {
                                                "example_id": "d44bf513-e135-4105-b613-83728b3dc29e",
                                                "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                                "text": "some of the Quakers were extravagant and foolish"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdcdbcbc-0103-4bea-bc13-eb4c07498a19",
                        "source_entry_id": "1b7be1f2-78d0-3fd0-8a5d-81c61edf84ea",
                        "source_sense_id": "a095e69a-08b1-3048-898e-b71767ca50a6",
                        "target_lang_word": "superfluous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superfluous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                        "entry_id": "0d4a640d-b010-30a1-9949-2e95d86eff2b",
                                        "glosses": [
                                            "In excess of what is required or sufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77362d98-2f9e-44e6-9adf-eb10b1229484",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "With a full rain suit, carrying an umbrella may be superfluous."
                                            },
                                            {
                                                "example_id": "35ad54e6-a8c0-48a7-a66b-d7855c96647e",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "Then I began to play in timid fashion, venturing only twenty or thirty gulden at a time. Meanwhile, I observed and took notes. It seemed to me that calculation was superfluous, and by no means possessed of the importance which certain other players attached to it, even though they sat with ruled papers in their hands, whereon they set down the coups, calculated the chances, reckoned, staked, and—lost exactly as we more simple mortals did who played without any reckoning at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
