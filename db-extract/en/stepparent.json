                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5443dad-f7dc-482c-aa8c-8610e784d176",
                        "source_entry_id": "27e9c605-1748-3481-b83b-e7bd72576104",
                        "source_sense_id": "b330faba-c874-34f3-8ddd-0840120b097c",
                        "source_sense_description": "stepfather or stepmother",
                        "target_lang_word": "Stiefvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                        "entry_id": "69b5ee0d-3122-3224-b605-88f1d9e34246",
                                        "glosses": [
                                            "der nach einer Wiederverheiratung der Mutter (infolge von Tod oder Scheidung) neue Ehemann der Mutter, der mit seinem Stiefkind (Stieftochter, Stiefsohn) nicht leiblich verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb013db-d4c2-48bc-878c-5ca990980073",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "Ich verstehe mich mit meinem Stiefvater sehr gut."
                                            },
                                            {
                                                "example_id": "b45e97df-a572-4b9e-83e0-a6e9b8ad7f5c",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Der Stiefvater wusste, dass der Oberst ein Theaterliebhaber war und hatte ihm von dem Theaterinteresse seines Stiefsohnes erzählt.“"
                                            },
                                            {
                                                "example_id": "a85c7a71-419d-41d2-a37d-f0b6a5997424",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Damals bekam Lea fast gleichzeitig mit einer Adoptivschwester auch einen Stiefvater.“"
                                            },
                                            {
                                                "example_id": "6a13b6a1-cf1d-402c-a5a8-24e184bf7338",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Dass sein Stiefvater Ingvald sich noch mehr über seine Besuche freute und sie als Ritterschlag wertete, ahnte der Junge nicht.“"
                                            },
                                            {
                                                "example_id": "dc389e1b-1fc2-4a43-82a7-fb9a943bf339",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Der Stiefvater zuckt die Achseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b197fd6-6b21-40b8-b0c3-39bc8c1ba523",
                        "source_entry_id": "27e9c605-1748-3481-b83b-e7bd72576104",
                        "source_sense_id": "b330faba-c874-34f3-8ddd-0840120b097c",
                        "source_sense_description": "stepfather or stepmother",
                        "target_lang_word": "Stiefmutter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                        "entry_id": "9ebcc088-317f-3382-bbcc-6d3f2e1753de",
                                        "glosses": [
                                            "die nach einer Wiederverheiratung des Vaters (infolge von Tod oder Scheidung) neue Ehefrau des Vaters, die mit ihrem Stiefkind (Stieftochter, Stiefsohn) nicht leiblich verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92234ffa-aee4-4255-9673-42f172e16738",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "Meine Stiefmutter ist eine liebevolle Frau."
                                            },
                                            {
                                                "example_id": "14d3323a-aef6-4bf3-8942-61ddd95fcbe3",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Er wollte seinem geliebten Sohn keine Stiefmutter vorsetzen.“"
                                            },
                                            {
                                                "example_id": "a2c9f8b3-fca2-49ae-8698-0fe7d0b6638b",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Die neue Stiefmutter kümmerte sich wohl um die körperlichen Bedürfnisse der Stiefkinder; ein wirklicher Ersatz für die leibliche Mutter wurde sie aber nie.“"
                                            },
                                            {
                                                "example_id": "b8f49e05-bd63-48fa-991e-4b35ceae8c83",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Zu meiner Stiefmutter habe ich ein gutes Verhältnis.“"
                                            },
                                            {
                                                "example_id": "a859536c-faca-42b3-8256-5685f6ef7d88",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Meine neue Stiefmutter rechtfertigte völlig die schlechte Meinung, die man von ihr hatte, und ihr erstes Auftreten bestand darin, daß sie mich zu verführen suchte.“"
                                            },
                                            {
                                                "example_id": "f54fcf9a-22c5-42bf-9c0e-efa49e2a3379",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Meine spätere Stiefmutter hatte ebenfalls keinen Grund, für ihre Stieftochter oder für mich besondere Zuneigung zu entwickeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be60047a-b2b7-3b25-92b7-38f8f7d6ebfa",
                                        "entry_id": "9ebcc088-317f-3382-bbcc-6d3f2e1753de",
                                        "glosses": [
                                            "Stereotype für eine oder die böse Frau"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7a5512-c642-49b9-953c-bad7fe7ddbc9",
                                                "sense_id": "be60047a-b2b7-3b25-92b7-38f8f7d6ebfa",
                                                "text": "Du könntest etwas netter sein und mich nicht wie eine Stiefmutter behandeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
