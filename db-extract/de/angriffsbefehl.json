                        "examples": [
                            {
                                "example_id": "31cb51bc-d37f-4013-8b6d-ed9ff78e66f0",
                                "sense_id": "5511ef32-42c2-3c60-af1e-987210ae6365",
                                "text": "Der General erteilte den Angriffsbefehl."
                            },
                            {
                                "example_id": "060cdc70-ddb6-468b-a54f-6fa1dd42072b",
                                "sense_id": "5511ef32-42c2-3c60-af1e-987210ae6365",
                                "text": "„Fast alle Soldaten, die an der Grenze zu Ostpreußen auf den Angriffsbefehl warteten, hatten im Krieg Geschwister, Eltern, Kinder, Verwandte oder Freunde verloren, von ihren Häusern und Höfen zu schweigen.“"
                            }
                        ],
