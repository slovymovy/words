                        "glosses": [
                            "In a spanking manner; vigorously; freshly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2439b6cc-e8ce-4c36-8f95-6b4911a9aa6c",
                                "sense_id": "ec275ebf-ef07-3007-b2a5-e5c1757f9ee7",
                                "text": "She is both wetting and getting up a fresh topsail on her after-mast — I see them crossing the yard even now. By my honour, she is a charming, lively creature, and goes through it spankingly."
                            },
                            {
                                "example_id": "6e3e72ee-34a0-4eef-9195-b2f76338a6aa",
                                "sense_id": "ec275ebf-ef07-3007-b2a5-e5c1757f9ee7",
                                "text": "a modern and spankingly clean subway system"
                            }
                        ]
                    }
                ],
