                                        "entry_id": "167e7408-dda3-3656-a35d-53f2d90f56f2",
                                        "glosses": [
                                            "Having two equal axes and one unequal, and all angles 90°."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
