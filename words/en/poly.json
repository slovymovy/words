                            }
                        },
                        {
                            "text": "Make sure to use a <w>poly</w> finish to protect the wooden table from water damage.",
                            "target_lang_translations": {
                                "ru": "Обязательно используйте <w>полиуретановое</w> покрытие, чтобы защитить деревянный стол от повреждения водой."
