{
    "word_family": [
        "prosecution",
        "prosecutor",
        "prosecutorial"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbffbf4a-15c2-3cd9-80d8-0bfd11f65f38",
                    "sense_definition": "To officially start a legal case against someone in a court of law for a crime.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>prosecute</w> the company for violating environmental safety regulations.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>привлечь к ответственности</w> компанию за нарушение правил экологической безопасности.",
                                "tr": "Hükümet, çevre güvenliği düzenlemelerini ihlal ettiği için şirkete <w>dava açmaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "The district attorney will <w>prosecute</w> the case despite the lack of physical evidence.",
                            "target_lang_translations": {
                                "ru": "Окружной прокурор будет <w>вести обвинение</w> по этому делу, несмотря на отсутствие вещественных доказательств.",
                                "tr": "Bölge savcısı, somut delil eksikliğine rağmen davayı <w>yürütecek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "indict",
                        "arraign",
                        "sue"
                    ],
                    "antonyms": [
                        "defend",
                        "pardon",
                        "exonerate"
                    ],
                    "common_phrases": [
                        "prosecute the case",
                        "prosecute for fraud",
                        "prosecute a crime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально возбуждать судебное дело против кого-либо в суде за совершение преступления.",
                        "tr": "Bir suç işlendiği iddiasıyla biri hakkında mahkemede resmi olarak yasal süreç başlatmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследовать в судебном порядке",
                                "target_lang_sense_clarification": "официально возбуждать дело"
                            },
                            {
                                "target_lang_word": "привлекать к ответственности",
                                "target_lang_sense_clarification": "за нарушение закона"
                            },
                            {
                                "target_lang_word": "обвинять",
                                "target_lang_sense_clarification": "выступать стороной обвинения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dava açmak",
                                "target_lang_sense_clarification": "yasal süreç başlatmak"
                            },
                            {
                                "target_lang_word": "dava yürütmek",
                                "target_lang_sense_clarification": "idddia makamı olarak bulunmak"
                            },
                            {
                                "target_lang_word": "kovuşturmak",
                                "target_lang_sense_clarification": "resmi olarak soruşturmak ve dava açmak"
                            },
                            {
                                "target_lang_word": "yargılamak",
                                "target_lang_sense_clarification": "mahkemede hesap sormak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7db01a23-70d5-3ca1-ad30-f611b3f7e7a7",
                    "sense_definition": "To continue with a task, activity, or investigation until it is finished.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pursuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military commander was determined to <w>prosecute</w> the war until a total victory was achieved.",
                            "target_lang_translations": {
                                "ru": "Военачальник был полон решимости <w>вести</w> войну до достижения полной победы.",
                                "tr": "Askeri komutan, tam bir zafer elde edilene kadar savaşı <w>sürdürmeye</w> kararlıydı."
                            }
                        },
                        {
                            "text": "They need more funding to <w>prosecute</w> the inquiry into the cause of the accident.",
                            "target_lang_translations": {
                                "ru": "Им нужно больше финансирования, чтобы <w>продолжить</w> расследование причин аварии.",
                                "tr": "Kaza nedenine ilişkin soruşturmayı <w>yürütmek</w> için daha fazla finansmana ihtiyaçları var."
                            }
                        }
                    ],
                    "synonyms": [
                        "pursue",
                        "carry on",
                        "conduct"
                    ],
                    "antonyms": [
                        "abandon",
                        "cease",
                        "halt"
                    ],
                    "common_phrases": [
                        "prosecute a war",
                        "prosecute an inquiry",
                        "prosecute a task"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or military contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать выполнение задачи, деятельности или расследования до их завершения.",
                        "tr": "Bir görevi, faaliyeti veya soruşturmayı tamamlanana kadar sürdürmek, devam ettirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "войну, расследование или дело"
                            },
                            {
                                "target_lang_word": "продолжать",
                                "target_lang_sense_clarification": "осуществлять деятельность"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "расследование или политику"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürdürmek",
                                "target_lang_sense_clarification": "devam ettirmek"
                            },
                            {
                                "target_lang_word": "yürütmek",
                                "target_lang_sense_clarification": "faaliyet veya savaşı yönetmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}