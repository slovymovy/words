                "senses": [
                    {
                        "sense_id": "c10af347-4bf6-38cd-8425-fbbee4fc93e1",
                        "entry_id": "9a91807a-be9b-3925-8d30-668e7f6077ca",
                        "glosses": [
                            "To ride public transport while standing and holding onto a strap."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f513788d-3298-4e7c-bc50-772069862fbb",
                                "sense_id": "c10af347-4bf6-38cd-8425-fbbee4fc93e1",
                                "text": "Instead of having people coming from the outskirts, straphanging in omnibuses and trains, working in the centre under congested conditions in badly lit, insanitary buildings[…]"
                            },
                            {
                                "example_id": "14c45c20-1e9d-4323-9b4b-abe4beebe68f",
                                "sense_id": "c10af347-4bf6-38cd-8425-fbbee4fc93e1",
                                "text": "Unheeding the conductor's warning glare, Mr. Devine straphung, smiling, his lips forming soundless phrases as though he enjoyed a delightful, inaudible conversation."
                            },
                            {
                                "example_id": "39c6caa0-f273-4c5d-a1e5-7fd4760a9eca",
                                "sense_id": "c10af347-4bf6-38cd-8425-fbbee4fc93e1",
                                "text": "He straphung for five stops, pressed on three sides by a young Rastafarian wearing a green-suede pillbox hat, an elderly, tiny Chinese couple, and a coffee-coloured nurse who was literally asleep on her feet."
                            },
                            {
                                "example_id": "4ba19dac-fc8d-4202-ad89-8932a8c7ba37",
                                "sense_id": "c10af347-4bf6-38cd-8425-fbbee4fc93e1",
                                "text": "It will take a long time for these commuters to come back. And clearly, from all the evidence we have so far, not many will be 'straphanging' five days per week. Indeed, straphanging itself may be a thing of the past."
                            }
                        ]
                    }
