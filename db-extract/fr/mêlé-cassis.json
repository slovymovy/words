                        "glosses": [
                            "Mélange d'eau-de-vie ou d'absinthe et de cassis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57e5939-79a8-44be-9cdf-92ded59c4b69",
                                "sense_id": "72d4490b-7d65-3894-bf8c-cef9bbc4c053",
                                "text": "Et l’on s’attablait. Le vin blanc d’abord, puis le mêlé-cassis, le trois-six, parfois quelques absinthes. Vers dix heures, Barjeot, très éméché, redescendait la Grande-Rue en zigzaguant, et rentrait à la Gendarmerie pour déjeuner."
                            },
                            {
                                "example_id": "e8fb9aad-9942-4a20-98bc-67b83774f333",
                                "sense_id": "72d4490b-7d65-3894-bf8c-cef9bbc4c053",
                                "text": "En buvant le dernier mêlé-cassis, Ribeyrou fut pris d'un éclat de rire."
                            }
                        ]
                    }
