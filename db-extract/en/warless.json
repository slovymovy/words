                "senses": [
                    {
                        "sense_id": "2591d982-2af9-321b-a500-44e061eccbb1",
                        "entry_id": "12210b6b-4e02-3d32-b9ef-d14186581fc3",
                        "glosses": [
                            "Without war, devoid of war."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "17833034-933c-4b45-8377-143689f43035",
                                "sense_id": "2591d982-2af9-321b-a500-44e061eccbb1",
                                "text": "Alas! in this he did not prove himself a true prophet, although it must be conceded that many wars have been averted or shortened by means of the telegraph, and there are some who hope that a warless age is even now being conceived in the womb of time."
                            },
                            {
                                "example_id": "1eba0767-8db8-462f-8ee5-6bb472e580ae",
                                "sense_id": "2591d982-2af9-321b-a500-44e061eccbb1",
                                "text": "It is really quite idle to dream of a warless world in which States are still absolutely free to annoy one another with tariffs, with the blocking and squeezing of trade routes, with the ill-treatment of immigrants and travelling strangers, and between which there is no means of settling boundary disputes."
                            },
                            {
                                "example_id": "86d867a2-31fb-4444-8364-be0f9965ec52",
                                "sense_id": "2591d982-2af9-321b-a500-44e061eccbb1",
                                "text": "Well; for nine and twenty years he held that vast empire warless; even though it included within its boundaries many restless and savage tribes."
                            }
                        ]
                    }
                ],
