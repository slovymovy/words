                "senses": [
                    {
                        "sense_id": "7b583c8c-0ede-3b5c-98e8-e9ea8025c8db",
                        "entry_id": "42e2349b-c065-3e19-acf2-c36eb0e7c3e4",
                        "glosses": [
                            "Surprendre de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07dabb48-5006-40d7-ba43-a342c560153b",
                                "sense_id": "7b583c8c-0ede-3b5c-98e8-e9ea8025c8db",
                                "text": "C'est l’amour qui les a surprises, et qui les resurprend chaque fois qu’elles vont se reposer."
                            },
                            {
                                "example_id": "a84848fd-5a63-4b78-849a-6b27e53118f7",
                                "sense_id": "7b583c8c-0ede-3b5c-98e8-e9ea8025c8db",
                                "text": "On est complètement resurpris par les éléments qu’on a installés soi-même, et parfois on doit refaire du montage pour mieux préparer et changer des choses."
                            }
                        ]
                    }
