                                "sense_id": "8c42d11b-8c11-39d5-9830-77ca3411a831",
                                "text": "Dergelijke opmerkingen worden hier niet op prijs gesteld."
                            },
                            {
                                "example_id": "09fa5873-d4e2-4cf8-8599-f5f0230a5116",
                                "sense_id": "8c42d11b-8c11-39d5-9830-77ca3411a831",
                                "text": "Waarom God hun alle drie een dergelijke gunst had verleend, was onmogelijk te begrijpen, evenmin waarom hij in hun jeugd hun vader en oom tot zich had genomen door hen te laten verdwijnen op zee."
                            },
                            {
                                "example_id": "6c98527f-6d9d-4e44-8b8e-1b63b6db200e",
                                "sense_id": "8c42d11b-8c11-39d5-9830-77ca3411a831",
                                "text": "Een dergelijke route afleggen zorgt voor een bepaalde loutering, waarbij we ons lichaam en onze ziel reinigen."
                            }
                        ]
                    }
