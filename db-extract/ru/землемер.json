                "senses": [
                    {
                        "sense_id": "8cf94fbd-90b7-3255-9acc-86d8f1ed70a0",
                        "entry_id": "f300ee93-6146-3727-9a9d-3b8a5b0fdf7b",
                        "glosses": [
                            "устар. специалист по межеванию и землеустройству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f84f6701-cde8-4e01-a652-d5441dcecbfc",
                                "sense_id": "8cf94fbd-90b7-3255-9acc-86d8f1ed70a0",
                                "text": "С открытием губерний топография вошла в обязанность землемеров, и круг действия их ограничился пределами, межевою инструкциею постановленными."
                            },
                            {
                                "example_id": "ef1ed76e-8a89-4c45-b560-af3bc0d0a9c4",
                                "sense_id": "8cf94fbd-90b7-3255-9acc-86d8f1ed70a0",
                                "text": "Землемер ли едет с поручением через вотскую деревню, он непременно в ней останавливается, берёт с телеги астролябию, вбивает шест, протягивает цепь."
                            }
                        ]
                    }
