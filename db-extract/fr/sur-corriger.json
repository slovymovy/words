                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ecb7040-8e07-4926-999c-d0f2bb59f3cf",
                                "sense_id": "5c6f90b6-eaa0-393d-b68d-0ca557adab67",
                                "text": "Ce niveau de centralisation est susceptible de sur-corriger tout problème de dispersion des rôles d'encadrement."
                            },
                            {
                                "example_id": "4d29e006-5996-4ff3-a251-002c04ff6dd7",
                                "sense_id": "5c6f90b6-eaa0-393d-b68d-0ca557adab67",
                                "text": "Pour les rotations dentaires, il est donc possible de sur-corriger légèrement et de faire 10 mois de contention au moyen du rotateur utilisé, évidemment fixe s'il s'agit d'une prémolaire ou molaire, ou bien de (...)"
                            }
                        ]
