                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ae1b76-649c-40f1-80d4-cb339145dbcc",
                                "sense_id": "df4d7a78-5bfb-3496-90a9-f77723b25417",
                                "text": "Il lui demanda son nom. Elle s’appelait Thérèse : le nom lui plut."
                            },
