                "senses": [
                    {
                        "sense_id": "3b99c1a8-65cf-3fdf-aba9-ba74a7a86e01",
                        "entry_id": "a3ce04a4-29ed-3f3c-a1b5-433ff4a7beba",
                        "glosses": [
                            "Einrichtung/Institution, die sich der Pflege und/oder dem Unterricht von Sprache widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6fdb59-c838-46e5-85ca-d67eedb68d91",
                                "sense_id": "3b99c1a8-65cf-3fdf-aba9-ba74a7a86e01",
                                "text": "„Sie waren vielmehr eine Art von Sprachakademien, die den Wortschatz und die Orthographie diskutierten und mit Hilfe bester Kenner Sprachgesetze dekretierten.“"
                            },
                            {
                                "example_id": "f6725ea9-613d-4ac4-a6b4-a5555c4fe6bf",
                                "sense_id": "3b99c1a8-65cf-3fdf-aba9-ba74a7a86e01",
                                "text": "„Während etwa in zahlreichen romanischen Ländern Sprachakademien eine maßgebliche Rolle spielen – in Italien die Accademia della Crusca (Florenz), in Frankreich die Académie française (Paris), in Spanien die Real Academia Española (Madrid) –, gibt es z.B. weder in Großbritannien noch in den USA vergleichbare Institutionen.“"
                            },
                            {
                                "example_id": "7aed1950-3fb7-4466-bbe9-08cada26c5df",
                                "sense_id": "3b99c1a8-65cf-3fdf-aba9-ba74a7a86e01",
                                "text": "„Wo man über nationale Sprachakademien verfügt, arbeiten diese in staatlichem Auftrag an Themen, die von praktischer Bedeutung für die jeweilige Sprachgemeinschaft sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
