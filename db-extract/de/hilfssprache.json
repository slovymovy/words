                    {
                        "form_id": "28067eb0-52e1-4c39-89d4-e2c70ab687ac",
                        "entry_id": "03b6642a-2862-3a46-8c9e-42c9b124c6d6",
                        "tags": [
                            "accusative",
                            "plural"
