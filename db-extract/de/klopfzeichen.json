                ],
                "senses": [
                    {
                        "sense_id": "8423e53e-f8dd-318c-825b-402feb7918d2",
                        "entry_id": "f2210408-1fb0-3015-8785-fb25bc3ad8ae",
                        "glosses": [
                            "Zeichen, das durch Klopfen gegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ebf606-2c0a-40f1-895d-542fbbd63a0d",
                                "sense_id": "8423e53e-f8dd-318c-825b-402feb7918d2",
                                "text": "„Auch hielt sie sich dabei nicht an konventionelle Zeiten, sondern erschien sowohl frühmorgens als auch spätabends, nach abgesprochenen, dem Morse-System nicht unähnlichen Klopfzeichen von bestimmter Folge und Dauer.“"
                            },
                            {
                                "example_id": "ef97edf3-0505-4e55-b995-92a94ee684ff",
                                "sense_id": "8423e53e-f8dd-318c-825b-402feb7918d2",
                                "text": "„Ein Klopfzeichen reichte und Aladin ließ uns wieder hinaus.“"
                            },
                            {
                                "example_id": "0fb9ec5b-e4ea-4e7b-9ad8-19fa0bb29254",
                                "sense_id": "8423e53e-f8dd-318c-825b-402feb7918d2",
                                "text": "„In einer Nacht Ende Januar 1942 hören die Adlers an ihrer Tür ein schnelles Klopfen, das nicht den verabredeten Klopfzeichen entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
