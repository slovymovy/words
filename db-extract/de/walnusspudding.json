                            {
                                "example_id": "59c017cd-dd74-485c-a2be-86f7fedb26cf",
                                "sense_id": "e2a0d75b-2a03-3737-8b42-4f5a01f55995",
                                "text": "„Zur Erquickung nach dem Begräbnis hatte Oma Minnie Apfeltorte und Gugelhupf mit Zitronenzuckerguss und Aprikosenquiche gebacken. Gewürzbrot mit Streuseln, Ahornriegel, Kirschkompott, Pfirsichpasteten, Birnenbrot, Rosinenmuffins, Kokoschips, Walnusspudding, Zimtschnecken, Pflaumenknödel und Haselnusshörnchen.“"
                            }
                        ],
