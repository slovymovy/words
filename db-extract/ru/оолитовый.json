                                "target_senses": [
                                    {
                                        "sense_id": "168c25dc-60a1-36d5-826a-a08376e03076",
                                        "entry_id": "f38e737c-65a0-32b0-acbc-a1d6c63c59eb",
                                        "glosses": [
                                            "Made up of, or containing oolites"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b11406-1eab-497f-8cb9-1e813d172cca",
                                                "sense_id": "168c25dc-60a1-36d5-826a-a08376e03076",
                                                "text": "Masses of white, finely oolitic rock are attached to the outside of some of these coated pebbles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a02d071-7e5e-392d-9703-93a4c7abe7ab",
                                        "entry_id": "f38e737c-65a0-32b0-acbc-a1d6c63c59eb",
                                        "glosses": [
                                            "Of a prehistoric era; Jurassic."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab6279b2-3785-4173-9de4-a038d4a2fc81",
                                                "sense_id": "0a02d071-7e5e-392d-9703-93a4c7abe7ab",
                                                "text": "These mines occur in the same ridge in which, about 120 miles to the northward, and subsequently in their more immediate neighborhood, we discovered the fossils belonging to the oolitic period"
                                            }
                                        ]
                                    }
                                ]
