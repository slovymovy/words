                        "entry_id": "995aca02-4391-3a20-b368-e68228f532f7",
                        "glosses": [
                            "A device for applying an adhesive tab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60da3854-5560-4b74-b9b2-3e35f9c66853",
                                "sense_id": "2d58cde0-bab6-3d02-977e-25f32f4b993a",
                                "text": "Mail tabbers are an economical and timesaving alternative for mass mailings, such as newsletters and brochures. Instead of inserting the pages inside an envelope, which then needs to be sealed, a tabber places a small adhesive tab (or wafer seal) on folded sheets of paper to securely hold them shut."
                            }
                        ]
                    },
                    {
                        "sense_id": "83d73daa-11cb-3291-9648-7e6a2d01435c",
                        "entry_id": "995aca02-4391-3a20-b368-e68228f532f7",
                        "glosses": [
                            "One who wears a tab of a specified kind."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "412b893e-c4fe-4f9a-9346-b638be290afc",
                                "sense_id": "83d73daa-11cb-3291-9648-7e6a2d01435c",
                                "text": "Under this system, outstanding freshmen cadets (green tabbers) are picked during the first semester, and \"marked\" with green shoulder tabs and green plastic lapel discs."
                            },
                            {
                                "example_id": "8c588fc0-a15f-4bd4-9a1f-19fb27a6fdf9",
                                "sense_id": "83d73daa-11cb-3291-9648-7e6a2d01435c",
                                "text": "But the sensitivity of the issue still lingered. To this day ex-servicemen still identify themselves as \"Red Tabbers\" or \"Red Tab\", […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e578cb89-b5c6-33fb-8fe2-bbf7c4d6dc3f",
                        "entry_id": "995aca02-4391-3a20-b368-e68228f532f7",
                        "glosses": [
                            "A user who switches between tabs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71350980-051a-4317-99b8-15c5ce91f1dc",
                                "sense_id": "e578cb89-b5c6-33fb-8fe2-bbf7c4d6dc3f",
                                "text": "OmniWeb has a reputation for fast browsing, but if you're a card-carrying member of TA (Tabbers Anonymous), you need the 5.0 beta version to get that feature."
                            }
                        ]
