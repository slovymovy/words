                    {
                        "sense_id": "692986a1-4c03-3d6f-a55a-23c838232ce0",
                        "entry_id": "a7f3f303-efe1-3b46-8402-feffae77641d",
                        "glosses": [
                            "Allée carrossable bordée d’arbres."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "3ada6fe2-f326-4bb2-bd7d-8ad985b264de",
                                "sense_id": "692986a1-4c03-3d6f-a55a-23c838232ce0",
                                "text": "Le lendemain, Petit-Pierre aperçut dans la drève un abbé monté sur sa mule."
                            },
                            {
                                "example_id": "dd0056ab-375f-42ec-9ba0-3d0116c8749b",
                                "sense_id": "692986a1-4c03-3d6f-a55a-23c838232ce0",
                                "text": "Il marchait aux côtés de son maître dans la drève, conduisant au château de la Héronnière, et voici qu'il avaient atteint la pelouse."
                            }
                        ]
                    },
                    {
                        "sense_id": "a91ded13-3583-36e1-9245-49e55d400b1e",
                        "entry_id": "a7f3f303-efe1-3b46-8402-feffae77641d",
                        "glosses": [
                            "Route en ligne droite traversant une forêt."
                        ],
                        "tags": [
                            "Nord de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "50de0ce9-ea50-4cea-a452-19e7b5f3df99",
                                "sense_id": "a91ded13-3583-36e1-9245-49e55d400b1e",
                                "text": "La drève des Boules d’Hérin (plus connue sous le nom de trouée d’Arenberg)."
                            }
                        ]
                    }
                ],
