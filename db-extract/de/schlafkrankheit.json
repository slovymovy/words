                        "entry_id": "42d6f35d-4502-3cdf-80e6-cc4ce8956b64",
                        "glosses": [
                            "durch die Tsetsefliege übertragene Tropenkrankheit, deren Endstadium vor allem durch Schläfrigkeit gekennzeichnet ist"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "c6c9ebe2-3eaf-4194-95fc-b474bce95be4",
                                "sense_id": "a0d92cb5-75ea-3024-9040-7151e9d5f1bc",
                                "text": "„Für den unbestreitbaren massiven Bevölkerungsschwund machen die Apologeten König Leopolds, damals wie heute, die Schlafkrankheit verantwortlich.“"
                            },
                            {
                                "example_id": "cec37678-3b70-4d64-90fd-ee3ac6c6d3b3",
                                "sense_id": "a0d92cb5-75ea-3024-9040-7151e9d5f1bc",
                                "text": "„Denn die Schlafkrankheit wütete im Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
