                                    {
                                        "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                        "entry_id": "dca185d5-7589-30a3-bc21-e74a07736218",
                                        "glosses": [
                                            "Dermatose inflammatoire et pustuleuse du visage ou de la partie supérieure du thorax, due à une inflammation des follicules pilosébacés (les glandes sécrétant le sébum, à la racine des poils) avec formation de comédons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa7e2a9-6732-467d-a509-226095c3ca47",
                                                "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                                "text": "Son visage est abimé par une acné sévère."
                                            },
                                            {
                                                "example_id": "1fdd739c-9c85-49ad-bba6-c127c694110a",
                                                "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                                "text": "L'acné est une dermatose chronique évoluant par poussées, très fréquente à la puberté."
                                            },
                                            {
                                                "example_id": "91f84aef-3224-4ebb-8cf4-a8a47b69adff",
                                                "sense_id": "79521706-4b83-3476-87f5-57f205d23c32",
                                                "text": "Observée de suffisamment haut dans l’exosphère, une explosion nucléaire ressemble à l’éclosion d’un bouton d’acné. — (Daniel Nayeri, Coco et Cloclo, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 293)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b46be7c-c7ef-4df5-a3c8-96d1e9123d8e",
