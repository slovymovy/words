                "senses": [
                    {
                        "sense_id": "a2c1b628-df2d-39de-9f30-d876fa4248ba",
                        "entry_id": "98aefcac-2827-3ab0-8459-534f94951480",
                        "glosses": [
                            "eine Niger-Kongo-Sprache (genauer: atlantische Sprache), die in Westafrika und Zentralafrika verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bc07d9b-cb26-42a2-a31c-a87a7cf92d6c",
                                "sense_id": "a2c1b628-df2d-39de-9f30-d876fa4248ba",
                                "text": "„Es sind aber nicht nur Listen eines einfachen semantischen Feldes (z. B. Vögel und Geräte aus dem Bereich der Fischerei), sondern auch echte zweisprachige Wortlisten, die für das Sprachenpaar Bambara und Ful gedichtet wurden.“"
                            },
                            {
                                "example_id": "13353e4c-6722-4f76-98fb-35db7f87667f",
                                "sense_id": "a2c1b628-df2d-39de-9f30-d876fa4248ba",
                                "text": "„Die Umfassende Ausbreitung des Ful als Zweitsprache in den Ethnien Adamauas ist zwar auch für das Untersuchungsgebiet, insbesondere Banyo, belegt […]“"
                            },
                            {
                                "example_id": "5f0d5e61-e76c-4901-80a2-2b070128d57f",
                                "sense_id": "a2c1b628-df2d-39de-9f30-d876fa4248ba",
                                "text": "„Ähnlich stehen in Niger Hausa, Songhai und Ful als größte Regionalsprachen der Staatssprache Französisch gegenüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
