                    "frequency": "Middle",
                    "semantic_group_id": "sadness_and_trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's financial <w>woes</w> began with the sudden drop in global demand.",
                            "target_lang_translations": {
                                "pl": "Finansowe <w>kłopoty</w> firmy zaczęły się od nagłego spadku globalnego popytu."
                            }
