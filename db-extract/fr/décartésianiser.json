                "senses": [
                    {
                        "sense_id": "fb0c08f9-d2c8-3725-af4c-044121ec419b",
                        "entry_id": "a38edc29-64eb-3f6e-850c-2e225086f40e",
                        "glosses": [
                            "Faire perdre son caractère cartésien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbbe73dc-8e0f-44c0-a371-d76b781d5185",
                                "sense_id": "fb0c08f9-d2c8-3725-af4c-044121ec419b",
                                "text": "Lorsque j’étais au collége de Clermont, à Paris, on tâcha de me décartésianiser en me mettant entre les mains une relation vraie ou fausse de ce qui s’était passé à ce sujet."
                            },
                            {
                                "example_id": "23a9eaf4-319a-4420-91d5-4b580f62275d",
                                "sense_id": "fb0c08f9-d2c8-3725-af4c-044121ec419b",
                                "text": "On voulait décartésianiser la France, et au commencement du XVIIIe siècle le cartésianisme vainqueur après cinquante années de lutte régnait partout sans contestation."
                            }
                        ]
                    }
                ],
