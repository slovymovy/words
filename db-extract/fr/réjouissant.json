                    {
                        "sense_id": "0680c6c5-284f-3455-a42c-fbc6b48c2d4c",
                        "entry_id": "9aa1017d-7489-3d06-b3e9-a11c9b688b8d",
                        "glosses": [
                            "Qui réjouit, qui amuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd07072-abd4-4a80-b5b0-6c93155e764b",
                                "sense_id": "0680c6c5-284f-3455-a42c-fbc6b48c2d4c",
                                "text": "Les rives de la Moselle sont vraiment pittoresques et réjouissantes au possible ; pour les artistes elles offrent un caractère tout particulier."
                            },
                            {
                                "example_id": "73d5aded-9294-40eb-91d6-d272f5486110",
                                "sense_id": "0680c6c5-284f-3455-a42c-fbc6b48c2d4c",
                                "text": "Rien de bien réjouissant. « C’est mieux que rien », se sont dit bon nombre de Québécois, en proie à l’écœurantite aiguë."
                            },
                            {
                                "example_id": "fd52f36e-5b4c-4965-b872-d5ad6a1a0ebb",
                                "sense_id": "0680c6c5-284f-3455-a42c-fbc6b48c2d4c",
                                "text": "Laurent Lafitte secoue Blanche Gardin et vice versa dans le réjouissant Tout le monde aime Jeanne, premier film de Céline Devaux découvert à la Semaine de la critique du Festival de Cannes et en salles ce mercredi."
                            }
                        ]
                    }
