                "senses": [
                    {
                        "sense_id": "731dd672-f932-3f83-b389-b52663bcdfa4",
                        "entry_id": "edf25935-491c-3ae1-be17-4c6a129cc485",
                        "glosses": [
                            "Enlever son caractère anglo-saxon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ff83e2-614b-4786-a1fe-0fc21f9de59d",
                                "sense_id": "731dd672-f932-3f83-b389-b52663bcdfa4",
                                "text": "Quoi de mieux pour la France que d’y faire son retour par la grande porte pour la \"désanglo-saxonniser\" ?"
                            },
                            {
                                "example_id": "9b060d70-b38a-488d-be7b-9465e711ffaa",
                                "sense_id": "731dd672-f932-3f83-b389-b52663bcdfa4",
                                "text": "Ce qui fait que cette Amérique-là ne se reconnaît plus dans celle qui est venue ensuite, c’est que, du fait de la troisième vague d’immigration, elle s’est désanglo-saxonnisée."
                            },
                            {
                                "example_id": "0ce1f5ca-8af4-4da1-876e-cc0783c4c395",
                                "sense_id": "731dd672-f932-3f83-b389-b52663bcdfa4",
                                "text": "Cette Amérique n’est plus. Du fait de la troisième vague d’immigration et des conditions nouvelles de l’existence au xxe siècle, elle a tendu à se désanglo-saxonniser."
                            }
                        ]
                    }
