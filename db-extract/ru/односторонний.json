                    },
                    {
                        "sense_id": "8c1a7c7a-acc2-3d9e-97d7-d410ce2bd559",
                        "entry_id": "e3929100-ca80-3820-8416-a192d4f72f52",
                        "glosses": [
                            "ограниченный, направленный только в одну сторону"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee940a0-8b4e-4160-8daa-3b04f1663ae1",
                                "sense_id": "8c1a7c7a-acc2-3d9e-97d7-d410ce2bd559",
                                "text": "Из различных вариантов этого понятия мы в настоящей работе будем рассматривать понятие одностороннего недетерминированного стекового автомата."
                            },
