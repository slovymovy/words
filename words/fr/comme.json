{
    "word_family": [
        "comment"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "41db59c9-a4de-3c55-9644-3982fcb11f2c",
                    "sense_definition": "Indique la ressemblance ou la conformité entre deux éléments : de la même manière que, pareil à.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "comparaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il chante très bien <w>comme</w> son père depuis son plus jeune âge."
                        },
                        {
                            "text": "Nous irons au restaurant ce soir <w>comme</w> convenu après notre travail."
                        }
                    ],
                    "common_phrases": [
                        "comme toujours",
                        "comme convenu"
                    ]
                },
                {
                    "sense_id": "6a99008c-a97c-368e-9255-b024dcc6273b",
                    "sense_definition": "Indique le rôle, la fonction ou la qualité : en tant que, en qualité de.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a commencé à travailler <w>comme</w> professeure dans cette école."
                        },
                        {
                            "text": "Cette caisse en bois peut servir <w>comme</w> table de nuit."
                        }
                    ],
                    "common_phrases": [
                        "travailler comme",
                        "servir comme"
                    ]
                },
                {
                    "sense_id": "677e2877-d788-3151-ae5d-862d8270d16a",
                    "sense_definition": "Sert à introduire un ou plusieurs exemples : tel que, par exemple.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exemple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'aime beaucoup visiter des pays européens <w>comme</w> l'Espagne et le Portugal."
                        },
                        {
                            "text": "Elle apprécie les sports d'hiver <w>comme</w> le ski et le patinage."
                        }
                    ],
                    "common_phrases": [
                        "des choses comme",
                        "des personnes comme"
                    ]
                },
                {
                    "sense_id": "278e25d1-875a-31c9-acb6-e204cc5e206d",
                    "sense_definition": "Introduit une cause ou une explication en tête de proposition : étant donné que, vu que.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Comme</w> il pleuvait abondamment, nous avons préféré rester à l'intérieur."
                        },
                        {
                            "text": "<w>Comme</w> prévu, le train est arrivé à l'heure à la gare centrale."
                        }
                    ],
                    "synonyms": [
                        "puisque",
                        "car"
                    ],
                    "common_phrases": [
                        "comme prévu"
                    ]
                },
                {
                    "sense_id": "6d9024ce-6a86-3d8c-a3da-fd8d488a6680",
                    "sense_definition": "Indique la simultanéité temporelle : au moment où, pendant que.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Comme</w> le train entrait en gare, les voyageurs se sont levés."
                        },
                        {
                            "text": "<w>Comme</w> le soleil se couchait, une brise fraîche a commencé à souffler."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "caf660a6-14c6-31fa-84c1-0d979c54a2b3",
                    "sense_definition": "Exprime l'admiration, la surprise ou l'intensité dans une proposition exclamative : à quel point, combien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Comme</w> cette maison ancienne est charmante et chaleureuse !"
                        },
                        {
                            "text": "<w>Comme</w> le temps passe vite pendant les vacances scolaires !"
                        }
                    ],
                    "common_phrases": [
                        "comme le temps passe"
                    ]
                },
                {
                    "sense_id": "61b6ee4d-5454-380a-b52d-1ab78f9796d2",
                    "sense_definition": "Sert à marquer une similitude hypothétique ou une approximation : presque, pour ainsi dire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a préféré faire <w>comme</w> si rien d'anormal ne s'était passé."
                        },
                        {
                            "text": "Elle continue d'agir <w>comme</w> si elle ne comprenait pas la situation."
                        }
                    ],
                    "common_phrases": [
                        "faire comme si",
                        "agir comme si"
                    ]
                }
            ]
        }
    ]
}