                                        "sense_id": "2c346411-8088-38f5-8451-67819ac239ff",
                                        "entry_id": "c44b92e0-7276-3b3f-ae57-c3de9fc795cb",
                                        "glosses": [
                                            "Activité, divertissement qui consiste à lancer des nains le plus loin possible."
                                        ],
                                        "tags": [],
                                        "note": "Cette activité est considérée comme portant atteinte à la dignité humaine",
                                        "examples": [
                                            {
                                                "example_id": "d8261d7c-4c90-4e48-935f-26c6ec502b2c",
                                                "sense_id": "2c346411-8088-38f5-8451-67819ac239ff",
                                                "text": "Spectacle de lancer de nain, pour autant d'ailleurs que l'on puisse considérer cela comme un spectacle, qui consiste, comme vous l'imaginez, à se saisir d'une personne de petite taille pour essayer de la projeter le plus loin possible, et ce spectacle était naturellement organiser avec l'accord du nain qui y trouvait un moyen de subsistance, et avait été interdit par un maire considérant que ce spectacle était par définition dégradant et portait atteinte à la dignité humaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
