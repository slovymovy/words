                        "examples": [
                            {
                                "example_id": "63037a28-b9a2-4787-8358-c93e3d76fc1f",
                                "sense_id": "72fcdd5b-8dae-3d46-9d34-c5b0a1ebbe5e",
                                "text": "The place for the fuel is carried up ſtrait on both ſides, till about three feet high ; then they almoſt fill it with wood, and over that lay a covering of ſea-coal, and then overſpan the arch[…]"
                            },
                            {
                                "example_id": "709c67f7-996e-4fb5-812f-273b574e97ee",
                                "sense_id": "72fcdd5b-8dae-3d46-9d34-c5b0a1ebbe5e",
                                "text": "If we look at the geographical position, which the great world-powers (England, Russia, and France) occupy on the surface of the globe, we shall perceive that the actual Russian territories in Europe, Asia, and America, overspan, like an arch, all the civilised countries of Europe, and the vast territories of Tartary and China—descending moreover, like the shoot of a root, from the shores of the Caspian and Aral seas towards the Indian Empire."
                            },
                            {
                                "example_id": "c44150b3-5c2b-44a2-a732-e0ab795e3b1f",
                                "sense_id": "72fcdd5b-8dae-3d46-9d34-c5b0a1ebbe5e",
                                "text": "The majestic proportions of this bridge may be partly realized by a few comparisons. […] This bridge would overspan the Capitol at Washington and clear the top of the dome by 51 feet."
                            }
                        ]
                    }
