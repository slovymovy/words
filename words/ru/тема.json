{
    "word_family": [
        "тематика",
        "тематический",
        "темка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5b9a909-df50-3a32-b4e2-28b7689b1550",
                    "sense_definition": "Основной предмет разговора, обсуждения, книги или исследования; то, о чём идет речь.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель объяснил новую <тему> урока.",
                            "target_lang_translations": {
                                "en": "The teacher explained the new lesson <topic>.",
                                "cs": "Učitel vysvětlil nové <téma> hodiny."
                            }
                        },
                        {
                            "text": "Мы долго обсуждали эту важную <тему>.",
                            "target_lang_translations": {
                                "en": "We discussed this important <topic> for a long time.",
                                "cs": "Dlouho jsme diskutovali o tomto důležitém <tématu>."
                            }
                        }
                    ],
                    "synonyms": [
                        "тематика",
                        "топик",
                        "вопрос",
                        "предмет"
                    ],
                    "antonyms": [
                        "вода"
                    ],
                    "common_phrases": [
                        "сменить тему",
                        "актуальная тема",
                        "закрыть тему",
                        "свободная тема",
                        "тема урока"
                    ],
                    "target_lang_definitions": {
                        "en": "The main subject of a conversation, discussion, book, or study; what is being talked about.",
                        "cs": "Hlavní předmět hovoru, diskuse, knihy nebo studie; to, o čem se mluví."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "topic",
                                "target_lang_sense_clarification": "subject of conversation or discussion"
                            },
                            {
                                "target_lang_word": "subject",
                                "target_lang_sense_clarification": "area of study or discussion"
                            },
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "central idea in a book or art"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "téma",
                                "target_lang_sense_clarification": "obecný předmět hovoru či diskuse"
                            },
                            {
                                "target_lang_word": "námět",
                                "target_lang_sense_clarification": "předmět uměleckého díla nebo studie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60384a86-3d0e-33d0-8a00-e8a4412382c0",
                    "sense_definition": "Что-то интересное, выгодное, стоящее внимания или отличная идея.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поехать на море зимой — это отличная <тема>.",
                            "target_lang_translations": {
                                "en": "Going to the sea in winter is a great <idea>.",
                                "cs": "Jet v zimě k moři, to je skvělá <pecka>."
                            }
                        },
                        {
                            "text": "Твой план просто супер, реальная <тема>!",
                            "target_lang_translations": {
                                "en": "Your plan is super, the real <deal>!",
                                "cs": "Tvůj plán je super, fakt <pecka>!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "это тема",
                        "реальная тема"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something interesting, profitable, worth attention, or a great idea.",
                        "cs": "Něco zajímavého, výhodného, hodného pozornosti nebo skvělý nápad."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "great idea",
                                "target_lang_sense_clarification": "informal"
                            },
                            {
                                "target_lang_word": "cool thing",
                                "target_lang_sense_clarification": "informal"
                            },
                            {
                                "target_lang_word": "the real deal",
                                "target_lang_sense_clarification": "slang, something genuine or excellent"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pecka",
                                "target_lang_sense_clarification": "slangově, něco skvělého"
                            },
                            {
                                "target_lang_word": "dobrý nápad",
                                "target_lang_sense_clarification": "neformálně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c769df96-403b-3862-afd0-f2bf8cd0f79e",
                    "sense_definition": "Музыкальная мелодия, которая является основой для построения произведения или его части.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Главная <тема> симфонии звучит очень торжественно.",
                            "target_lang_translations": {
                                "en": "The main <theme> of the symphony sounds very solemn.",
                                "cs": "Hlavní <téma> symfonie zní velmi slavnostně."
                            }
                        },
                        {
                            "text": "Композитор мастерски развивает эту <тему> в финале.",
                            "target_lang_translations": {
                                "en": "The composer masterfully develops this <theme> in the finale.",
                                "cs": "Skladatel mistrně rozvíjí toto <téma> ve finále."
                            }
                        }
                    ],
                    "synonyms": [
                        "лейтмотив"
                    ],
                    "antonyms": [
                        "вариация"
                    ],
                    "common_phrases": [
                        "главная тема",
                        "побочная тема",
                        "музыкальная тема"
                    ],
                    "target_lang_definitions": {
                        "en": "A musical melody that serves as the basis for constructing a work or a part of it.",
                        "cs": "Hudební melodie, která slouží jako základ pro stavbu díla nebo jeho části."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "music"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "téma",
                                "target_lang_sense_clarification": "hudební motiv"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb443fe6-3a44-3d4f-9904-2a582aa0150d",
                    "sense_definition": "Исходная часть предложения, содержащая известную информацию (в противоположность новой информации — реме).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом предложении подлежащее выступает как <тема>.",
                            "target_lang_translations": {
                                "en": "In this sentence, the subject acts as the <theme>.",
                                "cs": "V této větě vystupuje podmět jako <téma>."
                            }
                        },
                        {
                            "text": "Анализ текста требует выделения <темы> и ремы.",
                            "target_lang_translations": {
                                "en": "Text analysis requires identifying the <theme> and rheme.",
                                "cs": "Analýza textu vyžaduje určení <tématu> a rématu."
                            }
                        }
                    ],
                    "antonyms": [
                        "рема"
                    ],
                    "common_phrases": [
                        "тема и рема"
                    ],
                    "target_lang_definitions": {
                        "en": "The initial part of a sentence containing known information (as opposed to new information — rheme).",
                        "cs": "Výchozí část věty obsahující známou informaci (v protikladu k nové informaci – rématu)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "linguistics"
                            },
                            {
                                "target_lang_word": "topic",
                                "target_lang_sense_clarification": "linguistics"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "téma",
                                "target_lang_sense_clarification": "lingvistika, východisko výpovědi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7e75c0c-a084-31b9-a2d3-04b5891603fa",
                    "sense_definition": "Обозначение принадлежности к ЛГБТ-сообществу или осведомленности о его культуре.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сразу понял, что новый знакомый в <теме>.",
                            "target_lang_translations": {
                                "en": "He immediately understood that the new acquaintance was <in the know>.",
                                "cs": "Hned pochopil, že nový známý je <v obraze>."
                            }
                        },
                        {
                            "text": "Они обсуждали свои вопросы, так как оба были в <теме>.",
                            "target_lang_translations": {
                                "en": "They discussed their issues since both were <in the know>.",
                                "cs": "Probírali své otázky, protože oba byli <v obraze>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "быть в теме"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "LGBT"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An indication of belonging to the LGBT community or awareness of its culture.",
                        "cs": "Označení příslušnosti k LGBT komunitě nebo povědomí o její kultuře."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in the know",
                                "target_lang_sense_clarification": "idiom, aware of the situation"
                            },
                            {
                                "target_lang_word": "part of the scene",
                                "target_lang_sense_clarification": "idiom, belonging to a subculture"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "být v obraze",
                                "target_lang_sense_clarification": "idiom, být informovaný"
                            },
                            {
                                "target_lang_word": "být součástí komunity",
                                "target_lang_sense_clarification": "příslušnost k subkultuře"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a6dc46c4-ecb2-3d7c-bc24-b59d03ad05e5",
                    "sense_definition": "Мужское имя, уменьшительная форма от имён Артём или Артемий.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего лучшего друга зовут <Тёма>.",
                            "target_lang_translations": {
                                "en": "My best friend's name is <Tyoma>.",
                                "cs": "Můj nejlepší kamarád se jmenuje <Tjoma>."
                            }
                        },
                        {
                            "text": "<Тёма> пришел в гости с большим тортом.",
                            "target_lang_translations": {
                                "en": "<Tyoma> came to visit with a big cake.",
                                "cs": "<Tjoma> přišel na návštěvu s velkým dortem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "дядя Тёма"
                    ],
                    "target_lang_definitions": {
                        "en": "A male name, a diminutive form of the names Artem or Artemiy.",
                        "cs": "Mužské jméno, domácká podoba jmen Artěm nebo Artěmij."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Tyoma",
                                "target_lang_sense_clarification": "name"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Tjoma",
                                "target_lang_sense_clarification": "jméno"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}