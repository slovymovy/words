                                "target_senses": [
                                    {
                                        "sense_id": "6bf31e1e-17d9-3f49-9cb8-7fc45f33dfe5",
                                        "entry_id": "32ffb27e-186b-3901-9b6c-b91a52b62833",
                                        "glosses": [
                                            "To destroy oneself or itself."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1271b911-97a1-42e0-bf5e-7eacb6197623",
                                                "sense_id": "6bf31e1e-17d9-3f49-9cb8-7fc45f33dfe5",
                                                "text": "The submarine was primed to self-destruct."
                                            },
                                            {
                                                "example_id": "ac6998a6-ad37-4ff7-b09d-290c16aae72b",
                                                "sense_id": "6bf31e1e-17d9-3f49-9cb8-7fc45f33dfe5",
                                                "text": "The Ferraris pressed the self-destruct button, Lewis Hamilton lost his spot on the podium, and there were champagne moments for Pierre Gasly and Carlos Sainz Jr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b371ac19-8a09-3fef-9c02-a5076fa25104",
                                        "entry_id": "32ffb27e-186b-3901-9b6c-b91a52b62833",
                                        "glosses": [
                                            "To destroy or greatly damage one's position in a game, in one's work or career, in one's financial or social position, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1efa8935-a73b-4c35-939c-b574e4742919",
                                                "sense_id": "b371ac19-8a09-3fef-9c02-a5076fa25104",
                                                "text": "If you attack with an energy level of only 30 you are going to self-destruct."
                                            },
                                            {
                                                "example_id": "30ca3abb-a401-438f-a544-5d56c0dcd654",
                                                "sense_id": "b371ac19-8a09-3fef-9c02-a5076fa25104",
                                                "text": "Dating the boss is a bad move: if it goes badly, you could self-destruct."
                                            }
                                        ]
                                    }
                                ]
                            }
