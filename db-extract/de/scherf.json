                "senses": [
                    {
                        "sense_id": "0cfc658a-0670-346e-86f0-6001eee933d3",
                        "entry_id": "29c7d400-3394-3011-8cac-dd8b77b41bd5",
                        "glosses": [
                            "die kleinste Münze"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e8a0b4e4-9f83-4cd0-9206-6a699c543cbd",
                                "sense_id": "0cfc658a-0670-346e-86f0-6001eee933d3",
                                "text": "[…] hat verkündet, daß die Arnoldus-Gulden (Geldern) von dreierlei Wert seien, und daß man die Goldschmiede Hans Langen und Hans Schulten angestellt habe, damit sie einen jeden Gulden zeichnen, das heißt also gegenstempeln möchten, gegen die Entrichtung eines Scherfs (halber Pfennig)."
                            },
                            {
                                "example_id": "ba2df6af-4754-4024-b687-652fead6a046",
                                "sense_id": "0cfc658a-0670-346e-86f0-6001eee933d3",
                                "text": "„Sie ließ durch eine Magd die Alte mit Tee und Gebäck bewirten und packte ihr beim Abschiede drei Scherf Silber als Arzneigeld ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ce54ffd7-42a1-341e-b423-f21338ac9b56",
                        "entry_id": "29c7d400-3394-3011-8cac-dd8b77b41bd5",
                        "glosses": [
                            "ein sehr kleiner monetärer Betrag"
                        ],
                        "tags": [
                            "archaic",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd3b271-923c-4a0a-b666-c391c651f7a4",
                                "sense_id": "ce54ffd7-42a1-341e-b423-f21338ac9b56",
                                "text": "Er hat keinen Scherf zu dem gesamten Betrag von sich aus beigetragen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
