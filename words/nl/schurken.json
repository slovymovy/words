                    "sense_id": "f736a4f2-60a6-3d81-a4f0-fdeb1094426a",
                    "sense_definition": "Zich tegen een vast voorwerp wrijven, meestal om jeuk te bestrijden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het paard <w>schurkte</w> zich tegen een boompje om van de jeuk af te komen.",
                            "target_lang_translations": {
                                "en": "The horse <w>rubbed</w> itself against a small tree to get rid of the itch.",
                                "fr": "Le cheval <w>s'est frotté</w> contre un petit arbre pour se soulager de la démangeaison."
                            }
                        },
                        {
                            "text": "De kat houdt ervan om zich tegen de tafelpoot te <w>schurken</w>.",
                            "target_lang_translations": {
                                "en": "The cat likes to <w>rub</w> against the table leg.",
                                "fr": "Le chat aime <w>se frotter</w> contre le pied de la table."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheuken"
                    ],
                    "common_phrases": [
                        "tegen een boom schurken"
                    ],
                    "target_lang_definitions": {
                        "en": "To rub oneself against a solid object, usually to relieve an itch.",
                        "fr": "Se frotter contre un objet solide, généralement pour soulager une démangeaison."
                    },
                    "translations": {
                        "en": [
                            {
