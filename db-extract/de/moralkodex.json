                "senses": [
                    {
                        "sense_id": "9836deee-9a64-32f5-9316-63d0dd8a2b4a",
                        "entry_id": "accaeaaf-d2fb-343b-9264-5e6c638e7a69",
                        "glosses": [
                            "Gesamtheit moralischer Vorschriften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37719e62-6cf7-479f-a277-360c699733a0",
                                "sense_id": "9836deee-9a64-32f5-9316-63d0dd8a2b4a",
                                "text": "„Zwar kamen sie wie alle Sterblichen vom Wege ab, doch zwang ihr rigider Moralkodex sie, diese Vergehen unter allen Umständen zu verheimlichen - was schließlich dazu führte, dass das Verheimlichte mit der Zeit immer geschmackloser wurde.“"
                            },
                            {
                                "example_id": "0f7fbb54-9a5a-4a3d-9840-22057c07c901",
                                "sense_id": "9836deee-9a64-32f5-9316-63d0dd8a2b4a",
                                "text": "„Im Gegensatz zu vielen anderen revolutionären Bewegungen formulierte die zionistische Bewegung nie einen eigenen Moralkodex.“"
                            },
                            {
                                "example_id": "361a02b5-5c26-4a9e-bb34-12e6bb7cab95",
                                "sense_id": "9836deee-9a64-32f5-9316-63d0dd8a2b4a",
                                "text": "„Und normalerweise lebte er nach dem Moralkodex Onkel Sollys.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
