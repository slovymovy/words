                                "target_senses": [
                                    {
                                        "sense_id": "5767059f-7f1d-337b-bf3e-62a9fa6700da",
                                        "entry_id": "f0d6e679-ae6d-3113-a7ff-f2795a6e3f35",
                                        "glosses": [
                                            "A city in Sfax Governorate, Tunisia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c5a25f-dafe-4781-8ee3-64d70bfc0c94",
                                                "sense_id": "5767059f-7f1d-337b-bf3e-62a9fa6700da",
                                                "text": "On a recent afternoon in the Tunisian coastal city of Sfax, as shoppers hurried around a market buying food and drink for that evening’s iftar meal, a small group of men from sub-Saharan Africa gathered near a stall selling phone accessories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "053b0645-1582-3912-a688-e0309a23e5d7",
                                        "entry_id": "f0d6e679-ae6d-3113-a7ff-f2795a6e3f35",
                                        "glosses": [
                                            "Sfax Governorate, one of the governorates in Tunisia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06905866-f1b4-4c6e-938c-eb37a3a220fe",
                        "source_entry_id": "4f437e4b-6b0a-3335-b024-0dad63963644",
                        "source_sense_id": "ff33c33b-a248-3d11-b024-b286b05279de",
                        "source_sense_description": "zweitgrößte Stadt Tunesiens",
                        "target_lang_word": "Sfax",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sfax",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6440601d-f567-39c1-bf1e-22f965019a2e",
                                        "entry_id": "015e4242-2559-3d81-9d4d-691651513a3a",
                                        "glosses": [
                                            "Ville de Tunisie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0327186b-e9f3-446d-9d40-8f215c3134b0",
                                                "sense_id": "6440601d-f567-39c1-bf1e-22f965019a2e",
                                                "text": "Et puis, Sfax, dont ils connaissaient à peine le nom, c’était le bout du monde, le désert, et il ne leur déplaisait même plus de penser, avec ce goût si fort pour les situations extrêmes, qu’ils allaient être coupés de tout, éloignés de tout, isolés comme ils ne l’avaient jamais été."
                                            },
                                            {
                                                "example_id": "8516b647-b929-4ce7-a0bf-4c3ad46f1826",
                                                "sense_id": "6440601d-f567-39c1-bf1e-22f965019a2e",
                                                "text": "Si la résistance a eu lieu à Sfax et pas à Kairouan, c'est parce que Sfax était fortifiée d'une part et et qu'elle abritait la mehalla au moment de l'occupation."
                                            },
                                            {
                                                "example_id": "2d34136f-a01d-4b7c-bdb2-f5b213a83df6",
                                                "sense_id": "6440601d-f567-39c1-bf1e-22f965019a2e",
                                                "text": "En juillet 2008 la section d'autoroute reliant M'saken à Sfax, longue de 98 km a été inaugurée. Cette section se compose de deux tronçons, le premier reliant M'saken et El Jem et le second El Jem et Sfax-Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
