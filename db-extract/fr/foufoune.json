        "fr-extract.jsonl": [
            {
                "entry_id": "6a65d353-2a42-34a4-9326-b1551fe39dd2",
                "word": "foufoune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a6dd8c63-01db-4968-8f49-c4c7be1b743c",
                        "entry_id": "6a65d353-2a42-34a4-9326-b1551fe39dd2",
                        "tags": [
                            "plural"
                        ],
                        "form": "foufounes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9dbe9fe-9c3b-3d93-a7cf-fc4911ec63ed",
                        "entry_id": "6a65d353-2a42-34a4-9326-b1551fe39dd2",
                        "glosses": [
                            "ou Fesse."
                        ],
                        "tags": [
                            "childish",
                            "familiar"
                        ],
                        "note": "Ce terme est généralement utilisé au pluriel",
                        "examples": [
                            {
                                "example_id": "93acf7f4-68e7-4fc3-8ca9-95ff102726b2",
                                "sense_id": "b9dbe9fe-9c3b-3d93-a7cf-fc4911ec63ed",
                                "text": "De l’autre, elle se dandine les foufounes et se comporte comme une entraîneuse !"
                            },
                            {
                                "example_id": "d2b00b07-8c54-4774-a960-223ee079ffba",
                                "sense_id": "b9dbe9fe-9c3b-3d93-a7cf-fc4911ec63ed",
                                "text": "Un cheval en bois c’est dur pour les foufounes !"
                            },
                            {
                                "example_id": "1061852f-d5d3-4ba9-832b-26fc30cfd5a6",
                                "sense_id": "b9dbe9fe-9c3b-3d93-a7cf-fc4911ec63ed",
                                "text": "Les « Foufounes électriques », ou les Fouf’, est un bar très populaire à Montréal."
                            }
                        ]
                    },
                    {
                        "sense_id": "15f013d0-4070-3a86-b2f1-6441cbe81564",
                        "entry_id": "6a65d353-2a42-34a4-9326-b1551fe39dd2",
                        "glosses": [
                            "ou Vulve."
                        ],
                        "tags": [
                            "familiar",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a0fdda40-cdc0-408e-883c-e2b7c3c95e3c",
                                "sense_id": "15f013d0-4070-3a86-b2f1-6441cbe81564",
                                "text": "EXPLOSER LA FOUFOUNE. loc. verb. faire l’amour (garçon). « Il dit qu’il lui a explosé la foufoune, je te dis pas l’embrouille ! »"
                            },
                            {
                                "example_id": "d5773c3c-11da-48c3-885f-80e0c8b3fed2",
                                "sense_id": "15f013d0-4070-3a86-b2f1-6441cbe81564",
                                "text": "Cet hiver, il faudra avoir les seins plus hauts que les épaules et la foufoune dépeuplée."
                            },
                            {
                                "example_id": "de64d6a9-6828-4512-a7de-1e1298e9b712",
                                "sense_id": "15f013d0-4070-3a86-b2f1-6441cbe81564",
                                "text": "Oui, acquiesça Lolita Fourmi : au rythme où il est parti, s’il ne lève pas un peu le pied, ça craint du boudin pour les excitées de la foufoune qui vont croiser sa route."
                            },
                            {
                                "example_id": "a8c7a7e8-b0f2-4b7e-85bc-fc62a7d0a785",
                                "sense_id": "15f013d0-4070-3a86-b2f1-6441cbe81564",
                                "text": "Ma puce, as-tu bien débarbouillé ta foufoune ?"
                            }
                        ]
                    }
                ],
