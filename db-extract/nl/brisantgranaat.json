                        "examples": [
                            {
                                "example_id": "1eb08d57-5429-4208-becb-7d39dafd6343",
                                "sense_id": "830f993a-320d-3afb-a724-be47c95b856a",
                                "text": "Uit voorzorg werden twee flats in de omgeving ontruimd. Zo'n honderd mensen moesten tijdelijk hun huis uit. Uiteindelijk bleek het te gaan om een brisantgranaat zonder springstof erin. De EOD onderzoekt de granaat verder."
                            },
                            {
                                "example_id": "ecaa55ae-ec5a-4b84-a332-8083e310f42d",
                                "sense_id": "830f993a-320d-3afb-a724-be47c95b856a",
                                "text": "Op het forteiland Pampus bij Muiden is een Engelse brisantgranaat uit de Tweede Wereldoorlog onschadelijk gemaakt."
                            }
                        ]
