                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>frère</w> aîné travaille dans une boulangerie près de chez nous."
                        },
                        {
                            "text": "Elle partage sa chambre avec son petit <w>frère</w> depuis toujours."
                        }
                    ],
                    "synonyms": [
                        "frangin",
                        "frérot",
                        "reuf"
                    ],
                    "antonyms": [
                        "sœur"
                    ],
                    "common_phrases": [
