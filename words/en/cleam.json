{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a04e304b-64ca-3278-8cc7-40107435ed2c",
                    "sense_definition": "To smear, rub on, or spread an oily, sticky, or viscous substance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "apply_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker had to <w>cleam</w> thick grease across the heavy iron gears to prevent them from grinding.",
                            "target_lang_translations": {
                                "ru": "Рабочему пришлось <w>намазать</w> толстый слой густой смазки на тяжелые железные шестерни, чтобы предотвратить их скрежет."
                            }
                        },
                        {
                            "text": "He used a broad wooden paddle to <w>cleam</w> fresh pitch over the seams of the boat.",
                            "target_lang_translations": {
                                "ru": "С помощью широкой деревянной лопатки он <w>замазал</w> свежей смолой швы лодки."
                            }
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "bedaub",
                        "anoint"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Primarily found in regional or dialectal English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намазывать, размазывать или втирать маслянистое, липкое или вязкое вещество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намазывать",
                                "target_lang_sense_clarification": "покрывать слоем вязкого вещества"
                            },
                            {
                                "target_lang_word": "мазать",
                                "target_lang_sense_clarification": "наносить смолу, жир или смазку"
                            },
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "наносить вещество для защиты или скольжения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d6a46ee-9ecc-3b98-81d0-57613e523b3b",
                    "sense_definition": "To cause something to stick or adhere to a surface; to glue or fasten on.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully <w>cleamed</w> the torn wallpaper back onto the dry plaster with paste.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>приклеила</w> оторванные обои обратно к сухой штукатурке с помощью клейстера."
                            }
                        },
                        {
                            "text": "They would <w>cleam</w> the damp label onto each glass jar before packing them away.",
                            "target_lang_translations": {
                                "ru": "Они <w>наклеивали</w> влажную этикетку на каждую стеклянную банку перед тем, как упаковать их."
                            }
                        }
                    ],
                    "synonyms": [
                        "glue",
                        "paste",
                        "affix"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Primarily found in regional or dialectal English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приклеивать, прикреплять или заставлять что-либо прилипнуть к поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приклеивать",
                                "target_lang_sense_clarification": "соединять клеем или липким составом"
                            },
                            {
                                "target_lang_word": "прилеплять",
                                "target_lang_sense_clarification": "прикреплять с помощью вязкого вещества"
                            },
                            {
                                "target_lang_word": "наклеивать",
                                "target_lang_sense_clarification": "прикреплять на поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8eb7bf6a-a6a0-39e4-89a7-be107a465d53",
                    "sense_definition": "To stick, cling, or adhere closely to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wet clay tended to <w>cleam</w> tightly to the soles of the travelers' leather boots.",
                            "target_lang_translations": {
                                "ru": "Влажная глина постоянно <w>налипала</w> на подошвы кожаных сапог путешественников."
                            }
                        },
                        {
                            "text": "The damp leaves <w>cleamed</w> against the wooden fence throughout the stormy autumn night.",
                            "target_lang_translations": {
                                "ru": "Всю штормовую осеннюю ночь мокрые листья <w>липли</w> к деревянному забору."
                            }
                        }
                    ],
                    "synonyms": [
                        "cling",
                        "adhere",
                        "stick"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Primarily found in regional or dialectal English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилипать, приставать или плотно удерживаться на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилипать",
                                "target_lang_sense_clarification": "крепко держаться на поверхности"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "липнуть к чему-либо"
                            },
                            {
                                "target_lang_word": "налипать",
                                "target_lang_sense_clarification": "накапливаться, прилипая к предмету"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}