{
    "word_family": [
        "onshore",
        "offshoring",
        "reshore",
        "nearshore"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c090cd94-b20a-330c-b932-0dfbc25c4f05",
                    "sense_definition": "Located in the sea at a distance from the coast.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "location_sea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company built a large <w>offshore</w> platform to drill for oil.",
                            "target_lang_translations": {
                                "ru": "Компания построила большую <w>шельфовую</w> платформу для бурения нефтяных скважин.",
                                "zh": "该公司建造了一个大型<w>海上</w>平台用于石油钻探。"
                            }
                        },
                        {
                            "text": "We could see several <w>offshore</w> islands on the horizon.",
                            "target_lang_translations": {
                                "ru": "На горизонте мы видели несколько <w>прибрежных</w> островов.",
                                "zh": "我们能看到地平线上有几个<w>近海</w>岛屿。"
                            }
                        }
                    ],
                    "antonyms": [
                        "onshore",
                        "inshore",
                        "coastal"
                    ],
                    "common_phrases": [
                        "offshore oil rig",
                        "offshore drilling",
                        "offshore wind farm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в море на некотором расстоянии от берега.",
                        "zh": "位于离海岸一定距离的海中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шельфовый",
                                "target_lang_sense_clarification": "о платформах, добыче ископаемых"
                            },
                            {
                                "target_lang_word": "морской",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "近海的",
                                "target_lang_sense_clarification": "指靠近海岸的海域"
                            },
                            {
                                "target_lang_word": "海上",
                                "target_lang_sense_clarification": "通用术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7866e38c-810d-30cc-ad12-d3ac409922b9",
                    "sense_definition": "Registered or located in a foreign country, often to take advantage of lower taxes or less strict regulations.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "business_foreign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many wealthy individuals keep their money in <w>offshore</w> bank accounts.",
                            "target_lang_translations": {
                                "ru": "Многие состоятельные люди хранят свои деньги на <w>офшорных</w> банковских счетах.",
                                "zh": "许多富人将钱存在<w>离岸</w>银行账户中。"
                            }
                        },
                        {
                            "text": "The corporation set up an <w>offshore</w> subsidiary to handle international sales.",
                            "target_lang_translations": {
                                "ru": "Корпорация создала <w>офшорный</w> филиал для ведения международных продаж.",
                                "zh": "该公司成立了一家<w>离岸</w>子公司来处理国际销售业务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overseas"
                    ],
                    "antonyms": [
                        "domestic",
                        "onshore"
                    ],
                    "common_phrases": [
                        "offshore banking",
                        "offshore account",
                        "offshore company",
                        "offshore tax haven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зарегистрированный или расположенный в иностранном государстве, часто для снижения налогов.",
                        "zh": "在外国注册或设立的，通常为了利用较低的税率或较宽松的监管。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "офшорный",
                                "target_lang_sense_clarification": "финансовый, юридический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离岸的",
                                "target_lang_sense_clarification": "金融或法律语境"
                            },
                            {
                                "target_lang_word": "海外的",
                                "target_lang_sense_clarification": "指在境外"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07079ab2-4f85-3ebe-98e5-2e950442c257",
                    "sense_definition": "Moving or directed away from the land towards the sea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction_wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A gentle <w>offshore</w> breeze cooled the beach in the evening.",
                            "target_lang_translations": {
                                "ru": "Легкий бриз <w>с берега</w> освежал пляж вечером.",
                                "zh": "傍晚时分，一阵柔和的<w>离岸</w>微风吹凉了海滩。"
                            }
                        },
                        {
                            "text": "Surfers prefer an <w>offshore</w> wind because it shapes the waves perfectly.",
                            "target_lang_translations": {
                                "ru": "Серферы предпочитают <w>отжимной</w> ветер, потому что он придает волнам идеальную форму.",
                                "zh": "冲浪者更喜欢<w>离岸</w>风，因为它能塑造出完美的浪形。"
                            }
                        }
                    ],
                    "antonyms": [
                        "onshore"
                    ],
                    "common_phrases": [
                        "offshore breeze",
                        "offshore wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направленный от суши в сторону моря.",
                        "zh": "从陆地吹向海洋的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дующий с берега",
                                "target_lang_sense_clarification": "о ветре"
                            },
                            {
                                "target_lang_word": "отжимной",
                                "target_lang_sense_clarification": "термин серферов и моряков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离岸风",
                                "target_lang_sense_clarification": "指风向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f624bd02-15bf-3c46-bed9-fd7f7866eb28",
                    "sense_definition": "At a distance from the coast; away from the land.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location_sea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship anchored <w>offshore</w> to wait for the storm to pass.",
                            "target_lang_translations": {
                                "ru": "Корабль встал на якорь <w>вдали от берега</w>, чтобы переждать шторм.",
                                "zh": "船只停泊在<w>离岸</w>处等待风暴过去。"
                            }
                        },
                        {
                            "text": "We swam <w>offshore</w> until the water became deep and blue.",
                            "target_lang_translations": {
                                "ru": "Мы плыли <w>от берега</w>, пока вода не стала глубокой и синей.",
                                "zh": "我们向<w>离岸</w>方向游去，直到水变得深蓝。"
                            }
                        }
                    ],
                    "antonyms": [
                        "onshore",
                        "inshore"
                    ],
                    "common_phrases": [
                        "anchor offshore",
                        "move offshore"
                    ],
                    "target_lang_definitions": {
                        "ru": "На расстоянии от побережья; вдали от суши.",
                        "zh": "在远离海岸的地方；在海上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в открытом море",
                                "target_lang_sense_clarification": "местоположение"
                            },
                            {
                                "target_lang_word": "вдали от берега",
                                "target_lang_sense_clarification": "дистанция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在近海",
                                "target_lang_sense_clarification": "位置"
                            },
                            {
                                "target_lang_word": "在离岸处",
                                "target_lang_sense_clarification": "距离"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3630ea45-5f88-3a71-b6a8-01938fa3e4ae",
                    "sense_definition": "To relocate business processes or industrial production to a foreign country to reduce costs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_foreign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer decided to <w>offshore</w> its assembly line to reduce labor costs.",
                            "target_lang_translations": {
                                "ru": "Производитель решил <w>перенести</w> свою сборочную линию <w>за границу</w>, чтобы сократить расходы на оплату труда.",
                                "zh": "制造商决定将其装配线<w>离岸外包</w>以降低劳动力成本。"
                            }
                        },
                        {
                            "text": "Many IT support services have been <w>offshored</w> to countries with a skilled workforce.",
                            "target_lang_translations": {
                                "ru": "Многие службы IT-поддержки были <w>выведены в офшор</w> в страны с квалифицированной рабочей силой.",
                                "zh": "许多IT支持服务已被<w>离岸外包</w>到拥有熟练劳动力的国家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outsource",
                        "relocate"
                    ],
                    "antonyms": [
                        "reshore"
                    ],
                    "common_phrases": [
                        "offshore jobs",
                        "offshore production",
                        "offshore services"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносить бизнес-процессы или производство в другую страну для снижения затрат.",
                        "zh": "将业务流程或工业生产转移到外国以降低成本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить за границу",
                                "target_lang_sense_clarification": "производство или услуги"
                            },
                            {
                                "target_lang_word": "выводить в офшор",
                                "target_lang_sense_clarification": "бизнес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离岸外包",
                                "target_lang_sense_clarification": "商业行为"
                            },
                            {
                                "target_lang_word": "转移至海外",
                                "target_lang_sense_clarification": "生产或服务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8bf09d20-371f-3500-a297-ec7213d2cbc6",
                    "sense_definition": "An area of the sea located away from the shore.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "location_sea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marine biologist studied the ecology of the <w>offshore</w>.",
                            "target_lang_translations": {
                                "ru": "Морской биолог изучал экологию <w>прибрежной зоны</w>.",
                                "zh": "海洋生物学家研究了<w>近海</w>的生态系统。"
                            }
                        },
                        {
                            "text": "Fishermen know that the deep <w>offshore</w> can be dangerous during the hurricane season.",
                            "target_lang_translations": {
                                "ru": "Рыбаки знают, что глубокое <w>открытое море</w> может быть опасным в сезон ураганов.",
                                "zh": "渔民们知道，在飓风季节，深水<w>外海</w>可能会很危险。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок моря, расположенный вдали от берега.",
                        "zh": "远离海岸的海域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибрежная зона",
                                "target_lang_sense_clarification": "морская зона"
                            },
                            {
                                "target_lang_word": "открытое море",
                                "target_lang_sense_clarification": "глубоководная зона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "近海",
                                "target_lang_sense_clarification": "海域"
                            },
                            {
                                "target_lang_word": "外海",
                                "target_lang_sense_clarification": "深水区"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}