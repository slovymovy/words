                "senses": [
                    {
                        "sense_id": "4febe421-f155-36c7-aaea-18a85fc73527",
                        "entry_id": "090c4f84-dfa9-362f-bf5e-021605396be0",
                        "glosses": [
                            "Herrschertitel im östlichen Mittelmeerraum der Antike"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6c2495b0-d6be-4de6-bf9c-266bb7dda695",
                                "sense_id": "4febe421-f155-36c7-aaea-18a85fc73527",
                                "text": "„Ethnarch bedeutet eigentlich Volksherrscher. Den Titel konnten Stammesfürsten, Oberhäupter bestimmter Volksgruppen, aber auch Landesfürsten und Klientelfürsten Roms unterhalb der Würde eines Königs und Archelaus tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bba9e07-18a7-4bc2-8a25-e9ba8538b64e",
                        "source_entry_id": "090c4f84-dfa9-362f-bf5e-021605396be0",
                        "source_sense_id": "4febe421-f155-36c7-aaea-18a85fc73527",
                        "source_sense_description": "historisch: Herrschertitel im östlichen Mittelmeerraum der Antike",
                        "target_lang_word": "ethnarch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnarch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0385907b-16a0-343c-9e0f-bb5e9e54803c",
                                        "entry_id": "c6cd4586-c40e-3722-9202-f0cec984d12f",
                                        "glosses": [
                                            "The governor of a Jewish province under the Roman Empire."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb4d05da-f611-4f33-94b8-b13654d4a2e8",
                                                "sense_id": "0385907b-16a0-343c-9e0f-bb5e9e54803c",
                                                "text": "In the course of the struggle with the unfortunate ethnarch, the nobles had found it expedient to attach themselves to Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb3e46e-e57f-33ac-94bc-fc591cbdc4f8",
                                        "entry_id": "c6cd4586-c40e-3722-9202-f0cec984d12f",
                                        "glosses": [
                                            "A leader of an ethnic community, especially a Jewish or (in the Ottoman Empire) Eastern Orthodox leader having political as well as spiritual authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f914e1-8048-4ed0-a43b-928aced82e10",
                                                "sense_id": "9fb3e46e-e57f-33ac-94bc-fc591cbdc4f8",
                                                "text": "In fact, from a worldly perspective, sages were petty clerks, employees of the ethnarch of their ethnic group. The ethnarch may have treated sages with […]"
                                            },
                                            {
                                                "example_id": "38b05507-1bb6-4a50-a1dd-5b253e3a6356",
                                                "sense_id": "9fb3e46e-e57f-33ac-94bc-fc591cbdc4f8",
                                                "text": "The Archbishop became the ethnarch, the leader of the ethnic group. It was his responsibility to administer the territories where his people lived, to collect taxes and to regulate matters relating to marriage, divorce, dowry and inheritance."
                                            },
                                            {
                                                "example_id": "f028aa2c-ac75-40f6-bbf7-077c2d84de90",
                                                "sense_id": "9fb3e46e-e57f-33ac-94bc-fc591cbdc4f8",
                                                "text": "By the seventeenth century the archbishop became recognized as the ethnarch (ethnic political leader) of the Greek Cypriot community."
                                            },
                                            {
                                                "example_id": "8aa80cc6-1329-409e-ae46-03eb27cb0586",
                                                "sense_id": "9fb3e46e-e57f-33ac-94bc-fc591cbdc4f8",
                                                "text": "But the Ethnarch, by tradition and long-established practice that had begun under the Ottomans, was more than a spiritual leader. He was expected to act as the spokesman, defender and protector of his flock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
