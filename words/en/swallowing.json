                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient complained that <w>swallowing</w> caused sharp pain in his throat.",
                            "target_lang_translations": {
                                "de": "Der Patient klagte darüber, dass das <w>Schlucken</w> stechende Schmerzen im Hals verursachte."
                            }
                        },
                        {
                            "text": "Normal <w>swallowing</w> requires coordination of several muscles in the neck.",
                            "target_lang_translations": {
