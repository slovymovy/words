                "senses": [
                    {
                        "sense_id": "e45c1ef5-d329-3cf3-8752-b88208142f26",
                        "entry_id": "ce8887fc-d15c-3adf-a6dc-f527e9a5735c",
                        "glosses": [
                            "schienengebundenes Fahrzeug ohne Fahrgäste beziehungsweise Fracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbf3755-e47e-4026-bdba-948d0da0b7d4",
                                "sense_id": "e45c1ef5-d329-3cf3-8752-b88208142f26",
                                "text": "„Während die Vollzüge daher im Gefälle von 1: 300 und 1: 125 ausfahren, müssen die Leerwagenzüge in Steigungen von 1 : 300 und 1: 125 ausfahren, was aber wegen der geringeren Zugbelastung angängig erscheint.“"
                            },
                            {
                                "example_id": "869c8cc0-6439-4703-a9c5-f225da76da9d",
                                "sense_id": "e45c1ef5-d329-3cf3-8752-b88208142f26",
                                "text": "„Dabei aber nimmt die Zahl der bestellten Wagen immer mehr zu, während die der gestellten Wagen von Stunde zu Stunde immer mehr abnimmt, obgleich Leerwagenzüge nach wie vor zugeführt werden.“"
                            },
                            {
                                "example_id": "9f16bb53-6550-442b-90b0-ab2a9daa5cd7",
                                "sense_id": "e45c1ef5-d329-3cf3-8752-b88208142f26",
                                "text": "„Die Lokomotive schiebt den Leerwagenzug bis vor die Drehscheibe; ein Wagen wird von Hand aus in die Nische gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
