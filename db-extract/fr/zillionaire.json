                        "examples": [
                            {
                                "example_id": "75e5cb9b-1a54-42b5-9d32-d7c5804f285b",
                                "sense_id": "35b63186-54d2-35cf-bef6-5b466f4a53cc",
                                "text": "Avez-vous l’étoffe d'un zillionaire ? Lancez les dés et empochez la monnaie !\nAmassez des sommes colossales … et soyez le plus riche à la fin !"
                            },
                            {
                                "example_id": "a03d0a05-3402-427d-bf7e-ad7422dff48a",
                                "sense_id": "35b63186-54d2-35cf-bef6-5b466f4a53cc",
                                "text": "Mais garder à l’esprit que les chances de devenir un zillionaire de cette façon est pratiquement zilch, avec les paiements étant assez maigres, allant de 0,50 $ à 5,00 $ par sondage."
                            },
                            {
                                "example_id": "1903d7c1-32c2-4a69-b442-71dd6a983c89",
                                "sense_id": "35b63186-54d2-35cf-bef6-5b466f4a53cc",
                                "text": "Cette proposition d’Obama est évidemment un effort visant à empêcher des zillionaires comme Romney d’amasser de telles sommes sans payer de taxes en grande partie."
                            }
                        ]
                    }
