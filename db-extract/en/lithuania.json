                    },
                    {
                        "translation_id": "94a2af53-09cd-47ef-b103-170d1baefbb4",
                        "source_entry_id": "531af21a-6910-30f5-903a-b6ff419ad10f",
                        "source_sense_id": "ca522e8a-7ebc-3d0e-8dd2-5a5b0d9ca1a8",
