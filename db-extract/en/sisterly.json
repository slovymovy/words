                        "sense_id": "6b997dbb-ed76-3ea2-b633-ca727da16e73",
                        "entry_id": "111cee22-07a1-3fd9-b8b7-6e675793ba26",
                        "glosses": [
                            "Of or characteristic of sisters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c769c325-1151-47c5-ac1b-9ed4158415c7",
                                "sense_id": "6b997dbb-ed76-3ea2-b633-ca727da16e73",
                                "text": "Burton designed both Middleton sisters' dresses in white, so that when Pippa picked up Kate's train in the abbey, the two of them were united, visually, in a display of sisterly togetherness."
                            }
                        ]
                    }
                ],
