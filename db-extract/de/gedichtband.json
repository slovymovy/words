                "senses": [
                    {
                        "sense_id": "ed012d38-28a2-3c6b-bfda-cf3cf42eba46",
                        "entry_id": "b86bab71-a45e-380e-abd1-ddae0852d8fc",
                        "glosses": [
                            "Band, der Gedichte eines einzelnen oder unterschiedlicher Autoren beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e0194c-ce2d-4785-bf4f-d69992d224e9",
                                "sense_id": "ed012d38-28a2-3c6b-bfda-cf3cf42eba46",
                                "text": "Diese Woche ist sein dritter Gedichtband erschienen."
                            },
                            {
                                "example_id": "c892adc0-5a55-469f-8392-f8cfb06ec468",
                                "sense_id": "ed012d38-28a2-3c6b-bfda-cf3cf42eba46",
                                "text": "„Dann fiel ihm der kleine Gedichtband ein, den ihm die Mutter zu Weihnachten geschickt hatte und den er heilig hielt und immer in der Tasche auf der Brust herumtrug.“"
                            },
                            {
                                "example_id": "0df511c6-93bb-43bc-8e24-69b1b0198765",
                                "sense_id": "ed012d38-28a2-3c6b-bfda-cf3cf42eba46",
                                "text": "„Julio Flóres' Gedichtband wurde 1899 publiziert.“"
                            },
                            {
                                "example_id": "811b898e-3c0d-4b74-80d4-0f0b0e4c78bf",
                                "sense_id": "ed012d38-28a2-3c6b-bfda-cf3cf42eba46",
                                "text": "„Morgen geh ich wieder hin, mit einer Lupe und einem Gedichtband im Gepäck.“"
                            },
                            {
                                "example_id": "86068d32-23e8-4c07-bf49-495d2abb2fd0",
                                "sense_id": "ed012d38-28a2-3c6b-bfda-cf3cf42eba46",
                                "text": "„Mein zweiter Gedichtband enthält ein Vorwort von Reich-Ranicki.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
