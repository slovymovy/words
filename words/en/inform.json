                {
                    "sense_id": "16009c8c-336e-3bd5-974a-c18db39b7e1e",
                    "sense_definition": "To officially report someone's illegal or wrong activities to an authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "denounce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was afraid that his neighbors might <w>inform</w> on him to the police.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что соседи могут <w>донести</w> на него в полицию.",
                                "nl": "Hij was bang dat zijn buren hem bij de politie zouden <w>verklikken</w>.",
                                "pl": "Bał się, że sąsiedzi mogą na niego <w>donieść</w> na policję.",
                                "de": "Er hatte Angst, dass seine Nachbarn ihn bei der Polizei <w>denunzieren</w> könnten.",
                                "fr": "Il avait peur que ses voisins ne le <w>dénoncent</w> à la police.",
                                "it": "Temeva che i suoi vicini potessero <w>fare la spia</w> su di lui alla polizia.",
                                "cs": "Bál se, že by na něj sousedé mohli <w>donášet</w> policii.",
                                "tr": "Komşularının kendisini polise <w>ihbar etmesinden</w> korkuyordu.",
                                "es": "Tenía miedo de que sus vecinos pudieran <w>delatarlo</w> ante la policía."
                            }
                        },
                        {
                            "text": "The gang member refused to <w>inform</w> against his accomplices.",
                            "target_lang_translations": {
                                "ru": "Член банды отказался <w>доносить</w> на своих сообщников.",
                                "nl": "Het bendlid weigerde zijn medeplichtigen aan te <w>geven</w>.",
                                "pl": "Członek gangu odmówił <w>składania doniesień</w> na swoich wspólników.",
                                "de": "Das Bandenmitglied weigerte sich, seine Komplizen zu <w>verraten</w>.",
                                "fr": "Le membre du gang a refusé de <w>dénoncer</w> ses complices.",
                                "it": "Il membro della banda si è rifiutato di <w>testimoniare</w> contro i suoi complici.",
                                "cs": "Člen gangu odmítl <w>udat</w> své komplice.",
                                "tr": "Çete üyesi, suç ortaklarını <w>ele vermeyi</w> reddetti.",
                                "es": "El miembro de la banda se negó a <w>delatar</w> a sus cómplices."
                            }
                        }
