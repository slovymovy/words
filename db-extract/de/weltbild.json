                ],
                "senses": [
                    {
                        "sense_id": "4ef4431d-069b-372e-be04-615c3b2f22bf",
                        "entry_id": "eba782ef-ab42-327b-9f99-d200dd16f90b",
                        "glosses": [
                            "Gesamtbild der durch Anschauung erwerbbaren, in eine Ordnung und einen Zusammenhang gebrachten Vorstellungen von der Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0766c56-566e-4aae-ad42-b344ef694f11",
                                "sense_id": "4ef4431d-069b-372e-be04-615c3b2f22bf",
                                "text": "„In den meisten Fassungen der Loreleysage haben die Dichter Loreleys Wiedergeburt einfach übergangen, wahrscheinlich weil das Thema Reinkarnation nicht in das christliche Weltbild der damaligen Zeit paßte.“"
                            },
                            {
                                "example_id": "7e822743-4741-4c78-b3ab-1721183dbdf9",
                                "sense_id": "4ef4431d-069b-372e-be04-615c3b2f22bf",
                                "text": "„Seine Forschungsreise verändert das Weltbild der alten Griechen ebenso gründlich wie die Persien- und Indien-Feldzüge seines Zeitgenossen Alexander des Großen.“"
                            },
                            {
                                "example_id": "ce1d8025-ff00-4566-8a1e-9bfa841ecaf3",
                                "sense_id": "4ef4431d-069b-372e-be04-615c3b2f22bf",
                                "text": "„Tja. Und dann stehst du da, und dein ganzes Weltbild fliegt dir um die Ohren.“"
                            },
                            {
                                "example_id": "c8efb7b7-8657-4d8a-9a5b-d07aa2940ff9",
                                "sense_id": "4ef4431d-069b-372e-be04-615c3b2f22bf",
                                "text": "„All diese Ideen stören das Weltbild der PiS-Politiker, die Polen erbarmungslos in einen reaktionären Staat umbauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cb068e6-5f4f-4d26-a2d1-86ae2891cceb",
