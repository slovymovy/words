                                "target_senses": [
                                    {
                                        "sense_id": "d6140232-c297-30fc-83c5-73b968c55e79",
                                        "entry_id": "f38a51bd-d870-306f-86a4-8f338338ce2a",
                                        "glosses": [
                                            "An erratic, unpredictable occurrence or action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7c46eb-46f9-4984-9afc-939aa977421c",
                                                "sense_id": "d6140232-c297-30fc-83c5-73b968c55e79",
                                                "text": "It now turns out that the Pitch Lake, like most other things, owes its appearance on the surface to no convulsion or vagary at all, but to a most slow, orderly, and respectable process of nature, by which buried vegetable matter, which would have become peat, and finally brown coal, in a temperate climate, becomes, under the hot tropic soil, asphalt and oil, continually oozing up beneath the pressure of the strata above it."
                                            },
                                            {
                                                "example_id": "9a8c4b2b-b283-495c-b316-d9f3388c0f14",
                                                "sense_id": "d6140232-c297-30fc-83c5-73b968c55e79",
                                                "text": "This searching was facilitated by the author's knowledge of the vagaries of Anglo-Indian spelling and the numerous colonial-era transliteration systems used for loanwords from Indian languages."
                                            },
                                            {
                                                "example_id": "26b68dd7-270d-4ed0-9929-e6e28e34ebf3",
                                                "sense_id": "d6140232-c297-30fc-83c5-73b968c55e79",
                                                "text": "These systems learn the vagaries of language by analyzing enormous amounts of text, including thousands of books, Wikipedia entries and other online documents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de00256b-a44c-3d22-9f09-7e28f963fa53",
                                        "entry_id": "f38a51bd-d870-306f-86a4-8f338338ce2a",
                                        "glosses": [
                                            "Something vague."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c93a2e21-9f98-45ea-97ec-b37a4c1d7531",
                                                "sense_id": "de00256b-a44c-3d22-9f09-7e28f963fa53",
                                                "text": "to speak in vagaries"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32bbe4fc-84e0-3dcb-901e-579f436c0544",
                                        "entry_id": "f38a51bd-d870-306f-86a4-8f338338ce2a",
                                        "glosses": [
                                            "An impulsive or illogical desire; a caprice or whim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cead827e-b87f-4a69-b35a-71d42043a2e2",
                                                "sense_id": "32bbe4fc-84e0-3dcb-901e-579f436c0544",
                                                "text": "And then came the day when my socialism grew respectable,—still a vagary of youth, it was held, but romantically respectable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
