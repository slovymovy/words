                ],
                "senses": [
                    {
                        "sense_id": "b5e3d0aa-5517-3a38-ba00-77e758637767",
                        "entry_id": "ba3f77c9-3a0d-31fb-872d-8f7f60471a4b",
                        "glosses": [
                            "Person, die von Ort zu Ort zieht, um zu predigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4dff22e-a488-4d25-9354-bdef44c22bab",
                                "sense_id": "b5e3d0aa-5517-3a38-ba00-77e758637767",
                                "text": "„Jahrelang zog er als armer Wanderprediger durchs Land.“"
                            },
                            {
                                "example_id": "a75670e2-4231-4f53-bd81-01f29373f0e6",
                                "sense_id": "b5e3d0aa-5517-3a38-ba00-77e758637767",
                                "text": "„Ein Wanderprediger verkündete auf dem Dorfplatz vor Frauen und Kindern die Ankunft des Jüngsten Gerichts.“"
                            },
                            {
                                "example_id": "1f77e197-e345-4342-ab8b-a7da5688d046",
                                "sense_id": "b5e3d0aa-5517-3a38-ba00-77e758637767",
                                "text": "„So wählen sheikhs häufig das Leben als Einsiedler oder als Wanderprediger.“"
                            },
                            {
                                "example_id": "e811a2c0-4b9e-4c34-9439-1b2395442f0c",
                                "sense_id": "b5e3d0aa-5517-3a38-ba00-77e758637767",
                                "text": "„Daraus folgerten Wanderprediger und Flugblattpropheten, eine neue Sintflut stehe bevor und die Konjunktion der Planeten werde »ungezweiffelt vil wunderbarlicher ding geperen«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
