                ],
                "senses": [
                    {
                        "sense_id": "3b63e675-be59-330e-84f0-c0a57ee5ac6d",
                        "entry_id": "eed527e6-a690-3e08-aab0-a71f871b6935",
                        "glosses": [
                            "избавиться от чего-либо нежелательного, назойливого"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3649f87d-dd9b-4a87-b409-ef11b27aa1ba",
                                "sense_id": "3b63e675-be59-330e-84f0-c0a57ee5ac6d",
                                "text": "Никак не могу отделаться от одного бывшего ухажёра."
                            },
                            {
                                "example_id": "248f9e68-accd-4f4e-ab08-cbad41138e43",
                                "sense_id": "3b63e675-be59-330e-84f0-c0a57ee5ac6d",
                                "text": "Как отделаться от двойного налога?"
                            },
                            {
                                "example_id": "0ed885fc-5ca5-4e8b-aaf1-a9454f2550ca",
                                "sense_id": "3b63e675-be59-330e-84f0-c0a57ee5ac6d",
                                "text": "Российский фондовый рынок никак не может отделаться от китайской зависимости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84dcb64c-7265-4adc-a3b8-bff8381889e9",
                        "source_entry_id": "eed527e6-a690-3e08-aab0-a71f871b6935",
                        "source_sense_id": "3b63e675-be59-330e-84f0-c0a57ee5ac6d",
                        "target_lang_word": "davonkommen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "davonkommen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "778fe136-d320-3bd8-9216-456248fa0956",
                                        "entry_id": "12602a19-2225-3323-b8ff-d4010e97cf9c",
                                        "glosses": [
                                            "aus einer bedrohlichen, prekären oder sonst unangenehmen Situation mit wenig Schaden herauskommen oder ohne Schaden zu erleiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7eae87f-d853-4ee6-b54e-74719434cdbd",
                                                "sense_id": "778fe136-d320-3bd8-9216-456248fa0956",
                                                "text": "„Am Montag noch hatte die Regierungschefin die Ministerin mit einer Verwarnung davonkommen lassen.“"
                                            },
                                            {
                                                "example_id": "ab9a3d87-7f4d-43d3-9715-e8ab4b4e4f0b",
                                                "sense_id": "778fe136-d320-3bd8-9216-456248fa0956",
                                                "text": "„Der zweite schwerverletzte Nationalsozialist dürfte auch kaum mit dem Leben davonkommen.“"
                                            },
                                            {
                                                "example_id": "7fe37237-7893-498b-b595-0e0a5f2b2caf",
                                                "sense_id": "778fe136-d320-3bd8-9216-456248fa0956",
                                                "text": "„Während ich mit der Mahnung, nie wieder zu lügen davonkam, mußte mein Bruderherz ohne Essen zu Bett gehen.“"
                                            },
                                            {
                                                "example_id": "0b2238b1-1d3a-4e30-8620-032fb7e164e1",
                                                "sense_id": "778fe136-d320-3bd8-9216-456248fa0956",
                                                "text": "„Mit Helm wären viele glimpflicher davongekommen.“"
                                            },
                                            {
                                                "example_id": "aa690982-f53e-49bd-9e71-2eb79c323a49",
                                                "sense_id": "778fe136-d320-3bd8-9216-456248fa0956",
                                                "text": "„Mehr als 600 Menschen konnten sich retten, etwa 50 von ihnen seien mit Verletzungen davongekommen, hieß es.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11b9f15b-541c-487d-b6bd-624e7080a5d4",
