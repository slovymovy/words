                        "entry_id": "06f56c8f-2c82-36d5-a16e-026793339957",
                        "glosses": [
                            "Person, die für die Administration eines Internetforums, einer Nachrichtenseite, ein Computernetzwerk oder Ähnliches verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1092f7-a74f-4c00-8c46-038726305aa7",
                                "sense_id": "7c22c132-9a86-3961-98df-bcb8fd50fa8c",
                                "text": "„Sysops und Netzwerkverwalter sind heimliche Machthaber jedes Unternehmens: Sie wissen viel über interne Vorgänge, sehen alles, was im Firmennetzwerk geschieht und verfügen über ein Herrschaftswissen, dass sie oft schwer ersetzbar macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
