                    "sense_definition": "Служит для образования формы повелительного наклонения 3-го лица; выражает побуждение, пожелание или приказ.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "imperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пусть</w> он позвонит мне завтра утром.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> him call me tomorrow morning.",
                                "zh": "<w>让</w>他明天早上给我打电话。",
                                "nl": "<w>Laat</w> hem me morgenochtend bellen.",
                                "pl": "<w>Niech</w> zadzwoni do mnie jutro rano.",
                                "de": "<w>Lass</w> ihn mich morgen früh anrufen.",
                                "fr": "<w>Qu'</w>il m'appelle demain matin.",
                                "it": "<w>Che</w> mi chiami domani mattina.",
                                "cs": "<w>Ať</w> mi zítra ráno zavolá.",
                                "tr": "<w>Bırakın</w> beni yarın sabah arasın.",
                                "es": "<w>Que</w> me llame mañana por la mañana."
                            }
                        },
                        {
                            "text": "<w>Пусть</w> дети играют во дворе, пока на улице тепло.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> the children play in the yard while it is warm outside.",
                                "zh": "趁外面暖和，<w>让</w>孩子们在院子里玩吧。",
                                "nl": "<w>Laat</w> de kinderen in de tuin spelen zolang het buiten warm is.",
                                "pl": "<w>Niech</w> dzieci bawią się na podwórku, póki na dworze jest ciepło.",
                                "de": "<w>Lass</w> die Kinder im Hof spielen, solange es draußen warm ist.",
                                "fr": "<w>Que</w> les enfants jouent dans la cour tant qu'il fait chaud dehors.",
                                "it": "<w>Lascia</w> che i bambini giochino in cortile finché fa caldo fuori.",
                                "cs": "<w>Ať</w> si děti hrají na dvoře, dokud je venku teplo.",
                                "tr": "Hava sıcakken <w>bırakın</w> çocuklar bahçede oynasın.",
                                "es": "<w>Que</w> los niños jueguen en el patio mientras hace calor afuera."
                            }
                        }
                    ],
                    "synonyms": [
                        "пускай",
                        "да"
                    ],
                    "common_phrases": [
                        "пусть говорят",
                        "пусть будет"
