                "senses": [
                    {
                        "sense_id": "46437d07-704e-3a66-992d-389b42458189",
                        "entry_id": "99e78316-43be-39e4-a478-2589a4147fe6",
                        "glosses": [
                            "das Gewicht von lebenden Tieren im Gegensatz zum Schlachtgewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6029cf91-3537-4946-8de6-143220b18712",
                                "sense_id": "46437d07-704e-3a66-992d-389b42458189",
                                "text": "Schweine sind schlachtreif, wenn sie etwa 6 Monate alt sind oder ungefähr 100 kg Lebendgewicht haben."
                            },
                            {
                                "example_id": "31440af7-82e4-4209-a2f0-7b4df85b4888",
                                "sense_id": "46437d07-704e-3a66-992d-389b42458189",
                                "text": "„Ein heutiges Mastschwein erreicht also dreimal mehr Lebendgewicht als eine Straßensau zur Lutherzeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
