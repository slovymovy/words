                        "entry_id": "b22a5c2c-e0a3-3b86-9ab6-0b2d17aab94d",
                        "glosses": [
                            "A little roll; a roll of coins put up in paper, or something resembling such a roll."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61099ff7-56b2-4f35-b66c-040436af5de6",
                                "sense_id": "3cecf644-30cb-32cf-8444-0583db3b3295",
                                "text": "We always judge of others by ourselves; and his idea of Cupid's quiver is a rouleau."
                            },
                            {
                                "example_id": "79c60472-f79a-410f-9efc-48e18b72ec16",
                                "sense_id": "3cecf644-30cb-32cf-8444-0583db3b3295",
                                "text": "Early in the morning, the rouleau of gold was left at my door in a little box, with my name on the outside."
                            },
                            {
                                "example_id": "0aa45e01-a312-4958-ac01-4889e4a38518",
                                "sense_id": "3cecf644-30cb-32cf-8444-0583db3b3295",
                                "text": "[…] he liked your philosophy, and hopes you'll accept of this, which from its weight I take to be a little rouleau of guineas."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e05f1c0-c3b6-350d-a45f-592e0f43750c",
                        "entry_id": "b22a5c2c-e0a3-3b86-9ab6-0b2d17aab94d",
                        "glosses": [
                            "A decorative technique that involves creating patterns with piping, cording or bias tape. A rouleau loop uses the same cord or piping as a way of fastening buttons, most notably down the back of bridal gowns."
                        ],
                        "tags": [],
