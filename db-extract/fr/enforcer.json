                "senses": [
                    {
                        "sense_id": "5ef1ad91-8904-383e-b177-e8ed208a40db",
                        "entry_id": "9c07ce02-636c-30a0-9d3d-b2037044bac3",
                        "glosses": [
                            "Forcer, presser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05f68a08-bcdc-3f41-a51a-43e0b833c2ab",
                        "entry_id": "9c07ce02-636c-30a0-9d3d-b2037044bac3",
                        "glosses": [
                            "Violer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b5f8d8-e9c8-4dfa-b12b-d10d8b0009ab",
                                "sense_id": "05f68a08-bcdc-3f41-a51a-43e0b833c2ab",
                                "text": "Oui, les voilà bien, ces mauvais garçons ! s’exclamait la mère Corniflet ; ils ne songent qu’à piller, qu’à mettre les pauvres gens à mal, ces ribauds; qu’à enforcer les jeunes bachelettes, les mécréans."
                            }
                        ]
                    },
                    {
                        "sense_id": "42949f52-2e8a-3ade-976f-49a3d9164335",
                        "entry_id": "9c07ce02-636c-30a0-9d3d-b2037044bac3",
                        "glosses": [
                            "Faire appliquer en pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644c08a1-04a1-4d9f-99ad-5fc2541d0ef4",
                                "sense_id": "42949f52-2e8a-3ade-976f-49a3d9164335",
                                "text": "D’où la seconde conséquence : ne pas interdire si c'est inutile pour enforcer."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e8313ed-dc04-32b2-8607-2663b0573833",
                        "entry_id": "9c07ce02-636c-30a0-9d3d-b2037044bac3",
                        "glosses": [
                            "Rendre plus solide, renforcer, fortifier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ec1d4d-20a3-4f7a-8915-f1ecb2402a59",
                                "sense_id": "9e8313ed-dc04-32b2-8607-2663b0573833",
                                "text": "C’est un fil bien ténu, mais que j’enforcerai de manière à faire une corde pour monter au balcon de l’infante."
                            }
                        ]
                    }
                ],
