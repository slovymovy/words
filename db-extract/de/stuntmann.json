                "senses": [
                    {
                        "sense_id": "90accd8b-3d73-35ba-b6cd-b4a55663d617",
                        "entry_id": "a06b3c7d-15e4-3985-8a13-b03d88a2cf88",
                        "glosses": [
                            "Filmberuf: jemand, der den Schauspieler ersetzt, sobald gefährliche Filmszenen gedreht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9aa3bf5-f031-4e8b-bc5f-c99dec5358b1",
                                "sense_id": "90accd8b-3d73-35ba-b6cd-b4a55663d617",
                                "text": "„Daraufhin habe der Stuntmann die fast 21 Kilometer auf zwei Rädern zurückgelegt.“"
                            },
                            {
                                "example_id": "d34af9cb-a44d-4b02-8d59-69aef5a70d22",
                                "sense_id": "90accd8b-3d73-35ba-b6cd-b4a55663d617",
                                "text": "„Wir hatten einen großartigen Tag am Set mit Kampfszenen, die fast zehn Stunden dauerten. Der Stuntmann hat nur ungefähr zwei oder drei Einstellung machen können.“"
                            },
                            {
                                "example_id": "efe1bd20-284b-451e-a4ea-d3856c2d59d7",
                                "sense_id": "90accd8b-3d73-35ba-b6cd-b4a55663d617",
                                "text": "„Gerade das aber ist schon wieder sprechend, denn die Stuntmänner sind die, die ihre Fähigkeit anderen zur Verfügung stellen und die anonym bleiben […] Das ändert sich erst dann, wenn der Stuntmann, der Stellvertreter selbst, angegriffen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
