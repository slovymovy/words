                ],
                "senses": [
                    {
                        "sense_id": "5284271d-b3b9-37aa-83e9-bc9e5e08faa0",
                        "entry_id": "55039dab-f65d-3b7e-a126-171ce0b55e34",
                        "glosses": [
                            "Se déshabiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4560647f-6d19-474c-be16-a292be35c9dd",
                                "sense_id": "5284271d-b3b9-37aa-83e9-bc9e5e08faa0",
                                "text": "Tout ça pour dire que, contrairement aux courageux capitaines d'industrie qui se couchent tard et dont les ouvriers se lèvent tôt, la vedette se détorchonne honteusement tard, laissant son ange gardien disposer de ses huit heures de sommeil réparateur."
                            },
                            {
                                "example_id": "45a5999b-67b5-46f8-b550-01d1abb397d9",
                                "sense_id": "5284271d-b3b9-37aa-83e9-bc9e5e08faa0",
                                "text": "Elle se déblouse, se détorchonne, se débarbouille."
                            },
                            {
                                "example_id": "bd5e5a5d-20e1-4449-b4b0-17ee178e099f",
                                "sense_id": "5284271d-b3b9-37aa-83e9-bc9e5e08faa0",
                                "text": "Ça ne regarde que moi si je me détorchonne à six plombes du matin, non ?"
                            }
                        ]
                    }
                ],
