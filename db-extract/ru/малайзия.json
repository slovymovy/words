                                    {
                                        "sense_id": "13ae1419-110e-3a05-9a15-ea7bb5745943",
                                        "entry_id": "d9a40a13-773b-3cff-af2e-06bc8e213e7d",
                                        "glosses": [
                                            "A country in Southeast Asia. Capital: Kuala Lumpur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78549760-e139-344a-8dd9-7a8d9b512074",
                                        "entry_id": "d9a40a13-773b-3cff-af2e-06bc8e213e7d",
                                        "glosses": [
                                            "The Malay Archipelago."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71815d77-cb55-4c48-97e9-69c072b1df78",
                                                "sense_id": "78549760-e139-344a-8dd9-7a8d9b512074",
                                                "text": "For the purpose of topographical description, Malaysia may be divided into six groups of islands, namely — 1. Sumatra, and the smaller islands adjacent ; 2. The long chain of islands which extends east and west from the Strait of Sunda to New Guinea, including Java, Madura, Bali, Lombok, Sumbawa, Comobo, Flares, Jindana or Sandelwood, Adenar, Solor, Lomblem, Pantar, Ombay, Timor, Semao, Rotte, Savu, Cambi, Wetter, Serwatty, Babba, Timorlaut, &c. ; 3. The Banda and Molucca Islands ; 4. Celebes and the smaller adjacent islands; 5. Borneo and adjacent islands; 6. The Philippine Islands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46b2108c-cee5-4670-a204-a57aa3b9d214",
                        "source_entry_id": "676891e8-3e87-3722-8342-261e08c51c4d",
                        "source_sense_id": "d6f99cfd-661b-3a4c-9f55-abb2bfdf242c",
                        "target_lang_word": "Malaysia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malaysia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b385f9-426b-3a67-9239-2f9a3eb7ed0a",
                                        "entry_id": "e1ba6aa0-6672-3150-bca1-5c635b3a2c02",
                                        "glosses": [
                                            "Staat in Südostasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f49e9f7-b36e-455a-8225-81d8b2a6489a",
                                                "sense_id": "f9b385f9-426b-3a67-9239-2f9a3eb7ed0a",
                                                "text": "Wir fahren übermorgen zum Formel-1-Rennen nach Malaysia."
                                            },
                                            {
                                                "example_id": "7fe095f5-96da-4298-940d-1c9cfd721c19",
                                                "sense_id": "f9b385f9-426b-3a67-9239-2f9a3eb7ed0a",
                                                "text": "Kuala Lumpur ist die Hauptstadt von Malaysia."
                                            },
                                            {
                                                "example_id": "a276ddfe-6583-4572-bd4c-090533edea54",
                                                "sense_id": "f9b385f9-426b-3a67-9239-2f9a3eb7ed0a",
                                                "text": "„Archaische Bilder hält das Malaysia des 21. Jahrhunderts noch jede Menge parat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dca15c8-1b1c-4c9a-9dfb-a243efe57933",
                        "source_entry_id": "676891e8-3e87-3722-8342-261e08c51c4d",
