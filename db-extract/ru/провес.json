                ],
                "senses": [
                    {
                        "sense_id": "90b2a254-7095-3adc-8eb7-755367bc8ce5",
                        "entry_id": "73787f1c-ea69-317a-badb-52eceefb909d",
                        "glosses": [
                            "то же, что провисание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922f62df-03e9-47c2-ad7b-9faa1735f696",
                                "sense_id": "90b2a254-7095-3adc-8eb7-755367bc8ce5",
                                "text": "Фуражечный ремень висит свободно, с провесом, и лежит на козырьке, или прижат нижним краем кокарды."
                            }
                        ]
                    },
                    {
                        "sense_id": "d98a0568-0a9f-351c-9984-943838bae66f",
                        "entry_id": "73787f1c-ea69-317a-badb-52eceefb909d",
                        "glosses": [
                            "спец. провисшее место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406d5a33-c2c3-4a7d-ac13-068d055c425a",
                                "sense_id": "d98a0568-0a9f-351c-9984-943838bae66f",
                                "text": "Один из подрядчиков, ярославский крестьянин, сказал зодчему, что в погибе переводин мало запасу и надо его прибавить почти на вершок, иначе потолок сядет и будет провес."
                            }
                        ]
                    },
                    {
                        "sense_id": "9740841d-db72-3765-b352-2eb2a7f724c7",
                        "entry_id": "73787f1c-ea69-317a-badb-52eceefb909d",
                        "glosses": [
                            "торг. недостаточность в весе против должного количества"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e17f4ab0-6953-4b54-81a9-1fa20615f1d9",
                                "sense_id": "9740841d-db72-3765-b352-2eb2a7f724c7",
                                "text": "Начнут кули набивать, окажется провес, засудит его купец."
                            },
                            {
                                "example_id": "fde174cf-022d-4760-b418-9aa7ebd9f126",
                                "sense_id": "9740841d-db72-3765-b352-2eb2a7f724c7",
                                "text": "На Сиротке догадывались, что с Петром Васильичем опять что-то вышло, и решили, что или он попался с краденым золотом, или его вздули старатели за провес."
                            }
                        ]
                    }
                ],
