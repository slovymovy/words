            {
                "entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                "word": "magnétophone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a56c917-8328-4ecb-b72f-0db2c6b3b9d3",
                        "entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnétophones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                        "entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                        "glosses": [
                            "Outil permettant d’enregistrer des sons sur un support magnétique amovible."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "965933e4-4d37-4f08-96ea-cc9a706b6565",
                                "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                "text": "Le premier magnétophone de Poulsen utilisait un fil magnétique."
                            },
                            {
                                "example_id": "decc026e-7358-4721-bb1d-5ca0e860289d",
                                "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                "text": "Le magnétophone a été remplacé dans le grand public par des lecteurs/enregistreurs à mémoire flash-eprom"
                            },
                            {
                                "example_id": "64b5a675-3d3e-40a7-ba7c-4a8ba3f75704",
                                "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                "text": "Un après-midi, le docteur Baramian, que le bruit n’avait pas encore chassé, avait invité Lucile et Lisbeth dans son cabinet pour leur montrer son magnétophone. Elles ignoraient l’une et l’autre qu’un tel engin existât."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e37b501c-c098-49e2-a9f0-143b25d70c86",
                        "source_entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                        "source_sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                        "target_lang_word": "Tonbandgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tonbandgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                        "entry_id": "ff79a021-a166-341e-a42e-a0e3350321e7",
                                        "glosses": [
                                            "ein Gerät, mit dem man Geräusch-, Sprach- oder Musikaufnahmen auf sogenannten Tonbändern herstellen und abhören kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c99856a-8946-4aa8-b98e-a78c9c7be1c6",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„In der fünften Klasse kam der Schuldirektor meiner sowjetischen Schule mitten im Unterricht mit einem großen Tonbandgerät und einem Mikrofon zu uns in die Klasse.“"
                                            },
                                            {
                                                "example_id": "7c74d3bd-624a-4a6e-b461-7a56c8eb7f74",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Neben ihr saß Miss Carey vor einem Klapptischchen, auf dem das Tonbandgerät stand.“."
                                            },
                                            {
                                                "example_id": "802ab761-fcda-41e6-9344-c6dcf216ad07",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Inzwischen hatte sich der Tombolatisch bis auf ein paar Plüschtiere, eine LP und das Tonbandgerät geleert.“"
                                            },
                                            {
                                                "example_id": "bb06f586-840b-4957-8f5a-c045381d131d",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Im Schrank erwarteten mich, gut verpackt, ein Tonbandgerät und ein Fotoapparat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03eef67f-93b9-4313-8f7d-ed45f2e66c2d",
                        "source_entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                        "source_sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                        "target_lang_word": "Bandgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bandgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c456940b-6011-3214-9bbf-d2836cd7e5fc",
                                        "entry_id": "d21ca5cd-c096-3154-ae16-1a6fedfa508f",
                                        "glosses": [
                                            "Gerät, welches ein oder mehrere Bänder antreibt oder von diesen angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25caa999-94ff-4546-b117-ccbca1f2d7f1",
                                                "sense_id": "c456940b-6011-3214-9bbf-d2836cd7e5fc",
                                                "text": "Das Bandgerät muss ausgeschaltet werden."
                                            },
                                            {
                                                "example_id": "cc793fe9-6f88-41e6-afdb-94711acb2b4b",
                                                "sense_id": "c456940b-6011-3214-9bbf-d2836cd7e5fc",
                                                "text": "„In ihrem Zimmer steht ein Bandgerät, und außerdem hören sie die Gespräche mit einem Kopfhörer mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "455ecd78-7fad-4929-8397-901bf23b896d",
                        "source_entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                        "source_sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
