                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f63d9e-83a6-42eb-a841-a339904bf4f6",
                                "sense_id": "f9a05dc9-4660-3b12-8b93-3c66fc79fb35",
                                "text": "“Our goal with this update is to more tightly tie hitboxes and hurtboxes to our character’s animations,” devs explained in the blog post."
                            },
                            {
                                "example_id": "182c026c-e900-479c-bd37-8866b5b3354a",
                                "sense_id": "f9a05dc9-4660-3b12-8b93-3c66fc79fb35",
                                "text": "Some fans, naturally, quizzed the Rockstar dev as to when they might expect a second trailer to drop. However, as is classic Rockstar, there are no answers on that front."
                            }
                        ]
                    },
