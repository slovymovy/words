                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9be602f0-3af8-4b2a-a0f8-d01626a75566",
                        "entry_id": "645325dc-925c-307e-86d0-3bc244548c05",
                        "tags": [
                            "plural"
                        ],
                        "form": "DoBs"
