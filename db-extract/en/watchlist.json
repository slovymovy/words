                                "sense_id": "e4aed0c3-2f18-3ff8-9624-892a9c3b9741",
                                "text": "The police have hundreds of citizens on their watchlists."
                            },
                            {
                                "example_id": "caca427f-163e-4953-9148-75710bc9ca84",
                                "sense_id": "e4aed0c3-2f18-3ff8-9624-892a9c3b9741",
                                "text": "The TSA provides the airlines with the “No Fly” and “Automatic Selectee” watchlists for use in identifying passengers who are to be denied boarding or who require additional scrutiny prior to boarding. The “No Fly” watchlist is a list of persons who are considered a direct threat to U.S. civil aviation."
                            }
                        ]
                    }
