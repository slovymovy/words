                ],
                "senses": [
                    {
                        "sense_id": "89c9da37-7170-375c-a719-2b25da791123",
                        "entry_id": "7f869702-e12e-3419-baeb-10d0f701714e",
                        "glosses": [
                            "Zusammenschluss von Personen, die gemeinsam eine Tätigkeit ausüben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e85127-2906-4210-b2e8-df458ee7bccc",
                                "sense_id": "89c9da37-7170-375c-a719-2b25da791123",
                                "text": "„Die Interdisziplinäre Arbeitsgruppe Funktionen des Bewusstseins setzt sich aus unterschiedlichen fachlichen Perspektiven mit verschiedenen Fragestellungen zu Funktionen des Bewusstseins auseinander.“"
                            },
                            {
                                "example_id": "996015ac-899b-40c1-b69b-73ef2bfb79e7",
                                "sense_id": "89c9da37-7170-375c-a719-2b25da791123",
                                "text": "„Über die Arbeitsgruppen hinaus besteht für alle Mitglieder des Rates die Möglichkeit, eigene Projekte bzw. Untersuchungen im Rahmen der Sitzungen zu präsentieren, sofern es in den zeitlichen Rahmen passt und die Ergebnisse für die Arbeit des Rates relevant sind.“"
                            },
                            {
                                "example_id": "f34cc28a-7be6-40fd-9e9e-bbce6e8ad046",
                                "sense_id": "89c9da37-7170-375c-a719-2b25da791123",
                                "text": "„Das Komitee sollte Arbeitsgruppen für die verschiedenen Gebiete ernennen, die in Zusammenarbeit mit Filmexperten Empfehlungen und Vorschläge für einen Produktionsplan und seine praktische Verwirklichung vorlegen würden.“"
                            },
                            {
                                "example_id": "6ef93541-c13c-4ba6-a3f5-140c23598300",
                                "sense_id": "89c9da37-7170-375c-a719-2b25da791123",
                                "text": "„Unsere Arbeitsgruppe wurde, von geringen Ausnahmen abgesehen, auch diesmal noch fürs Leben bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
