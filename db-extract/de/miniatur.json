                                        "examples": [
                                            {
                                                "example_id": "ac9e8ac6-b112-4522-9aac-6d1b384bbc25",
                                                "sense_id": "11285b6c-d920-32f6-a248-d99cb594ffc8",
                                                "text": "If it be ever so little removed, or seen thro’ the miniaturing End of the Perspective Glass, it either wholly escapes their Sight, or appears to them a mere Minutity."
                                            },
                                            {
                                                "example_id": "50e8de7e-f45c-462f-8fbc-7cf9c39571af",
                                                "sense_id": "11285b6c-d920-32f6-a248-d99cb594ffc8",
                                                "text": "The smile of the babe was in my eye, and in my heart. I saw miniatur’d forth, the features of the murdered Edward."
                                            },
                                            {
                                                "example_id": "cf0ea815-5ffa-468c-b742-b6bead2ea202",
                                                "sense_id": "11285b6c-d920-32f6-a248-d99cb594ffc8",
                                                "text": "c. 1807, Samuel Taylor Coleridge, letter to Joseph Cottle, cited in Joseph Cottle, Early Recollections, Chiefly Relating to the Late Samuel Taylor Coleridge, London: Longman, Rees, 1837, Volume 2, p. 131,\nNow what the globe is in geography, miniaturing in order to manifest the truth, such is a poem to that image of God, which we were created into […]"
                                            },
                                            {
                                                "example_id": "69fe3c89-29c0-4b68-87c0-eadd488470df",
                                                "sense_id": "11285b6c-d920-32f6-a248-d99cb594ffc8",
                                                "text": "[…] a moon holds its gray glories miniatured in rock and dust."
                                            },
                                            {
                                                "example_id": "b202d38f-3aae-447f-ac8d-5db10f028503",
                                                "sense_id": "11285b6c-d920-32f6-a248-d99cb594ffc8",
                                                "text": "Dad had had Lily’s Haiti photos developed, and […] among them was a sunset miniatured in purple […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
