                                "example_id": "526b885c-8e5d-4ce4-92d1-a1bb69695b2e",
                                "sense_id": "38088566-eda1-34e4-9c74-fa4c9b1836a2",
                                "text": "En effet, l'entretien est un métadiscours, capable à ce titre de réinvestir et de ré-encadrer les discours antérieurs des écrivains."
                            },
                            {
                                "example_id": "48a73186-f6d6-43f4-a1f4-cb8f5f5a1312",
                                "sense_id": "38088566-eda1-34e4-9c74-fa4c9b1836a2",
