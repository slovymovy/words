                        "glosses": [
                            "straat of steeg die dwars op een grotere hoofdstraat uitkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee86e800-a402-45f7-8b46-bff2be3b59ae",
                                "sense_id": "a3af7d21-9b16-3067-a9ef-65a51b9cddcd",
                                "text": "‘Hoe heet dat plein?’, vroeg hij. ‘Dat weet geen Parijzenaar. Zoals niemand weet dat die strook waar de markt op is, de naam draagt van de Renault-directeur die daar in 1986 werd doodgeschoten. En niemand weet waarom die dwarsstraat de Huygensstraat heet. Welke Huygens was dat?’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "402a8504-2699-4b18-b474-2ea2a97ee060",
                        "source_entry_id": "385dd4b7-bd60-3314-a938-d79892b9bfbb",
                        "source_sense_id": "a3af7d21-9b16-3067-a9ef-65a51b9cddcd",
