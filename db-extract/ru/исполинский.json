                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801656f4-dc8d-4a7e-83c4-eb0c2e0e7d79",
                                                "sense_id": "e6e445ea-578e-3dcb-8e94-a9b160abd6f7",
                                                "text": "Bei der Kollision wurde ein riesiges Loch in die Bordwand gerissen."
                                            },
                                            {
                                                "example_id": "633b53ad-c424-4fa9-b3dd-6fb12e32499b",
                                                "sense_id": "e6e445ea-578e-3dcb-8e94-a9b160abd6f7",
                                                "text": "Auf der Messe herrschte ein riesiger Andrang."
                                            },
                                            {
                                                "example_id": "8e6b73c2-05a9-45bd-a317-ee79925be367",
                                                "sense_id": "e6e445ea-578e-3dcb-8e94-a9b160abd6f7",
                                                "text": "„Viele Konzerne verursachen riesige Mengen CO₂.“"
                                            }
                                        ],
