                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4ba03fa-1501-317e-a9f7-fd78aa85c773",
                        "entry_id": "6f604151-5b1a-39b9-9063-2b024cf27449",
                        "glosses": [
                            "To move up and down on one's knee or in one's arms, in affectionate play, usually said of a child."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f1b2a17-ef27-4551-b8ef-5edd1b26b5d7",
                                "sense_id": "c4ba03fa-1501-317e-a9f7-fd78aa85c773",
                                "text": "the young mother sat [the infant] upright in her lap, and[…]dandled it with a gloomy indifference."
                            },
                            {
                                "example_id": "f0a881a4-7e2f-4752-8021-f5af61886357",
                                "sense_id": "c4ba03fa-1501-317e-a9f7-fd78aa85c773",
                                "text": "You will nurse and be carried on her arm and dandled on her knees."
                            },
                            {
                                "example_id": "c66b19af-f584-4f79-a62f-f550b7229ffd",
                                "sense_id": "c4ba03fa-1501-317e-a9f7-fd78aa85c773",
                                "text": "Hands grasped me like a doll, and as I dandled thus between the meretrices of Abaia, I was lifted from my broad-armed chair in the inn of Saltus; yet still, for perhaps a hundred heartbeats more, I could not rid my mind of the sea and its green-haired women."
                            }
                        ]
                    },
                    {
                        "sense_id": "38eaa23d-e563-3adb-9e1e-7619fadd96a0",
                        "entry_id": "6f604151-5b1a-39b9-9063-2b024cf27449",
                        "glosses": [
                            "To treat with fondness or affection, as if a child; to pet."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "85f924b0-d038-4f2e-877c-56258312c554",
                                "sense_id": "38eaa23d-e563-3adb-9e1e-7619fadd96a0",
                                "text": "[T]hey have put me in a silk night-gown and gaudy fool's cap, and make me now and then stand in the window with it. I am ashamed to be dandled thus, and cannot look in the glass without blushing to see myself turned into such a pretty little master."
                            },
                            {
                                "example_id": "5efa0fa8-9124-4eaa-abd5-8c86d528062a",
                                "sense_id": "38eaa23d-e563-3adb-9e1e-7619fadd96a0",
                                "text": "The book, thus dandled into popularity by bishops and good ladies, contained many pieces of nursery eloquence."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d315074-b292-386b-9e24-5c80b5ab86cf",
                        "entry_id": "6f604151-5b1a-39b9-9063-2b024cf27449",
                        "glosses": [
                            "To play with; to wheedle."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ff3c17c1-6113-4051-87c6-a724057e9bb6",
                                "sense_id": "4d315074-b292-386b-9e24-5c80b5ab86cf",
                                "text": "captaines, who notwithstanding that they are specially imployed to make peace thorough strong execution of warre, yet they doe so dandle their doings, and dallie in the service to them committed"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b41c8ae8-903b-4264-8f31-311758ce3cff",
                        "source_entry_id": "6f604151-5b1a-39b9-9063-2b024cf27449",
                        "source_sense_description": "to move up and down on one's knee or in one's arms, in affectionate play",
                        "target_lang_word": "dodeliner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dodeliner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                        "entry_id": "a2dcedc0-407e-3673-981e-78e7ad314d1c",
                                        "glosses": [
                                            "Se balancer doucement."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946e8564-fdd1-4363-baf7-036fc220e94c",
                                                "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                                "text": "Dodeliner du corps, de la tête."
                                            },
                                            {
                                                "example_id": "ec203d52-44af-45b3-8346-1eb6b3755040",
                                                "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                                "text": "— Venez, cher ami, dit-il à Sainte-Austreberthe, et écoutons religieusement ; si vous pouvez dodeliner de la tête ou prendre l’air de douce béatitude d’un abonné du Conservatoire, cela fera très bien dans le pays."
                                            },
                                            {
                                                "example_id": "3b4b786e-737c-4d46-973c-147cc4defcd2",
                                                "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                                "text": "Voilà notre farceur qui se pose juste en face de la vieille et ancestrale horloge et qui, dodelinant de la tête, l’index tendu, accompagne d’un balancement rythmique de tout son corps le mouvement du balancier."
                                            },
                                            {
                                                "example_id": "5387aa8d-43d7-44cd-bf45-e603c2d5609c",
                                                "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                                "text": "La cloche endormie dodelinait. Une ou deux fois, cet hiver, le vent de La Châtre soufflant, elle avait sonné d’elle-même, et tous les enfants s’étaient regardés, bienheureux."
                                            },
                                            {
                                                "example_id": "a2839bb8-6b30-43d0-952a-9ae6ecfb44c3",
                                                "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                                "text": "Sous un éclairage blafard, un chanteur aux cheveux blonds platinés et au costume bleu ciel secouait une guitare électrique en dodelinant de la tête."
                                            },
                                            {
                                                "example_id": "c54a84e5-4a87-4806-b869-a8ca9788f8ba",
                                                "sense_id": "ab2df6e7-3b21-318b-93af-c6118e81f399",
                                                "text": "Sa moumoute dodelinait d'une oreille à l'autre. Ses pupilles dodelinaient au milieu des iris. Ses yeux dodelinaient à l'intérieur des orbites. En avant, en arrière, il dodelinait de la tête, du torse, du bassin, des genoux. Il dodelinait de partout. Lentement, comme le balancier d'une pendule au ressort détendu. En long, en large. Du corps. Et de l'âme. Jusqu'à la bonne volonté, jusqu'à la bonne foi, jusqu'au courage, jusqu'à la franchise, qu'il avait résolument do-de-li-nants.\nSa langue pointait-elle par intermittence d'entre ses lèvres épaisses? C'était pour la remettre à dodeliner après qu'il l'eut rappelée en son clapet. … Au paroxysme de certains bâillements, il m'était arrivé de distinguer le fond de sa gorge, où dodelinait l'épiglotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2b74b9-e14b-3710-927a-cb4e5b1dc977",
                                        "entry_id": "a2dcedc0-407e-3673-981e-78e7ad314d1c",
                                        "glosses": [
                                            "Balancer doucement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee89cae0-36e9-45b3-aebe-18d2c4558fc6",
                                                "sense_id": "2b2b74b9-e14b-3710-927a-cb4e5b1dc977",
                                                "text": "Des sons lointains de clochettes annoncent des troupeaux de vaches. Les voici qui viennent, dodelinant les têtes et se berçant du doux tintement de leurs cloches. = Albert Robida (1848-1926), \"Les Vieilles villes de Suisse\" (1879)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49f49309-00da-4629-93ac-d678db628573",
                        "source_entry_id": "6f604151-5b1a-39b9-9063-2b024cf27449",
                        "source_sense_description": "to move up and down on one's knee or in one's arms, in affectionate play",
                        "target_lang_word": "se trémousser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se trémousser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "945d06e2-a35d-3195-9af1-600fc9ee1397",
                                        "entry_id": "2ac09847-612d-3251-9d28-11c745a5f61f",
                                        "glosses": [
                                            "S’agiter d’un mouvement vif et irrégulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284fe387-7247-4208-a1c0-c71426444d5a",
                                                "sense_id": "945d06e2-a35d-3195-9af1-600fc9ee1397",
                                                "text": "De leur balcon qu'on atteignait par une échelle,, les musiciens déversaient sans répit sur la foule, des airs de valse, de java, de shimmy, de charleston et tout le monde se trémoussait."
                                            },
                                            {
                                                "example_id": "177e3956-c185-4fc8-b5f3-7300b6155d76",
                                                "sense_id": "945d06e2-a35d-3195-9af1-600fc9ee1397",
                                                "text": "Il se mit à se trémousser sur sa chaise, secoué d'un accès d'hilarité, des larmes dans les yeux, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457bbdc1-3aa5-3c8f-9a70-9f8204c04c48",
                                        "entry_id": "2ac09847-612d-3251-9d28-11c745a5f61f",
                                        "glosses": [
                                            "Faire des démarches nombreuses, se donner beaucoup de mouvement pour faire réussir une affaire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8824c5f0-91bc-4ae4-8470-e1dcd6b10c15",
                                                "sense_id": "457bbdc1-3aa5-3c8f-9a70-9f8204c04c48",
                                                "text": "Donnez ordre à tout, trémoussez-vous un peu."
                                            },
                                            {
                                                "example_id": "dc1f4f64-4e18-4175-aaeb-5e495f682066",
                                                "sense_id": "457bbdc1-3aa5-3c8f-9a70-9f8204c04c48",
                                                "text": "Il se trémousse fort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
