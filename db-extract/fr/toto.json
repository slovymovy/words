                    {
                        "sense_id": "4e7bb568-c2ee-313c-b8f5-12e236821da1",
                        "entry_id": "87d9b749-8590-377a-b296-e7e6892404ba",
                        "glosses": [
                            "Partisan du mouvement autonome (classé à l’extrême gauche)."
                        ],
                        "tags": [
