                ],
                "senses": [
                    {
                        "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                        "entry_id": "5151c12d-d5df-3d65-851b-53c989d644c2",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18cf5c92-621e-437f-8661-c76a180bcbd0",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Frau Scherle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "307d4560-1256-44a2-988c-8136c7982e76",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Herr Scherle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a6e76749-6ba1-4ceb-ae78-8b6d0f4547de",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Die Scherles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "72fdc70f-c215-4dcd-80c7-f172396b2509",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Der Scherle trägt nie die Schals, die die Scherle ihm strickt."
                            },
                            {
                                "example_id": "85083e3c-4883-46dc-9b15-3f58df066ea4",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scherle kommt, geht der Herr Scherle.“"
                            },
                            {
                                "example_id": "c473bf10-6158-4326-9e62-5b30c576292e",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Scherle kommt und geht."
                            },
                            {
                                "example_id": "1eb50b5d-d676-444f-815c-e5348839b148",
                                "sense_id": "8af8ccad-0949-3191-a8e7-ddc94a72c693",
                                "text": "Scherles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
