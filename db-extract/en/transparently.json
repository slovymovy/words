                        "glosses": [
                            "In a transparent manner; with nothing hidden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef43da2b-709d-4d55-8f68-b516a449e40a",
                                "sense_id": "fac33874-2a02-3856-9897-8e3be17f1438",
                                "text": "They conducted their business transparently, solely in public meetings."
                            },
                            {
                                "example_id": "e704e9cd-6d81-42a2-bc63-8c305903c629",
                                "sense_id": "fac33874-2a02-3856-9897-8e3be17f1438",
                                "text": "Musk’s Israel tour was transparently transactional and frankly insulting. The antisemitic sentiment Musk endorsed had nothing to do with Israel; “replacement theory” is generally an unsupported allegation that Jews and other immigrants in the US and Europe are destroying Western civilization."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee949b61-c97c-3e55-a8a1-78955885abb6",
                        "entry_id": "d4d8f576-01d7-353f-a806-06405f5ab52c",
                        "glosses": [
                            "So as to admit light without distortion."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "420b9b6f-4804-32c6-b94f-5d55d8397276",
                        "entry_id": "d4d8f576-01d7-353f-a806-06405f5ab52c",
                        "glosses": [
                            "So as to be readily perceived and understood."
                        ],
                        "tags": [
                            "modal"
                        ],
                        "examples": [
                            {
                                "example_id": "eb004e83-5322-43f4-898c-61947b5b273b",
                                "sense_id": "420b9b6f-4804-32c6-b94f-5d55d8397276",
                                "text": "Transparently to all, he had nothing of substance to say."
                            }
                        ]
                    }
