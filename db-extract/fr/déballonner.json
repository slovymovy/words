                        ],
                        "examples": [
                            {
                                "example_id": "efba8688-bc4d-4f2e-b6a9-d4c02aaa4bde",
                                "sense_id": "80be197a-e1b3-334e-8fd0-398ab7a7b37b",
                                "text": "Thierry voulait accoster une super meuf à la soirée, mais il s’est déballonné quand elle l’a regardé droit dans les yeux.",
                                "translation": "Thierry wilde die avond een te gekke meid aanspreken, maar hij haakte af toen ze hem recht in de ogen keek."
                            }
                        ]
                    }
