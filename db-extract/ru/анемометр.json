                "translations": [
                    {
                        "translation_id": "300782c3-43f4-45c4-be1b-92ac4a984c94",
                        "source_entry_id": "d295c88d-9167-3ca7-8a52-0623a5549020",
                        "source_sense_id": "f64e5cd5-dd08-3554-876e-04c769b82e2a",
                        "target_lang_word": "anemometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anemometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9ffb7b2-9da3-3996-bc58-85398a9935eb",
                                        "entry_id": "41b47efa-dbd2-3329-b5b2-70f97f276997",
                                        "glosses": [
                                            "An instrument for measuring and recording the speed of the wind, a windmeter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e907f8-d621-4d16-adf2-d24cfcacf053",
                                                "sense_id": "b9ffb7b2-9da3-3996-bc58-85398a9935eb",
                                                "text": "An anemometer constructed by the Soil Mechanics Laboratory of the Western Region, British Railways, has been installed at Dawlish Warren, near Exeter, to obtain a record of the velocity (speed and direction) of the wind. This information is used for the study of the effects of wind erosion on the sand dunes which protect the railway from the sea at that point."
                                            },
                                            {
                                                "example_id": "5966d42c-7305-4211-81c1-62f43fe9079a",
                                                "sense_id": "b9ffb7b2-9da3-3996-bc58-85398a9935eb",
                                                "text": "This anemometer was installed by the North Eastern Railway on Staithes Viaduct in 1884, to warn signallers of dangerously high winds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4fd6fd0-ce6b-4afb-884c-4561e1131284",
                        "source_entry_id": "d295c88d-9167-3ca7-8a52-0623a5549020",
                        "source_sense_id": "f64e5cd5-dd08-3554-876e-04c769b82e2a",
                        "target_lang_word": "wind gauge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wind gauge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "157d8c81-5692-387e-9a0f-1898aada2166",
                                        "entry_id": "e8c4ce2e-0eb6-3bd1-8103-e84995435281",
                                        "glosses": [
                                            "An anemometer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7f90c5-8f42-453b-b30d-834f1f6a09ff",
                                                "sense_id": "157d8c81-5692-387e-9a0f-1898aada2166",
                                                "text": "Detailed records are kept of the strains imposed on the bridge by the violent gales that frequently sweep the firth, and a self-recording wind gauge is fixed on the top of the tower."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
