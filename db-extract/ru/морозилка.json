                "translations": [
                    {
                        "translation_id": "e1ff93d2-4e62-45ee-91ab-dc89da56cbbd",
                        "source_entry_id": "7abd41a2-6cc4-3949-932c-073bd22ec10b",
                        "source_sense_id": "861ed0e8-1a4f-3206-a215-6aed158829e0",
                        "target_lang_word": "freezer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freezer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b958dc-515e-3985-9b09-22c6f34a4da1",
                                        "entry_id": "f9efb631-945a-3965-b4e1-dfcbc8635e03",
                                        "glosses": [
                                            "Compartiment d’un réfrigérateur destiné à la congélation, communément utilisé pour produire et stocker des glaçons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "freezer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "760e7440-848e-347b-8559-c21ac29e8a25",
                                        "entry_id": "c7f7f775-957f-3213-896e-7b515e0b1a99",
                                        "glosses": [
                                            "Cesser de réagir aux activités de l’utilisateur."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa05f3c6-e540-451f-bde4-d085a40a7cb6",
                                                "sense_id": "760e7440-848e-347b-8559-c21ac29e8a25",
                                                "text": "En quelques mots, Microsoft Edge a freezé pendant que l’ingénieur travaillait avec des machines virtuelles dans le navigateur, et à en juger par la vitesse à laquelle il procédait au téléchargement de Google Chrome, ce n’était pas la première fois que cela arrivait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5228e1d-8a84-3b2c-8c3b-7bc71a010868",
                                        "entry_id": "c7f7f775-957f-3213-896e-7b515e0b1a99",
                                        "glosses": [
                                            "Rester anormalement dans un certain état, en parlant d’une image qui est censée bouger (vidéo, télévision, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab26620-6436-4c0b-aa62-bfcec26d3af1",
                                                "sense_id": "f5228e1d-8a84-3b2c-8c3b-7bc71a010868",
                                                "text": "Bien sûr, les images étaient pixélisées, freezaient régulièrement, le son était robotisé."
                                            },
                                            {
                                                "example_id": "1116bc9b-ca67-4f48-bcfd-99104a51ab3f",
                                                "sense_id": "f5228e1d-8a84-3b2c-8c3b-7bc71a010868",
                                                "text": "Selon nos constatations et plusieurs témoignages, il est fréquent si vous habitez le long d’une ligne de Tramway d'avoir l’image de la télévision qui freeze (ou la connexion sui saute) au passage d’un tram."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05914100-2366-4ce5-affe-c5685a6209f3",
                        "source_entry_id": "7abd41a2-6cc4-3949-932c-073bd22ec10b",
                        "source_sense_id": "861ed0e8-1a4f-3206-a215-6aed158829e0",
                        "target_lang_word": "congélateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congélateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                        "entry_id": "1733cd96-a684-34d1-8ede-8167d97c1b43",
                                        "glosses": [
                                            "Appareil destiné à stocker durablement les produits surgelés ou congelés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809d1290-a4fd-4203-bd19-9664b4992438",
                                                "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                                "text": "Placée au congélateur, la propolis devient friable et peut être récupérée."
                                            },
                                            {
                                                "example_id": "585b7099-6b65-44fd-8b20-4276bbb42689",
                                                "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                                "text": "Ici aussi, on vivait de la récup, de la réparation d’appareils usagés, de la vente de métaux. Des coups de marteau s'élevaient derrière des palissades formées de frigos ou de congélateurs."
                                            },
                                            {
                                                "example_id": "9637bf49-fd84-49c5-8746-4324fde697d5",
                                                "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                                "text": "Daniel Paré assure cependant que de nombreuses doses sont conservées dans des congélateurs, comme l’exige le type de vaccin produit par Pfizer, pour administrer les deuxièmes doses aux personnes qui ont été vaccinées cette semaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
