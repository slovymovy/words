                        "sense_id": "5816d0b7-fac3-3795-9509-cd8a4420905c",
                        "entry_id": "321d3281-2c53-301f-bf57-319602a2125a",
                        "glosses": [
                            "zuren die een onderdeel vormen van de gal en een belangrijke rol spelen bij de vertering van vetten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4759e064-bee3-4a98-a05f-54617baa6536",
                                "sense_id": "5816d0b7-fac3-3795-9509-cd8a4420905c",
                                "text": "In het bloed van de beren bleken ’s winters de gehaltes aan vetten en cholesterol significant verhoogd, als gevolg van de vetverbranding tijdens de winterslaap. De bloedconcentratie van galzuur (dat de opname van vetten uit voedsel stimuleert) daalde juist in de winter."
                            },
                            {
                                "example_id": "7d847f6f-2864-412c-ad42-1b74adf33d4d",
                                "sense_id": "5816d0b7-fac3-3795-9509-cd8a4420905c",
                                "text": "Patiënten met cerebrotendineuze xanthomatose (CTX) maken onvoldoende galzuur aan. Dat kan leiden tot staar op jonge leeftijd, vroeg beginnende dementie en ernstige spieraandoeningen. CDCA kan, als het op tijd wordt ingezet, zware handicaps voorkomen. In Nederland lijden zo’n 65 mensen aan CTX."
                            }
                        ]
                    }
