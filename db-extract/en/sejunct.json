                        "entry_id": "39b472e5-3f2a-36d2-a12c-a47e573515f7",
                        "glosses": [
                            "Separate; separated."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ca7d7825-b2df-4e9d-b111-064193fc58d9",
                                "sense_id": "d47c9a32-56a0-3ab6-baca-37575890f854",
                                "text": "‘Nay, not so far – [...] not so far, he saith, do I pronounce the gods to be sejunct and alienate from us, as to think that not even our prayers can reach them.’"
                            },
                            {
                                "example_id": "cff8f0ac-a99b-4012-ab2f-40513874e1db",
                                "sense_id": "d47c9a32-56a0-3ab6-baca-37575890f854",
                                "text": "Now that mechanical science has realised his ancient dreams of flight and sejunct communication, he is the advance guard of the psychologist on the watch for new emotions, new vibrations sensible to faculties as yet ill understood."
                            },
                            {
                                "example_id": "36855878-98c9-4bb9-b474-1e36e7c4de76",
                                "sense_id": "d47c9a32-56a0-3ab6-baca-37575890f854",
                                "text": "images, divine and human, the cogitation of which by sejunct females is to tumescence conducive or eases issue in the high sunbright wellbuilt fair home of mothers when, ostensibly far gone and reproductitive, it is come by her thereto to lie in, her term up."
                            }
                        ]
                    }
