                        ],
                        "form": "die Biologinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                        "entry_id": "5bc20e27-97be-3d44-b9c3-d0029e3ab873",
                        "glosses": [
                            "Wissenschaftlerin, die sich mit belebter Natur (Biologie) beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27396f8f-1e8b-47b1-8a51-11561983c8cf",
                                "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                "text": "Zur Umweltverträglichkeitsprüfung wurde eine Biologin zu Rate gezogen."
                            },
                            {
                                "example_id": "837103f2-e9c4-4d5e-a54f-a017c89b93b0",
                                "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                "text": "„Die beiden Biologinnen kartieren Trittspuren, nehmen Kotproben, schließlich dürfen sie einige Tiere mit Sendern ausstatten, um deren Bewegungen zu verfolgen.“"
                            },
                            {
                                "example_id": "6bff3eb4-2b8a-4449-b5a6-62e9c9d8e42a",
                                "sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                                "text": "„Die Person, die so etwas behauptet, ist die Biologin Christiane Nüsslein-Volhard.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43c408e4-35df-460a-9288-2af3f89d2560",
                        "source_entry_id": "5bc20e27-97be-3d44-b9c3-d0029e3ab873",
                        "source_sense_id": "714fae77-6b1d-395a-99bc-0190780f13a1",
                        "source_sense_description": "Wissenschaftlerin, die sich mit belebter Natur (Biologie) beschäftigt",
                        "target_lang_word": "biologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee1092e2-051a-379a-a7c8-84869ac08c7f",
                                        "entry_id": "243976be-dda5-3681-9d5c-cc937a0f10d7",
                                        "glosses": [
                                            "A student of biology; one versed in the science of biology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d435863-fdb0-47f7-b5fd-a62ea18ed976",
                                                "sense_id": "ee1092e2-051a-379a-a7c8-84869ac08c7f",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            },
                                            {
                                                "example_id": "a8fca659-0fd0-4daf-a2ba-0f239bc248ef",
                                                "sense_id": "ee1092e2-051a-379a-a7c8-84869ac08c7f",
                                                "text": "Wildlife biologist Stanley Temple hypothesised that perhaps the dodo tree was dependent on its seeds passing through the digestive system of dodos in order to properly germinate and that the handful of individuals in the 1970s were the last remaining trees from seeds that passed through a dodo in the 1690s-1700s when they went extinct."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
