                ],
                "senses": [
                    {
                        "sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                        "entry_id": "8b29fee3-2583-3c38-ad02-18125de02f07",
                        "glosses": [
                            "ein hölzerner Löffel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b44589d-2250-49ba-ba48-af45ba9a9257",
                                "sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                                "text": "Er rührte die Suppe mit einem großen Holzlöffel um."
                            },
                            {
                                "example_id": "5efc15e8-37c3-418f-b6fe-fc4fa386047e",
                                "sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                                "text": "„Ich setzte mich zu Tisch; da ich vor mir einen Holzlöffel liegen sah, stieß ich ihn zurück und verlangte mein Eßbesteck, das ich liebte, weil es ein Geschenk meiner guten Großmutter war.“"
                            },
                            {
                                "example_id": "9e8d08dc-32fd-43d8-ae5a-68e3f5ed6922",
                                "sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                                "text": "„Die Köchin Rosa schwenkte dort einen großen Holzlöffel.“"
                            },
                            {
                                "example_id": "81b852c0-c0b8-4d27-926a-5f10f6df5f24",
                                "sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                                "text": "„Eine Lösung aus Lauge und Wasser löst einen Holzlöffel auf.“"
                            },
                            {
                                "example_id": "b9e0ba95-bbc8-4c0d-b0d7-675f2fe7206b",
                                "sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                                "text": "„Nab mußte die dampfende Masse mit Holzlöffeln umrühren, um die Verdampfung zu beschleunigen und zu verhindern, dass der Zucker hinterher verbrannt schmeckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0917c4ed-a55c-45a7-ab20-ae9b8225fa17",
                        "source_entry_id": "8b29fee3-2583-3c38-ad02-18125de02f07",
                        "source_sense_id": "8f7eb112-2e32-389e-9737-8fe0c5ee9147",
                        "source_sense_description": "ein hölzerner Löffel",
                        "target_lang_word": "wooden spoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wooden spoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "780911a2-2c69-3c73-825c-7174711db375",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "A spoon made from wood, commonly used in food preparation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c6a9679-e01d-3788-9795-b1bb2a7e62b3",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "An ironic prize for finishing last in a competition."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44fd61c-943f-4c7c-b944-ec0a4ec00161",
                                                "sense_id": "6c6a9679-e01d-3788-9795-b1bb2a7e62b3",
                                                "text": "Earnestly bent upon fulfilling the weighty, nay solemn, responsibilities of his office at all hazard, even at the risk of so far neglecting his parliamentary duties as to appear upon the division-list less frequently than any of his colleagues, Sir John Pakington wore the wooden spoon at the whitebait dinner, though with an air of waggery — almost as a decoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487a742e-c957-38e2-861a-77a17e3d74ec",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "The last junior optime who takes a university degree."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e749943-7a7d-4e12-b0a6-73d198c593ec",
                                                "sense_id": "487a742e-c957-38e2-861a-77a17e3d74ec",
                                                "text": "We submit that a wooden spoon of our day would not be justified in calling Galileo and Napier blockheads because they never heard of the differential calculus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be55e4f8-08e2-3a8b-b5ba-5a1b5d5cc7c8",
                                        "entry_id": "9c8a31aa-d466-3fee-bc34-4fcec195f579",
                                        "glosses": [
                                            "The lowest appointee of the junior year; sometimes, one especially popular in his class, without reference to scholarship. Formerly, it was a custom for classmates to present to this person a wooden spoon with formal ceremonies."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
