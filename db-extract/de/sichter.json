                ],
                "senses": [
                    {
                        "sense_id": "7c049ee8-28b8-3f15-ad32-801619ade20e",
                        "entry_id": "d68bc0a4-1276-3e26-b7fb-2a7412b24504",
                        "glosses": [
                            "Person, die etwas prüfend beobachtet oder begutachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c43d59e-a3f3-4af6-a79f-20ca3318fa2e",
                                "sense_id": "7c049ee8-28b8-3f15-ad32-801619ade20e",
                                "text": "„Immerhin werden nun Änderungen an einem Artikel der breiten Masse nicht mehr umgehend angezeigt, dies bedarf der Zustimmung eines ‚Sichters‘.“"
                            },
                            {
                                "example_id": "2895b554-09e0-481c-8005-b4970eff876c",
                                "sense_id": "7c049ee8-28b8-3f15-ad32-801619ade20e",
                                "text": "„Ihren Status erhalten die aktiven Sichter nach quantitativen Aktivitätskriterien und Wohlverhaltensvorschriften: So dürfen nur maximal drei Prozent der Bearbeitungen eines Benutzers wieder rückgängig gemacht worden sein.“"
                            },
                            {
                                "example_id": "9655f473-6245-416a-8fed-caf9b28c2a80",
                                "sense_id": "7c049ee8-28b8-3f15-ad32-801619ade20e",
                                "text": "„Durch die Nutzergruppe der Sichter wurde eine Zwischeninstanz geschaffen; die Sichtung eines Artikels bestätigt die Überprüfung auf offensichtlichen Vandalismus durch einen regelmäßigen Autor der Wikipedia, sagt jedoch nichts über die inhaltliche Qualität oder Richtigkeit eines Artikels aus.“"
                            },
                            {
                                "example_id": "1cc6f89f-4c49-450d-942d-88d9bee23169",
                                "sense_id": "7c049ee8-28b8-3f15-ad32-801619ade20e",
                                "text": "„Seit Mai 2008 ist es nicht-registrierten Nutzern nicht mehr möglich, den Artikel direkt zu bearbeiten und diese Bearbeitung dann sofort online zu stellen, sondern sie muss zunächst von einem Sichter überprüft werden.“"
                            },
                            {
                                "example_id": "bab5e66c-a3a2-4f23-a364-587bf3b89021",
                                "sense_id": "7c049ee8-28b8-3f15-ad32-801619ade20e",
                                "text": "„Die Sichter der USK erhalten alle komplexen Titel bereits Tage vor der eigentlichen Prüfung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bafa6282-5d48-36b3-9017-c54866c8751d",
                        "entry_id": "d68bc0a4-1276-3e26-b7fb-2a7412b24504",
                        "glosses": [
                            "Anlage, in der etwas prüfend beobachtet oder begutachtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c7749e6-2cb9-48b5-8dba-75e462d04458",
                                "sense_id": "bafa6282-5d48-36b3-9017-c54866c8751d",
                                "text": "„Der Sichter besteht aus einem rechteckigem Kanal, der durch zickzackförmige Wände in mehrere Rohre unterteilt wird.“"
                            },
                            {
                                "example_id": "53c10e02-db3c-498e-aae0-416cdcd8faa8",
                                "sense_id": "bafa6282-5d48-36b3-9017-c54866c8751d",
                                "text": "„Entwicklungsfähig sind ferner die Sichter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
