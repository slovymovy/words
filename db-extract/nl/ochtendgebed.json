                                            {
                                                "example_id": "ec6d14d3-6ea3-448b-9b53-e8676dfed493",
                                                "sense_id": "dd5b24dc-9ef0-3bb9-b416-52fb5016a9f2",
                                                "text": "Die Mönche verrichten ihr Morgengebet."
                                            },
                                            {
                                                "example_id": "c89b8de1-60b0-4ac4-9414-3d5005c12307",
                                                "sense_id": "dd5b24dc-9ef0-3bb9-b416-52fb5016a9f2",
                                                "text": "„Nach einer kurzen Morgentoilette begaben Michael und ich uns zum Morgengebet, obwohl wir im Gegensatz zum vorherigen Tag überhaupt nicht dazu aufgelegt waren, sondern viel lieber weitergeschlafen hätten.“"
                                            },
                                            {
                                                "example_id": "83466b14-3891-46a2-977b-78dfa068690f",
                                                "sense_id": "dd5b24dc-9ef0-3bb9-b416-52fb5016a9f2",
                                                "text": "„Er verrichtet das Morgengebet, holt Bauernkleider aus dem Schrank und zieht sie an, mit einem Sack und einer Axt verlässt er das Haus.“"
                                            }
