                ],
                "senses": [
                    {
                        "sense_id": "d00d03a9-4c71-3e72-aa9e-426a13cbd3c0",
                        "entry_id": "e3d30f5f-7525-3cac-bf7b-946c13f6a904",
                        "glosses": [
                            "Créer un protocole, une procédure, pour normaliser une activité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4320ab21-bf8e-456d-b4ea-34c13674d072",
                                "sense_id": "d00d03a9-4c71-3e72-aa9e-426a13cbd3c0",
                                "text": "Le cadre infirmier doit être capable de protocoliser les pratiques soignantes à partir des prescriptions médicales."
                            },
                            {
                                "example_id": "67551c55-661b-4657-8986-c6ca48768630",
                                "sense_id": "d00d03a9-4c71-3e72-aa9e-426a13cbd3c0",
                                "text": "Il serait donc sans doute bénéfique de protocoliser l'information adressée aux receveurs afin que tous soient informés suffisamment tôt et sans «pression»."
                            },
                            {
                                "example_id": "0feaa288-39b4-480f-be15-2b0ff91874b1",
                                "sense_id": "d00d03a9-4c71-3e72-aa9e-426a13cbd3c0",
                                "text": "Tout est très protocolisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d204b3b-de50-35ab-82d7-63668075e8f0",
                        "entry_id": "e3d30f5f-7525-3cac-bf7b-946c13f6a904",
                        "glosses": [
                            "Agir en privilégiant le protocole avant tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5f7e18-2786-4e2d-afb2-ddc3ab70122f",
                                "sense_id": "7d204b3b-de50-35ab-82d7-63668075e8f0",
                                "text": "En voyant la Prusse qui traitait isolément, et l'Empire qui ne cessait de protocoliser, l'Autriche jeta les hauts cris."
                            }
                        ]
                    }
