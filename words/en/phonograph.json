                    "frequency": "Middle",
                    "semantic_group_id": "audio_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique shop had an old <w>phonograph</w> sitting in the corner."
                        },
                        {
                            "text": "We listened to vintage jazz music playing on the <w>phonograph</w>."
                        }
                    ],
                    "synonyms": [
                        "gramophone",
                        "record player"
                    ],
                    "common_phrases": [
                        "listen to a phonograph",
                        "antique phonograph"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often refers specifically to historical sound playback machines."
                        }
                    ]
                },
                {
