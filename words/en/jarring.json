                            },
                            {
                                "target_lang_word": "pronikavý",
                                "target_lang_sense_clarification": "o zvuku nebo vjemu"
                            },
                            {
                                "target_lang_word": "nesourodý",
                                "target_lang_sense_clarification": "neodpovídající, disharmonický"
                            },
                            {
                                "target_lang_word": "šokující",
                                "target_lang_sense_clarification": "vyvolávající náhlý údiv či nepohodlí"
                            }
                        ]
                    }
                }
            ]
