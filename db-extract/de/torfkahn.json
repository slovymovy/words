                "senses": [
                    {
                        "sense_id": "69eedce5-2e6c-30b7-bf8d-2e8ae9107056",
                        "entry_id": "12f8f5fb-18e3-3b93-904d-3a1ffd4b746d",
                        "glosses": [
                            "Bootstyp, welcher verwendet wurde, um sich in Mooren fortzubewegen und Torf, also abgelagertes, totes organisches Material, das wegen Wassersättigung nicht vollständig abgebaut werden konnte, zu transportieren"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "94d73d0b-96e4-41e2-b50e-aad338d3a592",
                                "sense_id": "69eedce5-2e6c-30b7-bf8d-2e8ae9107056",
                                "text": "Heutzutage gibt es nur noch sehr wenige Torfkähne."
                            },
                            {
                                "example_id": "e0385c45-4e3a-45b6-8744-6f302023dba2",
                                "sense_id": "69eedce5-2e6c-30b7-bf8d-2e8ae9107056",
                                "text": "„Typisch für einen Fehnkanal ist, dass es auf beiden Seiten des Kanales Straßen bzw. Wege gibt, die einst notwendig waren, um die Torfkähne über die Kanäle zu ziehen.“"
                            },
                            {
                                "example_id": "74752937-4773-4aac-a98f-cc8b9e0962ba",
                                "sense_id": "69eedce5-2e6c-30b7-bf8d-2e8ae9107056",
                                "text": "„Auf dem See selbst aber begann es sich zu regen, und ein die Morgenbrise benutzender Torfkahn glitt mit ausgespanntem Segel an Schach vorüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
