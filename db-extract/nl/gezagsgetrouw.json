                "senses": [
                    {
                        "sense_id": "c9dc1be8-d177-3fa7-9b39-9137553b9d06",
                        "entry_id": "a7f31a17-855c-3975-8692-b9041382ad97",
                        "glosses": [
                            "trouw de aanwijzingen van het bevoegd gezag volgend; het bevoegd gezag respecterend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d64b562-9dc8-421b-a5a2-8f184add42ce",
                                "sense_id": "c9dc1be8-d177-3fa7-9b39-9137553b9d06",
                                "text": "Tonio, veel te gezagsgetrouw, had het advies om als handbagage alleen het hoogstnoodzakelijke mee het vliegtuig in te nemen te letterlijk genomen, waardoor de dure camera in zijn koffer terechtkwam."
                            },
                            {
                                "example_id": "ef776a57-ce5e-4474-9860-9101f3b7f2c1",
                                "sense_id": "c9dc1be8-d177-3fa7-9b39-9137553b9d06",
                                "text": "\"Ik denk niet dat Denen meer gezagsgetrouw zijn, maar ze hebben meer vertrouwen in het beleid\", zegt epidemioloog Viggo Andreasen. Dat betekent ook dat de Denen elkaar aanspreken als er niet in de ellenboog wordt gehoest of er geen mondkapje wordt gedragen. Iedereen gratis laten testen is erg duur. \"Maar het is peanuts in vergelijking met een nieuwe lockdown\", aldus Andreasen."
                            }
                        ]
                    }
