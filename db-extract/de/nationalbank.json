                "senses": [
                    {
                        "sense_id": "bd4be53d-831c-3926-b187-4648ae6ccdc0",
                        "entry_id": "1f515f2c-8ce0-39ba-982b-97413543371f",
                        "glosses": [
                            "zentrale Notenbank eines Staates"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "fc63fcc9-5520-4784-93e8-e03feceb62d3",
                                "sense_id": "bd4be53d-831c-3926-b187-4648ae6ccdc0",
                                "text": "„Die Nationalbank hielt Ende 2013 rund 82 Prozent ihrer physischen Goldreserven in England.“"
                            },
                            {
                                "example_id": "004dfa1e-5baf-44db-8501-091ef50b26f2",
                                "sense_id": "bd4be53d-831c-3926-b187-4648ae6ccdc0",
                                "text": "„Die kasachische Nationalbank teilt mit, dass Kasachstans Gold- und Devisenreserven 2007 auf 38,4 Mrd. US-Dollar gestiegen sind.“"
                            },
                            {
                                "example_id": "1e76de90-5c87-4212-b81d-cb6c8090bcc9",
                                "sense_id": "bd4be53d-831c-3926-b187-4648ae6ccdc0",
                                "text": "„Diese Industriediamanten und -brillanten tauchten kurze Zeit später in dem geräumigen Stahlsafe der Nationalbank in Zürich wieder auf, das ein gewisser Eugen Wälterli daselbst gemietet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
