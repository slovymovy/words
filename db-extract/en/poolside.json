                        "sense_id": "8aa1e9b2-f9f5-319b-8a5c-349362b805f5",
                        "entry_id": "004e1c56-74c2-3f5c-9e72-ff82dccd2770",
                        "glosses": [
                            "By the side of a pool."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0aaa4af4-3cea-4670-afe8-14fc6146403f",
                                "sense_id": "8aa1e9b2-f9f5-319b-8a5c-349362b805f5",
                                "text": "She was sunbathing on the poolside deckchair."
                            },
                            {
                                "example_id": "9bec081b-e887-4928-b03a-891302f7933c",
                                "sense_id": "8aa1e9b2-f9f5-319b-8a5c-349362b805f5",
                                "text": "If L. bicolor occurs at the same site, then L. microbelos becomes the underdog and calls from the base of poolside grasses but if L. bicolor is absent, L. microbelos calls from the top of grass stems."
                            },
                            {
                                "example_id": "fac7364d-d4df-4356-801e-7d5d5259314b",
                                "sense_id": "8aa1e9b2-f9f5-319b-8a5c-349362b805f5",
                                "text": "Sitting by the pool, Jan escapes into a Patricia Cornwell thriller while restless Anna, dissatisfied with the neglected poolside Japanese garden her mother had planted, pulls weeds."
                            },
                            {
                                "example_id": "79cea38f-6f5a-42a8-ab7c-3047b67444e7",
                                "sense_id": "8aa1e9b2-f9f5-319b-8a5c-349362b805f5",
                                "text": "I was sitting with Uncle Meyer inside the Lanskys' poolside cabana watching retirees assert their waning vestiges of earthly power with gratuitous admonitions to other people's grandchildren […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5b55ec37-e08a-3ecf-9e67-76ad6e0f334a",
