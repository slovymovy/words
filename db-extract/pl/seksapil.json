                "translations": [
                    {
                        "translation_id": "352bf6fc-7d71-46af-801b-1691258e2fe2",
                        "source_entry_id": "6c278f42-7a59-303b-8bbc-970a7b9dda80",
                        "source_sense_id": "c577bd7b-9119-303e-9938-d1080490018a",
                        "target_lang_word": "sex appeal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sex appeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                        "entry_id": "89369fda-0d68-364b-8d91-0a9fb151cd7b",
                                        "glosses": [
                                            "Sexual attractiveness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906821db-fd1e-4802-b023-38fa3a16bf93",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "He may be as thick as a plank, but he sure has some sex appeal."
                                            },
                                            {
                                                "example_id": "3c962f6f-3045-4368-b9bc-af0ead397a6c",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "But when she goes on to remark that “it is the height of folly to say that woman, who has been taught by the uncounted ages that her strongest hold on man is because of her sex, can throw off or disregard the knowledge that her sex appeal is the strongest weapon she has” then I am appalled at the extreme illogic of the lady!"
                                            },
                                            {
                                                "example_id": "9dcd28d6-23b9-4616-a172-bf6dbebb2f22",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "\"I can't talk to you when you're in a daze of admiration over your own sex appeal.\""
                                            },
                                            {
                                                "example_id": "01ff49d9-257a-49dd-8e4d-84e03d859463",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "Samara: She impresses with sophistication and sex appeal. Then she strikes. The hunt interests her as much as the conquest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2acfde37-9dea-46dc-be73-131b3a611018",
                        "source_entry_id": "6c278f42-7a59-303b-8bbc-970a7b9dda80",
                        "source_sense_id": "c577bd7b-9119-303e-9938-d1080490018a",
                        "target_lang_word": "attraction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attraction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e69d336e-6704-3c77-9a8f-57addf019d5b",
                                        "entry_id": "2b6a7974-06d0-34f5-9510-548505f13cbd",
                                        "glosses": [
                                            "Action d’attirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a35206-9611-427a-a1e9-d64869868eeb",
                                                "sense_id": "e69d336e-6704-3c77-9a8f-57addf019d5b",
                                                "text": "N’est-il pas étrange, ou plutôt fatal, qu’une irrésistible attraction fasse toujours graviter ces criminels autour du formidable tribunal qui les condamne à la prison, au bagne, à l’échafaud !"
                                            },
                                            {
                                                "example_id": "89ff578f-845a-4a28-a95f-b47314968a22",
                                                "sense_id": "e69d336e-6704-3c77-9a8f-57addf019d5b",
                                                "text": "L’attraction du fer par l’aimant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57bd895c-3b00-36d1-a689-0a57f0b09ae1",
                                        "entry_id": "2b6a7974-06d0-34f5-9510-548505f13cbd",
                                        "glosses": [
                                            "Ce qui attire la foule, notamment les spectacles, les divertissements, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48aae224-ad27-46c0-833d-87638ce35b5c",
                                                "sense_id": "57bd895c-3b00-36d1-a689-0a57f0b09ae1",
                                                "text": "Willy Ronis (1910-2009) aimait photographier la foule, les moments de rassemblement populaire autour d’une cause comme les ambiances festives dans les guinguettes des bords de Marne ou les attractions foraines."
                                            },
                                            {
                                                "example_id": "919ded8f-57bc-4292-8b3e-300fcd196fb0",
                                                "sense_id": "57bd895c-3b00-36d1-a689-0a57f0b09ae1",
                                                "text": "Vers sept heures du soir, je vais avec Milton au Paramount, cinéma où l’orchestre de Count Basie passe en attraction. Ce n’est pas du tout comme dans nos cinémas de Paris, où l’attraction – lorsque attraction il y a – reste secondaire : à New-York, on se dérange surtout pour l’attraction qui occupe la moitié du spectacle ; c’est le film qui est secondaire."
                                            },
                                            {
                                                "example_id": "5cca8544-245e-4bda-8f98-f5a31756d05c",
                                                "sense_id": "57bd895c-3b00-36d1-a689-0a57f0b09ae1",
                                                "text": "Ces \"Riverains du parc\" sont à bout à cause des bruits provenant de cette nouvelle attraction : \"Ce sont des cris qui nous empêchent de profiter de nos jardins, de travailler la fenêtre ouverte quand on est en télétravail, ou simplement d'être dehors avec les enfants\""
                                            },
                                            {
                                                "example_id": "54236173-1479-4a5a-a889-a2bc469a3528",
                                                "sense_id": "57bd895c-3b00-36d1-a689-0a57f0b09ae1",
                                                "text": "« Je cherche une attraction pour notre petite fête », dit le mulot. « Voudrais-tu être notre attraction? »\n« Une attraction? Qu'est-ce que c'est? » demande Bambou.\n« Une attraction, c'est quelque chose que l'on ne voit pas tous les jours. »\n« Oh, alors je veux bien être votre attraction. Dis-moi seulement ce que je dois faire », dit gaiement Bambou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3592889e-63bf-31b1-8cc2-497ed8a88190",
                                        "entry_id": "2b6a7974-06d0-34f5-9510-548505f13cbd",
                                        "glosses": [
                                            "Tendance des corps célestes à s’attirer les uns les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6edd01a-883d-4a12-8cbf-da5742ab6ccc",
                                                "sense_id": "3592889e-63bf-31b1-8cc2-497ed8a88190",
                                                "text": "La solution du problème se réduit donc à exprimer l’intégrale par une série convergente ; ce qui suppose nécessairement, que la masse ou la distance, en un mot, que l’attraction d'un corps est inconsidérable par rapport à celle de l'autre : […]."
                                            },
                                            {
                                                "example_id": "9c16092a-c5b0-4977-9f6e-f538d6cc3d3e",
                                                "sense_id": "3592889e-63bf-31b1-8cc2-497ed8a88190",
                                                "text": "A partir d'ici, nous étudions principalement le mouvement périodique d'un corps, le satellite artificiel, soumis a l’attraction gravitationnelle de la Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db8bab4-6b6d-347b-83be-d4f01b0402d3",
                                        "entry_id": "2b6a7974-06d0-34f5-9510-548505f13cbd",
                                        "glosses": [
                                            "Action mutuelle que tous les corps sont supposés exercer les uns sur les autres."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d32757d8-b904-3f9a-b8eb-4b2931001f00",
                                        "entry_id": "2b6a7974-06d0-34f5-9510-548505f13cbd",
                                        "glosses": [
                                            "Modification d’une lettre ou d’une tournure par l’influence d’une lettre ou d’une tournure voisine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88642d11-a8a4-41eb-8b35-1f5fb20fd7d7",
                        "source_entry_id": "6c278f42-7a59-303b-8bbc-970a7b9dda80",
                        "source_sense_id": "c577bd7b-9119-303e-9938-d1080490018a",
                        "target_lang_word": "sexuelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexuelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29fcdf89-97bc-3f41-bcf0-35ffd58215e1",
                                        "entry_id": "230cfcb1-af12-306f-a87f-5305855f7d4a",
                                        "glosses": [
                                            "Féminin singulier de sexuel."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79427afc-46ea-4c11-abd9-06d93e0802bb",
                                                "sense_id": "29fcdf89-97bc-3f41-bcf0-35ffd58215e1",
                                                "text": "Ça désanatomise la localisation sexuelle du plaisir, au point qu’en effet…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "369e88c6-8ffe-4bcc-ae98-43f73703e45d",
                        "source_entry_id": "6c278f42-7a59-303b-8bbc-970a7b9dda80",
                        "source_sense_id": "c577bd7b-9119-303e-9938-d1080490018a",
                        "target_lang_word": "attrait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attrait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3382b584-0efd-332c-bf34-dab7ce1bf9e7",
                                        "entry_id": "49f95d89-ec04-3291-a2fc-07f68a72c3de",
                                        "glosses": [
                                            "Ce qui attire agréablement ; ou inclination, goût que l’on a pour quelque chose d’agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc94b8e-117f-43b2-883a-2de84ba5ab94",
                                                "sense_id": "3382b584-0efd-332c-bf34-dab7ce1bf9e7",
                                                "text": "Un enfant, […], a incontestablement un droit naturel à la subsistance, fondé sur le devoir prescrit par la nature au pere et à la mere. Ce droit lui est d’autant plus assuré que le devoir du pere et de la mere est accompagné d’un attrait naturel, qui agit beaucoup plus puissamment sur le pere et plus particulierement sur la mere, que le motif du précepte qui établit le devoir."
                                            },
                                            {
                                                "example_id": "ecdd4fba-075d-43da-90aa-2ffde501915e",
                                                "sense_id": "3382b584-0efd-332c-bf34-dab7ce1bf9e7",
                                                "text": "Aux aventureux, l'Islande offre aussi l’attrait de l’inconnu. Le cœur de l’île, inhabité et inhabitable, est encore une terre incognito."
                                            },
                                            {
                                                "example_id": "17db7007-b068-4fff-9c32-d8d6c54428d0",
                                                "sense_id": "3382b584-0efd-332c-bf34-dab7ce1bf9e7",
                                                "text": "Non content de déblatérer sur la couille molle que je suis […], il m'accuse de plus de l'intrusion d'une crapule dans mon foyer, ainsi que de son attrait pour une queutarde patentée."
                                            },
                                            {
                                                "example_id": "07b0eb81-be90-4aed-b2b9-a0a8ad3b44ca",
                                                "sense_id": "3382b584-0efd-332c-bf34-dab7ce1bf9e7",
                                                "text": "L’involucre, cette collerette de bractées finement découpées qui entourent l’inflorescence chez certaines espèces, chez les ombellifères en particulier, ne constitue jamais, comme chez la nigelle de Damas, l’attrait principal de la plante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a733a2d0-1f75-3cb5-a590-67e6d7fbe175",
                                        "entry_id": "49f95d89-ec04-3291-a2fc-07f68a72c3de",
                                        "glosses": [
                                            "Agréments, charmes d’une personne."
                                        ],
                                        "tags": [
                                            "especially",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08468fb1-f642-4486-84f5-51cca1ec27f8",
                                                "sense_id": "a733a2d0-1f75-3cb5-a590-67e6d7fbe175",
                                                "text": "Et s’il parlait aux demoiselles : « Que le ciel, disait-il, vous donne un époux vraiment digne de vos attraits et de vos vertus. »"
                                            },
                                            {
                                                "example_id": "c95720ce-7a73-42af-86bb-44c95c74e13f",
                                                "sense_id": "a733a2d0-1f75-3cb5-a590-67e6d7fbe175",
                                                "text": "…, et les plus jeunes chevaliers, se regardant les uns les autres, se dirent, dans le langage muet des yeux, que ses attraits étaient le meilleur sortilège qu’elle eût pu employer pour gagner le cœur de Bois-Guilbert."
                                            },
                                            {
                                                "example_id": "da20b4be-addb-4205-97d8-4e901e6255e7",
                                                "sense_id": "a733a2d0-1f75-3cb5-a590-67e6d7fbe175",
                                                "text": "Sa froideur a, pour moi, tant d’attraits, qu’elle me brûle et me glace. J'ai beau savoir qu'au fond de ce regard, tout est calcul et complaisance, où qu'il m'entraîne, je le suivrai."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "attrait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a59340-0cca-3c36-85f1-2b55c0f9decd",
                                        "entry_id": "2c4e3df3-6bc2-385f-b799-94b367ce2bb6",
                                        "glosses": [
                                            "Participe passé masculin singulier de attraire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27a4b81-0e10-427c-a4e2-ddc691123f77",
                                                "sense_id": "b8a59340-0cca-3c36-85f1-2b55c0f9decd",
                                                "text": "Ayant attrait jusqu’au guéridon central l’une des dix-huit chaises rituellement disposées en ovale, Chicotte-l’Alambic, avachi, incongrûment déboutonné, tuait le temps en face d’une bouteille de rhum presque vidée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8935e1-542f-36dd-9b62-77b02404ec93",
                                        "entry_id": "2c4e3df3-6bc2-385f-b799-94b367ce2bb6",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de attraire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3806d513-3df3-4040-93d0-d6a0dda09c58",
                        "source_entry_id": "6c278f42-7a59-303b-8bbc-970a7b9dda80",
                        "source_sense_id": "c577bd7b-9119-303e-9938-d1080490018a",
                        "target_lang_word": "sexuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05f702d1-755d-3f8e-aeaf-7897709fcc08",
                                        "entry_id": "33e30279-1fb3-3afc-8853-b35547790a71",
                                        "glosses": [
                                            "Relatif au sexe, chez l’être humain, les animaux et les plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6faa18-192c-4106-87e3-e7b7827ba366",
                                                "sense_id": "05f702d1-755d-3f8e-aeaf-7897709fcc08",
                                                "text": "Lorsque l’homosexualité intégrera la normalité, il faudra alors instituer le régime isosexuel où tous les rôles sexuels seront abolis."
                                            },
                                            {
                                                "example_id": "4a1c522b-be41-4d0f-914c-2adb58167a8e",
                                                "sense_id": "05f702d1-755d-3f8e-aeaf-7897709fcc08",
                                                "text": "Les différences sexuelles."
                                            },
                                            {
                                                "example_id": "3c5da888-f750-460b-880a-c7420d9942c7",
                                                "sense_id": "05f702d1-755d-3f8e-aeaf-7897709fcc08",
                                                "text": "Les parties sexuelles."
                                            },
                                            {
                                                "example_id": "d7e76201-495e-49d5-995e-7158e5b57568",
                                                "sense_id": "05f702d1-755d-3f8e-aeaf-7897709fcc08",
                                                "text": "Les organes sexuels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1b9c71-c2e3-3fe1-8cdd-1813a93801d0",
                                        "entry_id": "33e30279-1fb3-3afc-8853-b35547790a71",
                                        "glosses": [
                                            "Relatif à la sexualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4645891-d3a6-4730-b3e6-c519d8362e08",
                                                "sense_id": "0b1b9c71-c2e3-3fe1-8cdd-1813a93801d0",
                                                "text": "Depuis les Hervieu, les Bernstein, les Marguerite^([sic]), les Paul Adam, les Pierre Louys et leur séquelle de journalistes caudataires, prêchèrent l’émancipation sexuelle, le bris des tenailles et le culte d’Aphrodite."
                                            },
                                            {
                                                "example_id": "a1f0f7e3-b973-42e5-9fc9-cb4a7880a8b4",
                                                "sense_id": "0b1b9c71-c2e3-3fe1-8cdd-1813a93801d0",
                                                "text": "[…] où l’on découvre que les hommes préhistoriques ne jouaient pas uniquement à « Moi Tarzan, toi Jane ». Leurs pratiques sexuelles étant nettement plus variées. Homosexualité, zoophilie, masturbation…"
                                            },
                                            {
                                                "example_id": "b820f6a8-4739-4739-b300-bcfb2fc640e5",
                                                "sense_id": "0b1b9c71-c2e3-3fe1-8cdd-1813a93801d0",
                                                "text": "Il potassait à la chandelle, au gué, au gué\nDes traités de maintien sexuel, au gué, au gué."
                                            },
                                            {
                                                "example_id": "0da880cb-5e43-4d52-9f16-1b778c370669",
                                                "sense_id": "0b1b9c71-c2e3-3fe1-8cdd-1813a93801d0",
                                                "text": "Ce retour à l’honnêteté affective et sexuelle des élites françaises est un progrès probablement plus important pour notre pays que les changements et manipulations constitutionnels de l’après-guerre ou de 1958."
                                            },
                                            {
                                                "example_id": "d589f11f-1ea3-479f-a3e5-b9bc9fe093b1",
                                                "sense_id": "0b1b9c71-c2e3-3fe1-8cdd-1813a93801d0",
                                                "text": "« De toutes les aberrations sexuelles, la plus singulière est encore la chasteté », disait Remy de Gourmont.\nSes contemporains étaient de son avis. Dieu merci !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb7d5b9-d6cb-3b5a-91e0-c896d9a50932",
                                        "entry_id": "33e30279-1fb3-3afc-8853-b35547790a71",
                                        "glosses": [
                                            "Qui aime à faire l’amour ; qui provoque cet instinct chez l’autre."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de39e0fe-88fd-41cc-8c58-1a95c922fc84",
                                                "sense_id": "9fb7d5b9-d6cb-3b5a-91e0-c896d9a50932",
                                                "text": "Elle est très sexuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d353aa2-a7e8-45ef-b627-a052efc194ac",
