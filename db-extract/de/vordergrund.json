                                    }
                                ]
                            },
                            {
                                "target_word": "foreground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec28949f-9813-3323-bc40-3f940a2f406a",
                                        "entry_id": "2063f48a-a53a-332b-9594-51e7172c9043",
                                        "glosses": [
                                            "To place in the foreground (physically or metaphorically)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f75b3e5-addc-4e03-b493-049cdd3c1f46",
                                                "sense_id": "ec28949f-9813-3323-bc40-3f940a2f406a",
                                                "text": "Right from the start, The Irishman foregrounds the looming inevitability of death."
                                            },
                                            {
                                                "example_id": "f56a4f9d-4d1d-42d1-ba71-8cfd6c15554c",
                                                "sense_id": "ec28949f-9813-3323-bc40-3f940a2f406a",
                                                "text": "Things that were implicit and largely unjudged in the book, filtered through layers of stiff-upper-lip irony — Fanny’s self-pity, Linda’s obliviousness — are now foregrounded and, for the most part, rendered banal, with “Beaches”-level platitudes and sentimentality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2fe6d5f-8a40-46ff-8750-b4a84848979e",
                        "source_entry_id": "b91e965e-6960-3507-94b4-7be19f3e9269",
                        "source_sense_id": "9275b1af-58d0-3a28-b5ec-a4a3630938b0",
                        "source_sense_description": "der Teil (des Bildes), der dem Betrachter am nächsten ist",
                        "target_lang_word": "premier plan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premier plan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd988337-470d-31c8-8218-4e4ae40d252c",
                                        "entry_id": "8911b223-1fb5-3f1a-9f47-34d1ba5aba04",
                                        "glosses": [
                                            "En termes de composition, ce qui est sur le devant de la scène principale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ebf338a-7f6a-42ff-94cf-28d7a1583cca",
                                                "sense_id": "bd988337-470d-31c8-8218-4e4ae40d252c",
                                                "text": "De temps en temps, les premiers plans étaient gâtés par les toilettes de quelques ultra-élégantes de la ville ; ces dames, ayant voulu être trop Parisiennes, avaient réussi à être assez bizarres."
                                            },
                                            {
                                                "example_id": "871d521f-cc7d-432d-9737-3567d7f92809",
                                                "sense_id": "bd988337-470d-31c8-8218-4e4ae40d252c",
                                                "text": "Donc, en plaçant une chambre noire à une distance telle des premiers plans d’un paysage , qu’ils soient réfractés au foyer principal de l’objectif, on peut être assuré d’obtenir une image nette, tant de ces premiers plans que de l’horizon ."
                                            },
                                            {
                                                "example_id": "15d91206-f236-4bce-8093-675589a2ff2c",
                                                "sense_id": "bd988337-470d-31c8-8218-4e4ae40d252c",
                                                "text": "Dans le premier plan de la plage, le peintre avait su habituer les yeux à ne pas reconnaître de frontière fixe, de démarcation absolue, entre la terre et l'océan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eabb29d8-6e75-39e6-bb57-3779bfa3e12f",
                                        "entry_id": "8911b223-1fb5-3f1a-9f47-34d1ba5aba04",
                                        "glosses": [
                                            "Ce qui est le plus important, qui est mis en avant, que l’on voit en premier."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d487c871-f39c-408c-8f6a-73470f4879bc",
                                                "sense_id": "eabb29d8-6e75-39e6-bb57-3779bfa3e12f",
                                                "text": "D’autres n’ont pas ces pudeurs. A La France insoumise, par exemple, dont l’université d’été se tient à Marseille du 23 au 26 août, les intellectuels jouent un rôle de premier plan."
                                            },
                                            {
                                                "example_id": "156464d9-715c-49e6-b4e7-c4f0b120c940",
                                                "sense_id": "eabb29d8-6e75-39e6-bb57-3779bfa3e12f",
                                                "text": "Des projets repassent au premier plan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
