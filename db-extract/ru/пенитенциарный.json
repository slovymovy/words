                                                "sense_id": "2769f691-5f56-32f6-bc88-31d855c2dd6c",
                                                "text": "Po raz pierwszy twórczość osadzonych została wyeksponowana na wolności, poza murem zakładu penitencjarnego"
                                            },
                                            {
                                                "example_id": "4d718bd2-215c-4b5e-9f6e-154ec5a30dd4",
                                                "sense_id": "2769f691-5f56-32f6-bc88-31d855c2dd6c",
