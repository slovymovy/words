                                "target_senses": [
                                    {
                                        "sense_id": "2e9a4ee1-318c-3805-b506-9e735468d653",
                                        "entry_id": "0b9e3d5b-e734-3329-b30f-edfb2b5d1219",
                                        "glosses": [
                                            "niedriges Amt in der römischen Ämterlaufbahn, hauptsächlich Polizeibeamter, aber der Aufgabenbereich unterlag über die Jahrhunderte einem Wandel"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89737f99-0311-410f-a52f-02faf100f370",
                                                "sense_id": "2e9a4ee1-318c-3805-b506-9e735468d653",
                                                "text": "„Der Großvater des Kaisers Nero – er war als äußerst arrogant verschrien und gehörte als Ädil dem niederen Beamtenstand an – soll einen höher stehenden Zensor zum Ausweichen gezwungen haben. Ein Skandal!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e728d731-1e3e-4783-a729-4c383601d12a",
                        "source_entry_id": "d5d73eaf-0776-350d-8bd5-94134b307735",
                        "source_sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
