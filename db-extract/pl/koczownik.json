                    {
                        "translation_id": "b6687a55-2bb1-486f-bb5c-11b597594a6c",
                        "source_entry_id": "c408fed8-a76e-369b-a87f-9b3ca76e1460",
                        "source_sense_id": "609dec1d-5812-3b52-860e-0bc8fb91f7df",
                        "target_lang_word": "nómada",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nómada",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "06172711-7838-37bb-bc3f-cfa2cd1b9a3c",
                                        "entry_id": "d4e7b080-8c1f-3c2f-b6da-ca237943afac",
                                        "glosses": [
                                            "Aquél que está constantemente desplazándose de un lugar a otro, sin rumbo ni domicilio fijo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18dc79bb-0614-4519-816a-24cefb026802",
                                                "sense_id": "06172711-7838-37bb-bc3f-cfa2cd1b9a3c",
                                                "text": "Los cazadores paleolíticos eran nómadas porque debían seguir las huellas de la caza, si querían sobrevivir"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6ae316c-3b7c-4ab2-a5d5-a70e3667bf33",
                        "source_entry_id": "c408fed8-a76e-369b-a87f-9b3ca76e1460",
                        "source_sense_id": "609dec1d-5812-3b52-860e-0bc8fb91f7df",
                        "target_lang_word": "nomade",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomade",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2b48f220-0ce5-319b-a0ed-0ea34e9ed5ea",
                                        "entry_id": "576f8610-1971-3ef3-ace4-7b9eb3f9cfeb",
                                        "glosses": [
                                            "Mensen of bevolkingsgroepen die geen vaste woon- of verblijfplaats hebben."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c22394d-e737-4f4a-b99f-c4503665bf58",
                                                "sense_id": "2b48f220-0ce5-319b-a0ed-0ea34e9ed5ea",
                                                "text": "Stadsnomaden zijn daklozen en mensen die in grote steden soms ongebruikte terreinen kraken om daar in leegstaande gebouwen, woonwagens, caravans en in provisorische hutten en tenten te leven totdat de grond wordt opgeëist door de rechtmatige eigenaars en zij weer andere plekken moeten zoeken."
                                            },
                                            {
                                                "example_id": "ae230c46-4812-4a59-95d3-2e0896765d4c",
                                                "sense_id": "2b48f220-0ce5-319b-a0ed-0ea34e9ed5ea",
                                                "text": "Ook kwam ik een aantal ondernemers tegen die als heuse digitale nomaden hun bedrijven op afstand bestuurden."
                                            }
                                        ]
                                    }
