                        "glosses": [
                            "buis of waterweg waardoor een vloeistof of een gas kan weg stromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a240ee49-2dfa-48fc-82f6-6bb49fb8c964",
                                "sense_id": "3646bafe-7115-3ef5-b77b-d27d3681216a",
                                "text": "\"De damp die uit het afvoerkanaal opstijgt, is het ergst\", zei een moeder van twee kinderen. Ze woont aan de rand van een leerlooierij. \"Die damp is echt heel gevaarlijk. Daar gaan soms mensen aan dood.\""
                            },
                            {
                                "example_id": "a8432a13-e268-4702-8b68-85b2846a42ba",
                                "sense_id": "3646bafe-7115-3ef5-b77b-d27d3681216a",
                                "text": "De mensen wonen allemaal in dezelfde flat aan de Standerdmolen. In dat gebouw zijn vandaag werkzaamheden uitgevoerd aan een afvoerkanaal. Dat heeft waarschijnlijk de problemen veroorzaakt. De problemen zijn inmiddels verholpen, en alle bewoners kunnen weer terug naar hun woningen."
                            }
                        ]
                    }
