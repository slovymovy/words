        "de-extract.jsonl": [
            {
                "entry_id": "f7399bf6-b303-3d1c-9ade-625d46661add",
                "word": "Lent",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "46e0d4a3-94b1-3a9c-99a7-42109a06d2b9",
                        "entry_id": "f7399bf6-b303-3d1c-9ade-625d46661add",
                        "glosses": [
                            "die Fastenzeit als Vorbereitungszeit für Ostern; österliche Bußzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5816b153-c4d1-4e18-b57d-13e2c1d76da8",
                                "sense_id": "46e0d4a3-94b1-3a9c-99a7-42109a06d2b9",
                                "text": "„During Lent, many of the faithful commit to fasting or giving up certain types of luxuries as a form of penitence.“",
                                "translation": "Während der Fastenzeit verpflichten sich viele Gläubige dazu, zu fasten oder gewisse Arten von Luxus aufzugeben als eine Form von Buße."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71020f98-2029-481f-a873-fb8ec4ab9d66",
                        "source_entry_id": "f7399bf6-b303-3d1c-9ade-625d46661add",
                        "source_sense_id": "46e0d4a3-94b1-3a9c-99a7-42109a06d2b9",
                        "source_sense_description": "Christentum: die Fastenzeit als Vorbereitungszeit für Ostern; österliche Bußzeit",
                        "target_lang_word": "Fastenzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fastenzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29eb20ed-a47b-3c78-aa60-40246da9b081",
                                        "entry_id": "ed0b11ee-91e2-33c9-98fa-eefdfe338804",
                                        "glosses": [
                                            "Zeit, in der Gläubige sich des Verzehrs bestimmter Speisen und Getränke enthalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16fdcc15-5947-4440-b11a-8f68e6620d3c",
                                                "sense_id": "29eb20ed-a47b-3c78-aa60-40246da9b081",
                                                "text": "„Heute versuchen wir, die Fastenzeit mit der ganzen Familie zu verbringen.“"
                                            },
                                            {
                                                "example_id": "eb7c368d-d5ca-4c1e-8fff-2aebf2a354f2",
                                                "sense_id": "29eb20ed-a47b-3c78-aa60-40246da9b081",
                                                "text": "„Man fühlt sich hier an die Fastenzeit erinnert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06714dfb-5243-3f3c-9b6c-802e82a91523",
                                        "entry_id": "ed0b11ee-91e2-33c9-98fa-eefdfe338804",
                                        "glosses": [
                                            "die von Aschermittwoch ausgehende 40-tägige Vorbereitungszeit auf das Osterfest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2460884-35bf-489a-bfbe-01e0fcc9aef0",
                                                "sense_id": "06714dfb-5243-3f3c-9b6c-802e82a91523",
                                                "text": "Am Aschermittwoch beginnt die Fastenzeit."
                                            },
                                            {
                                                "example_id": "b125d97d-0ae7-4b51-87e7-3b8143ecd94c",
                                                "sense_id": "06714dfb-5243-3f3c-9b6c-802e82a91523",
                                                "text": "„Aber kaum irgendwo auf der Welt dauert die Fastenzeit so lange wie in der Äthiopisch-Orthodoxen Kirche.“"
                                            },
                                            {
                                                "example_id": "e232808e-e4ca-47d6-9f3d-a9a0563b9c07",
                                                "sense_id": "06714dfb-5243-3f3c-9b6c-802e82a91523",
                                                "text": "„Ich verbrachte die Fastenzeit glücklich und zufrieden mit meinen beiden Engeln, im Freundeskreis von Signor Malipiero und über dem Studium der Experimentalphysik im Kloster S. Maria della Salute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
