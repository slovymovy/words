    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "41398344-f3cc-3fb3-a23f-a5c933ed4557",
                    "sense_definition": "Initialism of <w>by the way</w>, used to introduce a new topic or add a parenthetical remark.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Btw</w>, did you remember to lock the back door?",
                            "target_lang_translations": {
                                "ru": "<w>Кстати</w>, ты не забыл запереть заднюю дверь?",
                                "zh": "<w>对了</w>，你记得锁后门了吗？"
                            }
                        },
                        {
                            "text": "I really liked that movie, and <w>btw</w>, the soundtrack was amazing too.",
                            "target_lang_translations": {
                                "ru": "Мне очень понравился этот фильм, и, <w>кстати</w>, саундтрек тоже был потрясающим.",
                                "zh": "我很喜欢那部电影，<w>顺便说一下</w>，原声带也很棒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "by the way",
                        "incidentally"
                    ],
                    "common_phrases": [
                        "oh btw",
                        "btw thanks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "text messaging and internet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от «by the way» (кстати), используемое для введения новой темы или добавления попутного замечания.",
                        "zh": "用于引入新话题或补充说明的插入语，常用于网络聊天或非正式场合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кстати",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "между прочим",
                                "target_lang_sense_clarification": "вводная фраза"
                            },
                            {
                                "target_lang_word": "кста",
                                "target_lang_sense_clarification": "сленговое сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺便说一下",
                                "target_lang_sense_clarification": "最常用的标准表达"
                            },
                            {
                                "target_lang_word": "对了",
                                "target_lang_sense_clarification": "口语中用于突然想起某事"
                            },
                            {
                                "target_lang_word": "顺便问一下",
                                "target_lang_sense_clarification": "用于引出问题"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "06a2bb73-c1c0-3112-afb5-bb49568346a3",
                    "sense_definition": "Abbreviation of <w>between</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difference <w>btw</w> the two products is negligible.",
                            "target_lang_translations": {
                                "ru": "Разница <w>между</w> двумя продуктами незначительна.",
                                "zh": "这两个产品<w>之间</w>的差异微乎其微。"
                            }
                        },
                        {
                            "text": "Please keep this conversation just <w>btw</w> us.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, пусть этот разговор останется <w>между</w> нами.",
                                "zh": "请把这次谈话的内容保密，只在我们<w>之间</w>知道就好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "between"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от «between» (между).",
                        "zh": "介词“between”的缩写，表示在两者之间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "между",
                                "target_lang_sense_clarification": "предлог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "之间",
                                "target_lang_sense_clarification": "表示位置或关系"
                            },
                            {
                                "target_lang_word": "在……之间",
                                "target_lang_sense_clarification": "用于连接两个对象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
