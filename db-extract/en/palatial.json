                    {
                        "translation_id": "3f3f07b0-a318-45a3-9a71-5944c6b91d8e",
                        "source_entry_id": "7ffb0b6a-70ed-3d59-ad2e-d1aad13c756d",
                        "source_sense_description": "on a grand scale",
                        "target_lang_word": "palastartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palastartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b9e69f-b17e-3384-869f-474467fa832d",
                                        "entry_id": "9c7d8bc4-f691-36cc-be70-da9d4bd2dcac",
                                        "glosses": [
                                            "vom Aussehen an einen Palast erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f33e0450-5d05-401a-b0b7-e8fc6c231601",
                                                "sense_id": "f1b9e69f-b17e-3384-869f-474467fa832d",
                                                "text": "„Das alte Rathaus von Amritsar ist ein palastartiger roter Sandsteinbau aus dem späten 19. Jahrhundert, eines der Architekturschmuckstücke, die von den britischen Kolonialherren in Indien hinterlassen wurden.“"
                                            },
                                            {
                                                "example_id": "38b83cfd-637c-4bd0-84f3-a24d78637374",
                                                "sense_id": "f1b9e69f-b17e-3384-869f-474467fa832d",
                                                "text": "„Diese Darstellung palastartiger Großartigkeit vermischte sich zuweilen - oder eher: wurde durch sie ersetzt - mit in kaleidoskopischer Rotation befindlichen flüchtigen Eindrücken weiter Ebenen und anmutiger Täler, hoher Berge und einladender Grotten, ausgestattet mit allen liebreizenden Attributen einer Landschaft, die meine entzückten Augen sich auszumalen vermochten, doch bestanden sie zur Gänze aus einer glühenden, ätherischen Masse, die sich gleichermaßen aus Geist und aus Materie zusammensetzte.“"
                                            },
                                            {
                                                "example_id": "0e599bdb-a25d-4191-abf9-3c3f40e15e97",
                                                "sense_id": "f1b9e69f-b17e-3384-869f-474467fa832d",
                                                "text": "„Worin bestand die Verbindung zwischen dieser schäbigen, baufälligen Fischerhütte und dem palastartigen Anwesen von Yotai Yun?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
