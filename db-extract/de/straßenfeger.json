                "senses": [
                    {
                        "sense_id": "813d57cc-21aa-3d0d-8aa6-e75bc5772e3f",
                        "entry_id": "e1a2a22a-395b-30ac-83b7-44935072ac02",
                        "glosses": [
                            "Person, deren Aufgabe die Reinigung der (öffentlichen) Straßen und Plätze ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa995c1-1977-4ee2-9baf-6574aea8ee68",
                                "sense_id": "813d57cc-21aa-3d0d-8aa6-e75bc5772e3f",
                                "text": "„Gemeinsam ist den Parias die Ausübung von Berufen, die nach hinduistischen Vorstellungen als unrein gelten (z.B. Straßenfeger, Wäscher, Lederarbeiter, Fleischer); der körperliche Kontakt mit den höheren Kasten ist ihnen daher verboten, was den Parias den Beinamen „Unberührbare„ (englisch untouchables) einbrachte.“"
                            },
                            {
                                "example_id": "80c13143-b82f-46c5-bb73-af3b28fe25df",
                                "sense_id": "813d57cc-21aa-3d0d-8aa6-e75bc5772e3f",
                                "text": "„Straßenfeger schoben den Dreck auf dem Bürgersteig mit nachlässigen Gesten zu kleinen Haufen zusammen und schaufelten sie in eine Karre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67ccf1a2-0de3-31b6-9b13-d2be78116337",
                        "entry_id": "e1a2a22a-395b-30ac-83b7-44935072ac02",
                        "glosses": [
                            "Fernsehsendung mit sehr hoher Einschaltquote"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4d29b2-00d1-48f3-885c-aa49811e8811",
                                "sense_id": "67ccf1a2-0de3-31b6-9b13-d2be78116337",
                                "text": "„Mit der Bezeichnung Straßenfeger werden seit den frühen Jahren Sendungen des Deutschen Fernsehens mit sehr hohen Einschaltquoten bezeichnet, die dafür sorgten, dass die Straßen praktisch menschenleer waren, sie also wie leer gefegt waren.“"
                            },
                            {
                                "example_id": "cd9ecb97-2abe-4098-8ada-64a9212deb36",
                                "sense_id": "67ccf1a2-0de3-31b6-9b13-d2be78116337",
                                "text": "„Die erste deutsche Science-Fiction-Serie startete 1966 und galt der ARD als „Straßenfeger“ – mit einer Einschaltquote von bis zu 56 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
