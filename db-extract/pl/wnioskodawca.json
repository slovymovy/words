                        "target_lang_word": "Antragsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antragsteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17ce6359-feea-3360-ad22-a594bf72ff48",
                                        "entry_id": "bd66e473-f376-3f52-a50c-1346bfd04ca3",
                                        "glosses": [
                                            "Person, die ein Ansuchen stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cbe1a2a-b2b6-453d-ae71-3d582f757aa5",
                                                "sense_id": "17ce6359-feea-3360-ad22-a594bf72ff48",
                                                "text": "„Den gegen den Ordnungsruf vom Antragsteller eingelegten Einspruch wies der Landtag in seiner 70. Sitzung am 31.1.2013 ohne Aussprache zurück.“"
                                            },
                                            {
                                                "example_id": "ce3227a0-ae3f-4df4-b950-f3c4ea8f2070",
                                                "sense_id": "17ce6359-feea-3360-ad22-a594bf72ff48",
                                                "text": "Es fiel eine Entscheidung zugunsten des Antragstellers."
                                            },
                                            {
                                                "example_id": "19e2a3a6-a642-454c-b145-f092dfaee06c",
                                                "sense_id": "17ce6359-feea-3360-ad22-a594bf72ff48",
                                                "text": "Der Antrag muss genaue Angaben über das Alter, den beruflichen Werdegang und die bisherige berufliche Tätigkeit des Antragstellers enthalten."
                                            },
                                            {
                                                "example_id": "97fe4211-71dc-496f-9918-f903038bdd89",
                                                "sense_id": "17ce6359-feea-3360-ad22-a594bf72ff48",
                                                "text": "„Ich ging direkt zum Bargello. Dieser vermag in Rom sehr viel, nimmt eine Reihe von Dingen auf sich und handelt sehr rasch, wenn er klar sieht und die Antragsteller keine Ausgabe scheuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
