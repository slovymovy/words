                "senses": [
                    {
                        "sense_id": "45d6d5d9-5ff3-32c2-8260-3893bdd9a390",
                        "entry_id": "9e3265a2-6c1a-3dd9-878e-b42458b0c9ac",
                        "glosses": [
                            "Robote, robot d’apparence féminine."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "64fc0abb-86c7-4fd9-bae6-7acaef149323",
                                "sense_id": "45d6d5d9-5ff3-32c2-8260-3893bdd9a390",
                                "text": "D’autres avancent au contraire qu’en permettant aux femmes de ne plus se coltiner les tâches répétitives et sources d’erreurs, les robotesses les libèrent pour un travail plus gratifiant et plus valorisant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcf71b9c-6325-4a75-b51a-5f258371d481",
                        "source_entry_id": "9e3265a2-6c1a-3dd9-878e-b42458b0c9ac",
                        "source_sense_id": "45d6d5d9-5ff3-32c2-8260-3893bdd9a390",
                        "target_lang_word": "fembot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fembot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f34c6d-9993-3ee7-b02a-74c98241d9a8",
                                        "entry_id": "0ff824cd-225d-3b0b-9fa3-51a35dff189e",
                                        "glosses": [
                                            "A robot in female or feminine form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc8ded6-ccdb-444d-b210-656c8ab0c79b",
                                                "sense_id": "b7f34c6d-9993-3ee7-b02a-74c98241d9a8",
                                                "text": "Yes, the girl is valuable. But, my fembots can do anything she can."
                                            },
                                            {
                                                "example_id": "68e003ed-f648-4035-87b4-5cd25fea5f36",
                                                "sense_id": "b7f34c6d-9993-3ee7-b02a-74c98241d9a8",
                                                "text": "Jawohl, Herr Doktor. I have created the ultimate weapon to defeat Austin Powers. Send in the fembots!"
                                            },
                                            {
                                                "example_id": "64bae42f-98d2-4ce7-8d3b-f042a1d9bf3d",
                                                "sense_id": "b7f34c6d-9993-3ee7-b02a-74c98241d9a8",
                                                "text": "The body of Eve 8, the fembot, represents both steely industrial strength and the mysteries of microelectronic circuitry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31b966eb-1f83-3261-9789-253b02cb24a1",
                                        "entry_id": "0ff824cd-225d-3b0b-9fa3-51a35dff189e",
                                        "glosses": [
                                            "A robot in female or feminine form.",
                                            "A female sexbot."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78b2b432-800e-3871-9836-09323ca8355c",
                                        "entry_id": "0ff824cd-225d-3b0b-9fa3-51a35dff189e",
                                        "glosses": [
                                            "A docile, unthinking and conformist woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "010e5a06-02cc-47ae-b31e-01f40c038bfa",
                                                "sense_id": "78b2b432-800e-3871-9836-09323ca8355c",
                                                "text": "[...] patriarchal socialization works to sap, stunt and tame this energy, leaving successfully adapted women as little more than 'fembots' or 'feminized artifacts' who have become the products and commodities of patriarchal 'necrophilic' sexual fantasy."
                                            },
                                            {
                                                "example_id": "96d93da7-d62f-4b2a-af03-5cb5be641303",
                                                "sense_id": "78b2b432-800e-3871-9836-09323ca8355c",
                                                "text": "Too many people, forgetting the discipline of love and rage, have read the \"Manifesto\" as the ramblings of a blissed-out, technobunny, fembot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d69b021-006c-4707-a4fe-d5df306b74fc",
                        "source_entry_id": "9e3265a2-6c1a-3dd9-878e-b42458b0c9ac",
                        "source_sense_id": "45d6d5d9-5ff3-32c2-8260-3893bdd9a390",
                        "target_lang_word": "robotess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robotess",
