                                "target_senses": [
                                    {
                                        "sense_id": "dac8270c-721f-3560-b5ce-de985420ec97",
                                        "entry_id": "d0ab1e39-0790-396c-85f6-aec975d6f945",
                                        "glosses": [
                                            "One who hates mankind; a misanthrope."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef3825cd-e8f7-3275-a855-45c3a2c0bc41",
                                        "entry_id": "d0ab1e39-0790-396c-85f6-aec975d6f945",
                                        "glosses": [
                                            "One who hates men or the male sex; a misandrist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6450ac58-f3b2-4b9e-a942-4475087e0177",
                                                "sense_id": "ef3825cd-e8f7-3275-a855-45c3a2c0bc41",
                                                "text": "From past experiences it seems that 99% of man hating women consider themselves feminists, but few feminists consider themselves manhaters."
                                            },
                                            {
                                                "example_id": "dbccbbd7-64d3-49d4-b4ed-8208d39384be",
                                                "sense_id": "ef3825cd-e8f7-3275-a855-45c3a2c0bc41",
                                                "text": "Julia has to make various disclaimers (feminism does not always imply lesbianism and vice-versa; she is a lesbian 'but' not a manhater) before occupying a pro-feminist stance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfdd32a1-543e-4052-819c-4867222f047e",
                        "source_entry_id": "c11d544a-03a2-3419-bea5-296d40ba8ed7",
                        "source_sense_id": "ddf0d37c-762f-3bb2-8519-2be44843b9eb",
