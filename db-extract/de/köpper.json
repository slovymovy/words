                "senses": [
                    {
                        "sense_id": "d2fa618b-83c2-379b-8b12-e197ed479af9",
                        "entry_id": "59cf1f11-e45d-3bd2-8819-c713bffb91c4",
                        "glosses": [
                            "Sprung (ins Wasser), bei dem der Absprung kopfüber erfolgt"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d5cd921c-a7e8-4a63-826c-f944f8319f22",
                                "sense_id": "d2fa618b-83c2-379b-8b12-e197ed479af9",
                                "text": "„Mein Vater traute sich im Freibad zwar keinen Köpper, nicht einmal vom Einer, aber er erlaubte fast alles, las vor und spielte jedes Spiel mit.“"
                            },
                            {
                                "example_id": "8c08ad7f-fe99-4525-a972-c2909580fda6",
                                "sense_id": "d2fa618b-83c2-379b-8b12-e197ed479af9",
                                "text": "„Nah dran an denen, die sich da vor, neben und um sie herum auf den Sitzkissen flätzen, sind auch die Figuren: Da ist der schöne Gerber (Sebastian Stert), der seinen kleinen lästigen Bruder zum Zigarettenholen schickt und versucht, die hübsche Hanna mit Köppern vom Einer zu beeindrucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
