                                    },
                                    {
                                        "sense_id": "d27431f1-4038-365c-a4ce-69b17c30d90b",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "A standardized block of metal used in a balance to measure the mass of another object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a24056ef-b0b2-3542-a14e-0027085ca063",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Importance or influence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d16c9b-5ad8-4dd2-a76e-0f7f6fc6a75d",
                                                "sense_id": "a24056ef-b0b2-3542-a14e-0027085ca063",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            },
                                            {
                                                "example_id": "c2c1bb7d-13b0-43a5-9201-22b04757201a",
                                                "sense_id": "a24056ef-b0b2-3542-a14e-0027085ca063",
                                                "text": "Another knight came to settle on the island, a man of much weight and position, on whom the Adelantados of all the island relied, and who was made a magistrate."
                                            },
                                            {
                                                "example_id": "b0f10770-063d-4e2c-bbd3-5ecbc8061d1c",
                                                "sense_id": "a24056ef-b0b2-3542-a14e-0027085ca063",
                                                "text": "\"You surely are a man of some weight around here,\" I said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af50566c-af1d-3328-a915-0efa55c4a375",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "An object, such as a weight plate or barbell, used for strength training."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7073cdda-936c-4a76-91b7-e4b6dec35229",
                                                "sense_id": "af50566c-af1d-3328-a915-0efa55c4a375",
                                                "text": "He's working out with weights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ccda82b-fdc6-3725-92d1-93cd5f27e4a1",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Viscosity rating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c52e11c-08f5-31f1-bd15-98cec00b7b50",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Mass (atomic weight, molecular weight, etc.) (in restricted circumstances)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fb609b6-7e6f-3ae4-96b6-50b9c4d18ff4",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Synonym of mass (in general circumstances)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84cf93a9-1dfc-3866-a883-98f2cb1d5bc7",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Mass (net weight, troy weight, carat weight, etc.)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79873ae6-3e36-4866-aab1-6aecc9296704",
                                                "sense_id": "84cf93a9-1dfc-3866-a883-98f2cb1d5bc7",
                                                "text": "I'm the same weight as I was ten years ago."
                                            }
                                        ]
                                    },
                                    {
