{
    "word_family": [
        "ondeugend",
        "deugd",
        "deugdelijk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff1b6afc-58c0-3541-a3c2-a45ab0e230c7",
                    "sense_definition": "Iemand, vaak een kind, die kattenkwaad uithaalt of ondeugend gedrag vertoont.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kleine <w>ondeugd</w> heeft al het snoep uit de keukenkast opgegeten.",
                            "target_lang_translations": {
                                "en": "That little <w>rascal</w> ate all the candy from the kitchen cupboard."
                            }
                        },
                        {
                            "text": "Mijn neefje is een echte <w>ondeugd</w>, maar hij bedoelt het zelden verkeerd.",
                            "target_lang_translations": {
                                "en": "My nephew is a real <w>scamp</w>, but he rarely means any harm."
                            }
                        }
                    ],
                    "synonyms": [
                        "boefje",
                        "rakker",
                        "bengel"
                    ],
                    "common_phrases": [
                        "kleine ondeugd"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone, often a child, who gets up to mischief or behaves mischievously."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rascal",
                                "target_lang_sense_clarification": "a mischievous person or child"
                            },
                            {
                                "target_lang_word": "scamp",
                                "target_lang_sense_clarification": "a cheeky or mischievous child"
                            },
                            {
                                "target_lang_word": "imp",
                                "target_lang_sense_clarification": "a small, mischievous child"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0772e4a0-2b36-36d0-9fc6-7bfd6e1a74bd",
                    "sense_definition": "Een slechte eigenschap of immorele gewoonte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Roken is een hardnekkige <w>ondeugd</w> waar velen moeilijk mee kunnen stoppen.",
                            "target_lang_translations": {
                                "en": "Smoking is a stubborn <w>vice</w> that many find hard to quit."
                            }
                        },
                        {
                            "text": "In klassieke filosofie wordt matigheid tegenover verschillende vormen van <w>ondeugd</w> geplaatst.",
                            "target_lang_translations": {
                                "en": "In classical philosophy, temperance is contrasted with various forms of <w>vice</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwaad",
                        "gebrek"
                    ],
                    "antonyms": [
                        "deugd"
                    ],
                    "common_phrases": [
                        "deugden en ondeugden"
                    ],
                    "target_lang_definitions": {
                        "en": "A bad character trait or immoral habit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vice",
                                "target_lang_sense_clarification": "an immoral habit or character flaw"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}