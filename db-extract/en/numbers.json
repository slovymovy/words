                        ],
                        "examples": [
                            {
                                "example_id": "90998da1-1171-43ad-9038-70be4ab81f11",
                                "sense_id": "41618cdb-7913-3377-9a66-f84c26f62d60",
                                "text": "Numbers of people have visited the fair."
                            },
                            {
                                "example_id": "f55c8669-faa1-4d53-9a3b-328a940cfd1c",
                                "sense_id": "41618cdb-7913-3377-9a66-f84c26f62d60",
                                "text": "Unlike fairies who could produce only a single child every twenty years, Mud People bred like rodents. Numbers would subdue even magic."
                            },
                            {
                                "example_id": "35c6941c-4d03-407d-a85a-fa8e985b83fc",
                                "sense_id": "41618cdb-7913-3377-9a66-f84c26f62d60",
                                "text": "Wrex: We didn't have the numbers to go to war. Even if we did, the genophage made sure we couldn't replenish our numbers fast enough."
                            }
                        ]
                    },
                    {
                        "sense_id": "39a6fb1c-9a50-360b-ba60-5138a1036372",
                        "entry_id": "5d0d4789-7605-3360-bcf6-9ab7ca230aae",
                        "glosses": [
                            "Ellipsis of numbers game."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis",
                            "plural",
                            "plural-only",
                            "with-definite-article"
                        ],
                        "examples": [
                            {
                                "example_id": "f82edc22-580f-4c26-a73d-d00475ade338",
                                "sense_id": "39a6fb1c-9a50-360b-ba60-5138a1036372",
                                "text": "Her aunt played the numbers every day for years."
                            }
                        ]
                    }
