    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                "word": "setdown",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b291b4a9-6253-4a97-9d70-29b678386d1e",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "tags": [
                            "plural"
                        ],
                        "form": "setdowns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "035925ed-e45e-3d89-859f-250b4d6411aa",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "glosses": [
                            "The act of setting down something or someone."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6eec98d0-787d-4be7-8531-141eaf6f8f71",
                                "sense_id": "035925ed-e45e-3d89-859f-250b4d6411aa",
                                "text": "setdown areas in a factory for materials unloaded from incoming vehicles"
                            },
                            {
                                "example_id": "b790dc95-d8f1-4041-a531-018a92ddaafe",
                                "sense_id": "035925ed-e45e-3d89-859f-250b4d6411aa",
                                "text": "The [tour] bus brought them to the next setdown point, the gravesites of John and Robert Kennedy."
                            },
                            {
                                "example_id": "f4900afd-6c01-4e1e-a515-073eb9178635",
                                "sense_id": "035925ed-e45e-3d89-859f-250b4d6411aa",
                                "text": "2003, Nancy Kerrigan and Mary Spencer, Artistry on Ice, Champaign IL: Human Kinetics, Chapter 18, p. 141,\n[…] lifts are an equal relationship, with both [figure skating] partners starting the lift, maintaining its position in the air, and executing a smooth setdown."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d78a941-6001-307d-896d-e6506250b81f",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "glosses": [
                            "The act of descending onto a surface (of an aircraft or spacecraft)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf584a14-c7b2-4e00-ade6-bdc27c0292d9",
                                "sense_id": "3d78a941-6001-307d-896d-e6506250b81f",
                                "text": "The platforms [at the rear of the spaceship] will also have legs for landing—designed to cushion the setdown and also to help level off the ship."
                            },
                            {
                                "example_id": "fd9efadd-a9a5-488d-a631-b502722f7cf0",
                                "sense_id": "3d78a941-6001-307d-896d-e6506250b81f",
                                "text": "The medic would have to hold them on hover and watch the radar for a clear setdown."
                            },
                            {
                                "example_id": "c0970b58-45fa-4b98-9973-868e0b04f015",
                                "sense_id": "3d78a941-6001-307d-896d-e6506250b81f",
                                "text": "You had almost no time, yet you autorotate at barely three hundred feet to make a perfect setdown on this flyspot. That was incredible flying."
                            }
                        ]
                    },
                    {
                        "sense_id": "e75c278a-347e-3928-b376-13b2df908b8f",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "glosses": [
                            "The humbling of a person by act or words."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e20edb34-42d0-4e34-9d28-c1175830a9ed",
                                "sense_id": "e75c278a-347e-3928-b376-13b2df908b8f",
                                "text": "Diva fell quietly asleep, and presently there were indications that she would soon be noisily asleep. Miss Mapp hoped that she would begin to snore properly, for that would be a good set-down for Lucia […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0ff89624-7550-3754-a8e3-173be7b17d8d",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "glosses": [
                            "A retort or a reproof that has a humbling effect."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f7d36b9a-d088-4d0a-bd68-0e3b17de1a05",
                                "sense_id": "0ff89624-7550-3754-a8e3-173be7b17d8d",
                                "text": "He walked here, and he walked there, fancying himself so very great! […] I wish you had been there my dear, to have given him one of your set downs."
                            },
                            {
                                "example_id": "efbcd2ec-9130-4249-9be5-5d5a9a8de789",
                                "sense_id": "0ff89624-7550-3754-a8e3-173be7b17d8d",
                                "text": "To see a family taking deck passage on the boat […] is an interesting spot in the day’s experience, especially when some patronising passenger, accustomed to “natives” in other countries, gets one of the delightful set-downs the Maori can give so effectively."
                            }
                        ]
                    },
                    {
                        "sense_id": "b417d465-15c9-3830-9115-c243c24fc97f",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "glosses": [
                            "A sit-down meal eaten by a tramp; a charitable meal provided to a tramp in the giver's home."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b7fe2806-4bdd-4e7a-8dff-3adc3c7268e9",
                                "sense_id": "b417d465-15c9-3830-9115-c243c24fc97f",
                                "text": "In Germany and England the tramps usually eat their set-downs in cheap restaurants or at lodging-houses."
                            },
                            {
                                "example_id": "b16d521b-3f43-4820-afc1-2f287072c352",
                                "sense_id": "b417d465-15c9-3830-9115-c243c24fc97f",
                                "text": "They had just finished eating, and I was taken right into the dining room—in itself a most unusual happening, for the tramp who is lucky enough to win a set-down usually receives it in the kitchen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae0f31ec-a2bd-32d6-9650-e92fadaeea6d",
                        "entry_id": "24f4c39a-83b3-3183-a809-5e618981825d",
                        "glosses": [
                            "A person’s buttocks."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "obsolete",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3873640-91e2-411e-b2ae-1bca36c0a68a",
                                "sense_id": "ae0f31ec-a2bd-32d6-9650-e92fadaeea6d",
                                "text": "“If we [boys] did get caught the watchman would take the wooden end of his hood, slap our setdowns, then give us a kick and say, ‘Get out!’ […]”"
                            }
                        ]
                    }
