                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report raised doubts about the <w>sufficiency</w> of the current safety regulations. ",
                            "target_lang_translations": {
