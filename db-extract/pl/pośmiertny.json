                        "glosses": [
                            "zrobiony po czyjejś śmierci; zachodzący po śmierci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd949b5b-4643-478b-a2b0-4b80025232b3",
                                "sense_id": "f931a986-4232-359c-9259-81cc5b045374",
                                "text": "Generał Eugeniusz Kuszko w imieniu naczelnego dowódcy WP odczytał rozkaz o odznaczeniu pośmiertnym czołowych bohaterów powstania w getcie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75544229-d710-4284-b068-b24d60fb5eea",
                        "source_entry_id": "7d5d34f9-ff09-3f0a-8339-79863f652e39",
                        "source_sense_id": "f931a986-4232-359c-9259-81cc5b045374",
                        "target_lang_word": "posthumous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posthumous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "268a77dd-3a72-3736-a935-76ca794f8304",
                                        "entry_id": "f54161b5-36d7-3916-b8c6-2e4640d66610",
                                        "glosses": [
                                            "After the death of someone."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b9d8564-f723-424f-beff-4881cb5de1de",
                                                "sense_id": "268a77dd-3a72-3736-a935-76ca794f8304",
                                                "text": "The most favorable posthumous history the stay-at-home traitor can hope for is—oblivion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcf0836-48ca-352c-ac2b-5b39e00b3728",
                                        "entry_id": "f54161b5-36d7-3916-b8c6-2e4640d66610",
                                        "glosses": [
                                            "Taking place after one's own death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d3c5a2-766b-4b23-bde7-5a955639dfaa",
                                                "sense_id": "ebcf0836-48ca-352c-ac2b-5b39e00b3728",
                                                "text": "Artists obscure during their life often receive posthumous recognition, too late for them to enjoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4206d9-69f4-3106-96c6-8cc40e67e901",
                                        "entry_id": "f54161b5-36d7-3916-b8c6-2e4640d66610",
                                        "glosses": [
                                            "In reference to a work, published after the author's death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38ca3eb7-a571-42dd-837a-a6cb0ae01612",
                                                "sense_id": "bc4206d9-69f4-3106-96c6-8cc40e67e901",
                                                "text": "His memoirs were his posthumous revenge on enemies he dared not take on alive."
                                            },
                                            {
                                                "example_id": "8084fc17-218e-4822-ae6c-90fff65d0e56",
                                                "sense_id": "bc4206d9-69f4-3106-96c6-8cc40e67e901",
                                                "text": "Eight posthumous albums have been released to date – two more than the man managed in his lifetime – often with conspiracy-baiting titles such as Still I Rise and Tupac Resurrection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e73d95-6bcb-3997-b397-320f0df10e5e",
                                        "entry_id": "f54161b5-36d7-3916-b8c6-2e4640d66610",
                                        "glosses": [
                                            "In reference to a musical opus, published or initially performed after the composer's death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5d6fd07-5a7d-31fe-8cb6-2f4d2d4db6b0",
                                        "entry_id": "f54161b5-36d7-3916-b8c6-2e4640d66610",
                                        "glosses": [
                                            "Born after the death of one's father."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789067e5-3ce6-4159-a294-8461a2b0bc3a",
                                                "sense_id": "e5d6fd07-5a7d-31fe-8cb6-2f4d2d4db6b0",
                                                "text": "Posthumous orphans never even knew their fathers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a004da6-0ff2-4616-a09a-6ba18190cf99",
                        "source_entry_id": "7d5d34f9-ff09-3f0a-8339-79863f652e39",
                        "source_sense_id": "f931a986-4232-359c-9259-81cc5b045374",
                        "target_lang_word": "posmrtný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posmrtný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea3ae98-3bfc-3294-b1cc-e3eee80215ad",
                                        "entry_id": "cce6b14b-bb00-32ad-927b-2dd416d1a29c",
                                        "glosses": [
                                            "vztahující se k době po smrti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a83e0c-8c2d-4597-b076-cb12741dacd3",
                                                "sense_id": "4ea3ae98-3bfc-3294-b1cc-e3eee80215ad",
                                                "text": "Mezi unikátní a přitom nepříliš známé poklady patří posmrtné masky slavných osobností či sbírka nemocí, které trápily naše předky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c568fc4-d6d2-4475-a97d-cd7a7c112b0c",
                        "source_entry_id": "7d5d34f9-ff09-3f0a-8339-79863f652e39",
                        "source_sense_id": "f931a986-4232-359c-9259-81cc5b045374",
                        "target_lang_word": "posthume",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posthume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60808323-afbf-356a-b747-9fb685019c1b",
                                        "entry_id": "b9169bf9-f5a4-32f1-b5ba-cbec48e5f2ae",
                                        "glosses": [
                                            "Dont la naissance a lieu après la mort de son père."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51079301-bceb-452b-858d-8a1cb6b8eaf3",
                                                "sense_id": "60808323-afbf-356a-b747-9fb685019c1b",
                                                "text": "Deux ans après elle accoucha d’une fille posthume, Blanche de France, qui fut promise le 16 juillet 1370 à Jean d’Aragon, duc de Gironde, & qui mourut l’année d’après à Beziers, en allant en Espagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7b7c00-d98b-39e8-a5c8-b818fedaeccb",
                                        "entry_id": "b9169bf9-f5a4-32f1-b5ba-cbec48e5f2ae",
                                        "glosses": [
                                            "Se dit d’une œuvre qui paraît pour la première fois après la mort de l’auteur (ou, dans le cas d'un opus de musique, qui s'interprète pour la première fois après la mort du compositeur)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a480e6aa-aa3d-4be9-a2c9-1f37f1337188",
                                                "sense_id": "6d7b7c00-d98b-39e8-a5c8-b818fedaeccb",
                                                "text": "Nous bornerons ici nos observations critiques, et en répétant que cet ouvrage posthume de Benjamin Constant ne contient pas une histoire complète, ne présente pas les idées et les faits dans leur face principale et leur racine profonde, mais plutôt en opposition et en saillie, nous nous serons complètement acquittés du devoir d’être sincères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a4bf5c6-742d-3300-abf7-b556840ab14f",
                                        "entry_id": "b9169bf9-f5a4-32f1-b5ba-cbec48e5f2ae",
                                        "glosses": [
                                            "Se dit aussi de ce qui se produit après la mort d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2ae12a-ce03-49e5-b17f-e47f63a1a011",
                                                "sense_id": "9a4bf5c6-742d-3300-abf7-b556840ab14f",
                                                "text": "Diffusée probablement d’abord en copies, la Respuesta a Sor Filotea sera publiée dans un hommage posthume à Madrid en 1700. Son grand succès se basera sur le talent de l’auteure : là encore, les revendications exprimées semblent n’avoir été ni approuvées ni critiquées et l’on n’a pas retrouvé de traduction ancienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
