    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7d32398-3ca0-3ba6-9475-57e37fd4b098",
                    "sense_definition": "Titre de civilité employé pour s'adresser poliment à un homme ou pour le désigner.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "titre_politesse",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "Bonjour <w>monsieur</w>, comment puis-je vous aider aujourd'hui ?"
                        },
                        {
                            "text": "Je vous présente <w>monsieur</w> Martin, notre nouveau professeur de français."
                        }
                    ],
                    "synonyms": [
                        "M.",
                        "m'sieur"
                    ],
                    "antonyms": [
                        "madame"
                    ],
                    "common_phrases": [
                        "bonjour monsieur",
                        "monsieur le directeur",
                        "monsieur le président"
                    ]
                },
                {
                    "sense_id": "b026417a-9cdb-3e0f-aef6-baaef930dc66",
                    "sense_definition": "Homme adulte dont on ne connaît généralement pas le nom.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a un <w>monsieur</w> à l'accueil qui demande à vous parler."
                        },
                        {
                            "text": "Ce <w>monsieur</w> a laissé son parapluie noir sur la table du restaurant."
                        }
                    ],
                    "antonyms": [
                        "dame"
                    ],
                    "common_phrases": [
                        "monsieur Tout-le-Monde"
                    ]
                },
                {
                    "sense_id": "6236435c-a9d3-33e5-b5d1-c4f6c69d5569",
                    "sense_definition": "Personne masculine remarquable par son rang, son autorité ou sa valeur morale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personnalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux professeur dévoué est un grand <w>monsieur</w> respecté par tous les habitants."
                        },
                        {
                            "text": "Par son courage et son intégrité, il a prouvé qu'il était un vrai <w>monsieur</w>."
                        }
                    ],
                    "common_phrases": [
                        "un grand monsieur"
                    ]
                },
                {
                    "sense_id": "a1ace9d8-6586-3c62-880f-a559722ff75d",
                    "sense_definition": "Personne reconnue comme spécialiste ou représentante emblématique d'un domaine précis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après vingt ans de carrière, il reste le <w>monsieur</w> météo le plus populaire de la chaîne."
                        },
                        {
                            "text": "Le ministre a désigné un <w>monsieur</w> sécurité pour coordonner les services de secours."
                        }
                    ],
                    "common_phrases": [
                        "monsieur météo"
                    ]
                },
                {
                    "sense_id": "fede2990-0244-3072-a2d3-8393fa4f33cd",
                    "sense_definition": "Maître de maison, dans le langage du personnel domestique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "titre_politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le valet annonça aux invités que <w>monsieur</w> descendrait au salon dans quelques minutes."
                        },
                        {
                            "text": "Dans cette grande demeure bourgeoise, <w>monsieur</w> prenait toujours son déjeuner à midi pile."
                        }
                    ],
                    "antonyms": [
                        "madame"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "langage domestique traditionnel"
                        }
                    ]
                },
                {
                    "sense_id": "08a6fd7d-ae76-38d2-89d5-41db4ae4d664",
                    "sense_definition": "Titre donné au frère cadet du roi sous l'Ancien Régime en France.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historique",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "À la cour de Versailles, les courtisans se pressaient chaque matin chez <w>Monsieur</w>."
                        },
                        {
                            "text": "Cette somptueuse résidence appartenait autrefois à <w>Monsieur</w>, frère puîné du souverain."
                        }
                    ],
                    "traits": [
