                ],
                "senses": [
                    {
                        "sense_id": "2c19bc95-dfc9-3d57-908b-f39975be5b20",
                        "entry_id": "de77d8f1-b493-3e65-b6f6-99ad6897c9d7",
                        "glosses": [
                            "Qui a une affinité pour les colorants neutres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ccd0c4-5e1f-44fb-a4e2-4d26951655c2",
                                "sense_id": "2c19bc95-dfc9-3d57-908b-f39975be5b20",
                                "text": "Les granulocytes neutrophiles ne vivent que pour un temps relativement bref et ont pour fonction de phagocyter les bactéries dangereuses."
                            },
                            {
                                "example_id": "797dfaf3-2c1c-4762-8c79-54d859fcb9dd",
                                "sense_id": "2c19bc95-dfc9-3d57-908b-f39975be5b20",
                                "text": "Le granulocyte neutrophile est un microphage.  ^([1])"
                            }
                        ]
                    },
                    {
                        "sense_id": "17ceac62-95c6-31fc-afb4-4a4c3068c0c2",
                        "entry_id": "de77d8f1-b493-3e65-b6f6-99ad6897c9d7",
                        "glosses": [
                            "Qualifie un végétal qui se plaît sur des sols neutres : ni acides, ni alcalins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6e06c4-0305-48aa-802a-85a3bc2fbb5a",
                                "sense_id": "17ceac62-95c6-31fc-afb4-4a4c3068c0c2",
                                "text": "La rive Est du plan d’eau présente localement une végétation neutrophile."
                            },
                            {
                                "example_id": "c89f898a-8daf-49a7-9bee-b7384b4e94cf",
                                "sense_id": "17ceac62-95c6-31fc-afb4-4a4c3068c0c2",
                                "text": "La végétation naturelle, calcicole ou neutrophile, bénéficie d’un climat doux de type tempéré océanique du fait de la proximité de l’Atlantique, et pendant la période estivale, d’un climat ensoleillé, chaud et sec, de type provençal."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6855fef-11ed-3d11-9693-7df951b5b97a",
                        "entry_id": "de77d8f1-b493-3e65-b6f6-99ad6897c9d7",
                        "glosses": [
                            "Se dit d’un noyau qui a une grande section efficace pour la capture de neutrons."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "ddbec4b6-b5e2-45e1-8735-cca88626997c",
                                "sense_id": "f6855fef-11ed-3d11-9693-7df951b5b97a",
                                "text": "Cet exemple montre que la méthode par transparence aux neutrons s’applique surtout dans le cas où l’on désire doser un corps très apte à capter les neutrons en présence d’autres éléments très peu neutrophiles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
