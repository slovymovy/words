                "senses": [
                    {
                        "sense_id": "cae996dd-e8e3-3f7b-a38b-266d0a0ed274",
                        "entry_id": "9570985e-d3dd-3b1f-91a3-396f30f3d8ba",
                        "glosses": [
                            "van boven naar beneden springen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd77b60-d8f9-405f-b015-23cf1b4e8702",
                                "sense_id": "cae996dd-e8e3-3f7b-a38b-266d0a0ed274",
                                "text": "De bestuurder van de hoogwerker kon volgens ooggetuigen op tijd van zijn voertuig afspringen en bleef ongedeerd. Hij wordt door de politie gehoord. Het is onbekend of hij ergens van verdacht wordt."
                            }
                        ]
                    },
                    {
                        "sense_id": "add08338-8aec-3e54-b71c-c0602ff62d32",
                        "entry_id": "9570985e-d3dd-3b1f-91a3-396f30f3d8ba",
                        "glosses": [
                            "ergens plotseling vanaf gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c013dd-b324-4f5b-9d1d-daa686b049c0",
                                "sense_id": "add08338-8aec-3e54-b71c-c0602ff62d32",
                                "text": "De deksel sprong van de pan af toen het water ging koken."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6d88f68-e6ac-3e9d-b29d-5c4962a939d3",
                        "entry_id": "9570985e-d3dd-3b1f-91a3-396f30f3d8ba",
                        "glosses": [
                            "plotseling afbreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749fa7b1-df69-4da0-8928-1a35b7dff4de",
                                "sense_id": "e6d88f68-e6ac-3e9d-b29d-5c4962a939d3",
                                "text": "De Grote Van Dale kent breekpunt drie betekenissen toe. Eén: ‘punt waar iets gebroken is of kan breken’. Twee: ‘(figuurlijk) punt waarop een bespreking, onderhandeling of samenwerking afspringt of kan afspringen, waarop een ontwikkeling afgebroken wordt, tot stilstand komt’. En drie: ‘breakpoint’."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8e72bc3-6df3-3c76-b126-e71166477250",
                        "entry_id": "9570985e-d3dd-3b1f-91a3-396f30f3d8ba",
                        "glosses": [
                            "raken met een wapen of projectiel zonder dat het doel beschadigd wordt"
                        ],
