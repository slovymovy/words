                ],
                "senses": [
                    {
                        "sense_id": "939b0bf4-fd62-34fa-ad68-04fc929a3262",
                        "entry_id": "9fa9a011-fee7-3e0b-a68f-60e12fd46a4b",
                        "glosses": [
                            "Anzeichen für Nachwirkungen/Langzeitfolgen von Covid-19; Weiterbestehen von Krankheitssymptomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46edf32-e45c-4ac7-b39e-a5f7508efcf4",
                                "sense_id": "939b0bf4-fd62-34fa-ad68-04fc929a3262",
                                "text": "„In welchen Fällen die Long-Covid-Symptome wieder weggehen und bei wem sie bleiben, lässt sich noch nicht beantworten.“"
                            },
                            {
                                "example_id": "2718ae0b-8418-4a6e-bef9-4c097c7d2715",
                                "sense_id": "939b0bf4-fd62-34fa-ad68-04fc929a3262",
                                "text": "„Viele Menschen zeigen noch Monate nach einer Coronainfektion mindestens ein Long-Covid-Symptom. Eine Untersuchung von 270.000 Genesenen hat nun genauere Zahlen ergeben.“"
                            },
                            {
                                "example_id": "a756cd03-4316-4cdf-81e6-1b74d58f1297",
                                "sense_id": "939b0bf4-fd62-34fa-ad68-04fc929a3262",
                                "text": "„Man würde meinen, eine Corona-Erkrankung sei beängstigend genug - eine neue Studie jedoch hat nun ein mögliches neues Long-Covid-Symptom entdeckt.“"
                            },
                            {
                                "example_id": "8aa6261e-35fe-4b23-b999-40601702132c",
                                "sense_id": "939b0bf4-fd62-34fa-ad68-04fc929a3262",
                                "text": "„Long Covid hat bei den Untersuchungen für die Zulassung der Corona-Impfstoffe noch keine Rolle gespielt. Es gibt allerdings Indizien dafür, dass Geimpfte weniger häufig Long-Covid-Symptome aufweisen als Ungeimpfte.“"
                            },
                            {
                                "example_id": "4bc20893-6e3a-4c51-bfa9-4569fa15ab51",
                                "sense_id": "939b0bf4-fd62-34fa-ad68-04fc929a3262",
                                "text": "„Auch unter den Infizierten mit milderen oder asymptomatischen Verläufen haben rund 40 Prozent mit Long-Covid-Symptomen zu kämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
