                ],
                "senses": [
                    {
                        "sense_id": "55e38c40-6711-3784-af8b-3b4f9f3af54d",
                        "entry_id": "6a2aae87-e038-3b78-8e03-d5af653dc310",
                        "glosses": [
                            "A board, having letters of the alphabet and the words yes and no; used with a planchette during a seance to \\\"communicate\\\" with spirits."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2b66b709-64b3-3252-9c88-f77aaeccc7bf",
                        "entry_id": "6a2aae87-e038-3b78-8e03-d5af653dc310",
                        "glosses": [
                            "The use of such a board to attempt to communicate with spirits."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "64f704f2-ab61-4391-82db-fe9454254b41",
                                "sense_id": "2b66b709-64b3-3252-9c88-f77aaeccc7bf",
                                "text": "Soon after the departure of my brother to the better land, our spirit-band informed us very plainly through \"Ouija,\" that it was our duty to remove to Boston in order that our children might have better educational facilities, and be admitted to the \"musical swim\" of the \"Hub of the Universe.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda5695c-b352-4cfd-9ea3-b5d875017a21",
                        "source_entry_id": "6a2aae87-e038-3b78-8e03-d5af653dc310",
                        "source_sense_description": "board",
                        "target_lang_word": "ouijabord",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouijabord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f9eab819-ab8e-3d99-97f0-b416ddc57c40",
                                        "entry_id": "f02d5504-473c-36bc-a4b5-3256745c159b",
                                        "glosses": [
                                            "plank met daarop de letters van het alfabet, de cijfers 0-9, en de woorden 'ja' en 'nee', waarmee men communiceert met geesten of het onderbewuste door middel van een planchette (een wijzer) die zich over het bord beweegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635a8e55-ef73-4eec-b618-9e0cc6766ab3",
                                                "sense_id": "f9eab819-ab8e-3d99-97f0-b416ddc57c40",
                                                "text": "Deze prequel wordt net als zijn voorganger Ouija (2014) uitgebracht rond Halloween op 31 oktober. Hij speelt zich af in 1967 en laat zien hoe een ouijabord, waarmee met de geesten van overledenen gecommuniceerd kan worden, langzaam maar zeker een gezin uit elkaar scheurt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f9aaecc-df09-4503-9cd1-9c688bbab611",
                        "source_entry_id": "6a2aae87-e038-3b78-8e03-d5af653dc310",
