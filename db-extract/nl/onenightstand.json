                                    {
                                        "sense_id": "0ea3e75a-60a1-3cf2-a651-2420e83800b3",
                                        "entry_id": "255991c2-b414-3ebf-9695-de9895dec3c3",
                                        "glosses": [
                                            "An occasion when a performer or team of them (especially in vaudeville) expects to perform at a theater for a single evening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad5ceda-4a65-41ea-aa3c-b7fa3f45f5f2",
                                                "sense_id": "0ea3e75a-60a1-3cf2-a651-2420e83800b3",
                                                "text": "Again, when the affair is over, I catch a glimpse of myself running to catch a train for our next one-night stand."
                                            },
                                            {
                                                "example_id": "ad357712-df4e-4258-8caa-ae48b5431ad4",
                                                "sense_id": "0ea3e75a-60a1-3cf2-a651-2420e83800b3",
                                                "text": "It wasn't until the third or fourth or fifth drops that I became aware of this rain that was to engulf my life. I remember the date, August 3, 1928. We were playing a one-night stand in a small town in Louisiana, Glenberry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40efeb1a-700e-35fe-b18e-120466721a1e",
                                        "entry_id": "255991c2-b414-3ebf-9695-de9895dec3c3",
                                        "glosses": [
                                            "A single sexual encounter between two individuals, where at least one of the partners has no immediate intention or expectation of establishing a longer-term sexual or romantic relationship."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdedba9e-17db-4d9c-a32d-2e0d86db8c4f",
                                                "sense_id": "40efeb1a-700e-35fe-b18e-120466721a1e",
                                                "text": "Near-synonyms: hit and run; pump and dump; wham, bam, thank you ma'am"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfd88bcb-9e97-35fe-b01d-8c72bf7efc65",
                                        "entry_id": "255991c2-b414-3ebf-9695-de9895dec3c3",
                                        "glosses": [
                                            "Either of the two partners involved in such a single sexual encounter."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b59b54-36d3-42d0-9c07-14db48daf23e",
                                                "sense_id": "cfd88bcb-9e97-35fe-b01d-8c72bf7efc65",
                                                "text": "Chet's mom was never home. She always went out gambling, partying and staying overnight with one of her sugar daddies. Chet never met his father. He was just a one-night stand she'd had eighteen years ago."
                                            },
                                            {
                                                "example_id": "fe9a7bc6-394e-4f4b-ad72-2d129dc74ef3",
                                                "sense_id": "cfd88bcb-9e97-35fe-b01d-8c72bf7efc65",
                                                "text": "She was a one-night stand he'd met at the gym, and Herschel couldn't remember her name."
                                            },
                                            {
                                                "example_id": "67c564af-b026-4147-bd39-c0f776a4639d",
                                                "sense_id": "cfd88bcb-9e97-35fe-b01d-8c72bf7efc65",
                                                "text": "“So she was just a one-night stand like all the rest?”"
                                            }
                                        ]
                                    }
                                ]
