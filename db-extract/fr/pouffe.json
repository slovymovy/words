            {
                "entry_id": "9b53a14a-7f23-3236-9457-4fb10047a304",
                "word": "pouffe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6313103b-ee6c-4064-a6b1-cef3c01aee2b",
                        "entry_id": "9b53a14a-7f23-3236-9457-4fb10047a304",
                        "tags": [
