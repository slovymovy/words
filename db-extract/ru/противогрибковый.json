                "senses": [
                    {
                        "sense_id": "b736509f-cd7f-3bd7-8ae8-185e18632b5b",
                        "entry_id": "583cdd63-b204-3e6c-8ab8-28977e1dc8b2",
                        "glosses": [
                            "предназначенный для лечения грибковых заболеваний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa826c8-31ed-4cf3-ae23-61d0001248dd",
                                "sense_id": "b736509f-cd7f-3bd7-8ae8-185e18632b5b",
                                "text": "Антибиотический комплекс Act. hygroscopicus (Цыганов и др., 1967) может включать до трех противогрибковых антибиотиков (в том числе гексаен) и два противобактериальных."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7ca421f-0305-4b2e-bab9-fe309a78b858",
                        "source_entry_id": "583cdd63-b204-3e6c-8ab8-28977e1dc8b2",
                        "source_sense_id": "b736509f-cd7f-3bd7-8ae8-185e18632b5b",
                        "target_lang_word": "antimykotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimykotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ecd7316-6736-3c00-9073-c2d4108c5e54",
                                        "entry_id": "d8cc96ec-9d6c-36dd-8104-9f23ee3a86c4",
                                        "glosses": [
                                            "gegen Pilze wirkend, Pilze abtötend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe72ab40-6acf-49e5-91ca-9e21c4281c69",
                                                "sense_id": "2ecd7316-6736-3c00-9073-c2d4108c5e54",
                                                "text": "„Es fand sich kein statistisch signifikanter Unterschied zwischen antimykotischen und desinfizierenden Methoden, weder bei klinischen noch bei mikrobiologischen Endpunkten.“"
                                            },
                                            {
                                                "example_id": "d2964534-13e0-40e2-ae59-79b61fa20017",
                                                "sense_id": "2ecd7316-6736-3c00-9073-c2d4108c5e54",
                                                "text": "„Propolis, auch Bienenharz, Bienenleim, Bienenkittharz, Kittharz oder Kittwachs genannt, ist eine von Bienen hergestellte harzartige Masse mit antibiotischer, antiviraler und antimykotischer Wirkung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
