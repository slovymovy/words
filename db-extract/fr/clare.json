                                ]
                            },
                            {
                                "target_word": "Clare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c14cdb09-80e7-3901-a832-c86ad537da1c",
                                        "entry_id": "e209b81a-92b2-3235-8889-0356009f9737",
                                        "glosses": [
                                            "A female given name from Latin, more often spelled Claire from the 20th century onward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f16addd-d59f-4ff6-b555-c24d9847d91c",
                                                "sense_id": "c14cdb09-80e7-3901-a832-c86ad537da1c",
                                                "text": "Yes, truly: I speak not as desiring more,\nBut rather wishing a more strict restraint\nUpon the sisterhood, the votarists of Saint Clare."
                                            },
                                            {
                                                "example_id": "98d87938-0c5d-4725-803b-827d76d9f1ed",
                                                "sense_id": "c14cdb09-80e7-3901-a832-c86ad537da1c",
                                                "text": "Following Francis' example, Clare founded an order of religious women known as the Poor Ladies of Assisi (like Francis' Poor Men), and later as the Clarissas or Poor Clares in her honor."
                                            },
                                            {
                                                "example_id": "34430197-c259-4ba7-90ee-80d1c03e1286",
                                                "sense_id": "c14cdb09-80e7-3901-a832-c86ad537da1c",
                                                "text": "\"What's your name?\"\n\"Clare Fairweather,\" she said. \"Awful, isn't it?\" and went away, hiding her mirth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09b318e0-dad3-3ca6-9898-979a543a4c7e",
                                        "entry_id": "e209b81a-92b2-3235-8889-0356009f9737",
                                        "glosses": [
