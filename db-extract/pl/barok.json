                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baroque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a96560-e413-346f-b7c5-3257dcceb951",
                                        "entry_id": "c045bb98-3163-3127-827e-c13f679fe461",
                                        "glosses": [
                                            "Qualifie l’art que l’on situe entre la Renaissance et le classicisme."
                                        ],
                                        "tags": [
                                            "Histoire de l’art"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2865e61-24f8-4dd1-b42c-11dac60d7aed",
                                                "sense_id": "f2a96560-e413-346f-b7c5-3257dcceb951",
                                                "text": "Pour Justin Taylor, plus versé dans la musique baroque, enregistrer Chopin n’est pas allé de soi."
                                            },
                                            {
                                                "example_id": "b14202ea-8bcf-4e12-b8c5-1570ec043e18",
                                                "sense_id": "f2a96560-e413-346f-b7c5-3257dcceb951",
                                                "text": "Style baroque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f698b947-5611-34f9-9683-a01a48a44d91",
                                        "entry_id": "c045bb98-3163-3127-827e-c13f679fe461",
                                        "glosses": [
                                            "Irrégulier, en parlant d’une perle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                        "entry_id": "c045bb98-3163-3127-827e-c13f679fe461",
                                        "glosses": [
                                            "Qui est d’une irrégularité bizarre au sens physique ou au sens moral."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d41e277b-e54d-48ba-ac4d-74185b231d72",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "Elle avait un accoutrement des plus baroques."
                                            },
                                            {
                                                "example_id": "d10e5426-c975-4b7d-9cd1-20c9533b211d",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "Cet homme a une figure baroque."
                                            },
                                            {
                                                "example_id": "e9cea71d-cd17-4391-a73d-8f67883ba0ab",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "Mais ferait-il campagne pour qu’on vote contre lui ? Ce serait quand même baroque."
                                            },
                                            {
                                                "example_id": "435efa05-b9b2-4aa1-8ef1-c4ad90780cf9",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "Le premier passait son chemin en respirant une fleur et l’on se rendait compte qu’il était à cent lieues de partager l’humeur baroque et déconcertante du second."
                                            },
                                            {
                                                "example_id": "d7f26785-fe2e-4da5-8024-2be484b024ff",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "La Corse est un lieu baroque au sens de sa recherche de l’irrégulier, du hors-norme, qui peut aller parfois jusqu’au hors-la-loi. Rien ne s’y fait comme ailleurs."
                                            },
                                            {
                                                "example_id": "2b5adac8-e81e-46fe-b487-13aa6c990282",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "[…] est clair que ce sont mes regards pleins de froideur qui ont allumé l’amour baroque que cette fille de si haute naissance s’avise d’avoir pour moi."
                                            },
                                            {
                                                "example_id": "7cfaaf3e-7e8f-423f-8614-9a7fa354552b",
                                                "sense_id": "c5863a83-8c0f-3b95-818d-071c7a793ce8",
                                                "text": "Décédé en 2008, [Marcel Leroux] a bâti dès les années 1990 une théorie climatique baroque, dite des « anticyclones mobiles polaires », fondée sur une interprétation erronée d’images satellites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28a8c4e-8db4-3296-b655-06bad42214f5",
                                        "entry_id": "c045bb98-3163-3127-827e-c13f679fe461",
                                        "glosses": [
                                            "Une pensée, un système, une idéologie baroque est une référence à sa complexité structurelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92553a0a-2de3-451b-b2bf-9665999eb449",
                                                "sense_id": "a28a8c4e-8db4-3296-b655-06bad42214f5",
                                                "text": "Même si le nominalisme occupait certes une place prépondérante à l’Université de Vienne, fondée en 1365, et si l’importance de la philosophie y était moindre que celle accordée à la théologie depuis la Réforme, en passant par la Contre-Réforme, puis sous l’influence dominante des Jésuites, le fait que le philosophe baroque allemand par excellence, Leibniz, conçût sa monadologie, ce chef-d'œuvre de raffinement philosophique, sur le sol viennois, porte également à réfléchir."
                                            },
                                            {
                                                "example_id": "d2dc6bfd-4242-4695-bc1e-ad8dfbc1c851",
                                                "sense_id": "a28a8c4e-8db4-3296-b655-06bad42214f5",
                                                "text": "L’ensemble que forment cette ossature très puissante, un peu paradoxale, un peu bizarre, cette charpente de l’édifice, peut-être un peu de guingois, mais en tout cas surprenante, et cette ornementation proliférante, extrêmement étrange, tarabiscotée et ramifiée, est ce qui produit l’effet propre à Malebranche, que j’appelle l’effet baroque, et donc la philosophie baroque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baroque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db1925d1-2b6a-3624-b989-59ce499cda6f",
                                        "entry_id": "7ef474ee-db17-3052-b062-fc77e2ae12df",
                                        "glosses": [
                                            "Art baroque."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "444a9ea9-cef7-47b1-b51a-10ec1a6b824b",
                                                "sense_id": "db1925d1-2b6a-3624-b989-59ce499cda6f",
                                                "text": "Dans ses paysages d’un baroque déchiqueté, les plans sont mis en miettes."
                                            },
                                            {
                                                "example_id": "a33a3658-48ec-401b-bbe7-e22eaa6b275d",
                                                "sense_id": "db1925d1-2b6a-3624-b989-59ce499cda6f",
                                                "text": "Toujours cette éternelle confusion entre le baroque et le rococo ; on dit sans cesse de l’un ce qui ne peut s’appliquer qu’à l’autre ; on refuse au vrai baroque la gravité religieuse alors qu’elle est très évidente à la chapelle de la Sorbonne ou au Val-de-Grâce ; on l’appelle frivole alors qu’il n’est frivole que dans ses œuvres les plus faibles et les plus tardives."
                                            },
                                            {
                                                "example_id": "d229b9a9-e744-4825-84ef-6afa3350be82",
                                                "sense_id": "db1925d1-2b6a-3624-b989-59ce499cda6f",
                                                "text": "Le baroque touche à tous les domaines artistiques. En littérature, cette esthétique de l'excès se reconnaît à ses développements complexes et multiples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ef3f427-e5b4-3366-8201-b47bb361a78f",
                                        "entry_id": "7ef474ee-db17-3052-b062-fc77e2ae12df",
                                        "glosses": [
                                            "Cépage donnant du raisin dont les grains sont d'un blanc rosé, de petite taille et en grappes serrées. On le nomme aussi bordelais dans les Landes."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589d198a-2db2-4a4e-9e32-2c3921fb98e7",
                                                "sense_id": "8ef3f427-e5b4-3366-8201-b47bb361a78f",
                                                "text": "Complété par le gros manseng et par un appoint de sauvignon, le baroque, cépage typique de l'appellation, compose 35 % de l'assemblage de cette cuvée or pâle restée trois mois dans le bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
