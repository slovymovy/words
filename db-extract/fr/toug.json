                        "glosses": [
                            "Étendard turc, fait dʼune demi-pique au bout de laquelle est fixée une queue-de-cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f05afe8-647a-4f70-8dea-dca656eb1fe1",
                                "sense_id": "a637212b-28a9-3cb5-9c7e-e468914ec093",
                                "text": "Au premier rang, sous le toug, un cavalier dʼimposante stature chevauchait, le bâton de commandement à la main."
                            },
                            {
                                "example_id": "4bc9fe1b-affc-4c30-8c7b-8eadd959e7b5",
                                "sense_id": "a637212b-28a9-3cb5-9c7e-e468914ec093",
                                "text": "Il renferme plusieurs trophées pris aux Turcs par le margrave Louis, époux de Sibylle-Augusta: armes, selles, chabraques, tougs, drapeaux. tapis, etc., en outre des portraits de famille, des gobelins, etc."
                            }
                        ]
