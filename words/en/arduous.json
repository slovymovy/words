    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a70f2e2-d44c-3b20-9e58-b82e164c163a",
                    "sense_definition": "Requiring a great deal of effort and endurance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team faced an <w>arduous</w> journey to reach the remote village in the mountains.",
                            "target_lang_translations": {
                                "tr": "Ekip, dağlardaki uzak köye ulaşmak için <w>zorlu</w> bir yolculukla karşı karşıya kaldı."
                            }
                        },
                        {
                            "text": "Writing a thesis is an <w>arduous</w> task that requires months of dedicated research.",
                            "target_lang_translations": {
                                "tr": "Tez yazmak, aylarca süren özverili bir araştırma gerektiren <w>çetin</w> bir iştir."
                            }
                        }
                    ],
                    "synonyms": [
                        "demanding",
                        "strenuous",
                        "laborious",
                        "onerous"
                    ],
                    "common_phrases": [
                        "arduous task",
                        "arduous journey"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok fazla çaba ve dayanıklılık gerektiren, zorlu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zor",
                                "target_lang_sense_clarification": "Sıkıntı veya güçlükle yapılan, kolay olmayan işler için kullanılır."
                            },
                            {
                                "target_lang_word": "çetin",
                                "target_lang_sense_clarification": "Üstesinden gelinmesi güç, engeli çok olan durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "Çetin, güç ve sorumluluk gerektiren durumlar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed4270b4-9f3c-3737-9efd-83c29899cdf9",
                    "sense_definition": "Difficult or exhausting to travel across.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They struggled to climb the <w>arduous</w> path leading to the summit.",
                            "target_lang_translations": {
                                "tr": "Zirveye giden <w>sarp</w> yolu tırmanmakta zorlandılar."
                            }
                        },
                        {
                            "text": "The hikers were exhausted after completing the <w>arduous</w> trek through the dense forest.",
                            "target_lang_translations": {
                                "tr": "Yürüyüşçüler, sık ormanın içinden geçen <w>zorlu</w> parkuru tamamladıktan sonra bitkin düştüler."
                            }
                        }
                    ],
                    "synonyms": [
                        "uphill",
                        "strenuous"
                    ],
                    "common_phrases": [
                        "arduous climb",
                        "arduous trail"
                    ],
                    "target_lang_definitions": {
                        "tr": "Üzerinden geçilmesi veya tırmanılması zor, yorucu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sarp",
                                "target_lang_sense_clarification": "Dik, çıkılması ve geçilmesi güç olan yerler için kullanılır."
                            },
                            {
                                "target_lang_word": "çetin",
                                "target_lang_sense_clarification": "Geçilmesi veya aşılması zor olan yollar veya koşullar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28cd6f1e-a2e8-3a7f-a4dc-8a72327009a4",
                    "sense_definition": "Burning or passionate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>arduous</w> spirit of the saint in his verses.",
                            "target_lang_translations": {
                                "tr": "Şair, dizelerinde azizin <w>tutkulu</w> ruhunu betimledi."
                            }
                        },
                        {
                            "text": "His <w>arduous</w> devotion to the cause inspired everyone around him.",
                            "target_lang_translations": {
                                "tr": "Davaya olan <w>ateşli</w> bağlılığı çevresindeki herkese ilham verdi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or poetic sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tutkulu, ateşli veya yoğun bir bağlılık içeren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tutkulu",
                                "target_lang_sense_clarification": "Güçlü bir duygu veya bağlılık içeren durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "ateşli",
                                "target_lang_sense_clarification": "Coşkulu ve yoğun bir ruh hali veya bağlılık için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}