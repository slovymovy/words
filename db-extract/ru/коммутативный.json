                        "sense_id": "95994653-3d5f-341b-826c-8ebe09bc35e9",
                        "entry_id": "1ad6fc35-84f8-30a5-8ba8-c745dd08f37d",
                        "glosses": [
                            "матем. такой, результат которого не зависит от перестановки его элементов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c73507b-50d1-4267-a001-6558135df0a3",
                                "sense_id": "95994653-3d5f-341b-826c-8ebe09bc35e9",
                                "text": "В более общем смысле действие а * b называется коммутативным, если а*b=b*a."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37926d30-8287-4fd5-861a-7e102124a14e",
                        "source_entry_id": "1ad6fc35-84f8-30a5-8ba8-c745dd08f37d",
                        "source_sense_id": "95994653-3d5f-341b-826c-8ebe09bc35e9",
                        "target_lang_word": "commutative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commutative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13be36f6-9e51-3bde-b37c-4e58e6746dcb",
                                        "entry_id": "998453c8-b6bd-3026-ba42-b847e893105b",
                                        "glosses": [
                                            "Such that the order in which the operands are taken does not affect their image under the operation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f682bbf8-19a3-400c-baca-759430515e50",
                                                "sense_id": "13be36f6-9e51-3bde-b37c-4e58e6746dcb",
                                                "text": "Addition on the real numbers is commutative because for any real numbers s,t, it is true that s#43;t#61;t#43;s."
                                            },
                                            {
                                                "example_id": "4170b67d-4b58-459d-80f0-59550a7d196e",
                                                "sense_id": "13be36f6-9e51-3bde-b37c-4e58e6746dcb",
                                                "text": "Addition and multiplication are commutative operations but subtraction and division are not."
                                            },
                                            {
                                                "example_id": "9b0cf7c1-3735-4578-b7a0-eabc87b21f0c",
                                                "sense_id": "13be36f6-9e51-3bde-b37c-4e58e6746dcb",
                                                "text": "The associativity of OR and AND is not at all obvious. It is tempting to assume that because OR and AND are commutative that they must be associative also. This is not the case, however, and some commutative Boolean operators are not associative. Examples include NAND and NOR."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5635464-6378-3fab-9470-19f0d38abe50",
                                        "entry_id": "998453c8-b6bd-3026-ba42-b847e893105b",
                                        "glosses": [
                                            "Having a commutative operation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c473a089-93e1-35c7-b246-3756d2e48346",
                                        "entry_id": "998453c8-b6bd-3026-ba42-b847e893105b",
                                        "glosses": [
                                            "Such that any two sequences of morphisms with the same initial and final positions compose to the same morphism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8da69c87-7b4e-3556-8fe4-c7d482084d00",
                                        "entry_id": "998453c8-b6bd-3026-ba42-b847e893105b",
                                        "glosses": [
                                            "Relating to exchange; interchangeable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
