                        "examples": [
                            {
                                "example_id": "96f6b9c5-3e46-4aa2-880c-d58c96539056",
                                "sense_id": "ad4b3457-7c99-319f-9e92-b7fa4a3e1607",
                                "text": "Het jongetje raakte ernstig gehandicapt na een darmoperatie. De IGZ kwam pas na drie jaar met een rapport waarin werd geconstateerd dat het ziekenhuis ernstige fouten had gemaakt. Later werd die conclusie plotseling weer ingetrokken."
                            },
                            {
                                "example_id": "6f4d79a0-6a93-4dc9-879a-1a9d4e6d2c3a",
                                "sense_id": "ad4b3457-7c99-319f-9e92-b7fa4a3e1607",
                                "text": "Zowel 2009 als in 2008 moest prins Bernhard jr. rond Koninginnedag een darmoperatie ondergaan. In 2007 ontbrak prinses Máxima doordat ze net was bevallen van prinses Ariane. Een jaar eerder kon prinses Anita door griep niet aanwezig zijn."
                            }
                        ]
