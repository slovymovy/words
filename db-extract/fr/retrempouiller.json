                "senses": [
                    {
                        "sense_id": "1f0a11b6-e7bb-3683-b838-8524af0ebbaa",
                        "entry_id": "c7c9aa07-e362-31d5-9405-927859ff02cf",
                        "glosses": [
                            "Trempouiller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596e59e0-8a7b-4555-bd8d-37f9d03a2fbb",
                                "sense_id": "1f0a11b6-e7bb-3683-b838-8524af0ebbaa",
                                "text": "Quand tu souhaites plus de couvrance il te suffit de retrempouiller le pinceau dans le boîtier et de repasser par dessus."
                            },
                            {
                                "example_id": "fd8c2243-b472-4e22-9e47-6d90e4e28d49",
                                "sense_id": "1f0a11b6-e7bb-3683-b838-8524af0ebbaa",
                                "text": "Le Mâle attache les oeufs sur son dos et retourne les retrempouiller dans l'eau régulièrement pour qu'ils restent humides."
                            },
                            {
                                "example_id": "445d77f9-4beb-4bfe-bbd4-9d1298041fbe",
                                "sense_id": "1f0a11b6-e7bb-3683-b838-8524af0ebbaa",
                                "text": "En fait, j'ai compté les 5 secondes super rapidou, et j'ai dû retrempouiller le bidule."
                            }
                        ]
                    }
