                                                "sense_id": "60f99ac3-23fe-3cf9-afcd-2fab94f06f5d",
                                                "text": "Obtenir un exécutoire."
                                            },
                                            {
                                                "example_id": "88b2c771-b15d-49a1-801b-ed8cbcc0b499",
                                                "sense_id": "60f99ac3-23fe-3cf9-afcd-2fab94f06f5d",
                                                "text": "Délivrer un exécutoire."
