                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5f3faec-87fc-3191-b89e-3c1d301606ee",
                        "entry_id": "ca7ef164-ab48-329c-9a86-d8fdd9324165",
                        "glosses": [
                            "Substance à base de tartrate double d’antimoine et de potassium utilisé comme vomitif."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2ec3aa01-f0c4-3581-910b-5392244c5316",
                        "entry_id": "ca7ef164-ab48-329c-9a86-d8fdd9324165",
                        "glosses": [
                            "Tout produit médicamenteux aux propriétés vomitives."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "47463ffd-3145-4646-b65f-68a28c3fe303",
                                "sense_id": "2ec3aa01-f0c4-3581-910b-5392244c5316",
                                "text": "Prendre un émétique."
                            },
                            {
                                "example_id": "6198df5a-3b1c-4ee2-8897-bcec4f6f448f",
                                "sense_id": "2ec3aa01-f0c4-3581-910b-5392244c5316",
                                "text": "Quand le méridional, stimulé par une espèce de fatuité, regarda le crapaud, il éprouva comme une chaleur d’émétique au creux de l’estomac en ressentant une terreur assez semblable à celle du criminel devant le gendarme."
                            },
                            {
                                "example_id": "2c1f5e07-c1a0-47bb-8713-6415d05afe6d",
                                "sense_id": "2ec3aa01-f0c4-3581-910b-5392244c5316",
                                "text": "Il faut également la convaincre d’accepter de prendre un émétique car elle en a « une furieuse peur », au point que les médecins envisagent de lui en faire prendre sans lui révéler la nature exacte du remède."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96243a73-cb57-4761-adc4-1d8bc13f632a",
                        "source_entry_id": "ca7ef164-ab48-329c-9a86-d8fdd9324165",
                        "target_lang_word": "Brechmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brechmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe5bbe6-f6ad-3826-9728-c9e224088e1b",
                                        "entry_id": "01692856-65a8-3645-b7af-2148ed6099f2",
                                        "glosses": [
                                            "Medikament, welches Erbrechen auslöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dec9cdf-ea2f-4891-a2ef-233445fb2e8a",
                                                "sense_id": "0fe5bbe6-f6ad-3826-9728-c9e224088e1b",
                                                "text": "„Die Befragung Scherfs sollte klären, welche politischen Vorgaben es 2004 zum Einsatz von Brechmitteln bei mutmaßlichen Drogendealern gab.“"
                                            },
                                            {
                                                "example_id": "c7c49594-6b5c-4584-8aa5-b40a18393b6a",
                                                "sense_id": "0fe5bbe6-f6ad-3826-9728-c9e224088e1b",
                                                "text": "„Sie lasen die Verordnungen der Ärzte und waren sehr erstaunt, daß Beruhigungsmittel manchmal aufregend, daß Brechmittel zuweilen wie Abführmittel wirken, daß ein und dasselbe Heilmittel bei verschiedenen Krankheiten hilft und daß eine Krankheit durch einander entgegengesetzte Behandlungsmethoden verschwindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b401b32-657e-4b69-9b1b-2b66946280d8",
                        "source_entry_id": "ca7ef164-ab48-329c-9a86-d8fdd9324165",
                        "target_lang_word": "braakmiddel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braakmiddel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c781ecd8-9ec1-3b5a-b3cc-fb8a5bfc100b",
                                        "entry_id": "ca2d63f8-a95e-331c-a2a1-64213dc3c9e8",
                                        "glosses": [
                                            "middel dat overgeven opwekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85481a7-7ffc-4fbd-86c6-70f7001cc57c",
                                                "sense_id": "c781ecd8-9ec1-3b5a-b3cc-fb8a5bfc100b",
                                                "text": "Nu waren ze die oude zottin van een Guichard in kamer 24 aan het ontgiften, ze kreeg een braakmiddel toegediend en haar darmen en maag werden gespoeld."
                                            },
                                            {
                                                "example_id": "8c8b972f-2684-4fcc-9dd7-e30279e4b92e",
                                                "sense_id": "c781ecd8-9ec1-3b5a-b3cc-fb8a5bfc100b",
                                                "text": "Vooral in de jaren '80, weet ze, kon ze niets goed doen. 'Liesbeth Slist' en 'Een muzikaal braakmiddel', heette ze in die tijd voor menig criticus. „Mijn zalen raakten leeg. Onverdraaglijk. Het voelde als een vernedering.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75327efe-c243-4613-a7c9-445d92297fc0",
                        "source_entry_id": "ca7ef164-ab48-329c-9a86-d8fdd9324165",
