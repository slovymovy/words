                        "glosses": [
                            "Nom vulgaire de lichens fruticuleux appartenant au genre botanique Usnea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7cdea97-1a81-4f8a-9d04-3acf7d12e3f2",
                                "sense_id": "08424fb5-2ace-3bac-bb2e-e7e70d9dfdd9",
                                "text": "Sous les vieux sapins aux branches parées d’usnée barbue, dominant leurs aïeux tombés au sol après une longue vie de lutte, il règne une sérénité réconfortante."
                            },
                            {
                                "example_id": "d6858e3a-8f24-49df-adb0-e45fcd67ad65",
                                "sense_id": "08424fb5-2ace-3bac-bb2e-e7e70d9dfdd9",
                                "text": "L’Usnée barbue […], au thalle arborescent pendant, d’un vert gris, souple à l’état humide."
                            }
                        ]
                    }
                ],
