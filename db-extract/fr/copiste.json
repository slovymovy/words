        "fr-extract.jsonl": [
            {
                "entry_id": "c5838435-6568-33c8-99de-e4f0f1d322a1",
                "word": "copiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cc64414b-1e9f-434e-83af-1e3809e9f96a",
                        "entry_id": "c5838435-6568-33c8-99de-e4f0f1d322a1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "copistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6126230-2e49-3625-91ab-49b727c373ef",
                        "entry_id": "c5838435-6568-33c8-99de-e4f0f1d322a1",
                        "glosses": [
                            "Personne qui copie, et, notamment autrefois, dont le métier était de copier des textes manuscrits, de la musique ou des œuvres d'art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80de52c-754d-4210-ba77-4c796d759c8d",
                                "sense_id": "b6126230-2e49-3625-91ab-49b727c373ef",
                                "text": "La profession des copistes était une des plus nombreuses, des plus honorées et des plus lucratives. Des librairies entretenaient des milliers de copistes, revendaient leurs copies, […]."
                            },
                            {
                                "example_id": "d6f701e1-019f-4051-a1dc-7229494fccc6",
                                "sense_id": "b6126230-2e49-3625-91ab-49b727c373ef",
                                "text": "C'est là que j'ai cherché la véritable orthographe du manuscrit original, tel qu'il fut exécuté sous les yeux de Joinville par un des clercs de sa chancellerie. C'est là que je crois avoir retrouvé sa langue, exempte de toutes les altérations qu'y ont introduites des copistes d'un autre temps et d'un autre pays."
                            },
                            {
                                "example_id": "d003d28b-f6e9-40e5-a3e2-42c666c5ae3b",
                                "sense_id": "b6126230-2e49-3625-91ab-49b727c373ef",
                                "text": "Il n’y avait guère là que les copistes, travaillant dans un profond silence, que troublaient seuls les pas errants de quelques étrangers."
                            },
                            {
                                "example_id": "d69f94e0-9111-4d27-994a-a7a3402613da",
                                "sense_id": "b6126230-2e49-3625-91ab-49b727c373ef",
                                "text": "Cette dernière disposition a pour corollaire une autre mesure interdisant aux copistes de prendre des libertés avec les manuscrits."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cd2bc7f-475c-3dbc-86fa-d5feffba76e1",
                        "entry_id": "c5838435-6568-33c8-99de-e4f0f1d322a1",
                        "glosses": [
                            "Plagiaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6400089f-2ad2-4e72-b41a-771721e9bf0c",
                                "sense_id": "1cd2bc7f-475c-3dbc-86fa-d5feffba76e1",
                                "text": "Dépourvu d’invention, il s’est fait le copiste de cet auteur, de ce peintre, etc. Un froid, un insipide copiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "25188b95-43d9-3815-9c74-a918accfb933",
                        "entry_id": "c5838435-6568-33c8-99de-e4f0f1d322a1",
                        "glosses": [
                            "Élève qui copie sur son voisin, copieur."
                        ],
                        "tags": [
                            "Mali",
                            "Belgique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "075de234-1621-4b85-8572-292efc8729aa",
                        "source_entry_id": "c5838435-6568-33c8-99de-e4f0f1d322a1",
                        "source_sense_description": "Personne dont le métier était de copier des textes manuscrits ou de la musique",
                        "target_lang_word": "Amanuensis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amanuensis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                                        "entry_id": "e0a8d7ed-3717-3c00-ae74-68fa6043926d",
                                        "glosses": [
                                            "Schreibgehilfe"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ffb539f-2970-4eb8-b11d-ca207be9b475",
                                                "sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                                                "text": "„Der Pionieraufsatz von Steven Shapin aus dem Jahr 1989, hier erstmals in deutscher Übersetzung zugänglich, lenkte die Aufmerksamkeit auf Mechaniker, Techniker, Assistenten, Familienmitglieder, Gewerbetreibende, Illustratoren, Zeichner und anderen ‚Amanuenses‘ (Handlanger, ursprünglich: Schreiber).“"
                                            },
                                            {
                                                "example_id": "f5eb9bec-27c1-4fee-af5b-1e24bc5181e4",
                                                "sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                                                "text": "„Er sucht einen Amanuensis, jemanden, dem er den Text eines Buches diktieren kann, denn bei einem Verkehrsunfall vor vier Jahren in Sri Lanka wurde ihm die linke Gesichtshälfte weggerissen und er erblindete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db5f7732-7b91-3cf1-8c03-724df9e10826",
                                        "entry_id": "e0a8d7ed-3717-3c00-ae74-68fa6043926d",
                                        "glosses": [
                                            "Sekretär, Assistent"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89bc33be-139b-40a1-985c-815a70b42865",
                                                "sense_id": "db5f7732-7b91-3cf1-8c03-724df9e10826",
                                                "text": "„Vor der ordentlichen Professur trat Mussafia im Jänner 1858 den Dienst in der kaiserlichen Hofbibliothek als Hilfsarbeiter an und stieg im Jahre 1863 zum dritten Amanuensis, im Oktober 1867 zum zweiten Amanuensis der Handschriftenabteilung auf.“"
                                            },
                                            {
                                                "example_id": "7dab44eb-49d1-4d72-952c-fc2675893e65",
                                                "sense_id": "db5f7732-7b91-3cf1-8c03-724df9e10826",
                                                "text": "„1993 hatte die Universität 487 Professoren, 605 Amanuenses und 35.050 Studierende, darunter 501 Theologen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8391ac6-6bb7-421d-b605-57a031139da6",
