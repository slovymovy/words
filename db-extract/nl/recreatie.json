                        "sense_id": "897b1a4d-fdee-3f50-9423-1aa81319af25",
                        "entry_id": "13307a86-eebd-3914-9c8e-38f36732c982",
                        "glosses": [
                            "activiteiten die de gezondheid of het moraal bevorderen door ontspanning en plezier"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
