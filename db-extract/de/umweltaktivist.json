                    {
                        "translation_id": "3fe5ebfd-b7ed-425e-b482-a7c912cdabe9",
                        "source_entry_id": "9634e4f3-14ff-396c-adbb-364ce13fe6ae",
                        "source_sense_id": "5872e7ea-c8df-35c4-a31d-100d6a6dc3b4",
                        "source_sense_description": "Person, die sich für den Umweltschutz einsetzt",
                        "target_lang_word": "environnementaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "environnementaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff3a2a60-0dbb-310b-a4f2-c9ebc60e0d7c",
                                        "entry_id": "c6e9b783-44ee-3ca8-b845-24f8e5591ffb",
                                        "glosses": [
                                            "Personne qui étudie les relations entre l’être humain et son environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd90764-d4ce-4839-b4d3-93a603ba9a3f",
                                                "sense_id": "ff3a2a60-0dbb-310b-a4f2-c9ebc60e0d7c",
                                                "text": "Henry David Thoreau (1817-1862) est considéré comme le premier environnementaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b142731e-8291-3b80-9885-3089983abf34",
                                        "entry_id": "c6e9b783-44ee-3ca8-b845-24f8e5591ffb",
                                        "glosses": [
                                            "Personne qui milite pour la préservation ou la restauration de l’environnement et le respect de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfea4110-f4aa-4e7e-9bd0-50045faab458",
                                                "sense_id": "b142731e-8291-3b80-9885-3089983abf34",
                                                "text": "Les environnementalistes, comme la majorité des scientifiques, sont unanimes sur la question du réchauffement climatique."
                                            },
                                            {
                                                "example_id": "c162c4a4-579e-4f4a-bded-dcfce8ba3736",
                                                "sense_id": "b142731e-8291-3b80-9885-3089983abf34",
                                                "text": "Wangari Maathai, environnementaliste kényane, a été lauréate du prix Nobel de la Paix en 2004."
                                            },
                                            {
                                                "example_id": "21f291a7-5f21-4926-a12a-8c4cfb96969a",
                                                "sense_id": "b142731e-8291-3b80-9885-3089983abf34",
                                                "text": "Il montre une facette étonnante de lui-même en prenant la posture de l’environnementaliste convaincu, puisqu’il décrit la manière dont les grandes agglomérations repoussent toujours plus loin les terres cultivables et crachent des fumées lourdes de pollution. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 148)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "environnementaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d90bdf44-b1fd-326a-9c5c-1e8138049ee0",
                                        "entry_id": "a8098328-b9a0-3238-9797-3c3221cec7e3",
                                        "glosses": [
                                            "Relatif à l'étude ou à la défense de l'environnement et à la protection de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c8cf7d-1b6e-416b-8205-546f7601e3b6",
                                                "sense_id": "d90bdf44-b1fd-326a-9c5c-1e8138049ee0",
                                                "text": "Connu pour ses positions antivax parfois complotistes, l’ancien avocat environnementaliste, qui mise sur un programme populiste, semble particulièrement séduire les jeunes et les indépendants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
