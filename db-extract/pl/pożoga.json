                ],
                "senses": [
                    {
                        "sense_id": "aac6d6dd-23df-3ab4-bb8e-4737ebd7bda7",
                        "entry_id": "d9a5076a-9db8-3cc3-9735-8d6258868aff",
                        "glosses": [
                            "wielki ogień szerzący się na znacznej przestrzeni, wielki pożar"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "adc6fc59-16b1-4b1c-980a-cf855728248d",
                                "sense_id": "aac6d6dd-23df-3ab4-bb8e-4737ebd7bda7",
                                "text": "Jego oddział schronił się w jeziorze, gdy flota przeprowadzała bombardowanie Bazy Gamma Jeden. W ognistej pożodze woda w jeziorze zagotowała się i wyparowała"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46a2c5c2-9fbb-46af-a04e-07ca8afdb167",
                        "source_entry_id": "d9a5076a-9db8-3cc3-9735-8d6258868aff",
                        "source_sense_id": "aac6d6dd-23df-3ab4-bb8e-4737ebd7bda7",
                        "target_lang_word": "conflagration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conflagration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ea42c1-fd93-398a-8e62-d48e7ef6c202",
                                        "entry_id": "9885dc36-84a2-318c-b22e-7c0394b028c1",
                                        "glosses": [
                                            "A large fire extending to many objects, or over a large space; a general burning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c98293-f842-45d4-8478-24dd0adc516a",
                                                "sense_id": "b7ea42c1-fd93-398a-8e62-d48e7ef6c202",
                                                "text": "It took sixty firefighters to put out the conflagration."
                                            },
                                            {
                                                "example_id": "3c7f03d1-3f0e-46aa-a1c0-40a30eb4c0b7",
                                                "sense_id": "b7ea42c1-fd93-398a-8e62-d48e7ef6c202",
                                                "text": "And back to hell his way did he take, / For the Devil thought by a slight mistake / It was general conflagration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc97334-a4e4-34ef-a76a-70ad14a0ec3f",
                                        "entry_id": "9885dc36-84a2-318c-b22e-7c0394b028c1",
                                        "glosses": [
                                            "A large-scale conflict."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6aff09a-1b77-4a13-9e11-d021c8299e65",
                                                "sense_id": "8dc97334-a4e4-34ef-a76a-70ad14a0ec3f",
                                                "text": "This was well brought out in the skillfully conducted campaigns by the various governments in appealing to the masses with their characteristic suggestible subconsciousness, stirring to the very depths the reflex consciousness of gregarious man by all sorts of direct and indirect suggestions of fear of attacks and patriotic reactions of self-defence against such attacks until the evil genie of self-preservation and fear became loose, resulting in a sweeping conflagration of a war of nations with all the horror of diseases, mutilation, and extermination of millions of human lives, over seventeen and a half millions, according to latest accounts, having perished in this world-massacre of the human race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8136c1c8-9a4b-33c6-9840-13da28e12d1c",
                                        "entry_id": "9885dc36-84a2-318c-b22e-7c0394b028c1",
                                        "glosses": [
                                            "A situation of great passion or emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c4db2c5-e4b0-43d9-87e4-ad6e9b0792c0",
                                                "sense_id": "8136c1c8-9a4b-33c6-9840-13da28e12d1c",
                                                "text": "I thought it only an amourette when you told me. It was a fire — a conflagration; subdue it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8574d245-f4a8-423f-af0f-6a480d6ebfb9",
                        "source_entry_id": "d9a5076a-9db8-3cc3-9735-8d6258868aff",
                        "source_sense_id": "aac6d6dd-23df-3ab4-bb8e-4737ebd7bda7",
                        "target_lang_word": "Feuersbrunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuersbrunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4a82f8-6df7-3839-8b1e-29aeef65ebaf",
                                        "entry_id": "33a72417-9ce7-35b6-94c7-e13f3f209f45",
                                        "glosses": [
                                            "verheerender Brand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ae3df4-596e-4148-b5f0-75596276ede5",
                                                "sense_id": "5e4a82f8-6df7-3839-8b1e-29aeef65ebaf",
                                                "text": "Elf Personen fielen einer Feuersbrunst zum Opfer."
                                            },
                                            {
                                                "example_id": "e2e8e6e4-e57a-4cd6-814e-4cbce4cb1307",
                                                "sense_id": "5e4a82f8-6df7-3839-8b1e-29aeef65ebaf",
                                                "text": "„Nachdem eine Feuersbrunst anno 1046 den alten Dom zerstört hatte, schickte sich Azelin an, hier einen neuen zu errichten.“"
                                            },
                                            {
                                                "example_id": "9bb6277b-21e4-44f7-b7ad-2c4da6d6835f",
                                                "sense_id": "5e4a82f8-6df7-3839-8b1e-29aeef65ebaf",
                                                "text": "„Nach dem 30jährigen Krieg setzten wiederkehrende Feuersbrünste dem Gemeinwesen arg zu.“"
                                            },
                                            {
                                                "example_id": "55a0e290-5f2e-4a2b-96f3-04b55d25092a",
                                                "sense_id": "5e4a82f8-6df7-3839-8b1e-29aeef65ebaf",
                                                "text": "„Wer an einer fremden Sache ohne Einwilligung des Eigentümers eine Feuersbrunst verursacht, ist mit Freiheitsstrafe von einem bis zu zehn Jahren zu bestrafen.“"
                                            },
                                            {
                                                "example_id": "27d32e16-fac0-4e61-9322-8bed11175055",
                                                "sense_id": "5e4a82f8-6df7-3839-8b1e-29aeef65ebaf",
                                                "text": "„Die gefüllten Magazine, die angenehmen Quartiere, alles ging unter in einer Feuersbrunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af1beee9-f922-49da-b931-2883f5dddeda",
                        "source_entry_id": "d9a5076a-9db8-3cc3-9735-8d6258868aff",
                        "source_sense_id": "aac6d6dd-23df-3ab4-bb8e-4737ebd7bda7",
                        "target_lang_word": "большой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "большой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3d2ae7a-11b6-365a-811b-562279b3236b",
                                        "entry_id": "227efacb-7629-38c1-a610-0c44bf5b499f",
                                        "glosses": [
                                            "имеющий крупный, значительный размер, превосходящий среднее значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "883b935b-6d80-4f06-b6da-1a3c5d0e572a",
                                                "sense_id": "f3d2ae7a-11b6-365a-811b-562279b3236b",
                                                "text": "Озёр здесь более двухсот двадцати — больших, поменьше и совсем крохотных."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97a79562-13a0-3310-9542-f234b25683d9",
                                        "entry_id": "227efacb-7629-38c1-a610-0c44bf5b499f",
                                        "glosses": [
                                            "многочисленный (о сообществе, категории и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1d009e-db0c-46d1-a349-c60367bf51e1",
                                                "sense_id": "97a79562-13a0-3310-9542-f234b25683d9",
                                                "text": "— А что, у отца-то большая семья? // «Семья-то большая, да два человека // Всего мужиков-то: отец мой да я…»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b0797e-52bb-33f1-bb1f-d398384bd06f",
                                        "entry_id": "227efacb-7629-38c1-a610-0c44bf5b499f",
                                        "glosses": [
                                            "перен. (о мастерстве кого-либо) выдающийся, замечательный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f222363-7d52-4fdf-a9bd-719c053c572b",
                                                "sense_id": "97b0797e-52bb-33f1-bb1f-d398384bd06f",
                                                "text": "Бывает, что хороший, большой артист играет в триста двадцать пятый раз роль какого-нибудь Чичикова на автопилоте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "201bf0df-633f-3129-9313-1b6ad934d018",
                                        "entry_id": "227efacb-7629-38c1-a610-0c44bf5b499f",
                                        "glosses": [
                                            "перен. (о поведении кого-либо) указывает на сильную степень привязанности, преданности данному поведению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "856a32a0-35b6-42cd-ba94-904f26b2e484",
                                                "sense_id": "201bf0df-633f-3129-9313-1b6ad934d018",
                                                "text": "Я большой любитель кинематографа, и когда количество фильмов в моей коллекцие начало исчисляться сотнями, я стал подумывать об их каталогизации."
                                            },
                                            {
                                                "example_id": "a84c26f3-16c8-40b1-b95b-38dcee27336c",
                                                "sense_id": "201bf0df-633f-3129-9313-1b6ad934d018",
                                                "text": "Как-то в Гатчине у нас появился медвежонок Маша, большая проказница, любившая переворачивать тарелки на обеденном столе лапой, очень ловко, не разбивая их."
                                            },
                                            {
                                                "example_id": "bba97b60-fb39-445e-90c2-5517caaeb4a5",
                                                "sense_id": "201bf0df-633f-3129-9313-1b6ad934d018",
                                                "text": "ирон. Мой брат — большой артист."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b4d2d4-de8f-3d04-b1a4-55fb659a9a56",
                                        "entry_id": "227efacb-7629-38c1-a610-0c44bf5b499f",
                                        "glosses": [
                                            "перен., разг. то же, что взрослый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6763164-ed35-48a4-912d-c48fff50f3ff",
                                                "sense_id": "94b4d2d4-de8f-3d04-b1a4-55fb659a9a56",
                                                "text": "Наш сын уже большой, хватит его с ложечки кормить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9406957-4eb4-32a5-90fd-61d458736ce9",
                                        "entry_id": "227efacb-7629-38c1-a610-0c44bf5b499f",
                                        "glosses": [
                                            "перен., разг. бо́льший из нескольких"
