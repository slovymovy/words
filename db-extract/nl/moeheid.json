                                            {
                                                "example_id": "206ac5d7-50be-4b4b-8466-86f5bf5a6cb8",
                                                "sense_id": "ffc4a288-eb28-3913-bf34-834b344bd38d",
                                                "text": "Dieses System warnt den Lenker eines Autos vor Ermüdung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "518370cd-c851-32f4-8388-8c1a3fe8307d",
