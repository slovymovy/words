                ],
                "senses": [
                    {
                        "sense_id": "768a9822-2226-38ff-b84d-bbcf4afe6e7c",
                        "entry_id": "4a31b121-67c1-3e3c-b50c-a18e7f5fae05",
                        "glosses": [
                            "Faire subir une immuno-précipitation à quelque chose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "613ff47f-d6fe-4bad-a29b-f405922c39b6",
                                "sense_id": "768a9822-2226-38ff-b84d-bbcf4afe6e7c",
                                "text": "Un anticorps permettant d’immuno-précipiter NRPB1 a été utilisé à partir d'extraits protéiques de plantes SPT6l+ et les différents extraits ont été analysés avec un anticorps anti-HA afin de tester la présence de protéine SPT6+."
                            },
                            {
                                "example_id": "64aabb37-5c00-43aa-879e-9b9b7f0384f0",
                                "sense_id": "768a9822-2226-38ff-b84d-bbcf4afe6e7c",
                                "text": "Les complexes anticorps/antigènes sont ensuite immuno-précipités à l’aide de billes couplées à des protéines chimériques A/G qui possèdent une forte affinité pour le fragment Fc des IgG."
                            },
                            {
                                "example_id": "2a11e540-322d-43a1-8d18-6d5d8ee1eaa3",
                                "sense_id": "768a9822-2226-38ff-b84d-bbcf4afe6e7c",
                                "text": "Il ne reconnaitra donc que l’anticorps primaire du WB et pas l’anticorps primaire utilisé pour immuno-précipiter la protéine d’intérêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1c66afa-85f7-35fe-bc4e-1c49c693010a",
