                "senses": [
                    {
                        "sense_id": "a8f018ed-deea-36cb-ab32-ffd9f4813c3c",
                        "entry_id": "2d93b201-5bb3-3617-95ef-d8ae117eaf40",
                        "glosses": [
                            "kobieta, która schlebia komuś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd64ff2-dd81-4445-ad67-3711d32ee9d0",
                                "sense_id": "a8f018ed-deea-36cb-ab32-ffd9f4813c3c",
                                "text": "Nowa pracownica okazała się jedynie pochlebczynią, która chciała zdobyć względy szefa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bac99dd-972a-4202-baa2-7e47a4cf61d9",
                        "source_entry_id": "2d93b201-5bb3-3617-95ef-d8ae117eaf40",
                        "source_sense_id": "a8f018ed-deea-36cb-ab32-ffd9f4813c3c",
                        "target_lang_word": "flatteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e266214-9628-3260-b324-10604a473d60",
                                        "entry_id": "a6d99cd9-a8c5-3bc9-8ef3-0f4414a63bc2",
                                        "glosses": [
                                            "Celle qui flatte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f526ec14-b93f-4c15-b7d2-1864969da555",
                                                "sense_id": "0e266214-9628-3260-b324-10604a473d60",
                                                "text": "N’en croyez rien, monsieur; non, je ne suis pas une flatteuse, vous en seriez convaincu si vous l’entendiez chanter; mais il ne chante jamais que pour moi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flatteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2078a437-fe55-3e54-acda-eaf42503806a",
                                        "entry_id": "90014847-833a-3b3b-9004-571231330d65",
                                        "glosses": [
                                            "Féminin singulier de flatteur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe34b0f-4def-4aa9-a9d5-3931141540e6",
                                                "sense_id": "2078a437-fe55-3e54-acda-eaf42503806a",
                                                "text": "L’occasion d’une croisade utile au grand nombre, utile à la civilisation, utile à la terre entière, — au surplus, flatteuse à l’orgueil européen (mais il me déplaît de faire appel à cet orgueil) — une occasion de croisade nous est offerte : la manquerons-nous ? Ce qui revient à dire : une occasion d’accroître nos âmes, de devenir plus hommes, de « désétioler » nos personnes, de les rendre capables de l’atmosphère éternelle, cette occasion splendide est là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23799153-c1b9-492d-ad82-b824ff6c4aa7",
                        "source_entry_id": "2d93b201-5bb3-3617-95ef-d8ae117eaf40",
                        "source_sense_id": "a8f018ed-deea-36cb-ab32-ffd9f4813c3c",
                        "target_lang_word": "Schmeichlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmeichlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6c6cf2-42b2-3dc8-bf78-3877037cc8d5",
                                        "entry_id": "7777ea95-b2b9-367a-959b-8087b58000af",
                                        "glosses": [
                                            "weibliche Person, die in übertriebener Weise jemandem Komplimente macht, Gutes über jemanden verbreitet, eventuell auch nur, um sich Wohlwollen, Zuneigung zu sichern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d389bb3-0a42-4dc1-80b6-c213a006c81a",
                                                "sense_id": "6c6c6cf2-42b2-3dc8-bf78-3877037cc8d5",
                                                "text": "Sie war der perfekte Schmeichlerin und die Männer lagen ihr zu Füßen."
                                            },
                                            {
                                                "example_id": "6b766cdd-8c2d-48ab-87aa-ca20a676679d",
                                                "sense_id": "6c6c6cf2-42b2-3dc8-bf78-3877037cc8d5",
                                                "text": "„Über der gemeinen Schmeichlerin, die ihr jetzt den Hof machte, konnte Emmy jedoch nie die üble Tyrannin vergessen, die sie so manches Mal unglücklich gemacht hatte.“"
                                            },
                                            {
                                                "example_id": "9c45491b-696f-4c96-8d4d-b284d1ba2d8d",
                                                "sense_id": "6c6c6cf2-42b2-3dc8-bf78-3877037cc8d5",
                                                "text": "„Die Hoffnung, der man so viel Gutes nachrühmt, ist im Grunde eine Schmeichlerin, die der Vernunft nur deshalb genehm ist, weil sie ein Besänftigungsmittel braucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
