                                "target_senses": [
                                    {
                                        "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                        "entry_id": "1f04e934-444c-3bcf-9472-1d3132e660a8",
                                        "glosses": [
                                            "A tool used to curl the eyelashes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a15d31e-bfd9-4b59-954b-24f6eb7c21c8",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "Curling the lashes with an eyelash curler prior to mascara application will make the eyes seem more wide open and bright."
                                            },
                                            {
                                                "example_id": "e4a3e780-2543-456e-ac39-22e56184d3cc",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "She instructs: “Then you’re going to put [the eyelash curler] down and use your phone … to search up what’s happening in China"
                                            },
                                            {
                                                "example_id": "1608ae84-1bbe-4cfb-8f79-ceffc25f68a6",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "I pick up my hairbrush, my eyelash curler, my mascara: my arsenal of weapons, my quiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
