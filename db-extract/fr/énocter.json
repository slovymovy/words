                "senses": [
                    {
                        "sense_id": "cf9236c0-4c8a-3475-945f-a0069a4d1f0e",
                        "entry_id": "e7a8e309-1ef0-3983-96df-bc20c2f32d7f",
                        "glosses": [
                            "Débarrasser le poisson du sang qu’on y voit, pour qu’il se conserve mieux."
                        ],
                        "tags": [
                            "Grande pêche"
                        ],
                        "examples": [
                            {
                                "example_id": "43e7bb03-4fb5-464a-817a-9b1030fc04ce",
                                "sense_id": "cf9236c0-4c8a-3475-945f-a0069a4d1f0e",
                                "text": "La morue, il faut la préparer, il faut l’ébréguer, il faut la décoller, il faut la trancher, il faut l'énocter, il faut la laver, il faut l’empiler, il faut la saler."
                            },
                            {
                                "example_id": "958eecd4-979d-4785-b7d6-6685015a7dd1",
                                "sense_id": "cf9236c0-4c8a-3475-945f-a0069a4d1f0e",
                                "text": "le poisson est énocté, c'est à dire qu'on lui enlève les traces de sang qui pouvaient rester dans les poches et autres parties internes du poisson."
                            }
                        ]
                    }
