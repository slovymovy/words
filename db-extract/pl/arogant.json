                "senses": [
                    {
                        "sense_id": "07bb2d2e-d583-39d4-81f6-af59e5e720eb",
                        "entry_id": "7dda491f-42be-3c05-9083-b7cb10a10780",
                        "glosses": [
                            "człowiek arogancki, zuchwały"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b652a6-b0e8-4fa4-9621-2c284438f1c1",
                                "sense_id": "07bb2d2e-d583-39d4-81f6-af59e5e720eb",
                                "text": "Ależ się z niego zrobił arogant."
                            },
                            {
                                "example_id": "6506420c-4902-45da-ad44-c307c6b0de04",
                                "sense_id": "07bb2d2e-d583-39d4-81f6-af59e5e720eb",
                                "text": "Dawniej był potulny, dziś arogant i pogardliwy […]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f26ed27c-874c-41d4-818d-d8e038c06ce8",
                        "source_entry_id": "7dda491f-42be-3c05-9083-b7cb10a10780",
                        "source_sense_id": "07bb2d2e-d583-39d4-81f6-af59e5e720eb",
                        "target_lang_word": "arrogant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b896c87e-18e7-3479-aed2-78c7af584dc5",
                                        "entry_id": "a007776a-ef3e-338b-a46a-47911d3a9277",
                                        "glosses": [
                                            "Qui montre de l’arrogance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2be4327-6e6e-42bd-a8be-b15cf6051ec9",
                                                "sense_id": "b896c87e-18e7-3479-aed2-78c7af584dc5",
                                                "text": "Ce jour là, les arrogants hérétiques avaient été broyés par l'extraordinaire machine glaouie."
                                            },
                                            {
                                                "example_id": "c59da109-2d3a-4615-b3cf-7183b496a9bd",
                                                "sense_id": "b896c87e-18e7-3479-aed2-78c7af584dc5",
                                                "text": "Richard Blakely n'est qu'un petit branleur arrogant et misogyne, et qui utilise le sexe (pas énorme, d'ailleurs) pour asseoir son pouvoir.\nRichard Blakely est une machine, un égocentrique au dernier degré, et c'est mon patron. Putain de vie !"
                                            },
                                            {
                                                "example_id": "8ca684ac-1345-4c4b-a097-731eceb67262",
                                                "sense_id": "b896c87e-18e7-3479-aed2-78c7af584dc5",
                                                "text": "Le trumpisme, marqué par le chaos, le mensonge et un refus arrogant et effronté du réel donne une connotation nettement péjorative à l’exceptionnalisme américain."
                                            },
                                            {
                                                "example_id": "0f041806-d308-4ff6-a1a6-a00d27b8ec95",
                                                "sense_id": "b896c87e-18e7-3479-aed2-78c7af584dc5",
                                                "text": "Le Beerenberg apparut fier et arrogant dans une brusque et étroite déchirure des nuées ; le blanc immaculé de son sommet éclairé par le soleil se détachait dans une auréole d’azur."
                                            },
                                            {
                                                "example_id": "5cc54425-9f7e-4c95-80de-7a9aeb6ed78b",
                                                "sense_id": "b896c87e-18e7-3479-aed2-78c7af584dc5",
                                                "text": "D’un geste large et cinégraphique, elle rejeta ses draps ; sauta hors du lit, et, s’allongeant sur un tapis ad hoc, commença les quelques mouvements qui donnent à la femme un ventre plat, des seins menus et arrogants, une taille fine, des cuisses fuselées et un postère bien ferme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arrogant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a48f6342-7f6c-34f9-8163-0c25c2bef135",
                                        "entry_id": "6359ddc0-23e8-300f-a942-c0fc2c1a9bcf",
                                        "glosses": [
                                            "Celui qui se comporte avec arrogance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016b98e4-d16c-4791-b312-939074751539",
                                                "sense_id": "a48f6342-7f6c-34f9-8163-0c25c2bef135",
                                                "text": "C’est un arrogant, un petit arrogant."
                                            },
                                            {
                                                "example_id": "3dde2b1e-8ba1-4503-966d-7aff9f7403c1",
                                                "sense_id": "a48f6342-7f6c-34f9-8163-0c25c2bef135",
                                                "text": "Le cynisme des gens de télé ajoute qu’il est payant à l’antenne d’affronter un arrogant car la sympathie du public vous est aussitôt acquise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac0a3ac-a99b-46f0-9f67-69c9f1c58852",
                        "source_entry_id": "7dda491f-42be-3c05-9083-b7cb10a10780",
                        "source_sense_id": "07bb2d2e-d583-39d4-81f6-af59e5e720eb",
                        "target_lang_word": "нахал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нахал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c90cf99-db38-3f4e-8747-b4041f6e244a",
                                        "entry_id": "0688d47d-2a9e-3c43-85aa-35b57ba487a6",
                                        "glosses": [
                                            "разг. беззастенчивый, грубо бесцеремонный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b3ae04-e1e3-426f-83a9-c84ee674eb31",
                                                "sense_id": "5c90cf99-db38-3f4e-8747-b4041f6e244a",
                                                "text": "Я не желаю разговаривать с нахалами! Извольте убираться вон!"
                                            },
                                            {
                                                "example_id": "2601f327-b01e-4910-ad41-7f086c5e7053",
                                                "sense_id": "5c90cf99-db38-3f4e-8747-b4041f6e244a",
                                                "text": "Самое большое зло нашего времени, нашей культуры, что дураку и нахалу теперь везде ход, и он чувствует себя все равно как и гений, и нет средств никаких усмирить его."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
