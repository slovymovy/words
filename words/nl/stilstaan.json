                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto moest voor het rode stoplicht <w>stilstaan</w>.",
                            "target_lang_translations": {
                                "ru": "Машина должна была <w>остановиться</w> на красный свет.",
                                "en": "The car had to <w>stop</w> for the red light.",
                                "pl": "Samochód musiał <w>zatrzymać się</w> na czerwonym świetle.",
                                "de": "Das Auto musste vor der roten Ampel <w>anhalten</w>.",
                                "fr": "La voiture a dû <w>s'arrêter</w> au feu rouge.",
                                "it": "L'auto ha dovuto <w>fermarsi</w> al semaforo rosso.",
                                "cs": "Auto muselo na červenou <w>zastavit</w>.",
                                "tr": "Araba kırmızı ışıkta <w>durmak</w> zorundaydı.",
                                "es": "El coche tuvo que <w>detenerse</w> ante el semáforo en rojo.",
                                "zh": "汽车必须在红灯前<w>停下</w>。"
                            }
                        },
                        {
                            "text": "Hij bleef even <w>stilstaan</w> om goed op de kaart te kunnen kijken.",
                            "target_lang_translations": {
                                "ru": "Он ненадолго <w>остановился</w>, чтобы хорошенько взглянуть на карту.",
                                "en": "He <w>stood still</w> for a moment to get a good look at the map.",
                                "pl": "<w>Zatrzymał się</w> na chwilę, żeby dobrze przyjrzeć się mapie.",
                                "de": "Er blieb kurz <w>stehen</w>, um gut auf die Karte schauen zu können.",
                                "fr": "Il est <w>resté immobile</w> un instant pour bien regarder la carte.",
                                "it": "Si è <w>fermato</w> un momento per guardare bene la mappa.",
                                "cs": "Na chvíli se <w>zastavil</w>, aby se mohl pořádně podívat do mapy.",
                                "tr": "Haritaya iyi bakabilmek için bir anlığına <w>durdu</w>.",
                                "es": "Se <w>quedó quieto</w> un momento para poder mirar bien el mapa.",
                                "zh": "他<w>停下</w>脚步，以便能仔细看地图。"
                            }
                        }
                    ],
                    "synonyms": [
