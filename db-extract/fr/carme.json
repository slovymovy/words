                        "cross_references": [
                            {
                                "target_word": "karmeliet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f49d0f87-fefe-3874-88a1-162d569ca526",
                                        "entry_id": "b2fb3952-6788-3adf-a9bc-a1605f363fbf",
                                        "glosses": [
                                            "bedelmonnik van de orde onzer lieve-vrouwe van den Berg Karmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ecc2bb-c230-4070-b5d2-35571d42bd45",
                                                "sense_id": "f49d0f87-fefe-3874-88a1-162d569ca526",
                                                "text": "`Namen liever zo laten dat de genoemde het begrijpt als hij geroepen wordt.` Met deze opmerking besluit Cees Nooteboom zijn bespreking (Boeken, 13.06.2008) van 101 bedevaartsplaatsen in Nederland van Charles Caspers en Peter Jan Margry. Nooteboom vindt dat de schrijvers de 16de-eeuwse karmeliet Juan de la Cruz niet Johannes van het Kruis hadden moeten noemen. In de context van de katholieke bedevaart, is de genoemde een door de Roomse kerk plechtig erkende heilige. Gelovigen mogen er daarom gerust van uitgaan dat hij in de Hemel verkeert in afwachting van de jongste dag. Om de tijd door te komen doet hij af en toe een goed woordje bij God voor hen die zijn hulp inroepen. Als de genoemde karmeliet geroepen wordt, mag je dus verwachten dat hij niet alleen reageert als dat in accentloos Castiliaans gebeurt, maar dat hij welwillend gehoor geeft aan smeekbedes in minstens al die talen waarin de paus zijn kudde jaarlijks vrolijk Pasen wenst. `Johannes van het Kruis` lijkt mij in een boek over Nederlandse bedevaartsoorden dan ook zonder meer acceptabel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937d0716-2583-3d5b-9b4a-55936534f88e",
                                        "entry_id": "b2fb3952-6788-3adf-a9bc-a1605f363fbf",
                                        "glosses": [
                                            "soort Belgisch bier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc36a93-4ba7-4966-abf5-b72a9237663b",
                                                "sense_id": "937d0716-2583-3d5b-9b4a-55936534f88e",
                                                "text": "De Belgische bierbrouwer Duvel Moortgat is afgehaakt in de strijd om zijn branchegenoot Bosteels, brouwer van onder meer Pauwel Kwak en Karmeliet. Dat meldde De Tijd donderdag op basis van ingewijden. De Belgische zakenkrant meldde eerder deze week dat ook Heineken geïnteresseerd is in overname van de Belgische brouwerij. Duvel zou de prijs die wordt gevraagd voor Bosteels te hoog vinden. Volgens de krant moet Bosteels minstens 200 miljoen euro kosten. Die prijs zou overeenkomen met vijftien keer het bedrijfsresultaat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0102f109-5efa-4183-b622-1b0e72fdeea5",
                        "source_entry_id": "4ab4dd2b-bb21-3f4b-986a-619e9ff3338a",
                        "target_lang_word": "karmelita",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karmelita",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f975312-e278-3098-a6e4-36bfddbb892a",
                                        "entry_id": "7833cc85-e125-3d0e-b052-1ab7be7d38e8",
                                        "glosses": [
                                            "zakonnik z zakonu karmelitańskiego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64efddec-b055-45e8-851d-d28eebc6dc35",
                                                "sense_id": "9f975312-e278-3098-a6e4-36bfddbb892a",
                                                "text": "Strój karmelitów składa się z tuniki z pasem koloru brązowego oraz szkaplerza i kaptura tegoż koloru."
                                            },
                                            {
                                                "example_id": "e0bb5166-7a4c-43b7-ac8e-b1116baf51a1",
                                                "sense_id": "9f975312-e278-3098-a6e4-36bfddbb892a",
                                                "text": "Rafał Kalinowski był karmelitą bosym."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
