    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "89e99809-7c6b-3522-a520-4b1aab0cfbd7",
                "word": "visage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f6e1f0dc-b5ec-4ba7-8bf0-752188e1e380",
                        "entry_id": "89e99809-7c6b-3522-a520-4b1aab0cfbd7",
