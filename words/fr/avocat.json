                },
                {
                    "sense_id": "54cf07b3-7169-3757-bb13-efd481287302",
                    "sense_definition": "Personne qui prend la défense d'une autre ou qui soutient activement une cause auprès de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soutien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a été un excellent <w>avocat</w> pour défendre notre projet devant la direction."
                        },
                        {
                            "text": "Mon frère s'est fait mon <w>avocat</w> auprès de mes parents pour cette décision."
