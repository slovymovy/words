        "nl-extract.jsonl": [
            {
                "entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                "word": "pingelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3fceb89e-51be-3ac9-a4bb-2d774c5333c7",
                        "entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                        "glosses": [
                            "te vroeg en ongecontroleerd ontbranden van een brandstof in een verbrandingsmotor"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "57f56816-0263-357b-90cd-bcdae1b2a8d4",
                        "entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                        "glosses": [
                            "slecht pianospelen, slecht gitaarspelen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "57329c5b-a666-4cda-8ef8-3d2b02f44cec",
                                "sense_id": "57f56816-0263-357b-90cd-bcdae1b2a8d4",
                                "text": "De grote sterkte van Ramkoers als muziektheater zit in de vaart waarmee het collectief nieuwe munitie opvoert. De naaimachine is nog niet uitgezongen of er passeert een rad waarin de pianist overkop gaat terwijl hij onverstoord blijft pingelen. De ­trukendoos van Bot is net groot ­genoeg om te blijven verrassen."
                            }
                        ]
                    },
                    {
                        "sense_id": "198a5d1e-de8d-3211-a483-5ad7fca411eb",
                        "entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                        "glosses": [
                            "proberen korting te krijgen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c7dbbff5-66a3-34c4-b478-e8465a035f25",
                        "entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                        "glosses": [
                            "zonder overspelen proberen een doelpunt te maken waarbij verschillende tegenstanders voorbij gespeeld moeten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8f4e00-02e8-4161-9535-db70dae7dd82",
                                "sense_id": "c7dbbff5-66a3-34c4-b478-e8465a035f25",
                                "text": "Met weemoed dacht ik terug aan de trainingen bij mijn amateurclub. Een paal met één lamp die een zee van modder bescheen. En maar glijden, pingelen, lachen. Het is niet meer van deze tijd, ik weet het heel goed. Maar dat weerhoudt je er als speler in het Nederlands elftal niet van om met plezier op zo’n blubberveld te staan."
                            }
                        ]
                    },
                    {
                        "sense_id": "a42b9461-903a-366a-9100-128e925a6b6a",
                        "entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                        "glosses": [
                            "priegelen op fijn naaiwerk"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69952823-0874-4407-8be6-4d64fe1be2e8",
                        "source_entry_id": "e802cc7f-3c93-30f5-8c7b-7d9f6859d22e",
                        "source_sense_id": "198a5d1e-de8d-3211-a483-5ad7fca411eb",
                        "source_sense_description": "(handel) proberen korting te krijgen",
                        "target_lang_word": "bargain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bargain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5159916-06ee-3916-9a58-42545abeb68a",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "An agreement between parties concerning the sale of property; or a contract by which one party binds themself to transfer the right to some property for a consideration, and the other party binds themself to receive the property and pay the consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3824b91a-93fb-47f8-9310-aaad9549c37e",
                                                "sense_id": "e5159916-06ee-3916-9a58-42545abeb68a",
                                                "text": "A contract is a bargain that is legally binding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ee9a47-2447-322e-b4a4-3abfe68c4149",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "An agreement or stipulation; mutual pledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f727c8d8-b18a-422f-b5d2-b1df12f3f962",
                                                "sense_id": "d4ee9a47-2447-322e-b4a4-3abfe68c4149",
                                                "text": "[…]And when your honors mean to solemnize\n The bargain of your faith, I do beseech you,\n Even at that time I may be married too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef394636-2cd8-3c49-b025-a5a47b403185",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "An item purchased for significantly less than the usual, or recommended, price"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "A gainful transaction; an advantageous purchase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19137c3d-b6d5-4510-8ec5-2f68c85c351b",
                                                "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                                "text": "to buy (something) at a bargain"
                                            },
                                            {
                                                "example_id": "7a5e8175-17fc-405d-aaf2-b35efbfb4a23",
                                                "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                                "text": "At that price, it’s not just a bargain, it’s a steal."
                                            },
                                            {
                                                "example_id": "238c43cc-3775-445a-8214-a9cdc909b98c",
                                                "sense_id": "0c5d6ea2-b4ae-3f26-804a-bad7dbb852a6",
                                                "text": "Thus the red damask curtains which now shut out the fog-laden, drizzling atmosphere of the Marylebone Road, had cost a mere song, and yet they might have been warranted to last another thirty years. A great bargain also had been the excellent Axminster carpet which covered the floor;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b6a9cd-30fa-3370-945b-2cd095577492",
                                        "entry_id": "78e85084-9f52-3021-9c4c-3cce33b4cf21",
                                        "glosses": [
                                            "The thing stipulated or purchased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e6e0e1-85ae-4ac2-8765-5660748dea75",
                                                "sense_id": "58b6a9cd-30fa-3370-945b-2cd095577492",
                                                "text": "If he say so, may his pernicious soul Rot half a grain a day! He lies to th' heart. She was too fond of her most filthy bargain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bargain",
                                "target_lang_code": "en",
                                "target_senses": [
