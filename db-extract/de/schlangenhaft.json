                            {
                                "example_id": "d6b1406d-1779-40e3-bf0d-88e33814b76d",
                                "sense_id": "04f98b68-fb39-325b-a394-4daf8e22996e",
                                "text": "„Nur einen Augenblick später hörte ich einen kurzen, heftigen Schrei, dann den Knall eines harten Schlages und das hysterische Kreischen eines Mädchens, vermischt mit einem schlangenhaften Zischen, dass sich mir die Haare sträubten.“"
                            },
                            {
                                "example_id": "fcc8e4ae-e28d-47be-9d44-c1032cb57df9",
                                "sense_id": "04f98b68-fb39-325b-a394-4daf8e22996e",
                                "text": "„Die Hand ihrer Mutter, die sie an der Schulter berührte und sanft schüttelte, erschien ihr schlangenhaft, die Finger hatten eine kalte Schlangenhaut und bewegten sich mit einem beinlosen Schlängeln.“"
                            },
                            {
                                "example_id": "390e4547-2ff1-4199-8e21-b94a62070704",
                                "sense_id": "04f98b68-fb39-325b-a394-4daf8e22996e",
                                "text": "„Selbst aus dieser Ferne - und der Zug war noch immer einige Kilometer von dem Krater entfernt - konnte CJ deutlich ihre Formen erkennen: geschmeidige, schlangenhafte Körper, lange schlanke Hälse und, am verblüffendsten von allem, riesige Fledermausflügel.“"
                            },
                            {
                                "example_id": "2bb8850d-addb-4454-b46e-0cbc94ffab8a",
                                "sense_id": "04f98b68-fb39-325b-a394-4daf8e22996e",
                                "text": "„Durch diese Furcht erregende Medusenmähne hindurch glitzern zwei wilde, schlangenhafte Augen und vermitteln ein starkes Gefühl von kaltem, unmenschlichem Hohn und verborgener Bedrohung...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
