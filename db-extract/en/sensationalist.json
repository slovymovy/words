                        "glosses": [
                            "Sensationalistic; tending to sensationalize; characterized by sensationalism (the use of exaggerated or lurid material in order to gain public attention)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08bd792-000e-4a2b-9dd3-7e88c281e88c",
                                "sense_id": "6c06f115-16cf-3cf9-9d2f-a3fb01dd6488",
                                "text": "Near-synonym: clickbait"
                            },
                            {
                                "example_id": "268dcf52-3edc-49ff-82e6-f4850be79b19",
                                "sense_id": "6c06f115-16cf-3cf9-9d2f-a3fb01dd6488",
                                "text": "It was a sensationalist newspaper, even by tabloid standards."
                            }
