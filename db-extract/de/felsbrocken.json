                                        "sense_id": "63176009-bb48-32f2-82cc-e5107aad408f",
                                        "entry_id": "055f5c8c-d361-3edf-982e-907ab7e16dee",
                                        "glosses": [
                                            "A large mass of stone detached from the surrounding land."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c91efbb-1ae9-3a74-89a1-fd21752cefab",
                                        "entry_id": "055f5c8c-d361-3edf-982e-907ab7e16dee",
                                        "glosses": [
                                            "A particle greater than 256 mm in diameter, following the Wentworth scale"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "685ea663-24d3-3197-9ade-7cd9ea8761b8",
                                        "entry_id": "055f5c8c-d361-3edf-982e-907ab7e16dee",
                                        "glosses": [
                                            "A large marble, in children's games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c01fbe-e41c-4bca-bc2c-6939119336c4",
                                                "sense_id": "685ea663-24d3-3197-9ade-7cd9ea8761b8",
                                                "text": "There were four sizes of marbles and we called them boulders, biggies, regulars, and teenies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e805c2c-155a-3212-a544-1c9097437f37",
                                        "entry_id": "055f5c8c-d361-3edf-982e-907ab7e16dee",
                                        "glosses": [
                                            "A session of bouldering; involvement in bouldering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "boulder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea236e93-c0da-3b14-8599-ae684a4b0a1b",
                                        "entry_id": "a9b10f42-2538-3f59-bceb-fef8fd4d529b",
                                        "glosses": [
                                            "To engage in bouldering."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208e700d-aded-417d-9d57-1d13597c62f3",
                                                "sense_id": "ea236e93-c0da-3b14-8599-ae684a4b0a1b",
                                                "text": "He bouldered a route in the same area with ease. Mitchell, 11, was hanging with the older kids in an area where bouldering nearly upside down seemed to be...."
                                            },
                                            {
                                                "example_id": "3ebff799-53eb-42fa-9a4c-11da74ea1fdf",
                                                "sense_id": "ea236e93-c0da-3b14-8599-ae684a4b0a1b",
                                                "text": "As the week unfolded, we were taught about the equipment we needed, how to tie a rope and what to wear. We learnt to balance on our feet rather than cling on with our arms and to trust our rock shoes, the moulded rubber slippers that can grip the smoothest of surfaces. We abseiled, bouldered and belayed."
                                            },
                                            {
                                                "example_id": "50f0800d-1c94-45ea-825e-7d9979ed9ffb",
                                                "sense_id": "ea236e93-c0da-3b14-8599-ae684a4b0a1b",
                                                "text": "There's even old climbing hardware in it because people bouldered on it for years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5c4858e-f87f-4bb6-b478-ee02077a040c",
                        "source_entry_id": "9c435a58-0335-30be-83d5-69f2a3146eec",
                        "source_sense_id": "1110a768-b46c-37ab-a711-f854ec8a791b",
                        "source_sense_description": "ein Stück Fels",
                        "target_lang_word": "peñasco",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peñasco",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bc197f4a-29d2-3638-8721-7b749acbf1e5",
                                        "entry_id": "2072ca9d-d8f2-3be2-8b05-b6e58f53351c",
                                        "glosses": [
                                            "Peña de gran tamaño y elevación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf4fcda-1cd9-4580-8a81-d0fa746dcde6",
                                                "sense_id": "bc197f4a-29d2-3638-8721-7b749acbf1e5",
                                                "text": "Por consolarse, escaló aquel peñasco de poco más arriba, desde donde se divisaba una doble perspectiva cuya remembranza enervó alguna vez los sueños nostálgicos de su prisión"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19f0a681-e35d-3f34-abcb-c82155e5a992",
                                        "entry_id": "2072ca9d-d8f2-3be2-8b05-b6e58f53351c",
                                        "glosses": [
                                            "Molusco marino que segrega una sustancia utilizada antiguamente en tintorería."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80aadf02-ed23-427c-a8ae-15d966ab7a2f",
                                                "sense_id": "19f0a681-e35d-3f34-abcb-c82155e5a992",
                                                "text": "Aquí se ven además en abundancia unas conchas muy espinosas y verrugosas del género murex, llamado también peñasco a causa de su estructura"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "08d288ca-4f07-3125-a344-137497b4bf73",
                                        "entry_id": "2072ca9d-d8f2-3be2-8b05-b6e58f53351c",
                                        "glosses": [
                                            "Parte del hueso temporal de los mamíferos, que tiene una gran dureza y que contiene al oído interno."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed068d7-50df-4fb3-b8e1-29c40506afbe",
                                                "sense_id": "08d288ca-4f07-3125-a344-137497b4bf73",
                                                "text": "Para la radiografía anteroposterior es ventajoso inclinar la cabeza 25° hacia atrás para eliminar de la imagen de la órbita la sombra del peñasco"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
