                    {
                        "sense_id": "02f62f72-fc94-3658-a29a-f53411deb261",
                        "entry_id": "d716a787-46ae-3afb-a2bc-871d744ba53d",
                        "glosses": [
                            "bij een bepaalde stelling of kant aansluiten , iemand of iets bevoordelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2209cbc3-5e5a-4fd8-b836-f53aabb844c1",
                                "sense_id": "02f62f72-fc94-3658-a29a-f53411deb261",
                                "text": "Die scheidsrechter is partijdig !"
                            },
                            {
                                "example_id": "aca189ea-aef1-4a69-8780-1ca07c973849",
                                "sense_id": "02f62f72-fc94-3658-a29a-f53411deb261",
                                "text": "De Amerikaanse president Trump klaagt The New York Times aan, een van de meest prestigieuze kranten van de VS. Hij eist een schadevergoeding van minstens 15 miljard dollar voor wat hij noemt partijdige berichtgeving (!)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cec9bc3-b130-426d-bf97-eedcbd4b3e2b",
                        "source_entry_id": "d716a787-46ae-3afb-a2bc-871d744ba53d",
                        "source_sense_id": "02f62f72-fc94-3658-a29a-f53411deb261",
                        "source_sense_description": "bij een bepaalde stelling of kant aansluiten",
                        "target_lang_word": "parteiisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parteiisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7542ce92-22a1-3ce7-a2d3-c1d188a07f5b",
                                        "entry_id": "e51febd1-2c90-320d-9145-730a00d284ac",
                                        "glosses": [
                                            "einseitig für eine Person oder Gruppe eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8e5bd8-f385-4a18-835c-745be80f5618",
                                                "sense_id": "7542ce92-22a1-3ce7-a2d3-c1d188a07f5b",
                                                "text": "Der Verteidiger lehnte den Richter als „parteiisch“ ab."
                                            },
                                            {
                                                "example_id": "07717dde-cdbf-46f9-b38a-e4f8ae25e8aa",
                                                "sense_id": "7542ce92-22a1-3ce7-a2d3-c1d188a07f5b",
                                                "text": "Als Deutscher bin ich bei der Frage, wo das beste Bier gebraut wird, natürlich parteiisch."
                                            },
                                            {
                                                "example_id": "d2c98280-5c13-4cd2-bd92-104778e14218",
                                                "sense_id": "7542ce92-22a1-3ce7-a2d3-c1d188a07f5b",
                                                "text": "„…die Regierung hat auch Gutachter beauftragt, die ohnehin parteiisch, weil gekauft, sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91a65424-0585-41d1-a426-54af8a499ca0",
                        "source_entry_id": "d716a787-46ae-3afb-a2bc-871d744ba53d",
                        "source_sense_id": "02f62f72-fc94-3658-a29a-f53411deb261",
