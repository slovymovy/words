                "senses": [
                    {
                        "sense_id": "e43a62a3-da5b-304b-9952-c52e2505338a",
                        "entry_id": "32eb8307-b44b-3b41-a0d5-779a1d50b863",
                        "glosses": [
                            "Surligner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4f5be9-a3b9-4bc6-bafa-e1c97a3fa568",
                                "sense_id": "e43a62a3-da5b-304b-9952-c52e2505338a",
                                "text": "Cela peut aider les étudiants s'ils sont encouragés à stabiloser en couleur les différentes étapes de leur programmation."
                            },
                            {
                                "example_id": "c2d12814-c3bd-42bd-9045-d7ef5a61ea58",
                                "sense_id": "e43a62a3-da5b-304b-9952-c52e2505338a",
                                "text": "Troisième surprise on ne peut pas stabiloser le texte, ni écrire dessus;"
                            },
                            {
                                "example_id": "c489f932-1643-4855-a719-ab960ce778f4",
                                "sense_id": "e43a62a3-da5b-304b-9952-c52e2505338a",
                                "text": "Cette bonne santé commune n'est pas arrivée si souvent qu'il faut le stabiloser."
                            }
                        ]
                    }
                ],
