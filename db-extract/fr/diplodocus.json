        "fr-extract.jsonl": [
            {
                "entry_id": "d780ef29-21c7-3077-9804-d2100a1d1ce7",
                "word": "Diplodocus",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c53c6aa1-391b-3d21-b207-1cf55a1c67e1",
                        "entry_id": "d780ef29-21c7-3077-9804-d2100a1d1ce7",
                        "glosses": [
                            "Grue ferroviaire de l’armée de terre française qui comporte deux flèches et servait à la pose de tabliers de pont provisoires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b363a7a4-8e1b-4ded-902a-5f3322581a8e",
                                "sense_id": "c53c6aa1-391b-3d21-b207-1cf55a1c67e1",
                                "text": "Le \"Diplodocus\" est né des destructions de la dernière guerre : plus de 2600 ponts de chemin de fer à reconstruire ou à réparer, représentant près de 112 km de brèches."
                            },
                            {
                                "example_id": "a6170f71-da1f-4c77-a3ab-8fdd5422c1d8",
                                "sense_id": "c53c6aa1-391b-3d21-b207-1cf55a1c67e1",
                                "text": "Jean-Paul Guimbert se lance dans le matériel roulant avec la reproduction à l’échelle du Diplodocus, engin unique classé Monument Historique."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
