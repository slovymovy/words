                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2cde4c3-cd84-3071-b3ab-e5f58e0133d6",
                                        "entry_id": "427087e3-fe3f-3cb3-b23a-c053aa8f1e02",
                                        "glosses": [
                                            "A scriptural narrative, especially a discourse of the Buddha."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59059b07-e824-4b6b-b330-f1c13459b003",
                                                "sense_id": "e2cde4c3-cd84-3071-b3ab-e5f58e0133d6",
                                                "text": "Shepard: This Code of the Justicar seems central to your life.\nSamara: It is five thousand sutras, and covers every situation one can encounter. I have memorized every word. There is only the Code."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9473303-3aa0-452d-a2d3-428ad8dc81d3",
