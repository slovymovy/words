                                                "example_id": "305b7518-16ce-4263-8e10-5c7fb2367660",
                                                "sense_id": "cbde62c2-7aaf-3edc-934b-3599a5959f66",
                                                "text": "a moral certainty"
                                            }
                                        ]
                                    },
                                    {
