                ],
                "senses": [
                    {
                        "sense_id": "01d5fded-959a-3ce9-b3b7-1b78c05c7c3b",
                        "entry_id": "efbf15a6-5b7b-30d1-b6ba-412457e67916",
                        "glosses": [
                            "Signifier plus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a11d7da-7838-41e1-b3ad-229ebabde69d",
                                "sense_id": "01d5fded-959a-3ce9-b3b7-1b78c05c7c3b",
                                "text": "La manipulation du signe relève exactement d'une paranoïa-critique : l'herméneutique doit faire sens et sursens — tout doit signifier et sur-signifier."
                            },
                            {
                                "example_id": "81517786-f620-4a9f-97f1-911a393c24c2",
                                "sense_id": "01d5fded-959a-3ce9-b3b7-1b78c05c7c3b",
                                "text": "L'aptitude spécifique de la poésie réside non seulement dans le fait de \"dire autrement\", mais aussi de \"dire plus\" : sur-signifier, et dissimuler dans le même temps."
                            }
                        ]
                    }
