                ],
                "senses": [
                    {
                        "sense_id": "8d262325-bace-3c6c-ad1c-ae642872c022",
                        "entry_id": "6069c8cc-a79b-379b-9eef-5d6825f83e9d",
                        "glosses": [
                            "związany z Wormacją, dotyczący Wormacji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "424fb53e-9ba3-418a-83fc-9eafe6727616",
                        "source_entry_id": "6069c8cc-a79b-379b-9eef-5d6825f83e9d",
                        "source_sense_id": "8d262325-bace-3c6c-ad1c-ae642872c022",
                        "target_lang_word": "Wormser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wormser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67f5385e-9853-3536-a416-a52503bc37c4",
                                        "entry_id": "6da0decf-e183-3060-94db-8641b66a745e",
                                        "glosses": [
                                            "ein Einwohner, Bewohner der Stadt Worms, eine in Worms geborene, aus Worms stammende Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f7058e-a808-4824-935d-02d18facd8c8",
                                                "sense_id": "67f5385e-9853-3536-a416-a52503bc37c4",
                                                "text": "„Aber eigentlich hatte er gar nicht den Spiegel-Chefredakteur empfangen, sondern den Landsmann, den Rheinland-Pfälzer, den Wormser. Wer ihm vertraut erschien, dem vertraute er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b22a83b-55b2-3584-8326-08c213cfe0fd",
                                        "entry_id": "6da0decf-e183-3060-94db-8641b66a745e",
                                        "glosses": [
                                            "Mehrzahl von [1] beiderlei Geschlechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06d645b3-8560-499f-a50a-31979119380c",
                                                "sense_id": "5b22a83b-55b2-3584-8326-08c213cfe0fd",
                                                "text": "„Für viele Wormser hat das Turmblasen einen festen Platz im adventlich vollgepackten Terminkalender.“"
                                            },
                                            {
                                                "example_id": "b334b7ca-7819-453e-8fd6-3e82114fbfa6",
                                                "sense_id": "5b22a83b-55b2-3584-8326-08c213cfe0fd",
                                                "text": "„Als die Mainzer von Hambach heimkehrten, geriethen ſie unterwegs zu Worms in einen rohen Pöbelaufruhr hinein; die Wormſer meinten einfach, jetzt ſei Freiheit.“"
                                            },
                                            {
                                                "example_id": "bbef81c7-74de-487f-9b78-37e907d3a6a6",
                                                "sense_id": "5b22a83b-55b2-3584-8326-08c213cfe0fd",
                                                "text": "„[…], das gab am Wasichenstein ein hartes Fechten und Funkensprühen von Helm und Schilden, da ihm die Wormser nachrückten, aber die Lieb’ und ein gut Gewissen hat den Walthari stark gemacht, daß er sie alle bestand, den König Gunther und Hagen selbst, den Grimmen.“"
                                            },
                                            {
                                                "example_id": "66618fff-10f6-4ce0-939e-b3c66846ed5b",
                                                "sense_id": "5b22a83b-55b2-3584-8326-08c213cfe0fd",
                                                "text": "„Die Wormſer klagten über die ‚unmenſchliche Fehde die Franciscus von Sickingen, unverwahrt ſeiner Ehren, wider ſie erhoben;‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wormser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0f240b8-6659-38f4-aefb-b8199c5d9a9c",
                                        "entry_id": "abe153f6-f48b-3ce3-94c2-ba71f1618036",
                                        "glosses": [
                                            "zu Worms, sich auf diesen Ort beziehend, in der Art und Weise dieses Ortes, aus Worms kommend, stammend, Worms betreffend, zu Worms gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48c3e400-0c3d-47a8-9c8f-52d099393c15",
                                                "sense_id": "b0f240b8-6659-38f4-aefb-b8199c5d9a9c",
                                                "text": "„Sehen und hören Sie Wormser Traditionslieder und -tänze, treffen Sie bekannte Gesichter aus der Wormser Fastnacht mit bunten Brauchtumsliedern und Tanzdarbietungen.“"
                                            },
                                            {
                                                "example_id": "a0fbb75f-89bb-4e22-90fa-acefad9a6ce5",
                                                "sense_id": "b0f240b8-6659-38f4-aefb-b8199c5d9a9c",
                                                "text": "„Der Tiergarten Worms liegt […] zwischen der geschichtsträchtigen Wormser Innenstadt und dem schönen Rhein.“"
                                            },
                                            {
                                                "example_id": "937f5f3d-45e5-4f83-b15f-74e97c330360",
                                                "sense_id": "b0f240b8-6659-38f4-aefb-b8199c5d9a9c",
                                                "text": "„Bischof Burchard hat an der Stelle einer Basilika aus fränkischer Zeit den Wormser Dom im 12. Jahrhundert errichten lassen.“"
                                            },
                                            {
                                                "example_id": "dae96710-90fe-4995-8e2d-13c599d7a9ed",
                                                "sense_id": "b0f240b8-6659-38f4-aefb-b8199c5d9a9c",
                                                "text": "„Aus dem 18. Jahrhundert, einer der glanzvollsten Perioden in der Geschichte Frankenthals, stammen die beiden prächtigen Stadttore, das Speyerer und das Wormser Tor. […] Das Wormser Tor, ehemals am nördlichen Rand der Stadt gelegen […], wurde 1770 bis 1772 errichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wormser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                        "entry_id": "373a9725-5fd7-338e-99b8-96836c2e81c8",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d09b2d-4af6-4964-8988-2cdac9317cff",
                                                "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                                "text": "„Welche Hand hatte ihn, den Hauslehrer bei Wormsers, diesen Jämmerling mit der geplatzten Hose, dem sicheren Rachen des Untergangs entführt, um den andern Kandidaten hineinzustoßen?“"
                                            },
                                            {
                                                "example_id": "64c02888-a6ad-422f-90b4-45e309524a7f",
                                                "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                                "text": "(Hauptmann von Schlettow zum Schneider Adolf Wormser:) „Ich weiß nich, Herr Wormser, mit der Uniform is was nich richtig.“"
                                            },
                                            {
                                                "example_id": "b96a2956-7e93-4216-b61a-023315d8bd87",
                                                "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                                "text": "„Darf ich vorstellen: Frau Doktor Wormser.“"
                                            },
                                            {
                                                "example_id": "ca166889-774d-4daf-b0bf-071d5cfb9dd9",
                                                "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                                "text": "„Wormser, erheben Sie sich!“"
                                            },
                                            {
                                                "example_id": "7095af11-2cff-4753-88b4-5e38872c371a",
                                                "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                                "text": "„Mein Nachbar, der Wormser, kann mir bestimmt eine Säge leihen.“"
                                            },
                                            {
                                                "example_id": "59711fb3-dc64-4073-a7fa-fa84625c4220",
                                                "sense_id": "612fcbe2-107e-3aae-bda4-826385efb1e1",
                                                "text": "Mit dem Wormser kann man kein vernünftiges Wort reden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
