                        "examples": [
                            {
                                "example_id": "1e53325c-f9b1-48e5-8433-16e1886b1f19",
                                "sense_id": "79e1ce41-546f-31f9-899d-f6f76ca135e3",
                                "text": "29-го ма́я Наполео́н вы́ехал из Дре́здена, где он пробы́л три неде́ли, окружённый дворо́м, соста́вленным из при́нцев, ге́рцогов, короле́й и да́же одного́ импера́тора.",
                                "translation": "On the twenty-ninth of May Napoleon left Dresden, where he had spent three weeks surrounded by a court that included princes, dukes, kings, and even an emperor.",
                                "english": "On the twenty-ninth of May Napoleon left Dresden, where he had spent three weeks surrounded by a court that included princes, dukes, kings, and even an emperor."
                            }
                        ]
