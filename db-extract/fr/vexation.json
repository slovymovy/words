        "fr-extract.jsonl": [
            {
                "entry_id": "6b922b13-e09a-3a5f-8605-825eaf63f9bc",
                "word": "vexation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c0f7b42-51ed-4563-ad9f-a43f24eece94",
                        "entry_id": "6b922b13-e09a-3a5f-8605-825eaf63f9bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "vexations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74590c88-8d96-32ce-962c-e92170c64273",
                        "entry_id": "6b922b13-e09a-3a5f-8605-825eaf63f9bc",
                        "glosses": [
                            "Action de vexer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60e9e65-6a32-4612-aaef-20e5549612c7",
                                "sense_id": "74590c88-8d96-32ce-962c-e92170c64273",
                                "text": "[…] depuis long-temps, presque toutes ces provinces sont en proie aux vexations d’administrateurs avides et ignorants ; depuis longtemps les guerres civiles et l’anarchie détruisent à de courts intervalles le bien-être de leurs habitants […]"
                            },
                            {
                                "example_id": "3a19b24f-7922-4226-bca2-ebdfcc6c1e1c",
                                "sense_id": "74590c88-8d96-32ce-962c-e92170c64273",
                                "text": "D’un autre côté, les moyens de vexation et d’oppression que possédaient les grands barons étaient si étendus et si multiples, que jamais ils ne manquaient ni de prétexte ni de volonté pour poursuivre, harasser, pousser enfin aux dernières limites de la destruction ceux de leurs moins puissants voisins qui tentaient de se dégager de leur autorité […]"
                            },
                            {
                                "example_id": "ab2eedc3-2086-4303-bfb9-eed78457ea52",
                                "sense_id": "74590c88-8d96-32ce-962c-e92170c64273",
                                "text": "– Bigre ! s’écria-t-il, avec un sentiment d’infinie vexation. Quel idiot je suis ! J’aurais dû leur faire rendre leurs épées…"
                            }
                        ]
                    },
                    {
                        "sense_id": "37f76fbb-3a5b-3fc7-a933-64559fa4f1b9",
                        "entry_id": "6b922b13-e09a-3a5f-8605-825eaf63f9bc",
                        "glosses": [
                            "Trouble causé à une personne par le diable ou ses démons, sans que ces derniers soient présents dans le corps de celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d151a27-0845-4937-895d-85dc5279fdd9",
                                "sense_id": "37f76fbb-3a5b-3fc7-a933-64559fa4f1b9",
                                "text": "Les vexations se manifestent principalement comme des sortes de plaisanteries méchantes perpétrées par le démon. Car l'ennemi est capable de se livrer à des « blagues » vraiment cruelles. Et il ne s'en prive pas !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51cdf3ef-ae61-48b1-b4bc-ce871c3b78c1",
                        "source_entry_id": "6b922b13-e09a-3a5f-8605-825eaf63f9bc",
                        "target_lang_word": "Schikane",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schikane",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26b9fa37-065e-3e92-bc78-a3773592c27d",
                                        "entry_id": "3dab0f14-532d-33e0-be51-3edf8353937a",
                                        "glosses": [
                                            "eine absichtlich gestellte Schwierigkeit, um irgendjemandem etwas zu erschweren; eine hämische Plackerei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e61576-6047-45ae-9c43-174fb2a05f11",
                                                "sense_id": "26b9fa37-065e-3e92-bc78-a3773592c27d",
                                                "text": "An seinem Arbeitsplatz musste er viele Schikanen erdulden."
                                            },
                                            {
                                                "example_id": "e9cc8063-d33d-47d1-a23c-0a06a49fa4e2",
                                                "sense_id": "26b9fa37-065e-3e92-bc78-a3773592c27d",
                                                "text": "„Aber es darf keine Schikane werden.“"
                                            },
                                            {
                                                "example_id": "76123d87-5d57-4b7e-9e40-db52dfb0c54d",
                                                "sense_id": "26b9fa37-065e-3e92-bc78-a3773592c27d",
                                                "text": "„Und sobald er weinte, weil er sich ja nicht wehren durfte, begann die Schikane von neuem.“"
                                            },
                                            {
                                                "example_id": "fdef7e27-0e77-4efb-8814-ffa907024af9",
                                                "sense_id": "26b9fa37-065e-3e92-bc78-a3773592c27d",
                                                "text": "„Zwei oder drei Mal griff er noch ein, dann hörten die Hänseleien und Schikanen der anderen Kinder auf.“"
                                            },
                                            {
                                                "example_id": "aa47600b-1bef-408f-85a7-0f4fab259cb4",
                                                "sense_id": "26b9fa37-065e-3e92-bc78-a3773592c27d",
                                                "text": "„Trotz aller Schikanen, Frivolitäten und Lügen glaubte ich an sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5654b2e3-aea6-3f3e-8fc2-f5d91d3d8b54",
                                        "entry_id": "3dab0f14-532d-33e0-be51-3edf8353937a",
                                        "glosses": [
                                            "besonders schwieriger Streckenabschnitt"
                                        ],
                                        "tags": [
                                            "Rennsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de744391-603e-4ebb-a9f5-9049d3c35abf",
                                                "sense_id": "5654b2e3-aea6-3f3e-8fc2-f5d91d3d8b54",
                                                "text": "In der ersten Schikane verfuhr er sich und verlor dabei viel Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
