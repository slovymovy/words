                    {
                        "translation_id": "8d4d90c6-575e-4968-b8a3-8f20fed962e1",
                        "source_entry_id": "e5a71625-a053-3dc3-9a6d-0cd3b9ef8238",
                        "source_sense_id": "d0ea7e72-d92c-3fc8-aacd-28815df5e285",
                        "source_sense_description": "etwas, das stark von der Norm, dem Üblichen abweicht",
                        "target_lang_word": "особенность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "особенность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c99854-5522-3e5e-b2b8-8509f7a36e6e",
                                        "entry_id": "b3ff9789-e947-395a-867c-b09ff6bb3c6e",
                                        "glosses": [
                                            "свойство по значению прилагательного особенный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1da999a4-8b85-40a8-b5da-e53250d6e722",
                                                "sense_id": "c1c99854-5522-3e5e-b2b8-8509f7a36e6e",
                                                "text": "Разумеется, растение не было выведено специально для удобства путешественников, и его особенность имеет биологическое объяснение."
                                            },
                                            {
                                                "example_id": "ec134313-3f69-4831-ac32-789cd0dd127a",
                                                "sense_id": "c1c99854-5522-3e5e-b2b8-8509f7a36e6e",
                                                "text": "Особенность нынешней весны в том, что реки уже вскрылись, а Ильмень всё ещё скован льдом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45963896-0f7b-3f2c-8581-141c89a03c89",
                                        "entry_id": "b3ff9789-e947-395a-867c-b09ff6bb3c6e",
                                        "glosses": [
                                            "отличительное свойство, отличительная черта кого-либо или чего-либо; то, что придаёт своеобразие кому-либо или чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfc7ae6c-61cb-4839-befc-8648ecde6e79",
                                                "sense_id": "45963896-0f7b-3f2c-8581-141c89a03c89",
                                                "text": "Чудик обладал одной особенностью: с ним постоянно что-нибудь случалось."
                                            },
                                            {
                                                "example_id": "c8f4dc89-684e-44b9-b579-00cceffe8daf",
                                                "sense_id": "45963896-0f7b-3f2c-8581-141c89a03c89",
                                                "text": "Приятной особенностью острова являются колодцы с пресной водой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
