                    {
                        "sense_id": "350d49d4-20e3-3c27-823f-8646f7b326e6",
                        "entry_id": "69e29a48-ac51-3890-8a6b-283457cd631c",
                        "glosses": [
                            "Qui provoque le plaisir sexuel ; qui est aphrodisiaque."
                        ],
                        "tags": [],
