                "translations": [
                    {
                        "translation_id": "cf74d82d-4fdd-4058-84e1-dbfc29aa72c4",
                        "source_entry_id": "f3d6c39d-4b70-3053-adb4-76a492e6aa21",
                        "source_sense_id": "a5dc95cb-ab1e-3567-8c4e-9ea6495688d2",
                        "target_lang_word": "heuristic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heuristic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "120836b5-4f6d-347f-a38e-e1b7788053c4",
                                        "entry_id": "fd4c23d3-6cae-3225-a936-ccb216164485",
                                        "glosses": [
                                            "That employs a practical method not guaranteed to be optimal or perfect; either not following or derived from any theory, or based on an advisedly oversimplified one."
                                        ],
                                        "tags": [
                                            "of an approach to problem solving"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42e6b825-79a4-4e6d-8307-75fe38e1cd65",
                                                "sense_id": "120836b5-4f6d-347f-a38e-e1b7788053c4",
                                                "text": "\"The heuristic appraisal is the 'identification and evaluation of hints and clues that can provide direction to inquiry in the sometimes large gap between the extremes of complete knowledge and complete ignorance'”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49e3050-280e-33f8-a705-6fb6ea0b4ff1",
                                        "entry_id": "fd4c23d3-6cae-3225-a936-ccb216164485",
                                        "glosses": [
                                            "That provides a useful, but not optimal, solution to a problem. Such algorithms are typically employed either because the only known algorithms that provide optimal solutions use too much time or resources, or else because there is no known algorithm that provides an optimal solution."
                                        ],
                                        "tags": [
                                            "of a method or algorithm"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c038e30-bce3-4efb-8671-505a973c3a9c",
                                                "sense_id": "e49e3050-280e-33f8-a705-6fb6ea0b4ff1",
                                                "text": "If a heuristic algorithm works for most of the input data or its maximum percentage error is tolerable, we may prefer the heuristic algorithm to an optimum algorithm that requires a long time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48b7b89a-5403-3d19-a34e-d173ebb910de",
                                        "entry_id": "fd4c23d3-6cae-3225-a936-ccb216164485",
                                        "glosses": [
                                            "That reasons from the value of a method or principle that has been shown by experimental investigation to be a useful aid in learning, discovery and problem-solving."
                                        ],
                                        "tags": [
                                            "of an argument"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "heuristic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45fc8991-2a51-3bcc-a4ed-a785e463bef6",
                                        "entry_id": "c582d5ab-755f-3264-8892-1f97111cc0a3",
                                        "glosses": [
                                            "A heuristic method."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "331b794a-5b36-33be-aa83-db4ae7c2a615",
                                        "entry_id": "c582d5ab-755f-3264-8892-1f97111cc0a3",
                                        "glosses": [
                                            "The art of applying heuristic methods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b87a3da5-38cf-3d03-a5f9-9f73e8a4f058",
                                        "entry_id": "c582d5ab-755f-3264-8892-1f97111cc0a3",
                                        "glosses": [
                                            "A heuristic algorithm or method."
                                        ],
                                        "tags": [],
