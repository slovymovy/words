                        "glosses": [
                            "Ne pas se soumettre, ne pas suivre une tendance ou une hiérarchie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7138c2-7287-43eb-915a-4a9a58075c87",
                                "sense_id": "b9a7aa14-340b-3d6f-8969-da61ec1b2449",
                                "text": "« A travers ce tableau d’honneur, a expliqué le député de Marseille, nous voulons dire que ça vaut la peine de s’insoumettre. Notre rôle, c’est de résister à la pente du monde. »"
                            },
                            {
                                "example_id": "0c1f21ea-d1c1-457c-aef7-01f29689591d",
                                "sense_id": "b9a7aa14-340b-3d6f-8969-da61ec1b2449",
                                "text": "Je ne regrette qu’une seule chose : avoir trop tardé à m’insoumettre, ce que j’ai fait quand j’ai dit en direct que j’avais \"envie de faire caca\". Je me suis rendu compte de l’embrigadement trop tard."
                            }
                        ]
                    }
