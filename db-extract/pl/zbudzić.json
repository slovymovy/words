                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e028353-7f6c-442a-b06c-1344fae5dea3",
                        "source_entry_id": "3e4cc4a5-bed0-3f8d-acee-a4a64bd7ce6d",
                        "source_sense_id": "d91f0d8f-da82-3018-9818-47fd3635a679",
                        "target_lang_word": "разбудить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разбудить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3e8f77e9-455a-3402-afb6-dfded62bec0c",
                                        "entry_id": "49ffda1c-f0e4-30b1-8f11-335d84bd82fa",
                                        "glosses": [
                                            "вывести из состояния сна, заставить проснуться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0efe6c98-3460-4e99-8474-76584478d201",
                                                "sense_id": "3e8f77e9-455a-3402-afb6-dfded62bec0c",
                                                "text": "По счастию моему случившаяся на дороге рытвина, в которую кибитка моя толкнулась, меня разбудила."
                                            },
                                            {
                                                "example_id": "75bbb716-ad78-4371-bea2-b9acc64e3300",
                                                "sense_id": "3e8f77e9-455a-3402-afb6-dfded62bec0c",
                                                "text": "Утренняя песнь птичек разбудила юношу."
                                            },
                                            {
                                                "example_id": "c25c0351-a14d-4aa5-8e59-664fe7725fdf",
                                                "sense_id": "3e8f77e9-455a-3402-afb6-dfded62bec0c",
                                                "text": "Восходящее солнце разбудило меня лучами своими…"
                                            },
                                            {
                                                "example_id": "dda0f0e2-ea5a-45d4-8ace-6dbab9aae533",
                                                "sense_id": "3e8f77e9-455a-3402-afb6-dfded62bec0c",
                                                "text": "Уж поздно; ты, я чай, устал: ночуй здесь, как бывало в старину. Завтра я тебя разбужу."
                                            },
                                            {
                                                "example_id": "434beb54-5862-4f20-8fcf-8c1bc6da7a94",
                                                "sense_id": "3e8f77e9-455a-3402-afb6-dfded62bec0c",
                                                "text": "На дворе было ещё темно, как Адриана разбудили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "355b8f8d-9856-32d2-b283-0d53419e86da",
                                        "entry_id": "49ffda1c-f0e4-30b1-8f11-335d84bd82fa",
                                        "glosses": [
                                            "перен. вывести из состояния покоя, апатии, заставить быть деятельным"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39417d30-d49b-30b2-b2d5-c4a430684afd",
                                        "entry_id": "49ffda1c-f0e4-30b1-8f11-335d84bd82fa",
                                        "glosses": [
                                            "перен. вызвать, усилить (какие-либо чувства, мысли, переживания и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d8250a-4119-41f2-9b16-1268a3f31c57",
                                                "sense_id": "39417d30-d49b-30b2-b2d5-c4a430684afd",
                                                "text": "Её характер мне нравился: в нём видел я какую-то пылкость, твёрдость и благородство, редко заметные в наших женщинах, одним словом, что-то первобытное, допотопное, что-то увлекающее ― частые встречи, частые прогулки, невольно яркий взгляд, случайное пожатие руки ― много ли надо, чтоб разбудить таившуюся искру?.."
                                            },
                                            {
                                                "example_id": "9e3b0b96-0d41-4535-877a-e1d61596784e",
                                                "sense_id": "39417d30-d49b-30b2-b2d5-c4a430684afd",
                                                "text": "Он разбудил в душе моей тяжёлое чувство…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
