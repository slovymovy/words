                        ],
                        "form": "die Lernprozesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5643e5c1-8be5-376a-bb96-f1249b43bd17",
                        "entry_id": "d0e44631-7ce1-396f-b4c7-19a2e2078c16",
                        "glosses": [
                            "Vorgang der Aneignung von Wissen, Können, Einsichten, Wertvorstellungen oder sozialem Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53cbc00-e517-4b43-9b5e-614e160d866f",
                                "sense_id": "5643e5c1-8be5-376a-bb96-f1249b43bd17",
                                "text": "„Der Großteil aller Lernprozesse vollzieht sich in Schonräumen und Spielbereichen.“"
                            },
                            {
                                "example_id": "2d949808-bb12-4919-a6a9-edd3da1afb5a",
                                "sense_id": "5643e5c1-8be5-376a-bb96-f1249b43bd17",
                                "text": "„Nach Abschluß dieses Lernprozesses wurde das Tier vor ein neues Problem gestellt.“"
                            },
                            {
                                "example_id": "7684b4ac-681f-465d-b81d-5d259163a62c",
                                "sense_id": "5643e5c1-8be5-376a-bb96-f1249b43bd17",
                                "text": "„Eine gebundene Handschrift zu erlernen, sei ein elementarer individueller Lernprozess für jedes Kind.“"
                            },
                            {
                                "example_id": "fbdcd061-6ed2-4856-8ab3-434bfc555c5b",
                                "sense_id": "5643e5c1-8be5-376a-bb96-f1249b43bd17",
                                "text": "„Für die Kirche und auch für mich selbst war es ein schmerzhafter Lernprozess, vor allem und in allem von der Perspektive der Opfer her zu denken und zu handeln.“"
                            },
                            {
                                "example_id": "8cb1591a-98f2-4220-8652-bc5246499dd4",
                                "sense_id": "5643e5c1-8be5-376a-bb96-f1249b43bd17",
                                "text": "„Die Union, erst recht die unendlich lernwütige Kanzlerin, wird diesen vierwöchigen Lernprozess nicht einfach ad acta legen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
