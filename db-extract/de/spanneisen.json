                    },
                    {
                        "translation_id": "9ebf72e3-511c-482f-b928-6ce3e2c1759a",
                        "source_entry_id": "d7dc56ac-031c-390b-932f-c6a5d9af0a17",
                        "source_sense_id": "56d92464-df07-30a7-b647-819058ccda2f",
                        "target_lang_word": "bride",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7088a807-7c2a-354d-8a67-065c8f456d7f",
                                        "entry_id": "60bd43c5-b3e9-3b05-8ebc-b23022dfcd0f",
                                        "glosses": [
                                            "Harnais placé sur la tête du cheval et destiné à l’arrêter ou à le diriger, selon la volonté du cavalier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd5c594-27b2-417f-8512-d5d66d36cf32",
                                                "sense_id": "7088a807-7c2a-354d-8a67-065c8f456d7f",
                                                "text": "Les brides et les bâts des chameaux étaient tout parés de perles brillantes et de pompons multicolores."
                                            },
                                            {
                                                "example_id": "44b15109-00b9-4452-8396-4d972a0e9488",
                                                "sense_id": "7088a807-7c2a-354d-8a67-065c8f456d7f",
                                                "text": "Quant aux brides, aux mors, aux têtières, aux frontails, nos langues du Nord sont trop froides, trop pauvres, trop mesquines, pour en décrire les somptuosités."
                                            },
                                            {
                                                "example_id": "93a910e7-19be-41f9-9ef0-8e8253da69cc",
                                                "sense_id": "7088a807-7c2a-354d-8a67-065c8f456d7f",
                                                "text": "A la bride et au mors arabe on ajoute, aux grandes occasions, une large bande frontale ornée de franges et un gros gland pendant au cou du cheval."
                                            },
                                            {
                                                "example_id": "1e2e5206-4d47-497d-b9f2-5b4356bfec24",
                                                "sense_id": "7088a807-7c2a-354d-8a67-065c8f456d7f",
                                                "text": "La bride se compose de trois parties : la monture, le mors et les rênes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e684eb35-75ae-36c7-b9f4-5a854ac1c084",
                                        "entry_id": "60bd43c5-b3e9-3b05-8ebc-b23022dfcd0f",
                                        "glosses": [
                                            "Les rênes seules."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee738e9-a41f-4c01-81d1-321d0f6545c3",
                                                "sense_id": "e684eb35-75ae-36c7-b9f4-5a854ac1c084",
                                                "text": "Quelques appels de bride, invisibles pour les profanes, donnèrent au cheval du préfet, étonné de l’insolence de son cavalier, de petits mouvements d’impatience charmants pour les connaisseurs."
                                            },
                                            {
                                                "example_id": "1a30037a-2f6c-48e0-9772-c2de208322ad",
                                                "sense_id": "e684eb35-75ae-36c7-b9f4-5a854ac1c084",
                                                "text": "De Mouy descendit de cheval, jeta la bride aux mains de son laquais, s’achemina vers le guichet, se fit reconnaître de la sentinelle, […]."
                                            },
                                            {
                                                "example_id": "3572adc1-e008-42fd-8cdd-fb43ba3f9f9a",
                                                "sense_id": "e684eb35-75ae-36c7-b9f4-5a854ac1c084",
                                                "text": "[…]; et le maréchal, […], tenait le cheval par la bride, parce que le cheval était un peu nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb92b129-9f84-3016-be6c-9538e88eb79e",
                                        "entry_id": "60bd43c5-b3e9-3b05-8ebc-b23022dfcd0f",
                                        "glosses": [
                                            "Obstacle ; frein ; retenue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "010c8e6c-91ef-4c15-bd97-433d13965490",
                                                "sense_id": "fb92b129-9f84-3016-be6c-9538e88eb79e",
                                                "text": "Lâcher la bride, mettre à quelqu’un la bride sur le cou : lui laisser toute liberté d’agir."
                                            },
                                            {
                                                "example_id": "ea0b5dea-2a89-414b-bb73-48a8d3822609",
                                                "sense_id": "fb92b129-9f84-3016-be6c-9538e88eb79e",
                                                "text": "Lâcher la bride à ses passions."
                                            },
                                            {
                                                "example_id": "9dc6455e-4dfd-4742-9acb-3abdb0c157e8",
                                                "sense_id": "fb92b129-9f84-3016-be6c-9538e88eb79e",
                                                "text": "Le garder dans mes jupes ? pour qu’il reste craintif et mal dégourdi ? Merci bien !... Je lui laisserai la bride assez longue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                        "entry_id": "60bd43c5-b3e9-3b05-8ebc-b23022dfcd0f",
                                        "glosses": [
                                            "Lien pour retenir certaines coiffures qui passe ou qu’on noue sous le menton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5444f6bf-3fbf-4c04-b430-ec50e3ac8b06",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "[…] ; à gauche de la porte, sur le fourneau, où pêle-mêle s’étalait la vaisselle, certain chapeau, rehaussé de plumes, trempait l’une de ses brides dans la soupière pleine de beurre fondu."
                                            },
                                            {
                                                "example_id": "cacedbd3-710f-4ae0-8d10-554ab6a665bb",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "La ceinture de velours noir au large nœud flottant, le chapeau de paille souple à grands bords qu’au dossier de la chaise elle a suspendu par la bride, tout ajoute à son air enfantin."
                                            },
                                            {
                                                "example_id": "73686086-782f-429b-9c69-42a4b7bbeee1",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "Chacun d’eux, dans sa maison, possédait une femme qui, les brides du bonnet nouées derrière la tête, préparait le repas à l’heure et n’acceptait aucun délai."
                                            },
                                            {
                                                "example_id": "71494ef5-1d8c-4970-80d7-22ad2ae94d9c",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "[…], troussant son tablier, rattachant les brides flottantes de son bonnet, elle courut, à grands clic-clacs de sabots, colporter la nouvelle chez les voisines:"
                                            },
                                            {
                                                "example_id": "6af1b70c-e554-4494-891b-e2004a880986",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "Elle était par ailleurs, portée à les croire peu chic, depuis qu’elle avait vu passer dans la rue la marquise de Villeparisis en robe de laine noire, avec un bonnet à brides.\n— Mais elle a l’air d’une ouvreuse, d’une vieille concierge, darling ! Ça, une marquise ! Je ne suis pas marquise, mais il faudrait me payer bien cher pour me faire sortir nippée comme ça !"
                                            },
                                            {
                                                "example_id": "268937b0-6d3b-4b06-944f-a63524c6fae6",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "Droite et maigre dans sa robe noire, la tête prise dans son bonnet à brides, elle regardait les trois tombes des Maloret, pinçant la bouche et fronçant les narines, comme si elle eût soupçonné les trois défunts, non seulement de puer vers son nez, mais encore de le faire exprès."
                                            },
                                            {
                                                "example_id": "d7aa1dc9-4229-4440-ab18-3c4d4e4f7c58",
                                                "sense_id": "972b17e6-9283-3e0a-9210-874f44212c6a",
                                                "text": "Elle était toujours vêtue de noir et portait un petit chapeau dont les brides étaient nouées sous le menton en une élégante rosette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a647130-d8fd-3667-b11e-4cbce420358b",
                                        "entry_id": "60bd43c5-b3e9-3b05-8ebc-b23022dfcd0f",
                                        "glosses": [
                                            "Espèce de boutonnière qui se fait aux manches et aux cols des femmes pour les fixer à un bouton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de23ea2-8cd5-407f-86a9-efcaf0e2e484",
                                                "sense_id": "9a647130-d8fd-3667-b11e-4cbce420358b",
                                                "text": "La bride se fait en saillie sur l’étoffe ; c’est un feston sur des fils posés en demi-cercle et pouvant entourer le bouton. La bride n’est attachée à l’étoffe que par ses deux côtés, tandis que la boutonnière est dans l’étoffe même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78e0b41-ccb6-3e47-ba4d-fd58a93aec8e",
                                        "entry_id": "60bd43c5-b3e9-3b05-8ebc-b23022dfcd0f",
                                        "glosses": [
                                            "Points aux deux extrémités d’une boutonnière pour empêcher qu’elle ne se déchire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
