                ],
                "senses": [
                    {
                        "sense_id": "02dfc064-ec9d-3577-bf2c-b5ebc2dbc202",
                        "entry_id": "2e0e4fe9-21ec-3dc0-bb30-fd878bdba8e8",
                        "glosses": [
                            "свойство по значению прилагательного смиренный; покорность, отсутствие гордости, строптивости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db493e48-b7de-4cb0-a3e0-6e41a8b4bea1",
                                "sense_id": "02dfc064-ec9d-3577-bf2c-b5ebc2dbc202",
                                "text": "Жалкий в своем пороке и смиренности, в своей пастушеской первобытности, Кирюшка спал, покрывшись армяком, выставив из-под него толстую, в белых онучах, согнутую в колене ногу."
                            },
                            {
                                "example_id": "41f36b93-668b-443a-a193-7500c17ee11c",
                                "sense_id": "02dfc064-ec9d-3577-bf2c-b5ebc2dbc202",
                                "text": "И то, что в гостинице ему предложили такую постель, ещё одно свидетельство его бьющей в глаза моложавости. И смиренности облика. А то, что он безропотно принял эту милость, ещё один знак его неозабоченности пустяками."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fa8804a-39a9-4152-bf92-6327e17b30e2",
                        "source_entry_id": "2e0e4fe9-21ec-3dc0-bb30-fd878bdba8e8",
                        "source_sense_id": "02dfc064-ec9d-3577-bf2c-b5ebc2dbc202",
                        "target_lang_word": "humility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8866ec4e-911c-36db-9d70-e67427c4d839",
                                        "entry_id": "3b5c1ace-7261-38dd-b1ab-99aed6371c69",
                                        "glosses": [
                                            "The characteristic of being humble; humbleness in character and behavior."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad21f9e-efae-461c-907e-dd07eeb956e9",
                                                "sense_id": "8866ec4e-911c-36db-9d70-e67427c4d839",
                                                "text": "She had established a character for humility, discretion, noiselessness and religion which Mrs. Piper greatly regretted losing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38909670-330f-44e3-98ab-c2e279f1ad00",
                        "source_entry_id": "2e0e4fe9-21ec-3dc0-bb30-fd878bdba8e8",
                        "source_sense_id": "02dfc064-ec9d-3577-bf2c-b5ebc2dbc202",
                        "target_lang_word": "meekness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meekness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                        "entry_id": "f4c8aab2-537d-3c1b-8917-91a704977393",
                                        "glosses": [
                                            "The state or quality of being meek."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a4d4688-f867-4921-94eb-a8af47c3197e",
                                                "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                                "text": "But thou, O man of God, flie these things; and follow after righteousnesse, godlinesse, faith, loue, patience, meekenesse."
                                            },
                                            {
                                                "example_id": "f9bab15d-9529-488c-a3b9-4f0bcb64c54a",
                                                "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                                "text": "Nor could Pym fail to notice that his old friend in rendering account of himself assumed the familiar meekness of the displaced person in the presence of his betters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
