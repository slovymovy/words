                        "sense_id": "efa545d5-4e7f-3223-8f5d-8c0d7adff327",
                        "entry_id": "89101f6d-b789-3162-b9e8-e1be84754889",
                        "glosses": [
                            "alternative form of Skandal"
                        ],
                        "tags": [
                            "alt-of",
