    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7d3cc96-6a72-388a-b000-546d76ea589d",
                    "sense_definition": "Rendre hommage ou témoigner un profond respect à quelqu'un ou à quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La ville a érigé une statue pour <w>honorer</w> la mémoire des soldats disparus."
                        },
                        {
                            "text": "Les citoyens se sont rassemblés afin d'<w>honorer</w> leurs héros nationaux lors de la cérémonie officielle."
                        }
                    ],
                    "synonyms": [
                        "révérer"
                    ],
                    "antonyms": [
                        "déshonorer",
                        "mépriser"
                    ],
                    "common_phrases": [
                        "honorer la mémoire",
                        "honorer les morts",
                        "honorer ses parents"
                    ]
                },
                {
                    "sense_id": "a119e148-382e-36b1-a9dc-3e1e7208ffa8",
                    "sense_definition": "Respecter ou exécuter fidèlement un engagement, une promesse ou un contrat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a promis d'<w>honorer</w> son engagement malgré les difficultés financières de l'entreprise."
                        },
                        {
                            "text": "Si vous donnez votre parole, vous devez absolument l'<w>honorer</w> dans les délais convenus."
                        }
                    ],
                    "antonyms": [
                        "trahir"
                    ],
                    "common_phrases": [
                        "honorer un engagement",
                        "honorer sa promesse",
                        "honorer un contrat"
                    ]
                },
                {
                    "sense_id": "e5033c44-121c-3a88-9809-c415a2b59ecc",
                    "sense_definition": "Faire honneur à quelqu'un ou à quelque chose, en être une source de fierté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par son dévouement exemplaire, ce jeune médecin <w>honore</w> toute sa profession."
                        },
                        {
                            "text": "Une telle générosité vous <w>honore</w> et suscite l'admiration de tous vos collègues."
                        }
                    ],
                    "common_phrases": [
                        "faire honneur"
                    ]
                },
                {
                    "sense_id": "231903b4-72a5-38ef-afcb-a347d02dac7d",
                    "sense_definition": "Témoigner de la déférence en accordant une visite, une attention ou une distinction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire a accepté d'<w>honorer</w> notre festival de sa présence lors de l'inauguration."
                        },
                        {
                            "text": "Votre confiance m'<w>honore</w> et je ferai tout pour être à la hauteur de vos attentes."
                        }
                    ],
                    "common_phrases": [
                        "honorer de sa présence",
                        "honorer de sa confiance"
                    ]
                },
                {
                    "sense_id": "e1af6834-9b7d-375f-8907-90c7c7a34e4e",
                    "sense_definition": "Payer une somme due ou s'acquitter d'une dette, d'une traite ou d'une facture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La société dispose de liquidités suffisantes pour <w>honorer</w> ses dettes à la fin du mois."
                        },
                        {
                            "text": "Il doit impérativement trouver des fonds pour <w>honorer</w> cette facture d'électricité avant la fin de semaine."
                        }
                    ],
                    "synonyms": [
                        "révérer"
                    ],
                    "common_phrases": [
                        "honorer une dette",
                        "honorer une facture",
                        "honorer ses traites"
                    ]
                },
                {
                    "sense_id": "6650c062-7e39-313d-b3ca-dd1293797563",
                    "sense_definition": "Tenir en grande estime le mérite ou les qualités de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bien que je sois en désaccord avec ses idées, j'<w>honore</w> son intégrité et son courage politique."
                        },
                        {
                            "text": "Tout le monde dans le laboratoire <w>honore</w> le dévouement et l'intelligence de cette chercheuse."
                        }
                    ]
                },
                {
                    "sense_id": "8132b80d-2535-3c03-94fd-904b5b1e30f2",
                    "sense_definition": "Avoir des relations sexuelles avec une personne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce roman libertin du dix-huitième siècle, le héros prétend <w>honorer</w> sa maîtresse à plusieurs reprises."
                        },
                        {
                            "text": "L'auteur utilise cette formule vieillotte pour dire qu'il a <w>honoré</w> son amante toute la nuit."
                        }
                    ],
