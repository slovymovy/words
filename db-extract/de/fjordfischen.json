                "senses": [
                    {
                        "sense_id": "cc66be13-3648-30e0-98aa-b384657ed122",
                        "entry_id": "d93602fc-011c-3aca-bdf2-4edbd886f8ab",
                        "glosses": [
                            "das Fischen in einem Fjord; spezielle Angeltechnik zum Fjordfisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfba0b8-0078-412e-9354-0bd16c3d909e",
                                "sense_id": "cc66be13-3648-30e0-98aa-b384657ed122",
                                "text": "„Der ideale Ausgleich zum schweren Fjordfischen: mit der Spinnrute (Wurfgewicht bis 80 g), einer mittleren Stationärrolle und leichten Pilkern oder Gummiködern die Steilkanten abwerfen.“"
                            },
                            {
                                "example_id": "c05953b9-822a-4b92-b7ae-96758b6b4e72",
                                "sense_id": "cc66be13-3648-30e0-98aa-b384657ed122",
                                "text": "„Danach geht’s mit den Booten raus zum Fjordfischen, bevor wir kurz vor dem Eindunkeln wieder am Bach stehen, jedoch sehen wir die Fische nur springen.“"
                            },
                            {
                                "example_id": "be890ed7-404c-46cd-b751-08b64b63a6f5",
                                "sense_id": "cc66be13-3648-30e0-98aa-b384657ed122",
                                "text": "„Weitgehend wetterstabiles Fjordfischen im Skjerstadtfjorden, der Fjord dem der berühmte Saltstraumen das Wasser zuführt.“"
                            },
                            {
                                "example_id": "0c3d3c5b-3433-4f27-9849-f8a5b4fb6c94",
                                "sense_id": "cc66be13-3648-30e0-98aa-b384657ed122",
                                "text": "„Das Fjordfischen über flachem Wasser war besonders erfolgreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
