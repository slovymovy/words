                    {
                        "translation_id": "1526c8ed-2985-4b91-a4f3-ccb4e20d408d",
                        "source_entry_id": "8c6ca2b1-5541-3e4f-9753-75fe5dce5cc8",
                        "source_sense_description": "Cantharellus cibarius",
                        "target_lang_word": "girolle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "girolle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00c78871-c1fb-373c-bbf9-9e6da51aeac1",
                                        "entry_id": "57821295-3e08-3eee-8f3f-d00eafb37e74",
                                        "glosses": [
                                            "Espèce de champignons à plis lamelliformes, au chapeau convexe, s’aplatissant, puis en entonnoir, jaune plus ou moins orangé, au pied sans anneau, concolore et aux spores jaune pâle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953a8089-f012-439b-a138-3334b018cc7a",
                                                "sense_id": "00c78871-c1fb-373c-bbf9-9e6da51aeac1",
                                                "text": "Avec une fierté évidente, elle déposa au centre de la table un long plat de faïence ovale et courut à la cuisine chercher une casserolette de cuivre dans laquelle mijotaient des girolles à la crème."
                                            },
                                            {
                                                "example_id": "fea9a1a7-da5c-4502-863a-219db9fb60b3",
                                                "sense_id": "00c78871-c1fb-373c-bbf9-9e6da51aeac1",
                                                "text": "El Mouria, c’est toute la forêt : il en connaît tous les sentiers, à des lieues, les cantons à muguet, les champs de myrtilles, les placers de girolles, de pieds rouges, de charbonniers."
                                            },
                                            {
                                                "example_id": "d27eb48f-bd50-4cc1-8579-1da307a4e152",
                                                "sense_id": "00c78871-c1fb-373c-bbf9-9e6da51aeac1",
                                                "text": "Près de la carrière serpentait l’ancienne route abandonnée, avec ses nombreuses ornières et à gauche la pente du petit bois où l’on cherchait quelques champignons : girolles et cèpes, amanites oronges comestibles voisinant avec des espèces vénéneuses, fausses oronges ou amanites tue-mouche dont j’aimais tant la couleur rouge du chapeau tacheté de blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7a16db-9956-3a73-8a66-e8ef8579000b",
                                        "entry_id": "57821295-3e08-3eee-8f3f-d00eafb37e74",
                                        "glosses": [
                                            "Ustensile servant à racler des lamelles de tête de moine (fromage suisse) ou des fromages de forme cylindrique à pâte dure comme certains fromages basques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90839eb7-849c-417a-95e1-5dc7e3af5e52",
