                        "sense_id": "a8c5fe80-2f26-3c01-9a18-0d863e0067bf",
                        "entry_id": "b46f29ca-1155-3c66-9550-70f2e19e5a99",
                        "glosses": [
                            "een vrouw die een of meer kamers in haar eigen woonhuis ter beschikking stelt aan een kostganger of commensaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "500501e0-311f-415a-92ae-67c6b1b70283",
                                "sense_id": "a8c5fe80-2f26-3c01-9a18-0d863e0067bf",
                                "text": "Door het gebrek aan kamers dat in veel steden nog steeds heerst wonen er nog steeds redelijk wat studenten bij een hospita."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3752af97-a23b-4cfe-8f18-4374010866a9",
                        "source_entry_id": "b46f29ca-1155-3c66-9550-70f2e19e5a99",
                        "source_sense_id": "a8c5fe80-2f26-3c01-9a18-0d863e0067bf",
                        "source_sense_description": "een vrouw die een of meer kamers in haar eigen woonhuis ter beschikking stelt aan een kostganger of commensaal",
                        "target_lang_word": "Zimmerwirtin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmerwirtin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f13ec28-85a7-3aad-9c78-fb499db4b2e9",
                                        "entry_id": "f4e9098a-6808-3cbe-b439-8d7cbc8aaafa",
                                        "glosses": [
                                            "Frau, die ein Zimmer/mehrere Zimmer vermietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e06cf1ba-a335-4bae-bc26-a4e3d11eb8e7",
                                                "sense_id": "8f13ec28-85a7-3aad-9c78-fb499db4b2e9",
                                                "text": "„Verzweifelt fragte sie bei seiner Zimmerwirtin nach.“"
                                            },
                                            {
                                                "example_id": "b57a5d37-bfa8-4fdf-8424-18c4f9c55f5a",
                                                "sense_id": "8f13ec28-85a7-3aad-9c78-fb499db4b2e9",
                                                "text": "„Zusammen mit der Tochter ihrer Zimmerwirtin fuhr Ditti abends mit der Straßenbahn zur Endstation, sie kletterten auf die Güterwaggons mit den Eierbriketts, stopften die Rucksäcke voll und schleppten sie – verdammt schwer, wie sie waren – wieder zurück nach Hause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e10b698-ca37-4f6c-8a0a-6201cf046620",
                        "source_entry_id": "b46f29ca-1155-3c66-9550-70f2e19e5a99",
                        "source_sense_id": "a8c5fe80-2f26-3c01-9a18-0d863e0067bf",
                        "source_sense_description": "een vrouw die een of meer kamers in haar eigen woonhuis ter beschikking stelt aan een kostganger of commensaal",
                        "target_lang_word": "landlady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landlady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39b82ce0-a477-3afc-a68e-0e00a7b699cb",
                                        "entry_id": "198c3edf-ea49-3888-a0e0-0aa44b219ed9",
                                        "glosses": [
                                            "A female landlord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ea1de1-012c-4f96-84b0-b278cd749332",
                                                "sense_id": "39b82ce0-a477-3afc-a68e-0e00a7b699cb",
                                                "text": "In a large bedroom upstairs, the window of which was thickly curtained with a great woollen shawl lately discarded by the landlady, Mrs. Rolliver, were gathered on this evening nearly a dozen persons, all seeking vinous bliss; all old inhabitants of the nearer end of Marlott, and frequenters of this retreat."
                                            },
                                            {
                                                "example_id": "cadf51c9-203d-4dbb-b997-f7b3e1917458",
                                                "sense_id": "39b82ce0-a477-3afc-a68e-0e00a7b699cb",
                                                "text": "Yet Clacton, like every other station at a big seaside resort, is bedevilled by the traditional insistence of boarding-house landladies that their clients must arrive on Saturday before lunch and leave on Saturday after breakfast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
