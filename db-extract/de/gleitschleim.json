                "senses": [
                    {
                        "sense_id": "7da48f24-bfb9-3b36-8b6e-de9949621b9d",
                        "entry_id": "a2058b28-9939-3c42-aaea-34a2f9deedbd",
                        "glosses": [
                            "körpereigenes Sekret, das Reibung verhindern und eine Schutzschicht bilden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c77165-c0dd-4e3f-8ee2-f3f340524d1a",
                                "sense_id": "7da48f24-bfb9-3b36-8b6e-de9949621b9d",
                                "text": "„Sie sind auf der Lamina propria mucosae aufgereiht; Hemidesmosomenzellen und die damit steigende Produktion an Gleitschleim geht mit der entlang des Darms zunehmenden Eindickung des Chymus durch Wasserentzug einher.“"
                            },
                            {
                                "example_id": "61de81ff-0936-48eb-af51-357ea4fef339",
                                "sense_id": "7da48f24-bfb9-3b36-8b6e-de9949621b9d",
                                "text": "„Weiter hinten am harten Gaumen liegt zwischen Periost und Schleimhaut ein Feld von kleinen Schleimdrüsen, die Glandulae palatinae; diese produzieren ein muköses Sekret, das als Gleitschleim für die Passage der Nahrung wirkt.“"
                            },
                            {
                                "example_id": "4b459ebd-8f48-4617-a623-2021acd6cc77",
                                "sense_id": "7da48f24-bfb9-3b36-8b6e-de9949621b9d",
                                "text": "„Die Dickdarmkrypten liefern große Mengen eines verhältnismäßig sauren Schleims, der die Dickdarmschleimhaut gegenüber dem sich verfestigenden Darminhalt gleitfähig macht und so als Gleitschleim wirkt.“"
                            },
                            {
                                "example_id": "bc5afe95-247a-4b43-a620-8ec89bd42f56",
                                "sense_id": "7da48f24-bfb9-3b36-8b6e-de9949621b9d",
                                "text": "„Die Glandulae pharyngis liegen submukös. Sie bilden den Gleitschleim für den Rachen.“"
                            },
                            {
                                "example_id": "cb574aaa-b8a8-4e72-8489-d61a5bbef88a",
                                "sense_id": "7da48f24-bfb9-3b36-8b6e-de9949621b9d",
                                "text": "„Zahlreiche Becherzellen sezernieren den Gleitschleim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8ae10eb-5951-3da2-86ab-166defd6659d",
                        "entry_id": "a2058b28-9939-3c42-aaea-34a2f9deedbd",
                        "glosses": [
                            "zähflüssige, künstlich hergestellte Substanz, die zur Verminderung von Reibung bei Entbindungen, Untersuchungen oder Geschlechtsverkehr aufgetragen wird"
                        ],
                        "tags": [
                            "Sex"
                        ],
                        "examples": [
                            {
                                "example_id": "6de9d2fd-0ae5-4733-bbb4-f06f707e41ee",
                                "sense_id": "e8ae10eb-5951-3da2-86ab-166defd6659d",
                                "text": "„Vaginale geburtshilfliche Eingriffe werden durch eine großzügige Verwendung von Fruchtwasserersatz (Gleitschleim) erleichtert.“"
                            },
                            {
                                "example_id": "7b75651d-d45d-4515-b355-67b1172f8e0d",
                                "sense_id": "e8ae10eb-5951-3da2-86ab-166defd6659d",
                                "text": "„Ich wusch mir die Hände und Unterarme, Gleitschleim drauf und kniete mich hinter die Kalbin. Ich hatte zuvor schon ein- oder zweimal in eine kalbende Kuh gefasst, die warme, schleimige Begegnung mit dem inneren Geburtsweg war mir deshalb nicht neu.“"
                            },
                            {
                                "example_id": "4aba37f2-3af6-4223-b594-f4e5d1bc33f9",
                                "sense_id": "e8ae10eb-5951-3da2-86ab-166defd6659d",
                                "text": "„Beim Eingreifen in die Vagina wird die gereinigte, mit Gleitschleim eingehüllte Hand hierbei mit geschlossenen Fingern und Daumen kegelförmig eingeführt.“"
                            },
                            {
                                "example_id": "134a00fb-f1db-4f81-af75-304e7d684e31",
                                "sense_id": "e8ae10eb-5951-3da2-86ab-166defd6659d",
                                "text": "„Fertiger Gleitschleim. Erhöht die Gleitfähigkeit von Handschuhen und Armen bei Untersuchungen und der Geburtshilfe bei Rindern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
