                    {
                        "sense_id": "b0ada714-9b08-3f82-b25c-d15de95cf73a",
                        "entry_id": "6beae94c-f3f5-35a9-a860-a9da333d7a69",
                        "glosses": [
                            "Celui ou celle qui habite dans un pavillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52151ac4-ecbd-4b67-b943-e78bdd7c9056",
                                "sense_id": "b0ada714-9b08-3f82-b25c-d15de95cf73a",
                                "text": "Est-ce à dire que le pavillonnaire est fragmenté entre un pavillonnaire « premium » et un pavillonnaire « discount » pour reprendre les termes chers à Fourquet et Cassely (2021) ?"
                            },
                            {
                                "example_id": "98cc890a-2440-4206-804e-61173109195f",
                                "sense_id": "b0ada714-9b08-3f82-b25c-d15de95cf73a",
                                "text": "Dans le contexte du militantisme associatif et politique des années 1970, les pavillonnaires issus des nouvelles classes moyennes ont été décrits comme des « aventuriers du quotidien », des acteurs politiques et associatifs de premier plan proches de la gauche."
                            }
                        ]
                    }
