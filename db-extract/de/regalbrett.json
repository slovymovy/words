                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b480bbc-fa44-37ec-9199-d89b84725b2d",
                        "entry_id": "283046fc-fa78-3dd1-9cf5-460f83539a52",
                        "glosses": [
                            "Brett, das Teil eines Regals ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d9b9ab-64cd-4deb-a347-b7fef03ac888",
                                "sense_id": "5b480bbc-fa44-37ec-9199-d89b84725b2d",
                                "text": "„Es passte auf drei Regalbretter.“"
                            },
                            {
                                "example_id": "7c501a1d-4569-41d5-bb24-18cbcb45c9bc",
                                "sense_id": "5b480bbc-fa44-37ec-9199-d89b84725b2d",
                                "text": "„Sorgfältig, vielleicht sogar übertrieben vorsichtig nahm er jedes Buch in die linke Hand, staubte es mit seinem Stofftaschentuch – Papiertaschentücher verabscheute er – vorsichtig ab und stellte es, ohne daß der untere Bücherrand über das Regalbrett schurrte, andächtig auf sein Bücherbord.“"
                            },
                            {
                                "example_id": "be3eeefa-266f-453b-93a8-9d983f35f066",
                                "sense_id": "5b480bbc-fa44-37ec-9199-d89b84725b2d",
                                "text": "„In den Regalen waren die Waren verteilt, sie nahmen mehr Platz ein, als sie eigentlich brauchten; als ich klein war, hatten sich die Regalbretter unter der Last gebogen, der Tresen war bis zur letzten Schublade vollgestopft gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
