                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers ont monté un <w>piquet</w> de grève dès l'aube devant la grille principale de l'usine."
                        },
                        {
                            "text": "Aucun camion de livraison n'a pu traverser le <w>piquet</w> tenu fermement par les employés en grève."
