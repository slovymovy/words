                                        "sense_id": "765bce13-27dc-3691-ade5-07de5723fdf7",
                                        "entry_id": "87fb5423-38a2-3a89-a1f7-698e6baf0ddf",
                                        "glosses": [
                                            "A topgallant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
