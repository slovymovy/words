                "senses": [
                    {
                        "sense_id": "c9720d40-f367-3380-8622-c9fd7febb7e1",
                        "entry_id": "d4a5dc35-4ab7-3bcb-9520-00df81b56b6b",
                        "glosses": [
                            "weibliche Person, die einem Büro vorsteht, es leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23fb9f4c-05ce-477b-968f-6d32c363effb",
                                "sense_id": "c9720d40-f367-3380-8622-c9fd7febb7e1",
                                "text": "„Andrea Voßhoff stammt aus einer Schifferfamilie und zog 1991 nach Rathenow (Brandenburg), wo sie im Notarbüro ihres Ehemannes als Bürovorsteherin arbeitete, bevor sie 1998 über die Landesliste in den Bundestag einzog.“"
                            },
                            {
                                "example_id": "ac6140e0-daaa-499d-9c3c-08593dfd4551",
                                "sense_id": "c9720d40-f367-3380-8622-c9fd7febb7e1",
                                "text": "„Sie ist Mitglied der Schwedischen Volkspartei, studierte Betriebswirtschaft und arbeitete als Bürovorsteherin und im Vorstand finnischer Unternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
