                "senses": [
                    {
                        "sense_id": "2499a565-b3c3-348f-9072-a62688deac56",
                        "entry_id": "8328d050-8eed-35f3-b718-007e37097e5b",
                        "glosses": [
                            "муз. то же, что нотная грамота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a928b096-2596-4aa9-952a-e402701f38cd",
                                "sense_id": "2499a565-b3c3-348f-9072-a62688deac56",
                                "text": "С нашим педагогом дети осваивают ноты раньше, чем алфавит."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fccd9f3-1ca8-3b76-b03a-c01afd7af75a",
                        "entry_id": "8328d050-8eed-35f3-b718-007e37097e5b",
                        "glosses": [
                            "муз. то же, что нотная запись; графическая запись музыкального произведения нотами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b229a05c-8756-4033-a830-f5b5962d7825",
                                "sense_id": "1fccd9f3-1ca8-3b76-b03a-c01afd7af75a",
                                "text": "Ноты Берга легко узнать по изобилию динамических обозначений."
                            },
                            {
                                "example_id": "6dc3c3a9-541e-487c-a360-55069676012b",
                                "sense_id": "1fccd9f3-1ca8-3b76-b03a-c01afd7af75a",
                                "text": "Играть по нотам."
                            }
                        ]
                    },
                    {
                        "sense_id": "e46a5b53-6c82-3c3d-b804-ecc57572ae5d",
                        "entry_id": "8328d050-8eed-35f3-b718-007e37097e5b",
                        "glosses": [
                            "муз. то же, что нотное издание; книга, содержащая нотную запись"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9fb436-203c-45dd-9297-8372f101d883",
                                "sense_id": "e46a5b53-6c82-3c3d-b804-ecc57572ae5d",
                                "text": "Ноты продаются в книжном магазине рядом с детской литературой."
                            },
                            {
                                "example_id": "d6c16a2d-f960-4925-adec-0b79c6592721",
                                "sense_id": "e46a5b53-6c82-3c3d-b804-ecc57572ae5d",
                                "text": "Издавать ноты."
                            }
                        ]
                    }
