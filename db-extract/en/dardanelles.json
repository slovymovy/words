                        "cross_references": [
                            {
                                "target_word": "Dardanelles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b63462d4-b3e4-30fd-8939-3a6103be0e4b",
                                        "entry_id": "862061c5-0994-3470-9117-aebc080cdc2c",
                                        "glosses": [
                                            "Détroit, passage maritime reliant la mer Égée à la mer de Marmara."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ab2f75-2b39-4e1c-8cf8-06eabfbd4340",
                                                "sense_id": "b63462d4-b3e4-30fd-8939-3a6103be0e4b",
                                                "text": "J’ai ouï-dire qu’en mars dernier il fut sérieusement question, dans les milieux maritimes, d’envoyer une brigade aux Dardanelles."
                                            },
                                            {
                                                "example_id": "339b9880-43f2-49d3-86d7-7e43ca835f0d",
                                                "sense_id": "b63462d4-b3e4-30fd-8939-3a6103be0e4b",
                                                "text": "Elle avait eu deux beaux enfants de ce matelot, la Clémence, puis la chienne de guerre, la grande, était arrivée, expédiant le Paul aux Dardanelles, dans les pays là-bas comme on disait, aux cinq cents diables quoi !"
                                            },
                                            {
                                                "example_id": "6c9fadf9-9ad1-479c-a509-2d249ee9820e",
                                                "sense_id": "b63462d4-b3e4-30fd-8939-3a6103be0e4b",
                                                "text": "Le site, situé dans la péninsule de Gallipoli, dans le nord-ouest de la Turquie, fut le théâtre de la féroce bataille des Dardanelles ayant opposé les troupes britanniques (constituées pour partie de soldats australiens et néo-zélandais) et françaises aux forces ottomanes soutenues par l’Allemagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08de2eec-c14b-3630-99c2-d6497161231e",
                                        "entry_id": "862061c5-0994-3470-9117-aebc080cdc2c",
                                        "glosses": [
                                            "Région située aux alentours de ce détroit."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b7fa46d-12cb-44db-b4c9-e1fc85add8c7",
                        "source_entry_id": "2f265467-572a-35cd-a74d-d01dbd057440",
                        "source_sense_id": "9fc0adac-b931-3c2a-b471-4034f5ea7718",
