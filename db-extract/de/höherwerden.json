                "senses": [
                    {
                        "sense_id": "b92a642b-9618-3413-83a6-1655fe138742",
                        "entry_id": "d62110e6-cab4-3197-8dd5-83d0f493820c",
                        "glosses": [
                            "Ereignis, Handlung oder Maßnahme, die Höhe von etwas (einer Sache, eines Preises, eines Tones usw.) zu steigern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9cef985-e987-40bb-a0b7-22897b504283",
                                "sense_id": "b92a642b-9618-3413-83a6-1655fe138742",
                                "text": "„Spannt man beide Saiten gleich stark, so kann man durch Verkürzen einer Saite das Höherwerden ihres Tones zeigen.“"
                            },
                            {
                                "example_id": "673c54f8-9d6a-4572-86d9-c6b0082d96c8",
                                "sense_id": "b92a642b-9618-3413-83a6-1655fe138742",
                                "text": "„Ein gewisses Höherwerden der Fleischpreise findet sich übrigens in nnd ganz besonders nach den meisten Theuerungsjahren.“"
                            },
                            {
                                "example_id": "e5e934af-1e6b-4699-9aa0-9aef047811c6",
                                "sense_id": "b92a642b-9618-3413-83a6-1655fe138742",
                                "text": "„Dabei geht es nicht nur um das ständige Höherwerden der Wolke, sondern gleichfalls um eine immense Zunahme ihres Volumens.“"
                            },
                            {
                                "example_id": "2e936545-e616-4e21-9ac1-2d8849659e9d",
                                "sense_id": "b92a642b-9618-3413-83a6-1655fe138742",
                                "text": "„Ich hörte das Rotieren der Helikopterflügel und das Höherwerden seiner Motorengeräusche beim neuerlichen Abdrehen.“"
                            },
                            {
                                "example_id": "5eb085a2-081f-4ba2-ba6e-81ac082ce652",
                                "sense_id": "b92a642b-9618-3413-83a6-1655fe138742",
                                "text": "„Das Wachstum besteht nicht in einem Höherwerden des Charakters, sondern in einem Längerwerden des Titels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
