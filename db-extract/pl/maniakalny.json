                                                "sense_id": "9514655a-5758-3a15-adc3-824e4ccfbd66",
                                                "text": "C’est un maniaque."
                                            },
                                            {
                                                "example_id": "3bd60295-cbd9-44de-a507-db980070e0dc",
                                                "sense_id": "9514655a-5758-3a15-adc3-824e4ccfbd66",
