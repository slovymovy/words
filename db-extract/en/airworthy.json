                    {
                        "translation_id": "519ce57d-a073-48a9-b67e-d52e3ec1146c",
                        "source_entry_id": "88e2f402-0248-3adf-a903-a61f4035b02f",
                        "source_sense_id": "7c574cf0-8fc8-3bb9-bf41-a433b8c18664",
                        "source_sense_description": "meeting standards for safe flight",
                        "target_lang_word": "flugtauglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flugtauglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5897f20c-5602-3b3f-b37e-d29dbb41bbde",
                                        "entry_id": "94c391a3-1950-39e6-ab1c-33e765f17b03",
                                        "glosses": [
                                            "in der Lage, zu fliegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e220992-6099-4819-99db-4ca2cea55ba6",
                                                "sense_id": "5897f20c-5602-3b3f-b37e-d29dbb41bbde",
                                                "text": "„Während unserer Abwesenheit hatten Pabodie, Sherman, Ropes, McTighe und Williamson fieberhaft an zweien von Lakes am besten erhaltenen Flugzeugen geschraubt und sie wieder flugtauglich gemacht, trotz der völlig unerklärlichen Beschädigungen einiger wichtiger Funktionsteile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbd6be74-f1ef-4c7f-a0d7-d481e44f9ce8",
                        "source_entry_id": "88e2f402-0248-3adf-a903-a61f4035b02f",
                        "source_sense_id": "7c574cf0-8fc8-3bb9-bf41-a433b8c18664",
                        "source_sense_description": "meeting standards for safe flight",
                        "target_lang_word": "flugfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flugfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37e90dbb-cc20-32d9-bddf-06e2f00479d1",
                                        "entry_id": "1d1f2000-17cd-3918-8c88-dbdaee060bc6",
                                        "glosses": [
                                            "fähig zu fliegen oder zum Fliegen gebracht zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052677e0-6631-4d3c-afca-26fe2038eb53",
                                                "sense_id": "37e90dbb-cc20-32d9-bddf-06e2f00479d1",
                                                "text": "„Bei Jane’s geht man von etwa 370 Jets aus, von denen nur ein Teil jederzeit flugfähig ist.“"
                                            },
                                            {
                                                "example_id": "40bd4961-d48e-4065-8eb1-6202ae7da14d",
                                                "sense_id": "37e90dbb-cc20-32d9-bddf-06e2f00479d1",
                                                "text": "„Pilz hat diese Woche gefordert, die Eurofighter an EADS zurückzugeben, notfalls per Bahnfracht, weil nur noch drei der 15 Düsenjäger überhaupt flugfähig seien.“"
                                            },
                                            {
                                                "example_id": "ab853444-eba8-4194-b822-17970b269aa3",
                                                "sense_id": "37e90dbb-cc20-32d9-bddf-06e2f00479d1",
                                                "text": "„Beide Projekte führten innerhalb weniger Jahre zur Entwicklung flugfähiger Prototypen, die alle Erwartungen erfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
