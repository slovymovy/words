                        "cross_references": [
                            {
                                "target_word": "Saint-Brieuc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a82f7712-65b7-36ef-9a8d-416e6705bc4f",
                                        "entry_id": "967ef550-c558-38b4-b7e0-d0873a6f07f5",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, située dans le département des Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d93cf37-4af7-42ce-87a1-ee1d53326198",
                                                "sense_id": "a82f7712-65b7-36ef-9a8d-416e6705bc4f",
                                                "text": "Mais, à Guingamp, les journaux ne sont pas encore arrivés ; à Saint-Brieuc ils sont bien arrivés : seulement il n’en reste plus un numéro à la marchande ; le Briochins l’ont dépouillée avant nous."
                                            },
                                            {
                                                "example_id": "04d9fdc9-4271-4743-9688-a723efd3a494",
                                                "sense_id": "a82f7712-65b7-36ef-9a8d-416e6705bc4f",
                                                "text": "Plus modeste, avec un chiffre d’affaires de l’ordre de 400 millions mais un effectif salarié supérieur à 600, Stalaven présente l’originalité de compter, outre la charcuterie-salaison initiale de Saint-Brieuc et la saladerie industrielle d’Yffiniac, deux unités de plats cuisinés implantées hors de la Bretagne, l’une à Dunkerque, l’autre à Brisbane en Australie."
                                            },
                                            {
                                                "example_id": "4ba82813-7b45-47aa-a165-73224fe26408",
                                                "sense_id": "a82f7712-65b7-36ef-9a8d-416e6705bc4f",
                                                "text": "Dans les seuls évêchés de Dol, Saint-Malo et Saint-Brieuc, quatorze feudataires dont les revenus nobles propres allaient de 1500 à 40 livres monnaie appartenaient à la maison du vicomte de Rohan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
