                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4bfba141-301a-38b8-ac3d-49e714dc3c93",
                        "entry_id": "e2bcddec-655e-3e94-b746-99a8846be036",
                        "glosses": [
                            "Bundesstaat, der sich nach der Abspaltung der Südstaaten 1860/1861 weiterhin zu den Vereinigten Staaten bekannte"
                        ],
                        "tags": [
                            "historical",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "aa6a1250-5af8-4635-b7ca-d116fbd7b80b",
                                "sense_id": "4bfba141-301a-38b8-ac3d-49e714dc3c93",
                                "text": "„Die Nordstaaten setzten zwar ebenfalls auf Kriegsanleihen, behielten aber die Kontrolle über die Geldmenge.“"
                            },
                            {
                                "example_id": "5f4c1635-b96d-4de9-8e6a-44ba35dc0bc7",
                                "sense_id": "4bfba141-301a-38b8-ac3d-49e714dc3c93",
                                "text": "„Die Zeitungen der Nordstaaten stellen eine tatsächliche Macht dar, und ihre Korrespondenten sind angesehene Leute, auf deren Stimme man etwas gibt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ef16a583-e347-3c10-a6b2-06a393b70cd8",
                        "entry_id": "e2bcddec-655e-3e94-b746-99a8846be036",
                        "glosses": [
                            "mögliches Bundesland, das durch eine Neugliederung der bestehenden nördlichen Länder gebildet werden könnte"
                        ],
