                ],
                "senses": [
                    {
                        "sense_id": "ab838e92-e55a-33b3-a643-6e4710efff4e",
                        "entry_id": "10b3bb25-8a34-3d10-b251-6aefa479c070",
                        "glosses": [
                            "Action de jaillir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79ab832-5c8d-4eed-ad9b-89947130937b",
                                "sense_id": "ab838e92-e55a-33b3-a643-6e4710efff4e",
                                "text": "Quel que soit le mode de captage ou de jaillissement, l’eau minérale arrive toujours aux robinets de distribution, par des conduites à l’abri de toute contamination."
                            },
                            {
                                "example_id": "fc21dd39-67e0-43eb-9013-2545a03291b9",
                                "sense_id": "ab838e92-e55a-33b3-a643-6e4710efff4e",
                                "text": "Le jaillissement du sang."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f25e40a-faab-3955-a75a-ef8ce26942ae",
                        "entry_id": "10b3bb25-8a34-3d10-b251-6aefa479c070",
                        "glosses": [
                            "Émergence soudaine."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "27f7e0d9-fc44-489e-b941-20ee69be5a22",
                                "sense_id": "9f25e40a-faab-3955-a75a-ef8ce26942ae",
                                "text": "Un perpétuel jaillissement d’idées."
                            },
                            {
                                "example_id": "fec177f8-3a05-4320-a47e-c2a0e61fd72a",
                                "sense_id": "9f25e40a-faab-3955-a75a-ef8ce26942ae",
                                "text": "Tels, sur nos yeux sans flamme et sur nos fronts courbés,\nSans relâche, mes sœurs, les siècles sont tombés,\nDès l’heure où le premier jaillissement des âges\nD’une écume glacée a lavé nos visages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b978bc22-8f30-40e2-8bfa-75922720791c",
                        "source_entry_id": "10b3bb25-8a34-3d10-b251-6aefa479c070",
                        "target_lang_word": "eruption",
