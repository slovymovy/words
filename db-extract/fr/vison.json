                                "target_senses": [
                                    {
                                        "sense_id": "1f262a40-b139-3ea4-bf48-7bc96d236f0c",
                                        "entry_id": "f531b249-8852-30b1-af2e-e9d751d9edd7",
                                        "glosses": [
                                            "уменьш. к нора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248ccdf3-9637-4cef-8c40-a12c67ae8f7a",
                                                "sense_id": "1f262a40-b139-3ea4-bf48-7bc96d236f0c",
                                                "text": "Фенечки словно на свете не бывало; она сидела в своей комнатке, как мышонок в норке."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "но́рка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3f2153-2ee7-32eb-ad46-824f8b04a713",
                                        "entry_id": "8b6ce8c2-6413-3a8a-bfac-8532b05fc240",
                                        "glosses": [
                                            "зоол. хищный пушной зверёк с густой блестящей шерстью из семейства куньих (Mustela)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d6bd0e-9aa9-4a1b-9972-b8e112aabaab",
                                                "sense_id": "5c3f2153-2ee7-32eb-ad46-824f8b04a713",
                                                "text": "А на звероводческих фермах разводят серебристо-чёрных лисиц, голубых песцов, цветных норок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0404276e-799a-3a90-93b4-e9c2fe23e626",
                                        "entry_id": "8b6ce8c2-6413-3a8a-bfac-8532b05fc240",
                                        "glosses": [
                                            "мех этого зверька"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97c56ee-05a3-474c-9824-d0f43a4b9147",
                                                "sense_id": "0404276e-799a-3a90-93b4-e9c2fe23e626",
                                                "text": "К нему прилагалось и меховое манто из норки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ffdc58f-9110-3e39-8569-bb71cbf72e8f",
                                        "entry_id": "8b6ce8c2-6413-3a8a-bfac-8532b05fc240",
                                        "glosses": [
                                            "разг. изделие из такого меха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f074b9-6ce6-475e-b055-74694a1a0c2a",
                                                "sense_id": "8ffdc58f-9110-3e39-8569-bb71cbf72e8f",
                                                "text": "— Так что вы хотели купить? Норку, песца, или у вас ещё какие-то варианты? — Вы знаете, я оптовик, мне нужно купить несколько шуб, около двух десятков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
