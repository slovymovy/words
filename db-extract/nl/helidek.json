                        "glosses": [
                            "platform waarop een helikopter kan landen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a1157e-8095-470c-a0af-d2dcd8721701",
                                "sense_id": "12363616-d455-3892-aa0c-e4db1b8289d6",
                                "text": "Het MST is het traumacentrum voor Twente en de Achterhoek. Patiënten met ernstige trauma's, onder meer als gevolg van verkeersongelukken, worden per ambulance of per helikopter naar het MST gebracht, dat met een helidek is uitgerust."
                            },
                            {
                                "example_id": "0f0a1db0-49e4-4598-8e72-a9f13a048d62",
                                "sense_id": "12363616-d455-3892-aa0c-e4db1b8289d6",
                                "text": "De NH90-helikopter die Defensie gebruikt voor patiëntenvervoer van de Waddeneilanden naar het vasteland, kan niet landen bij het Universitair Medisch Centrum Groningen (UMCG). De NH90 is te zwaar voor het helidek van het ziekenhuis, zegt een woordvoerster van het UMCG donderdag."
                            }
                        ]
                    }
