                                            {
                                                "example_id": "287f77f4-481c-41e5-aae1-b94624df82f6",
                                                "sense_id": "99d03cb4-48ed-3a99-b4f5-410e2af93393",
                                                "text": "„Wird Anilin mit Essigsäure zusammengebracht, so verbinden sich beide zu essigsaurem Anilin, welche Verbindung beim Erhitzen in Wasser und Acetanilid zerfällt.“"
                                            }
                                        ],
