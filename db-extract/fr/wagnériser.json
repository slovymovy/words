                ],
                "senses": [
                    {
                        "sense_id": "badfe4e5-ff60-3661-ac61-4dff1c006434",
                        "entry_id": "81e3dec4-fe2f-37b4-bb4e-b67efec85f1c",
                        "glosses": [
                            "Donner un caractère wagnérien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ac4749-91b3-4f19-9f61-2f820c2626bd",
                                "sense_id": "badfe4e5-ff60-3661-ac61-4dff1c006434",
                                "text": "C’est une tentative de wagnériser le morceau?"
                            },
                            {
                                "example_id": "183ad5a4-0c1b-4097-b20e-edf2e4549cf8",
                                "sense_id": "badfe4e5-ff60-3661-ac61-4dff1c006434",
                                "text": "Vous ne pouvez nier que vous aussi avez été un certain temps considérablement wagnérisé."
                            },
                            {
                                "example_id": "51e6bd49-ffe2-4a17-b820-47885b471086",
                                "sense_id": "badfe4e5-ff60-3661-ac61-4dff1c006434",
                                "text": "Mais il ne serait pas l’inquiet que nous avons montré qu’il était, si tout de suite il n’avait l’angoisse de se wagnériser…"
                            }
                        ]
                    },
                    {
                        "sense_id": "de399cf2-c221-3137-b887-6703819a340a",
                        "entry_id": "81e3dec4-fe2f-37b4-bb4e-b67efec85f1c",
                        "glosses": [
                            "Imiter Richard Wagner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2058d9ce-9b6a-44ad-948f-1255bbce0c12",
                                "sense_id": "de399cf2-c221-3137-b887-6703819a340a",
                                "text": "On ne peut, après lui, que « wagnériser », « mozartiser », etc., ce que font tous les compositeurs contemporains, de l’avant-garde aux variétés."
                            }
                        ]
                    }
                ],
