                        ],
                        "examples": [
                            {
                                "example_id": "9836d88e-a585-4289-8278-5087cbb6a00b",
                                "sense_id": "c1a03c3c-9533-3266-8a86-747e69977a7e",
                                "text": "Hans Klawincker, floruit 1586-1635 w Norymberdze, w Niemczech"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1965cc9e-24e2-45b8-8f1a-8395818c827f",
                        "source_entry_id": "f24f4329-cee8-3003-8972-68574a628e2c",
                        "source_sense_id": "c1a03c3c-9533-3266-8a86-747e69977a7e",
                        "target_lang_word": "floruit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floruit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7c2273-b045-363f-96df-e921eafbe2b8",
                                        "entry_id": "bbaeee23-abcf-3748-906a-02b5fd00e1d7",
                                        "glosses": [
                                            "lived, used in biographies to indicate a time period during which a person is known to have been alive, when dates of birth and/or death are not known."
                                        ],
                                        "tags": [
                                            "defective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5135eebd-3a71-4bcd-8e4a-f4c8bba41264",
                                                "sense_id": "ea7c2273-b045-363f-96df-e921eafbe2b8",
                                                "text": "Marius Mercator must have shared the vigour of Alcimus, for he floruit in 218 according to Mr. Miller , while he at any rate existed in 418."
                                            },
                                            {
                                                "example_id": "8606e680-2f4c-4fbb-b9eb-e6e6b5b52697",
                                                "sense_id": "ea7c2273-b045-363f-96df-e921eafbe2b8",
                                                "text": "J. Joyce (floruit 1850)\nIn 1926 Svevo wrote a letter to James Joyce in Paris inquiring if he were related to the J. Joyce who in 1850 had had printed and published by Lloyd Austriaco in Trieste a book[...]"
                                            },
                                            {
                                                "example_id": "1bbb9bbd-ce10-4146-9f7a-2cd1cf721a56",
                                                "sense_id": "ea7c2273-b045-363f-96df-e921eafbe2b8",
                                                "text": "Mīrā (Bai). Floruit 16th century. Rajasthan's most famous female saint and poetess of Kṛṣṇa bhakti."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "floruit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf7939c-a0d8-35b8-8cf0-24206ec2bc77",
                                        "entry_id": "71b95f6f-66ae-3701-8b2c-a96b29512a23",
                                        "glosses": [
                                            "The time period during which a person, group, culture, etc. is at its peak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6d4c51-12c7-4ebd-a3a8-a536f28c24e0",
                                                "sense_id": "1cf7939c-a0d8-35b8-8cf0-24206ec2bc77",
                                                "text": "Though Aristotle claimed that a human being reaches his intellectual peak at age forty-nine (Rhetoric 1390b9), chronologists reckon a person's flowering—his floruit—at about age forty. The mists of time have made the precise reckoning of chronology quite difficult. Sometimes, when a birth is not known, a floruit can be estimated on the basis of what is known about an individual's career."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
