                "senses": [
                    {
                        "sense_id": "063f6a27-22a0-38ae-bd92-ad3d12a943a3",
                        "entry_id": "36b330da-12d8-3154-b2f0-be654ad72363",
                        "glosses": [
                            "техн. предназначенный, служащий для отлива, откачивания воды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ee21c6-d9fb-4444-b727-d73df99d196e",
                                "sense_id": "063f6a27-22a0-38ae-bd92-ad3d12a943a3",
                                "text": "А дальше им остается только осушить эти отсеки водоотливными средствами, и авария будет окончательно устранена."
                            },
                            {
                                "example_id": "0c37ab5f-1b30-4c9f-9cdd-35b06142e31c",
                                "sense_id": "063f6a27-22a0-38ae-bd92-ad3d12a943a3",
                                "text": "Вода или выкачивается из рудников посредством особых водоотливных машин, или отводится в нарочно устроенные для этого протоки."
                            }
                        ]
                    }
