                        "examples": [
                            {
                                "example_id": "63e7e7c8-eb65-469a-a3d4-b85ab2e6e72c",
                                "sense_id": "208a50cf-a078-3291-91bb-620ccfd8be82",
                                "text": "— Посмотри́-кася, каку́ю циду́лу мне Пе́тька Шестикры́лов присла́л, — сказа́л он, подава́я Ни́ткину пове́стку. — К себе́ в четве́рг зовёт… Пое́дешь со мной?",
                                "translation": "“Take a look at what sort of missive Petka Sixwingsky has sent me,” he said, handing Nitkin the summons. “He’s inviting me for Thursday…Will you come with me?”",
                                "english": "“Take a look at what sort of missive Petka Sixwingsky has sent me,” he said, handing Nitkin the summons. “He’s inviting me for Thursday…Will you come with me?”"
                            }
                        ]
