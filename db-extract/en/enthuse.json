                "senses": [
                    {
                        "sense_id": "7ad9b607-dade-3d2d-9cb2-81cba13cd8ac",
                        "entry_id": "b90d2884-2583-325d-981f-465084823e72",
                        "glosses": [
                            "To show enthusiasm."
                        ],
                        "tags": [
                            "colloquial",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "927f8562-0871-41bc-aa69-030b0e37f6d1",
                                "sense_id": "7ad9b607-dade-3d2d-9cb2-81cba13cd8ac",
                                "text": "a splendid performance, and I was enthusing over it"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4ef1d73-345e-3d93-a91b-c27383f099ea",
                        "entry_id": "b90d2884-2583-325d-981f-465084823e72",
                        "glosses": [
                            "To cause (someone) to feel enthusiasm or to be enthusiastic."
                        ],
                        "tags": [
                            "humorous",
                            "proscribed",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "212ad6bf-87bc-487a-905d-eccd446384dc",
                                "sense_id": "f4ef1d73-345e-3d93-a91b-c27383f099ea",
                                "text": "The novelty of the film enthused the audience."
                            },
                            {
                                "example_id": "9695bfa7-58f5-4f76-bf4a-c2505b417504",
                                "sense_id": "f4ef1d73-345e-3d93-a91b-c27383f099ea",
                                "text": "One of the museum's greatest strengths is its focus on educating and enthusing children from an early age, and it's something that Mullins is especially proud of."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1df7d026-86b5-4420-bb54-32434404d242",
                        "source_entry_id": "b90d2884-2583-325d-981f-465084823e72",
                        "source_sense_description": "to feel enthusiasm",
                        "target_lang_word": "begeistern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begeistern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff7cdcb-34b4-3205-a6a8-5e4a30a22517",
                                        "entry_id": "c33daf48-3486-3672-aa70-93289b29d6eb",
                                        "glosses": [
                                            "jemanden in große freudige Erregung versetzen; jemandem Hoffnung geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0fe2c2e-0fa5-42c0-adf8-8765611377d8",
                                                "sense_id": "2ff7cdcb-34b4-3205-a6a8-5e4a30a22517",
                                                "text": "Deine Ruhe und Gelassenheit im Umgang mit Kindern begeistert mich."
                                            },
                                            {
                                                "example_id": "3a881729-c215-4c1a-8722-5f39e6e9ba0c",
                                                "sense_id": "2ff7cdcb-34b4-3205-a6a8-5e4a30a22517",
                                                "text": "Wir waren von der Ausstellung ganz begeistert, ich kann sie nur jedem empfehlen."
                                            },
                                            {
                                                "example_id": "0669a91c-8503-4d58-a054-8a0b2f2b1959",
                                                "sense_id": "2ff7cdcb-34b4-3205-a6a8-5e4a30a22517",
                                                "text": "Sie hat so eine Art, wie sie auch pubertierende Teenager noch begeistern kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d60f3fcf-8e52-35bd-887e-086abb9ae0cb",
                                        "entry_id": "c33daf48-3486-3672-aa70-93289b29d6eb",
                                        "glosses": [
                                            "sich für etwas sehr interessieren"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d5f48e-ab61-41da-acd7-55b3ed7f7a95",
                                                "sense_id": "d60f3fcf-8e52-35bd-887e-086abb9ae0cb",
                                                "text": "Fernando Botero begeistert sich für Kunst."
                                            },
                                            {
                                                "example_id": "8fb53526-942b-433f-8226-56b480add3b7",
                                                "sense_id": "d60f3fcf-8e52-35bd-887e-086abb9ae0cb",
                                                "text": "Und wofür begeisterst du dich so?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
