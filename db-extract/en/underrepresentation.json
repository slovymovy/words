                        "source_sense_id": "08def920-c173-39ff-a80b-d3268a714585",
                        "source_sense_description": "Translations",
                        "target_lang_word": "ondervertegenwoordiging",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ondervertegenwoordiging",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a5d5eb85-736b-3321-ba59-72845eccf09b",
                                        "entry_id": "cf017cf7-17e0-33dc-80c0-c45bd8597783",
                                        "glosses": [
                                            "het relatief weinig voorkomen van bepaalde delen van de bevolking in bepaalde functies"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f142a386-5fcc-45dd-b365-2d889df673ab",
                                                "sense_id": "a5d5eb85-736b-3321-ba59-72845eccf09b",
                                                "text": "Haar besluit is duidelijk: als je het aantal vrouwen en mannen telt die voor de Vlaamse overheid werken, krijg je in het algemeen een evenwicht. Maar zowel het midden- als het topkader vormt een uitzondering. Daar is sprake van een historische ondervertegenwoordiging van vrouwen. En die geschiedenis zet zich tot op vandaag door."
                                            },
                                            {
                                                "example_id": "1dfc12b9-1de8-416f-bcc0-5c91c200e0e5",
                                                "sense_id": "a5d5eb85-736b-3321-ba59-72845eccf09b",
                                                "text": "De ondervertegenwoordiging komt vooral doordat weinig niet-westerse allochtonen kiezen voor de journalistiek, bevestigen opleidingen in Amsterdam en Utrecht.\nEen betere afspiegeling zou mooi zijn, zeggen de ondervraagden, maar ze doen er niets aan. De hoofdredacteuren zien de situatie als onvermijdelijk. Quota of voorkeursbeleid zien ze niet zitten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24851e1e-b290-47fb-9373-d3980fc6c5e1",
                        "source_entry_id": "621f0d99-6bf9-38d3-8485-f2411a72a825",
                        "source_sense_id": "08def920-c173-39ff-a80b-d3268a714585",
                        "source_sense_description": "Translations",
                        "target_lang_word": "sous-représentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-représentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47b00a81-1f95-3a22-8ee3-5326d102022e",
                                        "entry_id": "e9b59846-33b4-312f-9fde-b91d39d4e796",
                                        "glosses": [
                                            "Fait de représenter de façon inférieure à ce que demanderait la logique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20f3bf0-05c9-426a-934e-79cb9241c56f",
                                                "sense_id": "47b00a81-1f95-3a22-8ee3-5326d102022e",
                                                "text": "Des scientifiques dénoncent la sous-représentation des plantes, des champignons et des micro-organismes parmi les émojis proposés aux utilisateurs."
                                            },
                                            {
                                                "example_id": "4dadd029-0b78-4cb9-832f-69d2f93c8f0c",
                                                "sense_id": "47b00a81-1f95-3a22-8ee3-5326d102022e",
                                                "text": "Le problème de la sous-représentation féminine a donc été présenté de deux manières très différentes en Suisse et en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "187b916e-d0bb-386d-924a-40573e000cd8",
