                                        "entry_id": "b03a0f48-f125-3b00-9335-50fb885ec5d3",
                                        "glosses": [
                                            "Breuvage, médicament ou toute autre chose qui réconforte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
