                                    {
                                        "sense_id": "a511a707-b39c-358c-b862-ab6f9be0abbb",
                                        "entry_id": "87ae11fe-1869-3d08-a072-4d992e72e4c9",
                                        "glosses": [
                                            "Hacer girar una puerta hasta separarla de su marco."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a769b38e-0559-4a20-95a4-7025c19536bd",
                                                "sense_id": "a511a707-b39c-358c-b862-ab6f9be0abbb",
                                                "text": "¿Y a qué hora abre el museo?"
                                            },
                                            {
                                                "example_id": "7acd3ac2-7b81-4a29-8106-f0018a5c3506",
                                                "sense_id": "a511a707-b39c-358c-b862-ab6f9be0abbb",
                                                "text": "El primer club republicano se abrió en Alicante alrededor de noviembre de 1868, y esta tendencia política triunfó en las elecciones municipales de 1870."
                                            },
                                            {
                                                "example_id": "c48b14ad-8eff-4e64-beb0-6eb1e81a7e14",
                                                "sense_id": "a511a707-b39c-358c-b862-ab6f9be0abbb",
                                                "text": "Se considera a Orson Welles como precursor del cine moderno, adelantado a su época, que abrió las puertas para que los jóvenes realizadores americanos realizaran décadas después estos cambios."
                                            },
                                            {
                                                "example_id": "55aa89f8-b092-46c5-b5f8-f2ff0b9c6c0f",
                                                "sense_id": "a511a707-b39c-358c-b862-ab6f9be0abbb",
                                                "text": "El primer cibercafé en Londres fue el Café Cyberia que abrió sus puertas en septiembre de 1994."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9694e6a5-7d01-3560-9fc7-c74362c6f1c0",
                                        "entry_id": "87ae11fe-1869-3d08-a072-4d992e72e4c9",
                                        "glosses": [
                                            "Separar del marco la hoja o las hojas que tienen una puerta o una ventana, haciéndolas girar sobre sus herrajes."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
