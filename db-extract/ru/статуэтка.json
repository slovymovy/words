                    {
                        "form_id": "4bc54b53-0251-4bd1-98a2-3643d1196def",
                        "entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "статуэ́тках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                        "entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "glosses": [
                            "небольшая скульптурная фигурка, обычно служащая комнатным украшением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5bd2893-c640-45db-b205-98af2c3a6f8c",
                                "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                "text": "Я вам вышью феску, а вы мне… позвольте, вы мне подарите ту статуэтку из терракоты, помните, — ребёнка, который снимает с ноги чулок и падает."
                            },
                            {
                                "example_id": "98e9b2c0-98d3-4845-a45a-16cec6a8b12f",
                                "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                "text": "Я просто хочу любоваться тобой, как статуэткой."
                            },
                            {
                                "example_id": "9807f302-a15e-44d3-adcd-ae98fcfa1de5",
                                "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                "text": "Храм был заставлен жертвенниками, многорукими статуями, этажерками с грудами статуэток бодисатв."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99b2ac9a-770a-4055-974f-10f6b389bddf",
                        "source_entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "source_sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                        "target_lang_word": "statuette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                        "entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                                        "glosses": [
                                            "A small statue, usually a figure much less than life size, especially when of marble or bronze, or of plaster or clay as a preparation for the marble or bronze, as distinguished from a figure in terra cotta etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1179c4-a395-4a8c-952d-79679cb2c569",
                                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                                "text": "[…] may be discovered not far from a charming statuette of Queen Alexandra, and there is also the figurette of King George's elder brother."
                                            },
                                            {
                                                "example_id": "a7e3b7e2-9ff9-431d-a000-3c5f32bacf4e",
                                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                                "text": "Some statuettes are not monochrome but represent characters. That is why they are called nanofigures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78fad9e5-d5fb-48ff-b187-2cb00286b59a",
                        "source_entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "source_sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                        "target_lang_word": "figurine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                        "entry_id": "46f6a49a-bdfc-32cb-83b6-240067a65994",
                                        "glosses": [
                                            "A small carved or molded figure; a statuette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f37ed64-266d-48a0-9dc0-ee989a10ac57",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "Galvanised by this knowledge, the figurine family take to exercise and healthy eating in the park, forming themselves into the key words \"Eat\" (better), \"Move\" (more) and \"Live\" (longer) of the government's urgings and soon the municipal landscape is filled with other happy, healthier families who, incidentally, look even more delicious en masse."
                                            },
                                            {
                                                "example_id": "352f8ba8-3d16-4d08-acda-568b639cbe5a",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "While figurines were an integral part of Late Neolithic and Early Copper Age life, they disappear from society until the later Nuragic period.[…]The lack of figurines is a conscious choice, as is the decision to produce over 500 bronze figurines (bronzetti) in phases III and IV of the Nuragic period."
                                            },
                                            {
                                                "example_id": "17394593-3b3f-48ac-8b5a-75777649bab4",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "For the abbreviation of the name of the pieces, each player is free to use the name which is commonly used in his/her country. Examples: F = fou (French for bishop), L = loper (Dutch for bishop). In printed periodicals, the use of figurines is recommended."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa6dd49-d0aa-49ea-a089-67a86cbe4321",
                        "source_entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "source_sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                        "target_lang_word": "Statuette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Statuette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                        "entry_id": "b982b5cf-c76b-3ec2-bf4f-91ea8690dbcc",
                                        "glosses": [
                                            "kleine Statue"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33ff6f8-488c-498a-b184-0ecf3f3f7e33",
                                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                                "text": "„Kleinplastiken (Figurinen bzw. Statuetten) sind einer der diagnostischen Marker der Donauzivilisation.“"
                                            },
                                            {
                                                "example_id": "aefa0651-463e-443e-a52d-3bea296a0e3c",
                                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                                "text": "„Auf einem Regal stand eine Statuette Unserer Allergnädigsten Majestät zu Pferde.“"
                                            },
                                            {
                                                "example_id": "0757691a-6689-4f1a-b53c-3935d52362e4",
                                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                                "text": "„Er stellte sie sich vor wie Statuetten, die er dann im Wohnzimmer seines Elternhauses plazierte.“"
                                            },
                                            {
                                                "example_id": "b171a594-d595-4a39-96bc-651d76a82d57",
                                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                                "text": "„Im Regal standen nach wie vor die alten Bücher und daneben ein paar Statuetten und alte Bilder, die ihre Mutter dort abstellte, wenn sie im Wohnzimmer keinen Platz fand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2043328-4dce-4e0e-a800-8b822d41b8cc",
                        "source_entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "source_sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                        "target_lang_word": "statuette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                        "entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                                        "glosses": [
                                            "Petite statue."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ebe1c78-8155-42fd-b46b-dc4622185063",
                                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                                "text": "Réexaminons en premier lieu le groupe bien connu des statuettes de terre cuite attiques, conservé à New York, qui révèle une stylisation indéniable des masques comiques dès la fin du Vᵉ siècle av. J.-C."
                                            },
                                            {
                                                "example_id": "21baf6fc-a6bf-45b1-b97b-ff82bc21de4e",
                                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                                "text": "En juin, une statuette anthropomorphe au faciès joufflu en serpentine a ainsi été adjugée pour 399 900 euros chez Binoche et Giquello."
                                            },
                                            {
                                                "example_id": "a448c5f4-49f4-4572-b7d4-7f65e7129ec0",
                                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                                "text": "Commana s’inquiète pour son petit patrimoine : la statuette de la croix de Quillidiec vient de disparaître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edee268e-5f58-45eb-b98f-5dc3091c64fd",
                        "source_entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                        "source_sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                        "target_lang_word": "figurine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08e1b5f6-5770-342c-9330-4d76f558597e",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Petite figure préhistorique ou antique de terre cuite, de bronze, d’argent, etc."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3865c0c0-d245-43b0-8b17-b23a078d11e5",
                                                "sense_id": "08e1b5f6-5770-342c-9330-4d76f558597e",
                                                "text": "Cet amateur a une précieuse collection de figurines."
                                            },
                                            {
                                                "example_id": "1471b0bb-94f8-4e31-861f-6cfb6ae6ee92",
                                                "sense_id": "08e1b5f6-5770-342c-9330-4d76f558597e",
                                                "text": "Sauf une figurine informe trouvée à Solutré et un équidé gravé sur un os provenant de Creswell-Crags (Angleterre), toutes ces ébauches, tous ces essais de gravure ou de sculpture avaient été trouvés dans le midi de la France ; et on pensait que les troglodytes de la Gascogne avaient eu le monopole de l’art, dans les premiers temps où nous pouvons affirmer l’existence de l’homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Statuette."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25aa22e6-1de8-4a70-bcdc-0bf43e805980",
                                                "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                                "text": "Ce tombeau est un monument fort intéressant, bien que la figure du personnage, traitée en bas-relief, soit médiocre ; le simulacre du sarcophage qui la porte donne une série de figurines d’une conservation parfaite, […]."
                                            },
                                            {
                                                "example_id": "9d6e4d8f-1407-46aa-ac42-fc8c281a729d",
                                                "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                                "text": "On peut, mais plus rarement, en rencontrer modelant, parfois avec un instinct sûr, de « rustiques figurines », si originales qu’un musée d’ethnographie pourrait désirer les mettre dans ses vitrines, affirmant ainsi la vérité de cette parole d’un savant archéologue : « Il n’y a pas de différence entre les inventions des Bushmen ou des Hottentots et celles des premiers Grecs. »"
                                            },
                                            {
                                                "example_id": "14a6008e-3824-4693-81bb-951efe8d59e5",
                                                "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                                "text": "Figurines de Saxe, de Sèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b5f628-1b06-3720-89a4-076e847619a5",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Pion ou petit jouet représentant un personnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "803364e0-b64c-4514-bc3c-948a5b8f9e98",
                                                "sense_id": "10b5f628-1b06-3720-89a4-076e847619a5",
                                                "text": "Après un jeu de figurines (encore un) ayant récolté des centaines de millions d’euros via Kickstarter, Conan le Barbare est l’objet de nombreux projets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41df29a4-7217-3d34-a553-48dedeb51ae2",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Petite image en deux dimensions symbolisant une personne ou un usager."
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d9acd2-6753-4432-b7b4-7da1b683f09a",
                                                "sense_id": "41df29a4-7217-3d34-a553-48dedeb51ae2",
                                                "text": "Le 12 décembre, mise en place de figurines vélo en association des doubles chevron au niveau des différentes bretelles d’accès afin d’indiquer les zones d’interaction potentielle avec les cyclistes (bretelles d’accès à la RD 1085). Cela permet aussi pour les véhicules venant de la RD 1085, de mieux visualiser la présence des cyclistes et la répartition des différents espaces au niveau de la CVCB."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8702ee3f-168a-3cb8-8b29-e82256b4c084",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Petite image en deux dimensions symbolisant une personne ou un usager.",
                                            "Représentation en deux dimensions d’un modèle de mode."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56a5ab9f-8690-41a1-953f-5938c83bb7d8",
                                                "sense_id": "8702ee3f-168a-3cb8-8b29-e82256b4c084",
                                                "text": "Le patron d’une figurine de mode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
