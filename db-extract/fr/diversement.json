        "fr-extract.jsonl": [
            {
                "entry_id": "cbbfecb7-dfd3-36ec-8dd6-e9158ea5cf76",
                "word": "diversement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                        "entry_id": "cbbfecb7-dfd3-36ec-8dd6-e9158ea5cf76",
                        "glosses": [
                            "De diverse manière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "452a2302-8a0e-4f5e-beac-c7a3a88a3ca7",
                                "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                                "text": "On emploie pour cette pêche les engins ordinaires, ceux que nous avons décrits ci-dessus, et des poches en chanvre diversement disposées et tissues, que le poisson remplit quelquefois entièrement."
                            },
                            {
                                "example_id": "97642c45-36ea-444f-95af-d33bfef58004",
                                "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                                "text": "L’allégresse qu’ils semaient le long de la route affectait diversement, et selon leurs tempéraments, les autres excursionnistes."
                            },
                            {
                                "example_id": "f9ca6b18-323c-4d8e-9554-8d4927fac348",
                                "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                                "text": "Les grès à Woltzia […] forment dans leur niveau inférieur des bancs compacts et fossilifères où « les couches gréseuses alternent avec des argiles diversement nuancées » […]"
                            },
                            {
                                "example_id": "ec844658-2948-45f6-a2a9-9452c4784c65",
                                "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                                "text": "Là nous n’avons rien su que de la renommée, Qui par un bruit confus diversement semée […]"
                            },
                            {
                                "example_id": "db8315a5-f699-4cb6-9f2f-acc2ac280cca",
                                "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                                "text": "La même erreur les fait errer diversement."
                            },
                            {
                                "example_id": "cef6f557-65b9-4aa9-a468-a6e046f93054",
                                "sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                                "text": "Les Russes parlent diversement de leur général et de leur empereur ; pour nous, comme ennemis, nous ne pouvons juger nos ennemis que par les faits ; or telles furent leurs paroles, et leurs actions y répondirent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a92b30c-512f-4250-87a9-ead879e94b3a",
                        "source_entry_id": "cbbfecb7-dfd3-36ec-8dd6-e9158ea5cf76",
                        "source_sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
                        "target_lang_word": "diversely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diversely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3726ce-9c7e-38a9-8684-07ba256bcc03",
                                        "entry_id": "7318bc9e-1ca0-39cb-8537-803ce54a02d5",
                                        "glosses": [
                                            "In a diverse manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ef5a8a-e6f7-4f51-94c9-651dc2486d2b",
                                                "sense_id": "fb3726ce-9c7e-38a9-8684-07ba256bcc03",
                                                "text": "Thoſe teachers that be of the wiſer ſort, cal for their ſchoolage and minervals of their ſcholars, not all after one maner, but diverſly: a number of them, according as the preſent occaſion requireth, who promiſe not to make them wiſe men, and that within a yeere; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "574f16b4-539e-4171-a940-a2d9dfe7f6f3",
                        "source_entry_id": "cbbfecb7-dfd3-36ec-8dd6-e9158ea5cf76",
                        "source_sense_id": "5d2613d7-0c30-36d0-9d0b-7ec035c86d0d",
