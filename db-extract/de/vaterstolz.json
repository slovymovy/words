                        "glosses": [
                            "Stolz eines Vaters auf sein Kind; zum Beispiel, weil das Kind etwas gemacht/geschafft hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec40b7d-4a60-46a4-af9a-f3fa793e9cd3",
                                "sense_id": "36a8e563-3eb5-3054-8bbb-87f8874a9d4b",
                                "text": "Dieter erzählte uns von den Entwicklungsschritten seines kleinen Sohns und strotzte dabei nur so vor Vaterstolz."
                            },
                            {
                                "example_id": "43d152e6-bc6f-4984-93ac-93d6d9a286b5",
                                "sense_id": "36a8e563-3eb5-3054-8bbb-87f8874a9d4b",
                                "text": "Wenn Herbert seiner Tochter beim Spielen zusieht, könnte er platzen vor Vaterstolz."
                            },
                            {
                                "example_id": "4d23b9c2-9c8b-46ef-8c51-ca5b9df07bcb",
                                "sense_id": "36a8e563-3eb5-3054-8bbb-87f8874a9d4b",
                                "text": "Das Verhalten, das seine Freundin so stört, ist doch nur ein Zeichen seines riesigen Vaterstolzes."
                            }
                        ],
