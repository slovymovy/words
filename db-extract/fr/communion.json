                                        "sense_id": "b373e07b-3790-30a6-8ec7-fdb2763724e7",
                                        "entry_id": "222634f0-63f3-301f-adbf-1ebb9300756c",
                                        "glosses": [
                                            "A joining together of minds or spirits; a mental connection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bbab52d-29b3-4161-9c34-0543d457069d",
                                                "sense_id": "b373e07b-3790-30a6-8ec7-fdb2763724e7",
                                                "text": "It would be uplifting to think that the ziggurat was the first expression of Near Eastern civilization, for then one could speak about humanity's fascination with the heavens, of the human quest for communion with the infinite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ba8188-2df5-30dd-9086-7aeaebc416e0",
                                        "entry_id": "222634f0-63f3-301f-adbf-1ebb9300756c",
                                        "glosses": [
                                            "Holy Communion; the Eucharist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c0abeeb-892b-44ed-a4c3-c5ff386ecabf",
                                                "sense_id": "f4ba8188-2df5-30dd-9086-7aeaebc416e0",
                                                "text": "It is with the day of her first communion that this narrative of mine begins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29f34c7-f070-3598-80af-c923c4e6654f",
