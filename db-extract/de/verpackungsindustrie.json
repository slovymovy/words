                    {
                        "sense_id": "3d123034-f982-37ae-9767-046803828935",
                        "entry_id": "7f942d5d-1f6e-3c16-b0e2-d3c42a9f1954",
                        "glosses": [
                            "Industrie, die sich mit der Herstellung von Verpackungen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ecacc7-a374-49e9-8d19-283ceae45f43",
                                "sense_id": "3d123034-f982-37ae-9767-046803828935",
                                "text": "„Ebenso erfolgreich arbeiten Absolventen im Anlagenbau, Verarbeitungsmaschinenbau und in der Verpackungsindustrie.“"
                            },
                            {
                                "example_id": "c5ea8b3e-1b96-475e-a2ea-6afb5b4ea2d7",
                                "sense_id": "3d123034-f982-37ae-9767-046803828935",
                                "text": "„Mais kommt u. a. in der Textilherstellung, in der Papier- und Verpackungsindustrie sowie in der Pharmaindustrie zum Einsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
