                        ]
                    },
                    {
                        "translation_id": "1cf19147-cbc2-49f7-9559-be1c10218922",
                        "source_entry_id": "7e7d7271-1365-3c86-bece-0a000cad7fc6",
                        "source_sense_description": "not containable or controllable",
                        "target_lang_word": "irrépressible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrépressible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                        "entry_id": "aa1e7556-66f3-3564-8a45-ba9d6529e2cf",
                                        "glosses": [
                                            "Qu’on ne peut réprimer ou contenir, irrésistible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47dcc242-3c0e-458e-9c49-7719723eed70",
                                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                                "text": "Quand on assistait à une comédie d’Eugène Labiche, c’était le même rire irrépressible."
                                            },
                                            {
                                                "example_id": "ca731ac7-5009-49ca-bf08-c53d6f31193a",
                                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                                "text": "L’irrépressible Rolf proposa d’aller souper à trois dans une taverne de Richmond où l’on trouvait de bonnes huîtres."
                                            },
                                            {
                                                "example_id": "000d64b2-13eb-4012-a7e3-c6a6b072364a",
                                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                                "text": "Comme l’être humain a un besoin irrépressible d’opium, les sectes et la charlatanerie ne manqueront pas de pulluler."
                                            },
                                            {
                                                "example_id": "fb0250de-8df4-49fa-b946-7496df9226a5",
                                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                                "text": "L’urgenturie, anciennement appelée impériosité urinaire, se définit par un besoin urgent et irrépressible d’uriner. Deux à trois millions de personnes sont concernées en France."
                                            },
                                            {
                                                "example_id": "35ef1491-74af-4b3f-92c2-c9327f8614d1",
                                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                                "text": "La chaleur de l’incendie commençait à gagner les environs, mais il n’écoutait plus, pris de sanglots irrépressibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
