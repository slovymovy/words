                    {
                        "form_id": "67641880-afa4-46e2-8d5a-e1888d350164",
                        "entry_id": "afb0bb53-ebc2-352b-9d4b-f1a55f0764d2",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zuvorkommenheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "237857d2-4eee-3f80-a52c-65ad8eb89d97",
                        "entry_id": "afb0bb53-ebc2-352b-9d4b-f1a55f0764d2",
                        "glosses": [
                            "Eigenschaft, zuvorkommend/bereitwillig auf Wünsche/Vorstellungen einer anderen Person zu reagieren, auch auf solche, die noch gar nicht geäußert wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a8ceec-4e5f-4d3d-a26c-cec93548cf94",
                                "sense_id": "237857d2-4eee-3f80-a52c-65ad8eb89d97",
                                "text": "„Sein charmanter Umgangston, seine Zuvorkommenheit und seine präzise Arbeit wurden geschätzt.“"
                            },
                            {
                                "example_id": "7d1f2440-9a69-48e2-a8da-2c6e53c26910",
                                "sense_id": "237857d2-4eee-3f80-a52c-65ad8eb89d97",
                                "text": "„Was man dem Sachsen noch zuschreibt, ist seine Verträglichkeit, Gutmütigkeit, und im Witz auch: die sich überstürzende Zuvorkommenheit, eine Bescheidenheit, die bis zur Selbstverleugnung geht.“"
                            },
                            {
                                "example_id": "f0615cde-de1c-4103-adbd-d8b69db9db30",
                                "sense_id": "237857d2-4eee-3f80-a52c-65ad8eb89d97",
                                "text": "„Für Palmström und Korf, diese skurrilen Geistessöhne Christian Morgensterns, hat Zuvorkommenheit Priorität im Umgang mit der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
