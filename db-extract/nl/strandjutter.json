                                        "sense_id": "6c4077f0-b47d-3458-b192-89e96623d7c7",
                                        "entry_id": "1f9191a4-afd8-33c1-bc6c-bfd85f75bd17",
                                        "glosses": [
                                            "A long rolling wave of the sea."
                                        ],
