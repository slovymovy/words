                                                "sense_id": "f0aba005-0c28-3723-931a-6adeb854491c",
                                                "text": "Sie ist Böhmin."
                                            },
                                            {
                                                "example_id": "7461c5f2-aee4-4c0d-bb24-a5297e5dd96f",
                                                "sense_id": "f0aba005-0c28-3723-931a-6adeb854491c",
                                                "text": "Der Böhme hat den Hut verloren und die Böhmin hat's gemerkt."
                                            },
                                            {
                                                "example_id": "b4a8ef42-2a07-4bb1-bfd4-b793fa328c73",
                                                "sense_id": "f0aba005-0c28-3723-931a-6adeb854491c",
                                                "text": "„Lisa ist, soviel wir wissen, Böhmin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
