                                    {
                                        "sense_id": "96cc43ee-5c0d-3831-8389-49c13f9cb5a5",
                                        "entry_id": "ae308817-565b-33d1-8c03-5b008d703cc5",
                                        "glosses": [
                                            "A dedicated space in a library, or similar institution of learning, set aside for reading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5daf1eb-b447-4cc7-a5da-f998e994ea9b",
                                                "sense_id": "96cc43ee-5c0d-3831-8389-49c13f9cb5a5",
                                                "text": "There is also a fine dance and concert hall, a capacious reading room, a well-appointed billiards room with five tables, various committee and games rooms, photographic dark rooms, and a small but compact ladies' lounge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2d4a6f5-291a-385d-b972-348ad7bcf3e8",
                                        "entry_id": "ae308817-565b-33d1-8c03-5b008d703cc5",
                                        "glosses": [
                                            "A reference library."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cb7845d-fc92-48e2-833d-dbeb9813b87e",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "čítárna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "88aef98b-e15d-47ea-a8d6-3da2d6705029",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "studovna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "01c0df6f-af3a-485b-96ef-4e734e8c6c79",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "salle de lecture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salle de lecture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                        "entry_id": "ae1feadf-8bfe-3e9f-bd3d-8935d751acfb",
                                        "glosses": [
                                            "Espace aménagé dans une bibliothèque ou un service d’archives permettant la consultation des documents sur place."
                                        ],
                                        "tags": [
                                            "Bibliothéconomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65368a82-b4c4-4001-9646-05656df78edc",
                                                "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                                "text": "Ils entrèrent avec précaution dans la salle de lecture : un homme jeune et de méchante humeur y feuilletait des journaux sous la lampe, près d’un général chauve absorbé par sa lecture."
                                            },
                                            {
                                                "example_id": "f3c95044-4b6e-4206-ab1e-65db30f2dae2",
                                                "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                                "text": "Je le félicitai, en lui recommandant de ne pas se faire d’amis, la Bibliothèque nationale regorgeant d’aimables causeurs qui semblent ne pas aimer la lecture des autres et qui se relayent pour vous empêcher de prendre connaissance du livre que vous venez d’ouvrir. Il me répondit qu’il avait sa méthode, et que, dès qu’un de ceux pour qui la salle de lecture est une salle de conversation venait s’accouder à son fauteuil, il s’endormait immédiatement, ce qui, dans une salle de lecture, comme à un cours public, est dans les mœurs, ne peut froisser personne et n’a pas besoin qu’on s’en excuse."
                                            },
                                            {
                                                "example_id": "c32e5507-9a07-4a01-b7eb-0f9c098144c9",
                                                "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                                "text": "Dans la vaste salle de lecture, un seul lecteur prend place sur chaque ensemble de tables qui, initialement en accueillait quatre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c8b228b-e4af-47c7-818a-0f10cc916e96",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "sala de lectura",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2ac12a10-306a-4af5-9f74-7d629b3ef6d8",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "leeszaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leeszaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0d332dbd-069a-3f8a-8396-7de6b17a427c",
                                        "entry_id": "391782b3-57db-3cda-9156-b04faeb912fc",
                                        "glosses": [
                                            "een (openbare) ruimte waarin men kan lezen en studeren, vaak een deel van een bibliotheek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6553be8-58ff-481a-8d45-2d6afb666ba2",
                                                "sense_id": "0d332dbd-069a-3f8a-8396-7de6b17a427c",
                                                "text": "Na een paar dagen binnen zitten, besloot ik een kop koffie te gaan drinken in het centrum van Rotterdam en belandde na wat omzwervingen in Leeszaal Rotterdam West. De Leeszaal is vijf jaar geleden opgericht aan het Rijnhoutplein achter de Nieuwe Binnenweg, de langste maar ook meest onveilige winkelstraat van Nederland. Het is een favoriete plek voor buurtbewoners om bij elkaar te komen. De plek wordt gerund door meer dan tachtig vrijwilligers die er taallessen, kinderprogramma’s, dichtersavonden en debatten organiseren. Twee bewoners namen hiertoe het initiatief. Deels uit frustratie dat gemeenschappelijke ruimten als de bibliotheek en het wijkgebouw werden gesloten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3ab86e4-5635-4a1a-9c4a-8b626bde38ac",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "Lesesaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lesesaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01e6df5e-0091-3789-968c-d3b04ef112d5",
                                        "entry_id": "9b4f5e19-7b6b-3870-bb78-8e2e97dd0143",
                                        "glosses": [
                                            "Raum, in dem die Besucher einer Bibliothek die Bücher und Zeitschriften der Bibliothek lesen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdf521d-183f-4c07-bb5f-046de89f44ad",
                                                "sense_id": "01e6df5e-0091-3789-968c-d3b04ef112d5",
                                                "text": "„Am gestrigen Dienstag war eine mehrere Meter lange Leuchtschiene im Lesesaal der Bibliothek von der Decke gefallen.“"
                                            },
                                            {
                                                "example_id": "f2975169-a22a-4848-b15e-f58b5a7c07a4",
                                                "sense_id": "01e6df5e-0091-3789-968c-d3b04ef112d5",
                                                "text": "„Zwei splitternackte Studenten, den Schambereich mit einem Plastikschurz notdürftig bedeckt, rennen durch den Lesesaal der Bayerischen Staatsbibliothek in München - unter lautem Beifall der dort am Schreibtisch lernenden Kommilitonen.“"
                                            },
                                            {
                                                "example_id": "ca3f2dec-611f-45f9-990c-270e0e3827dc",
                                                "sense_id": "01e6df5e-0091-3789-968c-d3b04ef112d5",
                                                "text": "„Henriette fachte den Ofen an, leerte die Spucknäpfe und Aschenbecher und sorgte für einen sauberen und ordentlichen Lesesaal.“"
                                            },
                                            {
                                                "example_id": "f5b13742-9d55-4794-99ec-7797089f9b0b",
                                                "sense_id": "01e6df5e-0091-3789-968c-d3b04ef112d5",
                                                "text": "„Wenn man einen Leseausweis hat, den man im Voraus beantragen muss, kann man zwar einige Räume der campusartig angelegten Gebäudekomplexe und der Lesesäle aufsuchen, aber der überwiegende katalogisierte und in riesigen Metallreihen untergebrachte Teil der Sammlung ist nicht zugänglich für Besucher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8290609f-0331-4efa-98c7-8d8b5e931fc8",
                        "source_entry_id": "447563bf-9abb-36f7-89d1-ae5b3fdab638",
                        "source_sense_id": "001b09b2-cb11-3974-8215-be98adfbe5e4",
                        "target_lang_word": "Leseraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leseraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                        "entry_id": "948c10c7-52e6-3f26-8639-14ffe35d5981",
                                        "glosses": [
                                            "Zimmer oder Saal einer Institution, beispielsweise einer Bibliothek, in dem Besucher Bücher, Dokumente und Zeitschriften lesen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627dd842-9be3-4920-aee7-b702ee95228b",
                                                "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                                "text": "„Ich setze mich nachher in der Leseraum der Bibliothek, da habe ich meine Ruhe!“"
                                            },
                                            {
                                                "example_id": "63a4385c-e301-403b-a523-ad75fe6ff80a",
                                                "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                                "text": "Es gibt [an der Leipziger August-Bebel-Grundschule] einen Leseraum, weil es Kinder gibt, die zu Hause keine Büchern haben […]."
                                            },
                                            {
                                                "example_id": "a986269a-13d6-4b6d-9160-b15e68543715",
                                                "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                                "text": "Gerade fertig geworden ist der neue, öffentlich zugängliche Leseraum der Bibliothek im Erdgeschoss des Instituts, ein großer, heller Raum mit langen Regalen voller Bücher und Zeitschriften an den Wänden."
                                            },
                                            {
                                                "example_id": "455a0e86-0727-4457-8fe0-2688f119ff63",
                                                "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                                "text": "Manche [Dokumente der Code of Conduct Group, die sich mit Steuertricks innerhalb der EU beschäftigt,] sind so brisant, dass sie [für die Abgeordneten] nur in einem Leseraum eingesehen werden können."
                                            },
                                            {
                                                "example_id": "c5acffe3-8fa0-49c2-84e9-771ab10e7721",
                                                "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                                "text": "Die Synagoge bestand aus drei Räumen: ein großer annähernd quadratischer Leseraum, an den im Westen ein Vestibül angrenzte, und ein kleinerer Raum im Süden, der möglicherweise zur Aufbewahrung der Schriftrollen diente."
                                            },
                                            {
                                                "example_id": "76d3b425-5760-4cd5-86dd-4d5f20d95797",
                                                "sense_id": "a874744f-3f96-3660-bcdc-69c906a50f08",
                                                "text": "Der Komplex [Bistaar, ein multifunktionales Kulturzentrum in der Stadt Chittagong] verfügt neben zwei Ausstellungsräumen und den Verwaltungsbereichen über eine kleine Bibliothek mit Leseraum, einen Balkon und ein Café mit eigener Küche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
