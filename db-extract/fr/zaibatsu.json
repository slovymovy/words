                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a76981d-1a7c-4103-aa54-14ff2bf9a412",
                                                "sense_id": "ee43bbc6-6b7f-3f3e-beab-3d1fbc300219",
                                                "text": "He wondered briefly what it would be like, working all your life for one zaibatsu. Company housing, company hymn, company funeral."
                                            },
                                            {
                                                "example_id": "2ed0a6db-cc85-4d29-95bd-adc96760619a",
                                                "sense_id": "ee43bbc6-6b7f-3f3e-beab-3d1fbc300219",
                                                "text": "At other points, the film suggests the motive is financial, depicting the Kobayashi clan as staging an industrial coup of sorts, like a quirky Andersonian take on the zaibatsu (a term for the family-controlled business monopolies that dominated Japan until the end of World War II)."
                                            }
                                        ]
                                    },
