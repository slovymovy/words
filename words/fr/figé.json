{
    "word_family": [
        "figer",
        "figement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3451184e-3310-344a-8c14-bebf35653723",
                    "sense_definition": "Qui ne bouge pas du tout, qui demeure totalement immobile en parlant d'une personne, d'un regard ou d'une attitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "immobilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté <w>figé</w> de stupeur en apprenant cette terrible nouvelle.",
                            "target_lang_translations": {
                                "en": "He remained <w>frozen</w> with shock on hearing this terrible news.",
                                "ru": "Услышав это страшное известие, он <w>застыл</w> от потрясения.",
                                "de": "Als er diese schreckliche Nachricht erfuhr, war er vor Schock <w>starr</w>.",
                                "es": "Se quedó <w>petrificado</w> de estupor al enterarse de esta terrible noticia.",
                                "zh": "听到这个可怕的消息，他震惊得浑身<w>僵硬</w>。"
                            }
                        },
                        {
                            "text": "Elle gardait un sourire <w>figé</w> devant les photographes impatients.",
                            "target_lang_translations": {
                                "en": "She kept a <w>fixed</w> smile in front of the impatient photographers.",
                                "ru": "Перед нетерпеливыми фотографами она сохраняла <w>застывшую</w> улыбку.",
                                "de": "Vor den ungeduldigen Fotografen behielt sie ein <w>starres</w> Lächeln bei.",
                                "es": "Mantenía una sonrisa <w>rígida</w> ante los fotógrafos impacientes.",
                                "zh": "面对急不可耐的摄影师，她脸上始终挂着一副<w>僵硬</w>的笑容。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immobile",
                        "pétrifié"
                    ],
                    "antonyms": [
                        "mobile",
                        "expressif"
                    ],
                    "common_phrases": [
                        "sourire figé",
                        "regard figé",
                        "rester figé"
                    ],
                    "target_lang_definitions": {
                        "en": "Not moving at all, completely motionless, said of a person, a look or an attitude.",
                        "ru": "Совершенно неподвижный, ни на миг не двигающийся; о человеке, взгляде или позе.",
                        "de": "Völlig unbeweglich, ohne jede Regung; bezogen auf Personen, Blicke oder Haltungen.",
                        "es": "Que no se mueve en absoluto y permanece completamente inmóvil, referido a una persona, una mirada o una actitud.",
                        "zh": "完全不动、一动不动的，多形容人、目光或姿态。"
                    },
                    "translations": {
