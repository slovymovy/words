                "senses": [
                    {
                        "sense_id": "99ac7f14-61b9-3eea-99f0-48d037b9a46f",
                        "entry_id": "b7281a74-4c19-390e-86bf-e634667a9e55",
                        "glosses": [
                            "Faire perdre son caractère méridional à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4cc2038-8643-47b6-b62d-3c89b855aeac",
                                "sense_id": "99ac7f14-61b9-3eea-99f0-48d037b9a46f",
                                "text": "Et il s’y livre à ses goûts favoris : goûts invétérés de Méridional que Paris n’a pu déméridionaliser !"
                            },
                            {
                                "example_id": "dfb3b0d0-b86f-4943-95d8-96a5a692e291",
                                "sense_id": "99ac7f14-61b9-3eea-99f0-48d037b9a46f",
                                "text": "Il se pénètrera plus profondément du sombre génie qu’il a su regarder en face et s’il veut détacher ses regards de l’azur pour les plonger dans le brouillard, se déméridionaliser un peu et se shakespeariser braucoup, il atteindra sans doute un jour l’équation qu’il poursuit !"
                            }
                        ]
                    }
