                        ],
                        "form": "Papoea-Nieuw-Guinea's"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b04f4006-5bd7-35dc-94b8-feb4378d5aa2",
                        "entry_id": "19e99042-edb8-319d-b1d8-0f0909e05370",
                        "glosses": [
                            "het oostelijke deel van het eiland Nieuw-Guinea dat ten noorden van Australië in Oceanië ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e2ce2a-cc5f-4300-b713-c4ab2ecba247",
                                "sense_id": "b04f4006-5bd7-35dc-94b8-feb4378d5aa2",
                                "text": "In Papoea-Nieuw-Guinea groeien planten die bij het klimaat passen."
                            },
                            {
                                "example_id": "0d069b4c-0de0-4a7f-910b-b09d3f2b4cf3",
                                "sense_id": "b04f4006-5bd7-35dc-94b8-feb4378d5aa2",
                                "text": "Het land is in werkelijkheid boeiender dan het Papoea-Nieuw-Guinea uit de reisgids."
                            }
                        ]
                    },
                    {
                        "sense_id": "22c6e554-a63f-3a80-95e7-a2e0dc0b097b",
                        "entry_id": "19e99042-edb8-319d-b1d8-0f0909e05370",
                        "glosses": [
                            "de soevereine \\\"Onafhankelijke Staat Papoea-Nieuw-Guinea\\\" (Engels: Independent State of Papua New Guinea) die het onder [1] genoemde gebied en naburige eilanden omvat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a479ed-76f8-4da7-8258-ffd9606a9167",
                                "sense_id": "22c6e554-a63f-3a80-95e7-a2e0dc0b097b",
                                "text": "Papoea-Nieuw-Guinea is lid van de Verenigde Naties."
                            }
                        ]
                    },
                    {
                        "sense_id": "71f8497d-d08a-3215-8906-5cbbb2ee93f5",
                        "entry_id": "19e99042-edb8-319d-b1d8-0f0909e05370",
                        "glosses": [
                            "Zij die als vertegenwoordigers van het land genoemd in [2] optreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e43c96f-193a-4420-b0af-88b0dc36a3f6",
                                "sense_id": "71f8497d-d08a-3215-8906-5cbbb2ee93f5",
                                "text": "Het Papoea-Nieuw-Guinea van twee jaar geleden was een zeer sterk elftal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baf88984-beea-497a-8371-17dcfd9ba229",
                        "source_entry_id": "19e99042-edb8-319d-b1d8-0f0909e05370",
