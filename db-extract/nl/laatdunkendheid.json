        "nl-extract.jsonl": [
            {
                "entry_id": "750037bb-a72d-374b-962f-d79794e28699",
                "word": "laatdunkendheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfe39348-e1c3-388f-ba5a-c7f0d3b46653",
                        "entry_id": "750037bb-a72d-374b-962f-d79794e28699",
                        "glosses": [
                            "het jezelf verheven voelen boven de rest van de mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a71bfdd-3ea1-4eca-a0be-a7a7d2b6730b",
                                "sense_id": "dfe39348-e1c3-388f-ba5a-c7f0d3b46653",
                                "text": "Twee dagen later brengt Pence een bezoek aan EU-president Donald Tusk en zegt naderhand dat de VS een volledige partner van de Europese Unie zal blijven. Niets te bekennen van de eerdere laatdunkendheid die Trump koesterde ten opzichte van de EU."
                            },
                            {
                                "example_id": "d47507d2-15b3-4c4d-9cf6-62218a3ca5cc",
                                "sense_id": "dfe39348-e1c3-388f-ba5a-c7f0d3b46653",
                                "text": "Dat clichébeeld werkt evenzeer door in de politieke analyses van de problemen in de samenleving. Hogeropgeleide middenklassers kunnen de politieke keuzes van de lageropgeleiden doorgaans rustig negeren, paternalistisch omzeilen of laatdunkend bekritiseren. De legitieme zorgen van de arbeidersklasse – over werkgelegenheid, de negatieve gevolgen van globalisering, de onzekere levenskwaliteit van hun kinderen – worden weggezet als bekrompen vooringenomenheid van een groepje dwazen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce3241f7-0e1d-4961-b438-7fba66bfe5d2",
                        "source_entry_id": "750037bb-a72d-374b-962f-d79794e28699",
                        "source_sense_id": "dfe39348-e1c3-388f-ba5a-c7f0d3b46653",
                        "target_lang_word": "impertinence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impertinence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cabae79e-b9ad-32d9-857c-6a52e7f9f563",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Lack of pertinence; irrelevance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "An instance of this; a moment of being impertinent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a958ca5-1fbd-4ce6-a67f-036c21e3bce1",
                                                "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                                "text": "\"Enough, sir! \" he thundered with barely restrained fury. \"Enough, I say! Once and for all I must endeavour to rid myself of you and your impertinence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15643dfb-94ed-3a72-bd4d-90bd496fe180",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "The fact or character of being out of place; inappropriateness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Insolence; impudence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273eca85-0d82-41a7-b05c-11960ef88d0b",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "\"Because,\" interrupted the actress, \"I see things exactly as they are. I calculate my effects, but they do not deceive myself; you, on the contrary, live in a world of illusions, where every thing is called by such an exceedingly fine name, that it seems a downright impertinence to ascertain what it really is.\""
                                            },
                                            {
                                                "example_id": "06d0d651-ebae-430e-8466-3b5d770050b5",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "The musical has always had a lightness of touch, an impertinence that resembles gay humor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
