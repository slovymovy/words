{
    "word_family": [
        "gwałt",
        "gwałtowny",
        "gwałcić"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2e92d669-3cfb-30ad-81eb-1801823a69c2",
                    "sense_definition": "w sposób bardzo intensywny, z dużą siłą lub natężeniem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensywność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ludzie <w>gwałtownie</w> zaczęli zaopatrywać się w mąkę, bo bali się, że wkrótce jej zabraknie.",
                            "target_lang_translations": {
                                "ru": "Люди <w>бурно</w> начали запасаться мукой, опасаясь, что скоро она закончится."
                            }
                        },
                        {
                            "text": "Ceny paliw <w>gwałtownie</w> wzrosły w ciągu ostatniego miesiąca.",
                            "target_lang_translations": {
                                "ru": "Цены на топливо <w>резко</w> выросли за последний месяц."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensywnie",
                        "mocno"
                    ],
                    "antonyms": [
                        "powoli",
                        "stopniowo"
                    ],
                    "common_phrases": [
                        "gwałtownie rosnąć",
                        "gwałtownie spadać"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень интенсивно, с большой силой или напряжением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурно",
                                "target_lang_sense_clarification": "о процессах, происходящих с большой интенсивностью"
                            },
                            {
                                "target_lang_word": "резко",
                                "target_lang_sense_clarification": "об изменении показателей или интенсивности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daef234e-cc64-3f1a-b9c4-64d4ec9d47bd",
                    "sense_definition": "w sposób nagły, niespodziewany i szybki",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nagłość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Odwrócił się <w>gwałtownie</w> na dźwięk swojego imienia.",
                            "target_lang_translations": {
                                "ru": "Он <w>резко</w> обернулся на звук своего имени."
                            }
                        },
                        {
                            "text": "Kierowca <w>gwałtownie</w> zahamował, gdy zobaczył psa na drodze.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>резко</w> затормозил, когда увидел собаку на дороге."
                            }
                        }
                    ],
                    "synonyms": [
                        "nagle",
                        "raptownie"
                    ],
                    "common_phrases": [
                        "gwałtownie zahamować",
                        "gwałtownie zareagować"
                    ],
                    "target_lang_definitions": {
                        "ru": "внезапно, неожиданно и быстро"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внезапно",
                                "target_lang_sense_clarification": "о неожиданном действии"
                            },
                            {
                                "target_lang_word": "резко",
                                "target_lang_sense_clarification": "о быстром, порывистом движении"
                            },
                            {
                                "target_lang_word": "стремительно",
                                "target_lang_sense_clarification": "о очень быстром и порывистом действии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d3bcdf6-d1cd-3995-ae73-c8cc36e4c4eb",
                    "sense_definition": "w sposób agresywny, brutalny lub pełen przemocy",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agresja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tłum <w>gwałtownie</w> zareagował na prowokacyjne słowa polityka.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>яростно</w> отреагировала на провокационные слова политика."
                            }
                        },
                        {
                            "text": "Wiatr <w>gwałtownie</w> uderzył w okna starego domu.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>с силой</w> ударил в окна старого дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "brutalnie",
                        "agresywnie"
                    ],
                    "antonyms": [
                        "łagodnie",
                        "spokojnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "агрессивно, жестоко или с применением силы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яростно",
                                "target_lang_sense_clarification": "с проявлением сильной агрессии или гнева"
                            },
                            {
                                "target_lang_word": "грубо",
                                "target_lang_sense_clarification": "в агрессивной или небрежной манере"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}