                                                "example_id": "7f6942e9-8c5d-4d08-8f46-dc0c4e13d899",
                                                "sense_id": "f3a12aa8-ef62-30b0-90de-264c9ebf505b",
                                                "text": "boiling kettle  boiling oil"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd291276-7bb5-3a32-93ac-a7e397aa6331",
                                        "entry_id": "7da5eeac-5fb7-33d3-b879-9718b8ff156c",
                                        "glosses": [
                                            "Of a thing: extremely hot or active."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70928f7b-c083-47b0-ba88-3cc7e32a7465",
                                                "sense_id": "cd291276-7bb5-3a32-93ac-a7e397aa6331",
                                                "text": "The radiator is boiling – I’m going to turn it down a bit."
                                            },
                                            {
                                                "example_id": "265f9745-05bb-4e2c-86a2-9cc6f790d835",
                                                "sense_id": "cd291276-7bb5-3a32-93ac-a7e397aa6331",
                                                "text": "With a little manœuvring they contrived to meet on the doorstep which now, in mid-morning, was in a boiling stream of passers-by, hurrying business people speeding past in a flurry of fumes and dust in the bright haze."
                                            },
                                            {
                                                "example_id": "62ebae02-b039-4c4a-8c09-d72911aa45d6",
                                                "sense_id": "cd291276-7bb5-3a32-93ac-a7e397aa6331",
                                                "text": "As I collected some individuals from a nest, an alarm was sent and a boiling mass of ants issued from the colony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ef17b9-0302-319b-825e-8ba3211a3c27",
                                        "entry_id": "7da5eeac-5fb7-33d3-b879-9718b8ff156c",
                                        "glosses": [
                                            "Of a person: feeling uncomfortably hot."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84052ea-6122-4cf3-9882-2e30bbdb725b",
                                                "sense_id": "48ef17b9-0302-319b-825e-8ba3211a3c27",
                                                "text": "I’m boiling – can’t we open a window?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58351319-9a40-36a5-bb2d-8e086140d1fa",
                                        "entry_id": "7da5eeac-5fb7-33d3-b879-9718b8ff156c",
                                        "glosses": [
                                            "Of the weather: very hot."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386f2b1c-c88d-4291-a0eb-9daa37a49ea1",
                                                "sense_id": "58351319-9a40-36a5-bb2d-8e086140d1fa",
                                                "text": "It’s boiling out today!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
