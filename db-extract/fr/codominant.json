                        "glosses": [
                            "Qui domine avec un ou plusieurs autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df754717-64ed-4b50-acee-0dcf79fcbdb5",
                                "sense_id": "62c17560-699a-38d8-a44c-8134c55e91dd",
                                "text": "Dans les zones où le sol sans être humide reste constamment frais, Leontodon hispidum et Lathyrus pratensis sont codominants, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab707a83-418d-3f57-98d4-617df7fc8377",
                        "entry_id": "ef016eea-7463-32f1-84ec-3df381f731f6",
                        "glosses": [
                            "Qualifie un arbre qui fait partie de la strate dominante, mais qui subit la concurrence de voisins plus vigoureux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35521af-05fe-403e-b331-8715a118be94",
                                "sense_id": "ab707a83-418d-3f57-98d4-617df7fc8377",
                                "text": "Par la suite, la désignation a évolué vers le choix de tiges très élancées, élaguées naturellement très haut, pour la plupart codominantes."
                            }
                        ]
                    }
