                "senses": [
                    {
                        "sense_id": "5bb12810-b4a7-33bf-a6bd-ba873861cc2b",
                        "entry_id": "78e24603-4bdb-388d-bcae-c7e5fffe0bce",
                        "glosses": [
                            "eine Khoisan-Sprache, bekannt für ihr großes Lautinventar, einschließlich zahlreicher Schnalz- bzw. Klicklaute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345307a8-7525-4885-987c-cd1a93ef6708",
                                "sense_id": "5bb12810-b4a7-33bf-a6bd-ba873861cc2b",
                                "text": "„Einige der Khoisan-Sprachen, wie etwa das ǃXóõ, haben über 80 verschiedene Klicklaute in ihrem Phoneminventar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a7fee56-9c3c-459a-be89-532d82e21c30",
                        "source_entry_id": "78e24603-4bdb-388d-bcae-c7e5fffe0bce",
                        "source_sense_id": "5bb12810-b4a7-33bf-a6bd-ba873861cc2b",
                        "source_sense_description": "Khoisan-Sprache mit großem Lautinventar, einschließlich zahlreicher Schnalz- bzw. Klicklaute",
                        "target_lang_word": "ǃXóõ",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ǃXóõ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                        "entry_id": "021c68f1-843c-31b7-92a1-9d21e5080aae",
                                        "glosses": [
                                            "A Khoisan language, known for its large phonemic inventory including complex click consonants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a87251-a043-4389-8742-5079d5ccc573",
                                                "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                                "text": "The ǃXóõ language is spoken by widely scattered groups of San living in southwestern Botswana and a small area of eastern Namibia."
                                            },
                                            {
                                                "example_id": "f503d540-13d9-4e19-b7d9-fde85434bcf8",
                                                "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                                "text": "[…] which studied category formation of ǃXóõ clicks by speakers of a language that has no clicks (American English) and two other unrelated African languages that have clicks, but fewer of them […]"
                                            },
                                            {
                                                "example_id": "816a7ab5-b09d-4a7b-985a-be2de9676301",
                                                "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                                "text": "However, the phonotactic patterning of 'uvular' clicks in ǃXóõ does not comply with the predicted patterns given in this analysis."
                                            },
                                            {
                                                "example_id": "a7a0ae69-9c69-4a57-91ba-02df69bc6c51",
                                                "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                                "text": "Speakers of ǃXóõ (also known as Taa), gathered together for a storytelling competition at Pos 17, Namibia […]"
                                            },
                                            {
                                                "example_id": "026e639c-41eb-4569-b88a-1c941a2789f3",
                                                "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                                "text": "The most phonologically diverse language may be ǃXóõ, spoken by about 4,000 people in Botswana and Namibia, which has somewhere between 84 and 159 consonants."
                                            },
                                            {
                                                "example_id": "471012b5-b8f6-44de-8f8a-34e60d69750a",
                                                "sense_id": "44ca74a1-a5c5-3892-8586-701938597603",
                                                "text": "[…] and the ǃXóõ language spoken in Botswana and Namibia […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
