                            {
                                "example_id": "28acecdc-5626-47dd-810f-3116b246b02b",
                                "sense_id": "feb55bc4-2178-3b00-98f4-b5f4726c8af4",
                                "text": "Autodémolition est un mot de Paul VI, qui dénonçait implicitement le véritable coupable : car qui peut « autodémolir » l’Eglise, sinon celui qui a pour mission de la maintenir sur le roc ?"
                            },
                            {
                                "example_id": "6025fd9e-d6de-4e93-92e7-dee73a028bcd",
                                "sense_id": "feb55bc4-2178-3b00-98f4-b5f4726c8af4",
                                "text": "Une théorie qui ne fait pas tout pour s'autodémolir n'est pas scientifique."
                            },
                            {
                                "example_id": "ebb5340c-5729-4381-ba38-1e3cb2734772",
                                "sense_id": "feb55bc4-2178-3b00-98f4-b5f4726c8af4",
                                "text": "S'autodémolir, c'est se démolir soi-même."
                            }
                        ]
                    }
