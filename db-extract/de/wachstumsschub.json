                        "form": "die Wachstumsschübe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ba9edb9-1b47-335c-9464-cb65cfb7ec3e",
                        "entry_id": "3a1798e8-8c26-3010-97c6-3c253cdb2e75",
                        "glosses": [
                            "das deutliche Wachsen innerhalb eines verhältnismäßig kurzen Zeitraums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901fef2a-931d-43d5-a615-1033dde47e4e",
                                "sense_id": "1ba9edb9-1b47-335c-9464-cb65cfb7ec3e",
                                "text": "„Oft kriegen Babys während eines Wachstumsschubs auch vermehrt Hunger und müssen öfter gestillt werden als sonst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a5c00ff-b221-374e-ba51-76cd2d807d23",
                        "entry_id": "3a1798e8-8c26-3010-97c6-3c253cdb2e75",
                        "glosses": [
                            "plötzlicher Anstieg der wirtschaftlichen Leistung oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24236c97-ee24-486c-8d5f-80ee443fcf9f",
                                "sense_id": "3a5c00ff-b221-374e-ba51-76cd2d807d23",
                                "text": "„Geld, das zuvor als Sicherung für mögliche Bankausfälle diente, kann nun in Form von Krediten in den Markt gelangen und der Wirtschaft kurzfristig Wachstumsschübe bescheren.“"
                            },
                            {
                                "example_id": "84519d04-1111-4f81-8d15-104b742b4ede",
                                "sense_id": "3a5c00ff-b221-374e-ba51-76cd2d807d23",
                                "text": "„Die Kongresspartei litt aber auch darunter, dass ihre Wirtschaftsreform Indien zwar einen Wachstumsschub bescherte, der aber der ärmeren Bevölkerung noch nicht zugute kam.“"
                            },
                            {
                                "example_id": "d54fc306-c275-4e3e-81d8-071ed58c5c24",
                                "sense_id": "3a5c00ff-b221-374e-ba51-76cd2d807d23",
                                "text": "„Südrhodesiens Hauptstadt Salisbury war Sitz von Parlament und Regierung der Föderation, was ihr einen Wachstumsschub und neue Arbeitsplätze in der Verwaltung bescherte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
