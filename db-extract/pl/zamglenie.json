                                                "sense_id": "fb99b9c6-78d0-3505-b015-12ab9fca4bd2",
                                                "text": "It's misting this morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8454f851-3a71-37cf-92f8-3759a01c8a45",
                                        "entry_id": "ceba4995-61c1-3592-9f1f-8bb0d981c084",
                                        "glosses": [
                                            "To spray fine droplets on, particularly of water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef5240a-dab2-4d60-be93-71db993a6f0e",
                                                "sense_id": "8454f851-3a71-37cf-92f8-3759a01c8a45",
                                                "text": "I mist my tropical plants every morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57324fab-fc32-39f6-8d99-fb80b9dc6d1f",
                                        "entry_id": "ceba4995-61c1-3592-9f1f-8bb0d981c084",
                                        "glosses": [
                                            "To rain in very fine droplets."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34eb8014-bbbf-4a95-9d13-ef293c02244c",
                                                "sense_id": "57324fab-fc32-39f6-8d99-fb80b9dc6d1f",
                                                "text": "... it's misting outside. When it mists outside it's half fog and half rain."
                                            },
                                            {
                                                "example_id": "9070174d-1a7b-454e-ad49-84edcf14a4ae",
                                                "sense_id": "57324fab-fc32-39f6-8d99-fb80b9dc6d1f",
                                                "text": "On this particular early morning , with a bitter cold rain misting down, Seminov was reaching the end of his endurance."
                                            },
                                            {
                                                "example_id": "d0f7548d-2de5-447d-8962-35cc7f8d0fa5",
                                                "sense_id": "57324fab-fc32-39f6-8d99-fb80b9dc6d1f",
                                                "text": "... rain misting outside from thick clouds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8296501-d28d-3d39-9aaa-8fc91db53aaf",
                                        "entry_id": "ceba4995-61c1-3592-9f1f-8bb0d981c084",
                                        "glosses": [
                                            "To cover with a mist."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8545b8a0-6d09-4d65-b954-967d380ac125",
                                                "sense_id": "b8296501-d28d-3d39-9aaa-8fc91db53aaf",
                                                "text": "The lens was misted."
                                            },
                                            {
                                                "example_id": "2b916b17-0987-45fc-b370-b2f430d24f87",
                                                "sense_id": "b8296501-d28d-3d39-9aaa-8fc91db53aaf",
                                                "text": "her breath will mist or staine the stone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f89f5d-d5d2-31e5-951a-749b7174667b",
                                        "entry_id": "ceba4995-61c1-3592-9f1f-8bb0d981c084",
                                        "glosses": [
                                            "To be covered by tears."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a40ed2-b2eb-4e05-9832-a6e9da746f50",
                                                "sense_id": "b0f89f5d-d5d2-31e5-951a-749b7174667b",
                                                "text": "My eyes misted when I remembered what had happened."
                                            }
                                        ]
                                    },
