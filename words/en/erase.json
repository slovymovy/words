{
    "word_family": [
        "eraser",
        "erasable",
        "erasure"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87e13008-3c71-3bfb-8cdd-657c4f366af2",
                    "sense_definition": "To remove written or drawn markings, or to clear information from something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>erase</w> the mistakes on the whiteboard before starting the next lesson.",
                            "target_lang_translations": {
                                "zh": "开始下一课之前，请把白板上的错误<w>擦掉</w>。"
                            }
                        },
                        {
                            "text": "I used a pencil so I could easily <w>erase</w> the mistake if I made one.",
                            "target_lang_translations": {
                                "zh": "我用了铅笔，这样如果写错了就能很容易地<w>擦掉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delete",
                        "remove",
                        "wipe"
                    ],
                    "antonyms": [
                        "record"
                    ],
                    "common_phrases": [
                        "erase the mistake",
                        "erase a memory"
                    ],
                    "target_lang_definitions": {
                        "zh": "擦掉或抹去书写或绘制的痕迹，或清除某物上的信息。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "擦掉",
                                "target_lang_sense_clarification": "指物理上擦除铅笔字迹或白板上的标记。"
                            },
                            {
                                "target_lang_word": "抹去",
                                "target_lang_sense_clarification": "指清除痕迹或记忆。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf51899-e832-36f7-a2e8-5cfc574491ce",
                    "sense_definition": "To delete files or clear data from a storage medium, such as a hard drive or tape.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to back up your personal files before you <w>erase</w> the hard drive.",
                            "target_lang_translations": {
                                "zh": "在<w>清除</w>硬盘之前，请务必备份你的个人文件。"
                            }
                        },
                        {
                            "text": "He decided to <w>erase</w> the hard drive completely before selling his old laptop.",
                            "target_lang_translations": {
                                "zh": "他决定在卖掉旧笔记本电脑前，将硬盘彻底<w>清除</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "wipe",
                        "format"
                    ],
                    "common_phrases": [
                        "erase the hard drive",
                        "erase the data"
                    ],
                    "target_lang_definitions": {
                        "zh": "删除文件或清除存储介质（如硬盘或磁带）中的数据。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清除",
                                "target_lang_sense_clarification": "指彻底清空存储设备中的数据。"
                            },
                            {
                                "target_lang_word": "删除",
                                "target_lang_sense_clarification": "指移除电子数据或文件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49d52c42-15c9-3516-a42b-5c51f864713c",
                    "sense_definition": "To marginalize, ignore, or eliminate the visibility or presence of a group, history, or culture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new curriculum attempts to <w>erase</w> history by removing discussions of minority groups.",
                            "target_lang_translations": {
                                "zh": "新课程试图通过删除关于少数群体的讨论来<w>抹杀</w>历史。"
                            }
                        },
                        {
                            "text": "Critics argued that the documentary tended to <w>erase</w> history by ignoring the contributions of local artists.",
                            "target_lang_translations": {
                                "zh": "评论家认为，这部纪录片通过忽视当地艺术家的贡献，有<w>抹杀</w>历史的倾向。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marginalize",
                        "ignore",
                        "suppress"
                    ],
                    "common_phrases": [
                        "erase history",
                        "erase the culture"
                    ],
                    "target_lang_definitions": {
                        "zh": "边缘化、忽视或消除某个群体、历史或文化的可见性或存在。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抹杀",
                                "target_lang_sense_clarification": "指在历史或文化层面否定或消除某事物的存在。"
                            },
                            {
                                "target_lang_word": "消除",
                                "target_lang_sense_clarification": "指使某事物的影响力或存在感消失。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab767412-b167-39ce-a18c-6d9b804b579f",
                    "sense_definition": "To murder or assassinate someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mafia hitman was hired to <w>erase</w> the key witness before the trial.",
                            "target_lang_translations": {
                                "zh": "那个黑手党杀手受雇在审判前<w>除掉</w>关键证人。"
                            }
                        },
                        {
                            "text": "The criminal syndicate planned to <w>erase</w> the rival gang leader.",
                            "target_lang_translations": {
                                "zh": "犯罪集团计划<w>除掉</w>敌对帮派的首领。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assassinate",
                        "eliminate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "谋杀或暗杀某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "除掉",
                                "target_lang_sense_clarification": "黑话，指暗杀或消灭某人。"
                            },
                            {
                                "target_lang_word": "干掉",
                                "target_lang_sense_clarification": "口语，指杀害某人。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85f8e35a-9572-3168-bec2-e77f76270905",
                    "sense_definition": "An act or operation of deleting stored data.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system initiated a full <w>erase</w> of the memory unit after the error occurred.",
                            "target_lang_translations": {
                                "zh": "错误发生后，系统启动了对内存单元的完全<w>清除</w>。"
                            }
                        },
                        {
                            "text": "The system initiated a data <w>erase</w> after three failed password attempts.",
                            "target_lang_translations": {
                                "zh": "在三次密码输入失败后，系统启动了数据<w>清除</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deletion"
                    ],
                    "common_phrases": [
                        "data erase"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "删除存储数据的行为或操作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清除",
                                "target_lang_sense_clarification": "指计算机系统中对数据的彻底删除操作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}