    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                "word": "Nazism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19921501-8c6e-3d01-ba71-f4f4043f424a",
                        "entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                        "glosses": [
                            "The ideology of the Nazi Party (the National Socialist German Workers' Party or NSDAP), being a form of fascism characterised by Adolf Hitler's cult of personality, hate propaganda, white supremacy, extreme bigotry (especially antisemitism and racism), eugenics, mass violence, genocide, ethnonationalist territorial expansion (Lebensraum) and state capitalism."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f2b9f89e-962d-336b-88bb-68826b713a00",
                        "entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                        "glosses": [
                            "The ideology of derived, copycat or other neo-Nazi groups that support most or all of that ideology."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b45f2344-4e70-4140-af19-b85ed4ddee07",
                        "source_entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                        "source_sense_description": "the ideology of Adolf Hitler's Nazi Party",
                        "target_lang_word": "nacismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nacismus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c835c7-47f4-3200-a5fa-dae53da25b75",
                                        "entry_id": "ed828d3e-8eb0-3d5f-a3f8-67f3a09c8aa7",
                                        "glosses": [
                                            "totalitní ideologie Německa v letech 1933–1945 založená na vypjatém nacionalismu, rasismu, prvcích socialismu, militarismu a antisemitismu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2cb2a4-5d64-44be-ba82-99a6164138ce",
                                                "sense_id": "f8c835c7-47f4-3200-a5fa-dae53da25b75",
                                                "text": "„Existuje-li přitom tak těsná vazba mezi monismem a totalitarismem, jak jsme právě naznačili, musíme dát za pravdu těm myslitelům (za všechny jmenujme alespoň Friedricha Augusta Hayeka a jeho knihu Cesta do otroctví), kteří nalézají kořeny nacismu i bolševismu právě v německé kultuře a za jakýsi předobraz obou totalitních režimů pokládají pruský stát s jeho všepronikající organizovaností a militarismem, stát, jehož dvorním filosofem ostatně nebyl nikdo jiný než Georg Wilhelm Friedrich Hegel.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e9e126-f1de-4de7-9b5d-85c3bd3732d2",
                        "source_entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                        "source_sense_description": "the ideology of Adolf Hitler's Nazi Party",
                        "target_lang_word": "nazisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nazisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "06cb1896-519d-37d2-9527-f2c5dabec37b",
                                        "entry_id": "3e81700f-4407-37b9-abd8-2c3a23438b04",
                                        "glosses": [
                                            "nationaalsocialisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af36f71-7818-44a9-add6-639f65d9ee41",
                                                "sense_id": "06cb1896-519d-37d2-9527-f2c5dabec37b",
                                                "text": "Wanneer iemand zijn leven heeft gegeven voor zijn geloof en daarmee een martelaar is geworden, is er voor zaligverklaring geen wonder nodig. Dat was zo bij Titus Brandsma, die in 1985 zalig werd vanwege zijn verzet tegen het nazisme."
                                            },
                                            {
                                                "example_id": "473c5abd-2941-488c-9e5a-f01faf08dac1",
                                                "sense_id": "06cb1896-519d-37d2-9527-f2c5dabec37b",
                                                "text": "Hitler en het nazisme zijn weliswaar geschiedenis, stelt hij, maar de methodes en de mentaliteit van het nazisme zijn onder ons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71b7bcfa-f76c-44bc-b591-4fcdfe89ea67",
                        "source_entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                        "source_sense_description": "the ideology of Adolf Hitler's Nazi Party",
                        "target_lang_word": "nazisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nazisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                        "entry_id": "fd289a16-bb29-37a4-9b92-eb08c00608f2",
                                        "glosses": [
                                            "Doctrine politique du parti national-socialiste allemand, et application de cette politique, ayant connu son apogée sous la direction d'Adolf Hitler de 1933 à 1945."
                                        ],
                                        "tags": [
                                            "Nazism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e14aa9e-932c-4700-8420-38dd62b21c6e",
                                                "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                                "text": "L’acquiescence active ou passive d'un vaste nombre d’Allemands au nazisme, la facile soumission de tous, sauf d'une brave et infime minorité, sont des faits d'une profonde signification historique."
                                            },
                                            {
                                                "example_id": "f666d2c2-17aa-47b9-b45d-8d9c37bf47d0",
                                                "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                                "text": "Il n’était pas possible d’admettre qu’Hitler eût raison, que le nazisme fût un espoir de l’Europe. Et si Hitler avait tort, il fallait s’obstiner contre lui."
                                            },
                                            {
                                                "example_id": "ab14829f-590e-40cb-b1ae-f50029331065",
                                                "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                                "text": "Avec le nazisme, nous le savons bien, c'est toute l'Europe qui avait sombré."
                                            },
                                            {
                                                "example_id": "d1f07aac-a68f-4bf5-9ef0-5f6ca4faf5da",
                                                "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                                "text": "Il y a eu plusieurs nazismes politiques que Hitler, quand il le fallait, a admirablement su jouer les uns contre les autres, selon le vieux principe « diviser pour régner »."
                                            },
                                            {
                                                "example_id": "709ddd6d-73c6-4d8b-9516-3595da76f612",
                                                "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                                "text": "Troisièmement, enfin, il réécrivirent l'histoire du nazisme et des dignitaires nazis, leur faisant subir un processus de « mythologisation », c'est-à-dire que les personnages et les faits historiques disparurent au profit d'une image mythique et le nazisme se « folklorisa », même si, globalement, la politique génocidaire nazie resta condamnée."
                                            },
                                            {
                                                "example_id": "b4f06783-8f26-444f-bf05-3c86cc328853",
                                                "sense_id": "9adbeb48-60e5-3daf-ac55-881894e4867e",
                                                "text": "Parvient-on à comprendre la nature du nazisme en ne retenant que les modalités de la mise à mort et en évacuant totalement les motivations de celles-ci ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24ab34a1-af09-4918-82b8-139b7fa23b30",
                        "source_entry_id": "84ab4acd-0f24-3b82-befb-6ed7142848eb",
                        "source_sense_description": "the ideology of Adolf Hitler's Nazi Party",
                        "target_lang_word": "Nazismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nazismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e780a395-da46-3bd1-b5b7-11fb7037da80",
                                        "entry_id": "513d6b53-e24a-38e5-8204-cfe864b154cb",
                                        "glosses": [
                                            "Nationalsozialismus"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc09027-53bf-4dbd-b473-3674f5739933",
                                                "sense_id": "e780a395-da46-3bd1-b5b7-11fb7037da80",
                                                "text": "„Über zehn Jahre Nazismus und der sich anschließende Sozialismus haben weder den katholischen Glauben der Sorben noch das Gesicht der Dörfer so beschädigen können, daß nicht wiederzuerkennen wäre, was sich mir einst als Kind eingeprägt hat.“"
                                            },
                                            {
                                                "example_id": "89b18add-c3f7-4008-aa7e-b0b3727ef8f7",
                                                "sense_id": "e780a395-da46-3bd1-b5b7-11fb7037da80",
                                                "text": "„Nazismus und Hass auf Andere, der mühelos den Schritt vom Wahlkreuz zur Vernichtung geht, gehört zu diesem Land.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
