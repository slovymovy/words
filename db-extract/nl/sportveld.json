                        "source_sense_description": "(sport) grasveld met doelpalen, grenslijnen e.d. waarop diverse sporten worden bedreven",
                        "target_lang_word": "Sportplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sportplatz",
