{
    "word_family": [
        "przekład",
        "przekładać",
        "przełożenie",
        "przełożony"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d466a5f-35e1-3dc1-9ce6-e74d5739f49a",
                    "sense_definition": "zmienić miejsce położenia czegoś, kładąc to gdzie indziej",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zmiana_miejsca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>przełożyć</w> te ciężkie książki na niższą półkę.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>переложить</w> эти тяжёлые книги на полку пониже."
                            }
                        },
                        {
                            "text": "Ona <w>przełożyła</w> telefon z torebki do kieszeni płaszcza.",
                            "target_lang_translations": {
                                "ru": "Она <w>переложила</w> телефон из сумочки в карман пальто."
                            }
                        }
                    ],
                    "synonyms": [
                        "przestawić"
                    ],
                    "common_phrases": [
                        "przełożyć z miejsca na miejsce"
                    ],
                    "target_lang_definitions": {
                        "ru": "положить что-либо в другое место, переместить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переложить",
                                "target_lang_sense_clarification": "в другое место или ёмкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9016e036-174a-3e99-aec1-135b5c085769",
                    "sense_definition": "zmienić planowany termin lub datę jakiegoś wydarzenia na inny czas",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz zachorował, dlatego musimy <w>przełożyć</w> wizytę na przyszły piątek.",
                            "target_lang_translations": {
                                "ru": "Врач заболел, поэтому нам нужно <w>перенести</w> визит на следующую пятницу."
                            }
                        },
                        {
                            "text": "Z powodu deszczu dyrektor <w>przełożył</w> spotkanie na świeżym powietrzu.",
                            "target_lang_translations": {
                                "ru": "Из-за дождя директор <w>перенёс</w> встречу на открытом воздухе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przełożyć spotkanie",
                        "przełożyć na inny termin",
                        "przełożyć na jutro"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить запланированный срок или дату события на другое время"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перенести",
                                "target_lang_sense_clarification": "на другой срок, дату или время"
                            },
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "на более позднее время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eef98687-e72b-3917-b792-63666c6561cc",
                    "sense_definition": "wyrazić treść tekstu lub wypowiedzi w innym języku",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tlumaczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młoda tłumaczka <w>przełożyła</w> współczesną powieść z hiszpańskiego na polski.",
                            "target_lang_translations": {
                                "ru": "Молодая переводчица <w>перевела</w> современный роман с испанского на польский."
                            }
                        },
                        {
                            "text": "Ten wiersz jest bardzo trudny i nikt jeszcze go dobrze nie <w>przełożył</w>.",
                            "target_lang_translations": {
                                "ru": "Это стихотворение очень трудное, и никто ещё хорошо его не <w>перевёл</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "przetłumaczyć"
                    ],
                    "common_phrases": [
                        "przełożyć z języka",
                        "przełożyć na język polski"
                    ],
                    "target_lang_definitions": {
                        "ru": "выразить содержание текста или речи на другом языке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевести",
                                "target_lang_sense_clarification": "на другой язык"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85f2bf6b-6f2c-3685-b490-c4e63e270f24",
                    "sense_definition": "umieścić coś w taki sposób, aby przechodziło przez coś lub zwisało po drugiej stronie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiana_miejsca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażer szybko <w>przełożył</w> pas bezpieczeństwa przez ramię.",
                            "target_lang_translations": {
                                "ru": "Пассажир быстро <w>перекинул</w> ремень безопасности через плечо."
                            }
                        },
                        {
                            "text": "Dziewczynka <w>przełożyła</w> rękę przez ogrodzenie, żeby pogłaskać psa sąsiadów.",
                            "target_lang_translations": {
                                "ru": "Девочка <w>просунула</w> руку через забор, чтобы погладить соседскую собаку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przełożyć przez ramię",
                        "przełożyć przez płot"
                    ],
                    "target_lang_definitions": {
                        "ru": "поместить что-либо так, чтобы оно проходило сквозь что-то или свешивалось с другой стороны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекинуть",
                                "target_lang_sense_clarification": "через плечо, через забор"
                            },
                            {
                                "target_lang_word": "просунуть",
                                "target_lang_sense_clarification": "сквозь отверстие или преграду"
                            },
                            {
                                "target_lang_word": "переложить",
                                "target_lang_sense_clarification": "через край или преграду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc13b204-3ed1-3f6d-ba43-fcf412ab3dc6",
                    "sense_definition": "umieścić coś warstwami między innymi rzeczami",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ukladanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharz upiekł biszkopt i <w>przełożył</w> ciasto kremem czekoladowym.",
                            "target_lang_translations": {
                                "ru": "Повар испёк бисквит и <w>прослоил</w> торт шоколадным кремом."
                            }
                        },
                        {
                            "text": "Przed wysyłką <w>przełożyła</w> delikatne talerze miękkim papierem.",
                            "target_lang_translations": {
                                "ru": "Перед отправкой она <w>переложила</w> хрупкие тарелки мягкой бумагой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przełożyć ciasto kremem"
                    ],
                    "target_lang_definitions": {
                        "ru": "поместить что-либо слоями между другими предметами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прослоить",
                                "target_lang_sense_clarification": "кремом, начинкой"
                            },
                            {
                                "target_lang_word": "переложить",
                                "target_lang_sense_clarification": "слоями, бумагой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70100c1d-9187-3ea8-9f8e-94277c9c355c",
                    "sense_definition": "uznać coś lub kogoś za ważniejszego od kogoś innego; dać czemuś pierwszeństwo",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wartosciowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawsze <w>przełożył</w> dobro własnej rodziny ponad swoje osobiste ambicje.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>ставил</w> благополучие собственной семьи <w>выше</w> своих личных амбиций."
                            }
                        },
                        {
                            "text": "Nigdy nie <w>przełożyłby</w> zysku nad uczciwość wobec swoich klientów.",
                            "target_lang_translations": {
                                "ru": "Он никогда не <w>поставил бы</w> прибыль <w>выше</w> честности по отношению к своим клиентам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przełożyć ponad wszystko",
                        "przełożyć interes nad"
                    ],
                    "target_lang_definitions": {
                        "ru": "отдать предпочтение чему-либо или кому-либо; поставить выше другого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставить выше",
                                "target_lang_sense_clarification": "отдать предпочтение"
                            },
                            {
                                "target_lang_word": "предпочесть",
                                "target_lang_sense_clarification": "выбрать в первую очередь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "241a7619-b33c-3758-b043-12ef77b44205",
                    "sense_definition": "wytłumaczyć coś komuś, przekonać kogoś do zmiany zdania lub uświadomić rację",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tlumaczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Długo rozmawialiśmy, aż wreszcie ojciec <w>przełożył</w> synowi powagę sytuacji.",
                            "target_lang_translations": {
                                "ru": "Мы долго разговаривали, пока наконец отец не <w>растолковал</w> сыну всю серьёзность ситуации."
                            }
                        },
                        {
                            "text": "Nauczyciel cierpliwie <w>przełożył</w> uczniom zasady panujące w nowej klasie.",
                            "target_lang_translations": {
                                "ru": "Учитель терпеливо <w>разъяснил</w> ученикам правила, действующие в новом классе."
                            }
                        }
                    ],
                    "synonyms": [
                        "wytłumaczyć",
                        "wyjaśnić"
                    ],
                    "common_phrases": [
                        "przełożyć do rozumu"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane rzadziej we współczesnej polszczyźnie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "растолковать, убедить кого-либо в чём-либо или заставить осознать правоту"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растолковать",
                                "target_lang_sense_clarification": "доходчиво объяснить"
                            },
                            {
                                "target_lang_word": "разъяснить",
                                "target_lang_sense_clarification": "пояснить суть дела"
                            },
                            {
                                "target_lang_word": "втемяшить",
                                "target_lang_sense_clarification": "убедить, внушить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "477e6c97-d94a-307b-9754-269b5a1846f0",
                    "sense_definition": "podzielić potasowaną talię kart na dwie części i zamienić ich kolejność",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ukladanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gracz po lewej stronie rozdającego szybko <w>przełożył</w> talię przed rozpoczęciem partii.",
                            "target_lang_translations": {
                                "ru": "Игрок слева от сдающего быстро <w>снял</w> колоду перед началом партии."
                            }
                        },
                        {
                            "text": "Zanim rozdasz karty wszystkim przy stole, musisz je dokładnie <w>przełożyć</w>.",
                            "target_lang_translations": {
                                "ru": "Прежде чем раздать карты всем за столом, ты должен их аккуратно <w>снять</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przełożyć talię",
                        "przełożyć karty"
                    ],
                    "target_lang_definitions": {
                        "ru": "разделить перетасованную колоду карт на две части и поменять их местами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снять",
                                "target_lang_sense_clarification": "колоду карт"
                            },
                            {
                                "target_lang_word": "подснять",
                                "target_lang_sense_clarification": "карты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}