                                    {
                                        "sense_id": "5b299ef0-eba9-34b6-82be-d1ee8f99bb98",
                                        "entry_id": "212cdd09-33fb-3104-a024-40b4997564d6",
                                        "glosses": [
                                            "Initialism of Democratic People's Republic of Korea, official name of North Korea: a country in East Asia."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3419111e-fae5-4e2c-9384-9f81f3f2da97",
                                                "sense_id": "5b299ef0-eba9-34b6-82be-d1ee8f99bb98",
                                                "text": "In addition, on the basis of making full use of Dalian and Qinhuangdao ports for exports, we should fully use Qingjin and Luojin ports in the DPRK to expand our province's export commodity capacity."
                                            },
                                            {
                                                "example_id": "d70f5dc0-1a78-4317-8dba-fbbd7ebdfc7e",
                                                "sense_id": "5b299ef0-eba9-34b6-82be-d1ee8f99bb98",
                                                "text": "There are plenty of soldiers in the surrounding Yanbian Korean Autonomous Prefecture, the official Chinese name for the region, mounting guard along the nearby border with the DPRK. […] Yanbian, Yanji apart, is one of the least densely populated regions of China outside the high plateau of Tibet and the deserts of Xinjiang."
                                            },
                                            {
                                                "example_id": "3daca52b-574b-4f34-a32d-553ff18305df",
                                                "sense_id": "5b299ef0-eba9-34b6-82be-d1ee8f99bb98",
                                                "text": "The DPRK government maintains different systems of labor camps – the kwan-li-so, or political prison camps, and the kwo-hwa-so, or reeducation labor camps – among other types of detention facilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
