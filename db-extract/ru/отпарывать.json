                                        "sense_id": "45bce65e-35cc-3733-b258-a4276279cbf2",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To undo sewing stitches."
                                        ],
                                        "tags": [],
                                        "examples": []
