                                                "sense_id": "53fbe2ca-301d-35be-aa29-b62fd4a57a04",
                                                "text": "Szlachcica zatrzymał prosty chłop ubrany w proste szaty i prosił o pomoc."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "4ab9bc9f-72af-3f17-946e-dd226ef0e9b5",
                                        "entry_id": "2d0d95a2-451d-3fff-afaa-8050735dbc04",
