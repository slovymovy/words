                "senses": [
                    {
                        "sense_id": "08d35aef-2a90-3199-8c54-d78a099892a3",
                        "entry_id": "5609b49b-0b9b-35ae-8508-9424d1e05370",
                        "glosses": [
                            "To set off, get going; to start a journey."
                        ],
                        "tags": [
                            "US",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "082f8309-00fb-4b5c-913f-61a63786eeb4",
                                "sense_id": "08d35aef-2a90-3199-8c54-d78a099892a3",
                                "text": "Haven't got time. I must mosey up to the North End to see a man who has got a lovely throat. Nobody can find out what is the matter. He has puzzled all the doctors."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b141500-b2eb-3e97-bb97-b76b749841a3",
                        "entry_id": "5609b49b-0b9b-35ae-8508-9424d1e05370",
                        "glosses": [
                            "To go off quickly: to hurry up."
                        ],
                        "tags": [
                            "US",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "52168978-4e66-39a2-a15b-f971bb095d75",
                        "entry_id": "5609b49b-0b9b-35ae-8508-9424d1e05370",
                        "glosses": [
                            "To amble; to walk or proceed in a leisurely manner."
                        ],
                        "tags": [
                            "US",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d8fe1875-e8d7-463e-a915-31238e86726c",
                                "sense_id": "52168978-4e66-39a2-a15b-f971bb095d75",
                                "text": "We'll mosey along toward the river. Kinder take it easy an' drift the herd down slow so as to let the cattle put on flesh."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "106d333d-3d07-448d-b21f-260eda59e1c0",
                        "source_entry_id": "5609b49b-0b9b-35ae-8508-9424d1e05370",
                        "source_sense_description": "to set off",
                        "target_lang_word": "starten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50abdbc8-8076-330b-9da7-2d4b8d554a21",
                                        "entry_id": "1fbb6968-4a82-3820-b475-b1798ac34d0d",
                                        "glosses": [
                                            "einen Vorgang beginnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6556aaef-2637-4ff1-84ca-8b67abf17499",
                                                "sense_id": "50abdbc8-8076-330b-9da7-2d4b8d554a21",
                                                "text": "Zu Beginn der Sommerferien starten viele Familien ihren Urlaub."
                                            },
                                            {
                                                "example_id": "6fc423a9-c944-46a5-984e-b989fda2a8c8",
                                                "sense_id": "50abdbc8-8076-330b-9da7-2d4b8d554a21",
                                                "text": "Wir haben ein neues Projekt gestartet."
                                            },
                                            {
                                                "example_id": "acffe840-43b6-4ec9-a4f5-3eb1a883ba33",
                                                "sense_id": "50abdbc8-8076-330b-9da7-2d4b8d554a21",
                                                "text": "„Deshalb startete er diesen Feldzug, der dann mit dem fehlgeschlagenen Opfer der beiden Löwen unter denkbar unglücklichen Vorzeichen begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c87d2ecf-a535-3050-a371-d2a39f376063",
                                        "entry_id": "1fbb6968-4a82-3820-b475-b1798ac34d0d",
                                        "glosses": [
                                            "einen Motor zum Laufen bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e32780a-4e93-4dcd-a333-90e1071dea94",
                                                "sense_id": "c87d2ecf-a535-3050-a371-d2a39f376063",
                                                "text": "Versuch noch einmal, den Motor zu starten!"
                                            },
                                            {
                                                "example_id": "58ff0a86-e193-43e1-9291-9fe1bfbf5063",
                                                "sense_id": "c87d2ecf-a535-3050-a371-d2a39f376063",
                                                "text": "Matti hat den Rasenmäher dann doch gestartet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1eecf39d-e7b5-3eba-af32-eb402e8c00e1",
                                        "entry_id": "1fbb6968-4a82-3820-b475-b1798ac34d0d",
                                        "glosses": [
                                            "einen Wettkampf eröffnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e53588e-6822-4b1c-b94d-b9ed8c54c8fc",
                                                "sense_id": "1eecf39d-e7b5-3eba-af32-eb402e8c00e1",
                                                "text": "Früher wurden Autorennen durch Senken einer Flagge gestartet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "starten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "707592a0-9390-372e-8d4b-7fe3353fa165",
                                        "entry_id": "9e23e5c0-2297-327a-b347-85c8508de3ec",
                                        "glosses": [
                                            "einen Vorgang beginnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b61419-6e95-41dd-9775-06709eabf69d",
                                                "sense_id": "707592a0-9390-372e-8d4b-7fe3353fa165",
                                                "text": "Der Triathlet ist zu spät gestartet, um den Ausgang des Rennens noch beeinflussen zu können."
                                            },
                                            {
                                                "example_id": "bd5594e9-3729-451d-8649-745aac636052",
                                                "sense_id": "707592a0-9390-372e-8d4b-7fe3353fa165",
                                                "text": "Ich bin dieses Jahr zum ersten Mal bei den Senioren gestartet."
                                            },
                                            {
                                                "example_id": "af56821a-10a8-4b09-a30b-99db05fd21e7",
                                                "sense_id": "707592a0-9390-372e-8d4b-7fe3353fa165",
                                                "text": "Die Rakete startete um acht Uhr MEZ."
                                            },
                                            {
                                                "example_id": "6c743232-36b7-41dc-aeb3-0a5c5e96558f",
                                                "sense_id": "707592a0-9390-372e-8d4b-7fe3353fa165",
                                                "text": "„Im Flugsport kann sich z.B. eine Ordalsituation andeuten, wenn ein Pilot auf seinen Gerät- und Startcheck verzichtet, wenn ein Paragleiter bei Föhn oder aufziehender Gewitterfront einen Flug wagt, wenn ein Drachenflieger in ein Wolkenfenster startet, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3bf4c6e-4d70-44ab-9a17-19b3cc08e8d9",
                        "source_entry_id": "5609b49b-0b9b-35ae-8508-9424d1e05370",
                        "source_sense_description": "to set off",
                        "target_lang_word": "beginnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beginnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee48b907-bbb7-32b1-b23b-dc9023e0a311",
                                        "entry_id": "184bb176-0b31-39fa-81ed-236f6fd1e576",
                                        "glosses": [
                                            "etwas in Gang setzen, etwas starten, etwas anfangen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c629916e-d050-43fd-b127-ae718d697806",
                                                "sense_id": "ee48b907-bbb7-32b1-b23b-dc9023e0a311",
                                                "text": "„Seine Fliegerlaufbahn begann er mit 14 Jahren in einem Segelflugzeug, mit 18 hatte er die Lizenz als Motorflieger.“"
                                            },
                                            {
                                                "example_id": "31557212-e6c6-46de-90c8-7e423a216610",
                                                "sense_id": "ee48b907-bbb7-32b1-b23b-dc9023e0a311",
                                                "text": "Morgen beginne ich mit der Therapie."
                                            },
                                            {
                                                "example_id": "ca9f77e3-0fb2-4f2d-b6ed-672a38fd77b3",
                                                "sense_id": "ee48b907-bbb7-32b1-b23b-dc9023e0a311",
                                                "text": "Wir beginnen die Reise in Cuxhaven."
                                            },
                                            {
                                                "example_id": "5aee7e04-953b-4a0d-9969-6b9f964597fe",
                                                "sense_id": "ee48b907-bbb7-32b1-b23b-dc9023e0a311",
                                                "text": "Wir dachten am nächsten Wochenende mit den Übungen zu beginnen."
                                            },
                                            {
                                                "example_id": "b0bb89e0-c510-4606-aed2-6d7923d20690",
                                                "sense_id": "ee48b907-bbb7-32b1-b23b-dc9023e0a311",
                                                "text": "„Am Tag nach dem Feuer auf einem mit Öl beladenen Tankschiff auf der Ostsee beginnt die Suche nach der Ursache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "910a5e8e-345c-39ab-a8d9-80127a6be502",
                                        "entry_id": "184bb176-0b31-39fa-81ed-236f6fd1e576",
                                        "glosses": [
                                            "sich in Bewegung setzen, starten, anfangen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b86fe5-e81a-4d11-9b8b-e43ce19357bb",
                                                "sense_id": "910a5e8e-345c-39ab-a8d9-80127a6be502",
                                                "text": "Morgen beginnt meine Therapie."
                                            },
                                            {
                                                "example_id": "88cc9b86-9f68-49ee-a3a3-649374cf5512",
                                                "sense_id": "910a5e8e-345c-39ab-a8d9-80127a6be502",
                                                "text": "Der Tag hat so schön begonnen."
                                            },
                                            {
                                                "example_id": "4a350eab-1ccb-4d08-9033-90bc99a8d012",
                                                "sense_id": "910a5e8e-345c-39ab-a8d9-80127a6be502",
                                                "text": "Die Vorstellung hat doch noch gar nicht begonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
