                "senses": [
                    {
                        "sense_id": "600a5a53-eccd-3ee3-a2ba-fc743b981241",
                        "entry_id": "dedb4588-1e46-392d-9a5a-f4aec8c07bf2",
                        "glosses": [
                            "zonder chloor; zonder dat er chloor gebruikt is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b970c677-66ba-410c-b71f-4e5368419fa8",
                                "sense_id": "600a5a53-eccd-3ee3-a2ba-fc743b981241",
                                "text": "FAIRkleding steekt zijn complete marketingbudget in dit ene model jeans van biologisch katoen met chloorvrije wassing en knopen zonder zware metalen."
                            },
                            {
                                "example_id": "ee8ccb20-b090-46b6-b07f-05191f822525",
                                "sense_id": "600a5a53-eccd-3ee3-a2ba-fc743b981241",
                                "text": "Eind 1994 stelde de Europese Unie al scherpe grenzen aan productie en gebruik van chloorfluorkoolwaterstoffen. Deze verbindingen kunnen jaren nadat ze in het milieu belanden, in de stratosfeer boven de polen chemische reacties veroorzaken die de ozonlaag aantasten. Inmiddels zijn er voldoende alternatieven voor de milieugevaarlijke verbindingen. Zo kunnen koelkasten bijvoorbeeld de koolwaterstof pentaan (C5H12) gebruiken. Ook zijn er chloorvrije fluorkoolwaterstoffen."
                            },
                            {
                                "example_id": "e9ff1eb3-98a9-470c-bbc6-339a290d1a19",
                                "sense_id": "600a5a53-eccd-3ee3-a2ba-fc743b981241",
                                "text": "Het is voor het eerst dat bij een buitenbad onderzoek wordt gedaan. Het Twentebad is zeer geïnteresseerd; het bad verbood eerder uit hygiëne-overwegingen de Björn Borg-onderbroeken onder de zwembroeken. Keuten streeft in zijn promotie-onderzoek naar een chloorvrij zwembad."
                            }
                        ]
                    }
