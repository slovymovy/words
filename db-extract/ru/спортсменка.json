                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93acdf73-145b-4fbb-9ae2-7d7d90bc4cff",
                                "sense_id": "df564309-a8d1-3e4e-aea6-c66841cfb4e9",
                                "text": "В двенадцать лет спортсменка выиграла чемпионат России, после чего пообещала завоевать золото на Олимпиаде, что и сделала спустя шесть лет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
