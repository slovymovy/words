                                    {
                                        "sense_id": "68d72a01-5de1-3635-81e4-41aa89d3e2ae",
                                        "entry_id": "e9f6fb0f-3228-3a9d-ba7e-79440de6dbe8",
                                        "glosses": [
                                            "een oord met geneeskrachtige baden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0784c3-5847-4fd6-9cce-aa0484d135b1",
                                                "sense_id": "68d72a01-5de1-3635-81e4-41aa89d3e2ae",
                                                "text": "Een kuuroord heeft een zeer ontspannende werking."
