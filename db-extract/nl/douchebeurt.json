                        "examples": [
                            {
                                "example_id": "c2125040-fc06-4656-b92f-273ff6ce5911",
                                "sense_id": "5a2bb8f3-5a8a-3e04-bdb3-c32171a7320f",
                                "text": "De verpleegkundige kijkt bedenkelijk en besluit dan dat er tijdwinst gloort. Nu kan Elza haar ogen dichtdoen om uit te rusten van de douchebeurt. Ze houdt de armsteun vast en probeert zich te ontspannen."
                            },
                            {
                                "example_id": "b0778a6f-769a-4e47-9b19-6a756030b966",
                                "sense_id": "5a2bb8f3-5a8a-3e04-bdb3-c32171a7320f",
                                "text": "Bij het douchen verbruik je zo'n 10 liter water per minuut. Het is daarmee het meest waterverspillende wat je kunt doen in huis. Volgens onderzoek doen volwassenen er gemiddeld acht minuten over om zich te wassen. Dat betekent dat een Kaapstatter al meer dan het maximale dagelijkse watergebruik van 50 liter aan één douchebeurt zou verspillen."
                            }
                        ]
                    }
