    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                "word": "stricture",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e1c8b67-d583-4924-b467-60cd537fbfd3",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "strictures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "A rule restricting behaviour or action."
                        ],
                        "tags": [
                            "countable",
                            "plural-normally",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "740aee93-18ac-415c-9ea4-db63fc03cacc",
                                "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                "text": "To his eyes it had no attraction; it savoured of simony, and was likely to bring down upon him harder and more deserved strictures than any he had yet received: he positively declined to become vicar of Puddingdale under any circumstances."
                            },
                            {
                                "example_id": "c4641e49-113d-48fd-b6ad-11c8e4ddb270",
                                "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                "text": "1931 Edgar Wallace: Again Sanders\n\"That is a matter for you to discuss with the Government,\" said Sanders, in his iciest tone. \"I am only authorized to collect twenty-eight thousand.\nI will note your strictures and report them to Whitehall.\"\n\"I'm passing no strictures said the Major, hastily.\nHe had been warned against Sanders..."
                            },
                            {
                                "example_id": "36f0ba28-59ae-47ae-83ca-f04d51c12752",
                                "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                                "text": "Even venerable print publications seem to accept that old strictures no longer apply when they move online."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "A general state of restrictiveness on behavior, action, or ideology."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d8af0824-c4de-4cb1-a134-64a65f140748",
                                "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                                "text": "I just couldn't take the stricture of that place a single day more."
                            },
                            {
                                "example_id": "41b9f60a-f94e-4602-9ea4-80c817df3252",
                                "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                                "text": "For many young people throughout Britain in the 1970s, Northern Soul became a truly alternative lifestyle with the rites and values of the scene replacing many of the traditional strictures of society."
                            }
                        ]
                    },
                    {
                        "sense_id": "e87e60a7-d071-36e3-998e-bb76e481ff2c",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "A sternly critical remark or review."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2fc4496e-db45-4e75-98e4-03ee2d2d406a",
                                "sense_id": "e87e60a7-d071-36e3-998e-bb76e481ff2c",
                                "text": "When he read the poem to his parents, upon its conclusion, both were much impressed by it, though his father made severe strictures upon its lack of polish, its terminal inconcision, and its vagueness of thought."
                            }
                        ]
                    },
                    {
                        "sense_id": "0aa32909-cffb-3e04-8174-c0442516381a",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "Abnormal narrowing of a canal or duct in the body."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f4812b-e2c2-4aab-ad44-bd0a79c923c0",
                                "sense_id": "0aa32909-cffb-3e04-8174-c0442516381a",
                                "text": "Even in the brief moment of his entrance into the magnificence of Anthony Harding's home he had felt a strange little stricture of the throat—a choking, half-suffocating sensation."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7233fdf-b330-3096-9079-d91f9be10085",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "Strictness."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "de87b34e-9147-4e14-a9d7-edaf749c90ab",
                                "sense_id": "a7233fdf-b330-3096-9079-d91f9be10085",
                                "text": "a man of stricture and firm abstinence"
                            }
                        ]
                    },
                    {
                        "sense_id": "d49fb412-5fe8-3db2-b923-04154508690f",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "A stroke; a glance; a touch."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "83e1bfc2-cd3e-47c7-8550-c4fadcb84e90",
                                "sense_id": "d49fb412-5fe8-3db2-b923-04154508690f",
                                "text": "But whatever may be said of other matters , certainly the first draughts and strictures of Natural Religion and Morality are naturally in the Mind"
                            }
                        ]
                    },
