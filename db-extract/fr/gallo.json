                                "target_senses": [
                                    {
                                        "sense_id": "76d3b152-c195-3a2c-8ed6-e9566e60de96",
                                        "entry_id": "8afb107f-b369-3a1d-aa78-d698cc45e30c",
                                        "glosses": [
                                            "A Romance language spoken in north-west France, see Gallo language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87c4b3bc-a05a-342b-9a25-f4100204a4a2",
                                        "entry_id": "8afb107f-b369-3a1d-aa78-d698cc45e30c",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                        "entry_id": "8afb107f-b369-3a1d-aa78-d698cc45e30c",
                                        "glosses": [
                                            "A brand of low-priced California wine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c494256-6509-4000-a629-3a39a5e43895",
                                                "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                                "text": "\"A few bottles of Gallo muscatel, and you with all them trinkets.\""
                                            },
                                            {
                                                "example_id": "b7deac3c-775e-40b8-b32f-6081f68a3e3f",
                                                "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                                "text": "But Vincent was carrying a sack of groceries. He wasn't going to drop a half gallon of Gallo Hearty Burgundy, a bottle of prune juice and a jar of Ragu spaghetti sauce on the sidewalk."
                                            },
                                            {
                                                "example_id": "d96849d8-7452-4f2e-a424-304a897d9f3a",
                                                "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                                "text": "On a good day he'd rip through several bottles of Gallo White Port and a fifth of bargain scotch. If he stumbled upon a twenty-dollar bill he would drink Irish whiskey."
                                            },
                                            {
                                                "example_id": "75e574ea-25aa-4b45-94fa-d299c415b93b",
                                                "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                                "text": "I ate the result, drank some Gallo white and was ready to shout instructions and encouragement to Buddy Bell and the Tigers [...]."
                                            },
                                            {
                                                "example_id": "1a6bb41f-0d7b-43c0-b63a-ca8e750d9cd6",
                                                "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                                "text": "\"I'll get it,\" she said. \"I promised your mother I'd keep an eye on you.\" Yeah, right, Ronnie thought, you and the Gallo Brothers."
                                            },
                                            {
                                                "example_id": "11ac7a68-685d-40f6-af02-82d4fdca0e8e",
                                                "sense_id": "1d3f6a65-99c0-36ac-9f7f-44d6a11b0c69",
                                                "text": "The last thing I wanted was to lapse into maudlin snuffling, or get stopped for driving while under the influence of the Gallo boys"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
