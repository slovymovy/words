                ],
                "senses": [
                    {
                        "sense_id": "2efe2026-8b80-3fbf-9ff7-b13293cda37a",
                        "entry_id": "da347d1b-ef19-320b-83a3-9cf732578a43",
                        "glosses": [
                            "Accorder le titre de baron à (quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3577c6-780f-4c08-bfa0-f165808e79d8",
                                "sense_id": "2efe2026-8b80-3fbf-9ff7-b13293cda37a",
                                "text": "Votre Altesse ne croira pas peut- être que j'aie trouvé en ruminant un expédient à cette affaire : c'est de me faire baroniser à Vienne."
                            },
                            {
                                "example_id": "18ccb017-c3ad-4c31-9ca7-a6c3a52bdf83",
                                "sense_id": "2efe2026-8b80-3fbf-9ff7-b13293cda37a",
                                "text": "Elle ne manquait jamais de l’appeler par son titre, à l’imitation de Bernage qui baronisait volontiers son futur gendre, et cette fois, elle appuya sur le mot, […]."
                            },
                            {
                                "example_id": "07237815-2117-4c9b-90aa-fa76f9766cad",
                                "sense_id": "2efe2026-8b80-3fbf-9ff7-b13293cda37a",
                                "text": "Elle aurait pensé à « baroniser » le chef de la famille Caillaux."
                            }
                        ]
                    }
                ],
