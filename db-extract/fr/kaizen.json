                "senses": [
                    {
                        "sense_id": "155f27b2-e284-3c00-b0d3-da3d00b0a02b",
                        "entry_id": "b49c2aed-3b1f-3dfc-8170-e0dd931fc566",
                        "glosses": [
                            "Démarche d’amélioration continue des procédés de fabrication et de la logistique."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "930c9dfb-9747-40ea-80be-049bd73589a9",
                                "sense_id": "155f27b2-e284-3c00-b0d3-da3d00b0a02b",
                                "text": "Les éléments clés du kaizen sont la qualité, l’effort, la volonté de changer et la communication."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f76e36c-f036-3717-b7a4-435cda558563",
                        "entry_id": "b49c2aed-3b1f-3dfc-8170-e0dd931fc566",
                        "glosses": [
                            "Philosophie qui consiste en l’accomplissement de petits pas afin de progresser vers l’excellence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966f2ab8-3e55-4292-9b18-fbbbd5069511",
                                "sense_id": "5f76e36c-f036-3717-b7a4-435cda558563",
                                "text": "Un petit pas peut changer votre vie : La voie du kaizen"
                            },
                            {
                                "example_id": "189469bc-520b-41a9-a42c-c3729aa8114f",
                                "sense_id": "5f76e36c-f036-3717-b7a4-435cda558563",
                                "text": "Kaizen, c’est progresser jour après jour, à son pas, à son rythme, à sa mesure."
                            }
                        ]
                    }
                ],
