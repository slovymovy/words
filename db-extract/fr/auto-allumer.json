                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64e405c-f401-4eaa-9e27-71341646f17c",
                                "sense_id": "b40965d4-1aae-3a10-8819-c0ab24d6c43f",
                                "text": "Et l'indice de cétane, ça dit comment le carburant est facile à auto-allumer sous pression."
