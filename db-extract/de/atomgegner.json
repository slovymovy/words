                "senses": [
                    {
                        "sense_id": "3f77417e-af00-3e19-a876-22be434dec37",
                        "entry_id": "e26015f5-6164-311d-a279-22cff2887d78",
                        "glosses": [
                            "eine Person, die gegen das Betreiben von Atomkraftwerken (Kernkraftwerken) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79397355-9e9a-4759-835b-300b55da6508",
                                "sense_id": "3f77417e-af00-3e19-a876-22be434dec37",
                                "text": "„Man stelle sich vor: Atomgegner blockierten in regelmäßiger Unregelmäßigkeit die österreichisch-deutsche Grenze, um etwa gegen den betagten Siedewasserreaktor Isar I in Niederbayern zu protestieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06268655-682d-4d8e-8919-4eb2f8743b1d",
                        "source_entry_id": "e26015f5-6164-311d-a279-22cff2887d78",
                        "source_sense_id": "3f77417e-af00-3e19-a876-22be434dec37",
                        "source_sense_description": "Politik: eine Person, die gegen das Betreiben von Atomkraftwerken (Kernkraftwerken) ist",
                        "target_lang_word": "anti-nuclear activist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "52b85bbd-0243-4b79-8bce-f1b4a96e22e9",
                        "source_entry_id": "e26015f5-6164-311d-a279-22cff2887d78",
                        "source_sense_id": "3f77417e-af00-3e19-a876-22be434dec37",
                        "source_sense_description": "Politik: eine Person, die gegen das Betreiben von Atomkraftwerken (Kernkraftwerken) ist",
                        "target_lang_word": "antinucléaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antinucléaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47d682eb-bc02-3d2b-85fd-d1c3ef3cdd0f",
                                        "entry_id": "32197cea-9286-3ff2-9478-df5980c55a8f",
                                        "glosses": [
                                            "Qui s’oppose à l’emploi civil ou militaire de l’énergie nucléaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89acdba2-83d9-41f1-8324-85c9f1fb4965",
                                                "sense_id": "47d682eb-bc02-3d2b-85fd-d1c3ef3cdd0f",
                                                "text": "L’opinion est donc une matière flasque, dangereuse, manipulable et manipulée. L’opinion est le résultat d’un rapport de force. Il est de notoriété publique que le mouvement antinucléaire allemand a été financé par les fabricants de lignite et l’Union soviétique qui, dans les années 1950, souhaitait dans ce domaine son retard sur les pays occidentaux."
                                            },
                                            {
                                                "example_id": "3b8ecf60-e75d-479d-acfc-707a9c3a245c",
                                                "sense_id": "47d682eb-bc02-3d2b-85fd-d1c3ef3cdd0f",
                                                "text": "Certes, il faut faire un sérieux effort, mais essayons. Essayons d’imaginer un ancien Premier ministre antinucléaire. Par exemple, un Valls, un Raffarin, un Fillon, un Ayrault… Difficile, non ? Voire impossible. Et pourtant ça existe. Pas chez nous, mais au Japon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antinucléaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38eedc20-0051-3314-b475-a8f864009767",
                                        "entry_id": "6975d0a8-fde7-32d7-ad86-1cd337384e6b",
                                        "glosses": [
                                            "Personne qui s’oppose à l’emploi de l’énergie nucléaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493cc233-b21f-4d64-99b2-ace8bce51962",
                                                "sense_id": "38eedc20-0051-3314-b475-a8f864009767",
                                                "text": "Le renchérissement du pétrole complique la lutte des antinucléaires pour des énergies écologiques."
                                            },
                                            {
                                                "example_id": "b149eb67-0d7e-4ac3-bbf8-3d7b49fafa0d",
                                                "sense_id": "38eedc20-0051-3314-b475-a8f864009767",
                                                "text": "De quoi creuser tranquillement la plus grande poubelle nucléaire française et y enfouir les 100 000 prochaines années les déchets les plus radioactifs du pays. Mais voilà que des antinucléaires se mettent à repeupler l’endroit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
