                            },
                            {
                                "target_lang_word": "единый",
                                "target_lang_sense_clarification": "неделимый, неразрывный"
                            },
                            {
                                "target_lang_word": "монолитный",
                                "target_lang_sense_clarification": "плотный, плотно сплочённый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f155c8ce-f189-3c3d-b4f5-d9c72c63196f",
                    "sense_definition": "o figurze, zbiorze punktów lub grafie: stanowiący pojedynczy połączony kawałek, w którym między każdą parą punktów istnieje droga",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matematyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W teorii grafów graf <w>spójny</w> to taki, w którym każda para wierzchołków jest połączona ścieżką.",
                            "target_lang_translations": {
                                "ru": "В теории графов <w>связный</w> граф — это такой, в котором любая пара вершин соединена путем."
                            }
                        },
                        {
                            "text": "Podczas wykładu z topologii analizowaliśmy właściwości <w>spójnej</w> przestrzeni metrycznej.",
                            "target_lang_translations": {
                                "ru": "На лекции по топологии мы анализировали свойства <w>связного</w> метрического пространства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graf spójny",
                        "zbiór spójny"
                    ],
                    "target_lang_definitions": {
                        "ru": "о фигуре, множестве или графе: представляющий собой единый непрерывный объект, где любые две точки соединены путем"
                    },
