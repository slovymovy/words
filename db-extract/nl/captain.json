                            {
                                "example_id": "c0e5730e-6d6f-48e7-ab7e-b0a26fceab23",
                                "sense_id": "c6e42842-ce72-3c37-b23a-468118623d4a",
                                "text": "- De captain overlegde tijdens de wedstrijd met de scheidsrechter."
                            },
                            {
                                "example_id": "1bb1880c-1820-43fd-bc26-ce7662a9b2b8",
                                "sense_id": "c6e42842-ce72-3c37-b23a-468118623d4a",
                                "text": "- Hodgsons nam een „grote gok”, spraken tabloids en kwaliteitskranten gistermorgen eender over het voornemen om de basiself van de voorgaande twee duels voor (ruim) de helft om te gooien. Rust voor sommigen (captain Wayne Rooney, beide backs), een beloning voor anderen zoals aanvallers Jamie Vardy en Daniel Sturridge, die tegen Wales het verschil maakten."
                            }
                        ]
                    },
                    {
                        "sense_id": "daed8f35-de47-32b6-8666-9f7141af7566",
