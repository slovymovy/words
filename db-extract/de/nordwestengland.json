                "senses": [
                    {
                        "sense_id": "c3025f18-5905-32c8-be3c-5b75a76706ce",
                        "entry_id": "421e0ff7-aed9-3145-aed6-2d4794b095b7",
                        "glosses": [
                            "der nordwestliche Teil Englands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "775cb312-68d2-4618-adab-c4922e916e26",
                                "sense_id": "c3025f18-5905-32c8-be3c-5b75a76706ce",
                                "text": "„In einem Vermisstenfall in Lancashire im Nordwestengland sorgt die Strategie der Polizei, eine Alkoholkrankheit der Vermissten öffentlich zu machen, für Kritik.“"
                            },
                            {
                                "example_id": "1c69a4d3-51e5-4f01-9810-5000d5fb0ac4",
                                "sense_id": "c3025f18-5905-32c8-be3c-5b75a76706ce",
                                "text": "„Bei einer Razzia in Nordwestengland haben Terrorfahnder am Mittwoch zehn Verdächtige verhaftet.“"
                            },
                            {
                                "example_id": "9dba3666-bbf8-4407-9a82-98116ac6b7c6",
                                "sense_id": "c3025f18-5905-32c8-be3c-5b75a76706ce",
                                "text": "„Nachdem wochenlang nach einer vermissten Mutter in Nordwestengland gesucht worden war, hat die Polizei nun deren Tod bestätigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
