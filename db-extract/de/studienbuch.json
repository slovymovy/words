                        "entry_id": "41dd96a8-7beb-352b-b103-ede9df11421d",
                        "glosses": [
                            "Heft, mit dem Studierende ihre Immatrikulation an einer Hochschule, ihre Studienfächer und die erbrachten Studienleistungen nachweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8565b5a6-1c27-4a09-a12f-b5fb47510d6e",
                                "sense_id": "1f039723-2850-3ea1-b6d4-35ff1145f38b",
                                "text": "Früher musste während des gesamten Studiums ein Studienbuch geführt werden."
                            },
                            {
                                "example_id": "5160c24e-6adf-4a39-b3c0-288b7eaa775f",
                                "sense_id": "1f039723-2850-3ea1-b6d4-35ff1145f38b",
                                "text": "„Im Studienbuch sind alle für das Studium maßgeblichen Umstände zu vermerken.“"
                            },
                            {
                                "example_id": "450d8513-050e-4f0a-ac33-78b5f7bffa7d",
                                "sense_id": "1f039723-2850-3ea1-b6d4-35ff1145f38b",
                                "text": "„Laut Studienbuch war Chomsky an der Penn eingeschrieben, wo er auch seinen Abschluss machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
