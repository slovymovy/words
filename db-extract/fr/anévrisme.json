                                        "sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                                        "entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                                        "glosses": [
                                            "An abnormal blood-filled swelling of an artery or vein, resulting from a localized weakness in the wall of the vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a87df8-1946-4d3f-ac8d-f7e735b742b9",
                                                "sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                                                "text": "About 120,000 people were helping with the two-week annual harvest and “obviously you’re going to have some accidents”, he said. Every year, “one or two people” died from heart failure or aneurysms, he added."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f11bac0-2f5e-41e4-82ae-781adbb8c08e",
