                ],
                "senses": [
                    {
                        "sense_id": "ec0accc2-a12f-3e06-9ab5-284695863400",
                        "entry_id": "7af8c392-adea-36a2-a420-d1278bb4e3d7",
                        "glosses": [
                            "aufgrund von Alter ergraut/verblasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c1bc7f-b96f-47e1-9d95-1bed0c21d31b",
                                "sense_id": "ec0accc2-a12f-3e06-9ab5-284695863400",
                                "text": "„Die altersgrauen Schriftzeichen schienen in seinem ungebildeten, aber regen Geist schwache Erinnerungen zu wecken, obwohl es ausgeschlossen war, dass er dergleichen jemals zuvor gesehen hatte.“"
                            },
                            {
                                "example_id": "f497a247-b88f-45fb-ab3a-575742a178f8",
                                "sense_id": "ec0accc2-a12f-3e06-9ab5-284695863400",
                                "text": "„Sie ließ ihren Blick über die Brieffächer gleiten, dann über die schlanken kleinen Schubfächer. Schließlich blieb er wie gefesselt an dem großen, altersgrauen Buch mit der eisernen Schließe hängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
