                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "закуто́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b54b16aa-59f8-3452-899a-5e3f3b52b673",
                                        "entry_id": "c08ad99d-2a08-3b84-9a5f-d67dac847dda",
                                        "glosses": [
                                            "рег. уменьш. к закут; хлев для скота (обычно мелкого)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3be70e-5f50-4569-8e3b-bfd358d005c9",
