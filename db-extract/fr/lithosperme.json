                        "examples": [
                            {
                                "example_id": "511128e2-2fcf-4650-bdd4-179f7dbafad5",
                                "sense_id": "a8fad0c0-4769-3c16-878e-f91b806bbe85",
                                "text": "On distingue :\n1° le lithosperme officinal, dit grémil, perlière, herbe aux perles, blé d'amour, millet d'amour ; les semences portent le nom de graine perlée et graine d'amour ;\n2° le lithosperme tinctorial, qui a été l'anchuse tinctoriale de certains auteurs, et, pour d'autres, la buglosse tinctoriale ; sa racine est l'orcanette."
                            },
                            {
                                "example_id": "dee7e9e1-980e-4903-bf21-10b183d96abf",
                                "sense_id": "a8fad0c0-4769-3c16-878e-f91b806bbe85",
                                "text": "Une d’elles, le lithosperme des champs, peut compter des dizaines de mille pieds dans un hectare de blé."
                            }
                        ]
                    }
