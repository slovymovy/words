                    ],
                    "common_phrases": [
                        "écraser l'adversaire",
                        "écraser la concurrence"
                    ]
                },
                {
                    "sense_id": "f6a88b53-189f-3eb6-8bc5-68ed73426d03",
                    "sense_definition": "Accabler ou faire plier quelqu'un sous une charge morale, physique ou financière très lourde.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune travailleur se sentait totalement <w>écrasé</w> sous le poids de ses nouvelles responsabilités."
                        },
                        {
                            "text": "Cette décision brutale risque d'<w>écraser</w> sous les dettes de nombreux petits commerçants locaux."
