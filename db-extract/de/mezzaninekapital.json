                    {
                        "sense_id": "708f92e9-1306-35f9-8ce0-bff78e9c452b",
                        "entry_id": "86eb62b6-2b80-39ce-8792-cb41ec969681",
                        "glosses": [
                            "zwischen Eigenkapital und Fremdkapital stehende Finanzierungsform"
