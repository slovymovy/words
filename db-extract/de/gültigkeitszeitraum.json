                "senses": [
                    {
                        "sense_id": "16e3b7c1-032a-3d75-b1dc-4a095fbf96f5",
                        "entry_id": "d3773522-62c0-3187-9757-45694ee82f40",
                        "glosses": [
                            "Zeitspanne, während der etwas Gültigkeit besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99aaebf-205b-4308-9772-80fe0f6f165c",
                                "sense_id": "16e3b7c1-032a-3d75-b1dc-4a095fbf96f5",
                                "text": "„Teilnahmekarten berechtigen dazu, innerhalb des jeweiligen Gültigkeitszeitraumes entsprechend dem auf den Karten genannten Umfang an Kurseinheiten teilzunehmen.“"
                            },
                            {
                                "example_id": "89ba297e-c838-4164-9397-d7dd3b591781",
                                "sense_id": "16e3b7c1-032a-3d75-b1dc-4a095fbf96f5",
                                "text": "„Innerhalb des Gültigkeitszeitraumes nicht genutzte Kurseinheiten verfallen ersatzlos.“"
                            },
                            {
                                "example_id": "a53b520e-c3d0-4bc8-8509-df22990534ba",
                                "sense_id": "16e3b7c1-032a-3d75-b1dc-4a095fbf96f5",
                                "text": "„Die Girocard ersetzt ab Herbst 2008 sukzessive die bisher von Banken und Sparkassen ausgegebenen Debitkarten vor Ablauf des Gültigkeitszeitraums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
