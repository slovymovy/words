{
    "word_family": [
        "astonish",
        "astonishing",
        "astonishment"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9967b92d-9d18-342e-97d4-bbc498d42375",
                    "sense_definition": "Used as an intensifier to mean very or remarkably.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room was <w>astonishingly</w> clean for such a low price.",
                            "target_lang_translations": {
                                "es": "La habitación del hotel estaba <w>asombrosamente</w> limpia para un precio tan bajo."
                            }
                        },
                        {
                            "text": "He performed <w>astonishingly</w> well during his first piano recital.",
                            "target_lang_translations": {
                                "es": "Tocó <w>sorprendentemente</w> bien durante su primer recital de piano."
                            }
                        }
                    ],
                    "synonyms": [
                        "amazingly",
                        "staggeringly",
                        "remarkably",
                        "very"
                    ],
                    "common_phrases": [
                        "astonishingly good",
                        "astonishingly bad",
                        "astonishingly high"
                    ],
                    "target_lang_definitions": {
                        "es": "Utilizado como intensificador para indicar un grado muy alto, extraordinario o sorprendente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "asombrosamente",
                                "target_lang_sense_clarification": "de manera extraordinaria o notable"
                            },
                            {
                                "target_lang_word": "sorprendentemente",
                                "target_lang_sense_clarification": "de un modo que llama la atención por lo inesperado o alto"
                            },
                            {
                                "target_lang_word": "increíblemente",
                                "target_lang_sense_clarification": "extremadamente, difícil de creer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3fc3131-7a84-302f-bd62-8187485fd6fd",
                    "sense_definition": "In a manner that causes great surprise or wonder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician <w>astonishingly</w> pulled a rabbit out of his empty hat.",
                            "target_lang_translations": {
                                "es": "El mago, <w>asombrosamente</w>, sacó un conejo de su sombrero vacío."
                            }
                        },
                        {
                            "text": "She <w>astonishingly</w> managed to finish the marathon despite her recent injury.",
                            "target_lang_translations": {
                                "es": "<w>Para asombro de todos</w>, logró terminar el maratón a pesar de su reciente lesión."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "De un modo que causa gran sorpresa, admiración o pasmo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "asombrosamente",
                                "target_lang_sense_clarification": "con asombro o causando gran pasmo"
                            },
                            {
                                "target_lang_word": "para asombro de todos",
                                "target_lang_sense_clarification": "de forma que genera estupor general"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}