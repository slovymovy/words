                "senses": [
                    {
                        "sense_id": "a9228b64-4f2d-3ba1-925c-869043138bcb",
                        "entry_id": "3b62518a-e13a-35f0-b7c9-0cba7166578b",
                        "glosses": [
                            "Wort, das beispielhaft für bestimmte Merkmale steht und das an etwas erinnern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd4197c6-b97d-4dd1-89c6-e0fd8bc946b5",
                                "sense_id": "a9228b64-4f2d-3ba1-925c-869043138bcb",
                                "text": "„Sobald man die Ankerwörter perfekt gelernt hat, kann man sich beliebige andere Items merken, indem man durch Vorstellungsbilder jeweils ein Ankerwort mit einem Item verbindet.“"
                            },
                            {
                                "example_id": "b5341878-0a97-4668-ad1c-e14d814713db",
                                "sense_id": "a9228b64-4f2d-3ba1-925c-869043138bcb",
                                "text": "„Dagegen weist der Text für die Ankerwörter Leichtigkeit und Raserei keine typischen Wortverbindungen auf.“"
                            },
                            {
                                "example_id": "bc21625d-0737-4064-8ddd-429cf655e4f5",
                                "sense_id": "a9228b64-4f2d-3ba1-925c-869043138bcb",
                                "text": "„Die Ankerwörter sind oft ein Schlüssel zum Verstehen eines Idioms.“"
                            }
                        ],
