                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ac984ea7-a9bf-4c36-bbb1-96f65d1d19f2",
                        "entry_id": "943da9a9-8cef-3fcc-9bf4-304e66e7cd20",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more centrist"
                    },
                    {
                        "form_id": "668723f7-57ae-4604-bfc1-31993ec933f6",
                        "entry_id": "943da9a9-8cef-3fcc-9bf4-304e66e7cd20",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most centrist"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "929e01c9-4679-3e83-8549-60a190135d46",
                        "entry_id": "943da9a9-8cef-3fcc-9bf4-304e66e7cd20",
                        "glosses": [
                            "Of, pertaining to, or advocating centrism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a5e778e-52ad-47d5-8f10-af407366b120",
                                "sense_id": "929e01c9-4679-3e83-8549-60a190135d46",
                                "text": "Emmanuel Macron’s ruling centrist party was divided and soul-searching on Wednesday after a strict new immigration law was approved by parliament but contained so many hardline measures that the far-right Marine Le Pen claimed it as an “ideological victory” for her own anti-immigration platform."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e4d4f0d-9bbe-4162-bcb4-f0ae46b1550b",
                        "source_entry_id": "943da9a9-8cef-3fcc-9bf4-304e66e7cd20",
                        "source_sense_id": "929e01c9-4679-3e83-8549-60a190135d46",
                        "source_sense_description": "of, pertaining to, or advocating centrism",
                        "target_lang_word": "centriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35e364bb-116e-3e41-9d5f-a353dc2fce2f",
                                        "entry_id": "00998a12-466a-3ea6-bd9f-91d6b17e54ed",
                                        "glosses": [
                                            "Relatif au centrisme ou qui en relève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00317c99-e7c8-47ff-92b4-feec97b2668b",
                                                "sense_id": "35e364bb-116e-3e41-9d5f-a353dc2fce2f",
                                                "text": "Cela dit, à l'intérieur de l’alliance centriste, chacun essaie de conquérir la position la plus forte, ce qui le conduit à s’appuyer dans une certaine mesure sur le parti extrême correspondant à sa tendance."
                                            },
                                            {
                                                "example_id": "513ac4c9-cca5-4ee9-b0a4-4a9f15cef36c",
                                                "sense_id": "35e364bb-116e-3e41-9d5f-a353dc2fce2f",
                                                "text": "Parti d’inspiration chrétienne, européen et centriste, il ne peut pas résister à l’attraction sur ses troupes d’un de Gaulle qui apparaît aussi chrétien, européen et centriste que lui avec la crédibilité en plus."
                                            },
                                            {
                                                "example_id": "54bb2e30-37e8-4b57-a079-136c2d4ee9ff",
                                                "sense_id": "35e364bb-116e-3e41-9d5f-a353dc2fce2f",
                                                "text": "Ce résultat fut atteint par un autre homme politique, centriste de tempérament, mais non issu de la tradition du catholicisme politique."
                                            },
                                            {
                                                "example_id": "49779c48-16d2-468c-a89b-d36a8670a4b7",
                                                "sense_id": "35e364bb-116e-3e41-9d5f-a353dc2fce2f",
                                                "text": "Les politologues parlent de Fenêtre d’Overton : cette formule décrit le type d’agenda centriste qu’un homme politique peut adopter sans risque d’être qualifié de réactionnaire ou d’extrémiste, et la manière dont il peut déplacer de quelques degrés vers la gauche ou la droite cette fenêtre d’acceptabilité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "centriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c462250-aacd-3ada-b7b5-992f55fc3c92",
                                        "entry_id": "036508e4-43e5-30a2-b84d-8a709dc3ae87",
                                        "glosses": [
                                            "Personne qui se situe au centre sur l'échiquier politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f7411d-9ed2-45c7-8bde-806ad8645092",
                                                "sense_id": "9c462250-aacd-3ada-b7b5-992f55fc3c92",
                                                "text": "Mais, un centriste qui depuis trente ans vote avec la droite, ce qui est très courant, je me dis que c’est certainement un homme de droite."
                                            },
                                            {
                                                "example_id": "21cc7786-142e-4b44-a572-8a96b928ab85",
                                                "sense_id": "9c462250-aacd-3ada-b7b5-992f55fc3c92",
                                                "text": "Si le RPR espérait consolider ses positions lors des élections sénatoriales de 1998, il ne pouvait gagner le « plateau » qu'avec l’appui des centristes. Or Jacques Chirac avait tout intérêt à jouer l’union des forces de droite plutôt que la division […]."
                                            },
                                            {
                                                "example_id": "a160846f-a859-4e56-9fa4-b59e1c46e694",
                                                "sense_id": "9c462250-aacd-3ada-b7b5-992f55fc3c92",
                                                "text": "Fils spirituel de Dominique de Villepin dont il fut pendant dix ans l'un des plus proches conseillers, il s'est forgé durant son passage au gouvernement une image de modéré et de centriste bon teint, proche d'Alain Juppé et de Nathalie Kociusco-Morizet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "203ba28f-1002-4ec3-b536-bcbfc1ea7640",
                        "source_entry_id": "943da9a9-8cef-3fcc-9bf4-304e66e7cd20",
                        "source_sense_id": "929e01c9-4679-3e83-8549-60a190135d46",
                        "source_sense_description": "of, pertaining to, or advocating centrism",
                        "target_lang_word": "gemäßigt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemäßigt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61933914-f41c-32ad-8ca5-164353b47f4e",
                                        "entry_id": "94114d71-ea89-32a0-8da7-716085eb26ab",
                                        "glosses": [
                                            "im richtigen, nicht übertriebenen Maße"
                                        ],
                                        "tags": [
                                            "Denken",
                                            "Verhalten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192a48c9-ea2a-4f3a-9046-23259de6c0a5",
                                                "sense_id": "61933914-f41c-32ad-8ca5-164353b47f4e",
                                                "text": "Denn Meuthen, 54-jähriger Professor an der Verwaltungshochschule in Kehl, pflegt eine gemäßigte Rhetorik."
                                            },
                                            {
                                                "example_id": "9a589adf-052b-4dd1-834e-3fb6933e58b2",
                                                "sense_id": "61933914-f41c-32ad-8ca5-164353b47f4e",
                                                "text": "Warum also soll Donald Trump nun respektvoll und gemäßigt auftreten, wenn seine Partei sich schon seit Jahren in Respektlosigkeit und Blockade gefällt?"
                                            },
                                            {
                                                "example_id": "14b9e285-99dc-4a86-8f37-b62699cea50a",
                                                "sense_id": "61933914-f41c-32ad-8ca5-164353b47f4e",
                                                "text": "Als während der helvetischen Einheitsregierung wieder gemäßigte Ansichten Geltung gewannen, ward G. 1800 Präsident des Cantonsgerichtes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bf140ab-03bb-3768-90a1-6949c699aa01",
                                        "entry_id": "94114d71-ea89-32a0-8da7-716085eb26ab",
                                        "glosses": [
                                            "vernünftige Grenzen einhaltend, einen Ausgleich zulassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a27253db-dea4-47c0-a581-a1f48f1f8339",
                                                "sense_id": "8bf140ab-03bb-3768-90a1-6949c699aa01",
                                                "text": "Genauer gesagt wird uns erzählt, dass es einen „gemäßigten“ Islam gäbe und einen „extremistischen“ Islam – der erstere gut und wahr, der von einer Mehrheit der Muslime praktiziert würde, der letztere ein perverser Frevel, der durch eine Minderheit missbräuchlich instrumentalisiert werde."
                                            },
                                            {
                                                "example_id": "947f2650-840a-4491-9de9-bb2263981ccf",
                                                "sense_id": "8bf140ab-03bb-3768-90a1-6949c699aa01",
                                                "text": "In Marokko hat die gemäßigt islamistische Regierungspartei PJD die Parlamentswahl gewonnen."
                                            },
                                            {
                                                "example_id": "cb796ff2-ecf9-4a7c-a6ed-ea534e90a052",
                                                "sense_id": "8bf140ab-03bb-3768-90a1-6949c699aa01",
                                                "text": "Nach Jahrzehnten linker Vorherrschaft erobern gemäßigte Gruppen die Studentenvertretungen, häufig mit überwältigender Mehrheit."
                                            },
                                            {
                                                "example_id": "871d83d6-386e-48e2-b8ea-075ed96b96dd",
                                                "sense_id": "8bf140ab-03bb-3768-90a1-6949c699aa01",
                                                "text": "Der türkische Ministerpräsident galt als gemäßigt und guter Partner der EU."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "838b3454-426b-3269-afc4-343641f71588",
                                        "entry_id": "94114d71-ea89-32a0-8da7-716085eb26ab",
                                        "glosses": [
                                            "einer Zone mit ausgeglichenem Klima angehörend"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae84af5-cd9d-4105-83b3-c2856b897005",
                                                "sense_id": "838b3454-426b-3269-afc4-343641f71588",
                                                "text": "Die Vegetation in der gemäßigten Zone besteht hauptsächlich aus Nadelwäldern, Misch- und Laubwäldern."
                                            },
                                            {
                                                "example_id": "6d0651d1-64e2-47b1-a3ad-5665ca6b27e1",
                                                "sense_id": "838b3454-426b-3269-afc4-343641f71588",
                                                "text": "Über ein Drittel der Weltbevölkerung lebt in der gemäßigten Zone, in der auch Österreich liegt."
                                            },
                                            {
                                                "example_id": "aee7ac5f-3e57-4806-99ed-09be17c13d41",
                                                "sense_id": "838b3454-426b-3269-afc4-343641f71588",
                                                "text": "Die gemäßigte Zone ist durch ihr relativ ausgeglichenes Klima und den Ablauf der vier Jahreszeiten gekennzeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gemäßigt",
                                "target_lang_code": "de",
                                "target_senses": [
