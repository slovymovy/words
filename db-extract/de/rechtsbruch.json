                ],
                "senses": [
                    {
                        "sense_id": "7913387b-89d6-3cba-a19a-a74ca7396c81",
                        "entry_id": "fc585b75-d8d3-38d9-9fbd-5cff7a01ab03",
                        "glosses": [
                            "Verstoß gegen das Recht, Brechen eines Gesetzes"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "202e9661-2c45-4b95-9eec-1a14a3bfd0dd",
                                "sense_id": "7913387b-89d6-3cba-a19a-a74ca7396c81",
                                "text": "Mit diesem Bescheid hat die Behörde in meinen Augen einen klaren Rechtsbruch begangen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd313373-057a-3103-8f1e-d18ff40f11bf",
                        "entry_id": "fc585b75-d8d3-38d9-9fbd-5cff7a01ab03",
                        "glosses": [
                            "Bezeichnung einer Fallgruppe unlauteren Wettbewerbshandelns im Rahmen des Gesetzes gegen den unlauteren Wettbewerb (UWG) §4"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "42888ced-f3fd-4cb0-bd1e-e83244a66591",
                                "sense_id": "dd313373-057a-3103-8f1e-d18ff40f11bf",
                                "text": "Der Rechtsbruch wie er in §4, Absatz 11 UWG beschrieben ist: „Unlauter handelt insbesondere, wer einer gesetzlichen Vorschrift zuwiderhandelt, die auch dazu bestimmt ist, im Interesse der Marktteilnehmer das Marktverhalten zu regeln.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea29bc43-df4e-439a-9da0-2a1bf60bb8fc",
                        "source_entry_id": "fc585b75-d8d3-38d9-9fbd-5cff7a01ab03",
                        "source_sense_id": "7913387b-89d6-3cba-a19a-a74ca7396c81",
                        "source_sense_description": "Rechtswesen: Verstoß gegen das Recht, Brechen eines Gesetzes",
                        "target_lang_word": "breach of law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a9a3a63a-179e-4ab5-a339-b32b6ccd7c46",
                        "source_entry_id": "fc585b75-d8d3-38d9-9fbd-5cff7a01ab03",
                        "source_sense_id": "7913387b-89d6-3cba-a19a-a74ca7396c81",
                        "source_sense_description": "Rechtswesen: Verstoß gegen das Recht, Brechen eines Gesetzes",
                        "target_lang_word": "violation du droit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ab63a5b-036b-4516-88f2-9a1046802663",
                        "source_entry_id": "fc585b75-d8d3-38d9-9fbd-5cff7a01ab03",
                        "source_sense_id": "7913387b-89d6-3cba-a19a-a74ca7396c81",
                        "source_sense_description": "Rechtswesen: Verstoß gegen das Recht, Brechen eines Gesetzes",
                        "target_lang_word": "crime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a27c237b-0546-3ccb-9e35-8f4233704961",
                                        "entry_id": "71b54793-d3ad-39e0-9e49-dc0243531c40",
                                        "glosses": [
                                            "Infraction très grave, à la morale ou à la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f445e64-4fd3-4bb3-9043-c6ea81a2c2c5",
                                                "sense_id": "a27c237b-0546-3ccb-9e35-8f4233704961",
                                                "text": "L’abbaye, dit-on, doit son origine à une comtesse Cuniga, une sorte de Barbe-Bleue en jupons, qui avait empoisonné ses sept maris et terrifiait toute la contrée par ses crimes."
                                            },
                                            {
                                                "example_id": "20285d52-7d01-464b-9c2c-dd659667d4e2",
                                                "sense_id": "a27c237b-0546-3ccb-9e35-8f4233704961",
                                                "text": "Tout s'est modernisé, et il y a de tout, sauf des gendarmes et des prisons, car le crime est encore inconnu."
                                            },
                                            {
                                                "example_id": "1c2c0540-c3fc-4508-9da0-20731538b13f",
                                                "sense_id": "a27c237b-0546-3ccb-9e35-8f4233704961",
                                                "text": "Hitler, Staline, Mussolini, tout le monde connaît leurs crimes et leurs capacités de nuisance sur leurs congénères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445fa473-6609-351e-a071-8752d52766a9",
                                        "entry_id": "71b54793-d3ad-39e0-9e49-dc0243531c40",
                                        "glosses": [
                                            "Infraction que la loi punit d’une peine infamante ou afflictive et infamante, par opposition au délit et à la contravention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359ae1d5-d8bb-4c87-af4b-8bec15ea1b1b",
                                                "sense_id": "445fa473-6609-351e-a071-8752d52766a9",
                                                "text": "Individuellement ou en \"petty sessions\", les Magistrats procèdent à la recherche, dans leur voisinage, des contraventions, délits et crimes de toute espèce."
                                            },
                                            {
                                                "example_id": "4ac50284-1219-4567-9c51-572060c17243",
                                                "sense_id": "445fa473-6609-351e-a071-8752d52766a9",
                                                "text": "Mon père, je suis pour ainsi dire condamnée à mourir pour un crime que mon âme ne connaît pas, c’est-à-dire pour le crime de sorcellerie."
                                            },
                                            {
                                                "example_id": "5453224d-5557-4adf-b65f-c8f5e7ba3830",
                                                "sense_id": "445fa473-6609-351e-a071-8752d52766a9",
                                                "text": "La loi du 22 prairial se contente de définitions assez vagues du crime politique, de manière à ne laisser échapper aucun ennemi de la Révolution ; […]."
                                            },
                                            {
                                                "example_id": "7db3fdb7-b531-4744-919c-bc00684045dd",
                                                "sense_id": "445fa473-6609-351e-a071-8752d52766a9",
                                                "text": "Quant à moi, […], je souhaiterais que des châtiments vraiment effrayants frappassent ceux qui, médecins ou matrones, pour de l'argent, se font les instruments de tels crimes."
                                            },
                                            {
                                                "example_id": "16d9fd1f-25d1-445a-ae29-e0a40854e785",
                                                "sense_id": "445fa473-6609-351e-a071-8752d52766a9",
                                                "text": "Cette union, que cimente jusqu'à la mort un crime entre complices […] Jim tout à coup s'apercevait qu'elle existait, qu'elle formait l'élément primordial de sa vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764a4eb4-5077-3262-9cd8-dbb5b5e0b600",
                                        "entry_id": "71b54793-d3ad-39e0-9e49-dc0243531c40",
                                        "glosses": [
                                            "Homicide volontaire, meurtre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3c3db9-cc03-4171-81a9-dda5eab3d1fb",
                                                "sense_id": "764a4eb4-5077-3262-9cd8-dbb5b5e0b600",
                                                "text": "Un double crime."
                                            },
                                            {
                                                "example_id": "3ec03201-18cd-46c5-b900-1fa687e12f0e",
                                                "sense_id": "764a4eb4-5077-3262-9cd8-dbb5b5e0b600",
                                                "text": "L'auteur du crime a été identifié."
                                            },
                                            {
                                                "example_id": "c0a90974-a96e-48f5-81f1-c95f494eba69",
                                                "sense_id": "764a4eb4-5077-3262-9cd8-dbb5b5e0b600",
                                                "text": "L'arme du crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                        "entry_id": "71b54793-d3ad-39e0-9e49-dc0243531c40",
                                        "glosses": [
                                            "Action blâmable ou condamnable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a74c012-d3b4-4119-99be-d4a15af16228",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "Mon fils, à eux deux, ils ont fait la somme, et je suis allé payer pour toi le Bédouin qui a commis un crime de lèse-génie en te coffrant."
                                            },
                                            {
                                                "example_id": "d5e9aaed-5980-4297-aefa-2fcae2f8bdb6",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "C’est un crime d’avoir laissé perdre ces manuscrits, d’avoir abattu de si beaux arbres."
                                            },
                                            {
                                                "example_id": "b4976de8-05a8-436d-8d12-743c7c11ec73",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "Imputer à crime."
                                            },
                                            {
                                                "example_id": "52be23f1-9f02-4fd1-bd79-0dd02bc96924",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "Ce n’est pas un grand crime, se dit pour excuser ou diminuer quelque faute."
                                            },
                                            {
                                                "example_id": "ed3d7bb1-152b-4e73-93bb-dc03f2067818",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "On dit dans le même sens"
                                            },
                                            {
                                                "example_id": "86889958-824b-4c9a-a7b3-a5517bc3f3a5",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "Est-ce un si grand crime ?"
                                            },
                                            {
                                                "example_id": "9a2c4fb2-cdc7-4362-ad39-213021f341ae",
                                                "sense_id": "531100a9-524e-317f-b963-a663b9b309b5",
                                                "text": "Est-ce donc un crime ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62e7b1f-dc1b-3727-8d51-e664e401e07c",
                                        "entry_id": "71b54793-d3ad-39e0-9e49-dc0243531c40",
                                        "glosses": [
                                            "Faute légère."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b41976-b0f7-4173-b20a-567c90cac44d",
                                                "sense_id": "a62e7b1f-dc1b-3727-8d51-e664e401e07c",
                                                "text": "Tout son crime, son seul crime est de... : c'est là sa seule faute, son seul tort."
                                            },
                                            {
                                                "example_id": "13387431-afe1-47b1-abdd-0c3b0bdf4ad2",
                                                "sense_id": "a62e7b1f-dc1b-3727-8d51-e664e401e07c",
                                                "text": "Voilà tout son crime, tout mon crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6cd317f-47f9-306d-abdf-b65e7447e27c",
                                        "entry_id": "71b54793-d3ad-39e0-9e49-dc0243531c40",
                                        "glosses": [
                                            "L'ensemble des personnes criminelles, des actes criminels."
                                        ],
                                        "tags": [
                                            "formal",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369480a5-681f-4d07-a98f-777cb14b6f7f",
                                                "sense_id": "b6cd317f-47f9-306d-abdf-b65e7447e27c",
                                                "text": "Châtier le crime. - Désarmer le crime. - Le crime allait tête levée."
                                            }
                                        ]
                                    }
                                ]
                            },
