                                        "sense_id": "c6de01ab-9cda-335a-9a08-72f0ab2d1aec",
                                        "entry_id": "a914658f-488f-32ea-86c7-f5ce1e7dbc72",
                                        "glosses": [
                                            "geleerde uit de Griekse oudheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a858a3-f02e-44ce-8ff7-d707fb78f34e",
                                                "sense_id": "c6de01ab-9cda-335a-9a08-72f0ab2d1aec",
                                                "text": "Vrouwen werden geassocieerd met de aarde, het lichaam en het materiële. Mannen met de hemel, het bovenaardse en het etherische, waaronder Pythagoras en zijn volgelingen al snel ook getallen, wiskunde en abstract denken schaarden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3401a168-c339-47ce-b4d1-9746943012b2",
                        "source_entry_id": "40c9de98-383d-319a-9221-9b4bbe087f0b",
                        "source_sense_description": "Ancient Greek mathematician and philosopher",
                        "target_lang_word": "Pythagore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pythagore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b176af7-5328-393c-b064-66d003a89d66",
                                        "entry_id": "8b41aa1c-674e-347f-a792-89a7157719d7",
                                        "glosses": [
                                            "Nom d'un mathématicien, philosophe présocratique et astronome de la Grèce antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f587291-0cef-47bc-90c8-8ae9042bcca7",
                                                "sense_id": "5b176af7-5328-393c-b064-66d003a89d66",
                                                "text": "Déségyptianiser Pythagore, en l’indianisant un peu, permet en plus d’accroître son rayonnement et d’en faire un Sage aux dimensions du monde, comme Apollonios son successeur (au moins tel qu’il est rêvé par Philostrate, engagé lui aussi dans une défense et illustration de l’identité culturelle grecque)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e062f3e4-63cb-4342-9fac-c7158ffc4a48",
                        "source_entry_id": "40c9de98-383d-319a-9221-9b4bbe087f0b",
                        "source_sense_description": "Ancient Greek mathematician and philosopher",
