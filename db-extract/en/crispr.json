                ],
                "senses": [
                    {
                        "sense_id": "52024b2d-077e-328a-b1cb-61c72a84a047",
                        "entry_id": "2a62ba0f-f3e3-300b-b56e-7f0d281fcc5f",
                        "glosses": [
                            "Segments of bacteria and archaea DNA containing short repetitions of base sequences."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d10e64d7-b749-4144-a77c-105aa28fc5af",
                                "sense_id": "52024b2d-077e-328a-b1cb-61c72a84a047",
                                "text": "Crispr is a guide molecule made of RNA, that allows a specific site of interest on the DNA double helix to be targeted."
                            }
                        ]
                    },
                    {
                        "sense_id": "31a8ddc5-d4cb-3175-a8a7-648d49c5775c",
                        "entry_id": "2a62ba0f-f3e3-300b-b56e-7f0d281fcc5f",
                        "glosses": [
                            "The CRISPR/Cas9 system, which functions to provide immunity to bacteria and archaea by finding a section of DNA and replacing it with an alternative."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "507e94b4-061f-45a2-ab47-948ae799b56c",
                                "sense_id": "31a8ddc5-d4cb-3175-a8a7-648d49c5775c",
                                "text": "For the first time, doctors in the U.S. have used the powerful gene-editing technique CRISPR to try to treat a patient with a genetic disorder."
                            }
                        ]
                    },
                    {
                        "sense_id": "50ebdd26-05ad-34ed-8dab-b694155fc5c5",
                        "entry_id": "2a62ba0f-f3e3-300b-b56e-7f0d281fcc5f",
                        "glosses": [
                            "Any technique or process or system for editing genomes by laboratory use of the CRISPR/Cas9 system."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
