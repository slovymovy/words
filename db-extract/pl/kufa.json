                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd6f0d4-f1b9-4008-8d0f-e01b3a4456d7",
                                "sense_id": "cc96515b-7641-353b-bc40-7940fee02811",
                                "text": "Podobne do spanieli wyżły fryzyjskie mają kufę zwężającą się w stronę nosa."
