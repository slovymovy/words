                    {
                        "translation_id": "f9a3956d-a696-4876-8fc5-bc88f76317cf",
                        "source_entry_id": "3b5d73c4-ff8b-393a-a703-8e31881efb09",
                        "source_sense_id": "33be7942-f8be-3f5d-b9f7-242b236ada88",
                        "source_sense_description": "Botanik: Blütenpflanze (Hibiscus) aus der Familie der Malvengewächse (Malvaceae)",
                        "target_lang_word": "hibiscus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
