                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used as industry jargon in hospitality"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（酒店、餐饮等行业用语）人，位（计算用餐或参会人数的单位）"
                    },
                    "translations": {
