                "senses": [
                    {
                        "sense_id": "513b8169-51ec-3474-a7cf-8e42901423a7",
                        "entry_id": "d8f0e145-dc30-39c4-8f63-3ab0bd0a0305",
                        "glosses": [
                            "Roller, der von einem Elektromotor angetrieben wird"
                        ],
                        "tags": [
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "f67c55a1-3f2f-42b9-bbfb-e3eb53b2cd09",
                                "sense_id": "513b8169-51ec-3474-a7cf-8e42901423a7",
                                "text": "„Laut einer Studie verdienen Verleihfirmen mit Elektrorollern erst nach vier Monaten Geld.“"
                            },
                            {
                                "example_id": "b8d9ecc4-5af9-4ec6-8125-4f25ce042ea3",
                                "sense_id": "513b8169-51ec-3474-a7cf-8e42901423a7",
                                "text": "„Elektroroller sind das ideale Verkehrsmittel für Städte wie Paris: Sie brauchen wenig Platz, sind umweltfreundlich, schnell und flexibel nutzbar.“"
                            },
                            {
                                "example_id": "85e5a844-9c40-4495-9b07-972b7208d610",
                                "sense_id": "513b8169-51ec-3474-a7cf-8e42901423a7",
                                "text": "„Aus der Ferne könnte man den mitten in Frankfurt abgestellten Elektroroller für ein Modell mit Klappfunktion halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
