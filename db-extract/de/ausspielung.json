                "senses": [
                    {
                        "sense_id": "7290f90c-6766-3bf7-a8eb-7cdc1e4a813f",
                        "entry_id": "b8b99587-9c02-3384-b941-fd8cb62160fa",
                        "glosses": [
                            "Ausschüttung von Gewinnen bei einem Glücksspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc53e66b-a522-4118-aaaf-2f73a7a1045f",
                                "sense_id": "7290f90c-6766-3bf7-a8eb-7cdc1e4a813f",
                                "text": "„Ein leidenschaftlicher Lotto-Spieler vergleicht am Samstagabend während der Ausspielung laufend die bereits gezogenen Zahlen mit seinen Tippreihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                        "entry_id": "b8b99587-9c02-3384-b941-fd8cb62160fa",
                        "glosses": [
                            "Übermittlung von Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f85a60-f6e4-4dda-b9d1-a502ce37fbb7",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Aktuell erfolgt damit eine Ausspielung der Inhalte über analoge Verbindungen nur noch im Kabelnetz.“"
                            },
                            {
                                "example_id": "6c7b9e6f-ef28-4a23-b6fd-2c53ac259555",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Häufig übernehmen sog. Ingest-Server die Einspielung des Rohmaterials und Playout-Server die Ausspielung der sendefertigen Beiträge.“"
                            },
                            {
                                "example_id": "d4637733-8576-4cf2-8825-a57f8a277c3e",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Ein Laufbalken zeigt grafisch an, an welcher Stelle eines Titels oder Beitrags sich die Ausspielung gerade befindet – praktisch für den schnellen Überblick: wie viel Zeit bleibt dem Moderator z. B. noch bis zur nächsten Moderation.“"
                            },
                            {
                                "example_id": "66c5262e-0fca-4b7c-b7d4-de5d726f6e17",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Diese Methode der Ausspielung von Werbung ist unter dem Stichwort Behavioural Targeting bekannt.“"
                            },
                            {
                                "example_id": "472ad15f-b15e-419c-874c-e72ff6400ce5",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Real Time Advertising beinhaltet als Überbegriff sowohl den Kreationsprozess (die individuelle Ausspielung von Bannern pro einzelne Ad Impression) als auch den Bietprozess (das Real Time Bidding im engeren Sinn: individuelle Gebote pro Ad Impression).“"
                            },
                            {
                                "example_id": "fb839055-473b-471c-add1-779f85f5cdd6",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Neben unzähligen frei verfügbaren kostenlosen Tools zur Ausspielung von Werbung auf Webseiten, werden in Deutschland auch professionelle Systeme angeboten, die bei Vermarktern und Agenturen ihren Einsatz finden.“"
                            },
                            {
                                "example_id": "d210ee82-7a1b-48a5-9a2e-b81f008038ae",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Die exakte Berechnung der Online-Werbung und die Ausspielung der Werbung in Echtzeit, das sogenannte Realtime-Bidding, werden den Markt bald auch in Europa verändern.“"
                            },
                            {
                                "example_id": "bd2bee4d-ac50-4c51-bb7c-f470fd9dcb26",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Der Suchmaschinen-Konzern verwendet für die optimale Ausspielung von Werbung komplexe Modelle – so wird beispielsweise in Auktionen festgelegt, welcher Werbeauftraggeber zu welchem Preis und wann eine Anzeige bei einer Google-Suche zeigen darf.“"
                            },
                            {
                                "example_id": "e30e2353-81e0-40bc-b6e5-49f6a578dd98",
                                "sense_id": "941aeeda-3373-39f5-a6f2-0f1cc77de069",
                                "text": "„Im Kern beschreibt er jedoch einen fortgeschrittenen Automatisierungsgrad bei der Buchung, Platzierung und Ausspielung von Werbung sowie auch bei der Preisbildung auf den Märkten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
