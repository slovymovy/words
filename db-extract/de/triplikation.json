                    {
                        "sense_id": "d095f604-54bb-3c43-902b-e051a8e1fd19",
                        "entry_id": "c30a5407-979a-3bdc-b0e1-e6938b14338e",
                        "glosses": [
                            "Wortbildung (Vorgang und Ergebnis) durch dreifache Wiederholung eines Wortes oder Wortteils mit oder ohne Abwandlung der Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ea9b5a-9a35-429b-b044-5978fc43d7e4",
                                "sense_id": "d095f604-54bb-3c43-902b-e051a8e1fd19",
                                "text": "„Pipapo“ und „rirarutsch“ sind bekannte Beispiele für Triplikation im Deutschen."
                            },
                            {
                                "example_id": "cadd955f-d68f-488e-8652-190199ad345b",
                                "sense_id": "d095f604-54bb-3c43-902b-e051a8e1fd19",
                                "text": "„Anzahl der Iterationen: Reduplikation, Triplikation, Quadruplikation.“"
                            },
                            {
                                "example_id": "772f06af-22b5-472e-9b5b-6dfb467d22bd",
                                "sense_id": "d095f604-54bb-3c43-902b-e051a8e1fd19",
                                "text": "„Ein zweiter Grundtyp sind die Reimdoppelungen […], ein dritter die Ablautbildungen […], die gelegentlich sogar als Triplikationen vorkommen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40cee1d7-02fc-324b-ba83-e66aa578558a",
                        "entry_id": "c30a5407-979a-3bdc-b0e1-e6938b14338e",
                        "glosses": [
                            "„dreifache Wiederholung eines Wortes oder Satzes“"
                        ],
