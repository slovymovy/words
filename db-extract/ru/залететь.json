                "senses": [
                    {
                        "sense_id": "0cc77d00-ecc4-3566-bb34-242854e540e9",
                        "entry_id": "80cdfb58-56d9-3a56-8f7e-d83a22efb242",
                        "glosses": [
                            "to fly (in, into)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f49946d-0f26-4796-bcae-64816b1cd59c",
                                "sense_id": "0cc77d00-ecc4-3566-bb34-242854e540e9",
                                "text": "му́ха залете́ла в ко́мнату",
                                "translation": "a fly flew into the room",
                                "english": "a fly flew into the room"
                            }
                        ]
                    },
                    {
                        "sense_id": "5c258997-0607-3bf1-82d2-c768a35deaed",
                        "entry_id": "80cdfb58-56d9-3a56-8f7e-d83a22efb242",
                        "glosses": [
                            "to fly (as high as), to go up (as far as), to fly (as far as), to fly (behind, beyond)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "004180e4-c4cd-4af0-a6f4-7f8b6e4856eb",
                                "sense_id": "5c258997-0607-3bf1-82d2-c768a35deaed",
                                "text": "самолёт залете́л за Северный поля́рный круг",
                                "translation": "the aircraft crossed the Arctic circle",
                                "english": "the aircraft crossed the Arctic circle"
                            },
                            {
                                "example_id": "36380208-6d72-4cee-9710-5c8f3408cfa8",
                                "sense_id": "5c258997-0607-3bf1-82d2-c768a35deaed",
                                "text": "мяч залете́л за огра́ду",
                                "translation": "the ball flew over the fence",
                                "english": "the ball flew over the fence"
                            }
                        ]
                    },
                    {
                        "sense_id": "9043dad1-fa7c-3806-9213-53ff1d6a47d2",
                        "entry_id": "80cdfb58-56d9-3a56-8f7e-d83a22efb242",
                        "glosses": [
                            "to land (somewhere) on the way, to make a stopover (somewhere)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "296ad33c-046f-375d-acf2-ecb03593d938",
                        "entry_id": "80cdfb58-56d9-3a56-8f7e-d83a22efb242",
                        "glosses": [
                            "to get into a fix, to get into a mess, to get something one doesn't want (i.e. contract a sexually transmitted disease or become pregnant)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "da264aae-4bf3-420e-8f7c-9f0a348c4c42",
                                "sense_id": "296ad33c-046f-375d-acf2-ecb03593d938",
                                "text": "залете́ть на экза́мене",
                                "translation": "to fail an exam",
                                "english": "to fail an exam"
                            },
                            {
                                "example_id": "c75b0a5c-cb61-4998-a425-7d2207d04e52",
                                "sense_id": "296ad33c-046f-375d-acf2-ecb03593d938",
                                "text": "Они́ уже́ вы́брали десе́рт, ждут, пока́ принесу́т ко́фе, и тут О́ля реша́ется и говори́т:\n– Зна́ешь, ка́жется, я залете́ла.",
                                "translation": "They are already choosing their dessert and waiting for the coffee to arrive when Olya finally makes up her mind and says:\n“You know, I think I’m pregnant.”",
                                "english": "They are already choosing their dessert and waiting for the coffee to arrive when Olya finally makes up her mind and says:\n“You know, I think I’m pregnant.”"
                            }
                        ]
                    }
                ],
