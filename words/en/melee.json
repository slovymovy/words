{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95296ecc-de2e-31eb-91ca-43240dd7e7b4",
                    "sense_definition": "A confused hand-to-hand fight or struggle among several people at close range.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several soldiers were wounded during the fierce <w>melee</w> near the city gates.",
                            "target_lang_translations": {
                                "tr": "Şehir kapılarının yakınındaki şiddetli <w>arbede</w> sırasında birkaç asker yaralandı."
                            }
                        },
                        {
                            "text": "The guards stepped in to break up the <w>melee</w> before anyone suffered serious injuries.",
                            "target_lang_translations": {
                                "tr": "Muhafızlar, kimse ciddi şekilde yaralanmadan <w>kavgayı</w> yatıştırmak için araya girdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "brawl",
                        "scuffle",
                        "clash"
                    ],
                    "common_phrases": [
                        "break up the melee"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birden fazla kişi arasında yakın mesafede yaşanan kargaşalı el göğüse kavga veya mücadele."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "arbede",
                                "target_lang_sense_clarification": "yakın mesafeli kargaşalı kavga"
                            },
                            {
                                "target_lang_word": "beden bedene kavga",
                                "target_lang_sense_clarification": "göğüs göğüse dövüş"
                            },
                            {
                                "target_lang_word": "kargaşa",
                                "target_lang_sense_clarification": "kavga ortamındaki kaos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2b5ac1a-29b8-39e3-89b8-f9dcefcb84e3",
                    "sense_definition": "A confused, noisy, or chaotic crowd or situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She got lost in the <w>melee</w> of the crowded marketplace.",
                            "target_lang_translations": {
                                "tr": "Kalabalık pazar yerinin <w>kargaşasında</w> kayboldu."
                            }
                        },
                        {
                            "text": "It was impossible to hear anything in the <w>melee</w> of the train station during peak hours.",
                            "target_lang_translations": {
                                "tr": "Yoğun saatlerde tren istasyonunun <w>ana baba gününde</w> bir şey duymak imkansızdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "turmoil",
                        "chaos",
                        "commotion"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "in the melee"
                    ],
                    "target_lang_definitions": {
                        "tr": "Karışık, gürültülü veya kaotik bir kalabalık ya da durum."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kargaşa",
                                "target_lang_sense_clarification": "kaotik durum veya kalabalık"
                            },
                            {
                                "target_lang_word": "ana baba günü",
                                "target_lang_sense_clarification": "Aşırı kalabalık ve kargaşalı ortam"
                            },
                            {
                                "target_lang_word": "itiş kakış",
                                "target_lang_sense_clarification": "kalabalık içerisindeki düzensizlik"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "645b831e-7174-303f-83ae-97b06d995ee8",
                    "sense_definition": "Relating to or used in hand-to-hand combat at close range.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Knights traditionally trained with a <w>melee</w> weapon like a sword or an axe.",
                            "target_lang_translations": {
                                "tr": "Şövalyeler geleneksel olarak kılıç veya balta gibi bir <w>yakın dövüş</w> silahıyla eğitilirdi."
                            }
                        },
                        {
                            "text": "He relied on his <w>melee</w> combat skills when his arrows ran out.",
                            "target_lang_translations": {
                                "tr": "Okları bittiğinde <w>yakın dövüş</w> becerilerine güvendi."
                            }
                        }
                    ],
                    "antonyms": [
                        "ranged"
                    ],
                    "common_phrases": [
                        "melee weapon",
                        "melee combat"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yakın mesafeli göğüs göğüse muharebe ile ilgili veya bu tür mücadelede kullanılan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yakın dövüş",
                                "target_lang_sense_clarification": "yakın mesafe silahı veya dövüşü"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dce1718a-23e4-3c9e-9f25-d92552a3ede7",
                    "sense_definition": "To attack or strike an opponent in close-quarters combat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player chose to <w>melee</w> the enemy instead of wasting ammunition.",
                            "target_lang_translations": {
                                "tr": "Oyuncu, mühimmat harcamak yerine düşmana <w>yakın dövüşle saldırmayı</w> tercih etti."
                            }
                        },
                        {
                            "text": "He managed to <w>melee</w> his opponent right before running out of stamina.",
                            "target_lang_translations": {
                                "tr": "Dayanıklılığı bitmeden hemen önce rakibine <w>yakın dövüş hamlesi yapmayı</w> başardı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yakın mesafeli dövüşte rakibe saldırmak veya vurmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yakın dövüş yapmak",
                                "target_lang_sense_clarification": "yakın mesafeden saldırmak"
                            },
                            {
                                "target_lang_word": "göğüs göğüse çarpışmak",
                                "target_lang_sense_clarification": "yakın mesafede mücadele etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}