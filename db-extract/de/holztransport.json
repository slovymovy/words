                "senses": [
                    {
                        "sense_id": "f9041c3c-37c3-33ef-b0f0-ca647e990cf0",
                        "entry_id": "a92f14f2-0e56-31ab-a5ad-0a34281bb5cc",
                        "glosses": [
                            "der Transport von Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc98113-8060-4cf1-a4de-69b435d37948",
                                "sense_id": "f9041c3c-37c3-33ef-b0f0-ca647e990cf0",
                                "text": "„Die Bahn sei für Holztransporte gegenüber der Straße nicht mehr konkurrenzfähig, sagte Christoph Kulterer, Vorsitzender der Österreichischen Sägeindustrie.“"
                            },
                            {
                                "example_id": "8805b94a-4d92-46fd-bc25-31d01fbb1bd5",
                                "sense_id": "f9041c3c-37c3-33ef-b0f0-ca647e990cf0",
                                "text": "„Das Forstamt Lüneburg will in einigen seiner Waldgebiete künftig auch Pferde zum Holztransport einsetzen.“"
                            },
                            {
                                "example_id": "e38a9cec-df72-4fb8-aad0-6f60e05d0543",
                                "sense_id": "f9041c3c-37c3-33ef-b0f0-ca647e990cf0",
                                "text": "„Durch die ständigen Holztransporte verbreiterte sich der provisorisch gebahnte Weg durch die Wälder fast von allein und wurde bald »Straße des Wilden Westens« getauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
