                    }
                ],
                "senses": [
                    {
                        "sense_id": "baacec09-d568-34d7-abda-ed476bbd9eb5",
                        "entry_id": "64b0196b-87cc-33b6-a2f3-ad7ac087f4ba",
                        "glosses": [
                            "Kerze aus Wachs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba0a3136-f660-4279-a752-ad0cd917e244",
                                "sense_id": "baacec09-d568-34d7-abda-ed476bbd9eb5",
                                "text": "„Schon eine handelsübliche Wachskerze riecht nach Geburtstag oder Weihnachten.“"
                            },
                            {
                                "example_id": "62f6b121-f756-4d64-9d91-fcc13ad7d32a",
                                "sense_id": "baacec09-d568-34d7-abda-ed476bbd9eb5",
                                "text": "„Hier war alles beherrscht vom würzigen Rauch der Wachskerzen, vom Ledergeruch, der dem Riemzeug und den Stiefeln der Soldaten entströmte und vom Naphtalinduft der Kaftane oder der so selten ans Tageslicht geförderten Contouche.“"
                            },
                            {
                                "example_id": "32f35d5b-85bd-4df1-861a-d243807f741c",
                                "sense_id": "baacec09-d568-34d7-abda-ed476bbd9eb5",
                                "text": "„Auch Wachskerzen oder Talglichter gibt es längst nicht mehr.“"
                            },
                            {
                                "example_id": "f968bf55-2386-4d59-9c26-128748c187df",
                                "sense_id": "baacec09-d568-34d7-abda-ed476bbd9eb5",
                                "text": "„In die Rechte, die mit der Handfläche nach unten dalag, hatte man ihm zwischen Daumen und Zeigefinger eine Wachskerze gesteckt, die ein alter Diener festhielt, der sich von hinten her über den Lehnstuhl beugte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
