                "senses": [
                    {
                        "sense_id": "42ba6750-f64d-3bac-a490-157146ffb747",
                        "entry_id": "3719a176-d516-3c57-b4fe-8823e5094a50",
                        "glosses": [
                            "im Aussagesatz die Wortstellungen, die sich hinter der Satzklammer befinden"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d6b9c8-3bda-4c59-8e3b-3caf81fd06f2",
                                "sense_id": "42ba6750-f64d-3bac-a490-157146ffb747",
                                "text": "In dem Satz \"Hans ist gestern zu uns zu Besuch gekommen, weil er früher nicht konnte\" steht \"weil er früher nicht konnte\" im Nachfeld."
                            },
                            {
                                "example_id": "119a98a2-511c-48b2-851f-3572b3e66812",
                                "sense_id": "42ba6750-f64d-3bac-a490-157146ffb747",
                                "text": "„Von Drach [1973] eingeführter Terminus für das Stellungsfeld nach dem zweiten Element der Satzklammer, die bei Normalstellung im Deutschen in der Regel unbesetzt bleibt.“"
                            },
                            {
                                "example_id": "99045a17-6f54-47ff-a184-fd404e50a1ec",
                                "sense_id": "42ba6750-f64d-3bac-a490-157146ffb747",
                                "text": "Nach Lewandowski ist das „Nachfeld des Satzes“ im „deutschen Normal-Hauptsatz die Position nach der finiten Verbform (bzw. nach dem Prädikat).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
