                        ],
                        "form": "der Bodenfruchtbarkeit"
                    },
                    {
                        "form_id": "7bcaabde-d04f-4943-92ed-79ef766972eb",
                        "entry_id": "511c2064-5784-37f7-aa9a-bc865c8f2306",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Bodenfruchtbarkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                        "entry_id": "511c2064-5784-37f7-aa9a-bc865c8f2306",
                        "glosses": [
                            "Eigenschaft der obersten Schicht eines Stück Lands/eines Ackers, hohe Erträge zu liefern/viel Biomasse zu produzieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588b7674-6223-4993-9fa7-ab68ae729c02",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„[Landwirte können] den Humus mit Fruchtfolgen und Einarbeitung von Pflanzenresten erhalten und die natürliche Bodenfruchtbarkeit steigern.“"
                            },
                            {
                                "example_id": "dec3352e-48a5-4fa7-a022-0ae894ba909e",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Die Fruchtfolge soll die Bodenfruchtbarkeit erhalten bzw. verbessern.“"
                            },
                            {
                                "example_id": "bd96dec1-fda1-4c3f-98cc-8c74dbc6436f",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Die Erhaltung der Bodenfruchtbarkeit ist essenziell für Landwirtschaft und Gartenbau.“"
                            },
                            {
                                "example_id": "c5d21c62-3482-414a-b0ea-b8e12c5a725a",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„»Der Humusgehalt ist ein langfristiges Kriterium für die Bodenfruchtbarkeit«, hebt Reinhild Bennig hervor.“"
                            },
                            {
                                "example_id": "462bd479-1a2d-4ea2-a13a-eb61a11aadf9",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Humus ist für die Bodenfruchtbarkeit zentral und der Nebeneffekt ist, dass es auch fürs Klima Positives bewirken kann.“"
                            },
                            {
                                "example_id": "b387219c-df93-421a-80c3-648dca5c2756",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "[Regenwürmer:] „Für Öko-Bauern sind sie Grundlage von Bodenfruchtbarkeit.“"
                            },
                            {
                                "example_id": "5dca6c14-fa58-46d0-a020-3379c4087f1c",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„[Kompost] fördert das Bodenleben und damit die Bodenfruchtbarkeit, verbessert die Durchlüftung des Bodens und erhöht dessen Wasserhaltefähigkeit.“"
                            },
                            {
                                "example_id": "45b85177-25d7-4834-a1be-b25da04e322e",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Kot und Urin hätten einen schlechten Ruf, erzählt Villanueva, dabei mache der Kompostierungsprozess sie nicht nur hygienisch, sondern sie seien auch die bessere Düngerwahl für die Bodenfruchtbarkeit […].“"
                            },
                            {
                                "example_id": "ebe789e5-28e2-4106-840d-8c5219fbb291",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Kalkungen werden durchgeführt, um einer Bodenversauerung entgegenzuwirken (Alkalisierung) und um die Bodenfruchtbarkeit zu erhalten oder zu verbessern.“"
                            },
                            {
                                "example_id": "bd6cbb2e-841e-4b07-b2b6-d8efb3fd770e",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Gründüngung ist kein Ersatz für die anderen Maßnahmen für Förderung von Bodenfruchtbarkeit.“"
                            },
                            {
                                "example_id": "75a2487b-d7a1-42f9-87b2-ba7ce91fb052",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„[Cannabispflanzen] haben tiefe Wurzeln, die den Boden lockern und zur Bodenfruchtbarkeit beitragen.“"
                            },
                            {
                                "example_id": "4ad8152d-3e56-4976-acac-6a8c113457df",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„»Also, ich sage ja immer, die Hornmilben sind die guten unter den Milben, weil sie für die Bodenfruchtbarkeit zuständig sind.«“"
                            },
                            {
                                "example_id": "f4ea4005-aa00-4ac0-b408-c49130a113ce",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Dass die biodynamische Landwirtschaft die Bodenfruchtbarkeit und das Leben darin optimal fördert, hat eine Studie des Forschungsinstitut für biologischen Landbau (FiBL) nachgewiesen.“"
                            },
                            {
                                "example_id": "99c9b570-8055-49d0-abaa-37da7464bf63",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "„Gerade für die Landwirtschaft lassen sich über das Verhältnis von C und N aussagekräftige Schlüsse bezüglich der Erhaltung der Bodenfruchtbarkeit ziehen.“"
                            },
                            {
                                "example_id": "ef3d5097-cf0f-41d0-8a2e-3155db6abb69",
                                "sense_id": "9c5fe39c-7bfc-3cbd-ab27-683c1c8b57b2",
                                "text": "[Pflanzenkohle:] „Der dabei gebundene Kohlenstoff kann über Jahrhunderte im Boden bleiben und in Verbindung mit Humus und Bakterien die Bodenfruchtbarkeit deutlich erhöhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
