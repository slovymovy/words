        "fr-extract.jsonl": [
            {
                "entry_id": "4de97bc1-0434-322a-b3e0-20ce65e17ea6",
                "word": "onirisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "20297e71-e969-424d-99c8-1cf8960896cd",
                        "entry_id": "4de97bc1-0434-322a-b3e0-20ce65e17ea6",
                        "tags": [
                            "plural"
                        ],
                        "form": "onirismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "346c4715-6d37-3ccb-af34-335d385acd5d",
                        "entry_id": "4de97bc1-0434-322a-b3e0-20ce65e17ea6",
                        "glosses": [
                            "État mental dans lequel on prend ses rêves pour la réalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd44826f-e1f5-48fc-8dc1-4ecd7e84e58c",
                                "sense_id": "346c4715-6d37-3ccb-af34-335d385acd5d",
                                "text": "Un risque évident, quand on fait appel à l’art pour traiter du rêve, est de confondre le rêve avec l’onirisme, et de considérer que toute œuvre onirique rend témoignage du sommeil."
                            },
                            {
                                "example_id": "e41d9e1e-1337-4f35-9db1-9ce0a890d154",
                                "sense_id": "346c4715-6d37-3ccb-af34-335d385acd5d",
                                "text": "Il est atteint d’un délire aigu, accompagné de tremblements, de fièvre et d’onirisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55eb747b-0df4-41c8-ad6e-397ed66e9002",
                        "source_entry_id": "4de97bc1-0434-322a-b3e0-20ce65e17ea6",
                        "source_sense_id": "346c4715-6d37-3ccb-af34-335d385acd5d",
                        "target_lang_word": "Onei­ris­mus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f6f2073b-231e-4ac8-8229-987a6fcd4338",
                        "source_entry_id": "4de97bc1-0434-322a-b3e0-20ce65e17ea6",
                        "source_sense_id": "346c4715-6d37-3ccb-af34-335d385acd5d",
                        "target_lang_word": "oneirism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oneirism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fd7f3a9-6d64-30f9-98d3-14ee2219f9b0",
                                        "entry_id": "6374365c-c750-35bd-bc07-9f8a56d75f0b",
                                        "glosses": [
                                            "Dream-like experiences or qualities; dreaminess."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5c6204-44f9-4546-84b8-4bc93a0ad52b",
                                                "sense_id": "7fd7f3a9-6d64-30f9-98d3-14ee2219f9b0",
                                                "text": "Following great explosions two forms of mental trouble have been found so frequently that other manifestations have become almost exceptional. These are mental confusion and delirious oneirism."
                                            },
                                            {
                                                "example_id": "e29a7f8c-e41b-4510-8043-62b95718b2b1",
                                                "sense_id": "7fd7f3a9-6d64-30f9-98d3-14ee2219f9b0",
                                                "text": "With an almost imperceptible touch, the narrator connects up this oneirism of names with the premonitory signs of the vocation that Remebrance is said to recount."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eee3cb53-15cd-317a-ab79-3b301d4e8223",
                                        "entry_id": "6374365c-c750-35bd-bc07-9f8a56d75f0b",
                                        "glosses": [
                                            "A state of abnormal consciousness in which dream-like experiences and hallucinations happen while awake."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
