                "senses": [
                    {
                        "sense_id": "0f7a0be7-8ae0-3868-a57e-83349dc2027a",
                        "entry_id": "16acda1c-d11f-347f-8aba-f9db6fc02ada",
                        "glosses": [
                            "Alternative form of Sangley."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c13d3a-6c4c-459d-a642-06b4f4346f1c",
                                "sense_id": "0f7a0be7-8ae0-3868-a57e-83349dc2027a",
                                "text": "The steersmen were killed on two of the bancas; the bancas, turning broadside to the current, were soon capsized, and the river became a mass of frenzied sangleys fighting for their lives in the treacherous waters."
                            },
                            {
                                "example_id": "b95d4b00-a878-436b-bb83-accbcb1fe913",
                                "sense_id": "0f7a0be7-8ae0-3868-a57e-83349dc2027a",
                                "text": "Moreover, the sangleys are setting up a small parian in this area. This is bound to grow in time as more and more sangleys will go there to sow the fields and plant sugarcane."
                            },
                            {
                                "example_id": "92838f19-3fb8-4e9a-a067-711e11f55f46",
                                "sense_id": "0f7a0be7-8ae0-3868-a57e-83349dc2027a",
                                "text": "As discussed in the Introduction, the sangley was intimately associated with the economic activity of trade: even though there were sangleyes who worked as artisans (and in some cases farmers and fishermen), sangley involvement in the China-Manila-Mexico galleon trade was a key element of the early Spanish colonial economy. The sangley was also characterized by his high level of mobility, that is, his \"frequent coming\" from somewhere not here but near."
                            }
                        ]
                    }
