                                    {
                                        "sense_id": "d9ae6bfe-4c80-396e-aa2b-372afb66ba17",
                                        "entry_id": "cd4af350-e878-3d06-bfa5-50f24a73175c",
                                        "glosses": [
                                            "einige Vogelarten aus der Familie Phasianidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb06e41-b7ec-4ad7-8e96-50f7445bec50",
                                                "sense_id": "d9ae6bfe-4c80-396e-aa2b-372afb66ba17",
                                                "text": "Die Männchen vieler Fasane sind sehr farbenprächtig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c2a60fd-91f2-3e3a-9588-f8f1d04b519b",
                                        "entry_id": "cd4af350-e878-3d06-bfa5-50f24a73175c",
                                        "glosses": [
                                            "speziell die Vogelart Phasianus colchicus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5863f4c-d260-413e-809c-207febd067e4",
                                                "sense_id": "6c2a60fd-91f2-3e3a-9588-f8f1d04b519b",
                                                "text": "Der Fasan ist ein Vogel, der aus Mittelasien stammt."
                                            },
                                            {
                                                "example_id": "0533f639-9aa5-4343-bfe2-74e9f6c99ba7",
                                                "sense_id": "6c2a60fd-91f2-3e3a-9588-f8f1d04b519b",
                                                "text": "„Kiebitze hatten sich längst aus der Sperrzone verzogen, ebenso waren die Fasane ausgewandert und die wilden, auf Stille angewiesenen Kaninchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "90fb4f36-1ddc-37d7-9183-47414e5b7ed8",
                                        "entry_id": "cd4af350-e878-3d06-bfa5-50f24a73175c",
                                        "glosses": [
                                            "Speisekartoffel: Sortenname: Fasan NN"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f62159-114a-4ea5-8c83-f4b8f42e43e3",
                                                "sense_id": "90fb4f36-1ddc-37d7-9183-47414e5b7ed8",
                                                "text": "Fasan NN, ist eine Kartoffelsorte, der 1997 offiziell von dem Bundessortenamt zugelassen wurde. Die Schalenfarbe ist gelb, die Fleischfarbe ist gelblich. Verwendet wird der Fasan NN als Speisekartoffel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01bcd167-4081-48d1-9557-d1d073945e30",
                        "source_entry_id": "d47f199d-7de6-35c5-bd28-056de4f6181b",
                        "source_sense_id": "da89b1da-6d56-3979-bdcf-db4e6358218a",
                        "source_sense_description": "bepaald soort kleurrijke vogel, Phasianus colchicus",
                        "target_lang_word": "pheasant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pheasant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                                        "entry_id": "1d059ba6-2a7a-379c-8143-980c42a7a16e",
                                        "glosses": [
                                            "A bird of family Phasianidae, often hunted for food."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47c88d9-a97f-41a0-9efc-7b45ef5effa7",
                                                "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            },
                                            {
                                                "example_id": "9773f1ca-c7b7-4cbd-a5f3-e45cf43c13f7",
                                                "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                                                "text": "Or sometimes, passing too near a sequestered copse, the shy tenants were startled, and the superb plumage of the pheasant dashed aside the branches, and the stately bird soared up on rattling wing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                        "entry_id": "1d059ba6-2a7a-379c-8143-980c42a7a16e",
                                        "glosses": [
                                            "The meat of this bird, eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0df7f04-8123-4abc-a3e2-dd42d2dc91ab",
                                                "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                                "text": "Tables were laid with cold pheasant, watercressy finger foods, sweets sufficient to give the Greater Raleigh Area sugar shock."
                                            },
                                            {
                                                "example_id": "cdcbb861-a82f-41a7-9ced-68b2abe883bb",
                                                "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                                "text": "Célestin Lainé sat on the edge of the bed, a tray on his lap, eating pheasant and roast vegetables with a red wine reduction."
                                            },
                                            {
                                                "example_id": "f0e08687-155e-4594-8661-eeb11ac5c616",
                                                "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                                "text": "Bring a dish of berries with cream to me there. Bread, too. And a slice of pheasant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "442febfe-59c8-4dbb-b88f-397640527c51",
                        "source_entry_id": "d47f199d-7de6-35c5-bd28-056de4f6181b",
                        "source_sense_id": "da89b1da-6d56-3979-bdcf-db4e6358218a",
                        "source_sense_description": "bepaald soort kleurrijke vogel, Phasianus colchicus",
                        "target_lang_word": "faisan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1690c90d-959b-3d4d-a7f1-a8839e0c85f8",
                                        "entry_id": "60daff9a-68a9-3896-af92-bfaa03ed86ce",
                                        "glosses": [
                                            "Nom donné à cinq genres de gallinacés de la famille des phasianidés, englobant une vintaine d'espèces qui fréquentent différents habitats forestiers dans les vallées et les montagnes de toute l'Asie du Sud-Est, présentant un dimorphisme sexuel prononcé et où le mâle arbore souvent un plumage multicolore et richement orné."
                                        ],
                                        "tags": [
                                            "Générique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df6c909-20de-486e-91ee-30e2a95986fc",
                                                "sense_id": "1690c90d-959b-3d4d-a7f1-a8839e0c85f8",
                                                "text": "Je repensais à l’automne en Oregon, au vol des faisans, aux soirs bleus, à la mélancolie."
                                            },
                                            {
                                                "example_id": "0fca135e-a1e7-49db-b37f-d178f8a0c784",
                                                "sense_id": "1690c90d-959b-3d4d-a7f1-a8839e0c85f8",
                                                "text": "Les hérons aux ailes de fer et les flamants dont le col se recourbe, traversent les mornes étendues ; les faisans courent sur le sable vert et l’horizon n’est qu’une ligne égale et brune que vient rompre à peine la cime noire d’un pin parasol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82f3af0-b31a-38ff-9995-fc58dfc6fbb0",
                                        "entry_id": "60daff9a-68a9-3896-af92-bfaa03ed86ce",
                                        "glosses": [
                                            "Lorsque le nom de l'espèce n'est pas précisé, nom désignant par ellipse le faisan de Colchide (Phasianus colchicus), appelé encore faisan à collier ou faisan de chasse, qui est originaire d'Asie et dont certaines sous-espèces ont été sélectionnées pour l'élevage et la chasse dès le Moyen-Âge."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0bf926b-6217-42fc-b2bc-9bc355f95992",
                                                "sense_id": "f82f3af0-b31a-38ff-9995-fc58dfc6fbb0",
                                                "text": "« Le faisan est assez beau, je vous l'accorde — mais il est bête, et au départ, il est aussi facile à tirer qu'un cerf-volant. Du point de vue du gourmet, sa chair est dure et sans goût : pour la rendre à peu près comestible, il faut la laisser se \"faisander\", c'est-à-dire se pourrir ! Non, le faisan n'est pas le roi des gibiers."
                                            },
                                            {
                                                "example_id": "ffe59fa9-5ce5-4c84-a3bd-b4c6a95c0ed1",
                                                "sense_id": "f82f3af0-b31a-38ff-9995-fc58dfc6fbb0",
                                                "text": "Une fois à Beaugency, il traversa le pont et s'engagea dans la forêt solognote à la recherche du cimetière de voitures. Apeurés, des faisans et des perdreaux s'envolaient sur son passage et se cachaient derrière les haies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af8d1d2-173b-32a0-84e1-e6af0a3ca55c",
                                        "entry_id": "60daff9a-68a9-3896-af92-bfaa03ed86ce",
                                        "glosses": [
                                            "Individu mâle de cet animal. La femelle s’appelle la faisane ou poule faisane, son petit est le faisandeau."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "259fda39-783a-3524-b323-3c895460a04e",
                                        "entry_id": "60daff9a-68a9-3896-af92-bfaa03ed86ce",
                                        "glosses": [
                                            "Viande de faisan."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fc75fa-1b4b-4c37-a6f6-86ac13d2690a",
                                                "sense_id": "259fda39-783a-3524-b323-3c895460a04e",
                                                "text": "J’ai fait manger du faisan et des becfigues à plus de quatre pauvres diables qui n’avaient jamais goûté la viande de leurs moutons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2886f181-7d40-38d4-b6ea-2e6982a8020a",
                                        "entry_id": "60daff9a-68a9-3896-af92-bfaa03ed86ce",
                                        "glosses": [
                                            "Homme de moralité douteuse, escroc."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af014a3-2e3c-41fe-9ef6-c2ddebefc09b",
                                                "sense_id": "2886f181-7d40-38d4-b6ea-2e6982a8020a",
                                                "text": "Le troupeau des faisans fonctionne dans le quadrilatère que forment les rues Montmartre et Richelieu d’un côté, les boulevards et la rue Réaumur de l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78651387-669f-3a1f-b833-412d94b60d0d",
                                        "entry_id": "60daff9a-68a9-3896-af92-bfaa03ed86ce",
                                        "glosses": [
                                            "Idiot."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e18afb1-86f0-43ac-899b-ca9d429949a2",
                                                "sense_id": "78651387-669f-3a1f-b833-412d94b60d0d",
                                                "text": "Perceval : Dans le Languedoc, ils m’appellent Provençal, mais c’est moi qui me suis gouré en disant mon nom. Sinon en Bretagne, c’est le gros faisan au sud, et au nord, c’est juste Ducon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
