                    {
                        "translation_id": "ce8a3348-9163-4c92-8c07-62453e904c6f",
                        "source_entry_id": "1827a56c-3bff-3fd6-9ddf-821b5e582b6e",
                        "source_sense_id": "05454dfc-b776-396c-a7f6-cc62de6766f5",
                        "target_lang_word": "coexister",
