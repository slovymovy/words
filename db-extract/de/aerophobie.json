                ],
                "senses": [
                    {
                        "sense_id": "561963f9-01f7-3b36-9dc8-81f1b5475413",
                        "entry_id": "ee0a524b-44bd-3254-a3f7-5841d0298ad8",
                        "glosses": [
                            "krankhafte, mithin unbegründete und anhaltende Angst, Luft zu schlucken oder schädliche Gase einzuatmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c1ece8-8efe-4eab-8cd1-5ae4c71206d3",
                                "sense_id": "561963f9-01f7-3b36-9dc8-81f1b5475413",
                                "text": "„Bei der häufigeren enzephalitischen Form der Tollwut kommt es zu Funktionsausfällen mit wechselnden Bewusstseinsstörungen, Hydrophobie, Aerophobie, Aggression, Spasmen und Überfunktion des limbischen Systems (Speichelfluss).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d04d2db-f048-4bc2-8a52-8b5351d2cea2",
                        "source_entry_id": "ee0a524b-44bd-3254-a3f7-5841d0298ad8",
                        "source_sense_id": "561963f9-01f7-3b36-9dc8-81f1b5475413",
                        "source_sense_description": "krankhafte Angst, Luft zu schlucken oder schädliche Gase einzuatmen",
                        "target_lang_word": "aerophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10091385-9a5e-34b8-b276-1bfdac28d75a",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "A pathological aversion or sensitivity to air or the movement of air, especially as a symptom of rabies."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cb02f5-2866-4982-b254-7a042fd6b1a7",
                                                "sense_id": "10091385-9a5e-34b8-b276-1bfdac28d75a",
                                                "text": "The patient was diagnosed after displaying both aerophobia and acute hydrophobia."
                                            },
                                            {
                                                "example_id": "0c32f109-19e1-4ada-8b81-10fd4d285f46",
                                                "sense_id": "10091385-9a5e-34b8-b276-1bfdac28d75a",
                                                "text": "Furious rabies, the more common presentation, involves the brainstem, the limbic system,, the hypothalamus, and the autonomic center. It is characterized by hydrophobia, aerophobia, and episodic generalized arousal interrupted by periods of lucidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc92d81-c349-39b0-aa4e-0054611b9d92",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "An aversion to fresh air, drafts or breezes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da066e2b-fd82-4387-944b-fc342803b2cc",
                                                "sense_id": "1bc92d81-c349-39b0-aa4e-0054611b9d92",
                                                "text": "I can't understand your aerophobia on days this warm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d087b7-a34b-3552-9655-82125080359f",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "Fear of flying"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def4243b-6c1b-43cb-960d-62d2aa0678bf",
                                                "sense_id": "95d087b7-a34b-3552-9655-82125080359f",
                                                "text": "Many first-time flyers suffer from aerophobia, though some hide it better than others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1768a50-c159-3256-9a2d-e8e266dd051f",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "Fear of heights"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "possibly",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6795af06-5b65-48c7-9c34-905a9d5cd9f3",
                                                "sense_id": "e1768a50-c159-3256-9a2d-e8e266dd051f",
                                                "text": "Standing on the edge of the cliff made me realise just how much aerophobia affected me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5f57869-fe12-42e0-b681-2a978fe40c63",
                        "source_entry_id": "ee0a524b-44bd-3254-a3f7-5841d0298ad8",
                        "source_sense_id": "561963f9-01f7-3b36-9dc8-81f1b5475413",
                        "source_sense_description": "krankhafte Angst, Luft zu schlucken oder schädliche Gase einzuatmen",
                        "target_lang_word": "aérophobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aérophobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e42ba1d-cf3e-37dc-b403-25156840626b",
                                        "entry_id": "3bc27852-ba32-3325-b491-c337610a714f",
                                        "glosses": [
                                            "Crainte du grand air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e01faae5-b36c-41bf-b6c7-bbd144919ff7",
                                                "sense_id": "5e42ba1d-cf3e-37dc-b403-25156840626b",
                                                "text": "L'aérophobie était tellement accentuée que le léger courant d'air produit par la simple fermeture de la porte suffisait pour provoquer au malade, des spasmes musculaires subits et presque généralisés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
