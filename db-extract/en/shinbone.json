                    {
                        "translation_id": "8ee8b83e-45be-494e-b553-ff66eec7bc8e",
                        "source_entry_id": "97d232dc-7c0b-35e5-bdc8-973e2cc83cda",
                        "source_sense_description": "inner bone of the hind limb below the knee",
                        "target_lang_word": "tibia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tibia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                        "entry_id": "b0a07dd0-6144-395f-bcff-2674a8e73e55",
                                        "glosses": [
                                            "Le plus gros des deux os de la jambe, qui se trouve à la partie antérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf05053f-0d03-490e-b8a3-327d1a87e4f2",
                                                "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                                "text": "Se casser le tibia."
                                            },
                                            {
                                                "example_id": "538ed75f-ebf5-4c8a-8862-c430b3b15ada",
                                                "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                                "text": "Il mâchait une petite branche de tilleul en guise de dessert, croisait l’un sur l’autre, avec une désinvolture de squelette frivole, ses tibias sans chair, et il lisait, sous son auvent de paille noire poussiéreuse."
                                            },
                                            {
                                                "example_id": "05e7ceeb-3f7f-4a02-a327-e14d5c53bc77",
                                                "sense_id": "6eb37e8a-d0d2-3ee4-95a9-c881686cbf29",
                                                "text": "On connaît ses fringues extravagantes, la veste en lézard et le costume de 2 000 dollars en poulain mort-né, qu’il jeta un jour dans la poubelle d’un aéroport, son chapeau orné d’une superbe tête de mort, tibias croisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109801d0-2697-3fd0-b9a2-58e413e1ca72",
                                        "entry_id": "b0a07dd0-6144-395f-bcff-2674a8e73e55",
                                        "glosses": [
                                            "Face avant de la partie antérieure de la jambe."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92e40d9-629a-4388-a86d-8081903a469d",
                                                "sense_id": "109801d0-2697-3fd0-b9a2-58e413e1ca72",
                                                "text": "Recevoir un coup dans le tibia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b576eaa-7b7e-4f49-a71a-3efae14e877a",
                        "source_entry_id": "97d232dc-7c0b-35e5-bdc8-973e2cc83cda",
                        "source_sense_description": "inner bone of the hind limb below the knee",
                        "target_lang_word": "Schienbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schienbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                        "entry_id": "6f84fb94-5e94-3d5b-bf3b-490c33357acf",
                                        "glosses": [
                                            "der kräftigere der beiden Knochen des Unterschenkels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1101d972-40e3-447c-b2f7-c886eb05518a",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "Das Skelett des Beines besteht aus dem Oberschenkelknochen, den Unterschenkelknochen (Schienbein und Wadenbein), den Fußwurzelknochen, Mittelfußknochen und den Zehenknochen."
                                            },
                                            {
                                                "example_id": "4307e5b4-934c-4923-8db8-4538309f627b",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "Beim Fußball geht es manchmal etwas rau zu. Da wird schon mal gegen das Schienbein getreten."
                                            },
                                            {
                                                "example_id": "2cf801ce-7434-4a23-8b7b-b63501ab562f",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "„Kurz darauf wurde Jörg B. festgenommen, wobei er einem Beamten gegen das Schienbein trat.“"
                                            },
                                            {
                                                "example_id": "2dc26328-3c2b-40f4-8971-4b61363863be",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "„Das Kind riß sich los und versetzte der Mutter einen Tritt gegen das Schienbein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
