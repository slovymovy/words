                "senses": [
                    {
                        "sense_id": "72f835b6-9c24-3c7f-b68c-85e53db63b07",
                        "entry_id": "a7090811-07be-31ae-91eb-762472591465",
                        "glosses": [
                            "przedstawiciel szkoły filozoficznej Antystenesa"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e936d899-279f-3485-b9a1-ecc2a6db7aec",
                        "entry_id": "a7090811-07be-31ae-91eb-762472591465",
                        "glosses": [
                            "człowiek lekceważący autorytety i przyjęte zasady"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c414ff12-b27b-4946-8f5c-6bc2d47f352c",
                                "sense_id": "e936d899-279f-3485-b9a1-ecc2a6db7aec",
                                "text": "Myślę o niej często, wspominając człowieka niezbyt szczęśliwego, który na złość samemu sobie przez wiele lat budował swoją reputację cynika i zimnego drania – nadaremno."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "810fee40-0d5b-49ba-88b4-9971dd429b41",
                        "source_entry_id": "a7090811-07be-31ae-91eb-762472591465",
                        "source_sense_id": "72f835b6-9c24-3c7f-b68c-85e53db63b07",
                        "target_lang_word": "cynic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                        "entry_id": "db410a88-2f81-3aab-a980-4c148adf5ae7",
                                        "glosses": [
                                            "A person whose outlook is scornfully negative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd617ac-19c3-4048-b6ab-97046f2151a8",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "Well, that's one in the eye for the nay-sayers, the doubters, the cynics and assorted tosspots what make up the media and that."
                                            },
                                            {
                                                "example_id": "35e96f49-73cd-4c29-a4b2-a96443916cf9",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "\"Accept your limitations,\" I'd warn her. \"A lot of these kids are damaged beyond repair.\" And you know what her response was? That I was cynical. Which hit a nerve, I had to admit. I wasn't a cynic; I was a banged-up realist. You live to middle age, you begin to reckon with life's limits, you know? You lace up your sneakers and run it out."
                                            },
                                            {
                                                "example_id": "e99d991c-6e84-47e0-bb13-1334128f98ff",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "The cynic surfaced, reminding him that she'd been accused of trying to spring the baby trap on Brad Comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ff83bd-3613-35e7-9b3d-53ae832f25f4",
                                        "entry_id": "db410a88-2f81-3aab-a980-4c148adf5ae7",
                                        "glosses": [
                                            "A person who believes that all people are motivated by selfishness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cynic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77314372-7a58-30f1-970e-c22ef0ed409e",
                                        "entry_id": "3619f86b-5ea0-355b-87fd-882ef7df1305",
                                        "glosses": [
                                            "cynical (in all senses)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ef84b03-6fdc-3bbe-8ffb-5480f86d69ba",
                                        "entry_id": "3619f86b-5ea0-355b-87fd-882ef7df1305",
                                        "glosses": [
                                            "Relating to the Dog Star."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c2dbe7-5159-487c-ad71-6126e7d88968",
                                                "sense_id": "6ef84b03-6fdc-3bbe-8ffb-5480f86d69ba",
                                                "text": "the cynic, or Sothic, year; cynic cycle"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8737aaa5-dbcc-4515-b520-f06270c02517",
                        "source_entry_id": "a7090811-07be-31ae-91eb-762472591465",
                        "source_sense_id": "72f835b6-9c24-3c7f-b68c-85e53db63b07",
                        "target_lang_word": "cínico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cínico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ccdf2e70-818c-3fe7-afa3-6b628c871210",
                                        "entry_id": "2fb07ffe-097f-381c-a650-e43b8103960f",
                                        "glosses": [
                                            "Que pertenece o concierne a la escuela de la filosofía griega del mismo nombre, que abogaba por una vida sencilla y el abandono de las sofisticaciones de la sociedad."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56a14d4f-c717-35c1-931d-275945f50493",
                                        "entry_id": "2fb07ffe-097f-381c-a650-e43b8103960f",
                                        "glosses": [
                                            "Seguidor de la escuela cínica₁ o cinismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db6e29c6-98ad-4a2c-8ec2-eb4aabda2b8b",
                                                "sense_id": "56a14d4f-c717-35c1-931d-275945f50493",
                                                "text": "Las gentes, como los vían, detestando tanta desvergüenza como a perros y bestias los escopían, tirábanles piedras y lodo, como a enemigos de la humana vergüenza; los cuales, para que nadie los impidiese, proveyéronse de ciertos garabatos o asadores o semejantes instrumentos de hierro y con ellos iban tras los que los molestaban y estorbaban en aquello. Estos philósophos o bestias se llamaban cínicos, cuasi caninos o perrunos, porque en ellos no había, más que si fueran perros, vergüenza."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ccd3eb82-6003-315c-9c98-2c608827c990",
                                        "entry_id": "2fb07ffe-097f-381c-a650-e43b8103960f",
                                        "glosses": [
                                            "Impúdico, procaz; que no muestra vergüenza por cometer acciones chocantes, ofensivas o contra las convenciones sociales, rechazándolas, en especial las relativas al pudor y honestidad; que se expresa con sinceridad fría y brutal."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81968233-15d3-4266-aaa6-5a6916ad174d",
                                                "sense_id": "ccd3eb82-6003-315c-9c98-2c608827c990",
                                                "text": "Y dejando a un lado los tiempos remotos de la antigua Grecia, pasemos rápidamente la vista sobre el modo de decir de los escritores del siglo cultísimo (con relación sin duda a los anteriores) de Augusto, y dígasenos francamente si el oscuro Persio, si el acre Juvenal, usando de giros más cínicos que los mismos personajes imperiales que satirizaban, hubieran hallado lectores sufridos en nuestro siglo de más hipócritas modales, amigo de giros más mojigatos."
                                            },
                                            {
                                                "example_id": "3d155575-f185-403b-b607-2db7ac708717",
                                                "sense_id": "ccd3eb82-6003-315c-9c98-2c608827c990",
                                                "text": "Mas ¿cuál infame y cínica cohorte\nÁ mis ojos parece?... ¡Ah vil canalla,\nEscándalo y escoria de la Corte!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f95b6cc4-904e-36c1-96f4-ae7d592a6b4f",
                                        "entry_id": "2fb07ffe-097f-381c-a650-e43b8103960f",
                                        "glosses": [
                                            "Que no cuida su aseo personal."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "425f3d4c-3068-328b-8e75-bee1293d25e2",
                                        "entry_id": "2fb07ffe-097f-381c-a650-e43b8103960f",
                                        "glosses": [
                                            "Por extensión, que muestra desconfianza hacia los valores y motivos éticos, adoptando un frío realismo y escepticismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb8ad1b-761d-458d-9eb6-6948cb38ac51",
                                                "sense_id": "425f3d4c-3068-328b-8e75-bee1293d25e2",
                                                "text": "¿Qué pasa con la amistad hispanoárabe tan dejada de la mano de España durante siglos y, de pronto, convertida en un postulado de la política española? Quienes suelen preferir las explicaciones cínicas y materiales atribuirán el fenómeno a los petrodólares."
                                            },
                                            {
                                                "example_id": "6237c738-2de0-458f-977f-349113a54fe0",
                                                "sense_id": "425f3d4c-3068-328b-8e75-bee1293d25e2",
                                                "text": "La experiencia, el saber tanto del mundo, el leer entre líneas, la perspicacia excesiva, el espíritu crítico... Todo eso que, en tus relaciones y negocios, te ha llevado demasiado lejos, hasta el punto de volverte un poco cínico; todo ese 'excesivo realismo' —que es falta de espíritu sobrenatural— ha invadido incluso tu vida interior. —Por no ser sencillo, te has vuelto a veces frío y cruel."
                                            },
                                            {
                                                "example_id": "290557ab-4d63-4f28-8bb6-eba7e79e42fa",
                                                "sense_id": "425f3d4c-3068-328b-8e75-bee1293d25e2",
                                                "text": "Algunos mexicanos aseveran cínicamente que lo único que los españoles desean es ganar dinero. Foco central de la celebración española del aniversario será una ostentosa Exposición Universal en Sevilla, en la que se invertirán 800 millones de dólares."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "73829e07-78e0-3d80-9295-cad756d9f5a6",
                                        "entry_id": "2fb07ffe-097f-381c-a650-e43b8103960f",
                                        "glosses": [
                                            "Que olvida el hecho de una circunstancia negativa que la misma persona causó o se hace el desentendido de esta. Que no considera el sufrimiento o malas consecuencias que hace afectar a otros, ni a sí mismo. Frialdad y falta de empatía, con la idea que todo se hace por egoísmo.^([cita requerida])"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "549d51dc-32e7-4c14-bff9-aec966c8f984",
                        "source_entry_id": "a7090811-07be-31ae-91eb-762472591465",
                        "source_sense_id": "e936d899-279f-3485-b9a1-ecc2a6db7aec",
                        "target_lang_word": "cynic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cynic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                        "entry_id": "db410a88-2f81-3aab-a980-4c148adf5ae7",
                                        "glosses": [
                                            "A person whose outlook is scornfully negative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd617ac-19c3-4048-b6ab-97046f2151a8",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "Well, that's one in the eye for the nay-sayers, the doubters, the cynics and assorted tosspots what make up the media and that."
                                            },
                                            {
                                                "example_id": "35e96f49-73cd-4c29-a4b2-a96443916cf9",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "\"Accept your limitations,\" I'd warn her. \"A lot of these kids are damaged beyond repair.\" And you know what her response was? That I was cynical. Which hit a nerve, I had to admit. I wasn't a cynic; I was a banged-up realist. You live to middle age, you begin to reckon with life's limits, you know? You lace up your sneakers and run it out."
                                            },
                                            {
                                                "example_id": "e99d991c-6e84-47e0-bb13-1334128f98ff",
                                                "sense_id": "8436f2fa-9e2e-33be-a250-e45c771aecf6",
                                                "text": "The cynic surfaced, reminding him that she'd been accused of trying to spring the baby trap on Brad Comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ff83bd-3613-35e7-9b3d-53ae832f25f4",
                                        "entry_id": "db410a88-2f81-3aab-a980-4c148adf5ae7",
                                        "glosses": [
                                            "A person who believes that all people are motivated by selfishness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cynic",
                                "target_lang_code": "en",
