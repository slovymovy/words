                        "examples": [
                            {
                                "example_id": "97d50305-be07-4ee5-b317-4fde80effcbc",
                                "sense_id": "c50b0efe-1ff1-3be6-99d2-dd45696db6c5",
                                "text": "Far from being gaumy with pitch, they looked rather remarkably smooth and well manicured."
                            },
                            {
                                "example_id": "23e0f744-6cce-4731-b0f7-f5fccc5aec14",
                                "sense_id": "c50b0efe-1ff1-3be6-99d2-dd45696db6c5",
                                "text": "The narrow, dark stairs are gaumy with paste, and everywhere open barrels of the mixture gave out the sickening, sour odor that is always in the nostrils of the workers."
                            },
                            {
                                "example_id": "d470d1f2-17b3-4fd3-b608-2beb82b06064",
                                "sense_id": "c50b0efe-1ff1-3be6-99d2-dd45696db6c5",
                                "text": "And Fothergil Finch, rather gaumy\nWith Cosmic cosmetics, was there,\nBut the Swami went just as the Swami,\nAfter oiling the kinks in his hair.\nI said to Hermione: \"Goddess! You're graceful, you're Greek, you're a rose, […]\""
                            }
                        ]
