                "senses": [
                    {
                        "sense_id": "ed5526de-b1fe-3889-9626-ff1a1fe93954",
                        "entry_id": "c9686fdb-a58b-3e6d-9548-7f7e7a6ea2d5",
                        "glosses": [
                            "As much as a plain contains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983b8393-74e1-444b-be0a-f916e2c8fd97",
                                "sense_id": "ed5526de-b1fe-3889-9626-ff1a1fe93954",
                                "text": "The world is found bowing before his seat (Rev. ii. 13); as Shadrach, Meshach, Abed-nego stood erect amidst a plainful of prostrate “peoples, nations, and languages,” so the man “not of the world even as” his Master was not, stands erect, exceptional, singular, to be in consequence cast into the furnace for his disconformity."
                            },
                            {
                                "example_id": "711f73c2-1969-4fa3-8d08-64596cb8a7ae",
                                "sense_id": "ed5526de-b1fe-3889-9626-ff1a1fe93954",
                                "text": "The Dutch pictures of old women and cheeses are not less but more heroic and enduring than the eighteenth-century canvases massing a dozen gods, a hundred generals, and a plainful of bleeding soldiers."
                            },
                            {
                                "example_id": "e5c5dc64-8b92-40a3-bc8f-db7e061ccbec",
                                "sense_id": "ed5526de-b1fe-3889-9626-ff1a1fe93954",
                                "text": "Did some mythical giantess in the creation of this earth playfully prepare her desserts by the plainfuls?"
                            },
                            {
                                "example_id": "425ee721-87ae-48b7-9418-86276adbed2e",
                                "sense_id": "ed5526de-b1fe-3889-9626-ff1a1fe93954",
                                "text": "The chessboard they played it out on was the region of Arcadia, which has been described as a plainful of mountains."
                            }
                        ]
                    }
