                    {
                        "sense_id": "f426f740-3ce3-3077-9dae-7476d61540d0",
                        "entry_id": "7e79e73d-6368-35bb-bc93-46c467568022",
                        "glosses": [
                            "Person, mit der man per Brief freundschaftlich verkehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe183ef-e5dd-464f-877f-cc51d682f461",
                                "sense_id": "f426f740-3ce3-3077-9dae-7476d61540d0",
                                "text": "Heute treffe ich meinen Brieffreund das erste Mal persönlich."
                            },
                            {
                                "example_id": "d3320632-316a-4159-ae4a-d52ad49e196e",
                                "sense_id": "f426f740-3ce3-3077-9dae-7476d61540d0",
                                "text": "„Bilibin schrieb, die Zurückhaltung und Diskretion, die sein Beruf ihm auferlege, seien ihm eine Qual, und er sei glücklich, an dem Fürsten Andrej einen zuverlässigen Brieffreund zu haben, vor dem er alle Galle ausschütten könne, die sich angesichts der Zustände und Ereignisse bei der Armee in ihm angehäuft habe.“"
                            },
                            {
                                "example_id": "237f1d38-a151-4c62-80ce-49f4f61a67ba",
                                "sense_id": "f426f740-3ce3-3077-9dae-7476d61540d0",
                                "text": "„Roth schrieb ihr wenig später, und sie wurden Brieffreunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
