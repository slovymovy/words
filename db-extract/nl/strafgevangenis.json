                                            {
                                                "example_id": "ace4d0ef-7c37-456f-becb-d15bbd6efd0d",
                                                "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                                                "text": "released from jail"
                                            },
                                            {
                                                "example_id": "1e702702-091f-4402-ab64-5d5e170b0f18",
                                                "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                                                "text": "jail sentence"
                                            },
                                            {
                                                "example_id": "003076ce-0e5b-47bf-9590-863c0003cd44",
                                                "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                                                "text": "He was sent to jail for theft."
                                            },
                                            {
                                                "example_id": "cc7e03a2-1a54-427f-9fd0-86ce78e79df3",
                                                "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                                                "text": "She visited her brother in jail."
                                            },
                                            {
                                                "example_id": "b8b178b4-9b90-45bf-82c7-2727595fee4a",
                                                "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                                                "text": "Taking a shower at the high school, Tommy (the Kitten) Cavanaugh kids Ugly Palmers. \"Ugly, if you think the world is coming to an end,\" he says, \"what are you wasting your time here at this jail for? You gonna need American history up there?\""
                                            },
                                            {
                                                "example_id": "b5e8710e-3207-4bfd-aba4-e294962d1d6e",
                                                "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                                                "text": "“I’m out!” That, of course, is an excerpt from Robert Durst’s children’s books [sic], Goodbye Jail. “Goodbye money. Goodbye bail. I killed them all, but goodbye jail. Of course! Of course!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df96d964-f4b7-3257-8b53-25bf15a0e508",
                                        "entry_id": "9e04f472-aeef-3e86-b7b6-d42d2f163547",
                                        "glosses": [
                                            "Confinement in a jail."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070a15e2-2f07-4874-bfbc-4bc1b8b97dce",
                                                "sense_id": "df96d964-f4b7-3257-8b53-25bf15a0e508",
                                                "text": "He said Robins had not been in trouble with the law before and had no previous convictions. Jail would have an adverse effect on her and her three children as she was the main carer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007b6666-bc42-3835-bca3-67fbcc825d70",
                                        "entry_id": "9e04f472-aeef-3e86-b7b6-d42d2f163547",
                                        "glosses": [
                                            "The condition created by the requirement that a horse claimed in a claiming race not be run at another track for some period of time (usually 30 days)."
