                                        "entry_id": "d7727803-a931-3cb4-9ea5-b4cd3a981beb",
                                        "glosses": [
                                            "To acquire or obtain through force; snatch, steal; to rob, especially in reference to jugging (which see)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5507ba64-2e22-4fd2-bf3a-12cc08689e3d",
                                                "sense_id": "e1e4bf06-b331-3e46-a3a4-69432fac97b8",
                                                "text": "I just jugged a band director; now I got a brand new saxophone."
                                            }
                                        ]
