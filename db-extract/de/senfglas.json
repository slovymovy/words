                    },
                    {
                        "translation_id": "d6fcfb0b-d486-4c87-8eef-71c03bb4044b",
                        "source_entry_id": "e86361a4-4cdb-3291-9439-42c7691f75da",
                        "source_sense_id": "a0ab50bc-9624-3fc4-8ba3-6c3a08033a72",
                        "source_sense_description": "Glas, dessen Bestimmung die Aufbewahrung von Senf ist",
                        "target_lang_word": "verre à moutarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verre à moutarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b20dc17-43e5-3e45-a18b-b0439048066b",
                                        "entry_id": "2ebdd80d-cba6-3c1e-b2f2-6bae89b16cec",
                                        "glosses": [
                                            "Verre sans pied de 20 centilitres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449adb28-215d-4005-b671-a1263bf9c869",
                                                "sense_id": "3b20dc17-43e5-3e45-a18b-b0439048066b",
                                                "text": "Sur la table, des verres taillés d’une finesse extrême voisinaient avec des verres à moutarde, des couteaux de cuisine avec des petites cuillers d’argent armoriées."
                                            },
                                            {
                                                "example_id": "343acfae-38fb-4cc4-ba8e-c6a4bca0338f",
                                                "sense_id": "3b20dc17-43e5-3e45-a18b-b0439048066b",
                                                "text": "En deux mois ils jouaient tout Gershwin sur des verres à moutarde"
                                            },
                                            {
                                                "example_id": "7f68e9b0-857a-45b1-8b2a-9e3f13a2da7b",
                                                "sense_id": "3b20dc17-43e5-3e45-a18b-b0439048066b",
                                                "text": "[…], Messaoud dressait aussi le couvert : assiettes en aluminium, fourchettes et cuillers en fer battu, verre à moutarde, et se tenait près de son maître avec des prévenances de butler […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abaddc9b-03ac-321a-84ac-70159534b66a",
                                        "entry_id": "2ebdd80d-cba6-3c1e-b2f2-6bae89b16cec",
                                        "glosses": [
                                            "La contenance d'un tel verre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d635883b-f1c0-42e7-96a7-2936d33b3b24",
                                                "sense_id": "abaddc9b-03ac-321a-84ac-70159534b66a",
                                                "text": "pour 4 personnes : il vous faut : pâte à tarte brisée du commerce ou faîte maison (225 g de farine, sel fin, 1/2 verre à moutarde d'huile d'arachide, 1/2 verre à moutarde d'eau chaude) […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fa9bdd1-d910-447c-86b5-7e22357185ac",
                        "source_entry_id": "e86361a4-4cdb-3291-9439-42c7691f75da",
                        "source_sense_id": "a0ab50bc-9624-3fc4-8ba3-6c3a08033a72",
                        "source_sense_description": "Glas, dessen Bestimmung die Aufbewahrung von Senf ist",
                        "target_lang_word": "pot à moutarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pot à moutarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fa85091-aa06-3825-a133-3b65729eb148",
                                        "entry_id": "8916c8b7-9f51-37df-b552-2b94977abe1e",
                                        "glosses": [
                                            "Récipient destiné à contenir de la moutarde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a0becb-8598-44ff-a1f1-aecf867846bd",
                                                "sense_id": "9fa85091-aa06-3825-a133-3b65729eb148",
                                                "text": "– Quand j’étais petit, je ne pouvais pas voir un pot à moutarde avec des croûtes autour sans que cela me soulève le cœur."
                                            },
                                            {
                                                "example_id": "0cbb161b-3726-49dd-8934-45835f6866e5",
                                                "sense_id": "9fa85091-aa06-3825-a133-3b65729eb148",
                                                "text": "Je constate que toutes mes assiettes sont ébréchées et qu’on boit dans des pots à moutarde reconvertis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4295df90-e18d-3873-998b-c5129b3acc87",
                                        "entry_id": "8916c8b7-9f51-37df-b552-2b94977abe1e",
                                        "glosses": [
                                            "Sorte de petite mine antipersonnel de l’armée allemande en usage durant la Seconde Guerre mondiale."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571bff30-d01e-46d0-8220-40f432d105ce",
                                                "sense_id": "4295df90-e18d-3873-998b-c5129b3acc87",
                                                "text": "Sur les chemins et les fossés se trouvent de nombreuses petites mines dites : « pot à moutarde » à cause de leur ressemblance avec ces objets. Placées en grand nombre […] elles sont dangereuses sur un rayon de 15 mètres au moins."
                                            },
                                            {
                                                "example_id": "317556d1-cc78-4076-92d9-5251eac41bc1",
                                                "sense_id": "4295df90-e18d-3873-998b-c5129b3acc87",
                                                "text": "La mine A-200, appelée pour sa forme « pot à moutarde », est munie d’un allumeur chimique: Buck. Elle consiste en un corps cylindrique en tôle emboutie contenant environ 100 g d’acide picrique en poudre, constituant la charge explosive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
