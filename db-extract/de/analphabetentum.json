                            {
                                "example_id": "4c049d62-924d-48ef-8764-42709e95a4d9",
                                "sense_id": "7e644378-aec0-3283-9cc3-c701fb623d26",
                                "text": "„Arabische Wortführer warfen den Briten oft vor, das Analphabetentum in der arabischen Bevölkerung zu fördern.“"
                            },
                            {
                                "example_id": "4722a803-95c7-4753-8f2f-707c2c4527a7",
                                "sense_id": "7e644378-aec0-3283-9cc3-c701fb623d26",
                                "text": "„Analphabetentum war ein großes Problem, ehe die Taliban auftauchten, es betraf etwa 90 Prozent der Mädchen und 60 Prozent der Jungen.“"
                            },
                            {
                                "example_id": "5b6e75b1-7786-44ea-86f6-d660b4e363db",
                                "sense_id": "7e644378-aec0-3283-9cc3-c701fb623d26",
                                "text": "„Prabhjot Kaur war entsetzt: Sie hatte das Analphabetentum des Landes vor sich, in ihrem eigenen Garten.“"
                            }
                        ],
