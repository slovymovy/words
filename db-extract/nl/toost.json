        "nl-extract.jsonl": [
            {
                "entry_id": "40127bd4-6ed2-3dfb-89c0-c027087f94ce",
                "word": "toost",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "494cdd70-1896-4b76-9d50-25db819bbc06",
                        "entry_id": "40127bd4-6ed2-3dfb-89c0-c027087f94ce",
                        "tags": [
