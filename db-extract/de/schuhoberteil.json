                            {
                                "example_id": "bacda6b0-c1ae-469c-a299-b2b425714682",
                                "sense_id": "712d4a09-99b5-34d5-8e37-83063d2066b6",
                                "text": "„Sie zeichnete sich einen Schuhoberteil auf und ließ Väsele Li durch Schlehenblüte herbitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c382c21-f0d7-4151-b164-6e3e1c427d76",
                        "source_entry_id": "3fb09df0-fc49-34f4-882c-36a2175247af",
                        "source_sense_id": "712d4a09-99b5-34d5-8e37-83063d2066b6",
                        "source_sense_description": "Teil eines Schuhs über der Sohle",
                        "target_lang_word": "dessus de chaussure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7aa8f980-b1e3-4fe3-a1e8-19c3d81fbb5e",
                        "source_entry_id": "3fb09df0-fc49-34f4-882c-36a2175247af",
                        "source_sense_id": "712d4a09-99b5-34d5-8e37-83063d2066b6",
                        "source_sense_description": "Teil eines Schuhs über der Sohle",
                        "target_lang_word": "tige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Organe végétal, généralement en forme d’axe, reliant les racines et les feuilles, et assurant la conduction de la sève brute et de la sève élaborée. Il peut être aérien ou souterrain, et porter des branches, des fleurs ou des fruits."
                                        ],
                                        "tags": [
                                            "Anatomie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02d6641-3ee1-40e4-a0d8-35bd185ce07f",
                                                "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                                "text": "Ce sont les larves des pucerons qui, réunies en familles innombrables, recouvrent quelquefois des branches entières de nos arbres fruitiers, la tige de nos fleurs, de nos légumes."
                                            },
                                            {
                                                "example_id": "d0b446fe-90e7-4974-aa2c-4da0bffc8229",
                                                "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                                "text": "Le chanvre femelle continuant à végéter jusqu'à la maturité de la graine, sa tige acquiert plus de force, sa fibre plus de dureté et on ne peut en tirer parti que dans les carderies."
                                            },
                                            {
                                                "example_id": "0ac8f9e3-7337-49fd-9632-826e8adddd67",
                                                "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                                "text": "Elle sourit en baissant les yeux; sur ses bras, elle portait toute une gerbe de fleurs vives aux longues tiges."
                                            },
                                            {
                                                "example_id": "d4621102-d249-4e39-881a-bc8d38f74049",
                                                "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                                "text": "Il sait aussi fabriquer une flûte douce dans l'entre-nœud d'une grosse tige de berce."
                                            },
                                            {
                                                "example_id": "803950ff-184e-4674-ad69-25775c92016d",
                                                "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                                "text": "Les trous seront effectués à la tarière hélicoïdale ou à la barre à mine avec comme objectif d'enfoncer la tige à 1 mètre de profondeur."
                                            },
                                            {
                                                "example_id": "b0032e57-8f3d-4d5d-8162-8cdb6ff66e48",
                                                "sense_id": "b6a3612b-df57-3a4e-b0d5-2c1be68f00c8",
                                                "text": "Jardin dickinsonien –\nUn enchevêtrement\nde tiges, feuilles et fleurs\nde sucepin,\nvenant\nd’un herbier iridescent,\nenvahit\nle jardin panoramique\n…\nde ma vitre givrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53350b6b-c06d-37a4-b12c-622e6f06fa53",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Pédoncule d’une fleur."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d264d92-ea80-3233-b987-cefeb31ef468",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Arbre, semis, pied."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afbaed99-b322-4797-be6b-6b99f2eca0d1",
                                                "sense_id": "6d264d92-ea80-3233-b987-cefeb31ef468",
                                                "text": "Dans les cas où ces chênes sont entourés de charmes ou, à plus forte raison, de hêtres, le suivi de la régénération devra être continu et fin pour ne pas risquer de perdre trop de chênes et donc limiter le choix ultérieur des tiges qui composeront le peuplement final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae17539-96cd-3277-9ef6-5bac2220037b",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Premier père duquel sont sorties toutes les branches d’une famille, tant la branche aînée que la cadette."
                                        ],
                                        "tags": [
                                            "Généalogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6c8489-4682-453e-b6dd-bb4fb4a785f8",
                                                "sense_id": "8ae17539-96cd-3277-9ef6-5bac2220037b",
                                                "text": "Il sort d’une tige illustre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7388426f-410a-3110-9878-13770d2fb569",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "436ca7cf-4bbf-3237-93f7-0272a56dc918",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "L’espèce de branche qui part d’un culot ou fleuron et qui porte les feuillages d’un rinceau d’ornement."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
