                                "target_word": "Böhmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db338233-db8e-3a3d-809b-757c28037e38",
                                        "entry_id": "08e7e75f-15c4-38c8-860d-258df974509a",
                                        "glosses": [
                                            "ehemaliges Königreich, heute eine Großregion in Tschechien mit der Hauptstadt Prag"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb77eee-bd4d-4e7b-b6a5-0b6cbe168086",
                                                "sense_id": "db338233-db8e-3a3d-809b-757c28037e38",
                                                "text": "Das ist der weiße Löwe nicht von Böhmen! Der Löw’ ist rot! –"
                                            },
                                            {
                                                "example_id": "7a78f5f4-e302-4666-b7ba-43f32ecf711f",
                                                "sense_id": "db338233-db8e-3a3d-809b-757c28037e38",
                                                "text": "„Damit begründete er einen landeseigenen politischen Heiligenkult, der nicht nur Einheit und Identifikation stiftete, die herausgehobene Stellung Prags festigte, ja die Stadt zum Symbol der Herrschaft über Böhmen schlechthin erhob, sondern die Dynastie der Přemysliden, der Wenzel entstammte, auch einen enormen Zuwachs an Prestige und Machtlegitimation verlieh.“"
                                            },
                                            {
                                                "example_id": "d6fbf44d-aca3-4ef5-8c52-4bf1e097ae10",
                                                "sense_id": "db338233-db8e-3a3d-809b-757c28037e38",
                                                "text": "„Mein Interesse für Böhmen wurde erst geweckt, als ich (im Dezember 1980) ins Präsidium der SPD gewählt wurde.“"
                                            },
                                            {
                                                "example_id": "01b430b7-ee1c-4c12-ad1e-51327dae8970",
                                                "sense_id": "db338233-db8e-3a3d-809b-757c28037e38",
                                                "text": "„Der Münzschatz vom Altenfeld ließ sich bis ins 300 Kilometer entfernte Böhmen zurückverfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
