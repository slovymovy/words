                                                "sense_id": "95e9d217-c53e-372f-8cd6-9788123458a9",
                                                "text": "The baby gurgled with delight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gurgle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b1009f-a246-36ab-b506-1e1eafa68908",
