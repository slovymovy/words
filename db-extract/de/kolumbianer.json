                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colombiano",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "191d6c2f-5b02-3ec9-bd50-d7250ef116c4",
                                        "entry_id": "25f9e7b9-d6d5-3933-acb2-f9a56367d74a",
                                        "glosses": [
                                            "Originario, relativo a, o propio de Colombia."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f256cf9-d956-4898-985d-03e98009620e",
                                                "sense_id": "191d6c2f-5b02-3ec9-bd50-d7250ef116c4",
                                                "text": "El honor de la Nueva Granada exige imperiosamente escarmentar a esos osados invasores, persiguiéndolos hasta los últimos atrincheramientos, como su gloria depende de tomar a su cargo la empresa de marchar a Venezuela, a libertar la cuna de la independencia colombiana, sus mártires, y aquel benemérito pueblo caraqueño, cuyos clamores sólo se dirigen a sus amados compatriotas los granadinos, que ellos aguardan con una mortal impaciencia, como a sus redentores."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
