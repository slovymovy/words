{
    "word_family": [
        "easy",
        "easily",
        "uneasy",
        "unease",
        "easiness",
        "uneasiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ebe0c6b-4020-3711-b715-bfbc2f182af7",
                    "sense_definition": "Lack of difficulty; the ability to do something without effort.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty_level",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He passed the driving test with <w>ease</w>.",
                            "target_lang_translations": {
                                "ru": "Он с <w>лёгкостью</w> сдал экзамен по вождению.",
                                "zh": "他<w>轻松</w>地通过了驾驶考试。"
                            }
                        },
                        {
                            "text": "The <w>ease</w> of using this software makes it very popular.",
                            "target_lang_translations": {
                                "ru": "<w>Лёгкость</w> использования этого программного обеспечения делает его очень популярным.",
                                "zh": "这款软件使用的<w>简便性</w>使其非常受欢迎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "easiness",
                        "facility",
                        "simplicity",
                        "effortlessness"
                    ],
                    "antonyms": [
                        "difficulty"
                    ],
                    "common_phrases": [
                        "with ease",
                        "ease of use",
                        "ease of access"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие трудности; способность делать что-то без усилий.",
                        "zh": "指做某事不费力，没有困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лёгкость",
                                "target_lang_sense_clarification": "отсутствие усилий"
                            },
                            {
                                "target_lang_word": "простота",
                                "target_lang_sense_clarification": "отсутствие сложности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻松",
                                "target_lang_sense_clarification": "形容做事的容易程度"
                            },
                            {
                                "target_lang_word": "容易",
                                "target_lang_sense_clarification": "指没有难度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "955fdd06-ba6e-3b83-af74-20eef426ed4e",
                    "sense_definition": "Freedom from worry, problems, or anxiety; a state of being comfortable and relaxed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The good news set her mind at <w>ease</w>.",
                            "target_lang_translations": {
                                "ru": "Хорошие новости вернули ей душевное <w>спокойствие</w>.",
                                "zh": "好消息让她<w>安心</w>了。"
                            }
                        },
                        {
                            "text": "They enjoyed a life of <w>ease</w> and luxury after retirement.",
                            "target_lang_translations": {
                                "ru": "После выхода на пенсию они наслаждались жизнью, полной <w>покоя</w> и роскоши.",
                                "zh": "退休后，他们过着<w>安逸</w>奢华的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "peace",
                        "relaxation",
                        "rest"
                    ],
                    "common_phrases": [
                        "at ease",
                        "ill at ease",
                        "set one's mind at ease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свобода от беспокойства или проблем; состояние комфорта и расслабленности.",
                        "zh": "指没有忧虑、问题或焦虑；处于舒适和放松的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спокойствие",
                                "target_lang_sense_clarification": "душевное равновесие"
                            },
                            {
                                "target_lang_word": "покой",
                                "target_lang_sense_clarification": "отсутствие тревог"
                            },
                            {
                                "target_lang_word": "беззаботность",
                                "target_lang_sense_clarification": "отсутствие забот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安宁",
                                "target_lang_sense_clarification": "指心境平静"
                            },
                            {
                                "target_lang_word": "自在",
                                "target_lang_sense_clarification": "指无拘无束、舒适"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25fff1ca-a9af-34ec-9f5b-ec9d320cfdf7",
                    "sense_definition": "Relief or freedom from physical pain or discomfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relief_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor gave him medicine to provide <w>ease</w> from the pain.",
                            "target_lang_translations": {
                                "ru": "Врач дал ему лекарство для <w>облегчения</w> боли.",
                                "zh": "医生给了他药以<w>缓解</w>疼痛。"
                            }
                        },
                        {
                            "text": "She felt immediate <w>ease</w> after taking the tablet.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала мгновенное <w>облегчение</w> после приема таблетки.",
                                "zh": "服药后她立刻感到<w>轻松</w>多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "relief",
                        "alleviation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Облегчение или избавление от физической боли или дискомфорта.",
                        "zh": "指减轻或消除身体上的疼痛或不适。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчение",
                                "target_lang_sense_clarification": "уменьшение боли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缓解",
                                "target_lang_sense_clarification": "指减轻痛苦"
                            },
                            {
                                "target_lang_word": "减轻",
                                "target_lang_sense_clarification": "指程度上的降低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceda6638-0600-38c7-88f1-298152c16edb",
                    "sense_definition": "Natural behavior that is not awkward or embarrassed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior_grace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke to the large audience with natural <w>ease</w>.",
                            "target_lang_translations": {
                                "ru": "Она говорила перед большой аудиторией с естественной <w>непринуждённостью</w>.",
                                "zh": "她在面对大批听众时表现得十分<w>从容</w>。"
                            }
                        },
                        {
                            "text": "His social <w>ease</w> made everyone feel welcome at the party.",
                            "target_lang_translations": {
                                "ru": "Его <w>непринуждённость</w> в общении заставила всех чувствовать себя желанными гостями на вечеринке.",
                                "zh": "他在社交场合的<w>自如</w>表现让派对上的每个人都感到宾至如归。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poise",
                        "composure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественное поведение, лишенное неловкости или смущения.",
                        "zh": "指自然大方，没有尴尬或局促不安的表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непринуждённость",
                                "target_lang_sense_clarification": "естественность в поведении"
                            },
                            {
                                "target_lang_word": "раскованность",
                                "target_lang_sense_clarification": "свобода в общении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "从容",
                                "target_lang_sense_clarification": "指态度镇定、不慌张"
                            },
                            {
                                "target_lang_word": "自然",
                                "target_lang_sense_clarification": "指举止不造作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a5e8501-7fea-35dc-8957-26aa9b4f2dd1",
                    "sense_definition": "A relaxed standing position in the military with feet apart.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "military_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant ordered the soldiers to stand at <w>ease</w>.",
                            "target_lang_translations": {
                                "ru": "Сержант приказал солдатам стоять <w>вольно</w>.",
                                "zh": "中士命令士兵们<w>稍息</w>。"
                            }
                        },
                        {
                            "text": "At <w>ease</w>, soldier!",
                            "target_lang_translations": {
                                "ru": "<w>Вольно</w>, солдат!",
                                "zh": "<w>稍息</w>，士兵！"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stand at ease",
                        "at ease"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расслабленная стойка в армии с расставленными ногами.",
                        "zh": "军事术语，指两脚分开的放松站立姿势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вольно",
                                "target_lang_sense_clarification": "военная команда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稍息",
                                "target_lang_sense_clarification": "军事口令"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5316a3ed-e3e7-37df-ab8c-f56372fa26d5",
                    "sense_definition": "To make something unpleasant, such as pain, worry, or tension, less severe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "alleviate_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a pill to <w>ease</w> the headache.",
                            "target_lang_translations": {
                                "ru": "Он принял таблетку, чтобы <w>облегчить</w> головную боль.",
                                "zh": "他吃了一片药来<w>缓解</w>头痛。"
                            }
                        },
                        {
                            "text": "The government tried to <w>ease</w> fears about the economy.",
                            "target_lang_translations": {
                                "ru": "Правительство попыталось <w>успокоить</w> страхи по поводу экономики.",
                                "zh": "政府试图<w>平息</w>人们对经济的担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviate",
                        "lessen",
                        "reduce",
                        "assuage",
                        "allay",
                        "soothe"
                    ],
                    "common_phrases": [
                        "ease the pain",
                        "ease the pressure",
                        "ease the burden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-то неприятное (боль, тревогу, напряжение) менее сильным.",
                        "zh": "使不愉快的事物（如疼痛、担忧或紧张）变得不那么严重。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "боль или страдания"
                            },
                            {
                                "target_lang_word": "успокаивать",
                                "target_lang_sense_clarification": "тревогу или страх"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "напряжение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减轻",
                                "target_lang_sense_clarification": "使程度变轻"
                            },
                            {
                                "target_lang_word": "缓解",
                                "target_lang_sense_clarification": "使紧张或痛苦减弱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64b6448-a342-3b9f-8a42-3e9c0ba65abc",
                    "sense_definition": "To move or guide someone or something slowly and carefully into a position.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "move_carefully",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>eased</w> the car into the narrow parking space.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>ввёл</w> машину на узкое парковочное место.",
                                "zh": "他小心翼翼地将车<w>挪进</w>了狭窄的停车位。"
                            }
                        },
                        {
                            "text": "She <w>eased</w> the cork out of the bottle without spilling a drop.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>вытащила</w> пробку из бутылки, не пролив ни капли.",
                                "zh": "她小心地将瓶塞<w>拔出</w>，一滴也没洒出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ease into",
                        "ease out of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно и осторожно перемещать или направлять кого-то или что-то.",
                        "zh": "缓慢而小心地引导某人或某物进入某个位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осторожно двигать",
                                "target_lang_sense_clarification": "перемещать аккуратно"
                            },
                            {
                                "target_lang_word": "аккуратно вводить",
                                "target_lang_sense_clarification": "помещать внутрь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小心地移动",
                                "target_lang_sense_clarification": "缓慢且谨慎地操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bdfe521-4fb6-313c-a904-151e1af1dc48",
                    "sense_definition": "To become less intense or severe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alleviate_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain began to <w>ease</w> off in the afternoon.",
                            "target_lang_translations": {
                                "ru": "Днем дождь начал <w>утихать</w>.",
                                "zh": "下午雨开始<w>减弱</w>了。"
                            }
                        },
                        {
                            "text": "Her pain <w>eased</w> after she rested for a while.",
                            "target_lang_translations": {
                                "ru": "Ее боль <w>утихла</w> после того, как она немного отдохнула.",
                                "zh": "休息了一会儿后，她的疼痛<w>减轻</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lessen"
                    ],
                    "common_phrases": [
                        "ease off",
                        "ease up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться менее интенсивным или суровым; ослабевать.",
                        "zh": "变得不那么强烈或严重。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "о боли или стихии"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "терять силу"
                            },
                            {
                                "target_lang_word": "отпускать",
                                "target_lang_sense_clarification": "разг., о боли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指强度降低"
                            },
                            {
                                "target_lang_word": "缓和",
                                "target_lang_sense_clarification": "指局势或情绪变平稳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "248512ed-aa80-32bf-9522-cf74a8826cc5",
                    "sense_definition": "To make a process, rule, or situation less difficult or strict.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "facilitate_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school decided to <w>ease</w> the entry requirements for new students.",
                            "target_lang_translations": {
                                "ru": "Школа решила <w>смягчить</w> вступительные требования для новых учеников.",
                                "zh": "学校决定<w>放宽</w>新生的入学要求。"
                            }
                        },
                        {
                            "text": "New technology helps to <w>ease</w> the workload for staff.",
                            "target_lang_translations": {
                                "ru": "Новые технологии помогают <w>облегчить</w> рабочую нагрузку на персонал.",
                                "zh": "新技术有助于<w>减轻</w>员工的工作负担。"
                            }
                        }
                    ],
                    "synonyms": [
                        "facilitate",
                        "simplify"
                    ],
                    "common_phrases": [
                        "ease restrictions",
                        "ease regulations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать процесс, правило или ситуацию менее сложными или строгими.",
                        "zh": "使过程、规则或情况变得不那么困难或严格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "делать проще"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "делать менее строгим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放宽",
                                "target_lang_sense_clarification": "指限制变少"
                            },
                            {
                                "target_lang_word": "简化",
                                "target_lang_sense_clarification": "使过程变简单"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}