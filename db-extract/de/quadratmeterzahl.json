                "senses": [
                    {
                        "sense_id": "66a934a6-8370-3c86-b1d2-70d17d885f94",
                        "entry_id": "4c908622-aece-345e-9034-adec2e0f305c",
                        "glosses": [
                            "Anzahl von Quadratmetern (Flächen von 1 m x 1 m), die in Summe die Größe einer Fläche beschreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31394933-fd36-4912-a528-bd221e6e193e",
                                "sense_id": "66a934a6-8370-3c86-b1d2-70d17d885f94",
                                "text": "„Bei etwa zwei Dritteln aller Wohnungen stimmen nach Schätzungen des Deutschen Mieterbundes (DMB) die im Mietvertrag genannten Quadratmeterzahlen nicht mit der tatsächlichen Wohnungsgröße überein.“"
                            },
                            {
                                "example_id": "718a0981-c48e-432e-b680-87f3a83d4077",
                                "sense_id": "66a934a6-8370-3c86-b1d2-70d17d885f94",
                                "text": "„Am 20.04. traten die ersten Lockerungen der Corona-Beschränkungen für den Handel in Kraft. Kleinere Geschäfte mit einer Quadratmeterzahl von bis zu 800 durften wieder öffnen, größere Geschäfte und Kaufhäuser mussten geschlossen bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
