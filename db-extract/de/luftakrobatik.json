                "senses": [
                    {
                        "sense_id": "fcdc895c-8328-3608-9350-05a6efb5aec3",
                        "entry_id": "2b1a25bb-7268-39a3-a283-97b5ca2c0ecd",
                        "glosses": [
                            "Form der Akrobatik, die auf einem Seil, an Trapezen oder Ähnlichem ausgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045dee48-7b86-4513-96c7-9eef49e644b4",
                                "sense_id": "fcdc895c-8328-3608-9350-05a6efb5aec3",
                                "text": "„Sie erzählte mir, dass sie in jungen Jahren Artistin auf dem Drahtseil gewesen sei und später Luftakrobatik machte.“"
                            },
                            {
                                "example_id": "ea2718ee-fdb6-4f28-a43a-720f7123b312",
                                "sense_id": "fcdc895c-8328-3608-9350-05a6efb5aec3",
                                "text": "„Ohne ein großes Herz, stählerne Flügelmuskulatur und eine leistungsstarke Lunge wäre solche Luftakrobatik nicht möglich.“"
                            },
                            {
                                "example_id": "d4d4e8da-f39f-4444-84eb-c0423d9bb4ee",
                                "sense_id": "fcdc895c-8328-3608-9350-05a6efb5aec3",
                                "text": "„Dann bekommen die Zuschauer spektakulären Sport und atemberaubende Luftakrobatik geboten.“"
                            },
                            {
                                "example_id": "ee0ada9b-2bf1-44e3-87e0-bcba70da46ef",
                                "sense_id": "fcdc895c-8328-3608-9350-05a6efb5aec3",
                                "text": "[übertragen:] „Es handelte sich um einen bulligen, stark motorisierten Doppeldecker: ein Jagdflugzeug, das durchaus auch für Luftakrobatik geeignet war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
