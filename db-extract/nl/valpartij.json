                "senses": [
                    {
                        "sense_id": "23d983e4-90cf-318e-98c1-af3c4cf97fdf",
                        "entry_id": "5df98879-8d2d-3d76-b2b6-fcf8198c3c51",
                        "glosses": [
                            "gezamenlijke buiteling tijdens sportbeoefening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6af7fd-2a31-4fea-846b-87b5edff89b8",
                                "sense_id": "23d983e4-90cf-318e-98c1-af3c4cf97fdf",
                                "text": "Na een zware valpartij is zaterdag de derde etappe van de Ronde van België gestaakt en de vierde en laatste dag geschrapt."
                            },
                            {
                                "example_id": "ad7b579f-cbd5-4ab3-b2a2-a3fb82137169",
                                "sense_id": "23d983e4-90cf-318e-98c1-af3c4cf97fdf",
                                "text": "Juist begon hij 't meisje, zeer voorzichtig, den mantel wat schoon te maken, toen door de beweging, of door een zeker (onverklaarbaar?) trillen, ook zijn voeten begonnen te glijden, glijden, glijden.... tot onze ridder met een smak neerplofte, vrij wat onzachter, dan zijne schoone 't hem had voorgedaan. Die valpartij op 't ijs, had het ijs der vormelijkheid voor hen gebroken."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c43697a-4f4a-3446-a6b5-707043bd3057",
                        "entry_id": "5df98879-8d2d-3d76-b2b6-fcf8198c3c51",
                        "glosses": [
                            "buiteling, onderuitgaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107cb2d4-469c-4fb0-9195-604e33b7f126",
                                "sense_id": "1c43697a-4f4a-3446-a6b5-707043bd3057",
                                "text": "Berthe tuimelde tegen een koperen handvat van de commode; zij haalde haar wang open, er kwam bloed uit. Na die valpartij van Berthe trekt Emma aan het schelkoord om de meid erbij te halen."
                            },
                            {
                                "example_id": "180a4f09-3798-49c6-9400-cc8e6350ed9f",
                                "sense_id": "1c43697a-4f4a-3446-a6b5-707043bd3057",
                                "text": "Ik was geheel en al verkleumd door mijn valpartij; ik had een lading sneeuw over mij heen gekregen, en daar ik vergeten had mijn handschoenen aan te trekken, waren mijn handen in ijsklompen veranderd."
                            },
                            {
                                "example_id": "5ff1ff5c-5aa7-46db-b543-c6bb70a2d657",
                                "sense_id": "1c43697a-4f4a-3446-a6b5-707043bd3057",
                                "text": "Of hij de groep wielrenners bewust afsneed, is volgens de politie nog niet duidelijk. Ook staat nog niet onomstotelijk vast dat hij iets merkte van de valpartij."
                            }
                        ]
                    }
                ],
