                            {
                                "example_id": "1efb7b12-19ab-42f1-8c79-9d980d2a81db",
                                "sense_id": "17caf6d6-5ea2-3f32-9817-cb2ae3adeb9a",
                                "text": "De Nederlandse burger is bang voor de buitenwereld en hij neemt dat de overheid kwalijk. “Door immigratie en open grenzen dreigt Nederland te veel van zijn eigenheid te verliezen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "d9cea0e7-d1b9-3faa-bfce-ebca5b359806",
