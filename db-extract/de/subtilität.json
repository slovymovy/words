                ],
                "senses": [
                    {
                        "sense_id": "0e62e594-3b53-325d-9a0e-333abe59522b",
                        "entry_id": "224def67-4469-37b7-a124-599d245c6c75",
                        "glosses": [
                            "bildungssprachlich: die Eigenschaft, subtil zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859b7589-8024-4be4-8847-de56e599471f",
                                "sense_id": "0e62e594-3b53-325d-9a0e-333abe59522b",
                                "text": "„Der Subtilitäten in der Deutung des Dramas ist kein Ende. Immer neue Literaturtheorien üben sich an ihm, und auch das Interesse der Theater wächst weiterhin …“"
                            },
                            {
                                "example_id": "6e22130f-4e40-425d-b0fb-4c9d92aff125",
                                "sense_id": "0e62e594-3b53-325d-9a0e-333abe59522b",
                                "text": "„Nicht, daß die Sprachkritiker sich mit derart groben Fällen von Laisser-faire-Lässigkeit aufhielten – es gibt auch sehr interessante Subtilitäten der Logik.“"
                            },
                            {
                                "example_id": "a936ee8e-3ddc-4835-8ce5-a5997e43e1cc",
                                "sense_id": "0e62e594-3b53-325d-9a0e-333abe59522b",
                                "text": "„Die Gewaltbereitschaft äußerte sich auch in verbalen Ausfällen, die erkennen ließen, dass sich die Subtilitäten intellektueller Diskurse manchen Angehörigen der Bildungselite nicht recht erschlossen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1921405d-b006-426f-9db9-c861009dd559",
                        "source_entry_id": "224def67-4469-37b7-a124-599d245c6c75",
                        "source_sense_id": "0e62e594-3b53-325d-9a0e-333abe59522b",
                        "source_sense_description": "bildungssprachlich: die Eigenschaft, subtil zu sein",
                        "target_lang_word": "subtleness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subtleness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1c13c6-c375-3eba-b1c6-740d330c0776",
                                        "entry_id": "83b3b5e9-7543-3a8e-8b94-467f686cc8b9",
                                        "glosses": [
                                            "The property of being subtle, of avoiding brute force and instead being clever or skillful."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0297cdd9-f4db-4c6c-869a-e5797d4573a9",
                                                "sense_id": "ed1c13c6-c375-3eba-b1c6-740d330c0776",
                                                "text": "The movie was praised for the subtleness of its themes. None of it came off as being too preachy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28cf1356-e660-4d8b-aaca-8f7ae32cbfd2",
                        "source_entry_id": "224def67-4469-37b7-a124-599d245c6c75",
                        "source_sense_id": "0e62e594-3b53-325d-9a0e-333abe59522b",
                        "source_sense_description": "bildungssprachlich: die Eigenschaft, subtil zu sein",
                        "target_lang_word": "subtilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subtilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd3d88e-31c4-37ab-8891-8e92658478e9",
                                        "entry_id": "666fb3e4-3d4d-3499-8378-a1f818a2201e",
                                        "glosses": [
                                            "Caractère de ce qui est subtil, aux divers sens du mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07542db-19fd-49fc-8285-859ff95f62b7",
                                                "sense_id": "ffd3d88e-31c4-37ab-8891-8e92658478e9",
                                                "text": "La subtilité des atomes, des parties de la matière. - La subtilité de l’air. - La subtilité d’un poison. - La subtilité des sens."
                                            },
                                            {
                                                "example_id": "870e1af9-e0d4-4e17-859a-98bf661d3ca7",
                                                "sense_id": "ffd3d88e-31c4-37ab-8891-8e92658478e9",
                                                "text": "Il reconnut, quoique rien ne soit défini en Grèce, […] que lutter de subtilité avec les Grecs, c’était s’exposer à être vaincu."
                                            },
                                            {
                                                "example_id": "5156874e-dbc2-4881-b13e-c23a1208445c",
                                                "sense_id": "ffd3d88e-31c4-37ab-8891-8e92658478e9",
                                                "text": "Dennis incarne la subtilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44d6d8d0-644a-36fa-b385-056dd83c06f9",
                                        "entry_id": "666fb3e4-3d4d-3499-8378-a1f818a2201e",
                                        "glosses": [
                                            "Distinctions ou raisonnements qui sont trop raffinés et qui échappent à l’intelligence."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d329c1-c3b9-4b75-9394-c5595df9b748",
                                                "sense_id": "44d6d8d0-644a-36fa-b385-056dd83c06f9",
                                                "text": "[…] : rien n'est plus gênant en pareil cas que d’être aux prises avec un homme ouvert et franc, qui , sans combattre avec vous de subtilités et de ruses, vous rompt en visière à tout moment."
                                            },
                                            {
                                                "example_id": "686c133e-b8b8-475c-a516-fd24ab07657f",
                                                "sense_id": "44d6d8d0-644a-36fa-b385-056dd83c06f9",
                                                "text": "Les subtilités de l’ontologie ont fait tout au plus des sceptiques ; c’est à la connaissance de la nature qu’il était réservé de faire de vrais déistes."
                                            },
                                            {
                                                "example_id": "11367296-07de-4309-8985-321db5c8b306",
                                                "sense_id": "44d6d8d0-644a-36fa-b385-056dd83c06f9",
                                                "text": "Dans l’Aurore du 4 septembre 1905, Clemenceau reproche à Jaurès d'embrouiller l'esprit de ses partisans « en des subtilités métaphysiques où ils sont incapables de le suivre » ; […]."
                                            },
                                            {
                                                "example_id": "84ff6e77-1be4-4f13-9387-ff313af2bbb5",
                                                "sense_id": "44d6d8d0-644a-36fa-b385-056dd83c06f9",
                                                "text": "Il s'évertua en français à expliquer à l’irlandais les subtilités des différents plats de poisson, particulièrement du « Tronçon de turbot grillé aux oignons caramélisés, arlésienne de légumes, sauce choron. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
