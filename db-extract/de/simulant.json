                            {
                                "example_id": "bae2b5e9-c0c2-4ee5-bfdc-5f79c25d703e",
                                "sense_id": "f8e2aacf-d82a-3679-9ae7-ae645e0ae675",
                                "text": "Schwester: \"Herr Doktor, der Simulant in Zimmer 9 ist gestorben!\" -- Doktor: \"Jetzt übertreibt er es aber!\"",
                                "translation": "Infirmière : \"Docteur, le simulateur de la chambre 9 est mort\" ! -- Docteur : \"Maintenant, il exagère !\""
                            }
                        ]
                    }
