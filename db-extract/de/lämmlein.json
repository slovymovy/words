                ],
                "senses": [
                    {
                        "sense_id": "e0f616d3-63e0-3f06-9cb6-9613311cc863",
                        "entry_id": "2df96a17-e11b-3d0c-adf2-1fe484a01bd2",
                        "glosses": [
                            "kleines Lamm"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "3551ecf0-c52b-46b3-a7b8-334b03cff44d",
                                "sense_id": "e0f616d3-63e0-3f06-9cb6-9613311cc863",
                                "text": "„Die Schafe haben gerade Lämmlein geworfen, die wie flauschige Wattebällchen die nun saftigen Wiesen sprenkeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7118efd-d00a-4c86-8b8c-6a653586b334",
                        "source_entry_id": "2df96a17-e11b-3d0c-adf2-1fe484a01bd2",
                        "source_sense_id": "e0f616d3-63e0-3f06-9cb6-9613311cc863",
                        "source_sense_description": "Diminutiv von Lamm: kleines Lamm",
                        "target_lang_word": "lambkin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambkin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3beb0a50-6b06-3afd-9ccf-d6eebc28f8d6",
                                        "entry_id": "6f55ddfc-04b4-310b-9196-cfe6396df228",
                                        "glosses": [
                                            "A young lamb, a very young sheep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fddbc438-3bac-4010-bdfc-66503d08a853",
                                                "sense_id": "3beb0a50-6b06-3afd-9ccf-d6eebc28f8d6",
                                                "text": "A lambkin’s snowy fleece"
                                            },
                                            {
                                                "example_id": "a8ba69d7-3ed3-48e5-a53a-9e656f079897",
                                                "sense_id": "3beb0a50-6b06-3afd-9ccf-d6eebc28f8d6",
                                                "text": "There might ye ſee the pioney ſpread vvide, / The full-blovvn roſe, the ſhepherd and his laſs, / Lap-dog and lambkin vvith black ſtaring eyes, / And parrots vvith tvvin cherries in their beak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e767758d-b482-3fa8-9af1-54e3722d4da7",
                                        "entry_id": "6f55ddfc-04b4-310b-9196-cfe6396df228",
                                        "glosses": [
                                            "A term of endearment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b7dfb7-1541-4644-b953-205f4d43a6cc",
                                                "sense_id": "e767758d-b482-3fa8-9af1-54e3722d4da7",
                                                "text": "Let vs condoll the knight: for lamkins vve vvill liue."
                                            },
                                            {
                                                "example_id": "dd1b225a-a2af-4f6e-bec1-1a5b43513152",
                                                "sense_id": "e767758d-b482-3fa8-9af1-54e3722d4da7",
                                                "text": "She has no real cognisance, dear lambkin, of anything at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab04b1e3-e484-4779-a317-84cd0d2ee9c7",
                        "source_entry_id": "2df96a17-e11b-3d0c-adf2-1fe484a01bd2",
                        "source_sense_id": "e0f616d3-63e0-3f06-9cb6-9613311cc863",
                        "source_sense_description": "Diminutiv von Lamm: kleines Lamm",
                        "target_lang_word": "lambie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4996def-8403-363a-8b0d-6c9c1a4a5331",
                                        "entry_id": "384b551a-c1d1-38bb-90b9-934c170d0c2d",
                                        "glosses": [
                                            "A lamb."
                                        ],
                                        "tags": [
                                            "childish",
                                            "endearing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b287dc9c-0b30-4f22-b59a-abc2fede1d38",
                                                "sense_id": "e4996def-8403-363a-8b0d-6c9c1a4a5331",
                                                "text": "Your lambies aren't lambies anymore, but they're pining for you just the same, and I'll drop them off on my way back if you want."
                                            },
                                            {
                                                "example_id": "c692e721-1a43-404a-b3ff-d9db57d75e81",
                                                "sense_id": "e4996def-8403-363a-8b0d-6c9c1a4a5331",
                                                "text": "The part I don't like about sheep and wool festivals? The part where the little lambies aren't considered part of the fiber-bearing aspect but as part of the snack-food aspect. Lambies on a stick or ground up into sausage are not nearly as much fun to imagine as gamboling lambies waiting happily to be shorn."
                                            },
                                            {
                                                "example_id": "1c628ca8-e66e-436d-825f-c7764ba15453",
                                                "sense_id": "e4996def-8403-363a-8b0d-6c9c1a4a5331",
                                                "text": "They are misguided by misinformation, and talking the Undisputed Truth is a physical means of weaning these little lambies from their childish and sheep like behaviour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e3269cc-a48b-4be0-a9d4-2a79a5c20446",
                        "source_entry_id": "2df96a17-e11b-3d0c-adf2-1fe484a01bd2",
                        "source_sense_id": "e0f616d3-63e0-3f06-9cb6-9613311cc863",
                        "source_sense_description": "Diminutiv von Lamm: kleines Lamm",
                        "target_lang_word": "lamby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4110a30-01d1-3aa9-a4d1-a655da1a60da",
                                        "entry_id": "911d2bda-c690-3ee1-8843-0c2135f5860b",
                                        "glosses": [
                                            "Resembling or characteristic of a lamb or the meat of a lamb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c21d8aaa-82f3-4fd0-9d37-270c8fd283d9",
                                                "sense_id": "e4110a30-01d1-3aa9-a4d1-a655da1a60da",
                                                "text": "We try to avoid a lamby or \"woolly\" flavor."
                                            },
                                            {
                                                "example_id": "a8f53f5d-5611-4d94-99a7-e323a61b76ae",
                                                "sense_id": "e4110a30-01d1-3aa9-a4d1-a655da1a60da",
                                                "text": "The resulting sausages, incorporated into various dishes or grilled on their own, are plump torpedoes of lamby goodness, aggressively and expertly spiced."
                                            },
                                            {
                                                "example_id": "939b6319-6e84-4c9d-8345-52111247da30",
                                                "sense_id": "e4110a30-01d1-3aa9-a4d1-a655da1a60da",
                                                "text": "Méchoui is like a foretaste of paradise, the tenderest and most delicious meat surrounded by the crispest, lambiest skin imaginable."
                                            },
                                            {
                                                "example_id": "ebb8061e-17da-4d3b-81aa-5f77d1fedfe2",
                                                "sense_id": "e4110a30-01d1-3aa9-a4d1-a655da1a60da",
                                                "text": "And not just lamb; we're talkin' mutton, old lamb, which has an even deeper, lambier flavor."
                                            },
                                            {
                                                "example_id": "a222ad89-0396-4815-a93f-9271e68fc89e",
                                                "sense_id": "e4110a30-01d1-3aa9-a4d1-a655da1a60da",
                                                "text": "When I arrived at the house, crying, 'And how are you, my lambiest lamb?' he'd be about to reply, telling me how exhausted he felt from being up all night winding my grandson, when he discovered that I had zoomed past him to speak to the baby."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lamby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                        "entry_id": "1fd295a6-1ae9-3bdf-bc51-f2510e585e6b",
                                        "glosses": [
                                            "Alternative form of lambie."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac29df16-a54a-42d2-a7e8-a72aebd64db3",
                                                "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                                "text": "With a big heavy bucket full of bottles of warm milk, she would call out, “Here, lamby, lamby, lamby.”"
                                            },
                                            {
                                                "example_id": "5de3e612-e054-4498-847a-ecb323ef56dc",
                                                "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                                "text": "\"It's a lamby, Callie! A little baby lamby.\""
                                            },
                                            {
                                                "example_id": "f4d8926b-5583-44b3-a685-54c3d1440a36",
                                                "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                                "text": "Now, if you're thinking being a shepherd means sitting around playing a harp and saying things like, “Here, lamby,” you are mistaken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "22f63c94-6ede-439b-9d2b-8dafbd123cf0",
                        "source_entry_id": "2df96a17-e11b-3d0c-adf2-1fe484a01bd2",
                        "source_sense_ids": [
