                        "glosses": [
                            "Cachot très profond dans une prison."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "2e285298-2bf3-48a0-818d-dab832f4682d",
                                "sense_id": "f7911a39-2f54-31ad-8ef6-e04131c45fe1",
                                "text": "Ils prirent Jérémie, et ils le jetèrent dans la basse-fosse de Melchias qui était dans le vestibule de la prison."
                            },
                            {
                                "example_id": "1f96a2ac-1666-4481-aee3-3ff7c9ae9ac7",
                                "sense_id": "f7911a39-2f54-31ad-8ef6-e04131c45fe1",
                                "text": "Quant à Merlin, il fut mis tout coffré qu'il était, dans la basse-fosse. Et le roi fit un édit portant : Celui qui déprisonnera Merlin je le ferai mourir."
                            }
                        ]
                    }
