                "translations": [
                    {
                        "translation_id": "c9d8b9d3-b37a-44a7-8d6c-3026c54d7d1e",
                        "source_entry_id": "0074259b-5e93-345f-938a-f1f3159efe42",
                        "source_sense_id": "9bfdd012-52f6-3e37-b9fe-c3827b18af71",
                        "source_sense_description": "koeterwaals",
                        "target_lang_word": "Kauderwelsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kauderwelsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                        "entry_id": "7bbf4698-8968-37d2-8f1f-1d8f074d36b4",
                                        "glosses": [
                                            "schwer- oder unverständliche Sprache; aus Elementen verschiedener Sprachen gemischte Ausdrucksweise, fehlerhafte Ausdrucksweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e05eeb-adfc-4c59-830c-8d8908adf1ec",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Sein Kauderwelsch aus Spanisch und Deutsch war kaum verständlich."
                                            },
                                            {
                                                "example_id": "03da9ff9-2d2d-4500-99e2-f49e12229b0d",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Man kann einen Satz, in dem Wörter oder grammatische Strukturen unterschiedlicher sprachlicher Herkunft gemischt werden, als Kauderwelsch bezeichnen."
                                            },
                                            {
                                                "example_id": "1370db05-c8d6-4361-ad1b-1fa36ac5e1df",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Auch eine unverständliche Ausdrucksweise kann als Kauderwelsch bezeichnet werden."
                                            },
                                            {
                                                "example_id": "455e2124-bc05-4ea0-a051-6311b023ae7e",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Auf Fremde wirkt der Hamburger manchmal leicht befremdlich, weil er ein nicht leicht verständliches Kauderwelsch, das Hamborger Platt, als Verständigungsmittel einsetzt."
                                            },
                                            {
                                                "example_id": "2c3282df-4437-46eb-9d54-b423a7db36a2",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Der Linguist [Reiner Pogarell] hat beobachtet, dass das Aufbegehren gegen Denglisch-Kauderwelsch in Firmen stärker wird […]"
                                            },
                                            {
                                                "example_id": "a91c9376-2258-4ede-a4ac-36ab77d5517a",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Wir haben .. wiederholt auf das zähe westliche Vorurteil bei Jud und Christ hingewiesen, wonach Jiddisch nichts anderes sei als ein Jargon, ein verdorbenes, mit fremden Brocken anorganisch durchwürfeltes Deutsch, ein Kauderwelsch.“"
                                            },
                                            {
                                                "example_id": "8cc5b731-89f5-45ff-9805-0849d5e97e6a",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Für das, was er für Englisch hielt, hätte es ohnehin eines Dolmetschers bedurft, es handelte sich um ein Kauderwelsch aus Schwäbisch und Globalesisch."
                                            },
                                            {
                                                "example_id": "69586255-3a16-4259-a723-e550e00ddf00",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Und wenn Eltern eine Sprache vermitteln wollen, die sie selbst nur mangelhaft beherrschen, kommt dabei oft eher ein Kauderwelsch heraus.“"
                                            },
                                            {
                                                "example_id": "29149c2f-06f7-4d3e-823c-e9e3f2bd532f",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Wir besaßen jeder nicht weniger als dreißigtausend Fuß in den »reichsten Gruben der Erde«, wie es im wilden Kauderwelsch der Minensprache hieß - und hatten Schulden beim Metzger.“"
                                            },
                                            {
                                                "example_id": "35879291-482c-46e0-b036-78cd148b270d",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Soll man nun beim Jiddisch des Ostens nach wie vor von Mischsprache oder Kauderwelsch sprechen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba72ece2-3eb7-41e6-878d-c886a36c857d",
                        "source_entry_id": "0074259b-5e93-345f-938a-f1f3159efe42",
                        "source_sense_id": "e9cd692b-f42b-3c6a-b931-7730219203c7",
                        "source_sense_description": "vaktaal, taalgebruik binnen een bepaalde groep, vaak moeilijk te volgen voor een buitenstaander",
                        "target_lang_word": "Fachsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                        "entry_id": "a7a6ab2e-9d0d-3015-8458-ee481aed9df8",
                                        "glosses": [
                                            "die für ein bestimmtes Fach spezifischen Sprachformen und Begriffe"
                                        ],
                                        "tags": [
                                            "Soziolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57612a23-8fb8-4ea1-bfe3-9dded9a409f1",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "Das Wichtigste an Fachsprachen ist ihr Fachwortschatz, also die Gesamtheit der Fachwörter."
                                            },
                                            {
                                                "example_id": "e05a97c0-a7a2-4385-ad2c-30793db612c3",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Zu letzteren gehören beispielsweise solche nach Berücksichtigung der gesprochenen Sprache sowie von Szene- oder bestimmten Fachsprachen.“"
                                            },
                                            {
                                                "example_id": "26db6ba6-31bf-469b-8017-89b732e1b778",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Aber auch in der Alltagssprache der Menschen in beiden Staaten wie in den Fachsprachen gab es die eine oder andere Unterschiedlichkeit.“"
                                            },
                                            {
                                                "example_id": "c35aa0b2-aa37-448b-a6a1-bf7ac1401c49",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Nicht nur die Anschauungen über Erotik, Sexualität und Pornographie waren und sind einem ständigen Wandel unterworfen, sondern auch die auf sie referierenden »Wörter der Lust« - in der Gemeinsprache, in der Fachsprache, in der Sondersprache, in der Regionalsprache und in den Dialekten.“"
                                            },
                                            {
                                                "example_id": "ecd124b8-4532-4309-af5e-3498af012a73",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Es handelt sich um terminologisierte Wörter, die einen wesentlichen Bestandteil der Fachsprachen ausmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                        "entry_id": "a7a6ab2e-9d0d-3015-8458-ee481aed9df8",
                                        "glosses": [
                                            "alle in einem bestimmten Fach verwendeten Sprachformen und Begriffe"
                                        ],
                                        "tags": [
                                            "Soziolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13884fba-c660-4ba8-8f86-ad21dc4ee34d",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "Das Wichtigste an Fachsprachen ist ihr Fachwortschatz, also die Gesamtheit der Fachwörter."
                                            },
                                            {
                                                "example_id": "dadaa370-8651-4bb8-aff1-349d18c8bd04",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "„Zu letzteren gehören beispielsweise solche nach Berücksichtigung der gesprochenen Sprache sowie von Szene- oder bestimmten Fachsprachen.“"
                                            },
                                            {
                                                "example_id": "b0c97351-6086-479e-beb3-737d40e0e54c",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "„Aber auch in der Alltagssprache der Menschen in beiden Staaten wie in den Fachsprachen gab es die eine oder andere Unterschiedlichkeit.“"
                                            },
                                            {
                                                "example_id": "665b660f-0311-4c5f-a200-65f6afd09127",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "Fachsprache wird nach den Ebenen der Kommunikation eingeteilt in „»wissenschaftliche Fachsprache« (Wissenschaftssprache/Theoriesprache), »Werkstattsprache« (Betriebssprache, Produktionssprache) und »Verkäufersprache« (Verkaufssprache, Verteilersprache) […]“"
                                            },
                                            {
                                                "example_id": "3b292e9c-9235-4f85-958b-c67c9daed85a",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "„Die meisten Fachsprachen sind regional beschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f013251d-0363-44c8-9d43-1cda82329ffd",
                        "source_entry_id": "0074259b-5e93-345f-938a-f1f3159efe42",
                        "source_sense_id": "e9cd692b-f42b-3c6a-b931-7730219203c7",
                        "source_sense_description": "vaktaal, taalgebruik binnen een bepaalde groep, vaak moeilijk te volgen voor een buitenstaander",
                        "target_lang_word": "Jargon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jargon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94abc1fd-6cce-3fa1-a243-a09c48253a6a",
                                        "entry_id": "3afd2ea9-3f6e-3c81-be11-862bf3e455c2",
                                        "glosses": [
                                            "Art und Weise des Sich-Ausdrückens bestimmter sozialer, beruflicher oder ähnlicher Gesellschaftskreise innerhalb einer Sprache"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6ecf252-da5a-4acb-8dfb-14e491726e27",
                                                "sense_id": "94abc1fd-6cce-3fa1-a243-a09c48253a6a",
                                                "text": "„Der Begriff Jargon ist der weitaus häufigste pejorative Ausdruck für Gruppensprache.“"
                                            },
                                            {
                                                "example_id": "622061fd-971a-46f5-b6d9-a59c0096137f",
                                                "sense_id": "94abc1fd-6cce-3fa1-a243-a09c48253a6a",
                                                "text": "„Müsst ihr in einem solchen Jargon reden? Ich versteh´ ja kein Wort!“"
                                            },
                                            {
                                                "example_id": "373f87a8-414b-4dc3-81e3-c088cb205f88",
                                                "sense_id": "94abc1fd-6cce-3fa1-a243-a09c48253a6a",
                                                "text": "„Anwälte, Biochemiker, Feuerwehrleute, Jäger, Stadtplaner und Hals-Nasen-Ohren-Ärzte können untereinander gerne in ihrem Jargon reden und schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a8d4802-1c00-3907-9d05-14a4691f8a84",
                                        "entry_id": "3afd2ea9-3f6e-3c81-be11-862bf3e455c2",
                                        "glosses": [
                                            "Ostjiddisch"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fbca2b9-d327-42bb-b5ec-ad279af09272",
                                                "sense_id": "4a8d4802-1c00-3907-9d05-14a4691f8a84",
                                                "text": "„Vor den ersten Versen der ostjüdischen Dichter möchte ich Ihnen, sehr geehrte Damen und Herren, noch sagen, wie viel mehr Jargon Sie verstehen als Sie glauben. […] Der Jargon ist die jüngste europäische Sprache, erst vierhundert Jahre alt und eigentlich noch viel jünger. Er hat noch keine Sprachformen von solcher Deutlichkeit ausgebildet, wie wir sie brauchen. Sein Ausdruck ist kurz und rasch. Er hat keine Grammatiken. Liebhaber versuchen Grammatiken zu schreiben, aber der Jargon wird immerfort gesprochen; er kommt nicht zur Ruhe. Das Volk läßt ihn den Grammatikern nicht. Er besteht nur aus Fremdwörtern. Diese ruhen aber nicht in ihm, sondern behalten die Eile und Lebhaftigkeit, mit der sie genommen wurden. Völkerwanderungen durchlaufen den Jargon von einem Ende bis zum anderen. Alles dieses Deutsche, Hebräische, Französische, Englische, Slawische, Holländische, Rumänische und selbst Lateinische ist innerhalb des Jargon von Neugier und Leichtsinn erfaßt, es gehört schon Kraft dazu, die Sprachen in diesem Zustande zusammenzuhalten. Deshalb denkt auch kein vernünftiger Mensch daran, aus dem Jargon eine Weltsprache zu machen, so nahe dies eigentlich läge. Nur die Gaunersprache entnimmt ihm gern, weil sie weniger sprachliche Zusammenhänge braucht als einzelne Worte. Dann, weil der Jargon doch lange eine mißachtete Sprache war.“ _(Franz Kafka, Rede über die Jiddische Sprache, 1912)"
                                            },
                                            {
                                                "example_id": "86e660c0-97d3-4426-9f0f-7d929cd2e23f",
                                                "sense_id": "4a8d4802-1c00-3907-9d05-14a4691f8a84",
                                                "text": "„Die historischen Bezeichnungen“ für die Sprache der Juden waren „in christlichen Quellen seit dem 19. Jahrhundert oft abwertend Hebräisch-Deutsch, Jüdisch-Deutsch, Judendeutsch, im 18. Jahrhundert Jargon (was im Ostjiddisch des späteren 19. Jahrhunderts zeitweilig zum allgemeinen Namen dieser Sprache wurde).“"
                                            },
                                            {
                                                "example_id": "ee39b40b-a663-45a4-9558-5e211eb842de",
                                                "sense_id": "4a8d4802-1c00-3907-9d05-14a4691f8a84",
                                                "text": "„Mit der Angst des Unbewussten vor dem Zensor meint Freund natürlich weit mehr als die Angst vor dem Jargon, die Kafka auf den Gesichtern der deutschsprachigen Juden erkennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfe71b92-8cd4-3d8b-8f2a-80d6a7d457c3",
                                        "entry_id": "3afd2ea9-3f6e-3c81-be11-862bf3e455c2",
                                        "glosses": [
                                            "heller Zirkon"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce367e1-abb7-4bbd-8e30-68d8ea39ce1a",
                                                "sense_id": "cfe71b92-8cd4-3d8b-8f2a-80d6a7d457c3",
                                                "text": "Die Brosche zierte ein Jargon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
