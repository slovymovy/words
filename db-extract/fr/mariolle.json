                        "examples": [
                            {
                                "example_id": "55dfd3e7-4467-4e28-bfaf-8578f9540910",
                                "sense_id": "5c6b7f0d-1a09-3cf1-8bed-6d7b604a8d14",
                                "text": "Émouvants, les visages défaits de ceux que l’on croise aux petites heures : le fêtard, le soûlard, la fille perdue, la petite frappe, le désemparé, le déviant, le mariolle qui a perdu sa faconde, le veilleur de nuit qui va dormir… Figures de la nuit, ombres portées de nous-mêmes."
                            },
                            {
                                "example_id": "d168be28-0a6a-4188-9479-bbceb71e9cd2",
                                "sense_id": "5c6b7f0d-1a09-3cf1-8bed-6d7b604a8d14",
                                "text": "Penses-tu, disait-il, elle crâne un peu devant le monde, la Tine ! Elle fait sa mariolle, mais je connais les trucs pour la faire filer droit."
                            }
                        ]
                    }
