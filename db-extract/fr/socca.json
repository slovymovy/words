                ],
                "senses": [
                    {
                        "sense_id": "4d5c2740-bc52-32a4-af30-c46b00717563",
                        "entry_id": "4d67e745-9036-3c69-b637-130fa2d45096",
                        "glosses": [
                            "Grande et fine galette de couleur jaune orangé, spécialité culinaire à base de farine de pois chiche, consommée par exemple à Menton et à Nice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7205d7e6-6ccb-4c14-b321-73134e2328b8",
                                "sense_id": "4d5c2740-bc52-32a4-af30-c46b00717563",
                                "text": "Les deux hommes qui approchaient de la quarantaine du même pas, se connaissaient depuis l’époque où, gamins, ils venaient dépenser les quelques sous qu’ils possédaient à acheter des portions de « socca » bien chaude ou un bout de « peissaladière » aux marchandes ambulantes."
                            },
                            {
                                "example_id": "821d0a02-57c4-433e-abf9-5783ad2e2424",
                                "sense_id": "4d5c2740-bc52-32a4-af30-c46b00717563",
                                "text": "Il continua sa marche, pénétrant dans la vieille ville, et entra dans un petit restaurant qui servait de la socca, un plat traditionnel qu'il appréciait."
                            },
                            {
                                "example_id": "9b1fd69c-a661-466c-a4f5-ba6d9333e1b8",
                                "sense_id": "4d5c2740-bc52-32a4-af30-c46b00717563",
                                "text": "Sa mère avait commencé à faire des soccas et des pizzas et son mari à les vendre dans les nouveaux quartiers en construction."
                            }
                        ]
                    }
                ],
