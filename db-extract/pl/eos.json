                "entry_id": "2742bc96-165b-3b98-9e08-127b22f934d4",
                "word": "Eos",
                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd4e3f36-38f6-317e-822c-0f3f35d13a9b",
                        "entry_id": "2742bc96-165b-3b98-9e08-127b22f934d4",
                        "glosses": [
                            "bogini i uosobienie zorzy porannej, brzasku oraz świtu, utożsamiana z rzymską Aurorą"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "ecdc15ac-41dc-47aa-a699-969bccb6b9da",
                                "sense_id": "fd4e3f36-38f6-317e-822c-0f3f35d13a9b",
                                "text": "Zanim pojawi się na niebie wóz słońca, znad brzegów Oceanu wyjeżdża na lekkim rydwanie Eos, różanopalca bogini jutrzenki"
                            },
                            {
                                "example_id": "0a8f0f3f-4283-4f1f-9e4a-814baaa39c90",
                                "sense_id": "fd4e3f36-38f6-317e-822c-0f3f35d13a9b",
                                "text": "Różanopalca Eos, bogini jutrzenki, pierwsza rozpraszała mroki nocy"
                            },
                            {
                                "example_id": "18689a35-5a00-49a9-a88e-ee44bc42194f",
                                "sense_id": "fd4e3f36-38f6-317e-822c-0f3f35d13a9b",
                                "text": "Atrybutami Eos były: szata (peplos) szafranowej barwy, wielkie skrzydła u ramion, rydwan, kwiaty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ad452028-e524-3a6f-84da-d2cbf4043cb3",
                        "entry_id": "2742bc96-165b-3b98-9e08-127b22f934d4",
                        "glosses": [
                            "planetoida o numerze katalogowym 221"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7130657-7e73-4350-81bf-f418525e9f67",
                                "sense_id": "ad452028-e524-3a6f-84da-d2cbf4043cb3",
                                "text": "Eos porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
