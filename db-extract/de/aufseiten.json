                        ],
                        "examples": [
                            {
                                "example_id": "fbb7f024-dc3b-45e3-8aa3-2a407ec2a731",
                                "sense_id": "a87bd6a3-f60c-3dd9-a4fa-1a7bbfc99880",
                                "text": "„Den Nachteil aufseiten der Troer hebt Zeus durch gegen Diomedes gerichtete Blitze auf, sodass diese den Graben überqueren können.“"
                            },
                            {
                                "example_id": "6033eaa1-ee4d-491f-b127-f12466bee5f4",
                                "sense_id": "a87bd6a3-f60c-3dd9-a4fa-1a7bbfc99880",
                                "text": "„Vor dem amerikanischen Bürgerkrieg gründeten sie viele zivilgesellschaftliche Vereine, und bis ins frühe 20. Jahrhundert kämpften sie aufseiten der Arbeiterschaft gegen den Laisser-faire-Kapitalismus.“"
                            },
                            {
                                "example_id": "e6067a15-abb9-418c-8a9b-d83dbe38600a",
                                "sense_id": "a87bd6a3-f60c-3dd9-a4fa-1a7bbfc99880",
                                "text": "„Als am 8. Mai 1945 Nazideutschland kapitulierte, kam es auch in Algerien zu Siegesfeiern - hatten doch, wie schon im Ersten Weltkrieg, unzählige algerische Soldaten aufseiten Frankreichs gekämpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
