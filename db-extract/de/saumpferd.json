                "senses": [
                    {
                        "sense_id": "130a0fb9-2d18-30f6-b2b5-8e2690ea95f7",
                        "entry_id": "99ee8670-07a2-37df-9289-157caf1397ba",
                        "glosses": [
                            "Pferd, das zum Tragen von Lasten und Transportgut (in unebenem Gelände) genutzt wird bzw. abgerichtet ist"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "67712609-a1d6-4d11-97a1-ad197b2caf4c",
                                "sense_id": "130a0fb9-2d18-30f6-b2b5-8e2690ea95f7",
                                "text": "„In den ersten Septembertagen zogen die Gäste fort. Ein Saumpferd trug die Staffelei, die fertigen und angefangenen Bilder und die Skizzen des Künstlers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f33f5fb8-a864-4614-b0a8-ff52d76f2ea0",
                        "source_entry_id": "99ee8670-07a2-37df-9289-157caf1397ba",
                        "source_sense_id": "130a0fb9-2d18-30f6-b2b5-8e2690ea95f7",
                        "source_sense_description": "Pferd, das Lasten trägt oder dazu abgerichtet ist",
                        "target_lang_word": "packhorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "packhorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                        "entry_id": "2d8fe8c9-84ca-3d07-9e9b-081e65b67b01",
                                        "glosses": [
                                            "A horse used as a pack animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04401d04-29f8-4285-a371-b74344b8e327",
                                                "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                                "text": "Finally they put him on one of De Soto's packhorses, but even on a packhorse his feet hung down to within a few inches of the ground."
                                            },
                                            {
                                                "example_id": "1ac0f6e3-dd1e-4672-844e-f8c0cc237bb0",
                                                "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                                "text": "Procter had a handsome half-breed girl with him and two splendid elk heads and meat on his packhorses that he was taking to Fort Lincoln for sale."
                                            },
                                            {
                                                "example_id": "488f57d5-f1b1-4228-9808-24bf8fb36d81",
                                                "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                                "text": "While I was destroying my parka, the packhorse that Bob had been leading laid down. So now all our supplies were supine along with the napping packhorse. Looking upon a reclining packhorse while facing a wind-driven rain, wearing a tattered rain parka, with lightning flashing every fifteen seconds followed by thunder so loud my clothes shuddered was not how I had expected the afternoon to unfold. Each time we got the packhorse to his feet he would promptly lie down again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
