                "senses": [
                    {
                        "sense_id": "3171e84f-7d8a-39f0-bd1d-18a9b45f7f00",
                        "entry_id": "f678dc3b-da46-32fa-93f9-6d3e2463f7bc",
                        "glosses": [
                            "niet fel, maar wel langdurig ontevredenheid laten blijken"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "54cf8061-a9b3-4257-b748-1afd54970283",
                                "sense_id": "3171e84f-7d8a-39f0-bd1d-18a9b45f7f00",
                                "text": "'Wilde ik ooit nog een kans maken op een post in een toekomstig kabinet, dan was er maar een koers: niet jennen, niet bouderen en niet samenzweren', zou Heseltine later aan een vriend toevertrouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "06b537dc-e5cf-3f58-a1cd-684a3f4cc839",
                        "entry_id": "f678dc3b-da46-32fa-93f9-6d3e2463f7bc",
                        "glosses": [
                            "mokkend benaderen, pruilen tegen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cd663bd4-7782-4cf9-831a-01aaa6fd51bb",
                                "sense_id": "06b537dc-e5cf-3f58-a1cd-684a3f4cc839",
                                "text": "Kom, wees lief, Alfred, laten we elkaar niet bouderen. Is dat nu de moeite waard? Laat ons liever elkaar goed trachten te begrijpen."
                            }
                        ]
                    }
