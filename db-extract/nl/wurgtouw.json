                    {
                        "sense_id": "3442bc38-7729-3a52-bfff-549486e6038d",
                        "entry_id": "1335bdcd-00ce-31c3-94e8-5decb68b453f",
                        "glosses": [
                            "een koord waarmee men iemand kan verstikken door het om zijn hals aan te trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c8a2805-b9b2-43f9-8cd2-b5d7019a40c2",
                                "sense_id": "3442bc38-7729-3a52-bfff-549486e6038d",
                                "text": "In het spel vermoordt de speler iedereen die hij tegenkomt. Hij maakt daarbij onder meer gebruik van glasscherven, wurgtouw, plastic zakken en kapmessen. „Je moet bij dit spel op z’n minst berusten in moord, er mogelijk enige tolerantie voor opbouwen of er zelfs van gaan genieten”, zei Hastings."
                            },
                            {
                                "example_id": "cf7aa2ed-53cb-412e-826e-4133275f9142",
                                "sense_id": "3442bc38-7729-3a52-bfff-549486e6038d",
                                "text": "Sekkaki had een gevlochten touw bij zich, dat als wurgtouw dienst had kunnen doen."
                            },
                            {
                                "example_id": "52fa84cc-461f-403b-9c55-d9097abd2a01",
                                "sense_id": "3442bc38-7729-3a52-bfff-549486e6038d",
                                "text": "In hypergestileerde geweldsballetten laat hitman Rupert Friend (uit Homeland) zien hoe met handen, een mes, wurgtouw, spijkerpistool, grijpmachine en een vliegtuigmotor een tegenstander kan worden uitgeschakeld."
                            }
                        ]
                    }
