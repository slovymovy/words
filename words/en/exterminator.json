{
    "word_family": [
        "exterminate",
        "extermination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbe31b8c-bf85-323c-a81c-4c193c610098",
                    "sense_definition": "A professional who removes or kills pests like insects or rodents from buildings.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pest_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We called the <w>exterminator</w> to deal with the ants in our kitchen.",
                            "target_lang_translations": {
                                "cs": "Zavolali jsme <w>deratizátora</w>, aby se vypořádal s mravenci v naší kuchyni."
                            }
                        },
                        {
                            "text": "The <w>exterminator</w> sprayed the basement to prevent spiders from returning.",
                            "target_lang_translations": {
                                "cs": "<w>Dezinsektor</w> vystříkal sklep, aby zabránil návratu pavouků."
                            }
                        }
                    ],
                    "synonyms": [
                        "pest-control worker"
                    ],
                    "common_phrases": [
                        "call an exterminator"
                    ],
                    "target_lang_definitions": {
                        "cs": "Odborník, který odstraňuje nebo hubí škůdce, jako je hmyz nebo hlodavci, v budovách."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "deratizátor",
                                "target_lang_sense_clarification": "odborník na hubení hlodavců"
                            },
                            {
                                "target_lang_word": "dezinsektor",
                                "target_lang_sense_clarification": "odborník na hubení hmyzu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deedb356-26bc-3c2e-a122-a15bcb0f58c6",
                    "sense_definition": "A person or thing that destroys or eliminates something completely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pest_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new chemical acts as an effective <w>exterminator</w> for invasive weeds.",
                            "target_lang_translations": {
                                "cs": "Tato nová chemikálie působí jako účinný <w>likvidátor</w> invazivních plevelů."
                            }
                        },
                        {
                            "text": "In science fiction, the robot was designed as an <w>exterminator</w> of all alien life.",
                            "target_lang_translations": {
                                "cs": "Ve sci-fi byl robot navržen jako <w>hubitel</w> veškerého mimozemského života."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroyer",
                        "eliminator"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba nebo věc, která něco zcela ničí nebo eliminuje."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "likvidátor",
                                "target_lang_sense_clarification": "kdo nebo co něco odstraňuje či ničí"
                            },
                            {
                                "target_lang_word": "hubitel",
                                "target_lang_sense_clarification": "kdo nebo co hubí (často v přeneseném smyslu)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}