{
    "word_family": [
        "gieren",
        "gegier"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d7c96580-5190-3840-a188-dabf5c99e984",
                    "sense_definition": "Een scherp, schel of piepend geluid makend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto vertrok met <w>gierende</w> banden uit de straat.",
                            "target_lang_translations": {
                                "fr": "La voiture a quitté la rue avec des pneus <w>crissants</w>."
                            }
                        },
                        {
                            "text": "Buiten waaide een <w>gierende</w> storm die de takken deed breken.",
                            "target_lang_translations": {
                                "fr": "Dehors soufflait une tempête <w>hurlante</w> qui brisait les branches."
                            }
                        }
                    ],
                    "synonyms": [
                        "krijsend",
                        "piepend"
                    ],
                    "common_phrases": [
                        "gierende banden",
                        "gierende wind"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui produit un son strident, aigu ou grinçant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "crissant",
                                "target_lang_sense_clarification": "pour des pneus, freins ou frottements"
                            },
                            {
                                "target_lang_word": "hurlant",
                                "target_lang_sense_clarification": "pour le vent ou une tempête"
                            },
                            {
                                "target_lang_word": "strident",
                                "target_lang_sense_clarification": "son aigu et perçant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0be70d5-73b7-362d-aed6-2de28fc59554",
                    "sense_definition": "Zeer luid en onbeheerst lachend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zaal lag <w>gierend</w> van het lachen op de grond na die grap.",
                            "target_lang_translations": {
                                "fr": "La salle était <w>pliée</w> de rire par terre après cette blague."
                            }
                        },
                        {
                            "text": "Het publiek luisterde naar de cabaretier en barstte in een <w>gierend</w> applaus uit.",
                            "target_lang_translations": {
                                "fr": "Le public écoutait le comédien et a éclaté en un tonnerre d'applaudissements <w>délirants</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaterend"
                    ],
                    "common_phrases": [
                        "gierend van het lachen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Riant de manière très bruyante, incontrôlable ou aux éclats."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "écroulé de rire",
                                "target_lang_sense_clarification": "fou de rire"
                            },
                            {
                                "target_lang_word": "hilarant",
                                "target_lang_sense_clarification": "qui rit aux éclats"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d71ace5f-e35d-3f79-977e-2fa191e2b8b7",
                    "sense_definition": "Onvoltooid deelwoord van <w>gieren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind kwam <w>gierend</w> langs de hoge toren razen.",
                            "target_lang_translations": {
                                "fr": "Le vent s'est mis à souffler avec fracas <w>en hurlant</w> le long de la haute tour."
                            }
                        },
                        {
                            "text": "Zij renden <w>gierend</w> door de gangen van de school.",
                            "target_lang_translations": {
                                "fr": "Ils couraient <w>en glapissant</w> dans les couloirs de l'école."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent du verbe 'gieren' (hurler, tournoyer, crisser)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "en hurlant",
                                "target_lang_sense_clarification": "vent, cris perçants"
                            },
                            {
                                "target_lang_word": "en crissant",
                                "target_lang_sense_clarification": "bruit de pneus ou de friction"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}