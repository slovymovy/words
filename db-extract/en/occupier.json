                                        "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                        "entry_id": "d4076bd8-3a3e-3749-95b2-05653e957b0e",
                                        "glosses": [
                                            "iemand die bezet, meer in het bijzonder de bezetter van een overwonnen natie in oorlogstijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "890870ce-ee13-46db-ae6f-41b204789da4",
                                                "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                                "text": "De bezetter was bezig het veel te nationalistische Nationaal Front buiten spel te zetten."
                                            },
                                            {
                                                "example_id": "e64c9658-3657-4ef0-8452-15759d01322d",
                                                "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                                "text": "Volgens de overlevering vluchtten meisjes uit Plancher-Les-Mines gedurende de Dertigjarige Oorlog (1618-1648) de bossen in om te ontkomen aan bloeddorstige huurlingen in dienst van de Zweedse bezetter."
                                            },
                                            {
                                                "example_id": "738df002-78b8-49ca-9404-beab9cd292b3",
                                                "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                                "text": "Hendrikx zag in 1940 als 16-jarige jongen hoe de Duitse bezetters zijn dorp binnenmarcheerden. Hij vluchtte naar Canada, kreeg een militaire training en vertrok in 1942 naar Engeland om jachtvlieger op de Spitfire te worden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bezetter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
