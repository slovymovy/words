                    },
                    {
                        "translation_id": "1ddfc200-3949-40bb-bd2f-55f74c70286f",
                        "source_entry_id": "6895a946-6e1a-36bb-9953-5d0bd5de8672",
                        "source_sense_id": "bd629762-3758-3296-b71c-e6308a35608c",
                        "target_lang_word": "vorstellbar",
                        "target_lang_code": "de",
