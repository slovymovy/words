                    },
                    {
                        "form_id": "9bb31830-3bf1-443b-8bbb-2d30ae495bd8",
                        "entry_id": "6b4f8a11-5105-353b-9777-af2c18d3684c",
                        "tags": [
                            "rare"
                        ],
                        "form": "pythonesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5a9ea06-95a8-3cd1-922c-bf5e751a135c",
                        "entry_id": "6b4f8a11-5105-353b-9777-af2c18d3684c",
                        "glosses": [
                            "Pythie de Delphes."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e1692833-d144-4b10-9b12-c4cfbbccc578",
                                "sense_id": "a5a9ea06-95a8-3cd1-922c-bf5e751a135c",
                                "text": "La pythonisse d’Endor."
                            },
                            {
                                "example_id": "8c355a6e-6e76-4eff-a3f0-bff9ca91a7b1",
                                "sense_id": "a5a9ea06-95a8-3cd1-922c-bf5e751a135c",
                                "text": "Saül consulta la pythonisse."
                            },
                            {
                                "example_id": "7cf7849d-6384-4e90-86d9-07f5c44ab46e",
                                "sense_id": "a5a9ea06-95a8-3cd1-922c-bf5e751a135c",
                                "text": "« Ceci, mes amis, s’écria-t-il, est l’invocation de Saül à la pythonisse ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "fb30cb6c-98ef-35f5-ad58-4afe8f895dc6",
                        "entry_id": "6b4f8a11-5105-353b-9777-af2c18d3684c",
                        "glosses": [
                            "Toute femme qui fait métier de prédire l’avenir."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "12d343c1-e817-4046-a7e3-e67ade8063f6",
                                "sense_id": "fb30cb6c-98ef-35f5-ad58-4afe8f895dc6",
                                "text": "Elle est allée consulter une pythonisse."
                            },
                            {
                                "example_id": "a33d0ff3-a4a7-4cbc-aee1-711300d3e598",
                                "sense_id": "fb30cb6c-98ef-35f5-ad58-4afe8f895dc6",
                                "text": "Elles comptent et ajustent les pétales des pâquerettes qui doivent servir d’oracles aux jeunes filles. Celle-ci, douce et bienveillante, a soin que ces petits rayons d’argent, qui entourent le disque d’or de la marguerite, atteignent et ne dépassent pas le nombre de quatorze, de dix-neuf, de vingt-quatre ou de vingt-neuf, afin que la pythonisse des prairies, à la question « m’aime-t-il ? » réponde toujours « passionnément. »"
                            },
                            {
                                "example_id": "3293d3d5-615d-4785-8ff9-fb9c61de3da6",
                                "sense_id": "fb30cb6c-98ef-35f5-ad58-4afe8f895dc6",
                                "text": "Sa figure ressemblait à celles que nous supposons aux pythonisses, elle serrait ses dents pour les empêcher de claquer, et une affreuse convulsion faisait trembler ses membres."
                            },
                            {
                                "example_id": "9becaed5-e85c-4dc5-b404-013a2922948e",
                                "sense_id": "fb30cb6c-98ef-35f5-ad58-4afe8f895dc6",
                                "text": "Une ouvreuse […] vous offre un programme qui est une merveille d’art tout à la fois spiritualiste et positiviste : Indien qui maquille les cartes, dame qui s’intitule chiromancienne et graphologue, magnétiseur, somnambules, pythonisses au marc de café."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2db6317e-6beb-4583-b9f7-96df17eb10f1",
                        "source_entry_id": "6b4f8a11-5105-353b-9777-af2c18d3684c",
                        "target_lang_word": "Wahrsagerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrsagerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                        "entry_id": "f7799cf1-4e51-3516-9bd0-b4b7d72af9e6",
                                        "glosses": [
                                            "jemand, der versucht, die Zukunft vorherzusagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb4e669-ac70-46d5-bbfe-1fcd0d807ced",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "Auf die Prophezeiungen von Wahrsagerinnen kann man sich nicht verlassen."
                                            },
                                            {
                                                "example_id": "8a276318-c86d-40ee-b0d1-394804af02aa",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Nachdenklich zieht er sein Portemonnaie hervor, nimmt zwei Zehnpfennigstücke heraus und zieht an einem grünen Automaten neben dem der Wahrsagerin eine Packung Pfefferminz.“"
                                            },
                                            {
                                                "example_id": "00178ae2-c7a5-438a-b50f-dea368cf7af8",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Tante Fatma sei die beste Wahrsagerin jenseits des Bosporus, sagte meine Schwester.“"
                                            },
                                            {
                                                "example_id": "f59771d0-d611-40f4-a07e-84c33c8fd6f6",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„Denn die Wahrsagerin ist noch beschäftigt, oder sie braucht Zeit zur Meditation und zur Einstimmung auf den Gast.“"
                                            },
                                            {
                                                "example_id": "75e79e6c-cea9-4f29-a31b-653fbc087053",
                                                "sense_id": "0c026186-008b-30ae-a854-513b68128df8",
                                                "text": "„In seiner Kindheit wurde Freud von einer Wahrsagerin vorausgesagt, er würde Minister werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a6d9129-1a1d-4fa1-926b-37ef899fca1b",
                        "source_entry_id": "6b4f8a11-5105-353b-9777-af2c18d3684c",
                        "target_lang_word": "Kartenleserin",
