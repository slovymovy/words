                        "translation_id": "8f95273c-f325-43d1-921b-a0403ccc118e",
                        "source_entry_id": "c5fd28f1-73b5-392f-8b5a-07ecb1c8f6d5",
                        "source_sense_id": "4f85f0b7-6f4a-3532-b5cb-9d9fee9dc6f6",
                        "source_sense_description": "voor het grootste gedeelte",
                        "target_lang_word": "for the most part",
