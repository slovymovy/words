                        "entry_id": "6405a47f-0007-3bae-ba29-cae796516e9f",
                        "glosses": [
                            "Dans le nazisme, « race » considérée comme inférieure."
                        ],
                        "tags": [
                            "Nazism",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "9bcfd5a1-4692-442d-bbb9-e8efc7fcc679",
                                "sense_id": "c1401270-4da8-3ddf-adcd-71b32708bbfe",
                                "text": "Comme si le consommateur était quelqu’un d’une autre race – un « untermensch »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd003d1f-c26c-4220-904c-8f15111f65ad",
                        "source_entry_id": "6405a47f-0007-3bae-ba29-cae796516e9f",
