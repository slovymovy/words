                ],
                "senses": [
                    {
                        "sense_id": "7b9cdcb1-a2be-36d5-a125-f0c91686720f",
                        "entry_id": "03231807-5f63-31b8-ac0f-3441b53191ad",
                        "glosses": [
                            "Qualifie les guerres stupides opposant Picrochole à Grandgousier et à Gargantua pour quelques galettes de froment dans Gargantua de Rabelais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0b2688-e7bd-44c2-a986-134f25197004",
                                "sense_id": "7b9cdcb1-a2be-36d5-a125-f0c91686720f",
                                "text": "Les fouaciers, rentrés à Lerné, immédiatement, sans prendre le temps de boire ni de manger, se transportèrent au Capitole et là, devant leur roi nommé Picrochole troisième du nom, exposèrent leurs doléances en montrant leurs paniers crevés, leurs bonnets enfoncés, leurs habits déchirés, leurs fouaces pillées et surtout Marquet énormément blessé."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a7942c1-8897-3b60-83bf-d2f35e3b09a2",
                        "entry_id": "03231807-5f63-31b8-ac0f-3441b53191ad",
                        "glosses": [
                            "Qualifie un conflit entre des institutions ou des individus, aux péripéties souvent burlesques et dont le motif apparaît obscur ou insignifiant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d8f3e387-16a9-4ce7-af17-9e45bd03bf05",
                                "sense_id": "9a7942c1-8897-3b60-83bf-d2f35e3b09a2",
                                "text": "Ces conflits picrocholins ne facilitaient pas la rénovation nécessaire des juridictions commerciales."
                            },
                            {
                                "example_id": "be5ba120-ea9d-4b56-8de3-90fd488cd181",
                                "sense_id": "9a7942c1-8897-3b60-83bf-d2f35e3b09a2",
                                "text": "Jacques Chirac et Édouard Balladur s’affrontent dans une querelle sur le chiffrage de leurs programmes qui prend des allures de guerre picrocholine, entre Petitboutiens et Grosboutiens."
                            },
                            {
                                "example_id": "ecc3b47b-58b6-4ddf-a53f-b05ba5c339d6",
                                "sense_id": "9a7942c1-8897-3b60-83bf-d2f35e3b09a2",
                                "text": "Nous sommes les rois des luttes intestines et des guerres picrocholines. Notre histoire, c’est Florence contre Pise, Pise contre Livourne, Venise contre Milan…"
                            },
                            {
                                "example_id": "2d5bde53-b8be-4869-837c-2ba4112db460",
                                "sense_id": "9a7942c1-8897-3b60-83bf-d2f35e3b09a2",
                                "text": "Et donc il y a là un effort que nous devons produire pour ne pas retomber dans nos débats picrocholins et rester à la hauteur de l'événement."
                            }
                        ]
                    }
                ],
