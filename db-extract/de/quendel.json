                        ],
                        "form": "die Quendel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                        "entry_id": "d0b3d100-9d7d-306f-9847-dfdb655fb097",
                        "glosses": [
                            "wilder Thymian"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62b40df-685b-471c-b202-f232ae96823e",
                                "sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                                "text": "„Aber die unzähligen Mulden verströmten ihrerseits einen Duft von Heidekraut und glühendem Quendel.“"
                            },
                            {
                                "example_id": "63cdd71a-e153-46b9-96fb-4df3e7091e2d",
                                "sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                                "text": "„Der Gartenthymian, der ursprünglich aus Südeuropa kommt, darf nicht mit dem einheimischen Wildthymian oder Quendel (T. serpyllum) verwechselt werden, dessen Blätter breiter sind.“"
                            },
                            {
                                "example_id": "5d23f295-85fa-45e3-ae6e-40fa70800475",
                                "sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                                "text": "„Und der Quendel gedieh so herb wie nirgends sonst nahe der Alm, wo er im Frühjahr von zahllosen Hufen niedergetrampelt wurde.“"
                            },
                            {
                                "example_id": "ae2b48ac-4fc7-45ef-8d85-7947377679e8",
                                "sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                                "text": "„Eines Tages entdeckte Harbert in einer feuchten Niederung ganze Stauden von aromatischen Kräutern, Thymian, Quendel, Basilikum, Pfefferkraut und viele andere Lippenblütler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d871f2a7-e237-4a66-8904-cc3d6cb88c1a",
                        "source_entry_id": "d0b3d100-9d7d-306f-9847-dfdb655fb097",
                        "source_sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                        "target_lang_word": "serpolet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serpolet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5550c9cc-2ef8-3b04-ad04-4e8a7a868bd9",
                                        "entry_id": "f77cb2ed-e79d-3c03-ab4f-09fd11a8ab84",
                                        "glosses": [
                                            "Nom usuel de Thymus serpyllum, plante annuelle, odoriférante, aromatique, à fleurs labiées, de la famille des Lamiaceae, qui pousse dans les lieux secs, les garrigues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efd9ee9-0f6e-4f5a-9425-2d658a2ecff7",
                                                "sense_id": "5550c9cc-2ef8-3b04-ad04-4e8a7a868bd9",
                                                "text": "Le serpolet y forme de larges plaques d’un vert foncé qu’émaillent ses petites touffes de fleurs purpurines."
                                            },
                                            {
                                                "example_id": "c856c271-e428-4183-b7fc-46714f3be647",
                                                "sense_id": "5550c9cc-2ef8-3b04-ad04-4e8a7a868bd9",
                                                "text": "Les odeurs forestières, senteurs adorées par les âmes friandes de poésie à qui plaisent les mousses les plus innocentes, les cryptogames les plus vénéneux, les terres mouillées, les saules, les baumes, le serpolet, les eaux vertes d’une mare, l’étoile arrondie des nénuphars jaunes ; toutes ces vigoureuses fécondations se livrent à vos narines en vous livrant toute une pensée, leur âme peut-être."
                                            },
                                            {
                                                "example_id": "0dd06115-3022-4a8e-90f0-b47a2a131f81",
                                                "sense_id": "5550c9cc-2ef8-3b04-ad04-4e8a7a868bd9",
                                                "text": "Vous dormez chaque nuit sur la terre dure ou sur des planches ; l’herbe qui est ici est meilleure et sent bon comme le serpolet."
                                            },
                                            {
                                                "example_id": "bae36de2-5cb4-4d04-bb27-157710790192",
                                                "sense_id": "5550c9cc-2ef8-3b04-ad04-4e8a7a868bd9",
                                                "text": "Anselme, qui menait chaque matin, à petits pas, trois ou quatre douzaines de moutons paître le chiendent et le serpolet sur les premières pentes des collines, pouvait bien compter soixante-dix hivers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f75b3841-1e11-40d1-a0bd-b889dcf140e1",
                        "source_entry_id": "d0b3d100-9d7d-306f-9847-dfdb655fb097",
                        "source_sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                        "target_lang_word": "тимьян",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тимьян",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cef4e476-ebd1-30a6-9604-8759b92302b3",
                                        "entry_id": "42c2c657-7130-39bf-b3a8-ece2ba2b578a",
                                        "glosses": [
                                            "ботан. душистое кустарничковое или полукустарничковое растение семейства Яснотковые, с мелкими цветами, из листьев которого добывается эфирное масло (Thymus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25ce318-fb47-42aa-80e4-c74e280c5875",
                                                "sense_id": "cef4e476-ebd1-30a6-9604-8759b92302b3",
                                                "text": "Травы представлены осокой аргунской, термопсисом, тимьяном, остролодкой, полынью."
                                            },
                                            {
                                                "example_id": "a7d53176-6321-4da5-a18b-4dd616f8d062",
                                                "sense_id": "cef4e476-ebd1-30a6-9604-8759b92302b3",
                                                "text": "Тимьян размножают семенами, черенками и делением куста."
                                            },
                                            {
                                                "example_id": "40b1c90a-30bc-4edf-8689-37fc5a5d43fb",
                                                "sense_id": "cef4e476-ebd1-30a6-9604-8759b92302b3",
                                                "text": "На равнинах, покрытых хорошей травой, попадаются тимьян и в особенности полынь, также цветёт шиповник. ❬…❭ Из растений и кореньев полезны только тимьян и макарша; первый употребляется преимущественно для куренья, а иногда и в пищу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2eeb59-1200-37c4-a61f-ef44c8d57b09",
                                        "entry_id": "42c2c657-7130-39bf-b3a8-ece2ba2b578a",
                                        "glosses": [
                                            "кулин. свежие или сушёные листья тимьяна обыкновенного, использующиеся как пряность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b682da75-253a-4f8a-abc8-66e7e613dca0",
                                                "sense_id": "8d2eeb59-1200-37c4-a61f-ef44c8d57b09",
                                                "text": "Нанизать на вертел куски рыбы, чередуя с креветками и черносливом, сбрызнуть маслом, посыпать тимьяном, посолить, жарить 3—4 минуты, часто поворачивая."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3970708-ac7b-4d33-b099-ba52a243bc0a",
                        "source_entry_id": "d0b3d100-9d7d-306f-9847-dfdb655fb097",
                        "source_sense_id": "e7317561-4102-3cc7-9d93-4f3a10813eea",
                        "target_lang_word": "чабрец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чабрец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "59abc7cb-5eda-3cc7-8738-c89e9179f061",
                                        "entry_id": "b47f4d37-225c-3ae9-9648-4d8408a573b8",
                                        "glosses": [
                                            "то же, что тимьян"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ba7066-a57b-4bf8-ac44-37f82320cca2",
                                                "sense_id": "59abc7cb-5eda-3cc7-8738-c89e9179f061",
                                                "text": "— Воздух, воздух… А вот кому воздуха?.. Прохладный, отрадный, как ручей течёт, холодит, как лёд… Купишь разок — запросишь в другой… Есть и весенний, есть и осенний, из дальних краёв, с Антильских островов… Ясный и синий, пахнет дыней… Воздух, воздух, свежий, солёный… Чистый, душистый… В бутылке с колпачком, надушен чабрецом..Всякому на долю, и всласть и вволю, сколько хочешь вдохнёшь — и всего-то за грош!"
                                            },
                                            {
                                                "example_id": "916855a9-33fd-4a0b-a5b7-b857a91e2569",
                                                "sense_id": "59abc7cb-5eda-3cc7-8738-c89e9179f061",
                                                "text": "Тимьян ползучий широко известен под названиями богородская трава, чабрец, тимьян душистый."
                                            },
                                            {
                                                "example_id": "0c1104b9-ecc4-4e9d-a5b5-6aa3ab5dff0d",
                                                "sense_id": "59abc7cb-5eda-3cc7-8738-c89e9179f061",
                                                "text": "Чабрец — это низкорослый кустарник, обладающий насыщенным ароматом и вкусом. Ещё его называют тимьяном, однако, это не всегда синонимы. Тимьянов существует несколько видов, но только один из них — тимьян ползучий — именуется чабрецом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
