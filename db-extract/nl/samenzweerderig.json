                        "glosses": [
                            "betrekking hebbend op het maken van een geheime afspraak of een geheim verbond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d376a1-ecd8-4eaa-8b1e-8123aaedf24e",
                                "sense_id": "5c2b72a2-2858-3a15-af90-03b9f06b86dd",
                                "text": "Hij sprak op een zachte, samenzweerderige toon tegen zijn vrienden over het cadeau dat ze de leraar zouden geven."
                            },
                            {
                                "example_id": "372149ee-509b-4b81-80f6-836ee5b53c37",
                                "sense_id": "5c2b72a2-2858-3a15-af90-03b9f06b86dd",
                                "text": "En trouwens, kon Poulette meedelen, ze boog overdreven samenzweerderig naar voren en vormde met haar handen een trechter voor haar mond terwijl ze luid fluisterde dat 'de jodenrekening'feitelijk al was opgemaakt, maar dat de Reichswehr het resultaat geheim had verklaard."
                            }
                        ]
