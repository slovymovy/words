                    }
                ],
                "senses": [
                    {
                        "sense_id": "747c9bb7-1884-3339-8a24-5789efa1fd2c",
                        "entry_id": "65628e39-7e81-3686-9f3b-916f0118c92f",
                        "glosses": [
                            "Calcium (l’élément chimique Ca)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6986da78-5071-4623-8bde-71d45a4a0b97",
                                "sense_id": "747c9bb7-1884-3339-8a24-5789efa1fd2c",
                                "text": "Der Körper braucht Vitamin D, um Kalzium aus der Nahrung aufzunehmen und in den Knochen einlagern zu können.",
                                "translation": "Le corps a besoin de vitamine D pour absorber le calcium de l’alimentation et le stocker dans les os."
                            },
                            {
                                "example_id": "ffadf6b1-9cc2-48ff-9f8b-ea1ec1f96e52",
                                "sense_id": "747c9bb7-1884-3339-8a24-5789efa1fd2c",
                                "text": "In den ersten Monaten geht dieser Zustand oft mit Appetitmangel und häufigem Erbrechen einher (…, der Organismus) wird ärmer an Phosphor, Kalzium und Eisen, wobei vor allem der Eisenmangel in der Folge schwer auszugleichen ist.",
                                "translation": "Elle s’accompagne souvent dans les premiers mois d’un manque d’appétit et de vomissements (…, l’organisme) s’appauvrit en phosphore, en calcium, en fer, ce dernier déficit étant par la suite difficile à combler"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
