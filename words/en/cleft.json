                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river flows through a deep <w>cleft</w> in the mountains.",
                            "target_lang_translations": {
                                "cs": "Řeka protéká hlubokou <w>štěrbinou</w> v horách."
                            }
                        },
                        {
                            "text": "The climber found a small <w>cleft</w> in the rock to place his fingers.",
                            "target_lang_translations": {
                                "cs": "Horolezec našel ve skále malou <w>štěrbinu</w>, do které mohl vsunout prsty."
