                "forms": [],
                "senses": [
                    {
                        "sense_id": "23b9e890-857a-3523-a77f-3ad87dabb486",
                        "entry_id": "a4d1a698-1f58-3606-acf3-98ca24b28684",
                        "glosses": [
                            "Used to indicate that a magic trick or other illusion has been performed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c95b72b-8d1d-4d32-a6a1-16037a6ba5ef",
                                "sense_id": "23b9e890-857a-3523-a77f-3ad87dabb486",
                                "text": "The Tahitian kids had ridden out most of their lives, and they were busy riding in on their surf mats and belly boards. But when they met the out part, shazam!"
                            },
                            {
                                "example_id": "8bad3a42-729c-4437-a838-435f343bef84",
                                "sense_id": "23b9e890-857a-3523-a77f-3ad87dabb486",
                                "text": "My parents lived in the Last Naïf Age: the last ‘good war’, atoms for peace, and parental philosophy that said children should do and say exactly what we do and say, and Shazam! You'll be us."
                            },
                            {
                                "example_id": "96034332-7de6-4c4e-af90-9cfafd0a6ecf",
                                "sense_id": "23b9e890-857a-3523-a77f-3ad87dabb486",
                                "text": "So I brought you down the trail on the sled, put you in my car and, shazam, here we are."
                            }
                        ]
                    }
                ],
