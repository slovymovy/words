                "senses": [
                    {
                        "sense_id": "d96fdd5e-84c9-3853-94cd-e3605e144036",
                        "entry_id": "9102b703-34af-3fef-b48a-1ae9d343c0a3",
                        "glosses": [
                            "de periode dat het toegestaan is om een patiënt in een ziekenhuis of verpleeginrichting te bezoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69107b5-3e2b-4b99-b7f9-b9237ea3ab07",
                                "sense_id": "d96fdd5e-84c9-3853-94cd-e3605e144036",
                                "text": "Bezoekers zorgen voor te veel drukte in de ziekenhuizen omdat ze vaak met te veel mensen komen of de visite niet goed met elkaar afstemmingen. Per patiënt mogen er tijdens een bezoektijd (dagelijks 18-20 uur en in het weekend 13.45-14.30 uur) twee mensen komen, mits ze niet tegelijkertijd aan het bed verschijnen."
                            },
                            {
                                "example_id": "b811a156-f6eb-49eb-856e-a02f66e3240e",
                                "sense_id": "d96fdd5e-84c9-3853-94cd-e3605e144036",
                                "text": "Het was haar namelijk toegestaan om buiten de reguliere bezoektijden naast het bed van Jeroen te zitten."
                            }
                        ]
                    },
                    {
                        "sense_id": "64c6668f-ccfb-32d3-ac56-2ec6fc99c0aa",
                        "entry_id": "9102b703-34af-3fef-b48a-1ae9d343c0a3",
                        "glosses": [
                            "de periode dat het toegestaan is om een inrichting te bezoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c8bec65-a664-494c-b84a-fad7317c6076",
                                "sense_id": "64c6668f-ccfb-32d3-ac56-2ec6fc99c0aa",
                                "text": "Morogeta moest voor zijn douche een uur van kraakpand Kralenbeek 100 in Zuidoost, de Vluchtgarage, naar de Vluchthaven fietsen. Voor tien uur vanavond moet hij maken dat hij wegkomt, want dan is de bezoektijd voorbij en moet hij terugfietsen naar het koude kraakpand, zonder elektra, dat hij met ongeveer vijftig asielzoekers deelt."
                            },
                            {
                                "example_id": "e1ed7ce3-e3fc-4628-8d2d-cc5d30ad613b",
                                "sense_id": "64c6668f-ccfb-32d3-ac56-2ec6fc99c0aa",
                                "text": "Tientallen mensen brachten woensdag en donderdag een bezoek aan het klooster van de zusters karmelietessen in Sittard waar Gijsen ligt opgebaard. Veel mensen belden aan om een kort bezoek te brengen, sommigen bleven tot het einde van de bezoektijd."
                            }
                        ]
                    }
                ],
