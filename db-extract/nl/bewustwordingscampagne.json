                        "examples": [
                            {
                                "example_id": "6570f6b4-cd59-4ec3-844d-da30fc8842c6",
                                "sense_id": "8523a5f8-3d8b-3574-9f60-958fcf835197",
                                "text": "De groei is het resultaat van een bewustwordingscampagne die jongeren aanzet om hun gehoor te beschermen. Als deejays van 3FM het doen, dan is het toch heel gewoon, luidt de boodschap. Bij festivals en in discotheken liggen oordopjes goed zichtbaar te koop en bij voordeeldrogisterijketens liggen ze op de toonbank."
                            },
                            {
                                "example_id": "6802f90b-efad-4e33-aced-5ae6c82a2d59",
                                "sense_id": "8523a5f8-3d8b-3574-9f60-958fcf835197",
                                "text": "Gemeenten binden de strijd aan tegen dit gore gedrag. Met boetes, bewustwordingscampagnes, picknickkleedjes en, jawel, steltlopers. Maar of de gemiddelde parkbezoeker zich wat aantrekt van dit soort praktijken, dat valt te betwijfelen. Vooral in de grootste steden wordt gesproken van een complex probleem."
                            }
                        ]
                    }
