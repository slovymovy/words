                        "examples": [
                            {
                                "example_id": "29ac3f66-7479-4f90-af79-a535940d02b9",
                                "sense_id": "0f96e4d3-9242-3ebc-89a2-cf3fae446f2d",
                                "text": "My baldness was the result of radiotherapy."
                            },
                            {
                                "example_id": "015a60a5-3028-4cba-ba54-59ba79f95f90",
                                "sense_id": "0f96e4d3-9242-3ebc-89a2-cf3fae446f2d",
                                "text": "We turn next to the puzzle of borderlineness: If Harry is intermediate between clear cases and clear noncases of baldness, “Is Harry bald?” seems to have no good, direct, answer."
                            }
                        ]
