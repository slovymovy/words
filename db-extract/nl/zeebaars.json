                    {
                        "translation_id": "dc7e2e87-8e07-451a-b2ce-cbe8b8da7ce8",
                        "source_entry_id": "8676b197-d692-3766-9074-0293c51424cc",
                        "source_sense_id": "d8aca6dd-674a-361c-9094-08b5c3ca3ae8",
                        "source_sense_description": "baarsachtige zeevis, Dicentrarchus labrax",
                        "target_lang_word": "bar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "634d3156-9a4f-31d5-b94d-bfa589284d23",
                                        "entry_id": "c8e1a535-06d3-3a2f-85c0-ad2cd1bc3b87",
                                        "glosses": [
                                            "Comptoir où se servent les boissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedde34c-2ce8-4389-910b-41c9d65179db",
                                                "sense_id": "634d3156-9a4f-31d5-b94d-bfa589284d23",
                                                "text": "Un bar en acajou."
                                            },
                                            {
                                                "example_id": "3a9eb1dd-eded-4c98-b1c2-74e7905fa9b0",
                                                "sense_id": "634d3156-9a4f-31d5-b94d-bfa589284d23",
                                                "text": "Ils sont tous les deux accoudés au bar."
                                            },
                                            {
                                                "example_id": "ca5a7f2f-9539-49bf-b993-c91f5a7f020a",
                                                "sense_id": "634d3156-9a4f-31d5-b94d-bfa589284d23",
                                                "text": "Un petit bar qui sert autant pour le service que de caisse, un pâle tapis usé qui semble résister aux aléas de l’hiver, un mur de briques, de petites tables collées et hop!, le tour est joué pour simplement laisser filer le temps et découvrir le charme discret de cette maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8efa4e3-1269-3ca7-ade2-abefc8e0d3ff",
                                        "entry_id": "c8e1a535-06d3-3a2f-85c0-ad2cd1bc3b87",
                                        "glosses": [
                                            "Débit de boissons."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5fdb752-07bf-48af-8bcb-5846b414d766",
                                                "sense_id": "b8efa4e3-1269-3ca7-ade2-abefc8e0d3ff",
                                                "text": "Quel démon vous a mis en tête le tourment de l’Art ? Auriez-vous fait rencontre, dans une brasserie, d’un peintre, d’un esthète, — d’un critique, peut-être (disons le mot) ? Car c’est dans les brasseries, vous le savez, Nane, que se rencontre l’aristocratie de la pensée ; comme, dans les bars, celle de la naissance."
                                            },
                                            {
                                                "example_id": "d33afcb9-f0fd-4bf2-86ae-3640860574b9",
                                                "sense_id": "b8efa4e3-1269-3ca7-ade2-abefc8e0d3ff",
                                                "text": "J’avais pour invité, dans un bar de Montmartre, le chasseur d’une boîte de nuit qui, sous son beau costume, abritait une nature inquiète."
                                            },
                                            {
                                                "example_id": "d4df39eb-d4fa-49ba-9369-aca322802555",
                                                "sense_id": "b8efa4e3-1269-3ca7-ade2-abefc8e0d3ff",
                                                "text": "Au fond d’un bar fallacieusement intitulé La Jeunesse, un phonographe tournait et répandait des gargouillements sonores d’accordéon."
                                            },
                                            {
                                                "example_id": "0ffe2fa4-1a4c-4f71-8ef7-1170ada67098",
                                                "sense_id": "b8efa4e3-1269-3ca7-ade2-abefc8e0d3ff",
                                                "text": "La cigarette est bannie des bars, pubs et restaurants en Irlande, Norvège, Malte, Écosse et à compter de l’été 2007 au Royaume-Uni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c77c856-cb53-395e-8ae0-7da1e032674a",
                                        "entry_id": "c8e1a535-06d3-3a2f-85c0-ad2cd1bc3b87",
                                        "glosses": [
                                            "Commerce spécialisé dans la vente au comptoir d'un produit ou d'un service spécifique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c0c3d8-2278-4d38-b536-a293c767562b",
                                                "sense_id": "4c77c856-cb53-395e-8ae0-7da1e032674a",
                                                "text": "En attendant, Garry Dorr fait encore figure de pionnier français. « En ouvrant mon premier bar à huîtres en 2010, je voulais qu'il soit possible de s'installer au bar, de déguster un verre de blanc et seulement une huître. »"
                                            },
                                            {
                                                "example_id": "79ab9515-d3a0-468e-b559-e9f899d864ca",
                                                "sense_id": "4c77c856-cb53-395e-8ae0-7da1e032674a",
                                                "text": "On connaissait le bar à salades, le bar à huîtres, le bar à ongles… Mais chez Bouygues Telecom, c'est un « bar à prompts » qui vient d'être installé, sur son Technopole de Meudon, en banlieue parisienne. Deux à trois fois par mois, près de la cantine, des ingénieurs de l'opérateur apprennent aux salariés les meilleures façons de dialoguer avec un robot d'intelligence artificielle comme ChatGPT."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c5d228-9af2-3571-9fe6-12f931a0385d",
                                        "entry_id": "0ac88e73-9d0d-3afd-9b32-6e00f1aeacaa",
                                        "glosses": [
                                            "Poisson de mer dont la chair blanche est délicatement parfumée, appartenant aux genres Dicentrarchus ou Morone, variante de loup de mer (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41fa8e3d-c7e7-4934-aab3-86f99d6a0cb2",
                                                "sense_id": "e9c5d228-9af2-3571-9fe6-12f931a0385d",
                                                "text": "Bref, trois quarts d’heure plus tard, je descendais de voiture devant la mairie où m’attendait le maréchal des logis-chef Le Gallo, un des meilleurs pêcheurs de bars de l’endroit."
                                            },
                                            {
                                                "example_id": "b1c5b8d0-3bff-433c-911e-1469d6395562",
                                                "sense_id": "e9c5d228-9af2-3571-9fe6-12f931a0385d",
                                                "text": "Les bars arrondis, ouvrant une bouche énorme, faisant songer à quelque âme trop grosse, rendue à pleine gorge, dans la stupéfaction de l’agonie."
                                            },
                                            {
                                                "example_id": "b2dbdc80-e2c8-492b-814b-ff1247bd4efe",
                                                "sense_id": "e9c5d228-9af2-3571-9fe6-12f931a0385d",
                                                "text": "Recouvrez le filet de bar, sans peau et sans arêtes, de gros sel de Guérande, pendant onze minutes, afin de saumurer le poisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac09fb5-d339-3c6e-85b7-016b9a8aeabf",
                                        "entry_id": "0ac88e73-9d0d-3afd-9b32-6e00f1aeacaa",
                                        "glosses": [
                                            "Chair cuisinée de ce poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e94f774b-9e54-3fc7-a602-6ef957cf6da1",
                                        "entry_id": "0ac88e73-9d0d-3afd-9b32-6e00f1aeacaa",
                                        "glosses": [
                                            "Meuble représentant un animal du même nom dans les armoiries. Contrairement au poisson, il est généralement représenté par paire, en pal, courbé (l'un à dextre l’autre à senestre) et adossés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb4de235-d753-416d-88b8-0ea2f1306b14",
                                                "sense_id": "e94f774b-9e54-3fc7-a602-6ef957cf6da1",
                                                "text": "D’azur semé de croisettes d’or et aux deux bars d’or, qui est du Comte Bar → voir illustration « armoiries avec 2 bars »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "903a882a-485e-382b-b4e6-cea8b93ad561",
                                        "entry_id": "9464d2ad-d479-3b9f-a9f1-e4117cca6119",
                                        "glosses": [
                                            "Unité de mesure de masse qui vaut une tonne."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08f693d-77a6-49ff-97b9-3c390336f4a3",
                                                "sense_id": "903a882a-485e-382b-b4e6-cea8b93ad561",
                                                "text": "Bar ou Millier, ou 100 myriagrammes, poids égal au mètre cube d’eau qui pèse 1000 kilogrammes ; le bar remplace l’ancien tonneau de mer ; il vaut env. 2043 liv. poids de marc ; voy. pag. 189 et suiv."
                                            },
                                            {
                                                "example_id": "69f871d0-2082-4ec2-bef5-ae58a95c4023",
                                                "sense_id": "903a882a-485e-382b-b4e6-cea8b93ad561",
                                                "text": "BAR. Mot qui, dans le principe, faisait partie de la nomenclature du système métrique français, et désignait un poids de 1000 kilogrammes. Cette dénomination, aujourd’hui inusitée, a été remplacée par celle de millier ou tonneau. Voyez ces mots.\nLe bahar ou candi, poids des Indes orientales, porte quelquefois aussi le nom de bar. Voyez Bahar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd90cc3-90b9-34e8-9d91-c6221a096a36",
                                        "entry_id": "9464d2ad-d479-3b9f-a9f1-e4117cca6119",
                                        "glosses": [
                                            "Unité de mesure de pression des fluides, égale à exactement 100,000 pascal (Pa) et proche de la valeur moyenne de la pression atmosphérique au niveau de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5423b81d-16a3-42ab-a635-92f420cca20e",
                                                "sense_id": "edd90cc3-90b9-34e8-9d91-c6221a096a36",
                                                "text": "Hors du Système international (SI), le bar dérive de la barye (1 bar = 1,000,000 baryes), unité de pression du Système CGS. En Europe, depuis 1992, l’utilisation du bar est toujours permise mais non recommandée."
                                            },
                                            {
                                                "example_id": "274186b4-1650-400d-8be6-a7f7b50bdb4a",
                                                "sense_id": "edd90cc3-90b9-34e8-9d91-c6221a096a36",
                                                "text": "Viennent ensuite les conduites forcées qui mènent l’eau jusqu’aux turbines. Ces impressionnants tuyaux en acier de 1,9 à 2,3 mètres de diamètre peuvent supporter une pression de 28 bars."
                                            }
                                        ]
                                    }
                                ]
                            },
