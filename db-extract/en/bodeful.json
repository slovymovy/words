                        "entry_id": "44d027ac-a89a-3171-b1c1-842e903fa876",
                        "glosses": [
                            "Portentous; ominous; foreboding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c227b6-8504-4261-b901-9c8b14bd11c4",
                                "sense_id": "87f62566-6146-38e1-b59b-35f9b5fab549",
                                "text": "It is a voice bodeful of death or of life."
                            },
                            {
                                "example_id": "4d189d75-442a-4f29-8001-c33065737d14",
                                "sense_id": "87f62566-6146-38e1-b59b-35f9b5fab549",
                                "text": "They came ungraciously, but after his dark, bodeful hints as to the necessity of their attending service at the grazier's homestead next day, he was invited inside and a place was cleared for him at the table."
                            }
                        ]
                    }
