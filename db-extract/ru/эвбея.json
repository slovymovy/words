                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a44def6-5ac3-4a70-8db5-0760b4fdb8fc",
                                                "sense_id": "ac3c6813-1e77-381c-b2b2-b546a96240c7",
                                                "text": "Vers l’après-midi le mont Hélias, couronné de blanc et de rose comme une danseuse des Panathénées, indiqua la présence d’Eubée."
                                            },
                                            {
                                                "example_id": "d35d3982-da7e-4ae9-81e4-4eb48fb79752",
                                                "sense_id": "ac3c6813-1e77-381c-b2b2-b546a96240c7",
                                                "text": "Un avion bombardier d’eau s’est écrasé mardi sur l’île d’Eubée, près d’Athènes, en Grèce en luttant contre l’un des incendies qui ravagent le pays."
                                            }
