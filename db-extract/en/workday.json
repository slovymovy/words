                        "entry_id": "f88f6a90-a82c-3403-b1e4-274cd86f39e1",
                        "glosses": [
                            "Any of the days of a week on which work is done; any day in a workweek. The five workdays in many countries are usually Monday to Friday (and are defined as such in official and legal usage even though many people work on weekends)."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "c4c93009-26b8-4393-94c2-06f111310c99",
                                "sense_id": "7e8a102e-15d4-30d3-b8df-1a89572c539b",
                                "text": "It will take five workdays to process your application."
                            }
                        ]
                    },
                    {
                        "sense_id": "db66fdd1-1546-3a8b-a926-be14f04e7851",
                        "entry_id": "f88f6a90-a82c-3403-b1e4-274cd86f39e1",
                        "glosses": [
                            "That part of a day in which work is done."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "3d805834-4589-481c-8561-a06006765dcf",
                                "sense_id": "db66fdd1-1546-3a8b-a926-be14f04e7851",
                                "text": "My workday is 8 hours."
                            }
                        ]
                    }
