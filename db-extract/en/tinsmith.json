                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be73ce4f-353b-47a3-88b5-b1df5abe0e8d",
                                                "sense_id": "779187b7-bfb1-32d5-a276-c5ce243460c6",
                                                "text": "Der Klempner repariert unsere Regenwasserableitungen, der Installateur muss unsere Wasserleitung reparieren."
                                            },
                                            {
                                                "example_id": "db910d78-b029-490a-887e-098a02f4da62",
                                                "sense_id": "779187b7-bfb1-32d5-a276-c5ce243460c6",
                                                "text": "„Der Klempner schwieg lange, nachdem Roman ihm von Bodendorf erzählt hatte.“"
                                            },
                                            {
                                                "example_id": "f660b7f3-e918-42fa-847b-bc9c236e26c0",
                                                "sense_id": "779187b7-bfb1-32d5-a276-c5ce243460c6",
                                                "text": "„Sie ließen einen Schlosser für die Spalierstangen, einen Klempner für die Drahtverspannungen, einen Zimmermann für die Pfähle kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
