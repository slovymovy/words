                                        "glosses": [
                                            "Celui qui est chargé par la justice d’administrer une succession ou une société."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba83b37e-7112-49d9-94c0-a4752a3f2ef4",
                                                "sense_id": "9265732d-dba8-3c15-bb60-60a4fa8b157b",
                                                "text": "D’autre part, le tribunal nomme un administrateur judiciaire dont la mission est, selon la décision du tribunal, de surveiller le débiteur, voire, dans certains cas, de l’assister."
                                            }
