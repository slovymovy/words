                "senses": [
                    {
                        "sense_id": "f36f56a3-e8a5-341e-9cb2-4d659d16089c",
                        "entry_id": "834fa0a4-bfa4-35ec-8a4e-98603f448791",
                        "glosses": [
                            "Lehrerin, die Sport unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdbcd96d-ad14-420b-9855-a3d40b54fc84",
                                "sense_id": "f36f56a3-e8a5-341e-9cb2-4d659d16089c",
                                "text": "„Sportlehrerinnen weisen einen besonders hohen Anteil des Musters ‚Burnout‘ auf, während ihre männlichen Kollegen durch einen bemerkenswert hohen Anteil am Muster ‚Schonung‘ auffallen.“"
                            },
                            {
                                "example_id": "110a2f8c-c81e-4698-9b59-e33a1f0adb51",
                                "sense_id": "f36f56a3-e8a5-341e-9cb2-4d659d16089c",
                                "text": "„Hans Fallada lernt eine junge Frau kennen, Marianne Portisch, Sportlehrerin aus dem Sudetenland, Schriftleiterin einer nationalsozialistischen Mädchenzeitschrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
