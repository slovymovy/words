                },
                {
                    "sense_id": "0ec9dc91-5604-3dcf-b451-3055333cedb8",
                    "sense_definition": "A person very much liked or loved by someone, especially a romantic partner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "endearment_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "John married his high-school <w>sweetheart</w> in 1981.",
                            "target_lang_translations": {
                                "ru": "Джон женился на своей школьной <w>возлюбленной</w> в 1981 году.",
                                "zh": "约翰在1981年娶了他的高中<w>恋人</w>。"
                            }
                        },
                        {
                            "text": "They have been <w>sweethearts</w> since they were teenagers.",
                            "target_lang_translations": {
                                "ru": "Они были <w>влюбленными</w> с подросткового возраста.",
                                "zh": "他们从青少年时期就是<w>恋人</w>了。"
                            }
                        }
