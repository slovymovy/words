                "senses": [
                    {
                        "sense_id": "3094d731-a4dd-367e-b8f4-11dff025583c",
                        "entry_id": "1c3d18c4-ec61-38e5-8776-104906e76324",
                        "glosses": [
                            "osoba poddawana badaniom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6f3a23-98f8-4d34-bb9f-4e958c5206d1",
                                "sense_id": "3094d731-a4dd-367e-b8f4-11dff025583c",
                                "text": "Wydaje się, że etap narzeczeństwa nastaje tak po prostu, znienacka. Nikt z badanych nie wspominał o decyzji poprzedzonej głębokimi przemyśleniami, czy to na pewno ten jedyny/ta jedyna."
                            },
                            {
                                "example_id": "89f43705-3ebc-431b-939f-beaaf0646fb1",
                                "sense_id": "3094d731-a4dd-367e-b8f4-11dff025583c",
                                "text": "W czasie gdy badani grali w zmodyfikowaną wersję słynnego Pac-Mana, naukowcy zaobserwowali, że w zależności od bliskości zagrożenia strachem zarządzają różne obszary mózgu."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
