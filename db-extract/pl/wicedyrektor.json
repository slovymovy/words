                                ]
                            },
                            {
                                "target_word": "vice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3e5284-d2c6-301b-b75f-c4529705cd44",
                                        "entry_id": "c0f6fa95-9203-3588-a455-8e875486b6dd",
                                        "glosses": [
                                            "Alternative spelling of vise (“to hold or squeeze with a vice”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc2fc0a-a584-4357-b6f0-10ef76a526f8",
                                                "sense_id": "8f3e5284-d2c6-301b-b75f-c4529705cd44",
                                                "text": "Camillo. As he had ſeen’t, or beene an Instrument / To vice you to't, that you haue toucht his Queene / Forbiddenly."
                                            },
                                            {
                                                "example_id": "6b77ac22-fe1a-4cec-8e1c-800959f862c5",
                                                "sense_id": "8f3e5284-d2c6-301b-b75f-c4529705cd44",
                                                "text": "What could be done—who was it that could do it—to check the storm-flight of these maniacal horses? Could I not seize the reins from the slumbering coachman? […] [F]rom the way in which the coachman's hand was viced between his upper and lower thigh, this was impossible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bad00a09-d6ad-36d8-baa0-d59cc05b25fe",
                                        "entry_id": "e7988c77-02a2-3c93-8fb0-9f9c1dc625dd",
                                        "glosses": [
                                            "Instead of; in place of; versus."
