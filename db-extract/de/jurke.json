                ],
                "senses": [
                    {
                        "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                        "entry_id": "5f9fcd08-7f19-3da5-bfbf-ed2faa98974a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086f1b70-45cd-4299-9f3e-be3ea5de4277",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Frau Jurke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4b55bba2-ace3-4eac-a313-8503d85c5a57",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Herr Jurke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e8e22da4-9a83-43eb-9d15-a9f72a08f990",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Die Jurkes fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "12159ad1-f3f3-4df7-b438-15b46d660d13",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Der Jurke trägt nie die Pullover, die die Jurke ihm strickt."
                            },
                            {
                                "example_id": "93060c3c-1301-4616-a044-45d9d31a9d30",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jurke kommt, geht der Herr Jurke.“"
                            },
                            {
                                "example_id": "b92f0628-c1d8-46ec-a406-af3b2dde0d20",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Jurke kommt und geht."
                            },
                            {
                                "example_id": "31e4eff1-55e5-4991-a705-c08f3c23a8e4",
                                "sense_id": "9a8cd5ee-c5e9-373c-8a2e-3402acdc1f9c",
                                "text": "Jurkes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
