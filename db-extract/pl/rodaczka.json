                        "source_sense_id": "a2fa55f5-d531-33d8-8234-9a7a2b88a792",
                        "target_lang_word": "countrywoman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "countrywoman",
