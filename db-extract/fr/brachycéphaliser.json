                ],
                "senses": [
                    {
                        "sense_id": "24f83f33-9377-32f3-a4a6-1dec3364168a",
                        "entry_id": "3e8cd3df-e09b-3885-8cf9-3b4dee1a6cdb",
                        "glosses": [
                            "Rendre brachycéphale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe51060-8b94-46b0-90ea-187cf4638814",
                                "sense_id": "24f83f33-9377-32f3-a4a6-1dec3364168a",
                                "text": "Un aliment d'un genre nouveau, en forçant les muscles divers effectuant la mastication aurait brachycéphalisé le crâne, augmentant ainsi le volume du cerveau et par conséquent l'intelligence du sujet."
                            },
                            {
                                "example_id": "2b56ef0b-7d1b-478a-9b0a-d72a829511b9",
                                "sense_id": "24f83f33-9377-32f3-a4a6-1dec3364168a",
                                "text": "Le métissage alpin, qui aurait brachycéphalisé cette variété, aurait logiquement influencé les autres caractères, ce qui ne paraît pas être le cas."
                            },
                            {
                                "example_id": "ed0e3a30-be45-4450-b076-1e14a47fb97a",
                                "sense_id": "24f83f33-9377-32f3-a4a6-1dec3364168a",
                                "text": "On sait qu'un peuple dolichocéphale peut se brachycéphaliser sans apports génétiques extérieurs."
                            }
                        ]
                    }
                ],
