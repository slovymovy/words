                        "source_sense_id": "28f33a90-4211-32aa-91a5-142a0f87320d",
                        "target_lang_word": "gezond",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gezond",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f95448a-579a-319c-89f1-6fc9efe6f886",
                                        "entry_id": "76a1291b-1af5-3432-9588-40edd00c27a1",
                                        "glosses": [
                                            "vrij van ziektes en zeertes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8ab469-344a-4497-bfec-96c87ae76917",
                                                "sense_id": "8f95448a-579a-319c-89f1-6fc9efe6f886",
                                                "text": "Hij is nog goed gezond voor zijn leeftijd."
                                            },
                                            {
                                                "example_id": "dc6aa493-5cf6-4bf4-9383-eea08a7695d0",
                                                "sense_id": "8f95448a-579a-319c-89f1-6fc9efe6f886",
                                                "text": "Zo geeft het Tacuinum Sanitatis, een middeleeuwse gids tot gezond leven die in verschillende rijkgeïllustreerde kopieën is overgeleverd, ook nadrukkelijk aandacht aan de jacht."
                                            },
                                            {
                                                "example_id": "f8908077-3dd3-4046-a4af-3c248d09a030",
                                                "sense_id": "8f95448a-579a-319c-89f1-6fc9efe6f886",
                                                "text": "De eerste dode in elke oorlog is het gezond verstand."
                                            },
                                            {
                                                "example_id": "2f9953b9-7cf9-498c-8d36-ac2b0f6376ce",
                                                "sense_id": "8f95448a-579a-319c-89f1-6fc9efe6f886",
                                                "text": "Eindelijk nam ze een klein aarden kruikje, goot de drank erin, deed er een kurk op en zei: 'Ieder uur tien druppels, drie dagen lang en je paard is weer gezond.'"
                                            },
                                            {
                                                "example_id": "ea90df3e-e0e0-473c-ac8f-d6d64e793d0a",
                                                "sense_id": "8f95448a-579a-319c-89f1-6fc9efe6f886",
                                                "text": "Zonder gezonde voeten kon ik hier helemaal niks, dus ik deed er alles aan om ze extra te verzorgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb446f05-2f93-36b6-90b3-a2362dd5afc7",
                                        "entry_id": "76a1291b-1af5-3432-9588-40edd00c27a1",
                                        "glosses": [
                                            "bevorderlijk voor een goede conditie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8086c5-1f10-44f0-b31c-1ab6eda4d6b6",
                                                "sense_id": "fb446f05-2f93-36b6-90b3-a2362dd5afc7",
                                                "text": "Lichaamsoefening is gezond voor een mens."
                                            }
                                        ]
                                    }
                                ]
