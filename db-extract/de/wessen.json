                    {
                        "translation_id": "7d4636fd-9427-4637-81be-5c199fb5cf12",
                        "source_entry_id": "1df2e161-a000-3b3e-8f73-dbbc6be75015",
                        "source_sense_id": "7a31a05a-4b17-385e-9129-4e0c1e14479b",
