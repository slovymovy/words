                                        "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                        "entry_id": "5da66afc-7373-35dc-8549-311bd749b6a5",
                                        "glosses": [
                                            "Qui a ou qui marque du dédain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37525311-804d-41fe-bfaf-7aae2ceba2fa",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "Ceux-ci, d’ailleurs, un peu hautains et dédaigneux, affectaient souvent de regarder comme indignes d’eux les amusements habituels des gosses."
                                            },
                                            {
                                                "example_id": "c0e140dc-f2f6-457d-8923-e7a47626a843",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "Il tira une chaise, s'installa à califourchon et son regard fit le tour de la chambre avec une lippe dédaigneuse et apitoyée."
                                            },
                                            {
                                                "example_id": "6f3d6bfb-727b-4229-8e13-43891c48d07f",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "Joseph détourna la tête, mais il saisit du coin de l’œil le regard dédaigneux dont on le couvrit en passant, et le sang lui monta aux joues."
                                            },
                                            {
                                                "example_id": "70f8a186-b22b-4de5-a6d8-90a2724917ab",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "L’homme revint vers la porte, semblant pressé de refouler ces intrus trop curieux, et dédaigneux de ses richesses : des adonis marmoréens, des chandeliers, des meubles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb77f67a-d271-43a2-b93a-2edbe9692ddb",
                        "source_entry_id": "003bb275-8222-36c8-8e43-1ee33706bbde",
                        "source_sense_id": "60549e5c-a47c-3458-95aa-a1d78173d704",
                        "source_sense_description": "showing contempt or scorn",
                        "target_lang_word": "geringschätzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geringschätzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                        "entry_id": "c80bff19-128b-34cc-92f0-fe2760225479",
                                        "glosses": [
                                            "jemanden oder etwas wenig Bedeutung und/oder Respekt beimessend; abwertend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbbfe19-bbf9-4c07-a56e-69a7e2c2249c",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Bemerkenswert ist, wie geringschätzig in dem Papier über die Kirchengemeinden gesprochen wird, während kirchensoziologische Studien deren bleibende Bedeutung unterstreichen.“"
                                            },
                                            {
                                                "example_id": "3b77afd7-a90d-426c-8f15-a6f32089674f",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„‚Sie versucht, mich genauso geringschätzig zu betrachten wie Ali meinen Vater‘, beklagte sich die Rechtsanwältin, die im Ring ohne Chance blieb.“"
                                            },
                                            {
                                                "example_id": "e576ae0a-43af-45f9-8704-3265e7a7b180",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Das ‚glaubhaft‘ in diesem Zusammenhang ist nicht nur ein geringschätziges, sondern ein böses, hämisches Wort.“"
                                            },
                                            {
                                                "example_id": "7de4647c-dcaf-490a-8c75-73c7c675cc10",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Teilweise entwickelte sich die Rückmeldung so zu einem Wettkampf zwischen den Jungen, mit dem Ziel, sich gegenseitig durch immer geringschätzigere Kommentare zu überbieten.“"
                                            },
                                            {
                                                "example_id": "fd940f18-5f6e-4226-af32-f81731a780af",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Er lehnte sich gelassen auf seinem Stuhl zurück und zeigte seinen blasiertesten und geringschätzigsten Gesichtsausdruck und grinste auch noch dabei. Weil er ja der große Zampano ist und alle anderen sind dumme, kleine Arschlöcher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "290870dc-63e3-4288-b042-ab803058be1b",
                        "source_entry_id": "003bb275-8222-36c8-8e43-1ee33706bbde",
