                "senses": [
                    {
                        "sense_id": "ce0114bd-428c-3c9a-827d-e54c3132f35c",
                        "entry_id": "b1694e49-2b70-3f0a-9e24-a7944ce11de2",
                        "glosses": [
                            "jemand, der dem Fünften folgt (und eventuell dem Siebten vorausgeht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816951e1-6314-4497-b9ab-0417bbcaec50",
                                "sense_id": "ce0114bd-428c-3c9a-827d-e54c3132f35c",
                                "text": "Der Sechste war insgesamt schneller als der Fünfte."
                            },
                            {
                                "example_id": "232295a1-e1d3-4e00-9e3e-81ef2790cdee",
                                "sense_id": "ce0114bd-428c-3c9a-827d-e54c3132f35c",
                                "text": "Der Teilnehmer aus Frankreich wurde nur Sechster, blieb aber optimistisch."
                            },
                            {
                                "example_id": "24d609d3-54d8-47bf-9c23-0134352d34bb",
                                "sense_id": "ce0114bd-428c-3c9a-827d-e54c3132f35c",
                                "text": "Nie wollte er Sechster werden, aber er ist doch immer wieder geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d625eb6-7128-4d79-8d6f-0ec6d302e380",
                        "source_entry_id": "b1694e49-2b70-3f0a-9e24-a7944ce11de2",
                        "source_sense_id": "ce0114bd-428c-3c9a-827d-e54c3132f35c",
                        "source_sense_description": "jemand, der dem Fünften folgt (und eventuell dem Siebten vorausgeht)",
                        "target_lang_word": "sixth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sixth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                        "entry_id": "f8050b46-6b02-31a9-867c-761e8b2980db",
                                        "glosses": [
                                            "The ordinal form of the number six."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66cc5f1c-61fc-4856-bef9-1d74809b8b7a",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "And * God ſaw euery thing that hee had made : and behold, it was very good. And the euening and the moꝛning were the ſixth day.",
                                                "translation": "And God saw everything that he had made: and behold, it was very good. And the evening and the morning were the sixth day.",
                                                "english": "And God saw everything that he had made: and behold, it was very good. And the evening and the morning were the sixth day."
                                            },
                                            {
                                                "example_id": "1aef3002-f666-425a-83a4-9d407b888ebb",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "Dr. Ridpath, in his usual happy manner, thanked the Executive Committee and the various members of the Association who had so earnestly cooperated with him in the work of the Sixth Annual Meeting now drawing to a close."
                                            },
                                            {
                                                "example_id": "0d02015b-29cb-4e63-bd67-b2fe99ce7c72",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "[T]he law codes drafted in Athens in the late seventh and early sixth centuries were the work of individuals, Drakon and then Solon."
                                            },
                                            {
                                                "example_id": "7f5f2460-ae18-4a3d-928f-61fd9465f5bb",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "On Monday, the federal Immigration and Customs Enforcement agency placed a similar detainer on Melvin Jovel, 18, who on Sunday was the sixth person to be arrested in the case."
                                            },
                                            {
                                                "example_id": "ff2fb097-8fea-4c18-8ca8-bd4fa37168a0",
                                                "sense_id": "3c2274a5-172d-320f-92a9-18f429e1a7f4",
                                                "text": "As this sixth edition is published in 2011, it is exactly 25 years since the publication of the first edition in 1986. That, in itself, is a very sobering thought, for all kinds of reasons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sixth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a681994-e98a-3374-837a-53f61b2d3d65",
                                        "entry_id": "aeaced94-da9c-3cdf-bc0f-521790194e31",
                                        "glosses": [
                                            "The person or thing in the sixth position."
                                        ],
                                        "tags": [
                                            "not used in the plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21b4e259-e79a-3ebe-876f-e23be5810730",
                                        "entry_id": "aeaced94-da9c-3cdf-bc0f-521790194e31",
                                        "glosses": [
                                            "One of six equal parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53844e5c-7f37-440e-b7e1-a2432683f646",
                                                "sense_id": "21b4e259-e79a-3ebe-876f-e23be5810730",
                                                "text": "On the moon, however the weight of a pound-mass (lb or lbm) is only about one sixth of a pound-force (lbf)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7cdcab-15d8-34bf-840e-b24c0d4a741a",
                                        "entry_id": "aeaced94-da9c-3cdf-bc0f-521790194e31",
                                        "glosses": [
                                            "The interval between one note and another, five notes higher in the scale; for example C to A, a major sixth, or C to A flat, a minor sixth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sixth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "595b77f0-5f80-318c-af16-ea11aa42f155",
                                        "entry_id": "ee9da277-435e-36be-8d06-ed8f2aeaa8a3",
                                        "glosses": [
                                            "To divide by six, equivalent to multiplying a denominator by six."
                                        ],
                                        "tags": [
                                            "informal",
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0171841d-5d29-417a-a18f-2880c619462b",
                                                "sense_id": "595b77f0-5f80-318c-af16-ea11aa42f155",
                                                "text": "Why would anyone use sixthing when any (N − a²) divisible by 6 would also be divisible by 3? The answer is that sometimes the numerator and/or the denominator is simpler in sixthing,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8f090d-8563-4c20-acbf-40ec3d4203a1",
                        "source_entry_id": "b1694e49-2b70-3f0a-9e24-a7944ce11de2",
                        "source_sense_id": "ce0114bd-428c-3c9a-827d-e54c3132f35c",
                        "source_sense_description": "jemand, der dem Fünften folgt (und eventuell dem Siebten vorausgeht)",
                        "target_lang_word": "шестой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шестой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cba5a236-025a-3de2-a488-ef1cb156edc0",
                                        "entry_id": "40051558-186a-3788-b365-8f31f974548e",
                                        "glosses": [
                                            "имеющий номер шесть, стоящий в ряду после пятого и перед седьмым"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f4c3d7-22b1-4090-b47f-6d3b8fdad3c9",
                                                "sense_id": "cba5a236-025a-3de2-a488-ef1cb156edc0",
                                                "text": "Он жил на шестом этаже, и город лежал под его ногами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732a89eb-423c-3dc3-be47-9948765d36d6",
                                        "entry_id": "40051558-186a-3788-b365-8f31f974548e",
                                        "glosses": [
                                            "субстантивир. шестая часть чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb550d6e-ad5a-43f2-8a3e-7a09717eaf12",
                                                "sense_id": "732a89eb-423c-3dc3-be47-9948765d36d6",
                                                "text": "Кроме этого (превосходного) дома, пять шестых которого отдавались в наём, генерал Епанчин имел ещё огромный дом на Садовой, приносивший тоже чрезвычайный доход."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac6c80c-8e7c-3ed2-a162-698225037672",
                                        "entry_id": "40051558-186a-3788-b365-8f31f974548e",
                                        "glosses": [
                                            "субстантивир. то же, что шестой час; интервал времени между пятью и шестью часами дня или ночи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f353beb-a57f-4756-ae7a-fcb1cbaec223",
                                                "sense_id": "0ac6c80c-8e7c-3ed2-a162-698225037672",
                                                "text": "Только отъехав вёрст семь, он настолько опомнился, что посмотрел на часы и понял, что было половина шестого и что он опоздал."
                                            },
                                            {
                                                "example_id": "b7a62f16-348e-4061-8f29-69ec0dbadeae",
                                                "sense_id": "0ac6c80c-8e7c-3ed2-a162-698225037672",
                                                "text": "Минутная стрелка указывала уже пять минут шестого."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
