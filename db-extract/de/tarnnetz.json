                "senses": [
                    {
                        "sense_id": "fcb84737-0306-31f1-b508-032f45651523",
                        "entry_id": "9466f7f9-e079-3e72-9587-60e20747680d",
                        "glosses": [
                            "als Sichtschutz dienendes Netz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8715c2-765d-45c3-9c66-e933f4b4384f",
                                "sense_id": "fcb84737-0306-31f1-b508-032f45651523",
                                "text": "„Tarnnetze lagen über den »Seehunden«.“"
                            },
                            {
                                "example_id": "c128f0eb-ca35-472c-8609-7e160dbbb8cb",
                                "sense_id": "fcb84737-0306-31f1-b508-032f45651523",
                                "text": "„Die Tarnnetze und der Tarnanstrich sind jetzt noch weniger wert als vorher.“"
                            },
                            {
                                "example_id": "0e31097a-6919-4e82-8a36-5ee4fb5d7c78",
                                "sense_id": "fcb84737-0306-31f1-b508-032f45651523",
                                "text": "„Frauen nähten Tarnnetze für die Front, Arbeiter bauten Kanonenöfen für die Unterstände der Schützengräben in der Ukraine und Familien packten Geschenkpakete für die Soldaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
