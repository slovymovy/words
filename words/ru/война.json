                            {
                                "target_lang_word": "战争",
                                "target_lang_sense_clarification": "比喻性的对抗行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c92b4b12-bef2-35dc-95cf-9c2e92cfbb1c",
                    "sense_definition": "Состояние вражды, ссоры или острого соперничества между людьми.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "interpersonal_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Между соседями началась настоящая <w>война</w> из-за громкой музыки.",
                            "target_lang_translations": {
                                "en": "A real <w>war</w> started between the neighbors because of the loud music.",
                                "zh": "邻居们因为大声播放音乐而爆发了真正的<w>争斗</w>。"
                            }
                        },
                        {
                            "text": "Их постоянная <w>война</w> на работе мешает всему коллективу.",
                            "target_lang_translations": {
                                "en": "Their constant <w>war</w> at work disturbs the whole team.",
                                "zh": "他们在工作中的持续<w>敌对</w>影响了整个团队。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вражда"
                    ],
                    "antonyms": [
                        "дружба",
                        "мир"
                    ],
                    "common_phrases": [
