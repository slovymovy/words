                "senses": [
                    {
                        "sense_id": "fd8a8b1b-9405-344d-8254-4a471914eec7",
                        "entry_id": "2e33cee2-4cae-33e8-a051-544caac2a2f8",
                        "glosses": [
                            "Avertissement aux voyageurs, message officiel par lequel les autorités déconseillent de voyager vers une destination en raison du danger qu'elle présente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "545416d5-a172-43d1-b635-c52f500433e2",
                                "sense_id": "fd8a8b1b-9405-344d-8254-4a471914eec7",
                                "text": "Reisewarnungen sind ein dringender Appell des Auswärtigen Amts, Reisen in ein Land oder in eine Region eines Landes zu unterlassen."
                            },
                            {
                                "example_id": "d2e90aa6-f226-4f82-aa34-98f36145f31c",
                                "sense_id": "fd8a8b1b-9405-344d-8254-4a471914eec7",
                                "text": "Schon einmal befand sich Miles Routledge in einer heiklen Situation in Afghanistan, (...) Was ihn aber nicht davon abhielt, erneut nach Afghanistan zu reisen - trotz der strikten Reisewarnung, die auch die Regierung in London ausgesprochen hat.",
                                "translation": "Miles Routledge s’est déjà retrouvé dans une situation délicate en Afghanistan, (...) ce qui ne l’a pas empêché de s'y rendre à nouveau, malgré le strict avertissement de voyage émis également par le gouvernement de Londres."
                            }
                        ]
                    }
                ],
