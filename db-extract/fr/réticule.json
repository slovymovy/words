            {
                "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                "word": "réticule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "24bad2b4-7fdf-4991-936e-15d17fcedaa7",
                        "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "réticules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd2a52c2-894a-3d3c-b297-92905dadbc3e",
                        "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "glosses": [
                            "Petit sac en filet que les femmes portaient à la main."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ccd2ac58-fc20-4b61-a430-ff641a6843d1",
                                "sense_id": "fd2a52c2-894a-3d3c-b297-92905dadbc3e",
                                "text": "À la fin de la soirée, elle me rejoignait, son réticule plein de louis qu’elle avait gagnés."
                            }
                        ]
                    },
                    {
                        "sense_id": "779e27f2-afb6-3c48-ad8e-38bc6f713d9e",
                        "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "glosses": [
                            "Sorte de résille."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b4d36f97-75f7-3288-a2dd-4630c5a40f4a",
                        "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "glosses": [
                            "Système de fils derrière lesquels on observe le passage d’une étoile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b460b6b5-e83f-4742-b8cf-47a09d0d6f3f",
                                "sense_id": "b4d36f97-75f7-3288-a2dd-4630c5a40f4a",
                                "text": "Michel Zorn, muni d’une lunette à réticule, vérifiait la pose de ces jalons et la reconnaissait exacte, lorsque le fil vertical du réticule partageait toutes leurs images focales en parties égales."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cf07f96-1db8-300b-975a-9ce7ac7f55dd",
                        "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "glosses": [
                            "Dans un système de visée ou de pointage, ensemble de lignes, en général une croix, superposé sur l’image de la cible pour améliorer la précision du tir ou du pointage."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d2935e1e-07e3-325b-b917-336bb30abd73",
                        "entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "glosses": [
                            "Réseau."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "22107060-caab-48bf-9e20-d1922b9e0bb8",
                                "sense_id": "d2935e1e-07e3-325b-b917-336bb30abd73",
                                "text": "À mesure qu’ils s’enfonçaient dans le réticule de corridors, ils percevaient plus nettement une étrange litanie, comme des bruits d’animaux planant dans l’air."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a511a05b-65f6-450b-bbbe-aba2685a8181",
                        "source_entry_id": "bfd8d7af-bed8-3a64-b669-9ba7660a18d5",
                        "source_sense_description": "ensemble de ligne superposé sur l’image de la cible",
                        "target_lang_word": "reticle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reticle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b36d47da-84a3-3f54-a1c1-da77e21c99a1",
                                        "entry_id": "0ee26d11-a0c2-3b8c-9769-6a340ce72ff6",
                                        "glosses": [
                                            "A grid, network, or crosshatch found in the eyepiece of various optical instruments to aid measurement or alignment"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "714815fa-3bc3-3e59-8ae8-3f4301afc1cb",
                                        "entry_id": "0ee26d11-a0c2-3b8c-9769-6a340ce72ff6",
                                        "glosses": [
                                            "Alternative form of reticule (“a little bag”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a88bc058-f301-427e-970e-db96f2ed0a68",
                                                "sense_id": "714815fa-3bc3-3e59-8ae8-3f4301afc1cb",
                                                "text": "On the following day Mrs. Kent went into the bed-room; and laid a reticle, which contained the money, upon her bed; and afterwards returned into the sitting-room; leaving the door between that and the bed-room open. After she had remained in the sitting-room about five minutes, she sent Miss S. for the reticle; and it was not to be found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
