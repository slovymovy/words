                "senses": [
                    {
                        "sense_id": "ca50f298-c331-3d40-94d2-6b801d6af5ed",
                        "entry_id": "04f57493-20e6-3840-8fc3-7dc1f3f31f83",
                        "glosses": [
                            "Somewhat well; reasonable; adequate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d59edaf-e80e-4218-a27c-cad01f9ef368",
                                "sense_id": "ca50f298-c331-3d40-94d2-6b801d6af5ed",
                                "text": "Come, I say, old boy, you are going it strongish: rot me, if the garden wasn't pretty wellish."
                            },
                            {
                                "example_id": "fd119208-60a4-4287-9d39-3da85c0c87e0",
                                "sense_id": "ca50f298-c331-3d40-94d2-6b801d6af5ed",
                                "text": "Knowing human nature as we do we can safely prophesy that the State Council will merrily go its round of life in spite of the distant rumblings of the Boycott war-cry from the rather wellish dry North"
                            },
                            {
                                "example_id": "695390b3-55be-4ec1-8e85-7a876f2356a6",
                                "sense_id": "ca50f298-c331-3d40-94d2-6b801d6af5ed",
                                "text": "Sermon being done, how are you? All wellish here."
                            },
                            {
                                "example_id": "297db2b0-bb37-4079-9416-cb9b55dc615a",
                                "sense_id": "ca50f298-c331-3d40-94d2-6b801d6af5ed",
                                "text": "All might be well, or wellish, if Bill Bryden 's production had more tension and emotional intensity."
                            }
                        ]
                    },
                    {
                        "sense_id": "57b284f8-798b-3ca9-b118-cc15234ced75",
                        "entry_id": "04f57493-20e6-3840-8fc3-7dc1f3f31f83",
                        "glosses": [
                            "Somewhat well; in okay but not great health."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24411fde-8371-478e-a859-796601fc997f",
                                "sense_id": "57b284f8-798b-3ca9-b118-cc15234ced75",
                                "text": "The Emperor looked wellish but a bad colour."
                            },
                            {
                                "example_id": "bb595872-6043-4001-b8cf-e7eb69e43746",
                                "sense_id": "57b284f8-798b-3ca9-b118-cc15234ced75",
                                "text": "Sometimes I feel wellish here, sometimes very bad; never well, I never can be well again without the miracle."
                            },
                            {
                                "example_id": "adac60ff-ca79-435f-b2df-c30f20a0e78c",
                                "sense_id": "57b284f8-798b-3ca9-b118-cc15234ced75",
                                "text": "The operation went without difficulty and two days later he was longing for the simple pleasures of life: 'I am feeling quite wellish & am longing for some sausages & mashed [potatoes] – which I shan't get';"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
