                ],
                "senses": [
                    {
                        "sense_id": "05c241fd-e926-3671-a8eb-f925bb7b654f",
                        "entry_id": "cd491450-c2e2-3adf-b6b4-b2624598954a",
                        "glosses": [
                            "Vorrichtung aus zwei Spulen, die elektrische Energie transformiert, das heißt ihre charakteristische Größe Spannung so ändert, dass Niederspannung am Ausgang entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36dc9ce-60e9-47f6-b3c9-25c9cf375a92",
                                "sense_id": "05c241fd-e926-3671-a8eb-f925bb7b654f",
                                "text": "„Ohne einen Niederspannungstransformator kann der Anlagenbetreiber einen noch höheren Wirkungsgrad erzielen bei gleichzeitig niedrigeren Wechselrichterkosten.“"
                            },
                            {
                                "example_id": "73a06650-ed62-4eff-8397-09f4320462b2",
                                "sense_id": "05c241fd-e926-3671-a8eb-f925bb7b654f",
                                "text": "„Die Niederspannungs-Leitungsverluste im Bereich zwischen Niederspannungstransformator und Messpunkt (ohne Betrachtung der Verluste in zugehörigen Niederspannungstransformatoren, Sicherungen und Messeinrichtungen) betragen in einzelnen Niederspannungsabgängen über 4% der übertragenen Energiemenge (Abb. 1), wobei die mittleren Leitungsverluste der betrachteten Siedlungstypen zwischen 0,85% und 1,35% liegen.“"
                            },
                            {
                                "example_id": "071b2adb-475d-4dac-94fd-ab3263d3806d",
                                "sense_id": "05c241fd-e926-3671-a8eb-f925bb7b654f",
                                "text": "„Die modulare Bauweise und der Betrieb ohne Niederspannungstransformator tragen zu einer wesentlichen Steigerung der Leistungsfähigkeit bei, die durch verschiedene unabhängig voneinander betriebene DC-Leistungsstufen sowie Sucher des maximalen Leistungspunkts (MPPT) zusätzlich unterstützt wird.“"
                            },
                            {
                                "example_id": "b838c611-5991-446d-92ed-cf4890ae0ae9",
                                "sense_id": "05c241fd-e926-3671-a8eb-f925bb7b654f",
                                "text": "„Zwischen dem Niederspannungstransformator, der Platte und den Leuchten entsteht eine derart enge Verbindung, dass schlicht und einfach die Platte selbst zum zentralen Element des DIPLINE-Konzepts wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
