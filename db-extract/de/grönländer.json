                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                        "entry_id": "aef88037-629a-3abf-a88b-095240f9aad4",
                        "glosses": [
                            "Einwohner von Grönland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad8af41-e1b2-4b77-a6b7-9231225c0e79",
                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                "text": "Zudem werden die Grönländer als eigenes Volk und Grönländisch als Landessprache anerkannt."
                            },
                            {
                                "example_id": "a47a7908-1911-48c4-811a-9f1d1621efd7",
                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                "text": "Dem Entwurf zufolge soll Grönland pro Jahr die ersten 75 Millionen Kronen (rund 100 Millionen Euro) aus künftigen Öleinnahmen behalten dürfen. Was darüber hinaus geht, wollen sich Grönländer und Dänen je zur Hälfte teilen."
                            },
                            {
                                "example_id": "5bcf8937-7919-42bf-9f15-052228217006",
                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                "text": "Doch hoffen die Grönländer immer noch auf Wohlstand durch den Fund von Öl oder Mineralien."
                            },
                            {
                                "example_id": "3facfc29-ccd0-42df-9eac-5cca399360ad",
                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                            },
                            {
                                "example_id": "b85716b6-7851-46ce-9bc2-5f031f5c2ef9",
                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                "text": "„Sie waren die ersten Grönländer, die eine Universitätsausbildung erhielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be492e03-5860-4942-a6d5-ce9930aac214",
                        "source_entry_id": "aef88037-629a-3abf-a88b-095240f9aad4",
                        "source_sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                        "source_sense_description": "Einwohner von Grönland",
                        "target_lang_word": "Greenlander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Greenlander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fce9b7f-2aea-37a3-8591-2bfd8bce94e8",
                                        "entry_id": "68da084d-4541-3ef0-a9db-9fa31efefd12",
                                        "glosses": [
                                            "A person from Greenland or of Greenlandic descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e5d543-986d-4e88-81f2-6a9d055cda3e",
                                                "sense_id": "4fce9b7f-2aea-37a3-8591-2bfd8bce94e8",
                                                "text": "1865, Henry David Thoreau, Cape Cod, Chapter IV. \"The Beach\", page 54.\nWere it not for this, we Europeans should have no wood to burn there, and the poor Greenlanders […] would, however, have no wood to roof their houses, to erect their tents, as also to build their boats, and to shaft their arrows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59ff09e2-5c0b-412b-87c8-62409614d953",
                        "source_entry_id": "aef88037-629a-3abf-a88b-095240f9aad4",
                        "source_sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                        "source_sense_description": "Einwohner von Grönland",
                        "target_lang_word": "Groenlandais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Groenlandais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c11054b-a40a-31fd-94dd-c0ac410a6af2",
                                        "entry_id": "1880b664-cf00-36ed-9ae9-f5f22a0e1d70",
                                        "glosses": [
                                            "Habitant du Groenland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fb195f-de84-47f0-8954-9fe00a8957c4",
                                                "sense_id": "9c11054b-a40a-31fd-94dd-c0ac410a6af2",
                                                "text": "À l’abri du monopole et de la paix qui en résultait, les Groenlandais se multiplièrent et aujourd’hui, deux cents ans après l’arrivée de Hans Egede, ils sont au nombre de 15.000, répartis en 12 districts de colonisation, comprenant au total 62 groupes d’habitations, possédant chacun une boutique, un prêtre et un instituteur ; à chaque district est attaché un médecin."
                                            },
                                            {
                                                "example_id": "9e667aaf-9b6d-4934-9b06-90b2f7a9ce22",
                                                "sense_id": "9c11054b-a40a-31fd-94dd-c0ac410a6af2",
                                                "text": "« L’un des plus grandes surprises a été de découvrir que les Groenlandais les plus jeunes sont moins conscients des changements climatiques liés à l’homme que les plus âgés », a relevé l’auteur de l’étude, Kelton Minor."
                                            },
                                            {
                                                "example_id": "65bacbe5-4377-47cc-8575-468bd3b935cb",
                                                "sense_id": "9c11054b-a40a-31fd-94dd-c0ac410a6af2",
                                                "text": "Les Groenlandais ont l’habitude de prendre les choses comme elles viennent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
