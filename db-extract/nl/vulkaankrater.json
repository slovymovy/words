                        "sense_id": "fea4216c-ce66-335a-8a41-1ea50feaf40d",
                        "entry_id": "02036647-4aa7-35c8-9cee-87bbeabfe8fe",
                        "glosses": [
                            "een krater in een planeetoppervlak waardoor, bij een vulkanische uitbarsting, lava aan het oppervlak komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363b2093-fec0-4c7f-be87-f9874e1e9c89",
                                "sense_id": "fea4216c-ce66-335a-8a41-1ea50feaf40d",
                                "text": "Het beloofde een bijzondere dag te worden. Het pad liep langs het beroemde Crater Lake, een prachtige vulkaankrater gevuld met uitzonderlijk helder, blauw water."
                            },
                            {
                                "example_id": "bd87dd47-db77-449d-8897-0a739d54bcac",
                                "sense_id": "fea4216c-ce66-335a-8a41-1ea50feaf40d",
                                "text": "Een Amerikaanse militair op verlof heeft woensdag een val van meer dan twintig meter gemaakt in een vulkaankrater op Hawaï."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
