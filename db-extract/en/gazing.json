                            {
                                "example_id": "44bf76dc-6b73-49e5-b94c-3b9ce91e133f",
                                "sense_id": "431ff49d-0591-3bdc-852c-c8fb8d1b6de5",
                                "text": "There is a dangerous freshness in the hues / Of the new bonnets which that day produces / Bright from the bandbox, be they greens or blues; / The aspect of a new pelisse conduces / To gazings which the gazer often rues."
                            },
                            {
                                "example_id": "11bfac4d-2948-43bd-966f-65bff4276955",
                                "sense_id": "431ff49d-0591-3bdc-852c-c8fb8d1b6de5",
                                "text": "To make matters worse, we pass through a torrential rainstorm, which makes window-gazing almost impossible, leaving me glad that the trip is less than 30 minutes duration."
                            }
                        ]
                    }
