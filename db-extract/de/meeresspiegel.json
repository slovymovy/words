                    {
                        "translation_id": "c64a747d-2adc-4d30-8478-9f8a8ece004f",
                        "source_entry_id": "5f0f1256-0f8b-3bcc-8469-e49f7b1e5747",
                        "source_sense_id": "316115dd-9d16-3df6-8e12-43fa80a349ca",
                        "source_sense_description": "Höhe des Wasserstandes des Meeres",
                        "target_lang_word": "zeespiegel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeespiegel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8615b767-497f-3e8b-b92f-cf37252e722c",
                                        "entry_id": "060a1309-980b-3545-b38d-e06a777c4bf0",
                                        "glosses": [
                                            "de oppervlakte van de zee, het zeeoppervlak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1daec3-89b7-4c88-99f7-b8f9823730ee",
                                                "sense_id": "8615b767-497f-3e8b-b92f-cf37252e722c",
                                                "text": "\"Het KNMI heeft verschillende scenario's geschetst van hoeveel de zeespiegel stijgt. In het meest sombere scenario staat het zeewater aan het eind van deze eeuw twee tot drie meter hoger\", zegt gepensioneerd ingenieur van Rijkswaterstaat Frank Spaargaren. En op de vraag of de keringen in onze Deltawerken daarop berekend zijn, \"is het antwoord nee\", zo zegt hij."
                                            },
                                            {
                                                "example_id": "67ab15d0-0915-472f-9e14-1390e0fe7ea3",
                                                "sense_id": "8615b767-497f-3e8b-b92f-cf37252e722c",
                                                "text": "Wonen op drie meter onder zeeniveau (NAP) is heel wat anders dan lopen op duizend meter boven de zeespiegel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff5216a5-5767-4530-aa05-5d3d59c5fd3b",
                        "source_entry_id": "5f0f1256-0f8b-3bcc-8469-e49f7b1e5747",
                        "source_sense_id": "316115dd-9d16-3df6-8e12-43fa80a349ca",
                        "source_sense_description": "Höhe des Wasserstandes des Meeres",
                        "target_lang_word": "zeeniveau",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeeniveau",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "582705fe-7a01-3071-91ed-4ceb34fc8ec0",
                                        "entry_id": "b1218ecb-279a-30d4-a901-41c1ec6e549a",
                                        "glosses": [
                                            "hoogte van de zeespiegel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a2d53b-fee1-4a3d-a2eb-ec52158fb95e",
                                                "sense_id": "582705fe-7a01-3071-91ed-4ceb34fc8ec0",
                                                "text": "Na een tijdje merkte ik duidelijk aan mijn oren dat we van zeeniveau naar duizend meter hoogte aan het klimmen waren."
                                            },
                                            {
                                                "example_id": "27524281-2e6b-42e3-b61b-d2bb9e442a95",
                                                "sense_id": "582705fe-7a01-3071-91ed-4ceb34fc8ec0",
                                                "text": "Het voordeel van Leningrad was dat je het onder de radar aan kon vallen, slechts tien meter boven het zeeniveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89f9f677-7b1d-4174-ad6f-92010a5bdd27",
                        "source_entry_id": "5f0f1256-0f8b-3bcc-8469-e49f7b1e5747",
                        "source_sense_id": "316115dd-9d16-3df6-8e12-43fa80a349ca",
                        "source_sense_description": "Höhe des Wasserstandes des Meeres",
                        "target_lang_word": "poziom morza",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poziom morza",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "98a918a9-7131-3a60-8206-ef0f7c2fb939",
                                        "entry_id": "e09d80ea-cb34-3efd-afdd-fcc60b700273",
                                        "glosses": [
                                            "umowny punkt wyjścia do pomiarów wysokości lub głębokości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3971d03e-9fe2-42d4-a26b-4c588d10f506",
                                                "sense_id": "98a918a9-7131-3a60-8206-ef0f7c2fb939",
                                                "text": "Jesteśmy już na kilka tysięcy stóp nad poziomem morza, jakkolwiek prawie nigdzie nie można dostrzec, żeby pociąg szedł pod górę."
                                            },
                                            {
                                                "example_id": "523eb367-79c9-492a-9746-2e3af3e90783",
                                                "sense_id": "98a918a9-7131-3a60-8206-ef0f7c2fb939",
                                                "text": "Konsekwencją ocieplenia klimatu jest podniesienie się poziomu morza, które stanowi ogromny problem dla krajów insularnych, których wysokość rzadko sięga powyżej kilkudziesięciu m n.p.m."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
