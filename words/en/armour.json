                    "synonyms": [
                        "armor",
                        "protective covering",
                        "shielding"
                    ],
                    "common_phrases": [
                        "body armour",
                        "suit of armour",
                        "plate armour",
                        "chink in one's armour"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитное покрытие, обычно из металла или прочных материалов, используемое для предотвращения ранений в бою или при выполнении опасных задач.",
                        "nl": "Een beschermende laag of kleding, meestal van metaal of ander stevig materiaal, om verwondingen in de strijd of gevaarlijke situaties te voorkomen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "броня",
                                "target_lang_sense_clarification": "общее название защитного покрытия техники или тела"
                            },
                            {
                                "target_lang_word": "доспехи",
                                "target_lang_sense_clarification": "историческое защитное снаряжение рыцарей или воинов"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "harnas",
                                "target_lang_sense_clarification": "historische metalen bescherming van een ridder"
                            },
                            {
                                "target_lang_word": "pantser",
                                "target_lang_sense_clarification": "algemene beschermende laag of bepantsering"
                            }
