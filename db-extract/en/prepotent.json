        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "eb472f20-5194-3619-8f49-800e5c659bd5",
                "word": "prepotent",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75384779-8e65-3092-bd9d-23577736af06",
                        "entry_id": "eb472f20-5194-3619-8f49-800e5c659bd5",
                        "glosses": [
                            "Very powerful; superior in force, influence, or authority; predominant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7007852f-150b-4fc5-b0b5-2592d42c5117",
                                "sense_id": "75384779-8e65-3092-bd9d-23577736af06",
                                "text": "To ordre his subiectes after true iustice / As a prepotent prince"
                            },
                            {
                                "example_id": "40a93c48-2f9b-4ba8-b039-edd7aa6b3636",
                                "sense_id": "75384779-8e65-3092-bd9d-23577736af06",
                                "text": "[…] Jeff’s eyes were dry, though his face was discharged of all its prepotent impudence."
                            },
                            {
                                "example_id": "cb9e18a8-07eb-4edf-a493-8275d389a9bb",
                                "sense_id": "75384779-8e65-3092-bd9d-23577736af06",
                                "text": "[…] if they had subordinated themselves, docilely and automatically, to the prepotent social and academic figures of the society about them, that in no wise detracted from the favorable impression they had made on her."
                            },
                            {
                                "example_id": "35fd90db-58f2-4e9c-8e0c-5f8967b73a17",
                                "sense_id": "75384779-8e65-3092-bd9d-23577736af06",
                                "text": "[…] the exigencies of awareness are that we focus on certain dimensions of the objects before us, make certain ways of seeing them prepotent."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf20da7c-ed5a-3322-926f-97aa7aa2db27",
                        "entry_id": "eb472f20-5194-3619-8f49-800e5c659bd5",
                        "glosses": [
                            "Characterized by prepotency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ba627d-cc88-439e-9b1e-8044cd1aed8e",
                                "sense_id": "bf20da7c-ed5a-3322-926f-97aa7aa2db27",
                                "text": "When one parent alone displays some of the newly-acquired and generally inheritable character, and the offspring do not inherit it, the cause may lie in the other parent having the power of prepotent transmission."
                            },
                            {
                                "example_id": "c3ec488c-b81e-432b-94a8-29fb77cd8404",
                                "sense_id": "bf20da7c-ed5a-3322-926f-97aa7aa2db27",
                                "text": "[…] the mother strain, if not prepotent in the sense of science, seems to me to have outweighed that of any other relative of whom we have record."
                            }
                        ]
                    }
                ],
