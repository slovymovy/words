                    {
                        "sense_id": "da32a279-649a-3f64-9ced-f6e1fcdb6400",
                        "entry_id": "e2547127-ef04-3651-9c86-81bf717a8846",
                        "glosses": [
                            "kobieta, która wydaje wyroki w sądzie"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "869a8d0a-d2b7-4cec-82ea-2000240a51aa",
                                "sense_id": "da32a279-649a-3f64-9ced-f6e1fcdb6400",
                                "text": "Wystudiowany szloch powódki ani przez chwilę nie zwiódł doświadczonej sędziny."
                            },
                            {
                                "example_id": "85a2edbd-1fad-4fb3-ac6c-ccbe8a9c10a1",
                                "sense_id": "da32a279-649a-3f64-9ced-f6e1fcdb6400",
                                "text": "Na mojej sprawie rozwodowej czułem się jak jakiś najgorszy element aspołeczny. Sędzina mnie pyta, czy piłka nożna jest dla mnie ważniejsza niż moja żona."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
