                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team secured a <w>statement</w> victory against the league leaders last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером команда одержала <w>громкую</w> победу над лидерами лиги.",
                                "tr": "Takım dün gece lig liderine karşı <w>iddialı</w> bir galibiyet elde etti."
