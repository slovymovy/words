                "senses": [
                    {
                        "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                        "entry_id": "100a3b7e-9681-33b0-983b-7c1141bd0b14",
                        "glosses": [
                            "Person, die Wald nach ökonomischen Grundsätzen bewirtschaftet oder bewirtschaften lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81468cc5-b8bd-49ec-9008-d567da456b5c",
                                "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                "text": "„Die Wildschweinpopulation stellt seit Jahren ein zunehmendes Problem für Land- und Forstwirte dar.“"
                            },
                            {
                                "example_id": "9275559c-4962-4067-be7a-e1def46e1f09",
                                "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                "text": "„Die Forstwirte betrachteten es als gefährlich und zerstörerisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "732da76d-e23b-3a27-96ee-95be5244c7c8",
                        "entry_id": "100a3b7e-9681-33b0-983b-7c1141bd0b14",
                        "glosses": [
                            "staatlich anerkannter Ausbildungsberuf für einen Waldarbeiter in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0a619b-768e-4f24-9ec9-202955e4babf",
                                "sense_id": "732da76d-e23b-3a27-96ee-95be5244c7c8",
                                "text": "„Ein Forstwirt führt alle anfallenden Tätigkeiten im Forstbetrieb (Waldarbeit) aus, von der Begründung neuer Waldbestände bis zur Holzernte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
