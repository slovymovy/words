                        ]
                    },
                    {
                        "translation_id": "8eea5687-353e-4159-bf50-12584818ca00",
                        "source_entry_id": "e6a78a5c-1244-3933-b191-b04799f555d9",
                        "source_sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
                        "target_lang_word": "robustness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robustness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                        "entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                                        "glosses": [
                                            "The quality of being robust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b75165-7a18-409b-b0b4-5e32c5846dba",
                                                "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                                "text": "Robustness was considered to be an essential feature because of the comparatively high starting effort and the generally rough work for which the locomotives are to be used."
                                            },
                                            {
                                                "example_id": "8bd3cd99-5bae-4b06-a79e-602b1e07f692",
                                                "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                                "text": "The Inspecting Officer draws attention to the remarkable way in which the train held together after the final derailment; this was due in no small measure to the robustness of the buckeye couplings fitted to the coaches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ddeceef-e6f1-4e5b-8d26-627d8f539ea7",
                        "source_entry_id": "e6a78a5c-1244-3933-b191-b04799f555d9",
                        "source_sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
                        "target_lang_word": "courage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The quality of being confident, not afraid or easily intimidated, but without being incautious or inconsiderate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b353f3f-4f3a-4761-9749-392d73548b3d",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "A great part of courage is the courage of having done the thing before."
                                            },
                                            {
                                                "example_id": "9a657da2-9fef-4405-9f52-9485ca4e917a",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "There is a stubbornness about me that never can bear to be frightened at the will of others. My courage always rises at every attempt to intimidate me."
                                            },
                                            {
                                                "example_id": "b4be87e1-43eb-44b9-9360-44ded218bd70",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "It takes a lot of courage to be successful in business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The ability to overcome one's fear, do or live things which one finds frightening."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df93de8-46c6-4591-a43d-2cd69a183f44",
                                                "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                                "text": "He plucked up the courage to tell her how he felt."
                                            },
                                            {
                                                "example_id": "afa74805-5552-49f1-8618-b7d3a970bf01",
                                                "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                                "text": "Courage is resistance to fear, mastery of fear—not absence of fear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The ability to maintain one's will or intent despite either the experience of fear, frailty, or frustration; or the occurrence of adversity, difficulty, defeat or reversal. Moral fortitude."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecb03c0-b960-4f81-abae-f078fe64ce20",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "“Courage is not simply one of the virtues but the form of every virtue at the testing point, which means at the point of highest reality.”"
                                            },
                                            {
                                                "example_id": "65b4e4b6-a6b2-4791-9278-cfe48e886ae1",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "I wanted you to see what real courage is, instead of getting the idea that courage is a man with a gun in his hand. It's when you know you're licked before you begin, but you begin anyway and see it through no matter what."
                                            },
                                            {
                                                "example_id": "151d52c3-76a5-4403-9b39-ece09f2f7928",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "Courage isn't having the strength to go on - it is going on when you don't have strength."
                                            },
                                            {
                                                "example_id": "3a40a8b8-d3a3-4d2c-b565-bb77172b4f1b",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "2008, Maya Angelou, address for the 2008 Cornell University commencement\nCourage is the most important of all the virtues because without courage, you can't practice any other virtue consistently."
                                            },
                                            {
                                                "example_id": "49791790-df56-4ddd-acfd-fd8987fdb2bb",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "I hope you live a life you’re proud of. If you find that you’re not, I hope you have the courage to start all over again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                        "entry_id": "8abb55a0-abb8-3084-ad11-f0e20171d040",
                                        "glosses": [
                                            "To encourage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d4a34c-9ad8-4a9e-9aad-a0d010baf4f8",
                                                "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                                "text": "And wete yow wel sayd kynge Arthur vnto Vrres syster I shalle begynne to handle hym and serche vnto my power not presumyng vpon me that I am soo worthy to hele youre sone by my dedes / but I wille courage other men of worshyp to doo as I wylle doo"
                                            },
                                            {
                                                "example_id": "7caf610b-b4f2-469d-961b-e18b32573b02",
                                                "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                                "text": "Paul writeth unto Timothy, to instruct him, to teach him, to exhort, to courage him, to stir him up,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf4af066-ebf1-4f86-a547-020d1d6ae3b9",
                        "source_entry_id": "e6a78a5c-1244-3933-b191-b04799f555d9",
                        "source_sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
                        "target_lang_word": "strength",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strength",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The quality or degree of being strong."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df294d46-6f40-4d19-9e1e-18aa218c807c",
                                                "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                                "text": "It requires great strength to lift heavy objects."
                                            },
                                            {
                                                "example_id": "e11da1eb-0cf8-4d73-aa3f-67bd6369cb68",
                                                "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                                "text": "Our castle’s strength will laugh a siege to scorn."
                                            },
                                            {
                                                "example_id": "80894fcd-14c3-4b79-b56f-4df35485a865",
                                                "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The intensity of a force or power; potency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c0cdef7-3902-48f5-b941-d079e67a0182",
                                                "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                                                "text": "He had the strength of ten men."
                                            },
                                            {
                                                "example_id": "8e628716-2e77-464b-9dbb-21c2ba1f5124",
                                                "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d004da12-b103-3390-a88a-a97ba4b42d65",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The strongest part of something; that on which confidence or reliance is based."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb62489-b14d-45e2-914c-d4f1be5034a8",
                                                "sense_id": "d004da12-b103-3390-a88a-a97ba4b42d65",
                                                "text": "God is our refuge and strength, a very present help in trouble."
                                            },
                                            {
                                                "example_id": "724af0e9-c233-4cf3-b922-256758c8758b",
                                                "sense_id": "d004da12-b103-3390-a88a-a97ba4b42d65",
                                                "text": "[…] certainly there is not in the world a greater strength against temptations, then is deposited in an obedient understanding […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "A positive attribute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc33dcd-11eb-4170-a7c6-b60e26d21acf",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "to play to one's strengths"
                                            },
                                            {
                                                "example_id": "5002f008-cfe9-46dc-b6ea-0322881cf6ef",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "We all have our own strengths and weaknesses."
                                            },
                                            {
                                                "example_id": "784792e4-6f4f-46c1-a18a-eb63f6d1a814",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "The compulsion to expose, renegotiate, or reinvent the strengths and weaknesses of dance tradition offers little in its final outcome to attract the average dance-goer."
                                            },
                                            {
                                                "example_id": "f981f79b-5fa4-4336-875b-b866e4051851",
                                                "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                                                "text": "Career diplomat Conrad Tribble said on Twitter that multiculturalism “is one of our greatest strengths as a country, and I go to that well often as an American diplomat. It’s hard to overstate the global soft power impact of America’s cultural diversity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91f70b2-cbaf-3bfd-93f1-6e9c039cfcfe",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "An armed force, a body of troops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e189e6d8-a6cd-4d07-88fb-7a71f86fdfab",
                                                "sense_id": "c91f70b2-cbaf-3bfd-93f1-6e9c039cfcfe",
                                                "text": "Thou princely leader of our English strength,\nNever so needful on the earth of France,"
                                            },
                                            {
                                                "example_id": "0b71fb22-9425-4a48-ac03-011deb3f5a09",
                                                "sense_id": "c91f70b2-cbaf-3bfd-93f1-6e9c039cfcfe",
                                                "text": "That done, dissever your united strengths,\nAnd part your mingled colours once again;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7e4c36-1ec8-3a3a-bc1c-93da5f07ba6d",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "A strong place; a stronghold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd6807a-048d-4da0-8011-db99ea4b1496",
                                                "sense_id": "ef7e4c36-1ec8-3a3a-bc1c-93da5f07ba6d",
                                                "text": "All like himself rebellious, by whose aid\nThis inaccessible high strength, the seat\nOf Deitie supream, us dispossest,\nHe trusted to have seis’d […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f7499d-f85b-3506-b24b-9602a9223cc0",
                                        "entry_id": "6e081e00-4b81-3146-a95d-f987d5907193",
                                        "glosses": [
                                            "The minimum ratio of the number of edges removed from a given graph to components created, over all possible removals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "strength",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                        "entry_id": "eeadaa95-45ce-3496-bc8b-5417bd3cfcdb",
                                        "glosses": [
                                            "To strengthen (all senses)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208be12b-2bf7-4de1-b26e-d817e8e20a9a",
                                                "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                                "text": "ſtrengthed with all myght / thꝛowe hys gloꝛious power / vnto all pacience / and longe ſufferynge with ioyfulnes"
                                            },
                                            {
                                                "example_id": "18b3e966-019f-4ddf-b60b-40e9e551b1fa",
                                                "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                                "text": "Then ſhalt thow perceave what it meaneth that the power of this wretched monſtre / muſt be ſtrengthed / by anothers power and not by his awne."
                                            },
                                            {
                                                "example_id": "3bc6bcd4-1a3b-4ae5-8e63-c635e0b308ad",
                                                "sense_id": "1c382cf6-b0d0-3cb3-abcd-aed3ee53959f",
                                                "text": "In witnes wherof we haue cauſed this pꝛeſent wꝛiting to be ſtrengthed with the ſeal of our facultie[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
