                                "target_word": "Pisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a36ad6b7-3565-3bce-adaa-05591659ea23",
                                        "entry_id": "a54e5056-6fea-333b-bbfc-1d56b40c5045",
                                        "glosses": [
                                            "flüssige Ausscheidung der Blase, Urin"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b633351-b718-4576-a3f9-28c116ca110c",
                                                "sense_id": "a36ad6b7-3565-3bce-adaa-05591659ea23",
                                                "text": "Glaubst du etwa, ich werde hier die ganze Pisse am Boden wegwischen?"
                                            },
                                            {
                                                "example_id": "edce75fb-5c14-4766-a380-1c9680fc8bae",
                                                "sense_id": "a36ad6b7-3565-3bce-adaa-05591659ea23",
                                                "text": "„Die Pisse floß mir warm am linken Bein runter, innen am Oberschenkel und am Knie vorbei.“"
                                            },
                                            {
                                                "example_id": "a8cc9378-82a7-4613-8889-3ad599be5d19",
                                                "sense_id": "a36ad6b7-3565-3bce-adaa-05591659ea23",
                                                "text": "„Frustriert nahm er die nächstbeste Flasche, die er finden konnte, und schrubbte sich mit einer großen Bürste die Pisse von der Hose.“"
                                            },
                                            {
                                                "example_id": "355393ae-53f9-4db7-8240-6fe0a22a70df",
                                                "sense_id": "a36ad6b7-3565-3bce-adaa-05591659ea23",
                                                "text": "„Normalerweise stinkt es nach Diesel, aber jetzt ist es wohl auch Angstschweiß, der hier stinkt, und dazu wer weiß was alles – Pisse vor allem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3715bcc-049d-3e35-a976-66ef97500060",
                                        "entry_id": "a54e5056-6fea-333b-bbfc-1d56b40c5045",
                                        "glosses": [
                                            "ein Geschehen, Zustand, Umstand, der jemandem gar nicht gefällt"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5967006-6793-4379-be77-c62d73a27503",
                                                "sense_id": "e3715bcc-049d-3e35-a976-66ef97500060",
                                                "text": "Diese ganze Pisse kotzt mich einfach nur an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
