                "forms": [
                    {
                        "form_id": "c788e17d-8e0c-4ecb-b1d8-d1f0d7ea0969",
                        "entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "micro-trottoirs"
                    },
                    {
                        "form_id": "90a63ced-e40c-4493-a173-a2fd9bb8ce70",
                        "entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "tags": [],
                        "form": "microtrottoir"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
                        "entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "glosses": [
                            "Technique qui consiste à interroger des personnes, le plus souvent dans la rue, pour leur poser des questions et collecter leur opinion spontanée sur un sujet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2af47e9-604f-4927-9efb-ec721913ec80",
                                "sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
                                "text": "Passée à la moulinette uniforme du micro-trottoir, l'opinion falsifiée de Monsieur X n'est plus qu'une façon dont la société tout entière prend conscience d'elle-même. La meilleure preuve en est que, quand le micro-trottoir donne la parole aux voisins d'un type dont on découvre, contre contre toute attente, qu'il est un criminel, ces derniers s'étonnent à l'unisson que le type en en question ait eu jusqu'ici un comportement tout à fait « normal », […]."
                            },
                            {
                                "example_id": "c6f901ef-9c77-4914-a2ff-8b4f312108ce",
                                "sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
                                "text": "Les radios et les télévisions du paysage audiovisuel français font un abondant usage de la pratique dite des \"micro-trottoirs\": on interroge les passants dans la rue sur un sujet d'actualité. C'est ainsi que nos médias sont censés (en dehors des sondages) recueillir l'opinion du bon peuple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a60de3-4e4d-4f3d-84f0-08091dab13fa",
                        "source_entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "source_sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
