        "fr-extract.jsonl": [
            {
                "entry_id": "4e5b1f45-d301-3dd3-9893-683e31692d3b",
                "word": "Rouen",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9b6290e-7478-3bfd-8e4a-c681bd4e97a0",
                        "entry_id": "4e5b1f45-d301-3dd3-9893-683e31692d3b",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département de la Seine-Maritime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de5effd-1965-42c8-a2fd-1ca352e13a14",
                                "sense_id": "c9b6290e-7478-3bfd-8e4a-c681bd4e97a0",
                                "text": "À Rouen, les autorités firent savoir que ceux qui n’accepteraient pas le baptême seraient considérés comme hors-la-loi."
                            },
                            {
                                "example_id": "489b5760-992a-4d8c-8d61-f8ed92c38e51",
                                "sense_id": "c9b6290e-7478-3bfd-8e4a-c681bd4e97a0",
                                "text": "Le lendemain, il prend le château de Damville, à vingt kilomètres de Verneuil, et regagne ensuite Rouen, d’où il envoie aussitôt ses mercenaires en Bretagne, vers Fougères et Dol."
                            },
                            {
                                "example_id": "248b4e8e-fdb9-40c7-8999-52fb39e367f6",
                                "sense_id": "c9b6290e-7478-3bfd-8e4a-c681bd4e97a0",
                                "text": "Nous allâmes en auto à Rouen ; l’après-midi se passa à visiter des églises ; il y en avait beaucoup et chacune déchaînait des délires extatiques ; devant les dentelles de pierre de Saint-Maclou, l’enthousiasme atteignit au paroxysme : quel travail ! quelle finesse !"
                            },
                            {
                                "example_id": "08c09ac1-10bc-4ab8-9dd0-71802845fd19",
                                "sense_id": "c9b6290e-7478-3bfd-8e4a-c681bd4e97a0",
                                "text": "Le groupe est mené au siège de la 3ᵉ légion de gendarmerie à Rouen, où l’on regroupe tous les Juifs arrêtés dans l’Eure lors de la rafle du 13 juillet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0176410-d320-49e0-859c-190563ca1435",
                        "source_entry_id": "4e5b1f45-d301-3dd3-9893-683e31692d3b",
                        "source_sense_id": "c9b6290e-7478-3bfd-8e4a-c681bd4e97a0",
                        "target_lang_word": "Rouen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rouen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78c1528e-add9-35c2-9f52-8ea61e9522cc",
                                        "entry_id": "5b181816-8087-37ea-8a41-7d17bd074ac3",
                                        "glosses": [
                                            "französische Stadt in der Normandie, an der Seine gelegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5659fb9-b3bf-4b37-a6a4-9de87f62b7e1",
                                                "sense_id": "78c1528e-add9-35c2-9f52-8ea61e9522cc",
                                                "text": "Wenn du nach Rouen fährst, musst du dir die Kathedrale anschauen."
                                            },
                                            {
                                                "example_id": "8adb5c70-58b6-41f9-b3b7-448d8a72bacd",
                                                "sense_id": "78c1528e-add9-35c2-9f52-8ea61e9522cc",
                                                "text": "Der Hafen Rouens liegt 80 Kilometer von der Flussmündung entfernt."
                                            },
                                            {
                                                "example_id": "ddf15066-8ce0-412f-ba21-53f9a9c4329c",
                                                "sense_id": "78c1528e-add9-35c2-9f52-8ea61e9522cc",
                                                "text": "„Unmittelbar nach der Urteilsverkündung vernahm man weder in Rouen noch sonst irgendwo in Frankreich den geringsten Protest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
