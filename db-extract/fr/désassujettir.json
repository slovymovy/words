                ],
                "senses": [
                    {
                        "sense_id": "69da3068-8dc9-3aa7-9f3e-4ef7c42d8804",
                        "entry_id": "b2fc0ad3-3512-388b-a38a-b8d301d3fb80",
                        "glosses": [
                            "Cesser d’assujettir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eea0f13f-16b9-484a-a7c5-14d21e46e695",
                                "sense_id": "69da3068-8dc9-3aa7-9f3e-4ef7c42d8804",
                                "text": "La prétention de la musique à l’audio-analgésie, la désassujettissant à la prédation écrite, l’a restituée à l’hypnose."
                            },
                            {
                                "example_id": "43cb6521-5d65-495e-9873-a7a82a73199b",
                                "sense_id": "69da3068-8dc9-3aa7-9f3e-4ef7c42d8804",
                                "text": "La surface à désassujettir était réduite par rapport à celle proposée par le requérant."
                            },
                            {
                                "example_id": "84fc090d-93b9-4434-983d-1add9d298244",
                                "sense_id": "69da3068-8dc9-3aa7-9f3e-4ef7c42d8804",
                                "text": "Il s'agit rien de moins que de désassujettir le commun de la rareté socialement organisée."
                            },
                            {
                                "example_id": "1088f72e-126a-42e7-8e5f-543e66d84e9b",
                                "sense_id": "69da3068-8dc9-3aa7-9f3e-4ef7c42d8804",
                                "text": "Se désassujettir, c'est donc prendre des risques en regardant le monde autrement."
                            }
                        ]
                    }
                ],
