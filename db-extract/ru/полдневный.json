                "senses": [
                    {
                        "sense_id": "a8b414b4-60c1-3959-a897-7e1cecac656f",
                        "entry_id": "4d8c554f-8f3f-3519-a269-eb053484e9ea",
                        "glosses": [
                            "книжн., поэт. к полдень; связанный с ним || свойственный полдню, характерный для него"
                        ],
                        "tags": [
                            "adjective",
                            "noun"
                        ],
                        "examples": [
                            {
                                "example_id": "29cb1fb3-fe61-4739-ab6c-e51b66813297",
                                "sense_id": "a8b414b4-60c1-3959-a897-7e1cecac656f",
                                "text": "В полдневный жар в долине Дагестана // С свинцом в груди лежал недвижим я"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a0b9914-ef04-3797-9204-82520c6ad621",
                        "entry_id": "4d8c554f-8f3f-3519-a269-eb053484e9ea",
                        "glosses": [
                            "происходящий в полдень"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01c7a276-986f-40ff-b2a8-3f975b047a7d",
                                "sense_id": "5a0b9914-ef04-3797-9204-82520c6ad621",
                                "text": "― Сие изобилие трапез, долгий сон полдневный и малое движение знатных или богатых людей производили их обыкновенную тучность, вменяемую в достоинство: быть дородным человеком значило иметь право на уважение."
                            }
                        ]
                    }
