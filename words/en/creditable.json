{
    "word_family": [
        "credit",
        "creditable",
        "creditably",
        "credibility",
        "credible",
        "increditable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f209c81-8778-3a50-9bfa-4e4214cec46d",
                    "sense_definition": "Deserving praise, approval, or respect, though not necessarily outstanding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praiseworthy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young team put in a very <w>creditable</w> performance against the defending champions.",
                            "target_lang_translations": {
                                "ru": "Молодая команда показала очень <w>достойную</w> игру против действующих чемпионов."
                            }
                        },
                        {
                            "text": "Finishing the marathon in under four hours is a highly <w>creditable</w> effort for a beginner.",
                            "target_lang_translations": {
                                "ru": "Преодоление марафона менее чем за четыре часа — весьма <w>похвальный</w> результат для новичка."
                            }
                        }
                    ],
                    "synonyms": [
                        "commendable",
                        "respectable"
                    ],
                    "common_phrases": [
                        "creditable performance",
                        "creditable effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий похвалы, одобрения или уважения, хотя и не обязательно выдающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достойный похвалы",
                                "target_lang_sense_clarification": "заслуживающий уважения или одобрения"
                            },
                            {
                                "target_lang_word": "похвальный",
                                "target_lang_sense_clarification": "одобряемый, хороший"
                            },
                            {
                                "target_lang_word": "приличный",
                                "target_lang_sense_clarification": "на хорошем, достойном уровне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5f017aa-1b17-34f5-bf2e-183021915c5d",
                    "sense_definition": "Worthy of belief; capable of being believed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "believable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer produced a <w>creditable</w> witness whose testimony convinced the entire jury.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил <w>заслуживающего доверия</w> свидетеля, чьи показания убедили всех присяжных."
                            }
                        },
                        {
                            "text": "There was no <w>creditable</w> explanation for the sudden disappearance of the documents.",
                            "target_lang_translations": {
                                "ru": "Не нашлось ни одного <w>правдоподобного</w> объяснения внезапному исчезновению документов."
                            }
                        }
                    ],
                    "synonyms": [
                        "believable",
                        "credible"
                    ],
                    "antonyms": [
                        "incredible",
                        "unbelievable"
                    ],
                    "common_phrases": [
                        "creditable witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий доверия; правдоподобный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достоверный",
                                "target_lang_sense_clarification": "правдоподобный, внушающий доверие"
                            },
                            {
                                "target_lang_word": "заслуживающий доверия",
                                "target_lang_sense_clarification": "надежный источник или свидетель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a65c2a64-6085-3517-9979-1096a09d16b2",
                    "sense_definition": "Capable of being assigned, attributed, or credited to someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "assignable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Any financial surplus is <w>creditable</w> to the reserve fund at the end of the fiscal year.",
                            "target_lang_translations": {
                                "ru": "Любой финансовый излишек <w>подлежит зачислению</w> в резервный фонд в конце финансового года."
                            }
                        },
                        {
                            "text": "These additional training hours are fully <w>creditable</w> toward your final degree requirements.",
                            "target_lang_translations": {
                                "ru": "Эти дополнительные учебные часы полностью <w>засчитываются</w> в требования для получения диплома."
                            }
                        }
                    ],
                    "synonyms": [
                        "assignable"
                    ],
                    "common_phrases": [
                        "creditable toward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Который может быть зачислен, отнесен на чей-либо счет или учтен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлежащий зачислению",
                                "target_lang_sense_clarification": "о средствах или баллах, которые могут быть засчитаны"
                            },
                            {
                                "target_lang_word": "засчитываемый",
                                "target_lang_sense_clarification": "принимаемый в расчет или зачет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}