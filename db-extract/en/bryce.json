                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76155013-a0ba-30a7-b8f9-053688ebaf97",
                                        "entry_id": "fb84ca95-1aac-30a5-90a0-bf90fd9d6d21",
