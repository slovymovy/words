                                        "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                        "entry_id": "add286a2-8b93-3980-95fe-880dbc0662af",
                                        "glosses": [
                                            "Währung des Deutschen Reiches von 1924 bis 1948"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0997d2b1-219a-44b7-86e6-2adcb6589f42",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "Sein Opa zeigte ihm verschiedene Reichsmark-Münzen."
                                            },
                                            {
                                                "example_id": "210fba42-e32e-45a5-b3ca-f24c6c50a473",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "Während der Weimarer Republik zahlte man mit Reichsmark."
                                            },
                                            {
                                                "example_id": "bbe702ac-5530-46ca-9cd7-8148b10eb44a",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„Aber Zigaretten waren eine Kostbarkeit an sich, pro Stück fünfzehn Reichsmark wert.“"
                                            },
                                            {
                                                "example_id": "443d800b-1b12-4c4e-81cb-a2f44ef00a7f",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„Nunmehr kostete die Fünftagereise, leicht erhöht, fünfundvierzig Reichsmark.“"
                                            },
                                            {
                                                "example_id": "4c46e68d-6334-4036-97fc-357feb572b14",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„Insgesamt hatte Horst 242 Reichsmark angespart.“"
                                            },
                                            {
                                                "example_id": "540e96cc-429b-4997-916c-eefeb3a658c2",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„In meinen betagten, von Flicken verzierten Trainingsanzug werden zweitausend Reichsmark eingenäht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
