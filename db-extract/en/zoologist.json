                                    {
                                        "sense_id": "70b646a4-878f-3e81-8293-68903bd466dd",
                                        "entry_id": "43885baf-7219-3061-9df7-d20c8ec8519d",
                                        "glosses": [
                                            "Synonyme de zoologiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f2bb1d9-f2ae-40b6-9cf2-7ce96956f6d3",
                                                "sense_id": "70b646a4-878f-3e81-8293-68903bd466dd",
                                                "text": "En effet, un zoologue sait, sur les rats, une foule de choses qu’un locuteur normal ignore."
