                "senses": [
                    {
                        "sense_id": "ff6a379b-dd27-3ebb-95e3-996f0bb2e404",
                        "entry_id": "b601fbb9-944d-314c-b372-b936eebe7492",
                        "glosses": [
                            "Pigment colorant des algues bleues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1955a28-d8bd-4fb9-85fa-b43f3c5c8a8d",
                                "sense_id": "ff6a379b-dd27-3ebb-95e3-996f0bb2e404",
                                "text": "La spiruline, de couleur vert foncé, doit sa couleur à un pigment présent dans la microalgue \"Spirulina platensis\", la phycocyanine."
                            },
                            {
                                "example_id": "3ddf31a3-377d-4bb1-b178-208ca57f260a",
                                "sense_id": "ff6a379b-dd27-3ebb-95e3-996f0bb2e404",
                                "text": "La spiruline a ceci de particulier : en plus de la chlorophylle qu’elle possède en abondance, elle fabrique la phycocyanine, un complexe protéique unique qui absorbe une très grande partie du spectre lumineux solaire, chose que ne peuvent faire d’autres plantes."
                            }
                        ]
                    }
                ],
