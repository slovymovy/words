                        "cross_references": [
                            {
                                "target_word": "spit-roast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "426f2b87-32ef-34cc-8ada-f832d2c8d22e",
                                        "entry_id": "47b97b7b-f3bc-33b2-9827-286342d30cb4",
                                        "glosses": [
                                            "To roast (meat) on a spit (“metal or wooden rod”)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6c87a5-7aa1-4efc-8e2e-ba88f817ab75",
                                                "sense_id": "426f2b87-32ef-34cc-8ada-f832d2c8d22e",
                                                "text": "Even the men participated when we spit-roasted a whole lamb for Greek Easter in the American-Greek couple’s backyard."
                                            },
                                            {
                                                "example_id": "e6c89ff7-8cd0-48a6-88c0-a6a89ff32294",
                                                "sense_id": "426f2b87-32ef-34cc-8ada-f832d2c8d22e",
                                                "text": "Last summer we spit-roasted a baby lamb (slaughtered the day before) over a birch fire at our camp in the Rangeley Lake region of Maine."
                                            },
                                            {
                                                "example_id": "cdf0ca7d-9e10-4afc-a4e2-7e4fc7ac8660",
                                                "sense_id": "426f2b87-32ef-34cc-8ada-f832d2c8d22e",
                                                "text": "That first night we spit-roasted a goat over wood we burned to embers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e80cf26d-2619-3665-8e00-2ad88e7cfe45",
                                        "entry_id": "47b97b7b-f3bc-33b2-9827-286342d30cb4",
                                        "glosses": [
                                            "To engage in the sexual practice wherein two people penetrate a single sexual partner at the same time, one orally and the other vaginally or anally."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44713bf5-4543-41fd-a8c4-71ab8fbff649",
                        "source_entry_id": "458cbc28-fb55-3e62-ac0b-a7dae9042099",
