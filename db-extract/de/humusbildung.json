                    {
                        "form_id": "021fe2b1-0ecd-48b8-a316-c633c2f746ea",
                        "entry_id": "5685200d-9f7e-3e55-a174-3697fffcd52e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Humusbildungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                        "entry_id": "5685200d-9f7e-3e55-a174-3697fffcd52e",
                        "glosses": [
                            "Zersetzung von organischem Material (vor allem Pflanzenresten) durch Mikroorganismen, Pilze und andere Lebewesen; wichtig für die Bodenfruchtbarkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b4a198-c26f-446d-b20e-cffe033eccc5",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Die Humusbildung des Bodens wird dabei größtenteils durch den Ligninabbau gefördert.“"
                            },
                            {
                                "example_id": "82625e4c-8c5e-4356-8e2e-6508b10a4668",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Regenwürmer sind von großer Bedeutung für die Durchlüftung des Bodens und für die Humusbildung.“"
                            },
                            {
                                "example_id": "2a370c6d-aff1-4683-a6ac-a7c096840968",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "[Fadenwürmer:] „Denn diese winzigen Tierchen sind an der Humusbildung beteiligt.“"
                            },
                            {
                                "example_id": "c196716a-bdb7-42e5-b4ec-025023cc6564",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Zahlreiche Pilze, Insekten und Pflanzen sind auf Totholz angewiesen, zudem trägt der Zersetzungsprozess zur Humusbildung des Waldbodens bei.“"
                            },
                            {
                                "example_id": "495e3f94-c921-4206-adb0-92d97487b62f",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Die Humusbildung geht mit der Entwicklung und Besiedelung des Bodens durch Lebewesen Hand in Hand, denn ohne Bodenleben (Edaphon) gäbe es auch keinen Humus.“"
                            },
                            {
                                "example_id": "3af3199c-10d6-404d-a668-ddca5ba42677",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Die Mykorrhizapilze könnten dabei helfen, Pflanzen besser mit Nährstoffen zu versorgen und den Einsatz von Düngemitteln zu reduzieren. Zudem würden die Pilze die Bodenstruktur verbessern, da sie auf der Suche nach Nährstoffen den Boden durchwuchern und zur Humusbildung beitragen.“"
                            },
                            {
                                "example_id": "c16ac2d9-7083-4722-9f86-c5fe7d1948d4",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Diese Organismen erfüllen, alleine oder in Symbiose mit anderen Lebewesen, wichtige Funktionen im Boden: Sie sind maßgeblich an der Humusbildung und weiteren chemischen Prozessen beteiligt und sorgen außerdem für eine lockere, krümelige Bodenstruktur, die die Puffer- und Speicherkapazität des Bodens erhöht.“"
                            },
                            {
                                "example_id": "df3dead6-b077-406b-aa2e-f728412ee193",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Einmal im Jahr wechselt der Teakholzbaum sein Laub, doch die abgeworfenen Blätter verrotten nur sehr langsam, was die Humusbildung erschwert.“"
                            },
                            {
                                "example_id": "ae5ab92a-0f11-431a-85df-141546657277",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "[…] „die Vision von Ulf Karsten ist es, die Reste der Algen-Biomasse als Düngerersatz einzusetzen. »Das würde die Humusbildung im Boden anregen und die Bodenfruchtbarkeit steigern.«“"
                            },
                            {
                                "example_id": "958d0649-1f66-4bb2-a3b4-42e169da951c",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "[Landwirtschaft:] „Reduzierte Bodenbearbeitung erhält die Bodenstruktur und führt zu mehr Humusbildung.“"
                            },
                            {
                                "example_id": "4a8c3aba-0890-4bba-9ea6-82e772cfb828",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "[Landwirtschaft:] „Außerdem fördern ökologische Anbaumethoden die Humusbildung und die Artenvielfalt im Boden. In den Feldern der Ökobauern leben beispielsweise deutlich mehr Regenwürmer als im konventionellen Landbau – die Böden sind dadurch fruchtbarer.“"
                            },
                            {
                                "example_id": "83cf21f0-f8bf-4604-aa04-220871af5e4f",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„In Urwäldern ist die organische Substanz, die für die Humusbildung zur Verfügung steht, besonders hoch, da alle Bäume nach dem Absterben zersetzt werden und letztendlich die Humusvorräte aufbauen.“"
                            },
                            {
                                "example_id": "a0500765-3fc8-4053-b80a-0fa94f57616f",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Eine Bedeutung der organischen Dünger liegt in der Rückführung organischer Substanz in den Boden als Nahrung für die Bodenlebewesen und als Ausgangsstoff für die Humusbildung.“"
                            },
                            {
                                "example_id": "b927a4ef-3e8e-4721-b179-80bb124175de",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "Die Humusbildung entlastet die Atmosphäre für jede Tonne gebildeten Humus um 1,8 Tonnen CO₂."
                            },
                            {
                                "example_id": "9e46f01c-1eee-49e2-bb0d-873a03e5df80",
                                "sense_id": "51c5d113-d09b-3beb-899d-bcd34a924794",
                                "text": "„Der IPCC hält Maßnahmen für das Binden von CO2 aus der Atmosphäre für notwendig. Dies wäre möglich mit Humusbildung in den Böden, durch Renaturierung von Mooren und Wiederaufforstungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
