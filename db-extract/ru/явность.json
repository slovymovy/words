                                "target_senses": [
                                    {
                                        "sense_id": "9f0195ee-d734-31fb-86fc-0af31cb1ab28",
                                        "entry_id": "c72d2f8e-d821-3e27-b96b-e449a5b92d17",
                                        "glosses": [
                                            "Obviously true by simple observation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ecdf01-e024-41f0-a2fb-95820bd8d863",
                                                "sense_id": "9f0195ee-d734-31fb-86fc-0af31cb1ab28",
                                                "text": "It was evident she was angry, after she slammed the door."
                                            },
                                            {
                                                "example_id": "33ff7502-5446-4877-86bc-d88ea370683c",
                                                "sense_id": "9f0195ee-d734-31fb-86fc-0af31cb1ab28",
                                                "text": "Maccario, it was evident, did not care to take the risk of blundering upon a picket, and a man led them by twisting paths until at last the hacienda rose blackly before them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f845decf-b3b3-4897-b7d4-ecd22d6b13b5",
                        "source_entry_id": "35c857a9-4a7b-3258-9a2e-4053382f336b",
                        "source_sense_id": "7e542e50-c592-34f7-893e-c667a985d3e6",
                        "target_lang_word": "explicit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                                        "entry_id": "9066de5f-257c-3a07-835e-7d47e4bcb2db",
                                        "glosses": [
                                            "Very specific, clear, or detailed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca141c97-36ff-41d0-b698-886b9fa847ac",
                                                "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                                                "text": "I gave explicit instructions for him to stay here, but he followed me, anyway."
                                            },
                                            {
                                                "example_id": "fa9c926a-c121-4669-846a-0cacd63aa643",
                                                "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                                                "text": "If the task is indeed a difficult one, it may be worthwhile to attempt an explicit statement as to those aspects of the endeavor that appear to have the greatest importance for success or failure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                                        "entry_id": "9066de5f-257c-3a07-835e-7d47e4bcb2db",
                                        "glosses": [
                                            "Containing material (e.g. language or film footage) that might be deemed offensive or graphic through clear and direct expressions."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd99caf-d057-4718-a761-1d1015ce7185",
                                                "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                                                "text": "The film had several scenes including explicit language and sex."
                                            },
                                            {
                                                "example_id": "8641965d-5a34-4ad1-b677-77bf5a519f8d",
                                                "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                                                "text": "Cerberus Scientist: I'm sorry, sir. None of Normandy's surveillance feeds have been responding since Shepard went rogue.\nIllusive Man: I want it back. Retry the remote lockdown protocols.\nCerberus Scientist: After our last attempt, EDI flooded our server with seven zettabytes of explicit images. I think she was making a joke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "explicit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "112b7670-c421-32ab-8dd2-c5e2d7ab7a2a",
                                        "entry_id": "5bb6f82a-a8f7-366f-bace-4f0f2f6067bf",
                                        "glosses": [
                                            "The final few words of a text."
