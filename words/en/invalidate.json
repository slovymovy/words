{
    "word_family": [
        "invalid",
        "valid",
        "validity",
        "validation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17217254-d0fe-3ed5-9f47-dc7c2227d7e4",
                    "sense_definition": "To make something legally or officially void or ineffective.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "nullify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>invalidate</w> the contract because it was signed under pressure.",
                            "target_lang_translations": {
                                "zh": "法官决定<w>作废</w>这份合同，因为它是受压迫下签署的。"
                            }
                        },
                        {
                            "text": "New evidence may <w>invalidate</w> the previous court ruling.",
                            "target_lang_translations": {
                                "zh": "新的证据可能会使之前的法院裁决<w>失效</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "negate",
                        "vitiate"
                    ],
                    "antonyms": [
                        "validate"
                    ],
                    "common_phrases": [
                        "invalidate a contract",
                        "invalidate a claim"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某事物在法律上或官方层面失效或无效。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "作废",
                                "target_lang_sense_clarification": "指使文件、合同或证件失去效力。"
                            },
                            {
                                "target_lang_word": "使无效",
                                "target_lang_sense_clarification": "指通过法律或行政手段取消某事物的效力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2061c97e-64c0-3d61-8b98-83339611563f",
                    "sense_definition": "To prove that an argument, theory, or statement is incorrect or unsound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nullify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist conducted experiments to <w>invalidate</w> the outdated theory.",
                            "target_lang_translations": {
                                "zh": "科学家进行了实验以<w>推翻</w>那项过时的理论。"
                            }
                        },
                        {
                            "text": "New data helped to <w>invalidate</w> his earlier claims about the climate.",
                            "target_lang_translations": {
                                "zh": "新的数据有助于<w>驳倒</w>他早先关于气候的说法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disprove",
                        "negate"
                    ],
                    "antonyms": [
                        "validate"
                    ],
                    "common_phrases": [
                        "invalidate an argument",
                        "invalidate a theory"
                    ],
                    "target_lang_definitions": {
                        "zh": "证明某种论点、理论或陈述是不正确或站不住脚的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驳倒",
                                "target_lang_sense_clarification": "指通过论证证明对方的观点错误。"
                            },
                            {
                                "target_lang_word": "推翻",
                                "target_lang_sense_clarification": "指证明旧有的理论或结论不再成立。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be9c8922-17d2-374d-904b-ffdcd4273964",
                    "sense_definition": "To show that someone's feelings or experiences are not valid or important.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nullify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ignoring a child's concerns can <w>invalidate</w> their emotional development.",
                            "target_lang_translations": {
                                "zh": "忽视孩子的担忧可能会<w>否定</w>他们的情感发展。"
                            }
                        },
                        {
                            "text": "It is harmful to <w>invalidate</w> the experiences of others during a difficult time.",
                            "target_lang_translations": {
                                "zh": "在他人困难时期<w>否定</w>他们的经历是有害的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "invalidate feelings",
                        "invalidate experiences"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出对他人的感受或经历不予认可或认为其不重要。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "否定",
                                "target_lang_sense_clarification": "指不承认他人的感受或经历的价值。"
                            },
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "指对他人的情感体验表现出不重视的态度。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}