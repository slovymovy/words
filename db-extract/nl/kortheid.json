                                    {
                                        "sense_id": "05341dfe-fd46-3d03-8787-d18cb204cee9",
                                        "entry_id": "7e44359e-42fb-3547-b1de-dc9cfb5b76bb",
                                        "glosses": [
                                            "The quality of being brief in duration."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cce1ecc-dd5f-4bbd-8097-0f292bf9686e",
                                                "sense_id": "05341dfe-fd46-3d03-8787-d18cb204cee9",
                                                "text": "Thanks to Global Positioning Systems we can see that Europe and North America are parting at about the speed a fingernail grows—roughly two yards in a human lifetime. If you were prepared to wait long enough, you could ride from Los Angeles all the way up to San Francisco. It is only the brevity of lifetimes that keeps us from appreciating the changes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                        "entry_id": "7e44359e-42fb-3547-b1de-dc9cfb5b76bb",
                                        "glosses": [
                                            "Succinctness; conciseness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df726c3f-a125-40f0-a6d9-2d17e7829b55",
                                                "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                                "text": "[B]revity is the soul of wit,\nAnd tediousness the limbs and outward flourishes[.]"
                                            },
                                            {
                                                "example_id": "c443b0e8-7f3a-46d0-87eb-f3fe107643cb",
                                                "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                                "text": "Whenever a public question comes to such a crisis that the opportunities for individual intervention are reduced to the smallest possible compass, Mr. Roebuck is sure to step in with a formula, summing up the case with indignant brevity, censuring somebody, or panegyrizing somebody."
                                            },
                                            {
                                                "example_id": "6a769530-913f-4f76-a339-3c92bdd7f1a2",
                                                "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                                "text": "A good technical writing style will now be defined as a style possessing clarity, brevity, and variety."
                                            }
                                        ]
                                    },
