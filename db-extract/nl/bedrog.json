                            {
                                "example_id": "00c84fc1-ce37-48a2-99e1-b1b2c3a8003b",
                                "sense_id": "259c6ec6-e3ac-310c-b626-7b87d2aa564f",
                                "text": "Deze veelgeroemde wetenschappelijke publicatie berust op bedrog."
                            },
                            {
                                "example_id": "daad0882-d691-48ea-a599-6cf002d2ca46",
                                "sense_id": "259c6ec6-e3ac-310c-b626-7b87d2aa564f",
                                "text": "Het idee om na het tellen terug te keren naar zijn schrijfmachine was weliswaar rationeel, maar ook immoreel. Geen groot bedrog, maar toch bedrog."
                            },
                            {
                                "example_id": "7028d384-3968-46ed-8c73-f18e273c0b97",
                                "sense_id": "259c6ec6-e3ac-310c-b626-7b87d2aa564f",
                                "text": "En haar besluit om Olive te helpen met haar bedrog - de schilderijen naar Malaga brengen, ervoor zorgen dat Sarah bleef denken dat ze van Isaacs hand waren, de zolder schoonhouden - had geleid tot deze niet zo nobele waarheid: dat ze geschilderd wilde worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "120a6c3b-f957-4ed1-bf22-cb0582f60160",
                        "source_entry_id": "83151711-dbb8-3d5d-8f8f-0b3697064759",
