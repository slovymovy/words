                        "cross_references": [
                            {
                                "target_word": "train à grande vitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eae0f60f-c1e2-31f2-960a-0bb0cba813bb",
                                        "entry_id": "2cc0d4df-4c1c-32f7-bf73-968d2846d255",
                                        "glosses": [
                                            "Train circulant à grande vitesse (plus de 200 km/h)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c07e3c40-1d60-43d5-b932-724f9550cb0b",
                                                "sense_id": "eae0f60f-c1e2-31f2-960a-0bb0cba813bb",
                                                "text": "Elle compte sur la nouvelle ligne de train à grande vitesse, ouverte en novembre 2018 entre Casablanca et Tanger, pour attirer de nouveaux clients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "041ca68a-4045-3d43-8fb9-35d1b91dfced",
                                        "entry_id": "2cc0d4df-4c1c-32f7-bf73-968d2846d255",
                                        "glosses": [
                                            "Train à très grande vitesse exploité par la SNCF : le TGV."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "604fe9ef-2e74-466e-8106-f6ac4c15a693",
                                                "sense_id": "041ca68a-4045-3d43-8fb9-35d1b91dfced",
                                                "text": "Le sigle, généralement formé à partir des initiales des lexèmes composant l'appellation, est appelé acronyme. Par exemple, nous ne dirons sans doute pas train à grande vitesse mais TGV."
                                            },
                                            {
                                                "example_id": "f8c511c4-d71d-4986-8e51-56876a8905b5",
                                                "sense_id": "041ca68a-4045-3d43-8fb9-35d1b91dfced",
                                                "text": "Ainsi, il ne serait plus possible de substituer une preuve de vaccination par un résultat négatif à un récent test de dépistage pour fréquenter des lieux comme le restaurant ou utiliser le train à grande vitesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a374a21e-8953-433a-8589-76ca5ec8280c",
                        "source_entry_id": "428dbfae-a0d6-3828-a4bc-a6a127fe0591",
                        "source_sense_id": "5fc9b254-e681-3bf1-8d90-585b35bf2fea",
