                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                        "entry_id": "165bd71e-e546-3546-84b9-6b497e66b0cc",
                                        "glosses": [
                                            "ein Land im Baltikum (Nordeuropa)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dde040c-0a5d-4584-9353-ae0f51c8e43b",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Das heutige Estland ist Europa wieder nähergekommen."
                                            },
                                            {
                                                "example_id": "bb50fc1e-25a0-4637-b6de-435ee8fbe5ee",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Tallinn ist die Hauptstadt von Estland."
                                            },
                                            {
                                                "example_id": "fb42206f-2cea-4cc1-bfa8-cfbd0e09365f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Haupthandelspartner Estlands sind die skandinavischen Nachbarländer Schweden und Finnland sowie die Baltikum-Nachbarstaaten Lettland und Litauen.“"
                                            },
                                            {
                                                "example_id": "492477d2-238f-44ab-97da-eb4b0131f07a",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„In Estland und Litauen entstanden auch Lokalposten: echte Bedarfsbriefe sind jedoch nur wenige bekannt.“"
                                            },
                                            {
                                                "example_id": "1d011b8b-a9b4-48a7-8a08-c09b978dcc3f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Wer in Estland russisch spricht, macht sich verdächtig: der Zuneigung zu Wladimir Putin und seinem neoimperialen Projekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "366bc139-9bb8-4bb5-a7a9-7043091fa79d",
