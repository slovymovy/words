                    "sense_id": "62006b65-771d-3958-986a-45abc9c35bef",
                    "sense_definition": "In an excessive, unwarranted, or undeserved manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excessive_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>unduly</w> harsh when criticizing the team for a minor mistake.",
                            "target_lang_translations": {
                                "zh": "经理在批评团队的一个小错误时表现得<w>过分</w>严厉。"
                            }
                        },
                        {
                            "text": "We should not be <w>unduly</w> concerned about the small fluctuations in the market.",
                            "target_lang_translations": {
                                "zh": "我们不必对市场的微小波动感到<w>过度</w>担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excessively",
                        "unjustifiably",
                        "disproportionately"
                    ],
                    "antonyms": [
                        "justifiably",
                        "moderately"
                    ],
                    "common_phrases": [
                        "not unduly concerned",
                        "unduly harsh"
                    ],
                    "target_lang_definitions": {
                        "zh": "以过分、不必要或不应有的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
