                "senses": [
                    {
                        "sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                        "entry_id": "b4def960-3465-3eaa-8540-1edbfc35aef1",
                        "glosses": [
                            "energia objawiająca się w chęci do pracy i zabawy oraz w szybkości i sprawności w działaniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d82656-fbad-41b8-ac21-a4de6f47a0ad",
                                "sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                                "text": "Pomimo podeszłego wieku wciąż tryskał wigorem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93ae3378-f795-4a06-a028-3a7587d36508",
                        "source_entry_id": "b4def960-3465-3eaa-8540-1edbfc35aef1",
                        "source_sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                        "target_lang_word": "vigour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "544f2ca8-5fb7-3918-8bcc-830768561fef",
                                        "entry_id": "f858a1dc-a183-3441-ba3e-46eebcb6849e",
                                        "glosses": [
                                            "Active strength or force of body or mind; capacity for exertion, physically, intellectually, or morally; energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd4bf82-31b6-4f7b-a5e0-f8f7d5e783e6",
                                                "sense_id": "544f2ca8-5fb7-3918-8bcc-830768561fef",
                                                "text": "The vigour of this arm was never vain"
                                            },
                                            {
                                                "example_id": "b4afd85d-4d42-457d-b685-d905c38f7c1f",
                                                "sense_id": "544f2ca8-5fb7-3918-8bcc-830768561fef",
                                                "text": "A compound of eggs boiled with myrrh, pepper, and cinnamon, taken on several successive days, is recommended by Arabs for strengthening amorous vigor."
                                            },
                                            {
                                                "example_id": "2a2be4b7-01fc-479f-abe2-302fa2f2b5ad",
                                                "sense_id": "544f2ca8-5fb7-3918-8bcc-830768561fef",
                                                "text": "Mr. Elliot's frank statement that \"sloth and untidiness are indefensible\" is a sign that the task will be tackled with vigour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bea9a28-1238-31c7-986b-e12b9938e46c",
                                        "entry_id": "f858a1dc-a183-3441-ba3e-46eebcb6849e",
                                        "glosses": [
                                            "Strength or force in animal or vegetable nature or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4238f84-b163-47e4-993c-9b4e8238b379",
                                                "sense_id": "6bea9a28-1238-31c7-986b-e12b9938e46c",
                                                "text": "A plant grows with vigour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d703062-ca54-3e76-8b10-211699bb5707",
                                        "entry_id": "f858a1dc-a183-3441-ba3e-46eebcb6849e",
                                        "glosses": [
                                            "Strength; efficacy; potency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9eae5c-e298-4818-9957-68fbcc1990df",
                                                "sense_id": "4d703062-ca54-3e76-8b10-211699bb5707",
                                                "text": "But in the fruithful earth: there first receiv'd / His beams, unactive else, their vigour find."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60ee8928-3fff-4bb2-85e9-565e3239fdcb",
                        "source_entry_id": "b4def960-3465-3eaa-8540-1edbfc35aef1",
                        "source_sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                        "target_lang_word": "verve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e08b16e2-c04b-335a-92e0-efc7a98b1463",
                                        "entry_id": "8ac03805-54e6-3010-b3d4-34ed4e09b05d",
                                        "glosses": [
                                            "Enthusiasm, rapture, spirit, or vigour, especially of imagination such as that which animates an artist, musician, or writer, in composing or performing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a84b844f-25c5-4ef1-b61a-982ac4dd4773",
                                                "sense_id": "e08b16e2-c04b-335a-92e0-efc7a98b1463",
                                                "text": "His hands were strong and elegant; his experience of life evidently varied; his speech full of pith and verve; his manners forward, but perfectly presentable."
                                            },
                                            {
                                                "example_id": "e604ff06-372b-46ce-9e44-7e4e67a89169",
                                                "sense_id": "e08b16e2-c04b-335a-92e0-efc7a98b1463",
                                                "text": "They played through vacation to the fashionable of eight cities. […] Chicago he approved for a certain verve that transcended its loud accent—however, it was a Yale town, and as the Yale Glee Club was expected in a week the Triangle received only divided homage."
                                            },
                                            {
                                                "example_id": "4967e072-7e1e-4594-8955-324c3ecb9f76",
                                                "sense_id": "e08b16e2-c04b-335a-92e0-efc7a98b1463",
                                                "text": "Normally, this [girl] presents to the world the appearance of one who is feeling that if it isn't the best of all possible worlds, it's quite good enough to be going on with till a better one comes along. Verve, I mean, and animation and all that sort of thing. But now there was a listlessness about her […]"
                                            },
                                            {
                                                "example_id": "5be261ac-ea21-4eca-bd7b-f8b53b98ebbe",
                                                "sense_id": "e08b16e2-c04b-335a-92e0-efc7a98b1463",
                                                "text": "After spending so much of the season looking upwards, the swashbuckling style and swagger of early season Spurs was replaced by uncertainty and frustration against a Norwich side who had the quality and verve to take advantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b470aca5-663b-3ed6-8b80-06988428a93e",
                                        "entry_id": "8ac03805-54e6-3010-b3d4-34ed4e09b05d",
                                        "glosses": [
                                            "A particular skill in writing."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c6ef970-38c9-4854-acdd-27964526797a",
                                                "sense_id": "b470aca5-663b-3ed6-8b80-06988428a93e",
                                                "text": "If he be above Virgil, and is reſolv'd to follow his own Verve (as the French call it,) the Proverb will fall heavily upon him; Who teaches himſelf, has a Fool for his Maſter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7391351b-6169-4b2f-8a53-58fd0e5cf740",
                        "source_entry_id": "b4def960-3465-3eaa-8540-1edbfc35aef1",
                        "source_sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                        "target_lang_word": "brio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                                        "entry_id": "37dde311-e10e-342e-9399-4e34f61bd92a",
                                        "glosses": [
                                            "Vigour or vivacity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf8174d-6e26-4bba-990d-0b41460452b4",
                                                "sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                                                "text": "He lay tossing restlessly on a dirty old straw palliasse, and was in great pain; but greeted his friend with a dash of the old brio."
                                            },
                                            {
                                                "example_id": "18b73646-5c33-4431-8ab6-ee6efde427ab",
                                                "sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                                                "text": "And as if to undermine their authority still further, Welsh Philpott in his innocence has made the error of placing Rick beside the pulpit in the very spot from which in the past he has read us the day's lesson with such brio and persuasion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b20f636-875d-4ef4-a536-22b6f1d03bca",
                        "source_entry_id": "b4def960-3465-3eaa-8540-1edbfc35aef1",
                        "source_sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                        "target_lang_word": "vigueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fbfb3ea-f32d-3ceb-b591-3a979d0658d8",
                                        "entry_id": "b4df6589-ecf9-3ffc-b86d-27328eb26b27",
                                        "glosses": [
                                            "Force ; plénitude ; énergie ; fougue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2620627-08e9-47f4-a07c-5b5709a9df08",
                                                "sense_id": "6fbfb3ea-f32d-3ceb-b591-3a979d0658d8",
                                                "text": "[…], l’acheteur, le plus souvent, est séduit par le poil lustré, onctueux et cette ardeur factice qui fait cabrioler, se cabrer, ou croupionner les chevaux, comme s’ils étaient doués d’une vigueur hors ligne […]."
                                            },
                                            {
                                                "example_id": "a4d0c04d-8738-4243-aace-4b33a5e1c000",
                                                "sense_id": "6fbfb3ea-f32d-3ceb-b591-3a979d0658d8",
                                                "text": "Les pompiers de Monthois et de Mouron, avec un zèle et une vigueur dignes d’éloges, attaquèrent l'incendie et parvinrent à préserver l’auberge de, Mme Cbarbogne."
                                            },
                                            {
                                                "example_id": "e0f82098-5a14-4f10-b488-d8f4cf3b8514",
                                                "sense_id": "6fbfb3ea-f32d-3ceb-b591-3a979d0658d8",
                                                "text": "Quelle qu’ait été l’importance pratique de la surexcitation populaire, il est indéniable que le gouvernement des États-Unis a agi avec vigueur, avec science et intelligence en face de cette invasion tout à fait inattendue."
                                            },
                                            {
                                                "example_id": "80692389-d786-491e-bc3f-162070dfde8a",
                                                "sense_id": "6fbfb3ea-f32d-3ceb-b591-3a979d0658d8",
                                                "text": "Le pape Innocent III (1193-1216) devait rompre avec cette tradition de tolérance et se faire l'inspirateur d'une politique hostile, qu'il mena avec une vigueur exceptionnelle."
                                            },
                                            {
                                                "example_id": "2ef21b36-f427-4aa5-8619-feef17ea180b",
                                                "sense_id": "6fbfb3ea-f32d-3ceb-b591-3a979d0658d8",
                                                "text": "Mais à lui-même aussi, cette mort serrait le cœur qui, d'un coup, anéantissait un homme en pleine vigueur, dans la fleur de l'âge, sans l'avertir par les prodromes les plus légers, un homme sobre comme il l'était, et cela à quelque temps de la retraite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "953a1547-ee92-46a9-b81b-b511b088707a",
                        "source_entry_id": "b4def960-3465-3eaa-8540-1edbfc35aef1",
                        "source_sense_id": "c2e77a15-b33a-365b-8ee8-67358ede54e9",
                        "target_lang_word": "nervosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                        "entry_id": "d4e2cf2a-48e5-3aaf-a40b-593db1828366",
                                        "glosses": [
                                            "État d’irritation des nerfs, d’excitabilité passagère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05287f64-d63f-480c-87f4-2eb2a2d5f144",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Sa nervosité s'était calmée et son âme s'exhalait dans le silence des choses, tout en douceur, sans souffrance."
                                            },
                                            {
                                                "example_id": "5c7c8cc4-9999-4ee0-9687-27044587fc2d",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Un cantinier qui se rase sur l'accotement, sa glace pendue à un cerisier, attend avec nervosité, la figure débordant de mousse, que nous ayons fini de faire trembler la route."
                                            },
                                            {
                                                "example_id": "5e3015d8-5a65-4eda-a684-22e3d43fb60e",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Le commissaire Massart […] se rongeait les ongles et c'était le seul signe de nervosité que ce fonctionnaire eût jamais donné ; […]."
                                            },
                                            {
                                                "example_id": "0c4506be-d5be-47ac-a476-35612613bff5",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Nadia conduit lentement, tant par crainte d'enliser sa Fiat, qui patine dans les roulières, qu'en raison de la nervosité qu'elle ressent à la perspective de cette rencontre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b0a3aa-229e-3e7e-a9fa-930a5666bfe4",
                                        "entry_id": "d4e2cf2a-48e5-3aaf-a40b-593db1828366",
                                        "glosses": [
                                            "Coefficient de rétractabilité (c’est-à-dire son retrait volumétrique quand sa teneur en eau diminue de 1 %) d'un bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5dfc96-142b-4cba-a726-6995de56f196",
                                                "sense_id": "d8b0a3aa-229e-3e7e-a9fa-930a5666bfe4",
                                                "text": "On appelle nervosité d’un bois son coefficient de rétractabilité, c’est-à-dire son retrait volumétrique quand sa teneur en eau diminue de 1 %."
                                            }
