                "translations": [
                    {
                        "translation_id": "9511f5da-b7fe-47b0-b0ca-1c30a63f000d",
                        "source_entry_id": "80b1a469-a052-3bed-b416-91ee2a861c9d",
                        "source_sense_description": "act of collecting leftover crops from farmers' fields",
                        "target_lang_word": "glanage",
