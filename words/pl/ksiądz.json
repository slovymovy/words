            "senses": [
                {
                    "sense_id": "dbcdb3d5-fa0b-3275-be37-ae7dfb97de27",
                    "sense_definition": "Polskie nazwisko męskie lub żeńskie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Ksiądz</w> pracuje w urzędzie miasta od wielu lat.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Ксёндз</w> работает в городской администрации уже много лет.",
                                "en": "Mr. <w>Ksiądz</w> has been working at the city hall for many years."
                            }
                        },
                        {
                            "text": "Nie znam nikogo, kto nosiłby nazwisko <w>Ksiądz</w>.",
                            "target_lang_translations": {
                                "ru": "Я не знаю никого, кто носил бы фамилию <w>Ксёндз</w>.",
                                "en": "I don't know anyone whose last name is <w>Ksiądz</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
