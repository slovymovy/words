                        "entry_id": "5aefe737-bdc2-3c04-8f78-509e97fbcfce",
                        "glosses": [
                            "zjawisko językowe występowania w językach wschodniosłowiańskich grup „-oro-”, „-olo-”, „-ere-” i „-ele-”, którym w innych językach słowiańskich odpowiadają grupy z jedną samogłoską"
                        ],
                        "tags": [],
                        "examples": [
