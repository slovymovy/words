                        "glosses": [
                            "huis dat door ligging, omvang en ontwerp geschikt is voor mensen met een hogere leeftijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1935d04-dff6-467b-ac7f-2f41335b39cf",
                                "sense_id": "bf429b8f-909b-33af-9db6-bd5352ec338d",
                                "text": "Noodknoppen in seniorenwoningen zijn inmiddels heel gewoon, omdat de bewoners erom vragen en ook de opdrachtgever van dergelijke woningen, meestal een overheid, er het voordeel van inziet."
                            }
                        ]
                    },
                    {
                        "sense_id": "98115750-5c3d-3313-b789-8dfdc1d05dc1",
                        "entry_id": "90d5369c-cc2b-3228-9176-a94289959327",
                        "glosses": [
                            "corporatiewoning die alleen aan mensen op hogere leeftijd verhuurd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd0df9d-7e10-422d-944d-d109864394ce",
                                "sense_id": "98115750-5c3d-3313-b789-8dfdc1d05dc1",
                                "text": "Ik was op zoek naar een seniorenwoning. Die zijn er niet. Daarvoor moet je iets mankeren. En ik mankeer niets."
                            }
                        ]
                    }
