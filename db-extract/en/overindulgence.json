                                        "glosses": [
                                            "Eigenschaft, kein Maß zu halten, maßlos zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790de8e1-1546-4cf4-a2c6-6ecd075b8b22",
                                                "sense_id": "ea1d6326-bb97-3bde-aafa-5dc6dc796f5c",
                                                "text": "Die Maßlosigkeit, die er im Reden zeigte, bewirkte, dass wir das Zimmer verließen."
                                            },
                                            {
                                                "example_id": "3b9c207e-35cd-4ebd-943f-64a4561f2d23",
                                                "sense_id": "ea1d6326-bb97-3bde-aafa-5dc6dc796f5c",
                                                "text": "Ich muß herausfinden, worin meine Neigung zur Maßlosigkeit ihre Ursache hat. Vielleicht in einer Lebensgier, die mir in ihrem Ausmaß nicht immer bewußt ist."
                                            },
                                            {
                                                "example_id": "9d9f2a7a-0895-4e56-a7d9-6e7d0f6856b8",
                                                "sense_id": "ea1d6326-bb97-3bde-aafa-5dc6dc796f5c",
                                                "text": "„Infolge der Maßlosigkeit ihrer Leidenschaft stellte sich bei ihr Knochenerweichung und allgemeiner Kräfteverfall ein.“"
                                            },
                                            {
                                                "example_id": "646bf29c-5b55-428d-8e7e-c40b1bb3805f",
                                                "sense_id": "ea1d6326-bb97-3bde-aafa-5dc6dc796f5c",
                                                "text": "„Und die Maßlosigkeit steht in der Rangliste der deutschen Sündenfälle ganz obenan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
