                    {
                        "sense_id": "1e5a8074-86c2-325f-90de-da1d71ece219",
                        "entry_id": "5536762d-c042-37ad-b826-9cd12da7471c",
                        "glosses": [
                            "A house on floats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c02bef6-cecc-4837-b30e-d06bef873e4a",
                                "sense_id": "1e5a8074-86c2-325f-90de-da1d71ece219",
                                "text": "We'd live in a waterhouse. Not a houseboat. I didn't want any hint of the “B” word. A waterhouse is a home that floats."
                            },
                            {
                                "example_id": "2eb604f1-640e-4c25-88c0-573630c0fffc",
                                "sense_id": "1e5a8074-86c2-325f-90de-da1d71ece219",
                                "text": "The floating waterhouses allow residents to live a nomadic life."
                            },
                            {
                                "example_id": "68ade2d4-880d-4cfa-b285-eb6f332f414d",
                                "sense_id": "1e5a8074-86c2-325f-90de-da1d71ece219",
                                "text": "People build embankments and dams, construct waterhouses, establish channels and canals, found power plant and so on to avoid flood, irrigate, supply water, ship and generate electricity."
                            }
                        ]
                    }
                ],
