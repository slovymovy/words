                "senses": [
                    {
                        "sense_id": "8b9f4b70-6f9a-3d76-bf2e-c82a00b87dfa",
                        "entry_id": "afe844c5-1451-3456-9c70-6f9bb6825b78",
                        "glosses": [
                            "aus Beeren, Steinobst oder Kernobst durch Destillation hergestellter Schnaps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb2211d-0b6e-41a0-8f88-7a4a05095943",
                                "sense_id": "8b9f4b70-6f9a-3d76-bf2e-c82a00b87dfa",
                                "text": "„Eine badische Kleinstadt, dachte Henry, während Bettina weitererzählte, kultiviert, manierlich umgeben von Weinbergen. Hügel, sanft abfallende Wiesen, Feldsalat und Schneckensuppe, Riesling und Schwarzburgunder. Obstbrände statt Fusel. Umgangsformen statt Berliner Schnauze, plus Geld.“"
                            },
                            {
                                "example_id": "7b95d44f-84a2-484e-a4f5-d8c813bf75b3",
                                "sense_id": "8b9f4b70-6f9a-3d76-bf2e-c82a00b87dfa",
                                "text": "„Für eine geringe Pauschale gibt es ein Package mit Alpenkräutertee, Wabenhonig-Muffins und Pregler, einem Osttiroler Obstbrand.“"
                            },
                            {
                                "example_id": "41e63c4b-51ee-4639-b05d-e3362e48986f",
                                "sense_id": "8b9f4b70-6f9a-3d76-bf2e-c82a00b87dfa",
                                "text": "„Auch bei den Schnapsbrennern steht sie hoch im Kurs und ist seit Generationen Grundstoff für beste Obstbrände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
