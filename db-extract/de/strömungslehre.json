                "senses": [
                    {
                        "sense_id": "f9a6dde3-d461-3545-b2d3-2bd64931c260",
                        "entry_id": "0c23e18e-f784-3780-ad16-d17b748ea82c",
                        "glosses": [
                            "die Lehre vom Verhalten beweglicher Fluide, wenn diese ruhig stehen, sich bewegen oder gar strömen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc08e9c-96c7-484f-8677-04ed875e22ec",
                                "sense_id": "f9a6dde3-d461-3545-b2d3-2bd64931c260",
                                "text": "„Die Strömungslehre behandelt die Gesetzmäßigkeiten der Bewegung aller fluiden Medien.“"
                            },
                            {
                                "example_id": "b295a243-53b2-418a-8269-e1a0eb12ea3a",
                                "sense_id": "f9a6dde3-d461-3545-b2d3-2bd64931c260",
                                "text": "„Die Strömungslehre wird auch als Strömungs- oder Fluidmechanik bezeichnet und ist die Lehre von den Bewegungen flüssiger und gasförmiger Medien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
