                                            {
                                                "example_id": "780d31b0-e9ef-4e9e-949e-ff72d3ed0d66",
                                                "sense_id": "936b01e4-98da-318d-9ee0-427d7d2c7a65",
                                                "text": "Bohater naszej opowieści, gdy tylko wyzdrowiał, wyjechał do centralnej Polski, do Sandomierza"
                                            },
                                            {
                                                "example_id": "42bd2a03-d503-49d7-be53-3853644d7b9d",
                                                "sense_id": "936b01e4-98da-318d-9ee0-427d7d2c7a65",
                                                "text": "Kiedy mama i ja wyzdrowieliśmy, ojciec był jeszcze chory, więc wróciliśmy ze szpitala sami"
                                            }
