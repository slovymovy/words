                "senses": [
                    {
                        "sense_id": "6f55c574-540d-390d-974d-467b7d26727d",
                        "entry_id": "37aedc0a-5822-3cf2-be7f-49b0cbdb7db0",
                        "glosses": [
                            "Contribuer à quelque chose en commun avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd450ad-74ff-43ce-be3d-aa4cc8a1166a",
                                "sense_id": "6f55c574-540d-390d-974d-467b7d26727d",
                                "text": "La fonction principale des “covillageois” qui forment la communauté villageoise, c’est de “cocontribuer” (συντελεῖν), mais la personnalité juridique du chorion ne s’arrête pas aux impôts."
                            },
                            {
                                "example_id": "2b2651ff-91da-4a09-a4ce-a83991086e1b",
                                "sense_id": "6f55c574-540d-390d-974d-467b7d26727d",
                                "text": "Les stagiaires qui cocontribuent à la paternité d'une œuvre (avec le premier auteur ou l'auteur principal) ne sont pas admissibles."
                            },
                            {
                                "example_id": "79ae5423-7d52-4fc3-8e7c-fb7aea253725",
                                "sense_id": "6f55c574-540d-390d-974d-467b7d26727d",
                                "text": "Cocontribué par des journalistes, blogueurs, étudiants et internautes, ce site valorise aussi bien le travail mené par des start-up que (...)"
                            }
                        ]
                    }
