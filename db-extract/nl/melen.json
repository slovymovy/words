                "senses": [
                    {
                        "sense_id": "30aa17ce-d123-3a26-b928-4bd78a77189e",
                        "entry_id": "d4cbcfe7-c596-35de-b7a6-a4f6468b7b14",
                        "glosses": [
                            "heel kleine deeltjes loslaten"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a2fec63b-2dd8-3b16-be06-28741d867c35",
                        "entry_id": "d4cbcfe7-c596-35de-b7a6-a4f6468b7b14",
                        "glosses": [
                            "bestuiven met meel"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0106f80-c4c1-4052-9f33-ff8461f4106a",
                                "sense_id": "a2fec63b-2dd8-3b16-be06-28741d867c35",
                                "text": "Zorg ervoor dat je je deegroller en de handen ook meelt, zodat het deeg ook niet blijft plakken."
                            },
                            {
                                "example_id": "89e6a015-2fe2-41b8-bb3a-f9b8beabfb3d",
                                "sense_id": "a2fec63b-2dd8-3b16-be06-28741d867c35",
                                "text": "O, gij mulder wit gemeeld, gij die iedereen besteelt,\nGij zult mijne man niet zijn, mijne man zult gij niet zijn!"
                            }
                        ]
                    },
                    {
                        "sense_id": "288134aa-a1aa-3577-af1b-0930dcbbf683",
                        "entry_id": "d4cbcfe7-c596-35de-b7a6-a4f6468b7b14",
                        "glosses": [
                            "tot een poedervorm vermalen"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "777e9138-e760-4e98-8013-ea4bb6b1d411",
                                "sense_id": "288134aa-a1aa-3577-af1b-0930dcbbf683",
                                "text": "⧖ En in het gescarificeerde brengt men Sal armoniac; Sal tartari, pulv. myrrhae, Tinct. myrrh. nitrum Sal. Arm. met Sapo niger, Therebinth. Ung. AEgyptiac. fuscum, Vitriolum, aqua fortis, enz. te vooren gemeeld."
                            }
                        ]
                    },
