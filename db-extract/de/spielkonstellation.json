                ],
                "senses": [
                    {
                        "sense_id": "4b50e66d-faf4-3279-913d-3f5ef8cf8c61",
                        "entry_id": "81036196-7db6-3986-b159-f840556a316a",
                        "glosses": [
                            "spezielle Gegebenheit in einem Spielgeschehen; gegenseitige Zuordnung verschiedener Faktoren, die für das Spiel bedeutsam sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ed0d21-2aed-484b-b245-27ebcdd99a40",
                                "sense_id": "4b50e66d-faf4-3279-913d-3f5ef8cf8c61",
                                "text": "„Um noch etwas zu veranschaulichen, wie ein spieltheoretisch ausgefüllter Verantwortungsbegriff aussehen könnte, seien drei weitere Spielkonstellationen kurz kommentiert.“"
                            },
                            {
                                "example_id": "12c94502-52a5-4d99-902b-6f944d65978e",
                                "sense_id": "4b50e66d-faf4-3279-913d-3f5ef8cf8c61",
                                "text": "„Die nähere Betrachtung der Spielkonstellation (c) zeigt indes, daß dies zwar eine notwendige, keineswegs aber immer eine hinreichende Bedingung ist.“"
                            },
                            {
                                "example_id": "5ab52645-4055-4676-92ad-7d4f982a3000",
                                "sense_id": "4b50e66d-faf4-3279-913d-3f5ef8cf8c61",
                                "text": "„Diese komplexe Spielkonstellation schafft höchste Spielansprüche, die nicht übersehen werden dürfen, allerdings auch Niederlagen und Versagenserfahrungen.“"
                            },
                            {
                                "example_id": "cb027e99-fefc-4a52-a73c-4fe09035769f",
                                "sense_id": "4b50e66d-faf4-3279-913d-3f5ef8cf8c61",
                                "text": "„Bezogen auf das Spielkonzept von Thomas Schleisiek heißt dies, dass in Köttersen keine Spielzüge einstudiert wurden, sondern eher Spielkonstellationen, wobei die Spieler immer zwischen mehreren Handlungsalternativen auswählen konnten und sollten.“"
                            },
                            {
                                "example_id": "968c7594-755c-4931-ad89-3f1e266f6952",
                                "sense_id": "4b50e66d-faf4-3279-913d-3f5ef8cf8c61",
                                "text": "„Nur der echte Gewinn aus der chancenlosen Ausweglosigkeit der Spielkonstellation zählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
