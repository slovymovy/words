                        "entry_id": "b74b9dd5-4457-3042-9af2-c198d349b0d6",
                        "glosses": [
                            "Instrument ou organe d’un mécanisme qui détermine une détonation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01141431-f37e-4fe9-83e6-0b942ed241dd",
                                "sense_id": "7f35854a-6963-3dc3-9b1e-7635703e16dd",
                                "text": "Afin d’éviter toute incertitude sur la température au moment des expériences, la déflagration des explosifs traités a été réalisée par un détonateur électrique de force connue, au fulminate pur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d2349f1-6e4e-3d96-ac69-0cb91fe2562e",
                        "entry_id": "b74b9dd5-4457-3042-9af2-c198d349b0d6",
                        "glosses": [
                            "Substance capable de provoquer des explosions violentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb916f31-95f0-4d64-ba3b-c933488d2210",
                                "sense_id": "5d2349f1-6e4e-3d96-ac69-0cb91fe2562e",
                                "text": "Les amorces sont des détonateurs."
                            },
                            {
                                "example_id": "cc935607-b4d6-48a8-aa92-a08bc547473f",
                                "sense_id": "5d2349f1-6e4e-3d96-ac69-0cb91fe2562e",
                                "text": "Le fulminate de mercure est un détonateur puissant."
                            }
                        ]
                    }
