                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "2575e4ed-9f26-37d6-bd29-c471b027e9da",
                                        "entry_id": "f61d8fd2-04b0-3c65-a3fd-9653af4d7b3e",
                                        "glosses": [
