                ],
                "senses": [
                    {
                        "sense_id": "652ce039-30e1-317e-888e-93c57159e9c7",
                        "entry_id": "2621e451-ff24-3c73-99cb-1cca8251ed9d",
                        "glosses": [
                            "Engager plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51fe5c70-d923-413c-ad60-c07b1f42c01f",
                                "sense_id": "652ce039-30e1-317e-888e-93c57159e9c7",
                                "text": "Jouer AQo au début c'était un peu limite pour la SPT, mais ensuite sur le flop tu ne touches rien, évite de surengager de l'argent mort."
                            },
                            {
                                "example_id": "9c09b7d7-abf8-4408-8743-3389d0f28f39",
                                "sense_id": "652ce039-30e1-317e-888e-93c57159e9c7",
                                "text": "Et dans les virages serrés, cette répartition des masses a tendance à « surengager » la moto."
                            },
                            {
                                "example_id": "1e7b2752-b360-452c-9c5e-3a4345ef5f82",
                                "sense_id": "652ce039-30e1-317e-888e-93c57159e9c7",
                                "text": "Il faut veiller sans cesse à ne pas se “surengager”, au risque de mettre en péril un certain équilibre indispensable à une vie personnelle épanouie."
                            }
                        ]
                    }
