{
    "word_family": [
        "approximation",
        "approximately",
        "approximative",
        "approximant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bd1cff6-a104-32fa-b6c7-5556b418ef9c",
                    "sense_definition": "Nearly correct or exact but not perfectly accurate",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder gave us an <w>approximate</w> cost for the renovation before starting the work.",
                            "target_lang_translations": {
                                "ru": "Строитель назвал нам <w>приблизительную</w> стоимость ремонта перед началом работ."
                            }
                        },
                        {
                            "text": "We need to know the <w>approximate</w> number of guests attending the wedding next month.",
                            "target_lang_translations": {
                                "ru": "Нам нужно знать <w>примерное</w> количество гостей, которые придут на свадьбу в следующем месяце."
                            }
                        }
                    ],
                    "synonyms": [
                        "close"
                    ],
                    "antonyms": [
                        "exact",
                        "precise"
                    ],
                    "common_phrases": [
                        "approximate number",
                        "approximate cost",
                        "approximate value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почти верный или точный, но не идеально выверенный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приблизительный",
                                "target_lang_sense_clarification": "не совсем точный"
                            },
                            {
                                "target_lang_word": "примерный",
                                "target_lang_sense_clarification": "оценочный"
                            },
                            {
                                "target_lang_word": "приближенный",
                                "target_lang_sense_clarification": "близкий к точному значению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89c07519-6b09-3e00-a88b-dfb1f6bba9c0",
                    "sense_definition": "Resembling or approaching something in nature or character",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new synthetic material is an <w>approximate</w> match for real leather.",
                            "target_lang_translations": {
                                "ru": "Новый синтетический материал — это <w>близкое</w> подобие натуральной кожи."
                            }
                        },
                        {
                            "text": "His description of the events was only an <w>approximate</w> version of what actually happened.",
                            "target_lang_translations": {
                                "ru": "Его описание событий было лишь <w>приблизительной</w> версией того, что произошло на самом деле."
                            }
                        }
                    ],
                    "synonyms": [
                        "close"
                    ],
                    "common_phrases": [
                        "approximate match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий что-либо или близкий к чему-либо по характеру или свойствам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близкий",
                                "target_lang_sense_clarification": "похожий по свойствам"
                            },
                            {
                                "target_lang_word": "приблизительный",
                                "target_lang_sense_clarification": "неполный или неточный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85d29484-4c3f-3600-9909-e612c98f31be",
                    "sense_definition": "Located or drawn close together without being united",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist noted the <w>approximate</w> leaves on the stem of the rare plant.",
                            "target_lang_translations": {
                                "ru": "Ботаник отметил <w>сближенные</w> листья на стебле редкого растения."
                            }
                        },
                        {
                            "text": "In certain species, the <w>approximate</w> scales provide a protective layer for the bud.",
                            "target_lang_translations": {
                                "ru": "У некоторых видов <w>плотно прилегающие</w> чешуйки обеспечивают защитный слой для почки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенные или нарисованные близко друг к другу, но не соединенные"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сближенный",
                                "target_lang_sense_clarification": "в ботанике или анатомии"
                            },
                            {
                                "target_lang_word": "близкорасположенный",
                                "target_lang_sense_clarification": "находящийся рядом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e2d0422-e9f0-38f8-a6f6-325e59bc2374",
                    "sense_definition": "To estimate a value or amount roughly",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>approximate</w> the total by rounding each number to the nearest ten.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>приблизительно рассчитать</w> общую сумму, округлив каждое число до ближайшего десятка."
                            }
                        },
                        {
                            "text": "Scientists <w>approximate</w> the value of the constant based on recent experimental data.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>оценивают</w> значение константы на основе последних экспериментальных данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "approximate the value",
                        "approximate the total"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубо оценивать величину или количество"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать приблизительно",
                                "target_lang_sense_clarification": "давать грубую оценку"
                            },
                            {
                                "target_lang_word": "округлять",
                                "target_lang_sense_clarification": "для упрощения расчетов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3e4addf-d726-38d5-af2f-d97ec0eddb75",
                    "sense_definition": "To come close to or approach a certain state or quality",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new engine design aims to <w>approximate</w> the efficiency of a perfect machine.",
                            "target_lang_translations": {
                                "ru": "Конструкция нового двигателя призвана <w>приблизиться</w> к эффективности идеальной машины."
                            }
                        },
                        {
                            "text": "Her performance began to <w>approximate</w> the level of a professional athlete.",
                            "target_lang_translations": {
                                "ru": "Ее результаты начали <w>соответствовать</w> уровню профессионального атлета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "approximate to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближаться к определенному состоянию или качеству"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приближаться",
                                "target_lang_sense_clarification": "становиться похожим"
                            },
                            {
                                "target_lang_word": "почти равняться",
                                "target_lang_sense_clarification": "быть почти идентичным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09ac6cdb-f62b-3ccd-b2cd-c9a21c208b8b",
                    "sense_definition": "To bring or move something closer to a specific point or standard",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The policy was designed to <w>approximate</w> the living standards of the two regions.",
                            "target_lang_translations": {
                                "ru": "Эта политика была разработана для того, чтобы <w>сблизить</w> уровень жизни в двух регионах."
                            }
                        },
                        {
                            "text": "The surgeon worked carefully to <w>approximate</w> the edges of the wound for better healing.",
                            "target_lang_translations": {
                                "ru": "Хирург осторожно работал над тем, чтобы <w>соединить</w> края раны для лучшего заживления."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближать или перемещать что-либо ближе к определенной точке или стандарту"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сближать",
                                "target_lang_sense_clarification": "уменьшать расстояние или разницу"
                            },
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "края раны или части"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21a0d08b-da85-35e3-ae9d-29c6ee2f0322",
                    "sense_definition": "A result, quantity, or value that is nearly but not exactly correct",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The figures provided in the report are merely <w>approximates</w> and should be verified.",
                            "target_lang_translations": {
                                "ru": "Цифры, приведенные в отчете, являются лишь <w>приблизительными данными</w> и должны быть проверены."
                            }
                        },
                        {
                            "text": "When dealing with such large distances, we often have to rely on <w>approximates</w>.",
                            "target_lang_translations": {
                                "ru": "Имея дело с такими огромными расстояниями, нам часто приходится полагаться на <w>приближенные значения</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат, количество или значение, которое является почти, но не совсем точным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приблизительное значение",
                                "target_lang_sense_clarification": "неточное число"
                            },
                            {
                                "target_lang_word": "приближение",
                                "target_lang_sense_clarification": "оценочный результат"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}