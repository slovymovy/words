                "senses": [
                    {
                        "sense_id": "77563754-9a86-3ba5-93f1-3bd52f2e283c",
                        "entry_id": "4a680af1-f035-38af-8a1f-4b411104ed9d",
                        "glosses": [
                            "związany z chorągwią (przytwierdzonym do drzewca płatem tkaniny)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6ce266-c8b8-49c2-b8dc-d3caf8cfc2a1",
                                "sense_id": "77563754-9a86-3ba5-93f1-3bd52f2e283c",
                                "text": ", tom V, wyd. Gebethner i Wolff, Warszawa 1883.."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "32456e0d-e5ce-3915-b9ac-0bc8a461e4b0",
                        "entry_id": "4a680af1-f035-38af-8a1f-4b411104ed9d",
                        "glosses": [
                            "związany z chorągwią (jednostką organizacyjną w harcerstwie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc3b7cb-9557-448a-9f29-0f92d7ed3fd5",
                                "sense_id": "32456e0d-e5ce-3915-b9ac-0bc8a461e4b0",
                                "text": "Byłam ostatnio przez chwilę na warsztatach dla szefów chorągwianych inspektoratów ratowniczych, akurat trwały prezentacje inspektoratów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "48f9471b-3369-345a-b85b-51106f406279",
                        "entry_id": "4a680af1-f035-38af-8a1f-4b411104ed9d",
                        "glosses": [
                            "związany z chorągwią (oddziałem żołnierzy w dawnej Polsce)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37a0561-3654-4681-bfb2-f30b110ae39e",
                                "sense_id": "48f9471b-3369-345a-b85b-51106f406279",
                                "text": "A cóżeśmy, autorament, zawinili, że koło chorągwiane waćpana zgubiło, a waćpan sam siebie znalazłeś między nami?"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
