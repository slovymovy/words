                            }
                        ]
                    },
                    {
                        "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                        "entry_id": "d1418187-f891-3eab-970b-4d8dc0dd6151",
                        "glosses": [
                            "Sự tùy ý."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba17eb3b-7e68-4f72-9d5c-981a11c95e96",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "Laisser à quelqu'un le loisir de faire quelque chose",
                                "translation": "để cho ai tùy ý làm việc gì"
                            },
                            {
                                "example_id": "6befdb5b-1600-40db-b46e-7d4aed766709",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "à loisir",
                                "translation": "thủng thẳng, thong thả"
                            },
                            {
                                "example_id": "feef651c-f57f-4646-9e03-19785911e2fc",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "Je vous répondrai à loisir",
                                "translation": "thủng thẳng tôi sẽ trả lời anh+ thỏa thích"
                            },
                            {
                                "example_id": "cb163ec2-1195-48a7-98ae-702a547a5da3",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "Aimer à loisir",
                                "translation": "yêu thỏa thích"
                            },
                            {
                                "example_id": "a5a43132-0b59-42ff-92c6-13815c62a2ec",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "avoir loisir de; avoir le loisir de",
                                "translation": "có đủ thời giờ để"
                            },
                            {
                                "example_id": "42a83c8f-58f9-4915-8f05-486f02948942",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "N'avoir pas le loisir de respirer; n'avoir pas le loisir de se moucher",
                                "translation": "(thân mật) bận túi bụi, bận không mở mắt được"
                            },
                            {
                                "example_id": "2687c9c3-5e7a-49b9-8150-dbbb8a80e5e2",
                                "sense_id": "07754955-7823-34ca-84e3-90a73de3e227",
                                "text": "tout à loisir",
                                "translation": "như à loisir"
                            }
                        ]
                    }
