                                "example_id": "046c462f-cb4e-479d-a113-a24d589b0116",
                                "sense_id": "51d42a84-4c59-3b54-8353-5a3a2af2e4ad",
                                "text": "„Ein welkes Holunderblatt hatte sich im Faden eines Spinnennetzes verfangen und drehte sich sanft im Wind.“"
                            },
                            {
                                "example_id": "bba342dc-4d89-4591-be66-fdb29c43acef",
                                "sense_id": "51d42a84-4c59-3b54-8353-5a3a2af2e4ad",
                                "text": "„Der Duft der auf der Haut zerriebenen Holunderblätter soll Mücken vertreiben.“"
                            },
                            {
                                "example_id": "c0eb7af7-3de9-4172-aa91-fdf61cf43c04",
                                "sense_id": "51d42a84-4c59-3b54-8353-5a3a2af2e4ad",
                                "text": "„Holunderblätter sind hilfreich nach einem Bienen- oder Wespenstich.“"
                            }
                        ],
