                            {
                                "target_lang_word": "úpěnlivý pláč",
                                "target_lang_sense_clarification": "hlasitý usedavý pláč"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f040fae-360f-354c-9e6e-bf4e8dee47b2",
                    "sense_definition": "a sound that resembles a cry of lamentation, such as the howling of wind",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "environmental sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eerie <w>wail</w> of the winter wind made the abandoned house feel even more frightening.",
                            "target_lang_translations": {
                                "ru": "Жуткое <w>завывание</w> зимнего ветра делало заброшенный дом еще более пугающим.",
                                "cs": "Tajemné <w>kvílení</w> zimního větru dodávalo opuštěnému domu ještě děsivější atmosféru."
                            }
                        },
                        {
                            "text": "We were woken up by the distant <w>wail</w> of a lone wolf in the mountains.",
                            "target_lang_translations": {
                                "ru": "Нас разбудил далекий <w>вой</w> одинокого волка в горах.",
                                "cs": "Probudilo nás vzdálené <w>vytí</w> osamělého vlka v horách."
                            }
                        }
                    ],
                    "synonyms": [
                        "lament"
                    ],
                    "common_phrases": [
                        "wail of the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "звук, напоминающий плач, например, завывание ветра",
                        "cs": "zvuk připomínající nářek, například vytí větru"
                    },
                    "translations": {
