                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2262c7f0-ef8e-335c-a5ca-4ab63fa90a11",
                                        "entry_id": "3df654e3-2dc8-3ca5-9f16-41831f821bfe",
                                        "glosses": [
                                            "very low."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfeb4878-68a8-4247-88d9-ccef957d90da",
                                                "sense_id": "2262c7f0-ef8e-335c-a5ca-4ab63fa90a11",
                                                "text": "There was also the influx of a third of a million road lorries, sold at giveaway prices after their war roles ceased and used by competing one-man businesses to skim off sundry agricultural freight."
                                            }
                                        ]
                                    }
                                ]
                            }
