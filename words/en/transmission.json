{
    "word_family": [
        "transmit",
        "transmitter",
        "transmissible",
        "transmissive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51307fba-084d-3179-8057-2d2f4e086866",
                    "sense_definition": "The process of sending out something, such as a message, signal, or data, or the thing that is sent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satellite ensures the continuous <w>transmission</w> of television signals across the globe.",
                            "target_lang_translations": {
                                "ru": "Спутник обеспечивает непрерывную <w>передачу</w> телевизионных сигналов по всему миру.",
                                "zh": "卫星确保了电视信号在全球范围内的持续<w>传输</w>。"
                            }
                        },
                        {
                            "text": "We experienced a brief interruption in the data <w>transmission</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма мы столкнулись с кратковременным перерывом в <w>передаче</w> данных.",
                                "zh": "暴风雨期间，我们的数据<w>传输</w>出现了短暂中断。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outsending"
                    ],
                    "antonyms": [
                        "reception"
                    ],
                    "common_phrases": [
                        "data transmission",
                        "live transmission",
                        "satellite transmission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс отправки чего-либо, например сообщения, сигнала или данных, а также то, что отправляется.",
                        "zh": "发送信息、信号或数据等的过程，或所发送的内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "сигналов, данных или сообщений"
                            },
                            {
                                "target_lang_word": "пересылка",
                                "target_lang_sense_clarification": "данных или почты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传输",
                                "target_lang_sense_clarification": "用于数据、信号或信息"
                            },
                            {
                                "target_lang_word": "发送",
                                "target_lang_sense_clarification": "用于消息或信号的发出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7918542-663c-3f1d-8ed7-82a0bb6644c8",
                    "sense_definition": "The passing of a disease or pathogen from one person or group to another.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wearing masks is an effective way to reduce the disease <w>transmission</w> in crowded areas.",
                            "target_lang_translations": {
                                "ru": "Ношение масок — эффективный способ снизить <w>передачу</w> заболеваний в местах скопления людей.",
                                "zh": "在拥挤地区佩戴口罩是减少疾病<w>传播</w>的有效方法。"
                            }
                        },
                        {
                            "text": "The <w>transmission</w> of the virus occurred through contaminated water supplies.",
                            "target_lang_translations": {
                                "ru": "<w>Передача</w> вируса произошла через загрязненные источники воды.",
                                "zh": "病毒通过受污染的水源发生了<w>传播</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "prevention"
                    ],
                    "common_phrases": [
                        "disease transmission",
                        "virus transmission",
                        "human-to-human transmission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передача болезни или патогена от одного человека или группы другому.",
                        "zh": "疾病或病原体从一个人或群体传播给另一个人或群体的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "инфекции или вируса"
                            },
                            {
                                "target_lang_word": "распространение",
                                "target_lang_sense_clarification": "заболевания"
                            },
                            {
                                "target_lang_word": "трансмиссия",
                                "target_lang_sense_clarification": "медицинский термин для передачи инфекции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传播",
                                "target_lang_sense_clarification": "用于疾病或病毒的扩散"
                            },
                            {
                                "target_lang_word": "传染",
                                "target_lang_sense_clarification": "用于疾病从一方到另一方的感染"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "949ebca5-198b-3b6d-947b-1173dcf404f9",
                    "sense_definition": "The system of gears in a vehicle that transfers power from the engine to the wheels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic told me that my car needs a new automatic <w>transmission</w> because the gears are slipping.",
                            "target_lang_translations": {
                                "ru": "Механик сказал мне, что моей машине нужна новая автоматическая <w>коробка передач</w>, потому что передачи проскальзывают.",
                                "zh": "修理工告诉我，我的车需要换一个新的自动<w>变速箱</w>，因为齿轮打滑了。"
                            }
                        },
                        {
                            "text": "Any vehicle with an internal combustion engine needs a <w>transmission</w> that can alter the gear ratio.",
                            "target_lang_translations": {
                                "ru": "Любому транспортному средству с двигателем внутреннего сгорания нужна <w>трансмиссия</w>, способная изменять передаточное число.",
                                "zh": "任何配备内燃机的车辆都需要一个能够改变齿轮比的<w>传动系统</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tranny"
                    ],
                    "common_phrases": [
                        "automatic transmission",
                        "manual transmission",
                        "transmission fluid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система шестерен в транспортном средстве, которая передает мощность от двигателя к колесам.",
                        "zh": "车辆中将动力从发动机传递到车轮的齿轮系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коробка передач",
                                "target_lang_sense_clarification": "узел автомобиля"
                            },
                            {
                                "target_lang_word": "трансмиссия",
                                "target_lang_sense_clarification": "совокупность механизмов передачи движения"
                            },
                            {
                                "target_lang_word": "КПП",
                                "target_lang_sense_clarification": "аббревиатура для коробки переключения передач"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变速箱",
                                "target_lang_sense_clarification": "汽车机械部件"
                            },
                            {
                                "target_lang_word": "传动系统",
                                "target_lang_sense_clarification": "车辆动力传递装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74d4e739-6991-31c9-b992-2b57565fa544",
                    "sense_definition": "The passage of a nerve impulse across synapses in the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain chemicals in the brain can speed up or slow down the synaptic <w>transmission</w> of signals.",
                            "target_lang_translations": {
                                "ru": "Определенные химические вещества в мозге могут ускорять или замедлять синаптическую <w>передачу</w> сигналов.",
                                "zh": "大脑中的某些化学物质可以加速或减缓信号的突触<w>传递</w>。"
                            }
                        },
                        {
                            "text": "The study focuses on how drugs affect the <w>transmission</w> of pain signals to the brain.",
                            "target_lang_translations": {
                                "ru": "Исследование сосредоточено на том, как лекарства влияют на <w>передачу</w> болевых сигналов в мозг.",
                                "zh": "这项研究重点关注药物如何影响疼痛信号向大脑的<w>传递</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "synaptic transmission",
                        "nerve transmission"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прохождение нервного импульса через синапсы в организме.",
                        "zh": "神经冲动在体内突触间的传递。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "нервных импульсов"
                            },
                            {
                                "target_lang_word": "трансмиссия",
                                "target_lang_sense_clarification": "синаптическая или нервная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传递",
                                "target_lang_sense_clarification": "用于神经信号或冲动"
                            },
                            {
                                "target_lang_word": "传导",
                                "target_lang_sense_clarification": "用于生物电信号的移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99fe565d-c890-3b01-90f6-2e05bf92ef29",
                    "sense_definition": "The legal right of an heir to pass on an inheritance or right to their own successors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained the complex rules regarding the <w>transmission</w> of property rights to the next generation.",
                            "target_lang_translations": {
                                "ru": "Юрист объяснил сложные правила, касающиеся <w>передачи</w> прав собственности следующему поколению.",
                                "zh": "律师解释了关于将财产权<w>转让</w>给下一代的复杂规则。"
                            }
                        },
                        {
                            "text": "Even if he dies early, the <w>transmission</w> of his legacy to his children is protected by law.",
                            "target_lang_translations": {
                                "ru": "Даже если он умрет рано, <w>передача</w> его наследства детям защищена законом.",
                                "zh": "即使他早逝，他留给子女的遗产<w>继承</w>也受法律保护。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "right of transmission"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое право наследника передавать наследство или право своим собственным преемникам.",
                        "zh": "继承人将遗产或权利传给其后继者的法律权利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "прав или наследства"
                            },
                            {
                                "target_lang_word": "трансмиссия",
                                "target_lang_sense_clarification": "в наследственном праве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转让",
                                "target_lang_sense_clarification": "用于权利或财产的移交"
                            },
                            {
                                "target_lang_word": "继承",
                                "target_lang_sense_clarification": "用于遗产的传递"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}