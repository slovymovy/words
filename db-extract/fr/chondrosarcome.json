                        "entry_id": "49aa6a4b-9a22-3d20-a8ce-c8bea5b2b6d3",
                        "glosses": [
                            "Tumeur maligne des cartilages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c55afd0-8be3-4969-ba0a-89396388e3a3",
                                "sense_id": "7566bc26-00e5-39a5-a6e3-da67c86d45b5",
                                "text": "Tumeur maligne cartilagineuse, primitive ou secondaire, le chondrosarcome se rencontre à un âge avancé."
                            },
                            {
                                "example_id": "6b9a7400-ec86-4939-9cc3-edc49f28bb03",
                                "sense_id": "7566bc26-00e5-39a5-a6e3-da67c86d45b5",
                                "text": "Le chondrosarcome peut être révélé par une douleur avec ou sans masse palpable mais certains patients peuvent être asymptomatiques en raison d’une croissance tumorale très lente, en particulier au bassin."
                            }
                        ]
                    }
