    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd767647-358d-357d-9e15-58fbe954a205",
                    "sense_definition": "przemieszczać się pieszo na większe odległości bez określonego celu lub w celach turystycznych",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przemieszczanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W weekendy lubimy <w>wędrować</w> po górskich szlakach.",
                            "target_lang_translations": {
                                "ru": "По выходным мы любим <w>бродить</w> по горным тропам."
                            }
                        },
                        {
                            "text": "Młodzi ludzie często <w>wędrują</w> z plecakami po całym świecie.",
                            "target_lang_translations": {
                                "ru": "Молодые люди часто <w>путешествуют</w> с рюкзаками по всему миру."
                            }
                        }
                    ],
                    "synonyms": [
                        "spacerować",
                        "przechadzać się"
                    ],
                    "common_phrases": [
                        "wędrować po górach",
                        "wędrować po lesie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться пешком на большие расстояния без определенной цели или в туристических целях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "странствовать",
                                "target_lang_sense_clarification": "путешествовать, скитаться по свету"
                            },
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "медленно ходить без цели или гулять по тропам"
                            },
                            {
                                "target_lang_word": "путешествовать",
                                "target_lang_sense_clarification": "совершать пешие походы или поездки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b417898-83ea-3cd2-9b1b-55785e66fb9a",
                    "sense_definition": "przebywać długą drogę skądś dokądś, często w odniesieniu do zwierząt migrujących",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przemieszczanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jesienią bociany <w>wędrują</w> z Polski do Afryki.",
                            "target_lang_translations": {
                                "ru": "Осенью аисты <w>мигрируют</w> из Польши в Африку."
                            }
                        },
                        {
                            "text": "Wieloryby <w>wędrują</w> tysiące kilometrów przez oceany w poszukiwaniu cieplejszych wód.",
                            "target_lang_translations": {
                                "ru": "Киты <w>преодолевают</w> тысячи километров через океаны в поисках более тёплых вод."
                            }
                        }
                    ],
                    "synonyms": [
                        "migrować",
                        "przemieszczać się"
                    ],
                    "common_phrases": [
                        "wędrować na południe",
                        "wędrować na północ"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преодолевать долгий путь откуда-то куда-то (часто о сезонных перелетах или перемещениях животных)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигрировать",
                                "target_lang_sense_clarification": "о сезонных перемещениях животных и птиц"
                            },
                            {
                                "target_lang_word": "кочевать",
                                "target_lang_sense_clarification": "перемещаться с места на место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
