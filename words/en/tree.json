                {
                    "sense_id": "34e0f1ef-909c-3b92-8dc9-fb30a542b996",
                    "sense_definition": "A wooden structure used for execution, such as a gallows or a cross.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many religious texts, it is said that Jesus died on a <w>tree</w>.",
                            "target_lang_translations": {
                                "ru": "Во многих религиозных текстах говорится, что Иисус умер на <w>древе</w>."
                            }
