                "translations": [
                    {
                        "translation_id": "91889dab-0180-4042-bee9-8c82bcf1813c",
                        "source_entry_id": "97b70eb0-df98-3ac4-9fd7-a6f22d16ab3e",
                        "source_sense_id": "13b8c9ef-7af8-3807-81ff-38adf6f31c7f",
                        "source_sense_description": "not equally",
                        "target_lang_word": "ungleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                        "entry_id": "3fde18b7-b6c3-37cd-8af3-01fc4d0d673c",
                                        "glosses": [
                                            "(in bestimmten Eigenschaften) nicht gleich, nicht identisch, nicht übereinstimmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905b4a5d-afde-4ec2-93be-3b45dd75ffd8",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "Maria und Judith sind ungleiche Schwestern."
                                            },
                                            {
                                                "example_id": "1cbb7c03-7418-4a1f-a8bf-d069c62ba5fb",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "Der Gini-Koeffizient beschreibt das Ausmaß, wie ungleich Vermögen innerhalb einer Gesellschaft verteilt sind."
                                            },
                                            {
                                                "example_id": "07cae2b3-1587-428a-9f5f-2e357bd32495",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Gespaltene Gesellschaft - die Kluft zwischen Arm und Reich – Tausende Menschen in 80 Ländern weltweit gingen 2011 auf die Straße, um gegen die ungleiche Verteilung zu demonstrieren.“"
                                            },
                                            {
                                                "example_id": "ea231705-2027-40b6-b68b-4508bb9640d5",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Die Debatte um die ungleiche Bezahlung von Fußballerinnen und Fußballern nimmt Fahrt auf. Lewes FC aus England verpflichtet sich als erster Fußballklub weltweit öffentlich dazu, Männer und Frauen gleich zu entlohnen.“"
                                            },
                                            {
                                                "example_id": "fcf39d19-51e4-41ef-973f-d51246883d06",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "[Marokko:] „Die ungleiche Landverteilung zwischen den kleinen Bauern und den Großgrundbesitzern, die den größten Teil des Bodens bewirtschaften, konnte auch durch mehrere Agrarreformen kaum verändert werden.“",
                                                "translation": "mit Komparativ/Superlativ:"
                                            },
                                            {
                                                "example_id": "c5e8fe64-177c-4802-9540-573901d1ca6c",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Der materielle Wohlstand ist in Deutschland deutlich ungleicher verteilt als in anderen Industrienationen.“"
                                            },
                                            {
                                                "example_id": "deba8473-2c98-4e13-a043-d01402a82e10",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Deutschland liegt mit einem Wert von 73,3 deutlich über dem Durchschnitt der entwickelten Länder (64,6). Noch ungleicher sind die Vermögen nur in den USA (80,6), Schweden (79,9), Großbritannien (75,7), Österreich und Indonesien (je 73,6) verteilt.“"
                                            },
                                            {
                                                "example_id": "3e2191d7-a466-4568-8c70-4f5d84b9ff25",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Andere entwerfen das Bild von einem Land, in dem die Reichen immer reicher werden, die Zahl der Armen wächst und die Mittelschicht schrumpft - von einem Land also, das immer ungleicher wird.“"
                                            },
                                            {
                                                "example_id": "6a253914-44c7-4df1-8b43-5af4ad26ae3f",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Während [mit den 1980ern] im Westen eine Phase egalitärer Politik seit dem Zweiten Weltkrieg endete, wurden ungleiche Gesellschaften in Südamerika, Afrika oder dem Nahen Osten einfach noch ungleicher.“"
                                            },
                                            {
                                                "example_id": "9153172c-ba32-46ba-8577-c8f8e172e43e",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„Die Höhen könnten künftig noch ungleicher verteilt sein. Denn die westlichen Alpen wachsen in die Höhe, während das Gebirge gegen Osten, etwa ab der Linie Salzburg–Klagenfurt, absinkt.“"
                                            },
                                            {
                                                "example_id": "66698c48-0807-4576-8f58-24dbc0edb7b2",
                                                "sense_id": "e4905367-a722-3d47-a4a7-3156a6c5f9fa",
                                                "text": "„So beschreiben 15 von 36 Personen eine ungleichere Verteilung, bedingt durch den Einkommensverlust der ohnehin schon ärmsten Person.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "ungleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2be7ba2-6d20-37e4-bd55-cb094c1794cf",
                                        "entry_id": "dcc20418-7a58-3b3e-baab-b2b23a6011b8",
                                        "glosses": [
                                            "vor Komparativen als Verstärkung: weitaus, um vieles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162dda2e-445f-45d7-b094-0b3b253459dd",
                                                "sense_id": "f2be7ba2-6d20-37e4-bd55-cb094c1794cf",
                                                "text": "Meine Frau kann ungleich besser singen als ich."
                                            },
                                            {
                                                "example_id": "f9d9a19b-ff0c-45ec-92b6-8ba537d43098",
                                                "sense_id": "f2be7ba2-6d20-37e4-bd55-cb094c1794cf",
                                                "text": "Herr Huber ist der ungleich Kompetentere von uns beiden."
                                            },
                                            {
                                                "example_id": "3c8b19e3-d549-4000-9361-c36dd6332dcb",
                                                "sense_id": "f2be7ba2-6d20-37e4-bd55-cb094c1794cf",
                                                "text": "„»Meine Herren, was für ein Deutsch!« – mit diesen Worten kanzelte der spätere Bundespräsident Theodor Heuss die ursprüngliche Fassung des Artikel 1 ab. Sie lautete: »Der Staat ist um des Menschen Willen da, nicht der Mensch um des Staates willen.« Heuss nannte sie zutreffend »eine banale Staatsphilosophie«. Statt ihrer fand eine Formulierung Eingang in das Grundgesetz, die ungleich kürzer, ästhetischer und deshalb radikaler und präziser war: »Die Würde des Menschen ist unantastbar.«“"
                                            },
                                            {
                                                "example_id": "4bd9b051-1c64-4256-9971-a2e5ebd1021b",
                                                "sense_id": "f2be7ba2-6d20-37e4-bd55-cb094c1794cf",
                                                "text": "„Fakt ist: Training macht nicht immer Spass. Ungleich leichter fällt es, den inneren Schweinehunde zu überwinden, wenn es sich dabei um eine Sportart handelt, die einem auch (zumindest meistens) Spass macht und gut tut.“ [Anmerkung: Spass ist Schweizer Rechtschreibung, im Deutschen wäre Spaß korrekt.]"
                                            },
                                            {
                                                "example_id": "ac1ca5e6-ade2-4f32-8193-22389b1cd2a1",
                                                "sense_id": "f2be7ba2-6d20-37e4-bd55-cb094c1794cf",
                                                "text": "„Wer ein Leadgitarrist werden will, braucht eine E-Gitarre. Diverse Techniken, wie Sliding oder Bending, funktionieren mit einer Konzertgitarre ungleich schwerer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "ungleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "660dc7bd-d086-394a-a48f-837e491a8002",
                                        "entry_id": "bf576837-fb85-362b-a69b-c7546f4a6cba",
                                        "glosses": [
                                            "beim Dativ: im Unterschied zu etwas oder jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1562fab-2e96-4583-8fde-c8cd72a78cf8",
                                                "sense_id": "660dc7bd-d086-394a-a48f-837e491a8002",
                                                "text": "Ungleich meinem Bruder mag ich keine Essiggurken."
                                            },
                                            {
                                                "example_id": "2fd73260-9163-4a26-a268-d079ff46ebee",
                                                "sense_id": "660dc7bd-d086-394a-a48f-837e491a8002",
                                                "text": "Marga hat ungleich unserer Nachbarin keine Blumen im Fenster stehen."
                                            },
                                            {
                                                "example_id": "97405028-f33b-4b20-bfd4-78c7f686d5e0",
                                                "sense_id": "660dc7bd-d086-394a-a48f-837e491a8002",
                                                "text": "„Ist x ∈ A keine Einheit, dann ist das Ideal xA := {xa | a ∈ A} ungleich dem ganzen Ring A, also ist A/xA nicht der Nullring.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
