{
    "word_family": [
        "pregnancy",
        "impregnate",
        "impregnation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec16d19a-ce97-3293-bc9a-8bc61f9370b1",
                    "sense_definition": "Carrying a developing baby or offspring within the body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biological_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stopped drinking alcohol as soon as she found out she was <w>pregnant</w>.",
                            "target_lang_translations": {
                                "ru": "Она перестала употреблять алкоголь, как только узнала, что <w>беременна</w>.",
                                "zh": "她一发现自己<w>怀孕</w>了，就停止了饮酒。"
                            }
                        },
                        {
                            "text": "The doctor advised the <w>pregnant</w> woman to rest as much as possible.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал <w>беременной</w> женщине как можно больше отдыхать.",
                                "zh": "医生建议这位<w>孕妇</w>尽可能多休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expecting",
                        "expectant"
                    ],
                    "antonyms": [
                        "nonpregnant"
                    ],
                    "common_phrases": [
                        "get pregnant",
                        "heavily pregnant",
                        "become pregnant",
                        "pregnant woman"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вынашивающая ребенка или потомство в утробе.",
                        "zh": "指体内正在孕育胎儿或后代。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беременная",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "в положении",
                                "target_lang_sense_clarification": "вежливое, идиоматическое выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怀孕",
                                "target_lang_sense_clarification": "动词，指处于怀孕状态"
                            },
                            {
                                "target_lang_word": "有身孕",
                                "target_lang_sense_clarification": "较正式的表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66c3696b-3f54-335f-83ca-4d5303c73207",
                    "sense_definition": "Full of significance or unexpressed feeling; suggesting that something important is about to be said or done.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a long, <w>pregnant</w> pause before the winner was finally announced.",
                            "target_lang_translations": {
                                "ru": "Перед тем как наконец объявили победителя, повисла долгая, <w>многозначительная</w> пауза.",
                                "zh": "在最终宣布获胜者之前，出现了一段漫长而<w>意味深长</w>的停顿。"
                            }
                        },
                        {
                            "text": "The silence in the room was <w>pregnant</w> with tension and anticipation.",
                            "target_lang_translations": {
                                "ru": "Тишина в комнате была <w>наполнена</w> напряжением и ожиданием.",
                                "zh": "房间里的寂静<w>充满</w>了紧张和期待。"
                            }
                        }
                    ],
                    "synonyms": [
                        "meaningful",
                        "significant"
                    ],
                    "common_phrases": [
                        "pregnant pause",
                        "pregnant silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный значения или скрытого смысла; предвещающий, что скоро будет сказано или сделано что-то важное.",
                        "zh": "充满深意或未表达的情感；暗示即将发生重要的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многозначительный",
                                "target_lang_sense_clarification": "о паузе или молчании"
                            },
                            {
                                "target_lang_word": "чреватый",
                                "target_lang_sense_clarification": "таящий в себе (напряжение, последствия)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意味深长",
                                "target_lang_sense_clarification": "形容话语或表情含蓄，耐人寻味"
                            },
                            {
                                "target_lang_word": "充满……的",
                                "target_lang_sense_clarification": "形容某种氛围或状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a998b2cc-5da3-3aa9-9b58-8e9ddf824ee3",
                    "sense_definition": "Used to describe a couple who are expecting a baby together.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biological_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My husband and I are so excited to announce that we are <w>pregnant</w>!",
                            "target_lang_translations": {
                                "ru": "Мы с мужем так рады сообщить, что мы <w>ждем ребенка</w>!",
                                "zh": "我和我丈夫非常激动地宣布，我们<w>要当父母</w>了！"
                            }
                        },
                        {
                            "text": "They told their parents they were <w>pregnant</w> during the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "За праздничным ужином они рассказали родителям, что <w>ждут ребенка</w>.",
                                "zh": "他们在节日晚餐时告诉父母他们<w>要当父母</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expecting"
                    ],
                    "common_phrases": [
                        "we are pregnant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usage describing a couple"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания пары, которая вместе ожидает рождения ребенка.",
                        "zh": "用于描述一对共同期待孩子出生的夫妇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ждущие ребенка",
                                "target_lang_sense_clarification": "о паре (смысловой перевод)"
                            },
                            {
                                "target_lang_word": "беременны",
                                "target_lang_sense_clarification": "разговорное, калька с английского"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "期待宝宝出生",
                                "target_lang_sense_clarification": "描述夫妇共同期待的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c564c1d5-65e0-3dcd-acf0-f9f22d71b6da",
                    "sense_definition": "Capable of producing abundant growth, results, or ideas; fertile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphorical_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writer's mind was <w>pregnant</w> with new ideas for stories.",
                            "target_lang_translations": {
                                "ru": "Ум писателя был <w>полон</w> новых идей для рассказов.",
                                "zh": "这位作家的脑海中<w>富有</w>新的故事构思。"
                            }
                        },
                        {
                            "text": "They farmed the <w>pregnant</w> soil of the valley for generations.",
                            "target_lang_translations": {
                                "ru": "Они поколениями возделывали <w>плодородную</w> почву долины.",
                                "zh": "他们世世代代耕种着山谷中那片<w>肥沃</w>的土地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pregnant with"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный к обильному росту, результатам или идеям; плодородный.",
                        "zh": "能够产生丰富的成果或想法；肥沃的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодотворный",
                                "target_lang_sense_clarification": "об уме или идеях"
                            },
                            {
                                "target_lang_word": "плодородный",
                                "target_lang_sense_clarification": "о почве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "富有",
                                "target_lang_sense_clarification": "指充满某种特质或想法"
                            },
                            {
                                "target_lang_word": "肥沃",
                                "target_lang_sense_clarification": "指土地适合生长"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87487b98-7382-3904-b942-20401ebf26a4",
                    "sense_definition": "A pregnant person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medical study focused on the health outcomes of several <w>pregnants</w> in the village.",
                            "target_lang_translations": {
                                "ru": "Медицинское исследование было сосредоточено на показателях здоровья нескольких <w>беременных</w> в деревне.",
                                "zh": "这项医学研究重点关注了村里几位<w>孕妇</w>的健康状况。"
                            }
                        },
                        {
                            "text": "Special care must be taken to ensure the safety of all <w>pregnants</w> during the procedure.",
                            "target_lang_translations": {
                                "ru": "Необходимо проявлять особую осторожность для обеспечения безопасности всех <w>беременных</w> во время процедуры.",
                                "zh": "在手术过程中必须特别小心，以确保所有<w>孕妇</w>的安全。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беременная женщина (как существительное).",
                        "zh": "怀孕的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беременная",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孕妇",
                                "target_lang_sense_clarification": "指怀孕的女性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
