{
    "word_family": [
        "hiker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1363ccff-d36c-339b-aa0d-670ff610edc5",
                    "sense_definition": "A long walk, usually for pleasure or exercise, especially in the countryside.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "walking_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go for a <w>hike</w> in the mountains this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы решили отправиться в <w>поход</w> в горы в эти выходные.",
                                "zh": "我们决定这个周末去山里<w>徒步</w>。"
                            }
                        },
                        {
                            "text": "The <w>hike</w> to the waterfall took about two hours.",
                            "target_lang_translations": {
                                "ru": "<w>Поход</w> к водопаду занял около двух часов.",
                                "zh": "去瀑布的<w>徒步</w>行程大约花了两个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "walk",
                        "trek"
                    ],
                    "common_phrases": [
                        "go for a hike",
                        "take a hike",
                        "long hike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительная прогулка, обычно ради удовольствия или тренировки, особенно за городом или на природе.",
                        "zh": "指在郊外或自然环境中进行的长时间步行，通常是为了娱乐或锻炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поход",
                                "target_lang_sense_clarification": "путешествие"
                            },
                            {
                                "target_lang_word": "пешая прогулка",
                                "target_lang_sense_clarification": "длительная прогулка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徒步旅行",
                                "target_lang_sense_clarification": "长距离步行活动"
                            },
                            {
                                "target_lang_word": "远足",
                                "target_lang_sense_clarification": "郊外步行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "416bcb61-4365-36da-8538-f7691a4fb71e",
                    "sense_definition": "An abrupt increase in cost, amount, or rate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenants were very unhappy about the sudden rent <w>hike</w>.",
                            "target_lang_translations": {
                                "ru": "Жильцы были очень недовольны внезапным <w>повышением</w> арендной платы.",
                                "zh": "租户们对房租的突然<w>上涨</w>感到非常不满。"
                            }
                        },
                        {
                            "text": "Experts predict a tax <w>hike</w> in the coming fiscal year.",
                            "target_lang_translations": {
                                "ru": "Эксперты прогнозируют <w>повышение</w> налогов в предстоящем финансовом году.",
                                "zh": "专家预测在即将到来的财政年度税收将会<w>提高</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "cut",
                        "decrease"
                    ],
                    "common_phrases": [
                        "price hike",
                        "tax hike",
                        "rate hike",
                        "pay hike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое увеличение стоимости, количества или ставки.",
                        "zh": "指成本、金额或费率的突然大幅增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышение",
                                "target_lang_sense_clarification": "увеличение"
                            },
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкий рост"
                            },
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "увеличение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上涨",
                                "target_lang_sense_clarification": "价格或费率的增加"
                            },
                            {
                                "target_lang_word": "提高",
                                "target_lang_sense_clarification": "金额或标准的提升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8addc27f-1b26-3d0d-b34f-e550592850a9",
                    "sense_definition": "A sharp upward tug or movement to raise something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pull_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>hike</w> of his backpack, he prepared to climb the hill.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>рывком</w> поправив рюкзак, он приготовился подниматься на холм.",
                                "zh": "他<w>提</w>了一下背包，准备开始爬山。"
                            }
                        },
                        {
                            "text": "She gave her skirt a little <w>hike</w> to avoid the mud.",
                            "target_lang_translations": {
                                "ru": "Она слегка <w>поддёрнула</w> юбку, чтобы не испачкаться в грязи.",
                                "zh": "她把裙子稍微<w>提</w>高了一些，以避开泥泞。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое движение вверх, рывок, чтобы поднять или поправить что-то.",
                        "zh": "指为了提起或调整某物而进行的猛然向上拉动或移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "поддёргивание",
                                "target_lang_sense_clarification": "одежды или снаряжения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛拉",
                                "target_lang_sense_clarification": "向上拉动"
                            },
                            {
                                "target_lang_word": "提拉",
                                "target_lang_sense_clarification": "调整衣物位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92c7f8f5-285e-3197-958a-f7c12b055dd3",
                    "sense_definition": "The act of snapping the ball to start a play in American football.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "football_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quarterback waited for the <w>hike</w> before starting the play.",
                            "target_lang_translations": {
                                "ru": "Квотербек ждал <w>ввода мяча</w> перед началом розыгрыша.",
                                "zh": "四分卫在等待<w>开球</w>后再开始进攻。"
                            }
                        },
                        {
                            "text": "A bad <w>hike</w> can ruin the entire offensive strategy.",
                            "target_lang_translations": {
                                "ru": "Плохой <w>ввод мяча</w> может разрушить всю стратегию нападения.",
                                "zh": "一次糟糕的<w>开球</w>可能会毁掉整个进攻策略。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American football"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ввод мяча в игру в американском футболе.",
                        "zh": "美式橄榄球中，指中锋将球传给四分卫以开始比赛的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ввод мяча",
                                "target_lang_sense_clarification": "начало розыгрыша"
                            },
                            {
                                "target_lang_word": "снэп",
                                "target_lang_sense_clarification": "термин американского футбола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开球",
                                "target_lang_sense_clarification": "橄榄球术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b5f010a-d82c-3832-bfda-b30ab91c45b6",
                    "sense_definition": "To take a long walk for pleasure or exercise, especially in nature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "walking_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>hike</w> through the national park next summer.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>пройти пешком</w> через национальный парк следующим летом.",
                                "zh": "他们计划明年夏天去国家公园<w>徒步</w>。"
                            }
                        },
                        {
                            "text": "We <w>hiked</w> for miles without seeing another person.",
                            "target_lang_translations": {
                                "ru": "Мы <w>шли</w> много миль, не видя ни души.",
                                "zh": "我们<w>徒步</w>走了好几英里，没见到一个人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tramp",
                        "walk"
                    ],
                    "common_phrases": [
                        "hike a trail",
                        "go hiking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать длительную прогулку ради удовольствия или тренировки, особенно на природе.",
                        "zh": "指为了娱乐或锻炼而进行长距离步行，特别是在自然环境中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить в поход",
                                "target_lang_sense_clarification": "заниматься туризмом"
                            },
                            {
                                "target_lang_word": "путешествовать пешком",
                                "target_lang_sense_clarification": "передвигаться пешком"
                            },
                            {
                                "target_lang_word": "гулять",
                                "target_lang_sense_clarification": "прогуливаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徒步",
                                "target_lang_sense_clarification": "长距离行走"
                            },
                            {
                                "target_lang_word": "远足",
                                "target_lang_sense_clarification": "户外步行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66836db8-5874-3614-90ad-50f117f543ec",
                    "sense_definition": "To raise a price, rate, or amount suddenly or significantly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>hike</w> its prices due to inflation.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>повысить</w> цены из-за инфляции.",
                                "zh": "由于通货膨胀，公司决定<w>提高</w>价格。"
                            }
                        },
                        {
                            "text": "Landlords often <w>hike</w> the rent when a new lease is signed.",
                            "target_lang_translations": {
                                "ru": "Арендодатели часто <w>задирают</w> арендную плату при подписании нового договора.",
                                "zh": "房东在签署新合同时经常会<w>提高</w>租金。"
                            }
                        }
                    ],
                    "antonyms": [
                        "cut",
                        "decrease"
                    ],
                    "common_phrases": [
                        "hike up",
                        "hike prices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко или значительно повышать цену, ставку или количество.",
                        "zh": "指突然或大幅度地提高价格、费率或金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "цену или ставку"
                            },
                            {
                                "target_lang_word": "взвинчивать",
                                "target_lang_sense_clarification": "резко поднимать цены"
                            },
                            {
                                "target_lang_word": "задирать",
                                "target_lang_sense_clarification": "разг. необоснованно повышать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提高",
                                "target_lang_sense_clarification": "增加价格或费率"
                            },
                            {
                                "target_lang_word": "猛涨",
                                "target_lang_sense_clarification": "大幅度提升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b17a8642-6480-3631-a28a-f29874215af7",
                    "sense_definition": "To pull or tug something upwards sharply, often clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pull_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hiked</w> up his socks before putting on his boots.",
                            "target_lang_translations": {
                                "ru": "Он <w>подтянул</w> носки, прежде чем надеть ботинки.",
                                "zh": "他在穿靴子前把袜子<w>提</w>了上去。"
                            }
                        },
                        {
                            "text": "She <w>hiked</w> her skirt up to step over the puddle.",
                            "target_lang_translations": {
                                "ru": "Она <w>подобрала</w> юбку, чтобы перешагнуть через лужу.",
                                "zh": "她把裙子<w>提</w>起来跨过水坑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hike up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко подтягивать что-либо вверх, часто одежду.",
                        "zh": "指猛然向上拉或提某物，通常指衣物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтягивать",
                                "target_lang_sense_clarification": "одежду"
                            },
                            {
                                "target_lang_word": "поддёргивать",
                                "target_lang_sense_clarification": "резким движением"
                            },
                            {
                                "target_lang_word": "задирать",
                                "target_lang_sense_clarification": "поднимать высоко"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提",
                                "target_lang_sense_clarification": "向上拉起衣物"
                            },
                            {
                                "target_lang_word": "拉起",
                                "target_lang_sense_clarification": "调整衣物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9db1d0a-1fb5-37e0-94b2-73d7a12406e8",
                    "sense_definition": "To snap the ball to start a play in American football.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "football_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The center <w>hiked</w> the ball perfectly to the quarterback.",
                            "target_lang_translations": {
                                "ru": "Центровой идеально <w>ввёл</w> мяч квотербеку.",
                                "zh": "中锋完美地将球<w>开</w>给了四分卫。"
                            }
                        },
                        {
                            "text": "They <w>hiked</w> the ball on the count of three.",
                            "target_lang_translations": {
                                "ru": "Они <w>ввели</w> мяч на счёт три.",
                                "zh": "他们在数到三时<w>开</w>球。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American football"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить мяч в игру в американском футболе.",
                        "zh": "美式橄榄球中，指中锋将球传给四分卫以开始比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить мяч",
                                "target_lang_sense_clarification": "в игру"
                            },
                            {
                                "target_lang_word": "делать снэп",
                                "target_lang_sense_clarification": "американский футбол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开球",
                                "target_lang_sense_clarification": "橄榄球动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c02beef1-0d65-3a22-a8db-cb11008a1d72",
                    "sense_definition": "To lean out to the windward side of a sailboat to counterbalance the wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sailing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew had to <w>hike</w> hard to keep the boat flat in the strong wind.",
                            "target_lang_translations": {
                                "ru": "Экипажу пришлось сильно <w>откренивать</w>, чтобы удерживать лодку ровно при сильном ветре.",
                                "zh": "在强风中，船员们必须努力<w>压舷</w>以保持船身平稳。"
                            }
                        },
                        {
                            "text": "You need strong abdominal muscles to <w>hike</w> effectively.",
                            "target_lang_translations": {
                                "ru": "Нужны сильные мышцы пресса, чтобы эффективно <w>откренивать</w>.",
                                "zh": "你需要强壮的腹肌才能有效地<w>压舷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lean out",
                        "sit out"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняться на наветренную сторону парусной лодки для противовеса ветру.",
                        "zh": "帆船运动中，指船员向迎风侧倾斜身体以平衡风力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откренивать",
                                "target_lang_sense_clarification": "парусный спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压舷",
                                "target_lang_sense_clarification": "帆船术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b29bcaff-14aa-3bc0-8c1a-42a482fd8b65",
                    "sense_definition": "A command used to tell a dog sled team to start moving or go faster.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dog_command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musher shouted \"<w>Hike</w>!\" and the dogs began to run.",
                            "target_lang_translations": {
                                "ru": "Каюр крикнул: \"<w>Вперёд</w>!\", и собаки побежали.",
                                "zh": "赶狗雪橇的人大喊一声“<w>出发</w>！”，狗群便开始奔跑。"
                            }
                        },
                        {
                            "text": "He yelled \"<w>Hike</w>!\" into the cold winter air to urge the team forward.",
                            "target_lang_translations": {
                                "ru": "Он крикнул: \"<w>Пошёл</w>!\" в холодный зимний воздух, подгоняя упряжку.",
                                "zh": "他对着寒冷的冬日空气大喊“<w>前进</w>！”，催促狗队向前。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mushing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Команда, используемая для того, чтобы заставить упряжку собак начать движение или бежать быстрее.",
                        "zh": "用于指挥雪橇犬队开始移动或加速的指令。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вперёд!",
                                "target_lang_sense_clarification": "команда"
                            },
                            {
                                "target_lang_word": "Пошёл!",
                                "target_lang_sense_clarification": "команда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出发",
                                "target_lang_sense_clarification": "指令"
                            },
                            {
                                "target_lang_word": "前进",
                                "target_lang_sense_clarification": "指令"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}