                "senses": [
                    {
                        "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                        "entry_id": "07e806e0-334e-3a62-acf3-72cd07459c85",
                        "glosses": [
                            "Désintoxication, traitement contre la dépendance à la drogue ou à l’alcool."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cc054469-ab13-4370-bd90-a26abda2b635",
                                "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                "text": "Pour le public bourgeois, l’avant-garde « sérieuse » (l’avant-garde « drôle ») c’était le groupe diablotin Cocteau-Radiguet, avec ses performances, ses opiums, ses chapelles peintes, ses cures de désintox, ses saute-rétros et saute-rires (sic), ses bonnes facéties."
                            },
                            {
                                "example_id": "329edf0e-c662-4efc-b187-bcc185cd2009",
                                "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                "text": "J’ai donc dû ronger mon frein pendant sept longues journées passées en « thérapie » avec d'autres ados « difficiles ». Entre l’anorexique de 40 kg persuadée qu’elle est énorme, l’obèse qui voulait maigrir, le camé en cure de désintox et le flippé bourré de tocs, j’ai passé une semaine d’enfer."
                            },
                            {
                                "example_id": "fd263a09-419f-4e98-a626-2d64e7893384",
                                "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                "text": "Je suis le fils de Brad (décédé) et Kitty (en cure de désintox) Bolitar, et je cohabite actuellement avec mon oncle, Myron Bolitar (que je tolère)."
                            }
                        ]
                    },
                    {
                        "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                        "entry_id": "07e806e0-334e-3a62-acf3-72cd07459c85",
                        "glosses": [
                            "Séjour en centre spécialisé pour y subir une cure de désintoxication."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0133832d-b9fb-4941-b2f6-78fc3448d39d",
                                "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                "text": "Je ne veux pas aller en désintox."
                            },
                            {
                                "example_id": "a9427947-8cec-444c-9c61-d7e4d1ee6b40",
                                "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                "text": "Je suis sorti de désintox le mois dernier."
                            },
                            {
                                "example_id": "258fc591-10ff-4f77-b2d0-aa255731b628",
                                "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                "text": "J'ai rencontré mon conjoint pendant ma désintox."
                            }
                        ]
                    }
                ],
