                                "target_senses": [
                                    {
                                        "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                        "entry_id": "2e20e2a7-a8c2-3a22-9e60-1cca7a5600e8",
                                        "glosses": [
                                            "Qui promet, qui donne à espérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b438bb-3984-45d9-9124-4b522f33e060",
                                                "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                                "text": "À la fenêtre, le rideau bat comme une aile, le chaud parfum va et vient, comme ta main prometteuse sur mes cheveux, comme ta lèvre ensorcelante sur mon cou, comme ton amour qui mène sa somptueuse galère dans mon cœur palpitant."
                                            },
                                            {
                                                "example_id": "6181380b-bb3a-4be3-857b-ffd2ac06642e",
                                                "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                                "text": "Après un début de saison prometteur, ponctué par deux victoires en trois courses, Ferrari n’a fait qu’enchaîner les boulettes et les contre-performances. Au point de devenir la risée du paddock."
                                            },
                                            {
                                                "example_id": "47c292c7-faf1-4766-940e-d1a46fc9c56a",
                                                "sense_id": "7d433f15-c89b-3d6c-bc36-b093fe4baf83",
                                                "text": "C’était un catalogue très complet, avec des sous-parties sur l’air comprimé, le soudage, les échafaudages, le levage et des tas de rubriques prometteuses de cette sorte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prometteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8afaa33-1492-3311-ad10-83286207a4e4",
                                        "entry_id": "507165e6-f916-30e1-9f13-3f2586aa82f6",
                                        "glosses": [
                                            "Celui qui promet légèrement, ou sans intention de tenir sa promesse."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf79cb9-59da-42d2-a8b7-36e286466a2b",
                                                "sense_id": "c8afaa33-1492-3311-ad10-83286207a4e4",
                                                "text": "C’est un grand prometteur."
                                            },
                                            {
                                                "example_id": "2cc9461d-40a1-4649-a8ac-f801e0c21e71",
                                                "sense_id": "c8afaa33-1492-3311-ad10-83286207a4e4",
                                                "text": "Vous êtes un beau prometteur."
                                            },
                                            {
                                                "example_id": "9cbefdc1-57e3-44a7-bbd5-03b8bced69e5",
                                                "sense_id": "c8afaa33-1492-3311-ad10-83286207a4e4",
                                                "text": "Je rappelais, timide: le prometteur était en réunion avec des prometteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
