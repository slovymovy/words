                "senses": [
                    {
                        "sense_id": "23d29583-a591-331d-a211-cfe329fb6818",
                        "entry_id": "8fdecbde-57db-32e2-85a7-81b6ac9532d2",
                        "glosses": [
                            "fundamental frequency"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "5e6826dc-0693-44d5-a9f5-50fddad800b4",
                                "sense_id": "23d29583-a591-331d-a211-cfe329fb6818",
                                "text": "De grondtoon van een snaar hangt af van de lengte en spanning.",
                                "translation": "The fundamental frequency of a string depends on its length and tension.",
                                "english": "The fundamental frequency of a string depends on its length and tension."
                            },
                            {
                                "example_id": "e704936e-3891-4de0-895b-d4f9b3078a13",
                                "sense_id": "23d29583-a591-331d-a211-cfe329fb6818",
                                "text": "Bij het aanslaan van een gitaarsnaar hoor je eerst de grondtoon.",
                                "translation": "When you pluck a guitar string, you first hear its fundamental frequency.",
                                "english": "When you pluck a guitar string, you first hear its fundamental frequency."
                            },
                            {
                                "example_id": "c783ec63-ddba-4200-8f89-d225bdc75ef7",
                                "sense_id": "23d29583-a591-331d-a211-cfe329fb6818",
                                "text": "Elk muziekinstrument heeft zijn eigen unieke grondtoon.",
                                "translation": "Each musical instrument has its own unique fundamental frequency.",
                                "english": "Each musical instrument has its own unique fundamental frequency."
                            }
                        ]
                    },
                    {
                        "sense_id": "942becfc-c37b-35e3-84e8-44e10c5ee281",
                        "entry_id": "8fdecbde-57db-32e2-85a7-81b6ac9532d2",
                        "glosses": [
                            "keynote"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ef157658-d6fc-4f5c-a647-4bdd7ec712b0",
                                "sense_id": "942becfc-c37b-35e3-84e8-44e10c5ee281",
                                "text": "In veel traditionele muziek is de grondtoon cruciaal voor de melodie.",
                                "translation": "In many traditional musics, the keynote is crucial for the melody.",
                                "english": "In many traditional musics, the keynote is crucial for the melody."
                            },
                            {
                                "example_id": "b45a594f-6e15-475f-8ac5-1c9a8a32e0ba",
                                "sense_id": "942becfc-c37b-35e3-84e8-44e10c5ee281",
                                "text": "De fluit speelde de grondtoon terwijl de viool een harmonie speelde.",
                                "translation": "The flute played the keynote while the violin played a harmony.",
                                "english": "The flute played the keynote while the violin played a harmony."
                            },
                            {
                                "example_id": "cf332bd4-8c8a-40d9-89a9-577ee6d207ed",
                                "sense_id": "942becfc-c37b-35e3-84e8-44e10c5ee281",
                                "text": "Een goede componist weet hoe de grondtoon te gebruiken om emotie over te brengen.",
                                "translation": "A good composer knows how to use the keynote to convey emotion.",
                                "english": "A good composer knows how to use the keynote to convey emotion."
                            }
                        ]
                    },
                    {
                        "sense_id": "1391b9d8-435e-3a89-a64e-595c82cd3b9a",
                        "entry_id": "8fdecbde-57db-32e2-85a7-81b6ac9532d2",
                        "glosses": [
                            "the main subject of a poem, talk, etc."
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "aab49142-b094-47df-b701-ab65328a2cb4",
                                "sense_id": "1391b9d8-435e-3a89-a64e-595c82cd3b9a",
                                "text": "De grondtoon van zijn toespraak was verandering.",
                                "translation": "The main subject of his speech was change.",
                                "english": "The main subject of his speech was change."
                            },
                            {
                                "example_id": "2808ae41-2109-4e4c-aa3f-3ac4af09bf5c",
                                "sense_id": "1391b9d8-435e-3a89-a64e-595c82cd3b9a",
                                "text": "In elk van zijn gedichten is liefde de duidelijke grondtoon.",
                                "translation": "In each of his poems, love is the clear main subject.",
                                "english": "In each of his poems, love is the clear main subject."
                            },
                            {
                                "example_id": "30a386bf-bdb8-4f49-b42b-eec7faa4c063",
                                "sense_id": "1391b9d8-435e-3a89-a64e-595c82cd3b9a",
                                "text": "Het publiek was geraakt door de grondtoon van hoop in haar presentatie.",
                                "translation": "The audience was touched by the main subject of hope in her presentation.",
                                "english": "The audience was touched by the main subject of hope in her presentation."
                            }
                        ]
                    },
                    {
                        "sense_id": "51038250-e5d9-3750-ab8e-f63574b22cfa",
                        "entry_id": "8fdecbde-57db-32e2-85a7-81b6ac9532d2",
                        "glosses": [
                            "the main colour of a painting"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "421d4c76-9182-492f-8b5b-90d45a6373f2",
                                "sense_id": "51038250-e5d9-3750-ab8e-f63574b22cfa",
                                "text": "De grondtoon van het schilderij was een rustgevend groen.",
                                "translation": "The main colour of the painting was a soothing green.",
                                "english": "The main colour of the painting was a soothing green."
                            },
                            {
                                "example_id": "316e9c27-fe8c-49e1-97a6-ebd6a1256845",
                                "sense_id": "51038250-e5d9-3750-ab8e-f63574b22cfa",
                                "text": "Ze gebruikte rood als grondtoon om passie en energie over te brengen.",
                                "translation": "She used red as the main colour to convey passion and energy.",
                                "english": "She used red as the main colour to convey passion and energy."
                            },
                            {
                                "example_id": "87b304d8-9d91-4771-bbe1-ccc8fa844d27",
                                "sense_id": "51038250-e5d9-3750-ab8e-f63574b22cfa",
                                "text": "De kunstenaar koos voor een grondtoon van blauw om een gevoel van kalmte te creëren.",
                                "translation": "The artist chose a main colour of blue to create a sense of calmness.",
                                "english": "The artist chose a main colour of blue to create a sense of calmness."
                            }
                        ]
                    }
