                        "form": "den Silberrücken"
                    },
                    {
                        "form_id": "f1c64a1d-807b-4fa3-82e8-dee0a67bb7ab",
                        "entry_id": "1527d8d7-d5bb-3dc5-ba94-acf9c6cefcaa",
                        "tags": [
                            "accusative",
