                "senses": [
                    {
                        "sense_id": "3328f581-50d7-3c46-8b2a-4e79674b4bbd",
                        "entry_id": "acd26dbe-b99f-3050-a1d6-be33c9fc141f",
                        "glosses": [
                            "Gras, das in Steppen wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8017d921-3be0-4741-b0eb-aaf7ea2988c7",
                                "sense_id": "3328f581-50d7-3c46-8b2a-4e79674b4bbd",
                                "text": "„Schließlich taucht das erste dünne, bleiche Steppengras auf, es wächst in den Senken, ist salzig auf der Zunge, blond, strohweiß, leuchtend wie der Flaum auf den Armen.“"
                            },
                            {
                                "example_id": "af2d937b-5659-4041-977e-100a3070635d",
                                "sense_id": "3328f581-50d7-3c46-8b2a-4e79674b4bbd",
                                "text": "„Im Lauf seiner Karriere war er in Afrika und im Nahen Osten ein halbes Dutzend Mal Teil eines solchen Überfallkommandos gewesen, normalerweise ohne Nachtsichtgerät, aber immer mit einer Waffe in der Hand und umgeben von paramilitärischen Spezialkräften, die sich in der Wüste, im Dschungel, in Wohngebieten oder durch Steppengras zügig ihrem Zielobjekt näherten.“"
                            },
                            {
                                "example_id": "dbb1d29f-6217-47be-a34b-70e4be0e44bb",
                                "sense_id": "3328f581-50d7-3c46-8b2a-4e79674b4bbd",
                                "text": "„›Wir werden mit mutierten Steppengräsern beginnen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70a3e2b6-cd19-4b42-b70b-fdcbb4128899",
                        "source_entry_id": "acd26dbe-b99f-3050-a1d6-be33c9fc141f",
                        "source_sense_id": "3328f581-50d7-3c46-8b2a-4e79674b4bbd",
                        "source_sense_description": "Gras, das in Steppen wächst",
                        "target_lang_word": "steppegras",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steppegras",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "faaa82cf-68a3-3c9a-981a-6ec0be16c944",
                                        "entry_id": "eb663dd9-dfad-3300-bc76-1044d2388569",
                                        "glosses": [
                                            "gras dat goed tegen de droogte van de halfwoestijn kan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76c2e71-72d4-45a8-9a6d-0594f60f31c6",
                                                "sense_id": "faaa82cf-68a3-3c9a-981a-6ec0be16c944",
                                                "text": "Ze staat met Pjotr Iljitsj bij het hoge steppegras van Zjarov, antwoordde Semjon glimlachend."
                                            },
                                            {
                                                "example_id": "d1366a74-0f0b-4f2d-8c01-d1eedc81e275",
                                                "sense_id": "faaa82cf-68a3-3c9a-981a-6ec0be16c944",
                                                "text": "Van oorsprong eten paarden steppegras, veel kruiden en takken van bepaalde bomen. Van gewoon gras krijgen ze welvaartsziekten. Aan dit speciale hooi zijn we één keer per drie weken 350 euro kwijt, maar dat is het ons waard. Anders hebben we ook weer hogere dierenartskosten én een boel zorgen om hun gezondheid.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7c9993-f769-3fbd-89ed-558f092c9c99",
                                        "entry_id": "eb663dd9-dfad-3300-bc76-1044d2388569",
                                        "glosses": [
                                            "heel dun gesneden patat frites"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d82dfc07-0cf1-4a25-8aff-d981b0ef9056",
                                                "sense_id": "dd7c9993-f769-3fbd-89ed-558f092c9c99",
                                                "text": "Friet - of patat - kent vele variaties. Belgische frieten hebben meestal een dikte van 10 tot 13 millimeter. Behoorlijk dik, maar niet zo dik als die van de Britten, die hun fries tot wel 15 millimeter dik snijden. Behoorlijk dun zijn de alumettes, superdunne exemplaren die in Frankrijk vaak op het bord verschijnen. Dan heb je nog het zogenoemde ‘steppegras', die 4 millimeter meten. De allerdunste frietjes zijn strofriet: die zijn maar 1,5 millimeter dik. De 'gewone’ patat die je in de cafetaria's krijgt, zijn meestal 10 millimeter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
