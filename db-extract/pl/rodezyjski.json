                                            {
                                                "example_id": "9fa2687c-d268-4c23-908f-3ce1b91b21cc",
                                                "sense_id": "31047222-0031-38d0-ac8c-3b60ad930faf",
                                                "text": "“Take it easy, Tahm-boo,” your boss says, her Rhodesian accent returning inexplicably."
                                            }
                                        ]
                                    }
                                ]
                            },
