                    {
                        "sense_id": "b1ce63d3-0ec2-3c9e-947b-3d8e66088ba5",
                        "entry_id": "3f7ba8d7-175f-3367-9762-cb0aedfc97e0",
                        "glosses": [
                            "Vendeur de thériaque. Il ne se dit qu'en mauvaise part des saltimbanques et des charlatans qui débitent la thériaque et autres drogues sur un théâtre."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5f878b6e-1994-3e4d-b412-6ff974d01d4b",
                        "entry_id": "3f7ba8d7-175f-3367-9762-cb0aedfc97e0",
                        "glosses": [
                            "Se dit d'un homme qui parle à la manière des charlatans, pour faire valoir ce qu'il dit ou ce qu'il fait, et qui cherche à tromper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50af0397-74f9-4969-92c0-0eb45ec9c687",
                                "sense_id": "5f878b6e-1994-3e4d-b412-6ff974d01d4b",
                                "text": "Un franc triacleur."
                            },
                            {
                                "example_id": "84281b05-2ddb-4bc3-ab94-a40b13ce46aa",
                                "sense_id": "5f878b6e-1994-3e4d-b412-6ff974d01d4b",
                                "text": "Tous ces beaux suffisants dont la cour est semée,\nNe sont que triacleurs et vendeurs de fumée."
                            },
                            {
                                "example_id": "2b96a35e-4748-45b5-ba28-ded57f7c338a",
                                "sense_id": "5f878b6e-1994-3e4d-b412-6ff974d01d4b",
                                "text": "Un certain Jérôme Bolsec, un peu auparavant carme de Paris, et puis soudain devenu de théologien médecin, ou plus tost triacleur."
                            }
                        ]
                    }
