                    {
                        "translation_id": "845298c8-8fd4-47d9-b479-df03a4dc1bf4",
                        "source_entry_id": "cf124802-9679-3b2d-8975-0e799b98e0d5",
                        "source_sense_id": "790e7ca2-e0c8-3328-8bfc-7e642877f9c8",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Baruch",
