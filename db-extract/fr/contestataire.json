        "fr-extract.jsonl": [
            {
                "entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                "word": "contestataire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c76dedda-0c49-434c-9d2f-99eea6f29273",
                        "entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "contestataires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                        "entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                        "glosses": [
                            "Qui conteste les valeurs dominantes d'une société avec refus de s'intégrer dans un ordre social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e06e158-0943-43f7-88c1-cfeeb0b1bfea",
                                "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                "text": "Le punk est un mouvement contestataire."
                            },
                            {
                                "example_id": "009b97f6-2dc5-43fc-9a1c-9498d47f1dde",
                                "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                "text": "Comme s'il avait retrouvé son ancien élan de dissident contestataire, il a refusé une déclaration exigée par cette loi, car il la trouvait indigne, contraire aux droits de l'homme et à la Constitution."
                            },
                            {
                                "example_id": "a9c3f545-b948-4a29-813e-29f27f07c888",
                                "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                "text": "Quant aux mouvements contestataires de l'Ouest : Beatles, cheveux longs et musique rock, les Chinois n'y voyaient, dit-on, que des caprices d'adolescents et un leurre …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45e7ee33-0e0b-4d68-af85-a516882fb932",
                        "source_entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                        "source_sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                        "target_lang_word": "Protestler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protestler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c9a64a-05d1-34b9-9872-61d06ffbf048",
                                        "entry_id": "8d1817e6-47fb-3ea0-b954-6aa679d38564",
                                        "glosses": [
                                            "Person, die gegen etwas protestiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011aa0f3-9560-4d58-a100-9f77edb88457",
                                                "sense_id": "f2c9a64a-05d1-34b9-9872-61d06ffbf048",
                                                "text": "Die Protestler verhielten sich gegenüber den Polizisten friedlich."
                                            },
                                            {
                                                "example_id": "78d5271c-6a35-42e2-8eeb-142e1aec1ee2",
                                                "sense_id": "f2c9a64a-05d1-34b9-9872-61d06ffbf048",
                                                "text": "„Die technikaffinen Protestler stellten alles ins Netz und sorgten, wenn auch mit dem Defizit, dass nicht alles nachprüfbar war, für eine breite Öffentlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dda96dd-ad9f-4856-bf1f-049a6a0c7594",
                        "source_entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                        "source_sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                        "target_lang_word": "antiestablishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiestablishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60c3cfc0-355b-3ab4-bcfd-70714a351d23",
                                        "entry_id": "af96db0c-7969-331c-8cf3-028adbe61b1b",
                                        "glosses": [
                                            "Alternative spelling of anti-establishment."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dba1552a-9a65-45a9-a665-677aacbaac3b",
                                                "sense_id": "60c3cfc0-355b-3ab4-bcfd-70714a351d23",
                                                "text": "Asked whether he worries about losing his antiestablishment aura or, worse yet, being accused of selling out, he said: “I think it depends on what you do with your success.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "068b4442-e6ed-45e1-9acd-c0ccf1bc000c",
                        "source_entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                        "source_sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                        "target_lang_word": "contestatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contestatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a8176f-b806-3203-8a85-6471760b7174",
                                        "entry_id": "5236bf47-98f1-3ebb-9016-3f4e62a5189c",
                                        "glosses": [
                                            "Serving to contest something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24059903-450e-4b8b-9f91-342848d11055",
                                                "sense_id": "a7a8176f-b806-3203-8a85-6471760b7174",
                                                "text": "It is one thing to compare the claims that can be made for cinema as a homogeneous and homogenizing, versus a heterogeneous institution, and another thing to valorize heterogeneity as necessarily contestatory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9ab47ea-01ba-41d6-8f9e-8c25919ee674",
                        "source_entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                        "source_sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                        "target_lang_word": "dissenter",
