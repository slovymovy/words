                                "target_senses": [
                                    {
                                        "sense_id": "6c321105-457d-3319-9c65-a73649ff85bb",
                                        "entry_id": "a1f3d836-bfeb-3697-b5cf-33150efe46ee",
                                        "glosses": [
                                            "The issuing or selling of tickets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399afe01-9fba-4e55-9466-9507b5eaf2ea",
                                                "sense_id": "6c321105-457d-3319-9c65-a73649ff85bb",
                                                "text": "Other approaches, which apply to bus as well, are to upgrade existing facilities, improve ticketing, ensure fares are affordable and longer operating hours."
                                            },
                                            {
                                                "example_id": "639d2b7c-32ce-47e4-b793-f251765fa20e",
                                                "sense_id": "6c321105-457d-3319-9c65-a73649ff85bb",
                                                "text": "Quizzed on simplifying fares, Heaton-Harris said the Government had inherited a \"mix of ticketing and unbelievable, interesting fares up and down the system, and we do want to simplify them\"."
                                            },
                                            {
                                                "example_id": "f6c019b1-b332-41b0-8342-2f7808b73e23",
                                                "sense_id": "6c321105-457d-3319-9c65-a73649ff85bb",
                                                "text": "Traditionally, 'ticket office' seems to have been the preferred term in America, with Britain using the term 'booking office' (as an 1881 edition of The Railway Age Monthly and Railway Service Magazine explains). Today, the two are often used interchangeably (as the recent 'Save our ticket offices' campaign shows), with the term 'ticketing' perhaps capturing more of the point-of-sale transaction and issuing of tickets within stations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf71edac-1eac-31d2-aae0-f7ece4ea1c53",
                                        "entry_id": "a1f3d836-bfeb-3697-b5cf-33150efe46ee",
                                        "glosses": [
                                            "A periodic sale of ore in the mining districts, in which buyers wrote their bids upon tickets."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
