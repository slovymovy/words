                        "source_entry_id": "5a1e97e1-92e1-3a3d-9418-1073e2372293",
                        "source_sense_id": "d040fc24-adc3-3c76-96b6-9b9184f33f4e",
                        "target_lang_word": "обрез",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
