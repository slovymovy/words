                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9357af1-132b-337e-8ad4-2b9a241a91bf",
                        "entry_id": "14d06bb1-d1f8-3817-b4ce-6403528d48b9",
                        "glosses": [
                            "behorend tot de stand van dorpsbewoners, die weinig status had"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18386027-1be4-4d88-a520-d4012f546194",
                                "sense_id": "c9357af1-132b-337e-8ad4-2b9a241a91bf",
                                "text": "Verstaat gij? Ik, Jacques de Châtillon,\nDe gunsteling van Jehanne de Navarre,\nOnteerd, bespot door gans de ridderschap\nVan Vrankrijk, van de hele Kerstenheid,\nDoor 't dorper volk gewezen met den vinger; (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "a496cab1-2c19-3566-a4e4-158f8aa37f4b",
                        "entry_id": "14d06bb1-d1f8-3817-b4ce-6403528d48b9",
                        "glosses": [
                            "weinig beschaafd of respectabel"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "bab0e27d-40b4-494f-8a78-5ec1227bb221",
                                "sense_id": "a496cab1-2c19-3566-a4e4-158f8aa37f4b",
                                "text": "Wie van de toehoorders na het horen van deze woorden zou weglopen, kwalificeert zich als dorper en dwaas, als bot en dom."
                            }
                        ]
                    }
                ],
