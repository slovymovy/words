                    {
                        "sense_id": "7ef989b4-d471-395d-b08b-dc947c3e75d6",
                        "entry_id": "b40de10e-b8cc-3a88-af08-8c9aa5eabcba",
                        "glosses": [
                            "abschließende Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ecf0b31-5399-4843-a514-455bfec8816c",
                                "sense_id": "7ef989b4-d471-395d-b08b-dc947c3e75d6",
                                "text": "„Am Nachmittag kam es auf dem für die Schlussveranstaltung vorgesehenen Gelände, der abgeschlossenen Liegenschaft eines ehemaligen Güterbahnhofs mit einem einzigen Zugang, auf eng begrenztem Raum zu einer derartigen Verdichtung der Besucherströme, dass im Zugangsbereich Menschen den Tod fanden und 600 weitere verletzt wurden, viele davon schwer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
