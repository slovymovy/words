                    }
                ],
                "translations": [
                    {
                        "translation_id": "50e0a272-0630-49ca-bbf0-72347e822bd6",
                        "source_entry_id": "f3f9c5a2-3048-3615-9064-0b3518cea364",
                        "source_sense_id": "fb632c98-3fea-3bff-ad1a-b65c4715a882",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Verlobung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlobung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                        "entry_id": "8fb0d999-43e0-323e-a1aa-f31d36dd3d6c",
                                        "glosses": [
                                            "das Versprechen, eine Person (den Verlobten beziehungsweise die Verlobte) zu heiraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314421d5-ebcf-4e20-b35a-8e013f2bb0a1",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "Die Verlobung der beiden fand heute statt."
                                            },
                                            {
                                                "example_id": "0b744582-1f90-4a99-8e4a-5b89bd97600b",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„Da soll etwas geschieden werden, das eigentlich noch gar nicht angefangen hat, es ist ein Mittelding zwischen einer handfesten Ehescheidung und einer zurückgegangenen Verlobung.“"
                                            },
                                            {
                                                "example_id": "4e51830a-37b7-4df5-bd51-2100533ee7a0",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„Wenn sie, vielleicht nach einem halben Jahre, das Gefühl haben würde, ihn doch nicht von ganzem Herzen zu lieben, so würde sie durchaus recht daran tun, von der Verlobung zurückzutreten.“"
                                            },
                                            {
                                                "example_id": "97e7b3bb-6f5f-48c3-83a1-9e8f56e4a7ec",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„So kam es, daß er am selben Tag, an dem, nach gegenseitigem Abkommen, seine Verlobung mit Victoire veröffentlicht werden sollte, Berlin verließ.“"
                                            },
                                            {
                                                "example_id": "ed5cc680-6577-4184-a4e2-fbab15b3452f",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„Erst nach ihrer Verlobung löste sie sich langsam aus den größten Zwängen der Gutsverwaltung und plante ein neues Leben mit Jochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e830eb0f-1458-485d-84e3-9c319e9509db",
                        "source_entry_id": "f3f9c5a2-3048-3615-9064-0b3518cea364",
                        "source_sense_id": "fb632c98-3fea-3bff-ad1a-b65c4715a882",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Verlöbnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlöbnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                        "entry_id": "60767cc1-38bf-32c0-990d-9a0552b087b3",
                                        "glosses": [
                                            "Verlobung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e669716-9dfd-4320-981c-a9b6693ca9cb",
                                                "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                                "text": "Das Verlöbnis von Hans und Anne fand am 1. August statt."
                                            },
                                            {
                                                "example_id": "eb36ee14-5fd9-4429-8125-8c81c5bd37f9",
                                                "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                                "text": "„Aber in der geheimsten Tiefe ihrer Seele quälte sie doch die Frage, ob ihr Verlöbnis mit Boris ein Scherz oder ein ernstzunehmendes und bindendes Versprechen gewesen war.“"
                                            },
                                            {
                                                "example_id": "d39c9b6a-e827-49d2-a146-94a838a2a417",
                                                "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                                "text": "„Einen Abend und eine Maiennacht lang währte das Verlöbnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "696b3d8e-c554-4aa4-b935-dece44fe3412",
                        "source_entry_id": "f3f9c5a2-3048-3615-9064-0b3518cea364",
                        "source_sense_id": "bfe569cf-0a4d-33ab-8246-86fb23ea6e79",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Vermählung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermählung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4987017-3f49-350e-97d5-b24e8ad75ce5",
                                        "entry_id": "7c3ecc1b-5fff-3f99-a78e-095f4e74d252",
                                        "glosses": [
                                            "(erzwungene oder freiwillige) Eheschließung zweier Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf26ff77-918f-42b8-9892-467a7cc60fd1",
                                                "sense_id": "f4987017-3f49-350e-97d5-b24e8ad75ce5",
                                                "text": "„Die Vermählung des Dauphin François fand am 15. Oktober 1548 statt und nicht am 20. März 1549.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "012a993e-d9be-4842-a778-8ead0632d227",
                        "source_entry_id": "f3f9c5a2-3048-3615-9064-0b3518cea364",
                        "source_sense_id": "bfe569cf-0a4d-33ab-8246-86fb23ea6e79",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Trauung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trauung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd8b3f0-8b44-3375-b199-0db3d213e56b",
                                        "entry_id": "7b981996-9a75-384e-8d4d-7622b329e57d",
                                        "glosses": [
                                            "Verheiratung zweier Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a33e8b5-2012-4b8b-bc42-bc6667d793a7",
                                                "sense_id": "5fd8b3f0-8b44-3375-b199-0db3d213e56b",
                                                "text": "Unsere kirchliche Trauung findet am kommenden Samstag statt."
                                            },
                                            {
                                                "example_id": "2c903ea8-45a6-4f3a-a799-1476800bcdf1",
                                                "sense_id": "5fd8b3f0-8b44-3375-b199-0db3d213e56b",
                                                "text": "„Seine kurzen Ansprachen vor den zur Trauung entschlossenen Paaren waren immer eher spröde.“"
                                            },
                                            {
                                                "example_id": "4d225101-cc8d-436c-b1db-38c69f227172",
                                                "sense_id": "5fd8b3f0-8b44-3375-b199-0db3d213e56b",
                                                "text": "„Vor einigen Wochen baten Sie mich, der Pfarrer bei ihrer Trauung zu sein. Deshalb sitzen wir jetzt zusammen.“"
                                            },
                                            {
                                                "example_id": "2c9382a8-d642-452c-89a1-b1f1f6e3aaff",
                                                "sense_id": "5fd8b3f0-8b44-3375-b199-0db3d213e56b",
                                                "text": "„1558 wurde Notre-Dame zum Schauplatz einer spektakulären Trauung: Der künftige König von Frankreich, Franz II., ehelichte Maria Stuart.“"
                                            },
                                            {
                                                "example_id": "d2a0c47a-331e-4250-a5d3-14d32492d91a",
                                                "sense_id": "5fd8b3f0-8b44-3375-b199-0db3d213e56b",
                                                "text": "„Sie katholisch, er evangelisch, beide ganz jung, wollen bei der Trauung alles richtig machen. Sie heiraten in einer katholischen Kirche mit Priester und evangelischer Pfarrerin, die die Predigt halten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0f27236-3001-40ec-9e41-d90f8af05a6f",
                        "source_entry_id": "f3f9c5a2-3048-3615-9064-0b3518cea364",
                        "source_sense_id": "2bc4f3a4-5dbf-33f1-b257-9810adef1470",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Parteinahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parteinahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4e1abd-ee4a-3b1e-97a1-5fbaf86dfd4c",
                                        "entry_id": "758e53e1-8748-3e16-b3dc-fd0e3a975458",
                                        "glosses": [
                                            "einseitige Stellungnahme zugunsten einer Konfliktpartei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b9cfba-c6c8-4e6f-bb8f-7c96fba0af05",
                                                "sense_id": "0c4e1abd-ee4a-3b1e-97a1-5fbaf86dfd4c",
                                                "text": "„Die ebenso leidenschaftliche wie kritiklose Parteinahme für die Serben (der übrigens seit damals eine ebenso leidenschaftliche wie kritiklose Parteinahme gegen die Serben entgegensteht) zeigt das deutlich.“"
                                            },
                                            {
                                                "example_id": "2652739c-7254-4f70-a69d-ad3ee0585d4a",
                                                "sense_id": "0c4e1abd-ee4a-3b1e-97a1-5fbaf86dfd4c",
                                                "text": "„Auch die Parteinahme für die Ostküstenstaaten zahlte sich für die Indigenen nicht aus: In den Jahren nach dem Sieg der 13 Kolonien verloren sie einen großen Teil ihrer Gebiete an die Siedler.“"
                                            },
                                            {
                                                "example_id": "e9af8296-7499-4d19-9d90-832e8f1b2343",
                                                "sense_id": "0c4e1abd-ee4a-3b1e-97a1-5fbaf86dfd4c",
                                                "text": "„Nach anfänglichen Überlegungen, die Sanktionen aufzuheben, verzichtete Thatcher in Lusaka jedoch auf eine einseitige Parteinahme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
