                                        "glosses": [
                                            "von sich selbst, der eigenen Person, so bezeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a04bf457-8ed3-4ab4-b8fb-70ccd25a442c",
                                                "sense_id": "e278bf56-49b5-3d65-a8b8-43c58d282664",
                                                "text": "Als selbsternannte Künstlerin versucht sie, sich ein Flair der Boheme zu geben."
                                            },
                                            {
                                                "example_id": "ec758c24-7b7d-42c5-b277-8cbcf2f689fd",
                                                "sense_id": "e278bf56-49b5-3d65-a8b8-43c58d282664",
                                                "text": "Die Welt ist voll von selbsternannten Experten zu allem und jedem."
                                            }
                                        ],
