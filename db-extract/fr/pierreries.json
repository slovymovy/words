                "senses": [
                    {
                        "sense_id": "7d7d6c4e-baea-3ff4-903d-4879bfd7e9a7",
                        "entry_id": "0218a030-07f9-3643-ada3-b576f1d196bd",
                        "glosses": [
                            "Pierres précieuses travaillées."
                        ],
                        "tags": [
                            "collectively",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ee87183a-8f41-474f-a9d4-4a68e2ee8cc2",
                                "sense_id": "7d7d6c4e-baea-3ff4-903d-4879bfd7e9a7",
                                "text": "Croyez-vous que j’estime ces pierreries étincelantes plus que ma liberté, ou que mon père y attache plus de prix qu’à la vie et à l’honneur de son enfant ?"
                            },
                            {
                                "example_id": "2d360b0f-f544-43d8-bc9d-f21a3d96c523",
                                "sense_id": "7d7d6c4e-baea-3ff4-903d-4879bfd7e9a7",
                                "text": "[…] : puis il […] se coiffa d’un toquet de velours noir sans plume ni pierreries, s’enveloppa d’un manteau de couleur sombre, […]."
                            },
                            {
                                "example_id": "087c01c0-1aa8-4520-8891-b9ae591e9cb0",
                                "sense_id": "7d7d6c4e-baea-3ff4-903d-4879bfd7e9a7",
                                "text": "Les Turkomanes riches portent aux bras et aux pieds des bracelets pour la plupart en argent et ornés de turquoises, des ceintures et des colliers enrichis de pierreries et d'énormes boucles d’oreilles, le tout en argent."
                            }
                        ]
                    }
                ],
