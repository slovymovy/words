                "senses": [
                    {
                        "sense_id": "6ca39dd9-368f-3cfa-86c3-6d49599ed925",
                        "entry_id": "b126b694-400e-3e14-93a2-586c993c47d9",
                        "glosses": [
                            "устар. деятель, рачитель, ревнитель, попечитель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11a7faf0-c894-4ca8-8224-96ed27db36be",
                                "sense_id": "6ca39dd9-368f-3cfa-86c3-6d49599ed925",
                                "text": "По всему хороший был парень, к отцу, к матери почтительный, о братишке да об сёстрах заботливый, по дому во всём старатель."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c094571-2dfc-376b-ab80-f50af7151aac",
                        "entry_id": "b126b694-400e-3e14-93a2-586c993c47d9",
                        "glosses": [
                            "человек, добывающий золото кустарным способом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba4018a-eedb-48a8-8ba7-bc6e194d62fb",
                                "sense_id": "3c094571-2dfc-376b-ab80-f50af7151aac",
                                "text": "Пёстрые кучки старателей были рассыпаны по всему прииску; по ним можно было определить положение вашгердов, на которых совершалась промывка песков."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fbe3141-f5ce-485d-9b10-14ac669202fa",
                        "source_entry_id": "b126b694-400e-3e14-93a2-586c993c47d9",
                        "source_sense_description": "человек, добывающий золото",
                        "target_lang_word": "prospector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prospector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13c48996-04ba-3bc9-b445-9e929bf6f74e",
                                        "entry_id": "6e76d641-9f73-362e-81cb-f413134557cf",
                                        "glosses": [
                                            "A person who explores or prospects an area in search of mineral deposits, such as gold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b70540-9f81-4edb-82dc-27addae85e21",
                                                "sense_id": "13c48996-04ba-3bc9-b445-9e929bf6f74e",
                                                "text": "A large number of prospectors have crossed over the divide to the British head waters of the Yukon, in search of the rich diggings found by a lucky few last year."
                                            },
                                            {
                                                "example_id": "6efc0563-7cfe-4cfa-8d1e-c1b8b8bf9eb7",
                                                "sense_id": "13c48996-04ba-3bc9-b445-9e929bf6f74e",
                                                "text": "The south polar region of Promethei Planum developed a Bermuda Triangle reputation. Satellites detected intermittent mass concentrations and magnetic field shifts. In 2148, prospectors working near Deseado Crater discovered an underground complex: a Prothean observation post. The odd phenomena were generated by the operation and discharge of a mass effect core, struggling to function despite fifty millennia of neglect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d747e6f-ec00-4d3c-9097-8ea5c7d13e13",
                        "source_entry_id": "b126b694-400e-3e14-93a2-586c993c47d9",
                        "source_sense_description": "человек, добывающий золото",
                        "target_lang_word": "gold-digger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold-digger",
                                "target_lang_code": "en",
