                        "entry_id": "599f1c59-929b-393b-bf3e-034eedc7d5c6",
                        "glosses": [
                            "decyzja podjęta przez sędziów, jurorów, ławę przysięgłych, komisję itp."
                        ],
                        "tags": [],
