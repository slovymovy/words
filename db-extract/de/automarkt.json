                "senses": [
                    {
                        "sense_id": "78786f6d-6160-398b-9d60-450d4644085a",
                        "entry_id": "91bee513-519b-3b1c-80ee-f2fb138d4f74",
                        "glosses": [
                            "Markt^([3]) von Autos; sprich Angebot und Nachfrage von Autos"
                        ],
                        "tags": [
                            "Automobil",
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "9294632e-40f7-4f7e-acf5-33b48fef98f6",
                                "sense_id": "78786f6d-6160-398b-9d60-450d4644085a",
                                "text": "„Nachdem der deutsche Automarkt in den ersten drei Monaten konstant zulegte, verzeichnete die Neuzulassungsstatistik des Kraftfahrtbundesamts (KBA) im April erstmals einen Rückgang im Vergleich zum Vorjahresmonat: Mit 274 097 Autos wurden 3,6 Prozent weniger angemeldet als im April 2013.“"
                            },
                            {
                                "example_id": "861cb165-04d2-44ef-9259-4cc2a9921767",
                                "sense_id": "78786f6d-6160-398b-9d60-450d4644085a",
                                "text": "„Im Jahresvergleich liegt der Automarkt noch in der Gewinnzone (plus 2,9 Prozent).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
