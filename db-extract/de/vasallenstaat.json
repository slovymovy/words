                "senses": [
                    {
                        "sense_id": "eed7f127-78b3-391c-8b31-47e17df2dce5",
                        "entry_id": "20914959-91e8-3c75-931a-87c623b7b382",
                        "glosses": [
                            "von einem ausländischen Staat abhängiger, unsouveräner Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf61d13-a656-47cb-95ca-5c034ed2808b",
                                "sense_id": "eed7f127-78b3-391c-8b31-47e17df2dce5",
                                "text": "Polen war im Kalten Krieg ein Vasallenstaat Moskaus."
                            },
                            {
                                "example_id": "9d8d2134-10f3-49ad-842c-da0f4544a2ec",
                                "sense_id": "eed7f127-78b3-391c-8b31-47e17df2dce5",
                                "text": "„Die Serben konnten jedenfalls nicht verhindern, dass sie nach der Schlacht auf dem Amselfeld zu einem türkischen Vasallenstaat wurden und ab Mitte des 15. Jahrhunderts dem Osmanischen Reich angehörten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16f23d09-2d59-4443-adb7-7072c57a78c0",
                        "source_entry_id": "20914959-91e8-3c75-931a-87c623b7b382",
                        "source_sense_id": "eed7f127-78b3-391c-8b31-47e17df2dce5",
                        "source_sense_description": "Politik: von einem ausländischen Staat abhängiger, unsouveräner Staat",
                        "target_lang_word": "satellite state",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satellite state",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2391e13c-d34e-3672-8961-2b57494776e1",
                                        "entry_id": "154d50ca-3744-30f6-80a5-5730ce284b5f",
                                        "glosses": [
                                            "A country that is formally independent, but under heavy influence or control from another country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf373c17-c245-4476-9a0d-205d87fef6b9",
                                                "sense_id": "2391e13c-d34e-3672-8961-2b57494776e1",
                                                "text": "As the principal link between the satellite states, the \"Balt-Orient Express\" is the train most affected by the gradual liberalisation of travel, and had frequently to be strengthened or duplicated during the summer of 1956."
                                            },
                                            {
                                                "example_id": "f38db755-7a95-4005-834a-267d2838a3b0",
                                                "sense_id": "2391e13c-d34e-3672-8961-2b57494776e1",
                                                "text": "From this may be gathered, as is often confirmed by the press in the satellite states, that the Soviet Union has become more interested in the military protection of the industries of the satellite states."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
