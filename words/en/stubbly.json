{
    "word_family": [
        "stubble"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "defcd933-ce5d-3ab3-b39a-b4ab6204afcb",
                    "sense_definition": "Covered with or having short, stiff hairs or stalks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rubbed his <w>stubbly</w> chin after not shaving for three days.",
                            "target_lang_translations": {
                                "cs": "Potřel si svou <w>strniskatou</w> bradu poté, co se tři dny neholil."
                            }
                        },
                        {
                            "text": "The farmer walked across the <w>stubbly</w> field after the wheat was cut.",
                            "target_lang_translations": {
                                "cs": "Farmář kráčel přes <w>strništní</w> pole poté, co byla pšenice posekána."
                            }
                        }
                    ],
                    "synonyms": [
                        "bristly",
                        "rough"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "stubbly chin",
                        "stubbly field"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrytý krátkými, tuhými chlupy nebo zbytky stébel."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strništní",
                                "target_lang_sense_clarification": "vztahující se ke strništi na poli"
                            },
                            {
                                "target_lang_word": "strniskatý",
                                "target_lang_sense_clarification": "mající vzhled nebo texturu strniště"
                            },
                            {
                                "target_lang_word": "drsný",
                                "target_lang_sense_clarification": "mající hrubý povrch jako neoholená tvář"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a636f531-63e2-37fd-8041-ff3e343fc4b0",
                    "sense_definition": "Having the rough, coarse texture characteristic of stubble.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stubbly</w> texture of the fabric felt uncomfortable against his skin.",
                            "target_lang_translations": {
                                "cs": "<w>Drsná</w> textura látky byla na jeho kůži nepříjemná."
                            }
                        },
                        {
                            "text": "She disliked the <w>stubbly</w> feel of the dry grass under her bare feet.",
                            "target_lang_translations": {
                                "cs": "Nelíbil se jí <w>pichlavý</w> pocit suché trávy pod bosýma nohama."
                            }
                        }
                    ],
                    "synonyms": [
                        "coarse",
                        "scratchy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající hrubou, drsnou texturu typickou pro strniště."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drsný",
                                "target_lang_sense_clarification": "mající nepříjemně hrubý povrch"
                            },
                            {
                                "target_lang_word": "pichlavý",
                                "target_lang_sense_clarification": "způsobující pocit škrábání nebo píchání"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}