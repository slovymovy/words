                "senses": [
                    {
                        "sense_id": "bb26440e-c833-3d2a-85e4-a9221ccea702",
                        "entry_id": "44192f28-0cf2-32c1-87b1-e1a4c70c9790",
                        "glosses": [
                            "Transformer en bonsaï."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5ecefa2f-4bb7-439b-97b7-0ab41b71328e",
                                "sense_id": "bb26440e-c833-3d2a-85e4-a9221ccea702",
                                "text": "On peut imaginer que les jardiniers taillent le pin pour le « bonzaïfier »."
                            },
                            {
                                "example_id": "c3c5a913-a0c3-404f-9e5d-85c08fee73e4",
                                "sense_id": "bb26440e-c833-3d2a-85e4-a9221ccea702",
                                "text": "Au lieu d'abattre un arbre devenu gênant, pourquoi ne pas le « bonzaïfier » !"
                            },
                            {
                                "example_id": "252e5744-cdce-4f72-b5a2-9057c4d047dc",
                                "sense_id": "bb26440e-c833-3d2a-85e4-a9221ccea702",
                                "text": "J'affectionne les cactées et succulentes et tout ce qui peut se \"bonzaïfier\"."
                            }
                        ]
                    }
