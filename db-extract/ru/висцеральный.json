                                                "example_id": "0e69c831-2f42-4ca1-b35b-84a2e23161aa",
                                                "sense_id": "8384dcd3-ab72-3815-be46-19183a087e01",
                                                "text": "On est loin désormais de l’anti-psychiatrie primaire et pour tout dire viscérale, d’un T. Szasz."
                                            },
                                            {
                                                "example_id": "f998f2bb-f432-4192-bdd9-3a4f834ab718",
                                                "sense_id": "8384dcd3-ab72-3815-be46-19183a087e01",
                                                "text": "Des nouvelles qui témoignent d'un attachement fort, voire viscéral, pour cette terre mise à feu et à sang depuis bientôt dix ans."
                                            }
