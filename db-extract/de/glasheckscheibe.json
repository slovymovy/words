                "senses": [
                    {
                        "sense_id": "8a2879e8-8e17-3e2b-bc4c-26e5f8680d7d",
                        "entry_id": "c88bf7dc-2ce3-3b3e-92f9-98ca840c9ab7",
                        "glosses": [
                            "Heckscheibe, die aus Glas gefertigt ist"
                        ],
                        "tags": [
                            "bei Cabrios",
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "466f5177-d34b-48db-8769-8b6f9503507f",
                                "sense_id": "8a2879e8-8e17-3e2b-bc4c-26e5f8680d7d",
                                "text": "„Natürlich bleibt es zudem beim klassischen Stoffverdeck mit Glasheckscheibe, im Interieur bei Virtual Cockpit und LTE-Technik.“"
                            },
                            {
                                "example_id": "b4a4c1b8-dd7f-40ed-8574-8dbca8403ce2",
                                "sense_id": "8a2879e8-8e17-3e2b-bc4c-26e5f8680d7d",
                                "text": "„Markant sind die kugelrunden Scheinwerferaugen und die schwarze Glasheckscheibe.“"
                            },
                            {
                                "example_id": "57ca1731-4289-43a3-bfc6-909f9f3b21cd",
                                "sense_id": "8a2879e8-8e17-3e2b-bc4c-26e5f8680d7d",
                                "text": "„Außerdem bekommen die Spyder-Modelle ab sofort eine beheizbare Glasheckscheibe.“"
                            },
                            {
                                "example_id": "10016875-7262-4ade-bb01-57685bba73e1",
                                "sense_id": "8a2879e8-8e17-3e2b-bc4c-26e5f8680d7d",
                                "text": "„Die beheizbare Glasheckscheibe verschwindet dabei hinter der Kofferraumabdeckung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
