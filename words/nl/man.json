                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Het eiland <w>Man</w> ligt precies tussen Groot-Brittannië en Ierland.",
                            "target_lang_translations": {
                                "en": "The Isle of <w>Man</w> is located exactly between Great Britain and Ireland.",
                                "ru": "Остров <w>Мэн</w> расположен точно между Великобританией и Ирландией."
                            }
                        },
                        {
                            "text": "Toeristen bezoeken het eiland <w>Man</w> vaak voor de beroemde motorraces.",
                            "target_lang_translations": {
