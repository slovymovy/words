                    {
                        "sense_id": "7845cf54-99c7-3c40-aa38-9df4fc1f49cd",
                        "entry_id": "d54ae93b-d939-3333-a26e-540438794244",
                        "glosses": [
                            "freiwilliges Geben über das normale Maß hinaus; großzügige Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76890c1a-f645-43f2-963f-95d792e6c15e",
                                "sense_id": "7845cf54-99c7-3c40-aa38-9df4fc1f49cd",
                                "text": "„Er praktiziert Weitherzigkeit und hat darin ein Maß, das so weit wie das Meer ist.“"
                            },
                            {
                                "example_id": "c91aba1c-3b8e-4a72-9cbc-5a01d40f4dd7",
                                "sense_id": "7845cf54-99c7-3c40-aa38-9df4fc1f49cd",
                                "text": "„Ich kenne die fast unbegrenzte Weitherzigkeit der Religion von Grund aus und verehre in dieser Weitherzigkeit eine ihrer herrlichsten Segnungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
