                                        "glosses": [
                                            "The quality of a word, form or phoneme that is considered to be more complicated, less natural or stranger than the usual form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691c28be-004d-483b-9fef-c75a6e41b868",
                                                "sense_id": "761641b0-97db-3b5a-a85a-6a6e5de2c99c",
                                                "text": "Using the word \"comedienne\" instead of \"comedian\" can be seen as an example of markedness."
                                            }
