                "translations": [
                    {
                        "translation_id": "d0c62039-b724-45e3-98ce-34ad4d497b1d",
                        "source_entry_id": "fbaae8b1-4f44-3119-95a7-4687c37e69d8",
                        "source_sense_id": "f8d81e2b-e949-332a-b75c-b53a2a6e1ca2",
                        "target_lang_word": "Klatschtante",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klatschtante",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                        "entry_id": "a2110fe8-bf40-3296-88bd-45916a21755a",
                                        "glosses": [
                                            "weibliche Person, die gerne über andere Personen herzieht / abfällig redet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f707bb-ebc4-40c2-b7cf-1b78df38006f",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "Eine bessere Gesprächspartnerin [in der Mittagspause] ist allerdings die Klatschtante. Ein Mittagessen mit ihr empfiehlt sich besonders, um sich nach längerer Abwesenheit wieder auf den neuesten Stand zu bringen. Sie weiß, wer mit wem (nicht mehr auskommt), wer als Nächstes kündigt und wie die Stimmung in der Chefetage ist."
                                            },
                                            {
                                                "example_id": "a5b8d560-68af-45bd-840b-f1df96b8f903",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "[Michael Graeter] hat früher die Klatschtante bei der Münchner „AZ“ gemacht."
                                            },
                                            {
                                                "example_id": "034c9fa2-16cc-4523-8b23-028b9db2557a",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "Hollywoods Klatschtante Louella Parsons nannte Pier Angeli die beste Nachwuchsschauspielerin des Monats und verglich sie gleichzeitig mit Ingrid Bergman, als sie in „Intermezzo“ erschien."
                                            },
                                            {
                                                "example_id": "148168fb-8bc0-43d0-8ced-5ef8046e152f",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "„Sie hat nichts zu tun und ist die Klatschtante der Straße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd3f1883-ec2a-48ba-9059-2c3b8417ea99",
                        "source_entry_id": "fbaae8b1-4f44-3119-95a7-4687c37e69d8",
                        "source_sense_id": "f8d81e2b-e949-332a-b75c-b53a2a6e1ca2",
                        "target_lang_word": "chatterbox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chatterbox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e98ebe6-3c83-3c78-987c-6262439d5e09",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "One who chats or talks to excess."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f8fb86-2e93-40a4-aead-e23f6fb42d60",
                                                "sense_id": "0e98ebe6-3c83-3c78-987c-6262439d5e09",
                                                "text": "[S]he [Edwina, mother of Tennessee Williams] was indeed Amanda [Wingfield, character in Williams' play The Glass Menagerie] in the flesh: a doughty chatterbox from Ohio who adopted the manner of a Southern belle and eschewed both drink and sex to the greatest extent possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecd2c56-c4c9-3990-9561-bdaa80e9358f",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "Synonym of cootie catcher (“children's fortune-telling device”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e859580a-ed42-315c-8fdf-6906d77dabab",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "Synonym of chatterbot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3933cdbd-13e5-30b4-90dc-ee76deaf065c",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "The orchid Epipactis gigantea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6945973-72b3-4af2-bb43-d71a521644aa",
                        "source_entry_id": "fbaae8b1-4f44-3119-95a7-4687c37e69d8",
                        "source_sense_id": "f8d81e2b-e949-332a-b75c-b53a2a6e1ca2",
                        "target_lang_word": "pipelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pipelette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                        "entry_id": "c33b36c1-2416-3b74-add3-27e1ccf5effc",
                                        "glosses": [
                                            "Personne bavarde voire indiscrète."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ced98f3e-345c-474f-8155-39ba57aab566",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Les enfants, on sait ce que c’est, n’est-ce pas ! On peut le répéter : des braillards, des insolents, des crève-culotte, côté garçons ; des sournoises, des mijaurées, de petites pipelettes, côté filles."
                                            },
                                            {
                                                "example_id": "b9738bb9-2eec-4772-8daf-657e5be7660d",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Elle me l’a donné parce que c’était celui d’une de ses tantes préférées, mais ça rime en “ette”, comme pipelette, allumette et claquette."
                                            },
                                            {
                                                "example_id": "a5dc6a05-2ba1-42ab-8623-3046a959f864",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Il/Elle n’arrête jamais de parler, c’est une véritable pipelette."
                                            },
                                            {
                                                "example_id": "170e2f36-0df6-41a0-be94-03ed66c48ac8",
                                                "sense_id": "5bfe3b56-b65d-3432-84d1-624a8641b3f2",
                                                "text": "Caroline et Éric sont de véritables pipelettes avec un grand P."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beba02a1-4a85-3a7a-b054-dbe6c12952fb",
                                        "entry_id": "c33b36c1-2416-3b74-add3-27e1ccf5effc",
                                        "glosses": [
                                            "Concierge."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc77e903-0c68-4ac6-909d-41ebab53a5df",
                                                "sense_id": "beba02a1-4a85-3a7a-b054-dbe6c12952fb",
                                                "text": "Il s’rend aux endroits en question et passe la loge d’la cloporte, une serviette sous le bras. « Eh bien ! crie la pip'lette, où qu’vous aller ? » — (Francis Carco, Messieurs les vrais de vrai, Les Éditions de France, Paris, 1927)"
                                            },
                                            {
                                                "example_id": "2bd065d4-2474-48df-acfe-0e4f124c1b75",
                                                "sense_id": "beba02a1-4a85-3a7a-b054-dbe6c12952fb",
                                                "text": "Contrairement à la tradition qui représente les pipelettes sous des traits carabosses, c’est une aimable dame, jeune et tuberculeuse, qui nous ouvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0869ca44-f25a-4194-95c5-66c00aa07a5b",
