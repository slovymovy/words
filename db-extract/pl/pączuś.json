                    {
                        "sense_id": "797418e5-6b6c-3601-9be4-1caf90c358dc",
                        "entry_id": "a76c498f-446b-3fba-a290-248195acb714",
                        "glosses": [
                            "osoba przy kości, z nadwagą"
                        ],
                        "tags": [
                            "endearing"
                        ],
                        "examples": [
                            {
                                "example_id": "9883d154-b68e-4381-8bc9-c628d919b24a",
                                "sense_id": "797418e5-6b6c-3601-9be4-1caf90c358dc",
                                "text": "Nie krytykuj wyglądu córki. Nawet żart w dobrej wierze (\"ty mój pączusiu\") może spowodować niezadowolenie z siebie oraz doprowadzić do obsesyjnego myślenia o jedzeniu i panicznego strachu przed utyciem"
                            },
                            {
                                "example_id": "2e10bfd1-7ee8-4b83-9da4-d28cdf611f72",
                                "sense_id": "797418e5-6b6c-3601-9be4-1caf90c358dc",
                                "text": "Jako dziecko zawsze byłam pączuś, ale wszyscy myśleli, że wyrosnę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
