                "senses": [
                    {
                        "sense_id": "52d3b9b8-435b-3819-9590-02810e0f0cb3",
                        "entry_id": "39f913cd-c513-3d68-8480-0f8c45992e03",
                        "glosses": [
                            "Veranstaltung/Zusammenkunft, bei der einzelne Individuen eine Infektion stärker verbreiten können als andere (eine infizierte Person eine Infektion an überdurchschnittlich viele andere Personen weitergibt)"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c76d2ad2-7240-4b94-9eff-4fe7d43ea380",
                                "sense_id": "52d3b9b8-435b-3819-9590-02810e0f0cb3",
                                "text": "„In einer kleinen deutschen Stadt mit einem Superspreading-Event (Karnevalsveranstaltung), nach dem strikte Maßnahmen zur räumlichen Trennung angeordnet wurden, denen eine vorübergehende Infektionswelle folgte, wurde eine seroepidemiologische GCP- und GEP-konforme Studie durchgeführt.“"
                            },
                            {
                                "example_id": "3c2acafb-9bab-453b-bcfd-1c0afa1b7bdb",
                                "sense_id": "52d3b9b8-435b-3819-9590-02810e0f0cb3",
                                "text": "„Bei der Untersuchung dieser Superspreading-Events zeigten sich einige Faktoren, die offenbar die rasche Ausbreitung der Infektionen begünstigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
