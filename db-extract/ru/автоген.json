                "senses": [
                    {
                        "sense_id": "bfbd457b-4c2d-3344-9a6c-3962a8567d7e",
                        "entry_id": "e121461e-4367-31fd-9ee0-e5486c9eba12",
                        "glosses": [
                            "спец. автогенная (газовая) сварка, резка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b504da39-986b-4722-b95f-51e5d4500e00",
                                "sense_id": "bfbd457b-4c2d-3344-9a6c-3962a8567d7e",
                                "text": "Сейф был вскрыт автогеном."
                            }
                        ]
                    },
                    {
                        "sense_id": "104021c0-9598-3333-8535-8302eb745151",
                        "entry_id": "e121461e-4367-31fd-9ee0-e5486c9eba12",
                        "glosses": [
                            "спец. аппарат для резки и сварки металлов пламенем горючих газов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e2abf7e-c1a1-43c3-85e3-5fd2175d7316",
                                "sense_id": "104021c0-9598-3333-8535-8302eb745151",
                                "text": "Давайте тогда рельсы и двутавровое железо на автоген подносите, резаное обратно захватывайте."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9aa376e9-e6d3-4415-aef7-575e7224eecd",
                        "source_entry_id": "e121461e-4367-31fd-9ee0-e5486c9eba12",
                        "target_lang_word": "Brennschneiden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
