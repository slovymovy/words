                {
                    "sense_id": "790f9d9d-2c3a-3c50-a564-81d59d2c5544",
                    "sense_definition": "In een richting naar boven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>opwaartse</w> beweging van de lift was erg snel.",
                            "target_lang_translations": {
                                "en": "The <w>upward</w> movement of the elevator was very fast."
                            }
                        },
                        {
                            "text": "Er is een <w>opwaartse</w> trend zichtbaar in de verkoopcijfers.",
                            "target_lang_translations": {
                                "en": "There is an <w>upward</w> trend visible in the sales figures."
                            }
                        }
                    ],
                    "synonyms": [
                        "stijgend"
                    ],
                    "antonyms": [
                        "neerwaarts"
                    ],
                    "common_phrases": [
                        "opwaartse trend"
                    ],
                    "target_lang_definitions": {
                        "en": "In a direction towards the top or higher level."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upward",
                                "target_lang_sense_clarification": "general direction or movement"
                            },
                            {
                                "target_lang_word": "upward-sloping",
                                "target_lang_sense_clarification": "describing a trend or line"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "909f5325-734a-36dc-b878-f15a2ef10edb",
                    "sense_definition": "In de richting van boven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel vloog <w>opwaarts</w> naar de top van de boom.",
                            "target_lang_translations": {
                                "en": "The bird flew <w>upwards</w> to the top of the tree."
                            }
                        },
                        {
                            "text": "De raket bewoog zich snel <w>opwaarts</w> door de wolken.",
                            "target_lang_translations": {
                                "en": "The rocket moved quickly <w>upwards</w> through the clouds."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhoog"
                    ],
                    "antonyms": [
                        "neerwaarts"
                    ],
                    "target_lang_definitions": {
                        "en": "In the direction of above."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upwards",
                                "target_lang_sense_clarification": "moving towards a higher position"
                            },
                            {
                                "target_lang_word": "up",
                                "target_lang_sense_clarification": "simple direction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c93f264-445d-30be-855c-7a3c5bb088d7",
                    "sense_definition": "Langs een helling of berg omhoog.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fietsers moesten zwaar trappen terwijl ze <w>opwaarts</w> reden.",
                            "target_lang_translations": {
                                "en": "The cyclists had to pedal hard while they were riding <w>uphill</w>."
                            }
                        },
                        {
                            "text": "Het pad loopt steil <w>opwaarts</w> richting de top.",
                            "target_lang_translations": {
                                "en": "The path runs steeply <w>uphill</w> towards the summit."
                            }
