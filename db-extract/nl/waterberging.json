                        "glosses": [
                            "het (tijdelijk) opslaan van (overtollig) water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967cba1b-2e98-40d9-bbe5-62a7166d8348",
                                "sense_id": "050f37db-40d5-3af9-9a23-c61fa246b2eb",
                                "text": "Het hoogheemraadschap van Rijnland kocht enige tijd geleden de polder om hem te gaan gebruiken als waterberging voor overtollig water. Rijnland bood wetenschappers aan van de gelegenheid gebruik te maken om metingen te verrichten."
                            },
                            {
                                "example_id": "dc410665-7582-44d5-ae36-9d340f78be8b",
                                "sense_id": "050f37db-40d5-3af9-9a23-c61fa246b2eb",
                                "text": "Frans van de Ven, specialist waterbeheer van Deltaris aan de TU Delft, noemde in het Radio 1 Journaal een paar maatregelen die steden kunnen nemen om de schadelijke gevolgen van hevige regenval te beperken. Waterberging is daarbij volgens hem het sleutelwoord."
                            }
                        ]
                    }
