                                    {
                                        "sense_id": "0ad93d0b-d6fe-3ea9-a421-d090b9648593",
                                        "entry_id": "83f697c9-3c9b-3434-8876-0eab018142fe",
                                        "glosses": [
                                            "The tendency to promote or desire the esoteric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba524376-bcd4-4a10-a099-babb96990921",
                                                "sense_id": "0ad93d0b-d6fe-3ea9-a421-d090b9648593",
                                                "text": "Derridean \"messianicity without messianism\" that marks so much of post-modernist educational theorizing today, and that makes use of esotericism, sigetics, acroamatics, proleptics, and illocutionary and perlocutionary acts in the disguise of a new pedagogy of the unknowable, wasn't the answer ten years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd511d5-9a6d-3a56-b898-caa623319009",
                                        "entry_id": "83f697c9-3c9b-3434-8876-0eab018142fe",
                                        "glosses": [
                                            "Doctrines or practices of esoteric knowledge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
