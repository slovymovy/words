                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux moulin se dressait autrefois tout droit <w>envers</w> le cours de la rivière."
                        },
                        {
                            "text": "Ils s'installèrent sur la rive <w>envers</w> l'antique château fort."
