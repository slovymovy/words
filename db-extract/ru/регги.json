                ],
                "senses": [
                    {
                        "sense_id": "18e1bfbe-eee6-34ed-9b57-3141fada399f",
                        "entry_id": "f1aaa1aa-161b-37cc-951a-17137875e7a2",
                        "glosses": [
                            "направление современной музыки, сформировавшееся на Ямайке в конце 1960-х годов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c15082-870e-4f94-bdd0-bae38594c49f",
                                "sense_id": "18e1bfbe-eee6-34ed-9b57-3141fada399f",
                                "text": "Рока стало гораздо меньше, зато в изобилии элементы ямайской музыки, модные ныне даб, регги и даже подобие ска…"
                            },
                            {
                                "example_id": "382f8f6f-ac19-4be9-9ae8-8fddb04444e1",
                                "sense_id": "18e1bfbe-eee6-34ed-9b57-3141fada399f",
                                "text": "Говорим «мамбо» ― подразумеваем latino, говорим «джа» ― подразумеваем регги, Карибы, Боба Марли."
                            },
                            {
                                "example_id": "e175ad0e-02c4-4a54-aa60-51bc2652112b",
                                "sense_id": "18e1bfbe-eee6-34ed-9b57-3141fada399f",
                                "text": "Дело даже не в том, какую именно музыку они тогда заводили (на Ямайке ― регги, в шикарных нью-йоркских танцзалах ― диско, в Бронксе ― хип-хоп): весь фокус диджейства состоял и до сих пор состоит в том, что в руках диджея всем известные грампластинки начинают звучать по-новому."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b99113f4-9f93-40b2-922e-dfc468acf0f8",
                        "source_entry_id": "f1aaa1aa-161b-37cc-951a-17137875e7a2",
                        "source_sense_id": "18e1bfbe-eee6-34ed-9b57-3141fada399f",
                        "target_lang_word": "reggae",
