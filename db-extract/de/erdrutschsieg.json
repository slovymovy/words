                                        "sense_id": "d9e84d2b-49ea-30c0-a5e9-7f4552a35b45",
                                        "entry_id": "f7ea7eaf-2d25-32ad-8dae-03b085614245",
                                        "glosses": [
                                            "Variante de raz-de-marée."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da6b790-60e9-4bfb-a937-ef74ee6ed9a8",
                                                "sense_id": "d9e84d2b-49ea-30c0-a5e9-7f4552a35b45",
                                                "text": "Le clip a été visionné près de 360 millions de fois depuis sa mise en ligne sur YouTube le 15 juillet. Autant dire : un raz de marée !"
                                            },
                                            {
                                                "example_id": "56f47023-6f1a-43fc-93f7-e95bb4ca2739",
                                                "sense_id": "d9e84d2b-49ea-30c0-a5e9-7f4552a35b45",
                                                "text": "Il ne permet en aucune façon à la gauche de miser sur un raz de marée aux élections législatives du mois de juin, même si elle peut espérer bénéficier d’un effet amplificateur grâce à l'élection de François Hollande."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b725015-f95b-4b9c-b591-ae077fa5640b",
                        "source_entry_id": "0fab27f0-9114-3012-b023-a932e684a719",
                        "source_sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                        "source_sense_description": "hoher Wahlsieg einer Partei, bedingt durch eine unerwartete, immense Verschiebung von Wählerstimmen",
                        "target_lang_word": "victoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "victoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1a56f52-480d-385b-8b75-9d66af45f34d",
                                        "entry_id": "8eaaadd0-cc26-3453-a0d9-54d819591b09",
                                        "glosses": [
                                            "Avantage qu’on remporte sur les ennemis dans une guerre, dans une bataille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4428b97d-4377-4dd8-9d7e-4dad9c3dc34f",
                                                "sense_id": "e1a56f52-480d-385b-8b75-9d66af45f34d",
                                                "text": "On chantait presque tous les mois des Te Deum pour quelque nouvelle victoire, et le canon de l’arsenal tirait ses vingt et un coups, qui vous faisaient trembler le cœur."
                                            },
                                            {
                                                "example_id": "6e760483-0ee6-4d8d-b685-18bbd48f0ccd",
                                                "sense_id": "e1a56f52-480d-385b-8b75-9d66af45f34d",
                                                "text": "Au début de l'année 1918, ils ont mené l'offensive, ils ont déployé toutes leurs forces, et ils méritaient de gagner, ils méritaient la victoire, comme le vieux Pindur et son grand-père Otto Magnor, à la bataille de Sedan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b43afab-f972-385a-b220-827de3318bc8",
                                        "entry_id": "8eaaadd0-cc26-3453-a0d9-54d819591b09",
                                        "glosses": [
                                            "Personnification du succès dans le combat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abbbb02e-0325-40e3-b15e-76f168cf368a",
                                                "sense_id": "4b43afab-f972-385a-b220-827de3318bc8",
                                                "text": "La victoire s’est déclarée pour lui."
                                            },
                                            {
                                                "example_id": "9e0aee10-9115-4802-a2bd-998a927be7bf",
                                                "sense_id": "4b43afab-f972-385a-b220-827de3318bc8",
                                                "text": "La victoire le suit partout."
                                            },
                                            {
                                                "example_id": "d71dad45-dc92-4ade-8909-3f5c498b56e6",
                                                "sense_id": "4b43afab-f972-385a-b220-827de3318bc8",
                                                "text": "Les palmes, les trophées de la victoire."
                                            },
                                            {
                                                "example_id": "7699f23c-830d-452d-a64f-587221ccbb21",
                                                "sense_id": "4b43afab-f972-385a-b220-827de3318bc8",
                                                "text": "« De catastrophe en catastrophe, nous allons vers la victoire. » Cette sinistre parole de 1940 m’est revenue à l’esprit. Je crois que c’est tout simplement de cette manière que nous allons au paradis."
                                            },
                                            {
                                                "example_id": "416689fa-313b-4611-989a-ac72814c0cda",
                                                "sense_id": "4b43afab-f972-385a-b220-827de3318bc8",
                                                "text": "Selon elle, plus qu'une opportunité, cette migration des tiktokeurs américains vers RedNote est une «grande victoire» pour la Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33655160-0343-3cd2-a28b-d755bf76e1db",
                                        "entry_id": "8eaaadd0-cc26-3453-a0d9-54d819591b09",
                                        "glosses": [
                                            "Divinité représentée sous la figure d’une femme ayant des ailes et tenant une couronne d’une main, une palme de l’autre."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e929dfc6-a3c1-466a-889f-516e482895bf",
                                                "sense_id": "33655160-0343-3cd2-a28b-d755bf76e1db",
                                                "text": "[…] ; des Victoires aux ailes dorées portant des lances de trois mètres, au bout desquelles s’arrondissaient des cassolettes de parfums ; […]"
                                            },
                                            {
                                                "example_id": "ddb8d106-2bf0-43d8-a6bf-754bc30d4c96",
                                                "sense_id": "33655160-0343-3cd2-a28b-d755bf76e1db",
                                                "text": "Derrière la statue du prince il y a une victoire qui lui pose sur la tête une couronne de laurier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6eea13-eb7b-3588-adc4-95a94c963a26",
                                        "entry_id": "8eaaadd0-cc26-3453-a0d9-54d819591b09",
                                        "glosses": [
                                            "Avantage qu’on remporte sur un rival, sur un concurrent, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a698086-96a4-4b55-9b6c-0daecd158dd2",
                                                "sense_id": "ec6eea13-eb7b-3588-adc4-95a94c963a26",
                                                "text": "Drumont comptait sans doute sur la victoire du boulangisme pour faire triompher sa doctrine et imposer aux juifs une législation moyenâgeuse ?"
                                            },
                                            {
                                                "example_id": "eea9b57e-50af-4008-b8d8-d865b0b7a0ae",
                                                "sense_id": "ec6eea13-eb7b-3588-adc4-95a94c963a26",
                                                "text": "Vague de victoires pour le club de karaté de Mirambeau le 11 juin dernier. Il a participé au criterium enfants qui s’est déroulé à Sainte-Foy-la-Grance, une compétition annuelle organisée en alternance par trois clubs amis : Mirambeau, Saint-Savin et Sainte-Foy-la-Grande."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
