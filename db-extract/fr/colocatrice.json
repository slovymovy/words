                "senses": [
                    {
                        "sense_id": "ecf39083-83e4-33c2-82ec-aabcdf4a976d",
                        "entry_id": "8b83e6a6-34f2-3c98-b0cf-fdc9ad748577",
                        "glosses": [
                            "Femme ou fille qui partage un logement loué avec une autre personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e62507b-9aff-4543-bb3e-db086caf5b30",
                                "sense_id": "ecf39083-83e4-33c2-82ec-aabcdf4a976d",
                                "text": "Ce n’était pas elle qui en avait acheté mais sa colocatrice, une théière frémissante toujours à la main, du temps où les deux étudiantes partageaient un appartement."
                            },
                            {
                                "example_id": "e0525fe9-f540-4d7f-a0bf-9a93a66d356b",
                                "sense_id": "ecf39083-83e4-33c2-82ec-aabcdf4a976d",
                                "text": "Tatiana n’avait pas mis longtemps à trouver le chemin de l’escalier du 100. Une de ses anciennes colocatrices du foyer étudiant de Tomsk officiait à la barre de strip-tease depuis l’hiver d’avant et lui avait proposé de rencontrer son patron."
                            },
                            {
                                "example_id": "5394d3b9-bc3a-44a2-b0a2-d88580315d61",
                                "sense_id": "ecf39083-83e4-33c2-82ec-aabcdf4a976d",
                                "text": "Les gardiens de la vie naissante : Anne, colocatrice pour la vie"
                            },
                            {
                                "example_id": "f4979ba9-da9e-45e6-932a-f878d3cb1631",
                                "sense_id": "ecf39083-83e4-33c2-82ec-aabcdf4a976d",
                                "text": "Proposition encore plus claire pour cette maison de 78 mètres carrés dans le Loir-et-Cher : “Recherche colocatrice à titre gratuit en échange de moment sexe”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5daace70-87d5-46e4-b631-f6a9006606e8",
                        "source_entry_id": "8b83e6a6-34f2-3c98-b0cf-fdc9ad748577",
                        "source_sense_id": "ecf39083-83e4-33c2-82ec-aabcdf4a976d",
                        "target_lang_word": "Mitbewohnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitbewohnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                        "entry_id": "c7b7920b-6aaa-3ded-b4fe-8228d7de3ade",
                                        "glosses": [
                                            "weibliche Person, mit der jemand sich ein Haus, eine Wohnung oder ein Zimmer teilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fc7dc7-d6db-46ae-a47b-7230455750f3",
                                                "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                                "text": "„Weil sich Peter Sim seit Einzug seiner neuen Mitbewohnerin so langweilt, schreibt er Tweets und ab jetzt auch Notizen für diese Kolumne“"
                                            },
                                            {
                                                "example_id": "aabaa693-b7ba-4a89-afa4-afcfd7d487cc",
                                                "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                                "text": "„Wenige Tage später kommen Thomas und Mona Sendler mit einer anderen Mitbewohnerin des Hauses, der sehr korpulenten und resolut auftretenden Marina Graf, ins Gespräch.“"
                                            },
                                            {
                                                "example_id": "cac52cad-6734-4007-bc79-8fa2fe066d1b",
                                                "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                                "text": "„Als kleiner Junge jedoch war er – wegen des Altersunterschieds leider hoffnungslos – in seine hübsche Mitbewohnerin Ruth verliebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
