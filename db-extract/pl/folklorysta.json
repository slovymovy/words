                ],
                "translations": [
                    {
                        "translation_id": "57a95da7-8fc3-4b42-bfe4-fecfdf512860",
                        "source_entry_id": "09ab2c67-6a7d-366d-83fa-ad78c040d8a1",
                        "source_sense_id": "2fd78103-6bd1-3a34-b884-5595240c43d5",
