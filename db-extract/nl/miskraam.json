                    {
                        "translation_id": "d4232f7b-08c8-4718-99fe-1bfdbd94f742",
                        "source_entry_id": "044f8990-fbd8-3930-aaf8-00fa6477f8af",
                        "source_sense_id": "858cef77-1799-3541-98e2-2fc4b0eede00",
                        "target_lang_word": "Fehlgeburt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fehlgeburt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7956d003-05a1-3e23-bfe2-dc510aa78f57",
                                        "entry_id": "ee384560-1bfb-3bcb-9ed5-4d45058f04da",
                                        "glosses": [
                                            "spontane (ungewollte) oder artifizielle (gewollte) vorzeitige Unterbrechung der Schwangerschaft durch Verlust der Leibesfrucht mit einem Gewicht von weniger als fünfhundert Gramm und dem Fehlen von Lebenszeichen"
                                        ],
                                        "tags": [
                                            "Gynäkologie",
                                            "Geburtshilfe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "966a0489-847c-44e2-aeae-cc6aa815826b",
                                                "sense_id": "7956d003-05a1-3e23-bfe2-dc510aa78f57",
                                                "text": "„Hergesells machten ihren ersten Spaziergang nach Trudels Fehlgeburt.“"
                                            },
                                            {
                                                "example_id": "c92428f1-0118-4a13-91bd-2cefba2ba8e4",
                                                "sense_id": "7956d003-05a1-3e23-bfe2-dc510aa78f57",
                                                "text": "Eine Fehlgeburt unterliegt im Gegensatz zu einer Totgeburt nicht der Meldepflichtigkeit."
                                            },
                                            {
                                                "example_id": "389efe8f-15e1-4e62-bbc6-2c48c5ce8f97",
                                                "sense_id": "7956d003-05a1-3e23-bfe2-dc510aa78f57",
                                                "text": "„Bei einem Fliegerangriff erlitt die eine Fehlgeburt, von der sie sich nicht mehr erholte.“"
                                            },
                                            {
                                                "example_id": "1e6bc7c5-36a9-41de-9768-66f33867b883",
                                                "sense_id": "7956d003-05a1-3e23-bfe2-dc510aa78f57",
                                                "text": "„Am 17. Oktober ging unerwartet das Fruchtwasser ab, und sie erlitt im Bett eine Fehlgeburt.“"
                                            },
                                            {
                                                "example_id": "eb57fb99-35e5-4661-b8c3-e1fca3f18249",
                                                "sense_id": "7956d003-05a1-3e23-bfe2-dc510aa78f57",
                                                "text": "„Daß seine Frau wenig später eine Fehlgeburt hatte und sich ein schweres Unterleibsleiden zuzog, war ein unberechenbarer Zufall und nur auf ihre zunehmende Zimperlichkeit zurückzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51412a7a-38fe-4478-8d6a-c36a1174965a",
