                {
                    "sense_id": "f7d656bc-97eb-30d1-a0fe-e9f3bce95a0b",
                    "sense_definition": "een gat in de grond maken met de handen of met een graafwerktuig",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "graven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond begon enthousiast te <w>graven</w> in de tuin om zijn bot te verstoppen.",
                            "target_lang_translations": {
                                "en": "The dog enthusiastically started to <w>dig</w> in the garden to hide his bone.",
                                "ru": "Собака начала с энтузиазмом <w>копать</w> в саду, чтобы спрятать свою кость."
                            }
                        },
                        {
                            "text": "Met een kleine schep <w>groef</w> ik dagelijks een gat in de grond van ongeveer tien centimeter diep.",
                            "target_lang_translations": {
                                "en": "With a small shovel, I <w>dug</w> a hole in the ground about ten centimeters deep every day.",
                                "ru": "Маленькой лопаткой я каждый день <w>рыл</w> в земле яму глубиной около десяти сантиметров."
                            }
                        }
                    ],
                    "synonyms": [
                        "delven",
                        "spitten"
                    ],
                    "common_phrases": [
                        "een gat graven",
                        "in de grond graven"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a hole in the ground with hands or a digging tool",
                        "ru": "делать яму в земле руками или инструментом для копания"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dig",
                                "target_lang_sense_clarification": "to move earth to make a hole"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "копать",
                                "target_lang_sense_clarification": "делать углубление в земле"
                            },
                            {
                                "target_lang_word": "рыть",
                                "target_lang_sense_clarification": "создавать яму или канаву"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb4d60b6-da32-3033-8374-858f6e772772",
                    "sense_definition": "iets grondig onderzoeken of zoeken naar verborgen informatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderzoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De journalist besloot dieper te <w>graven</w> in het verleden van de corrupte politicus.",
                            "target_lang_translations": {
                                "en": "The journalist decided to <w>dig</w> deeper into the past of the corrupt politician.",
                                "ru": "Журналист решил <w>копать</w> глубже в прошлом коррумпированного политика."
                            }
                        },
                        {
                            "text": "Ik hoef niet lang in de berg documenten te <w>graven</w> om de waarheid te vinden.",
                            "target_lang_translations": {
                                "en": "I don't have to <w>dig</w> through the pile of documents for long to find the truth.",
                                "ru": "Мне не нужно долго <w>рыться</w> в горе документов, чтобы найти истину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in het verleden graven",
                        "dieper graven"
                    ],
                    "target_lang_definitions": {
                        "en": "to investigate something thoroughly or search for hidden information",
                        "ru": "тщательно исследовать что-либо или искать скрытую информацию"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dig",
                                "target_lang_sense_clarification": "to investigate or research"
                            },
                            {
                                "target_lang_word": "delve",
                                "target_lang_sense_clarification": "to examine in detail"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "копать",
                                "target_lang_sense_clarification": "проводить расследование, искать информацию"
                            },
                            {
                                "target_lang_word": "копнуть",
                                "target_lang_sense_clarification": "вникнуть в суть дела, исследовать глубже"
                            }
                        ]
                    }
                }
            ]
        },
