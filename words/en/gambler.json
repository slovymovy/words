                {
                    "sense_id": "767b07df-1c22-3c48-bfd6-4e5762ef89bc",
                    "sense_definition": "A person who plays games of chance or bets money on events.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gambler_literal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The casino was filled with every kind of <w>gambler</w> hoping to win big.",
                            "target_lang_translations": {
                                "ru": "Казино было заполнено самыми разными <w>игроками</w>, надеявшимися сорвать большой куш."
                            }
                        },
                        {
                            "text": "He struggled with debt because he was a compulsive <w>gambler</w>.",
                            "target_lang_translations": {
                                "ru": "Он погряз в долгах, потому что был патологическим <w>игроком</w>."
                            }
