                                            {
                                                "example_id": "cde3cb72-4e6a-4355-8ae4-131416179013",
                                                "sense_id": "f623698d-7150-3716-a7de-f28100e7ee12",
                                                "text": "Bij aerobics wordt er altijd harde muziek afgespeeld."
                                            },
                                            {
                                                "example_id": "fa02ed62-2cd2-4610-b657-d775f6785e63",
                                                "sense_id": "f623698d-7150-3716-a7de-f28100e7ee12",
                                                "text": "Sinds in 1969 aerobics werd bedacht, is er elke paar jaar een nieuwe fitnesstrend."
                                            },
                                            {
                                                "example_id": "0db289a9-221e-4a84-b3cc-495111bf666d",
                                                "sense_id": "f623698d-7150-3716-a7de-f28100e7ee12",
                                                "text": "De aerobics is laagdrempelig zodat iedereen kan meedoen."
                                            },
                                            {
                                                "example_id": "3500175a-c28e-4cf3-8896-205f54253fe4",
                                                "sense_id": "f623698d-7150-3716-a7de-f28100e7ee12",
                                                "text": "Er zijn allerlei veiligheidsregels uit het aerobics waar we ons aan moeten houden."
                                            },
                                            {
                                                "example_id": "390fa7a3-a9cb-4047-b1d2-602ec2cb6294",
                                                "sense_id": "f623698d-7150-3716-a7de-f28100e7ee12",
                                                "text": "Aerobics is een groepstraining waarbij oefeningen worden gedaan op muziek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
