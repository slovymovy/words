                                "target_senses": [
                                    {
                                        "sense_id": "8e6b4544-9f40-3496-b7fc-c54652208246",
                                        "entry_id": "63e9d6a2-64f1-3da0-90ba-847c421595df",
                                        "glosses": [
                                            "El ecosistema compuesto por todos los seres vivos del planeta Tierra."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [],
