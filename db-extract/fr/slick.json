                        "target_lang_word": "slick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "788d6136-a136-3a3c-a856-b87e27239604",
                                        "entry_id": "4cf8f4ea-dbf5-3f5b-9291-e79a9f2b1af2",
                                        "glosses": [
                                            "Slippery or smooth due to a covering of liquid; often used to describe appearances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e18d22c-7c79-490e-afdc-746cc6e75dd3",
                                                "sense_id": "788d6136-a136-3a3c-a856-b87e27239604",
                                                "text": "This rain is making the roads slick."
                                            },
                                            {
                                                "example_id": "fb39afb4-a00d-433b-84f0-73132791a2e3",
                                                "sense_id": "788d6136-a136-3a3c-a856-b87e27239604",
                                                "text": "The top coating of lacquer gives this finish a slick look."
                                            },
                                            {
                                                "example_id": "f115f35f-fde3-4e24-9abf-a3cb2e97fa4f",
                                                "sense_id": "788d6136-a136-3a3c-a856-b87e27239604",
                                                "text": "His large round head was shaved slick."
                                            },
                                            {
                                                "example_id": "82f2a936-39a6-4cfe-9ecc-407de7bbc55c",
                                                "sense_id": "788d6136-a136-3a3c-a856-b87e27239604",
                                                "text": "Morning commuters in parts of Texas, Oklahoma and Arkansas discovered slick sidewalks and icy roadways Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3739c2a2-b5a3-3069-8109-b5034fbe5ef2",
                                        "entry_id": "4cf8f4ea-dbf5-3f5b-9291-e79a9f2b1af2",
                                        "glosses": [
                                            "Sleek; smooth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d56647c-132b-4551-84fe-96e855e4f637",
                                                "sense_id": "3739c2a2-b5a3-3069-8109-b5034fbe5ef2",
                                                "text": "Both slick and dainty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec35bb45-37f8-30ec-87c7-9e94780768b3",
                                        "entry_id": "4cf8f4ea-dbf5-3f5b-9291-e79a9f2b1af2",
                                        "glosses": [
                                            "Appearing expensive or sophisticated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360d683d-b852-46e0-9184-e075b40c8b90",
                                                "sense_id": "ec35bb45-37f8-30ec-87c7-9e94780768b3",
                                                "text": "They read all kinds of slick magazines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d115329-f121-3416-b2ec-76f6cd3521c5",
                                        "entry_id": "4cf8f4ea-dbf5-3f5b-9291-e79a9f2b1af2",
                                        "glosses": [
                                            "Superficially convincing but actually untrustworthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f8837a-6da3-4fc8-8e01-a97fd03abea2",
                                                "sense_id": "0d115329-f121-3416-b2ec-76f6cd3521c5",
                                                "text": "That new sales rep is slick. Be sure to read the fine print before you buy anything."
                                            },
                                            {
                                                "example_id": "b711901c-81f9-4da0-bc63-e70ee2ffb347",
                                                "sense_id": "0d115329-f121-3416-b2ec-76f6cd3521c5",
                                                "text": "The threat the most radical of them pose is evidently far greater at home than abroad: in one characteristically slick and chilling Isis video – entitled “a message to the Jordanian tyrant” – a smiling, long-haired young man in black pats the explosive belt round his waist as he burns his passport and his fellow fighters praise the memory of Zarqawi, who was killed in Iraq in 2006."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "959d3351-e2f5-3925-b5e9-c291cc175966",
                                        "entry_id": "4cf8f4ea-dbf5-3f5b-9291-e79a9f2b1af2",
                                        "glosses": [
                                            "Clever, making an apparently hard task look easy."
                                        ],
                                        "tags": [
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "961aa67c-0ffa-409d-8e8e-2f4151499c57",
                                                "sense_id": "959d3351-e2f5-3925-b5e9-c291cc175966",
                                                "text": "That was a slick move, locking your keys in the car."
                                            },
                                            {
                                                "example_id": "ad4265b2-8990-4bac-a756-ec122d12809f",
                                                "sense_id": "959d3351-e2f5-3925-b5e9-c291cc175966",
                                                "text": "Our new process for extracting needles from haystacks is extremely slick."
                                            },
                                            {
                                                "example_id": "4dcca255-6790-472e-b7da-216f1176efa6",
                                                "sense_id": "959d3351-e2f5-3925-b5e9-c291cc175966",
                                                "text": "I leave the train at Salisbury, where (in a very slick operation) another two-car set is added to the front of the train before it heads for London."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3403dd57-6ded-3d88-a028-55b69e7867db",
                                        "entry_id": "4cf8f4ea-dbf5-3f5b-9291-e79a9f2b1af2",
                                        "glosses": [
                                            "Extraordinarily great or special."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d08a403-b1f4-4e90-abc2-10ec22e267a5",
                                                "sense_id": "3403dd57-6ded-3d88-a028-55b69e7867db",
                                                "text": "That is one slick bicycle: it has all sorts of features!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566aa9c5-e460-35f5-a031-68e123cca55e",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A covering of liquid, particularly oil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ffa64d-f873-4901-9d8b-43fc514a8361",
                                                "sense_id": "566aa9c5-e460-35f5-a031-68e123cca55e",
                                                "text": "Careful in turn three — there's an oil slick on the road."
                                            },
                                            {
                                                "example_id": "712aea19-b09d-44d7-bfe9-a3cb0fda6444",
                                                "sense_id": "566aa9c5-e460-35f5-a031-68e123cca55e",
                                                "text": "The oil slick has now spread to cover the entire bay, critically endangering the sea life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1e307d-a1a2-372a-b251-e295f308dec5",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A rapidly-expanding ring of dark water, resembling an oil slick, around the site of a large underwater explosion at shallow depth, marking the progress through the water of the shock wave generated by the explosion."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "198cdc17-9db6-3c46-aa7d-d8c85c1c83d8",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "Someone who is clever and untrustworthy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0829ce24-b35b-3023-9548-35c985b14001",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A tool used to make something smooth or even."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f70b19e0-09c3-3337-899f-718b27a35f21",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A tire with a smooth surface instead of a tread pattern, often used in auto racing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc079b15-bde0-4b73-b616-c74d3bac41f5",
                                                "sense_id": "f70b19e0-09c3-3337-899f-718b27a35f21",
                                                "text": "You'll go much faster if you put on slicks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ac35555-170e-34b4-810a-ae23238b0bbc",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A helicopter."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a587ca5-7948-31fa-9195-14e78bfbeaa6",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A camera-ready image to be used by a printer. The \\\"slick\\\" is photographed to produce a negative image which is then used to burn a positive offset plate or other printing device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51bdcee4-5daa-46f9-856e-ed8e5eb007ed",
                                                "sense_id": "2a587ca5-7948-31fa-9195-14e78bfbeaa6",
                                                "text": "The project was delayed because the slick had not been delivered to the printer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24499d95-0c05-375a-96c0-26c1d2fe2f36",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A glossy magazine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13a7d78-3822-4709-957b-1371bcd2d73c",
                                                "sense_id": "24499d95-0c05-375a-96c0-26c1d2fe2f36",
                                                "text": "Many of the stories in SSB [Sex Behind Bars] first appeared in gay slicks, Mandate, Honcho, First Hand, et al."
                                            },
                                            {
                                                "example_id": "ba26c714-2d7e-4b5a-a929-2dc6ce0c875e",
                                                "sense_id": "24499d95-0c05-375a-96c0-26c1d2fe2f36",
                                                "text": "When Carver, wild to be published in a major slick, decided to accept the changes, Maryann accused him “of being a whore, of selling out to the establishment.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6412a0fc-bdca-39f3-aab1-e61397dc9c24",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A wide paring chisel used in joinery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df034854-8589-3c08-985a-0301ff595c80",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "In omegaverse fiction, the copious, lubricating bodily fluid produced by an omega in heat."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e70818c-bee6-4fb4-ad44-e1559932c3fa",
                                                "sense_id": "df034854-8589-3c08-985a-0301ff595c80",
                                                "text": "I spent two fucking days locked up in that hotel room, miserable and hating myself and drenched in my own slick!"
                                            },
                                            {
                                                "example_id": "dff22ad5-241e-449b-9504-e9a4ce0b9474",
                                                "sense_id": "df034854-8589-3c08-985a-0301ff595c80",
                                                "text": "For his ruts, Castiel orders slick from a single donor, who is, unbeknownst to him, Dean, who lives at the Roadhouse and is in contact with many of his colleagues and rescuees."
                                            },
                                            {
                                                "example_id": "f49b12b3-0b00-4834-8860-05aea6376728",
                                                "sense_id": "df034854-8589-3c08-985a-0301ff595c80",
                                                "text": "She observed another parallel to menstruation, namely the abundance of 'slick' that Omegas produce when they go into heat, which mainly functions as an anal lubricant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae95959-b754-3324-8e2e-fc2076c8ea5c",
                                        "entry_id": "d57c7480-a3cf-3daf-b11a-38f4ea3fbec3",
                                        "glosses": [
                                            "A silver coin that has been worn to the point its surface feels smooth to the touch."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc561a76-77bf-475a-8bcb-bee5b87b94fd",
                                                "sense_id": "0ae95959-b754-3324-8e2e-fc2076c8ea5c",
                                                "text": "a slick doesn’t really give you anything except the satisfaction of owning it, while the hole gives you satisfaction if actually being able to see something"
                                            },
                                            {
                                                "example_id": "381fb04a-71b0-44d0-9c2d-41205efc5d1f",
                                                "sense_id": "0ae95959-b754-3324-8e2e-fc2076c8ea5c",
                                                "text": "Somebody once came into the coin shop with a bunch of really well-worn junk silver that would commonly be called \"slicks.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "470b2de2-8b40-3e2f-ad55-28d1e79d04a4",
                                        "entry_id": "3b0cb5e5-4d83-3094-a923-dba190d2bc9b",
