                        "examples": [
                            {
                                "example_id": "a7426953-5a08-4b6c-9044-c821868bcd3c",
                                "sense_id": "76bd65a0-aa38-32d0-93ec-02c721b1880d",
                                "text": "En clair, les tweets seront bientôt affichés par défaut de cette manière sur Twitter, ce que craignent de nombreux utilisateurs, qui dénoncent une « facebookisation » de Twitter."
                            },
                            {
                                "example_id": "660eb8e2-8763-448b-a4bc-a36468a4ddfe",
                                "sense_id": "76bd65a0-aa38-32d0-93ec-02c721b1880d",
                                "text": "La facebookisation du monde ne se réduit hélas pas à une formule. C’est au contraire la « réalité virtuelle », la « second life » qui s’est substituée depuis longtemps à la vie dite « réelle », à la conscience citoyenne, à sa vigilance critique."
                            }
                        ]
