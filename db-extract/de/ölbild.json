                                        "sense_id": "071bff3a-54aa-384b-9706-b442ee212a5a",
                                        "entry_id": "02f51069-de40-3d76-9487-c355ac24d7ec",
                                        "glosses": [
                                            "A physically attractive person."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d148b9-8864-4da4-9c0e-b65348ee8f48",
                                                "sense_id": "071bff3a-54aa-384b-9706-b442ee212a5a",
                                                "text": "\"Very lovely!\" he said, staring her straight in the face.\n\"You needn't try and be funny!\" she said. \"If you mean me, I'm no oil-painting, and I know it!\""
                                            },
                                            {
                                                "example_id": "0df54d06-a1f9-438f-80aa-cae3f8b9b779",
                                                "sense_id": "071bff3a-54aa-384b-9706-b442ee212a5a",
                                                "text": "Wayne Swan: All I can say is that she's a much more attractive person than the Prime Minister.\nGeorge Brandis: You're not exactly an oil painting yourself, Wayne."
                                            }
                                        ]
                                    }
                                ]
                            }
