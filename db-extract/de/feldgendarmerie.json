                        "examples": [
                            {
                                "example_id": "7b574502-9f24-4522-9120-bd17457e11b7",
                                "sense_id": "e783fe3c-3e00-3803-87be-b9c5ce0ca94b",
                                "text": "„Der Offizier der Feldgendarmerie wollte sich gerade auf den Kosakenhauptmann stürzen, als der mit einer unnachahmlich stolzen Bewegung die Hand hob.“"
                            },
                            {
                                "example_id": "8f6926e4-163b-45ac-a883-ae044b72eb0b",
                                "sense_id": "e783fe3c-3e00-3803-87be-b9c5ce0ca94b",
                                "text": "„Es gab insgesamt mehr als 50 weitere Transporte in Viehwaggons, bewacht von der Feldgendarmerie und französischen Polizisten.“"
                            }
                        ],
