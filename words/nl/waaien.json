                                "ru": "Вчера на побережье <w>дул</w> очень сильный ветер.",
                                "pl": "Wczoraj na wybrzeżu bardzo mocno <w>wiało</w>.",
                                "de": "Es <w>wehte</w> gestern sehr stark an der Küste.",
                                "fr": "Le vent <w>soufflait</w> très fort hier sur la côte.",
                                "it": "Ieri sulla costa <w>tirava un forte vento</w>.",
                                "cs": "Včera na pobřeží opravdu hodně <w>foukalo</w>.",
                                "tr": "Dün sahilde çok şiddetli rüzgâr <w>esti</w>.",
                                "es": "Ayer <w>hacía</w> muchísimo <w>viento</w> en la costa.",
                                "zh": "昨天海边<w>刮风</w>刮得很厉害。"
                            }
                        },
                        {
                            "text": "Het <w>waait</w> vandaag te hard om buiten te gaan tennissen.",
                            "target_lang_translations": {
                                "en": "It is <w>blowing</w> too hard today to play tennis outside.",
                                "ru": "Сегодня слишком сильно <w>дует ветер</w>, чтобы играть в теннис на улице.",
                                "pl": "Dziś zbyt mocno <w>wieje</w>, żeby grać w tenisa na zewnątrz.",
                                "de": "Es <w>ist</w> heute zu <w>windig</w>, um draußen Tennis zu spielen.",
                                "fr": "Il <w>y a trop de vent</w> aujourd'hui pour jouer au tennis dehors.",
                                "it": "Oggi <w>c'è troppo vento</w> per giocare a tennis all'aperto.",
                                "cs": "Dnes <w>fouká</w> příliš silně na to, abychom hráli tenis venku.",
                                "tr": "Bugün dışarıda tenis oynamak için çok fazla rüzgâr <w>esiyor</w>.",
                                "es": "Hoy <w>hace</w> demasiado <w>viento</w> para jugar al tenis afuera.",
                                "zh": "今天<w>风太大了</w>，不能去室外打网球。"
                            }
