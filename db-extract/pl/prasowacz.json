                                        "examples": [
                                            {
                                                "example_id": "1dc8c150-deb4-47c1-b526-a4c8b54d1765",
                                                "sense_id": "ac2698b2-a85a-30dc-993f-60637fc69c7b",
                                                "text": "At the presser, [Scott] Morrison confirmed that the petrol tax of 22 cents a litre will go back to 44 cents after six months despite prices nudging $2 a litre again; […]"
                                            },
                                            {
                                                "example_id": "5251078d-4c7b-425b-b7c9-5945b3527a7c",
                                                "sense_id": "ac2698b2-a85a-30dc-993f-60637fc69c7b",
                                                "text": "A statement will be issued. We'll do a presser this aftern—"
                                            }
