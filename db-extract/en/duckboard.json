                "word": "duckboard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1d4308e-08a9-44d2-b97a-7248a0d1acb4",
                        "entry_id": "c4408929-2bc7-3741-8bc9-504e5ce5847e",
                        "tags": [
                            "plural"
                        ],
                        "form": "duckboards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "754a656e-39a9-3e84-b40a-a89e02b0b4da",
                        "entry_id": "c4408929-2bc7-3741-8bc9-504e5ce5847e",
                        "glosses": [
                            "One of a long series of boards laid from side to side as a path across wet or muddy ground; normally used in plural."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cfc261a-1fc9-4e37-91f8-0cae9d105947",
                                "sense_id": "754a656e-39a9-3e84-b40a-a89e02b0b4da",
                                "text": "In an attempt to alleviate the problem, wooden planking, known as duckboards, was placed at the bottom of trenches and across other areas of muddy or waterlogged ground."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e3c0433-987b-3d26-a422-aa65b3472cfe",
                        "entry_id": "c4408929-2bc7-3741-8bc9-504e5ce5847e",
                        "glosses": [
                            "Wooden, low walkway or short part of a path with one or more planks, logs, or boards laid after each other lengthwise, often two planks wide."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "174a96d1-6987-3c24-9499-47a045be2908",
                        "entry_id": "c4408929-2bc7-3741-8bc9-504e5ce5847e",
                        "glosses": [
                            "A panel of wooden slats typically laid on a concrete floor in a workshop, to reduce fatigue for a person operating a machine tool or working at a bench."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36e9fb85-4381-4c65-82d6-50ae83d32acd",
                        "source_entry_id": "c4408929-2bc7-3741-8bc9-504e5ce5847e",
                        "source_sense_description": "plank or board laid lengthwise as path across wet ground",
                        "target_lang_word": "Holzsteg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzsteg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                        "entry_id": "c40e42f2-cdb7-3651-966a-7ea22c4bca12",
                                        "glosses": [
                                            "kleiner Fußweg aus Brettern und Pfählen (aus Holz), der meist über dem Wasser gebaut wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65de460f-19c7-4f1c-9d9e-26cf26501c6e",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "„Schefold hatte sich gegen ein Uhr von Hainstock verabschiedet, in Hemmeres nur einen einfachen, schnell zurechtgemachten Imbiß zu sich genommen, dann war er über den Holzsteg auf das andere Ufer der Our gegangen.“"
                                            },
                                            {
                                                "example_id": "53beaf3f-a1c1-4080-a0c1-19df183d80fd",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "[Gazi/Kenia:] „Der Holzsteg führt durch die Küstenmangroven gegenüber von Chale Island.“"
                                            },
                                            {
                                                "example_id": "76c02413-bf5f-4e24-a8a9-1ebad8838de6",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "[Smögen/Schweden:] „Die Promenade Smögenbryggan ist ein langer Holzsteg, direkt am Yachthafen. Er schlängelt sich fast ein Kilometer an den Granitfelsen entlang,“ […]."
                                            },
                                            {
                                                "example_id": "6fdc8fed-de2d-48de-9eb1-9230a2aeee2a",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "[Simon’s Town/Südafrika:] „Die meisten Brutkolonien sind am Foxy Beach, sie sind über Holzstege gut zugänglich.“"
                                            },
                                            {
                                                "example_id": "78948c2d-b3a6-4c6e-9c29-dcf3106e769c",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "„Alex Sandro dos Santos steht auf dem alten Holzsteg, der vom Ufer der Siedlung Tubiacanga zu den Fischerbooten führt.“"
                                            },
                                            {
                                                "example_id": "1e9302e9-db65-4970-9d00-91cc2cfcbf5a",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "[Braderuper Heide/Schleswig-Holstein:] „Die urwüchsige Heidelandschaft, die man über Holzstege erwandern kann, ist seit 1920 Naturschutzgebiet.“"
                                            },
                                            {
                                                "example_id": "677a625d-40fd-4050-9f53-6df323bff908",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "[Venedig:] „Nach tagelangem Regen steht das Wasser kniehoch auf dem Markusplatz. Vielen Gästen in der italienischen Stadt blieb nichts anderes übrig, als über Holzstege zu ihren Hotels zu balancieren.“"
                                            },
                                            {
                                                "example_id": "08013063-90c7-4e2c-9135-d9918ac2b820",
                                                "sense_id": "94655a24-812c-3bd2-b028-528a7630b75d",
                                                "text": "[Löptin/Schleswig-Holstein:] „Die Badestelle mit dem kleinen Wiesenstück und dem Holzsteg ist der perfekte Ort, um nach hektischen Tagen die Ruhe zu genießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1152e62e-e5d7-436c-b3ab-ff7bbb546fe5",
                        "source_entry_id": "c4408929-2bc7-3741-8bc9-504e5ce5847e",
                        "source_sense_description": "plank or board laid lengthwise as path across wet ground",
                        "target_lang_word": "Steg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "eine kleine Brücke"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97d196d-0ae3-4d32-844d-3300608105b5",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Diesen schmalen Steg müssen wir überschreiten."
                                            },
                                            {
                                                "example_id": "98b2eff3-e3ea-42dd-a9e0-365976a22f12",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "„Weit und breit verursachten unsere Füße auf dem knarrenden Steg das einzige Geräusch.“"
                                            },
                                            {
                                                "example_id": "1b7d0d8d-692c-4341-b6fc-f6144c56a12a",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "„Die Bretter des Stegs hatten geknarrt, und das Wasser des Flusses war so dunkel und durchsichtig gewesen wie immer.“"
                                            },
                                            {
                                                "example_id": "bba2adaf-ea7a-46a2-a9d2-d745bf88bfe0",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Köln, Rheinauhafen. Im Schatten der architektonisch durchaus gewagten drei Kranhäuser dümpeln gut vertäut Schiffe an den Stegen."
                                            },
                                            {
                                                "example_id": "2aa8c37b-67f7-40f5-963a-fa5f488ef1d3",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Am Steg baumelt ein Thermometer im Wasser. Neun Grad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "347ae8b4-d71e-31f8-8635-5f747d30120b",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "bei Streichinstrumenten auf dem Resonanzboden aufstehendes kleines Querbrett, über das die Saiten laufen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2302b2-8479-4fec-aac0-d8277c1ebc64",
                                                "sense_id": "347ae8b4-d71e-31f8-8635-5f747d30120b",
                                                "text": "Ein virtuoser Geiger muss den perfekten Treffpunkt des Bogens auf der Saite zwischen Steg und Griffbrett finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3f20325-6510-35ba-a289-d51a9c22f9b0",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "unter dem Schuh oder unter dem Fuß durchlaufender Riemen, um die Kleidung straff zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4efd06b-5206-45fb-8e88-751188b9e6d6",
                                                "sense_id": "a3f20325-6510-35ba-a289-d51a9c22f9b0",
                                                "text": "Der Steg unter meinem rechten Schuh ist schon durchgetreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dbb98190-58ba-382f-94b1-b7a113c8553e",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "die leere Außenfläche einer bedruckten Buchseite"
                                        ],
                                        "tags": [
                                            "Druckerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9af13e-aeaa-4d96-b51b-bd2d83d84eb0",
                                                "sense_id": "dbb98190-58ba-382f-94b1-b7a113c8553e",
                                                "text": "Der Steg dieser Buchseite ist mit Notizen beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8274703b-c041-3b8c-9e18-15b0924ef4ac",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "das die beiden Gurte (im Stahlbau auch Flansche genannten) verbindende Konstruktionselement eines doppel-T-förmigen Trägers"
                                        ],
                                        "tags": [
                                            "Stahlbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d16fa22d-4f60-43f9-87b8-1c5b8ff07f92",
                                                "sense_id": "8274703b-c041-3b8c-9e18-15b0924ef4ac",
                                                "text": "Der Steg eines Doppel-T-Trägers verbindet die beiden Flansche."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e655164a-cc0b-3da0-9f77-7b175a361851",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "generell verbindendes Konstruktionselement wie zum Beispiel der Brillensteg"
                                        ],
                                        "tags": [
                                            "Konstruktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4f15288-a057-4f0a-8408-5d9f1ac821e6",
                                                "sense_id": "e655164a-cc0b-3da0-9f77-7b175a361851",
                                                "text": "Der Optiker konnte den gebrochenen Steg an meiner Brille sofort reparieren."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
