        "fr-extract.jsonl": [
            {
                "entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                "word": "languissamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "442c7325-9766-3114-8636-3ba81d629e8d",
                        "entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                        "glosses": [
                            "D’une manière languissante ; qui montre un affaiblissement physique ou moral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763ca07f-a18a-4ee4-8fb5-753c6732f398",
                                "sense_id": "442c7325-9766-3114-8636-3ba81d629e8d",
                                "text": "Sa tête sur un bras languissamment penchée,\nImmobile et rêveur, en malheureux amant…"
                            },
                            {
                                "example_id": "b5a574f6-d32b-46a6-9a51-5af0962c14dd",
                                "sense_id": "442c7325-9766-3114-8636-3ba81d629e8d",
                                "text": "Le roi venait languissamment, se mettait en bonne place pour voir l’opération dans tous ses détails : cela le distrayait toujours un peu et lui faisait prendre le siége en patience ; mais cela ne l’empêchait pas de s’ennuyer fort, de parler à tous moments de retourner à Paris ; de sorte que si les messagers et les espions eussent fait défaut, Son Éminence, malgré toute son imagination, se fût trouvée fort embarrassée."
                            },
                            {
                                "example_id": "7dcce847-bed2-4c43-b383-80ddb769b142",
                                "sense_id": "442c7325-9766-3114-8636-3ba81d629e8d",
                                "text": "Un de ses bras pendait de la funèbre couche ;\nL’autre, languissamment replié sur son cœur,\nSemblait chercher encore et presser sur sa bouche\nL’image du Sauveur."
                            },
                            {
                                "example_id": "737ec7eb-e180-4b60-89c5-01fe59fce4da",
                                "sense_id": "442c7325-9766-3114-8636-3ba81d629e8d",
                                "text": "Il pleuvait. Elle écoutait languissamment les gouttes d’eau tomber sur la terrasse."
                            },
                            {
                                "example_id": "3fc6072b-af9a-48b2-be98-bcff831382c6",
                                "sense_id": "442c7325-9766-3114-8636-3ba81d629e8d",
                                "text": "L’émission se déroulait un peu languissamment quand un jeune homme surgi du public fait irruption sur le plateau en brandissant un couteau."
                            }
                        ]
                    },
                    {
                        "sense_id": "85bdc797-9d54-3b48-9121-564af81ce22a",
                        "entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                        "glosses": [
                            "Sans force ; sans activité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdef740d-db5b-48fb-ba93-3f763287b056",
                                "sense_id": "85bdc797-9d54-3b48-9121-564af81ce22a",
                                "text": "[…] ; les fruits mûrissaient à peine, je ne voyais point de vignes, les fleurs croissaient languissamment à long intervalle l’une de l’autre ; […]"
                            },
                            {
                                "example_id": "c5bff4e1-a107-4ba6-8687-cfb1fd844738",
                                "sense_id": "85bdc797-9d54-3b48-9121-564af81ce22a",
                                "text": "Des feux qui brillèrent sur notre gauche, dans la nuit du 23 au 24, avertirent du mouvement des Russes vers Malo-Iaroslavetz ; et cependant on remarquait qu’on y avait marché languissamment."
                            },
                            {
                                "example_id": "e09215c6-3803-4e3b-8789-ec0728664b7c",
                                "sense_id": "85bdc797-9d54-3b48-9121-564af81ce22a",
                                "text": "Vêtu de noir, à demi-couché sur une chaise longue, et les coudes appuyés sur des oreillers, le prince touchait languissamment les cordes de sa guitare."
                            },
                            {
                                "example_id": "372955b8-b52c-4bd6-a88c-ba6ece334ae7",
                                "sense_id": "85bdc797-9d54-3b48-9121-564af81ce22a",
                                "text": "Déjà le soleil se traînait languissamment au-dessus de l'horizon, car il ne s'élevait dans sa culmination que de quelques degrés à peine."
                            },
                            {
                                "example_id": "ccf80c18-823f-4b52-bbdb-c193d129238d",
                                "sense_id": "85bdc797-9d54-3b48-9121-564af81ce22a",
                                "text": "Un bananier gelé, brun et livide, se dressait encore languissamment devant le perron […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "01da6616-ea83-3891-843f-15e13e493b29",
                        "entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                        "glosses": [
                            "Avec une langueur amoureuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bc3ed1-de0f-4dca-bb2a-b280de0bf919",
                                "sense_id": "01da6616-ea83-3891-843f-15e13e493b29",
                                "text": "[…], il prit un flambeau d'une main, de l'autre alla chercher languissamment le cou de sa femme, et voulut l'embrasser ; […]."
                            },
                            {
                                "example_id": "33f3e22a-711b-464f-9381-15910be23e20",
                                "sense_id": "01da6616-ea83-3891-843f-15e13e493b29",
                                "text": "Manière d'agrémenter, on se finit la séance à la duc d’Aumale ; à savoir que messire Tonio est allongé languissamment sur le dos, les mains derrière la nuque (donc, devant, en réalité) et qu'il se laisse chevaucher par mam’selle Molly, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "731b6e4c-268b-4b2b-8d4a-f5c57e8836a5",
                        "source_entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                        "target_lang_word": "languidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                        "entry_id": "63dca619-e523-3d40-9d25-1ba3bbec3228",
                                        "glosses": [
                                            "In a languid manner, without force or effort, in a manner requiring little energy or exertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb5828e-1a37-4fad-bd0b-c905da4aff5a",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "He languidly waved his limp wrist, glad to see us, but not wanting to expend the energy to let us know that."
                                            },
                                            {
                                                "example_id": "c656122d-86b5-4e15-a071-128cf96ac1fe",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "Under the strain of this continually impending doom and by the sleeplessness to which I now condemned myself, ay, even beyond what I had thought possible to man, I became, in my own person, a creature eaten up and emptied by fever, languidly weak both in body and mind, and solely occupied by one thought: the horror of my other self."
                                            },
                                            {
                                                "example_id": "a91621e0-5e48-4969-b799-32eed81591fc",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "“It is your best work, Basil, the best thing you have ever done,” said Lord Henry, languidly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2f294d5-c187-41f8-a458-a1c7ad4996af",
                        "source_entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                        "target_lang_word": "languishingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languishingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a64722-e5f7-3198-908b-f76e791989c3",
                                        "entry_id": "0e2a82a0-835b-3587-a985-4e4fe752dd2e",
                                        "glosses": [
                                            "In a languishing manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f72f85-4d2e-41a6-901b-fb6098994b52",
                                                "sense_id": "f7a64722-e5f7-3198-908b-f76e791989c3",
                                                "text": "She looked languishingly at him as he danced with another woman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7613e91-6cf0-4a87-84df-062ba8ff7dd8",
                        "source_entry_id": "ae8e61b5-cc4d-35cd-bdab-380ac19e4a61",
                        "target_lang_word": "languorously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languorously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                        "entry_id": "a5c76311-f45c-3dd5-b080-8d38c85252f6",
                                        "glosses": [
                                            "In a languorous manner; without exertion; lazily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d699f0-9f37-41eb-a6fc-b5fceb83c183",
                                                "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                                "text": "I stretched languorously, and then remained in bed."
                                            },
                                            {
                                                "example_id": "8c21985f-3f6a-46b6-98fb-81977ac63742",
                                                "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                                "text": "\"I did!\" She had reached the barricades, and leaned over them languorously. \"I can't take all the credit, though, just, you know, most of it.\" She folded her arms over the edge, and kicked back both of her feet again and again. \"Somebody once told me I have a mind like a steel trap.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
