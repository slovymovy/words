    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2370c5b9-fbb7-3e3e-8da4-dcbad137683d",
                    "sense_definition": "niewielka jednostka pływająca poruszana wiosłami, żaglem lub małym silnikiem",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pojazd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Latem często wynajmujemy drewnianą <w>łódkę</w> i pływamy po całym jeziorze.",
                            "target_lang_translations": {
                                "ru": "Летом мы часто берем напрокат деревянную <w>лодку</w> и плаваем по всему озеру."
                            }
                        },
                        {
                            "text": "Rybak powoli skierował swoją <w>łódkę</w> w stronę brzegu przed burzą.",
                            "target_lang_translations": {
                                "ru": "Рыбак медленно направил свою <w>лодку</w> к берегу перед надвигающейся бурей."
                            }
                        }
                    ],
                    "synonyms": [
                        "łódeczka"
                    ],
                    "common_phrases": [
                        "pływać łódką",
                        "drewniana łódka",
                        "łódka rybacka"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое плавательное средство, приводимое в движение веслами, парусом или небольшим мотором"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лодка",
                                "target_lang_sense_clarification": "небольшое гребное, парусное или моторное судно"
                            },
                            {
                                "target_lang_word": "шлюпка",
                                "target_lang_sense_clarification": "небольшое вспомогательное судно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e031fcd-1f05-36da-a8ae-35c99f6740fc",
                    "sense_definition": "zdrobnienie od słowa <w>łódź</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pojazd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przy pomoście cumowała tylko mała, skromna <w>łódka</w> miejscowego wędkarza.",
                            "target_lang_translations": {
                                "ru": "У причала была пришвартована лишь маленькая, скромная <w>лодочка</w> местного рыбака."
                            }
                        },
                        {
                            "text": "Ta mała <w>łódka</w> należała do mojego dziadka i służyła mu przez lata.",
                            "target_lang_translations": {
                                "ru": "Эта маленькая <w>лодочка</w> принадлежала моему дедушке и служила ему годами."
                            }
                        }
                    ],
                    "synonyms": [
                        "łódeczka"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "zdrobnienie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительно-ласкательная форма от слова «łódź» (лодка)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лодочка",
                                "target_lang_sense_clarification": "уменьшительное к лодка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb3e0989-e305-3a2b-9651-72f124d10fd4",
                    "sense_definition": "zabawka przypominająca małą łódź, często wykonana z papieru lub plastiku",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "zabawka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci zrobiły papierowe <w>łódki</w> i puszczały je w głębokiej kałuży.",
                            "target_lang_translations": {
                                "ru": "Дети сделали бумажные <w>кораблики</w> и пускали их в глубокой луже."
                            }
                        },
                        {
                            "text": "W internecie znalazłem prosty filmik pokazujący składanie kolorowych <w>łódek</w> z papieru.",
                            "target_lang_translations": {
                                "ru": "В интернете я нашёл простое видео, показывающее, как складывать цветные <w>кораблики</w> из бумаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "łódeczka"
                    ],
                    "common_phrases": [
                        "papierowa łódka",
                        "puszczać łódki"
                    ],
                    "target_lang_definitions": {
                        "ru": "игрушка, напоминающая лодку, часто сделанная из бумаги или пластика"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кораблик",
                                "target_lang_sense_clarification": "игрушечный, бумажный"
                            },
                            {
                                "target_lang_word": "лодочка",
                                "target_lang_sense_clarification": "игрушечная"
                            }
                        ]
                    }
                }
            ]
        }
    ]
