                "senses": [
                    {
                        "sense_id": "3c2b73fd-9f73-37b4-aee9-c8a79de28ab6",
                        "entry_id": "9171288e-5f4a-3ee4-8b48-36257f30f31c",
                        "glosses": [
                            "To prepare; to make ready; to array; to dress."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3026092c-016a-4199-9b48-c16e2c3e8f08",
                                "sense_id": "3c2b73fd-9f73-37b4-aee9-c8a79de28ab6",
                                "text": "Busk ye, busk ye, my bonny, bonny bride."
                            },
                            {
                                "example_id": "99a9ffe7-6541-4b7a-a736-ffbac50400c8",
                                "sense_id": "3c2b73fd-9f73-37b4-aee9-c8a79de28ab6",
                                "text": "The watch stert up and drew their weapons bright / And busk'd them bold to battle and to fight."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f63dbad-3cdb-3172-afd3-c6bf7ea7914a",
                        "entry_id": "9171288e-5f4a-3ee4-8b48-36257f30f31c",
                        "glosses": [
                            "To go; to direct one's course."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "af27900b-903c-4f1f-a5e1-69c5fffc7496",
                                "sense_id": "5f63dbad-3cdb-3172-afd3-c6bf7ea7914a",
                                "text": "Ye might have busked you to Huntly-banks."
                            }
                        ]
                    }
                ],
