                "word": "druidesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b367d426-932f-4f96-ba57-b766cacd58ec",
                        "entry_id": "230832a8-106e-3e60-a8a2-ec58060c9b4e",
                        "tags": [
