{
    "word_family": [
        "nakomen",
        "afstammeling",
        "afstammen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d30d33c-c7ae-33de-9855-221be8c94065",
                    "sense_definition": "Een persoon of dier dat afstamt van een bepaalde voorouder; een afstammeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afstammeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is een directe <w>nakomeling</w> van de koninklijke familie.",
                            "target_lang_translations": {
                                "en": "She is a direct <w>descendant</w> of the royal family."
                            }
                        },
                        {
                            "text": "Elke gezonde <w>nakomeling</w> draagt bij aan het overleven van deze bedreigde diersoort.",
                            "target_lang_translations": {
                                "en": "Every healthy <w>offspring</w> contributes to the survival of this endangered species."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstammeling",
                        "nazaat",
                        "telg"
                    ],
                    "antonyms": [
                        "voorouder",
                        "voorzaat"
                    ],
                    "common_phrases": [
                        "directe nakomeling",
                        "enige nakomeling"
                    ],
                    "target_lang_definitions": {
                        "en": "A person or animal descended from a specific ancestor; an offspring or descendant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descendant",
                                "target_lang_sense_clarification": "a person or animal that is descended from a specific ancestor"
                            },
                            {
                                "target_lang_word": "offspring",
                                "target_lang_sense_clarification": "the immediate young of an animal or person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ddfea4e-42c4-3adc-9d99-9f75ee3fd968",
                    "sense_definition": "Een bloedverwant in neerdalende lijn.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "afstammeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nakomelingen</w> kunnen afwijkingen in het genetisch materiaal van hun ouders erven.",
                            "target_lang_translations": {
                                "en": "<w>Descendants</w> can inherit abnormalities in their parents' genetic material."
                            }
                        },
                        {
                            "text": "De rechtbank moest beslissen over de erfenis die bestemd was voor elke wettelijke <w>nakomeling</w>.",
                            "target_lang_translations": {
                                "en": "The court had to decide on the inheritance intended for each legal <w>descendant</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstammeling",
                        "nazaat",
                        "descendent"
                    ],
                    "antonyms": [
                        "voorouder"
                    ],
                    "common_phrases": [
                        "wettelijke nakomeling"
                    ],
                    "target_lang_definitions": {
                        "en": "A blood relative in a descending line."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descendant",
                                "target_lang_sense_clarification": "a person related by blood in a descending line"
                            },
                            {
                                "target_lang_word": "progeny",
                                "target_lang_sense_clarification": "descendants or offspring considered as a group"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}