                "senses": [
                    {
                        "sense_id": "09c31397-ef73-39e5-896a-d205c60b4db8",
                        "entry_id": "f99a3d7f-d875-34dd-bc18-56026a9a6df1",
                        "glosses": [
                            "Airbag, der den Beifahrer vor unfallbedingten Verletzungen schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f289425-4e1b-4862-a84c-c7c1922c8b6f",
                                "sense_id": "09c31397-ef73-39e5-896a-d205c60b4db8",
                                "text": "„Der Beifahrerairbag wird oftmals in Höhe des Handschuhfachs eingebaut, was den Nachteil hat, dass Letzteres sehr klein ausfällt.“"
                            },
                            {
                                "example_id": "d61dc52a-a554-4f8f-8f3e-883f3c901a15",
                                "sense_id": "09c31397-ef73-39e5-896a-d205c60b4db8",
                                "text": "„Bei der Untersuchung wurde der Fokus dabei in erster Linie auf familienfreundliche Wagen gerichtet, da man hierbei davon ausgehen können sollte, dass die Beifahrerairbag-Deaktivierung serienmäßig angeboten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
