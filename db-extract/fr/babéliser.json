                ],
                "senses": [
                    {
                        "sense_id": "9fb09c22-fe13-3aeb-858c-906c605abf65",
                        "entry_id": "4ad66ba0-7e2f-356a-99f2-c3364b2d09e8",
                        "glosses": [
                            "Donner un caractère babélien, rappelant la tour de Babel, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e84fe18-08a0-4c59-b4a1-5e2c06ed3ca5",
                                "sense_id": "9fb09c22-fe13-3aeb-858c-906c605abf65",
                                "text": "La langue grecque d’Eschyle a véritablement fécondé le français de Claudel, lui a sans doute permis de découvrir la présence du fameux «ïambe» fondamental, et a contribué à babéliser son écriture."
                            },
                            {
                                "example_id": "f4457b99-667b-4d6a-9271-b90cb71afac2",
                                "sense_id": "9fb09c22-fe13-3aeb-858c-906c605abf65",
                                "text": "Il va babéliser l'archive, faisant de son enregistrement un babil entrecoupé et inintelligible, pas du tout sérieux, pas digne qu’on lui prête la moindre attention."
                            },
                            {
                                "example_id": "ddf50dd0-4f17-4d02-b06f-62198a28a6b5",
                                "sense_id": "9fb09c22-fe13-3aeb-858c-906c605abf65",
                                "text": "En étant «parlé», le sujet finit par se babéliser, et quand celui-ci ne peut plus «être parlé», il ne peut que se taire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e93551ad-f6c6-4511-9808-45896d497ae8",
                        "source_entry_id": "4ad66ba0-7e2f-356a-99f2-c3364b2d09e8",
                        "source_sense_id": "9fb09c22-fe13-3aeb-858c-906c605abf65",
                        "target_lang_word": "babelize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babelize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c08ecfba-03b7-38e2-b27f-d40ab4f0ea16",
                                        "entry_id": "854177cd-cdcc-3bca-9d99-2f04340d5ff6",
                                        "glosses": [
                                            "To confuse by mixing or mingling divergent or distinct languages or cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec9ad16-a32c-4aeb-aced-a9b20cbbe3c6",
                                                "sense_id": "c08ecfba-03b7-38e2-b27f-d40ab4f0ea16",
                                                "text": "And if we want to speak upon our return of what we have learned there, to speak in our language perforce loses the life of their thoughts, but to speak in their language is to babelize in our own world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
