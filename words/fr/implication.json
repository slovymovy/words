                {
                    "sense_id": "5b73cd16-553b-3664-991c-4330ca29b3dc",
                    "sense_definition": "Engagement actif, participation personnelle ou investissement soutenu dans une action, une tâche ou un projet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
