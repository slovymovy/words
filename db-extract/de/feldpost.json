                ],
                "senses": [
                    {
                        "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                        "entry_id": "3bda2d30-f7f5-3367-bc8b-0d105665f71e",
                        "glosses": [
                            "Postverkehr in Kriegszeiten zwischen den Frontsoldaten und der Heimat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0eed4ab-6828-4cf5-8421-bbf918d787eb",
                                "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                                "text": "„Über die erste niederländische Feldpost ist in einem Beschluss vom 12. August 1597 zu lesen das demnach zwischen Den Haag und s'Gravenwert (einer Rheininsel bei Lobith) ein Reitpostkurs eingerichtet war mit festen Stationen in Alphen, Bodegraven, Utrecht, Rhenen und Arnheim.“"
                            },
                            {
                                "example_id": "9dba4848-2311-4b07-9d12-34bf81f6aa2c",
                                "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                                "text": "„Die Personalisierungen in einzelnen Abschnitten veranschaulichen die Bedeutung der Feldpost für die »Kommunikationsbeteiligten«.“"
                            },
                            {
                                "example_id": "32692b1b-36db-4a64-b55b-8d25ea96e57e",
                                "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                                "text": "„Da die Feldpost zensiert wurde, wussten wir, dass viele ihren Familien in Deutschland diese Fotos schickten, einige sogar in Gestalt kleiner Alben, mit Bildunterschriften geschmückt…“"
                            },
                            {
                                "example_id": "87a93539-e655-470d-bc03-a68ffc1ca837",
                                "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                                "text": "„Trotz großer Versorgungsengpässe funktionierte die Feldpost bis zur Kapitulation der Wehrmacht im Mai 1945.“"
                            },
                            {
                                "example_id": "35723fa9-b9c6-4a92-9ae6-9ab0a55a8d50",
                                "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                                "text": "„Er wird nach Jugoslawien geschickt, fortan lebt Kitty mit der Mutter allein - nur noch gelegentliche Feldpost hält die Verbindung in die Ferne.“"
                            },
                            {
                                "example_id": "2314979b-141c-457d-b5ef-881598e41d11",
                                "sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                                "text": "„Feldposten waren bereits dreimal im >Einsatz gewesen: Die Feldpost der Legion Condor im spanischen Bürgerkrieg, die Feldpost während der Annexion Österreichs zu Beginn des Jahres 1938 und schließlich die Feldpost während der Annexion der Sudetengebiete im Oktober 1938.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82db1329-72e4-45a8-97d2-c8784c4810fa",
                        "source_entry_id": "3bda2d30-f7f5-3367-bc8b-0d105665f71e",
                        "source_sense_id": "1bffeca9-e098-3454-bf4d-6408d55969cb",
                        "source_sense_description": "Postverkehr in Kriegszeiten zwischen den Frontsoldaten und der Heimat",
                        "target_lang_word": "veldpost",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veldpost",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "af337ecc-2ac1-3ea4-b690-897e1224dcad",
                                        "entry_id": "0980e5ab-a607-34d5-b4c4-e5bff2cb8c60",
                                        "glosses": [
                                            "verzorging van militaire post naar militairen die buiten de kazerne verblijven, omdat ze met hun onderdeel zijn ingezet voor oefening, mobilisatie of een daadwerkelijke confrontatie met de vijand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc17d4d-5bb2-4b0e-86b6-9234a350dffd",
                                                "sense_id": "af337ecc-2ac1-3ea4-b690-897e1224dcad",
                                                "text": "De kerstkaart werd door verzetsstrijders van Jersey met 85 andere soldatenbrieven gestolen uit een veldpostkantoor. De brieven werden onlangs aan het postbedrijf van Jersey gegeven. Het is de bedoeling dat alle brieven bij (nazaten van) de geadresseerden terechtkomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a425a10-60c8-3ef9-88f4-e4ee96fdc0c8",
                                        "entry_id": "0980e5ab-a607-34d5-b4c4-e5bff2cb8c60",
                                        "glosses": [
                                            "versterkte plaats buiten de bebouwde kom vanwaaruit acties ondernomen worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "480da884-b401-4ff5-9d09-acabb2ec2406",
                                                "sense_id": "0a425a10-60c8-3ef9-88f4-e4ee96fdc0c8",
                                                "text": "Zijn interventie was tegelijk een knipoog naar het oorlogsverleden van de locatie. Want de caban, die oorspronkelijk wat verderop stond, werd tijdens de Tweede Wereldoorlog een tijd ingenomen door de Duitsers, die ze gebruikten als veldpost om de boeren in de gaten te houden.de Standaard 22 AUGUSTUS 2016 OM 03:00 UUR"
                                            },
                                            {
                                                "example_id": "0cf9eb8d-08e0-46d3-9fdc-bcd9cfb3d773",
                                                "sense_id": "0a425a10-60c8-3ef9-88f4-e4ee96fdc0c8",
                                                "text": "We bouwen samen de veldpost op en er zijn 15 operatoren, met aflossingsbeurten, die de klok rond radioverbindingen leggen. We willen demonstreren dat radioverbindingen levens kunnen redden.'"
                                            },
                                            {
                                                "example_id": "0081c6e4-7740-4ee5-9249-454eb75566fa",
                                                "sense_id": "0a425a10-60c8-3ef9-88f4-e4ee96fdc0c8",
                                                "text": "In het buitenland zijn circa 100 AIVD-functionarissen gestationeerd. Zij sturen via ambassades, lokale stromannen, reizende posten (o.a. het toezicht op piraten in Somalië), veldposten en dekmantelbedrijven honderden informanten en infiltranten aan. In dit netwerk zal flink worden geschrapt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
