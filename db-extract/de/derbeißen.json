                "senses": [
                    {
                        "sense_id": "9eb3161c-d07e-311c-97eb-ab76fca4d32e",
                        "entry_id": "8cb051f8-ebc5-3f0b-a97b-cffe183256e2",
                        "glosses": [
                            "zerbeißen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "586bd97c-7b66-4c8b-a205-64ee3ceb22ae",
                                "sense_id": "9eb3161c-d07e-311c-97eb-ab76fca4d32e",
                                "text": "„Wann d' Mäus' in d' Pflanzbeet umrumor'n und d' Würzerln so derbeißen; …“"
                            },
                            {
                                "example_id": "7be0427c-64fa-4aea-bda6-1bd8dfef5a41",
                                "sense_id": "9eb3161c-d07e-311c-97eb-ab76fca4d32e",
                                "text": "„Ihr habt doch gute Zähn, und ich kann's so nimmer derbeißen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0775e7fe-3b43-3eb2-a5a1-a1c1578e1e7f",
                        "entry_id": "8cb051f8-ebc5-3f0b-a97b-cffe183256e2",
                        "glosses": [
                            "totbeißen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "20b8acbd-f2db-42f8-95e0-09190f724835",
                                "sense_id": "0775e7fe-3b43-3eb2-a5a1-a1c1578e1e7f",
                                "text": "„Bitt schön, den hat ein Hund derbissen.“"
                            },
                            {
                                "example_id": "b63eefe6-3e51-4347-8495-db531ae53bb8",
                                "sense_id": "0775e7fe-3b43-3eb2-a5a1-a1c1578e1e7f",
                                "text": "„Der Stärkere derbeißt leicht den Schwächeren.“"
                            },
                            {
                                "example_id": "1eee741d-e396-4d5c-b77d-66233f329a11",
                                "sense_id": "0775e7fe-3b43-3eb2-a5a1-a1c1578e1e7f",
                                "text": "„Und d'Hena häd uns da Fux dabissn.“"
                            },
                            {
                                "example_id": "a4829c97-bcf9-4b09-a9f4-0124382508ea",
                                "sense_id": "0775e7fe-3b43-3eb2-a5a1-a1c1578e1e7f",
                                "text": "„Hats gar da Kuckuck aussigschmissn? Da Marder dabissn?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3f5be66b-ee9c-300b-8feb-0272f04b887e",
