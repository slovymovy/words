                {
                    "sense_id": "a34bf569-2c3c-350d-a6ff-78b780c0e870",
                    "sense_definition": "В непосредственной близости, прямо за чем-либо (в пространстве или времени).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За деревней <w>сразу</w> начинался густой лес.",
                            "target_lang_translations": {
                                "en": "A dense forest began <w>immediately</w> beyond the village.",
                                "zh": "村子后面<w>紧</w>接着就是一片茂密的森林。",
                                "cs": "Za vesnicí <w>hned</w> začínal hustý les.",
                                "nl": "Achter het dorp begon <w>vlak</w> een dicht bos.",
                                "pl": "Za wsią <w>tuż</w> zaczynał się gęsty las.",
                                "de": "Hinter dem Dorf begann <w>gleich</w> ein dichter Wald.",
                                "fr": "Une forêt dense commençait <w>juste</w> après le village.",
                                "it": "Dietro il villaggio iniziava <w>subito</w> un bosco fitto.",
                                "tr": "Köyün <w>hemen</w> arkasından sık bir orman başlıyordu.",
                                "es": "Detrás del pueblo, <w>justo</w> empezaba un bosque espeso."
                            }
                        },
                        {
                            "text": "Магазин находится <w>сразу</w> за углом.",
                            "target_lang_translations": {
                                "en": "The shop is <w>right</w> around the corner.",
                                "zh": "商店<w>就</w>在拐角后面。",
                                "cs": "Obchod je <w>hned</w> za rohem.",
                                "nl": "De winkel is <w>vlak</w> om de hoek.",
                                "pl": "Sklep znajduje się <w>zaraz</w> za rogiem.",
                                "de": "Der Laden befindet sich <w>direkt</w> hinter der Ecke.",
                                "fr": "Le magasin se trouve <w>juste</w> au coin de la rue.",
                                "it": "Il negozio si trova <w>subito</w> dietro l'angolo.",
                                "tr": "Dükkan <w>tam</w> köşeyi dönünce.",
                                "es": "La tienda está <w>justo</w> a la vuelta de la esquina."
                            }
                        }
