                        "sense_id": "1bd25877-a0d6-35a6-ad34-99f68b3653f5",
                        "entry_id": "64c4e111-8221-3fdb-b996-4112a674b264",
                        "glosses": [
                            "Reise, die nur dem Vergnügen dient"
                        ],
