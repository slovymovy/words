{
    "word_family": [
        "immaculate",
        "immaculateness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5bec8879-4612-3dc7-b2ed-af94615a1cdb",
                    "sense_definition": "In a manner that is perfectly clean and free from any dirt or stains.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleanliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room was <w>immaculately</w> clean when we arrived.",
                            "target_lang_translations": {
                                "nl": "De hotelkamer was bij aankomst <w>smetteloos</w> schoon."
                            }
                        },
                        {
                            "text": "She was dressed <w>immaculately</w> for the formal dinner party.",
                            "target_lang_translations": {
                                "nl": "Ze was <w>onberispelijk</w> gekleed voor het formele diner."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleanly",
                        "perfectly",
                        "purely"
                    ],
                    "common_phrases": [
                        "immaculately dressed",
                        "immaculately clean"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een manier die volkomen schoon is en vrij van vuil of vlekken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onberispelijk",
                                "target_lang_sense_clarification": "vaak gebruikt voor kleding of uiterlijk"
                            },
                            {
                                "target_lang_word": "smetteloos",
                                "target_lang_sense_clarification": "benadrukt de afwezigheid van enig vuil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "119c4587-4041-3f07-b387-a6d3480dbf3c",
                    "sense_definition": "In a manner that is completely free of errors or flaws.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He performed the complex piano piece <w>immaculately</w> without a single mistake.",
                            "target_lang_translations": {
                                "nl": "Hij voerde het complexe pianostuk <w>vlekkeloos</w> uit, zonder ook maar één fout."
                            }
                        },
                        {
                            "text": "The project was <w>immaculately</w> executed from start to finish.",
                            "target_lang_translations": {
                                "nl": "Het project werd van begin tot eind <w>vlekkeloos</w> uitgevoerd."
                            }
                        }
                    ],
                    "synonyms": [
                        "flawlessly",
                        "impeccably",
                        "perfectly"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een manier die volledig vrij is van fouten of gebreken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlekkeloos",
                                "target_lang_sense_clarification": "geeft aan dat iets zonder fouten is verlopen"
                            },
                            {
                                "target_lang_word": "perfect",
                                "target_lang_sense_clarification": "algemene term voor foutloosheid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}