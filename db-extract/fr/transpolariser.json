                "senses": [
                    {
                        "sense_id": "85a6c942-4c95-367d-bbda-6afd05147b8e",
                        "entry_id": "bfea763b-934b-3d7b-b2c1-fa654cc114b5",
                        "glosses": [
                            "Donner un caractère transpolaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb4b66d-e9ca-4f03-b27b-7a7b82ac7634",
                                "sense_id": "85a6c942-4c95-367d-bbda-6afd05147b8e",
                                "text": "Elle peut transpolariser les ondes dans les cas suivants: — effet par temps clair (phénomène de réflexion). Cet effet est faible sur les liaisons obliques; (…)"
                            },
                            {
                                "example_id": "4a117291-558e-4d0b-8df2-a80b0816abf8",
                                "sense_id": "85a6c942-4c95-367d-bbda-6afd05147b8e",
                                "text": "Ces systèmes peuvent acquérir plusieurs voies radar différentes qui peuvent être monostatiques, bistatiques, copolarisées et transpolarisées, ce qui permet d'adapter la configuration du réseau à différentes exigences applicatives."
                            },
                            {
                                "example_id": "09c6f519-de58-48db-ab82-0ed08a2cb9e4",
                                "sense_id": "85a6c942-4c95-367d-bbda-6afd05147b8e",
                                "text": "L’asymétrie de l’alimentation favorise l’apparition de modes d’ordre supérieurs qui peuvent perturber le diagramme de rayonnement et introduire un champ transpolarisé."
                            }
                        ]
                    }
