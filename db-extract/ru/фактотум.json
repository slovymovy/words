                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2263ee-8971-4ffc-8c6e-4525e33147a8",
                                                "sense_id": "0d9ffd5c-f5c6-376a-8633-eaf46b1b3247",
                                                "text": "Under him, Dunstan was the do-all at court, being the king's treasurer, councilor, chancellor, confessor, all things."
                                            }
                                        ]
