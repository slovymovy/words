                "senses": [
                    {
                        "sense_id": "55130578-d546-39ce-8bce-7f9485061051",
                        "entry_id": "1a29d721-7c65-3870-9e35-7eb15dde99b5",
                        "glosses": [
                            "Glisser, introduire quelque part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb77cbd-10a2-49fe-9bce-761b6b2e97d0",
                                "sense_id": "55130578-d546-39ce-8bce-7f9485061051",
                                "text": "Il cède par là au tout fait, succombe à la confection de cette confession qui relie tout le passé aux fidélités présentes et tente tant bien que mal de contrefiler l’annonce du futur sous les événements irrécusables de son curriculum vitae."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1ee036d-1129-360a-bce9-e8b2f9822c2e",
                        "entry_id": "1a29d721-7c65-3870-9e35-7eb15dde99b5",
                        "glosses": [
                            "Se glisser, s’introduire quelque part."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "531fb9f8-9dc6-442e-a3d9-2db48743dd49",
                                "sense_id": "c1ee036d-1129-360a-bce9-e8b2f9822c2e",
                                "text": "Zigzaguer, tout est là : filer, se faufiler, s’entrefiler, se contrefiler, se défaufiler de cette perruque lancée à vingt à l’heure, la dernière seconde avant l’accroc."
                            }
                        ]
                    }
