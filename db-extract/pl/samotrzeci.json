                        "examples": [
                            {
                                "example_id": "11295bcf-f7bd-4534-8785-2c46ad57add9",
                                "sense_id": "4edb04d5-63c7-33ad-9a82-8bb6eed76871",
                                "text": "Kirkor samotrzeci / Chwyta dłonią koniowi królewskiemu cugle, / Krzycząc: srogi tyranie! trzema zabójstwami / Doszedłeś aż do tronu: idź w piekło!"
                            },
                            {
                                "example_id": "2b5d7cb8-1e3f-4114-88a7-2ab416cd3e69",
                                "sense_id": "4edb04d5-63c7-33ad-9a82-8bb6eed76871",
                                "text": "Świętopełk samotrzeci schronił się do zamku Kijowskiego, wojsko zaś jego częścią wyginęło, częścią dostało się do niewoli"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
