                "senses": [
                    {
                        "sense_id": "c930c82d-5ba1-3f43-98c1-e91da5d21d0e",
                        "entry_id": "d5b99168-49f0-3301-bc05-cf3a9a414ab5",
                        "glosses": [
                            "Rendre indéfini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88533f24-a618-4e0c-afd0-1347028b39ae",
                                "sense_id": "c930c82d-5ba1-3f43-98c1-e91da5d21d0e",
                                "text": "Tandis qu'en phrase affirmative la construction partitive était appelée, comme on l'a vu, pour indéfiniser un substantif de sens réel déterminé, le substantif de référent nul en phrase négative s'accommodait au mieux de la construction nue."
                            },
                            {
                                "example_id": "f1f01196-ff73-47f0-a88b-0c51ac5ac466",
                                "sense_id": "c930c82d-5ba1-3f43-98c1-e91da5d21d0e",
                                "text": "A tel point que l'on pouvait douter que la phénoménologie puisse penser l'infini comme tel, sans aussitôt le «phénoménaliser», c'est-à-dire le «finitiser» ou l'«indéfiniser»."
                            }
                        ]
                    }
                ],
