                    },
                    {
                        "translation_id": "4a3b434a-1767-4f8e-adae-b4f67bf26bf8",
                        "source_entry_id": "9b779dd8-b42e-3a65-8ca0-5d22884a1eec",
                        "source_sense_description": "valve, tap or faucet",
                        "target_lang_word": "vanne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75df116b-e828-3ca9-bb8e-cc3ebdccf7e7",
                                        "entry_id": "ae1be1e0-49bb-358f-a9cf-b0cc898cbad4",
                                        "glosses": [
                                            "Panneau de fermeture fixe et étanche servant à régler le débit d’un fluide liquide, gazeux ou pulvérulent dans une canalisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59356129-5f34-39d7-93ac-fe78f2737f70",
                                        "entry_id": "ae1be1e0-49bb-358f-a9cf-b0cc898cbad4",
                                        "glosses": [
                                            "Sorte de barrière étanche et mobile qui se hausse ou se baisse pour laisser passer l’eau ou la retenir dans un canal."
                                        ],
                                        "tags": [
                                            "Hydraulique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e443e46-b88e-4ce0-a821-0847785ee0b2",
                                                "sense_id": "59356129-5f34-39d7-93ac-fe78f2737f70",
                                                "text": "Il faut lever la vanne pour faire tourner le moulin."
                                            },
                                            {
                                                "example_id": "210f283e-4848-4548-974d-0aa5cc174f0b",
                                                "sense_id": "59356129-5f34-39d7-93ac-fe78f2737f70",
                                                "text": "Abaisser la vanne. Réparer les vannes."
                                            },
                                            {
                                                "example_id": "e2a9ee34-b8ea-4236-97bd-74643d89f6fe",
                                                "sense_id": "59356129-5f34-39d7-93ac-fe78f2737f70",
                                                "text": "Vannes de décharge. Vannes de chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3623bf-1ab7-314d-807b-60f32f4275a6",
                                        "entry_id": "ae1be1e0-49bb-358f-a9cf-b0cc898cbad4",
                                        "glosses": [
                                            "Partie liquide des matières fécales."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b19a892-5151-36a9-8052-fc1f9cfed0ab",
                                        "entry_id": "ae1be1e0-49bb-358f-a9cf-b0cc898cbad4",
                                        "glosses": [
                                            "Ce qui retient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c371a2a2-445d-4615-a0d5-d2455d1758ff",
                                                "sense_id": "6b19a892-5151-36a9-8052-fc1f9cfed0ab",
                                                "text": "Comme d’habitude, après avoir ouvert les vannes des finances pour un président républicain, les républicains trouveront subitement toutes sortes d’excuses pour refuser de l’argent à un président démocrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae7f00a8-757c-33d1-8c62-a9f5659d7388",
                                        "entry_id": "ae1be1e0-49bb-358f-a9cf-b0cc898cbad4",
                                        "glosses": [
                                            "Grande plume de l’aile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "263eef09-f1c1-3084-a865-578d13a640d2",
                                        "entry_id": "0f92bb0c-0a1d-3d5d-84aa-2ed0d400e2e7",
                                        "glosses": [
                                            "(Désuet au masculin) Méchanceté, pique, sarcasme, moquerie."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bffbca6b-11d9-44a2-8117-a1c01f22c8f1",
                                                "sense_id": "263eef09-f1c1-3084-a865-578d13a640d2",
                                                "text": "En fait d’blague, il s’agit d'un vanne ou plutôt d’une façon d'affranchir ceux qu’est pas au courant."
                                            },
                                            {
                                                "example_id": "6f51c008-b754-40c7-9a4c-1ade5eec959f",
                                                "sense_id": "263eef09-f1c1-3084-a865-578d13a640d2",
                                                "text": "En supposant même qu’il rencontre pas Riton, ou bien qu’il mesure à temps la connerie de son attitude, rien que pour avoir lâché ce vanne, il lui restait vingt-quatre heures à vivre, au mieux."
                                            },
                                            {
                                                "example_id": "ca8da009-d43b-41f3-b51b-64acbda4b8ac",
                                                "sense_id": "263eef09-f1c1-3084-a865-578d13a640d2",
                                                "text": "— Tu parles d’un sale boulot, dit d’un ton d’excuse celui qui avait déjà parlé.\n— Ah dis donc ! Passe la main ! cria joyeusement le petit noiraud, qu’est-ce que c’est que cette vanne ? C’est toi qui l’as choisi, le sale boulot ! On t’a pas forcé. T’étais volontaire, non ?"
                                            },
                                            {
                                                "example_id": "fc946609-b16c-4eb3-871e-8ee5baf9771b",
                                                "sense_id": "263eef09-f1c1-3084-a865-578d13a640d2",
                                                "text": "A la récréation, les gosses lui lançaient des vannes, « grosse vache », « grosse dinde ». Elle en souffrait énormément."
                                            },
                                            {
                                                "example_id": "6aad4a89-a0f1-4f00-8aa1-a03356d08d6b",
                                                "sense_id": "263eef09-f1c1-3084-a865-578d13a640d2",
                                                "text": "Il faut faire la gueule, balancer des vannes. S’aimer, ça ne se fait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c22ab502-d786-3334-a761-64e4510db386",
                                        "entry_id": "0f92bb0c-0a1d-3d5d-84aa-2ed0d400e2e7",
                                        "glosses": [
                                            "Plaisanterie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1ac410-1f04-4338-b12a-52a223d65b98",
                                                "sense_id": "c22ab502-d786-3334-a761-64e4510db386",
                                                "text": "Imagine que tu t’endors bercé par une histoire de La Fontaine, et qu’à ton réveil tout le monde cause comme Cyril Hanouna !\n— Qui ça ?\n— Ce gus qui riait comme une hyène épileptique à la moindre vanne débile, dans ces émissions de télé-poubelle que surkiffaient tant de nos petits camarades.\n— Oh, putain ! Y’a plus que toi pour te souvenir de ce vieil ectoplasme du PAF !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1413f130-22e2-3008-857e-1ffebe37cd80",
                                        "entry_id": "2bf3de05-e42e-322f-8bb9-0684117f09ec",
                                        "glosses": [
                                            "Variante de van pour faire correspondre prononciation et graphie."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c0616b-c750-4203-98b1-f53c8e698e1b",
                                                "sense_id": "1413f130-22e2-3008-857e-1ffebe37cd80",
                                                "text": "Tu sais maman, sur le carrefour ce matin, en plein milieu du croisement, j’ai vu quelque chose de très bizarre : il y avait dans un vanne, plein de morceaux de cocos, de feuilles, de cheveux, des pièces de monnaie le tout jauni de safran."
                                            },
                                            {
                                                "example_id": "c169fd9b-cb4b-4b95-ab64-0d9f7ac57828",
                                                "sense_id": "1413f130-22e2-3008-857e-1ffebe37cd80",
                                                "text": "«Le propriétaire vivait dans une vanne juste devant la propriété."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vanne",
                                "target_lang_code": "fr",
                                "target_senses": [
