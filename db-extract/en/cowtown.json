                            {
                                "example_id": "3976d620-5fa2-40ab-9b42-1e8865b4b5c6",
                                "sense_id": "8b4af2a2-ffe7-339d-b437-100e05d1696b",
                                "text": "In July 1873 a St. Louis journalist visited Wichita and penned a colorful description of the frontier cowtown, the article appearing in the St. Louis Globe under the heading of “NEAR BRIMSTONE.”"
                            }
                        ]
                    }
                ],
