                    {
                        "sense_id": "c3f9e557-4b1c-301a-991e-5ee264ec7053",
                        "entry_id": "e51a3845-3b3b-3f00-8bd4-33efa7399094",
                        "glosses": [
                            "lemon juice"
                        ],
