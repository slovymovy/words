                        "examples": [
                            {
                                "example_id": "2fa1c709-f9f6-4427-8d62-f5a024cea478",
                                "sense_id": "33ce5ecf-a472-31c5-b169-3ef76dbef987",
                                "text": "Si on n'a pas filtré le liquide immédiatement après la précipitation, il faut le remaintenir pendant un quart d'heure à 20° avant de le filtrer."
                            },
                            {
                                "example_id": "974c514f-1acd-47b7-a48a-ecfd6e962040",
                                "sense_id": "33ce5ecf-a472-31c5-b169-3ef76dbef987",
                                "text": "Remaintenir enfoncée la touche P1 (la diode rouge est toujours fixe) jusqu'à ce que la diode verte s'éteigne puis relâcher P1."
