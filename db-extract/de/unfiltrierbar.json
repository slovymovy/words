                    },
                    {
                        "form_id": "f28317c4-1573-4c6b-ab1f-110dc067a206",
                        "entry_id": "50c73d72-3cdf-348e-bdbb-d4f87bd81a96",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unfiltrierbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70ed235e-b76f-3815-81d5-c7ceb62f24af",
                        "entry_id": "50c73d72-3cdf-348e-bdbb-d4f87bd81a96",
                        "glosses": [
                            "so, dass es nicht filtriert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91622fb2-97f3-4f0e-81e6-0f31215958af",
                                "sense_id": "70ed235e-b76f-3815-81d5-c7ceb62f24af",
                                "text": "„Buttermilch hat den Nachteil, dass sie ohne Abtrennung der Caseine praktisch unfiltrierbar ist, und das an Phospholipiden reiche Butterserum ist nur sehr begrenzt verfügbar.“"
                            },
                            {
                                "example_id": "b49a5fc3-0d33-46a8-9032-fb0fcf55bb70",
                                "sense_id": "70ed235e-b76f-3815-81d5-c7ceb62f24af",
                                "text": "„Die Temperatur von 90° darf nicht überschritten werden, sonst erfolgt in der Titanlösung eine Änderung, indem ihre Farbe in Grau umschlägt und das mono-chinoide Salz unfiltrierbar wird.“"
                            },
                            {
                                "example_id": "3341d2c1-e002-4a4b-bd97-69124096bf34",
                                "sense_id": "70ed235e-b76f-3815-81d5-c7ceb62f24af",
                                "text": "„Wird die Rheniumsulfidfällung in natrium- oder kaliumhydroxydhaltiger Lösung ausgeführt, so färbt sich die Lösung tiefbraun. Nach einigen Stunden erscheint ein geringfügiger Niederschlag, der praktisch unfiltrierbar ist.“"
                            },
                            {
                                "example_id": "e9a67e35-9520-4c7d-8bf4-9b5914f2c555",
                                "sense_id": "70ed235e-b76f-3815-81d5-c7ceb62f24af",
                                "text": "„Bei Ultrafiltration durch Kollodiumfilter (Bechhold 7½% bei 10–12 Atm.) zeigte sich ein Teil der reduzierenden Substanz des Blutes unfiltrierbar, also kolloidal.“"
                            },
                            {
                                "example_id": "e3513964-f5d5-4242-bd60-97c4dd35c017",
                                "sense_id": "70ed235e-b76f-3815-81d5-c7ceb62f24af",
                                "text": "„Mit einer Zentrifuge lassen sich Klärgrad und Trübung des Bieres sehr präzise und reproduzierbar einstellen. Als Feinstklärer können Zentrifugen sogar den Filtrationsschritt ersetzen. Gute Nachrichten für Craftbrauer, deren oft stark gehopfte und malzhaltige Kreationen bisher als unfiltrierbar galten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
