                        "source_sense_id": "2310bdbf-d742-3a88-81bb-62de2b98e57c",
                        "target_lang_word": "probity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "probity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                                        "entry_id": "69fc911c-570e-3200-9cc9-da8e8a9ef69e",
                                        "glosses": [
                                            "Integrity, especially of the quality of having strong moral principles; decency and honesty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1ded67-d52b-4328-81d0-ead60af68e34",
                                                "sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                                                "text": "[…] they can but bend our hearts to the love of probity and true honour […]"
                                            },
                                            {
                                                "example_id": "ac22aa0e-4b58-452b-9c8f-01fd9f9bde07",
                                                "sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                                                "text": "[W]hen the interests or reputation of their own nation come into collision with those of another, they go to the opposite extreme, and forget their usual probity and candour, in the indulgence of spleen, and an illiberal spirit of ridicule."
                                            },
                                            {
                                                "example_id": "a3c4d4d2-36ca-4531-8ae2-561a6ea29e14",
                                                "sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                                                "text": "Distilled to its essence, it is by no means clear that the ‘Cablegate’ disclosures were intended to support freedom of information, transparency, probity in government, or defence of the public interest."
                                            },
                                            {
                                                "example_id": "061f1c46-79b8-4abe-b16e-414478b075e4",
                                                "sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                                                "text": "The veterans add in their letter, which was partly coordinated by the campaign group Republic: “Officers of the British armed forces must adhere to the very highest standards of probity, honesty and honourable conduct. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b939261-38a7-45c8-b4f0-faaa93fd05cf",
                        "source_entry_id": "d9d28be3-cc0e-3831-9310-74984d959176",
                        "source_sense_id": "2310bdbf-d742-3a88-81bb-62de2b98e57c",
                        "target_lang_word": "integrity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "integrity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "860e4f5a-a6e0-309e-9816-95420a407483",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
                                            "Steadfast adherence to a strict moral or ethical code."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa77af4f-0763-4607-8a79-5dcf58c2ebed",
                                                "sense_id": "860e4f5a-a6e0-309e-9816-95420a407483",
                                                "text": "Stand up, good Canterbury: Thy truth and thy integrity is rooted […]"
                                            },
                                            {
                                                "example_id": "e00ab04b-a1f4-4dc7-ac40-cf43c350f3ec",
                                                "sense_id": "860e4f5a-a6e0-309e-9816-95420a407483",
                                                "text": "Living a lie saps us of integrity and moral cohesion to the point that we can no longer distinguish between the artifice being propped up and the real world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e46980-1b66-3ea4-b9f4-e44ba7520cf4",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
                                            "The state of being wholesome; unimpaired"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc1b4e56-8283-3fd4-9a87-5ddd4c96cad4",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
                                            "The quality or condition of being complete; pure"
                                        ],
