                                "target_word": "makutra",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e8bcd9f6-786e-3888-92b6-dcb44b4e8b99",
                                        "entry_id": "44932ca3-6646-3b47-9a23-8c89306e6a24",
                                        "glosses": [
                                            "duża, ciężka, gliniana lub kamionkowa misa do ucierania różnych składników spożywczych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "628e9ac1-bf01-4e8f-9d3b-cb4ce2cbb472",
                                                "sense_id": "e8bcd9f6-786e-3888-92b6-dcb44b4e8b99",
                                                "text": "Wysuszone siemię rozcierają w makutrze, poczem wyduszają je i przecedzają przez sitko, przez które przechodzi biały płyn, mleko"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
