                                        "glosses": [
                                            "A book of printed sketches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e78808-d0bf-4e41-94f8-c468f5529f69",
                                                "sense_id": "cc07436a-ced7-36de-b8c6-cdefeb2df155",
                                                "text": "This compact sketchbook displays every style of blinds imaginable, from rollers to Romans and from London to Austrian blinds."
                                            },
                                            {
                                                "example_id": "ca0b9b73-faf2-4d27-930b-685280c27ac4",
                                                "sense_id": "cc07436a-ced7-36de-b8c6-cdefeb2df155",
                                                "text": "Since writing the preface for my sketchbook, I have, of course, been involved in a number of more recent projects where I have sketched ideas for structural solutions."
                                            },
                                            {
                                                "example_id": "a8e58f5d-681f-48a0-b381-fc4ad8a61916",
                                                "sense_id": "cc07436a-ced7-36de-b8c6-cdefeb2df155",
                                                "text": "This sketchbook provides an artist's impression in watercolours and drawings of the city's varied past, linked to the buildings and neighbourhoods still here today, as well as a glimpse of some of the beautifully conserved historic settlements on nearby islands."
                                            }
                                        ]
                                    },
