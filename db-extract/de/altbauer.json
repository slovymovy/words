                ],
                "senses": [
                    {
                        "sense_id": "0e572900-910c-3727-8abf-327c9504ad5a",
                        "entry_id": "79b73d7e-08e8-38cd-ace8-98aa9f4dbbb2",
                        "glosses": [
                            "ein sich im Ruhestandsalter befindender Bauer, der seinen Hof zum Teil oder schon ganz an einen Nachfolger (zum Beispiel an den Sohn) übergeben hat (aber den Hof unter Umständen noch mit bewirtschaftet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ec750a-f5e8-4a02-856c-ed1d66d265b3",
                                "sense_id": "0e572900-910c-3727-8abf-327c9504ad5a",
                                "text": "In den europäischen Agrargesellschaften wohnten die Altbauern gewöhnlich auf dem Altenteil."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "413b17a5-2862-38c8-b6c8-13ca43a29d44",
                        "entry_id": "79b73d7e-08e8-38cd-ace8-98aa9f4dbbb2",
                        "glosses": [
                            "Bauer, der bereits vor der Bodenreform in der SBZ 1945 Landwirtschaft betrieben hat"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a447bc54-978b-4abe-b017-4a945c0fb320",
                                "sense_id": "413b17a5-2862-38c8-b6c8-13ca43a29d44",
                                "text": "„Im Vergleich zu den Neubauern ist die Berichterstattung der SBZ/DDR über die Altbauern lückenhaft und sporadisch.“"
                            },
                            {
                                "example_id": "91a0259b-ac2e-4f67-bae7-c06b65dfbafc",
                                "sense_id": "413b17a5-2862-38c8-b6c8-13ca43a29d44",
                                "text": "„Viele Altbauern trauten der fachlichen Kompetenz der Neubauern nicht, von denen ein erheblicher Anteil berufsfremd war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
