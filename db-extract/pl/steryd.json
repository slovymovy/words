                "senses": [
                    {
                        "sense_id": "0c385f6c-086f-383c-916c-2b796f177a7c",
                        "entry_id": "53183826-0589-35c3-8559-cbf2c091849e",
                        "glosses": [
                            "lipid zbudowany z czterech pierścieni węglowych, odpowiedzialny za przepływ krwi, regulujący przemianę materii, zachowania seksualne, przyrost tkanek lub pełniący inną określoną funkcję"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c20af1-8e63-4cbe-876b-1269303d2646",
                                "sense_id": "0c385f6c-086f-383c-916c-2b796f177a7c",
                                "text": "Krótkotrwale, w przypadku zapalenia spojówek, pomagają także sterydy, które należy stosować pod ścisłą kontrolą lekarza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35530cf6-892b-4264-8cee-5066855e0654",
                        "source_entry_id": "53183826-0589-35c3-8559-cbf2c091849e",
                        "source_sense_id": "0c385f6c-086f-383c-916c-2b796f177a7c",
                        "target_lang_word": "steroid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "459ecad5-3316-31f8-b1e0-e77e4b4fa76e",
                                        "entry_id": "eb38bd7d-0781-3c8f-ad6a-c12f5904e987",
                                        "glosses": [
                                            "A class of organic compounds having a structure of 17 carbon atoms arranged in four rings; they are lipids, and occur naturally as sterols, bile acids, adrenal and sex hormones, and some vitamins; many drugs are synthetic steroids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b78110a3-b31a-3ae5-8a21-5b27279c62b7",
                                        "entry_id": "eb38bd7d-0781-3c8f-ad6a-c12f5904e987",
                                        "glosses": [
                                            "Any anabolic hormone used to promote muscle growth or athletic performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7546db-cc2c-467c-ac8e-09fb513ba9e7",
                                                "sense_id": "b78110a3-b31a-3ae5-8a21-5b27279c62b7",
                                                "text": "Men may also have fertility challenges, especially if their hypogonadism was caused by anabolic steroid use. Anabolic steroids can affect testicular health, including reducing the production of sperm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e11be1-7246-4520-92c6-f6e3e3ee89d8",
                        "source_entry_id": "53183826-0589-35c3-8559-cbf2c091849e",
                        "source_sense_id": "0c385f6c-086f-383c-916c-2b796f177a7c",
