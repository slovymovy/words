                                        "entry_id": "4a23f1b8-a9ab-3ad6-bb9a-b9a17d8f9dc5",
                                        "glosses": [
                                            "сменяющий зрелость период жизни, когда происходит постепенное ослабление и угасание организма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b97e2b-df7b-48b7-b12d-3671aa9e50cf",
                                                "sense_id": "4a732f98-e1de-3479-bfcc-6b1948402c9e",
                                                "text": "У старых людей часто руки трясутся от старости."
                                            },
                                            {
                                                "example_id": "ecc5fa94-9148-4cc8-aa91-b7a24fb8d2fd",
                                                "sense_id": "4a732f98-e1de-3479-bfcc-6b1948402c9e",
                                                "text": "С наступлением старости люди могут выйти на пенсию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5061a67a-2acd-33e4-8e50-7be850ea3137",
                                        "entry_id": "4a23f1b8-a9ab-3ad6-bb9a-b9a17d8f9dc5",
                                        "glosses": [
                                            "долговременное существование чего-либо; ветхость, изношенность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14cacfe-310c-4238-88fa-bd17b9ab181a",
                                                "sense_id": "5061a67a-2acd-33e4-8e50-7be850ea3137",
                                                "text": "Покосившийся от старости дом."
                                            },
                                            {
                                                "example_id": "ffd9b3d4-c6b1-4010-a8a1-a1fcd0a88eac",
