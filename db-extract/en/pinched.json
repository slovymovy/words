                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1ba66e-fe26-43a1-afeb-1d4ed299598b",
                                "sense_id": "5642296b-6df0-3253-965e-a47cdf5698e9",
                                "text": "If your sport makes you prone to violent neck motions, you are at risk for a pinched nerve. A pinched nerve occurs when a cervical disc ruptures, and the jellylike material from inside the disc presses on a nerve."
                            }
                        ]
