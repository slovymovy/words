                ],
                "senses": [
                    {
                        "sense_id": "ef34d5b3-ec8a-35ac-aced-d842e71c9e9a",
                        "entry_id": "40df44ad-f4be-3583-956e-28d0b171b20f",
                        "glosses": [
                            "рег. жидкая каша"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e21a61-5a64-437c-a907-3509e0c37d56",
                                "sense_id": "ef34d5b3-ec8a-35ac-aced-d842e71c9e9a",
                                "text": "Я придумал варить кулеш ― пшённую кашу с чем Бог пошлёт: сосиски, колбаса, рыба."
                            }
                        ]
                    },
                    {
                        "sense_id": "db64514c-4221-38f3-8f36-92daf1b1f6a4",
                        "entry_id": "40df44ad-f4be-3583-956e-28d0b171b20f",
                        "glosses": [
                            "рег. крупяная похлёбка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95c557a-557d-4e69-808b-8e926e320e55",
                                "sense_id": "db64514c-4221-38f3-8f36-92daf1b1f6a4",
                                "text": "Он ел свой любимый суп ― гречневый кулеш с картошкой и вспомнил свои детские слёзы, когда ходил весенней ночью в Киеве, а звёзды проглядывали меж цветущих каштанов."
                            }
                        ]
                    }
                ],
