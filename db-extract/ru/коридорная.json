                "senses": [
                    {
                        "sense_id": "cf27add0-d495-3dde-8091-f2be5d8f8de7",
                        "entry_id": "2829ad5a-e124-30eb-af5e-93125d93f9ba",
                        "glosses": [
                            "разг. женск. к коридорный; та, кто обслуживает ряд номеров в гостинице"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade2e5a2-7159-4ddc-8d9b-d09747eb0bbd",
                                "sense_id": "cf27add0-d495-3dde-8091-f2be5d8f8de7",
                                "text": "Вошла коридорная поменять постель и принесла воду."
                            },
                            {
                                "example_id": "e300e718-217f-47d5-bbee-7827f8039bd8",
                                "sense_id": "cf27add0-d495-3dde-8091-f2be5d8f8de7",
                                "text": "Коридорная указала мне мою кровать в четырёхместной комнате."
                            },
                            {
                                "example_id": "8ef42e94-46c0-4cc0-a857-80de610d50bd",
                                "sense_id": "cf27add0-d495-3dde-8091-f2be5d8f8de7",
                                "text": "При этом коридорная Эволюция Поликарповна улыбается мне самым нежнейшим способом .."
                            },
                            {
                                "example_id": "5d31b226-3918-48e2-bc2e-2a4c50833222",
                                "sense_id": "cf27add0-d495-3dde-8091-f2be5d8f8de7",
                                "text": "Оказывается, бухгалтера накрыли в ставропольском привокзальном ресторане с неизвестной женщиной, которая после допроса созналась, что она коридорная краснодарского Дома колхозников."
                            }
                        ]
                    }
