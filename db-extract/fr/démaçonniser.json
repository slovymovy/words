                "senses": [
                    {
                        "sense_id": "b14d6ee0-a387-3e54-81dc-09f34a7657a0",
                        "entry_id": "c9f2b4db-ec14-3964-91e3-fd1545576fbe",
                        "glosses": [
                            "Faire perdre son caractère franc-maçon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16c44050-f9da-4367-8cf9-9cb458921952",
                                "sense_id": "b14d6ee0-a387-3e54-81dc-09f34a7657a0",
                                "text": "Ce n'est pas moi qui te « démaçonnise », ni personne d'autre parce qu'il y a bien longtemps que tu t'es « démaçonnisé » toi-même."
                            },
                            {
                                "example_id": "b19578a2-dc91-4aee-ab74-3c5cf78954c5",
                                "sense_id": "b14d6ee0-a387-3e54-81dc-09f34a7657a0",
                                "text": "Les Protocoles comme texte démaçonnisé."
                            },
                            {
                                "example_id": "36162ec7-1d94-424b-8220-b914610a18e1",
                                "sense_id": "b14d6ee0-a387-3e54-81dc-09f34a7657a0",
                                "text": "Pour cela, en amont, il faut démaçonniser car tout vient de là quand même."
                            }
                        ]
                    }
