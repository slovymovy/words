                "forms": [],
                "senses": [
                    {
                        "sense_id": "a229c4be-ba89-3ad7-b466-82b3253ebfeb",
                        "entry_id": "b78964a7-850a-3f09-b27e-f759ccc4c103",
                        "glosses": [
                            "zeer goed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26075652-2266-4762-bda9-10aa4df85308",
                                "sense_id": "a229c4be-ba89-3ad7-b466-82b3253ebfeb",
                                "text": "Het was gewoon geen denderende wedstrijd. Ik wil altijd het beste in mezelf naar boven halen, maar dat is me deze Premier League nog niet echt gelukt."
                            },
                            {
                                "example_id": "4012ff05-ea76-4862-a413-0d999b86bbcc",
                                "sense_id": "a229c4be-ba89-3ad7-b466-82b3253ebfeb",
                                "text": "Stefan Küng heeft met een denderende tijdrit de macht gegrepen in de BinckBank Tour. De 24-jarige Zwitser van BMC won in Venray de race tegen de klok over 12,7 kilometer met groot machtsvertoon en neemt hierdoor de leiderstrui over van Nederlander Fabio Jakobsen."
                            },
                            {
                                "example_id": "5722eac7-a433-4182-876e-600b3e59591f",
                                "sense_id": "a229c4be-ba89-3ad7-b466-82b3253ebfeb",
                                "text": "'Er zit me nog iets dwars, Jeroen. Om je de waarheid te zeggen, spookt dit al heel lang door mijn hoofd. ' Niet bepaald een denderende opening, dacht ze."
                            }
                        ]
                    }
                ],
