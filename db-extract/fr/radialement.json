                "forms": [],
                "senses": [
                    {
                        "sense_id": "7e623b31-0d8f-3eff-af08-17cdcf6d5a21",
                        "entry_id": "55d5a892-fb9d-3664-8c78-0b987364b6c8",
                        "glosses": [
                            "En manière de rayons, de branches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794f146f-2642-4f24-bef0-e29c64abf6e0",
                                "sense_id": "7e623b31-0d8f-3eff-af08-17cdcf6d5a21",
                                "text": "Les trois faisceaux basilaires [des carpelles] opposés aux cloisons se divisent radialement comme ceux qui sont opposés aux loges."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfd1ce28-15dd-3167-972a-ae3954f0047e",
                        "entry_id": "55d5a892-fb9d-3664-8c78-0b987364b6c8",
                        "glosses": [
                            "Dans le sens du rayon d'un cercle ou d'un cylindre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9417cb84-afdf-409d-8ef1-894af2bbb32d",
                                "sense_id": "bfd1ce28-15dd-3167-972a-ae3954f0047e",
                                "text": "La conduite principale est constituée d'un tuyau Bonna en béton précontraint radialement et longitudinalement de 35 km dont 3 km en aérien pour franchir les marigots ; les tuyaux sont fabriqués sur place par centrifugation et essayés à des pressions variant de 4 à 9 kg/cm2."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63e345cb-cfea-4d19-8028-3da43d74eaf1",
                        "source_entry_id": "55d5a892-fb9d-3664-8c78-0b987364b6c8",
                        "target_lang_word": "radialmente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4698921a-a108-4d3b-bd69-c89e699d9823",
                        "source_entry_id": "55d5a892-fb9d-3664-8c78-0b987364b6c8",
                        "target_lang_word": "радиально",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "радиально",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0597426f-1536-311a-9193-d3c8fb594dfa",
                                        "entry_id": "88b0fc2e-a98e-3fe1-8798-d9990aac1943",
                                        "glosses": [
                                            "матем., техн. наречие к радиальный; с направлением по радиусу, вдоль радиуса (радиусов)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8d327a-43d6-45ff-ab89-29b9f0c94693",
                                                "sense_id": "0597426f-1536-311a-9193-d3c8fb594dfa",
                                                "text": "Цепи горных хребтов… на существующих картах и схемах радиально, как лучи, расходятся из этого неизвестного участка."
                                            },
                                            {
                                                "example_id": "205732a5-ba48-4568-8f84-1d95997bb4ae",
                                                "sense_id": "0597426f-1536-311a-9193-d3c8fb594dfa",
                                                "text": "Если эта поверхность вогнутая, то возникают радиально сходящиеся лучистые минеральные агрегаты, а если выпуклая — радиально расходящиеся игольчатые или столбчатые кристаллические массы."
                                            },
                                            {
                                                "example_id": "df0e73a8-b9ca-4619-9f5b-bb193f63afeb",
                                                "sense_id": "0597426f-1536-311a-9193-d3c8fb594dfa",
                                                "text": "На земле ровная и гладкая подстилка из тёмных коричневых игл, слежавшихся в плотный пружинящий войлок, по сторонам берёзки или иные деревца, сверху над головой радиально разбегающиеся чёрные еловые ветви."
                                            },
                                            {
                                                "example_id": "ea198ea4-fba4-4b49-bdf4-7f93bd9e39a2",
                                                "sense_id": "0597426f-1536-311a-9193-d3c8fb594dfa",
                                                "text": "Дольчатое строение печени хорошо выражено, в центре долек располагаются центральные вены, к которым радиально сходятся печёночные балки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
