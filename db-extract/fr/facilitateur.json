                                                "sense_id": "86a4409b-dffa-3840-b2fb-7f36e72bf842",
                                                "text": "The computer is an essential enabler of the conversation."
                                            },
                                            {
                                                "example_id": "d2a3c5d9-d4fe-473a-bb2a-e027caf602c6",
                                                "sense_id": "86a4409b-dffa-3840-b2fb-7f36e72bf842",
                                                "text": "The introduction of 33 bi-mode trains from 2023 will be an enabler for electrification of the Midland Main Line, claims East Midlands Railway Commercial Director Chris Wright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9535cf6-c592-39d5-b010-9d30c7a187d1",
                                        "entry_id": "46d163d0-9430-3c92-9d0c-508550e0c248",
                                        "glosses": [
                                            "One who encourages a bad habit in another (typically drug addiction) by their behavior."
                                        ],
                                        "tags": [],
