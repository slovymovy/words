                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "printing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый крупный формат бумаги, обычно размером 23 на 28 дюймов.",
                        "zh": "一种特定的纸张大尺寸规格，通常为23英寸乘28英寸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элефант",
                                "target_lang_sense_clarification": "формат бумаги"
                            }
                        ],
                        "zh": []
                    }
                },
                {
                    "sense_id": "1c6c13a6-1378-3339-9d7a-f9efe5885a81",
                    "sense_definition": "The hard white substance from the tusks of an elephant; ivory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient king received tributes of gold and <w>elephant</w>.",
                            "target_lang_translations": {
                                "ru": "Древний царь получал дань золотом и <w>слоновой костью</w>.",
                                "zh": "古代国王收到了黄金和<w>象牙</w>作为贡品。"
                            }
                        },
                        {
                            "text": "The handle of the dagger was carved from pure <w>elephant</w>.",
                            "target_lang_translations": {
                                "ru": "Рукоять кинжала была вырезана из чистой <w>слоновой кости</w>.",
                                "zh": "这把匕首的柄是用纯<w>象牙</w>雕刻而成的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое белое вещество из бивней слона; слоновая кость.",
                        "zh": "从大象牙齿中提取的坚硬白色物质；象牙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоновая кость",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象牙",
                                "target_lang_sense_clarification": "作为材料的名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8eb4a2fb-a7c1-3b71-b3f7-9e540696a9af",
                    "sense_definition": "A playing piece in the Chinese board game Xiangqi that moves diagonally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this version of the game, the <w>elephant</w> cannot cross the river.",
                            "target_lang_translations": {
                                "ru": "В этой версии игры <w>слон</w> не может пересечь реку.",
                                "zh": "在这个版本的游戏中，<w>象</w>不能过河。"
                            }
                        },
                        {
                            "text": "She used her <w>elephant</w> to defend the general from attack.",
                            "target_lang_translations": {
                                "ru": "Она использовала своего <w>слона</w>, чтобы защитить генерала от атаки.",
                                "zh": "她用她的<w>象</w>保护将军免受攻击。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фигура в китайской настольной игре Сянци, которая ходит по диагонали.",
                        "zh": "中国象棋中的一种棋子，走法为斜向移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слон",
                                "target_lang_sense_clarification": "фигура в сянци"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象",
                                "target_lang_sense_clarification": "象棋棋子名称"
                            },
                            {
                                "target_lang_word": "相",
                                "target_lang_sense_clarification": "象棋棋子名称（红方）"
                            }
                        ]
                    }
                }
            ]
