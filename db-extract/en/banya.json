                "senses": [
                    {
                        "sense_id": "d8fd4287-acac-32d4-93ff-03bf60644795",
                        "entry_id": "5e26c593-2ae3-3b93-aadb-c556aba7aa1e",
                        "glosses": [
                            "A type of steam bath, popular in Russia (and in some parts of Alaska as well)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b14de81-2155-4d7a-b23c-23839411d59a",
                                "sense_id": "d8fd4287-acac-32d4-93ff-03bf60644795",
                                "text": "The Russian public steam bath (banya) is a cultural hybrid which borrows freely from the Finnish sauna and the Turkish political detention centre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeb039b6-786b-46bb-99a7-393405283b2a",
                        "source_entry_id": "5e26c593-2ae3-3b93-aadb-c556aba7aa1e",
                        "source_sense_id": "d8fd4287-acac-32d4-93ff-03bf60644795",
                        "source_sense_description": "a Russian steam bath",
                        "target_lang_word": "banja",
