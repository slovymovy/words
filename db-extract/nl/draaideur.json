                        "entry_id": "91210502-cb2b-3f8a-9134-8679f663636a",
                        "glosses": [
                            "constructie van drie of vier deurbladen die rondom een gezamenlijke verticale as kunnen draaien, ter vervanging van een gewone deur m.n. gebruikt in winkels, ziekenhuizen enz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8e5571-3608-4c67-8c83-31c61a578f6a",
                                "sense_id": "aea9b85a-a983-35b4-9f9f-5fb2fc473235",
                                "text": "De draaideur is zowel links- als rechtdraaiend te plaatsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ee2b8c6-7122-3a38-b3a7-8f17442bb491",
                        "entry_id": "91210502-cb2b-3f8a-9134-8679f663636a",
