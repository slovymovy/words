                                        "entry_id": "93037b16-09d2-31bf-aa14-d024fc1c073e",
                                        "glosses": [
                                            "tömbeki denilen bir cins tütünü ısıtıp suyla filtreledikten sonra tütünün içilmesine yarayan alet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d44877-6faf-42c8-ad12-9598e9f8fb5c",
                                                "sense_id": "aedfd208-edfe-3030-94f2-9b8622ddd709",
                                                "text": "Köprü üstündeki gazinolardan birine gidip bir nargile tellendirmek istedim."
                                            }
                                        ]
