                        "glosses": [
                            "dotyczący zdjęcia (obrazu utrwalonego aparatem fotograficznym)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47224fda-2a6b-4791-944f-ae5015ef1979",
                                "sense_id": "a2cb4a67-b429-309a-8985-547a78672a4c",
                                "text": "Również portretowane przez Siniskę kobiety miały ochotę nanieść poprawki na swoje zdjęciowe wizerunki, a połączenie fotografii z obrazem zawsze daje takie możliwości."
                            }
                        ],
