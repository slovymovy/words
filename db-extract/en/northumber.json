                        "glosses": [
                            "A Northumbrian."
                        ],
                        "tags": [
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "cfb8cfac-3be9-4c02-9caf-8b4e5e1f8ff0",
                                "sense_id": "b1892c89-f390-337b-81c5-ca9ec2a08261",
                                "text": "From this monastery, all the churches of Bernicia, or the northern part of the kingdom of the Northumbers from the Tine to the Firth of Edinburgh, had their beginning ; as had some also of those of the Deïri, who inhabited the southern part of the same kingdom from the Tine to the Humber."
                            },
                            {
                                "example_id": "3d970ec0-cff9-4887-8510-98c5c7ecac3d",
                                "sense_id": "b1892c89-f390-337b-81c5-ca9ec2a08261",
                                "text": "Some years after Alla's reign, when Ethelfred was king of the Northumbers, he made war with the British Christians that inhabited Wales, and was the author of that terrible slaughter of the monks of Bangor."
                            },
                            {
                                "example_id": "546b9f55-4b12-429a-9782-d761d76de1c6",
                                "sense_id": "b1892c89-f390-337b-81c5-ca9ec2a08261",
                                "text": "All our historians agree that Oswald was a man of much piety, and of an amiable disposition. By his valour he united the kingdoms of Bernicia, and Deira, and made himself sole monarch over all the Northumbers."
                            }
                        ]
                    }
