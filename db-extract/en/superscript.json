                        "cross_references": []
                    },
                    {
                        "translation_id": "c9670150-5f02-4372-af2d-eb9c7debef0d",
                        "source_entry_id": "3310d8c1-4008-3b5d-a2d1-8b0934d44db8",
                        "source_sense_id": "146937a2-8ebe-3400-99e1-05b4f8431c8d",
                        "source_sense_description": "a type of lettering form",
                        "target_lang_word": "exposant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74b8162f-bc11-33d5-84bd-1c8dcf911ae9",
                                        "entry_id": "7e641ef0-b590-3774-b22c-c046974f1dda",
                                        "glosses": [
                                            "Personne qui expose des ouvrages d’art, des produits agricoles, industriels, des objets de trafic, pour les soumettre au jugement du public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "909eac83-776b-483c-ac2e-405dc7974365",
                                                "sense_id": "74b8162f-bc11-33d5-84bd-1c8dcf911ae9",
                                                "text": "Les exposants furent très nombreux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d493ad8-8838-3e8a-87a8-cbd92e8e4a83",
                                        "entry_id": "7e641ef0-b590-3774-b22c-c046974f1dda",
                                        "glosses": [
                                            "Personne qui expose un fait, qui expose ses droits, ses prétentions dans une requête ou dans tout autre acte semblable."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b20d0d-d4ee-405d-82d6-3bf6298c2d78",
                                                "sense_id": "0d493ad8-8838-3e8a-87a8-cbd92e8e4a83",
                                                "text": "Les raisons de l’exposant, de l’exposante sont…"
                                            },
                                            {
                                                "example_id": "d576abcd-cc70-47d8-b326-fa971cb2b0a0",
                                                "sense_id": "0d493ad8-8838-3e8a-87a8-cbd92e8e4a83",
                                                "text": "Les preuves et les titres de l’exposant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b21ac26-0016-38c1-8c48-dfd5c7dd3412",
                                        "entry_id": "05df6479-e67a-3a5d-853a-50c6c6532a17",
                                        "glosses": [
                                            "Nombre qui exprime le degré d’une puissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c46d4db7-8c41-4ef1-a22d-ec1326dfebe9",
                                                "sense_id": "2b21ac26-0016-38c1-8c48-dfd5c7dd3412",
                                                "text": "Deux est l’exposant du carré, trois est celui du cube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea8ca74-f1f5-37cd-9c3a-cbe1524f54d2",
                                        "entry_id": "05df6479-e67a-3a5d-853a-50c6c6532a17",
                                        "glosses": [
                                            "Notation supérieure à droite, de moindre corps, symétrique de l’indice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714c8645-91c4-4c85-a157-8a49dcfaab62",
                                                "sense_id": "3ea8ca74-f1f5-37cd-9c3a-cbe1524f54d2",
                                                "text": "En chimie, la charge d’un ion est écrit en exposant comme ceci : Fe²⁺ pour les ions ferreux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12ebb1a2-3e32-3d00-8f1a-f9e2abc40023",
                                        "entry_id": "51f5cfdb-37a4-3c7d-bd88-a4f53d52078a",
                                        "glosses": [
                                            "Participe présent de exposer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b40025-162c-4198-b70b-5cbf4485d411",
                                                "sense_id": "12ebb1a2-3e32-3d00-8f1a-f9e2abc40023",
                                                "text": "En été, elles se dessèchent et se crevassent, et les premières pluies de l’automne font couler dans les fentes les couches superficielles délayées, exposant ainsi des terrains toujours nouveaux à la surface."
                                            },
                                            {
                                                "example_id": "5fc1da03-90fb-48a0-9f1b-bb17fd845786",
                                                "sense_id": "12ebb1a2-3e32-3d00-8f1a-f9e2abc40023",
                                                "text": "Et elle se montre en minaudant, en s’exposant comme un beau fruit magnifiquement dressé dans l’étalage d’un marchand de comestibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
