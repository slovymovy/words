                        "target_lang_word": "schlendern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlendern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                                        "entry_id": "1190f2a4-2562-3994-b955-8f0fcdb456ee",
                                        "glosses": [
                                            "ohne bestimmtes Ziel locker und langsam umhergehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c505820c-714d-4ae7-9524-e670b431487b",
                                                "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                                                "text": "Ich schlenderte durch den Park, bis es Abend wurde."
                                            },
                                            {
                                                "example_id": "75da45af-6053-4ead-a466-2ec6305f4a94",
                                                "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                                                "text": "„Bald werden wir im Sonnenschein durch Fußgängerzonen schlendern und in den Schaufenstern nach Sonderangeboten suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c318b1f6-0257-4d32-8c5e-ffe21a7d95e8",
                        "source_entry_id": "0daf809e-7a27-3aa9-89f2-e91b22a9cc92",
                        "source_sense_description": "to walk in a carefree manner",
                        "target_lang_word": "flanieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flanieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                        "entry_id": "9ec497d1-1ab5-39b4-94bc-02c6f050193a",
                                        "glosses": [
                                            "langsam, ohne besonderes Ziel umherschlendern"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42b9eb62-fc22-4155-8db5-9521520db982",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "„Wenn er, den hellen runden Hut auf den schwarzen Locken zurückgesetzt, die Hände in den Hosentaschen, durch die Straßen flanierte, warfen ihm die Mädchen verliebte Blicke zu.“"
                                            },
                                            {
                                                "example_id": "3f8dd58c-2adb-429f-b5bd-9990dfe03ad6",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "„In deutschen und anderen europäischen Städten kann man flanieren: Man schlendert ohne Eile, verweilt hier und da, um etwas genauer zu betrachten.“"
                                            },
                                            {
                                                "example_id": "63f368a7-19f9-4062-8700-b84c2aa8f422",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "„Ich flanierte in der wiederaufgebauten Altstadt, ging in jede Kirche, spazierte im Park.“"
                                            },
                                            {
                                                "example_id": "a911389f-e00b-4632-a3a8-f5f07ab0c233",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "„Wir flanierten über den berühmten Marienplatz“ […]."
                                            },
                                            {
                                                "example_id": "158afe51-4a56-4ff8-a4f5-7966ddc6b1eb",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "[Über die Kirschblütenzeit] „Mit den ersten offenen Blüten in diesem Jahr flanieren endlich auch wieder die ersten Touristen durch die Straßen der Altstadt.“"
                                            },
                                            {
                                                "example_id": "dea1b3b3-1d3d-46bc-8fe2-bec5043339e9",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "„Es durftet nach Glühwein, nach Zimt und gebrannten Mandeln. In den Gassen flanieren die Menschen entspannt an den frei zugänglichen Buden vorbei.“"
                                            },
                                            {
                                                "example_id": "313ee279-4923-46cf-b4e7-51bebabad430",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "[Coronapandemie 2021] „Nur samstags konnte die genervte Schülerin kurz ausgehen, mit ihren Freundinnen auf der Promenade flanieren.“"
                                            },
                                            {
                                                "example_id": "716db49d-5c90-4706-8b6a-d05ba239ebcb",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "„Flaniert man anschließend durch den Laden, lässt sich entspannt entdecken, was Michelle, Jillian und Oliver“ […] „weltweit an Schönem und Praktischem gefunden haben:“ […]."
                                            },
                                            {
                                                "example_id": "9525827f-12bb-4394-a229-b8e45536ddf3",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "[Über die Weimarer Republik] „Während mondäne Damen des Großbürgertums mit Fellstolas auf dem Ku'damm flanierten, hungerten ganze Familien in den engen Wohnungen der Arbeiterviertel.“"
                                            },
                                            {
                                                "example_id": "75770200-5191-4857-83fc-aefd5ca57ee2",
                                                "sense_id": "0ae5636c-7d52-3cba-9474-7ffa6a3b41ef",
                                                "text": "[Coronapandemie in den USA 2020] „Auch in Ocean City ist die Mehrheit der Menschen, die am Mittwoch zwischen Strand und Souvenirläden flanieren, ohne Maske unterwegs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
