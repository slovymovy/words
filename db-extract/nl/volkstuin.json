                                    {
                                        "sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                                        "entry_id": "48561a24-1baa-33de-89ee-12249e309a92",
                                        "glosses": [
                                            "vergleichsweise kleiner Garten, der nicht direkt bei der Wohnung/dem Haus liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "748fcbd0-189b-44f3-a471-7bd13c1c2e5b",
                                                "sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                                                "text": "„Einem Hobbygärtner waren zwei Dinge aufgefallen, die sich in seinem Kleingarten verändert hatten.“"
                                            },
                                            {
                                                "example_id": "be97b0ab-2940-460f-b7f8-9c991afec151",
                                                "sense_id": "b57cf531-c420-3933-ba90-ec01c73f3220",
                                                "text": "„Im Februar 1916 kam eine Zentralstelle für den Gemüseanbau in Kleingärten hinzu - ein weiteres Feld, das dringend der Regelung bedurfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94021f6f-0bb6-4c25-a42a-5d6b1f19387b",
                        "source_entry_id": "af818a69-6675-3430-a9e9-a5beca6f7207",
                        "source_sense_id": "a9e0c20c-b6f9-39bb-86e5-c9ad49a94037",
                        "source_sense_description": "moestuin beschikbaar gesteld aan stadsbewoners",
                        "target_lang_word": "Schrebergarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrebergarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d18b7201-ef2b-3e06-b8f2-6c3bf4a48019",
                                        "entry_id": "8022b238-55bb-3888-9415-6566a16d94cc",
                                        "glosses": [
                                            "ein kleiner Garten innerhalb einer Gartenanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df9adb5-a576-40ab-ac16-45f1f176cd55",
                                                "sense_id": "d18b7201-ef2b-3e06-b8f2-6c3bf4a48019",
                                                "text": "Im Schrebergarten werden auch gemeinsame Grillfeiern gemacht."
                                            },
                                            {
                                                "example_id": "7bed021b-327f-4f96-a89b-ebcf111af2c3",
                                                "sense_id": "d18b7201-ef2b-3e06-b8f2-6c3bf4a48019",
                                                "text": "Schrebergärten dienen der Erholung von Stadtmenschen."
                                            },
                                            {
                                                "example_id": "4481e44e-34ac-45ba-b8ac-78bbc9aa8d47",
                                                "sense_id": "d18b7201-ef2b-3e06-b8f2-6c3bf4a48019",
                                                "text": "In jedem Schrebergarten befindet sich eine Gartenlaube."
                                            },
                                            {
                                                "example_id": "de8e233b-2397-46a9-8dc6-ddc123af55fe",
                                                "sense_id": "d18b7201-ef2b-3e06-b8f2-6c3bf4a48019",
                                                "text": "„Neben den Schrebergärten, in denen ohnehin schon fast immer Gemüse angebaut worden war, richtete man auf brachliegendem städtischem Land »Kriegsgärten« ein, die jeweils für wenig Geld verpachtet wurden - an bedürftige Familien sogar ganz umsonst.“"
                                            },
                                            {
                                                "example_id": "bcde3e94-0b53-4ff9-b774-39e912ed2c79",
                                                "sense_id": "d18b7201-ef2b-3e06-b8f2-6c3bf4a48019",
                                                "text": "„Kaum hat er seinen Schrebergarten in mühseliger Arbeit mit Wasser versorgt, fängt es an zu regnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a954ed6-1cfd-4a70-84fc-292dd14cc328",
                        "source_entry_id": "af818a69-6675-3430-a9e9-a5beca6f7207",
                        "source_sense_id": "a9e0c20c-b6f9-39bb-86e5-c9ad49a94037",
