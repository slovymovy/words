                "senses": [
                    {
                        "sense_id": "bd13bd4f-b52a-389e-81d8-f7de7fc19117",
                        "entry_id": "642973e7-d002-34f8-b665-c75d841a145e",
                        "glosses": [
                            "aus Frankreich stammender erotischer Tanz im 2/4-Takt, bei dem die Tänzerinnen ihre Beine hochwerfen, so dass man die Unterwäsche sehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347a4902-7486-4db8-bfb6-e68f3f128006",
                                "sense_id": "bd13bd4f-b52a-389e-81d8-f7de7fc19117",
                                "text": "„Sie hob die Beine wie beim Cancan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1f092b-116c-40ec-825d-dffb4038dae4",
                        "source_entry_id": "642973e7-d002-34f8-b665-c75d841a145e",
                        "source_sense_id": "bd13bd4f-b52a-389e-81d8-f7de7fc19117",
                        "source_sense_description": "erotischer Tanz im 2/4-Takt, bei dem die Tänzerinnen ihre Beine hochwerfen",
                        "target_lang_word": "cancan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cancan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82bed2ef-4dd3-30dc-9129-a430e0c24fe6",
                                        "entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                                        "glosses": [
                                            "A high-kicking chorus line dance originating in France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b644441-56b8-4c37-aa2a-fe0c4143adff",
                                                "sense_id": "82bed2ef-4dd3-30dc-9129-a430e0c24fe6",
                                                "text": "They formed up, in perfect silence, in two lines, facing each other between us and the fire, and then the dance - a sort of infernal and fiendish cancan - began."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fdc174c-2b03-3c5c-9fdc-42e18d3cac5f",
                                        "entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                                        "glosses": [
                                            "A trick where one leg is brought over the seat, so that both legs are on one side."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cancan",
