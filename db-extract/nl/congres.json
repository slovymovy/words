                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "504fd1bd-329f-3543-86ff-eef3d9bcbee3",
                                        "entry_id": "a252cd7b-1385-3db4-a95b-d07ec4ee4b03",
                                        "glosses": [
                                            "Coitus; sexual intercourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ac64b5-0a5c-410e-b902-e0af33794432",
                                                "sense_id": "504fd1bd-329f-3543-86ff-eef3d9bcbee3",
                                                "text": "Welsh ponies, I learn from a man who has had much experience with these animals, habitually produce erections and emissions in their stalls; they do not bring their hind quarters up during this process, and they close their eyes, which does not take place when they have congress with mares."
                                            },
                                            {
                                                "example_id": "19a0a8ca-6d13-40b2-a657-c62fd96d2cbc",
                                                "sense_id": "504fd1bd-329f-3543-86ff-eef3d9bcbee3",
                                                "text": "Not three weeks before this he was run out of Fort Smith Arkansas for having congress with a goat. Yes lady, that is what I said. Goat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335cfa21-1323-3e6c-b82d-f7346f552f9d",
                                        "entry_id": "a252cd7b-1385-3db4-a95b-d07ec4ee4b03",
                                        "glosses": [
                                            "A group of baboons; the collective noun for baboons."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c284b61-7a4a-430e-990a-e114f1dd14a5",
                                                "sense_id": "335cfa21-1323-3e6c-b82d-f7346f552f9d",
                                                "text": "[…] the council hall stank like a congress of baboons."
                                            },
                                            {
                                                "example_id": "6bca3b2b-a5ac-41fb-b5d4-c1412d3496be",
                                                "sense_id": "335cfa21-1323-3e6c-b82d-f7346f552f9d",
                                                "text": "2013, Dick Hrebik, Walter Goes to War—WWII, Rolling Meadows, IL: Windy City Publishers, Chapter 7, p. 133,\nSaw a congress of baboons of all sizes making their way to a mountaintop to spend the night on the rocks and trees there."
