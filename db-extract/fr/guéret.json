                        "entry_id": "f3c0694a-7067-3bef-957d-91ee3faaa464",
                        "glosses": [
                            "Ville et chef-lieu de département située dans le département de la Creuse, en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6eabe15-63fd-4183-b7aa-867473b80297",
                                "sense_id": "8ca3f304-bb9f-3f00-ac53-99ac6a8bd0f1",
                                "text": "Guéret est trop isolé des montagnes qui l’entourent, et n’a rien en lui qui compense l’éloignement de ce décor naturel. L’eau y est belle et claire ; voilà tout."
                            }
                        ]
                    }
