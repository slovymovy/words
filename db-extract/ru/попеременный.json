                                    {
                                        "sense_id": "e75ef525-8217-3c7b-93a3-5908b32a710d",
                                        "entry_id": "a136d15d-0260-313d-be24-cd5eb54a4f2f",
                                        "glosses": [
                                            "Happening by turns; one following the other in succession of time or place; first one and then the other (repeatedly)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc1df06-0c7e-45f1-9196-e0de419bb1f7",
                                                "sense_id": "e75ef525-8217-3c7b-93a3-5908b32a710d",
                                                "text": "And bid alternate passions fall and rise"
                                            },
                                            {
                                                "example_id": "1f57bb26-8ff1-4df4-980a-f7dc57c895e1",
                                                "sense_id": "e75ef525-8217-3c7b-93a3-5908b32a710d",
                                                "text": "One of the two boxes displaced by the new Pelaw installation will be Springwell, between Boldon Colliery and Pelaw, which has recently had the distinction of being manned by a husband and wife on alternate shifts."
                                            },
                                            {
                                                "example_id": "e566979b-393d-4e20-b4aa-fcef3d9960af",
                                                "sense_id": "e75ef525-8217-3c7b-93a3-5908b32a710d",
                                                "text": "The service is half-hourly as far as Harrogate and Knaresborough, with alternate trains going on to York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e6be03-de65-322f-a678-7826a26fa16f",
                                        "entry_id": "a136d15d-0260-313d-be24-cd5eb54a4f2f",
                                        "glosses": [
                                            "Happening by turns; one following the other in succession of time or place; first one and then the other (repeatedly).",
                                            "Alternating; (of e.g. a pair of tinctures which a charge is coloured) succeeding in turns, or (relative to the field) counterchanged."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf2560d-e8c0-4f69-aef9-a2eb01d35b4e",
                                                "sense_id": "96e6be03-de65-322f-a678-7826a26fa16f",
                                                "text": "Goldschmidt (Austria; creation July 27, 1862): [...] party, argent and gules, an eagle of alternate colors, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34cdffe5-aa74-378f-9bac-5f44f6fae44b",
                                        "entry_id": "a136d15d-0260-313d-be24-cd5eb54a4f2f",
                                        "glosses": [
                                            "Designating the members in a series, which regularly intervene between the members of another series, as the odd or even numbers of the numerals; every other; every second."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a943241-aa86-4965-9fc1-a09caf93ab8d",
                                                "sense_id": "34cdffe5-aa74-378f-9bac-5f44f6fae44b",
                                                "text": "the alternate members 1, 3, 5, 7, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8559dafd-4375-3760-81e1-3b1632b75fa9",
                                        "entry_id": "a136d15d-0260-313d-be24-cd5eb54a4f2f",
                                        "glosses": [
                                            "Other; alternative."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1d7436-a347-4971-b388-ad30c6ff7bdb",
                                                "sense_id": "8559dafd-4375-3760-81e1-3b1632b75fa9",
                                                "text": "Hyperlinked text is displayed in alternate color in a Web browser."
                                            },
                                            {
                                                "example_id": "30a690d7-1b1d-4144-a7ae-87f00d189bfe",
                                                "sense_id": "8559dafd-4375-3760-81e1-3b1632b75fa9",
                                                "text": "He lives in an alternate universe and an alternate reality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfbf3342-bc2b-3a84-a2bb-99af4d44ec32",
                                        "entry_id": "a136d15d-0260-313d-be24-cd5eb54a4f2f",
                                        "glosses": [
                                            "Distributed singly at different heights of the stem, and at equal intervals as respects angular divergence"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36cba16a-36ee-4939-a97c-f7912c3721eb",
                                                "sense_id": "cfbf3342-bc2b-3a84-a2bb-99af4d44ec32",
                                                "text": "Many trees have alternate leaf arrangement (e.g. birch, oak and mulberry)."
                                            }
                                        ]
                                    }
                                ]
                            },
