                                                "example_id": "83261f30-2063-4b73-a7f6-ac838ec2af62",
                                                "sense_id": "bcbb5153-a6dd-37da-b888-148b32a0b9ba",
                                                "text": "The innermore walls were sod inlayed with roots from trees, plants and weeds."
                                            }
