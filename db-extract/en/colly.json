                "senses": [
                    {
                        "sense_id": "1cd0d335-cd1f-37f0-91a0-41d9b4f5d751",
                        "entry_id": "de6dbd1d-64d2-348f-a030-95e12f67542c",
                        "glosses": [
                            "To make black, as with coal."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b33798f9-51df-46a6-9880-c6f20333ab3e",
                                "sense_id": "1cd0d335-cd1f-37f0-91a0-41d9b4f5d751",
                                "text": "Brief as the lighting in the collied night."
                            },
                            {
                                "example_id": "37ab0ef7-94cd-4fd4-95f6-3cccbdd312de",
                                "sense_id": "1cd0d335-cd1f-37f0-91a0-41d9b4f5d751",
                                "text": "Not as I could find i' my heart to let him stay i' the coal-hole more nor a minute, but it was enough to colly him all over. . . ."
                            },
                            {
                                "example_id": "8f91313b-d545-418b-9447-2026080b7759",
                                "sense_id": "1cd0d335-cd1f-37f0-91a0-41d9b4f5d751",
                                "text": "Thou hast not collied thy face enough, stinkard"
                            }
                        ]
                    }
                ],
