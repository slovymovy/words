                    {
                        "sense_id": "c2f0a828-8ddd-3a6a-b831-821a73954934",
                        "entry_id": "1cccc2e3-cfa5-3c8e-b007-bf483db5577c",
                        "glosses": [
                            "Celle qui finit deuxième d’un tournoi ou d’une compétition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f1420b-71e7-401a-a3bd-cc8764160270",
                                "sense_id": "c2f0a828-8ddd-3a6a-b831-821a73954934",
                                "text": "Les deux Français engagés mardi, Madeleine Malonga (photo), pourtant vice-championne olympique en moins de 78 kg, et le jeune Kenny Liveze en moins de 100 kg, ont été éliminés au deuxième tour."
                            },
                            {
                                "example_id": "916d2759-a5a6-4adb-8ac9-6612752f5294",
                                "sense_id": "c2f0a828-8ddd-3a6a-b831-821a73954934",
                                "text": "L’équipe de France a à chaque fois placé trois bateaux sur trois en demi-finale, avec la Paloise Marjorie Delassus, toute récente vice-championne d’Europe, à la 2ᵉ place, et Lucie Baudu (Saran) 4ᵉ."
                            },
                            {
                                "example_id": "0d85ca89-48ee-4994-863b-7cafc2f3b34b",
                                "sense_id": "c2f0a828-8ddd-3a6a-b831-821a73954934",
                                "text": "Célestine Simon, elle, a terminé vice-championne du Finistère."
                            }
                        ]
                    }
