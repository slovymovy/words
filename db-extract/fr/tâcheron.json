        "fr-extract.jsonl": [
            {
                "entry_id": "32228554-7312-3e35-9f6b-ef0636df36a1",
                "word": "tâcheron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18dc938e-affb-4b5f-b780-2e379640e826",
                        "entry_id": "32228554-7312-3e35-9f6b-ef0636df36a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "tâcherons"
                    },
                    {
                        "form_id": "7ea3ece1-ee80-4e42-89e0-b8047097e97d",
                        "entry_id": "32228554-7312-3e35-9f6b-ef0636df36a1",
                        "tags": [
                            "feminine"
                        ],
                        "form": "tâcheronne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39a9b94a-19ea-34d5-8198-5f8dfde6bea2",
                        "entry_id": "32228554-7312-3e35-9f6b-ef0636df36a1",
                        "glosses": [
                            "Ouvrier rémunéré à la tâche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ba45bb-dd17-4402-bb7d-281e00e100f5",
                                "sense_id": "39a9b94a-19ea-34d5-8198-5f8dfde6bea2",
                                "text": "Il était venu chez nous à Hurtebise, en tâcheron, de surcroît, en saisonnier."
                            },
                            {
                                "example_id": "d0f0a566-4885-4e12-aa00-57321953d36a",
                                "sense_id": "39a9b94a-19ea-34d5-8198-5f8dfde6bea2",
                                "text": "Voilà pourquoi la Haute-Saintonge a toujours attiré des populations venues d’ailleurs, défricheurs poitevins, tâcherons auvergnats, éleveurs vendéens, résiniers landoux ou réfugiés espagnols."
                            },
                            {
                                "example_id": "2a00d3d8-b979-4b0b-9027-90f0e499ec97",
                                "sense_id": "39a9b94a-19ea-34d5-8198-5f8dfde6bea2",
                                "text": "Si certains sont salariés, contractualisés, le digital labor a également fait émerger une nouvelle catégorie de travailleurs : les micro-tâcherons. Contre une rémunération infinitésimale, ces nano-intérimaires réalisent des tâches que seul l’homme sait pour l’heure réaliser."
                            }
                        ]
                    },
                    {
                        "sense_id": "defe8d3a-19e2-3842-add6-e45b9eb71282",
                        "entry_id": "32228554-7312-3e35-9f6b-ef0636df36a1",
                        "glosses": [
                            "Celui qui effectue consciencieusement des tâches sans grand intérêt ni prestige."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3650d2cb-2932-4267-b0f7-23b9e1b1ab95",
                                "sense_id": "defe8d3a-19e2-3842-add6-e45b9eb71282",
                                "text": "Ce n’est pas ta faute si ton pauvre mari n’est qu’un tâcheron d’amphithéâtre et d’hôpital, usé par la besogne et qui n’a rien pour parler à l’imagination…"
                            },
                            {
                                "example_id": "06944313-767d-478f-a283-4be0178bab5c",
                                "sense_id": "defe8d3a-19e2-3842-add6-e45b9eb71282",
                                "text": "Il y a un comble d’inertie qui tient depuis trois siècles cette ruine immobile, la même qui fait crouler ailleurs les avalanches. C’est pourquoi je vis ici à petit bruit, et retiens mon souffle, et fais de cette coquille le lit de ce sommeil épais de tâcheron qui te scandalise."
                            },
                            {
                                "example_id": "616d4a63-3972-4abd-9ab9-57646201b49f",
                                "sense_id": "defe8d3a-19e2-3842-add6-e45b9eb71282",
                                "text": "Souvent, le coup sec et répété d’un pivert met dans ce concert de pépiements son bruit artisanal de tâcheron pressé creusant un abri pour la future couvée."
                            },
                            {
                                "example_id": "5651b1a7-4679-467e-b346-a81f7631db7b",
                                "sense_id": "defe8d3a-19e2-3842-add6-e45b9eb71282",
                                "text": "La réalité de la peinture en train de se faire est bien plus riche que toutes les fictions que l’on peut s’en faire à l’avance. Si on ne fait qu’exécuter ce que l’on a imaginé, on n’est qu’un tâcheron de la peinture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93fb113d-e51b-47c8-9a00-bc124f5518cb",
                        "source_entry_id": "32228554-7312-3e35-9f6b-ef0636df36a1",
                        "source_sense_description": "1. Ouvrier rémunéré à la tâche",
                        "target_lang_word": "Hilfsarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilfsarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                        "entry_id": "b0d08c71-dffa-3e94-86b5-446ed92921e9",
                                        "glosses": [
                                            "Person, die für die von ihr ausgeübte Tätigkeit keine spezielle Ausbildung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe2dba1-9498-4142-a535-77c126acf232",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Anders als 1945, als sich die Ansiedler hauptsächlich aus landwirtschaftlichen Hilfsarbeitern und Gewerbetreibenden rekrutierten, nahmen jetzt vermehrt akut benötigte Industriearbeiter an der Siedlungsbewegung teil.“"
                                            },
                                            {
                                                "example_id": "434faf5b-4b50-4851-9edd-b34a6d444942",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Er verdiente sich sein Geld als Hilfsarbeiter und Postkartenmaler.“"
                                            },
                                            {
                                                "example_id": "6f8b41b6-2648-4143-b53b-24c1501aa126",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Der gelernte Schlosser, vertraut mit Metallen, hatte gleich nach dem Ersten Weltkrieg dort als Hilfsarbeiter begonnen und sich langsam hochgedient.“"
                                            },
                                            {
                                                "example_id": "29153440-f58e-4770-b2cb-f9a4f0c3d15d",
                                                "sense_id": "fbb3cbfa-34c9-36cc-92f7-a8ca03634d4f",
                                                "text": "„Darin ist keine Pioniertat einheitlicher Anrede vom Firmenchef bis zum Hilfsarbeiter zu sehen, sondern schlichtweg Übernahme schwedischen Anredegebrauchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
