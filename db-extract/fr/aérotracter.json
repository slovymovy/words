                "senses": [
                    {
                        "sense_id": "20980e8d-4bc0-3b8b-9c91-100f4f8a89af",
                        "entry_id": "ae248df0-5aef-3420-8941-7bd4174562a9",
                        "glosses": [
                            "Tracter en utilisant l’action du vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8104bbcc-7822-4186-8597-d587eb5a0717",
                                "sense_id": "20980e8d-4bc0-3b8b-9c91-100f4f8a89af",
                                "text": "Dès 14 ans, on peut s'essayer à ce sport impressionnant qui consiste à surfer en se faisant aérotracter par une grande voile."
                            },
                            {
                                "example_id": "85472af3-b96f-48dd-aa70-391d930b96c2",
                                "sense_id": "20980e8d-4bc0-3b8b-9c91-100f4f8a89af",
                                "text": "Ils seraient plus de 18 000 à se faire « aérotracter » chaque année dont 7 848 sont licenciés à la FFVL."
                            },
                            {
                                "example_id": "5facbf44-cc91-4475-b52c-f27037eb5aec",
                                "sense_id": "20980e8d-4bc0-3b8b-9c91-100f4f8a89af",
                                "text": "Après, il peut faire une montgolfière pour aérotracter le maïs, et mettre une laisse au canard, ce qui permet de le faire en un coup."
                            }
                        ]
                    }
