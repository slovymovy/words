                                        "sense_id": "fc45383e-c458-3494-841f-be73f28c1da9",
                                        "entry_id": "b9f9d6fc-b833-37e2-8305-939c50407ba2",
                                        "glosses": [
                                            "To refresh, revamp; to freshen or improve something, especially its appearance."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38895c1e-5aca-4b8a-84ae-693a7341ee61",
                                                "sense_id": "fc45383e-c458-3494-841f-be73f28c1da9",
                                                "text": "Fresh paint and some new curtains would do a lot to spruce up this dark room."
                                            },
                                            {
                                                "example_id": "b148509b-0b7b-4273-8671-c35af60908a3",
                                                "sense_id": "fc45383e-c458-3494-841f-be73f28c1da9",
                                                "text": "Hu Yaobang was officially rehabilitated on the ninetieth anniversary of his birth in 2005 and his mausoleum in China Youth League City (Gongqingcheng) in Jiangxi province was spruced up."
                                            },
                                            {
                                                "example_id": "7fc52a4d-c4df-49c0-8c2b-a2a68028f743",
                                                "sense_id": "fc45383e-c458-3494-841f-be73f28c1da9",
                                                "text": "Here's an interesting effect of a global pandemic that has forced Americans to stay home for nearly 10 months: with less vacation and dine-out options, folks have more money saved up than usual and, given the virtually endless amount of time spent staring at their own four walls, they seem to be more willing than usual to shell out some extra cash to spruce up their abodes."
                                            }
                                        ]
