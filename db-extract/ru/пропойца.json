                ],
                "senses": [
                    {
                        "sense_id": "1d1204e1-9fc6-3ec6-aee7-75b29dbe07a3",
                        "entry_id": "c97e1dfb-e2df-33f1-a547-753334d95e0a",
                        "glosses": [
                            "разг. спившийся человек; пьяница"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a2eba9-37e3-4e2c-8ef7-9083e28212df",
                                "sense_id": "1d1204e1-9fc6-3ec6-aee7-75b29dbe07a3",
                                "text": "А что, если я ошибаюсь и этот Рыбников — самый что ни на есть истый распехотный армейский пропойца?"
                            },
                            {
                                "example_id": "b6812714-2b11-4f94-9cb1-510f60279475",
                                "sense_id": "1d1204e1-9fc6-3ec6-aee7-75b29dbe07a3",
                                "text": "Талантливый человек — он иногда и играет, когда трезв, — но совсем, окончательно пропойца."
                            },
                            {
                                "example_id": "8f69a43a-17e3-4bd1-8ef8-fdf5c87403b6",
                                "sense_id": "1d1204e1-9fc6-3ec6-aee7-75b29dbe07a3",
                                "text": "Не бродяги, не пропойцы,//За столом семи морей//Вы пропойте, вы пропойте//Славу женщине моей!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0a778f4-99a0-40d9-b926-110bd6d8ef69",
                        "source_entry_id": "c97e1dfb-e2df-33f1-a547-753334d95e0a",
                        "source_sense_id": "1d1204e1-9fc6-3ec6-aee7-75b29dbe07a3",
                        "target_lang_word": "opój",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opój",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "32f7d3f7-c0e4-3046-bdbb-861abe2ba76f",
                                        "entry_id": "f8fe79c0-3aaa-3849-900a-c662fc629364",
                                        "glosses": [
                                            "człowiek upijający się, opijający się alkoholem, nadużywający alkoholu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daea6616-2537-460e-80c1-eeb262cfae2b",
                                                "sense_id": "32f7d3f7-c0e4-3046-bdbb-861abe2ba76f",
                                                "text": "W dramacie o Henryku V oberżystka opowiada o ostatniej chorobie jednego z najsłynniejszych Szekspirowskich bohaterów, grubego Falstaffa, wielkiego opoja i łgarza, w duszy prostego jak dziecko […]"
                                            },
                                            {
                                                "example_id": "ba4070a5-67b6-4c2f-ac56-dd90ac21b2e7",
                                                "sense_id": "32f7d3f7-c0e4-3046-bdbb-861abe2ba76f",
                                                "text": "Brak perspektywy porównawczej sprawia, iż o pijaństwo zwykliśmy oskarżać samych tylko Polaków, gdy tymczasem w Europie XVI wieku za największych opojów uchodzili Niemcy, w następnym stuleciu zaczęli z nimi konkurować Rosjanie, w XVIII wieku zaś gorszono się dość powszechnie skłonnością Anglików do ginu i tak dalej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
