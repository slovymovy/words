                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caf494d4-5a1b-4b5c-8f0b-be7ffa79d231",
                                                "sense_id": "01753d65-f91f-3e4d-bdd2-1bf3f6378e2e",
                                                "text": "„Manchmal haben Frauen ein bisschen Haue gern“ (Songtitel, Die Ärzte)"
                                            },
                                            {
                                                "example_id": "5cae9b5f-3f18-40f1-af1c-8f7ebbe0a776",
                                                "sense_id": "01753d65-f91f-3e4d-bdd2-1bf3f6378e2e",
                                                "text": "Sei nicht so frech, sonst gibt’s Haue!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1132c253-1f9d-3df6-9a9d-8dcef8baadc1",
                                        "entry_id": "4e573a36-92e9-39f8-a278-357592e95d5b",
                                        "glosses": [
                                            "Hacke"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f67698-90df-4aea-815a-eb9e8d8fbe45",
                                                "sense_id": "1132c253-1f9d-3df6-9a9d-8dcef8baadc1",
                                                "text": "„Manche Gänge sind so eng, daß die Arbeiter nur auf dem Rücken liegend die Kohle über sich mit der Haue loslösen […].“"
                                            }
