                    {
                        "sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "glosses": [
                            "osoba hodująca pszczoły w celu uzyskania produktów pszczelich, takich jak miód, wosk, pyłek, pierzga, propolis lub zapewnienia dostatecznej ilości pszczół do zapylania użytków rolnych"
                        ],
                        "tags": [
                            "beekeeping"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b3b300-0b06-42eb-b1d8-e64012b0930c",
                                "sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                                "text": "Pszczelarz wyciągnął z ula plaster miodu."
                            },
                            {
                                "example_id": "af7149eb-7379-47dc-b0a9-d72a8e0bbced",
                                "sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                                "text": "Święty Ambroży jest patronem pszczelarzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d0ba8e-11d0-4602-93f9-8fda7cb3b589",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "beekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beekeeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02c947e1-84c6-368a-8302-f656ae2dad12",
                                        "entry_id": "ed88862f-e605-33fb-8538-340af3d756ad",
                                        "glosses": [
                                            "A person who maintains hives and keeps bees, especially for the production of honey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b857ce8-9176-45df-912d-d1d999c30663",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "apiarist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apiarist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f8d9402-4ad0-3bb9-888f-a84baf80bd02",
                                        "entry_id": "a53cc0c5-e1e1-3db4-8402-3a11d45d39d9",
                                        "glosses": [
                                            "beekeeper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b043fda-bb63-459e-8c23-20a5409b24a3",
                                                "sense_id": "2f8d9402-4ad0-3bb9-888f-a84baf80bd02",
                                                "text": "Some late and very curious experiments, however, of M. Huber, one of the most celebrated apiarists in Europe, have shewn that the pollen has no share whatever in the formation of wax; but that this substance is produced indiscriminately from honey, sugar, or any other saccharine matter, which serves as food for the bees."
                                            },
                                            {
                                                "example_id": "a11ac3e1-3a77-410b-80c2-cedce4ed5dd0",
                                                "sense_id": "2f8d9402-4ad0-3bb9-888f-a84baf80bd02",
                                                "text": "In addition to this there are, within the borders of the United States, thousands of good locations for the apiarist — forest, prairie, swamp, and mountain regions — where agriculture has not yet gained a foothold, either because of remoteness from markets or the uninviting character of soil or climate."
                                            },
                                            {
                                                "example_id": "976c04c3-cc38-4f1b-8d62-375ac23cd7bc",
                                                "sense_id": "2f8d9402-4ad0-3bb9-888f-a84baf80bd02",
                                                "text": "Reverend Lorenzo Langstroth, a nineteenth- century apiarist, teacher and clergyman who is considered to be the father of American beekeeping, first described this type of hive in 1853."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "586e558b-c383-410e-935a-26012688c7fa",
                        "source_entry_id": "8acda249-1e6c-3a84-ab37-7db5c36a1827",
                        "source_sense_id": "3c7eba97-bc30-3c5c-81c5-68012165b984",
                        "target_lang_word": "včelař",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "včelař",
