                                        "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                        "entry_id": "52613071-e410-3026-82b9-e9b45a5dbfe3",
                                        "glosses": [
                                            "Ill will or hatred toward another, accompanied with the desire to unjustifiably irritate, annoy, or thwart; a want to disturb or put out another; mild malice"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d44c1d7-f746-4e56-9bc3-7cf1227d684c",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "He was so filled with spite for his ex-wife, his brother was afraid of what he might do."
                                            },
                                            {
                                                "example_id": "cac032a3-e3f3-4b5c-a101-373144c458c7",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "They did it just for spite."
                                            },
                                            {
                                                "example_id": "4c852062-f663-4fc8-b533-aa620efafd2b",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "This is the deadly spite that angers."
                                            },
                                            {
                                                "example_id": "97f3e3a7-ca15-40da-b2b4-2506dffae4aa",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "Out of spite, the human beings pretended not to believe that it was Snowball who had destroyed the windmill: they said that it had fallen down because the walls were too thin."
                                            },
                                            {
                                                "example_id": "ec6194d0-2442-4d3c-92f1-443eafde358f",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "sex with older men was a way to both internalize my spite towards my mother and to find security in a father figure I lacked with my own father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                                        "entry_id": "52613071-e410-3026-82b9-e9b45a5dbfe3",
                                        "glosses": [
                                            "Vexation; chagrin; mortification."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb48490-a3a2-45aa-93d5-a7fa80b0c2c4",
                                                "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                                                "text": "\"The time is out of joint: O cursed spite.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
