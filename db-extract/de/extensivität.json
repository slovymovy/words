                "senses": [
                    {
                        "sense_id": "fc2e6eb2-50a2-3074-b289-cd858da5eaa5",
                        "entry_id": "433a9ee3-37e9-3f75-be3c-2d8318ca9420",
                        "glosses": [
                            "umfangreiches, also breites oder tiefes oder ausführliches (extensives) Sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eddb3032-1e0e-4061-b1a0-1b3f5290f3c6",
                                "sense_id": "fc2e6eb2-50a2-3074-b289-cd858da5eaa5",
                                "text": "„Sie finden 1. ein originelles Einteilungssystem, benutzen 2. dieses System in aller Extensivität, stellen auf dieser Basis 3 weiterführende theoretische Überlegungen an, die 4. zum Aufdecken neuer und revolutionärer Zusammenhänge führen.“"
                            },
                            {
                                "example_id": "3c39ecf5-ec5e-4f13-9e6e-6bf27032f80e",
                                "sense_id": "fc2e6eb2-50a2-3074-b289-cd858da5eaa5",
                                "text": "„Das Prinzip der Extensivität beschreibt, dass die Analyse erschöpfend im Sinne der Quantität und im Sinne der Qualität zu erfolgen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32a54e20-8b9c-3297-bac1-57b719ce1760",
                        "entry_id": "433a9ee3-37e9-3f75-be3c-2d8318ca9420",
                        "glosses": [
                            "die Eigenschaft einer Abbildung, Mengen „zu vergrößern“"
                        ],
                        "tags": [
                            "Abbildung"
                        ],
                        "examples": [
                            {
                                "example_id": "aeceb75b-1da8-435a-bbdf-8099f9a652bb",
                                "sense_id": "32a54e20-8b9c-3297-bac1-57b719ce1760",
                                "text": "„Die im Entropieprinzip auftauchende Eigenschaft der Extensivität ist eng mit der Additivität verwandt. Für rationale Werte des Skalierungsparameters t sind die Bedingungen der Additivität und der Extensivität mathematisch äquivalent.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
