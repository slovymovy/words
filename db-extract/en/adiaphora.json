                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "ebc66865-b5ea-4a48-900a-f9e94c063a72",
                                "sense_id": "60819174-d07a-33d6-99c0-24bd7534990a",
                                "text": "Adiaphora being the theological tool which was developed during the controversies of the Reformation, is the baptism not an adiaphora?"
                            },
                            {
                                "example_id": "6937bf08-2a87-4f7c-ae7f-06af2740d77d",
                                "sense_id": "60819174-d07a-33d6-99c0-24bd7534990a",
                                "text": "Spener thought it should have been considered an adiaphora, or at worst, a moderate institution of spiritual life; Loescher thought its privatized nature competed directly with public and corporate worship."
                            },
                            {
                                "example_id": "bebb8b11-f63a-4e5e-aac6-3f3acf269882",
                                "sense_id": "60819174-d07a-33d6-99c0-24bd7534990a",
                                "text": "Second, Roman Catholicism in India dilly-dallied on the caste question, treating ‘caste’ as an adiaphora which was not significant in matters relating to salvation."
                            }
                        ]
                    }
                ],
