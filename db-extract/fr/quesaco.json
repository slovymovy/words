                "senses": [
                    {
                        "sense_id": "42bbbfb8-db48-3b5b-9921-9e16d5f3410d",
                        "entry_id": "3b665d93-e9a2-3ef5-a309-2f758554f715",
                        "glosses": [
                            "Qu’est-ce que c’est ?"
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "9ff0a7c6-3fa1-4ca2-b4a4-ccd1bbb6a39b",
                                "sense_id": "42bbbfb8-db48-3b5b-9921-9e16d5f3410d",
                                "text": "— Hélas ! c’est inutile, cousin, dit Gazonal qui leva sur ses deux amis un œil mélancolique, je suis devenu républicain…\n— Quesaco ? dit Léon."
                            },
                            {
                                "example_id": "8e2adf3d-be5a-4c4a-b336-5024a6270062",
                                "sense_id": "42bbbfb8-db48-3b5b-9921-9e16d5f3410d",
                                "text": "Votre objection, monsieur, est un non-sens…\nQuésaco? dit Margaritis."
                            }
                        ]
                    }
