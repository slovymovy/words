                                "sense_id": "f51b7040-5370-3a64-83ad-2845298117a9",
                                "text": "Examples of past imperfectives are shown in (42)."
                            },
                            {
                                "example_id": "d18e5931-4a59-434a-bebd-85c690241197",
                                "sense_id": "f51b7040-5370-3a64-83ad-2845298117a9",
                                "text": "These putative indeterminate imperfectives are innovative in form precisely because they add a manner meaning to the range of lexical meanings available to Proto-Slavic motion verbs."
                            },
                            {
                                "example_id": "1f15bcc9-408e-4b26-b660-d68cb0772c14",
                                "sense_id": "f51b7040-5370-3a64-83ad-2845298117a9",
                                "text": "Past imperfectives are also unproblematic because imperfectives are mass-like in nature, hence contractible."
                            }
                        ]
