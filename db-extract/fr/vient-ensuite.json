                        "entry_id": "65a2fa21-910a-369b-b6f2-0227903e63af",
                        "glosses": [
                            "Lors d’une élection, personne appelée à remplir un siège laissé vacant."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "dfbf9340-fdad-4298-90fc-02c0e4b1663f",
                                "sense_id": "83b11f3b-7e68-376f-b5fe-835441929e84",
                                "text": "Le député a décidé de laisser sa place au premier vient-ensuite."
                            },
                            {
                                "example_id": "88245887-63d6-450d-bb97-500bde7f87ae",
                                "sense_id": "83b11f3b-7e68-376f-b5fe-835441929e84",
                                "text": "Une vient-ensuite n’a pas été prévenue par son parti qu’un siège se libérait au Conseil communal."
                            },
                            {
                                "example_id": "76265e4f-9c56-4fcd-87a1-b04d6bea262e",
                                "sense_id": "83b11f3b-7e68-376f-b5fe-835441929e84",
                                "text": "De nombreux viennent-ensuite"
                            }
                        ]
                    }
