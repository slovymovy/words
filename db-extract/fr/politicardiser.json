                "senses": [
                    {
                        "sense_id": "8800a121-3840-3a1c-9a7b-abf8dc725787",
                        "entry_id": "3bb2e78d-ccfd-379e-afb6-adf296e45ccf",
                        "glosses": [
                            "Donner un caractère politicard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ad86ad-7de2-4ce6-8413-04e76c2af10f",
                                "sense_id": "8800a121-3840-3a1c-9a7b-abf8dc725787",
                                "text": "Aujourd'hui, la pression vers la transparence doit porter sur la Banque de Chine, les BRICS, les autres émergents. Janet et Mario out, plus les autres, ce n'est pas politiser les banques centrales, car elles se soucient bien sûr «du politique», c'est les «politicardiser»."
                            },
                            {
                                "example_id": "9430937a-a428-4670-88b5-52a05acca7fd",
                                "sense_id": "8800a121-3840-3a1c-9a7b-abf8dc725787",
                                "text": "Bref, ils se normalisent, i.e. se politicardisent, à vitesse V..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed2834a7-72cc-37d3-935b-7de792916f88",
                        "entry_id": "3bb2e78d-ccfd-379e-afb6-adf296e45ccf",
                        "glosses": [
                            "Se montrer politicard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13cd42b3-f926-4415-842d-d54f5cb4594c",
                                "sense_id": "ed2834a7-72cc-37d3-935b-7de792916f88",
                                "text": "Pas du tout envie de polémiquer. Encore moins de politicardiser."
                            },
                            {
                                "example_id": "27020982-745c-48c5-9885-2f5ef6126162",
                                "sense_id": "ed2834a7-72cc-37d3-935b-7de792916f88",
                                "text": "Certains me regardent comme un OVNI, d'autres comme un empêcheur de politicardiser en rond, certains enfin comme un suspect de manipulations ou un type qui se croit débarqué du futur."
                            }
                        ]
                    }
