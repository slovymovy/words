                    {
                        "translation_id": "4665758a-830a-4100-89d9-9adf57453c05",
                        "source_entry_id": "e8943ed5-3fa2-3d00-aaa3-f6359f172093",
                        "source_sense_id": "373659d6-e800-3b65-97b6-516f741c0b94",
