                        "sense_id": "f01f5dd0-fc68-3ebf-94ca-3bce45a9dd37",
                        "entry_id": "bf4b53f6-d153-3d4b-827d-3e6f6536035a",
                        "glosses": [
                            "de keer dat men een toneelstuk, muziekstuk of andersoortig stuk speelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70cf3a0-612e-4ce3-a0d9-f74eb47db9ca",
                                "sense_id": "f01f5dd0-fc68-3ebf-94ca-3bce45a9dd37",
                                "text": "Op het Gijsbrecht Bordes van de Amsterdamse Stadsschouwburg is tot 15 januari, rond voorstellingen, een korte animatiefilm te zien van Vondels tragedie Gysbreght van Aemstel (1637), verteld door Gijs Scholten van Aschat. Cineast Jacqueline Kooter liet zich inspireren door het kleurrijke mozaïek daarover in de schouwburg, van beeldend kunstenaar Antoon Molkenboer. Dit jaar vindt op Nieuwjaarsdag geen traditionele opvoering van de Gysbreght in de schouwburg plaats. (NRC)"
                            }
                        ]
                    }
