{
    "word_family": [
        "facial",
        "face"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76b2759b-c2c7-332c-b931-e21c7e8344ce",
                    "sense_definition": "The front or main exterior wall of a building.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_front",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic <w>facade</w> of the library was recently restored to its original beauty.",
                            "target_lang_translations": {
                                "es": "La histórica <w>fachada</w> de la biblioteca fue restaurada recientemente a su belleza original."
                            }
                        },
                        {
                            "text": "They stood in front of the building to admire the ornate <w>facade</w>.",
                            "target_lang_translations": {
                                "es": "Se detuvieron frente al edificio para admirar la ornamentada <w>fachada</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frontage",
                        "front"
                    ],
                    "common_phrases": [
                        "building facade",
                        "ornate facade"
                    ],
                    "target_lang_definitions": {
                        "es": "Pared exterior principal o frontal de un edificio."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fachada",
                                "target_lang_sense_clarification": "frente exterior de un edificio"
                            },
                            {
                                "target_lang_word": "frontis",
                                "target_lang_sense_clarification": "fachada o frente principal"
                            },
                            {
                                "target_lang_word": "frontispicio",
                                "target_lang_sense_clarification": "fachada principal o frontón decorado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c53d9c5-cd0a-3c2e-a49f-d5307fdf32b4",
                    "sense_definition": "A false or deceptive outward appearance that hides one's true feelings or character.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deceptive_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He maintained a calm <w>facade</w> even though he was extremely nervous inside.",
                            "target_lang_translations": {
                                "es": "Mantuvo una <w>fachada</w> tranquila a pesar de que por dentro estaba extremadamente nervioso."
                            }
                        },
                        {
                            "text": "The company's friendly <w>facade</w> hid a culture of greed and corruption.",
                            "target_lang_translations": {
                                "es": "La <w>apariencia</w> amigable de la empresa ocultaba una cultura de codicia y corrupción."
                            }
                        }
                    ],
                    "synonyms": [
                        "appearance",
                        "guise",
                        "pretence"
                    ],
                    "common_phrases": [
                        "maintain a facade",
                        "drop the facade"
                    ],
                    "target_lang_definitions": {
                        "es": "Apariencia exterior falsa o engañosa que oculta los verdaderos sentimientos o el carácter de alguien."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fachada",
                                "target_lang_sense_clarification": "apariencia engañosa"
                            },
                            {
                                "target_lang_word": "apariencia",
                                "target_lang_sense_clarification": "aspecto exterior fingido"
                            },
                            {
                                "target_lang_word": "pantalla",
                                "target_lang_sense_clarification": "cosa que sirve para encubrir la realidad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f5b5b3-3ecf-3a42-84f4-1ef152bfd989",
                    "sense_definition": "The most visible side or front part of an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_front",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organ's <w>facade</w> was decorated with intricate gold carvings.",
                            "target_lang_translations": {
                                "es": "La <w>fachada</w> del órgano estaba decorada con intrincadas tallas doradas."
                            }
                        },
                        {
                            "text": "The <w>facade</w> of the machine was covered in buttons and dials.",
                            "target_lang_translations": {
                                "es": "El <w>frontal</w> de la máquina estaba cubierto de botones y diales."
                            }
                        }
                    ],
                    "synonyms": [
                        "face",
                        "front"
                    ],
                    "common_phrases": [
                        "organ facade"
                    ],
                    "target_lang_definitions": {
                        "es": "Parte frontal o lado más visible de un objeto."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "frontal",
                                "target_lang_sense_clarification": "parte delantera visible de un objeto o máquina"
                            },
                            {
                                "target_lang_word": "frente",
                                "target_lang_sense_clarification": "lado delantero de un objeto"
                            },
                            {
                                "target_lang_word": "fachada",
                                "target_lang_sense_clarification": "cara exterior principal de una estructura como un órgano"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e8cae8b-e12d-3360-8bc1-a7eaf24bb04f",
                    "sense_definition": "A simplified interface that provides access to a complex underlying software system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_interface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer created a <w>facade</w> to hide the complexity of the legacy database.",
                            "target_lang_translations": {
                                "es": "El desarrollador creó una <w>fachada</w> para ocultar la complejidad de la base de datos heredada."
                            }
                        },
                        {
                            "text": "Using a <w>facade</w> makes the API much easier for other programmers to use.",
                            "target_lang_translations": {
                                "es": "Usar una <w>fachada</w> hace que la API sea mucho más fácil de usar para otros programadores."
                            }
                        }
                    ],
                    "common_phrases": [
                        "facade pattern"
                    ],
                    "target_lang_definitions": {
                        "es": "Interfaz simplificada que proporciona acceso a un sistema de software subyacente complejo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fachada",
                                "target_lang_sense_clarification": "patrón de diseño de software (facade pattern)"
                            },
                            {
                                "target_lang_word": "facade",
                                "target_lang_sense_clarification": "término técnico usado comúnmente en programación"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}