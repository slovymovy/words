                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c174654-132d-4cb9-9dc3-2ec0ad4d88a9",
                                "sense_id": "cdfc0938-4cb9-388b-b443-1534de4d5419",
                                "text": "Umiał zrzucić z siebie cuchnącą patynę palermskiej biedy i powstrzymać ślinkę cieknącą mu na widok świata, któremu wychodził naprzeciw"
                            },
                            {
                                "example_id": "74864c7f-1ca3-41c6-91da-831749bcae02",
                                "sense_id": "cdfc0938-4cb9-388b-b443-1534de4d5419",
                                "text": "Obaj wychowali się w palermskiej dzielnicy Kalsa, kopali z rówieśnikami na ulicy piłkę, których po latach odnaleźli w przeciwnej drużynie, często w rolach miejscowych bossów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
