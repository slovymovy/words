{
    "word_family": [
        "yawn",
        "yawner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4b6a263-22bc-3613-af40-6190d8536441",
                    "sense_definition": "present participle and gerund of <w>yawn</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept <w>yawning</w> throughout the long meeting because he had stayed up late.",
                            "target_lang_translations": {
                                "it": "Ha continuato a <w>sbadigliare</w> per tutta la lunga riunione perché era andato a letto tardi."
                            }
                        },
                        {
                            "text": "The tired child was <w>yawning</w> softly before falling asleep in her bed.",
                            "target_lang_translations": {
                                "it": "La bambina stanca stava <w>sbadigliando</w> piano prima di addormentarsi nel suo letto."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "participio presente e gerundio di \"yawn\" (sbadigliare)"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sbadigliando",
                                "target_lang_sense_clarification": "forma gerundiale del verbo sbadigliare"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "01b05d65-052a-30ad-833e-86f270bf3f53",
                    "sense_definition": "Experiencing tiredness and opening one's mouth involuntarily to take in air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train was filled with <w>yawning</w> commuters heading to work early in the morning.",
                            "target_lang_translations": {
                                "it": "Il treno era pieno di pendolari <w>che sbadigliavano</w> mentre andavano al lavoro la mattina presto."
                            }
                        },
                        {
                            "text": "A <w>yawning</w> student tried hard to concentrate on the professor's lecture.",
                            "target_lang_translations": {
                                "it": "Uno studente <w>che sbadigliava</w> cercava con fatica di concentrarsi sulla lezione del professore."
                            }
                        }
                    ],
                    "synonyms": [
                        "drowsy",
                        "sleepy"
                    ],
                    "antonyms": [
                        "alert",
                        "awake"
                    ],
                    "common_phrases": [
                        "yawning commuters"
                    ],
                    "target_lang_definitions": {
                        "it": "Che sbadiglia a causa di stanchezza o sonno"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "che sbadiglia",
                                "target_lang_sense_clarification": "riferito a persona stanca che compie l'atto di sbadigliare"
                            },
                            {
                                "target_lang_word": "assonnato",
                                "target_lang_sense_clarification": "pieno di sonno, che mostra stanchezza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68af582b-b2ed-33e8-8b8b-717275e773e4",
                    "sense_definition": "Wide open, extremely large, or cavernous, often referring to a gap, chasm, or mouth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers stopped at the edge of a <w>yawning</w> chasm and carefully looked down.",
                            "target_lang_translations": {
                                "it": "Gli escursionisti si fermarono sul bordo di un baratro <w>spalancato</w> e guardarono giù con cautela."
                            }
                        },
                        {
                            "text": "There is still a <w>yawning</w> gap between the richest and poorest members of society.",
                            "target_lang_translations": {
                                "it": "C'è ancora un <w>enorme</w> divario tra i membri più ricchi e quelli più poveri della società."
                            }
                        }
                    ],
                    "synonyms": [
                        "gaping",
                        "cavernous",
                        "wide"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "yawning chasm",
                        "yawning gap"
                    ],
                    "target_lang_definitions": {
                        "it": "Spalancato, enorme, profondo o voraginoso, detto di aperture, abissi o divari"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spalancato",
                                "target_lang_sense_clarification": "aperto al massimo grado"
                            },
                            {
                                "target_lang_word": "profondo",
                                "target_lang_sense_clarification": "di baratro o voragine immensa"
                            },
                            {
                                "target_lang_word": "enorme",
                                "target_lang_sense_clarification": "di divario o abisso amplissimo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dace7bed-af3a-3581-a367-d9c1f9d36dbb",
                    "sense_definition": "The act of taking a deep, involuntary breath with an open mouth, typically due to fatigue or boredom.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her loud <w>yawning</w> distracted everyone who was trying to listen to the speaker.",
                            "target_lang_translations": {
                                "it": "Il suo rumoroso <w>sbadigliare</w> distrasse tutti quelli che stavano cercando di ascoltare il relatore."
                            }
                        },
                        {
                            "text": "Frequent <w>yawning</w> during the day can sometimes indicate poor sleep quality.",
                            "target_lang_translations": {
                                "it": "Uno <w>sbadigliare</w> frequente durante il giorno a volte può indicare una scarsa qualità del sonno."
                            }
                        }
                    ],
                    "synonyms": [
                        "pandiculation"
                    ],
                    "common_phrases": [
                        "contagious yawning"
                    ],
                    "target_lang_definitions": {
                        "it": "L'atto di fare sbadigli in modo involontario a causa di stanchezza o noia"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sbadigliare",
                                "target_lang_sense_clarification": "l'azione o l'atto continuo dello sbadiglio (uso sostantivato)"
                            },
                            {
                                "target_lang_word": "sbadiglio",
                                "target_lang_sense_clarification": "singola o ripetuta inspirazione involontaria"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}