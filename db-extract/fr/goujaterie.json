                    {
                        "translation_id": "f114d120-1060-4eca-9242-a8fe62ef23f5",
                        "source_entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                        "source_sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                        "target_lang_word": "ongemanierdheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongemanierdheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bf36e938-8555-390c-954f-853086d29f54",
                                        "entry_id": "3e2f43ef-a03a-30fe-87c0-648b8e23599f",
                                        "glosses": [
                                            "het onfatsoenlijk zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c32878-1edf-4b6a-82a3-1dae1a942728",
                                                "sense_id": "bf36e938-8555-390c-954f-853086d29f54",
                                                "text": "Ik heb reeds het genoegen gehad kennis te maken, als de gravin zich dat nog herinnert, zei vorst Andrej met een hoffelijke en diepe buiging die volstrekt in tegenspraak was met Peronskaja's opmerking over zijn ongemanierdheid, terwijl hij zich tot Natasja wendde en zijn arm hief om haar middel te omvatten, nog voordat hij zijn vraag of zij met hem wilde dansen had afgerond."
                                            },
                                            {
                                                "example_id": "8988894e-9e8e-4ce4-9455-5194996e8b16",
                                                "sense_id": "bf36e938-8555-390c-954f-853086d29f54",
                                                "text": "Als de buurt geen andere bijdrage levert dan hard te schreeuwen en alleen maar ‘nee’ te roepen tegen een plan dat beleidsmatig past in de ruimtelijke en sectorale opvattingen van de gemeente, dan verdient dat geen enkel respect. Het lijkt erop dat rauwe kretologie en ongemanierdheid meer lonen dan argumenten en fatsoen.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b08f1d06-aea6-3ed7-8a79-9d00a450169d",
                                        "entry_id": "3e2f43ef-a03a-30fe-87c0-648b8e23599f",
                                        "glosses": [
                                            "iets dat getuigt van onfatsoenlijkheid"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40b3d16c-1ef7-46e7-b70f-44449df31a2b",
                        "source_entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                        "source_sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                        "target_lang_word": "onbeschoftheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbeschoftheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                                        "entry_id": "d355e489-4aab-3086-8f4b-650d0dfd0bb4",
                                        "glosses": [
                                            "grove, brutale, hinderlijke en beledigende handeling of uiting; een respectloze handeling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620799ba-4513-4111-984b-20540a0c2dba",
                                                "sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                                                "text": "Zo gewend zijn wij al aan de onbeschoftheid , de ongrondwettelijkheid, het onversneden racisme, de haat, de vuilspuiterij, dat we pas weer opveren als een buitenlandse verslaggever zich verwondert over de verlegde grenzen in het Nederlandse debat."
                                            },
                                            {
                                                "example_id": "83141daa-93d4-4375-861c-0f484f60d215",
                                                "sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                                                "text": "Waar in 2008 nog een kwart van de bevolking het gevoel had slecht behandeld te worden door personeel, was dat het afgelopen jaar nog maar 14 procent. Ook ervoeren minder Nederlanders onbeschoftheid door mensen op straat en overheidspersoneel. Het CBS doet de Veiligheidsmonitor jaarlijks in opdracht van het Ministerie van Justitie. Hiervoor houdt het bureau een grootschalige enquête onder tachtigduizend Nederlanders, waarin specifiek wordt gevraagd naar hun beleving van overlast en veiligheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
