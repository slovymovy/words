                "senses": [
                    {
                        "sense_id": "ea019663-904b-3b65-b197-b191ce101721",
                        "entry_id": "a1bde3d7-a402-38f2-a33b-6a1872d8ee6d",
                        "glosses": [
                            "General der Luftwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a9a630-278d-47ae-9c2d-24a5b69b0a87",
                                "sense_id": "ea019663-904b-3b65-b197-b191ce101721",
                                "text": "„Ihr Vater, ein ehemaliger Luftwaffengeneral, fand in Köln Arbeit beim Finanzamt.“"
                            },
                            {
                                "example_id": "d289645a-cf0c-43c8-8f92-db23646ac52f",
                                "sense_id": "ea019663-904b-3b65-b197-b191ce101721",
                                "text": "„Der Luftwaffengeneral bat sogar den Wehrbeauftragten um Rat und Hilfe.“"
                            },
                            {
                                "example_id": "127651b9-7178-4fd1-9ee4-2a12eb993d20",
                                "sense_id": "ea019663-904b-3b65-b197-b191ce101721",
                                "text": "„Mit der Entscheidung über mögliche Abschüsse wurden zwei Luftwaffengeneräle betraut.“"
                            },
                            {
                                "example_id": "cf04c213-8210-448d-b5ed-a4532042069b",
                                "sense_id": "ea019663-904b-3b65-b197-b191ce101721",
                                "text": "„Die Tochter eines 1974 von seinen Waffengefährten ermordeten Luftwaffengenerals, die nach Haft und Folter in die DDR ins Exil ging und dort Kinderheilkunde studierte, hat das Ihre dazu beigetragen, Vorbehalte gegen Frauen in öffentlichen Ämtern zu widerlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
