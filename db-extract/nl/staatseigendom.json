                    {
                        "sense_id": "d1124303-2ab9-3309-b73b-293a455dc17b",
                        "entry_id": "f889a6ca-ed8a-3795-9887-8a0edbe54856",
                        "glosses": [
                            "het in bezit zijn van de overheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43877908-2b1e-4b8c-b887-94f2d4256fab",
                                "sense_id": "d1124303-2ab9-3309-b73b-293a455dc17b",
                                "text": "Tsipras wil dat strategische bedrijven staatseigendom blijven, in plaats van ze te verkopen zoals de huidige regering wil. Daarnaast is Tsipras van plan de lonen te bevriezen en wil hij niet korten op pensioenen zoals de geldschieters van Griekenland eisen. Hoe Syriza de plannen wil betalen en wat ze opleveren, is onduidelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "c813af2d-4e07-3a9b-84da-9c0267e773a0",
                        "entry_id": "f889a6ca-ed8a-3795-9887-8a0edbe54856",
                        "glosses": [
                            "datgene dat in eigendom van de overheid is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fdc4ba-0890-4905-93a1-d8b097244e7d",
                                "sense_id": "c813af2d-4e07-3a9b-84da-9c0267e773a0",
                                "text": "Het bedrijf stelt beslag te kunnen leggen op het vliegtuig omdat het om Thais staatseigendom gaat, maar de Thaise regering zegt dat het privé-eigendom is van prins Maha Vajiralongkorn."
                            }
                        ]
                    }
