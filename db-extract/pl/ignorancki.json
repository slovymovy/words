        "pl-extract.jsonl": [
            {
                "entry_id": "e21e367f-3cc2-3970-a1eb-ff786cfd4e99",
                "word": "ignorancki",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28cb530d-e52d-3e7d-9e44-728bc1a2c152",
                        "entry_id": "e21e367f-3cc2-3970-a1eb-ff786cfd4e99",
                        "glosses": [
                            "nacechowany lekceważeniem faktów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41315624-71be-4d8c-904e-eb6b5422e841",
                                "sense_id": "28cb530d-e52d-3e7d-9e44-728bc1a2c152",
                                "text": "Jego ignoranckie podejście do problemów ekologii jest niebezpieczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a25201aa-a9af-477d-9284-f03e8f1a3570",
                        "source_entry_id": "e21e367f-3cc2-3970-a1eb-ff786cfd4e99",
                        "source_sense_id": "28cb530d-e52d-3e7d-9e44-728bc1a2c152",
                        "target_lang_word": "ignorant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07baf7ca-f4b9-3350-b792-51726d277638",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Unknowledgeable or uneducated; characterized by ignorance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e15b07-c112-45ea-b5d3-55e60fc42e7d",
                                                "sense_id": "07baf7ca-f4b9-3350-b792-51726d277638",
                                                "text": "That man that doth not know those things which are of use and necessity for him to know, is but an ignorant man, whatever he may know besides;"
                                            },
                                            {
                                                "example_id": "c57bae9d-c142-4a62-87f7-a55ec5e23ebd",
                                                "sense_id": "07baf7ca-f4b9-3350-b792-51726d277638",
                                                "text": "The ignorant peasant, without fault, is greater than the philosopher with many; for what is genius or courage without an heart?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Not knowing (a fact or facts), unaware (of something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8591adf1-71c5-4c31-84da-74ca0fd49942",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "Eve. Somewhat forbids me, which I cannot name;\nFor ignorant of guilt, I fear not shame:\nBut some restraining thought, I know not why,\nTells me, you long should beg, I long deny."
                                            },
                                            {
                                                "example_id": "8bfb10c2-649a-4853-bc78-182503cf2a6c",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "For we would not, brethren, have you ignorant of our trouble which came to us in Asia, that we were pressed out of measure, above strength, insomuch that we despaired even of life:"
                                            },
                                            {
                                                "example_id": "b7d41af4-53dd-414b-8145-dc37d4e275ec",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "1851, Walt Whitman, “Art and Artists” in Emory Holloway (editor), The Uncollected Poetry and Prose of Walt Whitman, Garden City, NY: Doubleday, Page & Co., 1921, Volume 1, p. 242,\n[…] perhaps it is sometimes the case that the greatest artists live and die, the world and themselves alike ignorant what they possess."
                                            },
                                            {
                                                "example_id": "5a68a2a4-8921-47e6-8fa2-aebde5aafc7d",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "That night he slept the sleep of happiness, blissfully ignorant that he had placed the letters in the wrong envelopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c8f8bf-563b-312d-8f45-99dd4f878fb0",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Ill-mannered, crude."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6de6103e-253e-436a-8b3a-17175d311a17",
                                                "sense_id": "50c8f8bf-563b-312d-8f45-99dd4f878fb0",
                                                "text": "His manner was at best off-hand, at worst totally ignorant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "unknown; undiscovered"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e081742c-4304-430a-b312-a32b5655284a",
                                                "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                                "text": "Alas, what ignorant sin have I committed?"
                                            },
                                            {
                                                "example_id": "bf8845ac-1292-4a12-b329-6da580679c17",
                                                "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                                "text": "[…] I beseech you,\nIf you know aught which does behove my knowledge\nThereof to be inform’d, imprison't not\nIn ignorant concealment."
                                            },
                                            {
                                                "example_id": "c26d800f-dc59-4bcc-b094-5d21a2364e92",
                                                "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                                "text": "1845, Robert Browning, letter addressed to Elizabeth Barrett Browning, cited in Percy Lubbock, Elizabeth Barrett Browning in Her Letters, London: Smith, Elder & Co., 1906, Chapter 4, p. 106,\n[…] as to you, your goodness and understanding will always see to the bottom of involuntary or ignorant faults—always help me to correct them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "006837c4-a292-35ea-b18d-e1a10fe306c7",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Resulting from ignorance; foolish; silly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c733db6b-a9a1-4466-bfa8-d21f926e4d8d",
                                                "sense_id": "006837c4-a292-35ea-b18d-e1a10fe306c7",
                                                "text": "[…] his shipping—\nPoor ignorant baubles!— upon our terrible seas,\nLike eggshells moved upon their surges, crack’d\nAs easily ’gainst our rocks:"
                                            },
                                            {
                                                "example_id": "4a1ca63d-2279-43d2-b033-32cc70244539",
                                                "sense_id": "006837c4-a292-35ea-b18d-e1a10fe306c7",
                                                "text": "He had never felt a pain or a sorrow, and did not know what they were, in any really informing way. He had no knowledge of them except theoretically—that is to say, intellectually. And of course that is no good. One can never get any but a loose and ignorant notion of such things except by experience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "en",
