                "senses": [
                    {
                        "sense_id": "5938fc65-a525-3ec9-b118-099f6cf1e102",
                        "entry_id": "b9608103-b5fd-3fdd-a2bf-ebacb963aa8f",
                        "glosses": [
                            "Mèche de cheveux emmêlées naturellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ef7a6e-3fd6-42e4-b9ac-d98d8da1e1a3",
                                "sense_id": "5938fc65-a525-3ec9-b118-099f6cf1e102",
                                "text": "Fixer une dreadlock synthétique sur une mèche de cheveux (pose d'extensions réalisée à chaud)."
                            },
                            {
                                "example_id": "a21c9444-50f5-4218-88e2-402ee16351ff",
                                "sense_id": "5938fc65-a525-3ec9-b118-099f6cf1e102",
                                "text": "Arrivés à une dizaine de centimètres de longueur, roulez les nœuds entre vos paumes de façon à les égaliser, à former une dreadlock bien cylindrique."
                            },
                            {
                                "example_id": "b299d2d7-de8e-4172-a3bb-18abcf5227ea",
                                "sense_id": "5938fc65-a525-3ec9-b118-099f6cf1e102",
                                "text": "Comme ses cheveux poussent vite, il décide de faire une dreadlock."
                            },
                            {
                                "example_id": "66d8c583-bc24-49da-bb41-cdc11cec7ab6",
                                "sense_id": "5938fc65-a525-3ec9-b118-099f6cf1e102",
                                "text": "Avant d’achever cette partie de notre développement, il nous semblait intéressant d’examiner l’influence de la logique commerciale sur un symbole incontournable du mouvement rastafari, les nattes, communément appelées dreadlocks."
                            }
                        ]
                    }
