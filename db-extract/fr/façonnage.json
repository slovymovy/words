                "senses": [
                    {
                        "sense_id": "4e48c7fb-e00b-3db5-949d-d6b5882c5bbc",
                        "entry_id": "e3217740-dee9-3c94-ad1c-3b901d1a6d4d",
                        "glosses": [
                            "Ensemble des opérations fait pour donner une forme à une matière quelconque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1634adf3-4a07-40ad-bc33-d8580adebef8",
                                "sense_id": "4e48c7fb-e00b-3db5-949d-d6b5882c5bbc",
                                "text": "Au sein des habitations, des pièces peuvent être réservées pour pratiquer un artisanat, par exemple le façonnage de petits objets en bronze, en os ou en verre."
                            },
                            {
                                "example_id": "40a8a59d-d4e8-4cde-953e-6e8bd6ca6ade",
                                "sense_id": "4e48c7fb-e00b-3db5-949d-d6b5882c5bbc",
                                "text": "Le modelage est la technique qui consiste à se donner une forme par façonnage d’une substance molle (glaise, cire, plastiline, terre)."
                            }
                        ]
                    },
                    {
                        "sense_id": "924890af-3390-3e95-b9b9-873cfb54d2fa",
                        "entry_id": "e3217740-dee9-3c94-ad1c-3b901d1a6d4d",
                        "glosses": [
                            "Ensemble des opérations à forfait effectuées pour le compte d’une société pétrolière ou pharmaceutique."
                        ],
                        "tags": [
                            "Raffinage"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7d3d1cbb-d7bb-3428-83ec-1b5734a5c979",
                        "entry_id": "e3217740-dee9-3c94-ad1c-3b901d1a6d4d",
                        "glosses": [
                            "Travail fait sur un texte et son message pour lui donner une orientation particulière ou la changer."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cee31b2c-ea37-4573-927e-6d3ba11e2498",
                                "sense_id": "7d3d1cbb-d7bb-3428-83ec-1b5734a5c979",
                                "text": "La mission se penche sur un double processus. D’une part, « le façonnage de l’image ou de la réputation d’un État, ou la promotion d’un +narratif+^([sic]) officiel, par l’instrumentalisation des sciences humaines et sociales »."
                            }
                        ]
                    }
