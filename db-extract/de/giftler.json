                        "examples": [
                            {
                                "example_id": "143b47de-076f-41c8-a53e-0b24c9233c30",
                                "sense_id": "24b4efc1-9f5c-3c64-99a7-d635f13f9d50",
                                "text": "„Zugedröhnte Giftler, die auf der Suche nach einem warmen Platz bei sozialen Einrichtungen anklopfen, finden schwer Einlass: Abstinenz, zumindest für den Moment, ist fast überall Aufnahmebedingung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50e88686-2ac3-4180-8b58-d64ba5235135",
                        "source_entry_id": "f172d980-5a18-3bcb-990d-614e9d490865",
                        "source_sense_id": "24b4efc1-9f5c-3c64-99a7-d635f13f9d50",
                        "source_sense_description": "jemand, der drogenabhängig ist",
                        "target_lang_word": "junkie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "junkie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e990db6a-8344-3b27-8c3d-04fe6d5eb9d3",
                                        "entry_id": "dbb85c43-dc16-3d16-b7bb-d4c646f616ad",
                                        "glosses": [
                                            "A narcotics addict, especially a heroin user."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cd39a7-5200-47ee-b12c-85c9815bf9ee",
                                                "sense_id": "e990db6a-8344-3b27-8c3d-04fe6d5eb9d3",
                                                "text": "It's wiser to say no / God made me a junkie / But Satan told me so"
                                            },
                                            {
                                                "example_id": "979d7229-b9e1-4801-8f22-b9599b5b3879",
                                                "sense_id": "e990db6a-8344-3b27-8c3d-04fe6d5eb9d3",
                                                "text": "Rats in the front room, roaches in the back / Junkies in the alley with a baseball bat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7f241d-2180-3af5-82b6-632a72f46f6c",
                                        "entry_id": "dbb85c43-dc16-3d16-b7bb-d4c646f616ad",
                                        "glosses": [
                                            "An enthusiast of something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad008208-d632-4bb2-8bdc-9046d284d41c",
                                                "sense_id": "fe7f241d-2180-3af5-82b6-632a72f46f6c",
                                                "text": "English people are travel junkies, but Americans hardly ever leave their state."
                                            },
                                            {
                                                "example_id": "d66378ba-a019-4a12-bc53-c2b3a9928a5c",
                                                "sense_id": "fe7f241d-2180-3af5-82b6-632a72f46f6c",
                                                "text": "My uncle is a classic-car junkie."
                                            }
                                        ]
                                    }
                                ]
                            }
