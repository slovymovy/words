                "senses": [
                    {
                        "sense_id": "4c8a5313-e586-3158-89c5-da6769803fa6",
                        "entry_id": "f9af855a-56b9-3e2a-af2e-6d6896ffdc05",
                        "glosses": [
                            "eine nilotische Sprache, die vor allem in Ostafrika vom Volk der Massai gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ca058b-c94d-47f9-a659-983023b69827",
                                "sense_id": "4c8a5313-e586-3158-89c5-da6769803fa6",
                                "text": "„Mara bedeutet in Maa soviel wie ›gefleckt‹, was sich wohl auf die mit Akazien und Buschgruppen bedeckte hügelige Savannenebene bezieht.“"
                            },
                            {
                                "example_id": "2c041124-2d34-485b-84c5-58ae6059a695",
                                "sense_id": "4c8a5313-e586-3158-89c5-da6769803fa6",
                                "text": "„Sie sprechen Maa, die gleiche Sprache, mit der sich auch die Massai, die im Süden des Landes leben und mit denen sie eng verwandt sind, verständigen.“"
                            },
                            {
                                "example_id": "621731f2-906c-4acc-b4f7-9fb1a6e50538",
                                "sense_id": "4c8a5313-e586-3158-89c5-da6769803fa6",
                                "text": "„Die Samburu leben wie die Massai in Kenia und verständigen sich ebenfalls auf Maa.“"
                            },
                            {
                                "example_id": "0ea59b4a-cf16-4a5e-ad25-4574367597f9",
                                "sense_id": "4c8a5313-e586-3158-89c5-da6769803fa6",
                                "text": "„Die Zahlen sprechen scheinbar für so eine Aussage: von knapp 1 Million Maa sprechenden Menschen in Tanzania und Kenya sind nach einem Jahrhundert teils intensiver Missionierungsbemühungen nur ca. 50.000 Menschen getauft[…]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
