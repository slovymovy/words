                                ]
                            },
                            {
                                "target_word": "groan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                        "entry_id": "c792ac03-1225-3edc-8182-38c97fca2017",
                                        "glosses": [
                                            "To make a groan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256fb2af-0e79-45b7-a792-dc866bbd8f29",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "We groaned at his awful jokes."
                                            },
                                            {
                                                "example_id": "64ddb276-f3c9-429d-916a-ed120a41a24a",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "The wooden table groaned under the weight of the banquet."
                                            },
                                            {
                                                "example_id": "45cdf4f0-bd10-4e7d-aa87-0e03609eacf3",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "My Lord of Hereford here whom you call King, / Is a foule traitour to proud Herefords King, / And if you crowne him let me propheſie, / The bloud of Engliſh ſhall manure the ground, / And future ages groane for this foule act, [...]"
                                            },
                                            {
                                                "example_id": "51d5eaca-d10a-40cf-a181-00474c5e36bc",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "Designed to accommodate 60,000 people per day in the 1960s, the main concourse, entrances and passageways around the station were by then positively groaning under the weight of more than 140,000 passengers every 24 hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                                        "entry_id": "c792ac03-1225-3edc-8182-38c97fca2017",
                                        "glosses": [
                                            "To seemingly creak under the strain of being heavily laden."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76781e13-6203-4922-9015-7e0560e12f0a",
                                                "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                                                "text": "That night the table in the outer dining room was just groaning with good things."
                                            },
                                            {
                                                "example_id": "2ae4e361-00ad-41c3-83d1-769540c2493b",
                                                "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                                                "text": "Bookshelves groan under the bloated weight of tomes detailing Great Straight Marriages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54adb875-dc77-3306-be80-de529d42dbbf",
                                        "entry_id": "c792ac03-1225-3edc-8182-38c97fca2017",
                                        "glosses": [
                                            "To strive after earnestly, as if with groans."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc47df6-c686-4ef5-b13c-0b68064bade3",
                                                "sense_id": "54adb875-dc77-3306-be80-de529d42dbbf",
                                                "text": "Nothing but holy, pure, and clear, / Or that which groaneth to be so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b442d654-efdf-4df9-8399-b5267f86cd6f",
