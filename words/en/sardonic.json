                            },
                            {
                                "target_lang_word": "spottend",
                                "target_lang_sense_clarification": "uitlachend, bespottelijk makend"
                            },
                            {
                                "target_lang_word": "cynisch",
                                "target_lang_sense_clarification": "bitter en wantrouwend spottend"
