                                    },
                                    {
                                        "sense_id": "b8361361-fb28-389c-aab7-5887dadd5111",
                                        "entry_id": "c3061c35-3c21-3a91-a949-4ef16c31079c",
                                        "glosses": [
                                            "The quality of having options."
                                        ],
