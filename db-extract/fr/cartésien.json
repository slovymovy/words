                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2fd9286-c745-3be8-8aef-123ad0112f93",
                        "entry_id": "91bfcfec-2dc4-3262-a1f2-24629bf1ee25",
                        "glosses": [
                            "Relatif à la doctrine de Descartes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd44ba9c-bdd0-4839-a2f7-eb437eb6a544",
                                "sense_id": "b2fd9286-c745-3be8-8aef-123ad0112f93",
                                "text": "Ce principe de la philosophie cartésienne, je pense, donc je suis, est ce que les adversaires du cartésianisme ont attaqué avec le plus de persévérance; et cela se conçoit, car ce principe admis, l'autorité de la conscience et de la raison s'ensuit nécessairement."
                            },
                            {
                                "example_id": "47fa8ee7-a668-44c9-b46e-d5c3fd376a1b",
                                "sense_id": "b2fd9286-c745-3be8-8aef-123ad0112f93",
                                "text": "Le rationalisme cartésien et l’ère nouvelle de la science du XVIIᵉ siècle ont marqué la fin du Moyen Âge et du monopole de l'Église sur les entreprises humaines."
                            },
                            {
                                "example_id": "7c1073f2-06f7-43cb-979e-2fc4f4d56dc0",
                                "sense_id": "b2fd9286-c745-3be8-8aef-123ad0112f93",
                                "text": "Les Français n’ayant lu de Descartes que la première phrase du Discours de la méthode et l’ayant prise à contre-sens prêtent à l’épithète « cartésien » le sens de : attaché au gros bon sens."
                            }
                        ]
                    },
                    {
                        "sense_id": "b32ce09c-525b-35b8-bea8-e73ce7bdbde5",
                        "entry_id": "91bfcfec-2dc4-3262-a1f2-24629bf1ee25",
                        "glosses": [
                            "Qui a adopté cette doctrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142bdec3-8943-4e63-b0e8-11d12f6c926e",
                                "sense_id": "b32ce09c-525b-35b8-bea8-e73ce7bdbde5",
                                "text": "Un philosophe cartésien."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cb7d0c5-82a4-3737-8241-4e313f346713",
                        "entry_id": "91bfcfec-2dc4-3262-a1f2-24629bf1ee25",
                        "glosses": [
                            "Rigoureux, clair, logique, méthodique, rationnel."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c8f2aa5d-eee3-33ee-9eed-e40504f1a0dc",
                        "entry_id": "91bfcfec-2dc4-3262-a1f2-24629bf1ee25",
                        "glosses": [
                            "Qui se rapporte à des objets liés à la géométrie de René Descartes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b9ff0d-c190-4274-bca0-cd02856fb546",
                                "sense_id": "c8f2aa5d-eee3-33ee-9eed-e40504f1a0dc",
                                "text": "Un axe cartésien, des coordonnées cartésiennes."
                            }
                        ]
                    }
