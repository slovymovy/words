                "senses": [
                    {
                        "sense_id": "aec3ac9c-c382-3c94-b357-d2bce86ca889",
                        "entry_id": "6d4269b1-8e18-3335-9314-a649a5e9c425",
                        "glosses": [
                            "Fuß (Körperteil am Ende des Beines) eines Babys (Person bis ein Jahr nach der Geburt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a201fe2c-a0c7-4002-a081-929f6521af45",
                                "sense_id": "aec3ac9c-c382-3c94-b357-d2bce86ca889",
                                "text": "„Der schreckliche Fund eines Babyfußes in Burg (Sachsen-Anhalt) lässt die Polizei weiter rätseln: Ein Großaufgebot suchte auch gestern vergeblich nach weiteren Leichenteilen.“"
                            },
                            {
                                "example_id": "7060f599-c70d-43e9-9f14-3fe51fd2b792",
                                "sense_id": "aec3ac9c-c382-3c94-b357-d2bce86ca889",
                                "text": "„Ein US-Tourist hat versucht, konservierte Körperteile aus Thailand mit der Post nach Hause zu schicken – darunter ein Kinderkopf, ein Babyfuß und ein Herz mit einer Messerwunde.“"
                            },
                            {
                                "example_id": "ca3e5f60-849b-4a1b-a228-5d86f47cd6a9",
                                "sense_id": "aec3ac9c-c382-3c94-b357-d2bce86ca889",
                                "text": "„Ein blutverschmiertes Handtuch und ein Babyfuß ragten aus dem Beutel.“"
                            },
                            {
                                "example_id": "cb345d13-c3f6-4f8f-9035-6274974c0294",
                                "sense_id": "aec3ac9c-c382-3c94-b357-d2bce86ca889",
                                "text": "„Zarte Babyfüße benötigen weiche Materialien.“"
                            },
                            {
                                "example_id": "85c9b3d8-016b-4298-9380-81dbfc70ee6f",
                                "sense_id": "aec3ac9c-c382-3c94-b357-d2bce86ca889",
                                "text": "„Bei Babyfüßen ist noch kein Fußgewölbe zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
