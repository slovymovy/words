                        "examples": [
                            {
                                "example_id": "cc03cfb3-7fb1-488c-b212-41b2ce64804f",
                                "sense_id": "7a40f203-09f1-3f48-ba3a-f01cb4e16e33",
                                "text": "Casino se sépare de 20 hypers"
                            },
                            {
                                "example_id": "17f56938-fded-4b4a-84c0-813ceaf45661",
                                "sense_id": "7a40f203-09f1-3f48-ba3a-f01cb4e16e33",
                                "text": "L’accroissement de la longueur des linéaires s'est accompagné d'une plus grande diversité des références: progression de 11% dans les hypers et de 9% dans les supers."
                            },
                            {
                                "example_id": "006caa5d-86a0-4234-a242-4d737f765861",
                                "sense_id": "7a40f203-09f1-3f48-ba3a-f01cb4e16e33",
                                "text": "Dans les allées de l’hyper, les gens étaient des présences qu’on croise et voit vaguement. C’est seulement aux caisses qu’ils s’individualisent."
                            }
                        ]
