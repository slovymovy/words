                    {
                        "translation_id": "dd643fc0-981d-4897-b5c8-be4a520e1451",
                        "source_entry_id": "587842e6-32f2-31da-9748-bdd87edeca65",
                        "target_lang_word": "habanera",
                        "target_lang_code": "en",
