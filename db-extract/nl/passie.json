                                "target_senses": [
                                    {
                                        "sense_id": "c536d3d7-7156-34fe-a4f9-e50cf3d7be31",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "A true desire sustained or prolonged."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5496fa88-cf03-4287-84c3-d1e735ba82a9",
                                                "sense_id": "c536d3d7-7156-34fe-a4f9-e50cf3d7be31",
                                                "text": "An oil lamp burned upon a high, old-fashioned mantel, casting its dim rays over a dozen repulsive figures. All but one were men. The other was a woman of about thirty. Her face, marked by low passions and dissipation, might once have been lovely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Any great, strong, powerful emotion, especially romantic love or extreme hate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a0d6ff-76c7-4848-9a86-0f7686b4f18a",
                                                "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                                                "text": "We share a passion for books."
                                            },
                                            {
                                                "example_id": "76be0a94-b486-4f3a-b8dd-f6d54e55f2b5",
                                                "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                                                "text": "That was partly because of a swirling wind that made precision passing difficult and also a derby atmosphere where the emphasis seemed to be on passion rather than football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc4b70a-7baa-393c-a13a-3e4219b4d452",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Fervor, determination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cf55df3-e83f-3a74-8d52-7339d6e5cf3b",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "An object of passionate or romantic love or strong romantic interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a40a88-ec32-460f-83a6-719892c40909",
                                                "sense_id": "2cf55df3-e83f-3a74-8d52-7339d6e5cf3b",
                                                "text": "It started as a hobby, but now my motorbike collection has become my passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72ef527-e92a-397f-bd7c-2a0d2642fab6",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Sexual intercourse, especially when very emotional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48478e1-f2e6-431d-aab3-b8165c7babc7",
                                                "sense_id": "b72ef527-e92a-397f-bd7c-2a0d2642fab6",
                                                "text": "We shared a night of passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9a1c46-8a15-37a6-86a1-51b32bbba0ed",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "The suffering of Jesus leading up to and during his crucifixion."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8b8186-a026-4238-af5a-1faaf8c16531",
                                                "sense_id": "6a9a1c46-8a15-37a6-86a1-51b32bbba0ed",
                                                "text": "Moreouer the perfit beleue of this article, worketh in all true chriſten people, aloue to continue in this vnitie, and afeare to be caſte out of the ſame, and it worketh in them that be ſinners and repentant, great comforte, and conſolacion, to obteine remiſſion of ſinne, by vertue of Chriſtes paſſion, and adminiſtracion of his ſacramentes at the miniſters handes, ordained for that purpoſe, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d31c6a2-4e9f-3194-8771-f60e7f1ce755",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "A display, musical composition, or play meant to commemorate the suffering of Jesus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6b2b107-b66b-3ecc-bdc6-8cb4a96406e3",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Suffering or enduring of imposed or inflicted pain; any suffering or distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1014f4d5-4901-428a-89eb-35d2e2f5b522",
                                                "sense_id": "d6b2b107-b66b-3ecc-bdc6-8cb4a96406e3",
                                                "text": "a cardiac passion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb84be7-790a-3064-8691-f77ac0524e38",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "The state of being acted upon; subjection to an external agent or influence; a passive condition"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b48c38a-dbb2-46f4-a11e-5da063ba9036",
                                                "sense_id": "dcb84be7-790a-3064-8691-f77ac0524e38",
                                                "text": "A Body at reſt affords us no Idea of any active Power to move; and when it is ſet in motion its ſelf, that Motion is rather a Paſſion, than an Action in it: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1bfb5c-5335-3201-b95a-1f65f39d597a",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "The capacity of being affected by external agents; susceptibility of impressions from external agents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7540db99-d40b-4b35-99a5-2e2748ef7cfa",
                                                "sense_id": "4b1bfb5c-5335-3201-b95a-1f65f39d597a",
                                                "text": "The Differences of Impreſsible and Not Impreſsible; Figurable and Not Figurable; Mouldable and Not Mouldable; Sciſsile and Not Sciſsile; And many other Paſsions of Matter, are Plebeian Notions, applied vnto the Inſtruments and Vſes which Men ordinarily practiſe; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ff9f5c-ff6d-3159-9469-288e074e0417",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "An innate attribute, property, or quality of a thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13cc862-e0fd-4d4a-8aca-fad1fef78144",
                                                "sense_id": "48ff9f5c-ff6d-3159-9469-288e074e0417",
                                                "text": "[...] to obtain the knowledge of some passion of the circle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c690f6a1-be22-3cb0-a774-43addcd62a12",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Disorder of the mind; madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43508217-acdd-47f2-9fed-70220b396600",
                                                "sense_id": "c690f6a1-be22-3cb0-a774-43addcd62a12",
                                                "text": "The fit is momentary, vpon a thought / He will againe be well. If much you note him / You ſhall offend him, and extend his Paſſion, / Feed, and regard him not."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                        "entry_id": "d99d6b26-0e86-321e-be1f-c8f68fa249a7",
                                        "glosses": [
                                            "To suffer pain or sorrow; to experience a passion; to be extremely agitated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25dd6c0-9e2a-412e-a7d5-a1b2a14f5afc",
                                                "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                                "text": "Dumbly she passions, frantically she doteth."
                                            },
                                            {
                                                "example_id": "ddf822bf-dcbf-4a24-afeb-64d7a83cc653",
                                                "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                                "text": "There did I ſee that low ſpirited Swaine, [...] hight Coſtard, (Clow[ne]. O mee) ſorted and conſorted contrary to thy eſtabliſhed proclaymed Edict and continent Cannon; Which with, o with, but with this I paſſion to ſay wherewith: / Clo[wne]. With a Wench."
                                            },
                                            {
                                                "example_id": "37d7c0b7-cdd4-4868-89fa-88296746e463",
                                                "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                                "text": "she passioned\nTo see herself escap'd from so sore ills"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d37ece-8599-34da-afc3-2e8991578c81",
                                        "entry_id": "d99d6b26-0e86-321e-be1f-c8f68fa249a7",
                                        "glosses": [
                                            "To give a passionate character to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cbb44cc-a4c9-4182-8b82-06f56786c796",
                        "source_entry_id": "217c457b-914e-36c1-bbc8-6e8761a9f457",
                        "source_sense_description": "1",
                        "target_lang_word": "passion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5246c9c1-b726-30c3-9d73-c3359c75e77e",
                                        "entry_id": "d14543d0-d743-3226-af2c-23b383b6214c",
                                        "glosses": [
                                            "Grandes douleurs ; souffrance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91758dea-4ea5-4d0a-8bdf-9c6a22324de8",
                                                "sense_id": "5246c9c1-b726-30c3-9d73-c3359c75e77e",
                                                "text": "Ces braves gens n’avaient pas l’air candide et pur d’un jeune séminariste, oh ! non. On voyait à leurs traits durs et prononcés, à leur teint hâlé, à leur front sillonné, que les passions — et quelles passions ! -, que les passions avaient passé par là, et qu’ils avaient mené une vie, hélas ! bien orageuse, ces honnêtes compagnons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                        "entry_id": "d14543d0-d743-3226-af2c-23b383b6214c",
                                        "glosses": [
                                            "Vif sentiment, émotion vivement ressentie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0aa53c-79f6-414d-bd20-a873b1c6f0d3",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "Ce sont là des passions trop enivrantes pour que le cœur humain les ressente et conserve la force de les combattre."
                                            },
                                            {
                                                "example_id": "a6192d1c-25da-4ac1-89c6-67f7172bd24e",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "Dans leurs oupa-oupa, qui passent avec raison pour des danses très obscènes, les acteurs peignent par des pantomimes expressives toutes les passions qui les exaltent."
                                            },
                                            {
                                                "example_id": "87bac9ca-cb02-4605-9dbf-04e0c62d9d9b",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "Le sentiment de révolte que l’on rencontre dans les classes pauvres se colorera dès lors d’une atroce jalousie. Nos journaux démocratiques entretiennent cette pas­sion avec beaucoup d’art, dans la pensée que c’est le meilleur moyen d’abrutir leur clientèle et de se l’attacher."
                                            },
                                            {
                                                "example_id": "7edc360e-65d9-4b02-9179-93715c0d8120",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "Considérons ces passions, dites politiques, par lesquelles des hommes se dressent contre d’autres hommes et dont les principales sont les passions de races, les passions de classes, les passions nationales."
                                            },
                                            {
                                                "example_id": "d328d517-28c7-42eb-ae29-d9fe6da05cf4",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "L’éclosion des sectes dissidentes au sein du christianisme n’a donc fait qu’aiguiser les passions anti-juives de l’Église."
                                            },
                                            {
                                                "example_id": "acbd6c96-7f7f-4e3c-9f7b-6a06276bca12",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "[…] Tritton poursuit : « Même si les dhimmi pouvaient jouir d’une grande prospérité, ils n’étaient toujours que tolérés, exposés aux caprices des gouvernants et aux passions de la foule. »"
                                            },
                                            {
                                                "example_id": "284b9810-3615-412d-a180-0f41a700758e",
                                                "sense_id": "035235f8-d08f-350e-9462-cc62fd01d199",
                                                "text": "Les vices et les passions dans l’art chrétien sont, comme le diable, symbolisés par des animaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cac774-151b-3c06-917f-3c34f81fad50",
                                        "entry_id": "d14543d0-d743-3226-af2c-23b383b6214c",
                                        "glosses": [
                                            "Vif sentiment amoureux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cfc2738-b2ab-4769-9b4b-3a49547768fd",
                                                "sense_id": "33cac774-151b-3c06-917f-3c34f81fad50",
                                                "text": "Souriante, avec, cependant, une ombre de mélancolie dans le regard, Yasmina écoutait Jacques lui chanter, maladroitement encore, toute sa passion qu’il n’essayait même plus d’enchaîner."
                                            },
                                            {
                                                "example_id": "cbe56e14-dabe-4d49-9a67-5e2c401d6943",
                                                "sense_id": "33cac774-151b-3c06-917f-3c34f81fad50",
                                                "text": "La passion est ce qu’il y a de vraiment absolu dans les choses humaines, elle ne veut jamais avoir tort."
                                            },
                                            {
                                                "example_id": "2055962c-06ab-4b9b-b38f-6c969c598672",
                                                "sense_id": "33cac774-151b-3c06-917f-3c34f81fad50",
                                                "text": "Dès le lendemain du crime, je devins éperdument amoureux de Rosalie. Je songeai aussitôt à en faire ma maîtresse, mais je me heurtai à une résistance entêtée et joviale, qui exaspéra et redoubla ma passion."
                                            },
                                            {
                                                "example_id": "284ce4bf-3458-46c8-bf1d-82afe3efa56c",
                                                "sense_id": "33cac774-151b-3c06-917f-3c34f81fad50",
                                                "text": "Ce sentiment ressemblait quelque peu à l'amour qu'elle avait pour ses parents, mais il était beaucoup plus puissant, car il lui faisait perdre le contrôle de sa raison. Parfois, elle se sentait tomber dans le vide sans savoir comment éviter la chute. Parfois encore, elle devenait timide à en perdre la parole. Les Terriens appelaient ce sentiment « la passion »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c822a69e-d0d2-3c62-ac09-575f0a7ba190",
                                        "entry_id": "d14543d0-d743-3226-af2c-23b383b6214c",
                                        "glosses": [
                                            "Goût très prononcé, voire irrésistible, pour une activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad3129b-ca08-4357-b220-c5654f66f0e1",
                                                "sense_id": "c822a69e-d0d2-3c62-ac09-575f0a7ba190",
                                                "text": "Vous connaissez ma passion pour l’histoire naturelle. Il ne se passe pas de semaine que je n’herborise, dans la campagne, autour de la ville."
                                            },
                                            {
                                                "example_id": "6ffc056b-1beb-44e6-9047-c059220aa6cb",
                                                "sense_id": "c822a69e-d0d2-3c62-ac09-575f0a7ba190",
                                                "text": "Seuls, les tripots attiraient encore les joueurs en proie à leur sèche passion."
                                            },
                                            {
                                                "example_id": "fc0c81d2-70be-4cd2-9562-4fad0e15e530",
                                                "sense_id": "c822a69e-d0d2-3c62-ac09-575f0a7ba190",
                                                "text": "Mais toute passion est sexuelle, même lorsque l'on dit de quelqu'un qu'il a la passion des échecs. C'est le même mot : vous avez vécu un grand amour passionné avec telle femme mais vous avez une autre passion, les échecs. Si votre passion est celle des armes de plus en plus destructrices c'est également sexuel mais cette manifestation de la force de vie conduit à la mort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passion",
                                "target_lang_code": "fr",
