                        "glosses": [
                            "Personne qui hante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb0b9c3-ed42-4dc2-ae8e-14d130cb8edb",
                                "sense_id": "3685ea11-b5f5-37e6-9cdc-28a5d381c0a4",
                                "text": "Ces beaux fils en corsets, que vous voyez si pâles,\nTous ces efféminés, honteux sardanapales,\nSont les riches hanteurs de ces lieux ténébreux ,\nOù mâle sur le mâle, ils s'accouplent entre eux."
                            },
                            {
                                "example_id": "e50bcc1c-893c-4985-b371-6b94054c3d1a",
                                "sense_id": "3685ea11-b5f5-37e6-9cdc-28a5d381c0a4",
                                "text": "Le voilà [un centenaire, le libraire Bossange] qui causait avec l'élégance et la grâce d'un hanteur de Versailles ou de Trianon."
                            }
                        ]
                    }
