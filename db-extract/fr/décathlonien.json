                "senses": [
                    {
                        "sense_id": "9bc698ad-3782-3177-b176-9e88a1fb9733",
                        "entry_id": "58dc89ba-e511-3b6b-9798-2eb0ece92bee",
                        "glosses": [
                            "Participant à un décathlon ; athlète spécialiste du décathlon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29e4515-86d2-4ae1-a6e9-9577a0f677d0",
                                "sense_id": "9bc698ad-3782-3177-b176-9e88a1fb9733",
                                "text": "Mais les bonnes surprises pourraient venir du décathlonien algérien Larbi Bouraada, de Tosin Oke, auteur d’un triple bond à 17m 22 a Nairobi, voire des relais sud-africain (4X100 m) et nigérian (4X400m)."
                            },
                            {
                                "example_id": "2be16d71-90c3-488e-a384-dd475632e8bc",
                                "sense_id": "9bc698ad-3782-3177-b176-9e88a1fb9733",
                                "text": "Mais il ne faut pas se tromper, aucun décathlonien ne sera jamais en même temps Usain Bolt sur 100 m, Mondo Duplantis à la perche et Jan Zelezny au javelot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6686d67-1422-48ec-b638-b60593592223",
                        "source_entry_id": "58dc89ba-e511-3b6b-9798-2eb0ece92bee",
                        "source_sense_id": "9bc698ad-3782-3177-b176-9e88a1fb9733",
                        "source_sense_description": "Participant à un décathlon",
                        "target_lang_word": "Zehnkämpfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zehnkämpfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d588030-148a-3077-9e51-4d677860786b",
                                        "entry_id": "d93eee6d-1537-30ab-b0b5-5fd1cb0ec609",
                                        "glosses": [
                                            "Person, die an einem Zehnkampf teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2494db1b-73d8-487e-bcbd-c12fe373d5e1",
                                                "sense_id": "6d588030-148a-3077-9e51-4d677860786b",
                                                "text": "Die Zehnkämpfer warten bereits auf den Beginn des Wettbewerbs."
                                            },
                                            {
                                                "example_id": "b6a8744f-c23f-4632-8fd6-bf35b0032137",
                                                "sense_id": "6d588030-148a-3077-9e51-4d677860786b",
                                                "text": "„Die tschechischen Zehnkämpfer Roman Sebrle und Tomas Dvorak sind nach dem Bekanntwerden, dass sie eine glucosehaltige Lösung vor dem 1.500-m-Meter-Lauf im WM-Zehnkampf in Helsinki erhalten haben, unter Manipulationsverdacht geraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62d5668d-53a1-4f66-adf7-e6a666f91a1c",
                        "source_entry_id": "58dc89ba-e511-3b6b-9798-2eb0ece92bee",
                        "source_sense_id": "9bc698ad-3782-3177-b176-9e88a1fb9733",
