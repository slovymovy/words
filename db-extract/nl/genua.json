                                "target_senses": [
                                    {
                                        "sense_id": "ad6a37f1-0795-31c4-8cae-115013fa60db",
                                        "entry_id": "8a8a2833-de4e-32c3-9ace-016f5d6a27de",
                                        "glosses": [
                                            "Stadt in Ligurien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d631ce4-0ef9-454e-83a1-d57a66f1fe63",
                                                "sense_id": "ad6a37f1-0795-31c4-8cae-115013fa60db",
                                                "text": "Im August werde ich mir die Altstadt Genuas anschauen."
                                            },
                                            {
                                                "example_id": "645ad03d-8344-4ec9-a0f8-c4089376abeb",
                                                "sense_id": "ad6a37f1-0795-31c4-8cae-115013fa60db",
                                                "text": "„Das neue Genua verdankt seine kulturelle Wiederbelebung zu einem großen Teil seinen Umweltprojekten im Hinterland[..], aber vor Allem den strukturellen Maßnahmen im Stadtzentrum selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Genua",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b892ea6-6c35-3a07-9878-8cfd1c712f7c",
                                        "entry_id": "173fab98-3470-338d-a85a-f85a4a6a9651",
                                        "glosses": [
                                            "vergrößertes Vorsegel"
                                        ],
                                        "tags": [
                                            "Seglersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c1b932-445b-45ed-9e24-b963b084b49b",
                                                "sense_id": "8b892ea6-6c35-3a07-9878-8cfd1c712f7c",
                                                "text": "Bei stark zunehmendem Wind sollte man rechtzeitig überlegen, von der Genua zur Fock zu wechseln."
                                            },
                                            {
                                                "example_id": "fff8d618-46c1-40c4-89fa-1b2722d6f9ad",
                                                "sense_id": "8b892ea6-6c35-3a07-9878-8cfd1c712f7c",
                                                "text": "Die Genua wird bei leichten bis mäßigen Winden gefahren."
                                            },
                                            {
                                                "example_id": "e5dd51ac-fe9a-4b79-a91c-4361735aa9fd",
                                                "sense_id": "8b892ea6-6c35-3a07-9878-8cfd1c712f7c",
                                                "text": "Die Genua ist eine übergroße Fock aus leichtem Tuch. Sind mehrere in verschiedenen Größen an Bord, werden sie von der größeren zur kleineren mit 1, 2 usw. bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
