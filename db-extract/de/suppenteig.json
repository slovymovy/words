                        "examples": [
                            {
                                "example_id": "3dd9aad4-ae49-49a4-bc15-70801a3901e3",
                                "sense_id": "2a084673-f9c3-3632-b15b-febe3b63961c",
                                "text": "„Der Vorratsschrank mit den 18 Aluminiumschütten für die damals üblicherweise lose gekauften Grundnahrungsmittel: Erbsen, Sago, Suppenteig, Gerste, Graupen, Nudeln ... hier lässt sich die Speisekarte Anfang des vergangenen Jahrhunderts ablesen.“"
                            },
                            {
                                "example_id": "b81473a1-3ea9-4e6f-bc51-34e3c55b6511",
                                "sense_id": "2a084673-f9c3-3632-b15b-febe3b63961c",
                                "text": "„Die Milchglaslampen werden mit altertümlichen Drehknöpfen angeschaltet. Und im Küchenregal gibt es Schubfächer für Suppenteig, Graupen und Paniermehl.“"
                            }
                        ],
