                ],
                "senses": [
                    {
                        "sense_id": "861d3e21-500f-3e2b-be3b-7fb245c6c886",
                        "entry_id": "96a38367-f686-3f89-bbd3-6dca0e957aa9",
                        "glosses": [
                            "to shit"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a9d6a7ad-b833-4215-8d37-4a8d83688637",
                                "sense_id": "861d3e21-500f-3e2b-be3b-7fb245c6c886",
                                "text": "Он насра́л в коридо́ре.",
                                "translation": "He shat in the corridor.",
                                "english": "He shat in the corridor."
                            },
                            {
                                "example_id": "3d89ccff-71e6-4718-b919-3a37acaa8774",
                                "sense_id": "861d3e21-500f-3e2b-be3b-7fb245c6c886",
                                "text": "будь дру́гом, насри́ кру́гом ― budʹ drúgom, nasrí krúgom ―\nбудь бра́том, насри́ квадра́том ― budʹ brátom, nasrí kvadrátom ―\nбудь сестро́й, насри́ звездо́й ― budʹ sestrój, nasrí zvezdój"
                            }
                        ]
                    },
                    {
                        "sense_id": "a06936c1-dd18-3121-8b1d-6ea2ae71d2fb",
                        "entry_id": "96a38367-f686-3f89-bbd3-6dca0e957aa9",
                        "glosses": [
                            "to harm (someone), to wrong (someone)"
                        ],
                        "tags": [
                            "figuratively",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "844f2d6d-5690-4129-b35b-c11dcad0d464",
                                "sense_id": "a06936c1-dd18-3121-8b1d-6ea2ae71d2fb",
                                "text": "Как то́лько он мне в ду́шу насра́л, вы стано́витесь его́ лу́чшими дру́зьями.",
                                "translation": "Аs soon as he screws me over, you're his new best friend.",
                                "english": "Аs soon as he screws me over, you're his new best friend."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ea96edd-b707-36bd-ba0a-208703a971ce",
                        "entry_id": "96a38367-f686-3f89-bbd3-6dca0e957aa9",
                        "glosses": [
                            "for (someone) to not give a shit [with dative ‘someone’ and на (na, + accusative) ‘about someone/something’] (idiomatically translated by English not give a shit with the dative object as the subject)"
                        ],
                        "tags": [
                            "figuratively",
                            "impersonal",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "5930f436-57f7-4921-8fee-91909578f075",
                                "sense_id": "7ea96edd-b707-36bd-ba0a-208703a971ce",
                                "text": "Ба́нкам насра́ть на таки́х, как я.",
                                "translation": "Banks don't give a shit about people like me.",
                                "english": "Banks don't give a shit about people like me."
                            },
                            {
                                "example_id": "1b11dfdf-21d4-42f9-bb3e-43a9707c211a",
                                "sense_id": "7ea96edd-b707-36bd-ba0a-208703a971ce",
                                "text": "В это трудно поверить\nНо надо признаться, что\nМне насрать на моё лицо\nЕй насрать на моё лицо\nВам насрать на моё лицо\nВсем вам насрать на моё лицо.",
                                "translation": "It's hard to believe\n But I have to admit\nI don't give a shit about my face\nShe doesn't give a shit about my face\nYou don't give a shit about my face\nYou all don't give a shit about my face",
                                "english": "It's hard to believe\n But I have to admit\nI don't give a shit about my face\nShe doesn't give a shit about my face\nYou don't give a shit about my face\nYou all don't give a shit about my face"
                            }
                        ]
                    }
                ],
