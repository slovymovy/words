                        "examples": [
                            {
                                "example_id": "461c97f8-4e10-4ab8-9862-9c3c352058b9",
                                "sense_id": "2c9f694a-d25c-38e2-9a42-1167a746d27d",
                                "text": "The city has now only three small newspapers, which are not abreast with its general progress or that of the State, chiefly because they do not receive sufficient patronage, owing to the overnumerousness of the negro population."
                            },
                            {
                                "example_id": "0f4a83e9-c4b9-42d1-aec4-55dc5db09177",
                                "sense_id": "2c9f694a-d25c-38e2-9a42-1167a746d27d",
                                "text": "His family name is as long as the word overnumerousness and derives from a songless Latin word referring to one of the countless human virtues."
                            },
                            {
                                "example_id": "a607db74-b064-4bb6-9101-1a6ef3e74483",
                                "sense_id": "2c9f694a-d25c-38e2-9a42-1167a746d27d",
                                "text": "Moss as “Word”: What do you call Negative One, sitting alone, in an empty room? […] Overnumerousness!"
                            }
                        ]
