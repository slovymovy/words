                                "target_senses": [
                                    {
                                        "sense_id": "65eca690-566d-347e-8535-f6c3b4061921",
                                        "entry_id": "af9bca73-a285-3440-b3ce-8ba771fb1b32",
                                        "glosses": [
                                            "leiding geven aan een vergadering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f5f5e2-fd1d-4b72-936b-7e3a8e11968c",
                                                "sense_id": "65eca690-566d-347e-8535-f6c3b4061921",
                                                "text": "Zij zat de vergadering van aandeelhouders voor."
