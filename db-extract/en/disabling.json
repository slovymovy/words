                "senses": [
                    {
                        "sense_id": "dd6acc31-d30e-3536-9d40-9a56bdb9a6f0",
                        "entry_id": "a7a06a9b-7ce3-3d06-9798-fa5f8fa759a0",
                        "glosses": [
                            "That disables; crippling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d95c9c05-cd5c-4019-9bd1-15b6fef93f1f",
                                "sense_id": "dd6acc31-d30e-3536-9d40-9a56bdb9a6f0",
                                "text": "Rationing decisions that accept people's 'needs' for physical care and limited domestic help, while rejecting demands to support integrated social activities as 'wants', legitimise some of our most disabling cultural values."
                            },
                            {
                                "example_id": "e4bce05a-0c66-40b9-8d96-13a983e3acb7",
                                "sense_id": "dd6acc31-d30e-3536-9d40-9a56bdb9a6f0",
                                "text": "Among physical conditions, neurological disorders are the most disabling conditions across all dimensions of disability consistently across the two higher country income levels."
                            },
                            {
                                "example_id": "88628780-0dcb-46f0-90a4-25ddce9035cd",
                                "sense_id": "dd6acc31-d30e-3536-9d40-9a56bdb9a6f0",
                                "text": "Schizophrenia spectrum disorders are some of the more disabling types of mental illnesses."
                            }
                        ]
                    }
                ],
