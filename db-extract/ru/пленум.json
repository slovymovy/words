                                    {
                                        "sense_id": "139c1679-1c30-3b59-8189-2f812cb9f82e",
                                        "entry_id": "9a473e51-ec63-369d-a86b-aa26301d1674",
                                        "glosses": [
                                            "A session of a conference or other meeting at which all members are expected to be present."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ef1c40-c975-4815-90cb-bf26d4ba6f17",
                                                "sense_id": "139c1679-1c30-3b59-8189-2f812cb9f82e",
                                                "text": "The conference consists of five regular sessions spread across multiple rooms and two plenary sessions in the main auditorium."
                                            }
