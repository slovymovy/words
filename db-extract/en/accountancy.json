                        "cross_references": [
                            {
                                "target_word": "comptabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                        "entry_id": "dd1b226d-7bfa-3ba4-975b-8117413dc832",
                                        "glosses": [
                                            "Tenue des comptes, la manière, l’action de rendre et d’établir des comptes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fc4e9e-941d-4751-a19f-639ad52d9fc6",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Si Ripoil tombe, je risque gros. On va enquêter, fouiller dans la comptabilité. Et le bougre est capable de manger le morceau. Nous avons touché Barnold et moi. L'extorsion de fonds est indéniable."
                                            },
                                            {
                                                "example_id": "8fcc903e-69be-40e1-aff6-3aee23a9c975",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Les chiffres publiés relèvent de la comptabilité publique, qui diffère de la comptabilité nationale, publiée par l’Institut national de la statistique (INE) et traditionnellement utilisée dans les comparaisons internationales."
                                            },
                                            {
                                                "example_id": "40fc9667-8662-4c36-8013-27571b2e673e",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Après un gigot flageolets avalé chez belle-maman, qu'il appelle « ma mère », monsieur met à profit l'après-midi dominical pour s'immerger dans la comptabilité familiale."
                                            },
                                            {
                                                "example_id": "374bd4a2-b4ac-4f07-bdd6-6418fc6a73a9",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Il a mis beaucoup d’ordre dans sa comptabilité."
                                            },
                                            {
                                                "example_id": "e1d6cfe2-8506-43dc-a7ae-217f545496c2",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Il aime bien la comptabilité."
                                            },
                                            {
                                                "example_id": "ec915d2d-52f1-493d-951f-b34a04b2e786",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Être chargé de la comptabilité."
                                            },
                                            {
                                                "example_id": "fee8fea9-74a0-4ccf-9ae8-2fc34825c529",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Bureau de la comptabilité."
                                            },
                                            {
                                                "example_id": "3f589ede-86a5-4a2f-8572-cea43a4b6226",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Le chef de la comptabilité va comptabiliser cette facture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
