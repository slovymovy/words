{
    "word_family": [
        "gape",
        "gaper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3044417-9c1b-3369-9e0c-a3a3d8737482",
                    "sense_definition": "Wide open.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "openness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a <w>gaping</w> hole in the wooden fence that needs to be repaired.",
                            "target_lang_translations": {
                                "ru": "В деревянном заборе есть <w>зияющая</w> дыра, которую нужно починить."
                            }
                        },
                        {
                            "text": "The workers had to fill the <w>gaping</w> wound in the road before traffic could resume.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось заделать <w>зияющую</w> яму на дороге, прежде чем движение могло возобновиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "agape",
                        "yawning"
                    ],
                    "antonyms": [
                        "closed"
                    ],
                    "common_phrases": [
                        "gaping hole",
                        "gaping wound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко открытый, зияющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зияющий",
                                "target_lang_sense_clarification": "о дыре, ране, пропасти"
                            },
                            {
                                "target_lang_word": "широко открытый",
                                "target_lang_sense_clarification": "о проеме, отверстии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dbcdd86-bfa4-3573-8c5b-d98404124c98",
                    "sense_definition": "Having the jaw wide open, as in astonishment or stupefaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "openness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician performed his tricks to the astonishment of the <w>gaping</w> crowd.",
                            "target_lang_translations": {
                                "ru": "Иллюзионист показывал свои фокусы к изумлению <w>глазеющей</w> толпы."
                            }
                        },
                        {
                            "text": "She stared with a <w>gaping</w> mouth when she heard the unexpected news.",
                            "target_lang_translations": {
                                "ru": "Она уставилась с <w>разинутым</w> ртом, когда услышала неожиданную новость."
                            }
                        }
                    ],
                    "synonyms": [
                        "astounded",
                        "open-mouthed"
                    ],
                    "common_phrases": [
                        "gaping crowd",
                        "gaping mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "С широко открытым ртом (от изумления или глупости)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разинувший рот",
                                "target_lang_sense_clarification": "от изумления"
                            },
                            {
                                "target_lang_word": "глазеющий",
                                "target_lang_sense_clarification": "о толпе, зрителе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30fea9f9-d8ad-3fb3-b17c-81aab252e040",
                    "sense_definition": "present participle and gerund of <w>gape</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were <w>gaping</w> at the beautiful sunset in absolute silence.",
                            "target_lang_translations": {
                                "ru": "Они в абсолютной тишине <w>глазели</w> на красивый закат."
                            }
                        },
                        {
                            "text": "Stop <w>gaping</w> at the screen and start doing your homework.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>пялиться</w> в экран и начинай делать домашнее задание."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола gape (глазеть, зиять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазеющий",
                                "target_lang_sense_clarification": "смотрящий с изумлением"
                            },
                            {
                                "target_lang_word": "зияющий",
                                "target_lang_sense_clarification": "быть широко открытым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d97d17a-517f-3649-8631-96d3191daad8",
                    "sense_definition": "The act of one who gapes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaping_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor observed the patient's involuntary <w>gapings</w> during the examination.",
                            "target_lang_translations": {
                                "ru": "Врач наблюдал непроизвольное <w>зевание</w> пациента во время осмотра."
                            }
                        },
                        {
                            "text": "His constant <w>gapings</w> showed how tired he was after the long flight.",
                            "target_lang_translations": {
                                "ru": "Его постоянное <w>зевание</w> показывало, как он устал после долгого полета."
                            }
                        }
                    ],
                    "synonyms": [
                        "yawning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие того, кто зевает или глазеет с открытым ртом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зевание",
                                "target_lang_sense_clarification": "от усталости"
                            },
                            {
                                "target_lang_word": "глазение",
                                "target_lang_sense_clarification": "с открытым ртом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc3b12ff-f862-3aca-940c-f2c0ab3b3231",
                    "sense_definition": "Something gaping; something agape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaping_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark <w>gapings</w> of the cave made the explorers feel uneasy.",
                            "target_lang_translations": {
                                "ru": "Темные <w>зияния</w> пещеры заставляли исследователей чувствовать себя неловко."
                            }
                        },
                        {
                            "text": "We could see several <w>gapings</w> in the old stone wall.",
                            "target_lang_translations": {
                                "ru": "Мы могли видеть несколько <w>проемов</w> в старой каменной стене."
                            }
                        }
                    ],
                    "synonyms": [
                        "opening",
                        "cleft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то широко открытое; щель, проем или трещина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зияние",
                                "target_lang_sense_clarification": "отверстие, проем"
                            },
                            {
                                "target_lang_word": "трещина",
                                "target_lang_sense_clarification": "щель в стене"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2778760-7374-38cd-9d0f-0e727b2142e2",
                    "sense_definition": "A threat or courtship behavior in animals involving holding the mouth open and displaying the teeth or other interior features.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lizard used defensive <w>gaping</w> to scare away the predator.",
                            "target_lang_translations": {
                                "ru": "Ящерица использовала защитное <w>открывание пасти</w>, чтобы отпугнуть хищника."
                            }
                        },
                        {
                            "text": "During courtship, the bird's colorful <w>gaping</w> attracted a mate.",
                            "target_lang_translations": {
                                "ru": "Во время ухаживания красочное <w>раскрывание клюва</w> птицы привлекало партнера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "defensive gaping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угрожающее или брачное поведение животных, заключающееся в широком открывании пасти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонстративное открывание пасти",
                                "target_lang_sense_clarification": "у животных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}