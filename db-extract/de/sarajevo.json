                                "target_senses": [
                                    {
                                        "sense_id": "2cbb4934-1ee3-33e3-8aac-62646a55fb45",
                                        "entry_id": "81e91681-86e5-35a0-8c97-75d8caa58f1e",
                                        "glosses": [
                                            "The capital city of Bosnia and Herzegovina, built on the Miljacka river."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9178702-157f-4b47-adcd-ddff062b39e4",
                                                "sense_id": "2cbb4934-1ee3-33e3-8aac-62646a55fb45",
                                                "text": "I had planned a stop in Sarajevo to meet with a multiethnic delegation to hear their ideas about what the United States government and private organizations could do to help heal a society ripped apart by war. The security situation forced me to cancel my trip to Sarajevo, but the people I was to meet were so disappointed that they insisted on braving the journey along fifty miles of treacherous roads to meet me in Tuzla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4555524b-06fc-39d3-bb8a-29a32c2c5792",
                                        "entry_id": "81e91681-86e5-35a0-8c97-75d8caa58f1e",
                                        "glosses": [
                                            "A canton of Bosnia and Herzegovina."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65110bb7-9e5f-4270-8410-5c2847d7b856",
                        "source_entry_id": "d2706c72-d9a1-3194-9fa0-af44ae9310e7",
                        "source_sense_id": "d0ce6bd5-8753-3cfa-bf77-47daea72a59f",
                        "source_sense_description": "Hauptstadt und Regierungssitz von Bosnien und Herzegowina",
                        "target_lang_word": "Sarajevo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sarajevo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc237b86-1dba-3b83-8ce5-40fdacdb2f4e",
                                        "entry_id": "17f3289a-8c1d-3a91-845e-e2f47925880a",
                                        "glosses": [
                                            "Capitale de la Bosnie-Herzégovine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f489be-df21-47ca-a050-ff0093226d9d",
                                                "sense_id": "cc237b86-1dba-3b83-8ce5-40fdacdb2f4e",
                                                "text": "Et la guerre fut là tout d’un coup, parce qu’un archiduc autrichien, dont personne ne sait plus le nom, avait été tué à Sarajevo."
                                            },
                                            {
                                                "example_id": "f4bac7c7-e883-4c0d-aa97-474362e855c0",
                                                "sense_id": "cc237b86-1dba-3b83-8ce5-40fdacdb2f4e",
                                                "text": "L’obstination portée à détruire l’Empire fédéral autrichien nous a valu la première guerre mondiale après l’attentat de Sarajevo, puis sa prolongation après le refus français d’une paix séparée avec l’Autriche […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58f7a87-f7b1-3ba8-9229-d6b35d11f7ad",
                                        "entry_id": "17f3289a-8c1d-3a91-845e-e2f47925880a",
                                        "glosses": [
                                            "Attentat qui déclencha la Première Guerre mondiale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4907abb-0e8e-45a9-be58-e9f50c1405a0",
                                                "sense_id": "b58f7a87-f7b1-3ba8-9229-d6b35d11f7ad",
                                                "text": "Ne voyons nous pas rallumée, à Dantzig, la fumante mèche de Sarajevo ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ede3d11f-3789-42e7-8056-d21d3a94860a",
                        "source_entry_id": "d2706c72-d9a1-3194-9fa0-af44ae9310e7",
                        "source_sense_id": "d0ce6bd5-8753-3cfa-bf77-47daea72a59f",
