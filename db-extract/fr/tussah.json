                ],
                "senses": [
                    {
                        "sense_id": "99bb8c76-610e-33b6-9d8e-07e2817ecfb0",
                        "entry_id": "3aeef7fa-97b7-3311-b825-ec25135c89c9",
                        "glosses": [
                            "Espèce de ver à soie (Antheraea pernyi)."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "d5533608-c22f-4187-b064-aa0aae9e4773",
                                "sense_id": "99bb8c76-610e-33b6-9d8e-07e2817ecfb0",
                                "text": "La « soie sauvage » ou brune est produite par le tussah (Antherae mylitta) qui se nourrit sur le Chêne de Mandchourie."
                            },
                            {
                                "example_id": "e30dea16-3591-4554-9c9b-1c04a7a79731",
                                "sense_id": "99bb8c76-610e-33b6-9d8e-07e2817ecfb0",
                                "text": "Le fil de soie Tussah est secrété par une espèce de gros bombyx qui fréquente les chênes (et non les mûriers) du sud de la Chine et que l'on appelle là-bas le tussah."
                            },
                            {
                                "example_id": "4f0731d6-6cbc-4a60-93cc-32460a06796c",
                                "sense_id": "99bb8c76-610e-33b6-9d8e-07e2817ecfb0",
                                "text": "Le Tussah au cocon gris ou brun qui vit aux Indes sur le ricin et le chêne et dont les produits soumis dans plusieurs localités à un élevage méthodique paraissent appelés à un grand avenir."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3158f9a-e6c7-31ea-8837-f28f07db5c8e",
                        "entry_id": "3aeef7fa-97b7-3311-b825-ec25135c89c9",
                        "glosses": [
                            "Variante de tussore."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d432b76d-3f2a-477a-8977-e81a03950f35",
                                "sense_id": "c3158f9a-e6c7-31ea-8837-f28f07db5c8e",
                                "text": "Avec des schappes de soie, on peut filer jusqu'au 400 m/m au kilogramme. Avec les déchets de tussah on ne peut filer plus de 140 m/m au kilogramme."
                            }
                        ]
                    }
                ],
