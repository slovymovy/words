                "senses": [
                    {
                        "sense_id": "bbb4ab82-3191-36ba-8672-b7e8e7b4d0a5",
                        "entry_id": "07383035-eeea-386d-882f-bf4317362b4f",
                        "glosses": [
                            "österreichische Jagdhunderasse mit schwarzem, glattem Fell, mittelgroßem Körper und langer Rute"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "7bafa893-ca5f-4d8b-b4d2-98e22fabe137",
                                "sense_id": "bbb4ab82-3191-36ba-8672-b7e8e7b4d0a5",
                                "text": "„Doch da sprang der Vieräugl daher, der sich vom Zaunpflock losgerissen hatte und verbiss sich augenblicklich in den spukhaften Angreifer.“"
                            },
                            {
                                "example_id": "1c00e220-e10c-4669-a139-994940d9a839",
                                "sense_id": "bbb4ab82-3191-36ba-8672-b7e8e7b4d0a5",
                                "text": "„Brandlbracken, auch Vieräugl genannt, begleiteten schon Kaiser Maximilian I. (1493–1519) bei der Hochwildjagd. Nach den Bildern in seinem Jagdbuch hat sich die Rasse wenig verändert.“"
                            },
                            {
                                "example_id": "ed2290ca-3447-45ff-a689-3cc9242fb4ff",
                                "sense_id": "bbb4ab82-3191-36ba-8672-b7e8e7b4d0a5",
                                "text": "„Aber Hugo mußte leider erkennen, daß es sich bei diesem Tier um ein Vieräugl handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
