                ],
                "senses": [
                    {
                        "sense_id": "f4055ca8-18b0-332a-b5bb-444fc60b9c66",
                        "entry_id": "e6832fa2-bdf0-318d-86fe-f344030a98f4",
                        "glosses": [
                            "das Unterbinden, Behindern, Hemmen der Bewegung, des Flusses von etwas (einer Flüssigkeit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca49ab9-0efd-45e6-b662-5bd00ed884d2",
                                "sense_id": "f4055ca8-18b0-332a-b5bb-444fc60b9c66",
                                "text": "„Die Stauung des Wassers beeinträchtigte zudem die Wasserqualität der Stadt Basel, weil das langsamer fliessende Wasser ins Grundwasser drang.“"
                            },
                            {
                                "example_id": "63f263b8-d4a0-4c85-8f86-f59dde1273b3",
                                "sense_id": "f4055ca8-18b0-332a-b5bb-444fc60b9c66",
                                "text": "„Zusätzlich zu den blutspeichernden Arterien in der Nähe des Gehirns besitzt die Giraffe mehrere venöse Klappen, um eine Stauung des Blutes zu verhindern sowie einen streng einseitig gerichteten Blutfluss zu bewirken[.]“"
                            },
                            {
                                "example_id": "53a6feb8-7395-4503-a285-d44f6691d0bc",
                                "sense_id": "f4055ca8-18b0-332a-b5bb-444fc60b9c66",
                                "text": "„In der Chinesischen Medizin spielt das Prinzip von Yin und Yang eine wichtige Rolle: Krankheit ist die Folge eines gestörten Gleichgewichts von Yin und Yang, das zu einer Stauung des Energieflusses führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84a321ae-55d2-3956-8a34-755530a6d32e",
                        "entry_id": "e6832fa2-bdf0-318d-86fe-f344030a98f4",
                        "glosses": [
                            "Zustand von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e187ef2-525d-472f-910b-6b039404ca0f",
                                "sense_id": "84a321ae-55d2-3956-8a34-755530a6d32e",
                                "text": "„Bei den herrschenden Wetterbedingungen war mit Stauungen auf der Autobahn ebenso zu rechnen, wie mit zähflüssigem Verkehr in der Münchner Innenstadt.“"
                            },
                            {
                                "example_id": "1bafe05b-0fce-49f1-9684-7c53b664ef41",
                                "sense_id": "84a321ae-55d2-3956-8a34-755530a6d32e",
                                "text": "„[…] [W]enn durch Diät und Magenwaschung die Stauung behoben wird, gehen die Symptome zurück, aber nicht das Karzinom.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
