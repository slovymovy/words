                ],
                "senses": [
                    {
                        "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                        "entry_id": "874731ef-2d33-3eaf-8d86-2f0617e1e76a",
                        "glosses": [
                            "En parlant d’enceintes, faire en sorte d’amplifier indépendamment les aigus et les graves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5324ba-2b17-4778-8e6d-0e82eb28b5c8",
                                "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                                "text": "Puis-je bi-câbler ou bi-amplifier mes enceintes?"
                            },
                            {
                                "example_id": "89e64488-dcad-41d7-839e-33bfa94bafd2",
                                "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                                "text": "La plupart du temps, ce pont est livré avec les enceintes et se présente sous la forme d'un strap métallique, qu'il convient d'ôter pour pouvoir bi-amplifier les enceintes."
                            },
                            {
                                "example_id": "88ad5a02-ee02-441d-ae80-4b641502ef38",
                                "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                                "text": "Si vous bi-amplifiez les enceintes avant, vous devez modifier le réglage « Speakers Type (Front) »."
                            },
                            {
                                "example_id": "6e17160a-7b5c-4ece-96ff-3516d6f735a3",
                                "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                                "text": "Lorsque vous bicâblez ou biamplifiez, retirez les plaquettes de liaison après. avoir desserré les capuchons de bornes."
                            },
                            {
                                "example_id": "1337d5ca-cec4-4b5d-a385-aca925e83cd4",
                                "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                                "text": "Enceinte de studio de proximité bass-reflex biamplifiée à 2 voies"
                            },
                            {
                                "example_id": "de94ca88-bb1e-49b6-89a2-8887e7dca3dd",
                                "sense_id": "801ae406-418c-3167-99af-6bb33190e861",
                                "text": "Je me demandais si en biamplifiant des sx300 je pouvais améliorer quelque chose."
                            }
                        ]
                    }
                ],
