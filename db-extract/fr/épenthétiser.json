                        "examples": [
                            {
                                "example_id": "85428730-1bd6-4c34-9077-0b2e8fb35644",
                                "sense_id": "db9653d8-12f7-3f3e-9888-8862a9fc08a7",
                                "text": "Si l’association des éléments de la racine et des positions du squelette est libre, avec en plus la possibilité d’épenthétiser w ou y, on devine les catastrophes que cela produira si l’on garde la conception du croisement des racines et des schèmes."
                            },
                            {
                                "example_id": "4e862cbf-fb73-4e7a-a4bd-df5ee5d0abfd",
                                "sense_id": "db9653d8-12f7-3f3e-9888-8862a9fc08a7",
                                "text": "[il] ne précise jamais par quel méchanisme formel la grammaire sélectionne pour chaque mot la CL particulière à épenthétiser …"
                            }
                        ]
                    }
