                "senses": [
                    {
                        "sense_id": "65d4b2b5-1f60-3e30-99cc-388bec1a6017",
                        "entry_id": "0fed3933-7f28-3ac6-85b0-292c61e1c2f7",
                        "glosses": [
                            "One who applies glazing, as in pottery, etc.; one who gives a glasslike or glossy surface to anything; a calenderer or smoother of cloth, paper, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "030bb4a2-9a39-3032-a162-da1999320b96",
                        "entry_id": "0fed3933-7f28-3ac6-85b0-292c61e1c2f7",
                        "glosses": [
                            "A person who is prone to endless monologuing; derived from the practice of speaking until the listener's eyes \\\"glaze over\\\"."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0a1819fd-76b1-3e55-a775-e4457c670609",
                        "entry_id": "0fed3933-7f28-3ac6-85b0-292c61e1c2f7",
                        "glosses": [
                            "A glazier; one who fits glass."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a8353d9c-9729-3a8f-8c02-5743e62c25d3",
                        "entry_id": "0fed3933-7f28-3ac6-85b0-292c61e1c2f7",
                        "glosses": [
                            "Someone who glazes (compliments or praises someone excessively in a cringeworthy way); an asskisser or sycophant."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "6295721a-5f01-44d3-9c68-22c354f199d2",
                                "sense_id": "a8353d9c-9729-3a8f-8c02-5743e62c25d3",
                                "text": "Weakest president ever. Such a glazer for the most evil tyrants in the world."
                            },
                            {
                                "example_id": "1e758252-5556-47ec-8080-1bbbbf4f20af",
                                "sense_id": "a8353d9c-9729-3a8f-8c02-5743e62c25d3",
                                "text": "Genius to maximize revenue from iron man glazers that do not care enough about the goat MF DOOM"
                            },
                            {
                                "example_id": "869b4a05-0b88-497b-a4ee-2ead3d1075e1",
                                "sense_id": "a8353d9c-9729-3a8f-8c02-5743e62c25d3",
                                "text": "roman's [i.e., Roman Reigns's] n1 glazer is back on tiktok 😭"
                            },
                            {
                                "example_id": "62ab7b82-df6e-4da0-98c2-7169030b8bdf",
                                "sense_id": "a8353d9c-9729-3a8f-8c02-5743e62c25d3",
                                "text": "Red Dead Redemption 2 is imho the most overrated game ever made. Story & Characters are top-notch no lie here, but it might be the single most frustrating game to play. Gameplay is genuinely so ass idk how you glazers can't see this fact."
                            }
                        ]
                    }
