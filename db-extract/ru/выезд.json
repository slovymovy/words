                                        "glosses": [
                                            "Stelle, an der man etwas fahrend verlassen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5a28fd-20f3-469f-ae5c-bcdb01bee14e",
                                                "sense_id": "38483561-4ea6-39ac-9d20-f78a7bc88ed9",
                                                "text": "Bitte die Ausfahrt freihalten!"
                                            },
                                            {
                                                "example_id": "ee7abe9e-0fe4-45bb-9de0-e6e1bf994b2a",
                                                "sense_id": "38483561-4ea6-39ac-9d20-f78a7bc88ed9",
                                                "text": "„Die Ausfahrt kam direkt hinter dem Tunnel, ein einfaches gelbes Schild teilte den Vorüberfahrenden mit, dass weiter unten Menschen wohnten.“"
                                            }
                                        ],
