                        "tags": [],
                        "examples": [
                            {
                                "example_id": "669ae53d-c36e-49ae-89e3-61768e163c95",
                                "sense_id": "f33df327-55c3-350e-95b2-a90ea9db8298",
                                "text": "Het rijtuig sloeg echter een zijweg in en reed langs de donkere massa, die niets anders bleek te zijn dan de stadswal rond Rome."
                            },
                            {
                                "example_id": "0f99a075-b087-46e4-9e08-1d918e3cfc8a",
                                "sense_id": "f33df327-55c3-350e-95b2-a90ea9db8298",
                                "text": "Het explosief werd gevonden bij opgravingen op de hoek van de Nieuweweg en de Oostersingel. Die plek lag in 1672 aan de binnenzijde van de Stadswal. Stadsarcheoloog Gert Kortekaas is lyrisch over de vondst. \"Zoiets kom je hoogst een enkele keer tegen\", zegt hij tegen RTV Noord. \"Dit is heel zeldzaam.\""
                            }
                        ]
                    }
