                        "entry_id": "60d8e68a-b3a7-3f5c-85e6-da9642978c19",
                        "glosses": [
                            "A person who deserves to be, or is likely to be, hanged."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d90a3aa7-51a2-465b-8708-0a2797136db0",
                                "sense_id": "910a2f40-f53d-31b0-a162-8d4fe30fdbe7",
                                "text": "Come hither, crackhempe."
                            },
                            {
                                "example_id": "2e20043a-29c0-4f8a-acf0-760f039acea1",
                                "sense_id": "910a2f40-f53d-31b0-a162-8d4fe30fdbe7",
                                "text": "Even in the Castle of Avenel thou wert a wild blood enough, but hadst thou been nurtured here, within a flight shot of the court, thou hadst been the veriest crack-hemp of a page that ever wore a feather in thy bonnet or steel by thy side: truly, I wish it may end week with thee."
                            }
                        ]
                    }
