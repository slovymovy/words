                    "frequency": "Middle",
                    "semantic_group_id": "homosexuality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using the word <w>homo</w> to insult someone on the school playground is unacceptable.",
                            "target_lang_translations": {
