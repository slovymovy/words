                "senses": [
                    {
                        "sense_id": "f02fa317-a16e-332a-a3c0-6a68295c8f5b",
                        "entry_id": "98edc3f9-edfd-3866-9469-a5f03d726321",
                        "glosses": [
                            "verband hebbend met de zichtbare werkelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d892d9d-a947-4312-9edf-b3287fdc16d7",
                                "sense_id": "f02fa317-a16e-332a-a3c0-6a68295c8f5b",
                                "text": "Een figuratieve ambachtsman die flirtte met pop-art, die niks moet hebben van het minimalisme van grote rode vlakken of barbaarse abstracte kunst, maar portretten maakt en reusachtige kleurrijke natuurschilderingen. Een vrolijke, innemende snuiter bovendien."
                            }
                        ]
