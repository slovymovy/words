                        },
                        {
                            "text": "У него совсем нет <w>силы</w> воли, чтобы бросить курить.",
                            "target_lang_translations": {
                                "en": "He has absolutely no <w>strength</w> of will to quit smoking.",
                                "it": "Non ha affatto la <w>forza</w> di volontà per smettere di fumare."
                            }
