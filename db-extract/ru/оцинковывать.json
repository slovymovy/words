                    {
                        "translation_id": "1facfb55-4a54-4b2a-9840-64450dff5137",
                        "source_entry_id": "768ec8ea-dee2-3a90-aa2e-7217f6e69326",
                        "source_sense_id": "918a2c1b-d315-3ef9-a09c-ffdbb0c80710",
                        "target_lang_word": "galvanize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galvanize",
