                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "633ee149-0322-3cae-a9d2-a27843ec0b5a",
                        "entry_id": "3d18e964-7112-38a7-9ae6-4ac235439eab",
                        "glosses": [
                            "die Schulnote „genügend“ beziehungsweise „ausreichend“ (4)"
                        ],
                        "tags": [
                            "Austrian German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "3a2267de-7cf0-45c4-ad0a-4669ab397825",
                                "sense_id": "633ee149-0322-3cae-a9d2-a27843ec0b5a",
                                "text": "Ich habe einen Vierer in Mathe."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "80c3de8b-1e42-3eac-ac55-57448224d3d6",
                        "entry_id": "3d18e964-7112-38a7-9ae6-4ac235439eab",
                        "glosses": [
                            "vier richtig getippte Zahlen im Lotto"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c217e1aa-f516-4f7d-b72a-583dec72ad0f",
                                "sense_id": "80c3de8b-1e42-3eac-ac55-57448224d3d6",
                                "text": "Mein Vierer war dreißig Euro wert."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "8f52f595-8f31-3228-b733-a58477e796d8",
                        "entry_id": "3d18e964-7112-38a7-9ae6-4ac235439eab",
                        "glosses": [
                            "die Zahl Vier"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "00109b46-f52a-47f5-a224-5dd4747a7ee8",
                                "sense_id": "8f52f595-8f31-3228-b733-a58477e796d8",
                                "text": "Hier steht ein Vierer."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "31a0c25b-fac4-3202-ab66-ca2b7b96e5cd",
                        "entry_id": "3d18e964-7112-38a7-9ae6-4ac235439eab",
                        "glosses": [
                            "die Augenzahl 4 auf einem Spielwürfel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33b3f42-d93a-4122-9376-7a57fbd86515",
                                "sense_id": "31a0c25b-fac4-3202-ab66-ca2b7b96e5cd",
                                "text": "„Er hebt den Becher hoch, er hat drei Vierer gewürfelt.“"
                            },
                            {
                                "example_id": "aa68e9fd-7235-4635-8e00-9c889a9463d2",
                                "sense_id": "31a0c25b-fac4-3202-ab66-ca2b7b96e5cd",
                                "text": "„Ich habe 2 Einser, vier Zweier und drei Vierer gewürfelt.“"
                            },
                            {
                                "example_id": "ac8de0f6-ff78-4bfb-b9e2-e5eb3dd2b9cf",
                                "sense_id": "31a0c25b-fac4-3202-ab66-ca2b7b96e5cd",
                                "text": "„Susi würfelte, und ein Vierer lag auf dem Tisch.“"
                            },
                            {
                                "example_id": "fc8b3235-af42-4c33-b16f-2c8e58fa4afa",
                                "sense_id": "31a0c25b-fac4-3202-ab66-ca2b7b96e5cd",
                                "text": "„SX würfelt drei Vierer, B hat mehr. Also hat B gewonnen.“"
                            },
                            {
                                "example_id": "39a32901-ac3b-46b5-bad1-ec39759f0332",
                                "sense_id": "31a0c25b-fac4-3202-ab66-ca2b7b96e5cd",
                                "text": "„Wenn man beim ersten Wurf mit allen 6 Würfeln ein Triplett bekommt, kann man 1000 seiner Punkte setzen und den Versuch unternehmen, durch Nochmalwürfeln mit den verbliebenen 3 Würfeln daraus einen Vierer zu machen. Gelingt es, bekommt man den Vierer gutgeschrieben und kann noch weiterwürfeln.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "eaaef8f6-3b22-378c-8d69-9976020d2b8e",
                        "entry_id": "3d18e964-7112-38a7-9ae6-4ac235439eab",
                        "glosses": [
                            "Geschlechtsverkehr zu viert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41a0d446-18d8-4d62-a88d-ec940c3eac64",
                                "sense_id": "eaaef8f6-3b22-378c-8d69-9976020d2b8e",
                                "text": "Letztes Wochenende hatte ich einen Vierer mit meinen Kolleginnen."
                            }
                        ],
                        "sense_index_json": "\"7\""
                    },
                    {
                        "sense_id": "6f41a068-5850-3ada-b2c5-bd294b4e6b6d",
                        "entry_id": "3d18e964-7112-38a7-9ae6-4ac235439eab",
                        "glosses": [
                            "Wettspielform im Golfspiel, bei der zwei Zweierteams jeweils nur einen Ball abwechselnd bis zum Loch schlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dde42fb-4c2d-4924-b6cf-93dcc4c71ced",
                                "sense_id": "6f41a068-5850-3ada-b2c5-bd294b4e6b6d",
                                "text": "Im Vierer war Sebastian schon immer schlecht."
                            }
                        ],
                        "sense_index_json": "\"8\""
                    }
