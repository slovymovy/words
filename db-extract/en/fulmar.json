                        "target_lang_word": "глупы́ш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глупы́ш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0158298a-322f-3faf-9a59-97700d0eda23",
                                        "entry_id": "70a06062-6b45-37bb-98ac-b4c7f9f08506",
                                        "glosses": [
                                            "неразумный, наивный ребёнок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac776b61-76b7-4c9b-97f6-67390678613d",
                                                "sense_id": "0158298a-322f-3faf-9a59-97700d0eda23",
                                                "text": "Сущий ребёнок же ещё, глупыш за партой, секретарь обкома улыбнётся девочке ― и той жизнь кажется прекрасной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5042ab3-57ad-385f-bee9-0a9ad9b8538f",
                                        "entry_id": "70a06062-6b45-37bb-98ac-b4c7f9f08506",
                                        "glosses": [
                                            "орнитол. северная морская водоплавающая птица семейства буревестниковых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d2832e-4723-4838-bf6b-cbc9331dc2e2",
                                                "sense_id": "b5042ab3-57ad-385f-bee9-0a9ad9b8538f",
                                                "text": "Глупыши питаются преимущественно рыбой, улитками, раками, головоногими и медузами."
                                            },
                                            {
                                                "example_id": "ebbe3d09-3fbf-4c86-9382-491587742afc",
                                                "sense_id": "b5042ab3-57ad-385f-bee9-0a9ad9b8538f",
                                                "text": "А мне, ребята, сон приснился. Глупыш прямо в кубрик залетел. Сел у меня в головах, клюнул плафончик и говорит человечьим голосом: «Бичи! ..»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
