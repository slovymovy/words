    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                "word": "forebody",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b874cd23-d0a3-4c95-9e46-4d9dc0a4a23a",
                        "entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "forebodies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "472cb2a2-a662-32aa-b555-ed1eb9b5dd98",
                        "entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "glosses": [
                            "The forepart of a vehicle; foreside."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967775d4-1e16-4da9-b330-1c3e64c93e46",
                                "sense_id": "472cb2a2-a662-32aa-b555-ed1eb9b5dd98",
                                "text": "Beyond that, there are indications that some gains may be made on road vehicles by shaping the forebody in such a way that the external flow is channeled sideways around the vehicle, rather than over the top, as will be discussed in a later section."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf0a587d-43c7-34db-a5b4-911b7415fcd9",
                        "entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "glosses": [
                            "The part of the vessel forward of amidships; foreship, forecastle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8fb60fe-1bb6-433c-89a7-7347e87ace1c",
                                "sense_id": "bf0a587d-43c7-34db-a5b4-911b7415fcd9",
                                "text": "The wear-off is intensified in heavily loaded areas, such as the ice belt in the ship's forebody, and during operations in heavy ice and especially in presence of soil or sand mixed in ice."
                            }
                        ]
                    },
                    {
                        "sense_id": "92f55bbf-5dfa-34e2-a0b4-7239903ad9d5",
                        "entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "glosses": [
                            "thorax"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9faab9c-9c5b-45a9-9493-08dc0a2a4cb5",
                        "source_entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "source_sense_description": "forepart of a vehicle",
                        "target_lang_word": "Front",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Front",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f10b4038-f9f1-31ea-8b92-ce18171c0c62",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "eine plötzlich auftretende Grenze ungleicher Luftmassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058aeeb7-b76f-4b52-a83a-b7823a436e7c",
                                                "sense_id": "f10b4038-f9f1-31ea-8b92-ce18171c0c62",
                                                "text": "„Hinter dieser Kaltfront von „Tilo“ sei zugleich „sehr kalte Polarluft“ nach Deutschland eingeflossen, sagte DWD-Meteorologe Andreas Friedrich – und das brachte schon einen vorzeitigen Winter in manche Regionen Deutschlands. […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b42a374-1448-3bef-973e-5dc85969c24c",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "Angrenzung (Grenzlinie) zum Gegner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad0581d-5ebb-443e-a4c6-154deba7d4fa",
                                                "sense_id": "5b42a374-1448-3bef-973e-5dc85969c24c",
                                                "text": "„Wir liegen neun Kilometer hinter der Front.“"
                                            },
                                            {
                                                "example_id": "8fbb889b-f22d-42d6-b42e-23a2630d915c",
                                                "sense_id": "5b42a374-1448-3bef-973e-5dc85969c24c",
                                                "text": "„Er sei gern Soldat gewesen, glaubt sie, zumal er den ganzen Krieg über in Deutschland blieb und nicht an die Front musste.“"
                                            },
                                            {
                                                "example_id": "3f5df51f-24c6-447d-8b13-3f06ac0ff5bb",
                                                "sense_id": "5b42a374-1448-3bef-973e-5dc85969c24c",
                                                "text": "„Um diese Zeit war Roman Bertini wie nie zuvor mit dem Verlauf der Fronten beschäftigt.“"
                                            },
                                            {
                                                "example_id": "2483bbb5-6bfa-4884-8a6d-36b3e80685a4",
                                                "sense_id": "5b42a374-1448-3bef-973e-5dc85969c24c",
                                                "text": "„An der Front sei er einer brutalen Ewigkeit ausgesetzt gewesen, er habe irgendwann nicht einmal mehr Tag und Nacht unterscheiden können unter all dem Staub und Rauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9f2bbbd-5849-3727-aa8a-786455bfc0aa",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "die größte militärische Formation einer Armee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4ae717-017b-432c-a9f6-2eba98548ac0",
                                                "sense_id": "e9f2bbbd-5849-3727-aa8a-786455bfc0aa",
                                                "text": "„Die militärische Einheit ward in der Infanterie die jetzt verdoppelte Legion, eine vollständig nach alter dorischer Art gereihte und gerüstete Phalanx von sechstausend Mann, die sechs Glieder hoch eine Front von tausend Schwergerüsteten bildete […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "7f2243d3-7bd1-3233-8ce8-acdd4177722f",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "Festungsbau zu gegnerischen zugewandte Stellungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bcb654e-d79f-4aad-ae1d-e129153ec490",
                                                "sense_id": "7f2243d3-7bd1-3233-8ce8-acdd4177722f",
                                                "text": "„Jede weitere fortifikatorische Maßnahme hätte jetzt zur Umwallung der gesamten Stadt mit einer Front von Bastionen führen müssen. […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "232e9c2a-90a2-3b83-87a3-ea60e6645005",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "auf Schiffen in eine bestimmte Richtung gerichteter Salut der Soldaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d61f79e1-57b3-49ef-9f1e-06df4eb51d13",
                                                "sense_id": "232e9c2a-90a2-3b83-87a3-ea60e6645005",
                                                "text": "Die Seeleute stehen auf dem Schiff in Front Angesicht zu Angesicht mit der Mannschaft des zu grüßenden Schiffes und salutieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2c\""
                                    },
                                    {
                                        "sense_id": "71d87c22-86fe-32b4-b4d1-9ddef1389b2a",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "Vorderseite diverser Gegenstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fda4d14-db79-4e21-8f8c-d3d52c7a3ffa",
                                                "sense_id": "71d87c22-86fe-32b4-b4d1-9ddef1389b2a",
                                                "text": "Die Frontseite des Wagens ist sehr aerodynamisch."
                                            },
                                            {
                                                "example_id": "425ec83a-c462-4335-87d6-36abea92566f",
                                                "sense_id": "71d87c22-86fe-32b4-b4d1-9ddef1389b2a",
                                                "text": "„Dafür waren die Räume zu groß, und vor der Front war keine Moskitoveranda.“"
                                            },
                                            {
                                                "example_id": "d3e0d1b4-f480-48ce-bf57-b638abfcd45d",
                                                "sense_id": "71d87c22-86fe-32b4-b4d1-9ddef1389b2a",
                                                "text": "„In einem regelmäßigen Straßengitter mit teilweise überdachten Gehwegen standen Fachwerkhäuser unterschiedlichster Größe und mit der Front nicht unbedingt an der Straße orientiert – jedes Raster bildete eine Freifläche, auf der sich die unterschiedlichsten Gebäude versammelten, kleine Häuser und größere Gehöfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "96e6f48d-4ce4-38b9-91f0-db4929113af7",
                                        "entry_id": "c711a816-dac1-3bf0-8312-9da23d6c09aa",
                                        "glosses": [
                                            "politisch orientierte Gesinnungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ced58dc-8599-4c98-b29a-a9c351578922",
                                                "sense_id": "96e6f48d-4ce4-38b9-91f0-db4929113af7",
                                                "text": "„War für Lenin noch der Klassenkampf zwischen ‚Arbeiterklasse‘ und ‚Bourgeoisie‘ die entscheidende Frontlinie, hat Sjuganow im heutigen Russland einen neuen ‚Hauptkonflikt‘ ausgemacht: zwischen ‚parasitärem Kapital‘ der Rohstoff-Exporteure und ‚schaffendem Kapital‘. […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Front",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77bff93c-9059-3ba1-b068-98d8cfa9eca9",
                                        "entry_id": "9386f4b3-59b6-3e25-8cb8-66f8d96b4923",
                                        "glosses": [
                                            "Gemeinde im Piemont (Italien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3669a58c-b037-4d6e-9773-7d91ce66245e",
                                                "sense_id": "77bff93c-9059-3ba1-b068-98d8cfa9eca9",
                                                "text": "Die Gemeinde Front hat circa 1700 Einwohner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aaee5ce-773b-487f-924c-d7819d0ecd3e",
                        "source_entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "source_sense_description": "forepart of a vehicle",
                        "target_lang_word": "Vorderteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aa550c5a-8cf3-4368-bccd-037bc92df1a6",
                        "source_entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "source_sense_description": "forepart of a vehicle",
                        "target_lang_word": "vorderer Teil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "997a68d0-370f-4310-94c1-3cb7cb782f67",
                        "source_entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "source_sense_description": "front part of a vessel",
                        "target_lang_word": "Vorschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                        "entry_id": "02600a0e-45d5-3f30-81e6-5ec392a58fe6",
                                        "glosses": [
                                            "vorderer Teil eines Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6874834f-d2e5-4fce-aedf-94439284d07c",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Wir gingen auf das Vorschiff und beugten uns dort über die Verschanzung.“"
                                            },
                                            {
                                                "example_id": "027f7862-1de8-460c-ab38-e529eb1fe1db",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Kurz nachdem sich die beiden Matrosen Lenz und Kremp in ihre Unterkunft im Vorschiff zurückgezogen hatten, klopfte es an der Außentür zum Achterruff.“"
                                            },
                                            {
                                                "example_id": "386a97a7-39c6-46c7-8728-283da57be528",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Im Laderaum stand Wasser, im Vorschiff reichte es bis zum Mastschuh, offenbar war es durch die offenen Luken eingedrungen.“"
                                            },
                                            {
                                                "example_id": "3228a463-4fd0-4d63-bc5c-109824d8af35",
                                                "sense_id": "b5b29362-dd6f-39af-a9dc-57277c67ef2e",
                                                "text": "„Es war wie immer, die Diesel sangen im Diskant, und das Boot bebte vor Kraft, der Turm nahm viel Wasser über, das Vorschiff wuchtete manchmal so schwer in die See, daß man Angst bekommen konnte, es käme niemals wieder hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d8c2cd5-67bc-4215-8a94-0f9940796252",
                        "source_entry_id": "bd0a9a8a-9e8b-3426-b6c2-89075c35a0f8",
                        "source_sense_description": "front part of a vessel",
                        "target_lang_word": "Bug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                        "entry_id": "c54f5d7e-c98d-3e47-aa01-724e90ef2cef",
                                        "glosses": [
                                            "Schiffsvorderteil, Flugzeugvorderteil"
                                        ],
                                        "tags": [
                                            "Aviatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e76249eb-e322-4396-81a2-e4a74f1651d4",
                                                "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                                "text": "Das Schiff lief mit dem Bug voraus auf eine Sandbank auf."
                                            },
                                            {
                                                "example_id": "723ffd78-e0a8-4cbd-be54-a51240f0d0ae",
                                                "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                                "text": "Im Bug klafft ein Leck."
                                            },
                                            {
                                                "example_id": "af02e80a-d816-4c12-9ace-abaab2dbf20b",
                                                "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                                "text": "…, Gischt schäumt um den Bug wie Flocken von Schnee, …"
                                            },
                                            {
                                                "example_id": "32d752ff-8309-4299-8c78-2105a938858f",
                                                "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                                "text": "„Ein Matrose maß am Bug mit einem Handlot die Wassertiefe.“"
                                            },
                                            {
                                                "example_id": "689f4f78-c923-4202-b3f5-0167cd8fe451",
                                                "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                                "text": "„Der erste Torpedo traf tief unter der Wasserlinie den Bug des Schiffes dort, wo die Mannschaftsräume lagen.“"
                                            },
                                            {
                                                "example_id": "406756c4-379b-4561-874d-86c88ced1223",
                                                "sense_id": "43fecc04-7ba1-36a7-a503-ccee3c2f2985",
                                                "text": "„Auf dem Fährschiff löste sich der alte Grams von Roman und lehnte sich am Bug gegen die Reeling.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54d3811f-5396-3a65-8977-9bb816a3e2bc",
                                        "entry_id": "c54f5d7e-c98d-3e47-aa01-724e90ef2cef",
                                        "glosses": [
                                            "die Schulter von Schlachttieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf01860-bc88-4dd5-8c2a-9dbde02d5889",
                                                "sense_id": "54d3811f-5396-3a65-8977-9bb816a3e2bc",
                                                "text": "Ein Mann, der eines Nachmittags müde nach Hause kam, hätte gern ein Stück Butterbrod mit Schnittlauch darauf gegessen, oder etwas von einem geräucherten Bug."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1fe4b4fb-28a4-3516-ab9d-94d65e71fdbf",
                                        "entry_id": "c54f5d7e-c98d-3e47-aa01-724e90ef2cef",
                                        "glosses": [
                                            "eine Strebe im Dachstuhl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43772a0f-1d92-4241-8af5-fce2c4bf26d8",
                                                "sense_id": "1fe4b4fb-28a4-3516-ab9d-94d65e71fdbf",
                                                "text": "Die Büge im flachgeneigten Satteldach waren zum Großteil dermaßen wurmstichig, dass sie ausgetauscht werden mussten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4c519553-b14d-350c-8c83-3680781106dc",
                                        "entry_id": "c54f5d7e-c98d-3e47-aa01-724e90ef2cef",
                                        "glosses": [
                                            "ein Teil des Korpus"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Streichinstrument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253edbba-8511-4647-bc6a-0b8096fcda1c",
                                                "sense_id": "4c519553-b14d-350c-8c83-3680781106dc",
                                                "text": "Der Bug eines Streichinstruments oder einer Gitarre wird in den Oberbug und den Unterbug unterteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d88304b0-2e88-392b-a102-c54aa0afb78d",
                                        "entry_id": "c54f5d7e-c98d-3e47-aa01-724e90ef2cef",
                                        "glosses": [
                                            "ein Knick in einer Briefmarke"
                                        ],
                                        "tags": [
                                            "Philatelie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6032d4d8-d0bd-4a0d-a549-78c59585ded4",
                                                "sense_id": "d88304b0-2e88-392b-a102-c54aa0afb78d",
                                                "text": "Der Bug in dieser Marke macht sie wertlos."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "167c95b7-2e7c-3dd6-a684-eb7e04accd14",
                                        "entry_id": "3ff13172-7764-3684-ad1f-2e3e5864e8e4",
                                        "glosses": [
                                            "ein Software- oder Hardwarefehler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f537086d-c226-4d30-a930-2ee24874ac1d",
                                                "sense_id": "167c95b7-2e7c-3dd6-a684-eb7e04accd14",
                                                "text": "Im Textverarbeitungsprogramm gibt es seit Jahren den so genannten Fußnotenbug."
                                            },
                                            {
                                                "example_id": "28a2e024-e51d-4696-8b5f-1b7571a3db62",
                                                "sense_id": "167c95b7-2e7c-3dd6-a684-eb7e04accd14",
                                                "text": "Dieser Bug bewirkt einen Absturz des Programms beim Speichern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5385244-1f7b-3341-82fa-29714629585d",
                                        "entry_id": "3de28374-8586-3ce2-9a54-8d6e954f02e8",
                                        "glosses": [
                                            "Halbinsel auf Rügen"
                                        ],
                                        "tags": [
                                            "geography"
