                            },
                            {
                                "example_id": "a456d59d-27b1-4df6-87c8-7d891e7d9725",
                                "sense_id": "241eb83d-24bc-3983-ae6e-898829c54a5f",
                                "text": "fishlike eyes"
                            },
                            {
                                "example_id": "042c7c61-05e0-4b8d-91a0-c6001ee5b792",
                                "sense_id": "241eb83d-24bc-3983-ae6e-898829c54a5f",
                                "text": "fishlike swimming ability"
                            },
                            {
                                "example_id": "857cf46e-8bf9-44f9-a31f-1b66a371f0a6",
                                "sense_id": "241eb83d-24bc-3983-ae6e-898829c54a5f",
                                "text": "fishlike smell"
                            },
                            {
                                "example_id": "10e84205-94bd-40c5-a8f7-ec569d3d80b0",
                                "sense_id": "241eb83d-24bc-3983-ae6e-898829c54a5f",
                                "text": "His skin was as scaly as those of some fish I'd seen. His nose was distorted—flattened from having been broken several times—and that enhanced his fishlike appearance."
                            },
                            {
                                "example_id": "ee2ebe3c-6d06-46df-913a-3d8c59cde017",
                                "sense_id": "241eb83d-24bc-3983-ae6e-898829c54a5f",
                                "text": "The most striking marine reptiles are the fishlike or porpoiselike ichthyosaurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89bfb65f-8402-4cf2-8ddb-de467a66b6b2",
                        "source_entry_id": "ba3eee7a-0ce1-3291-9224-1b95516e6f6c",
                        "source_sense_id": "241eb83d-24bc-3983-ae6e-898829c54a5f",
                        "source_sense_description": "like a fish",
                        "target_lang_word": "fischartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fischartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f4eab8c-a9b3-329d-b36c-408ced514374",
                                        "entry_id": "3e7ec6aa-b7a3-3ccf-a94e-a1d91301ac8f",
                                        "glosses": [
                                            "wie ein Fisch geartet, aussehend oder wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915cc511-3e77-4fea-8772-a961cd4a1849",
                                                "sense_id": "1f4eab8c-a9b3-329d-b36c-408ced514374",
                                                "text": "Im Teich sah ich ein fischartiges Wesen schwimmen."
                                            },
                                            {
                                                "example_id": "fbf7f960-66b4-4f11-bcd3-d244dcfac2bb",
                                                "sense_id": "1f4eab8c-a9b3-329d-b36c-408ced514374",
                                                "text": "„Vor rund 360 Millionen Jahren dann hatten sich bei einem fischartigen Wirbeltier aus zwei Paar Flossen vier Beine entwickelt, und es krabbelte unbeholfen an Land.“"
                                            },
                                            {
                                                "example_id": "26b81a13-803d-4716-8067-92e753a4b2e6",
                                                "sense_id": "1f4eab8c-a9b3-329d-b36c-408ced514374",
                                                "text": "„Großvater zieht kräftig an seiner Zigarre und stößt eine stinkende Qualmwolke mit fischartig geöffnetem Mund in die Luft.“"
                                            },
                                            {
                                                "example_id": "afe7b910-1f5b-42fd-8f81-1d4bf4315925",
                                                "sense_id": "1f4eab8c-a9b3-329d-b36c-408ced514374",
                                                "text": "„Die lang gestreckten, unten flachen Raupen leben auf Bäumen, kriechen halb spannerartig und bewegen sich beunruhigt lebhaft fischartig zappelnd.“"
                                            },
                                            {
                                                "example_id": "7cbffa0a-423d-45ff-a6ee-2d74eeb18352",
                                                "sense_id": "1f4eab8c-a9b3-329d-b36c-408ced514374",
                                                "text": "„Ihre fischartig vorstehenden Augen lugten durch die Scheibe nach der Kundschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
