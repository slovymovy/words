                                        "entry_id": "0626db22-b2e8-398d-a05f-30b88435e6fe",
                                        "glosses": [
                                            "Any of various small trees of the genus Cornus, especially the wild cornel and the flowering cornel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18cfa5f5-879a-39d6-9a45-f20c0cefd765",
                                        "entry_id": "0626db22-b2e8-398d-a05f-30b88435e6fe",
                                        "glosses": [
                                            "The wood of such trees and shrubs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecce120c-1f4d-3b89-a6e5-070fbe1c5c0c",
                                        "entry_id": "0626db22-b2e8-398d-a05f-30b88435e6fe",
                                        "glosses": [
                                            "A wood or tree similar to this genus, used in different parts of the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2401def6-7213-4916-bf79-9420aabb6d72",
                        "source_entry_id": "b8b3f2bc-456f-313d-ba90-f61c7ebd4020",
                        "target_lang_word": "cornel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cornel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2570db24-1a26-3228-b5ab-98695c82ebc6",
                                        "entry_id": "956c6b9c-1398-36c5-bdf1-4829c953b8c5",
                                        "glosses": [
                                            "Any tree or shrub of the dogwood subgenera, Cornus subg. Arctocrania (syn. Cornus subg. Chamaepericlymenum) or Cornus subg. Cornus, especially Cornus mas, the European cornel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7df4ba6e-dc39-3a87-ba8b-4b0393736f33",
                                        "entry_id": "956c6b9c-1398-36c5-bdf1-4829c953b8c5",
                                        "glosses": [
                                            "The cherry-like fruit of such plants, certain of which are edible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8541c6-ab74-4e48-a7cf-08559384a70b",
                                                "sense_id": "7df4ba6e-dc39-3a87-ba8b-4b0393736f33",
                                                "text": "Cornels, and ſalvage Berries of the Wood, / And Roots and Herbs have been my meagre Food."
                                            },
                                            {
                                                "example_id": "8877faf0-de7e-4dc3-9c16-006fcc11c4de",
                                                "sense_id": "7df4ba6e-dc39-3a87-ba8b-4b0393736f33",
                                                "text": "Meanwhile the goddess in disdain bestows / The mast and acorn, brutal food! and strows / The fruits and cornel, as their feast, around"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
