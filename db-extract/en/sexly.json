                        ],
                        "examples": [
                            {
                                "example_id": "5b4970b5-1a29-41fd-b0a1-654b1df96203",
                                "sense_id": "b1be3018-a000-3756-bb8e-778dc6325da7",
                                "text": "Should I ascribe any of these things unto myself or my sexly weaknesse, I were not worthy to live."
                            },
                            {
                                "example_id": "2e12be2d-2446-42a4-874a-1ae6a6851ddb",
                                "sense_id": "b1be3018-a000-3756-bb8e-778dc6325da7",
                                "text": "For surely in that time were those possessed\nOf Demons — making men's hearts a foul nest\nFor other thoughts besides the sexly crime.\nPerchance, tho' seven Demons in her breast\nSuch passions varied that gave her no rest\nLike Envy, Hate and Malice, which her soul had nursed\nUntil her mind—desires and life accursed.\nI have to think that Mary surely pure\nOf sexly passion—in that way demure—\nBut violent otherwise in fits of spite."
                            }
                        ]
                    }
