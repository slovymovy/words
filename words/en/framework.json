                    "sense_id": "e11284a1-4ed8-3d92-a50f-0adbb14a3efa",
                    "sense_definition": "A basic conceptual structure used to organize ideas, theories, or systems.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "conceptual_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers developed a new theoretical <w>framework</w> to study the effects of climate change on local agriculture.",
                            "target_lang_translations": {
                                "ru": "Исследователи разработали новую теоретическую <w>базу</w> для изучения влияния изменения климата на местное сельское хозяйство."
                            }
                        },
                        {
                            "text": "We need to establish a clear conceptual <w>framework</w> before we can begin the detailed analysis of the data.",
                            "target_lang_translations": {
                                "ru": "Нам необходимо установить четкие концептуальные <w>рамки</w>, прежде чем мы сможем приступить к детальному анализу данных."
                            }
                        }
                    ],
                    "synonyms": [
                        "structure",
                        "schema",
                        "model",
                        "system"
                    ],
                    "common_phrases": [
                        "conceptual framework",
                        "theoretical framework",
                        "within the framework",
                        "legal framework"
                    ],
                    "target_lang_definitions": {
