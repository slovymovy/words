                "forms": [
                    {
                        "form_id": "d003f523-0b9d-4027-b388-20d250520da8",
                        "entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "isomorphes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17b7363c-07f4-3b58-8236-4538ffcd62e9",
                        "entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "glosses": [
                            "Qui affecte la même forme cristalline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0afb726-2f00-40db-acf3-5bc923b128f3",
                                "sense_id": "17b7363c-07f4-3b58-8236-4538ffcd62e9",
                                "text": "Comme le nom l’indique, les corps isomorphes sont donc ceux qui cristallisent de la même manière et qui par suite sont capables de se mêler ou de se superposer dans un cristal sans en changer la forme."
                            },
                            {
                                "example_id": "f76f3d23-36a5-4ade-95a1-05169ed59269",
                                "sense_id": "17b7363c-07f4-3b58-8236-4538ffcd62e9",
                                "text": "Substances isomorphes."
                            },
                            {
                                "example_id": "5602f3b6-8658-402c-b76f-34c49e29d091",
                                "sense_id": "17b7363c-07f4-3b58-8236-4538ffcd62e9",
                                "text": "Cristaux isomorphes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d2f361b-e5f2-3b1b-add7-6feb573296bb",
                        "entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "glosses": [
                            "Qui est égal modulo une bijection respectant les structures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1983f290-2669-4775-a064-23d6e0fc8358",
                                "sense_id": "0d2f361b-e5f2-3b1b-add7-6feb573296bb",
                                "text": "Ces groupes sont isomorphes."
                            },
                            {
                                "example_id": "0d4b11af-fae9-4d45-beb1-8c8edde0fffc",
                                "sense_id": "0d2f361b-e5f2-3b1b-add7-6feb573296bb",
                                "text": "La cloture algébrique de R est isomorphe au corps des nombres complexes (théorème fondamental de l'algèbre)."
                            },
                            {
                                "example_id": "2aab181d-bed1-4521-9535-754739e9a3bb",
                                "sense_id": "0d2f361b-e5f2-3b1b-add7-6feb573296bb",
                                "text": "Note : Pour certaines structures, l'adjectif isomorphe peut être remplacé par homéomorphe, difféomorphe, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d7c3b6a-9e28-3eca-883c-2bc32423b1f9",
                        "entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "glosses": [
                            "Qui a une forme identique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e455a1-5ea6-46e4-9640-8ff35dbd1bfd",
                                "sense_id": "4d7c3b6a-9e28-3eca-883c-2bc32423b1f9",
                                "text": "Tous les visages des Doelen sont isomorphes."
                            }
                        ]
                    },
                    {
                        "sense_id": "6775b59a-219a-3cc0-bfe6-1ccc6ae89dc9",
                        "entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "glosses": [
                            "Qui est organisé de manière identique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa76d26-ccde-469e-94c0-d01fd88243b3",
                                "sense_id": "6775b59a-219a-3cc0-bfe6-1ccc6ae89dc9",
                                "text": "Le vocabulaire français et le vocabulaire allemand ne sont pas du tout isomorphes, malgré la proximité géographique des pays où ces deux langues sont apparues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5053f995-20d7-4339-89c7-f41fae36680e",
                        "source_entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "target_lang_word": "isomorph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isomorph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "462c62f7-ac21-33e0-93ec-68d853e3dddd",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "von gleicher Art, Struktur, Form oder Gestalt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1382663-39f6-3412-a661-318ea3a27e7b",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "gleichgestaltig"
                                        ],
                                        "tags": [
                                            "Kristallographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b49276c2-2267-4bbb-9d37-77db5621f6e3",
                                                "sense_id": "d1382663-39f6-3412-a661-318ea3a27e7b",
                                                "text": "Diese beiden Kristalle sind isomorph, obwohl sie aus verschiedenen Elementen aufgebaut sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "14fc10ec-24fb-366a-8d81-9cb824cc00e6",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "ohne Steigerung, Mathematik: bedeutungsgleiche Teile zweier Strukturen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac71e31b-5f25-4606-9b67-d2ee1ca27ee6",
                                                "sense_id": "14fc10ec-24fb-366a-8d81-9cb824cc00e6",
                                                "text": "Ein Modell ist ein isomorphes Abbild der Realität."
                                            },
                                            {
                                                "example_id": "ade5f25f-dd2f-4ab8-b8bf-b3cb9d0223ad",
                                                "sense_id": "14fc10ec-24fb-366a-8d81-9cb824cc00e6",
                                                "text": "Zwei algebraische Strukturen sind isomorph, wenn es eine in beiden Richtungen eindeutige Übersetzung zwischen ihren Elementen und Operatoren gibt, und damit die Übersetzung des Wertes eines gültigen Terms in der einen Struktur stets gleich ist dem Wert desselben Terms, in dem man aber die eingehenden Elemente und Operatoren vorab in die andere Struktur übersetzt hätte. Einander entsprechende Elemente und Operatoren isomorpher Strukturen können ganz verschieden sein; gegenüber den anderen Elementen und Operatoren ihrer eigenen Struktur, also formal, spielen sie jedoch die völlig entsprechende Rolle. Isomorphe Strukturen sind deshalb in formaler Hinsicht gleich und unterscheiden sich voneinander nur in den Benennungen von Elementen und Operatoren."
                                            },
                                            {
                                                "example_id": "1e634d14-bd70-4782-b2cd-87c062f10945",
                                                "sense_id": "14fc10ec-24fb-366a-8d81-9cb824cc00e6",
                                                "text": "Eine Abbildung zwischen zwei mathematischen Strukturen, durch die Teile einer Struktur auf „bedeutungsgleiche“ Teile einer anderen Struktur umkehrbar eindeutig (bijektiv) abgebildet werden kann, ist isomorph."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "95b851ce-92d9-32ca-a5cd-7f75fcb649ec",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "mit gleich aussehender haploider und diploider Generation (die Generationen sind äußerlich nicht unterscheidbar, obwohl sich ihre Fortpflanzungsart von Generation zu Generation ändert)"
                                        ],
                                        "tags": [
                                            "(vom Generationswechsel)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c206e175-ff76-4766-8ad1-597ef3fb834d",
                                                "sense_id": "95b851ce-92d9-32ca-a5cd-7f75fcb649ec",
                                                "text": "Beim Meersalat liegt ein isomorpher Generationswechsel vor."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8fb43d74-51ec-30e3-868c-807b595ecf22",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "strukturell ähnlich (obwohl verschiedenen Ursprungs)"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f0ce41-52e1-452a-b77c-46f6448b1a02",
                                                "sense_id": "8fb43d74-51ec-30e3-868c-807b595ecf22",
                                                "text": "„[…] Wenn unterschiedliche Gegenstandsbereiche mit gleichen Theorien oder Modellen erforscht werden können,“ dann sind sie isomorph. „In diesem Falle gleicher struktureller Beziehungen lassen sich die für einen Gegenstand gültigen Gesetzesaussagen auf die Aussagen des anderen übertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9de320ea-b479-32f0-9cbc-ed7431f2ff5b",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "äußerlich gleichgestaltig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32172376-7064-40ad-aaf1-962f323eff9b",
                                                "sense_id": "9de320ea-b479-32f0-9cbc-ed7431f2ff5b",
                                                "text": "„Minerale mit gleicher äußerer Gestalt“ sind isomorph."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4425a284-0159-3891-afee-75c749e531ae",
                                        "entry_id": "4a594360-559f-38df-95fb-797e970eb034",
                                        "glosses": [
                                            "„gestaltgleich von äthologisch unterschiedlichen Krankheitsbildern“"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d8f6c2-e2fe-4972-b1f2-6f38156deb3d",
                        "source_entry_id": "6579b05e-f1fb-3091-a058-4404231dd6a8",
                        "target_lang_word": "isomorphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isomorphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc76d64b-b242-3787-ac39-7be73da783e4",
                                        "entry_id": "3a7eab2a-b08e-306c-bc21-ce07869564fb",
                                        "glosses": [
                                            "Related by an isomorphism; having a structure-preserving one-to-one correspondence."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac38c2c-0a9d-4a97-a043-8824a4a7ca06",
                                                "sense_id": "fc76d64b-b242-3787-ac39-7be73da783e4",
                                                "text": "Let A, B be the ordered sets in Figure 10.3. Let C be the direct product of infinitely many copies of the two element chain 2. Then A^C is isomorphic to B^C, but A is not isomorphic to B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33dbc17c-278e-346a-9bc2-357a8ac9ec80",
                                        "entry_id": "3a7eab2a-b08e-306c-bc21-ce07869564fb",
                                        "glosses": [
                                            "Having a similar structure or function to something that is not related genetically or through evolution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f0d8ce-18ab-4e5f-b5cf-29087eb36bb2",
                                                "sense_id": "33dbc17c-278e-346a-9bc2-357a8ac9ec80",
                                                "text": "The fact that different structures can be shown to be functionally isomorphic implies that they are analogous, not homologous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c4edbe-5e78-3f81-b2ae-87b7333a70b2",
                                        "entry_id": "3a7eab2a-b08e-306c-bc21-ce07869564fb",
                                        "glosses": [
                                            "Having identical relevant structure; being structure-preserving while undergoing certain invertible transformations."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9df7dcf4-f606-4df7-a12a-c3f1a7e71288",
                                                "sense_id": "37c4edbe-5e78-3f81-b2ae-87b7333a70b2",
                                                "text": "For example, in so far as written and spoken English are isomorphic (i.e. have the same structure), they are the same language: there is nothing but their structure that they have in common."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00eee1d5-9db9-3795-a94c-17014324664c",
                                        "entry_id": "3a7eab2a-b08e-306c-bc21-ce07869564fb",
                                        "glosses": [
                                            "Able to run either client-side or server-side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50a930a9-6fdd-49da-9292-722f1a463bf6",
                                                "sense_id": "00eee1d5-9db9-3795-a94c-17014324664c",
                                                "text": "an isomorphic JavaScript app"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
