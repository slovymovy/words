                                        "entry_id": "ad3bf57b-31b3-3dc1-afc0-a07c279b71e4",
                                        "glosses": [
                                            "voorwerp dat snel om zijn as tolt, waardoor de draaias de neiging heeft zijn stand te behouden"
                                        ],
                                        "tags": [],
