                        "entry_id": "05b0d1b6-3b8b-3072-ad4e-592c8b23d4f1",
                        "glosses": [
                            "Hectoring; swaggering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d0f91b-25a4-49b1-bc35-2e47dc3dac91",
                                "sense_id": "b7cbaf30-c860-30d3-beab-d1666d36c7a5",
                                "text": "Weele haue a ſwaſhing and marſhall outſide, / As manie other manniſh cowards haue, / That doe outface it with their ſemblances."
                            }
                        ]
                    },
                    {
                        "sense_id": "19954ae3-da8f-3d33-8c7e-9b3b8e05dcfa",
                        "entry_id": "05b0d1b6-3b8b-3072-ad4e-592c8b23d4f1",
                        "glosses": [
                            "Crushing; resounding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8dd849-3bf1-4606-9aef-2a2023c4a8da",
                                "sense_id": "19954ae3-da8f-3d33-8c7e-9b3b8e05dcfa",
                                "text": "Draw [your swords] if you be men, Gregorie, remember thy [ſ]waſhing blowe."
                            },
                            {
                                "example_id": "43836f38-6184-48b4-97e5-d11da71b5533",
                                "sense_id": "19954ae3-da8f-3d33-8c7e-9b3b8e05dcfa",
                                "text": "And with this ſwaſhing blow, do you ſwear Prince; / I could hulk your Grace, and hang you up croſs-legg'd, / Like a Hare at a Poulters, and do this with this wiper."
                            }
                        ]
                    }
