{
    "word_family": [
        "vigilant",
        "vigilance",
        "vigilante"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d622286a-c5bf-30cc-857c-a61731a94181",
                    "sense_definition": "An instance of staying awake during the night, often to pray or keep watch.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "watch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family held a midnight <w>vigil</w> to pray for their missing relative.",
                            "target_lang_translations": {
                                "pl": "Rodzina zorganizowała nocne <w>czuwanie</w>, aby modlić się za zaginionego krewnego."
                            }
                        },
                        {
                            "text": "She kept a lonely <w>vigil</w> by the bedside of her sick friend.",
                            "target_lang_translations": {
                                "pl": "Samotnie <w>czuwała</w> przy łóżku chorego przyjaciela."
                            }
                        }
                    ],
                    "synonyms": [
                        "watch"
                    ],
                    "common_phrases": [
                        "keep vigil"
                    ],
                    "target_lang_definitions": {
                        "pl": "Czuwanie w nocy, często połączone z modlitwą lub opieką nad kimś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "czuwanie",
                                "target_lang_sense_clarification": "stan bycia obudzonym w nocy, często w celach religijnych lub opiekuńczych"
                            },
                            {
                                "target_lang_word": "nocne czuwanie",
                                "target_lang_sense_clarification": "określenie podkreślające porę nocną"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6676e05-f59c-3df9-a0de-d84033611ae4",
                    "sense_definition": "A period of careful observation or surveillance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "watch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loyal dog kept a constant <w>vigil</w> outside the hospital door.",
                            "target_lang_translations": {
                                "pl": "Wierny pies nieustannie <w>czuwał</w> pod drzwiami szpitala."
                            }
                        },
                        {
                            "text": "Security guards maintained a strict <w>vigil</w> over the expensive jewelry collection.",
                            "target_lang_translations": {
                                "pl": "Ochroniarze utrzymywali ścisłą <w>wartę</w> nad kolekcją drogiej biżuterii."
                            }
                        }
                    ],
                    "synonyms": [
                        "watch",
                        "lookout"
                    ],
                    "common_phrases": [
                        "keep vigil"
                    ],
                    "target_lang_definitions": {
                        "pl": "Okres uważnej obserwacji lub nadzoru."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "warta",
                                "target_lang_sense_clarification": "pełnienie straży lub obserwacja"
                            },
                            {
                                "target_lang_word": "obserwacja",
                                "target_lang_sense_clarification": "uważne śledzenie sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c2518db-39be-37f0-b1a0-88d503256f68",
                    "sense_definition": "A quiet public demonstration held to show support for a cause.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "demonstration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Protesters held a peaceful <w>vigil</w> outside the government building.",
                            "target_lang_translations": {
                                "pl": "Protestujący zorganizowali pokojowe <w>czuwanie</w> przed budynkiem rządowym."
                            }
                        },
                        {
                            "text": "Hundreds of people joined the <w>vigil</w> to support human rights.",
                            "target_lang_translations": {
                                "pl": "Setki ludzi dołączyły do <w>czuwania</w> w obronie praw człowieka."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a vigil"
                    ],
                    "target_lang_definitions": {
                        "pl": "Spokojna demonstracja publiczna wyrażająca poparcie dla jakiejś sprawy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "czuwanie",
                                "target_lang_sense_clarification": "pokojowa manifestacja, często z użyciem świec"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f052f292-32e2-3524-b7b2-4c7696686cee",
                    "sense_definition": "The evening before a religious festival, traditionally marked by prayer and staying awake.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church service was held on the <w>vigil</w> of the holy feast day.",
                            "target_lang_translations": {
                                "pl": "Nabożeństwo odbyło się w <w>wigilię</w> święta."
                            }
                        },
                        {
                            "text": "Many believers attended the midnight <w>vigil</w> before the holiday began.",
                            "target_lang_translations": {
                                "pl": "Wielu wiernych wzięło udział w nocnym <w>czuwaniu</w> przed rozpoczęciem święta."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wieczór poprzedzający święto religijne, tradycyjnie związany z modlitwą."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wigilia",
                                "target_lang_sense_clarification": "dzień lub wieczór poprzedzający święto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2cd0da9a-4303-3a3e-9089-23d2f266bc12",
                    "sense_definition": "To participate in a vigil.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "demonstration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The activists <w>vigiled</w> silently in front of the city hall all night.",
                            "target_lang_translations": {
                                "pl": "Aktywiści <w>czuwali</w> w milczeniu przed ratuszem przez całą noc."
                            }
                        },
                        {
                            "text": "They <w>vigiled</w> for peace while holding candles in the town square.",
                            "target_lang_translations": {
                                "pl": "<w>Czuwali</w> w intencji pokoju, trzymając świece na rynku miasta."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Uczestniczyć w czuwaniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "czuwać",
                                "target_lang_sense_clarification": "brać udział w czuwaniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6a438280-6f2d-3327-bcd4-c09200584ce3",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is named Sarah <w>Vigil</w>.",
                            "target_lang_translations": {
                                "pl": "Autorka artykułu nazywa się Sarah <w>Vigil</w>."
