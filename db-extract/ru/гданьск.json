                                        "sense_id": "9347a525-aa66-32f0-b10d-71bb0f7c0e15",
                                        "entry_id": "2cbd66f9-1251-390e-b6c9-12413de3e902",
                                        "glosses": [
                                            "Großstadt und Hafenstadt in Polen, ehemalige Hansestadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "821e03ea-2664-4f71-ad34-5edd43203a56",
                                                "sense_id": "9347a525-aa66-32f0-b10d-71bb0f7c0e15",
                                                "text": "Danzig bildet zusammen mit Gdingen, Zoppot und kleineren Städten den Ballungsraum Dreistadt mit einer Million Einwohnern."
                                            },
                                            {
                                                "example_id": "7db79b03-b987-40c4-be68-822f01dc9181",
                                                "sense_id": "9347a525-aa66-32f0-b10d-71bb0f7c0e15",
                                                "text": "„Durch den Versailler Vertrag, der am 10.1.1920 in Kraft trat, wurde die Stadt Danzig mit Umgebung vom Deutschen Reich abgetrennt und zur selbständigen freien Stadt unter dem Schutz des Völkerbunds erklärt.“"
                                            },
                                            {
                                                "example_id": "16014334-bb2e-4011-a476-fdd85c6f9626",
                                                "sense_id": "9347a525-aa66-32f0-b10d-71bb0f7c0e15",
                                                "text": "„Das Stadtmuseum und das Weltkriegsmuseum von Danzig wollen mit der Fotoausstellung auf ein wenig bekanntes Kapitel lokaler Geschichte im Zweiten Weltkrieg hinweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cec2d942-a070-3a4c-a28e-56471cfd40b7",
                                        "entry_id": "2cbd66f9-1251-390e-b6c9-12413de3e902",
                                        "glosses": [
                                            "ein Asteroid des Hauptgürtels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e16c5ca-198b-4fc8-a233-8a6487f9b66b",
                                                "sense_id": "cec2d942-a070-3a4c-a28e-56471cfd40b7",
                                                "text": "Danzig wurde 1929 vom deutschen Astronomen Karl Wilhelm Reinmuth entdeckt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Danzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff03fc2b-0f71-311a-8df8-97fa3f607976",
                                        "entry_id": "e66011ab-520a-3a35-a760-1ca546580812",
