                    {
                        "sense_id": "de93043b-01bd-3703-8cca-d7181106e895",
                        "entry_id": "7228a478-e82a-315c-9657-4fa5197b2d17",
                        "glosses": [
                            "Danse traditionnelle tahitienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2097700-587a-43ba-9973-4715f29eaf8d",
                                "sense_id": "de93043b-01bd-3703-8cca-d7181106e895",
                                "text": "Les danses qui mimaient les mouvements de l’accouplement comme les ’upa’upa, furent interdites et les autres danses dans le même élan."
                            },
                            {
                                "example_id": "df890fb1-c5cf-4ecd-bb1b-0084676a111b",
                                "sense_id": "de93043b-01bd-3703-8cca-d7181106e895",
                                "text": "De grandes festivités suivent le pillage, en particulier les ’upa’upa, jeux et danses de la société des ’Arioi avec simulacres de combat entre des champions des hommes et des champions des dieux comme nous le verrons infra."
                            },
                            {
                                "example_id": "b3f3d81e-8338-4b6b-be45-4ba65ab846ee",
                                "sense_id": "de93043b-01bd-3703-8cca-d7181106e895",
                                "text": "L’un des premiers gestes du premier gouverneur français de Tahiti est de réautoriser (en 1845, aux fêtes du « protectorat ») les danses ’upa’upa interdites pour cause de « lascivité »."
                            }
                        ]
                    }
