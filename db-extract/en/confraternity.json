                    },
                    {
                        "sense_id": "08808b62-5655-38f5-a56d-b197b0708677",
                        "entry_id": "4b0baea2-7652-33d9-8994-dfd081e02201",
                        "glosses": [
                            "Gemeinschaft, Genossenschaft"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34fb0042-e8e6-49b9-965a-2af421965950",
                        "source_entry_id": "4b0baea2-7652-33d9-8994-dfd081e02201",
                        "source_sense_id": "fa8e20a9-9aab-37f1-a18f-9d76e3d36027",
                        "source_sense_description": "Bruderschaft, Sekte",
                        "target_lang_word": "Bruderschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bruderschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9374bc8c-3d5b-328f-a4c5-4cd8df7f69e8",
                                        "entry_id": "a894ef13-75f8-35ed-9c4c-ff13c0f6e5c0",
                                        "glosses": [
                                            "Blutsverwandtschaft mehrerer Familien derselben Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcdf02e1-464b-3a40-b6c7-6e397ef39768",
                                        "entry_id": "a894ef13-75f8-35ed-9c4c-ff13c0f6e5c0",
                                        "glosses": [
                                            "religiöse Körperschaft von Geistlichen und Laien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4869a3fa-028f-435a-b8ed-6e953e7e84d5",
                                                "sense_id": "dcdf02e1-464b-3a40-b6c7-6e397ef39768",
                                                "text": "Schnell fanden sich viele Bürger, die in der neuen Pfarre eine Bruderschaft gründen wollten."
                                            },
                                            {
                                                "example_id": "db8df115-c197-43cd-a6e7-d3b78e6041ad",
                                                "sense_id": "dcdf02e1-464b-3a40-b6c7-6e397ef39768",
                                                "text": "„Erwachsen aus einer Bruderschaft zur Krankenpflege, die sich im Heiligen Land am Ende des Dritten Kreuzzugs zusammengefunden hatte, war er nach dem Vorbild der Templer und Johanniter in den Stand eines Ritterordens erhoben worden und hatte sich rasch in Europa ausgebreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7073f563-774d-3ecf-893e-45b8ebb3287d",
                                        "entry_id": "a894ef13-75f8-35ed-9c4c-ff13c0f6e5c0",
                                        "glosses": [
                                            "gewerkschaftliche Körperschaft von Gildenbrüdern oder Gewerkschaftsbrüdern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf308da-0643-45e6-93f7-208cd4a08470",
                                                "sense_id": "7073f563-774d-3ecf-893e-45b8ebb3287d",
                                                "text": "„Die in Wien seit dem 13. Jahrhundert nachweisbaren Bruderschaften waren Vereine mit Rechtspersönlichkeit, eigenem Vermögen (genannt Zeche, danach im weiteren Sinn Zeche = Bruderschaft) und periodisch gewählten Organen.“"
                                            },
                                            {
                                                "example_id": "ebfb4ef6-95fa-4334-ad5a-3c141aae4bed",
                                                "sense_id": "7073f563-774d-3ecf-893e-45b8ebb3287d",
                                                "text": "„Es waren absolut harmlose Leute, die hier aus und ein gingen und deren Spleen einzig und allein der war, daß sie sich nicht KLub oder Verein, sondern Loge oder Bruderschaft nannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa246e18-6dbc-4495-8fbd-e3d7bd99029b",
                        "source_entry_id": "4b0baea2-7652-33d9-8994-dfd081e02201",
                        "source_sense_id": "fa8e20a9-9aab-37f1-a18f-9d76e3d36027",
                        "source_sense_description": "Bruderschaft, Sekte",
                        "target_lang_word": "Sekte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sekte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b75786-5e7f-31fc-bc1a-fbb4ec5acb15",
                                        "entry_id": "8e7004c2-2d3a-3028-842f-a8b655a3224b",
                                        "glosses": [
                                            "von großen Religionsgemeinschaften abgelöste kleine Glaubensgemeinschaft"
                                        ],
                                        "tags": [
                                            "ursprünglich wertneutral, heute oft abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419cbad4-6aa1-435c-ab79-ba85d36436bd",
                                                "sense_id": "a2b75786-5e7f-31fc-bc1a-fbb4ec5acb15",
                                                "text": "Viele Jugendliche finden Aufnahme bei Sekten."
                                            },
                                            {
                                                "example_id": "eb3bb8a3-b2d9-4207-b6a2-dacd616b0945",
                                                "sense_id": "a2b75786-5e7f-31fc-bc1a-fbb4ec5acb15",
                                                "text": "„Archie lag zwar bei Einzelheiten daneben, aber durch seine unerwartete Parabel lernte ich eine mächtige Sekte kennen, die immer noch viele Anhänger hat.\""
                                            },
                                            {
                                                "example_id": "f2884b26-ce12-4cca-8997-56e338cbaff2",
                                                "sense_id": "a2b75786-5e7f-31fc-bc1a-fbb4ec5acb15",
                                                "text": "„Ihr Land wurde von einem Dutzend anderer Länder zerbombt, es musste ein diktatorisches Regime, zwölf Geheimdienste und mehrere radikale religiöse Sekten ertragen, die alle bis an die Zähne bewaffnet waren.“"
                                            },
                                            {
                                                "example_id": "c4eac1b2-1c4c-4649-b07a-ba633090865f",
                                                "sense_id": "a2b75786-5e7f-31fc-bc1a-fbb4ec5acb15",
                                                "text": "„Die Familie gehörte einer strengen Sekte an, in der der Vater der Protagonist war, wenn es darum ging, religiöse Dogmen in praktisches Alltagsverhalten umzusetzen.“"
                                            },
                                            {
                                                "example_id": "0d6bd8d1-2a26-405f-b862-7925c479e866",
                                                "sense_id": "a2b75786-5e7f-31fc-bc1a-fbb4ec5acb15",
                                                "text": "„Die griechischen philosophischen Richtungen, die sich nach dem Tod des Sokrates herausgebildet hatten, sind zu konkurrierenden Sekten mit Distinktionsfuror herabgekommen, dazu haben sich allerlei Kulte und mystische Geheimlehren eingefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sekte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b99f984d-df51-3269-8b21-669826ada651",
                                        "entry_id": "b2e70f16-fdb8-3825-a5c0-6e5f812288b0",
