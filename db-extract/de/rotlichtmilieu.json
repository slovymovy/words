                "senses": [
                    {
                        "sense_id": "e5087349-0b67-3c92-9f43-a58bfb68a13a",
                        "entry_id": "6c225898-feb0-3527-b0d6-27efa39565fa",
                        "glosses": [
                            "sozialer Bereich, in dem sexorientiertes Gewerbe angesiedelt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b87d27b-4487-4a22-8356-06ee650b3936",
                                "sense_id": "e5087349-0b67-3c92-9f43-a58bfb68a13a",
                                "text": "„Es ist durchaus üblich, dass in Verträgen des Rotlichtmilieus ausdrücklich geregelt wird, dass es sich zwar um keine Anstellung im arbeitsrechtlichen Sinne handele, obwohl eine exklusive Tätigkeit nur für ein Unternehmen vereinbart wird, die Sozialversicherungspflichten und die Versteuerung daher nicht den Unternehmen oblägen.“"
                            },
                            {
                                "example_id": "264fd845-a189-4f99-b8cf-af1394dc40e1",
                                "sense_id": "e5087349-0b67-3c92-9f43-a58bfb68a13a",
                                "text": "„Die Libanesen seien beliebte Leibwächter im Rotlichtmilieu.“"
                            },
                            {
                                "example_id": "d1f1595c-8e93-413b-b632-3ebed29c7408",
                                "sense_id": "e5087349-0b67-3c92-9f43-a58bfb68a13a",
                                "text": "„Sie kamen zur Kaiserstraße, die durch das Rotlichtmilieu zum Hauptbahnhof führt.“"
                            },
                            {
                                "example_id": "77a104b5-cd09-4702-8118-bb18b1605aa4",
                                "sense_id": "e5087349-0b67-3c92-9f43-a58bfb68a13a",
                                "text": "„Wie viele deutsche Großstädte verfügt auch Bochum über ein Rotlichtmilieu.“"
                            }
                        ],
