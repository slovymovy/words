                                "target_senses": [
                                    {
                                        "sense_id": "4dd06e58-ab1f-3e8b-b924-78baf18d9096",
                                        "entry_id": "8774d92f-513f-36ed-978d-6a4142ef9572",
                                        "glosses": [
                                            "okręg administracyjny w starożytnym Iranie"
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387a8080-e3ba-45a1-ad55-ae620a094fa8",
                                                "sense_id": "4dd06e58-ab1f-3e8b-b924-78baf18d9096",
                                                "text": "W okresach, w których następowało osłabienie władzy centralnej w państwie, satrapie uzyskiwały praktycznie niepodległość, szczególnie kiedy satrapa łączył władzę cywilną i wojskową w swojej satrapii"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8905efab-e799-4e66-951d-c8468eb268c1",
                        "source_entry_id": "06da4470-486b-3004-a016-6086476b165f",
                        "target_lang_word": "satrapie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satrapie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01a8d694-6879-37e7-8e3f-de048ba60e7a",
                                        "entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                                        "glosses": [
                                            "Gouvernement d’un satrape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d29fecb-45c9-4bd9-a448-31523223e13b",
                                                "sense_id": "01a8d694-6879-37e7-8e3f-de048ba60e7a",
                                                "text": "Les mages d’Atropatène, munis de pyrées ambulants montés sur des chars de prière, pénétrèrent dans le pays derrière les cavaliers et, parcourant une à une les satrapies arméniennes, s’acharnèrent à éteindre les croyances locales et à humilier les divinités dissidentes."
                                            },
                                            {
                                                "example_id": "79d39e2c-a49c-4125-8ca4-db5a26b423e2",
                                                "sense_id": "01a8d694-6879-37e7-8e3f-de048ba60e7a",
                                                "text": "Pour faire corps et chair et renverser les satrapies existantes, un autre type d'intelligence sociale et d'imagination culturelle est à inventer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "351570b5-944d-3e15-ad05-4a0d9d8d42c0",
                                        "entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                                        "glosses": [
                                            "(par extension) Gouvernement despotique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640333fa-7d32-43f2-82a1-fc5887a3f154",
                                                "sense_id": "351570b5-944d-3e15-ad05-4a0d9d8d42c0",
                                                "text": "Près de quarante ans après que « le vent de l’est » eut emporté les satrapies africaines de la guerre froide, et malgré la « relance » qu’aurait pu être le Printemps arabe, l’état de la démocratie en Afrique atteste ce fait ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
