        "fr-extract.jsonl": [
            {
                "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                "word": "lyrisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a853f883-512d-48fd-97ac-4ad792a69889",
                        "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                        "tags": [
                            "plural"
                        ],
                        "form": "lyrismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b2d5a61-c3ab-3e83-87b4-9cafaaf09259",
                        "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                        "glosses": [
                            "Qualité, ensemble de qualités constituant le caractère d’un style, soit dans les sentiments et les idées, soit dans le mouvement et la couleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6371345b-4690-42d6-9d9b-a8d885855cb0",
                                "sense_id": "8b2d5a61-c3ab-3e83-87b4-9cafaaf09259",
                                "text": "Il y a trop de lyrisme dans sa prose."
                            },
                            {
                                "example_id": "94acf25e-b6d3-4bee-9a79-a8352ab8078a",
                                "sense_id": "8b2d5a61-c3ab-3e83-87b4-9cafaaf09259",
                                "text": "Je te ferai bonne mesure de lyrisme funèbre, et l’orthographe sera mieux mise qu’une duchesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb4160ed-ed56-3aac-ac9f-4dd033a62da8",
                        "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                        "glosses": [
                            "Certaine exaltation d’esprit analogue à l’enthousiasme des poètes lyriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6692b5d-65ba-4166-9c56-2fc8b808380e",
                                "sense_id": "eb4160ed-ed56-3aac-ac9f-4dd033a62da8",
                                "text": "Un lyrisme intime bouillonna dans cette âme pleine des belles illusions de la jeunesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "998e15b0-eb7d-31b8-9403-62856ab89ca6",
                        "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                        "glosses": [
                            "Tonalité qui met en avant l’expression des sentiments personnels."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57b2a9e2-d010-4dca-8d8d-564b51935fee",
                        "source_entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                        "target_lang_word": "Lyrik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lyrik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1abd955-3d6b-3728-b451-1b7c000535f3",
                                        "entry_id": "2ac77c8a-f225-3f8c-abb5-6b1fc9cc2e60",
                                        "glosses": [
                                            "Kunstform der Literatur (Gedicht)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd35e7b-b23a-48eb-abb3-fa392ee507cd",
                                                "sense_id": "a1abd955-3d6b-3728-b451-1b7c000535f3",
                                                "text": "Die Lyrik wurde und wird immer wieder auch von der populären Musikkultur beeinflusst."
                                            },
                                            {
                                                "example_id": "e41231fc-da5e-426f-ac1a-aaecfd1359aa",
                                                "sense_id": "a1abd955-3d6b-3728-b451-1b7c000535f3",
                                                "text": "„Das große Zeitgefühl hatte uns ergriffen, ob wir uns nun für die ersten Aeroplanflieger oder für die neue Lyrik begeisterten, wir hatten eine Tür aufgestoßen, wir waren unterwegs, wir konnten nicht mehr zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "223f0923-fa73-3077-9c68-723330b96a3f",
                                        "entry_id": "2ac77c8a-f225-3f8c-abb5-6b1fc9cc2e60",
                                        "glosses": [
                                            "gedichtetes Werk eines Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45623f5a-7ec5-4bf0-bc41-cd4dc3872a2e",
                                                "sense_id": "223f0923-fa73-3077-9c68-723330b96a3f",
                                                "text": "„Derlei spekulative Erwägungen sind Reiner Wild fremd. In seiner umfangreichen Studie über \"Goethes klassische Lyrik\" geht es ihm vielmehr um den linearen Nachweis, daß diese Lyrik \"Teil und Ausdruck des 'Projekts Klassik'\" sei, mit dem \"Goethe und Schiller in gemeinsamer Arbeit auf tiefgreifende Krisenerfahrungen am Ende des 18. Jahrhunderts\" antworteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb17e8be-f6b8-4fa8-9383-7f2dc4d99307",
                        "source_entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                        "target_lang_word": "lyricism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lyricism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57d2397a-101d-31b9-b77b-8e05f5f6224a",
                                        "entry_id": "942f7849-20f2-3f65-b47a-8556fb36d502",
                                        "glosses": [
                                            "Great enthusiasm."
