            {
                "entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
                "word": "pédalo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0b3a2919-4604-4f13-a6a4-75083c583117",
                        "entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
                        "tags": [
