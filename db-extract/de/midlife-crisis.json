                    {
                        "form_id": "bb858ac6-4917-45a3-bf9c-9360d04b0859",
                        "entry_id": "fa6a2024-806c-3c33-9bd9-de186c974a7c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Midlife-Crisis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                        "entry_id": "fa6a2024-806c-3c33-9bd9-de186c974a7c",
                        "glosses": [
                            "psychische Krise im Leben eines Menschen (meist eines Mannes), die im mittleren Alter auftritt und in der die betroffene Person in dem Glauben ist, in ihrem Leben nichts erreicht zu haben, obwohl sie dieses schon zur Hälfte hinter sich hat (kann unter anderem eine tiefe Depression hervorrufen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5031099f-0a52-484a-933f-f3674f34edca",
                                "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                                "text": "Mein Mann durchlebt gerade seine Midlife-Crisis."
                            },
                            {
                                "example_id": "828bb0fa-6a42-40c0-8f74-f995623f4334",
                                "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                                "text": "Nicht jeder Mann wird von der Midlife-Crisis befallen."
                            },
                            {
                                "example_id": "060c19d0-7675-40d3-8244-c160e04a3a0d",
                                "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                                "text": "Die Midlife-Crisis ist so etwas wie die zweite Pubertät des Mannes."
                            },
                            {
                                "example_id": "f2f7b2b9-a22d-44b0-8829-fa550baaef8b",
                                "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                                "text": "„Natürlich denke ich manchmal darüber nach, dass mein Mann in der Midlife-Crisis mit einer netten Kundin, nein, Angestellten, nein, Kollegin oder Vertreterin durchbrennen könnte, und wenn das passieren sollte, dann ist auch die Buchhandlung Geschichte.“"
                            },
                            {
                                "example_id": "14cadf28-9de7-4390-a9c6-5b558d756fba",
                                "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                                "text": "„Für einen Mann, der so sehr aufs Geld achtete, schien Reg mir im Zuge seiner Midlife-Crisis eine bemerkenswerte Wandlung durchgemacht zu haben.“"
                            },
                            {
                                "example_id": "dd3b1383-5816-4b1e-95aa-8cbe5c0eacfb",
                                "sense_id": "b57dd722-029e-3a85-ad32-e90c39c6ad8e",
                                "text": "„Für eine Midlife-Crisis bin ich entschieden zu alt. Wahrscheinlich ist es eine allgemeine Sinnkrise, die mich beutelt. Ich liege in meinem schönen Hotelzimmer, schaue hinaus auf den Leuchtturm und frage mich: Was soll das alles?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
