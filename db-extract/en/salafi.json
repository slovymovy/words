                        ]
                    },
                    {
                        "translation_id": "dac9b25d-db5d-4704-a0a1-cb013b86e13d",
                        "source_entry_id": "a4cc429d-99d8-31a2-a7fd-65b85185214d",
                        "source_sense_id": "cf1532d8-b48e-35c3-b9bc-87caedf457c6",
                        "source_sense_description": "of or pertaining to Salafism",
                        "target_lang_word": "salafistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salafistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "130e5774-2dcb-36ae-81c4-573b0af1854f",
                                        "entry_id": "8cfc8c4f-79ea-3ae9-9f40-9b41b483296b",
                                        "glosses": [
                                            "in der Art des Salafismus, dem Salafismus zugehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c48f46c3-948d-45d4-a6b1-4ed4cc191347",
                                                "sense_id": "130e5774-2dcb-36ae-81c4-573b0af1854f",
                                                "text": "„In Deutschland verzeichnet das salafistische Spektrum seit Jahren steigende Anhängerzahlen.“"
                                            },
                                            {
                                                "example_id": "fc342392-9b6a-482b-a230-01d76dc79b49",
                                                "sense_id": "130e5774-2dcb-36ae-81c4-573b0af1854f",
                                                "text": "„Nach Interviews mit Islamwissenschaftlern aus Polizei und Verfassungsschutz, die wegen des sensiblen Themas anonym bleiben wollten, wird klar, dass in der salafistischen Szene in den vergangenen Monaten eine Radikalisierung stattgefunden hat, die, so die Befürchtung eines Verfassungsschützers, in einen „urbanen Terrorismus“ abgleiten könnte.“"
                                            },
                                            {
                                                "example_id": "9cad0121-2bcd-41cc-98e2-bb95c2cb0c79",
                                                "sense_id": "130e5774-2dcb-36ae-81c4-573b0af1854f",
                                                "text": "„Auch wenn die mutmaßliche Vorgänger-Organisation \"Millatu Ibrahim\" schon länger verboten ist, spielen deren ehemalige Mitglieder immer noch eine wichtige Rolle in der salafistischen Szene - auch in Schleswig-Holstein.“"
                                            },
                                            {
                                                "example_id": "cde1508c-a1a3-40e7-9f0a-8c5acea3a619",
                                                "sense_id": "130e5774-2dcb-36ae-81c4-573b0af1854f",
                                                "text": "„Besonders junge Leute sind anfällig für extremistisch-salafistisches Werben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
