                "forms": [],
                "senses": [
                    {
                        "sense_id": "da314598-f4b4-3a4c-bc99-e57ccd93aaaa",
                        "entry_id": "15c01ef4-e251-386d-9bcc-beed6448357d",
                        "glosses": [
                            "Petit oiseau de l’île de la Réunion, de la famille des muscicapidés, de nom scientifique Saxicola tectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60e07470-63f3-467c-90f2-a67804e0062a",
                                "sense_id": "da314598-f4b4-3a4c-bc99-e57ccd93aaaa",
                                "text": "Parmi les autres espèces rares originaires des hautes terres, citons encore le tec-tec, ou traquet de La Réunion (son nom créole est une onomatopée), et le papangue, ou busard de La Réunion, rapace protégé semblable à un faucon."
                            },
                            {
                                "example_id": "5fec9cf3-f16e-4ee1-a13c-df76d92e5372",
                                "sense_id": "da314598-f4b4-3a4c-bc99-e57ccd93aaaa",
                                "text": "Le tec-tec, moineau à la tête noire et à la gorge blanche, sautille volontiers en bordure du chemin à ses côtés."
                            }
                        ]
                    },
                    {
                        "sense_id": "e35bfb13-1c80-3c4c-986a-8ae4d4614745",
                        "entry_id": "15c01ef4-e251-386d-9bcc-beed6448357d",
                        "glosses": [
                            "Nom donné à l'île Maurice et aux Seychelles à des coquillages du genre Donax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e92aac97-ad0e-4b02-9ea9-dd45b3e3cc74",
                                "sense_id": "e35bfb13-1c80-3c4c-986a-8ae4d4614745",
                                "text": "D’excellents petits coquillages habitent également le lagon de Rodrigues : le cono-cono et le burgot, servis en salade, ou encore le tec-tec, préparé en salade, gratiné ou servi en bouillon."
                            },
                            {
                                "example_id": "fbf5eafc-fc24-4386-b59b-9fbbc2b11801",
                                "sense_id": "e35bfb13-1c80-3c4c-986a-8ae4d4614745",
                                "text": "Ajoutez-y quelques tec-tec, un coquillage bivalve hermaphrodite que l’on trouve sur nos plages."
                            }
                        ]
                    }
                ],
