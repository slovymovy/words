                "translations": [
                    {
                        "translation_id": "264b51f3-4978-4c48-ae98-0f79112396a1",
                        "source_entry_id": "89b738de-0dd4-3b1c-aea0-52fe2604e640",
                        "source_sense_id": "be4ad795-e8bb-3d2f-a48e-90370afd924a",
                        "target_lang_word": "dodecahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dodecahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                        "entry_id": "b15d36b1-6040-3818-b3cb-a6770c3c1713",
                                        "glosses": [
                                            "A polyhedron with twelve faces; the regular dodecahedron has regular pentagons as faces and is one of the Platonic solids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7596c97-eb85-4e5b-895d-dbd1886869b3",
                                                "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                                "text": "1707, Thomas Blount, Glossographia Anglicana Nova: Or, A Dictionary, Interpreting Such Hard Words, D. Brown, heading DO–DO,\nDodecahedron, (Gr.) in Geometry, is a solid Figure of 12 Sides or Faces that are regular Pentagons, it is one of the Platonick or Regular Bodies."
                                            },
                                            {
                                                "example_id": "8eb4625b-7256-407b-8569-6f143dc1a70b",
                                                "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                                "text": "It took me two years, but by the time I was 12 I could imagine the fifth four-dimensional polytope, which is made up of 120 dodecahedrons."
                                            },
                                            {
                                                "example_id": "b2448926-3d40-45ba-9b36-e7e4e822258d",
                                                "sense_id": "ccf952e5-f59b-30cf-b690-e3d9f6d8a4f8",
                                                "text": "There is no uniformity in the size or shape of the dodecahedra found so far, nor in their metal composition or even in the level of craftsmanship. If they were important objects, we would expect to also discover contextual evidence in the archaeological record, such as depictions in paintings or mosaics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7316f98e-a9ec-44de-96eb-844c380ebf6c",
                        "source_entry_id": "89b738de-0dd4-3b1c-aea0-52fe2604e640",
                        "source_sense_id": "be4ad795-e8bb-3d2f-a48e-90370afd924a",
                        "target_lang_word": "dvanáctistěn",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dvanáctistěn",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "152b9db6-7bb5-39ef-bbe4-8a03178a8678",
                                        "entry_id": "2bb414be-18a5-3bbb-8542-6beb2a52b956",
                                        "glosses": [
                                            "geometrické těleso mající dvanáct stěn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b28649ea-2d69-450d-960e-b83f252ae090",
                                                "sense_id": "152b9db6-7bb5-39ef-bbe4-8a03178a8678",
                                                "text": "Stěny pravidelného dvanáctistěnu jsou shodné pravidelné pětiúhelníky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c33e3dc0-9889-4225-9999-2ff482cdcb50",
                        "source_entry_id": "89b738de-0dd4-3b1c-aea0-52fe2604e640",
                        "source_sense_id": "be4ad795-e8bb-3d2f-a48e-90370afd924a",
                        "target_lang_word": "двенадцатигранник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "двенадцатигранник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "23ff3fc3-7c18-3a15-ad2c-a9ce94e1e6b0",
                                        "entry_id": "6adc3b77-ec02-3c6f-be7c-7c2076c24d4b",
                                        "glosses": [
                                            "геометр. многогранник, имеющий двенадцать граней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcb77f2-330d-4337-8693-186698258f13",
                                                "sense_id": "23ff3fc3-7c18-3a15-ad2c-a9ce94e1e6b0",
                                                "text": "― Вот посмотрите, кроме октаэдров ― ромбододекаэдр. ― Чурилин отделил спичкой зелёный двенадцатигранник. ― Этот вид алмаза отличается необыкновенной даже для этого камня твёрдостью."
                                            }
                                        ]
                                    }
                                ]
                            }
