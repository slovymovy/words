                    },
                    {
                        "translation_id": "5532fcee-8630-4499-aba5-7f41e5c02072",
                        "source_entry_id": "88fcbb38-1d6b-35f3-8a9a-1a30dee4243a",
                        "source_sense_id": "d9212fc2-4465-3da5-98a7-56094cad6ca7",
                        "target_lang_word": "Kombi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kombi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9ede45-8016-3c41-b09e-c4f545fd1b6a",
                                        "entry_id": "ebc77b56-29ed-341f-9ee8-c0659a6a2647",
                                        "glosses": [
                                            "Kombinationswagen oder Kombinationskraftwagen, ein Auto, das eine Kombination von einer Limousine und einem Lieferwagen darstellt und in der Regel 4 Seitentüren und eine Hecktür zum Beladen des Fahrzeuges hat"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3677ae7-0eab-4634-afeb-c97cfcf9865f",
                                                "sense_id": "0d9ede45-8016-3c41-b09e-c4f545fd1b6a",
                                                "text": "Ein Kombi ist ein praktisches Auto."
                                            },
                                            {
                                                "example_id": "accda657-ee78-4e83-ac8a-295e0abeddf3",
                                                "sense_id": "0d9ede45-8016-3c41-b09e-c4f545fd1b6a",
                                                "text": "„Der Kombi wurde beladen, als würden wir auswandern, und dann fuhren wir los.“"
                                            },
                                            {
                                                "example_id": "02f251f7-70cf-4a99-8285-7169506db893",
                                                "sense_id": "0d9ede45-8016-3c41-b09e-c4f545fd1b6a",
                                                "text": "„Vielleicht hat der Mann im grünen Kombi heute Nacht im Streit seine Alte vom Balkon geworfen?“"
                                            },
                                            {
                                                "example_id": "840088f8-4ca3-49b9-8621-33376432ad7d",
                                                "sense_id": "0d9ede45-8016-3c41-b09e-c4f545fd1b6a",
                                                "text": "„Ein lang gestreckter schwarzer Kombi war zur Abfahrt bereit.“"
                                            },
                                            {
                                                "example_id": "b5af77f8-9f1d-4041-b5e3-84b8c07a9244",
                                                "sense_id": "0d9ede45-8016-3c41-b09e-c4f545fd1b6a",
                                                "text": "„Papa stellte den Kombi dicht vor der Gartenmauer ab, nahm den Diplomatenkoffer vom Beifahrersitz und schaute zum Fenster im ersten Stock hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
