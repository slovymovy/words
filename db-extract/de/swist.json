                        ],
                        "form": "die Swist"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59136134-d90f-3bc2-a9c6-e509ca1775ed",
                        "entry_id": "5554b076-78fc-396c-9ea9-dcd17dd37c4e",
                        "glosses": [
                            "ein Fluss in Deutschland, Nebenfluss der Erft die in den Rhein mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76179787-ac7a-48a3-bce9-d42873a1b2fe",
                                "sense_id": "59136134-d90f-3bc2-a9c6-e509ca1775ed",
                                "text": "Die Swist mündet am nördlichen Ortsausgang von Weilerswist, unterhalb des Bliesheimer Kreuz (A61/A1) in die Erft."
                            },
                            {
                                "example_id": "8097f9d5-b65e-4ba5-b4df-f6a7a443f6a5",
                                "sense_id": "59136134-d90f-3bc2-a9c6-e509ca1775ed",
                                "text": "„Wo die Swist zuerst den Waldessaum begrüßt. Wo ein weißes Türmchen Du am Berge siehst. So heißt es im Heimatlied von Erich Kühn.“"
                            },
                            {
                                "example_id": "0703c59c-5832-4926-a3e2-4d87daf373b3",
                                "sense_id": "59136134-d90f-3bc2-a9c6-e509ca1775ed",
                                "text": "„Von der Landesgrenze zu Rheinland-Pfalz fließt die Swist als mäßig geschwungener Wiesenbach, der von typischen Bachgehölzen in einem Naturprofil gesäumt wird.“"
                            },
                            {
                                "example_id": "8772e659-64bd-40a7-8163-98059e1609a9",
                                "sense_id": "59136134-d90f-3bc2-a9c6-e509ca1775ed",
                                "text": "„Man wird hier später auch auf die Swist treffen, einen Bach, der erstaunlich klar und mit Fischreichtum gesegnet ist.“"
                            },
                            {
                                "example_id": "6e5de268-f0db-4483-9f59-a451923c7b25",
                                "sense_id": "59136134-d90f-3bc2-a9c6-e509ca1775ed",
                                "text": "„Für einen schönen Spaziergang braucht man noch nicht mal weit in die Eifel zu fahren, denn direkt hinter Erftstadt (je nach Blickwinkel vor oder hinter — hier aus Hürth gesehen) trifft die Swist auf die Erft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
