                "translations": [
                    {
                        "translation_id": "a5e443c3-da4b-4834-a11e-ad589a5fe40d",
                        "source_entry_id": "50cb78e4-035a-3d38-90b6-67ce4720c9db",
                        "source_sense_id": "3d5e9a96-6fac-380c-8e44-fd5f664fcd98",
                        "source_sense_description": "dunkle Stellen, Ringe unter den Augen",
                        "target_lang_word": "cerne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cerne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c00ea9d-a235-3bf0-beca-ec433e86690c",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Cercle sombre qui se forme autour de l’œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a91b692-1d70-472b-a765-25dfb7ec0d04",
                                                "sense_id": "3c00ea9d-a235-3bf0-beca-ec433e86690c",
                                                "text": "Le colchique couleur de cerne et de lilas"
                                            },
                                            {
                                                "example_id": "b1012e0b-4da0-4f00-b7ae-a6d482fe8926",
                                                "sense_id": "3c00ea9d-a235-3bf0-beca-ec433e86690c",
                                                "text": "Tout blanc, Ludo ; les traits tirés ; ces grands cernes sous les yeux ; et cette diarrhée qui continue ; ce refus persistant de manger, de boire."
                                            },
                                            {
                                                "example_id": "333f3b20-d55d-4564-8e80-57881897c030",
                                                "sense_id": "3c00ea9d-a235-3bf0-beca-ec433e86690c",
                                                "text": "Un jour, alors qu'il est parti, pauvre cœur aux yeux soulignés par des cernes mauvâtres, au dos de plus en plus voûté, à la pâleur carcérale, je décide, prise d'un besoin pressant, de me lever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "113052e4-409f-3b29-aa04-d79a0e600966",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Cercle livide autour d’une plaie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1b87a8f-d662-3af0-97e5-012e305917f9",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Un des cercles concentriques d’un tronc d’arbre, coupé en travers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c9ae0c-694a-4975-8247-f6bed7c4e55f",
                                                "sense_id": "b1b87a8f-d662-3af0-97e5-012e305917f9",
                                                "text": "En comptant le nombre de cernes, on peut en général avoir l’âge d’un arbre ; un cerne foncé correspond à la production de bois d’été, il est précédé d’un Cerne plus clair et souvent plus large correspondant à la production de bois de printemps."
                                            },
                                            {
                                                "example_id": "4f6346a6-acae-493f-b320-182e8fe14331",
                                                "sense_id": "b1b87a8f-d662-3af0-97e5-012e305917f9",
                                                "text": "Le bois en est plus résistant mécaniquement et il est plus coloré ce qui permet de compter les années par le nombre de cernes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cab5f75-1ba8-3112-8dd0-b5a9ee1169fc",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Trait délimitant une forme dans un dessin ou une peinture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcfdafc-1239-4946-8a95-5da99fe9161e",
                                                "sense_id": "2cab5f75-1ba8-3112-8dd0-b5a9ee1169fc",
                                                "text": "Le cerne qui nous propose les objets dessinés reste une sorte de véhicule d’où la forme descend, visiteuse plus complète et, tout compte fait, mieux rendue."
                                            },
                                            {
                                                "example_id": "a6092066-501a-44f8-a644-debac1ccdde2",
                                                "sense_id": "2cab5f75-1ba8-3112-8dd0-b5a9ee1169fc",
                                                "text": "Certains limites sont floues, notamment dans le fond du tableau. D'autres sont nettes et parfois soulignées d’un trait de contour (un cerne) : cerne bleu sur la partie gauche du chapeau, cerne vert sur l’épaule gauche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec295bd-9243-30bd-9b46-101fe93098f1",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Cercle nébuleux qui entoure quelquefois le disque de la lune."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8e402ef-cf40-3f86-9adf-7b0896267985",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Cercle qui, sur une étoffe, entoure la place d’une tache qu’on vient de nettoyer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7773a87e-15ff-3b6e-a857-eb4ea08404d0",
                                        "entry_id": "6f049289-3a5a-3393-b713-5736f66fbe97",
                                        "glosses": [
                                            "Cercle tracé sur la terre, sur le sable, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
