                                                "example_id": "544c1113-c550-488e-bd6f-e4d2aa69816c",
                                                "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                                "text": "L'œuvre de l’Industriel français qui pousse à l’association des petits contre l’implacable et mortelle concurrence des monopoleurs n'en est pas moins fort encourageable."
                                            },
                                            {
                                                "example_id": "ee3d7920-cac2-4724-a212-43f4d2838da6",
                                                "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                                "text": "Intendants, parlements, échevins ordonnaient de confisquer les blés des charrois, d'arrêter des bateliers, de surveiller les boulangers, de perquisitionner les greniers, de rechercher les « monopoleurs »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monopoleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5422f9f-c94f-33a8-8f37-f83dc9de7720",
                                        "entry_id": "b07b943f-570c-3ea1-bd7c-7c0de099aed0",
                                        "glosses": [
                                            "Qui exerce un monopole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6144077e-64bc-453a-b216-6f2b0b76752f",
                                                "sense_id": "d5422f9f-c94f-33a8-8f37-f83dc9de7720",
                                                "text": "c) Analogie entre les tendances à la \"planification\" inhérentes au capitalisme monopoleur et la planification soviétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
