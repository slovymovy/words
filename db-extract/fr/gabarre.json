            {
                "entry_id": "42133d77-b65a-3b72-bea4-df8c4ea8f7a7",
                "word": "gabarre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "523bfd80-8dc9-447a-8bf5-3310b08fb490",
