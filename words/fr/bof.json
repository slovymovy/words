                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "7887362e-b76b-374a-8ebc-3b576d88323b",
                    "sense_definition": "Exprime le doute ou un jugement mitigé sur la qualité ou l'intérêt de quelqu'un ou de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as aimé ce nouveau restaurant ? — <w>Bof</w>, ce n'était franchement rien d'exceptionnel."
                        },
                        {
                            "text": "Cette pièce de théâtre avait de bonnes critiques, mais notre impression reste plutôt <w>bof</w>."
                        }
                    ],
                    "synonyms": [
                        "mouais"
                    ],
                    "common_phrases": [
                        "bof sans plus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        },
        {
