                        "glosses": [
                            "Déformation par Balzac du mot ringlet (tresse anglaise, boucle anglaise)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c505b298-0b8e-4435-9735-acb6f781a82d",
                                "sense_id": "0b068ba7-fd01-32ba-9abc-015cea8da835",
                                "text": "A-t-elle une main royalement belle, le plus fin croira qu’il était absolument nécessaire de rouler, de remonter ou d’écarter celle de ses ringleets ou de ses boucles qu’elle caresse."
                            },
                            {
                                "example_id": "47e95464-73ea-4b33-b860-d0135056f0c9",
                                "sense_id": "0b068ba7-fd01-32ba-9abc-015cea8da835",
                                "text": "Elle était vêtue d’une délicieuse robe bleue en velours de coton, toujours le fichu clair, des grappes de raisins en grenat et or aux oreilles, les cheveux en ringleet, la jeannette astucieuse, de petits souliers en satin noir, des bas de soie gris, et des gants de Suède ; puis des airs de reine et des coquetteries de jeune fille à prendre tous les Rogron de la rivière."
                            }
                        ]
                    }
