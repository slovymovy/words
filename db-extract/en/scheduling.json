                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0dbf3505-9426-3146-8e74-289a8d391acb",
                        "entry_id": "ac154f96-f810-34e7-a563-314dee9132e2",
                        "glosses": [
                            "Assignment to a schedule, or systematic arrangement."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "00922dd5-cde8-4eec-880d-510d8ec8ed14",
                                "sense_id": "0dbf3505-9426-3146-8e74-289a8d391acb",
                                "text": "The use of modified unit-dose rather than eight separate pharmacies with an individual prescription system could have prevented virtually all of these inappropriate schedulings of drugs."
                            }
                        ]
                    }
