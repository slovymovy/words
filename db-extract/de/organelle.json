                ],
                "senses": [
                    {
                        "sense_id": "91c38bdb-d146-32cd-aa84-f83b3bca7c55",
                        "entry_id": "c6435e19-f190-3aeb-a3f6-f2d4b1081de4",
                        "glosses": [
                            "strukturell abgegrenzter, funktionelle Einheiten bildender, teilweise durch Membranen abgetrennter Bestandteil von Zellen der Eukaryoten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b2ecf9-d6c4-4178-8225-4a5e3f927dc2",
                                "sense_id": "91c38bdb-d146-32cd-aa84-f83b3bca7c55",
                                "text": "„Die Organellen der Zelle sind umgeben von Zytoplasma und arbeiten zusammen. Sie besitzen eine Lipidmembran, in die Proteine eingebettet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f303a721-53ae-4b05-998b-58ecc54295eb",
                        "source_entry_id": "c6435e19-f190-3aeb-a3f6-f2d4b1081de4",
                        "source_sense_id": "91c38bdb-d146-32cd-aa84-f83b3bca7c55",
                        "target_lang_word": "organelle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organelle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edeaa7c9-4ef9-31ba-ad0c-4427d569d984",
                                        "entry_id": "d11512bb-1f20-384c-928f-22c0b906c8dc",
                                        "glosses": [
                                            "A specialized structure found inside cells that carries out a specific life process (e.g. ribosomes, vacuoles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae46d0-6cb0-44bf-8054-79c75f9cb41f",
                                                "sense_id": "edeaa7c9-4ef9-31ba-ad0c-4427d569d984",
                                                "text": "Like organelles within a single cell, whole new specializations began to develop."
                                            },
                                            {
                                                "example_id": "70205096-c07e-40d5-86cc-c52eb9260e4a",
                                                "sense_id": "edeaa7c9-4ef9-31ba-ad0c-4427d569d984",
                                                "text": "The close analogies between DNA-containing eukaryotic cell organelles and microbial symbionts require revision of classic cell theory, wrote Scwemmler and Schenk (1980) on introducing the field of endocytobiology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67efa97d-298e-4506-8180-f6fb01d2ca72",
                        "source_entry_id": "c6435e19-f190-3aeb-a3f6-f2d4b1081de4",
                        "source_sense_id": "91c38bdb-d146-32cd-aa84-f83b3bca7c55",
                        "target_lang_word": "organite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf3bcb3-c760-33e7-9367-87b3030e48d3",
                                        "entry_id": "4b623516-772c-3d74-aae2-87ce7be3bb6e",
                                        "glosses": [
                                            "Chacune des structures compartimentées et spécialisées contenues dans le cytoplasme des cellules eucaryotes."
                                        ],
                                        "tags": [
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246b0a5d-f04c-4429-bb65-4f8cebb22c70",
                                                "sense_id": "1bf3bcb3-c760-33e7-9367-87b3030e48d3",
                                                "text": "L’un des arguments qui a fait pencher la balance en faveur de l’endosymbiose est l’absence de flagelle chez les Rickettsiales (la probable famille de bactéries de l'ancêtre des mitochondries), donc un manque de mobilité chez les aïeuls de l’organite cellulaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
