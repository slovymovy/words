    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7ca88d57-eaa1-30f1-b900-2d8ee7746b45",
                    "sense_definition": "als logisch resultaat of consequentie van iets; daardoor",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorzaak_gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sleutel zat nog in het slot en <w>bijgevolg</w> kon de deur niet open.",
                            "target_lang_translations": {
                                "en": "The key was still in the lock and <w>consequently</w> the door could not be opened."
                            }
                        },
                        {
                            "text": "De trein had vertraging en <w>bijgevolg</w> miste hij zijn aansluiting naar Brussel.",
                            "target_lang_translations": {
                                "en": "The train was delayed and <w>as a result</w> he missed his connection to Brussels."
                            }
                        }
                    ],
                    "synonyms": [
                        "daardoor",
                        "dientengevolge",
                        "dienvolgens"
                    ],
                    "target_lang_definitions": {
                        "en": "as a logical result or consequence; therefore, consequently"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consequently",
                                "target_lang_sense_clarification": "as a result"
                            },
                            {
                                "target_lang_word": "therefore",
                                "target_lang_sense_clarification": "for that reason"
                            },
                            {
                                "target_lang_word": "as a result",
                                "target_lang_sense_clarification": "because of that"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfcc7d48-569d-3786-af1c-ddc3a261aaa6",
                    "sense_definition": "een bijkomend, vaak onbedoeld gevolg of effect",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oorzaak_gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een onverwacht <w>bijgevolg</w> van de nieuwe wetgeving was een toename van de administratieve lasten.",
                            "target_lang_translations": {
                                "en": "An unexpected <w>byproduct</w> of the new legislation was an increase in administrative burdens."
                            }
                        },
                        {
                            "text": "De arts wees op een vervelend <w>bijgevolg</w> van de voorgeschreven therapie.",
                            "target_lang_translations": {
                                "en": "The doctor pointed out an unpleasant <w>side effect</w> of the prescribed therapy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
