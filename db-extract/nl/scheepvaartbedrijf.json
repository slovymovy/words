                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4ff1aa-7796-4393-8a43-c07a3ef53d18",
                                "sense_id": "1da245b4-d735-3ddd-916a-be131f4e4997",
                                "text": "Opvarenden van een veerboot tussen het Franse Duinkerken en het Engelse Dover moeten de nacht op zee doorbrengen vanwege de storm. De ferry van scheepvaartbedrijf DFDS Seaways met 239 passagiers kan door de harde wind de haven van Dover niet binnenvaren."
                            },
                            {
                                "example_id": "3f5dc396-1d1f-4911-9550-5e1e3321db88",
                                "sense_id": "1da245b4-d735-3ddd-916a-be131f4e4997",
                                "text": "Het is het tweede schip in een week van scheepvaartbedrijf Zodiac dat wordt gekaapt. Zodiac heeft nog niets gehoord van de piraten die het schip St. James Park kaapten. Het is onbekend hoe het gaat met de 26 leden van de bemanning."
                            }
                        ]
                    },
                    {
                        "sense_id": "4153e7b3-8f4d-35e4-ab70-45f101dd29b9",
                        "entry_id": "56460245-09a1-3a81-b402-339e9f849037",
                        "glosses": [
                            "bedrijf dat betrokken is bij de scheepsbouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42d1dad-8b9b-4a27-8393-af881d69f2be",
                                "sense_id": "4153e7b3-8f4d-35e4-ab70-45f101dd29b9",
                                "text": "De inspectie SZW heeft voor bijna 3 miljoen euro boete opgelegd aan twee bedrijven. Het gaat om een Gronings scheepvaartbedrijf en een Cypriotisch bedrijf."
                            },
                            {
                                "example_id": "e8bb0cc5-7ea6-4ba7-a701-d2833f3d504a",
                                "sense_id": "4153e7b3-8f4d-35e4-ab70-45f101dd29b9",
                                "text": "Het scheepvaartbedrijf IHC Merwede uit Sliedrecht heeft een order van ruim 1 miljard euro binnen van een Braziliaans bedrijf. IHC Merwede levert zes schepen voor de ontwikkeling van olievelden voor de kust van Brazilië."
                            }
                        ]
