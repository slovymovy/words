                    "sense_definition": "ozdobny, przezroczysty materiał wieszany w oknie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "okno",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nowym mieszkaniu powiesiliśmy białe <w>firanki</w>.",
                            "target_lang_translations": {
                                "en": "In the new apartment, we hung white <w>sheer curtains</w>.",
                                "ru": "В новой квартире мы повесили белые <w>занавески</w>.",
                                "nl": "In het nieuwe appartement hebben we witte <w>vitrages</w> opgehangen.",
                                "de": "In der neuen Wohnung haben wir weiße <w>Gardinen</w> aufgehängt.",
                                "fr": "Dans le nouvel appartement, nous avons suspendu des <w>voilages</w> blancs.",
                                "it": "Nel nuovo appartamento abbiamo appeso delle <w>tendine</w> bianche.",
                                "cs": "V novém bytě jsme pověsili bílé <w>záclony</w>.",
                                "tr": "Yeni daireye beyaz <w>tül perdeler</w> astık.",
                                "es": "En el nuevo piso colgamos <w>visillos</w> blancos.",
                                "zh": "我们在新公寓里挂上了白色的<w>纱帘</w>。"
                            }
                        },
                        {
                            "text": "Przez czyste <w>firanki</w> wpada do pokoju dużo światła.",
                            "target_lang_translations": {
                                "en": "A lot of light comes into the room through the clean <w>net curtains</w>.",
                                "ru": "Через чистый <w>тюль</w> в комнату попадает много света.",
                                "nl": "Door de schone <w>vitrages</w> valt er veel licht de kamer binnen.",
                                "de": "Durch die sauberen <w>Gardinen</w> fällt viel Licht in das Zimmer.",
                                "fr": "À travers les <w>voilages</w> propres, beaucoup de lumière entre dans la pièce.",
                                "it": "Attraverso le <w>tendine</w> pulite entra molta luce nella stanza.",
                                "cs": "Přes čisté <w>záclony</w> proniká do pokoje hodně světla.",
                                "tr": "Temiz <w>tüllerin</w> arasından odaya bolca ışık giriyor.",
                                "es": "A través de los <w>visillos</w> limpios entra mucha luz a la habitación.",
                                "zh": "充足的光线透过干净的<w>窗纱</w>照进房间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "białe firanki",
                        "wieszać firanki"
                    ],
                    "target_lang_definitions": {
                        "en": "a decorative, translucent piece of fabric hung in a window",
                        "ru": "декоративная, полупрозрачная ткань, которую вешают на окно",
                        "nl": "Decoratieve, doorschijnende stof die voor een raam wordt gehangen",
                        "de": "dünner, oft transparenter Vorhang oder Stoff, der am Fenster aufgehängt wird",
                        "fr": "Rideau léger et transparent que l'on suspend devant une fenêtre pour laisser passer la lumière tout en protégeant des regards.",
                        "it": "Telo leggero e trasparente appeso alla finestra per scopo decorativo o per filtrare la luce",
