                                    },
                                    {
                                        "sense_id": "68ae93f9-4402-312e-a91a-93498e34c433",
                                        "entry_id": "3cfc0cd4-de36-3789-9728-39930dc3e4b4",
                                        "glosses": [
                                            "The vulva or vagina."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeeb2704-bb69-471f-8c55-e77cae820f8f",
                                                "sense_id": "68ae93f9-4402-312e-a91a-93498e34c433",
                                                "text": "U.S.S. Millicent asked Mario if he'd ever seen a girl's yin-yang before."
                                            },
                                            {
                                                "example_id": "cf8a2e37-59fc-45a1-9998-4e267b8b9d65",
                                                "sense_id": "68ae93f9-4402-312e-a91a-93498e34c433",
                                                "text": "\"So I took off my apron and told her she could shove the job up her yin-yang.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dfaf8c4-6a2d-3c7d-8b88-25f98071db06",
                                        "entry_id": "3cfc0cd4-de36-3789-9728-39930dc3e4b4",
                                        "glosses": [
                                            "The anus or rectum."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c91698-96f0-463d-8878-4462a5c9f4ef",
                                                "sense_id": "8dfaf8c4-6a2d-3c7d-8b88-25f98071db06",
                                                "text": "He thought he could smuggle the drugs over the border by putting them in capsules and stuffing them up his yin-yang. Not a good idea!"
                                            },
                                            {
                                                "example_id": "3ef98447-7b28-4512-92ce-b0a1a2ad0c0c",
                                                "sense_id": "8dfaf8c4-6a2d-3c7d-8b88-25f98071db06",
                                                "text": "\"... I'd be on that phone call every single day. I'd be up that guy's yin-yang so far with a firecracker he wouldn't know what hit him,\" the Ontario premier said of Pfizer's executives."
                                            }
                                        ]
                                    }
                                ]
                            }
