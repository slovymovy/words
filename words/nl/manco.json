    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2629ee3f-7854-3b99-8678-ddc2826b3f87",
                    "sense_definition": "Een tekort, gebrek of fout in iets waardoor het niet perfect of compleet is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het enige <w>manco</w> aan dit prachtige plan is dat er geen budget voor is.",
                            "target_lang_translations": {
                                "en": "The only <w>drawback</w> to this wonderful plan is that there is no budget for it."
                            }
                        },
                        {
                            "text": "Zij wees op een belangrijk <w>manco</w> in de nieuwe software.",
                            "target_lang_translations": {
                                "en": "She pointed out a major <w>flaw</w> in the new software."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebrek",
                        "tekort",
                        "tekortkoming"
                    ],
                    "common_phrases": [
                        "een groot manco",
                        "belangrijk manco"
                    ],
                    "target_lang_definitions": {
                        "en": "A deficiency, defect, or flaw in something that prevents it from being perfect or complete."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shortcoming",
                                "target_lang_sense_clarification": "a fault or failure to meet a certain standard"
                            },
                            {
                                "target_lang_word": "flaw",
                                "target_lang_sense_clarification": "a defect or imperfection"
                            },
                            {
                                "target_lang_word": "deficiency",
                                "target_lang_sense_clarification": "a lack or shortage of something required"
                            },
                            {
                                "target_lang_word": "drawback",
                                "target_lang_sense_clarification": "a disadvantage or problem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "850189d6-73c1-3be4-8bd2-9ccea1aa75e5",
                    "sense_definition": "Een tekort aan geld of goederen, met name bij een afrekening of inventarisatie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tekort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het tellen van de kas bleek er een onverklaarbaar <w>manco</w> te zijn.",
                            "target_lang_translations": {
                                "en": "After counting the cash, there appeared to be an inexplicable <w>shortage</w>."
                            }
                        },
                        {
                            "text": "De leverancier moet het <w>manco</w> aan goederen zo snel mogelijk aanvullen.",
                            "target_lang_translations": {
                                "en": "The supplier must replenish the <w>shortfall</w> of goods as soon as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "tekort"
                    ],
                    "common_phrases": [
                        "een manco in de kas"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak gebruikt in een zakelijke of boekhoudkundige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A shortage of money or goods, especially during a settlement, cash count, or inventory check."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shortage",
                                "target_lang_sense_clarification": "a state where something needed cannot be obtained in sufficient amounts"
                            },
                            {
                                "target_lang_word": "deficit",
                                "target_lang_sense_clarification": "an excess of expenditure or liabilities over income or assets"
                            },
                            {
                                "target_lang_word": "shortfall",
                                "target_lang_sense_clarification": "a deficit of something, especially money"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}