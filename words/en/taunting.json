{
    "word_family": [
        "taunt",
        "taunter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8f06a28-099b-3f1d-8999-a3b6d577df92",
                    "sense_definition": "Abusing vocally; expressing contempt or ridicule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully made <w>taunting</w> remarks about the student's new clothes.",
                            "target_lang_translations": {
                                "nl": "De pester maakte <w>spottende</w> opmerkingen over de nieuwe kleren van de leerling."
                            }
                        },
                        {
                            "text": "She ignored the <w>taunting</w> laughter coming from the group of teenagers.",
                            "target_lang_translations": {
                                "nl": "Ze negeerde het <w>tergende</w> gelach dat uit de groep tieners kwam."
                            }
                        }
                    ],
                    "synonyms": [
                        "derisive",
                        "gibelike",
                        "jeering",
                        "mocking"
                    ],
                    "common_phrases": [
                        "taunting remarks",
                        "taunting laughter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beledigend of spottend; uitdrukking gevend aan minachting of spot."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spottend",
                                "target_lang_sense_clarification": "met de bedoeling iemand belachelijk te maken"
                            },
                            {
                                "target_lang_word": "tergend",
                                "target_lang_sense_clarification": "met de bedoeling iemand te irriteren of uit te lokken"
                            },
                            {
                                "target_lang_word": "hoonachtig",
                                "target_lang_sense_clarification": "vol minachting en spot"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29570313-054d-3ab9-bb25-10f82c53f14d",
                    "sense_definition": "The act of one who taunts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew tired of the constant <w>tauntings</w> from his coworkers.",
                            "target_lang_translations": {
                                "nl": "Hij werd moe van de constante <w>pesterijen</w> van zijn collega's."
                            }
                        },
                        {
                            "text": "The child cried after enduring the cruel <w>tauntings</w> of the older boys.",
                            "target_lang_translations": {
                                "nl": "Het kind huilde nadat het de wrede <w>spotternij</w> van de oudere jongens had ondergaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "taunt",
                        "twit"
                    ],
                    "common_phrases": [
                        "constant tauntings",
                        "cruel tauntings"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van iemand die bespot of uitlacht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pesterijen",
                                "target_lang_sense_clarification": "herhaaldelijk vervelend gedrag naar anderen toe"
                            },
                            {
                                "target_lang_word": "hoon",
                                "target_lang_sense_clarification": "het uiten van minachting of spot"
                            },
                            {
                                "target_lang_word": "spotternij",
                                "target_lang_sense_clarification": "het gedrag van het bespotten van anderen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c1ec164-b87a-32fb-89a8-40ca48a820a4",
                    "sense_definition": "present participle and gerund of <w>taunt</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players were <w>taunting</w> their opponents throughout the entire game.",
                            "target_lang_translations": {
                                "nl": "De spelers waren hun tegenstanders de hele wedstrijd lang aan het <w>bespotten</w>."
                            }
                        },
                        {
                            "text": "He was punished for <w>taunting</w> the other children on the playground.",
                            "target_lang_translations": {
                                "nl": "Hij werd gestraft voor het <w>tergen</w> van de andere kinderen op het schoolplein."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het bespotten of uitdagen van iemand."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bespotten",
                                "target_lang_sense_clarification": "iemand belachelijk maken"
                            },
                            {
                                "target_lang_word": "uitdagen",
                                "target_lang_sense_clarification": "iemand provoceren"
                            },
                            {
                                "target_lang_word": "tergen",
                                "target_lang_sense_clarification": "iemand opzettelijk irriteren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}