{
    "word_family": [
        "smeuïgheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30588523-b93e-32fa-a4f4-bb3c4ab59428",
                    "sense_definition": "Zacht, smeerbaar en niet droog van structuur, vaak gezegd van voedsel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze saus is heerlijk <w>smeuïg</w> en past goed bij de pasta. ",
                            "target_lang_translations": {
                                "pl": "Ten sos jest cudownie <w>kremowy</w> i dobrze pasuje do makaronu."
                            }
                        },
                        {
                            "text": "Hij kiest altijd voor een <w>smeuïge</w> kaas op zijn brood.",
                            "target_lang_translations": {
                                "pl": "Zawsze wybiera <w>kremowy</w> ser na kanapkę."
                            }
                        }
                    ],
                    "synonyms": [
                        "smeerbaar",
                        "zacht"
                    ],
                    "antonyms": [
                        "droog"
                    ],
                    "common_phrases": [
                        "smeuïge kaas"
                    ],
                    "target_lang_definitions": {
                        "pl": "Miękki, dający się rozsmarować i nieprzesuszony w strukturze, często używany w odniesieniu do jedzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kremowy",
                                "target_lang_sense_clarification": "o konsystencji przypominającej krem, gładki"
                            },
                            {
                                "target_lang_word": "soczysty",
                                "target_lang_sense_clarification": "o jedzeniu, które nie jest suche"
                            },
                            {
                                "target_lang_word": "aksamitny",
                                "target_lang_sense_clarification": "o bardzo gładkiej i delikatnej konsystencji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bed20c83-7976-3469-bced-68ddcb1639f9",
                    "sense_definition": "Levendig, meeslepend en voorzien van sensationele of vermakelijke details.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze vertelde een <w>smeuïg</w> verhaal over haar vakantie. ",
                            "target_lang_translations": {
                                "pl": "Opowiedziała <w>pikantną</w> historię ze swoich wakacji."
                            }
                        },
                        {
                            "text": "Iedereen wilde de <w>smeuïge</w> details van de roddel horen.",
                            "target_lang_translations": {
                                "pl": "Wszyscy chcieli usłyszeć <w>soczyste</w> szczegóły plotki."
                            }
                        }
                    ],
                    "synonyms": [
                        "pittig",
                        "smeuïg",
                        "smeuïge"
                    ],
                    "antonyms": [
                        "saai"
                    ],
                    "common_phrases": [
                        "smeuïge details",
                        "smeuïg verhaal"
                    ],
                    "target_lang_definitions": {
                        "pl": "Żywy, wciągający i zawierający sensacyjne lub zabawne szczegóły."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pikantny",
                                "target_lang_sense_clarification": "o opowieściach lub plotkach zawierających kontrowersyjne szczegóły"
                            },
                            {
                                "target_lang_word": "soczysty",
                                "target_lang_sense_clarification": "o plotkach lub historiach pełnych ciekawych, często skandalicznych detali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "634b2944-0722-374d-a4f8-819e2229f738",
                    "sense_definition": "Buigzaam en soepel, gemakkelijk te vervormen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe <w>smeuïger</w> het leer is, des te beter is de kwaliteit. ",
                            "target_lang_translations": {
                                "pl": "Im bardziej <w>elastyczna</w> jest skóra, tym lepsza jest jej jakość."
                            }
                        },
                        {
                            "text": "Door de olie werd het materiaal weer heel <w>smeuïg</w>.",
                            "target_lang_translations": {
                                "pl": "Dzięki olejowi materiał znów stał się bardzo <w>giętki</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigzaam",
                        "soepel"
                    ],
                    "antonyms": [
                        "stijf"
                    ],
                    "target_lang_definitions": {
                        "pl": "Giętki i elastyczny, łatwy do odkształcenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "elastyczny",
                                "target_lang_sense_clarification": "łatwo zmieniający kształt pod wpływem nacisku"
                            },
                            {
                                "target_lang_word": "giętki",
                                "target_lang_sense_clarification": "podatny na wyginanie"
                            },
                            {
                                "target_lang_word": "miękki",
                                "target_lang_sense_clarification": "o materiale, który stał się plastyczny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}