                "senses": [
                    {
                        "sense_id": "6d2a30aa-af06-3987-a79a-69f8d3fb1dd8",
                        "entry_id": "872ac2fe-c4c2-3a22-9985-7cc289e686a6",
                        "glosses": [
                            "zob. przeciwutleniacz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31e97c8-cf21-4978-accb-7944aeb9d58c",
                                "sense_id": "6d2a30aa-af06-3987-a79a-69f8d3fb1dd8",
                                "text": "Owoce i warzywa zawierają naturalne antyoksydanty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "955639d0-32ae-478b-8139-366dc5ecf6b4",
                        "source_entry_id": "872ac2fe-c4c2-3a22-9985-7cc289e686a6",
                        "source_sense_id": "6d2a30aa-af06-3987-a79a-69f8d3fb1dd8",
                        "target_lang_word": "антиоксидант",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антиоксидант",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "732b3a35-7181-348e-95f1-f7e4f7343250",
                                        "entry_id": "37f7fb30-348f-3064-8ab0-caa23ba3ef20",
                                        "glosses": [
                                            "биохим., мед. вещество, способное нейтрализовать свободные радикалы кислорода; ингибитор, замедлитель окисления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1934e212-4969-4e03-9cb3-c26e8b5e6b1d",
                                                "sense_id": "732b3a35-7181-348e-95f1-f7e4f7343250",
                                                "text": "Очень велико значение таких ингибиторов — антиоксидантов — в окислительных процессах: они предотвращают окисление различных материалов, например полимеров и пластиков."
                                            },
                                            {
                                                "example_id": "6c9e3c19-4ca9-4a31-a700-509a31af4ddb",
                                                "sense_id": "732b3a35-7181-348e-95f1-f7e4f7343250",
                                                "text": "Входящие в кремы активные антиоксиданты, а также увлажняющие компоненты обеспечивают полноценный уход за кожей, защищают её от старения и внешних неблагоприятных факторов."
                                            },
                                            {
                                                "example_id": "b359e909-458b-48a2-b726-b8d5a2b6de9f",
                                                "sense_id": "732b3a35-7181-348e-95f1-f7e4f7343250",
                                                "text": "Оказывается, кофе и шоколад особенно богаты мощными антиоксидантами, защищающими клетки от агрессивного воздействия свободных радикалов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
