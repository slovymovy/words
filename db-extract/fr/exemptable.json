                        "glosses": [
                            "Qui peut faire l’objet d’une exemption."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653937aa-33bd-4458-b90e-dcc95d2557eb",
                                "sense_id": "ee292449-4512-3d56-9ac9-a7b5cdcebf3d",
                                "text": "Cette exclusivité, dont le principe est accepté, peut être exemptable lorsqu’elle est de courte durée et limitée dans sa portée et dans ses effets."
                            },
                            {
                                "example_id": "2d9d9a92-9469-4ce2-be59-81a970e59374",
                                "sense_id": "ee292449-4512-3d56-9ac9-a7b5cdcebf3d",
                                "text": "Par exemple, une clause de non-concurrence post-contractuelle dans un réseau de distribution n’est exemptable que si cette clause sert la protection du savoir-faire du créancier de cette clause."
                            }
                        ]
                    }
