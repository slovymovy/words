                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d39f71f5-f214-45f2-9dcf-6c4365aed0e3",
                        "entry_id": "87c6a55e-9bf1-34b8-8a58-9bb44315549d",
                        "tags": [
                            "plural"
