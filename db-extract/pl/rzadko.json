                                            {
                                                "example_id": "4d40d368-49b2-481d-93f2-34a4d80fd3f5",
                                                "sense_id": "d469007f-bf1a-3ece-a650-debdc9393285",
                                                "text": "Málokdy se dnes už stane, že by byl přijat zákon, u kterého je dopředu jasné, že jej ústavní soud odmítne."
                                            },
                                            {
                                                "example_id": "7a0dc607-6d1a-4d1b-bf06-29e2b0a424e5",
                                                "sense_id": "d469007f-bf1a-3ece-a650-debdc9393285",
                                                "text": "Bůh ví, že na světě vždycky byli hloupí lidé a také spousta protivných lidí. Ale málokdy byla hloupost tak protivná a protivnost tak hloupá. Vedle něj vypadá Nixon důvěryhodně a George W. Bush chytře."
                                            }
                                        ]
                                    }
                                ]
