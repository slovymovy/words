                                    },
                                    {
                                        "sense_id": "f4dce70b-a6a4-3301-95a6-8c382d40d9cb",
                                        "entry_id": "996f08a9-21c1-3b22-b022-fb0db6d7a04b",
                                        "glosses": [
                                            "Believed or transmitted by the common people; not academically or ideologically correct or rigorous."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be9980c-64ee-49da-9650-a51785d82218",
                                                "sense_id": "f4dce70b-a6a4-3301-95a6-8c382d40d9cb",
                                                "text": "folk psychology; folk linguistics"
                                            },
                                            {
                                                "example_id": "7a2011d6-be91-4326-a935-7c6604da2b8b",
                                                "sense_id": "f4dce70b-a6a4-3301-95a6-8c382d40d9cb",
                                                "text": "Americans are not libertarians in the Cato Institute sense of the word, but they are folk libertarians in this sense of impulsive behaviour, which is a feature of American life that anyone who wants to govern the United States, Democratic or Republican, has to be aware of."
                                            }
                                        ]
                                    }
                                ]
