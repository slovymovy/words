                        "examples": [
                            {
                                "example_id": "e575f511-9a25-4ce7-bcca-cfffd7cf0a5f",
                                "sense_id": "cede324e-9a8f-31fa-b65b-f07853a04801",
                                "text": "Daar trouwt prinses Carolina (38), de jongste dochter van prinses Irene, met Albert Brenninkmeijer (38), in Frankrijk werkzaam in de directie van het familiebedrijf C&A. Uit Nederland is bijna de voltallige koninklijke familie aanwezig, inclusief koningin Beatrix. En dat brengt met zich mee dat het publiciteitsschuwe bruidspaar even uit de anonimiteit treedt. Maar bij de huwelijksmis blijven de deuren gesloten. Dat is privé, laat het paar weten."
                            },
                            {
                                "example_id": "64dd2437-4686-4925-b146-ff709f6251c9",
                                "sense_id": "cede324e-9a8f-31fa-b65b-f07853a04801",
                                "text": "Jaime en Viktória hebben voor Apeldoorn als plaats van hun huwelijk gekozen omdat de aanstaande bruid er is opgegroeid en de prins er veel herinneringen heeft. De huwelijksmis is in de kerk van Onze Lieve Vrouwe ten Hemelopneming en het aansluitende feest is op Paleis Het Loo."
                            }
                        ]
