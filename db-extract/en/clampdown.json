                        "glosses": [
                            "A sudden repressive or punitive restriction or control."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa696ed-2a8e-40de-b906-24b53fae0f42",
                                "sense_id": "b29424a1-453e-3725-9b91-417e206d7bd3",
                                "text": "The suspension of the writ of habeas corpus is merely one step towards the imposition of martial law, toward a total clampdown on all forms of peaceful struggle for meaningful change."
                            },
                            {
                                "example_id": "be3f9917-0481-42fe-980c-6abbf7d6d1af",
                                "sense_id": "b29424a1-453e-3725-9b91-417e206d7bd3",
                                "text": "There is already in the EU a clamour for barriers against competing products from Eastern Europe and Asia, and for a Europe-wide clampdown on 'aliens'."
                            },
                            {
                                "example_id": "5f73fa4d-fa1b-4ac8-a8a4-86b32781b860",
                                "sense_id": "b29424a1-453e-3725-9b91-417e206d7bd3",
                                "text": "Will there be any further restrictions on travel?\nOnly if the Government imposes them, although it seems unlikely that any further clampdowns will be made on domestic rail travel in case it risks the movement of key workers and essential goods at this critical time. [...]"
                            }
                        ]
                    }
