                        "cross_references": [
                            {
                                "target_word": "Kristall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82494afa-1443-3297-abd6-0ff0658ddb4b",
                                        "entry_id": "40184c1a-a8b5-3054-b2a5-280d41a96847",
                                        "glosses": [
                                            "homogener Körper, der eine periodische, dreidimensionale Struktur hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "843f6d30-8cee-44d4-a9c2-ffabf4596d33",
                                                "sense_id": "82494afa-1443-3297-abd6-0ff0658ddb4b",
                                                "text": "Einige Kristalle lassen sich durch Verdunstung einer wässrigen Lösung herstellen."
                                            },
                                            {
                                                "example_id": "0ab15cef-2465-4208-ba20-641f201d83b6",
                                                "sense_id": "82494afa-1443-3297-abd6-0ff0658ddb4b",
                                                "text": "„Die Kristalle von Natriumchlorid und Marmor sind hart, Stoffe wie Kerzenparaffin oder Bienenwachs dagegen sehr weich – man kann sie leicht mit dem Fingernagel ritzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kristall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afa41537-6cfb-350a-8025-a732f6b64b0c",
                                        "entry_id": "77780b75-c847-3366-9baa-fa0f9b310f97",
                                        "glosses": [
                                            "geschliffenes Glas mit hohem Brechungsindex, das handwerklich oder kunsthandwerklich hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008ab5e6-aeee-4ddf-9e07-0fb8d8dde210",
                                                "sense_id": "afa41537-6cfb-350a-8025-a732f6b64b0c",
                                                "text": "Diesen alten Wein zu genießen lohnt sich, das Kristall aufzudecken."
                                            },
                                            {
                                                "example_id": "7ca3df0f-a558-42eb-a202-4172ec20f2a3",
                                                "sense_id": "afa41537-6cfb-350a-8025-a732f6b64b0c",
                                                "text": "„Splitter von Kristall liegen auf dem Tisch und auf dem Fußboden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kristall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                        "entry_id": "89eda784-758e-3abf-ac46-9698eafd49b6",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810fa3eb-a81f-4abf-9a7b-9a9ac84820af",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Frau Kristall ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "0765b766-17de-4629-a7f5-76d290bf2740",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Herr Kristall wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4503eed4-af9d-4f33-adbe-56b71baf03ae",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Die Kristalls fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "324f9a86-9940-4f86-b040-bb08c9ec1580",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Der Kristall trägt nie die Schals, die die Kristall ihm strickt."
                                            },
                                            {
                                                "example_id": "644db36d-d73d-4f1a-8177-31db3ffa7c85",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kristall kommt, geht der Herr Kristall.“"
                                            },
                                            {
                                                "example_id": "d2ad1cd6-1f05-4819-8e0c-e8f93652fcf5",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Kristall kommt und geht."
                                            },
                                            {
                                                "example_id": "81d504b1-b852-4e96-b146-4e55d3704217",
                                                "sense_id": "ff922663-554d-3fc7-87fe-b72a042c2935",
                                                "text": "Kristalls kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77861742-6975-4dd4-8649-13865dc9c84a",
                        "source_entry_id": "70ecced5-b9b0-3e98-9d25-4a46155ad789",
