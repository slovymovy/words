        "de-extract.jsonl": [
            {
                "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                "word": "Zwischengeschlechtlichkeit",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "0d2525b7-4d33-4c37-8823-214ea4bddd52",
                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Zwischengeschlechtlichkeit"
                    },
                    {
                        "form_id": "45cf33dc-5fd6-44dc-8ec1-f6464d8a0f85",
                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Zwischengeschlechtlichkeit"
                    },
                    {
                        "form_id": "6a5f21ec-67e6-4f05-a3e7-e5d33039dea6",
                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Zwischengeschlechtlichkeit"
                    },
                    {
                        "form_id": "4e8dca02-ce2a-47cf-a385-241cd42db2d3",
                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zwischengeschlechtlichkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "glosses": [
                            "das Auftreten sowohl von männlichen als auch von weiblichen Geschlechtsmerkmalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0a4295-4a18-4ede-a13f-fd8fbacc9b08",
                                "sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                                "text": "„Hinter dem Begriff Intersexualität oder Zwischengeschlechtlichkeit verbergen sich viele unterschiedliche Phänomene nicht eindeutiger Geschlechtszugehörigkeit mit jeweils verschiedenen Ursachen.“"
                            },
                            {
                                "example_id": "37cf9313-4cec-422a-8a7c-f3ecc75058e5",
                                "sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                                "text": "„In der Kirche ist Intersexualität indes kein Thema. Noch nicht. Es gibt keine lehramtlichen Aussagen über die Zwischengeschlechtlichkeit und im theologischen Standardwerk, dem Lexikon für Theologie und Kirche, findet man zwar Einträge zu Homosexualität und Transsexualismus, einen Eintrag unter dem Stichwort Intersexualität sucht man jedoch vergebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "glosses": [
                            "weder dem weiblichen noch dem männlichen Geschlecht zuordenbare Geschlechtsidentität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6f78674-ff2f-48cd-b40a-6fb32bba484d",
                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                "text": "„Das OLG Frankfurt weitet nun über das AGG das Recht auf ‚korrekte Ansprache‘ auf das Privatrechtsverhältnis aus. Dabei stellt das Gericht nicht auf das ‚Geschlecht‘ im Sinne des Personenstandsgesetzes (PStG) ab, sondern die Geschlechtsidentität im Fall der Zwischengeschlechtlichkeit.“"
                            },
                            {
                                "example_id": "36489678-d0c6-4c8f-9e48-abcfd836d4f9",
                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                "text": "„Sich nicht komplett männlich zu fühlen oder Anteile anderer Geschlechter an sich wahrzunehmen, ist also gar nicht so selten. Bei Demiboys ist diese Zwischengeschlechtlichkeit nur eindeutiger ausgeprägt bzw. sie möchten diese unterschiedlichen Geschlechtsidentitäten auch gerne nach außen tragen und ihr Geschlechtsempfinden individuell gestalten.“"
                            },
                            {
                                "example_id": "307c1ae4-b2e9-409d-8b9b-0ac013d87f6c",
                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                "text": "„Zwischengeschlechtlichkeit umfasst verschiedene Selbstdefinitionen und Lebensweisen zwischen den üblichen zwei Geschlechtern bzw. jenseits davon.“"
                            },
                            {
                                "example_id": "9d2c7ea9-57c3-4eeb-a0a6-7bdfcd0880e0",
                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                "text": "„Fachleute sprechen von nicht-binär, wenn ein Mensch weder ausschließlich männlich noch weiblich ist. Ein anderer Begriff für die Zwischengeschlechtlichkeit ist divers.“"
                            },
                            {
                                "example_id": "f3954166-b19b-4290-a3d8-a694b625a5c0",
                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                "text": "„Dieser iterative Prozess, der das Soziale durchzieht und (re)produziert, schafft geschlechtliche, binäre Subjekte und sondert intelligible Zwischenformen rigoros aus. Zwischengeschlechtlichkeit wird als sozial nicht lesbar verworfen, eliminiert oder diskriminiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be9a55e4-404f-48c2-a5aa-59855774ae48",
                        "source_entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "source_sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                        "source_sense_description": "das Auftreten sowohl von männlichen als auch von weiblichen Geschlechtsmerkmalen",
                        "target_lang_word": "intersexuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intersexuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47969053-8230-3c6b-a561-14dde9b80ed9",
                                        "entry_id": "a6a3b6a5-7890-3cb7-a544-3a731609ca06",
                                        "glosses": [
                                            "The state of having the physical features of both sexes, or of having ambiguous sex, i.e. not unambiguously male or female."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43ff734b-8baf-47a2-ba45-ba8d1929f403",
                        "source_entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "source_sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                        "source_sense_description": "das Auftreten sowohl von männlichen als auch von weiblichen Geschlechtsmerkmalen",
                        "target_lang_word": "intersexualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intersexualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                        "entry_id": "8c30c302-3a83-3962-afe9-391e149bf83e",
                                        "glosses": [
                                            "Fait pour un être humain ou un animal de posséder des caractéristiques sexuelles qui ne correspondent pas aux définitions de mâle ou femelle selon les normes en vigueur."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1117bc3-b3a5-49b0-b3f8-08bcf2af8187",
                                                "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                                "text": "A l’exception du free-martinisme bovin, l’intersexualité est rare chez les animaux domestiques."
                                            },
                                            {
                                                "example_id": "34254a46-36bd-4560-bae0-1bb447f64a36",
                                                "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                                "text": "La dysphorie de genre est liée au désir d’avoir un corps dont le sexe est en accord avec la perception de soi et l’intersexualité est liée au fait d’être pourvu d’un corps qui n’appartient pas d’emblée à un sexe défini."
                                            },
                                            {
                                                "example_id": "910782ed-aa30-4cbf-b0ab-7e3f7040eb72",
                                                "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                                "text": "La découverte de son intersexualité — cachée par ses parents « pour la protéger », et les médecins, qui n’ont eu de cesse de couloir la « réparer », — a bouleversé sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99f7264f-a9c8-4c7d-afff-5d7624a0adb0",
                        "source_entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "source_sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                        "source_sense_description": "weder dem weiblichen noch dem männlichen Geschlecht zuordenbare Geschlechtsidentität",
                        "target_lang_word": "non-binarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-binarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc1d52ad-1fe7-3463-b806-52edf209b076",
                                        "entry_id": "0c443403-9a5b-3170-8302-c6f96e1a2283",
                                        "glosses": [
                                            "The quality of being non-binary (not binary); absence of binarity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d718e551-dc5b-4846-992f-f1be7a38a13a",
                                                "sense_id": "bc1d52ad-1fe7-3463-b806-52edf209b076",
                                                "text": "Beyond Ladefoged's arguments for non-binarity (1970), I feel that the human nervous system is not constructed in a way that it could use binarity easily, either in perception or production."
                                            },
                                            {
                                                "example_id": "24e9133e-b5eb-42fd-b5d0-97ebe3b362cc",
                                                "sense_id": "bc1d52ad-1fe7-3463-b806-52edf209b076",
                                                "text": "Through his use of ellipsis, understatement, unspecified agency, and non-binarity, Johnson is thus attempting to bring about a change in the status of the Negro without explicitly acknowledging or processing conflict and dispossession."
                                            },
                                            {
                                                "example_id": "fb975b5e-e33b-4817-bf63-fdc30c965a24",
                                                "sense_id": "bc1d52ad-1fe7-3463-b806-52edf209b076",
                                                "text": "As regards its particular mass and age, and probably its non-binarity, \"anthropic\" explanations may seem in place. The possible tendency for the Sun, as compared with similar stars, to be somewhat rich in iron relative to other elements […]"
                                            },
                                            {
                                                "example_id": "630fc56d-aa2d-4811-90aa-ebb7819a4017",
                                                "sense_id": "bc1d52ad-1fe7-3463-b806-52edf209b076",
                                                "text": "On the non-binarity of the null subject parameter"
                                            },
                                            {
                                                "example_id": "42dc7c4a-3cc0-431e-8b20-d6d8bbdd3017",
                                                "sense_id": "bc1d52ad-1fe7-3463-b806-52edf209b076",
                                                "text": "Nor can we maintain the converse position that a defining property of parameters is non-binarity, as there appear to be some, most notably the directionality parameters, which by their very nature are binary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c2b2ffc-9251-414a-9927-53eff414663b",
                        "source_entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                        "source_sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                        "source_sense_description": "weder dem weiblichen noch dem männlichen Geschlecht zuordenbare Geschlechtsidentität",
                        "target_lang_word": "non-binarité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-binarité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4579fc1d-29ee-3bb1-9abb-fcdebe937bc0",
                                        "entry_id": "c309e6ca-4986-3471-991b-1057c26734d1",
                                        "glosses": [
                                            "Identité de genre en dehors de la binarité femme/homme."
                                        ],
                                        "tags": [
                                            "LGBTQ",
                                            "Non-binarité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a03b7a8-ae63-4807-aa5a-e03a16770465",
                                                "sense_id": "4579fc1d-29ee-3bb1-9abb-fcdebe937bc0",
                                                "text": "La non-binarité se caractérise par le fait que je n’arrive pas à me reconnaître dans le genre strictement féminin ou strictement masculin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd55c55-80db-3b07-b82c-4132c9de1499",
                                        "entry_id": "c309e6ca-4986-3471-991b-1057c26734d1",
                                        "glosses": [
                                            "Conception des genres humains et de leurs expressions qui tient compte de leur diversité, sans reproduire les normes de genre binaires."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e2d5b0-2bfb-4911-925d-33d64ced317c",
                                                "sense_id": "1bd55c55-80db-3b07-b82c-4132c9de1499",
                                                "text": "C’est curieusement un monde hétéronormé dont la séduction fonctionne sur un cliché féminin mais, heureusement, il s’ouvre à la non-binarité"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
