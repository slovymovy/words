            "senses": [
                {
                    "sense_id": "05fc2e24-e8b4-3f75-8436-35671d4b4bdf",
                    "sense_definition": "Wederkerend voornaamwoord voor de derde persoon enkelvoud en meervoud (hemzelf, haarzelf, zichzelf, henzelf).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reflexive_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wast <w>zich</w> elke ochtend met koud water.",
                            "target_lang_translations": {
                                "en": "He washes <w>himself</w> every morning with cold water."
                            }
                        },
                        {
                            "text": "Zij voelen <w>zich</w> vandaag een stuk beter dan gisteren.",
                            "target_lang_translations": {
                                "en": "They feel <w>themselves</w> a lot better today than yesterday."
                            }
                        },
                        {
                            "text": "In deze moeilijke situatie is het vaak ieder voor <w>zich</w>.",
                            "target_lang_translations": {
                                "en": "In this difficult situation, it is often every man for <w>himself</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zichzelf"
                    ],
                    "common_phrases": [
                        "ieder voor zich",
                        "zich wassen",
                        "zich voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Reflexive pronoun for the third person singular and plural (himself, herself, itself, themselves)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "himself",
                                "target_lang_sense_clarification": "referring back to a male subject"
                            },
                            {
                                "target_lang_word": "herself",
                                "target_lang_sense_clarification": "referring back to a female subject"
                            },
                            {
                                "target_lang_word": "themselves",
                                "target_lang_sense_clarification": "referring back to a plural subject"
                            },
                            {
                                "target_lang_word": "itself",
                                "target_lang_sense_clarification": "referring back to a neutral or inanimate subject"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b7e06b1-cf12-33b6-97e6-7556c289a236",
                    "sense_definition": "Wederkerend voornaamwoord voor de tweede persoon enkelvoud en meervoud in de beleefdheidsvorm (uzelf).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflexive_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U kunt <w>zich</w> hier inschrijven voor de nieuwe cursus.",
                            "target_lang_translations": {
                                "en": "You can register <w>yourself</w> here for the new course."
                            }
                        },
                        {
                            "text": "Vergist u <w>zich</w> niet in de tijd die dit kost?",
                            "target_lang_translations": {
                                "en": "Are you not mistaken <w>yourself</w> about the time this takes?"
                            }
                        }
                    ],
                    "synonyms": [
                        "uzelf"
                    ],
                    "common_phrases": [
                        "u vergist zich",
                        "zich aanmelden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal register"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Reflexive pronoun for the second person singular and plural in the formal register (yourself, yourselves)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yourself",
                                "target_lang_sense_clarification": "formal singular"
                            },
                            {
                                "target_lang_word": "yourselves",
                                "target_lang_sense_clarification": "formal plural"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc1ea70e-05a4-3ad3-85c4-5be8b009c5c1",
                    "sense_definition": "Gebruikt in combinatie met werkwoorden om een onbedoeld of extreem resultaat van een handeling uit te drukken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unintended_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij lachte <w>zich</w> een bult om die grappige film.",
                            "target_lang_translations": {
                                "en": "He laughed <w>himself</w> silly at that funny movie."
                            }
                        },
                        {
                            "text": "De fietser viel <w>zich</w> een ongeluk op het gladde wegdek.",
                            "target_lang_translations": {
                                "en": "The cyclist had a terrible fall <w>himself</w> on the slippery road surface."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich een bult lachen",
                        "zich een ongeluk vallen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in idiomatic expressions"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used in combination with verbs to express an unintended, extreme, or idiomatic result of an action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oneself",
                                "target_lang_sense_clarification": "used in idiomatic expressions of intensity"
                            }
                        ]
                    }
                }
            ]
        }
