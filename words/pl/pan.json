    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "c381008d-18c1-353d-b094-2805a3fb3b01",
                    "sense_definition": "Zwrot grzecznościowy zastępujący zaimek osobowy drugiej osoby („ty”) przy zwracaniu się do mężczyzny; gramatycznie łączy się z czasownikiem w trzeciej osobie liczby pojedynczej.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy może <w>pan</w> otworzyć okno?",
                            "target_lang_translations": {
                                "ru": "Не могли бы <w>вы</w> открыть окно?",
                                "en": "Could <w>you</w> open the window?"
                            }
                        },
                        {
                            "text": "Gdzie <w>pan</w> kupił tę gazetę?",
                            "target_lang_translations": {
                                "ru": "Где <w>вы</w> купили эту газету?",
                                "en": "Where did <w>you</w> buy this newspaper?"
                            }
                        },
                        {
                            "text": "Przepraszam, czy to <w>pana</w> parasol?",
                            "target_lang_translations": {
                                "ru": "Извините, это <w>ваш</w> зонт?",
                                "en": "Excuse me, is this <w>your</w> umbrella?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "proszę pana",
                        "czy pan",
                        "niech pan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое обращение, заменяющее местоимение «ты» при обращении к мужчине; грамматически сочетается с глаголом в третьем лице единственного числа.",
                        "en": "A polite form of address replacing the second-person pronoun ('you') when addressing a man; grammatically it combines with a verb in the third-person singular."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы",
                                "target_lang_sense_clarification": "вежливое обращение"
                            },
                            {
                                "target_lang_word": "господин",
                                "target_lang_sense_clarification": "формальное обращение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "you",
                                "target_lang_sense_clarification": "polite form of address to a man"
                            },
                            {
                                "target_lang_word": "sir",
                                "target_lang_sense_clarification": "respectful term of address to a man"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8faee22f-af06-3912-b1f6-4d15f1b53f21",
                    "sense_definition": "Dorosły mężczyzna, zwłaszcza taki, którego nie znamy lub o którym mówimy z szacunkiem.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jakiś <w>pan</w> pytał o ciebie w recepcji.",
                            "target_lang_translations": {
                                "ru": "Какой-то <w>господин</w> спрашивал о тебе на ресепшене.",
                                "en": "Some <w>gentleman</w> was asking for you at the reception."
                            }
                        },
                        {
                            "text": "Ten starszy <w>pan</w> jest moim sąsiadem.",
                            "target_lang_translations": {
                                "ru": "Этот пожилой <w>господин</w> — мой сосед.",
                                "en": "That elderly <w>gentleman</w> is my neighbor."
                            }
                        }
                    ],
                    "synonyms": [
                        "mężczyzna"
                    ],
                    "antonyms": [
                        "pani"
                    ],
                    "common_phrases": [
                        "starszy pan",
                        "młody pan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослый мужчина, особенно незнакомый или о котором говорят с уважением.",
                        "en": "An adult man, especially one who is unknown or spoken of with respect."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господин",
                                "target_lang_sense_clarification": "вежливое обозначение мужчины"
                            },
                            {
                                "target_lang_word": "мужчина",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "gentleman",
                                "target_lang_sense_clarification": "polite term for a man"
                            },
                            {
                                "target_lang_word": "man",
                                "target_lang_sense_clarification": "adult male"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6daf9573-5aeb-33ee-9aab-1f297ffe5ab0",
                    "sense_definition": "Tytuł grzecznościowy używany przed imieniem, nazwiskiem lub nazwą stanowiska mężczyzny.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pan</w> Kowalski jest świetnym nauczycielem.",
                            "target_lang_translations": {
                                "ru": "<w>Господин</w> Ковальский — отличный учитель.",
                                "en": "<w>Mr.</w> Kowalski is a great teacher."
                            }
                        },
                        {
                            "text": "Dzień dobry, <w>panie</w> dyrektorze.",
                            "target_lang_translations": {
                                "ru": "Добрый день, <w>господин</w> директор.",
                                "en": "Good morning, <w>Mr.</w> Director."
                            }
                        }
                    ],
                    "antonyms": [
                        "pani"
                    ],
                    "common_phrases": [
                        "pan doktor",
                        "pan dyrektor",
                        "pan młody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый титул, используемый перед именем, фамилией или названием должности мужчины.",
                        "en": "A polite title used before a man's first name, last name, or professional title."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господин",
                                "target_lang_sense_clarification": "титул перед фамилией или должностью"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Mr.",
                                "target_lang_sense_clarification": "title before a surname"
                            },
                            {
                                "target_lang_word": "mister",
                                "target_lang_sense_clarification": "title of address"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e125065-b5f0-3e6b-96a2-f7cc2ddec096",
                    "sense_definition": "Osoba mająca władzę nad czymś lub będąca właścicielem czegoś (np. zwierzęcia, majątku).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "authority_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pies wiernie czekał na swojego <w>pana</w>.",
                            "target_lang_translations": {
                                "ru": "Пёс верно ждал своего <w>хозяина</w>.",
                                "en": "The dog waited faithfully for its <w>master</w>."
                            }
                        },
                        {
                            "text": "On czuje się <w>panem</w> sytuacji.",
                            "target_lang_translations": {
                                "ru": "Он чувствует себя <w>хозяином</w> положения.",
                                "en": "He feels like the <w>master</w> of the situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "właściciel"
                    ],
                    "antonyms": [
                        "służący",
                        "niewolnik"
                    ],
                    "common_phrases": [
                        "pan domu",
                        "pan sytuacji"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, имеющий власть над чем-либо или являющийся владельцем чего-либо (например, животного, имущества).",
                        "en": "A person who has power over something or is the owner of something (e.g., an animal, property)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "владелец"
                            },
                            {
                                "target_lang_word": "властелин",
                                "target_lang_sense_clarification": "обладающий властью"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "master",
                                "target_lang_sense_clarification": "owner of an animal or person in control"
                            },
                            {
                                "target_lang_word": "owner",
                                "target_lang_sense_clarification": "proprietor of property or a pet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "223eb0fe-220e-3193-bf8e-0f41d9d70936",
                    "sense_definition": "W dawnych czasach: właściciel ziemski, arystokrata lub władca sprawujący władzę nad poddanymi.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authority_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chłopi musieli pracować na polu swojego <w>pana</w>.",
                            "target_lang_translations": {
                                "ru": "Крестьяне должны были работать на поле своего <w>барина</w>.",
                                "en": "The peasants had to work on their <w>lord's</w> field."
                            }
                        },
                        {
                            "text": "Bogaty <w>pan</w> zorganizował wielką ucztę na zamku.",
                            "target_lang_translations": {
                                "ru": "Богатый <w>пан</w> устроил большой пир в замке.",
                                "en": "A wealthy <w>lord</w> organized a grand feast at the castle."
                            }
                        }
                    ],
                    "synonyms": [
                        "właściciel",
                        "panisko"
                    ],
                    "antonyms": [
                        "służący",
                        "niewolnik"
                    ],
                    "common_phrases": [
                        "pan feudalny",
                        "wielki pan"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В прошлом: землевладелец, аристократ или правитель, имеющий власть над подданными.",
                        "en": "In historical times: a landowner, aristocrat, or ruler exercising power over subjects."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барин",
                                "target_lang_sense_clarification": "помещик"
                            },
                            {
                                "target_lang_word": "пан",
                                "target_lang_sense_clarification": "исторический контекст (Польша, Украина)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lord",
                                "target_lang_sense_clarification": "feudal superior or nobleman"
                            },
                            {
                                "target_lang_word": "master",
                                "target_lang_sense_clarification": "historical owner of servants or estates"
                            }
                        ]
                    }
                }
            ]
        },
        {
