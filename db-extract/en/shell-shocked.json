                        "entry_id": "ec703f8c-f51c-363c-a9bd-3591fc67d6cf",
                        "glosses": [
                            "Stunned or mentally unbalanced by prolonged stress such as experienced in combat or under fire (shell-fire); suffering from post-traumatic stress disorder."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "878c5c0b-ac50-4961-944a-81ac5c28347b",
                                "sense_id": "127c4a74-34c2-3ca6-8c7e-da4209a0b548",
                                "text": "Glenn Kilbourne had returned from France early that fall, shell-shocked and gassed, and otherwise incapacitated for service in the army—a wreck of his former sterling self."
                            }
                        ]
                    },
                    {
                        "sense_id": "762eb99e-44a0-3b5f-82ad-6f6862403834",
                        "entry_id": "ec703f8c-f51c-363c-a9bd-3591fc67d6cf",
                        "glosses": [
                            "Confused as a result of a traumatic experience."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0182351b-650c-403a-9567-8d313b13efb0",
                                "sense_id": "762eb99e-44a0-3b5f-82ad-6f6862403834",
                                "text": "With inflationary pressures easing and economic concerns mounting, shell-shocked investors are seeking the protection of government securities."
                            },
                            {
                                "example_id": "cf072b2f-854b-4a55-a6af-3e24c6dde76e",
                                "sense_id": "762eb99e-44a0-3b5f-82ad-6f6862403834",
                                "text": "I lay there, momentarily shell-shocked as, hungover and jet-lagged, I tried to remember what I was doing today. Something important."
                            },
                            {
                                "example_id": "3962e2de-4ad2-40fe-aa71-6cf96e9efb4d",
                                "sense_id": "762eb99e-44a0-3b5f-82ad-6f6862403834",
                                "text": "A family from Knebworth has been left shell-shocked by the return of their beloved tortoise, more than eight months after she went missing."
                            }
                        ]
                    }
