                "senses": [
                    {
                        "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                        "entry_id": "54709cce-98dc-3b70-b92f-49bc7d4abe9c",
                        "glosses": [
                            "Name eines Eingabegerätes für Spiele in Form eines Hebels und meist mehrerer Knöpfe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8a9882-a102-4a33-ab52-f55b6d62c385",
                                "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                "text": "Heutzutage werden kaum noch Joysticks benutzt."
                            },
                            {
                                "example_id": "22a4d5c9-5e76-471b-939d-fbec39ce298b",
                                "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                "text": "„Bedient wird der Boxmover über eine Funkfernsteuerung, wobei man angesichts konventioneller Kransteuerungen mit mehreren Joysticks erst Erfahrungen sammeln musste.“"
                            },
                            {
                                "example_id": "5cdcd3da-c333-45f1-8051-d2fd0dd31791",
                                "sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                                "text": "„Immer waren irgendwelche Jungs da, um mit meinen Brüdern zu spielen, sie lungerten mit ihren Joysticks auf dem Wasserbett herum, während wir, die Mädchen aus meiner Klasse und ich, uns auf dem Boden zusammendrängten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fa1d564-7c68-465c-9dff-5b9c9b88c781",
                        "source_entry_id": "54709cce-98dc-3b70-b92f-49bc7d4abe9c",
                        "source_sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                        "source_sense_description": "Steuerungshebel für Computerspiele",
                        "target_lang_word": "joystick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joystick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af3d8f3f-a3fe-3d85-9ac3-97160feadefc",
                                        "entry_id": "22fe8579-b32f-3bfe-abd8-e374f524c1b7",
                                        "glosses": [
                                            "A mechanical control device consisting of a handgrip mounted on a base or pedestal and typically having one or more buttons, used to control an aircraft, computer, or other equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae999f4-5e24-4ac5-8104-e9447f7a422b",
                                                "sense_id": "af3d8f3f-a3fe-3d85-9ac3-97160feadefc",
                                                "text": "If games are your life, the choice of a joystick is desperately important."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad1d7e7-6f9c-382a-a505-7edb6ac7aa39",
                                        "entry_id": "22fe8579-b32f-3bfe-abd8-e374f524c1b7",
                                        "glosses": [
                                            "A penis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c745563e-1a0d-45ff-af8f-ebee54842fd3",
                                                "sense_id": "1ad1d7e7-6f9c-382a-a505-7edb6ac7aa39",
                                                "text": "She playing with my joystick\n All in my two seater"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joystick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                        "entry_id": "3406530b-d316-3491-b92b-b42e17445df6",
                                        "glosses": [
                                            "To manoeuvre by means of a joystick (sense 1)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0da9245-3448-4f6d-951e-30c0b43edf04",
                                                "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                                "text": "Marketing your home isn't as difficult as joysticking a Mars rover through a crater, despite what many people believe."
                                            },
                                            {
                                                "example_id": "d1510b27-5e5a-4979-bce0-aa44eacb4a7a",
                                                "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                                "text": "Therefore, part of the errors in the localization results is due to the problem of joysticking the robot exactly onto the marked positions."
                                            },
                                            {
                                                "example_id": "e693d011-7f83-45f2-9b67-4bff6ab893ea",
                                                "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                                "text": "It can run in autonomous mode or be manually joysticked using a radio controller."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbcefc2a-768d-4bc3-904f-f66c3fc2f632",
                        "source_entry_id": "54709cce-98dc-3b70-b92f-49bc7d4abe9c",
                        "source_sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                        "source_sense_description": "Steuerungshebel für Computerspiele",
                        "target_lang_word": "joystick",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joystick",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b5640e-d69a-3249-89c1-a467079d4f3d",
                                        "entry_id": "ccd52c3f-c643-383a-8b63-0dc2e8c8a03c",
                                        "glosses": [
                                            "Manette de jeu vidéo ou d'engins roulants, composée d’un manche et de boutons."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577b5bc8-a66f-44ce-851f-83adcf3b442d",
                                                "sense_id": "a4b5640e-d69a-3249-89c1-a467079d4f3d",
                                                "text": "Morphine et midazolam. Des tuyaux qui vont des poches au ventre de mon père. Sous-cutané. Il y a des poignées comme des joysticks pour balancer des doses en plus qu’on appelle des bolus. Bolus, mot nouveau. Un bolus autorisé toutes les trois heures. Un bolus de sédatif et un bolus de morphine. Je touche l’écran des pompes, je contrôle, je mets mes mains sur les joysticks, bip la morphine, bip le sédatif. […] La mort est un jeu vidéo, PlayStation ou console Atari."
                                            },
                                            {
                                                "example_id": "6ef0b519-ef94-460b-9d20-86f1a6b1b56f",
                                                "sense_id": "a4b5640e-d69a-3249-89c1-a467079d4f3d",
                                                "text": "De série, le tracteur reçoit un joystick multifonction, un tableau de bord digital de 10 pouces ainsi qu’un terminal de 12 pouces dans le toit. En option, le joystick 3L peut compléter l’équipement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfd057f0-fd77-4468-9f79-ea799100e9e0",
                        "source_entry_id": "54709cce-98dc-3b70-b92f-49bc7d4abe9c",
                        "source_sense_id": "707b02ae-84b2-3b27-beb1-8ca1238ebd99",
                        "source_sense_description": "Steuerungshebel für Computerspiele",
                        "target_lang_word": "manche à balai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manche à balai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                        "entry_id": "ef9f2992-9425-334c-a6d6-d48a12ec9e7a",
                                        "glosses": [
                                            "Manche d'un balai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d3a7dde-0d8b-4c5c-a58f-756c77ab6cb2",
                                                "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                                "text": "Le corps, une espèce de manche à balai, décemment couvert d’une robe, jouissait des avantages de la nature morte, il ne remuait point."
                                            },
                                            {
                                                "example_id": "6bd07e26-fa6a-4c3f-ac32-cdaccb1e1a83",
                                                "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                                "text": "— Voilà encore ces vieilles folles qui se croient au sabbat, dit-il, et qui font plus de bruit que lorsqu’elles y arrivent à cheval sur un manche à balai."
                                            },
                                            {
                                                "example_id": "92c7473f-ace6-4493-bb2e-b88be3aa904a",
                                                "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                                "text": "J’avais des jouets, une voiture bleue avec des roues, un cheval de bois, tandis qu’ils en étaient réduits à chevaucher des manches à balais et à traîner ce qui n’était carriole que dans leur imagination, deux ou trois planches mal assemblées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16aae0c-04e1-3975-a1bf-4431fb4a9548",
                                        "entry_id": "ef9f2992-9425-334c-a6d6-d48a12ec9e7a",
                                        "glosses": [
                                            "Manette de direction, levier de commande de l’avion."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd6647fb-0e71-49da-a28e-0f89e2863ba1",
                                                "sense_id": "e16aae0c-04e1-3975-a1bf-4431fb4a9548",
                                                "text": "Dans cet élan prodigieux, la machine parut lever le nez et se raidir. Nous avons fait comme un saut de mouton, puis j’ai arraché, avec plus d’énergie peut-être qu’auparavant, le « manche à balai ». À cet instant notre biplan se trouva dans une position beaucoup plus normale, et fila d’un trait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dcaf08d-6813-38f4-bba2-0bf275baf83f",
                                        "entry_id": "ef9f2992-9425-334c-a6d6-d48a12ec9e7a",
                                        "glosses": [
                                            "Dispositif de commande à plusieurs degrés de liberté servant à déplacer le curseur d’un écran de visualisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
