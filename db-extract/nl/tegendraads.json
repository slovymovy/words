                                        "glosses": [
                                            "Qui aime à contrarier, en parlant d'une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c58c83b-f0a5-4c26-9d7b-c43a7c60ffca",
                                                "sense_id": "7d974be1-87ff-3ada-b3d6-24f3c1fe6550",
                                                "text": "Vous êtes bien contrariant, bien contrariante. - Esprit contrariant. - Humeur contrariante."
                                            },
                                            {
                                                "example_id": "43977e89-60b2-4560-930e-5dbb551640c8",
                                                "sense_id": "7d974be1-87ff-3ada-b3d6-24f3c1fe6550",
                                                "text": "Tante Aline n’était ni curieuse, ni contrariante, elle ne posait pas de questions : « Pourquoi as-tu les yeux rouges ? Pourquoi ne manges-tu pas ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50eb3ac-7450-3d2a-b7d9-048d39c3eab6",
                                        "entry_id": "d319eb60-be42-3291-99bd-45deca24339e",
                                        "glosses": [
                                            "Qui est de nature à contrarier, en parlant d'une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
