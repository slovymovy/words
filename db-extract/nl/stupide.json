                                                "sense_id": "5fa72d1e-3a21-32ed-8217-728e774a2ab4",
                                                "text": "And it would be a fine proposition\nIf I was a stupid girl\nBut honey, I am no one's exception\nThis I have previously learned"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Exhibiting the quality of having been done by someone lacking in intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5395b0b1-9564-4e90-aa21-ad9e11832215",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "So I have to pay first, and then wait in line? That's a stupid rule!"
                                            },
                                            {
                                                "example_id": "12e965f3-fc82-4ebb-b0e0-2c21a85e719f",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "He made the stupid decision of standing in a half-hour queue for a hamburger, instead of calling ahead."
                                            },
                                            {
                                                "example_id": "92cc0b6d-fccb-4274-b7ee-87c13c4b83f5",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "I should have spoke to him there and then, seen he was in the mood to do something stupid."
                                            },
                                            {
                                                "example_id": "8cba2915-5545-4254-ad6c-fc74c10dd0f5",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "You can kiss a hundred boys in bars\nShoot another shot, try to stop the feeling\nYou can say it's just the way you are\nMake a new excuse, another stupid reason"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Unpleasant; annoying to the speaker. This sense can be used alongside obscene words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8549b3a3-dd7c-454e-9710-15b7f68704a7",
                                                "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                                                "text": "The stupid rusty wire cut my thumb when I grabbed it."
                                            },
                                            {
                                                "example_id": "62d9222a-fcb0-49aa-ac4a-a6082b065755",
                                                "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                                                "text": "Marcie Linguini, who had come down with a stupid ear infection the day of Thanksgiving vacation, curled deeper into her bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Usually replaces an obscene or profane word, and thus is audibly stressed as such."
                                        ],
                                        "tags": [
                                            "euphemistic"
