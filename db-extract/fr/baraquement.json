                                        "entry_id": "9585011d-e429-3933-96c9-e0f470ce778e",
                                        "glosses": [
                                            "A group of buildings used by military personnel as housing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e533b3-3689-4651-83d2-7e60c0c52545",
                                                "sense_id": "0aecb2db-4fd7-3a2f-92da-4fcd3c630338",
                                                "text": "There is a large barracks in this town and two other barracks are nearby."
                                            },
                                            {
                                                "example_id": "2643d76d-1ba7-4e81-a320-205e315fdc81",
                                                "sense_id": "0aecb2db-4fd7-3a2f-92da-4fcd3c630338",
                                                "text": "Resendiz was last seen on May 29 in her barracks in Miller Hall at Naval Station Norfolk, according to a missing person’s alert issued by Virginia State Police on June 3."
                                            }
                                        ]
                                    }
                                ]
