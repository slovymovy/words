                    "sense_id": "31ed9f7f-97ac-304a-b2ba-24fddf7d3d03",
                    "sense_definition": "Cérémonie religieuse ou civile et ensemble des actes qui accompagnent la mise en terre d'une personne décédée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille s'est réunie au village pour assister à l'<w>enterrement</w> de leur grand-mère."
                        },
                        {
                            "text": "Il portait un costume noir très élégant à l'<w>enterrement</w> de son collègue."
                        }
                    ],
                    "synonyms": [
                        "funérailles",
                        "obsèques",
                        "inhumation",
                        "mise en terre"
                    ],
                    "common_phrases": [
