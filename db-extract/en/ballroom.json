                    }
                ],
                "senses": [
                    {
                        "sense_id": "e99bf793-eccc-354d-a738-11afa2afb7a2",
                        "entry_id": "3027fec5-2424-3409-a268-15078a312b19",
                        "glosses": [
                            "A large room used for dancing and banquets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f742b2b-5fb0-4b0f-8d89-4332422ab5d0",
                                "sense_id": "e99bf793-eccc-354d-a738-11afa2afb7a2",
                                "text": "The boy became volubly friendly and bubbling over with unexpected humour and high spirits. He tried to persuade Cicely to stay away from the ball-room for a fourth dance. Nobody would miss them, he explained."
                            }
                        ]
                    },
                    {
                        "sense_id": "50b1593d-17a2-38af-a8c2-2f1b4ab0bbc0",
                        "entry_id": "3027fec5-2424-3409-a268-15078a312b19",
                        "glosses": [
                            "A type of elegant dance."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50e36bc-8e5c-4034-b78d-7319e5b4f1ce",
                        "source_entry_id": "3027fec5-2424-3409-a268-15078a312b19",
                        "source_sense_description": "large room used for dancing",
                        "target_lang_word": "salle de bal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f2ad529c-8d28-4fec-83af-f966f8837147",
                        "source_entry_id": "3027fec5-2424-3409-a268-15078a312b19",
                        "source_sense_description": "large room used for dancing",
                        "target_lang_word": "Ballsaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ballsaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                        "entry_id": "a17a06ba-9d47-38c9-a6cd-d91fda4cc9a7",
                                        "glosses": [
                                            "großer und geschmückter Raum in einem Schloss oder anderem (öffentlichen) Gebäude, in dem Tanzveranstaltungen stattfinden oder -fanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a217dd-562b-4a76-ae93-ea5f302ed32d",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "Gekleidet in eleganten Ballkleidern und Smokings betraten die Debütantinnen mit ihren Tanzpartnern den Ballsaal."
                                            },
                                            {
                                                "example_id": "34d92370-af6d-4691-960f-3938671b8095",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "Wegen der vielen Kerzen herrschte in mittelalterlichen Ballsälen eine erhöhte Brandgefahr."
                                            },
                                            {
                                                "example_id": "627540fc-009d-4794-a6b0-0d193e48b425",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "Im Ballsaal feierte das Brautpaar ihre Hochzeit."
                                            },
                                            {
                                                "example_id": "b446b129-d499-46a3-ad4e-8b225c200628",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "„Unpassend gekleidete Gäste werden aus dem Ballsaal verwiesen!“"
                                            },
                                            {
                                                "example_id": "4754ff15-a19f-493e-91aa-6ab99a650bfb",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "Als Show-Event wurde im Ballsaal eine Balletteinlage getanzt."
                                            },
                                            {
                                                "example_id": "9413f11f-fb2f-41a5-838a-73d39bdd97fe",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "„Niemand hat es je gewagt, die bemalten Kassettendecken und die riesigen Lüster im Ballsaal anzurühren.“"
                                            },
                                            {
                                                "example_id": "aacd824d-7711-44cd-a0ef-191e068a1b7b",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "„Mehr als 600 Genossen hocken unter dem Holzdach des Ballsaals an langen Tischen, trinken Bier (2,90 Euro), schneiden Schweineschnitzel (13,50 Euro).“"
                                            },
                                            {
                                                "example_id": "04d78a48-e599-4b08-8dc3-8b4ab5c19090",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "„Als wir in den Ballsaal traten, öffnete sich die große Schar der Gäste zu einem Korridor.“"
                                            },
                                            {
                                                "example_id": "3fbf6a25-705d-405b-9b32-7596b32180e3",
                                                "sense_id": "30edeb9e-6740-345b-89fb-3e54169e1472",
                                                "text": "„Natascha hatte kaum den Ballsaal betreten, als sie auch schon verliebt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af2819d9-78ba-49f1-8092-f661ab069e78",
                        "source_entry_id": "3027fec5-2424-3409-a268-15078a312b19",
                        "source_sense_description": "large room used for dancing",
                        "target_lang_word": "Tanzsaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanzsaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec91125-9294-364b-9aca-766a7ca54ecb",
                                        "entry_id": "e2a7ee09-3e1f-3a7e-80f3-01862dfd86aa",
                                        "glosses": [
                                            "großer Raum zum Tanzen in einem Lokal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4d9152-e2d1-47c3-9b4f-a1bc9a21538c",
                                                "sense_id": "4ec91125-9294-364b-9aca-766a7ca54ecb",
                                                "text": "„Thema Nummer eins ist jetzt die Dorfkneipe und der Tanzsaal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bd6a452-0e2a-477b-b124-a0c8bc8516c9",
                        "source_entry_id": "3027fec5-2424-3409-a268-15078a312b19",
                        "source_sense_description": "large room used for dancing",
                        "target_lang_word": "Festsaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Festsaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                        "entry_id": "6f676662-7355-3a11-9381-0a699df6fd1e",
                                        "glosses": [
                                            "großer Raum für ein Fest/für Feste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dee5e8b-41b6-4ac2-b45f-709590deb2ce",
                                                "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                                "text": "„Ich muß wohl ein wenig eingenickt sein, denn auf einmal war alles im Festsaal verändert.“"
                                            },
                                            {
                                                "example_id": "aef51fa8-bd07-4c29-994d-8ef40fbbf362",
                                                "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                                "text": "„Aus dem Festsaal wird eine Kantine mit Tüllgardinen.“"
                                            },
                                            {
                                                "example_id": "7564a12c-6582-4530-965c-b1f3da57563e",
                                                "sense_id": "020d8f21-fbfb-32dd-8544-113e4911e6e6",
                                                "text": "„Im großen Festsaal, am Vormittag von der Hausdame und ihren Mädchen mit einer Fülle von Blumengestecken und Girlanden dekoriert, wurden die Dessert-Teller abgeräumt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
