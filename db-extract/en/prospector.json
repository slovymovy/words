                                                "sense_id": "0f7ed745-41a2-3287-b5d4-06a8702fcdef",
                                                "text": "Prospecteur/prospectrice terrain-secteur photovoltaïque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbafad4-e0f3-34a9-844a-52ae18d50701",
                                        "entry_id": "e3cdc5bd-cd0f-3ea4-990e-a407af9c7e92",
                                        "glosses": [
                                            "Celle qui recherche et participe avant les autres à des événements nouveaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52903bcc-1b41-4f5f-a916-60fb48d85cae",
                                                "sense_id": "afbafad4-e0f3-34a9-844a-52ae18d50701",
                                                "text": "Zizi et Marie-Hélène avaient tout vu – pièces, films ballets, expositions de tableaux, collections de haute couture, – avant le grand public. Même Valérie était à la traîne par rapport à ces prospectrices de l’art parisien."
                                            }
                                        ]
                                    }
                                ]
                            },
