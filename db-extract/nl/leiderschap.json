                        "sense_id": "01a4d198-5c05-391c-abbd-f741586be922",
                        "entry_id": "76f34060-e0b6-36f8-8160-b4040f41b9bb",
                        "glosses": [
                            "leadership"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "81b68993-1521-4045-8173-afc1ff30d755",
                                "sense_id": "01a4d198-5c05-391c-abbd-f741586be922",
                                "text": "Hij toonde uitstekend leiderschap tijdens de crisissituatie.",
                                "translation": "He displayed excellent leadership during the crisis situation.",
                                "english": "He displayed excellent leadership during the crisis situation."
                            },
                            {
                                "example_id": "b1d2bf11-b781-4bf2-97b7-d6e4c067fd16",
                                "sense_id": "01a4d198-5c05-391c-abbd-f741586be922",
                                "text": "Het succes van het bedrijf is te danken aan het sterke leiderschap van de directeur.",
                                "translation": "The success of the company is attributed to the strong leadership of the director.",
                                "english": "The success of the company is attributed to the strong leadership of the director."
                            },
                            {
                                "example_id": "7c39da93-6ece-419a-a551-7025c45cf3b2",
                                "sense_id": "01a4d198-5c05-391c-abbd-f741586be922",
                                "text": "In tijden van verandering is goed leiderschap essentieel voor een organisatie.",
                                "translation": "In times of change, good leadership is essential for an organization.",
                                "english": "In times of change, good leadership is essential for an organization."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
