                    {
                        "translation_id": "c7d45f3f-dffe-4d37-87f8-a26bebaed91d",
                        "source_entry_id": "2d909f0e-a52f-34b2-9550-b111c9737796",
                        "source_sense_id": "75d78dbb-7f24-30f4-a5fa-11a18dd4886b",
                        "source_sense_description": "son of one's spouse and not of oneself",
                        "target_lang_word": "Stiefsohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefsohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                        "entry_id": "f46c04a9-49c9-3180-a82a-88e89322f2a8",
                                        "glosses": [
                                            "ein Sohn der Ehefrau oder des Ehemanns aus einer früheren Ehe oder einer außerehelichen Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8c7420-4b9d-433d-a776-270a4d5c079c",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "Sie behandelte Ihren Stiefsohn immer korrekt."
                                            },
                                            {
                                                "example_id": "9e393caa-2352-4847-8cd3-9b4244288199",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "„Der Stiefvater wusste, dass der Oberst ein Theaterliebhaber war und hatte ihm von dem Theaterinteresse seines Stiefsohnes erzählt.“"
                                            },
                                            {
                                                "example_id": "d7c32742-343d-48a2-a424-b3eb775913b9",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "„Und Hélène ist für Martin Mutter und ältere Freundin in einem - es trennen sie viel weniger Jahre von ihrem Stiefsohn als von ihrem Ehemann.“"
                                            },
                                            {
                                                "example_id": "322dd991-620f-48f0-9479-de34d32c94d0",
                                                "sense_id": "07f7e931-18e1-38ea-af22-95c871a4e35c",
                                                "text": "„Sein Stiefsohn sah ihn kein einziges Mal an, sondern steuerte unsicheren Schrittes auf die Treppe zu, seinen Hut am Hinterkopf balancierend, den Schirm noch in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
