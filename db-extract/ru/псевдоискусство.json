                                ]
                            },
                            {
                                "target_word": "pseudo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc7b386-6934-3586-add4-ae78c48538ab",
                                        "entry_id": "523ca603-3eac-353d-b413-eb2ca6b32866",
                                        "glosses": [
                                            "Other than what is apparent; spurious; sham."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0589fcc2-6e8f-4323-9c36-88c3aea690d5",
                                                "sense_id": "2cc7b386-6934-3586-add4-ae78c48538ab",
                                                "text": "Last week saw perhaps the first major showdown between the pseudo cryptolibertarianism they both espouse and that old-fashioned, resolutely analogue concept known as the nation state. For anyone who has spent any time pondering the intergalactic levels of entitlement among the tech broligarchy and the – until now – total impunity they’ve faced, the arrest and subsequent charging of Durov was a singular moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeae1252-0b32-3f91-94ce-1ea52169884f",
                                        "entry_id": "523ca603-3eac-353d-b413-eb2ca6b32866",
                                        "glosses": [
                                            "Insincere."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d55e742-e1b6-4e37-b194-8993f18d93a7",
                        "source_entry_id": "5ef7b300-b90e-3e3a-ab96-cfc904e0f461",
                        "source_sense_id": "59352ea3-c625-300c-bb2f-6d58a6d022a2",
                        "target_lang_word": "Pseudokunst",
