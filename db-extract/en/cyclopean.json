                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313810f9-56d0-4e56-b4b0-4d5d888426ea",
                                                "sense_id": "4ffe0b57-ec56-3525-ae64-8a6a29c94101",
                                                "text": "Olbrzymi, stary dąb trafiony przez piorun spłonął wczorajszej nocy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b920c069-7800-3ccb-966e-d831f4312ce0",
                                        "entry_id": "23224e77-45df-369f-aadc-6aad39d0d932",
                                        "glosses": [
                                            "wielki pod względem ilości, wartości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5d5a1b-6974-43fc-9400-a23ced18286a",
                                                "sense_id": "b920c069-7800-3ccb-966e-d831f4312ce0",
                                                "text": "Mój dziadek kolekcjonuje od dziecka znaczki. Jego olbrzymi zbiór zawiera znaczki z prawie wszystkich krajów świata."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "ebe5e465-282b-31d9-ad5d-1e1f143114b7",
                                        "entry_id": "23224e77-45df-369f-aadc-6aad39d0d932",
                                        "glosses": [
                                            "bardzo intensywny (zjawiska, uczucia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ecdf10-0dea-4045-b0c9-03d4624027fe",
                                                "sense_id": "ebe5e465-282b-31d9-ad5d-1e1f143114b7",
                                                "text": "Olbrzymia wichura zabiła kilka osób, które zostały przygniecione przez budynki."
                                            },
                                            {
                                                "example_id": "b69fff77-d5b1-46af-81ac-fdb16a93e582",
                                                "sense_id": "ebe5e465-282b-31d9-ad5d-1e1f143114b7",
                                                "text": "Odkąd poznał Anię, miotają nim naprawdę olbrzymie uczucia z nią związane."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
