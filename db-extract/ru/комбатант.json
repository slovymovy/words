                                        "glosses": [
                                            "Participe présent de combattre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "227733b5-6881-4d43-b2ee-e7e0907207ed",
                                                "sense_id": "86abeb98-8fd4-331c-9859-98363a78a07d",
                                                "text": "Dans le Mahabharata, poème épique de l’Inde ancienne, il est raconté que Krishna fut blessé à la guerre, en combattant contre le roi Shishupal."
