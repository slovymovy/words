                "senses": [
                    {
                        "sense_id": "4f21b9ce-75d0-3def-8a57-5bdf86794f04",
                        "entry_id": "27d60747-d4eb-33f0-af9e-900f7ba0946b",
                        "glosses": [
                            "meist finanzieller Anreiz, um sich impfen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f3476f-4042-4e56-bf1d-626ed2b88c76",
                                "sense_id": "4f21b9ce-75d0-3def-8a57-5bdf86794f04",
                                "text": "„Damit sich die Mitarbeiter gegen Corona impfen lassen, denken erste Supermärkte über eine Impfprämie für die Angestellten nach.“"
                            },
                            {
                                "example_id": "e5a92e7a-bc10-4609-b5fd-9ebd136e4981",
                                "sense_id": "4f21b9ce-75d0-3def-8a57-5bdf86794f04",
                                "text": "„Zuvor hatte Edeka Nord, einer der sieben Großhandelsbetriebe des Edeka-Verbundes, die die selbstständigen Kaufleute beliefern, angekündigt, seinen Mitarbeitern eine Impfprämie in Form eines 50-Euro-Einkaufsgutscheins zu schenken.“"
                            },
                            {
                                "example_id": "47188f68-fee0-4afb-ac47-1f1cfe2cbe0c",
                                "sense_id": "4f21b9ce-75d0-3def-8a57-5bdf86794f04",
                                "text": "„In den USA zahlt Lidl Mitarbeitern 200 Dollar Impfprämie.“"
                            },
                            {
                                "example_id": "c8c2e0c8-cc8b-49d1-840e-820e87cb66e6",
                                "sense_id": "4f21b9ce-75d0-3def-8a57-5bdf86794f04",
                                "text": "„Für die Konzerne hätte es viele Vorteile, wenn sie ihren Beschäftigten eine Impfprämie zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
