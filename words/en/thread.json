                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist used a lathe to <w>thread</w> <w>a</w> <w>bolt</w> for the custom engine.",
                            "target_lang_translations": {
