                        "entry_id": "4510f356-9163-3f35-8758-5014db27928b",
                        "glosses": [
                            "A type of woolen cloth with a diagonal ribbed texture on one side."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
