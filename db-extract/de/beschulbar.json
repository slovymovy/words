                        "form": "es ist beschulbar"
                    },
                    {
                        "form_id": "1d5a00d0-8335-41ef-a6c3-70d154661ad3",
                        "entry_id": "6ce32300-92ba-3e35-9433-c6a3a5797ee2",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind beschulbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fca5438f-2f24-3556-864b-0b66bba4abbe",
                        "entry_id": "6ce32300-92ba-3e35-9433-c6a3a5797ee2",
                        "glosses": [
                            "in der Lage, eine Bildungseinrichtung besuchen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef400ce-0e12-4d53-904b-efc88fa7db92",
                                "sense_id": "fca5438f-2f24-3556-864b-0b66bba4abbe",
                                "text": "„Er besucht nicht mehr die Schule, weil er laut den Lehrern nicht beschulbar ist.“"
                            },
                            {
                                "example_id": "5c5da6b3-5909-4fad-a582-4dfffa1955fc",
                                "sense_id": "fca5438f-2f24-3556-864b-0b66bba4abbe",
                                "text": "„Dieser Diskurs betraf insbesondere Menschen mit Beeinträchtigungen lange Zeit nicht: Man hat sie einfach als nicht beschulbar erklärt.“"
                            },
                            {
                                "example_id": "af4d4ba4-63b5-41fa-b12a-19f46cb23e0c",
                                "sense_id": "fca5438f-2f24-3556-864b-0b66bba4abbe",
                                "text": "„Einer der bedeutendsten Intelligenzforscher des 20. Jahrhunderts, S. Porteus (1937), hatte demgemäß in der außereuropäischen Welt ganze Bevölkerungen als nicht beschulbar diagnostiziert, als solche, die noch nicht einmal die Grundschule besuchen könnten.“"
                            },
                            {
                                "example_id": "cdb48f48-8017-4b5a-8030-5070d4b84e89",
                                "sense_id": "fca5438f-2f24-3556-864b-0b66bba4abbe",
                                "text": "„Zielgruppe sind Jugendliche, die im Regelschulsystem als nicht beschulbar gelten, unabhängig vom Stand ihrer bisherigen schulischen Bildung und unabhängig von eventuellen Behinderungen.“"
                            },
                            {
                                "example_id": "2875273f-b7cf-4afc-a626-e174af4fc1c6",
