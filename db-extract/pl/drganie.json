                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beba8161-48f2-478e-81df-38e004c5b188",
                                                "sense_id": "04fc5c76-1b09-3d79-9a5a-8ec9798c106b",
                                                "text": "Дрожь механизмов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6debe7-ec08-313e-9c84-dd935c7ff0b6",
                                        "entry_id": "7681ff09-1523-3690-951b-4da4b3348a93",
                                        "glosses": [
                                            "мерцание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba147ea7-7232-4921-b0cf-ed5447e5b433",
                                                "sense_id": "0d6debe7-ec08-313e-9c84-dd935c7ff0b6",
                                                "text": "Одни тухли, другие вспыхивали, электрическая дрожь пробегала по гирляндам, и всё время, качаясь, вспыхивала и гасла большая рогатая ветка, свешивающаяся с потолка."
                                            }
                                        ]
