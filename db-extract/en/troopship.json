                                            {
                                                "example_id": "4863c93b-a917-416c-bf38-c86f334298e6",
                                                "sense_id": "6fe802f1-bac9-33de-bfa9-df0849f6cfea",
                                                "text": "Débarquement en Normandie d’un transport de troupes."
                                            }
