                "forms": [
                    {
                        "form_id": "812f2c1e-8814-4c39-a559-d3d2092c7ae8",
                        "entry_id": "85a6d500-0fef-36d4-8829-2a54a8d68849",
                        "tags": [
                            "plural"
                        ],
                        "form": "amoralismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d2bd984-e046-3d3e-98d9-d85aaa34dd9f",
                        "entry_id": "85a6d500-0fef-36d4-8829-2a54a8d68849",
                        "glosses": [
                            "Ignorance (volontaire ou non) de la morale en vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434c0816-26e1-4016-9745-d7485e3c9cde",
                                "sense_id": "2d2bd984-e046-3d3e-98d9-d85aaa34dd9f",
                                "text": "Son amoralisme dans les affaires de l’amour et du pouvoir —inextricablement enchevêtrées au long de sa carrière— ne l’empêchait pas d’avoir, à la différence de plusieurs de ses rivaux, une conception sérieuse et personnelle des tâches politiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "c59cdbe8-e4f6-30d5-bc4f-807e4b951a60",
                        "entry_id": "85a6d500-0fef-36d4-8829-2a54a8d68849",
                        "glosses": [
                            "Doctrine selon laquelle il n’existe pas de morale immanente, sinon à titre de croyance, sans fondement objectif et universel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6653b6d6-11a2-4744-ae68-6d9db490a4be",
                                "sense_id": "c59cdbe8-e4f6-30d5-bc4f-807e4b951a60",
                                "text": "[…] l’amoralisme, accusant la vertu, sécrète le même pharisaïsme que la vertu accusant le vice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e835f99-f680-403d-b360-4fef1a1d1518",
