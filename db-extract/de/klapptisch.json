                "senses": [
                    {
                        "sense_id": "e4f1fdb3-94ea-35cd-ac3b-4e90d4cff8dc",
                        "entry_id": "587493bb-6eeb-3d8d-afe5-41d11ec2baff",
                        "glosses": [
                            "Tisch, den man hoch- oder zusammenklappen kann"
                        ],
                        "tags": [
                            "Mobiliar"
                        ],
                        "examples": [
                            {
                                "example_id": "ea8e99b2-8e1b-4d9f-9e94-f0f4e1bcebb2",
                                "sense_id": "e4f1fdb3-94ea-35cd-ac3b-4e90d4cff8dc",
                                "text": "„Auf der einen Seite befanden sich ein kleiner Petroleumherd, ein Klapptisch und eine gemütliche Schlafstelle, über der eine Art Kommode für Kleider und Ähnliches hing.“"
                            },
                            {
                                "example_id": "c5e8f755-f092-420f-93dd-82db41ea642e",
                                "sense_id": "e4f1fdb3-94ea-35cd-ac3b-4e90d4cff8dc",
                                "text": "„Sie setzen sich mit Ramin an einen Klapptisch, meine Mutter und ich nehmen auf einer Pritsche Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
