        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "230bb469-f118-3078-a801-61388ccfb945",
                    "sense_definition": "op een onrustige of gespannen manier handelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onrustig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze lachte <w>nerveus</w> toen de leraar haar een moeilijke vraag stelde.",
                            "target_lang_translations": {
                                "en": "She laughed <w>nervously</w> when the teacher asked her a difficult question.",
                                "de": "Sie lachte <w>nervös</w>, als der Lehrer ihr eine schwierige Frage stellte."
                            }
                        },
                        {
                            "text": "De verdachte keek <w>nerveus</w> om zich heen terwijl hij op de politie wachtte.",
                            "target_lang_translations": {
                                "en": "The suspect looked around <w>nervously</w> while waiting for the police.",
                                "de": "Der Verdächtige blickte <w>nervös</w> um sich, während er auf die Polizei wartete."
                            }
                        }
                    ],
                    "synonyms": [
                        "gejaagd",
                        "zenuwachtig"
                    ],
                    "antonyms": [
                        "rustig",
                        "beheerst"
                    ],
                    "common_phrases": [
                        "nerveus om zich heen kijken",
                        "nerveus lachen"
                    ],
                    "target_lang_definitions": {
                        "en": "acting in a restless or tense manner",
                        "de": "auf eine unruhige oder angespannte Art und Weise handelnd"
                    },
                    "translations": {
