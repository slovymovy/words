                "senses": [
                    {
                        "sense_id": "832b66ad-cbd1-3b4f-9b1b-873a5af5e69e",
                        "entry_id": "e248e0eb-8c0d-337e-9dc1-a0ddcf5722b7",
                        "glosses": [
                            "прост. вызвать кого-нибудь откуда-нибудь криком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b806ebdc-2297-4c9c-a9a1-0e933b8082c7",
                                "sense_id": "832b66ad-cbd1-3b4f-9b1b-873a5af5e69e",
                                "text": "Кличу, кличу, никак его выкликать из лесу не могу."
                            }
                        ]
                    },
                    {
                        "sense_id": "a12f9bba-fec4-31f8-b589-59c9335a8ea0",
                        "entry_id": "e248e0eb-8c0d-337e-9dc1-a0ddcf5722b7",
                        "glosses": [
                            "разг. вызывать по имени в порядке нумерации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73b4bbf-2f87-4583-a83c-f239afd85934",
                                "sense_id": "a12f9bba-fec4-31f8-b589-59c9335a8ea0",
                                "text": "Выкликать по списку."
                            }
                        ]
                    },
                    {
                        "sense_id": "39e9d56e-eaa1-3357-a737-67317ec273af",
                        "entry_id": "e248e0eb-8c0d-337e-9dc1-a0ddcf5722b7",
                        "glosses": [
                            "прост. рег. выкрикивать, взвизгивая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e0563d-ac3f-416b-8533-af9727624a7c",
                                "sense_id": "39e9d56e-eaa1-3357-a737-67317ec273af",
                                "text": "Кликуши выкликают над покойником."
                            },
                            {
                                "example_id": "119166fa-06d2-4785-b5b7-2cc2f39fa2c9",
                                "sense_id": "39e9d56e-eaa1-3357-a737-67317ec273af",
                                "text": "И на экзаменах с вдохновением и придыханием выкликали: «Рожденный ползать – летать не может!»"
                            }
                        ]
                    }
                ],
