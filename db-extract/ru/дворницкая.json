                "senses": [
                    {
                        "sense_id": "2f14a4e7-fbb7-3d20-b4ca-443bff49fc0d",
                        "entry_id": "50a9f3bf-ff79-3441-acc7-b7b80e259484",
                        "glosses": [
                            "устар. помещение, в котором жил дворник; помещение для дворника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19002f89-7645-46b4-a021-364d652b6bd7",
                                "sense_id": "2f14a4e7-fbb7-3d20-b4ca-443bff49fc0d",
                                "text": "Дворника во дворе не нашёл; дворницкая заперта, пошёл наудалую по другой лестнице ― на третью послали."
                            },
                            {
                                "example_id": "751b5b76-a5d7-4570-bb9a-894098b331b5",
                                "sense_id": "2f14a4e7-fbb7-3d20-b4ca-443bff49fc0d",
                                "text": "В отдельном флигельке, недалеко от ворот, где помещалась дворницкая, и в самой дворницкой кипел самовар; за самоваром, вымытый уже и распаренный, сидел нищий .."
                            },
                            {
                                "example_id": "53b3ca41-bc15-4468-a99e-b3b3cf97499f",
                                "sense_id": "2f14a4e7-fbb7-3d20-b4ca-443bff49fc0d",
                                "text": "Дворницкая стояла в заглохшем саду, окружённом высокой оградой из камня «дикаря»."
                            }
                        ]
                    }
