                                                "example_id": "95c3cda2-20b9-475a-bd12-216e7b21b83b",
                                                "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                                "text": "His head boasted a shock of sandy hair."
                                            },
                                            {
                                                "example_id": "043a1332-0063-4ee4-b6f1-419b0c8c82bf",
                                                "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                                "text": "Every now and then I’m startled at how good-looking John is, but he glared at me from under the shock of hair that fell across his brow and scared me a little."
                                            },
                                            {
                                                "example_id": "dda69445-5c57-41da-aed2-0dc7337526b8",
                                                "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                                                "text": "On day three I pointed at the edge of an intricate pentagram peeking above her shock of oily black hair."
                                            }
                                        ]
                                    },
