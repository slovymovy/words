                ],
                "senses": [
                    {
                        "sense_id": "9d361dc6-cc4f-3ab4-a50b-ef945e0bfac0",
                        "entry_id": "e78db373-008d-3b4e-a352-71019333668b",
                        "glosses": [
                            "plötzlich auftretende Ohnmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da216c27-7204-4f49-bc97-0e4be2c6e338",
                                "sense_id": "9d361dc6-cc4f-3ab4-a50b-ef945e0bfac0",
                                "text": "„Da übernahm Rose sich bei der Dreschmaschine, bekam einen Ohnmachtsanfall, hatte drei Tage lang eine krause Stirn, trank sich, als er in Howe zu tun hatte, bis oben hin voll und verschlief zwei Nächte.“"
                            },
                            {
                                "example_id": "360d4d31-cd20-41e0-8e1c-aac54080c70c",
                                "sense_id": "9d361dc6-cc4f-3ab4-a50b-ef945e0bfac0",
                                "text": "„Als sie gerade die fröhlichste Weinlaune erreicht hatten, erschien Dai-an, um Simen Tjing ins Ohr zu flüstern: die gnädige Frau habe ihn beauftragt, den Herrn abzuholen und ihm mitzuteilen, daß die dritte Frau heute einen Ohnmachtsanfall gehabt habe.“"
                            },
                            {
                                "example_id": "75525982-2709-46d7-9620-01583f433095",
                                "sense_id": "9d361dc6-cc4f-3ab4-a50b-ef945e0bfac0",
                                "text": "„Sein Ohnmachtsanfall wurde auf das Zusammenwirken von Klonopin und niedrigem Blutdruck zurückgeführt.“"
                            },
                            {
                                "example_id": "efed0434-f965-43b4-ba50-50cda7a805c8",
                                "sense_id": "9d361dc6-cc4f-3ab4-a50b-ef945e0bfac0",
                                "text": "„Mir selbst versagte Alos die Rolle des Kriegers, denn ich war schwach und neigte zu merkwürdigen Ohnmachtsanfällen, wenn ich mich Anstrengungen und Härten aussetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
