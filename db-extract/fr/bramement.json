                        "form": "bramements"
                    },
                    {
                        "form_id": "39cf6e1f-2853-4801-ad7a-2167826e9093",
                        "entry_id": "9e4fd634-9237-3d52-87de-9c9d6584203f",
                        "tags": [],
                        "form": "brâmement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12b27bf0-6acf-3569-b097-9ca0147c837e",
                        "entry_id": "9e4fd634-9237-3d52-87de-9c9d6584203f",
                        "glosses": [
                            "Action de bramer ; cri du cerf, du chevreuil, du daim, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35eb76cd-c57d-4d13-9ed6-90645ac5185a",
                                "sense_id": "12b27bf0-6acf-3569-b097-9ca0147c837e",
                                "text": "On n’y entendait d’autre bruit que le bramement des cerfs."
                            },
                            {
                                "example_id": "701f398f-6092-41c8-9873-9fa4002e01be",
                                "sense_id": "12b27bf0-6acf-3569-b097-9ca0147c837e",
                                "text": "Le désert ne répétait que les soupirs des vents, le bramement des cerfs et le chant des oiseaux."
                            },
                            {
                                "example_id": "bdf49215-7459-4564-9445-9567782d523b",
                                "sense_id": "12b27bf0-6acf-3569-b097-9ca0147c837e",
                                "text": "J’écoutais le bruit du vent dans la solitude, le bramement des daims et des cerfs."
                            },
                            {
                                "example_id": "a66c1518-8240-4802-8d12-4e01d4ba2e10",
                                "sense_id": "12b27bf0-6acf-3569-b097-9ca0147c837e",
                                "text": "Ce n’est point le bramement du renne, dit Marbre, et je nommerais bien la bête qui s’est fait prendre à notre traquenard !"
                            },
                            {
                                "example_id": "cb2ba213-56fc-4cd4-ba46-d833a14e124f",
                                "sense_id": "12b27bf0-6acf-3569-b097-9ca0147c837e",
                                "text": "[…] et d’immenses troupes de bisons faire trembler le sol dans leur course furieuse en poussant ces bramements de désespoir qui remplissent de terreur les hommes les plus braves."
                            }
                        ]
                    }
                ],
