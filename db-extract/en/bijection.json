                        "source_entry_id": "19609f95-24b1-37e8-a9db-2f9fb7f52014",
                        "source_sense_id": "acc70e86-3175-30b5-bed4-6e01bec74b4c",
                        "source_sense_description": "function that is both a surjection and an injection",
