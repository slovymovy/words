                ],
                "senses": [
                    {
                        "sense_id": "bc2c6d10-5afe-39d4-b2da-e6eda481470f",
                        "entry_id": "c601fbe3-4223-3e7a-bfab-05fb60fbe390",
                        "glosses": [
                            "Alternative letter-case form of Venmo."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1ba29d9b-31fe-4c54-bf07-f28d176a8c3d",
                                "sense_id": "bc2c6d10-5afe-39d4-b2da-e6eda481470f",
                                "text": "In all the examples mentioned earlier, consumers wouldn’t pay pennies every day by venmoing the seller."
                            },
                            {
                                "example_id": "bb4fc66b-dd5e-46da-b50f-e3c5a3342e87",
                                "sense_id": "bc2c6d10-5afe-39d4-b2da-e6eda481470f",
                                "text": "Many hours and dollars a year go into reading these emails and then acting on their directives—sending the kid in with a bagged lunch for the museum trip, buying something for the class basket, wrapping the Secret Santa present, venmoing Angela for the principal’s gift."
                            },
                            {
                                "example_id": "43396fca-ebcf-41f8-b718-e45504684776",
                                "sense_id": "bc2c6d10-5afe-39d4-b2da-e6eda481470f",
                                "text": "I’ve been going nuts, ready to assemble a search party, certain Ginny wasn’t a teenage girl and Theo was being held at knifepoint until he venmoed the contents of his bank account to some thug with an eye patch and a set of brass knuckles."
                            },
                            {
                                "example_id": "d8665000-4e1f-4c12-8f91-36bfed1df97e",
                                "sense_id": "bc2c6d10-5afe-39d4-b2da-e6eda481470f",
                                "text": "They are taking off work two hours early, confirming babysitters, venmoing dog walkers."
                            }
                        ]
                    }
                ],
