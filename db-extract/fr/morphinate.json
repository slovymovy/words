                        "entry_id": "9daf3bfd-38bb-3ea3-9a4e-d1119254e288",
                        "glosses": [
                            "Sel que forme la morphine avec une base."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ed7863-5aad-4953-931f-5bf707238494",
                                "sense_id": "ebc49e86-371e-33fd-805b-f234223b6650",
                                "text": "On retire la morphine de l'extrait d'opium au moyen d’un lait de chaux qui dissout la morphine sous forme de morphinate ; l'addition de chlorhydrate d'ammoniaque précipite la morphine."
                            },
                            {
                                "example_id": "2d02aad1-6a6b-4d46-9263-4e2d2873875f",
                                "sense_id": "ebc49e86-371e-33fd-805b-f234223b6650",
                                "text": "La morphine-base, insoluble dans l'eau froide, est ainsi transformée en son sel, le morphinate de calcium, parfaitement soluble."
                            }
                        ]
                    }
