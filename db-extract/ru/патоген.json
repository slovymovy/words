                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "970d457e-b599-4e5b-9c87-602a104e15d2",
                        "source_entry_id": "341e7586-a759-3768-bd05-42530a78417d",
                        "source_sense_id": "c63f1f82-22ef-3196-9b01-550a9c12c4c0",
                        "target_lang_word": "Krankheitserreger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankheitserreger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ab5110-c438-3cdf-ae8f-82ae1c5f7c6f",
                                        "entry_id": "24c2aa4b-d9b1-35c2-8e5e-f0ad307e6f03",
                                        "glosses": [
                                            "Organismus oder seltener ein Stoff, der eine Krankheit verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c634eb3-e047-4998-ab94-aa8b595f5231",
                                                "sense_id": "c7ab5110-c438-3cdf-ae8f-82ae1c5f7c6f",
                                                "text": "„Bis zu 600.000 Menschen würden sich in deutschen Kliniken jährlich mit Krankheitserregern infizieren, bis zu 40.000 Patienten würden jedes Jahr an diesen Infektionen sterben.“"
                                            },
                                            {
                                                "example_id": "8f453373-59a8-4aab-b5a7-3d3ed31ae75f",
                                                "sense_id": "c7ab5110-c438-3cdf-ae8f-82ae1c5f7c6f",
                                                "text": "„Neben dem HI-Virus verlangt Mycobacterium tuberculosis unter den Krankheitserregern inzwischen die meisten Opfer.“"
                                            },
                                            {
                                                "example_id": "fc423fb6-6793-409e-9e5c-03e7343d9ee9",
                                                "sense_id": "c7ab5110-c438-3cdf-ae8f-82ae1c5f7c6f",
                                                "text": "„Ärzte erklären, dass die Vuvuzela wie eine Kanone wirkt, die Menschen mit Krankheitserregern der übelsten Sorte beschießt.“"
                                            },
                                            {
                                                "example_id": "9c01a4da-a19c-4f65-808d-b3655ee1884e",
                                                "sense_id": "c7ab5110-c438-3cdf-ae8f-82ae1c5f7c6f",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
