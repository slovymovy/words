                    {
                        "translation_id": "ef1ac193-093a-4d2c-9fcd-08c6010f3ec8",
                        "source_entry_id": "b8021151-b80d-3fd8-bd67-4a6527e6c0f3",
                        "source_sense_description": "(of a person or part of the body) partly or wholly incapable of movement; disabled",
                        "target_lang_word": "paralysé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralysé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d3b9ddf-0b0d-363e-8607-c3a0af7a9c46",
                                        "entry_id": "9a4e2148-5b91-38fa-a23e-882003469ae2",
                                        "glosses": [
                                            "Atteint de paralysie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae45375-5182-4c7e-98c1-e1594746edc5",
                                                "sense_id": "0d3b9ddf-0b0d-363e-8607-c3a0af7a9c46",
                                                "text": "Une sœur est restée paralysée d’un côté, dix-huit mois, et actuellement encore elle traîne une jambe."
                                            },
                                            {
                                                "example_id": "9f5bccb2-2d90-46c4-9c57-bba018d337e7",
                                                "sense_id": "0d3b9ddf-0b0d-363e-8607-c3a0af7a9c46",
                                                "text": "Je suis atteint de la maladie de Charcot, et ils avaient prédit qu’à 21 ans [il en a 31, aujourd’hui], je serais paralysé de tous mes membres sur un lit médicalisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a2b4cfc-f13c-3651-bcb5-e1c5cd8b326a",
                                        "entry_id": "9a4e2148-5b91-38fa-a23e-882003469ae2",
                                        "glosses": [
                                            "Immobilisé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355831cd-aebd-4664-879f-545cf47b5e05",
                                                "sense_id": "5a2b4cfc-f13c-3651-bcb5-e1c5cd8b326a",
                                                "text": "La coque, paralysée et inerte, sans résistance contre le plissement insensé de l’eau, sans défense contre la pression du vent, poisson sans nageoires, oiseau sans ailes, ne peut qu’aller où le souffle la pousse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paralysé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                                        "entry_id": "8c689879-378d-34be-b008-5794c5b98fbf",
                                        "glosses": [
                                            "Personne atteinte de paralysie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89803e83-d47c-41bd-bd1b-af573ab4c048",
                                                "sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                                                "text": "À travers tout ce désordre cérébral, quelques conceptions délirantes orgueilleuses ou hypocondriaques peuvent apparaître encore, et c’est ainsi qu’un paralysé, questionné sur la cause de son grincement de dents, put répondre : « Je broie des diamants. »"
                                            },
                                            {
                                                "example_id": "35ed7baf-ada6-4216-bad2-754af3ae8f2e",
                                                "sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                                                "text": "Et les aveugles et les paralysés que Jésus est censé avoir guéris, ils n’ont pas eu besoin qu’un docteur vienne les soigner et les remette sur pied après l’intervention du Christ."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paralysé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ed99bb-5825-348f-bba0-437c0a48589e",
                                        "entry_id": "da8582a2-aaaa-3493-bec6-c78e5b92076a",
                                        "glosses": [
                                            "Participe passé masculin singulier de paralyser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87c39fc-94d0-4546-9659-9fd8725798a9",
                                                "sense_id": "b2ed99bb-5825-348f-bba0-437c0a48589e",
                                                "text": "Le peureux pusillanime incapable de réagir et paralysé par la peur est d'un caractère apathique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
