                "senses": [
                    {
                        "sense_id": "252100fa-51f9-38a8-a1ad-07494ea8ad2f",
                        "entry_id": "478b64f8-4d49-39e9-bb3c-5fae8a973d49",
                        "glosses": [
                            "bedrijf dat munten en medailles slaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f97f5a71-cf56-45bf-ae67-ae17b5493bfa",
                                "sense_id": "252100fa-51f9-38a8-a1ad-07494ea8ad2f",
                                "text": "De Koninklijke Nederlandse Munt is het eerste munthuis te wereld dat zogenoemde augmented reality heeft gebruikt om een munt met extra's te slaan, aldus een woordvoerster donderdag. De herdenkingsmunt is voor bijna 50 euro te koop. De oplage is beperkt tot 2500 exemplaren."
                            },
                            {
                                "example_id": "f7518d6b-3c6e-4fff-a981-cd433279dbbc",
                                "sense_id": "252100fa-51f9-38a8-a1ad-07494ea8ad2f",
                                "text": "Het Braziliaanse Munthuis moest de afgelopen jaren niet alleen de Real, de munteenheid van Brazilië, maar ook de medailles voor de Olympische en Paralympische Spelen maken."
                            }
                        ]
                    }
                ],
