                    }
                ],
                "senses": [
                    {
                        "sense_id": "329d8035-586e-3dcb-bdaa-7df8a0aa2872",
                        "entry_id": "93117fcb-f3ed-3576-9529-e27e43bbd386",
                        "glosses": [
                            "ein auf vier Säulen ruhendes Dach über dem Altar"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "0bcd6d49-8687-4cb2-bae7-43a542474509",
                                "sense_id": "329d8035-586e-3dcb-bdaa-7df8a0aa2872",
                                "text": "Das Tabernakel war ein luftiges Ziergehäuse der gotischen Architektur, es bestand aus einem baldachingleichen Dach auf Säulen."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "ba8e011b-c354-3442-856a-869fa29b511e",
                        "entry_id": "93117fcb-f3ed-3576-9529-e27e43bbd386",
                        "glosses": [
                            "Bauwerk: ein auf Säulen aufgebauter großer Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061ca316-3dec-4afa-900f-6fa59972c613",
                                "sense_id": "ba8e011b-c354-3442-856a-869fa29b511e",
                                "text": "„Die Stützlinienuntersuchung führte zu dem Ergebnis, dass nicht wie erwartet die Stützlinien oberhalb der Tabernakel aus dem Materialquerschnitt heraustreten, sondern wegen der geringen Masse der Pfeiler und den Gewichtsanteilen der Außenwand des Seitenschiffes nach innen gedrückt werden.“"
                            },
                            {
                                "example_id": "58502451-1142-4d9e-8106-deb584a6076c",
                                "sense_id": "ba8e011b-c354-3442-856a-869fa29b511e",
                                "text": "„War das mittelalterliche Mittelschiff früher ein durch Stufen erhöhter Altarraum, so findet sich jetzt hier der neue Ort für den Gottesdienst: Altar, Ambo* und Tabernakel* sind für diesen Ort von Ingrid Bussenius neu geschaffen worden.“"
                            },
                            {
                                "example_id": "942ea3dc-c082-444a-9af2-9100bac26af9",
                                "sense_id": "ba8e011b-c354-3442-856a-869fa29b511e",
                                "text": "„Die neue Halle, die wir nicht weit von hier entfernt bauen und die wir Konferenzzentrum genannt haben, hat 21000 Sitzplätze, mit dem dazugehörigen Theater 22000, fast dreieinhalb mal so viel wie dieses Tabernakel.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "1c6965eb-2096-336a-88ad-22c7e16bcd09",
                        "entry_id": "93117fcb-f3ed-3576-9529-e27e43bbd386",
                        "glosses": [
                            "ein schrankartiges Behältnis, in dem die geweihten Hostien (das Allerheiligste) aufbewahrt werden"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "0162c255-5756-4d7a-93a7-24bf6cafa521",
                                "sense_id": "1c6965eb-2096-336a-88ad-22c7e16bcd09",
                                "text": "„Tabernakel, das, der, von lateinisch tabernaculum, \"Hütte\", \"Zelt\" seit dem 12. Jh. das in christlichen Kirchen verwendete Behältnis zur Aufbewahrung des Hostiengefäßes. […]“"
                            },
                            {
                                "example_id": "3e08351d-af12-4f37-87d4-d4cc11c8cf41",
                                "sense_id": "1c6965eb-2096-336a-88ad-22c7e16bcd09",
                                "text": "„Ich sah dort das Tabernakel, in dem man bei der Fronleichnamsprozession das Heilige Sakrament trägt und das so schwer ist, daß dreißig Männer dafür nötig sind.“"
                            },
                            {
                                "example_id": "b2ca11ae-a7d1-43c7-85be-e9e5d9129127",
                                "sense_id": "1c6965eb-2096-336a-88ad-22c7e16bcd09",
                                "text": "„Zu Lebzeiten Luthers wurden die geweihten Hostien auch in evangelischen Kirchen weiterhin in Tabernakeln aufbewahrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a4f40355-3dbc-3193-8acd-3236b472efbf",
                        "entry_id": "93117fcb-f3ed-3576-9529-e27e43bbd386",
                        "glosses": [
                            "Mischkan, transportables Heiligtum der Juden bis zum Bau ihres ersten Tempels"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "eb69d76f-4c50-434d-95b5-e218a1481a50",
                                "sense_id": "a4f40355-3dbc-3193-8acd-3236b472efbf",
                                "text": "Demnach besaßen die Hebräer nur einen einzigen legitimen Tempel. Zuerst benutzten sie den Zelt-Tempel, auch das Tabernakel (lat. tabernaculum = Hütte, Zelt) genannt, später bauten sie den Solomonischen Tempel."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac488653-72c7-4bda-a252-56a97750b66a",
                        "source_entry_id": "93117fcb-f3ed-3576-9529-e27e43bbd386",
                        "target_lang_word": "tabernacle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tabernacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2b16ac-bbda-33b1-b86e-ccbccfc7136b",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "Any temporary dwelling; a hut, tent, or booth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e73250e-961b-4055-9601-87fff97c6cc3",
                                                "sense_id": "3e2b16ac-bbda-33b1-b86e-ccbccfc7136b",
                                                "text": "The tabernacles of robbers proſper, and they that prouoke God are ſecure, into whoſe hand God bringeth abundantly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9fb76d-9d03-3a0d-8a29-4abd26f00405",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "The portable tent used before the construction of the temple, where the shekinah (presence of God) was believed to dwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51fbc4ef-f66e-405c-96de-c6cc47004817",
                                                "sense_id": "2f9fb76d-9d03-3a0d-8a29-4abd26f00405",
                                                "text": "[…]ſo Moſes finiſhed the worke. Then a cloud couered the Tent of the Congregation, and the glory of the Lord filled the Tabernacle. And Moſes was not able to enter into the Tent of the Congregation, becauſe the cloud abode thereon, and the glory of the Lord filled the Tabernacle. And when the cloud was taken vp from ouer the Tabernacle, the children of Iſrael went onward in all their iourneys: But if the cloud were not taken vp, then they iourneyed not, till the day that it was taken vp. For the cloud of the Lord was vpon the Tabernacle by day, and fire was on it by night, in the ſight of all the houſe of Iſrael, throughout all their iourneys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "316516be-ecd0-3ab4-973a-46eb50d58bf0",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "The Jewish Temple at Jerusalem (as continuing the functions of the earlier tabernacle)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63e95d6e-c490-3b2a-9cd9-190e686f7102",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "Any portable shrine used in heathen or idolatrous worship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65623e32-c8e9-3290-ab38-584a58966872",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "A sukkah, the booth or 'tabernacle' used during the Jewish Feast of Sukkot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97542a41-dbd3-39f3-982c-8b20143d9345",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "A small ornamented cupboard or box used for the reserved sacrament of the Eucharist, normally located in an especially prominent place in a church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c078fd42-5bef-49b2-a9e0-2bdd74de5585",
                                                "sense_id": "97542a41-dbd3-39f3-982c-8b20143d9345",
                                                "text": "The tabernacle is to be situated \"in churches in a most worthy place with the greatest honor.\" The dignity, placing, and security of the Eucharistic tabernacle should foster adoration before the Lord really present in the Blessed Sacrament of the altar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778d95d2-e33c-3677-90ba-1cd2d2b2602c",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "A temporary place of worship, especially a tent, for a tent meeting, as with a venue for revival meetings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21bcbbe6-4236-4977-bca0-3f2901af2022",
                                                "sense_id": "778d95d2-e33c-3677-90ba-1cd2d2b2602c",
                                                "text": "It was over these innocent necessary precautions that the local committees always showed their meanness. They liked giving over only one contribution to the evangelist, but they wanted nothing said about it till they themselves had been taken care of--till the rent of the hall or the cost of building a tabernacle, the heat, the lights, the advertising, and other expenses had been paid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcefca69-3220-32ee-b5fd-cf2bf3d1d1c5",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "Any house of worship, especially a Mormon meetinghouse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abb59f6e-0414-3070-88b0-a1aa0a6f56d9",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "Any abode or dwelling place, or especially the human body as the temporary dwelling place of the soul, or life."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "625c025e-1cd7-38f8-a3dc-0045ab58a24c",
                                        "entry_id": "5ea6e83b-c75f-3d77-b29a-bc3bb2c09c90",
                                        "glosses": [
                                            "A hinged device allowing for the easy folding of a mast 90 degrees from perpendicular, as for transporting the boat on a trailer, or passing under a bridge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
