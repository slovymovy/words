                        "glosses": [
                            "Celle qui enjôle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf1f495-06af-445a-b172-8765f753940f",
                                "sense_id": "e2ee8604-d332-3c6b-948a-256a52b4c378",
                                "text": "C'est la femme aux bijoux,\nCelle qui rend fou,\nC’est une enjôleuse,\nTous ceux qui l’ont aimée,\nOnt souffert, ont pleuré."
                            },
                            {
                                "example_id": "19cc588e-9b70-4093-aa09-3d2071a60912",
                                "sense_id": "e2ee8604-d332-3c6b-948a-256a52b4c378",
                                "text": "- Colette avait raison, vous êtes une terrible enjôleuse, dit-il tout bas.\n- Mais vous êtes si peu enjôlable que je ne vois pas ce que vous craindriez, murmura-t-elle plus bas encore."
                            }
                        ]
                    }
