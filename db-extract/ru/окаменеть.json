                ],
                "senses": [
                    {
                        "sense_id": "da8e152a-bc3b-35f1-94a5-0ea52cb1490c",
                        "entry_id": "a10c1580-cd98-3a3c-a19f-2e1571e12df6",
                        "glosses": [
                            "превратиться в камень или очень твёрдый материал"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "86b732b2-1e06-34c8-bc69-b46101a959c7",
                        "entry_id": "a10c1580-cd98-3a3c-a19f-2e1571e12df6",
                        "glosses": [
                            "перен., книжн. замереть, застыть; стать неподвижным ,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5628a6ba-3ea3-494c-b6a6-e80b4818bcea",
                                "sense_id": "86b732b2-1e06-34c8-bc69-b46101a959c7",
                                "text": "Теперь, когда ветер порывом сильным и резким принёс в её чутьё подозрительный запах, она окаменела, выждала."
                            },
                            {
                                "example_id": "8940411c-34e2-4578-a3a8-1d8b1df8759d",
                                "sense_id": "86b732b2-1e06-34c8-bc69-b46101a959c7",
                                "text": "Тонкий вдруг побледнел, окаменел, но скоро лицо его искривилось во все сто́роны широчайшей улыбкой; казалось, что от лица́ и глаз его посы́пались искры."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d6bb964-ffde-3ac7-8221-3169a127a616",
                        "entry_id": "a10c1580-cd98-3a3c-a19f-2e1571e12df6",
                        "glosses": [
                            "перен. стать бесчувственным, бессердечным"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39894064-06cc-4368-8e9b-72b71e37c1c0",
                        "source_entry_id": "a10c1580-cd98-3a3c-a19f-2e1571e12df6",
                        "source_sense_description": "превратиться в камень",
                        "target_lang_word": "petrify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petrify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "864a04ce-c553-3f14-97d2-2f44a13c5542",
                                        "entry_id": "0250cef1-bb6c-339e-9581-7f23c3a3a76f",
                                        "glosses": [
                                            "To turn to stone: to harden organic matter by permeating with water and depositing dissolved minerals."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b6c187-679e-460f-ad64-f211511fd5b0",
                                                "sense_id": "864a04ce-c553-3f14-97d2-2f44a13c5542",
                                                "text": "a river that petrifies any sort of wood or leaves"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "922aaf51-203c-383c-9dbf-20cf2191c6a5",
                                        "entry_id": "0250cef1-bb6c-339e-9581-7f23c3a3a76f",
                                        "glosses": [
                                            "To produce rigidity akin to stone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6785a03c-8075-3cdc-9346-042a8209ff68",
                                        "entry_id": "0250cef1-bb6c-339e-9581-7f23c3a3a76f",
                                        "glosses": [
                                            "To immobilize with fright."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "921c4b1e-f3d3-3f2e-a043-848866913a2e",
                                        "entry_id": "0250cef1-bb6c-339e-9581-7f23c3a3a76f",
                                        "glosses": [
                                            "To become stone, or of a stony hardness, as organic matter by calcareous deposits."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1392552d-872c-3191-b1b8-64951a7d8e83",
                                        "entry_id": "0250cef1-bb6c-339e-9581-7f23c3a3a76f",
                                        "glosses": [
                                            "To become stony, callous, or obdurate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b588a9-97d1-4cb5-8398-69c70c083017",
                                                "sense_id": "1392552d-872c-3191-b1b8-64951a7d8e83",
                                                "text": "Like Niobe we marble grow, / And petrify with grief."
                                            },
                                            {
                                                "example_id": "11287c2a-16db-4e13-958a-2e65adb9d448",
                                                "sense_id": "1392552d-872c-3191-b1b8-64951a7d8e83",
                                                "text": "Hopes, feelings, and passion, petrify one after another; the crust of experience soon hardens over the hidden past; and who, looking on the levelled and subdued exterior, could dream of the wreck and ravage that lies below?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52dda58c-df2e-3cb4-9332-2d9cc7cc6961",
                                        "entry_id": "0250cef1-bb6c-339e-9581-7f23c3a3a76f",
                                        "glosses": [
                                            "To make callous or obdurate; to stupefy; to paralyze; to transform; as by petrification."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e2ca2ba-fc97-4777-bcc3-3ef66043b8f2",
                                                "sense_id": "52dda58c-df2e-3cb4-9332-2d9cc7cc6961",
                                                "text": "petrify a genius to a dunce"
                                            },
                                            {
                                                "example_id": "43041035-bfb1-4292-aae8-2250e9e0f24e",
                                                "sense_id": "52dda58c-df2e-3cb4-9332-2d9cc7cc6961",
                                                "text": "A hideous fatalism, which ought, logically, to petrify your volition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
