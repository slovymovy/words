                        "cross_references": [
                            {
                                "target_word": "disgusting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                        "entry_id": "0baa67de-a82f-3fcd-9609-0e245f24ff6e",
                                        "glosses": [
                                            "Causing disgust; repulsive; distasteful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fdb63f3-89be-406d-ada8-a56e732c5ca9",
                                                "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                                "text": "The taste and digestion are often depraved, anorexia, nausea, inappetence and vomiting supervene, the woman desires innutritious or disgusting food, such as chalk, cinders, putrescent animal food, […]"
                                            },
                                            {
                                                "example_id": "b7685284-cf5d-4520-9b05-e7cb2534ae12",
                                                "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                                "text": "But it is much more sensible and much more fun and much more disgusting to assume that the English Leather woman is really saying \"All my men wear English leather or nothing at all.\"."
                                            },
                                            {
                                                "example_id": "3f266cf4-7e65-41c8-888d-b1618964b4ea",
                                                "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                                "text": "One guy farted repeatedly and laughed out loud each time he let it out. To top off his disgusting behavior, he constantly picked his nose and thumped the waste in the air."
                                            }
                                        ]
                                    }
                                ]
                            },
