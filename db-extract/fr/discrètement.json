        "fr-extract.jsonl": [
            {
                "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                "word": "discrètement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                        "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                        "glosses": [
                            "Avec retenue ; avec réserve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5532403f-3889-4ac3-8bc1-53349b6e72fb",
                                "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                "text": "Elle fixa sur ses cheveux relevés un de ces délicieux chapeaux qu'on ne trouve qu'à Paris, sorte de tambourin de paille noir discrètement orné de fleurettes roses et d'une voilette."
                            },
                            {
                                "example_id": "76ed16df-bb9d-4ae6-aa8d-63a4e23f2b4b",
                                "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                "text": "Pour le prouver, et alors que les reptiles s’accouplent généralement discrètement, Megan Folwell table sur l’étude de leurs circuits neuronaux."
                            },
                            {
                                "example_id": "a820a3e4-fe47-4039-912b-5bd7fc83dbcd",
                                "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                "text": "Je continuerais ici, monseigneur, bien volontiers ce discours ; mais je crains de n'user pas assez discrètement de la liberté que l’on m’a donnée."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                        "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                        "glosses": [
                            "Sans dire ce qui doit être tu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7005c691-c0de-4c99-867c-9ee7837a7357",
                                "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                "text": "Au bled, le père s'était remarié en scred, discrètement, avec une jeunette, sans dire qu'il avait un fils de cinq ans."
                            },
                            {
                                "example_id": "87755400-a82e-44f5-8418-914e15e2d614",
                                "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                "text": "Vous affûtez vos armes discrètement."
                            },
                            {
                                "example_id": "dbf23be4-d874-48ee-bc7f-7005cbb3f917",
                                "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                "text": "Ce soir les hommes ont allumé un brasier et nous avons dîné de succulentes grillades, merguez et côtes d'agneau. Nous avons même bu un verre de boulaouane, mais discrètement."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc86e542-3410-3e46-86e3-688688109a0c",
                        "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                        "glosses": [
                            "De façon discontinue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef79fa4-26b8-4325-b1fa-ddfa389e2590",
                                "sense_id": "cc86e542-3410-3e46-86e3-688688109a0c",
                                "text": "La taille d'une population d'insectes varie discrètement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3b7ffb5-0fa1-4773-8227-62bfd4a13b8a",
                        "source_entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                        "target_lang_word": "discreetly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discreetly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24906953-df4c-3375-9686-e2629b1e85f2",
                                        "entry_id": "c1e8ab9b-0245-3f6c-8f8a-3ef4fde80309",
                                        "glosses": [
                                            "Acting in a discreet manner; acting in a way that respects privacy or secrecy; quietly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab25ad5-17f2-4647-be5c-4e1951c30c38",
                                                "sense_id": "24906953-df4c-3375-9686-e2629b1e85f2",
                                                "text": "Mao was animated and following every nuance of the conversation, but I could see that he was also becoming very tired. Chou had been discreetly glancing at his watch with increasing frequency, so I decided that I should try to bring the session to a close."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630ff14a-9a44-3709-87fb-9c7b4a3c501c",
                                        "entry_id": "c1e8ab9b-0245-3f6c-8f8a-3ef4fde80309",
                                        "glosses": [
                                            "inconspicuously"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e692e0-6780-434b-b977-5a939c38720c",
                                                "sense_id": "630ff14a-9a44-3709-87fb-9c7b4a3c501c",
                                                "text": "And, placed discreetly among these commonplaces, a few pieces of genuine quality, bizarrely distinguished by craftsmanship from the vulgar products of the machine."
                                            },
                                            {
                                                "example_id": "82026b26-c776-4d1a-83be-0bb7406ed6b8",
                                                "sense_id": "630ff14a-9a44-3709-87fb-9c7b4a3c501c",
                                                "text": "A Forest Trail and wild life hides lie 2 miles to the north-east. Blue hares, deer, wild geese, herons and duck can be discreetly observed from the hides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62a66bf9-c7df-45ee-94cb-04200399e293",
                        "source_entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                        "target_lang_word": "plainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                                        "glosses": [
                                            "In a plain manner; simply; basically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c94f750-8fa7-4427-a4de-e01b945d2d08",
                                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                                "text": "She decorated the room plainly but neatly."
                                            },
                                            {
                                                "example_id": "a2522760-5d67-4dff-821a-9551efd86e30",
                                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                                "text": "'Tell me plainly what you think of my daughter's little companion.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                                        "glosses": [
                                            "Obviously; clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1060563-3455-4aeb-8fec-0099957aa51f",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "You will see that ours is plainly the better method."
                                            },
                                            {
                                                "example_id": "84af7e50-d76c-436e-9827-75c6f2d77b1c",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed. They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "405ed914-8d92-40b0-97ec-1a9b888153fe",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "Plainly he was prepared to bark out an interminable succession of charges against the Wanderer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf9d9a8-6132-4206-a35c-9df35105a604",
                        "source_entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                        "target_lang_word": "quietly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quietly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54591f42-6dcf-3765-ae69-a703fa8cbaf8",
                                        "entry_id": "cb74771d-09fc-385a-8146-2745d8ff403a",
                                        "glosses": [
                                            "In a quiet manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4326ee50-f560-403b-a186-fd887ddddd83",
                                                "sense_id": "54591f42-6dcf-3765-ae69-a703fa8cbaf8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a03e25-0a7f-4dd6-9d7b-49b9c85079eb",
                        "source_entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
