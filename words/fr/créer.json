                {
                    "sense_id": "9930d4aa-f5df-3f55-a083-a5f6e4efca16",
                    "sense_definition": "Donner l'existence à quelque chose de nouveau ou faire exister matériellement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fabrication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>créer</w> un nouveau profil pour son projet artistique."
                        },
                        {
                            "text": "Les deux amis veulent <w>créer</w> une entreprise dans le secteur numérique."
                        }
                    ],
                    "synonyms": [
                        "produire",
                        "faire",
                        "réaliser",
                        "fabriquer"
                    ],
                    "antonyms": [
                        "détruire"
                    ],
                    "common_phrases": [
