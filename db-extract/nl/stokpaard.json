                    {
                        "translation_id": "bb23847b-dafc-4735-b750-0b2f302f03c4",
                        "source_entry_id": "829d113b-7c4c-3263-8913-c54bdc7e05f5",
                        "source_sense_id": "9c41e820-0d65-376b-adf2-edaa16d28701",
                        "source_sense_description": "een favoriet gespreksonderwerp",
                        "target_lang_word": "cheval de bataille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheval de bataille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01daa77f-2c65-3b3a-8048-f1e3a1749ffa",
                                        "entry_id": "302f4fe5-1cdd-32d6-963c-7b804ac755a1",
                                        "glosses": [
                                            "Cheval spécialement entraîné pour servir au combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642ce93f-93bf-47a7-a223-c135ee65f695",
                                                "sense_id": "01daa77f-2c65-3b3a-8048-f1e3a1749ffa",
                                                "text": "Le duc de Bourgogne, monté sur son grand cheval de bataille qui portait quatre blessures faites par les piques ennemies, fit son entrée dans la ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba61fc9c-b760-310f-8e69-bda10f611b35",
                                        "entry_id": "302f4fe5-1cdd-32d6-963c-7b804ac755a1",
                                        "glosses": [
                                            "Combat, thème favori pour défendre une cause."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b13f65-988d-4142-a7da-67dde6ccd5ad",
                                                "sense_id": "ba61fc9c-b760-310f-8e69-bda10f611b35",
                                                "text": "Dans le pays, singulièrement encouragée, la droite fait feu des quatre fers. L’École devient son cheval de bataille. Brandissant le sabre et le goupillon, elle rallume la guerre scolaire, […]."
                                            },
                                            {
                                                "example_id": "bf7a65fa-5334-4d43-809a-3ebf8fe612d8",
                                                "sense_id": "ba61fc9c-b760-310f-8e69-bda10f611b35",
                                                "text": "Par ce geste, la Turquie fait savoir une fois de plus qu’elle ne lâchera pas l’affaire Khashoggi, devenue le cheval de bataille du président Erdogan."
                                            },
                                            {
                                                "example_id": "9cc91c9c-4436-448d-925e-5903e1528246",
                                                "sense_id": "ba61fc9c-b760-310f-8e69-bda10f611b35",
                                                "text": "L’annulation de la construction de cette ligne ferroviaire à haute vitesse, qu’il considère comme un gaspillage d’argent public, était l’un des chevaux de bataille du parti antisystème M5S pendant la campagne électorale."
                                            },
                                            {
                                                "example_id": "6cf00754-fb7e-44a9-8adf-86dd800f1567",
                                                "sense_id": "ba61fc9c-b760-310f-8e69-bda10f611b35",
                                                "text": "Il avait choisi pour cheval de bataille une législation qui concernait le corps des femmes, qui autorisait des investigations dans leur intimité, mais ce fait n'avait jamais passé la barrière de sa conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3aa4246-f919-3325-ad77-e0ff47eb81cf",
                                        "entry_id": "302f4fe5-1cdd-32d6-963c-7b804ac755a1",
                                        "glosses": [
                                            "Argument, sujet, point de vue dans une discussion ; thème de prédilection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f279d5d-cfa1-46bc-97e7-02b7f7f093f9",
                                                "sense_id": "f3aa4246-f919-3325-ad77-e0ff47eb81cf",
                                                "text": "Le dogme et la controverse, qui ne sont que le cheval de bataille et les armes du sot et du fanatique […]."
                                            },
                                            {
                                                "example_id": "f833448c-da47-4210-b63d-2c68d0dffcc9",
                                                "sense_id": "f3aa4246-f919-3325-ad77-e0ff47eb81cf",
                                                "text": "Le doyen de l’Assemblée a encore enfourché son vieux cheval de bataille à la buvette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
