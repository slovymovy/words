{
    "word_family": [
        "onderdompelen",
        "dompelen",
        "dompelaar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec351cee-e79a-3ee8-8c2f-f8b7737316f9",
                    "sense_definition": "Het geheel onder water of in een andere vloeistof geduwd of gedompeld worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gelovigen kiezen vaak voor een volledige <w>onderdompeling</w> in de rivier tijdens het ritueel.",
                            "target_lang_translations": {
                                "en": "The believers often choose full <w>immersion</w> in the river during the ritual."
                            }
                        },
                        {
                            "text": "Een korte <w>onderdompeling</w> in koud water helpt om de gekookte groenten knapperig te houden.",
                            "target_lang_translations": {
                                "en": "A brief <w>dipping</w> in cold water helps keep the cooked vegetables crisp."
                            }
                        }
                    ],
                    "synonyms": [
                        "immersie"
                    ],
                    "common_phrases": [
                        "volledige onderdompeling"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of being pushed or dipped entirely under water or into another liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immersion",
                                "target_lang_sense_clarification": "in liquid or baptism"
                            },
                            {
                                "target_lang_word": "submersion",
                                "target_lang_sense_clarification": "sinking completely under liquid"
                            },
                            {
                                "target_lang_word": "dipping",
                                "target_lang_sense_clarification": "brief lowering into liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ed49f72-2898-3a5d-9478-e4a66c9e03d5",
                    "sense_definition": "Het volledig omgeven of opgaan in een bepaalde omgeving, sfeer of bezigheid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een totale <w>onderdompeling</w> in de lokale cultuur is de beste manier om de taal snel te leren.",
                            "target_lang_translations": {
                                "en": "Total <w>immersion</w> in the local culture is the best way to learn the language quickly."
                            }
                        },
                        {
                            "text": "Het nieuwe museum biedt bezoekers een interactieve <w>onderdompeling</w> in de geschiedenis van de stad.",
                            "target_lang_translations": {
                                "en": "The new museum offers visitors an interactive <w>immersion</w> into the history of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "immersie"
                    ],
                    "common_phrases": [
                        "totale onderdompeling"
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being completely surrounded by or absorbed in a particular environment, atmosphere, or activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immersion",
                                "target_lang_sense_clarification": "deep engagement or cultural/language experience"
                            },
                            {
                                "target_lang_word": "absorption",
                                "target_lang_sense_clarification": "deep mental involvement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}