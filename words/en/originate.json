{
    "word_family": [
        "origin",
        "original",
        "originality",
        "originator",
        "unoriginal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df55b403-558d-3347-8e92-872f5bb7362b",
                    "sense_definition": "To come into existence or have a specific beginning or source.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many modern customs <w>originate</w> from ancient traditions that have changed over centuries.",
                            "target_lang_translations": {
                                "ru": "Многие современные обычаи <w>происходят</w> от древних традиций, которые менялись на протяжении веков.",
                                "de": "Viele moderne Bräuche <w>entspringen</w> alten Traditionen, die sich über Jahrhunderte verändert haben."
                            }
                        },
                        {
                            "text": "The rumor seems to <w>originate</w> from a misunderstanding during the meeting.",
                            "target_lang_translations": {
                                "ru": "Похоже, что слух <w>возник</w> из-за недопонимания во время встречи.",
                                "de": "Das Gerücht scheint aus einem Missverständnis während des Treffens <w>entstanden</w> zu sein."
                            }
                        }
                    ],
                    "synonyms": [
                        "begin",
                        "spring to life",
                        "take shape",
                        "come into being"
                    ],
                    "antonyms": [
                        "terminate",
                        "end"
                    ],
                    "common_phrases": [
                        "originate from",
                        "originate with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникать, брать начало или иметь определенный источник происхождения.",
                        "de": "Entstehen, seinen Anfang nehmen oder eine bestimmte Quelle haben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "иметь источником"
                            },
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "появляться, начинаться"
                            },
                            {
                                "target_lang_word": "берет начало",
                                "target_lang_sense_clarification": "о традициях или реках"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entstehen",
                                "target_lang_sense_clarification": "allgemein für das Beginnen einer Existenz"
                            },
                            {
                                "target_lang_word": "entspringen",
                                "target_lang_sense_clarification": "von einem Ursprung oder einer Quelle ausgehend"
                            },
                            {
                                "target_lang_word": "herstammen",
                                "target_lang_sense_clarification": "einen Ursprung in etwas haben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20229aec-9535-359d-a8f5-7dfb5660c3f9",
                    "sense_definition": "To cause something to begin or to bring something into existence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist <w>originated</w> a new theory that challenged the existing laws of physics.",
                            "target_lang_translations": {
                                "ru": "Ученый <w>создал</w> новую теорию, которая бросила вызов существующим законам физики.",
                                "de": "Der Wissenschaftler <w>entwickelte</w> eine neue Theorie, die die bestehenden Gesetze der Physik infrage stellte."
                            }
                        },
                        {
                            "text": "It is difficult to <w>originate</w> a project without any initial financial backing.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>положить начало</w> проекту без какой-либо первоначальной финансовой поддержки.",
                                "de": "Es ist schwierig, ein Projekt ohne anfängliche finanzielle Unterstützung zu <w>erzeugen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "initiate",
                        "begin",
                        "coin"
                    ],
                    "antonyms": [
                        "terminate",
                        "end"
                    ],
                    "common_phrases": [
                        "originate a project",
                        "originate a role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать начало чему-либо или создавать что-то новое.",
                        "de": "Etwas ins Leben rufen, initiieren oder erschaffen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "производить на свет"
                            },
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "быть причиной"
                            },
                            {
                                "target_lang_word": "положить начало",
                                "target_lang_sense_clarification": "инициировать процесс"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entwickeln",
                                "target_lang_sense_clarification": "ein Konzept oder Projekt ausarbeiten"
                            },
                            {
                                "target_lang_word": "erzeugen",
                                "target_lang_sense_clarification": "etwas hervorbringen oder verursachen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b1a99fd9-6060-338e-8448-2423bed25cbb",
                    "sense_definition": "Founded on or having its origin in something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal argument was <w>originate</w> upon principles established in the previous century.",
                            "target_lang_translations": {
                                "ru": "Юридический аргумент был <w>основан</w> на принципах, установленных в прошлом веке.",
                                "de": "Das juristische Argument war auf Prinzipien <w>begründet</w>, die im vorigen Jahrhundert etabliert wurden."
                            }
                        },
                        {
                            "text": "His beliefs were <w>originate</w> from a deep sense of historical justice.",
                            "target_lang_translations": {
                                "ru": "Его убеждения <w>проистекали</w> из глубокого чувства исторической справедливости.",
                                "de": "Seine Überzeugungen <w>entsprangen</w> einem tiefen Sinn für historische Gerechtigkeit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "originate upon"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adjectival use is rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на чем-либо или берущий начало в чем-либо (архаичное использование).",
                        "de": "Auf etwas basierend oder seinen Ursprung in etwas habend (gehoben/archaisch)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основанный",
                                "target_lang_sense_clarification": "базирующийся на чем-то"
                            },
                            {
                                "target_lang_word": "проистекающий",
                                "target_lang_sense_clarification": "берущий начало"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "begründet",
                                "target_lang_sense_clarification": "auf einer Basis oder einem Prinzip fußend"
                            },
                            {
                                "target_lang_word": "provinierend",
                                "target_lang_sense_clarification": "aus etwas hervorgehend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}