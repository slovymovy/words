                        "tags": [],
                        "form": "Brunéi"
                    },
                    {
                        "form_id": "dc7e3037-13a8-40bc-88bd-8ecfa2958212",
                        "entry_id": "acb78875-7ade-327a-8b95-306662b6859a",
                        "tags": [
                            "rare"
                        ],
                        "form": "Bruneï"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "649acf15-4a33-34dc-b3ad-813413856b6c",
                        "entry_id": "acb78875-7ade-327a-8b95-306662b6859a",
                        "glosses": [
                            "Petit sultanat asiatique situé sur la rive nord-ouest de l’île de Bornéo, formé de deux territoires côtiers distincts frontaliers de la Malaisie. Sa capitale est Bandar Seri Begawan."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "2a9a881d-500e-466f-b31f-c7e786fd50c2",
                                "sense_id": "649acf15-4a33-34dc-b3ad-813413856b6c",
                                "text": "Les hasards de mon dernier voyage m'avaient amené à Brunei, sur la côte septentrionale de Bornéo, et tout de suite mes correspondants m'avaient signalé une affaire possible à Sandakan, de l'autre côté des Bangueys."
                            },
                            {
                                "example_id": "2364b247-ea02-4e73-9de7-e3ca8e8b76a1",
                                "sense_id": "649acf15-4a33-34dc-b3ad-813413856b6c",
                                "text": "II est entendu toutefois que les dispositions du présent paragraphe ne conféreront à aucune cour une compétence qui, immédiatement avant le Jour de la Malaisie, découlait d’une loi de l’État de Brunei."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "820671ab-57c9-412b-a1a3-e2387defea55",
                        "source_entry_id": "acb78875-7ade-327a-8b95-306662b6859a",
                        "source_sense_id": "649acf15-4a33-34dc-b3ad-813413856b6c",
                        "target_lang_word": "Brunei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brunei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f6aa048-5887-3b8c-97b0-8d033315f3f1",
                                        "entry_id": "b8e9613b-981a-3961-aa45-965ee82f6cd6",
                                        "glosses": [
                                            "Staat auf der asiatischen Insel Borneo"
                                        ],
                                        "tags": [
                                            "nicht amtlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82aba786-4a5b-4996-bbeb-12fb5999b867",
                                                "sense_id": "7f6aa048-5887-3b8c-97b0-8d033315f3f1",
                                                "text": "„Brunei ist ein reicher Wohlfahrtsstaat; Bildungs- und Gesundheitssystem auf hohem Niveau stehen kostenlos zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "eb341b36-2cd1-488e-ba86-a8af1db99397",
                                                "sense_id": "7f6aa048-5887-3b8c-97b0-8d033315f3f1",
                                                "text": "Das Brunei der Vergangenheit hatte eine größere Fläche."
                                            },
                                            {
                                                "example_id": "c3d7986a-4ccf-439e-9972-67ed4e0193d2",
                                                "sense_id": "7f6aa048-5887-3b8c-97b0-8d033315f3f1",
                                                "text": "„Brunei gab 2013 rund 402 Millionen US-Dollar für sein Militär aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
