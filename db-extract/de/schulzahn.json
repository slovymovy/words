                "senses": [
                    {
                        "sense_id": "1fb4b00a-2485-3376-9bc1-808ececf7949",
                        "entry_id": "a363e4d2-8c40-38a2-8b4d-bc7c5c024140",
                        "glosses": [
                            "Zahn, der bei Heranwachsenden etwa mit Beginn des Schuleintritts einen Zahn des Milchgebisses ablöst"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "caab97e9-ddd4-4037-ab72-0d99c1bda40e",
                                "sense_id": "1fb4b00a-2485-3376-9bc1-808ececf7949",
                                "text": "„Dass die nachkommenden Zähne mitunter als Schulzähne bezeichnet werden, offenbart das Wissen um den vergesellschafteten Charakter des herannahenden neuen Lebensabschnittes.“"
                            },
                            {
                                "example_id": "1f97efcd-0119-49f5-8d2a-2d8738668629",
                                "sense_id": "1fb4b00a-2485-3376-9bc1-808ececf7949",
                                "text": "„Es kommt vor, dass auf ein lupenreines Milchgebiss plötzlich fleckige, empfindliche Schulzähne folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
