                                        "entry_id": "112661b9-9f22-3044-922c-1aa7d5e42c5f",
                                        "glosses": [
                                            "zentrale Platine eines Computers, auf der alle wesentlichen elektronischen Baugruppen angeordnet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5410914-3511-47b4-953a-8c25b4c13481",
                                                "sense_id": "47656916-8a2a-336a-8d6f-4c3ca1f43313",
                                                "text": "Da er den Computer nur für Büroarbeiten verwendet, stellt er keine hohen Anforderungen an die Hauptplatine."
                                            },
                                            {
                                                "example_id": "74c6cbd9-797e-4317-bc96-fb5243373b54",
                                                "sense_id": "47656916-8a2a-336a-8d6f-4c3ca1f43313",
                                                "text": "„Von Wozniak stammte die Idee, die Bauteile auf einer Hauptplatine zu vereinen, die Anordnung der Schaltkreise bis hin zur Software, die das System zum Laufen brachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
