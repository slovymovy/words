                                "target_senses": [
                                    {
                                        "sense_id": "f13a8a44-f8d2-347a-8a08-277b9ee7be48",
                                        "entry_id": "8b772eee-53d8-3c92-8565-0d2d774f5420",
                                        "glosses": [
                                            "The act of lamenting."
                                        ],
