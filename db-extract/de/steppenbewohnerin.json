                ],
                "senses": [
                    {
                        "sense_id": "9fcfde97-de2f-3226-af89-794a37b9194f",
                        "entry_id": "7ecb879c-0f5b-37fc-a579-64d247cab474",
                        "glosses": [
                            "Bewohnerin einer Steppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b0d3d3f-606c-4021-a207-a9460e8b131a",
                                "sense_id": "9fcfde97-de2f-3226-af89-794a37b9194f",
                                "text": "„Alle die hübschen Lieder in den Beduinendialekten, die man am Lagerfeuer, bei Hochzeiten, in den Nächten des Ramadan hören kann und die oft sehr erotischen Inhaltes sind, beziehen sich auf verheiratete Steppenbewohnerinnen.“"
                            },
                            {
                                "example_id": "025d346b-0ced-4718-806a-0bf7cb224212",
                                "sense_id": "9fcfde97-de2f-3226-af89-794a37b9194f",
                                "text": "„Drei bayt verwendet der Autor, um der städtischen Araber Sitte, die Kinder zum Stillen den Steppenbewohnerinnen zu geben, zu beschreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
