{
    "word_family": [
        "essoufflement",
        "souffle",
        "souffler",
        "soufflerie",
        "souffleur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8edc9ca6-fa2f-3e2a-a1d0-0938a02e8ee2",
                    "sense_definition": "Mettre hors d'haleine par un mouvement violent ou un effort trop soutenu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette marche rapide dans la neige finit par <w>essouffler</w> les enfants.",
                            "target_lang_translations": {
                                "en": "This brisk walk through the snow ends up <w>exhausting</w> the children.",
                                "ru": "Этот быстрый переход по снегу в итоге <w>изматывает</w> детей.",
                                "de": "Dieser schnelle Marsch durch den Schnee <w>bringt</w> die Kinder am Ende <w>außer Atem</w>.",
                                "es": "Esta marcha rápida por la nieve acaba por <w>agotar</w> a los niños.",
                                "zh": "在雪地里快步走，最后让孩子们<w>喘不过气</w>来。"
                            }
                        },
                        {
                            "text": "Le rythme imposé dès le départ a rapidement réussi à <w>essouffler</w> l'adversaire.",
                            "target_lang_translations": {
                                "en": "The pace set from the start quickly managed to <w>wind</w> the opponent.",
                                "ru": "Навязанный с самого начала темп быстро <w>измотал</w> соперника.",
                                "de": "Das gleich zu Beginn diktierte Tempo hat den Gegner rasch <w>außer Atem gebracht</w>.",
                                "es": "El ritmo impuesto desde el principio logró <w>agotar</w> rápidamente al adversario.",
                                "zh": "一开场就强加给对方的快节奏，很快就把对手<w>拖垮</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "essouffler l'adversaire"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone out of breath through violent movement or excessive effort.",
                        "ru": "Вызвать сильную одышку или изнеможение у кого-либо физическим усилием.",
                        "de": "Jemanden durch eine heftige Bewegung oder eine zu große Anstrengung außer Atem bringen.",
                        "es": "Dejar a alguien sin aliento por un movimiento violento o un esfuerzo excesivo.",
                        "zh": "通过剧烈运动或过度费力，使人上气不接下气、精疲力竭。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave breathless",
                                "target_lang_sense_clarification": "through hard effort"
                            },
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "knock the breath out of"
                            },
                            {
                                "target_lang_word": "exhaust",
                                "target_lang_sense_clarification": "tire someone out physically"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "изматывать",
                                "target_lang_sense_clarification": "о длительной физической нагрузке"
                            },
                            {
                                "target_lang_word": "загонять",
                                "target_lang_sense_clarification": "разг., довести до изнеможения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "außer Atem bringen",
                                "target_lang_sense_clarification": "durch Anstrengung, schnelle Bewegung"
                            },
                            {
                                "target_lang_word": "aus der Puste bringen",
                                "target_lang_sense_clarification": "umgangssprachlich"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "agotar",
                                "target_lang_sense_clarification": "cansancio físico extremo"
                            },
                            {
                                "target_lang_word": "dejar sin aliento",
                                "target_lang_sense_clarification": "por esfuerzo físico intenso"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使喘不过气",
                                "target_lang_sense_clarification": "剧烈运动让人气喘"
                            },
                            {
                                "target_lang_word": "拖垮",
                                "target_lang_sense_clarification": "长时间消耗体力使人疲惫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc926567-d246-3f5a-808b-ce50d1b8fba3",
                    "sense_definition": "Perdre son souffle, manquer de respiration à la suite d'un effort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je commence à m'<w>essouffler</w> sérieusement en montant cette pente raide.",
                            "target_lang_translations": {
                                "en": "I'm starting to <w>pant</w> heavily as I climb this steep slope.",
                                "ru": "Поднимаясь по этому крутому склону, я начинаю сильно <w>задыхаться</w>.",
                                "de": "Beim Aufstieg auf diesen steilen Hang beginne ich, stark zu <w>keuchen</w>.",
                                "es": "Empiezo a <w>jadear</w> con fuerza al subir esta pendiente empinada.",
                                "zh": "爬这段陡坡时，我开始<w>喘</w>得厉害。"
                            }
                        },
                        {
                            "text": "Le randonneur s'<w>essouffle</w> dès que le chemin devient un peu trop escarpé.",
                            "target_lang_translations": {
                                "en": "The hiker starts to <w>pant</w> as soon as the path becomes a little too steep.",
                                "ru": "Турист начинает <w>задыхаться</w>, как только тропа становится чуть круче.",
                                "de": "Der Wanderer fängt an zu <w>keuchen</w>, sobald der Weg etwas zu steil wird.",
                                "es": "El excursionista empieza a <w>jadear</w> en cuanto el camino se vuelve un poco demasiado escarpado.",
                                "zh": "只要小路变得稍微有点太陡，徒步的人就开始<w>喘</w>起来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To lose one's breath and struggle to breathe after physical exertion.",
                        "ru": "Терять дыхание и с трудом дышать после физического напряжения.",
                        "de": "Nach einer körperlichen Anstrengung den Atem verlieren und nur schwer atmen können.",
                        "es": "Perder el aliento y respirar con dificultad tras un esfuerzo físico.",
                        "zh": "剧烈活动后呼吸急促、费力，上气不接下气。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get out of breath",
                                "target_lang_sense_clarification": "after exertion"
                            },
                            {
                                "target_lang_word": "pant",
                                "target_lang_sense_clarification": "short, rapid breaths"
                            },
                            {
                                "target_lang_word": "puff",
                                "target_lang_sense_clarification": "breathing hard, usually climbing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "запыхаться",
                                "target_lang_sense_clarification": "от быстрой ходьбы или бега"
                            },
                            {
                                "target_lang_word": "задыхаться",
                                "target_lang_sense_clarification": "нехватка воздуха, сильная одышка"
                            },
                            {
                                "target_lang_word": "пыхтеть",
                                "target_lang_sense_clarification": "громко, с усилием дыша"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "keuchen",
                                "target_lang_sense_clarification": "beim Laufen oder Bergsteigen"
                            },
                            {
                                "target_lang_word": "schnaufen",
                                "target_lang_sense_clarification": "laut atmen, oft bergauf"
                            },
                            {
                                "target_lang_word": "außer Atem kommen",
                                "target_lang_sense_clarification": "nach körperlicher Anstrengung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "jadear",
                                "target_lang_sense_clarification": "respiración rápida y entrecortada"
                            },
                            {
                                "target_lang_word": "quedarse sin aliento",
                                "target_lang_sense_clarification": "tras correr o subir cuestas"
                            },
                            {
                                "target_lang_word": "resollar",
                                "target_lang_sense_clarification": "respirar fuerte, con ruido"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喘",
                                "target_lang_sense_clarification": "剧烈运动后呼吸急促"
                            },
                            {
                                "target_lang_word": "气喘",
                                "target_lang_sense_clarification": "运动后呼吸困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab3e035e-620a-379c-8a72-525526a80f78",
                    "sense_definition": "Perdre de sa vitalité, de son élan ou faiblir peu à peu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affaiblissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La contestation populaire semble s'<w>essouffler</w> après des semaines de mobilisation continue.",
                            "target_lang_translations": {
                                "en": "Popular protest seems to be <w>flagging</w> after weeks of continuous mobilisation.",
                                "ru": "Народный протест, похоже, <w>выдыхается</w> после нескольких недель непрерывных акций.",
                                "de": "Der Volksprotest scheint nach wochenlanger anhaltender Mobilisierung <w>abzuflauen</w>.",
                                "es": "La protesta popular parece <w>decaer</w> tras semanas de movilización continua.",
                                "zh": "经过连续数周的动员，民众的抗议似乎正在<w>降温</w>。"
                            }
                        },
                        {
                            "text": "Le marché immobilier commence à s'<w>essouffler</w> face à la hausse des taux bancaires.",
                            "target_lang_translations": {
                                "en": "The property market is starting to <w>wane</w> in the face of rising bank interest rates.",
                                "ru": "Рынок недвижимости начинает <w>выдыхаться</w> под давлением роста банковских ставок.",
                                "de": "Der Immobilienmarkt beginnt angesichts steigender Bankzinsen <w>nachzulassen</w>.",
                                "es": "El mercado inmobiliario empieza a <w>decaer</w> ante la subida de los tipos de interés bancarios.",
                                "zh": "面对银行利率的上涨，房地产市场开始<w>降温</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "faiblir",
                        "ralentir"
                    ],
                    "target_lang_definitions": {
                        "en": "To gradually lose vitality, momentum or strength and weaken.",
                        "ru": "Постепенно терять силу, динамику или жизненность.",
                        "de": "Allmählich an Kraft, Schwung oder Lebendigkeit verlieren und schwächer werden.",
                        "es": "Perder poco a poco vitalidad, impulso o fuerza, debilitarse.",
                        "zh": "逐渐失去活力、势头或力量，慢慢减弱。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flag",
                                "target_lang_sense_clarification": "losing energy and enthusiasm"
                            },
                            {
                                "target_lang_word": "wane",
                                "target_lang_sense_clarification": "of popularity, influence or momentum"
                            },
                            {
                                "target_lang_word": "peter out",
                                "target_lang_sense_clarification": "gradually coming to an end"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выдыхаться",
                                "target_lang_sense_clarification": "о силе, энтузиазме, движении"
                            },
                            {
                                "target_lang_word": "спадать",
