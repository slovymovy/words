                                        "entry_id": "96e66334-cfda-3dfd-a182-c2f98fb8691b",
                                        "glosses": [
                                            "Like a fop, a man overly concerned with his appearance; vain and showy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb2dc8b-a696-4202-9d03-0480fb6ab802",
                                                "sense_id": "81ed2f36-1515-3eeb-ab52-f5109e226ab1",
                                                "text": "They talked a delicate and elastic Arabic, and were mannered, often foppish, in habit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
