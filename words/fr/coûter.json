                    "frequency": "High",
                    "semantic_group_id": "prix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau modèle de vélo électrique <w>coûte</w> plus de mille euros."
                        },
                        {
                            "text": "Prendre un taxi le soir peut <w>coûter</w> cher dans cette ville."
                        }
                    ],
                    "common_phrases": [
                        "coûter cher",
                        "coûter une fortune"
                    ]
                },
                {
                    "sense_id": "b6b206d6-d962-3043-9a7e-6aa1f3d75351",
                    "sense_definition": "Occasionner une perte pénible, exiger des sacrifices ou des efforts importants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet accident de la route a malheureusement <w>coûté</w> la vie à deux personnes."
                        },
                        {
                            "text": "Cette grave erreur risque de lui <w>coûter</w> sa place au sein de l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "coûter la vie",
                        "coûter cher"
                    ]
                },
                {
                    "sense_id": "e66e74a5-ad30-3a77-ac64-a46b1985dbbc",
                    "sense_definition": "Exiger un effort moral pénible, être difficile à faire ou à accepter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "peine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui en <w>coûte</w> d'avouer ses fautes devant toute la famille."
                        },
                        {
                            "text": "Je dois reconnaître que cette démarche nécessaire me <w>coûte</w> beaucoup."
                        }
                    ],
                    "common_phrases": [
                        "en coûter"
                    ]
                }
            ]
        }
