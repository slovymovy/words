                "senses": [
                    {
                        "sense_id": "515e73a1-bab3-3902-9611-c7c1e5ac457f",
                        "entry_id": "4deba7f3-e77f-34c3-9134-df9fa5607e31",
                        "glosses": [
                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch von der Ente"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "4d5861b9-3bdc-497c-9b40-a91cd6e74a13",
                                "sense_id": "515e73a1-bab3-3902-9611-c7c1e5ac457f",
                                "text": "„Das magere und das fette Schweinefleisch in Würfel schneiden und mit dem Entenfleisch mischen. Salzen und pfeffern.“"
                            },
                            {
                                "example_id": "d224a170-390b-49bc-a72f-8f660d69333f",
                                "sense_id": "515e73a1-bab3-3902-9611-c7c1e5ac457f",
                                "text": "„Thomas wanderte in die Küche zurück, um nach seinem Süppchen zu sehen, schnitt das Entenfleisch in Stücke und wanderte zurück ins Labor, um nach seinen Barren zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
