                                "sense_id": "3bc66af4-b60f-304b-b144-3ffa7fcca87c",
                                "text": "The film is told in reverse ala Memento."
                            },
                            {
                                "example_id": "533fde12-5cff-4825-9ce5-aed01078ea43",
                                "sense_id": "3bc66af4-b60f-304b-b144-3ffa7fcca87c",
                                "text": "[…] interactive plasma screens with flashing digits and what not, ala “Minority Report,” […]"
                            },
                            {
                                "example_id": "a85a4523-f21b-4b06-85fb-e075e2d4ab6d",
                                "sense_id": "3bc66af4-b60f-304b-b144-3ffa7fcca87c",
                                "text": "[…] we might be getting to the point where Palin is a bona fide liability—ala Pelosi—for the GOP."
                            },
                            {
                                "example_id": "24e7cbbc-9ea2-4487-9d12-dc74dba50201",
                                "sense_id": "3bc66af4-b60f-304b-b144-3ffa7fcca87c",
                                "text": "[…] the NYSE didn't implode ala Merrill […]"
                            }
                        ]
                    }
