                        "sense_id": "752bac8c-895e-3e4e-a87a-da13e9a601c3",
                        "entry_id": "bb96165c-3ad5-30b2-b5bf-c28ea092b97c",
                        "glosses": [
                            "That causes a transformation; causing a notable and lasting change"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c274e298-6312-46c7-8c98-c1b8f76af556",
                                "sense_id": "752bac8c-895e-3e4e-a87a-da13e9a601c3",
                                "text": "\"You'll know the transformative effect that the Metro has had on the whole of Tyneside,\" says NCC [Northumberland County Council] leader Peter Jackson. \"This new passenger line will have the same effect on southeast Northumberland. It's a transformative project and we're going to make sure it happens.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5ce587bb-f3ec-374d-b478-4bf46c4482c2",
                        "entry_id": "bb96165c-3ad5-30b2-b5bf-c28ea092b97c",
                        "glosses": [
                            "Chiefly in transformative-generative: of or relating to a theory of generative grammar in which defined operations called transformations produce new sentences from existing ones; transformational."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "193e1b72-936c-475c-bd1a-1a3f7d561ae1",
