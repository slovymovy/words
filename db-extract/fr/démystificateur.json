                                "target_senses": [
                                    {
                                        "sense_id": "37283759-69f7-3e4d-8b23-7ee352e23cc5",
                                        "entry_id": "cd4d9326-ab2d-3e89-b446-e032cf6a5a0d",
                                        "glosses": [
                                            "Someone who debunks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e0c395-9bd5-46d0-8f0e-e639ecfd64ed",
                                                "sense_id": "37283759-69f7-3e4d-8b23-7ee352e23cc5",
                                                "text": "Interest Rate Observer, and a debunker of U.S. stocks since the Dow was at 2,000, has appeared on Rukeyser's TV show, where he gets bear-baited: \"World's going to hell again, eh, Jim?\""
                                            },
                                            {
                                                "example_id": "bdaa616e-1672-4c9e-a545-ba2c21b33447",
                                                "sense_id": "37283759-69f7-3e4d-8b23-7ee352e23cc5",
                                                "text": "Still, something strange was afoot in Rendlesham, and even if the file is unlikely to satisfy either ufologists or debunkers, it suggests that the truth is still out there."
                                            },
                                            {
                                                "example_id": "05200525-af25-4402-88f5-0b4781dc3708",
                                                "sense_id": "37283759-69f7-3e4d-8b23-7ee352e23cc5",
                                                "text": "Philip J. Klass belonged to the small and somewhat peculiar class of individuals known as debunkers."
                                            }
                                        ]
                                    }
