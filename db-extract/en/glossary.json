        "de-extract.jsonl": [
            {
                "entry_id": "210eb9f7-a8c0-3067-ba05-3cc2c1a801fb",
                "word": "glossary",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e8da39d4-08a0-3064-98d5-9e52243d5e04",
                        "entry_id": "210eb9f7-a8c0-3067-ba05-3cc2c1a801fb",
                        "glosses": [
                            "Glossar: eine alphabetisch sortierte Liste von (Fach-)Begriffen eines bestimmten Wissensgebietes und den Definitionen für diese Begriffe"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02ffa3f1-5ed9-4bcc-96f6-0d980e483ff5",
                        "source_entry_id": "210eb9f7-a8c0-3067-ba05-3cc2c1a801fb",
                        "source_sense_id": "e8da39d4-08a0-3064-98d5-9e52243d5e04",
                        "target_lang_word": "Glossar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glossar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                        "entry_id": "853700da-4a1a-3efc-83d8-8fbe6b1cdb2a",
                                        "glosses": [
                                            "Liste von Fach- oder anderen nicht geläufigen Wörtern mit Erklärung (traditionell als Anhang in einem Buch, heute auch im Internet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a71261-8e01-4494-abe3-3f00bc82a4ce",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "Das Nützlichste an diesem Buch ist sein umfangreiches Glossar."
                                            },
                                            {
                                                "example_id": "f748b3a3-41b3-42cf-a4f0-99958ce03d56",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Der Abrogans, das älteste lateinisch-deutsche Glossar (…), bietet zu jedem Element eines lateinischen Synonymenpaars je ein althochdeutsches Äquivalent.“"
                                            },
                                            {
                                                "example_id": "f4281d8b-8f23-4421-a4ca-f020874173cc",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Abgerundet wird dieses Werk durch ein Glossar, in dem die Wurzeln der geografischen Namen (aus zahlreichen Sprachen) in kurzer Zusammenschau erklärt werden.“"
                                            },
                                            {
                                                "example_id": "ed4c7ca5-7c0f-45c5-8f11-646674c6c989",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Aber ich habe etliche dieser Begriffe separat im Anschluß an das Glossar aufgezählt.“"
                                            },
                                            {
                                                "example_id": "9d7e6326-a975-4eeb-86db-e3d394d2f27e",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Diese Arbeitsweise trägt der Tatsache Rechnung, dass das Glossar Teil eines sich ständig verändernden Diskurses ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31b0f50e-f39c-4a22-9651-74abb090447e",
                        "source_entry_id": "210eb9f7-a8c0-3067-ba05-3cc2c1a801fb",
                        "source_sense_id": "e8da39d4-08a0-3064-98d5-9e52243d5e04",
                        "target_lang_word": "Wortliste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortliste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                        "entry_id": "a5048a90-007a-3cc9-8baf-71a1f2a523ff",
                                        "glosses": [
                                            "Liste, auf der sich Wörter befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7136ab72-a403-4699-a47d-7c98a5b25492",
                                                "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                                "text": "Ein Team von Sprachforschern arbeitet gerade an einer Wortliste des germanischen Grundwortschatzes."
                                            },
                                            {
                                                "example_id": "a78e40a4-387e-4a9d-ad86-7c07413fa4ac",
                                                "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                                "text": "„Getestet wurde die Sprechweise in einer Reihe von Aufgaben: So sollten Texte und Wortlisten vorgelesen, einzelne Bilder benannt und Texte aus dem Englischen übersetzt werden, ferner mussten Wegbeschreibungen gegeben werden; zusätzlich wurden Interviews durchgeführt.“"
                                            },
                                            {
                                                "example_id": "8c18dd0c-fb35-45ff-990e-c9db4fd78cf5",
                                                "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                                "text": "„Zum Ersten ist festzuhalten, das sprachliche Unterschiede zwischen der alten Bundesrepublik und der DDR im Bereich öffentlich-institutionellen Sprechens existierten; es lassen sich entsprechende Wortlisten von beeindruckender Länge aufstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67feb557-294e-4fc5-8b3d-828a228d7524",
                        "source_entry_id": "210eb9f7-a8c0-3067-ba05-3cc2c1a801fb",
                        "source_sense_id": "e8da39d4-08a0-3064-98d5-9e52243d5e04",
                        "target_lang_word": "Wörterverzeichnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wörterverzeichnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5edfd4ea-c974-30c0-ba84-5c310ab70e8f",
                                        "entry_id": "d57a161b-fd15-3e07-b0d9-1afe52922c3f",
                                        "glosses": [
                                            "Liste von Wörtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ab8ab0-ee66-458e-922c-2b04e61e68fe",
                                                "sense_id": "5edfd4ea-c974-30c0-ba84-5c310ab70e8f",
                                                "text": "„Er wollte vor allem erreichen, daß die deutsche Rechtschreibung für jeden verständlich ist, und damit es ganz einfach und praktisch war, ergänzte er die Regeln durch ein Wörterverzeichnis.“"
                                            },
                                            {
                                                "example_id": "2123814f-fe7b-46ae-b4bb-855a04983e6c",
                                                "sense_id": "5edfd4ea-c974-30c0-ba84-5c310ab70e8f",
                                                "text": "„Die staatlichen Stellen übertrugen dem Rat anschließend das Recht, auf der Basis dieser Beobachtungen selbst über kleinere Veränderungen im Wörterverzeichnis zu entscheiden.“"
                                            },
                                            {
                                                "example_id": "dd5a584d-d794-4ff3-ab00-66fe4ad338ad",
                                                "sense_id": "5edfd4ea-c974-30c0-ba84-5c310ab70e8f",
                                                "text": "„Um nicht auf die Hilfe von Übersetzern angewiesen zu sein, lernt er, soweit möglich, die Sprachen der Völker, die er besucht, und legt dazu eigene Wörter- und Grammatikverzeichnisse an.“"
                                            },
                                            {
                                                "example_id": "64931b80-d5f6-4fc2-b983-e598a8923b03",
                                                "sense_id": "5edfd4ea-c974-30c0-ba84-5c310ab70e8f",
                                                "text": "„Wenn auch das Wörterverzeichnis nicht weiterhilft, stehen den Schreibenden gewisse Freiräume für eigene Entscheidungen offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
