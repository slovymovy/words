                        "sense_id": "14eb3b46-779a-38b8-b1d7-07a307a1803d",
                        "entry_id": "50ed8fde-61d9-3a58-bdac-a3dd5dee61d0",
                        "glosses": [
                            "Instrument de forge qui sert à aplatir le fer ou tout autre métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4f42ad-af23-4164-ad4f-0e82132dcfcb",
                                "sense_id": "14eb3b46-779a-38b8-b1d7-07a307a1803d",
                                "text": "Shani, masqué des lunettes de protection, frappait sur l’essieu avec l’aplatissoir, et au plus fort de la discussion il s’approcha de Le Gouarec, un morceau de fer incandescent au bout de ses tenailles."
                            }
                        ]
                    }
                ],
