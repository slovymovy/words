                },
                {
                    "sense_id": "d6ed889b-2a2a-399d-b797-9bc11e06ce27",
                    "sense_definition": "The movement of soldiers by turning on their heels to the right, left, or about.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_drill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drill sergeant instructed the recruits on proper <w>facings</w> and marching steps.",
                            "target_lang_translations": {
                                "ru": "Сержант по строевой подготовке проинструктировал новобранцев о правильном выполнении <w>поворотов на месте</w> и строевого шага."
                            }
                        },
                        {
                            "text": "The soldiers executed their <w>facings</w> with perfect precision during the parade.",
                            "target_lang_translations": {
                                "ru": "Солдаты с безупречной точностью выполняли <w>повороты</w> во время парада."
                            }
                        }
                    ],
                    "common_phrases": [
                        "right facing",
                        "left facing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение солдат при повороте на месте направо, налево или кругом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворот на месте",
                                "target_lang_sense_clarification": "строевой прием"
                            }
                        ]
