                                "example_id": "cec35481-855f-4ced-9ba0-232e590d37ba",
                                "sense_id": "a99545d3-b417-32fb-b515-c44cc5289931",
                                "text": "Les perfusionnistes exercent un métier exigeant, où la moindre erreur ou mauvaise décision peut entraîner de graves conséquences pour le patient."
                            }
                        ]
