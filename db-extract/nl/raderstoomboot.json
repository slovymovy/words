                "translations": [
                    {
                        "translation_id": "721f72a8-875f-4dea-8a6c-e7c9580a85f0",
                        "source_entry_id": "ca7c1bf2-09ee-3d59-91cd-8b26bf013df9",
                        "source_sense_id": "d1697def-133b-3dab-9724-73cf8398cff3",
                        "source_sense_description": "een scheepstype dat wordt voortbewogen door schoepenraderen",
                        "target_lang_word": "Raddampfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raddampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                        "entry_id": "126268d4-1684-33a2-b601-1d3287f4a9ad",
                                        "glosses": [
                                            "Dampfschiff, das von Schaufelrädern angetrieben wird"
                                        ],
                                        "tags": [
                                            "Schiffswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b697b6c-b185-4b57-9237-f0ea057af1f9",
                                                "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                                "text": "„Raddampfer wurden hauptsächlich im ausgehenden 19. und beginnenden 20. Jahrhundert gebaut, als die Dampfschifffahrt Stand der Technik im Schiffbau war.“"
                                            },
                                            {
                                                "example_id": "941f3757-adb3-4db4-8366-13eb6fef71ba",
                                                "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                                "text": "„Die Flotte der Schifffahrtsgesellschaft des Vierwaldstättersees betreibt fünf nostalgische Raddampfer, von denen jeder seine einzigartige Eigenschaft hat.“"
                                            },
                                            {
                                                "example_id": "8e6442bd-98d3-4a2a-9a22-5fe7f3615a8c",
                                                "sense_id": "0ffc9198-a036-373b-a92a-32c88c3d2572",
                                                "text": "„Ein schönes Erlebnis ist eine Ausflugsfahrt mit dem Raddampfer Freya. Wer eine kurze Reise in die Vergangenheit machen möchte, ist auf dem Raddampfer Freya am richtigen Ort. Dieses Schiff hat nichts von seinem Charme verloren und begeistert seine Gäste immer wieder aufs Neue.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2014d1cc-5950-452e-a7b3-cfa42a9c09fc",
                        "source_entry_id": "ca7c1bf2-09ee-3d59-91cd-8b26bf013df9",
                        "source_sense_id": "d1697def-133b-3dab-9724-73cf8398cff3",
