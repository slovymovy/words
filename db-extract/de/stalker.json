                        "source_sense_id": "ff022642-03db-3ad1-b3df-d301e7129ca4",
                        "source_sense_description": "jemand, der eine andere Person unaufhörlich verfolgt, bedrängt oder bedroht",
                        "target_lang_word": "persécuteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persécuteur",
