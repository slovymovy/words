                        "entry_id": "3e9d91d7-8bfd-3113-8925-2986257c65cb",
                        "glosses": [
                            "Qui n’est pas propre (à quelque chose), qui ne devrait pas être utilisé (pour quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc6cc791-cafd-4a2b-b79f-baae1f2cbd18",
                                "sense_id": "54b29551-f556-38cf-b87f-64974d7a965b",
                                "text": "L’inspection ante-mortem peut améliorer l’efficacité de l’opération en éliminant un certain nombre d’animaux qui seraient impropres à la consommation."
                            }
                        ]
                    },
                    {
                        "sense_id": "980efe32-e1b3-3c6d-92f7-5d244f188937",
                        "entry_id": "3e9d91d7-8bfd-3113-8925-2986257c65cb",
