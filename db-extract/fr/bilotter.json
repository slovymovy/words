                        "glosses": [
                            "Se faire de la bile, s’inquiéter."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "915f0987-3d31-4822-8108-e245708d78a3",
                                "sense_id": "402e3ad3-3765-31a1-927b-a2dcbc4e77cd",
                                "text": "Nous avons, en tête de notre flotte,\n Un ministre qui point ne se bilotte :\n Que tout aille mal, que tout aille bien,\n Ça ne lui fait rien ! rien ! rien !"
                            },
                            {
                                "example_id": "18cdd3b9-8030-4f47-a7ba-066de831fff0",
                                "sense_id": "402e3ad3-3765-31a1-927b-a2dcbc4e77cd",
                                "text": "C’est normal, mon Lieutenant, pas la peine de se bilotter, ça fait ça à tout le monde !"
                            }
                        ]
                    }
