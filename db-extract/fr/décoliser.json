                "senses": [
                    {
                        "sense_id": "6428e388-743b-3017-9bcb-6743302a6730",
                        "entry_id": "0705a81b-6f6e-3099-b23a-e2039705dafe",
                        "glosses": [
                            "Sortir (un produit) du colis où il était auparavant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4bbbd38-9466-4f20-a4d6-d69a70f84c03",
                                "sense_id": "6428e388-743b-3017-9bcb-6743302a6730",
                                "text": "Le principal rôle de la plate-forme est de collecter les produits des producteurs, de les stocker, parfois de les « décoliser » (pour les mettre dans des colis plus petits) et de préparer les produits à livrer en fonction des commandes clients."
                            },
                            {
                                "example_id": "b1f03c05-9e91-4e8e-8ca1-51a5a78fe3b1",
                                "sense_id": "6428e388-743b-3017-9bcb-6743302a6730",
                                "text": "Certaines références que nous ne stockons pas, ne peuvent être décolisées."
                            },
                            {
                                "example_id": "8d433099-fe51-4efb-b4b1-c7811a963124",
                                "sense_id": "6428e388-743b-3017-9bcb-6743302a6730",
                                "text": "Laisser la possibilité au client de commander des produits décolisés se paramètre lors de la mise en place de l'offre commerciale envers celui-ci."
                            }
                        ]
                    }
                ],
