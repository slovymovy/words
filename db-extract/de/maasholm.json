                            {
                                "example_id": "11034fb4-0b0a-4bc9-945a-f3e88103d784",
                                "sense_id": "02ab01c8-378d-37f0-b717-73f950333e46",
                                "text": "Unseren letzten Urlaub verbrachten wir in Maasholm."
                            },
                            {
                                "example_id": "0ffed9be-62d6-4fa0-ac93-2c694739b081",
                                "sense_id": "02ab01c8-378d-37f0-b717-73f950333e46",
                                "text": "Maasholm liegt an der Ostsee."
                            },
                            {
                                "example_id": "c5388af3-72c8-44f0-8823-ca3851fe4f56",
                                "sense_id": "02ab01c8-378d-37f0-b717-73f950333e46",
                                "text": "„Die Hafenmeister arbeiten in Maasholm mit Hochdruck daran, dass der Sportboothafen bald wieder zur Verfügung steht. Doch die Schäden sind immens.“"
                            }
                        ],
