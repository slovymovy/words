{
    "word_family": [
        "cabby",
        "cabman",
        "cabstand",
        "cabriolet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c37706d-177b-3cd7-b6da-7ac5e881a290",
                    "sense_definition": "A car and its driver that you pay to take you where you want to go.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to take a <w>cab</w> to the airport because my luggage was too heavy for the bus.",
                            "target_lang_translations": {
                                "ru": "Я решил поехать в аэропорт на <w>такси</w>, потому что мой багаж был слишком тяжелым для автобуса.",
                                "zh": "我决定<w>打车</w>去机场，因为我的行李太重，没法坐公交车。"
                            }
                        },
                        {
                            "text": "We should call a <w>cab</w> now if we want to make it to the theater on time.",
                            "target_lang_translations": {
                                "ru": "Нам стоит вызвать <w>такси</w> прямо сейчас, если мы хотим успеть в театр вовремя.",
                                "zh": "如果我们想准时赶到剧院，现在就得<w>叫车</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "taxi"
                    ],
                    "common_phrases": [
                        "take a cab",
                        "call a cab",
                        "cab ride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль с водителем, услуги которого оплачиваются для поездки в нужное место.",
                        "zh": "一种付费的载客汽车及其司机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "такси",
                                "target_lang_sense_clarification": "автомобиль"
                            },
                            {
                                "target_lang_word": "кэб",
                                "target_lang_sense_clarification": "в англоязычных странах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出租车",
                                "target_lang_sense_clarification": "现代载客汽车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "404a8cd5-33c9-3f19-aadd-51091fa3d237",
                    "sense_definition": "The separate front part of a truck, train, or crane where the driver sits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver climbed into the <w>cab</w> of the truck and started the engine.",
                            "target_lang_translations": {
                                "ru": "Водитель забрался в <w>кабину</w> грузовика и завел двигатель.",
                                "zh": "司机爬进卡车的<w>驾驶室</w>，发动了引擎。"
                            }
                        },
                        {
                            "text": "From the crane <w>cab</w>, the operator had a clear view of the entire construction site.",
                            "target_lang_translations": {
                                "ru": "Из <w>кабины</w> крана оператору открывался отличный вид на всю строительную площадку.",
                                "zh": "从起重机的<w>驾驶室</w>里，操作员可以清楚地看到整个施工现场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "driver's compartment"
                    ],
                    "common_phrases": [
                        "truck cab",
                        "crane cab",
                        "locomotive cab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная передняя часть грузовика, поезда или крана, где сидит водитель или оператор.",
                        "zh": "卡车、火车或起重机等车辆中供驾驶员或操作员坐的独立前部空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабина",
                                "target_lang_sense_clarification": "транспортного средства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驾驶室",
                                "target_lang_sense_clarification": "车辆的操作空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e0a3158-f65f-330f-955c-dc6e3d2f64ae",
                    "sense_definition": "An informal short name for Cabernet Sauvignon wine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vineyard is famous for producing a very bold and oaky <w>Cab</w>.",
                            "target_lang_translations": {
                                "ru": "Этот виноградник славится производством очень насыщенного <w>каберне</w> с дубовыми нотками.",
                                "zh": "这家酒庄以生产口感浓郁、带有橡木味的<w>赤霞珠</w>而闻名。"
                            }
                        },
                        {
                            "text": "Would you prefer a glass of Merlot or a <w>Cab</w> with your steak?",
                            "target_lang_translations": {
                                "ru": "Вы бы предпочли бокал мерло или <w>каберне</w> к стейку?",
                                "zh": "你的牛排想配一杯梅洛还是<w>赤霞珠</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass of Cab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used by wine enthusiasts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное сокращенное название вина сорта Каберне-совиньон.",
                        "zh": "赤霞珠葡萄酒的非正式简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каберне",
                                "target_lang_sense_clarification": "сорт вина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赤霞珠",
                                "target_lang_sense_clarification": "葡萄酒品种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d5cd72e-012f-3f51-8438-e2427f74df98",
                    "sense_definition": "A horse-drawn carriage used as a public vehicle for hire.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the Victorian era, the hansom <w>cab</w> was a common sight on the streets of London.",
                            "target_lang_translations": {
                                "ru": "В викторианскую эпоху двухколесный <w>кэб</w> был привычным зрелищем на улицах Лондона.",
                                "zh": "在维多利亚时代，双轮<w>马车</w>是伦敦街头常见的景象。"
                            }
                        },
                        {
                            "text": "The sound of the <w>cab</w> horses' hooves echoed through the foggy alleyway.",
                            "target_lang_translations": {
                                "ru": "Стук копыт лошадей, запряженных в <w>экипаж</w>, эхом разносился по туманному переулку.",
                                "zh": "<w>马车</w>的马蹄声在雾气弥漫的小巷中回荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "taxi"
                    ],
                    "common_phrases": [
                        "hansom cab"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конный экипаж, используемый как общественный транспорт для найма.",
                        "zh": "一种用作公共出租交通工具的马车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кэб",
                                "target_lang_sense_clarification": "наемный экипаж"
                            },
                            {
                                "target_lang_word": "извозчик",
                                "target_lang_sense_clarification": "экипаж с кучером"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马车",
                                "target_lang_sense_clarification": "旧式交通工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2d64472-524d-304e-8bed-2276b485dbee",
                    "sense_definition": "The wooden or metal housing for a stand-up arcade video game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the weekend restoring an old arcade <w>cab</w> he found at a garage sale.",
                            "target_lang_translations": {
                                "ru": "Он провел выходные, восстанавливая старый <w>корпус</w> аркадного автомата, который нашел на гаражной распродаже.",
                                "zh": "他花了一个周末修复在旧货摊上淘到的旧街机<w>机箱</w>。"
                            }
                        },
                        {
                            "text": "The classic Pac-Man <w>cab</w> was the centerpiece of his retro gaming collection.",
                            "target_lang_translations": {
                                "ru": "Классический <w>автомат</w> Pac-Man был центральным экспонатом его коллекции ретро-игр.",
                                "zh": "那台经典的吃豆人街机<w>机箱</w>是他复古游戏收藏中的核心展品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arcade cab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used by arcade collectors"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянный или металлический корпус для вертикального игрового автомата.",
                        "zh": "立式街机游戏机的木制或金属外壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпус",
                                "target_lang_sense_clarification": "игрового автомата"
                            },
                            {
                                "target_lang_word": "кабинет",
                                "target_lang_sense_clarification": "аркадного автомата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机箱",
                                "target_lang_sense_clarification": "街机外壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c1b29cc-f456-3bca-95c2-61da37936970",
                    "sense_definition": "An ancient Hebrew unit of measurement for dry or liquid goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biblical text mentions the price of a <w>cab</w> of seed during the great famine.",
                            "target_lang_translations": {
                                "ru": "В библейском тексте упоминается цена за <w>кав</w> семян во время великого голода.",
                                "zh": "圣经文本中提到了大饥荒期间一<w>卡夫</w>种子的价格。"
                            }
                        },
                        {
                            "text": "Scholars estimate that one <w>cab</w> was roughly equivalent to over one liter.",
                            "target_lang_translations": {
                                "ru": "Ученые подсчитали, что один <w>кав</w> был примерно равен чуть более чем одному литру.",
                                "zh": "学者们估计一<w>卡夫</w>大约相当于一升多。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "ancient measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древнееврейская единица измерения сыпучих или жидких продуктов.",
                        "zh": "古代希伯来人用于测量干货或液体的容量单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кав",
                                "target_lang_sense_clarification": "мера объема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡夫",
                                "target_lang_sense_clarification": "古代容量单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b68dc6b1-5558-3b25-bcc8-7265d4b7dbaf",
                    "sense_definition": "To travel or be transported using a taxi.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of walking in the rain, we decided to <w>cab</w> it to the restaurant.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы идти под дождем, мы решили <w>доехать на такси</w> до ресторана.",
                                "zh": "我们不想在雨中走路，于是决定<w>打车</w>去餐厅。"
                            }
                        },
                        {
                            "text": "He has been <w>cabbing</w> to work every day since his car broke down.",
                            "target_lang_translations": {
                                "ru": "Он <w>ездит на такси</w> на работу каждый день с тех пор, как сломалась его машина.",
                                "zh": "自从车坏了以后，他每天都<w>打车</w>上班。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cab it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или перемещаться на такси.",
                        "zh": "乘坐出租车出行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на такси",
                                "target_lang_sense_clarification": "способ передвижения"
                            },
                            {
                                "target_lang_word": "взять такси",
                                "target_lang_sense_clarification": "воспользоваться услугой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打车",
                                "target_lang_sense_clarification": "乘坐出租车"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b5cc13ed-0745-3dfc-b7f6-2d1c9922ecba",
                    "sense_definition": "A UK organization that offers free, confidential advice on legal and financial problems.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organizations",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "If you are having trouble with your landlord, you should visit the local <w>CAB</w>.",
                            "target_lang_translations": {
                                "ru": "Если у вас возникли проблемы с арендодателем, вам следует обратиться в местное <w>Бюро консультаций</w>.",
                                "zh": "如果你和房东之间有纠纷，你应该去当地的<w>公民咨询局</w>。"
                            }
                        },
                        {
                            "text": "The <w>CAB</w> provides essential support for people struggling with debt.",
                            "target_lang_translations": {
                                "ru": "<w>CAB</w> оказывает существенную поддержку людям, столкнувшимся с долгами.",
                                "zh": "<w>公民咨询局</w>为那些深陷债务困境的人们提供必要的支持。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Британская организация, предлагающая бесплатные консультации по юридическим и финансовым вопросам.",
                        "zh": "英国的一个组织，为法律和财务问题提供免费、保密的咨询。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бюро консультаций для граждан",
                                "target_lang_sense_clarification": "организация в Великобритании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公民咨询局",
                                "target_lang_sense_clarification": "英国咨询机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9024163a-392c-31de-a09f-6791d70dbc89",
                    "sense_definition": "A former US federal agency that regulated aviation services.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organizations",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>CAB</w> was abolished in 1985 as part of the deregulation of the airline industry.",
                            "target_lang_translations": {
                                "ru": "<w>Совет по гражданской авиации</w> был упразднен в 1985 году в рамках дерегулирования авиационной отрасли.",
                                "zh": "作为航空业放松管制的一部分，<w>民用航空委员会</w>于1985年被撤销。"
                            }
                        },
                        {
                            "text": "Historical records show how the <w>CAB</w> controlled ticket prices for decades.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают, как <w>CAB</w> десятилетиями контролировал цены на билеты.",
                                "zh": "历史记录显示<w>民用航空委员会</w>是如何在几十年里控制机票价格的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшее федеральное агентство США, регулировавшее авиационные услуги.",
                        "zh": "美国曾负责监管航空服务的前联邦机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Совет по гражданской авиации",
                                "target_lang_sense_clarification": "историческое ведомство США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民用航空委员会",
                                "target_lang_sense_clarification": "美国历史机构"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}