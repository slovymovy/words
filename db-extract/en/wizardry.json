                    },
                    {
                        "translation_id": "5f548e3c-4a5f-4b96-8b6a-fe5af4d2c393",
                        "source_entry_id": "8da3ac2b-abc3-3c18-93bf-540d36fcdd3d",
                        "source_sense_description": "art of a wizard; sorcery",
                        "target_lang_word": "Zauberei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zauberei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94229fea-99ea-3be0-a34d-2ae259b9d4bc",
                                        "entry_id": "19681a6c-89cd-3364-9fa9-0055a53532c3",
                                        "glosses": [
                                            "Kunst/Fähigkeit des Zauberns"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f33acbb-01d3-491a-81bf-982c3f38833a",
                                                "sense_id": "94229fea-99ea-3be0-a34d-2ae259b9d4bc",
                                                "text": "Der Begriff Zauberei wird in der Völkerkunde und der Religionswissenschaft zur Bezeichnung von magischen Handlungen und Praktiken verwendet. (aus der Wikipedia)"
                                            },
                                            {
                                                "example_id": "98866c24-2770-4e45-b00f-f23109c9386c",
                                                "sense_id": "94229fea-99ea-3be0-a34d-2ae259b9d4bc",
                                                "text": "„Der Glaube an Magie und Zauberei ist in Afrika lebendig und verbreitet.“"
                                            },
                                            {
                                                "example_id": "36232846-bc08-4250-ab12-37998e4c84f4",
                                                "sense_id": "94229fea-99ea-3be0-a34d-2ae259b9d4bc",
                                                "text": "„Der größte Zauberkünstler wäre der, der sich auch selbst so weit verzaubern könnte, daß seine Zaubereien ihm als selbständige Erscheinungen vorkämen, hat Fichte gemeint, und es trifft auf Hoffmann mehr als auf irgend jemanden zu.“"
                                            },
                                            {
                                                "example_id": "03a09364-565c-4e70-9703-757efb55e2ae",
                                                "sense_id": "94229fea-99ea-3be0-a34d-2ae259b9d4bc",
                                                "text": "„Ihre Toten hätten sie gekocht und getrocknet, das Fleisch und die Knochen zu Pulver zerrieben, um eine sogenanntes Leichenpulver für Zauberei herzustellen.“"
                                            },
                                            {
                                                "example_id": "20097fe6-a073-4c91-8841-5116b7ba0e00",
                                                "sense_id": "94229fea-99ea-3be0-a34d-2ae259b9d4bc",
                                                "text": "„Bei der Zauberei, die ihn das Leben kostete, könnte es sich um Goldmacherei gehandelt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a196aa0-3f03-3ce5-9add-caf06bc26c69",
                                        "entry_id": "19681a6c-89cd-3364-9fa9-0055a53532c3",
                                        "glosses": [
                                            "Zauberkunststück"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
