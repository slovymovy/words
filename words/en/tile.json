                {
                    "sense_id": "350c7778-6ecf-3e02-a49f-9ca1dea76def",
                    "sense_definition": "A small flat piece used in board games like Scrabble, Mahjong, or Dominoes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "game_piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each player draws seven <w>tiles</w> from the bag at the start of the game.",
                            "target_lang_translations": {
                                "ru": "Каждый игрок тянет семь <w>фишек</w> из мешка в начале игры.",
                                "tr": "Oyunun başında her oyuncu torbadan yedi <w>taş</w> çeker.",
                                "zh": "游戏开始时，每位玩家从袋子里摸七张<w>牌</w>。",
                                "es": "Cada jugador toma siete <w>fichas</w> de la bolsa al comienzo del juego."
                            }
                        },
                        {
                            "text": "He placed a <w>tile</w> on the board to complete the word.",
                            "target_lang_translations": {
                                "ru": "Он положил <w>фишку</w> на доску, чтобы закончить слово.",
                                "tr": "Kelimeyi tamamlamak için tahtaya bir <w>taş</w> koydu.",
                                "zh": "他放下一块<w>字母块</w>在棋盘上，拼成了那个单词。",
                                "es": "Él colocó una <w>ficha</w> en el tablero para completar la palabra."
                            }
                        }
                    ],
                    "synonyms": [
                        "piece"
                    ],
                    "common_phrases": [
                        "letter tiles",
                        "mahjong tiles",
                        "domino tiles"
