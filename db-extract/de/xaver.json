                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042f1d3a-60e0-4923-8a9a-393a0014e6d8",
                                "sense_id": "9295be88-9392-3252-9d3f-4c1f9de13142",
                                "text": "Xaver ließ gestern wieder lange auf sich warten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3df5c8c8-6d06-448b-bae2-2b198d3b927b",
                        "source_entry_id": "64005679-ccfa-362e-b85a-4a731109c155",
                        "source_sense_id": "9295be88-9392-3252-9d3f-4c1f9de13142",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Xavier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xavier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc21b345-3602-3f68-bc29-947d05369855",
                                        "entry_id": "765e4eec-664b-351a-ac76-efaef644b693",
                                        "glosses": [
                                            "A male given name from Spanish [in turn from Basque]."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7c3f14-5c0e-4e9f-bb9f-2f49f5891122",
                                                "sense_id": "cc21b345-3602-3f68-bc29-947d05369855",
                                                "text": "\"Full name please.\" \"Maurice Xavier Wu.\" \"Where did you get the Xavier?\" \"My father was a missionary,\" he said."
                                            },
                                            {
                                                "example_id": "16f32e1d-5f29-471a-be02-b8cbe3394351",
                                                "sense_id": "cc21b345-3602-3f68-bc29-947d05369855",
                                                "text": "'I keep telling you to call me Xavier,' he interjected silkily, aware that her reluctance to do so intrigued him. 'Xavier,' Laura agreed, and then hesitated. How could his name be so...so...enticing? Because it was foreign to her lips―lingering there like the juice of a fruit she had never tasted before? Or because it was impossible to say without first softening your voice?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1351d45d-4fde-3543-8862-eb47d9bee48b",
                                        "entry_id": "765e4eec-664b-351a-ac76-efaef644b693",
                                        "glosses": [
                                            "A surname from Spanish [in turn from Basque], found chiefly among people of Spanish and Portuguese descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1259128-a99f-4bb6-860a-c503ded59a1e",
                                                "sense_id": "1351d45d-4fde-3543-8862-eb47d9bee48b",
                                                "text": "A plaque commemorating the memory of British Rail guard Asquith Xavier, who broke the colour bar at Euston station in 1966, was unveiled at Chatham station on September 24."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e31121-22b9-30e6-9b8b-0d430b397e11",
                                        "entry_id": "765e4eec-664b-351a-ac76-efaef644b693",
                                        "glosses": [
                                            "Any of various notable people with this name as given name or surname, especially Saint Francis Xavier, a Spanish Catholic saint and missionary (1506–1552)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
