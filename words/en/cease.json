                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain finally <w>ceased</w> later in the afternoon.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь, наконец, <w>прекратился</w> ближе к вечеру.",
                                "nl": "De zware regen <w>hield</w> later in de middag eindelijk <w>op</w>.",
                                "pl": "Silny deszcz w końcu <w>ustał</w> późnym popołudniem.",
                                "de": "Der starke Regen <w>hörte</w> später am Nachmittag endlich <w>auf</w>.",
                                "fr": "La forte pluie a finalement <w>cessé</w> plus tard dans l'après-midi.",
                                "it": "La forte pioggia è finalmente <w>cessata</w> nel tardo pomeriggio.",
                                "cs": "Silný déšť později odpoledne konečně <w>přestal</w>.",
                                "tr": "Şiddetli yağmur öğleden sonra nihayet <w>durdu</w>.",
                                "es": "La fuerte lluvia finalmente <w>cesó</w> más tarde por la tarde.",
                                "zh": "午后，大雨终于<w>停止</w>了。"
                            }
                        },
                        {
                            "text": "The loud noise from the construction site <w>ceased</w> abruptly.",
                            "target_lang_translations": {
                                "ru": "Громкий шум со стройки внезапно <w>прекратился</w>.",
                                "nl": "Het harde lawaai van de bouwplaats <w>hield</w> abrupt <w>op</w>.",
                                "pl": "Głośny hałas z placu budowy nagle <w>ustał</w>.",
                                "de": "Der laute Lärm von der Baustelle <w>hörte</w> abrupt <w>auf</w>.",
                                "fr": "Le bruit assourdissant venant du chantier a <w>cessé</w> brusquement.",
                                "it": "Il forte rumore proveniente dal cantiere è <w>cessato</w> bruscamente.",
                                "cs": "Hlasitý hluk ze staveniště náhle <w>ustal</w>.",
                                "tr": "Şantiyeden gelen yüksek ses aniden <w>durdu</w>.",
                                "es": "El fuerte ruido de la obra <w>paró</w> abruptamente.",
                                "zh": "工地传来的巨大噪音突然<w>停止</w>了。"
                            }
                        }
                    ],
