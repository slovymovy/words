                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43c5d82-1b8d-4aea-a025-38a417ccc077",
                                "sense_id": "1d8f8da9-7778-3914-8c8f-7123ba52bc5b",
                                "text": "Hij had toeristen opgehaald van het vliegveld op het eiland Baltra die naar een veerboot gebracht moesten worden. De chauffeur zag te laat dat de zogeheten duivelskop op de weg liep. De landleguaan, die ruim een meter lang kan worden, is een beschermde diersoort."
                            }
                        ]
