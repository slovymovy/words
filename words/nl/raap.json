                    "sense_id": "5c44b99b-0176-3d18-9309-b7bc27c47ce1",
                    "sense_definition": "eetbare wortelknol van de plant Brassica rapa, gebruikt als groente",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "groente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor deze traditionele stoofpot heb je wortels en een witte <w>raap</w> nodig.",
                            "target_lang_translations": {
                                "en": "For this traditional stew, you need carrots and a white <w>turnip</w>."
                            }
                        },
                        {
                            "text": "In de biologische tuin oogsten we in het najaar verse <w>rapen</w> van het veld.",
                            "target_lang_translations": {
                                "en": "In the organic garden, we harvest fresh <w>turnips</w> from the field in the autumn."
                            }
                        }
                    ],
                    "synonyms": [
                        "meiraap",
                        "knolraap"
                    ],
                    "common_phrases": [
                        "gestoofde raap"
                    ],
                    "target_lang_definitions": {
                        "en": "edible root tuber of the plant Brassica rapa, used as a vegetable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turnip",
                                "target_lang_sense_clarification": "root vegetable"
                            },
                            {
                                "target_lang_word": "white turnip",
                                "target_lang_sense_clarification": "variety of turnip"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee233454-9a49-3145-ae1f-960b9e6ac65d",
                    "sense_definition": "het menselijk hoofd of gezicht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overvallers schoten de weerloze kassamedewerker recht voor zijn <w>raap</w>.",
                            "target_lang_translations": {
                                "en": "The robbers shot the defenseless cashier straight in the <w>face</w>."
                            }
                        },
                        {
                            "text": "Hij kreeg tijdens de vechtpartij een harde stomp op zijn <w>raap</w>.",
                            "target_lang_translations": {
                                "en": "He got a hard punch to the <w>head</w> during the fight."
                            }
                        }
                    ],
                    "synonyms": [
                        "kop",
                        "hoofd",
                        "smoel"
                    ],
                    "common_phrases": [
