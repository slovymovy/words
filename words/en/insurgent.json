{
    "word_family": [
        "insurgence",
        "insurgency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9aaf4661-2492-352d-80a2-9e73ca3bb4dc",
                    "sense_definition": "A person who takes up arms and fights against an established government or authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Government forces clashed with armed <w>insurgents</w> in the mountainous border region.",
                            "target_lang_translations": {
                                "ru": "Правительственные силы столкнулись с вооружёнными <w>повстанцами</w> в гористом приграничном районе."
                            }
                        },
                        {
                            "text": "The <w>insurgent</w> was captured while attempting to cross the checkpoint.",
                            "target_lang_translations": {
                                "ru": "<w>Мятежник</w> был схвачен при попытке пересечь контрольно-пропускной пункт."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebel",
                        "guerrilla"
                    ],
                    "antonyms": [
                        "loyalist"
                    ],
                    "common_phrases": [
                        "armed insurgents"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который с оружием в руках борется против действующей власти или правительства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повстанец",
                                "target_lang_sense_clarification": "участник вооруженного восстания"
                            },
                            {
                                "target_lang_word": "мятежник",
                                "target_lang_sense_clarification": "участник мятежа"
                            },
                            {
                                "target_lang_word": "бунтовщик",
                                "target_lang_sense_clarification": "участник бунта"
                            },
                            {
                                "target_lang_word": "инсургент",
                                "target_lang_sense_clarification": "книжн., участник восстания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94174f88-1aff-3b72-889b-9fb7ddbffaee",
                    "sense_definition": "Rising in active revolt or rebellion against an established government or ruler.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several <w>insurgent</w> groups joined forces to overthrow the corrupt administration.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>повстанческих</w> группировок объединили усилия, чтобы свергнуть коррумпированную администрацию."
                            }
                        },
                        {
                            "text": "The military launched an offensive against <w>insurgent</w> fighters hiding in the valley.",
                            "target_lang_translations": {
                                "ru": "Военные начали наступление на укрывающихся в долине <w>мятежных</w> боевиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebellious",
                        "mutinous"
                    ],
                    "antonyms": [
                        "loyal"
                    ],
                    "common_phrases": [
                        "insurgent forces",
                        "insurgent groups"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвующий в мятеже или восстании против существующей власти или правителя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повстанческий",
                                "target_lang_sense_clarification": "относящийся к повстанцам"
                            },
                            {
                                "target_lang_word": "мятежный",
                                "target_lang_sense_clarification": "поднявший мятеж"
                            },
                            {
                                "target_lang_word": "восставший",
                                "target_lang_sense_clarification": "принявший участие в восстании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62984c03-cdd4-3ecf-bb17-f5b93b8b4409",
                    "sense_definition": "Surging or rushing inward, especially referring to waves or water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat was tossed violently by the <w>insurgent</w> tide during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма маленькую лодку яростно швыряло <w>накатывающим</w> приливом."
                            }
                        },
                        {
                            "text": "She stood on the rocks watching the <w>insurgent</w> waters crash against the cliff face.",
                            "target_lang_translations": {
                                "ru": "Она стояла на скалах, наблюдая, как <w>бушующие</w> воды разбиваются об утес."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and archaic use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набегающий, бурно накатывающийся (о волнах, приливе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набегающий",
                                "target_lang_sense_clarification": "о волнах, приливе"
                            },
                            {
                                "target_lang_word": "накатывающий",
                                "target_lang_sense_clarification": "о набегающей воде"
                            },
                            {
                                "target_lang_word": "разбушевавшийся",
                                "target_lang_sense_clarification": "о бурных волнах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}