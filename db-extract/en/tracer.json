    "word": "tracer",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                "word": "tracer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "995fd48d-20cf-49eb-8d6f-78aafac6de5c",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "tags": [
                            "plural"
                        ],
                        "form": "tracers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e52c53db-846f-329b-ac40-da984de67872",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "A compound, element, or isotope used to track the progress or history of a natural process."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9763921f-3a30-32b9-b8f7-4644d463ef11",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "A round of ammunition for a firearm that contains magnesium or another flammable substance arranged such that it will burn and produce a visible trail when fired in the dark."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a452289f-827e-3da5-92f0-75e648fe4b20",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "The act or state of tracking or investigating something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94a67bd-8a73-4b7b-a68d-e4686c940cf7",
                                "sense_id": "a452289f-827e-3da5-92f0-75e648fe4b20",
                                "text": "We have a five-man tracer on him now. He's heading for a Vorster cell on Michigan Boulevard, and he's drunk as a lord. Should we intercept him?"
                            },
                            {
                                "example_id": "7dbb5074-c54e-4eff-a48b-12d7198c881d",
                                "sense_id": "a452289f-827e-3da5-92f0-75e648fe4b20",
                                "text": "A surveyor typically conducts a tracer on his or her own and later meets up with the rest of the team to discuss findings."
                            },
                            {
                                "example_id": "73d43585-b9a0-4c3b-a05f-3d207ac351b6",
                                "sense_id": "a452289f-827e-3da5-92f0-75e648fe4b20",
                                "text": "Ain't never running but I'm a paper chasing\nThey gon catch up to me, they gon need a pacer\nHow they over-watching me without a tracer"
                            }
                        ]
                    },
                    {
                        "sense_id": "4cfb9977-0fa7-30a8-9a09-34bb218457fa",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "A request to trace the movements of a person or an object, such as a shipment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec63b60-9ee0-42ff-8bc7-6940426beb2d",
                                "sense_id": "4cfb9977-0fa7-30a8-9a09-34bb218457fa",
                                "text": "The next morning when she awoke, she told Darcy what had happened, and Darcy agreed that she should go to the police and this time ask them if they could put a tracer on her incoming phone calls, just in case he called again."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf6b4c11-b1ca-3ed5-8b0d-3f5aeaccb1a1",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "A person who traces something."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b97d6ac5-3275-3e49-8366-9e3d1f3ea5de",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "A device or instrument used to assist in making tracings."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eac91a43-f1a9-3229-b930-29a7857dc1ed",
                        "entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "glosses": [
                            "A process that traces something, such as the path of execution of a program during debugging."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5263650-2ff8-40f1-a17f-a7fbe74968d9",
                        "source_entry_id": "d4afe801-0709-3019-9328-0b41621a3847",
                        "source_sense_description": "A chemical used to track the progress or history of a natural process",
                        "target_lang_word": "marqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf365c0-2e62-3968-9a9f-a668b986d884",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Celui qui marque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cab6a58-370a-4634-882f-73368ca75333",
                                                "sense_id": "9bf365c0-2e62-3968-9a9f-a668b986d884",
                                                "text": "Un marqueur de cuirs, de moutons."
                                            },
                                            {
                                                "example_id": "667952cb-7e8b-47d9-88bd-8911f6a8698d",
                                                "sense_id": "9bf365c0-2e62-3968-9a9f-a668b986d884",
                                                "text": "Une marqueuse de draps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b629abc7-26ea-31dd-b248-1b442059535c",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Personne qui marque et compte les points de chaque joueur."
                                        ],
                                        "tags": [
                                            "Jeu de paume"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9809d62-44e6-36e8-a724-6ff247dc7454",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Jeton servant à garder la marque des points."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e0ba7ed-6dc9-36ed-8434-5567d943088f",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Au paintball, élément mécanique ou électronique ayant l’aspect d’une arme à feu individuelle servant à propulser les billes grâce au gaz (CO₂ ou air comprimé) contenu dans une bouteille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8f92e66-3469-3e17-b700-071f8550e19c",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Stylo-feutre permettant principalement une grande taille d’écriture ou le surlignage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01124933-76c2-48ad-8f7f-7657277a5b3b",
                                                "sense_id": "a8f92e66-3469-3e17-b700-071f8550e19c",
                                                "text": "J'ai pris mes livres à colorier, mes livres à raconter, mes feuilles à dessiner, tous mes crayons, toutes mes gommes, tous mes taille-crayons, tous mes marqueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5626cee1-47c3-380c-88aa-a0c93265973c",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Élément caractéristique qui confirme ou infirme une hypothèse lors d'un test ou d’une analyse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d45a9d2-51f3-4e0e-810a-b455b57958cf",
                                                "sense_id": "5626cee1-47c3-380c-88aa-a0c93265973c",
                                                "text": "Actuellement, quand le premier test par marqueurs sériques révèle un risque important d’anomalie fœtale, on propose à la future mère une amniocentèse…"
                                            },
                                            {
                                                "example_id": "55c2fd7b-376a-4f40-947d-6a06b329c2f1",
                                                "sense_id": "5626cee1-47c3-380c-88aa-a0c93265973c",
                                                "text": "Une équipe de chercheurs a découvert un marqueur sanguin susceptible de déterminer la sévérité de la cirrhose et de prévoir son évolution à six mois."
                                            },
                                            {
                                                "example_id": "6a8cc456-cdbf-4bec-916f-68f67b6b5da2",
                                                "sense_id": "5626cee1-47c3-380c-88aa-a0c93265973c",
                                                "text": "Le dextran est inerte et, à cause de sa taille, ne peut diffuser d’une cellule à l’autre, ce qui permet à cette substance de remplir deux des conditions d’un bon marqueur cellulaire, la spécificité et l’innocuité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e24cc97-1463-3e16-9bf9-f1ba36f71d24",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Morphème ou construction qui indique une fonction grammaticale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5350de2-f23a-4e24-9f8e-3b7554d1e307",
                                                "sense_id": "5e24cc97-1463-3e16-9bf9-f1ba36f71d24",
                                                "text": "En anglais, -s est marqueur de pluriel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9fa997d-f564-3402-a448-50924d39c4b4",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Objet qui laisse une trace d’un événement passé."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4fcdd22-bbe3-4787-a775-649770bfe1ff",
                                                "sense_id": "e9fa997d-f564-3402-a448-50924d39c4b4",
                                                "text": "[Les cimetières] Les fonctions de souvenir individuel s’estompant, ils restent de formidables marqueurs de l’histoire, de la présence de ceux qui nous ont précédés, de nos racines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a39d244a-bce9-37c8-bc3d-bbc6c573da01",
                                        "entry_id": "35d9f046-d333-3c0e-b87d-74b41a7db93f",
                                        "glosses": [
                                            "Élément caractéristique."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14875782-1dc7-4090-bed6-4502468f9a28",
                                                "sense_id": "a39d244a-bce9-37c8-bc3d-bbc6c573da01",
                                                "text": "Si l’usage du mot « terrorisme » provoque une controverse sémantique, c’est aussi parce que son emploi est devenu un marqueur de l’importance de l’événement."
                                            },
                                            {
                                                "example_id": "c6bd4e24-5b36-43b4-852b-349bf72d0554",
                                                "sense_id": "a39d244a-bce9-37c8-bc3d-bbc6c573da01",
                                                "text": "Maîtriser les tournures syntaxiques et les marqueurs discursifs a plus d’impact dans un concours oral que de contrôler sa prononciation. Sans compter que cela a un coût cognitif exorbitant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
