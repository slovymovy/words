                            {
                                "example_id": "fb7bcdcd-7e3b-4c78-91f7-9cc9e1887b24",
                                "sense_id": "8c6c445d-4f54-389b-b50d-6970af839227",
                                "text": "Doorborduren op Möllnkempke: Liefst 53.250 kruisjes, 106.000 steken, 75 verschillende kleuren aan garen en meer dan 500 uur werk. Rikie Oltwater (72) uit Eibergen heeft er wat voor over gehad om een replica te maken van de wereldberoemde tekening De Boerenbruiloft van de West-Friese illustrator Coen van Hunnik."
                            }
                        ]
