                "senses": [
                    {
                        "sense_id": "487db1c6-2db4-3942-8732-3aa20a292adb",
                        "entry_id": "30dac6ec-7cbc-3dc6-a36e-8693a4ce91fb",
                        "glosses": [
                            "m.n. van kleding dat ze op maat gemaakt is en geregen is zodat men kan kijken of de maten goed zijn indien dat het geval is kan het later afgemaakt worden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5a8669b3-0b09-3033-8caa-407d683fc77f",
                        "entry_id": "30dac6ec-7cbc-3dc6-a36e-8693a4ce91fb",
                        "glosses": [
                            "iets wat helemaal af is en dus direct gebruikt kan worden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe84288-2863-4901-91ec-3d2f5a3eeb3e",
                                "sense_id": "5a8669b3-0b09-3033-8caa-407d683fc77f",
                                "text": "Sinds de jaren '70 zijn er meer en hevigere orkanen in het Atlantisch bassin. Of dat effectief komt door de klimaatopwarming is niet zeker. 'Daar is geen pasklaar antwoord voor', zegt Dehenauw."
                            },
                            {
                                "example_id": "019220f0-e0c9-4544-8eb3-bfc0d55d6f7a",
                                "sense_id": "5a8669b3-0b09-3033-8caa-407d683fc77f",
                                "text": "Een pasklaar antwoord op haar vraag is er natuurlijk niet, noch een exacte leeftijd vanaf wanneer samen douchen met je kind niet meer oké is. Wel zijn er een paar signalen waar je rekening mee kan houden als ouder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8623957-62a6-46d8-8194-8938811bef54",
                        "source_entry_id": "30dac6ec-7cbc-3dc6-a36e-8693a4ce91fb",
                        "source_sense_id": "5a8669b3-0b09-3033-8caa-407d683fc77f",
                        "source_sense_description": "iets wat helemaal af is en dus direct gebruikt kan worden",
                        "target_lang_word": "cut and dried",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut and dried",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1793ebe-7b96-3898-8392-21befcf0298c",
                                        "entry_id": "0431fadf-7001-3338-8055-6d7ac992d454",
                                        "glosses": [
                                            "Simple, straightforward, clear, or certain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b62f65-422f-4a7c-8b78-c982c195f855",
                                                "sense_id": "b1793ebe-7b96-3898-8392-21befcf0298c",
                                                "text": "Take care when guessing, since problems do not always have cut-and-dried answers."
                                            },
                                            {
                                                "example_id": "915dba96-7cb7-446c-ab3e-842a02e49688",
                                                "sense_id": "b1793ebe-7b96-3898-8392-21befcf0298c",
                                                "text": "But if I had not taken things for granted, if I had examined everything with the care which I should have shown had we approached the case de novo and had no cut-and-dried story to warp my mind, should I not then have found something more definite to go upon?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704e5b7a-11d8-334b-a59e-7af16e6d36d1",
                                        "entry_id": "0431fadf-7001-3338-8055-6d7ac992d454",
                                        "glosses": [
                                            "Decided, not open to change."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "378d2f3b-51d6-4a87-b744-1dfdb8eebd1b",
                                                "sense_id": "704e5b7a-11d8-334b-a59e-7af16e6d36d1",
                                                "text": "Willy: […] In those days there was personality in it. There was respect, and comradeship, and gratitude in it. Today, it's all cut and dried, and there's no chance for bringing friendship to bear—or personality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b289691c-0254-353a-a961-62683d85262a",
                                        "entry_id": "0431fadf-7001-3338-8055-6d7ac992d454",
                                        "glosses": [
                                            "Lacking freshness or spontaneity."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
