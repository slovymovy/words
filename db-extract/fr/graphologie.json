                "senses": [
                    {
                        "sense_id": "cc54ae02-a0ac-30bf-baa1-13dfc2492d8f",
                        "entry_id": "2bf1fe84-2ff8-3e24-8752-0e7f54c54f6d",
                        "glosses": [
                            "Étude des rapports qui existent entre l’écriture manuscrite des gens et leur caractère ou leur état moral et physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c012d9-9ad4-40a7-8cd0-3053150a8670",
                                "sense_id": "cc54ae02-a0ac-30bf-baa1-13dfc2492d8f",
                                "text": "La graphologie est véritablement née au début du XIX^(ème) siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "072d1bba-4327-454f-8c9e-1fdcc3ac347b",
                        "source_entry_id": "2bf1fe84-2ff8-3e24-8752-0e7f54c54f6d",
                        "source_sense_id": "cc54ae02-a0ac-30bf-baa1-13dfc2492d8f",
                        "target_lang_word": "Graphologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graphologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c2d1bf-9b61-388c-8418-6e59ed4dbd2a",
                                        "entry_id": "dd9e004e-5328-3bd1-bc70-5dfa8074c21b",
                                        "glosses": [
                                            "Lehre von der Handschrift als Ausdruck des Charakters, Analyse von Handschriften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14bd137d-84e0-40f8-b41d-0e631b3473ea",
                                                "sense_id": "e5c2d1bf-9b61-388c-8418-6e59ed4dbd2a",
                                                "text": "„Graphologie ist eine echte Wissenschaft, sagt Angel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5553e843-b614-47e0-873e-e48e70b79c22",
                        "source_entry_id": "2bf1fe84-2ff8-3e24-8752-0e7f54c54f6d",
                        "source_sense_id": "cc54ae02-a0ac-30bf-baa1-13dfc2492d8f",
                        "target_lang_word": "graphology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2dc574e-b7c6-3889-83f4-bf061c988ad2",
                                        "entry_id": "6178312b-9afc-32ad-9a50-17de4e3e52d8",
                                        "glosses": [
                                            "The study of handwriting, especially as a means of analyzing a person's character."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1bd4ff-3dc9-4141-ae31-3c91fe7e2dac",
                                                "sense_id": "f2dc574e-b7c6-3889-83f4-bf061c988ad2",
                                                "text": "Graphology, or handwriting analysis, is the study and interpretation of handwriting as an indicator of personality. Professional graphologists offer four primary services: graphology classes to hobbyists, personality profiles to help individuals increase their self-knowledge and potential for change, personnel screening and consultation for employers, and questioned document examination, or forensic graphology, to identify forged handwriting and documents for legal purposes."
                                            },
                                            {
                                                "example_id": "ae18d2eb-8749-473d-9919-c52852ea55fa",
                                                "sense_id": "f2dc574e-b7c6-3889-83f4-bf061c988ad2",
                                                "text": "The philosopher Ludwig Klages saw graphology as a means to penetrate the deceptive self-presentation of his contemporaries and unveil their true character."
                                            },
                                            {
                                                "example_id": "ba92b357-c256-446a-a947-4596f4a315c5",
                                                "sense_id": "f2dc574e-b7c6-3889-83f4-bf061c988ad2",
                                                "text": "Graphology and graphological deviation are likely to be very significant in a mode that lacks non-textual social cues, such as paralanguage, prosody and gesture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629c174d-17d9-32f8-9eed-95c5320cb8a0",
                                        "entry_id": "6178312b-9afc-32ad-9a50-17de4e3e52d8",
                                        "glosses": [
                                            "A system of handwriting."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e996c24-aa4d-487c-b790-c7956bca7c5e",
                                                "sense_id": "629c174d-17d9-32f8-9eed-95c5320cb8a0",
                                                "text": "\"Talented\" children fall into one of two classes: those with an imitative ability who readily absorb the preconceived graphologies they see about them in pictures, magazines and books, and those[…]."
                                            },
                                            {
                                                "example_id": "11ebe334-7fc2-4543-94e4-da66f2975a71",
                                                "sense_id": "629c174d-17d9-32f8-9eed-95c5320cb8a0",
                                                "text": "This 1960 work, like the black works of Rauschenberg and the graphologies of Cy Twombly, is our most patient analysis of multiplicity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f24754a3-aa25-4266-9b88-e23e055dd673",
                        "source_entry_id": "2bf1fe84-2ff8-3e24-8752-0e7f54c54f6d",
