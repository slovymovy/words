{
    "word_family": [
        "storing",
        "verstoren",
        "onverstoorbaar",
        "storend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "398a5821-8dad-38f7-bc0f-fe167adfc4a1",
                    "sense_definition": "iemand lastigvallen of onderbreken in zijn bezigheden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hinderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sorry dat ik je <w>stoor</w>, maar heb je even tijd voor een korte vraag?",
                            "target_lang_translations": {
                                "en": "Sorry to <w>disturb</w> you, but do you have a moment for a quick question?"
                            }
                        },
                        {
                            "text": "De leerlingen mogen de leraar niet <w>storen</w> tijdens de uitleg van de sommen.",
                            "target_lang_translations": {
                                "en": "The students are not allowed to <w>interrupt</w> the teacher during the explanation of the sums."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinderen",
                        "derangeren"
                    ],
                    "common_phrases": [
                        "niet storen",
                        "iemand storen"
                    ],
                    "target_lang_definitions": {
                        "en": "to bother or interrupt someone in their activities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disturb",
                                "target_lang_sense_clarification": "to interrupt someone's concentration or work"
                            },
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "to annoy or interrupt someone"
                            },
                            {
                                "target_lang_word": "interrupt",
                                "target_lang_sense_clarification": "to stop someone from continuing what they are doing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "027ea146-db58-3492-8cc2-5d30bdcf2e03",
                    "sense_definition": "zich ergens aan ergeren of er hinder van ondervinden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ergeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>stoor</w> me aan het lawaai van de buren dat elke avond doorgaat.",
                            "target_lang_translations": {
                                "en": "I <w>am bothered</w> by the noise from the neighbors that goes on every night."
                            }
                        },
                        {
                            "text": "Veel mensen <w>storen</w> zich aan de rommel op straat in het centrum.",
                            "target_lang_translations": {
                                "en": "Many people <w>mind</w> the litter on the streets in the city center."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinderen"
                    ],
                    "common_phrases": [
                        "zich storen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to be annoyed by something or to experience hindrance from it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "to be annoyed or bothered by something"
                            },
                            {
                                "target_lang_word": "be bothered by",
                                "target_lang_sense_clarification": "to feel annoyed or troubled by something"
                            },
                            {
                                "target_lang_word": "object to",
                                "target_lang_sense_clarification": "to feel or express opposition or dislike"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef194855-462a-3aa4-97b9-95fd0f911f0d",
                    "sense_definition": "het normale functioneren van een proces of apparaat nadelig beïnvloeden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interferentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Slecht weer kan het signaal van de televisie ernstig <w>storen</w>.",
                            "target_lang_translations": {
                                "en": "Bad weather can seriously <w>interfere with</w> the television signal."
                            }
                        },
                        {
                            "text": "De radio-uitzendingen werden door de vijand <w>gestoord</w> om communicatie te voorkomen.",
                            "target_lang_translations": {
                                "en": "The radio broadcasts were <w>jammed</w> by the enemy to prevent communication."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinderen"
                    ],
                    "common_phrases": [
                        "het signaal storen"
                    ],
                    "target_lang_definitions": {
                        "en": "to adversely affect the normal functioning of a process or device"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interfere with",
                                "target_lang_sense_clarification": "to prevent a process or signal from continuing or working correctly"
                            },
                            {
                                "target_lang_word": "disturb",
                                "target_lang_sense_clarification": "to disrupt the normal state or flow of something"
                            },
                            {
                                "target_lang_word": "disrupt",
                                "target_lang_sense_clarification": "to cause disorder or interrupt a system"
                            },
                            {
                                "target_lang_word": "jam",
                                "target_lang_sense_clarification": "to block or interfere with a radio or electronic signal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}