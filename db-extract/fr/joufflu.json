                "senses": [
                    {
                        "sense_id": "42c30dae-eb2f-3160-b14b-505ba4307539",
                        "entry_id": "3b6d016b-b919-37c9-bbad-30b198a95cdd",
                        "glosses": [
                            "Qui a de grosses joues."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "919edf44-e0ff-4da2-9d11-85cdc05ce24a",
                                "sense_id": "42c30dae-eb2f-3160-b14b-505ba4307539",
                                "text": "Petit-Pierre paraissait plus avisé que ses frères ; mais autant ceux-ci étaient gros, joufflus et vermeils, autant il avait l’air maigre, chétif et pâlot."
                            },
                            {
                                "example_id": "d95c1ce2-5693-4bc0-9504-a5a530174564",
                                "sense_id": "42c30dae-eb2f-3160-b14b-505ba4307539",
                                "text": "Une colossale figure du « Temps », soulève Terre et cadran sur ses vigoureuses épaules, tandis que des anges joufflus, des Amours pour mieux dire, se jouent tout autour, voletant et dégringolant jusque sur le fronton."
                            },
                            {
                                "example_id": "86315fd3-7780-45a3-a99f-8036e35a211e",
                                "sense_id": "42c30dae-eb2f-3160-b14b-505ba4307539",
                                "text": "Et voici que des guirlandes de jeunes filles, fleurs rieuses dans leurs corolles couleur de ciel, couleur d'eau, couleur de feuille, essaient la cadence des rondes dont le cornemusiste joufflu guidera aigrement les temps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9658e280-4b60-4f29-bb89-e4a621aee90d",
                        "source_entry_id": "3b6d016b-b919-37c9-bbad-30b198a95cdd",
                        "source_sense_id": "42c30dae-eb2f-3160-b14b-505ba4307539",
                        "target_lang_word": "pausbäckig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pausbäckig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7dcb2a4d-878f-34fe-91da-6d96b76969e4",
                                        "entry_id": "81393c68-26bf-326a-8a71-48bfa62bd9e9",
                                        "glosses": [
                                            "Pausbacken aufweisend, über Pausbacken verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b32ee4-3db0-4722-b85f-d9fcaa431fe8",
                                                "sense_id": "7dcb2a4d-878f-34fe-91da-6d96b76969e4",
                                                "text": "Der Nachrichtensprecher wirkt irgendwie pausbäckig, seit wir den neuen Fernseher haben."
                                            },
                                            {
                                                "example_id": "59b7c34f-d2af-4c81-94c3-47d5c919e5c7",
                                                "sense_id": "7dcb2a4d-878f-34fe-91da-6d96b76969e4",
                                                "text": "„Auf ihren noch erhaltenen Fries setzten sie 62 pausbäckige Engel, die mit Geigen und Flöten, mit Pauken und Trompeten einer Art himmlischem Karneval mitten im Urwald frönten.“"
                                            },
                                            {
                                                "example_id": "1c8174bc-a518-45b1-ad49-6ab8ff337b97",
                                                "sense_id": "7dcb2a4d-878f-34fe-91da-6d96b76969e4",
                                                "text": "„Nichts war mehr übrig geblieben von dem pausbäckigen jungen Mann, der noch am Mittag während der Verkündung seines Rücktritts vom Radsport mit dem Furor des Selbstgerechten die Reporterschar in Bausch und Bogen verdammt hatte.“"
                                            },
                                            {
                                                "example_id": "56405c92-97a4-4da8-9868-fb58b7ed44d4",
                                                "sense_id": "7dcb2a4d-878f-34fe-91da-6d96b76969e4",
                                                "text": "„Er hatte einen Körper wie ein aufgedunsener Zweijähriger und war pausbäckig und rundlich und o-beinig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
