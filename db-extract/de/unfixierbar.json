                    },
                    {
                        "form_id": "7984a9ff-46ed-4d07-aa1c-ece1ace9f72a",
                        "entry_id": "f89ec865-5ad3-34f7-9698-2e5b81b44bcc",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unfixierbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a887024b-3d9d-31e5-bac0-1b6776661ae8",
                        "entry_id": "f89ec865-5ad3-34f7-9698-2e5b81b44bcc",
                        "glosses": [
                            "so, dass es nicht fixiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8b765d-4ee3-48d7-9fda-0561a4d1bf22",
                                "sense_id": "a887024b-3d9d-31e5-bac0-1b6776661ae8",
                                "text": "„Mit anderen Worten: Der ontologische Status von »witchcraft« und anderen, verwandten »paranormalen« Phänomenen ist für unser rationalistisch-naturalistisches Bewusstsein schlichtweg unfixierbar.“"
                            },
                            {
                                "example_id": "b845498d-e661-45c5-b863-dd726798f84a",
                                "sense_id": "a887024b-3d9d-31e5-bac0-1b6776661ae8",
                                "text": "„Momente der ätherischen Vereinigung von Geist und Seele mit Ihnen, unbekannt, unfixierbar, und doch durch unser ganzes Wesen widerhallend. In diesen Momenten sind Sie ohne Zweifel lebendig und uns ganz nah.“"
                            },
                            {
                                "example_id": "b72b8fdf-ac18-409a-bc58-91e27bb6a665",
                                "sense_id": "a887024b-3d9d-31e5-bac0-1b6776661ae8",
                                "text": "„Was bleibt, auf Dauer konserviert in der Erinnerung, das waren Menschen, Gesichter, Charaktere, Schicksale, Begegnungen: ein real wirkender Bildungsfaktor, aber unfixierbar und unqualifizierbar.“"
                            },
                            {
                                "example_id": "235e6a27-cd64-44f3-9189-6cc22d759b5b",
                                "sense_id": "a887024b-3d9d-31e5-bac0-1b6776661ae8",
                                "text": "„Mit dem Humor sprengt [Henri Michaux] alle Grenzen der vom Denken geforderten Ernsthaftigkeit; und durch das chronische Unterwegssein ist er immer am anderen Ort, unfixierbar, ein Sicht-Entziehender.“"
                            },
                            {
                                "example_id": "622b24a0-04b0-4b81-8fd2-ff7e7e1c3b34",
                                "sense_id": "a887024b-3d9d-31e5-bac0-1b6776661ae8",
                                "text": "„Ruhm ist grundsätzlich unkontrollierbar, unfixierbar, unverfügbar, denn Reden über Ruhm ist noch nicht Herstellung von Ruhm. Weil Ruhm ein so komplexes Konzept ist, ist er auch heute noch interessant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
