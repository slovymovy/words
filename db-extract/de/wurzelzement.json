                        "translation_id": "e6e0c490-dd21-45b0-9976-6d442b01db86",
                        "source_entry_id": "54fd201e-277a-3a2e-9597-6a8424152361",
                        "source_sense_id": "1fa9371c-5613-378f-9e9f-20a3fca957f0",
                        "source_sense_description": "die Zahnwurzel eines Zahnes bedeckende äußerste Schicht als Teil des Parodontiums",
                        "target_lang_word": "cementum",
                        "target_lang_code": "en",
