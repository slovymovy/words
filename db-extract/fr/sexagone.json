                        "form_id": "121cb49b-93d0-413a-85be-1ed4f7c8c162",
                        "entry_id": "c3f8a8f9-e2cd-3d40-9dba-56e80589a040",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "sexagones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f6097d0-475c-3286-a0cd-ade237e00695",
                        "entry_id": "c3f8a8f9-e2cd-3d40-9dba-56e80589a040",
                        "glosses": [
                            "Qui a six angles et six côtés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd9a02e-7230-4103-ac43-8be310a00806",
                                "sense_id": "6f6097d0-475c-3286-a0cd-ade237e00695",
                                "text": "La fenêtre qui donne sur le jardin, comme celle qui donne sur la cour, et toutes deux se correspondent, est croisée de pierres et à vitrages sexagones sertis en plomb, drapée de rideaux à baldaquins et à gros glands en une vieille étoffe de soie rouge à reflets jaunes, nommée jadis brocatelle ou petit brocart."
                            },
                            {
                                "example_id": "08aea98a-65a9-4b13-82c1-e8b284ff234c",
                                "sense_id": "6f6097d0-475c-3286-a0cd-ade237e00695",
                                "text": "C’est une salière sexagone, montée sur un socle creux, dans l’intérieur duquel sont trois figures debout, juxtaposées en manière d’une triple cariatide."
                            },
                            {
                                "example_id": "1c9fd6c2-e8ad-4be3-ac53-1c50e854b88a",
                                "sense_id": "6f6097d0-475c-3286-a0cd-ade237e00695",
                                "text": "Des ruines d’un grand château, dont une tour sexagone est restée debout, occupent la moitié gauche de l’estampe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "919322c7-4d35-4e6a-b21f-7fce1b7aa5ad",
                        "source_entry_id": "c3f8a8f9-e2cd-3d40-9dba-56e80589a040",
                        "source_sense_id": "6f6097d0-475c-3286-a0cd-ade237e00695",
                        "target_lang_word": "hexagonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexagonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d07f02-e81e-34b9-997c-466604876b6a",
                                        "entry_id": "67d8a086-5134-3f27-89c1-1f15510f69f2",
                                        "glosses": [
                                            "Having six edges, or having a cross-section in the form of a hexagon."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032e747b-16f8-4e12-ad79-e9c802607831",
                                                "sense_id": "c9d07f02-e81e-34b9-997c-466604876b6a",
                                                "text": "Nuts in engineering are generally hexagonal."
                                            },
                                            {
                                                "example_id": "e191dfc6-659e-4f6a-9d72-077f15237e3c",
                                                "sense_id": "c9d07f02-e81e-34b9-997c-466604876b6a",
                                                "text": "If we just plopped down a dot for every observation we’d end up with an undifferentiated black blob, so the weathergami technique visualizes frequency of temperature pairs: we divide the chart area into a fine hexagonal grid, and then color each hexagon according to how many daily observations fall within it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c11b36ff-ea7a-3f34-bb68-dcef7524de45",
                                        "entry_id": "67d8a086-5134-3f27-89c1-1f15510f69f2",
                                        "glosses": [
                                            "Having three equal axes which cross at 60° angles, and an unequal axis which crosses the others at 90° angle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
