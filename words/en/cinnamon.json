                            }
                        },
                        {
                            "text": "I enjoy the <w>cinnamon</w> flavor of these cookies during the holiday season.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>коричный</w> вкус этого печенья во время праздников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cinnamon roll",
                        "cinnamon toast",
                        "cinnamon flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий корицу или имеющий ее вкус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с корицей",
                                "target_lang_sense_clarification": "о вкусе или составе"
                            },
                            {
                                "target_lang_word": "коричный",
                                "target_lang_sense_clarification": "относящийся к корице"
                            }
                        ]
