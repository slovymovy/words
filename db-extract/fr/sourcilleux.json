                    {
                        "form_id": "02b940f3-644d-4d16-9422-2d71b07ec212",
                        "entry_id": "1d446936-d4f7-348c-a87f-ad5e1edff23b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "sourcilleuses"
