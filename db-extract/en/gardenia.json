                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e72d1eb-485f-3bd9-80db-74e8cfeb2435",
                        "entry_id": "4e126f0a-3dc0-39d3-97f8-f574c97c79e6",
                        "glosses": [
                            "Any of various tropical evergreen small trees or shrubs, of the genus Gardenia, having glossy leaves and white flowers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6e071635-17ff-36f8-a70c-8fbd1c51c67f",
                        "entry_id": "4e126f0a-3dc0-39d3-97f8-f574c97c79e6",
                        "glosses": [
                            "The flower of these plants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30df4cf3-2acc-412b-a9e0-e26dd360e009",
                                "sense_id": "6e071635-17ff-36f8-a70c-8fbd1c51c67f",
                                "text": "The aroma given off by flowers has an aphrodisiac effect, especially on women. This is so particularly in the case of lilies of the valley, gardenia, frangipani, and henna."
                            },
                            {
                                "example_id": "3a65d461-43df-479d-8d34-c83975b510e3",
                                "sense_id": "6e071635-17ff-36f8-a70c-8fbd1c51c67f",
                                "text": "Heed remembered the baby-powder smell from the bowl of gardenias, their edges browning like toast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2388faaa-5b87-4ff5-9491-2c93e936735e",
                        "source_entry_id": "4e126f0a-3dc0-39d3-97f8-f574c97c79e6",
                        "source_sense_description": "tree or shrub of the genus Gardenia",
                        "target_lang_word": "gardénie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c6eaf44d-c890-4a1d-9def-43d9b402474a",
                        "source_entry_id": "4e126f0a-3dc0-39d3-97f8-f574c97c79e6",
                        "source_sense_description": "tree or shrub of the genus Gardenia",
                        "target_lang_word": "gardénia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardénia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c999e5b-5ac3-3927-8208-ea05d13f3018",
                                        "entry_id": "424d24a5-c051-3d7b-973e-29fc4a0d2b23",
                                        "glosses": [
                                            "Arbrisseau de la famille des Rubiacées, à feuilles lancéolées, luisantes, à grandes fleurs ornementales, blanches et odorantes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                        "entry_id": "424d24a5-c051-3d7b-973e-29fc4a0d2b23",
                                        "glosses": [
                                            "Fleur de cet arbuste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b656d957-8673-4c1d-a130-2987c8e30e05",
                                                "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                                "text": "Et elle montrait dédaigneusement de son bras nu un jeune homme qui, près d’eux, une fleur de gardénia à la boutonnière, ricanait."
                                            },
                                            {
                                                "example_id": "0cba8732-6eca-41bf-9df9-7e74ce034b3d",
                                                "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                                "text": "Une certaine élégance dans sa toilette, le gardénia odorant de sa boutonnière."
                                            },
                                            {
                                                "example_id": "6b7369d2-854d-408a-85f0-6eabee480801",
                                                "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                                "text": "De son smoking, il détacha son gardénia et l’attacha au manteau de l’actrice, après avoir longuement baisé ses mains."
                                            },
                                            {
                                                "example_id": "e97f15a8-bea6-4136-9473-e238c7d22d01",
                                                "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                                "text": "Deux heures plus tard, un gentleman en smoking impeccable, la gardénia à la boutonnière, regardait d'un œil, approbateur, un groom parfaitement stylé, qui se tenait respectueusement devant lui."
                                            },
                                            {
                                                "example_id": "b09d0c7f-2dac-47d6-8188-553055998629",
                                                "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                                "text": "Le beau gardénia crémeux qui décorait sa boutonnière."
                                            },
                                            {
                                                "example_id": "676ebe0b-9136-4ba5-93dd-b20db76d6e08",
                                                "sense_id": "7d66a9c2-f762-3544-9837-d84ff5e0bf5f",
                                                "text": "Tante Gardénia s’appelait ainsi car elle était ce genre de tata absorbante que chacun possède et subit, une sorte de fleur entêtante, bavarde et carnivore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
