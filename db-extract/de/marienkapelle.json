                "senses": [
                    {
                        "sense_id": "99d13a2f-c969-348b-b7b0-8423d659ff92",
                        "entry_id": "62c927bf-9fe4-3a95-b7f2-1ee6593a67b7",
                        "glosses": [
                            "nach Maria, der Mutter von Jesus Christus, benannte Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23223c37-bd61-4d04-85c7-3a03fa4d9a6a",
                                "sense_id": "99d13a2f-c969-348b-b7b0-8423d659ff92",
                                "text": "In einer Marienkapelle finden alle Gottesdienste stets auch in Andacht an die Heilige Maria statt."
                            },
                            {
                                "example_id": "ac5783f4-08a7-413c-9402-c51f2e2307e3",
                                "sense_id": "99d13a2f-c969-348b-b7b0-8423d659ff92",
                                "text": "„Die Marienkapelle liegt an der Rheinuferstraße in Richtung Baumberg auf der dem Rhein abgewandten Seite des Deichs.“"
                            },
                            {
                                "example_id": "58d937a3-1e78-4cf1-95f8-3c19650f689e",
                                "sense_id": "99d13a2f-c969-348b-b7b0-8423d659ff92",
                                "text": "„Der Bau der Marienkapelle wurde 1377 begonnen und mit dem Turmbau gegen 1480 vollendet.“"
                            },
                            {
                                "example_id": "73dbf088-9fb0-4a83-87ff-2cf5d099a1b3",
                                "sense_id": "99d13a2f-c969-348b-b7b0-8423d659ff92",
                                "text": "„Vor fast 350 Jahren, es war im Jahre 1662, wurde die Marienkapelle auf dem Karmelenberg von Johann Lothar Waldbott von Bassenheim (1615 - 1676) und seiner zweiten Frau Anna Magdalena gestiftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
