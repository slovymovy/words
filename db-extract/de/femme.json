                "senses": [
                    {
                        "sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                        "entry_id": "35eb6696-00f8-3d1b-bca6-3f2e6fd77a69",
                        "glosses": [
                            "sich betont feminin gebende Lesbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe226529-a72b-4c38-8373-9b74bac5f452",
                                "sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                                "text": "„Eine Butch wirkt in Kleidung und Habitus maskulin, während eine Femme auf den ersten Blick den normativen Vorstellungen von Weiblichkeit folgt.“"
                            },
                            {
                                "example_id": "56d2ec15-9011-4162-9ae3-95d5ef641cbf",
                                "sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                                "text": "„Diese Unterteilung in aktive und passive Partner spiegelt sich bis heute in den Identitätskonzeptionen von Femme und Butch.“"
                            },
                            {
                                "example_id": "26dfae4b-69f8-4ddc-883d-9aa0b7837c29",
                                "sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                                "text": "„Bei der Darstellung von Lesben wird in Einzelfällen auf Klischees zurückgegriffen, was sich in einer überdurchschnittlich männlichen Darstellung und einer Rollenverteilung in Butch und Femme ausdrückt.“"
                            },
                            {
                                "example_id": "ab9ba5c7-f2be-41cc-bc8d-666b1489da43",
                                "sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                                "text": "„Walker markiert die Femme als paradigmatische Figur des Ausschlusses von einer Theorie, die die Butch aufgrund ihrer ‚besseren‘ Sichtbarkeit bevorzugt.“"
                            },
                            {
                                "example_id": "9d9f216b-20bb-4fe0-970d-86cb1aa7d03f",
                                "sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                                "text": "„Ist es aber nicht vielmehr so, dass alle Lesben Weiblichkeit begehren? Und dass das, was sie an Butches, an Femmes oder an allen anderen Frauen, die weder das eine noch das andere sind, eben die Weiblichkeit ist, die sie schätzen und anziehend finden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4edf8d45-aee6-4cf5-8a86-46f0aab0c9f4",
                        "source_entry_id": "35eb6696-00f8-3d1b-bca6-3f2e6fd77a69",
                        "source_sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                        "source_sense_description": "sich betont feminin gebende Lesbe",
                        "target_lang_word": "femme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58626136-5152-30ee-97de-d6a553e4a80f",
                                        "entry_id": "5e184457-62de-3b87-89dd-ebee5a040633",
                                        "glosses": [
                                            "A woman, a wife; (now chiefly Canada, US) a young woman or girl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff5b71a-0a70-419a-8fd6-69199b4be093",
                                                "sense_id": "58626136-5152-30ee-97de-d6a553e4a80f",
                                                "text": "Then I turned to him and said, \"O my lord, I have that to propose to thee wherein thou must not cross me; and this it is that, when we reach Baghdad, my native city, I offer thee my life as thy handmaiden in holy matrimony, and thou shalt be to me baron and I will be femme to thee.\""
                                            },
                                            {
                                                "example_id": "5a9479ea-5489-42be-9344-1934ccca62cc",
                                                "sense_id": "58626136-5152-30ee-97de-d6a553e4a80f",
                                                "text": "Theodore J. Flicker and George Kirgo have penned a good script in which Elvis is played off against four femmes […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5b7b77-0525-3dd4-abfc-ddb1f05004c7",
                                        "entry_id": "5e184457-62de-3b87-89dd-ebee5a040633",
                                        "glosses": [
                                            "A lesbian or other queer woman whose appearance, identity etc. is seen as feminine as opposed to butch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fbefc6-5497-4d14-b7f5-2859ecf79a57",
                                                "sense_id": "9f5b7b77-0525-3dd4-abfc-ddb1f05004c7",
                                                "text": "Some of the most political dykes in town had already converted, tossing out their Levi's and Birkenstocks in favor of poodle skirts and heels. It was no longer a question of butch vs. femme, liberations vs. oppression. Clothes did not unmake the woman; clothes were just clothes."
                                            },
                                            {
                                                "example_id": "c0faf19a-ba87-40c4-9bd1-4202e965b760",
                                                "sense_id": "9f5b7b77-0525-3dd4-abfc-ddb1f05004c7",
                                                "text": "Monique whispered something to a butch sitting near her. The butch crossed the room and approached our table. “Hey,” she called to me. I didn't look up. “Hey, femme, you wanna dance with a real butch?”"
                                            },
                                            {
                                                "example_id": "453c225f-0cf0-4aa9-95ee-9937d0aa94a8",
                                                "sense_id": "9f5b7b77-0525-3dd4-abfc-ddb1f05004c7",
                                                "text": "Given the myth that lesbian femmes will eventually leave their butches for men, there is an understandable unwillingness to acknowledge bisexual femmes, who really might do it — as indeed they have every right to."
                                            },
                                            {
                                                "example_id": "bf695dbb-2b68-4ad0-a116-7f0b8d2981d2",
                                                "sense_id": "9f5b7b77-0525-3dd4-abfc-ddb1f05004c7",
                                                "text": "I love butches, though. I dated a femme once. That was wrong on so many levels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbad13f3-461b-3a2e-af0e-4e8b4ba8deb9",
                                        "entry_id": "5e184457-62de-3b87-89dd-ebee5a040633",
                                        "glosses": [
                                            "A person whose gender is feminine-leaning, such as a feminine non-binary person."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6e3e09-d529-424b-a940-c3213597ec71",
                                                "sense_id": "bbad13f3-461b-3a2e-af0e-4e8b4ba8deb9",
                                                "text": "The same is true of Goddess Spirituality spaces which are predicated on Radical Feminist rhetorics about Nature and the embodied experience – even those spaces which are open to trans women and nonbinary femmes may still fall back on language about the womb …"
                                            },
                                            {
                                                "example_id": "2e724a58-c0de-432f-a39c-ead2a9dcab48",
                                                "sense_id": "bbad13f3-461b-3a2e-af0e-4e8b4ba8deb9",
                                                "text": "[…] there is no story of Black pain deeper than that of Black fat women and femmes. […]\n¹ Gender expansive for women, femmes, and nonbinary folks."
                                            },
                                            {
                                                "example_id": "b6411119-d1ab-4f23-b736-a0166e1ce4c4",
                                                "sense_id": "bbad13f3-461b-3a2e-af0e-4e8b4ba8deb9",
                                                "text": "Jordan-Zachery offers two dominant scripts that are often written onto Black women's, femmes', and girls' bodies: The Ass and Strong Black Woman scripts."
                                            },
                                            {
                                                "example_id": "a31aff11-f0c3-48a0-92ce-0e1b4b60cf35",
                                                "sense_id": "bbad13f3-461b-3a2e-af0e-4e8b4ba8deb9",
                                                "text": "[...] and any person who might partake in feminine expression (cis and trans women and men, nonbinary femmes...)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "femme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "191a62b3-7692-3f7a-a99b-a5a11ccecd36",
                                        "entry_id": "36a9b324-2738-3226-a575-a5ab05409712",
                                        "glosses": [
                                            "Pertaining to a femme; feminine, female."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53eb8391-5ee3-460c-8bbb-6f75b905a689",
                                                "sense_id": "191a62b3-7692-3f7a-a99b-a5a11ccecd36",
                                                "text": "Admittedly, Kiedis was concerned about the lack of femme rockers on the bill: the only women featured were in British band Lush, who would open each day's festivities before a few hundred curious onlookers."
                                            },
                                            {
                                                "example_id": "0c720ba2-991d-4b7e-8732-35bcdc453509",
                                                "sense_id": "191a62b3-7692-3f7a-a99b-a5a11ccecd36",
                                                "text": "High heels are something like neckties for women, in that it can be harder to look both formal and femme without them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8909156d-819c-3916-a616-c593d1abca62",
                                        "entry_id": "36a9b324-2738-3226-a575-a5ab05409712",
                                        "glosses": [
                                            "Effeminate (of a man)."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "308b5d03-d00f-3cb2-9614-cc12a027e340",
                                        "entry_id": "36a9b324-2738-3226-a575-a5ab05409712",
                                        "glosses": [
                                            "Characteristic of a feminine lesbian or queer woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d7cca4-a0e9-4d1c-9abf-311511f3f726",
                                                "sense_id": "308b5d03-d00f-3cb2-9614-cc12a027e340",
                                                "text": "Her style was more femme than butch."
                                            },
                                            {
                                                "example_id": "3f43aeb9-ae06-4f56-8c5e-f740b42df429",
                                                "sense_id": "308b5d03-d00f-3cb2-9614-cc12a027e340",
                                                "text": "\"We want to base our relationships on who we are now, not who we once were\" says radical femme bisexual Linda Moore."
                                            },
                                            {
                                                "example_id": "e5050ad8-5b0c-42c6-9249-14b0647a919d",
                                                "sense_id": "308b5d03-d00f-3cb2-9614-cc12a027e340",
                                                "text": "In comparison to butch bisexual women, it may be easier for femme bisexual women to locate male and female dating partners […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "008f05b6-c260-42e3-8e04-039eaea58acf",
                        "source_entry_id": "35eb6696-00f8-3d1b-bca6-3f2e6fd77a69",
                        "source_sense_id": "058a370c-91b3-336c-bfdf-9cbbf7545f37",
                        "source_sense_description": "sich betont feminin gebende Lesbe",
                        "target_lang_word": "fem",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ebb0f09-176d-31b5-b90a-1864e8a5ae88",
                                        "entry_id": "7826fa50-565b-3e2f-9eb6-073910b15168",
                                        "glosses": [
                                            "Relatif aux lesbiennes dont l’apparence est jugée très féminine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca9c467-9149-4f64-b9da-81eff53106d7",
                                                "sense_id": "8ebb0f09-176d-31b5-b90a-1864e8a5ae88",
                                                "text": "Les identités fems sont parfois pensées – à tort à mon sens – comme moins radicales"
                                            },
                                            {
                                                "example_id": "eeff9d3f-1082-4168-b97c-3064c7302cca",
                                                "sense_id": "8ebb0f09-176d-31b5-b90a-1864e8a5ae88",
                                                "text": "Sa propre orientation sexuelle n’est pas le sujet ici : ce qui est en jeu, c’est une représentation artistique crédible d’un type particulier de lesbienne noire qui regarde sa petite amie fem faire un striptease, l’embrasse virilement et manie les armes comme un gangster."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "699b00dc-0e4b-326c-8b14-38fa78b14a1e",
                                        "entry_id": "805179ce-79a6-3784-ad03-51331fe7c213",
                                        "glosses": [
                                            "Lesbienne adoptant les codes vestimentaires féminins."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649ea727-6112-4787-a68a-2b29b9927796",
                                                "sense_id": "699b00dc-0e4b-326c-8b14-38fa78b14a1e",
                                                "text": "Pour faire simple, une fem (prononcer « faime ») c'est une gouine qui n'a rien contre les jupes, les talons hauts, le vernis à ongles et le maquillage. Voire éventuellement en surajoute. J'ai ça en commun avec les travestis et les drag-queen de savoir qu'être une femme ça relève de la performance de théâtre au final, qu'on soit sur les planches d'un cabaret transformiste ou bien dans une salle de réunion à la Défense. […] On confond parfois les fems avec les lipstick lesbiennes, les charmantes saphiques éthérées comme on en a vu à la fin des années 90 dans les pubs Dior, Benetton et Versace. […] Les fems ont ça de différent des lipstick lesbiennes que notre féminité n'est pas un passe-droit pour s'intégrer, mais au contraire le drapeau de la subversion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
