                                "target_senses": [
                                    {
                                        "sense_id": "de7972d3-fdf9-336f-a6c8-42653b9174ac",
                                        "entry_id": "703b0f03-73c5-3de6-90be-0785ca958609",
                                        "glosses": [
                                            "Propio del águila."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a8400e-f2c7-4776-b042-9fe5ca758191",
                                                "sense_id": "de7972d3-fdf9-336f-a6c8-42653b9174ac",
                                                "text": "«Estas piedras se llaman del águila, o aquilinas, porque dicha águila las lleva a su nido para que defiendan a los pollicos, o huevos, de los animales ponzoñosos»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8f8fabe-f9eb-3691-931d-fcbeef39c935",
                                        "entry_id": "703b0f03-73c5-3de6-90be-0785ca958609",
                                        "glosses": [
                                            "Dicho de un rostro: Largo y delgado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb90d91-e024-4d8e-a666-38da73862d2a",
                                                "sense_id": "c8f8fabe-f9eb-3691-931d-fcbeef39c935",
                                                "text": "«(…) cuando de pronto, la Zapatera vio con asombro que una mano como una garra, una mano que además de oscura, y seca, y peluda, y precisamente por eso, daba miedo, aparecía en el quicio de la puerta y se apoderaba de la muñeca izquierda de Minucha, y la arrastraba hacia un destino ignoto; siguió a la mano el perfil aquilino de don Acisclo Azpilcueta, también oscuro y peludo, cuya voz ordenó a la moza que se fuera con él y que ya mandaría después a buscar sus cosas»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
