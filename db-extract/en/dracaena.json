                        "entry_id": "20d06e6d-d925-3b59-af79-e9634eedc478",
                        "glosses": [
                            "Any of the genus Dracaena of liliaceous plants with woody stems and funnel-shaped flowers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65f1973d-c2b1-4d89-97c2-424602341c06",
                                "sense_id": "857eb411-8cb5-390a-83ec-18b1d624c843",
                                "text": "“Again with this?” I groaned to the dracaenae. (“Talk to them!” numerous readers advised.) The plants chuckled and shook their heads. No they didn’t. They’re plants!"
                            }
                        ]
                    }
                ],
