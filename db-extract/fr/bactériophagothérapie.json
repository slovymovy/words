                "senses": [
                    {
                        "sense_id": "ddfc422d-ab51-30c2-9c4a-7d991808611f",
                        "entry_id": "a5df19b0-6ec5-37d7-b97f-67d0b823f02a",
                        "glosses": [
                            "Phagothérapie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936f35d6-b7b1-4f99-b8bd-a08f477092c9",
                                "sense_id": "ddfc422d-ab51-30c2-9c4a-7d991808611f",
                                "text": "Le traitement fera appel surtout à la médication alcaline et aux antiseptiques qui s'éliminent par les urines. La bactériophagothérapie, les vaccins peuvent réussir quelquefois."
                            },
                            {
                                "example_id": "1a249e4e-1b1f-47ff-b595-41107d54022e",
                                "sense_id": "ddfc422d-ab51-30c2-9c4a-7d991808611f",
                                "text": "Actuellement, la bactériophagothérapie, très limitée en médecine, est assez limitée en chirurgie."
                            },
                            {
                                "example_id": "3624abe8-f332-404b-8b5a-8fe2e5aa9aa8",
                                "sense_id": "ddfc422d-ab51-30c2-9c4a-7d991808611f",
                                "text": "L'auteur rapporte les résultats de la bactériophagothérapie dans les plaies infectées et les suppurations rebelles du cheval. Il préconise les injections sous-cutanées de bactériophage à la dose de 10 cc. […]. La bactériophagothérapie ne permet l'association d'aucun traitement antiseptique, mais elle sera toujours avantageusement complétée par l'ouverture des abcès et le débridement des fistules."
                            }
                        ]
                    }
