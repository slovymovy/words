                "senses": [
                    {
                        "sense_id": "91361cbd-dc6d-3cd9-9c19-88582b9c07b1",
                        "entry_id": "6c19f050-f7e8-352a-80be-36a88e1853ca",
                        "glosses": [
                            "der Weg, auf dem das Vieh zur Weide getrieben wurde, oder die Weide selbst"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "ae735b9a-6027-4c56-8e38-620995604284",
                                "sense_id": "91361cbd-dc6d-3cd9-9c19-88582b9c07b1",
                                "text": "Das Vieh befand sich noch auf der Trift."
                            },
                            {
                                "example_id": "b1b97bbf-f123-42df-beb9-37fd298a5e51",
                                "sense_id": "91361cbd-dc6d-3cd9-9c19-88582b9c07b1",
                                "text": "„Die unheilvollen Berge lassen wir links liegen und gehen durch das Tal der Dobrava, an wundervoll grünen Triften und sanften Hügeln entlang.“"
                            },
                            {
                                "example_id": "c3cc0f5f-ecbd-49f7-8aa8-d674db4d4498",
                                "sense_id": "91361cbd-dc6d-3cd9-9c19-88582b9c07b1",
                                "text": "„Über den Dörfern, inmitten der niedrigen, grünen Triften, zwischen den träge fließenden Gewässern des Südlandes, lastet eine drückende Schwermut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
