                                        "sense_id": "268697b5-db2f-3556-bae3-2f44bd7c5e0b",
                                        "entry_id": "7079d3ea-ed85-30c5-95c0-fcb659880fb7",
                                        "glosses": [
                                            "A person of weak or even sickly physical constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc223632-b3b1-45b3-9d4e-35cc2907ac6d",
                                                "sense_id": "268697b5-db2f-3556-bae3-2f44bd7c5e0b",
                                                "text": "“Mon Dieu!” he soliloquized, “but they are all alike. Cheating, murdering, lying, fighting, and all for things that the beasts of the jungle would not deign to possess—money to purchase the effeminate pleasures of weaklings. And yet withal bound down by silly customs that make them slaves to their unhappy lot while firm in the belief that they be the lords of creation enjoying the only real pleasures of existence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5e8f6f-373b-32f3-b244-452856097fd6",
                                        "entry_id": "7079d3ea-ed85-30c5-95c0-fcb659880fb7",
                                        "glosses": [
                                            "A person of weak character, lacking in courage and/or moral strength."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61fa03db-059e-4c1b-9da3-6544b3fc2012",
                                                "sense_id": "6a5e8f6f-373b-32f3-b244-452856097fd6",
                                                "text": "c.1551, Hugh Latimer, a sermon in Lincolnshire\nWe may not be weaklings because we have a strong enemy."
                                            },
                                            {
                                                "example_id": "b9bffd7e-4239-488f-9dc6-ac546d0df87e",
                                                "sense_id": "6a5e8f6f-373b-32f3-b244-452856097fd6",
                                                "text": "Donald Trump has lashed out against his own supporters, calling them gullible “weaklings” for questioning the transparency of a secretive government inquiry into the late high-profile socialite and sex offender Jeffrey Epstein."
                                            }
                                        ]
                                    }
                                ]
