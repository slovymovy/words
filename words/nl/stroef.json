{
    "word_family": [
        "stroefheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "17585cd5-acf0-3426-9a12-b07de9259418",
                    "sense_definition": "ruw en niet glad waardoor er veel wrijving is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oppervlaktegesteldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij ijzel is de weg niet <w>stroef</w> meer en glijden auto's makkelijk weg.",
                            "target_lang_translations": {
                                "en": "When there is black ice, the road is no longer <w>rough</w> and cars slide away easily."
                            }
                        },
                        {
                            "text": "De nieuwe vloer is nog erg <w>stroef</w> waardoor je er niet op kunt uitglijden.",
                            "target_lang_translations": {
                                "en": "The new floor is still very <w>non-slip</w>, so you cannot slip on it."
                            }
                        }
                    ],
                    "antonyms": [
                        "glad"
                    ],
                    "common_phrases": [
                        "een stroef oppervlak",
                        "stroef wegdek"
                    ],
                    "target_lang_definitions": {
                        "en": "rough and not smooth, causing a lot of friction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "of a surface, not smooth"
                            },
                            {
                                "target_lang_word": "non-slip",
                                "target_lang_sense_clarification": "providing grip to prevent sliding"
                            },
                            {
                                "target_lang_word": "coarse",
                                "target_lang_sense_clarification": "having a rough texture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdae996c-c328-365c-86b8-ee401f1dcdd8",
                    "sense_definition": "moeilijk te bewegen of te verschuiven door weerstand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude houten lade gaat erg <w>stroef</w> open.",
                            "target_lang_translations": {
                                "en": "The old wooden drawer opens very <w>stiffly</w>."
                            }
                        },
                        {
                            "text": "Door het roest loopt de ketting van de fiets een beetje <w>stroef</w>.",
                            "target_lang_translations": {
                                "en": "Because of the rust, the bicycle chain is running a bit <w>roughly</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moeizaam"
                    ],
                    "antonyms": [
                        "soepel"
                    ],
                    "common_phrases": [
                        "stroef lopen",
                        "stroef bewegen"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to move or slide due to resistance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "difficult to move or operate"
                            },
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "not running smoothly"
                            },
                            {
                                "target_lang_word": "sluggish",
                                "target_lang_sense_clarification": "moving slowly or with difficulty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19faecac-ae23-3501-8aeb-78677d12f125",
                    "sense_definition": "moeizaam of ongemakkelijk verlopend in sociaal contact of samenwerking",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sociaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een <w>stroef</w> bedankje zei hij de hele avond geen woord meer.",
                            "target_lang_translations": {
                                "en": "After a <w>stiff</w> thank you, he didn't say another word all evening."
                            }
                        },
                        {
                            "text": "De onderhandelingen tussen de twee bedrijven verliepen in het begin erg <w>stroef</w>.",
                            "target_lang_translations": {
                                "en": "The negotiations between the two companies were very <w>strained</w> at the beginning."
                            }
                        }
                    ],
                    "synonyms": [
                        "moeizaam",
                        "stijf"
                    ],
                    "antonyms": [
                        "soepel"
                    ],
                    "common_phrases": [
                        "een stroef gesprek",
                        "stroeve samenwerking"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult or awkward in social contact or cooperation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "formal and not relaxed"
                            },
                            {
                                "target_lang_word": "awkward",
                                "target_lang_sense_clarification": "socially uncomfortable"
                            },
                            {
                                "target_lang_word": "strained",
                                "target_lang_sense_clarification": "not natural or easy"
                            },
                            {
                                "target_lang_word": "clunky",
                                "target_lang_sense_clarification": "lacking smoothness in interaction"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7347a7e6-089c-3856-a2e2-2df9bdf297a4",
                    "sense_definition": "op een moeizame of niet vlotte manier",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>stroef</w> lopende wiel moet dringend gesmeerd worden.",
                            "target_lang_translations": {
                                "en": "The <w>stiffly</w> turning wheel urgently needs to be lubricated."
                            }
                        },
                        {
                            "text": "De communicatie tussen de afdelingen verloopt de laatste tijd nogal <w>stroef</w>.",
                            "target_lang_translations": {
                                "en": "Communication between the departments has been quite <w>awkward</w> lately."
                            }
                        }
                    ],
                    "synonyms": [
                        "moeizaam"
                    ],
                    "antonyms": [
                        "soepel"
                    ],
                    "common_phrases": [
                        "stroef verlopen",
                        "stroef gaan"
                    ],
                    "target_lang_definitions": {
                        "en": "in a difficult or non-fluent manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiffly",
                                "target_lang_sense_clarification": "moving with difficulty"
                            },
                            {
                                "target_lang_word": "roughly",
                                "target_lang_sense_clarification": "not proceeding smoothly"
                            },
                            {
                                "target_lang_word": "with difficulty",
                                "target_lang_sense_clarification": "not easily or fluently"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}