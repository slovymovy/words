                    {
                        "sense_id": "833acf13-8f4b-3625-83ff-f1abbf4cd4f6",
                        "entry_id": "404eef72-aea5-3a23-be99-535390d3451a",
                        "glosses": [
                            "vaas bestemd voor de as van een overledene na crematie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a69450-7c44-434d-805a-bbc53b51b381",
                                "sense_id": "833acf13-8f4b-3625-83ff-f1abbf4cd4f6",
                                "text": "Door een slepende ziekte moest Rita Nobels op 4 januari 2001 veel te vroeg afscheid nemen van haar man, de toen nog maar 47-jarige Roger De Temmerman. Zes dagen later werd de urne met zijn as bijgezet in het columbarium van begraafplaats Silsburg in Deurne."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e562ac0-9c83-3957-88dc-7ea9ee21a893",
                        "entry_id": "404eef72-aea5-3a23-be99-535390d3451a",
                        "glosses": [
                            "stembus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98afa783-8fff-4b8b-9b9f-d100a4182292",
                                "sense_id": "8e562ac0-9c83-3957-88dc-7ea9ee21a893",
                                "text": "De stemming is verplicht. Dit betekent dat elke kiezer zich op de dag van de verkiezingen naar het kieslokaal moet begeven, naar het stemhokje moet gaan en daarna zijn stembrief of magneetkaart in de urne moet stoppen."
                            }
                        ]
                    }
