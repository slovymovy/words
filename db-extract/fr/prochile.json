            {
                "entry_id": "488cdb60-95ac-3acf-a2ad-e4ff03136495",
                "word": "prochile",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93f68753-9b00-4e41-afa9-fc75125804ac",
                        "entry_id": "488cdb60-95ac-3acf-a2ad-e4ff03136495",
                        "tags": [
                            "plural"
                        ],
                        "form": "prochiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74dcde50-2da9-375f-baf7-9410e233fc5c",
                        "entry_id": "488cdb60-95ac-3acf-a2ad-e4ff03136495",
                        "glosses": [
                            "Espèce d’ours des régions forestières du sous-continent indien, de l’Himalaya au Sri Lanka, au pelage noir en dehors du museau et d’un V sur la poitrine, nettement plus clairs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be798c5-f6e7-45da-bd46-c1b0b326d683",
                                "sense_id": "74dcde50-2da9-375f-baf7-9410e233fc5c",
                                "text": "Les prochiles (melursus) sont des ours de forte taille, à tête allongée et terminée par un museau à lèvres très mobiles …."
                            },
                            {
                                "example_id": "240da099-b350-4c87-a49e-48fc8a061b4b",
                                "sense_id": "74dcde50-2da9-375f-baf7-9410e233fc5c",
                                "text": "En novembre 1903 à Paris, Herman Weedon présentait à l’Hippodrome Bostock un groupe mixte de fauves avec deux prochiles lippus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3039d96c-1e65-499f-acf8-29a57c8ef0a2",
                        "source_entry_id": "488cdb60-95ac-3acf-a2ad-e4ff03136495",
                        "source_sense_id": "74dcde50-2da9-375f-baf7-9410e233fc5c",
                        "target_lang_word": "Lippenbär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lippenbär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1a0580f-e2af-33dc-9af4-5a6eb6b4e398",
                                        "entry_id": "b440a0dc-8427-318b-bd10-3f8a6f802336",
                                        "glosses": [
                                            "in Südasien beheimatetes Raubtier mit langem Fell und beweglichen Lippen, die ausgefahren werden können, um Insekten zu fressen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d562c96-2f64-4f0b-9e56-54c2f4fd648b",
                                                "sense_id": "b1a0580f-e2af-33dc-9af4-5a6eb6b4e398",
                                                "text": "„Ein indischer Lippenbär beschützt seinen Nachwuchs vor einem deutlich größeren Bengalischen Tiger – und gewinnt gegen die Raubkatze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb369296-0cec-4473-8d28-1aeaa0d4b900",
                        "source_entry_id": "488cdb60-95ac-3acf-a2ad-e4ff03136495",
                        "source_sense_id": "74dcde50-2da9-375f-baf7-9410e233fc5c",
                        "target_lang_word": "sloth bear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloth bear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                        "entry_id": "0939d868-8688-3c42-b13b-804f654dbb84",
                                        "glosses": [
                                            "A nocturnal bear, Melursus ursinus, native to South Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc96fa4c-d96e-4cdd-a53e-e760ee8e812c",
                                                "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                                "text": "More people in India are killed by sloth bears than by tigers."
                                            },
                                            {
                                                "example_id": "63ed3428-19d6-40d6-9f3f-586a52423882",
                                                "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                                "text": "As in other species of wild bears, sloth bears are most likely to die young, especially during the first few months after they have left their mothers."
                                            },
                                            {
                                                "example_id": "260bf7f3-2a69-4c65-950d-33b7143a44f0",
                                                "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                                "text": "Sloth bear attacks are in no way a thing of the past. In recent years, Sri Lankan wildlife expert Shyamala Ratnayeke has surveyed close to three hundred of her countrymen who have encountered and, in some cases, been injured by sloth bears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
