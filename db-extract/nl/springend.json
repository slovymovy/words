                "senses": [
                    {
                        "sense_id": "5c8355e5-11ca-3f44-a3bb-b409ae580f30",
                        "entry_id": "9285afc7-2c55-3ef0-b82b-a9aaf492dc43",
                        "glosses": [
                            "los van de grond komend door te springen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8248ce-c425-494c-aadd-a64ac7fa97a2",
                                "sense_id": "5c8355e5-11ca-3f44-a3bb-b409ae580f30",
                                "text": "Naar moderne maatstaven valt er genoeg aan te merken op het camerawerk. Een aantal opnames is versneld afgespeeld en er wordt overduidelijk gefilmd in een afgesloten deel van de stad, maar de orgie van rokende banden, springende auto’s en verwrongen blik leverde de film desondanks een Oscar op voor beste montage."
                            },
                            {
                                "example_id": "df3a1dcb-9e3a-441f-bebb-793c0000b8d2",
                                "sense_id": "5c8355e5-11ca-3f44-a3bb-b409ae580f30",
                                "text": "Rondslingerend bier door de lucht, een uitzinnige menigte die compleet uit zijn plaat gaat en duizenden van links naar rechts springende mensen. Het optreden van Snollebollekes op de Waalkade was er vrijdagavond een van ongekende proporties."
                            }
                        ]
                    }
                ],
