                        "glosses": [
                            "onderdeel van een gebouw waar artiesten hun uitvoering oefenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8de3184-d265-49ac-bb89-8a778a1d4082",
                                "sense_id": "5745047e-108b-311b-bf8d-e339f65a17de",
                                "text": "De muzikanten moesten een raam of deur van de repetitieruimte open hebben gezet, want Jeans stem klonk nu luider."
                            },
                            {
                                "example_id": "08c7f851-5d99-4432-a57c-5942f56bbeec",
                                "sense_id": "5745047e-108b-311b-bf8d-e339f65a17de",
                                "text": "Vandaag repeteert het orkest voor het eerst met zijn nieuwe dirigent. In keurig Nederlands begroet de Amerikaanse Canellakis de orkestleden. Terwijl ze bladert in haar muziek knikt ze links en rechts de musici toe. Alle ogen van de ruim tachtig orkestleden zijn op haar gericht. Dan heft ze haar rechterhand en vullen de eerste tonen van Sjostakovitsj' Tiende Symfonie de repetitieruimte."
                            }
                        ]
                    }
