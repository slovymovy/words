                "senses": [
                    {
                        "sense_id": "f439ba45-f1e0-3e2c-8d43-879b91bfb187",
                        "entry_id": "4dd50c18-c52d-3792-9158-26655e1d6916",
                        "glosses": [
                            "liturgisches Kleidungsstück, das im Gottesdienst getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c6d794-16f4-4cb3-b7c3-4b802b736362",
                                "sense_id": "f439ba45-f1e0-3e2c-8d43-879b91bfb187",
                                "text": "„Kleiderbügel waren lange das Privileg von Adel und Klerus, und ein sogenannter Paramentenbügel mit aufgespanntem Liturgiegewand ist das Prunkstück in Nürnberg.“"
                            },
                            {
                                "example_id": "6f36b7ea-2cb9-4c76-b40c-2fc75d3f63e2",
                                "sense_id": "f439ba45-f1e0-3e2c-8d43-879b91bfb187",
                                "text": "„Es gibt auch noch eine einfache Erklärung, dass das Gewand vom Liturgiegewand herkommt und dessen Farbe trägt.“"
                            },
                            {
                                "example_id": "d31aaffe-c864-4c41-b614-4bf9783c9fbb",
                                "sense_id": "f439ba45-f1e0-3e2c-8d43-879b91bfb187",
                                "text": "„Für Heidi Jetzer wird ein Liturgiegewand angeschafft.“"
                            },
                            {
                                "example_id": "58d69630-f8c6-4acc-b1a5-43ef42b1d08a",
                                "sense_id": "f439ba45-f1e0-3e2c-8d43-879b91bfb187",
                                "text": "„In einer an Liturgiegewänder gemahnenden Robe präsentiert sich der übergroße Gelehrte und seine Heiltrankschale.“"
                            },
                            {
                                "example_id": "aef63002-6530-4111-bb57-06fa45df4ee9",
                                "sense_id": "f439ba45-f1e0-3e2c-8d43-879b91bfb187",
                                "text": "„Geradezu eloquent wird sein Spott, wenn Zwingli über die modischen Melodiearten und Liturgiegewänder herzieht, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
