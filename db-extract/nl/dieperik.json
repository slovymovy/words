                        "examples": [
                            {
                                "example_id": "136844a4-09c5-4c25-951c-52430169ea83",
                                "sense_id": "73554502-bd81-3abf-9f03-581dd924bd4c",
                                "text": "Tijdens je menstruatie duikt je ijzerniveau de dieperik in. Dat verklaart meteen waarom je tijdens deze periode van de maand een plots verlangen lijkt te krijgen naar ijzerrijke voeding. Spinazie en boerenkool zijn de ideale voedingsmiddelen om aan je verlangen naar ijzer te voldoen."
                            },
                            {
                                "example_id": "00ca0dfe-099a-4890-a176-78c35354d1ab",
                                "sense_id": "73554502-bd81-3abf-9f03-581dd924bd4c",
                                "text": "De geldkraan van de Europese Centrale Bank duwt nu in de kernlanden van de eurozone de rente de dieperik in. In België, Duitsland, Finland, Frankrijk, Nederland en Oostenrijk kunnen de nationale overheden geld ophalen aan een negatieve vijfjaarsrente."
                            }
                        ]
