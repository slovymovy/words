                        "examples": [
                            {
                                "example_id": "9736009a-c014-4851-949b-7b1f1005299d",
                                "sense_id": "39df25b6-d2d5-35ef-822a-4397cba972de",
                                "text": "Ik spijkerde een stuk asfaltpapier over het dak om het waterdicht te maken en legde er een paar oude dekens in om op te liggen."
                            },
                            {
                                "example_id": "a0dd18c3-9ca2-41d5-ab91-adeddd1af1d8",
                                "sense_id": "39df25b6-d2d5-35ef-822a-4397cba972de",
                                "text": "De meeste woningen hadden een lessenaarsdak met asfaltpapier en een aanleunplee.” Walcheren telt nog ongeveer dertig van dergelijke „monumenten van bescheidenheid”, weet de vice-voorzitter van de Boerderijenstichting Zeeland. „Ze zijn nu vaak in gebruik als opslagruimte of kippenhok.”"
                            }
                        ]
                    }
