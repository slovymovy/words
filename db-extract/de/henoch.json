                ],
                "senses": [
                    {
                        "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                        "entry_id": "ae844be9-c9f9-3e42-8426-6cf12c6976f6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2ba94b-d1e6-4da1-b77a-987470e20360",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Frau Henoch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "306e4fe0-cc4a-42ce-833a-11947f410eaa",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Herr Henoch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7db53039-fbbf-4b4c-aa12-954b77f80c70",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Die Henochs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d842be93-2375-46e3-8b34-4ccbf8457072",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Der Henoch trägt nie die Schals, die die Henoch ihm strickt."
                            },
                            {
                                "example_id": "2bbbe9ec-3c1f-4779-8dc7-e6a2606ba121",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Henoch kommt, geht der Herr Henoch.“"
                            },
                            {
                                "example_id": "0c3b0080-fb07-42c6-b27c-08f995f850c0",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Henoch kommt und geht."
                            },
                            {
                                "example_id": "7645f4aa-911f-49aa-82a0-daa22c2cc6d2",
                                "sense_id": "d327dcc5-6eee-3f44-9f18-af7f900e4a5e",
                                "text": "Henochs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
