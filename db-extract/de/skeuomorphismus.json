                        "form": "den Skeuomorphismus"
                    },
                    {
                        "form_id": "1dcb5f1e-a978-4e93-8b18-a5d3f700951d",
                        "entry_id": "36363d1a-c623-3084-86f9-01979a9e563a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Skeuomorphismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                        "entry_id": "36363d1a-c623-3084-86f9-01979a9e563a",
                        "glosses": [
                            "Design eines Elements, das an ein vertrautes oder wertvolleres (funktionell nicht notwendiges) Objekt erinnert"
                        ],
                        "tags": [
                            "Design",
                            "Softwareentwicklung"
                        ],
                        "examples": [
                            {
                                "example_id": "16c943ca-6c08-4d99-9a90-6ebe6a889910",
                                "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                                "text": "Skeuomorphismus begegnet uns im Alltag an vielen Orten."
                            },
                            {
                                "example_id": "0a2cdd2d-4561-4b87-badc-7f9d08236647",
                                "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                                "text": "Die Verfechter des Skeuomorphismus betonen, wie sinnvoll dieses Design ist, um sich in der digitalen Welt zurecht zu finden. Gerade durch den Skeuomorphismus sei der Umgang intuitiv, oft auch spielerisch."
                            },
                            {
                                "example_id": "df448472-edd9-4517-91f8-82ad14d5f722",
                                "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                                "text": "Das langsame Verschwinden des Skeuomorphismus im Softwaredesign ist aber durchaus nachvollziehbar."
                            },
                            {
                                "example_id": "e5265907-c08e-4c08-b839-985aeaf2f6ab",
                                "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                                "text": "Anknüpfung an das Vertraute: Skeuomorphismus baut auf dem Vertrauten auf, um das Unbekannte zugänglich zu machen."
                            },
                            {
                                "example_id": "476f3904-b846-446e-a754-a46c4960cf86",
                                "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                                "text": "Im Automobildesign ist Skeuomorphismus besonders verbreitet."
                            },
                            {
                                "example_id": "3fdfde43-fb5a-42ed-9f67-3c9abc80bcf4",
                                "sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                                "text": "Ein weiterer Fall von Skeuomorphismus innerhalb der digitalen Sphäre sind Schaltflächen, die dreidimensionalen Knöpfen ähneln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5836391b-7212-452c-a371-013ab7376442",
                        "source_entry_id": "36363d1a-c623-3084-86f9-01979a9e563a",
                        "source_sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                        "source_sense_description": "Design eines Elements, das an ein vertrautes oder wertvolleres Objekt erinnert",
                        "target_lang_word": "skeuomorph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skeuomorph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0afe3ab0-4657-3873-87f7-266eb28ee645",
                                        "entry_id": "c3fbb975-d37a-3005-b89d-c4de5fa4c3ee",
                                        "glosses": [
                                            "A design feature copied from a similar feature in another object, even when not functionally necessary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ce9565-3085-4be4-bdbf-3a00ab59af6c",
                                                "sense_id": "0afe3ab0-4657-3873-87f7-266eb28ee645",
                                                "text": "As soon as man began to make things, to fasten a handle to a stone implement, to construct a wattled roof, to weave a mat, skeuomorphs became an inseparable part of his brain, and ultimately occasioned a mental craving or expectancy."
                                            },
                                            {
                                                "example_id": "5a9cf92f-7ff8-4319-a8f6-bab6f8b8f565",
                                                "sense_id": "0afe3ab0-4657-3873-87f7-266eb28ee645",
                                                "text": "1987, Alexander von Gernet, Peter Timmins, Pipes and Parakeets: Constructing Meaning in an Early Iroquoian Context, Ian Hodder, Archaeology As Long-Term History, page 37,\nOne of the most striking examples of a skeuomorph is the aforementioned impaled bird motif which has the stem of a pipe thrust through the body of a duck or other bird, so that the mouthpiece protrudes from the bill."
                                            },
                                            {
                                                "example_id": "a77831a2-058c-49d6-8089-003864bfe535",
                                                "sense_id": "0afe3ab0-4657-3873-87f7-266eb28ee645",
                                                "text": "2000, \"skeuomorph\", entry in Barbara Ann Kipfer, Encyclopedic Dictionary of Archaeology, page 519,\nA decorative bow attached to a shoe is a skeuomorph of the laces once used to tie it; triangular shapes drawn below handles on pottery are skeuomorphs of the metal plates by which the handles on metal prototypes were attached; and the semicircular mark on the back of a teaspoon represents the broadening of the handle where it was soldered to the bowl when it used to be made in two pieces."
                                            },
                                            {
                                                "example_id": "38dd9aa3-05fb-417b-af52-57b5f5decbc5",
                                                "sense_id": "0afe3ab0-4657-3873-87f7-266eb28ee645",
                                                "text": "Such skeuomorphs can be used to reconstruct ephemeral artifacts that cannot be recovered archaeologically. Understood in this way, the skeuomorph functions to extend the archaeological record."
                                            },
                                            {
                                                "example_id": "d3196673-7f45-4685-bf98-3fc3d12118ae",
                                                "sense_id": "0afe3ab0-4657-3873-87f7-266eb28ee645",
                                                "text": "While working two months ago in South Lowestoft, Suffolk, British archaeologist Clare Good excavated a four-sided object made of the mineral jet. It closely matches a geometrically designed gold object found far away at a burial site called Bush Barrow near Stonehenge in Wiltshire. The match is so close that experts believe the black artifact is a skeuomorph, or a copy in a different material."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3705eb7d-e941-489d-9362-02c047f5bb89",
                        "source_entry_id": "36363d1a-c623-3084-86f9-01979a9e563a",
                        "source_sense_id": "e6468b5a-1b5d-3580-a8e0-0aa790c8f570",
                        "source_sense_description": "Design eines Elements, das an ein vertrautes oder wertvolleres Objekt erinnert",
                        "target_lang_word": "skeuomorphisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skeuomorphisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b6498b-c9a8-3b7b-88e5-f03c3edf80db",
                                        "entry_id": "b14f8a06-66d1-3cb1-ac56-b00afc74c502",
                                        "glosses": [
                                            "Élément de design dont la forme n’est pas directement liée à la fonction, mais qui reproduit de manière ornementale un élément qui était nécessaire dans l’objet d'origine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b362d6b-8a64-4091-99c3-07ec29041096",
                                                "sense_id": "f5b6498b-c9a8-3b7b-88e5-f03c3edf80db",
                                                "text": "Steve Jobs était un fanatique du skeuomorphisme, une technique qui consiste à s’inspirer du monde réel pour concevoir les interfaces des logiciels, dans le but de simplifier l’interaction avec l’utilisateur final."
                                            },
                                            {
                                                "example_id": "77bc4d20-f1f2-4bec-9b82-d28ee64f9483",
                                                "sense_id": "f5b6498b-c9a8-3b7b-88e5-f03c3edf80db",
                                                "text": "C’est pour cette raison qu’arrivé à un certain point, certains designers s’agacent du skeuomorphisme omniprésent sur le web ou dans les UX …."
                                            },
                                            {
                                                "example_id": "e15f20bc-7c75-417a-803c-357c130130df",
                                                "sense_id": "f5b6498b-c9a8-3b7b-88e5-f03c3edf80db",
                                                "text": "Sans revenir au skeuomorphisme, le neumorphisme conserve l’abstraction du flat design et lui ajoute des petites touches de profondeur, avec des ombres et des effets de relief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
