                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wplątać",
                                "target_lang_sense_clarification": "wciągnąć kogoś w coś niechcianego lub kłopotliwego"
                            },
                            {
                                "target_lang_word": "uwikłać",
                                "target_lang_sense_clarification": "sprawić, że ktoś stanie się częścią trudnej sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fb6e3ab-fc08-38d9-87bf-caed88ac016d",
                    "sense_definition": "Op een verwarrende of vervelende wijze bij een zaak betrokken zijn",
