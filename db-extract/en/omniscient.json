                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                        "entry_id": "e498161d-7791-30a6-b4f1-732cb4a4d38f",
                        "glosses": [
                            "Having total knowledge."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4bdbed08-fb54-4741-8531-7ba753cf19c2",
                                "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                "text": "The story was narrated from an omniscient point of view."
                            },
                            {
                                "example_id": "4ef3965c-cd90-468b-86c9-859604796197",
                                "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                "text": "The Abrahamic God is omniscient."
                            },
                            {
                                "example_id": "f4ada1bf-3abc-41ae-b1e8-68fbe89add2e",
                                "sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
                                "text": "For me, anything is possible. I am omniscient and omnipotent, extremely vain, and, what is more, I come in a handy self-carrying package."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afe09225-676c-4e42-9bac-08fd5519f1e4",
                        "source_entry_id": "e498161d-7791-30a6-b4f1-732cb4a4d38f",
