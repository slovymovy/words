                    {
                        "translation_id": "e2763847-0597-438d-9116-7deebd35b31f",
                        "source_entry_id": "7abbab00-c5be-38fa-b8d0-956e845ec998",
                        "source_sense_id": "27fce29a-6cc3-3f17-a46b-596cedd98367",
                        "source_sense_description": "een schip dat met behulp van stoom wordt voortbewogen",
                        "target_lang_word": "steamship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steamship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                        "entry_id": "2a4e0975-aeb0-3306-9f1f-b15a21f45c98",
                                        "glosses": [
                                            "A ship or vessel propelled by steam power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20204c86-2525-4f5d-8ffa-50804c5fe17e",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "Steamship arrivals, however, are less predictable and the best arrangements of shipping companies and the railway operating department may be upset by weather and tide."
                                            },
                                            {
                                                "example_id": "06b0d395-69d7-4b43-8a41-b74cc1529460",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "The shipwreck is the earliest examples yet found of a propeller-driven steamship on the Great Lakes."
                                            },
                                            {
                                                "example_id": "b54548e2-c6ed-4e84-b423-54f35e2bb863",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "India’s half-hour zone dates back to colonial rule of India and the era when ever-faster steamships and trains were shrinking the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f90479d3-3b57-4343-a26a-5f8d95c058ea",
                        "source_entry_id": "7abbab00-c5be-38fa-b8d0-956e845ec998",
                        "source_sense_id": "27fce29a-6cc3-3f17-a46b-596cedd98367",
                        "source_sense_description": "een schip dat met behulp van stoom wordt voortbewogen",
                        "target_lang_word": "bateau à vapeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bateau à vapeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3e26ad-0c0b-30a9-ad8e-3df483818787",
                                        "entry_id": "c7bd08d8-615a-3e3f-b91a-bd15c490254b",
                                        "glosses": [
                                            "Embarcation pourvue d’un ou plusieurs moteurs à vapeur."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2712d1f-a324-490f-a872-13a4f77138c7",
                                                "sense_id": "7d3e26ad-0c0b-30a9-ad8e-3df483818787",
                                                "text": "Auprès d’un navire à voiles, le bateau à vapeur, tout commode qu’il est, paraît hideux. L’un a l’air d’un cygne épanouissant ses ailes blanches au souffle de la brise, et l’autre d’un poêle qui se sauve à toutes jambes, à cheval sur un moulin."
                                            },
                                            {
                                                "example_id": "8c4e14ef-54a9-409b-8128-a3834d78732e",
                                                "sense_id": "7d3e26ad-0c0b-30a9-ad8e-3df483818787",
                                                "text": "[…], et un bateau à vapeur du service municipal de la Tamise heurta si violemment le ponton de Westminster qu’il n’échappa au naufrage qu’en allant s’enliser sur la rive opposée, dans la vase découverte par la marée basse."
                                            },
                                            {
                                                "example_id": "87d80782-cb14-4d57-b954-0133da4d915a",
                                                "sense_id": "7d3e26ad-0c0b-30a9-ad8e-3df483818787",
                                                "text": "Début 1842, la compagnie belge de navigation à vapeur Anvers-New York annonce les premiers appareillages du British Queen entre les deux ports. Pour la première fois un bateau à vapeur relie le continent européen aux États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
