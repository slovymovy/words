                        "form": "loyalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f40d101-025a-39c1-9db6-ce40465553c0",
                        "entry_id": "eccb1ccb-55a5-344d-9cc0-6445a6a9960e",
                        "glosses": [
                            "Obéissance fidèle à son souverain, au gouvernement établi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e6c9eae-d750-4dbe-984f-be82413f3049",
                                "sense_id": "5f40d101-025a-39c1-9db6-ce40465553c0",
                                "text": "Dans le Haouz, dont la population était en général plus maniable et où il n’y avait qu’une garnison de mokhaznis à Marrakech, le makhzen s’appuyait sur quelques tribus d’un loyalisme plus ou moins éprouvé […]."
                            },
                            {
                                "example_id": "a6bb657e-2260-4c90-a264-25821b5f923c",
                                "sense_id": "5f40d101-025a-39c1-9db6-ce40465553c0",
                                "text": "Toutefois, les cités islamiques n’avaient jamais créé d’institutions autonomes […] Leurs habitants n’avaient aucun loyalisme civique ; ils n’étaient pas d’authentiques citoyens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc2846c8-5306-4c39-a1ae-746197a3f660",
                        "source_entry_id": "eccb1ccb-55a5-344d-9cc0-6445a6a9960e",
                        "source_sense_id": "5f40d101-025a-39c1-9db6-ce40465553c0",
                        "target_lang_word": "loyalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loyalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2af994c8-968c-3ea9-aec7-ffed81f4c6f7",
                                        "entry_id": "80f65ce1-2ede-330b-b801-ed104e1ec994",
                                        "glosses": [
                                            "The property of being a loyalist."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8ee868a-baf3-498a-9c85-fcb51bdbf020",
                                                "sense_id": "2af994c8-968c-3ea9-aec7-ffed81f4c6f7",
                                                "text": "And still there is about him a hint of the ingenu; a Tiggerish quality of enthusiasm for the [Tony] Blair vision that has nothing to do with fawning loyalism."
                                            },
                                            {
                                                "example_id": "37d82804-bafb-4372-8d21-754e9618bd28",
                                                "sense_id": "2af994c8-968c-3ea9-aec7-ffed81f4c6f7",
                                                "text": "In December, the province made it optional for elected officials to swear an oath of allegiance to the king. But Quebec was once also a bastion of loyalism to the monarchy, one with a 200-year history of staunch attachment to the crown, said Damien-Claude Bélanger, a history professor at the University of Ottawa who is writing a book on the subject."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
