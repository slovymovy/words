                "senses": [
                    {
                        "sense_id": "a2954fa1-a0ac-3d36-828e-ec05f728e075",
                        "entry_id": "bd73e539-a5dc-3217-a85c-049a32704e25",
                        "glosses": [
                            "aufgrund von Alter und damit verbundenen Witterungserscheinungen schwarz geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847497ee-4d31-4b36-a47a-1243c277ba66",
                                "sense_id": "a2954fa1-a0ac-3d36-828e-ec05f728e075",
                                "text": "„Ich parkte und ging den moosbedeckten Pfad zwischen zwei altersschwarzen Säulen entlang, um mit dem Pastor zu sprechen.“"
                            },
                            {
                                "example_id": "7110443d-12c3-4905-a68d-63dd6e52c27f",
                                "sense_id": "a2954fa1-a0ac-3d36-828e-ec05f728e075",
                                "text": "„Vor ihr lag ein altersschwarzer Behälter aus bretthartem Leder; sie öffnete ihn und begann ihre Utensilien auszubreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
