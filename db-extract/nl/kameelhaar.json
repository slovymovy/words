                            {
                                "example_id": "4cb3be0b-44d1-472d-9eb1-531bdf05e9ec",
                                "sense_id": "89fd6124-4cd2-38b6-bb88-d8be66527446",
                                "text": "De dekens bestaan uit fijne schapenwol of kameelhaar. Zij zijn in ongeverfde natuurbruine kleuren voorhanden en zijn, bij groote lichtheid, zeer warm."
                            },
                            {
                                "example_id": "e5f437c0-61c2-4b02-bc11-60c873f12fc3",
                                "sense_id": "89fd6124-4cd2-38b6-bb88-d8be66527446",
                                "text": "Maar ook aan de mannen werden alle sieraden ontnomen, en zilveren gordels, en jakken van zijde of kameelhaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7d0e914-294a-3862-a211-8dcdbeaf118e",
