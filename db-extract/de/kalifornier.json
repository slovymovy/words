                                        "glosses": [
                                            "Of or relating to California."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c917e357-655e-4376-83ec-9afffb3a0142",
                                                "sense_id": "8968dd90-bd46-3ea4-9a8e-2f160f320bb8",
                                                "text": "The Californian ant-cricket, Myrmecophila formicarum Scudder occurs in practically every nest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Californian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a304c6f-3630-3f9f-9340-f2714359c7a1",
                                        "entry_id": "d3b71621-42fd-372b-98c2-d5be3de00693",
                                        "glosses": [
                                            "A native or resident of the state of California in the United States of America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0855b78-b3ee-455b-b57e-c32ef40220f9",
                                                "sense_id": "6a304c6f-3630-3f9f-9340-f2714359c7a1",
                                                "text": "And almost five million Californians voted Republican."
                                            },
                                            {
                                                "example_id": "eb6fc1ee-63f4-49a0-9dbe-522b504cc497",
                                                "sense_id": "6a304c6f-3630-3f9f-9340-f2714359c7a1",
                                                "text": "In fact, it's often somewhat disparagingly called \"Boz Angeles\" for the many Californians and celebrities that have come to town, as well as its perceived \"fanciness\" in relation to the rest of the state."
                                            }
                                        ]
                                    }
                                ]
