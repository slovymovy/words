                "senses": [
                    {
                        "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                        "entry_id": "6ca61c69-941b-3938-818c-df24c4c4e1ce",
                        "glosses": [
                            "meist handgroßer Ball, der speziell für das Jonglieren gemacht wurde, also meist besonders grifffest, handlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e34465-f6e8-4279-b1ed-62e8a2d2f57e",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„Was kommt in die Schultüte? – […] Auch kleine Überraschungen wie ein Hüpfseil, Seifenblasen oder Jonglierbälle sind bei heutigen ABC-Schützen noch immer gefragt.“"
                            },
                            {
                                "example_id": "049d8836-03e1-4a8e-8380-f59525be39a1",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "Ich übe zweimal pro Woche mit meinen Jonglierbällen."
                            },
                            {
                                "example_id": "85b33d17-3e32-4bff-a426-00cea1860d51",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "Es ist phantastisch, was er mit den Jonglierbällen anstellt."
                            },
                            {
                                "example_id": "ab784e5b-174b-4bee-9c43-45a0686d5145",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "Mit Jonglierbällen schulst du deine Koordination."
                            },
                            {
                                "example_id": "6c13cfc7-3812-471f-b69f-ae0e071c2c96",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„Aus Luftballons und Reis oder Sand kannst du dir ganz leicht Jonglierbälle selber basteln.“"
                            },
                            {
                                "example_id": "9ce2bcd5-9e32-4bff-b488-e08b43f17cbc",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„Jonglierbälle sind einfach zu basteln. Mach am besten gleich mehrere Bälle, damit du mit ihnen jonglieren kannst.“"
                            },
                            {
                                "example_id": "b6f77edf-3bd1-4317-9c10-fda8d27da730",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„Bastel dir nach unserer Anleitung Jonglierbälle und mit ein bisschen Übung bist auch du bald ein kleiner Künstler.“"
                            },
                            {
                                "example_id": "c9de66ad-34c8-4aa9-aa4e-c62330825c30",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„»Kauf dir Jonglierbälle.«“"
                            },
                            {
                                "example_id": "0ef2ff0d-7778-4fc8-be23-1fc766a3b234",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„Jonglieren ist für jedes Alter, macht Spass und ist gesund. Das ist kein billiger Werbespot, sondern die Erfahrung all jener, die sich schon mal an Jonglierbälle oder sogar Keulen gewagt haben.“"
                            },
                            {
                                "example_id": "cd4a3e08-f92a-4d0c-b560-fe3aa268329e",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "„Er hatte beim Aufbruch aus dem Lager seine Jonglierbälle ganz unten in den Proviantbeutel gestopft.“"
                            },
                            {
                                "example_id": "9df6aff5-d48d-4bb7-9b90-6054593ae914",
                                "sense_id": "784eb18f-05a6-3721-8f97-345e451f7d7f",
                                "text": "[Ergotherapie:] „Bleib auf dem Hocker stehen. Hier hast Du zwei Jonglierbälle. Nimm in jede Hand einen Jonglierball und werfe nun beide Bälle abwechselnd hoch. Fange jeden Ball mit der Hand auf, mit der Du ihn hochgeworfen hast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
