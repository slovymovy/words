                        "target_lang_word": "Landsfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78281c74-b019-3441-9d8e-72ffbfc82a1d",
                                        "entry_id": "8f7116eb-59e5-300d-a86a-f4c55e1da138",
                                        "glosses": [
                                            "weibliche Person, die aus dem gleichen Land wie die beziehungsweise der Sprechende beziehungsweise aus einem genannten Land kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb31f24-3ec8-4295-878f-d5532e87fbb9",
                                                "sense_id": "78281c74-b019-3441-9d8e-72ffbfc82a1d",
                                                "text": "Sie war französische Landsfrau."
                                            },
                                            {
                                                "example_id": "cf20d1c4-f912-4e44-bdae-0dfa69845e00",
                                                "sense_id": "78281c74-b019-3441-9d8e-72ffbfc82a1d",
                                                "text": "Und was sind Sie für ein Landsfrau? — Ich bin Bayerin!"
                                            },
                                            {
                                                "example_id": "fc182789-3915-4598-b16e-190114adc646",
                                                "sense_id": "78281c74-b019-3441-9d8e-72ffbfc82a1d",
                                                "text": "Es stellte sich bald heraus, dass mein Gesprächspartnerin eine Landsfrau war und wir auch deutsch miteinander sprechen konnten."
                                            },
                                            {
                                                "example_id": "4c7e5a94-bcdd-4567-994c-9be635a9977a",
                                                "sense_id": "78281c74-b019-3441-9d8e-72ffbfc82a1d",
                                                "text": "„Gleich den Männern von Hebron verachtete ihr Wetzel die lästigen Ängste und Klagen seiner Wormser Landsfrauen; sie sah es und bezwang sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f752a996-3ac9-4220-a10b-dca9b0f5dcbb",
                        "source_entry_id": "e59eecb5-1600-37c3-94bd-7b82901251af",
                        "source_sense_id": "c533e699-f9b8-3000-8851-cbbb89600178",
                        "source_sense_description": "female relative",
                        "target_lang_word": "Landsmännin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsmännin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                        "entry_id": "5aae97e4-bf31-3938-9555-5afc84ee30bf",
                                        "glosses": [
                                            "Frau, die aus demselben Land, aus derselben Region kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42586718-3121-4880-9a09-2424522132c5",
                                                "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                                "text": "Im Finale des Turniers musste Karolina gegen ihre Landsmännin Swetlana antreten."
                                            },
                                            {
                                                "example_id": "8f1f6b0e-29ba-40cd-96e7-adbdee945993",
                                                "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                                "text": "„Selbst für mich, einen in Deutschland aufgewachsenen Türken der dritten Generation, ist es unheimlich schwierig, eine Beziehung mit einer Landsmännin aufzubauen.“"
                                            },
                                            {
                                                "example_id": "d99b9c96-b5d8-4304-bb31-6ec7d5b6043c",
                                                "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                                "text": "„So dumm bin ich nicht, liebe Landsmännin, rief ich begeistert, als ob sie vor mir stünde, und steckte den Brief in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
