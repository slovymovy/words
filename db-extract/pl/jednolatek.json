                "translations": [
                    {
                        "translation_id": "75c1de5b-9947-464c-b64b-b19f8eabaffc",
                        "source_entry_id": "3ef9f768-af36-3a1e-ae47-4a3772ccfc39",
                        "source_sense_id": "c19614a7-0619-358c-84ee-3c10348660db",
                        "target_lang_word": "однолеток",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "однолеток",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f349cccc-d4eb-3ed8-8377-fbbb90df2b94",
                                        "entry_id": "9423ccb4-58fc-308b-a843-fd402b697f4b",
                                        "glosses": [
                                            "разг. тот, кто одних лет с кем-либо; ровесник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fb0786f-2c45-4bd2-b2eb-6a819b7606f9",
                                                "sense_id": "f349cccc-d4eb-3ed8-8377-fbbb90df2b94",
                                                "text": "Я избегал общества своих однолетков; я вообще чуждался людей; я даже с матушкой разговаривал ма́ло."
                                            },
                                            {
                                                "example_id": "52890428-beff-49bb-a058-995afe724ee2",
                                                "sense_id": "f349cccc-d4eb-3ed8-8377-fbbb90df2b94",
                                                "text": "Она, а не я, повинна в том кощунстве, которое сотворил у гробового входа мой спутник и однолеток, почтив вставанием память усопшей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb9bf3eb-1893-37ac-9f84-9f806885afa2",
                                        "entry_id": "9423ccb4-58fc-308b-a843-fd402b697f4b",
                                        "glosses": [
                                            "разг. животное или растение в возрасте одного года"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "однолеток",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "67a6866e-0e88-3b18-8ad3-7ff2c13a9fc6",
                                        "entry_id": "9c3cb51d-4213-30a6-b01a-25abffd7ed77",
