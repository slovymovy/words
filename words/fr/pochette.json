            "senses": [
                {
                    "sense_id": "54cc58b1-4560-337b-8f49-7882e68d5299",
                    "sense_definition": "Enveloppe ou étui plat en papier, carton ou plastique servant d'emballage ou de protection pour un objet ou des documents.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emballage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai rangé tous mes papiers importants dans une <w>pochette</w> en plastique transparente."
                        },
                        {
                            "text": "L'illustration sur la <w>pochette</w> de ce disque vinyle est vraiment magnifique."
                        }
                    ],
                    "synonyms": [
                        "étui",
                        "enveloppe"
                    ],
                    "common_phrases": [
                        "pochette plastique",
                        "pochette de disque",
                        "pochette en carton",
                        "pochette d'allumettes"
                    ]
                },
                {
                    "sense_id": "a73bdcbb-09e9-389e-a1fe-3826e02069b6",
                    "sense_definition": "Petit sac à main plat, sans anse ni bandoulière, généralement porté lors des soirées et cérémonies.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accessoire_mode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle portait une élégante robe longue avec une petite <w>pochette</w> dorée à la main."
                        },
                        {
                            "text": "Cette <w>pochette</w> de soirée est assez spacieuse pour contenir un téléphone et des clés."
                        }
                    ],
                    "synonyms": [
                        "sacoche",
                        "sac à main"
                    ],
                    "common_phrases": [
