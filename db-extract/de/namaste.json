                            "singular"
                        ],
                        "form": "das Namaste"
                    },
                    {
                        "form_id": "ea6cf952-80c1-4e1f-9ea3-fc77f68dfcd2",
                        "entry_id": "135e609b-73cc-3c01-9c7a-da095d45a8e1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Namastes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29c4fa76-33cd-3742-b9e5-e4ba4b8feda1",
                        "entry_id": "135e609b-73cc-3c01-9c7a-da095d45a8e1",
                        "glosses": [
                            "überwiegend in Indien verbreiteter Geste zum Gruß, bei der die Handinnenflächen zusammengeführt, in Nähe des Herzens an die Brust gelegt und der Kopf leicht gebeugt wird"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "ffa070a8-68df-403e-b660-b021f1c88d50",
                                "sense_id": "29c4fa76-33cd-3742-b9e5-e4ba4b8feda1",
                                "text": "„In geringer Entfernung davon ließ Raghu anhalten, stieg ab, half Gabriela vom Karren und mit dem Namaste, dem indischen Gruß, gefaltete Hände und Verneigung, verabschiedeten sie sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e082e3b7-940c-4add-833b-7e5b950fe19b",
                        "source_entry_id": "135e609b-73cc-3c01-9c7a-da095d45a8e1",
                        "source_sense_id": "29c4fa76-33cd-3742-b9e5-e4ba4b8feda1",
                        "target_lang_word": "namaste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namaste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97629bea-c6aa-3253-83c0-c8488598fb1f",
                                        "entry_id": "253c4919-d3e2-3fc5-aca8-7a9a57d03f67",
                                        "glosses": [
                                            "A greeting in contexts relating to Indian culture or the New Age movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3441543e-9cd9-4f3b-a146-8489fce4e609",
                                                "sense_id": "97629bea-c6aa-3253-83c0-c8488598fb1f",
                                                "text": "First of all, Namaste to you! It is my sincere hope that the words of this book will assist you in living with full appreciation for all the moments of your life. Remember that each one is special and brings something to your life[…]"
                                            },
                                            {
                                                "example_id": "cc157e02-ce0b-4840-9352-531baae94922",
                                                "sense_id": "97629bea-c6aa-3253-83c0-c8488598fb1f",
                                                "text": "I shuffled from one foot to the other outside the room, as I delayed going in. Finally, I took a deep breath, exhaled slowly, and knocked on the door. 'Come in.' It seemed that Vimla was expecting me. 'Namaste.' She said, and gestured for me ..."
                                            },
                                            {
                                                "example_id": "547578bb-69b0-4338-920c-902c44989b1d",
                                                "sense_id": "97629bea-c6aa-3253-83c0-c8488598fb1f",
                                                "text": "\"What a lovely wedding for you both. Namaste,\" he said, his hands in prayer formation, his smile wide and confident and sincere. “Congratulations to you both.” “Thank you, Father,” Brian said. “Namaste to you, sir,” Priya added."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf5be6a7-2326-3479-beea-40ae53f4be58",
                                        "entry_id": "253c4919-d3e2-3fc5-aca8-7a9a57d03f67",
                                        "glosses": [
                                            "Thank you (via a misunderstanding of the meaning of the associated gesture)."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "namaste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d415c87f-b437-3769-bf3c-9822a805f54c",
                                        "entry_id": "baa68aa3-6a9f-354d-b96d-eaadf025e9aa",
                                        "glosses": [
                                            "The traditional greeting when saying the word namaste, with folded hands and a slight bow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1811e6d1-bc83-462c-a579-268abebf59fe",
                                                "sense_id": "d415c87f-b437-3769-bf3c-9822a805f54c",
                                                "text": "Krishnan introduced one of the girls as his sister. She was a small, frail-looking girl with a pretty smile. She clasped her hands, made a namaste and said, “Hello, nice meet you. My name is Karishma.” “Hello, Karishma,” said Natascha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25d2cfcb-4380-3f5f-afc8-c61eea1a1415",
                                        "entry_id": "baa68aa3-6a9f-354d-b96d-eaadf025e9aa",
                                        "glosses": [
                                            "In yoga, the pose associated with this word, usually with the flat hands held palms together, fingers up, in front of the heart and a slight bow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "namaste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "497809ea-689a-3d7d-929a-84040f273f24",
                                        "entry_id": "580057b4-ce99-32c8-900f-7a1bcd58d77e",
                                        "glosses": [
                                            "To utter \\\"namaste\\\"."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a95a12a-a32a-4f56-8769-bbbb7efe0e3e",
                                                "sense_id": "497809ea-689a-3d7d-929a-84040f273f24",
                                                "text": "The yoga instructor namasted, and the class began."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "4ed6f537-0486-3250-b03c-5a7425259c54",
