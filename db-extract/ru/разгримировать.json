                                            {
                                                "example_id": "dbd437c9-efe5-40c1-b717-c46e1f2e279c",
                                                "sense_id": "88562641-35c8-34b2-82df-fa2a7398127c",
                                                "text": "Jeden Abend schminkt sie sich ab."
                                            },
                                            {
                                                "example_id": "c78ba6d4-d227-4de6-868f-6df8a44c8073",
                                                "sense_id": "88562641-35c8-34b2-82df-fa2a7398127c",
                                                "text": "Die Maskenbildnerin schminkt die Schauspieler nach der Vorstellung nicht ab, das machen diese selbst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07235631-b85a-3dc7-96d3-578b5d118375",
                                        "entry_id": "6f415dc3-0fe6-33d3-894a-370119d534cb",
                                        "glosses": [
                                            "von einer Idee Abstand nehmen"
