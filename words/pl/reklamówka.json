    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dff8b79-b8b4-3813-bc3f-a13fef6688c1",
                    "sense_definition": "Plastikowa torba na zakupy, często z nadrukiem reklamowym.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "torba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy potrzebuje pan <w>reklamówkę</w> do tych zakupów?",
                            "target_lang_translations": {
                                "en": "Do you need a <w>plastic bag</w> for these groceries?",
                                "ru": "Вам нужен <w>пакет</w> для этих покупок?"
                            }
                        },
                        {
                            "text": "Zapakowałam wszystkie warzywa w jedną dużą <w>reklamówkę</w>.",
                            "target_lang_translations": {
                                "en": "I packed all the vegetables into one large <w>carrier bag</w>.",
                                "ru": "Я сложила все овощи в один большой <w>пакет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foliówka",
                        "siatka",
                        "torebka"
                    ],
                    "common_phrases": [
                        "foliowa reklamówka",
                        "duża reklamówka",
                        "reklamówka na zakupy"
                    ],
                    "target_lang_definitions": {
                        "en": "A plastic shopping bag, often featuring a printed advertisement.",
                        "ru": "Пластиковый пакет для покупок, часто с рекламным принтом."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plastic bag",
                                "target_lang_sense_clarification": "a thin bag made of plastic for carrying groceries"
                            },
                            {
                                "target_lang_word": "carrier bag",
                                "target_lang_sense_clarification": "a shopping bag provided by a store"
                            },
                            {
                                "target_lang_word": "shopping bag",
                                "target_lang_sense_clarification": "a bag used for carrying purchased goods"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "пластиковый или полиэтиленовый"
                            },
                            {
                                "target_lang_word": "пакет с рекламой",
                                "target_lang_sense_clarification": "с логотипом магазина или бренда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c47e298c-d1ea-351c-a0be-25ceb1b19720",
                    "sense_definition": "Dowolny przedmiot lub materiał służący promocji firmy, np. broszura, kalendarz lub długopis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marketing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na targach rozdawali różne <w>reklamówki</w>, w tym notesy i smycze.",
                            "target_lang_translations": {
                                "en": "At the fair, they were handing out various <w>promotional items</w>, including notebooks and lanyards.",
                                "ru": "На ярмарке раздавали различные <w>рекламные сувениры</w>, в том числе блокноты и шнурки для ключей."
                            }
                        },
                        {
                            "text": "Ta kolorowa <w>reklamówka</w> zawiera ofertę naszej nowej firmy.",
                            "target_lang_translations": {
                                "en": "This colorful <w>brochure</w> contains the offer of our new company.",
                                "ru": "Этот цветной <w>рекламный проспект</w> содержит предложение нашей новой компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "gadżet",
                        "prospekt"
                    ],
                    "common_phrases": [
                        "firmowa reklamówka"
                    ],
                    "target_lang_definitions": {
                        "en": "Any item or material used for company promotion, such as a brochure, calendar, or pen.",
                        "ru": "Любой предмет или материал, служащий для продвижения компании, например, брошюра, календарь или ручка."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "promotional material",
                                "target_lang_sense_clarification": "printed or physical items used for advertising"
                            },
                            {
                                "target_lang_word": "brochure",
                                "target_lang_sense_clarification": "a small book or magazine containing pictures and information about a product"
                            },
                            {
                                "target_lang_word": "flyer",
                                "target_lang_sense_clarification": "a small sheet of paper advertising something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рекламный материал",
                                "target_lang_sense_clarification": "брошюра, листовка"
                            },
                            {
                                "target_lang_word": "рекламный сувенир",
                                "target_lang_sense_clarification": "гаджет, ручка, блокнот"
                            },
                            {
                                "target_lang_word": "промо-материал",
                                "target_lang_sense_clarification": "для маркетинговых целей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d961e81-41a5-3aad-b47a-66790d8c6966",
                    "sense_definition": "Egzemplarz produktu służący do prezentacji, często sprzedawany później po niższej cenie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem ten telewizor taniej, bo to była ostatnia <w>reklamówka</w> z wystawy.",
                            "target_lang_translations": {
                                "en": "I bought this TV cheaper because it was the last <w>display model</w> from the exhibition.",
                                "ru": "Я купил этот телевизор дешевле, потому что это был последний <w>витринный экземпляр</w>."
                            }
                        },
                        {
                            "text": "Ta <w>reklamówka</w> ma kilka rys, ale działa bez zarzutu.",
                            "target_lang_translations": {
                                "en": "This <w>floor model</w> has a few scratches, but it works perfectly.",
                                "ru": "Этот <w>выставочный образец</w> имеет несколько царапин, но работает безупречно."
                            }
                        }
                    ],
                    "synonyms": [
                        "powystawowy",
                        "egzemplarz"
                    ],
                    "common_phrases": [
                        "ostatnia reklamówka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w kontekście handlowym"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A product unit used for presentation or display, often sold later at a lower price.",
                        "ru": "Экземпляр товара, предназначенный для демонстрации, часто продаваемый позже по сниженной цене."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "display model",
                                "target_lang_sense_clarification": "an item used for demonstration in a shop"
                            },
                            {
                                "target_lang_word": "floor model",
                                "target_lang_sense_clarification": "a product displayed on the showroom floor"
                            },
                            {
                                "target_lang_word": "ex-display unit",
                                "target_lang_sense_clarification": "an item previously used for display purposes"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "витринный экземпляр",
                                "target_lang_sense_clarification": "товар с выставки"
                            },
                            {
                                "target_lang_word": "выставочный образец",
                                "target_lang_sense_clarification": "используемый для презентации"
                            }
                        ]
                    }
                }
            ]
        }
