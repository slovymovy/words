                },
                {
                    "sense_id": "6942cdb7-9bb1-34fe-ba87-a1d440d5c34f",
                    "sense_definition": "A traditional soft cookie made with molasses, spices, dried fruits, and toasted pecans",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She baked a batch of fresh <w>mogs</w> for the holiday party.",
                            "target_lang_translations": {
                                "ru": "Она испекла партию свежего <w>печенья с патокой</w> для праздничной вечеринки."
                            }
                        },
                        {
                            "text": "These <w>mogs</w> are rich with molasses and full of raisins.",
                            "target_lang_translations": {
                                "ru": "Это <w>печенье с патокой</w> очень насыщенное и полно изюма."
                            }
                        }
                    ],
                    "synonyms": [
                        "cookie",
                        "biscuit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционное мягкое печенье с патокой, специями, сухофруктами и орехами пекан."
