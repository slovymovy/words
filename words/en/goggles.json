    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                    "sense_definition": "Protective eyewear set in a flexible frame to fit snugly against the face.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eyewear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must wear <w>goggles</w> while swimming in the pool.",
                            "target_lang_translations": {
                                "it": "Devi indossare gli <w>occhialini</w> mentre nuoti in piscina."
                            }
                        },
                        {
                            "text": "The scientist put on her <w>goggles</w> to protect her eyes from chemicals.",
                            "target_lang_translations": {
                                "it": "La scienziata si è messa gli <w>occhiali protettivi</w> per ripararsi gli occhi dalle sostanze chimiche."
                            }
                        }
                    ],
                    "common_phrases": [
                        "safety goggles",
                        "swimming goggles",
                        "pair of goggles"
                    ],
                    "target_lang_definitions": {
                        "it": "Occhiali protettivi con montatura aderente usati per sport (nuoto, sci) o sicurezza sul lavoro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "occhialini",
                                "target_lang_sense_clarification": "specifico per nuoto"
                            },
                            {
                                "target_lang_word": "occhiali protettivi",
                                "target_lang_sense_clarification": "per lavoro, laboratorio o sport"
                            },
                            {
                                "target_lang_word": "occhiali da sci",
                                "target_lang_sense_clarification": "maschera per sport invernali"
                            },
                            {
                                "target_lang_word": "maschera",
                                "target_lang_sense_clarification": "maschera da sub o da sci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37cae680-78ca-3c24-b8c1-5f54c32071db",
                    "sense_definition": "Glasses or spectacles used for vision correction.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "eyewear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He adjusted his <w>goggles</w> to read the small print on the menu.",
                            "target_lang_translations": {
                                "it": "Si è sistemato gli <w>occhiali</w> per leggere i caratteri piccoli del menu."
                            }
                        },
                        {
                            "text": "She could not see the blackboard clearly until she put on her <w>goggles</w>.",
                            "target_lang_translations": {
                                "it": "Non riusciva a vedere bene la lavagna finché non si è messa gli <w>occhiali</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "glasses",
                        "spectacles"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to refer to spectacles in an older or informal context."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Occhiali da vista usati per correggere difetti visivi (uso colloquiale o datato)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "occhiali",
                                "target_lang_sense_clarification": "termine generale per occhiali da vista"
                            },
                            {
                                "target_lang_word": "occhialoni",
                                "target_lang_sense_clarification": "occhiali grandi o vistosi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50a3e814-ba37-37f1-be89-a8b38f34b9bc",
                    "sense_definition": "Blinds used to prevent horses from shying or being distracted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equestrian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse wore <w>goggles</w> to keep it calm on the busy road.",
                            "target_lang_translations": {
                                "it": "Il cavallo portava i <w>paraocchi</w> per rimanere calmo sulla strada trafficata."
                            }
                        },
                        {
                            "text": "The trainer attached the <w>goggles</w> to the horse's bridle.",
                            "target_lang_translations": {
                                "it": "L'addestratore ha fissato i <w>paraocchi</w> alla briglia del cavallo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Paraocchi utilizzati per i cavalli per evitare che si distraggano o si spaventino."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "paraocchi",
                                "target_lang_sense_clarification": "per cavalli"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}