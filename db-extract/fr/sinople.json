                ],
                "senses": [
                    {
                        "sense_id": "9c25a742-eb83-3d6c-9eee-6829f7d15c4a",
                        "entry_id": "ef7a2dd4-89ea-3516-9d75-6ae10cab7b02",
                        "glosses": [
                            "Synonyme de quartz hématoïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a78b2b-05c7-40f9-a462-6edbe2d3a82b",
                                "sense_id": "9c25a742-eb83-3d6c-9eee-6829f7d15c4a",
                                "text": "Le quartz sinople est tantôt cristallisé, et tantôt en masse ; dans le premier cas, il porte vulgairement le nom de hyacinthe occidental ou de Compostelle,"
                            }
                        ]
                    },
                    {
                        "sense_id": "fd612681-067b-351e-aff9-29d9c4d814ea",
                        "entry_id": "ef7a2dd4-89ea-3516-9d75-6ae10cab7b02",
                        "glosses": [
                            "Émail de couleur verte que l’on utilise en blasonnement pour indiquer la couleur verte d’un élément des armoiries : écu, partition, pièce, meuble, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a34e51-9ec9-4a2e-9f30-1a825953290b",
                                "sense_id": "fd612681-067b-351e-aff9-29d9c4d814ea",
                                "text": "De sinople, au chef d’argent chargé de trois gouttes de sang de gueules, qui est d’Écurie du Pas-de-Calais."
                            },
                            {
                                "example_id": "d0a69dc8-afad-4e05-a4fb-be869d1214c5",
                                "sense_id": "fd612681-067b-351e-aff9-29d9c4d814ea",
                                "text": "Sur le carré du milieu, les armes de la ville étaient représentées au moyen d’artifices floraux et végétaux et M. Abel les redéchiffra mentalement au passage : « Parti de gueules et de sinople aux trois martels d’argent, le chef cousu de France »."
                            },
                            {
                                "example_id": "22fe06d7-8c2b-476c-b0ee-0861f66e0afe",
                                "sense_id": "fd612681-067b-351e-aff9-29d9c4d814ea",
                                "text": "Sinople, autrement verd ; Car le sinople est proprement une sorte de craie, ou de mineral, qui se trouve au Levant, & est bon pour teindre en verd."
                            }
                        ]
                    }
                ],
