    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e904143-c426-3ff3-8163-c39b0d1b19cd",
                "word": "autographist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a444a334-d5c8-4e72-9416-59e944777554",
                        "entry_id": "4e904143-c426-3ff3-8163-c39b0d1b19cd",
                        "tags": [
                            "plural"
                        ],
                        "form": "autographists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f62aaeb0-2860-34b1-85f6-3d16d82439ee",
                        "entry_id": "4e904143-c426-3ff3-8163-c39b0d1b19cd",
                        "glosses": [
                            "One who collects or authenticates autographs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7173b3a9-b98f-4866-9c28-60b5bba463f7",
                                "sense_id": "f62aaeb0-2860-34b1-85f6-3d16d82439ee",
                                "text": "He was particularly famous as an autographist, however, and his judgment in all matters concerning the genuineness and value of autographs was unerring."
                            },
                            {
                                "example_id": "327fd9ad-248f-4322-9786-563b7a84e5ab",
                                "sense_id": "f62aaeb0-2860-34b1-85f6-3d16d82439ee",
                                "text": "Above all things, my dear autographist, get your victim's name correct, do not add insult to injury."
                            },
                            {
                                "example_id": "8a8bb28f-7904-47cb-bb7a-6166fae73349",
                                "sense_id": "f62aaeb0-2860-34b1-85f6-3d16d82439ee",
                                "text": "[Joseph] Kyselak, who described himself as an \"autographist,\" was no innovator either."
                            }
                        ]
                    },
                    {
                        "sense_id": "280d3225-9f69-318d-b16b-6bab1ec88c87",
                        "entry_id": "4e904143-c426-3ff3-8163-c39b0d1b19cd",
                        "glosses": [
                            "One who signs an autograph."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d06f024-5f83-49b3-909d-7c44c84d50a2",
                                "sense_id": "280d3225-9f69-318d-b16b-6bab1ec88c87",
                                "text": "It was quite a troublesome task to keep the autographists within their proper limits, but I was very peremptory—though jocosely so, of course—upon the subject."
                            },
                            {
                                "example_id": "e1f63ea0-3a28-4bea-bd79-c341e654ae47",
                                "sense_id": "280d3225-9f69-318d-b16b-6bab1ec88c87",
                                "text": "The autographists have not been very happy in their quotations."
                            }
                        ]
                    },
                    {
                        "sense_id": "92341cba-bd89-38e8-92b2-37171e6283fd",
                        "entry_id": "4e904143-c426-3ff3-8163-c39b0d1b19cd",
                        "glosses": [
                            "One who copies a historic document."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36de6d14-703d-4788-883c-31e7a2eb08c7",
                                "sense_id": "92341cba-bd89-38e8-92b2-37171e6283fd",
                                "text": "Where no modern editing has been done on a number. with an 18th century edition merely being handed over to an autographist or engraver for re-copying, it is all too easy for careless, incorrect 20th century reprints to result."
                            }
                        ]
                    }
                ],
