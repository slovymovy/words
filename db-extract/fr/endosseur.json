                        "sense_id": "5174f337-9e96-391d-b70f-38500ef9e0b3",
                        "entry_id": "a94fcb66-fcf5-3f3a-9f1e-46cd3c3bd610",
                        "glosses": [
                            "Celui qui endosse une lettre de change, un chèque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d15f77-97c8-4a31-808a-2e9be8a51bfb",
                                "sense_id": "5174f337-9e96-391d-b70f-38500ef9e0b3",
                                "text": "Le tireur et les endosseurs d’une lettre de change sont garants solidaires de l’acceptation et du paiement à l’échéance."
                            },
                            {
                                "example_id": "a03eece9-e2b5-4d15-8751-0be08360605c",
                                "sense_id": "5174f337-9e96-391d-b70f-38500ef9e0b3",
                                "text": "Voulez-vous que l’on sache à la Banque de France que vous m’avez versé les trente mille francs dont vous êtes endosseur ?... C’est déjà beaucoup trop d’y avoir mis la signature d’un homme comme vous !..."
                            }
                        ]
                    }
