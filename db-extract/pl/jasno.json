                "senses": [
                    {
                        "sense_id": "1767c4b2-139d-35e4-be69-7ad5cda062d1",
                        "entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "glosses": [
                            "z dużą ilością światła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f259a7-0bd9-4c86-a7c2-9f9857cc0c87",
                                "sense_id": "1767c4b2-139d-35e4-be69-7ad5cda062d1",
                                "text": "Gdy się obudziła, na dworze było już zupełnie jasno."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b48bfb87-fc31-3648-9fef-68bf2f2b170d",
                        "entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "glosses": [
                            "w jasnym odcieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721597ef-a6b9-4806-a069-1983117599d8",
                                "sense_id": "b48bfb87-fc31-3648-9fef-68bf2f2b170d",
                                "text": "Czemu tak jasno się malujesz? Wcale nie widać, że masz makijaż."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b41786c0-00f5-33be-9f83-76fe47418cd8",
                        "entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "glosses": [
                            "w sposób zrozumiały, oczywisty"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "658f9074-2324-45ad-8ca1-2fe24e85d796",
                                "sense_id": "b41786c0-00f5-33be-9f83-76fe47418cd8",
                                "text": "Dopiero brat jasno wytłumaczył mu to zadanie."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "63c04f4b-29ba-3182-930b-d4d276bd3d3b",
                        "entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "glosses": [
                            "w sposób zdecydowany, stanowczy"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "d201ee4a-bde6-4571-b740-d00dfd688f6e",
                                "sense_id": "63c04f4b-29ba-3182-930b-d4d276bd3d3b",
                                "text": "Postawiła sprawę jasno: albo wódka, albo ona."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "80f8a84e-38b2-3c00-8f5e-b1f7343d9bcd",
                        "entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "glosses": [
                            "beztrosko, pogodnie, radośnie"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "88dd0344-078d-4406-a7a2-cced2431ff1b",
                                "sense_id": "80f8a84e-38b2-3c00-8f5e-b1f7343d9bcd",
                                "text": "Odkąd znalazł pracę, jasno patrzył w przyszłość."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb1e07ef-6698-4ac3-9781-1a5f819e2c0f",
                        "source_entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "source_sense_id": "1767c4b2-139d-35e4-be69-7ad5cda062d1",
                        "target_lang_word": "brightly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brightly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                        "entry_id": "dc090dbf-eebe-311e-9f55-c5e87607aebd",
                                        "glosses": [
                                            "In a bright manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85d3c11-9b4a-4ec2-affc-39f20fade48f",
                                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                                "text": "The sun was shining brightly, making me squint."
                                            },
                                            {
                                                "example_id": "be9c98ae-b1df-402e-844b-b2c4cc896251",
                                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                                "text": "The visitors started brightly and had an early chance when Valencia's experienced captain David Albeda gifted the ball to Fernando Torres, but the striker was caught by defender Adil Rami as he threatened to shoot."
                                            },
                                            {
                                                "example_id": "0615750b-1eeb-4565-8284-2ee363be4214",
                                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                                "text": "She looked brightly at Grandmamma, who nodded and said, 'Yes, it's yours now.'"
                                            },
                                            {
                                                "example_id": "df64ae00-025d-4baa-bb9f-5c635faa55ef",
                                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                                "text": "Now he rushed to the platform edge carrying a full fire bucket, in a forlorn attempt to douse the flames as the now brightly burning wagon rolled past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c89899-098f-47bf-93ea-bc318eaea660",
                        "source_entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
