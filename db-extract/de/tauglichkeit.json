                        ]
                    },
                    {
                        "translation_id": "c0b610e7-7683-4958-9364-dc9b50efd02a",
                        "source_entry_id": "a44ebcce-3fc9-3d7e-b425-8d88386b00fe",
                        "source_sense_id": "8d529e37-5140-3697-ace2-f62a6c2db804",
