                ],
                "senses": [
                    {
                        "sense_id": "55b505f5-5613-3bba-866b-ad4522353dae",
                        "entry_id": "130cbc5a-3cbe-3497-a3cc-92343bd61e63",
                        "glosses": [
                            "defeatist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0730ca8-0de0-420c-b6e8-a58d00426f56",
                                "sense_id": "55b505f5-5613-3bba-866b-ad4522353dae",
                                "text": "Говори, ты оборонец? Или, может быть, ты пораженец?",
                                "translation": "Tell [me], are you a Menshevik? Or, maybe you are a defeatist?",
                                "english": "Tell [me], are you a Menshevik? Or, maybe you are a defeatist?"
                            },
                            {
                                "example_id": "6600e500-ea6c-4019-a58d-59afe7caa61b",
                                "sense_id": "55b505f5-5613-3bba-866b-ad4522353dae",
                                "text": "Вслед за Патриотом пришел Пораженец — курсант Ибанов, поднявший по дороге на аэродром листовку, которую сбросил бог весть как залетевший в такой глубокий тыл вражеский самолет.",
                                "translation": "Following the Patriot came the Defeatist — cadet Ibanov, that on his way to the airfield picked up a flyer, that was dropped by an enemy airplane, that God knows how turned up so far on the rear.",
                                "english": "Following the Patriot came the Defeatist — cadet Ibanov, that on his way to the airfield picked up a flyer, that was dropped by an enemy airplane, that God knows how turned up so far on the rear."
                            },
                            {
                                "example_id": "660c711a-efdd-4fa6-b530-17a24ab92ce7",
                                "sense_id": "55b505f5-5613-3bba-866b-ad4522353dae",
                                "text": "Однако далеко не каждый пораженец, но и победитель способен к сознательному совершенствованию.",
                                "translation": "However not every defeatist by far, but also a winner is capable of consientious development.",
                                "english": "However not every defeatist by far, but also a winner is capable of consientious development."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada1903c-83fc-3a74-bd7b-41d0e1930544",
                        "entry_id": "130cbc5a-3cbe-3497-a3cc-92343bd61e63",
                        "glosses": [
                            "A person, often part of a racial or social minority, that has been stripped of some or all of their rights."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b3e6870d-b6ef-38e4-9fe6-e8d2b1a1375b",
                        "entry_id": "130cbc5a-3cbe-3497-a3cc-92343bd61e63",
                        "glosses": [
                            "A person arrested for doubting Soviet Union's victory over Nazi Germany."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
