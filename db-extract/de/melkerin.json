                "translations": [
                    {
                        "translation_id": "08364037-7268-4b1e-99dd-a186faeb3ec9",
                        "source_entry_id": "9f1fb438-fbe1-3012-a6d8-fe51f897339c",
                        "source_sense_id": "cf7e982f-fb3f-3923-91e8-c2b3ee09bfed",
                        "source_sense_description": "weibliche Person, die sich (beruflich) mit Melken beschäftigt",
                        "target_lang_word": "milker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82332e3b-1b01-3e5a-aa41-492a9b7e2b73",
                                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                                        "glosses": [
                                            "An animal, such as a dairy cow, kept for the milk it produces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbd446cf-65f4-3a57-861e-11c6eb9a0a44",
                                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                                        "glosses": [
                                            "A person who milks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "896caef7-85b4-4e3e-9ad2-68aa15129643",
                                                "sense_id": "bbd446cf-65f4-3a57-861e-11c6eb9a0a44",
                                                "text": "The milker woke up at dawn each day to tend to the cows."
                                            },
                                            {
                                                "example_id": "6f2bf010-dc2c-474d-b085-622ec8bada75",
                                                "sense_id": "bbd446cf-65f4-3a57-861e-11c6eb9a0a44",
                                                "text": "The snake milker massages the glands to extract the full measure of venom during each milking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13c65a5f-9c61-3b78-8c86-560acadd3eb5",
                                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                                        "glosses": [
                                            "A milking machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94eef611-9f88-46f8-806c-947af24e5832",
                                                "sense_id": "13c65a5f-9c61-3b78-8c86-560acadd3eb5",
                                                "text": "Many of those running small farms said the choice of a computerized milker came down to a bigger question: whether to upgrade or just give up. […] “It’s tough to find people to do it well and show up on time,” said Tim Kurtz, who installed four robotic milkers last year at his farm in Berks County, Pa. “And you don’t have to worry about that with a robot.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9899d597-a10e-3900-b28f-02928f63f7ac",
                                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                                        "glosses": [
                                            "A conservative poker player who only raises the stakes on a good hand."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "582826cf-8d79-3351-9449-422b5f68501b",
                                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                                        "glosses": [
                                            "A woman’s breast."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a2c89e-13ac-4167-95d8-7c5e41f3ffaf",
                                                "sense_id": "582826cf-8d79-3351-9449-422b5f68501b",
                                                "text": "In the San Diego Convention Center, hanging high above the makeshift alleyways of merchandise vendors, more than 40 pairs of anime-style breasts looked down upon me. I felt like a beetle at a cartoon Renaissance fair, staring at rows of mommy milkers peeking through manga bodices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9f2863f-93a8-4f9b-9aa6-33b48ec57e78",
                        "source_entry_id": "9f1fb438-fbe1-3012-a6d8-fe51f897339c",
                        "source_sense_id": "cf7e982f-fb3f-3923-91e8-c2b3ee09bfed",
                        "source_sense_description": "weibliche Person, die sich (beruflich) mit Melken beschäftigt",
                        "target_lang_word": "trayeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trayeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e91db047-652a-3f1d-ae2c-ee7fae0c4578",
                                        "entry_id": "d37549e7-81d0-3717-81f1-74434ddb7e64",
                                        "glosses": [
                                            "Celle qui trait."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b429edc6-40a7-475c-91b8-45c2229ef761",
                                                "sense_id": "e91db047-652a-3f1d-ae2c-ee7fae0c4578",
                                                "text": "On est tous mêlés ; maîtres et valets, la fermière et les domestiques, le premier garçon de ferme et le petit gardeur de porcs, l’oncle Jean, Florimond le laboureur, Pierrouni le vacher, Jeanneton la trayeuse, et toutes les cousines qui ont mis leur plus large coiffe et d’énormes ceintures vertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ba0f2c-6969-353f-9834-c073a2f9233d",
                                        "entry_id": "d37549e7-81d0-3717-81f1-74434ddb7e64",
                                        "glosses": [
                                            "Machine à traire les animaux d'élevage laitier (vaches, brebis, chèvres)."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ebbe27-169b-421d-ae5f-4132a647d3a9",
                                                "sense_id": "61ba0f2c-6969-353f-9834-c073a2f9233d",
                                                "text": "Les vaches, habituées aux ventouses happeuses des trayeuses, ruent des quatre sabots, envoyant balader dans les pailles noires les casseroles à lait parce que les doigts n'ont plus le tact, la manière, la caresse adéquate aux sollicitations du pis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b71c7660-076c-4f75-8c38-93e7a8397819",
                        "source_entry_id": "9f1fb438-fbe1-3012-a6d8-fe51f897339c",
                        "source_sense_id": "cf7e982f-fb3f-3923-91e8-c2b3ee09bfed",
                        "source_sense_description": "weibliche Person, die sich (beruflich) mit Melken beschäftigt",
                        "target_lang_word": "доярка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "доярка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a84daadd-da5e-3ad0-aa13-acc01583da83",
                                        "entry_id": "c19d03fa-fedf-3900-9cee-a7f741946d6b",
                                        "glosses": [
                                            "с.-х. работница, которая доит коров и ухаживает за ними"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a015d79b-1390-4170-9e66-8a43f1f4c8a8",
                                                "sense_id": "a84daadd-da5e-3ad0-aa13-acc01583da83",
                                                "text": "Молоко всегда будет погибать, если за посудой нет надзора, если доярки будут так доить, как вот я недавно видел: садиться под корову, вымя ей не обмывает, сосцы все в грязи, в навозе... и руки у самой доярки фактически немытые."
                                            },
                                            {
                                                "example_id": "27616eed-74c2-49be-8795-e2ec953badaa",
                                                "sense_id": "a84daadd-da5e-3ad0-aa13-acc01583da83",
                                                "text": "Босые доярки уже несли вёдра с молоком, шагая по земле толстыми ногами; на пороге ночлежной горницы сидел пожилой пастух, — он ел что-то из чашки на коленях и посматривал на доярок, на незнакомого человека и на отдалённые пастбища, где ему придётся пробыть весь день и много воображать, вследствие того, что пастуху на целине мало работы и всё время думается разное в голову."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
