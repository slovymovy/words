                                "target_senses": [
                                    {
                                        "sense_id": "4f5fb1a2-9334-31ca-b709-22686d22de59",
                                        "entry_id": "6f26941c-923a-3612-8d44-823c98fdb353",
                                        "glosses": [
                                            "farblose, leicht entflammbare Flüssigkeit, die als Lösungsmittel verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1b57aa-b511-4d25-b855-d8573cb3d00b",
                                                "sense_id": "4f5fb1a2-9334-31ca-b709-22686d22de59",
                                                "text": "Nagellackentferner enthält vor allem Azeton."
                                            },
                                            {
                                                "example_id": "eaee1945-79f3-4cec-89bb-44c114af317e",
                                                "sense_id": "4f5fb1a2-9334-31ca-b709-22686d22de59",
                                                "text": "„Unter dem erstaunten Blick des Kindes bestreicht sie seine kleinen Nägel mit Lack. Einem ziemlich ordinären rosa Lack, der sehr stark nach Azeton riecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
