                    {
                        "sense_id": "e02d0612-6962-3588-a703-88160d5206cf",
                        "entry_id": "51a75f26-1698-3020-8d46-3db504014fe3",
                        "glosses": [
                            "Relatif au Périgord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe49979d-ab56-44da-9b75-eebd1c582189",
                                "sense_id": "e02d0612-6962-3588-a703-88160d5206cf",
                                "text": "Une des plus tenaces était celle du lébérou périgourdin, une personne maudite mi-homme, mi-bête qui devait pour se libérer de ce sort passer devant sept fontaines ou sept chapelles durant la nuit."
                            },
                            {
                                "example_id": "0fa930e7-1303-4953-b86a-9ee42fd7bf1c",
                                "sense_id": "e02d0612-6962-3588-a703-88160d5206cf",
                                "text": "Guillemette de la Borie est l’auteure d’une quinzaine de romans périgourdins."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fcaebf4-8ca4-32b2-a0ee-b3803d150448",
                        "entry_id": "51a75f26-1698-3020-8d46-3db504014fe3",
                        "glosses": [
                            "Relatif à la ville de Périgueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c245b6-a942-4ff5-b874-652aa8af9f81",
                                "sense_id": "6fcaebf4-8ca4-32b2-a0ee-b3803d150448",
                                "text": "Le billard Club Périgourdin est un club de billard (pool, snooker, carambole) ouvert à tous."
                            }
                        ]
                    }
