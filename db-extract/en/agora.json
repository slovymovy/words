                "senses": [
                    {
                        "sense_id": "8364782e-28ed-319a-b793-ee7015676c80",
                        "entry_id": "acc22406-76d8-3221-9430-2f9f3e4519e8",
                        "glosses": [
                            "A place for gathering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8d2bf6-67e5-4ada-9c80-b2aaa98fbe87",
                                "sense_id": "8364782e-28ed-319a-b793-ee7015676c80",
                                "text": "The custom was to dance its length, moving from partner to masked partner all the way to the agora, the city’s gathering place."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bb5828c-2426-3884-b52f-5a249155ebb3",
                        "entry_id": "acc22406-76d8-3221-9430-2f9f3e4519e8",
                        "glosses": [
                            "A marketplace, especially in Classical Greece."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33b5eac7-5182-44d0-81d1-1893c44979d1",
                        "source_entry_id": "acc22406-76d8-3221-9430-2f9f3e4519e8",
                        "source_sense_description": "a place for gathering",
                        "target_lang_word": "shromaždiště",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shromaždiště",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "46a7086f-066a-384e-8e2d-5cfd77693d80",
                                        "entry_id": "0ef6a6a2-2f0b-35e8-9a3c-6722faa4abff",
                                        "glosses": [
                                            "místo pro shromáždění"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d51334f-cabb-4486-a2c5-bbdceaa64639",
                                                "sense_id": "46a7086f-066a-384e-8e2d-5cfd77693d80",
                                                "text": "Naprosto unikátní je zvláště Obří hrad, o jehož významu se odborníci dosud přou. V současné době převládá názor, že se jednalo o obětiště a shromaždiště keltských kněží – druidů."
                                            },
                                            {
                                                "example_id": "4b1b7dd5-f501-4df1-b705-def07fea482a",
                                                "sense_id": "46a7086f-066a-384e-8e2d-5cfd77693d80",
                                                "text": "Zvěř je na pohyb lidí po cestách i třeba značených turistických trasách zvyklá a vyhýbá se jim. Naopak v sečích, ale i na polích, můžeme v zimě narazit na početná shromaždiště zimující zvěře, kterou není dobré rušit. Pokud ji chceme pozorovat, tak výhradně z cesty a z bezpečné vzdálenosti."
                                            },
                                            {
                                                "example_id": "71a573f2-0059-4526-9c87-738fe5485d29",
                                                "sense_id": "46a7086f-066a-384e-8e2d-5cfd77693d80",
                                                "text": "Průkopníkem v otázce podzemních kontejnerů v regionu byl Uničov. První podzemní shromaždiště tříděného odpadu se ve městě objevilo před patnácti lety při rekonstrukci parkoviště v Nemocniční ulici."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78bd1299-a5bb-4cfb-a0ae-85601732d07c",
                        "source_entry_id": "acc22406-76d8-3221-9430-2f9f3e4519e8",
                        "source_sense_description": "a place for gathering",
                        "target_lang_word": "Agora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agora",
