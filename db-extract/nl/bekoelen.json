                "senses": [
                    {
                        "sense_id": "bd8f5eb1-24c0-3ca4-85a3-b4fe68c382e6",
                        "entry_id": "03c083c6-18fe-35ac-8070-d27e645661ac",
                        "glosses": [
                            "koel worden, rustiger worden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2baabf-3cf0-4490-b4c8-377714ed6bd1",
                                "sense_id": "bd8f5eb1-24c0-3ca4-85a3-b4fe68c382e6",
                                "text": "Een Europees leger is er nog lang niet. Maar nu de relatie met de VS lijkt te bekoelen, is er meer bereidheid tot militaire samenwerking."
                            },
                            {
                                "example_id": "da13ddf2-624f-49db-8b84-46f417ca74a1",
                                "sense_id": "bd8f5eb1-24c0-3ca4-85a3-b4fe68c382e6",
                                "text": "Terwijl de SP geen enkele moeite doet om minder mensen afhankelijk te maken van uitkeringen, Nederland te laten profiteren van de voordelen van de Europese samenwerking, de krappe arbeidsmarkt iets te bekoelen door Oost-Europese werknemers toe te laten of daadwerkelijk iets te dóen voor de mensen in wijken als Slotervaart, zijn dát juist de punten waar de kracht van de PvdA kan liggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4a35ae0-e623-3b6f-930b-9e44ca59b0de",
                        "entry_id": "03c083c6-18fe-35ac-8070-d27e645661ac",
                        "glosses": [
                            "minder heftig worden van een liefdesrelatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c89fd9-2e31-4379-886c-b75477a921f0",
                                "sense_id": "a4a35ae0-e623-3b6f-930b-9e44ca59b0de",
                                "text": "'Toch meen ik gehoord te hebben dat ze ooit hebben gewedijverd om de gunsten van prins Henry.'De graaf bette elegant zijn rode lippen. 'Dat ze hebben geprobeerd zijn liefde voor prinses Elfilda te doen bekoelen.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c29e6b5-3f66-4a8d-99b9-bbc478103932",
                        "source_entry_id": "03c083c6-18fe-35ac-8070-d27e645661ac",
                        "source_sense_id": "bd8f5eb1-24c0-3ca4-85a3-b4fe68c382e6",
                        "source_sense_description": "(figuurlijk) koel worden, rustiger worden",
                        "target_lang_word": "cool down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cool down",
