                        "entry_id": "bafe0f24-c02f-331e-982d-1c331e98d3a4",
                        "glosses": [
                            "afdeling van een ziekenhuis waar men patiënten met hartziekten behandeld; afdeling cardiologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5f18d8d-83a2-4dd7-a124-578baaa31f6f",
                                "sense_id": "3ac57a11-92ce-35ad-acf7-b291dbf0a84d",
                                "text": "Het HagaZiekenhuis in Den Haag erkent dat er problemen waren op de hartafdeling, maar de patiëntveiligheid is volgens het ziekenhuis nooit in gevaar geweest. Het ziekenhuis maakte vanmiddag op een persconferentie bekend dat er maatregelen zijn genomen op de afdeling cardiochirurgie."
                            },
                            {
                                "example_id": "9dd672cc-7e4b-4c70-849a-4d269e0f722c",
                                "sense_id": "3ac57a11-92ce-35ad-acf7-b291dbf0a84d",
                                "text": "De hartafdeling van het ziekenhuis werd dinsdag gesloten vanwege het opvallend hoge aantal sterfgevallen. Het ziekenhuis staat onder verscherpt toezicht van de Inspectie voor de Gezondheidszorg."
                            },
                            {
                                "example_id": "834070b8-87b8-465b-81f4-d6792489a623",
                                "sense_id": "3ac57a11-92ce-35ad-acf7-b291dbf0a84d",
                                "text": "Op de hartafdeling van het ziekenhuis lagen zes patiënten. Zij zijn allemaal overgebracht naar het Maasstad Ziekenhuis in Rotterdam."
                            }
                        ]
                    }
