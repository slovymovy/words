                ],
                "senses": [
                    {
                        "sense_id": "0007e8b8-2f1e-346f-9804-c0fbe65eeebd",
                        "entry_id": "588ea848-b417-3f70-b482-c21d8c0822ec",
                        "glosses": [
                            "anevrizma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4b4152-5c34-475a-8e19-85d7f0228090",
                                "sense_id": "0007e8b8-2f1e-346f-9804-c0fbe65eeebd",
                                "text": "Ein Aneurysma entsteht, wenn die betroffene Arterie eine angeborene oder erworbene Schwäche der Gefäßwand hat.",
                                "translation": "Etkilenen arterin damar duvarında konjenital veya edinilmiş bir zayıflığa sahip olduğunda anevrizma meydana gelir."
                            },
                            {
                                "example_id": "7355e2e9-fbbc-4256-b926-ea58f58dc0fa",
                                "sense_id": "0007e8b8-2f1e-346f-9804-c0fbe65eeebd",
                                "text": "„Er war elf, als seine Mutter in einem Restaurant mit einem Tablett voller dreckigem Geschirr zu taumeln begann, mit Getöse zusammenbrach und an einem Aneurysma starb.“",
                                "translation": "Annesi restoranda bir tablet dolusu kirli çanak çömlek olduğu hâlde sendelemeye başlayıp büyük gürültüyle yere yığılıp bir anevrizmadan öldüğünde on yaşındaydı."
                            },
                            {
                                "example_id": "87cc24af-af50-4497-af71-ed20b2b10e8c",
                                "sense_id": "0007e8b8-2f1e-346f-9804-c0fbe65eeebd",
                                "text": "„Der Landeschirurg erklärte, sein Kollege und lieber Freund sei an einem Aneurysma gestorben, und es tröstete Henriette, dass sie wusste, worum es sich bei einem Aneurysma handelte.“",
                                "translation": "Eyâlet cerrahı, meslektaşı ve sevgili arkadaşının bir anevrizmadan öldüğünü söyledi ve Henriette'yi anevrizmanın ne olduğunu bilmek rahatlattı."
                            }
                        ]
                    }
                ],
