                        "glosses": [
                            "Action de grogner en parlant d’un porc, d’une truie, d’un porcelet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aedd3c8-ab3f-40e8-8911-9d21d788c386",
                                "sense_id": "7aa8225f-8274-3336-bc11-fb543e0e0a8b",
                                "text": "On dormait dans de vieilles chambres boisées où pénétrait l’odeur du foin, où les bruits matinaux étaient le chant du coq, la faux aiguisée, le grouinement des cochons."
                            }
                        ]
                    },
