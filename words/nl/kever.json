                    "sense_id": "abb315d7-7464-3265-be46-5ce6cbe897df",
                    "sense_definition": "een insect dat behoort tot de orde Coleoptera, gekenmerkt door harde dekschilden",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "insecten",
                    "name_type": "no",
