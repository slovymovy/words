                "senses": [
                    {
                        "sense_id": "5b149b36-c6ac-3679-8e44-7da1cd624fd2",
                        "entry_id": "28699fa2-c27c-3d84-8a08-4f20c06f3772",
                        "glosses": [
                            "Bezeichnung für eine Klasse von Verben, deren Bedeutung darauf hinweist, dass etwas mit etwas Neuem versehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2bf76e-a4f8-4e7d-a8a2-0d0dac8ea935",
                                "sense_id": "5b149b36-c6ac-3679-8e44-7da1cd624fd2",
                                "text": "„Den Ornativa stehen die Privativa, Verben, die ein Wegnehmen, Entfernen bezeichnen, gegenüber…“"
                            },
                            {
                                "example_id": "beb3c052-94f1-48b0-92ee-ace948a047a0",
                                "sense_id": "5b149b36-c6ac-3679-8e44-7da1cd624fd2",
                                "text": "Zu den Ornativa gehört z.B. das Verb vergolden, da es bedeutet, dass etwas, das zunächst nicht vergoldet ist, später diesen Zustand haben wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
