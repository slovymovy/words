                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d11c212e-7e33-4d2a-84a6-acabcd9f8afb",
                                                "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                                "text": "Thea besucht im Juni den Nationalpark W im Norden Benins."
                                            },
                                            {
                                                "example_id": "a26b014b-e2d0-4663-9224-b8c6ecdd57c1",
                                                "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                                "text": "Porto Novo ist die Hauptstadt und Cotonou ist der Regierungssitz von Benin."
                                            },
                                            {
                                                "example_id": "1ecc6aa6-727f-4f81-8a22-a774c9513151",
                                                "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                                "text": "Aufgrund der hohen Auslandsverschuldung ist Benin nicht in der Lage, an den größeren internationalen Programmen der Entwicklungszusammenarbeit teilzunehmen, die eine gewisse Eigenbeteiligung erfordern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "481538bc-a659-32fc-aabc-3a15b5d5e814",
                                        "entry_id": "9bb378f7-9e93-33ff-a908-f656b8ab4d44",
                                        "glosses": [
                                            "von Edo-Völkern gegründetes und bis 1897 bestehendes Königreich im Südwesten des heutigen Nigeria"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c91ce8-4fae-46bb-8e5f-c1b8b51e8d26",
                                                "sense_id": "481538bc-a659-32fc-aabc-3a15b5d5e814",
                                                "text": "„Woher aber kam dieses Volk der Bini, wie ist das Reich Benin entstanden?“"
                                            },
                                            {
                                                "example_id": "3b22f34a-8fd7-4489-844f-939e911731ae",
                                                "sense_id": "481538bc-a659-32fc-aabc-3a15b5d5e814",
                                                "text": "„Am 2. Januar hatte er sich zusammen mit neun anderen Weißen und zweihundert afrikanischen Trägern auf eine Höflichkeitsvisite beim König von Benin begeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
