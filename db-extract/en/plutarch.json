                                        "glosses": [
                                            "Biographe et moraliste de la Grèce antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c9daa7-1edc-4183-9031-ca1918b09f15",
                                                "sense_id": "ab639ed1-5651-354f-bde1-ef4992d69327",
                                                "text": "Marie. – Et cette admiration pour les grands hommes de son Plutarque !"
                                            },
                                            {
                                                "example_id": "eb8380fc-fd4d-47c3-b02e-f93f26e665b0",
                                                "sense_id": "ab639ed1-5651-354f-bde1-ef4992d69327",
                                                "text": "Inutile de m’interroger bien profondément pour me confesser que la vie sauve c’est tout de même une consolation, surtout que les belles morts aujourd’hui n’ont plus droit à Plutarque."
                                            }
                                        ]
                                    }
                                ]
                            }
