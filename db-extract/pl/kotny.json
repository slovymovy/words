                "senses": [
                    {
                        "sense_id": "24e414dc-7d13-31b8-b5c1-62ec5a55aa28",
                        "entry_id": "16e4ed06-c7ca-3231-9d69-b04575ce3a64",
                        "glosses": [
                            "o niektórych samicach zwierząt: będący w ciąży, spodziewający się potomstwa"
                        ],
                        "tags": [
                            "zootechn."
                        ],
                        "examples": [
                            {
                                "example_id": "452f49fd-37df-410c-9d4a-f6ad26081d04",
                                "sense_id": "24e414dc-7d13-31b8-b5c1-62ec5a55aa28",
                                "text": "Nasza kotka jest kotna, wkrótce będzie miała młode."
                            },
                            {
                                "example_id": "2abd3071-3148-4d13-93ad-3d04315f393d",
                                "sense_id": "24e414dc-7d13-31b8-b5c1-62ec5a55aa28",
                                "text": "Nie wiem po czym poznać, że gupik jest kotny."
                            },
                            {
                                "example_id": "1d8a72a2-66ae-44c6-89af-b9a8096edd8d",
                                "sense_id": "24e414dc-7d13-31b8-b5c1-62ec5a55aa28",
                                "text": "W małżeństwie jak się pokłócą, będzie tam albo psie złe, albo diabeł kotny."
                            },
                            {
                                "example_id": "070ebed0-c29f-4435-a2a1-688e49cf9ac7",
                                "sense_id": "24e414dc-7d13-31b8-b5c1-62ec5a55aa28",
                                "text": "Gdyby nie to, że był kocur, nie kocica, można by pomyśleć, że kotny i kocięta go tak rozepchały."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
