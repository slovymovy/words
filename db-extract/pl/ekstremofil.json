                        "cross_references": [
                            {
                                "target_word": "extremophile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13c8900e-545e-37da-a26e-11d14148d986",
                                        "entry_id": "45036f87-901f-33b2-99d8-25267986d0f8",
                                        "glosses": [
                                            "Any of many organisms that live under extreme conditions of temperature, pressure, salinity, etc; many are autotrophs; some are commercially important as a source of enzymes that operate under similar conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6120bdb-f74f-49e8-b6c1-1d1984f9ecf3",
                                                "sense_id": "13c8900e-545e-37da-a26e-11d14148d986",
                                                "text": "They had found the world's first extremophiles – organisms that could live in water that had previously been assumed to be much too hot or acid or choked with sulphur to bear life."
                                            },
                                            {
                                                "example_id": "0f70522d-70e8-4ccf-aeba-d61e40a77d31",
                                                "sense_id": "13c8900e-545e-37da-a26e-11d14148d986",
                                                "text": "Lichens are 'extremophiles', organisms able to live, from our point of view, in other worlds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
