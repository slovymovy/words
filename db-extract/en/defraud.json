                "senses": [
                    {
                        "sense_id": "3ec8b921-1a16-38a1-a1a6-4679ed21a39f",
                        "entry_id": "5e6a3ed2-189c-3aaf-88fd-6c64c1ebb697",
                        "glosses": [
                            "To obtain money or property from (a person) by fraud; to swindle."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "436ee873-6109-4b96-90e6-f5ab8b17f835",
                                "sense_id": "3ec8b921-1a16-38a1-a1a6-4679ed21a39f",
                                "text": "I had never defrauded a man of a farthing, nor called him knave behind his back. But now the last rag that covered my nakedness had been torn from me. I was branded a blackleg, card-sharper, and murderer."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1c6e97b-6e67-323f-9348-855ebde01d99",
                        "entry_id": "5e6a3ed2-189c-3aaf-88fd-6c64c1ebb697",
                        "glosses": [
                            "To deprive."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9feb724c-fd26-453c-b63e-a2d974f8c2d7",
                                "sense_id": "c1c6e97b-6e67-323f-9348-855ebde01d99",
                                "text": "Defraud ye not one the other, except it be with consent for a time, that ye may give yourselves to fasting and prayer; and come together again, that Satan tempt you not for your incontinency."
                            },
                            {
                                "example_id": "62a9abe1-9691-4b20-b118-61000faace6f",
                                "sense_id": "c1c6e97b-6e67-323f-9348-855ebde01d99",
                                "text": "She is sinned against, because she is defrauded of her rights ^((i.e. sexual satisfaction))."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fea6faa-ea7c-4baa-8f84-f79061f1da68",
                        "source_entry_id": "5e6a3ed2-189c-3aaf-88fd-6c64c1ebb697",
                        "source_sense_description": "to obtain money or property by fraud",
                        "target_lang_word": "escroquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escroquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d7cacb9-9e3c-3674-b192-cee6405d72ab",
                                        "entry_id": "86de9fb4-0b73-344c-a43d-579c17e470ea",
                                        "glosses": [
                                            "Tirer quelque chose de quelqu’un par fourberie, par dol et manœuvres frauduleuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae82052c-188e-4f55-bf74-f98781412afc",
                                                "sense_id": "3d7cacb9-9e3c-3674-b192-cee6405d72ab",
                                                "text": "Il m’a escroqué cent cinquante euros, sous prétexte de me les emprunter."
                                            },
                                            {
                                                "example_id": "8a127459-85c2-4a54-9f48-b640d97f8f48",
                                                "sense_id": "3d7cacb9-9e3c-3674-b192-cee6405d72ab",
                                                "text": "Il m’a escroqué une montre, un cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cca7479d-585b-3513-9bb2-f3f8dcf751bc",
                                        "entry_id": "86de9fb4-0b73-344c-a43d-579c17e470ea",
                                        "glosses": [
                                            "Voler quelqu’un par des moyens frauduleux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99fc442-3e98-4cc1-915d-f20dcc2a65ee",
                                                "sense_id": "cca7479d-585b-3513-9bb2-f3f8dcf751bc",
                                                "text": "Arrêt de la Cour du Parlement, qui condamne une quidane, connue sous le nom de la femme des Ormes, à être attachée au carcan à la place Saint-Michel, et au bannissement pendant neuf ans, pour avoir escroqué différentes marchandises chez une lingère. (Du 24 janvier 1775.)"
                                            },
                                            {
                                                "example_id": "8186f0c1-da62-409f-ac1a-2ef7c6a9ef90",
                                                "sense_id": "cca7479d-585b-3513-9bb2-f3f8dcf751bc",
                                                "text": "Il escroque tant qu’il peut, partout où il peut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
