                        "examples": [
                            {
                                "example_id": "6003ad29-fc18-4719-b773-12747bc9bf1c",
                                "sense_id": "853f8eb4-0678-3d75-974f-2f5064383f41",
                                "text": "@Lady Baba : je commence à m'auto-apprivoiser."
                            },
                            {
                                "example_id": "8be39d26-3322-43df-9c8f-8a2293722a71",
                                "sense_id": "853f8eb4-0678-3d75-974f-2f5064383f41",
                                "text": "C'est 'achement dur ça, se définir en quelques mots, alors qu'il a fallu des années pour s'auto-apprivoiser (et que c'est pas fini!)"
                            },
                            {
                                "example_id": "1b4aa185-4710-4dee-8db3-5b8be635a62a",
                                "sense_id": "853f8eb4-0678-3d75-974f-2f5064383f41",
                                "text": "Mais comment se connaitre soi-même? Prisonnier de son corps quoique contraint à s'auto-apprivoiser..."
                            }
                        ]
                    }
