                "senses": [
                    {
                        "sense_id": "5a6ab87d-c81c-35aa-a649-1b35e0605b35",
                        "entry_id": "8ef7273c-c102-39a6-b271-26b359143e49",
                        "glosses": [
                            "Féminin singulier de haut."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d9450aab-27f8-4ef5-bc70-a91a58080162",
                                "sense_id": "5a6ab87d-c81c-35aa-a649-1b35e0605b35",
                                "text": "Ces personnes ont intérêt à lire à haute voix, à enregistrer les textes et à les réécouter."
                            },
                            {
                                "example_id": "bf659d4f-a133-4292-b37c-b0b1409f59f1",
                                "sense_id": "5a6ab87d-c81c-35aa-a649-1b35e0605b35",
                                "text": "Nous en avons assez des dentellières et de leurs racontars, et nous remontons vers la ville haute."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b468c4d0-2408-3a7e-b4a1-f58a59d90c2a",
                "word": "haute",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6594b261-c26e-3fe3-83cf-58fa5b2d9ab3",
                        "entry_id": "b468c4d0-2408-3a7e-b4a1-f58a59d90c2a",
                        "glosses": [
                            "Haute société ; classe sociale supérieure ; élite sociale."
                        ],
                        "tags": [
                            "ellipsis",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "89e072a9-39f8-422a-aa7d-6603a8d86d5c",
                                "sense_id": "6594b261-c26e-3fe3-83cf-58fa5b2d9ab3",
                                "text": "Ah ! les ouvriers pauvres ne feraient pas souvent des révolutions s’ils connaissaient mieux les femmes de la haute !"
                            },
                            {
                                "example_id": "d4c66ff8-d5bd-4daa-8dc4-0f8ec1521320",
                                "sense_id": "6594b261-c26e-3fe3-83cf-58fa5b2d9ab3",
                                "text": "Et nous autres, les gens du peuple, nous sommes des imbéciles. On se figurait que les personnages de la haute savaient où ils voulaient en venir, et ils ne savaient rien du tout."
                            },
                            {
                                "example_id": "f9d6c3ad-a2f7-40f9-a7a3-92c4bffcc2fe",
                                "sense_id": "6594b261-c26e-3fe3-83cf-58fa5b2d9ab3",
                                "text": "Moi, je suis bien à gauche, mais quand même pas communiste. Vous, vous êtes de la haute, hein ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
