                "senses": [
                    {
                        "sense_id": "925bf40d-17d3-3b90-954b-9b1db7f797a9",
                        "entry_id": "d4988c5f-084d-3f24-964e-be20ab8e40ab",
                        "glosses": [
                            "Donner un caractère languedocien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ba002f-1297-4636-a3ce-1c3b1a0aa627",
                                "sense_id": "925bf40d-17d3-3b90-954b-9b1db7f797a9",
                                "text": "Donc il ne faut pas languedocianiser le provençal, ce serait une horreur et une absurdité, on est tout d'accord !"
                            },
                            {
                                "example_id": "bb5ee367-e154-41c4-8970-f8d554856e7a",
                                "sense_id": "925bf40d-17d3-3b90-954b-9b1db7f797a9",
                                "text": "Franchement, si le gascon était réellement de l'occitan, on peut se demander si Grosclaude aurait à le languedocianiser pour se faire comprendre."
                            },
                            {
                                "example_id": "9bf65447-9de8-408f-8e7f-a675295f47ad",
                                "sense_id": "925bf40d-17d3-3b90-954b-9b1db7f797a9",
                                "text": "Arrêtez de languedocianiser le gascon !"
                            }
                        ]
                    }
