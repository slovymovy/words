                        "glosses": [
                            "Of, pertaining to, originating in, characteristic of, or deriving from Muslims or Islam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261a4d7e-1e1a-48a7-b7d9-5d45a89393ea",
                                "sense_id": "fcde273c-3513-3743-8c7f-7938da08fc95",
                                "text": "Described by witnesses as a keen cricketer and pubgoer until contacts with Islamic militants radicalized him on a trip to Pakistan, he was ordered to serve at least 14 years for the plot, and for supplying militants in Afghanistan with money and equipment."
                            }
