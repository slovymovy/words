    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6112adac-de45-371e-807c-ca744ebdbe11",
                    "sense_definition": "In een staat van extreme emotie verkeren waardoor men de zelfbeheersing of het heldere denkvermogen verliest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extreme emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De supporters waren <w>uitzinnig</w> van vreugde nadat hun team in de laatste minuut scoorde.",
                            "target_lang_translations": {
                                "en": "The fans were <w>beside themselves</w> with joy after their team scored in the final minute."
                            }
                        },
                        {
                            "text": "Toen de zanger het podium opkwam, reageerde het publiek met een <w>uitzinnig</w> gejuich.",
                            "target_lang_translations": {
                                "en": "When the singer took the stage, the audience responded with <w>frantic</w> cheering."
                            }
                        }
                    ],
                    "synonyms": [
                        "dol",
                        "buiten zinnen",
                        "extatisch",
                        "dolzinnig"
                    ],
                    "antonyms": [
                        "kalm",
                        "beheerst",
                        "rustig"
                    ],
                    "common_phrases": [
                        "uitzinnig van vreugde",
                        "uitzinnig van blijdschap",
                        "uitzinnig gejuich"
                    ],
                    "target_lang_definitions": {
                        "en": "Being in a state of extreme emotion, causing one to lose self-control or clear thinking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frantic",
                                "target_lang_sense_clarification": "wild or distraught with fear, anxiety, or other emotion"
                            },
                            {
                                "target_lang_word": "ecstatic",
                                "target_lang_sense_clarification": "overwhelmingly joyful or excited"
                            },
                            {
                                "target_lang_word": "beside oneself",
                                "target_lang_sense_clarification": "overcome with a very strong emotion"
                            },
                            {
                                "target_lang_word": "delirious",
                                "target_lang_sense_clarification": "in a state of wild excitement or ecstasy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "415aebd0-f457-3e20-8b78-9bed8f2b54d8",
                    "sense_definition": "Blijk gevend van een gebrek aan gezond verstand of rede; waanzinnig.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waanzin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>uitzinnig</w> plan dat onmogelijk uitgevoerd kon worden zonder grote risico's.",
                            "target_lang_translations": {
                                "en": "It was an <w>insane</w> plan that could not possibly be carried out without great risks."
                            }
                        },
                        {
                            "text": "In oude teksten worden mensen soms als <w>uitzinnig</w> beschreven wanneer ze onlogische keuzes maken.",
                            "target_lang_translations": {
                                "en": "In old texts, people are sometimes described as <w>mad</w> when they make illogical choices."
                            }
                        }
                    ],
                    "synonyms": [
                        "waanzinnig",
                        "krankzinnig",
                        "onzinnig"
                    ],
                    "antonyms": [
                        "verstandig",
                        "rationeel"
                    ],
                    "common_phrases": [
                        "een uitzinnig plan"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vaak in een religieuze of literaire context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Showing a lack of common sense or reason; insane or nonsensical."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insane",
                                "target_lang_sense_clarification": "extremely foolish or irrational"
                            },
                            {
                                "target_lang_word": "mad",
                                "target_lang_sense_clarification": "mentally ill or extremely foolish"
                            },
                            {
                                "target_lang_word": "frenzied",
                                "target_lang_sense_clarification": "wildly excited or uncontrolled"
                            }
                        ]
                    }
                }
            ]
        }
    ]
