                                "example_id": "58f0866b-b1f8-4b10-be20-06e0b44432e2",
                                "sense_id": "65a3acbf-a346-34c5-90c2-dc68249d969c",
                                "text": "The final lap in the drawdown of an approved loan or credit facility is the issue of an official instruction by the borrower to the lending bank."
                            },
                            {
                                "example_id": "e73ac994-29b7-4062-98de-c4464fc94317",
                                "sense_id": "65a3acbf-a346-34c5-90c2-dc68249d969c",
                                "text": "The financier exercises control over drawdown of the loan against presentation of stipulated documentation evidencing fulfilment of the pre-specified event or condition"
