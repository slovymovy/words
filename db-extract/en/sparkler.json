            {
                "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                "word": "sparkler",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9463adc8-ab3c-4ec9-8654-f088a2c18b0c",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "sparklers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3481dc9-2aa7-3875-ba6c-32248a1b48fa",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "Anything that sparkles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e162cee-76cd-41cc-8942-6e8aa5aaca9a",
                                "sense_id": "d3481dc9-2aa7-3875-ba6c-32248a1b48fa",
                                "text": "And yet a married woman, possessing your attractions, shuts her eyes (and sparklers too), and goes and runs her delicate-formed head against a wall."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e91ab5f-b344-37c7-84ab-b38da9232f94",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "A hand-held firework that emits sparks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d85c4a-2173-4e97-bcad-d9b1cd66eeda",
                                "sense_id": "9e91ab5f-b344-37c7-84ab-b38da9232f94",
                                "text": "The Playboy cover was of a girl in grey slacks and sandals, one hand on hip and the other waving a sparkler for Independence Day."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3aba740-7089-3ef7-a3a2-ea011543e008",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "A gem or ornament that sparkles."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7c67a11f-86f0-4d5d-b526-cf0e498db296",
                                "sense_id": "c3aba740-7089-3ef7-a3a2-ea011543e008",
                                "text": "When the bill came, I got a side-glance at it, and hoped Rose would have to hock her sparklers to pay it."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8bb7467-c6b4-36eb-9008-a939d00ba52d",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "A vivacious and charismatic person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba63a0c4-6adf-4af6-9000-99dc2468796c",
                                "sense_id": "a8bb7467-c6b4-36eb-9008-a939d00ba52d",
                                "text": "“As for Marilea, she was a sparkler. She was very effervescent. The family would often come out as a family unit when we were in the barnyard or the horse corral, and Marilea was just fine.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "3ee983b0-c728-30e7-b9e4-a54a2bab66fa",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "A sparkling wine."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ac76468e-002a-4773-ae8b-f67d687274f6",
                                "sense_id": "3ee983b0-c728-30e7-b9e4-a54a2bab66fa",
                                "text": "Irvine's white, a grape variety named for Hans Irvine, who developed the vineyards at Great Western (now owned by Seppelt), is frequently used in the Australian sparklers."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ad46c3a-3923-3a50-801b-77363fdcb370",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "A tiger beetle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f9bf19f3-1ef9-3501-b0b8-c0a705f324d8",
                        "entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "glosses": [
                            "One who scatters; especially, one who scatters money; an improvident person."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
