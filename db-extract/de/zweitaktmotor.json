                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "758f2aab-8150-491f-85c7-c609cd193218",
                        "source_entry_id": "c7f4f830-a846-3889-8695-ffa96863a74f",
                        "source_sense_id": "b32dc75b-c37a-3015-b6fd-ee86eee20811",
                        "target_lang_word": "moteur à deux temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moteur à deux temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43b174af-3476-36e3-92f8-8ea07fd6edec",
                                        "entry_id": "0a26f0be-37fe-34ed-b728-31685a271138",
                                        "glosses": [
                                            "Moteur à combustion interne dans lequel le cycle complet, de l’admission à l’échappement, s’effectue en un seul aller et retour du piston, soit une seule rotation de l’arbre moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6319f88b-33a2-42e7-a8c9-f414198a864d",
                                                "sense_id": "43b174af-3476-36e3-92f8-8ea07fd6edec",
                                                "text": "Le moteur à deux temps aura aussi l’avantage de pouvoir fournir, à la même vitesse, deux fois plus d’explosions qu’un moteur à quatre temps ; …."
                                            },
                                            {
                                                "example_id": "90664d6c-2f20-49e5-99f3-0abe894b7c82",
                                                "sense_id": "43b174af-3476-36e3-92f8-8ea07fd6edec",
                                                "text": "Le moteur à deux temps conserve les deux temps principaux indispensables à tout moteur à combustion interne : la compression et la détente. Mais les temps d’admission et d’échappement ne sont plus indépendants, étant remplacés par des phases de courte durée à la fin de la course de détente et au début de la course de compression."
                                            },
                                            {
                                                "example_id": "77ae0807-1416-45b2-a3f7-c355166ccb37",
                                                "sense_id": "43b174af-3476-36e3-92f8-8ea07fd6edec",
                                                "text": "Depuis ses débuts, le moteur à deux temps a beaucoup servi à propulser des motos, des mobylettes, des scooters et même le Solex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
