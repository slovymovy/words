                ],
                "translations": [
                    {
                        "translation_id": "401b2c31-fa3b-4e97-9b1a-dee3850ccc64",
                        "source_entry_id": "6ada4542-755d-3db4-b154-aceb4b4d3fc0",
                        "target_lang_word": "feint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d2515c1-098a-325f-8587-79a31ec01cae",
                                        "entry_id": "b50c32c9-38d0-31b1-8a5c-6699dd25ab8b",
                                        "glosses": [
                                            "A movement made to confuse an opponent; a dummy."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce5c3585-c68d-4eed-8462-f9ed84447fec",
                                                "sense_id": "7d2515c1-098a-325f-8587-79a31ec01cae",
                                                "text": "In October, Friburg had been taken by a Feint of the Duke of Crequi, before the Duke of Lorrain cou'd come to relieve it; […]"
                                            },
                                            {
                                                "example_id": "5a65e479-e20c-4aed-b975-f04da2aa87ae",
                                                "sense_id": "7d2515c1-098a-325f-8587-79a31ec01cae",
                                                "text": "Nothing could be more uncertain than the intentions of the French marshal [André Masséna], and Lord Wellington [Arthur Wellesley, 1st Duke of Wellington] felt, that by an incautious movement, his army must be seriously committed—Massena's retreat might only be a feint to draw the allies from their position—while by turning Monte Junta, he might make a sudden rush on Torres Vedras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f48e80-32f6-3b70-83f9-69cd7e815fd4",
                                        "entry_id": "b50c32c9-38d0-31b1-8a5c-6699dd25ab8b",
                                        "glosses": [
                                            "A blow, thrust, or other offensive movement resembling an attack on some part of the body, intended to distract from a real attack on another part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea76f69-ac25-4d60-8e33-881ed69b2287",
                                                "sense_id": "e2f48e80-32f6-3b70-83f9-69cd7e815fd4",
                                                "text": "He had some advantage in the difference of our weapons; for his sword, as I recollect, was longer than mine, […] His obvious malignity of purpose never for a moment threw him off his guard, and he exhausted every feint and strategem proper to the science of defence; while, at the same time, he mediated the most desperate catastrophe to our rencounter."
                                            },
                                            {
                                                "example_id": "59393902-68d5-4418-b247-eb52e63bd3d3",
                                                "sense_id": "e2f48e80-32f6-3b70-83f9-69cd7e815fd4",
                                                "text": "It is also possible to deliver a compound riposte by using an indirect feint. The attacking fencer would be open to a compound riposte following a successful parry by their opponent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6018af6-1fc7-3a60-b552-1cd16140d01f",
                                        "entry_id": "b50c32c9-38d0-31b1-8a5c-6699dd25ab8b",
                                        "glosses": [
                                            "Something feigned; a false or pretend appearance; a pretence or stratagem."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f475e8-30dd-42a1-8ee5-a9d321d7ec7e",
                                                "sense_id": "f6018af6-1fc7-3a60-b552-1cd16140d01f",
                                                "text": "[I]f your zeal slackens, how can one help thinking that Mr. Courtly's letter is but a feint to get off from a subject in which either your own, or the private and base ends of others to whom you are partial, or those of whom you are afraid, would not endure a reformation?"
                                            },
                                            {
                                                "example_id": "a0fa1e87-8d32-47ed-899c-4a8a4d54b0e4",
                                                "sense_id": "f6018af6-1fc7-3a60-b552-1cd16140d01f",
                                                "text": "If you had fallen up against him (as some of them did), and stood there; he would have made a feint of endeavouring to seize you, which would have been an affront to your understanding; […]"
                                            },
                                            {
                                                "example_id": "845bd9dd-7ee8-42db-abed-cbe1aedf8dfb",
                                                "sense_id": "f6018af6-1fc7-3a60-b552-1cd16140d01f",
                                                "text": "Receiving no reply at all here, from the thoughtful man whom he addressed, Mr. William approached him nearer, and made a feint of accidentally knocking the table with a decanter, to rouse him."
                                            },
                                            {
                                                "example_id": "96c367f3-01e4-429b-b6bf-5878bc7027ae",
                                                "sense_id": "f6018af6-1fc7-3a60-b552-1cd16140d01f",
                                                "text": "Toleration was just a feint to achieve the objective of the Catholic mission."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0881c70-69d8-3be1-a47e-7ce0784c6f55",
                                        "entry_id": "af90910e-fbb1-3d96-a9f3-18991913ed10",
                                        "glosses": [
                                            "To direct (a blow, thrust, or other offensive movement resembling an attack) on some part of the body, intended to distract from a real attack on another part."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b86a2d8-0e94-4306-b50a-a31323d19a29",
                                                "sense_id": "d0881c70-69d8-3be1-a47e-7ce0784c6f55",
                                                "text": "Genevra scowled and said, \"His word is wild, / But dastard treason feinteth such disorders: / Treason or witchcraft neither, undefiled, / A Christian court may cherish in its borders.\""
                                            },
                                            {
                                                "example_id": "2030881b-c1d2-4dc2-8a24-e1acbd15019e",
                                                "sense_id": "d0881c70-69d8-3be1-a47e-7ce0784c6f55",
                                                "text": "Even Penrod's walk was affected; he adopted a gait which was a kind of taunting swagger; and, when he passed other children on the street, he practised the habit of feinting a blow; then, as the victim dodged, he rasped out the triumphant horse laugh which he gradually mastered to horrible perfection."
                                            },
                                            {
                                                "example_id": "70ac6fa6-2785-44cc-a79d-4d3b69e549e5",
                                                "sense_id": "d0881c70-69d8-3be1-a47e-7ce0784c6f55",
                                                "text": "I spurred on the Turani instead of pulling him in, and stood up in the saddle just as we came upon the two. By feinting a slash at one I made him throw up his saber to guard his head. Then, leaning down as the three ponies came together, I cut at the other's neck, getting home over his blade. His mount reared and shelled him out of the saddle like a pea out of a pod."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0256f7b-81b8-3003-9f67-bf849ba35523",
                                        "entry_id": "af90910e-fbb1-3d96-a9f3-18991913ed10",
                                        "glosses": [
                                            "To direct a feint or mock attack against (someone)."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2bdb132-9e6b-49b8-b54e-28b42016a403",
                                                "sense_id": "f0256f7b-81b8-3003-9f67-bf849ba35523",
                                                "text": "Feint him—use your legs! draw him about! he'll lose his wind then in no time, and you can go into him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3a0021-3640-3a7b-a4bd-2b5cb3821035",
                                        "entry_id": "af90910e-fbb1-3d96-a9f3-18991913ed10",
                                        "glosses": [
                                            "To make a feint or mock attack."
                                        ],
                                        "tags": [
                                            "also",
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5973201c-5f46-443f-8d75-0132aefd633c",
                                                "sense_id": "9a3a0021-3640-3a7b-a4bd-2b5cb3821035",
                                                "text": "Ben-Hur feinted with his right hand. The stranger warded, slightly advancing his left arm. Ere he could return to guard, Ben-Hur caught him by the wrist in a grip which years at the oar had made terrible as a vise."
                                            },
                                            {
                                                "example_id": "9b1fc066-3172-4020-a4df-a4e68467928c",
                                                "sense_id": "9a3a0021-3640-3a7b-a4bd-2b5cb3821035",
                                                "text": "My assailant stood a little; in the thick darkness I could see him bob and sidle as though he were feinting at me for an advantageous onfall."
                                            },
                                            {
                                                "example_id": "760b1238-6420-4da3-b3c6-107008e2a331",
                                                "sense_id": "9a3a0021-3640-3a7b-a4bd-2b5cb3821035",
                                                "text": "Gomez feinted with his knife and the other man darted backward. He feinted again and the man moved to the side. The man feinted but Gomez didn't budge; he was anxious to get it on."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5340e14b-7f2f-334c-8c70-2199cca582c4",
                                        "entry_id": "9159ff11-ed8c-3ba7-bd84-66bdafb57403",
                                        "glosses": [
                                            "Of an attack or offensive movement: directed toward a different part from the intended strike."
                                        ],
                                        "tags": [
                                            "also",
                                            "not-comparable",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb0cd9ff-103a-366e-8455-d4f32c8ab930",
                                        "entry_id": "9159ff11-ed8c-3ba7-bd84-66bdafb57403",
                                        "glosses": [
                                            "Feigned, counterfeit, fake."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92988c95-b2cb-4264-a48a-520cbbdb5130",
                                                "sense_id": "fb0cd9ff-103a-366e-8455-d4f32c8ab930",
                                                "text": "We force ourselves to be hypocrites, and hide our wrongs from them; we speak of a bad father with false praises; we wear feint smiles over our tears and deceive our children—deceive them, do we?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3456f43b-b5e8-3830-ae6e-7649528ece47",
                                        "entry_id": "f843e56c-a434-3e2a-8243-50f6826a343a",
                                        "glosses": [
                                            "Of lines printed on paper as a handwriting guide: not bold; faint, light; also, of such paper: ruled with faint lines of this sort."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
