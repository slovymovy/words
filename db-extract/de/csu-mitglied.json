                "senses": [
                    {
                        "sense_id": "5e306dd6-652d-3144-a7da-24a9d96f9b12",
                        "entry_id": "408811cc-5dfd-383c-b09a-edf946bd61cd",
                        "glosses": [
                            "Person, die in die CSU (Christlich-Soziale Union) eingetreten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f40de2-1def-47ff-a2fc-ccae5ba9253b",
                                "sense_id": "5e306dd6-652d-3144-a7da-24a9d96f9b12",
                                "text": "„Das CSU-Mitglied Pauli bezichtigt die bayerische Staatskanzlei, sie auf der Suche nach kompromittierenden Informationen aus ihrem Privatleben bespitzelt zu haben.“"
                            },
                            {
                                "example_id": "e8b4db09-3596-4a1e-801f-e74ab3ee35a8",
                                "sense_id": "5e306dd6-652d-3144-a7da-24a9d96f9b12",
                                "text": "„79,3 Prozent der CSU-Mitglieder sind männlich, bei der AfD sind es 83 Prozent.“"
                            }
                        ],
