                "senses": [
                    {
                        "sense_id": "4b3ada0e-64ea-3461-a04c-7e665bb644d6",
                        "entry_id": "25cffee5-5141-3fab-8006-040c3566eae9",
                        "glosses": [
                            "Land, das bei einer internationalen Veranstaltung (z.B. einer Messe) zu Gast ist und sich besonders präsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f405df3-a718-48f6-9c65-0ebbbb8db245",
                                "sense_id": "4b3ada0e-64ea-3461-a04c-7e665bb644d6",
                                "text": "„Georgien wird 2018 das Gastland der Frankfurter Buchmesse sein, und mich zieht es in die Kloster- und Weinregion Kachetien: weiche, grüne Hügel, malerische, tief in den Wäldern versteckte Kirchen, Margeritenfelder, Esel, Pferde und in der Ferne die schneebedeckten Berge des Kaukasus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a204577-7587-3cb4-84f9-dc91cad66634",
                        "entry_id": "25cffee5-5141-3fab-8006-040c3566eae9",
                        "glosses": [
                            "das Land, in dem sich ein Ausländer als Besucher (für kurze Zeit) aufhält"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61d3be79-1df1-4775-9e59-47a053cb1321",
                        "source_entry_id": "25cffee5-5141-3fab-8006-040c3566eae9",
                        "source_sense_id": "4b3ada0e-64ea-3461-a04c-7e665bb644d6",
                        "source_sense_description": "Land, das bei einer internationalen Veranstaltung (z.B. einer Messe) zu Gast ist und sich besonders präsentiert",
                        "target_lang_word": "guest nation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5326f4a6-cf5d-456b-98a6-e5766334dfd8",
                        "source_entry_id": "25cffee5-5141-3fab-8006-040c3566eae9",
                        "source_sense_id": "4b3ada0e-64ea-3461-a04c-7e665bb644d6",
                        "source_sense_description": "Land, das bei einer internationalen Veranstaltung (z.B. einer Messe) zu Gast ist und sich besonders präsentiert",
                        "target_lang_word": "gastland",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gastland",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "93554030-12ed-3f1c-8045-bbd44bff0baf",
                                        "entry_id": "5ec65042-c465-3791-8152-ca3f2174ecd4",
                                        "glosses": [
                                            "een land dat een evenement huisvest; ontvangende natie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a5fd64-4ebe-45b2-a857-39d9ebadf805",
                                                "sense_id": "93554030-12ed-3f1c-8045-bbd44bff0baf",
                                                "text": "Ambassades willen volgens minister Stef Blok (Buitenlandse Zaken) niet graag bekend staan om hun gebrek aan respect voor de wet van het gastland. „Het publiceren van een ranglijst is daarom naar verwachting een effectieve prikkel voor diplomatieke en consulaire missies en internationale organisaties om personeel te wijzen op hun gedrag in het verkeer.”"
                                            },
                                            {
                                                "example_id": "7ddab249-fca0-4ba8-9282-c65e4bf7a782",
                                                "sense_id": "93554030-12ed-3f1c-8045-bbd44bff0baf",
                                                "text": "Grote steden worden overspoeld door toeristen. Is het dan niet netjes om als gastland je hierop aan te passen? Patrick Geradts kan zich hier juist wel in vinden: „Engels is een wereldtaal, niets mis mee. Laat dat kleinzielige gedoe achterwege. Met films op TV heb je toch ook geen probleem?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d775dfe-dee3-4695-ba1e-4dd856b5b404",
                        "source_entry_id": "25cffee5-5141-3fab-8006-040c3566eae9",
                        "source_sense_id": "1a204577-7587-3cb4-84f9-dc91cad66634",
