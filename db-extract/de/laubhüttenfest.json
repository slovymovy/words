                        ],
                        "form": "das Laubhüttenfest"
                    },
                    {
                        "form_id": "17788d96-6b15-4815-bc9b-05d47ba492b7",
                        "entry_id": "215d5213-dabf-306d-91f5-f070d81df754",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Laubhüttenfeste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                        "entry_id": "215d5213-dabf-306d-91f5-f070d81df754",
                        "glosses": [
                            "alljährliches, fünf Tage nach Jom Kippur begangenes Fest, das sieben Tage, vom 15. bis 21. Tischri, dauert und während dem traditionellerweise in eigens für die Dauer des Festes gebauten Laubhütten (auf Dächern, Terrassen, im Garten, Hof) oder in mit Laub geschmückten Zimmern gegessen (und gewohnt) wird"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "a8adda44-e29c-4c57-9137-d64799950b58",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Die Hamburger Jüdische Gemeinde wollte am Sonntag das Laubhüttenfest Sukkot feiern.“"
                            },
                            {
                                "example_id": "f7313731-7d93-4a12-ade6-f5e0c60c87c9",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Wegen des jüdischen Laubhüttenfestes riegelt Israel für die kommenden elf Tage die Palästinensergebiete ab.“"
                            },
                            {
                                "example_id": "59fe057a-b999-466b-a296-52bd05a36d3e",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Schon die Feier des Laubhüttenfestes oder gar eine Heiligung des Sabbats fand im großelterlichen Hause nicht statt; und in den folgenden Generationen trat — bei allem, oft trotzigen Betonen der Stammeszugehörigkeit — gegenüber dem Geist jüdischer Religion eher Gleichgültigkeit, ihren äußeren Formen gegenüber Widerstand, wenn nicht gar spöttisches Verhalten zutage.“"
                            },
                            {
                                "example_id": "aa304d10-29f4-448c-99cb-6fda2b0a3358",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Zu Sukkot, dem Laubhüttenfest, steht hier eine Hütte aus Zweigen, Stroh und Laub, in der man durch acht Tage ißt und schläft.“"
                            },
                            {
                                "example_id": "1f851c3b-7834-4823-bd08-c6befa6a71dc",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Schon in biblischer Zeit feierten die Israeliten eine gute Ernte mit ihren Wochen- und Laubhüttenfesten.“"
                            },
                            {
                                "example_id": "c95654c1-7bcf-466e-ba47-5b0a3c10661a",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„An den Münzbildern kann man dann jeweils ablesen, wie stark die Pressionen der Besatzungsmacht jeweils waren, ob sich die Prägungen auf die jüdische Tradition mit Lulav (Palmzweig) und Ethrog (Zitrone) als Symbole des Laubhüttenfests, auf den Siebenarmigen Leuchter, auf Harfe und Trompeten beschränken durften, oder ob Porträts und Embleme des römischen Weltreichs in Umlauf gebracht wurden.“"
                            },
                            {
                                "example_id": "bcc69536-2e9e-4960-9252-89f97cb43872",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Die Nordhäuser Familien jüdischen Glaubens hatten darin ihre Laubhüttenfeste gefeiert.“"
                            },
                            {
                                "example_id": "1cbe0613-13ee-45c3-939f-7fafc571b5ea",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Moses erhielt von Gott den Auftrag, sie [Anmerkung: die Israeliten] ins gelobte Land Kanaan zu führen. 40 Jahre soll die Wanderung durch die Wüste gedauert haben. Unterwegs lebten sie sie in \"Sukkot\" (Hütten). Daran erinnert das Laubhüttenfest, das jüdische Erntedankfest. Gläubige ziehen im Herbst nach Obsternte und Weinlese dort ein.“"
                            },
                            {
                                "example_id": "40089fe8-2e2f-4570-8312-9443ca592341",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "[Israelische Siedlungen im besetzten Westjordanland:] „Die Oberrabbiner Israels hatten eigens eine Genehmigung für die Bautätigkeit erteilt, trotz des religiösen Arbeitsverbots während des derzeitigen Laubhüttenfestes.“"
                            },
                            {
                                "example_id": "219ab965-6e2f-4f05-b923-8621cda68170",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "„Zum Beginn des jüdischen Laubhüttenfestes ist die Lage auf dem Tempelberg in Jerusalem noch einmal eskaliert. Die Al-Aksa-Moschee wurde geschlossen.“"
                            },
                            {
                                "example_id": "393fbe96-3c19-41e6-8941-194512c4cb13",
                                "sense_id": "05248a22-20ae-33c4-9d20-3fe1f69bf731",
                                "text": "[Neubau eines Bet- und Lehrhauses der drei monotheistischen Religionen in Berlin:] „[…] die Synagoge braucht Platz auf dem Dach für die Hütte zum Laubhüttenfest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
