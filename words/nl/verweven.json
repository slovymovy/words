                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to interweave",
                                "target_lang_sense_clarification": "to weave together"
                            },
                            {
                                "target_lang_word": "to weave in",
                                "target_lang_sense_clarification": "to incorporate by weaving"
                            },
                            {
