                            {
                                "example_id": "f4f5eebf-d40c-44fb-bbfc-8318e0901c22",
                                "sense_id": "84828dd3-eada-35af-a7e6-d12e15ce7f74",
                                "text": "„Im silberfarbenen Halbschatten des Buschwerks ließ er sie nicht aus den Augen.“"
                            }
                        ],
