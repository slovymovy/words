                                "target_senses": [
                                    {
                                        "sense_id": "e7f7c785-ea15-32bb-83eb-272606c55698",
                                        "entry_id": "9fb2f2d3-3c29-3a60-a0eb-0aab18a9c5f1",
                                        "glosses": [
                                            "Any secondary mineral, deposited in a natural cave by the action of water. Includes formations such as stalactites, stalagmites, flowstones, and helictites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7accc4c4-13da-4c60-b814-b54c6011e3d0",
                                                "sense_id": "e7f7c785-ea15-32bb-83eb-272606c55698",
                                                "text": "But it is possible that the painting itself might be thousands of years older because the technique only assesses the age of a mineral deposit, speleothem, that formed on the cave walls."
                                            }
                                        ]
                                    }
                                ]
                            }
