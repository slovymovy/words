                "senses": [
                    {
                        "sense_id": "702fb4de-eba7-3c79-869f-35bdf53eb26a",
                        "entry_id": "7354d041-8c2c-31d4-bf09-45dcbf3374be",
                        "glosses": [
                            "Qui découle ou s’apparente à la pensée de Gilles Deleuze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d4e621-9a48-4c35-bda0-0b09d31c2dfe",
                                "sense_id": "702fb4de-eba7-3c79-869f-35bdf53eb26a",
                                "text": "Mais un jour, peut-être, le siècle sera deleuzien."
                            },
                            {
                                "example_id": "a0242415-130e-40bf-9d71-63989444a51b",
                                "sense_id": "702fb4de-eba7-3c79-869f-35bdf53eb26a",
                                "text": "Elle était sous emprise, comme tant d’autres, hommes ou femmes, le furent tout au long de la vie du philosophe. J’en ai connu, à Vincennes et ailleurs, qui imitaient sans s’en rendre compte le timbre, le rythme, les modulations de la voix deleuzienne."
                            },
                            {
                                "example_id": "a7aa8c8f-a929-45c8-8303-95ce7f495489",
                                "sense_id": "702fb4de-eba7-3c79-869f-35bdf53eb26a",
                                "text": "Malgré ses proclamations antisoixantehuitardes, le PR semble avoir mis en place un fonctionnement deleuzien : l'Élysée est un rhizome."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03072ad2-893d-408a-8f0b-9a079c0641ac",
                        "source_entry_id": "7354d041-8c2c-31d4-bf09-45dcbf3374be",
                        "source_sense_id": "702fb4de-eba7-3c79-869f-35bdf53eb26a",
