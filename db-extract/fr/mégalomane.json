                ],
                "senses": [
                    {
                        "sense_id": "c18b885f-cad8-346f-bc52-974a878c4fc1",
                        "entry_id": "6533ee6f-8d02-3d0b-849e-a6a50c2cecbe",
                        "glosses": [
                            "Qui est atteint de mégalomanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5b4872-71d3-47cb-9618-16c0c728bedc",
                                "sense_id": "c18b885f-cad8-346f-bc52-974a878c4fc1",
                                "text": "Processus évidents sous les règnes de Louis XV et Louis XVI, dont les gouvernements ne poursuivaient pas la politique de contrôle social, d’imposition et de guerre totale de Louis XIV, notre Roi-Soleil mégalomane."
                            },
                            {
                                "example_id": "dec7f510-384a-4d5c-bc9c-5f0e4e643053",
                                "sense_id": "c18b885f-cad8-346f-bc52-974a878c4fc1",
                                "text": "Piot est bien supérieur à Courtois. Non seulement il n'a pas commis toutes les boulettes dont Courtois à fait sa spécialité (contre Liverpool, Barcelone ou la Russie et j'en oublie) mais en plus Piot n'a jamais eu une grande gueule de mégalomane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08a3cf1b-8327-458b-880c-8274edaa50c4",
                        "source_entry_id": "6533ee6f-8d02-3d0b-849e-a6a50c2cecbe",
                        "source_sense_id": "c18b885f-cad8-346f-bc52-974a878c4fc1",
                        "target_lang_word": "megalomaniacal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megalomaniacal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "036437ff-7d45-34d9-9517-3a44cde50276",
                                        "entry_id": "f8896111-1a6f-38a8-b343-72586562d5e0",
                                        "glosses": [
                                            "Megalomaniac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4be926f-ef19-4543-8d22-c194ffc4bdff",
                                                "sense_id": "036437ff-7d45-34d9-9517-3a44cde50276",
                                                "text": "It is Maruyama in the title role who makes this rather silly, overwrought plot work. He is alternately sinister and coy, megalomaniacal and vulnerable. He inhabits the role of a female master criminal effortlessly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86432bb1-8bdb-403f-80b2-8be91c594b6c",
