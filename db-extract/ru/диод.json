                                            {
                                                "example_id": "9fd8b4c1-5e96-461a-8537-43cf52aa6f7b",
                                                "sense_id": "84ef8c34-f1eb-34fa-843a-bd6a8fd49950",
                                                "text": "I propose to give the name diode to a tube with two electrodes."
