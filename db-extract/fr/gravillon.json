                "entry_id": "ebb3ac27-9ce9-3a5f-8540-ff79d831cc3b",
                "word": "gravillon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f1ff47cd-04a9-4a57-8828-907d1ec6b0a1",
                        "entry_id": "ebb3ac27-9ce9-3a5f-8540-ff79d831cc3b",
                        "tags": [
                            "plural"
                        ],
                        "form": "gravillons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                        "entry_id": "ebb3ac27-9ce9-3a5f-8540-ff79d831cc3b",
                        "glosses": [
                            "Fin gravier rond ou concassé dont la granularité varie de quatre à vingt millimètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3cfb9d5-3d91-4a22-9fcb-2886e151866d",
                                "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                "text": "Par exemple, un gravillon d’appellation 4/16 comporte moins de 15 % de grains de diamètre inférieur à 4 mm et moins de 10 % de grains de diamètre supérieur à 16 mm."
                            },
                            {
                                "example_id": "6fc28d6f-ab77-460e-9036-f358ba37f1e2",
                                "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                "text": "Theodor Adorno raconte méchamment que des gamins jetaient des gravillons dans le parapluie de Nietzsche, qui retombaient en averse sur sa tête dès qu'il l'ouvrait."
                            },
                            {
                                "example_id": "7467f73a-26ca-4093-a664-b6d0086effa7",
                                "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                "text": "D’après les premières constatations, la chute est survenue dans un virage avec des gravillons après une descente importante. Les deux jeunes filles étaient sur la trottinette, non casquées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dd7c19f-d416-4223-b30f-f26339fa37aa",
                        "source_entry_id": "ebb3ac27-9ce9-3a5f-8540-ff79d831cc3b",
                        "source_sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                        "target_lang_word": "gravel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "302ffa1f-a32a-36be-b991-45cd619ece63",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "Small fragments of rock, used for laying on the beds of roads and railways, and as ballast."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f00e43d2-86ee-36a6-bdde-bc767edd22ce",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "A type or grade of small rocks, differentiated by mineral type, size range, or other characteristics."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f854325-5f20-3267-a140-c14dd9892dac",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "A particle from 2 to 64 mm in diameter, following the Wentworth scale."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdaeb2cf-85b8-3a31-8118-6c7d3351e86f",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "Kidney stones; a deposit of small calculous concretions in the kidneys and the urinary or gall bladder; also, the disease of which they are a symptom."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e57c1e-e64a-4a55-b8c6-f8ef68695048",
                                                "sense_id": "cdaeb2cf-85b8-3a31-8118-6c7d3351e86f",
                                                "text": "The great use of coffee in France is supposed to have abated the prevalency of the gravel, for where coffee is used as a constant beverage, the gravel and the gout are scarcely known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83da1cda-f327-3591-b970-f44d5da3ca8c",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "A lameness in the foot of a horse, usually caused by an abscess."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65c8b1d9-8461-463f-89ed-a4467d151171",
                                                "sense_id": "83da1cda-f327-3591-b970-f44d5da3ca8c",
                                                "text": "The defendant below hired the horse to go from Cocksackie to Schodack, and the next day after his arrival at the latter place, the horse was found to be lame in one foot; and the lameness increasing, the defendant below was obliged to leave the horse there, and hire another with which to return. About four weeks after, the horse was brought home, and showed signs of gravel working out above the hoof."
                                            },
                                            {
                                                "example_id": "90ebd80b-53d9-45a0-9b08-02fbc2b78daf",
                                                "sense_id": "83da1cda-f327-3591-b970-f44d5da3ca8c",
                                                "text": "'Looks like pus in the foot to me.'\n'I'll bet you're right,' Farnon said. 'They call it gravel around here, by the way. What do you suggest we do about it?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40dda94d-b2c2-3fca-acf4-e2aebfafd53a",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "Inability to see at night; night blindness."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "435977c3-9178-4869-9df5-5216f06cf948",
                                                "sense_id": "40dda94d-b2c2-3fca-acf4-e2aebfafd53a",
                                                "text": "A malady that was rare, but which because of its peculiarity elicited much comment, was \"night blindness\" or \"gravel.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e43c75-edd1-3fbd-a19a-4aedb5a7170f",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "Gravel cycling, a discipline in cycling different from road cycling, mountain biking or cyclocross, for a large part on gravel roads, typically with a dedicated gravel bike."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36ca7831-64a5-3a08-8d84-ad0e2729204d",
                                        "entry_id": "f188d97a-f76e-3bff-bc29-a7085bc435c2",
                                        "glosses": [
                                            "The stimulant drug alpha-pyrrolidinopentiophenone."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gravel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2569a08a-b16f-3701-be29-1b05c0adbd94",
                                        "entry_id": "9ade3eca-58e0-3dad-b55d-830d3a4b3e0e",
                                        "glosses": [
                                            "To apply a layer of gravel to the surface of a road, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61de861a-d8df-4037-9d1e-8388928e148a",
                                                "sense_id": "2569a08a-b16f-3701-be29-1b05c0adbd94",
                                                "text": "We kept quietly on our way until we reached a place in the road that had been freshly graveled, and where the surface was covered with stones just suited to our use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50bc0cad-7289-39ac-8554-193d3f770bf3",
                                        "entry_id": "9ade3eca-58e0-3dad-b55d-830d3a4b3e0e",
                                        "glosses": [
                                            "To puzzle or annoy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74edfa96-1a4d-42bc-a3bb-de538dffd9f7",
                                                "sense_id": "50bc0cad-7289-39ac-8554-193d3f770bf3",
                                                "text": "It graveled me like sixty to pay such a price, but I had to do it because the season was just between hay and grass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d9e77a-ead9-31ae-a5ec-b53c57efd8a0",
                                        "entry_id": "9ade3eca-58e0-3dad-b55d-830d3a4b3e0e",
                                        "glosses": [
                                            "To run (as a ship) upon the gravel or beach; to run aground; to cause to stick fast in gravel or sand."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69da7ef9-d69e-47c3-8dbf-49de724e6723",
                                                "sense_id": "36d9e77a-ead9-31ae-a5ec-b53c57efd8a0",
                                                "text": "1605, William Camden, “Grave Speeches and wittie Apothegms of worthy Personages of this Realm in former times,” in Remaines Concerning Britain, London: Simon Miller, sixth impression, 1657, p. 243,\nWilliam Conqerour when he invaded this Iland, chanced at his arrival to be gravelled, and one of his feet stuck so fast in the sand, that he fell to the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9abe7a8e-5c5e-31b4-ba3f-9258aa19b95f",
                                        "entry_id": "9ade3eca-58e0-3dad-b55d-830d3a4b3e0e",
                                        "glosses": [
                                            "To check or stop; to confound; to perplex."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d92608b-80ea-4575-a4e5-f767412fe5ac",
                                                "sense_id": "9abe7a8e-5c5e-31b4-ba3f-9258aa19b95f",
                                                "text": "The physician was so gravelled and amazed withal, that he had not a word more to say."
                                            },
                                            {
                                                "example_id": "8d08511b-3271-4e8f-a530-5d329c187c90",
                                                "sense_id": "9abe7a8e-5c5e-31b4-ba3f-9258aa19b95f",
                                                "text": "When you were gravelled for lack of matter."
                                            },
                                            {
                                                "example_id": "4d44c864-72db-42f1-be70-af6ec54d3240",
                                                "sense_id": "9abe7a8e-5c5e-31b4-ba3f-9258aa19b95f",
                                                "text": "[…] I arrived at a spot where I was completely gravelled, and could go no farther one way or the other; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2adecb46-be27-3e1e-a7c2-d110add19e86",
                                        "entry_id": "9ade3eca-58e0-3dad-b55d-830d3a4b3e0e",
                                        "glosses": [
                                            "To hurt or lame (a horse) by gravel lodged between the shoe and foot."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3c4e3d7-a414-3eed-9cfc-6ca2d60e02d7",
                                        "entry_id": "9ade3eca-58e0-3dad-b55d-830d3a4b3e0e",
                                        "glosses": [
                                            "To prostrate; to beat to the ground."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
