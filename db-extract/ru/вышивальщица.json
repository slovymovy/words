                        "target_lang_word": "Stickerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stickerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                        "entry_id": "05ad126d-cb91-3584-ac91-c77fe53b3cb3",
                                        "glosses": [
                                            "weibliche Person, die mit Nadel und Faden/Stickgarn Gewebe verziert, indem sie Zierstiche setzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eaf9f33-e20d-49fb-97f7-c985b38d97a9",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "Sie war eine Künstlerin am Stickrahmen, ein Ausnahmetalent unter den Stickerinnen des Viertels."
                                            },
                                            {
                                                "example_id": "fc203517-88d2-43cc-a09b-6451a15c6320",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "Die Tochter verdiente ihr Geld als Stickerin von Monogrammen, die sie in Heimarbeit für ein Wäschegeschäft anfertigte."
                                            },
                                            {
                                                "example_id": "bc5b69d6-0736-4608-b52f-5800dae492fe",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "„Das traf mich wie ein Blitz aus heiterem Himmel; aber ich nahm seinen Verweis kaltblütig hin und sagte, ich würde die Zeit, die ich bisher bei der Stickerin verbracht hätte, fortan anderswo zubringen.“"
                                            },
                                            {
                                                "example_id": "f1432f9d-c91c-4366-af98-b14543a8f9f8",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "„Das galt nicht nur für Stickerinnen, sondern auch für Knopfgießer, Hutmacher, Schuhmacher, Goldschmiede und Strickerinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b597af5-73e8-4485-8c90-af2ff8a7208a",
                        "source_entry_id": "95df4350-72d9-3d82-83f3-ac8b0ff2d842",
