                        "glosses": [
                            "Personne qui coupe avec des cisailles, pour son métier ou pour d’autres raisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93c1303-6b36-43cf-9fae-83d56ae10d00",
                                "sense_id": "f41db469-30c2-34f2-8a79-3fa63c36078f",
                                "text": "Vingt secondes avaient suffi pour que le cisailleur hisse sur son épaule la masse inerte des cent quinze chevaux et s’active d’une démarche de Frankenstein accentuée par l’instabilité du ponton vers le quai."
                            },
                            {
                                "example_id": "a2990049-9abd-488c-b8bb-31f0cb91624e",
                                "sense_id": "f41db469-30c2-34f2-8a79-3fa63c36078f",
                                "text": "À la première panne, le cisailleur de service avait tenté d’émettre un avis."
                            },
                            {
                                "example_id": "23130ca3-2771-4353-b107-50373996a6fc",
                                "sense_id": "f41db469-30c2-34f2-8a79-3fa63c36078f",
                                "text": "Cette semaine encore, l’équipe des Cisailles a cessé le travail ; les cisailleurs demandaient 30 francs de l’heure d'augmentation et l'amélioration de la prime de production."
                            }
                        ]
                    }
