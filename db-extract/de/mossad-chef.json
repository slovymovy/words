                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4c520d-61bd-4b7d-8a9b-eb0a598804c0",
                                "sense_id": "e4aa4ec5-151d-3fbe-bd74-3e527d4393be",
                                "text": "„Angeblich hatte Oufkir den Mossad-Chef Meir Amit gebeten, ihm bei der Liquidierung Ben Barkas zu helfen, der im Oktober 1965 verschwand und nie wieder gesehen wurde.“"
                            },
                            {
                                "example_id": "f112c7d0-454c-46d6-888d-5575bae2d91b",
                                "sense_id": "e4aa4ec5-151d-3fbe-bd74-3e527d4393be",
                                "text": "„Ende Oktober legte eine israelische, von Zvi Zamir, dem früheren Mossad-Chef, geleitete Untersuchungskommission ihren Bericht zu den blutigen Ereignissen vor.“"
                            }
                        ],
