                        {
                            "text": "He dropped his keys down the drain and muttered, \"<w>Bugger</w>!\"",
                            "target_lang_translations": {
                                "ru": "Он уронил ключи в водосток и пробормотал: «<w>Блин</w>!»"
                            }
                        }
                    ],
                    "synonyms": [
                        "bummer",
                        "damn",
                        "rats",
                        "whoops"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее раздражение, разочарование или неудовольствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черт возьми",
                                "target_lang_sense_clarification": "выражение досады"
                            },
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "выражение разочарования"
                            },
                            {
                                "target_lang_word": "проклятье",
                                "target_lang_sense_clarification": "выражение раздражения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}