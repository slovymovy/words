                                            {
                                                "example_id": "9201cd26-26d9-4f95-9762-a5281375157f",
                                                "sense_id": "c03933c8-ad74-346c-9c43-c2c8f825cdb4",
                                                "text": "Wrok!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07769067-6da9-3cc2-8388-6829f572442a",
                                        "entry_id": "c6cbc3ef-edd5-33bb-b330-e3c023550563",
