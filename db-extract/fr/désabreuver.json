                        "glosses": [
                            "Ne plus abreuver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e00293-3b51-4664-82ac-d3ffbf8d8e6f",
                                "sense_id": "de7917c3-d4b4-3598-a654-9ca366d509ba",
                                "text": "Les amours suprêmes se délitent, Des amis fidèles réinvitent D’infidèles images désabreuvent, Délicates jeunes filles, jolies veuves."
                            },
                            {
                                "example_id": "eb8af8ba-3d91-4866-8709-d7aa19e8406a",
                                "sense_id": "de7917c3-d4b4-3598-a654-9ca366d509ba",
                                "text": "La pompe est désabreuvée."
                            },
                            {
                                "example_id": "9f5d3613-dc5c-401c-93ac-883be999941a",
                                "sense_id": "de7917c3-d4b4-3598-a654-9ca366d509ba",
                                "text": "L'abreuvoir est « désabreuvé » ! A sec !"
                            },
                            {
                                "example_id": "f801f714-a12b-4600-b90f-5b6185a96d24",
                                "sense_id": "de7917c3-d4b4-3598-a654-9ca366d509ba",
                                "text": "Au milieu de cette avenue se trouve un mur, seul refuge contre certaine misère dont se désabreuve journellement la vie humaine."
                            }
                        ]
                    }
