                        "source_sense_id": "294d7396-878b-3925-a805-000d6588dfc4",
                        "target_lang_word": "inspecter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inspecter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                        "entry_id": "727d12cd-9404-3f14-8e2a-b57b53c105b2",
                                        "glosses": [
                                            "Examiner avec attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4829f23-3ef7-4e2f-81c3-9f4bf84617bd",
                                                "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                                "text": "Puis, cela fait, il acheva de se déshabiller, non sans inspecter les poches de ses autres vêtements, à seule fin de s'assurer qu'on n'y avait rien fourré à son insu."
                                            },
                                            {
                                                "example_id": "65a730c8-9283-47a6-bee9-404fd6f6db41",
                                                "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                                "text": "Au jour, j’inspecte minutieusement les avaries et consolide les réparations provisoires de la nuit."
                                            },
                                            {
                                                "example_id": "b15d824a-f24b-4b02-9e3c-8e0644735e62",
                                                "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                                "text": "C’était la première fois qu’il se risquait au Montparnasse. Ses regards inspectèrent la salle et, finalement, se fixèrent sur la grosse nuque puissante de Feempje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                        "entry_id": "727d12cd-9404-3f14-8e2a-b57b53c105b2",
                                        "glosses": [
                                            "Examiner avec autorité, ou avec une mission spéciale d’une autorité compétente."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2780b61-1673-4b33-91e6-0d0f6dec2e74",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Le Prince les inspecta, comme s’il eût passé une revue, à cheval sur un fringant coursier."
                                            },
                                            {
                                                "example_id": "9ef966f4-188d-4c48-8c2a-db01e456f04f",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Il fut chargé d’inspecter ces magasins."
                                            },
                                            {
                                                "example_id": "59c6d041-c523-48f9-ab50-a81732167d5b",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Ils ne se retirèrent qu’après avoir soigneusement inspecté toute la maison."
                                            },
                                            {
                                                "example_id": "ca75febf-80b9-4b8e-a3ca-571dbee330f9",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Inspecter des travaux publics, un collège, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
