                    {
                        "form_id": "901c04ca-3148-49d0-8b6d-1244a60d3336",
                        "entry_id": "76bbf294-97ea-33ef-8525-5d7801a342ea",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Friedensverträge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                        "entry_id": "76bbf294-97ea-33ef-8525-5d7801a342ea",
                        "glosses": [
                            "Vereinbarung zwischen kriegführenden Parteien, zukünftig Frieden zu bewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f17f2a-a296-488b-933e-e11c9e24f515",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "[…] Ägypten [unterzeichnete] am 17. September 1978 den Friedensvertrag mit Israel, das Camp-David-Abkommen."
                            },
                            {
                                "example_id": "58532031-06cf-4bea-b51f-de66cc92447f",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "[Nach dem Koreakrieg] gibt es [auch 65 Jahre nach Ende der Kampfhandlungen] nur einen Waffenstillstand zwischen Nordkorea, China und den USA - ohne einen Friedensvertrag."
                            },
                            {
                                "example_id": "4209f071-e920-41b0-ae03-bd6728724298",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "Am Montag wurde der Friedensvertrag unterschrieben."
                            },
                            {
                                "example_id": "18b4b092-58b5-4553-9b24-5f0a7456eec3",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "Die aus Historikersicht bedeutendsten drei Friedensverträge sind wahrscheinlich der Westfälische Frieden, die Wiener Kongressakte und der Vertrag von Versailles."
                            },
                            {
                                "example_id": "d85e77b6-73df-4e1f-aa7d-84b14d76668a",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "„Am 30. Mai 1814 wurde in Paris der Friedensvertrag mit Frankreich geschlossen.“"
                            },
                            {
                                "example_id": "89c88dac-3fe9-4749-9c7c-1503200ecd64",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "„Doch als Christin und Kennerin der Fremden gelang es ihr, sich später in einem Friedensvertrag mit ihnen zu arrangieren.“"
                            },
                            {
                                "example_id": "f4dbc774-9288-429b-9085-f7b06d94b6d3",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "„Es gelingt ihr, einen Friedensvertrag zu schließen.“"
                            },
                            {
                                "example_id": "040de23a-37ae-4dba-b172-dcff54aae1ce",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "Rund eineinhalb Jahre nach dem historischen Friedensvertrag in Kolumbien hat ein Sondergericht seine Arbeit aufgenommen."
                            },
                            {
                                "example_id": "993eeb6b-68dc-4580-a551-56d968b0ddfe",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "Vor 85 Jahren beendete der Friedensvertrag von Riga den Krieg zwischen Polen und Russland."
                            },
                            {
                                "example_id": "333234a5-6694-434b-bbdf-e728b4e2854c",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "Der Friedensvertrag von Versaille verbot die Wiederbewaffnung Deutschlands."
                            },
                            {
                                "example_id": "29997dce-520f-4f0e-a557-b5b401405262",
                                "sense_id": "86eb0bff-e1d1-32a1-b1ee-f1687c85c3c2",
                                "text": "Im Mittelpunkt [des Gipfeltreffens des russischen Präsidenten Wladimir Putin mit dem japanischen Ministerpräsident Junichirō Koizumi] wird ein Friedensvertrag zwischen den beiden Staaten stehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
