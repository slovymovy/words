            {
                "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                "word": "homologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "412f3529-30f7-41da-b167-6fe26e8eddc7",
                        "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "tags": [
                            "plural"
                        ],
                        "form": "homologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c78550c9-34db-34ef-b37b-f11b8a8a73cc",
                        "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "glosses": [
                            "Qualité de ce qui est homologue."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "ee8be58d-50b1-4afe-9f51-34eb2bb39154",
                                "sense_id": "c78550c9-34db-34ef-b37b-f11b8a8a73cc",
                                "text": "Leur but est de démontrer l’homologie de la flore et de la faune dans trois stations édaphiquement et climatiquement proches, distantes d'une dizaine de kilomètres."
                            },
                            {
                                "example_id": "ee6d1032-fae7-4ec8-b032-1fce0575ae56",
                                "sense_id": "c78550c9-34db-34ef-b37b-f11b8a8a73cc",
                                "text": "À partir de la seule observation attentive de ce graphe global et des communautés cohésives qui le constituent, on peut déjà signaler une première caractéristique de la cathosphère : elle présente une homologie structurale avec le champ politique."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef9b47fe-6f61-3ffe-a177-79eb933a079a",
                        "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "glosses": [
                            "Similarité de caractères observée chez plusieurs espèces différentes, héritée d’un ancêtre commun."
                        ],
                        "tags": [
                            "Biologie évolutive",
                            "Anatomie comparée"
                        ],
                        "examples": [
                            {
                                "example_id": "94ca93c1-5176-4364-b79a-8e32de347413",
                                "sense_id": "ef9b47fe-6f61-3ffe-a177-79eb933a079a",
                                "text": "Cette homologie anatomique signifie qu’ils descendent d’un ancêtre commun."
                            },
                            {
                                "example_id": "040e0098-04c7-48aa-8ce6-641cc2b767c6",
                                "sense_id": "ef9b47fe-6f61-3ffe-a177-79eb933a079a",
                                "text": "Si le destin neurologique d’un patient humain est heureusement moins sévère que celui que nous venons de décrire chez le singe, force est de reconnaître qu’il partage néanmoins avec lui de nombreuses homologies. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 39)"
                            }
                        ]
                    },
                    {
                        "sense_id": "e191a6f4-69c5-3eac-a7a2-449c00cd521b",
                        "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "glosses": [
                            "Bijection d’un espace dans lui-même ayant un hyperplan invariant point par point."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a93f15-ec1c-45bf-bf2d-e4d6f9f45dda",
                                "sense_id": "e191a6f4-69c5-3eac-a7a2-449c00cd521b",
                                "text": "Montrer que, dans un espace projectif, le composé de deux homologies harmoniques de même hyperplan et de centres distincts, est une élation."
                            }
                        ]
                    },
                    {
                        "sense_id": "0038ea00-a336-346e-90bb-d2f77ae504de",
                        "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "glosses": [
                            "Technique générale en mathématiques qui sert à mesurer l’obstruction qu’ont certaines suites de morphismes à être exactes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07097ad-4aec-4604-a278-f96ede6aed5b",
                                "sense_id": "0038ea00-a336-346e-90bb-d2f77ae504de",
                                "text": "Cette droite représente en homologie l’obstruction qui donne la première classe de Chern du fibré universel sur [P2] ."
                            }
                        ]
                    },
                    {
                        "sense_id": "a37f7c01-4367-3aa1-ad53-5b45a156e6e0",
                        "entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "glosses": [
                            "Similitude entre la position sociale et le comportement des individus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cace12c8-1c7a-4180-88bd-9c3aab438b54",
                                "sense_id": "a37f7c01-4367-3aa1-ad53-5b45a156e6e0",
                                "text": "Il s’agit alors d’établir des principes d’homologie entre les positions sociales des individus et leurs prises de position […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f7859d3-be77-4b37-8ea6-1623fcef542e",
                        "source_entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "target_lang_word": "Homologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a899f685-1d16-3aff-8fbc-68c730376ec8",
                                        "entry_id": "720bdc19-2dc0-313f-bfa8-797ba77bb5f2",
                                        "glosses": [
                                            "Übereinstimmen des Handelns mit der Vernunft und dadurch auch mit der Natur"
                                        ],
                                        "tags": [
                                            "Philosophie der Stoa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe07526-795b-4082-baac-f35b429452a2",
                                                "sense_id": "a899f685-1d16-3aff-8fbc-68c730376ec8",
                                                "text": "In der pythagoräischen Auffassung bedeutet Homologie sogar die Ähnlichkeit und Übereinstimmung des eigenen Lebens und Handelns mit Gott."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63f072d5-2146-386b-adb0-d39740f49502",
                                        "entry_id": "720bdc19-2dc0-313f-bfa8-797ba77bb5f2",
                                        "glosses": [
                                            "Übereinstimmung von biologischen Strukturen (Organe, Makromoleküle et cetera) oder Verhaltensanteilen hinsichtlich ihrer Entwicklungsgeschichte und nicht in Hinsicht auf ihre Funktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17b59735-c5a1-40ee-96f7-f7e8eb5eb887",
                                                "sense_id": "63f072d5-2146-386b-adb0-d39740f49502",
                                                "text": "„Zum Nachweis von Homologien und damit von Verwand[t]schaft bedient sich die vergleichende Biologie bestimmter Homologiekriterien.“"
                                            },
                                            {
                                                "example_id": "615d4a64-a3b3-4626-bf3d-0e7ff1e79b90",
                                                "sense_id": "63f072d5-2146-386b-adb0-d39740f49502",
                                                "text": "Man brauchte einige Zeit, um die Homologie zwischen den Füßen von Pferd und Nashorn festzustellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "50d9d20b-6802-376c-98ea-439b394aef00",
                                        "entry_id": "720bdc19-2dc0-313f-bfa8-797ba77bb5f2",
                                        "glosses": [
                                            "Folge von mathematischen Objekten"
                                        ],
                                        "tags": [
                                            "Topologie",
                                            "Algebra"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8436e8cc-cac1-4df4-9fbf-c659b76fd1c0",
                                                "sense_id": "50d9d20b-6802-376c-98ea-439b394aef00",
                                                "text": "Eine perspektive Kollineation heißt Homologie, wenn Achse und Zentrum nicht inzidieren, andernfalls Elation."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7f078dec-02b4-3326-9f10-0652c47e8c97",
                                        "entry_id": "720bdc19-2dc0-313f-bfa8-797ba77bb5f2",
                                        "glosses": [
                                            "die Eigenschaft eines sprachlichen Ausdrucks, der durch seine Form ein Beispiel für seine Bedeutung darstellt, also ein Homolog ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8cd6ed-5f47-4fe3-9abe-8f2fce4e7a18",
                                                "sense_id": "7f078dec-02b4-3326-9f10-0652c47e8c97",
                                                "text": "Ein Beispiel für eine Homologie ist der Terminus »achtzehnbuchstabig«, da er selbst 18 Buchstaben aufweist. Entsprechendes gilt für »dreisilbig«, »deutsch«, »kleingeschrieben« und »Substantiv«, während »lang«, »Verb«, »französisch« und so weiter keine Homologe sind."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "872527ac-aa7a-4b84-ae57-0eae11a99c15",
                        "source_entry_id": "e14b4f2a-72a1-3d54-85ba-c5cb9ba36761",
                        "target_lang_word": "homology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb92123c-28c7-3e5f-87dc-18e9ad1dc031",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "specifically, such relationship in the context of the geometry of perspective."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57ee2ab8-d3bf-4db9-b615-ce227f88528a",
                                                "sense_id": "bb92123c-28c7-3e5f-87dc-18e9ad1dc031",
                                                "text": "1863, George Salmon, A Treatise on Conic Sections, Longman, Brown, Green, Longman, and Roberts, 4th Edition, page 61,\nTwo triangles are said to be homologous, when the intersections of the corresponding sides lie on the same right line called the axis of homology: prove that the lines joining the corresponding vertices meet in a point [called the centre of homology]."
                                            },
                                            {
                                                "example_id": "06716ac8-675e-48ab-ba8a-ffa132404bd8",
                                                "sense_id": "bb92123c-28c7-3e5f-87dc-18e9ad1dc031",
                                                "text": "1885, Charles Leudesdorf (translator), Luigi Cremona, Elements of Projective Geometry, Oxford University Press (Clarendon Press), page 11,\nTwo corresponding straight lines therefore always intersect on a fixed straight line, which we may call s; thus the given figures are in homology, O being the centre, and s the axis, of homology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad0d8daf-a92f-34e6-ab6d-39d1f285d9e7",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "An automorphism of the projective plane (representing a perspective projection) that leaves all the points of some straight line (the homology axis) fixed and maps all the lines through some single point (the homology centre) onto themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d796163-1f04-469b-8a8c-c4f5cf6e94ee",
                                                "sense_id": "ad0d8daf-a92f-34e6-ab6d-39d1f285d9e7",
                                                "text": "If the homology centre lies on the homology axis, the homology is said to be singular or parabolic; otherwise, it is called non-singular or hyperbolic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec16d511-ba8d-32e0-a3ed-ab6a88a4718d",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "A general way of associating a sequence of algebraic objects, such as abelian groups or modules, to a sequence of topological spaces; also used attributively: see Usage notes below."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd162f3f-ce31-4edc-9a46-6414d7257721",
                                                "sense_id": "ec16d511-ba8d-32e0-a3ed-ab6a88a4718d",
                                                "text": "One encounters a similar situation in homology theory. Beside singular homology, which is a homotopy invariant, and Čech homology, which is a shape invariant, there exists strong homology, which is a strong shape invariant. In the special case of metric compacta, this homology was introduced by N.E. Steenrod in 1940 and is often referred to as the Steenrod homology."
                                            },
                                            {
                                                "example_id": "da0e1bf8-4da5-444a-839f-b183e7c550c6",
                                                "sense_id": "ec16d511-ba8d-32e0-a3ed-ab6a88a4718d",
                                                "text": "Brieskorn homology spheres are a special case of Siefert fibered homology spheres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78e4ba46-557c-321e-9268-f96b158b91e3",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "Given a chain complex {Gₙ} and its associated set of homomorphisms {Hₙ}, the rule which explains how each Hₙ maps Gₙ into the kernel of Gₙ₊₁."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d89fb412-90a6-4450-9f20-8a3a39b19ad4",
                                                "sense_id": "78e4ba46-557c-321e-9268-f96b158b91e3",
                                                "text": "Because of their connection with both homology and cohomology, chain complexes are an important topic of study in homological algebra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7b9545-c13e-3b45-95dd-e9fb8c338df7",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "The relationship, between elements, of being in the same group of the periodic table."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c8e6ca9-91bf-31aa-a7a8-273d6c72f2b6",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "The relationship, between organic compounds, of being in the same homologous series."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cd54a87-aa20-3b74-bb5c-ff8e2c1066a3",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "The relationship, between characteristics or behaviours, of having a shared evolutionary or developmental origin;"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b2a057b-8142-471f-8a59-7dca571c0a93",
                                                "sense_id": "6cd54a87-aa20-3b74-bb5c-ff8e2c1066a3",
                                                "text": "2000, Julie A. Hawkins, Chapter 2: A survey of primary homology assessment, Robert Scotland, R. Toby Pennington (editors), Homology and Systematics, Taylor & Francis, The Systematics Association, page 22,\nThe objective of this study is to classify approaches to primary homology assessment, and to quantify the extent to which different approaches are found in the literature by examining variation in the ways characters are defined and coded in a data matrix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2154829-4cc8-3d2b-8e18-e0d776dfa2db",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "The relationship, between characteristics or behaviours, of having a shared evolutionary or developmental origin;\\n(evolutionary theory) specifically, a correspondence between structures in separate life forms having a common evolutionary origin, such as that between mammalian flippers and hands.",
                                            "specifically, a correspondence between structures in separate life forms having a common evolutionary origin, such as that between mammalian flippers and hands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1b72c82-e064-3feb-98a0-961b52999fb9",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "The presence of the same series of bases in different but related genes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67e827e0-e434-3b2e-ba83-c5c52a8136d9",
                                        "entry_id": "a28f9f2f-0179-3ba9-928f-8b7c44394f13",
                                        "glosses": [
                                            "The relationship of being homologous; a homologous relationship.",
                                            "The relationship, between temporally separated human beliefs, practices or artefacts, of possessing shared characteristics attributed to genetic or historical links to a common ancestor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
