                    }
                ],
                "senses": [
                    {
                        "sense_id": "753cf082-9ba8-3aa7-b60b-17770b7b1deb",
                        "entry_id": "1340e106-3d65-30fb-8d17-9120a64f320b",
                        "glosses": [
                            "разг. небольшая сумочка для косметики"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666d974a-aada-4f11-a1b8-77677c6f37b2",
                                "sense_id": "753cf082-9ba8-3aa7-b60b-17770b7b1deb",
                                "text": "Пока главный судья говорил свое, адвокатесса достала из сумочки косметичку, зеркальце оперла о сумочку, стала подводить губы."
                            },
                            {
                                "example_id": "9e830ba8-99ff-4d67-8238-c1b153bc7bd2",
                                "sense_id": "753cf082-9ba8-3aa7-b60b-17770b7b1deb",
                                "text": "Лизавета непроизвольно оглянулась в поисках сумочки, в которой косметичка с пудреницей и зеркалом."
                            }
                        ]
                    },
                    {
                        "sense_id": "e011e3db-ae2d-32fa-a4d1-e0a2e1b9e01e",
                        "entry_id": "1340e106-3d65-30fb-8d17-9120a64f320b",
                        "glosses": [
                            "разг. специалистка по косметическому уходу за лицом, телом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49872a25-cf44-4a1d-bf55-2cc6630e3a4c",
                                "sense_id": "e011e3db-ae2d-32fa-a4d1-e0a2e1b9e01e",
                                "text": "Бывшую гостиную занимала пожилая косметичка Людмилочка, с тщательно зашпаклеванным, каким-то барельефным лицом, являя собою наглядный уровень профессионального мастерства."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "726ac10b-6475-444d-942d-c13b2d7ac4c6",
                        "source_entry_id": "1340e106-3d65-30fb-8d17-9120a64f320b",
                        "target_lang_word": "kosmetyczka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosmetyczka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "fed61fb3-faa9-3bd2-8e7b-db70c8aadce2",
                                        "entry_id": "104c8379-11e2-3263-954f-f32de027cd22",
                                        "glosses": [
                                            "kobieta, która wykonuje zabiegi kosmetyczne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c9b2ed-18b7-48d6-a990-0518a2490637",
                                                "sense_id": "fed61fb3-faa9-3bd2-8e7b-db70c8aadce2",
                                                "text": "Moja ciocia pracuje jako kosmetyczka w eleganckim salonie piękności."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "633f0ec1-7f25-3651-9417-0fa11fc55c12",
                                        "entry_id": "104c8379-11e2-3263-954f-f32de027cd22",
                                        "glosses": [
                                            "torebka, saszetka do noszenia / przechowywania kosmetyków"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29dc7d1f-58bd-499f-9751-c07c6efe42ac",
                                                "sense_id": "633f0ec1-7f25-3651-9417-0fa11fc55c12",
                                                "text": "Muszę kupić większą kosmetyczkę, bo w tej już się nie mieszczę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
