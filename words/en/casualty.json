{
    "word_family": [
        "casual",
        "casually"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ac6ed55-f8c7-3a80-ab16-eb57264f1f2f",
                    "sense_definition": "A person who is injured or killed in an accident, war, or other violent event.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "victim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storm resulted in only one minor <w>casualty</w> who was treated for a small cut.",
                            "target_lang_translations": {
                                "ru": "Сильный шторм привел лишь к одному легко <w>пострадавшему</w>, которому обработали небольшой порез."
                            }
                        },
                        {
                            "text": "Emergency services reported a heavy <w>casualty</w> count following the multi-car pileup on the highway.",
                            "target_lang_translations": {
                                "ru": "Службы экстренной помощи сообщили о большом количестве <w>жертв</w> после массового столкновения автомобилей на шоссе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heavy casualty",
                        "civilian casualty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, получивший ранение или погибший в результате несчастного случая, войны или другого насильственного события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "пострадавший или погибший"
                            },
                            {
                                "target_lang_word": "пострадавший",
                                "target_lang_sense_clarification": "получивший травмы"
                            },
                            {
                                "target_lang_word": "потеря",
                                "target_lang_sense_clarification": "в контексте погибших или раненых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c14d9e56-a423-3533-871d-f868d2c6e96b",
                    "sense_definition": "A person or thing that is badly affected by a specific situation, decision, or event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "victim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small independent bookstores became a <w>casualty</w> of the rise of massive online retailers.",
                            "target_lang_translations": {
                                "ru": "Маленькие независимые книжные магазины стали <w>жертвой</w> роста крупных онлайн-ритейлеров."
                            }
                        },
                        {
                            "text": "The local library was a <w>casualty</w> of progress when the city decided to build a shopping mall instead.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека пала <w>жертвой</w> прогресса, когда город решил построить на ее месте торговый центр."
                            }
                        }
                    ],
                    "common_phrases": [
                        "casualty of progress",
                        "economic casualty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, на которые сильно повлияла определенная ситуация, решение или событие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "обстоятельств или прогресса"
                            },
                            {
                                "target_lang_word": "пострадавший",
                                "target_lang_sense_clarification": "от ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31ddd304-9eee-3b87-a13a-4423160f20a3",
                    "sense_definition": "The department of a hospital where people who have had severe accidents or sudden illnesses are taken for urgent treatment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hospital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the fall, he was rushed to <w>casualty</w> to check for any broken bones.",
                            "target_lang_translations": {
                                "ru": "После падения его срочно доставили в <w>травматологию</w>, чтобы проверить, нет ли переломов."
                            }
                        },
                        {
                            "text": "The nurse spent her entire shift working in <w>casualty</w> dealing with various emergencies.",
                            "target_lang_translations": {
                                "ru": "Медсестра провела всю смену, работая в <w>приемном покое</w> и занимаясь различными экстренными случаями."
                            }
                        }
                    ],
                    "synonyms": [
                        "A&E",
                        "accident and emergency",
                        "emergency department",
                        "emergency room",
                        "emergency ward",
                        "ER",
                        "casualty department"
                    ],
                    "common_phrases": [
                        "hospital casualty",
                        "admitted to casualty"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделение больницы, куда доставляют людей, получивших серьезные травмы или внезапно заболевших, для оказания неотложной помощи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травматология",
                                "target_lang_sense_clarification": "отделение травм"
                            },
                            {
                                "target_lang_word": "приемный покой",
                                "target_lang_sense_clarification": "отделение скорой помощи"
                            },
                            {
                                "target_lang_word": "травмпункт",
                                "target_lang_sense_clarification": "пункт неотложной помощи при травмах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "489a368e-da20-362f-ab8a-5e48eb03ba39",
                    "sense_definition": "A member of the armed forces who is lost to service through death, wounds, sickness, capture, or because their whereabouts are unknown.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was concerned about the rising <w>casualty</w> rate during the long winter campaign.",
                            "target_lang_translations": {
                                "ru": "Генерал был обеспокоен ростом уровня <w>потерь</w> во время долгой зимней кампании."
                            }
                        },
                        {
                            "text": "Every military <w>casualty</w> is a tragedy for the families waiting back home.",
                            "target_lang_translations": {
                                "ru": "Каждая военная <w>потеря</w> — это трагедия для семей, ждущих дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "military casualty",
                        "casualty rate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военнослужащий, выбывший из строя в результате смерти, ранения, болезни, пленения или пропажи без вести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потеря",
                                "target_lang_sense_clarification": "боевая единица"
                            },
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "военных действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73a0e959-32af-3299-a66e-6fc97e2b1242",
                    "sense_definition": "An unfortunate event that happens by chance, such as an accident or disaster.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old explorer had survived many <w>casualties</w> of nature during his travels across the desert.",
                            "target_lang_translations": {
                                "ru": "Старый исследователь пережил множество <w>превратностей</w> природы во время своих путешествий по пустыне."
                            }
                        },
                        {
                            "text": "It was a strange <w>casualty</w> that led to the discovery of the hidden cave.",
                            "target_lang_translations": {
                                "ru": "Это была странная <w>случайность</w>, которая привела к открытию скрытой пещеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortune",
                        "luck"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "older usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несчастливое событие, произошедшее случайно, например, авария или катастрофа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный случай",
                                "target_lang_sense_clarification": "случайное бедствие"
                            },
                            {
                                "target_lang_word": "происшествие",
                                "target_lang_sense_clarification": "непредвиденное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54793afd-3bfe-305a-aecb-d101e094abc6",
                    "sense_definition": "The quality of being dependent on chance; randomness or uncertainty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the <w>casualty</w> of life makes every moment precious.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>случайность</w> жизни делает каждое мгновение драгоценным."
                            }
                        },
                        {
                            "text": "Scientific experiments aim to reduce the element of <w>casualty</w> to ensure repeatable results.",
                            "target_lang_translations": {
                                "ru": "Научные эксперименты направлены на уменьшение элемента <w>случайности</w> для обеспечения повторяемости результатов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство зависимости от случая; случайность или неопределенность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "фактор случая"
                            },
                            {
                                "target_lang_word": "превратность",
                                "target_lang_sense_clarification": "изменчивость судьбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "066241c5-dbde-3768-bdaf-8ad50ae4c0c9",
                    "sense_definition": "An incidental or occasional charge, payment, or tax.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenant was surprised by a small <w>casualty</w> added to his annual rent agreement.",
                            "target_lang_translations": {
                                "ru": "Арендатор был удивлен небольшим <w>сбором</w>, добавленным к его ежегодному договору аренды."
                            }
                        },
                        {
                            "text": "Historical records show various <w>casualties</w> paid to the lord of the manor.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают различные <w>платежи</w>, выплачиваемые лорду поместья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical legal/financial term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Побочный или случайный сбор, платеж или налог."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный сбор",
                                "target_lang_sense_clarification": "нерегулярный платеж"
                            },
                            {
                                "target_lang_word": "непредвиденный расход",
                                "target_lang_sense_clarification": "дополнительная плата"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}