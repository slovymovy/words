                                            {
                                                "example_id": "7291e150-21e5-4ce8-8f95-4eb3f0438aa4",
                                                "sense_id": "9cbdae43-7e2c-3c89-a193-0ac3acb53b43",
                                                "text": "Je me sentis berné par je ne sais quel destin farceur."
                                            }
