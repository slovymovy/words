                "senses": [
                    {
                        "sense_id": "cc88f461-45a2-3e1e-b2fd-df0bad6b287e",
                        "entry_id": "5e9cbc4e-266e-3781-9036-157f043d392c",
                        "glosses": [
                            "тот, кто занимается зодчеством; архитектор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248f9589-9fff-46e4-abf8-3766f52c0e32",
                                "sense_id": "cc88f461-45a2-3e1e-b2fd-df0bad6b287e",
                                "text": "Улица зодчего Росси."
                            },
                            {
                                "example_id": "50c7215d-cb1b-4edf-9cf5-69b8d36de8e5",
                                "sense_id": "cc88f461-45a2-3e1e-b2fd-df0bad6b287e",
                                "text": "Он талант, если хочешь знать. Он зодчий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f9e158f-0c22-413c-917d-5a6e93c12114",
                        "source_entry_id": "5e9cbc4e-266e-3781-9036-157f043d392c",
                        "source_sense_id": "cc88f461-45a2-3e1e-b2fd-df0bad6b287e",
                        "target_lang_word": "architect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "caa0b56e-fc4e-37a0-9873-4216b4f5a580",
                                        "entry_id": "02234023-d147-3f9b-a952-172b11c48530",
                                        "glosses": [
                                            "A professional who designs buildings or other structures, or who prepares plans and superintends construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546647c5-0282-4da7-8436-f23ad73da64e",
                                                "sense_id": "caa0b56e-fc4e-37a0-9873-4216b4f5a580",
                                                "text": "Plato made the causes of things to be matter, ideas, and an efficient architect."
                                            },
                                            {
                                                "example_id": "dec09182-2634-4eab-a3db-8a89b334db81",
                                                "sense_id": "caa0b56e-fc4e-37a0-9873-4216b4f5a580",
                                                "text": "This was the second time in the last few months that she was asked to install a urinal in a luxury residential project, and she said she knows many other designers and architects who have been specifying home urinals in their projects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e69866e-17a0-3ec6-8ebb-c0c308052d38",
                                        "entry_id": "02234023-d147-3f9b-a952-172b11c48530",
                                        "glosses": [
                                            "A person who plans, devises or contrives the achievement of a desired result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5131d073-60d2-46be-bf0f-912b0f7fc362",
                                                "sense_id": "3e69866e-17a0-3ec6-8ebb-c0c308052d38",
                                                "text": "Peisistratus was the first architect of the Iliad and the Odyssey."
                                            },
                                            {
                                                "example_id": "28668c90-8ccd-4426-984f-13f7eb11e3ae",
                                                "sense_id": "3e69866e-17a0-3ec6-8ebb-c0c308052d38",
                                                "text": "French winger Hatem Ben Arfa has also taken plenty of plaudits recently and he was the architect of the opening goal with some superb trickery on the left touchline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba22985-4625-322e-b545-bcc8ad298f2f",
                                        "entry_id": "02234023-d147-3f9b-a952-172b11c48530",
                                        "glosses": [
                                            "An honorific given to architects. Usually capitalized or abbreviated as Arch./Ar. before the person's name."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "architect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0678e02-6086-3ebe-9761-17820d83421d",
                                        "entry_id": "ee0b1b60-0fa6-3a0b-b731-3b6eac083850",
                                        "glosses": [
                                            "To design, plan, or orchestrate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8130dff-cf79-4517-b3d6-97ead4e0cf43",
                                                "sense_id": "d0678e02-6086-3ebe-9761-17820d83421d",
                                                "text": "He architected the military coup against the government."
                                            },
                                            {
                                                "example_id": "935bda8f-9e4c-45bd-a9f1-439673f1e3d3",
                                                "sense_id": "d0678e02-6086-3ebe-9761-17820d83421d",
                                                "text": "Dacker was his own architect, (or, as he sometimes said, he architected his own fortunes,) and his own carpenter."
                                            },
                                            {
                                                "example_id": "46da364c-fd7f-434e-918a-b795a12ad0af",
                                                "sense_id": "d0678e02-6086-3ebe-9761-17820d83421d",
                                                "text": "It is interesting to record that the excavating and the laying of the pipes for the mains have been done by the Corporation employés under the supervision and control of Mr. Harpur, the borough engineer, who, by the way, architected the station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
