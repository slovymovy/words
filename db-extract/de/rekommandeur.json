                        "examples": [
                            {
                                "example_id": "76f4bee9-bab0-4a44-bcae-127856e5ef25",
                                "sense_id": "61f7c0e8-adb9-3c2b-a7ff-8f88fba4092a",
                                "text": "„Soooo. Gleich geht’s looooos. Lea ist unsere nächste Stripperin“, dröhnt es aus den Boxen. Der Ansager bleibt unsichtbar, er zieht die Vokale wie ein Rummel-Rekommandeur."
                            },
                            {
                                "example_id": "05048efa-423d-40db-8a1a-94cee2132506",
                                "sense_id": "61f7c0e8-adb9-3c2b-a7ff-8f88fba4092a",
                                "text": "Schon aus einiger Entfernung sind sie zu hören: die laut dröhnenden Hupen der Fahrgeschäfte und die elektronisch veränderten Stimmen der Rekommandeure, die lauthals und überschwänglich die nächste Runde ansagen."
                            }
                        ]
                    }
