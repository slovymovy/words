                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf608e73-2878-4b97-8433-4d3d4289ddcf",
                                "sense_id": "2ab0fa07-6f21-351c-82da-a5f1458b2c0c",
                                "text": "Over more than four decades between 1978 and 2019, the proportion of medical school enrollees who identify as Black, Hispanic or members of other underrepresented groups has stayed “well below” the proportions that each group represented in the general US population, according to a 2021 report in The New England Journal of Medicine."
                            }
