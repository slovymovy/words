                        "glosses": [
                            "prezbiter w pierwszym roku po przyjęciu święceń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182b711c-9d15-4e3a-9f0c-94c6ebed2953",
                                "sense_id": "342f184a-a57e-32dd-87d8-07f3ed91ce7c",
                                "text": "Biskup poprosił neoprezbiterów, by stanęli wokół ołtarza."
                            },
                            {
                                "example_id": "17b6d81f-3b71-40d6-959d-bbaf8b116410",
                                "sense_id": "342f184a-a57e-32dd-87d8-07f3ed91ce7c",
                                "text": "Panie z sodalicji mariańskiej złożyły księdzu neoprezbiterowi życzenia."
                            },
                            {
                                "example_id": "571e39e4-fab7-4244-82c5-c29aa68d47e1",
                                "sense_id": "342f184a-a57e-32dd-87d8-07f3ed91ce7c",
                                "text": "W niedzielę ojciec neoprezbiter będzie udzielał błogosławieństwa prymicyjnego."
                            }
                        ],
