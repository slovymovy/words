                "senses": [
                    {
                        "sense_id": "ff72a270-457a-3004-9c04-988541c0824b",
                        "entry_id": "4ade38e7-6a91-329e-9838-0bf0e8b1fc5b",
                        "glosses": [
                            "bedarfsabhängig gesteuerte oder geregelte Lüftungstechnik für einen Raum oder ein Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8321fb5d-891e-4277-a9ac-1fbe9595671a",
                                "sense_id": "ff72a270-457a-3004-9c04-988541c0824b",
                                "text": "„Für die Dimensionierung der Bedarfslüftung sind natürlich nur regelmäßig auftretende Ereignisse zu berücksichtigen, die durch die Grundlüftung nicht abgedeckt werden.“"
                            },
                            {
                                "example_id": "980bd704-d2a0-4cd0-ba41-51a471ef4ab9",
                                "sense_id": "ff72a270-457a-3004-9c04-988541c0824b",
                                "text": "„Ein integrierter Feuchtigkeitssensor sorgt für eine präzise Bedarfslüftung.“"
                            },
                            {
                                "example_id": "1d5bfb68-c6a5-4eab-af9b-0512eda4e11d",
                                "sense_id": "ff72a270-457a-3004-9c04-988541c0824b",
                                "text": "„Eine Bedarfslüftung hat den weiteren Vorteil, dass sich der Komfort für die Raumbenutzer bei zu gross dimensionierten Lüftungsanlagen oder ungünstig platzierten Auslässen stark verbessert.“"
                            },
                            {
                                "example_id": "238fe0b0-c0b4-47c4-be83-20418bf133f2",
                                "sense_id": "ff72a270-457a-3004-9c04-988541c0824b",
                                "text": "„Die Bedarfslüftung erfolgt abgestimmt auf individuelle Nutzerbedürfnisse oder Raumanforderungen.“"
                            },
                            {
                                "example_id": "9ca6af11-f3a4-4308-a1d0-09491cb7a251",
                                "sense_id": "ff72a270-457a-3004-9c04-988541c0824b",
                                "text": "„Das LIMODOR AirClean-System bietet somit die besten Voraussetzungen um in der kalten Jahreszeit die Wärmerückgewinnung über den Wärmetauscher sicherzustellen und in der warmen Jahreszeit auf eine reine Bedarfslüftung umzuschalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
