                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a1508e-3217-4d26-90a9-01f4ddd1e4cc",
                                "sense_id": "d487422a-a9ab-3061-b92d-31260729b818",
                                "text": "„Ich flitze über den mit Gummimatten ausgelegten Boden und schließe mich im Schlafzimmer ein.“"
                            },
                            {
                                "example_id": "d1878eed-674c-4cb6-bf13-435cbc6596aa",
                                "sense_id": "d487422a-a9ab-3061-b92d-31260729b818",
                                "text": "„Starling platzierte die Gummimatte auf dem nassen Boden vor der Tür und legte sich darauf; ihre Hände umfassten einen Packen Plastikbeutel für Beweismaterial über dem Objektiv ihrer Kamera, und ihre Aufschläge waren fest mit Yows Taschentuch und ihrem eigenen umwickelt.“"
                            }
                        ],
