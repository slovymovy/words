{
    "word_family": [
        "multitask",
        "taskmaster",
        "taskforce",
        "taskbar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b3ce9f4-dfe5-3147-8aa9-4af91543ea17",
                    "sense_definition": "A piece of work to be done, often as part of a duty or job.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our teacher gave us a simple <w>task</w> to finish before Friday.",
                            "target_lang_translations": {
                                "ru": "Наш учитель дал нам простое <w>задание</w>, которое нужно закончить до пятницы.",
                                "zh": "老师给我们布置了一个简单的<w>任务</w>，要求周五前完成。"
                            }
                        },
                        {
                            "text": "Cleaning the entire house is a daily <w>task</w> for her.",
                            "target_lang_translations": {
                                "ru": "Уборка всего дома — это для неё ежедневная <w>задача</w>.",
                                "zh": "打扫整个房子是她每天的<w>任务</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "job",
                        "chore",
                        "work"
                    ],
                    "common_phrases": [
                        "daily task",
                        "complete a task",
                        "simple task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работа или поручение, которое необходимо выполнить, часто как часть обязанностей.",
                        "zh": "需要完成的工作或任务，通常是职责或工作的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зада́ние",
                                "target_lang_sense_clarification": "поручение"
                            },
                            {
                                "target_lang_word": "зада́ча",
                                "target_lang_sense_clarification": "дело для выполнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任务",
                                "target_lang_sense_clarification": "指派的工作或职责"
                            },
                            {
                                "target_lang_word": "作业",
                                "target_lang_sense_clarification": "指学习或工作中的具体任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a9f47b9-ed8c-3062-ad7d-68b6560e3720",
                    "sense_definition": "A difficult or tedious undertaking.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rebuilding the ancient bridge proved to be a monumental <w>task</w>.",
                            "target_lang_translations": {
                                "ru": "Восстановление древнего моста оказалось монументальной <w>задачей</w>.",
                                "zh": "重建这座古桥被证明是一项艰巨的<w>任务</w>。"
                            }
                        },
                        {
                            "text": "It was a daunting <w>task</w> to organize the files from the last decade.",
                            "target_lang_translations": {
                                "ru": "Организовать файлы за последнее десятилетие было сложнейшей <w>задачей</w>.",
                                "zh": "整理过去十年的文件是一项令人望而生畏的<w>任务</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "undertaking"
                    ],
                    "common_phrases": [
                        "daunting task",
                        "impossible task",
                        "monumental task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложное или утомительное дело, требующее значительных усилий.",
                        "zh": "一项艰巨或繁琐的工程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зада́ча",
                                "target_lang_sense_clarification": "трудное дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艰巨任务",
                                "target_lang_sense_clarification": "困难且耗时的工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eede3a93-5192-3799-b3c7-76d7a700a233",
                    "sense_definition": "A specific objective or goal to be achieved.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team focused on the primary <w>task</w> of increasing sales.",
                            "target_lang_translations": {
                                "ru": "Команда сосредоточилась на основной <w>задаче</w> — увеличении продаж.",
                                "zh": "团队专注于提高销售额这一主要<w>任务</w>。"
                            }
                        },
                        {
                            "text": "Our main <w>task</w> is to ensure customer satisfaction.",
                            "target_lang_translations": {
                                "ru": "Наша главная <w>задача</w> — обеспечить удовлетворенность клиентов.",
                                "zh": "我们的主要<w>任务</w>是确保客户满意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "objective",
                        "goal"
                    ],
                    "common_phrases": [
                        "primary task",
                        "main task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная цель или задача, которую необходимо достичь.",
                        "zh": "需要达成的具体目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зада́ча",
                                "target_lang_sense_clarification": "цель деятельности"
                            },
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "желаемый результат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标",
                                "target_lang_sense_clarification": "想要达到的结果"
                            },
                            {
                                "target_lang_word": "任务",
                                "target_lang_sense_clarification": "核心工作目标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc611a5b-dfc6-3b8e-a16d-2dde73b3a1e0",
                    "sense_definition": "A process or execution of a program running on a computer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can use the manager to stop the frozen <w>task</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать диспетчер, чтобы остановить зависшую <w>задачу</w>.",
                                "zh": "你可以使用管理器来停止卡死的<w>任务</w>。"
                            }
                        },
                        {
                            "text": "The computer performs several background <w>tasks</w> at once.",
                            "target_lang_translations": {
                                "ru": "Компьютер выполняет несколько фоновых <w>задач</w> одновременно.",
                                "zh": "计算机同时执行多个后台<w>任务</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "process"
                    ],
                    "common_phrases": [
                        "background task",
                        "kill a task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или выполнение программы на компьютере.",
                        "zh": "计算机上运行的程序进程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зада́ча",
                                "target_lang_sense_clarification": "компьютерный процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任务",
                                "target_lang_sense_clarification": "计算机系统中的进程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef012266-b6b5-3ab4-8bf6-9e8009950d95",
                    "sense_definition": "To assign a specific job or responsibility to someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>tasked</w> us with improving the project design.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>поручил</w> нам улучшить дизайн проекта.",
                                "zh": "经理<w>委派</w>我们去改进项目设计。"
                            }
                        },
                        {
                            "text": "She was <w>tasked</w> with organizing the annual conference.",
                            "target_lang_translations": {
                                "ru": "Ей <w>поручили</w> организацию ежегодной конференции.",
                                "zh": "她被<w>委派</w>负责组织年度会议。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tasked with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поручить кому-либо определенную работу или ответственность.",
                        "zh": "指派某人负责某项具体工作或职责。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поруча́ть",
                                "target_lang_sense_clarification": "давать задание"
                            },
                            {
                                "target_lang_word": "озада́чивать",
                                "target_lang_sense_clarification": "ставить задачу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "委派",
                                "target_lang_sense_clarification": "指派某人做某事"
                            },
                            {
                                "target_lang_word": "交办",
                                "target_lang_sense_clarification": "把任务交给某人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}