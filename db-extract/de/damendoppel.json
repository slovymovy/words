                "senses": [
                    {
                        "sense_id": "c9f95571-7dda-3b56-aa84-f9bcfda7dee6",
                        "entry_id": "05c33cb9-e3f9-3905-b9da-48c0ea969ce7",
                        "glosses": [
                            "Spiel, bei dem zwei Teams aus je zwei Frauen gegeneinander antreten"
                        ],
                        "tags": [
                            "bei bestimmten Sportarten (etwa beim Tennis",
                            "Tischtennis",
                            "Rollstuhltennis",
                            "Ringtennis",
                            "Squash oder Badminton)"
                        ],
                        "examples": [
                            {
                                "example_id": "646040bc-36c6-45ed-96a5-3dfdf4fff58c",
                                "sense_id": "c9f95571-7dda-3b56-aa84-f9bcfda7dee6",
                                "text": "Miranda und Melinda nehmen an den Wettkämpfen im Damendoppel teil."
                            },
                            {
                                "example_id": "05e1af33-aa04-4328-9560-7b4de31e87dc",
                                "sense_id": "c9f95571-7dda-3b56-aa84-f9bcfda7dee6",
                                "text": "„Im Damendoppel siegten die Koreanerinnen Jung Kyung Eun und Kim Ha Na.“"
                            },
                            {
                                "example_id": "f7814cde-164e-493e-b54f-6006a049ceb6",
                                "sense_id": "c9f95571-7dda-3b56-aa84-f9bcfda7dee6",
                                "text": "„Venus und Serena Williams haben das Damendoppel bei den Australian Open gewonnen.“"
                            },
                            {
                                "example_id": "b007c80f-723c-462b-ae8f-08a7427a1313",
                                "sense_id": "c9f95571-7dda-3b56-aa84-f9bcfda7dee6",
                                "text": "„18 Medaillen wären theoretisch möglich gewesen, wenn nicht im Viertelfinale ein chinesisches Damendoppel ein anderes entfernt hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
