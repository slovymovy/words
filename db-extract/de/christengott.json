                "senses": [
                    {
                        "sense_id": "91368cdf-db19-3b31-abbd-81717d413f36",
                        "entry_id": "f1ab5e42-2f5c-30e7-8832-66d4de4b6cc8",
                        "glosses": [
                            "Gott, wie er von den Christen verehrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c131760-e8ca-41ae-aa18-e3a1fd2b4afa",
                                "sense_id": "91368cdf-db19-3b31-abbd-81717d413f36",
                                "text": "„Sary scheint an den Christengott zu glauben, genau wie viele andre hier das behaupten.“"
                            },
                            {
                                "example_id": "035e4598-e125-4b49-beee-df829d5e7843",
                                "sense_id": "91368cdf-db19-3b31-abbd-81717d413f36",
                                "text": "„Betete er zu seinem Christengott, zu dem er sich neuerdings bekehrt hatte?“"
                            },
                            {
                                "example_id": "87e8cd8b-e770-427c-9233-d29bcaff039c",
                                "sense_id": "91368cdf-db19-3b31-abbd-81717d413f36",
                                "text": "„Das war die Zeit, wie Obed die Leute zu verfluchen angefang' hat, weil se so blöde Schafe war'n und zum Christengott gebetet ham, der nix un' niemand geholfen hat.“"
                            },
                            {
                                "example_id": "7cf8aad7-d3ca-4038-9254-47f46e6ee0a7",
                                "sense_id": "91368cdf-db19-3b31-abbd-81717d413f36",
                                "text": "„Cortés folterte einen von ihnen und verlangte, dass er die Wahrheit sagte - gedolmetscht von Malintzin, die schnell feststellte, dass der Christengott nicht wirklich ein Gott des Friedens war.“"
                            },
                            {
                                "example_id": "dc88ce2b-fa89-48a0-870a-ff0a48adb43a",
                                "sense_id": "91368cdf-db19-3b31-abbd-81717d413f36",
                                "text": "„›Gut. Schwört es bei Eurem Christengott!‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
