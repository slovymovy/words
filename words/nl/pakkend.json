                    "frequency": "Middle",
                    "semantic_group_id": "boeiend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>pakkend</w> moment toen de winnaar eindelijk de trofee omhoog hield.",
