                ],
                "senses": [
                    {
                        "sense_id": "2852eefa-c77f-3619-962c-98254e5395f6",
                        "entry_id": "e740c2bd-c071-30b9-b672-9fcb9a7dd63a",
                        "glosses": [
                            "Impliquer plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b145cdb-2fdd-4128-8cb8-1ca0dcc6f3de",
                                "sense_id": "2852eefa-c77f-3619-962c-98254e5395f6",
                                "text": "Il est donc important de surimpliquer la famille puisqu'elle est partie prenante dans l'ensemble du processus toxicomaniaque."
                            },
                            {
                                "example_id": "6f2c5576-a87a-422e-95c3-b70354c3636c",
                                "sense_id": "2852eefa-c77f-3619-962c-98254e5395f6",
                                "text": "Démotiver ou au contraire surimpliquer ?"
                            },
                            {
                                "example_id": "da545ee5-17f1-4461-9d1a-f27a01ba5124",
                                "sense_id": "2852eefa-c77f-3619-962c-98254e5395f6",
                                "text": "Endossant de multiples rôles, ces aidants naturels ont dû se surimpliquer, se maîtriser en permanence, parfois tout contrôler, en incapacité de lâcher prise, d’où la culpabilité, l’agressivité."
                            }
                        ]
                    }
