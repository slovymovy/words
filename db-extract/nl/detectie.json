                ],
                "translations": [
                    {
                        "translation_id": "63614a3e-8b29-4954-8eb8-3a636a0821d0",
                        "source_entry_id": "04bf74ba-2a74-350d-bd85-48fab8c38220",
                        "source_sense_id": "164a7277-6dce-3687-93d0-8df2a677f700",
                        "source_sense_description": "opsporing, ontdekking",
                        "target_lang_word": "detection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb5f822-35f7-3513-a1d6-92515e8e16d8",
                                        "entry_id": "6c70f74c-6fe7-364b-b2e2-ccd7cc9a884b",
                                        "glosses": [
                                            "The act or process of detecting, uncovering, or finding out, the discovery of something new, hidden, or disguised."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "658d6aac-ba51-42e5-bbaf-b789ea16ce58",
                                                "sense_id": "fcb5f822-35f7-3513-a1d6-92515e8e16d8",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "2eda36ff-8e54-43fb-8ab2-13042624232a",
                                                "sense_id": "fcb5f822-35f7-3513-a1d6-92515e8e16d8",
                                                "text": "“Why should Eldridge commit murder?[…]There was only one possible motive—namely, he wished to avoid detection as James Selby of Anaconda Ltd.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e24b275-f8a9-3dd6-bd89-209767e824f9",
                                        "entry_id": "6c70f74c-6fe7-364b-b2e2-ccd7cc9a884b",
                                        "glosses": [
                                            "Synonym of accusation, the exposure of concealed information about a crime or heresy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d41e394-b694-3c8a-9ab4-e31ae29cffd3",
                                        "entry_id": "6c70f74c-6fe7-364b-b2e2-ccd7cc9a884b",
                                        "glosses": [
                                            "The act or process of finding or detecting an electrical signal in a carrier wave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e08d28-df5b-4a6b-807a-7b7e46116ea6",
                        "source_entry_id": "04bf74ba-2a74-350d-bd85-48fab8c38220",
                        "source_sense_id": "164a7277-6dce-3687-93d0-8df2a677f700",
                        "source_sense_description": "opsporing, ontdekking",
                        "target_lang_word": "détection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfed36f9-b691-3a79-b4a9-e071855944f8",
                                        "entry_id": "51ae33f0-fb7b-379a-95ba-81ca6f4cb211",
                                        "glosses": [
                                            "Action de détecter un objet, un corps ou une substance à l’aide d’un appareil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c8fdf2-cb8f-4272-904f-b7fa108e5418",
                                                "sense_id": "dfed36f9-b691-3a79-b4a9-e071855944f8",
                                                "text": "Nous avons déjà vu que les procédés de détection des isotopes sont suffisamment sensibles pour permettre des dilutions très considérables de l'élément marqué."
                                            },
                                            {
                                                "example_id": "498be8be-1aa1-4e79-b42f-c28ceeae0a5b",
                                                "sense_id": "dfed36f9-b691-3a79-b4a9-e071855944f8",
                                                "text": "Les rayons X par transmission (XRT) fonctionnent selon le principe de la radioscopie. Ils permettent la détection des métaux, la qualité du tri étant d'autant meilleure que les métaux présentent des masses atomiques éloignées."
                                            },
                                            {
                                                "example_id": "98dce20f-3dd4-4fe3-8e10-0c7f5cbb22be",
                                                "sense_id": "dfed36f9-b691-3a79-b4a9-e071855944f8",
                                                "text": "Les observations depuis la Terre ont permis la détection de l’acide cyanhydrique et du formaldéhyde dans la coma des comètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3504601-14dd-372e-8c80-6237d7b7d569",
                                        "entry_id": "51ae33f0-fb7b-379a-95ba-81ca6f4cb211",
                                        "glosses": [
                                            "Action de détecter quelque chose d’anormal, de défectueux, d’illégal, de délictueux, à l’aide d’un appareil ou d’un dispositif."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e56ca71a-9ad2-4a57-af4c-0a572c8978d5",
                                                "sense_id": "f3504601-14dd-372e-8c80-6237d7b7d569",
                                                "text": "Ainsi, dans de nombreuses institutions, tous les mémoires sont systématiquement soumis au logiciel de détection de plagiat Ephorus avant transmission aux enseignants."
                                            },
                                            {
                                                "example_id": "51b51415-e0b1-449f-abc2-458ed9fa92ec",
                                                "sense_id": "f3504601-14dd-372e-8c80-6237d7b7d569",
                                                "text": "Le système de détection des fumées et les installations électriques dans les établissements avec locaux d’hébergement doivent être vérifiés à la construction par des personnes ou des organismes agréés."
                                            },
                                            {
                                                "example_id": "de6e8d05-eee8-4eb5-89c4-12b9fe5d918c",
                                                "sense_id": "f3504601-14dd-372e-8c80-6237d7b7d569",
                                                "text": "Pour calculer le coût total de la sécurisation, il faut tenir compte des procédures et des appareils de détection des faux billets chez les commerçants ou leurs banques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cd3e291-66c8-3c4c-a099-57e48fc9a3cc",
                                        "entry_id": "51ae33f0-fb7b-379a-95ba-81ca6f4cb211",
                                        "glosses": [
                                            "Action de détecter, chez quelqu’un, une aptitude ou une compétence hors du commun."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e73702b9-33cc-47d4-b2ad-927a6f0ae379",
                                                "sense_id": "9cd3e291-66c8-3c4c-a099-57e48fc9a3cc",
                                                "text": "Nicolas et Denis s’étaient connus au lycée Chaptal où ils faisaient partie de la même équipe de basket, ils avaient partagé les soirs d’entraînement, les week-ends de matchs et de tournois, les stages et les détections."
                                            },
                                            {
                                                "example_id": "2c440d30-cf44-409d-90b7-694745e0a9b3",
                                                "sense_id": "9cd3e291-66c8-3c4c-a099-57e48fc9a3cc",
                                                "text": "Dans le cadre de ma mission avec le ministre des Sports, j'ai voulu remettre en cause la notion de détection des talents, à laquelle je préfère celle d'accompagnement de potentiel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
