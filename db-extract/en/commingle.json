                                        "sense_id": "4dd3605e-58e0-30ef-960b-a4e4b10476dc",
                                        "entry_id": "c53b1367-df36-34e0-a8e8-1c15e9592c62",
                                        "glosses": [
                                            "etwas, insbesondere alkoholische Getränke mischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3393097b-6119-4ed5-bcfd-03391eb86a05",
                                                "sense_id": "4dd3605e-58e0-30ef-960b-a4e4b10476dc",
                                                "text": "Er quirlte, rührte und mixte / und fand eine Pille, doch eine verflixte: …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54369063-6567-34f5-9ab8-0368fbc4304a",
                                        "entry_id": "c53b1367-df36-34e0-a8e8-1c15e9592c62",
                                        "glosses": [
                                            "etwas mit Hilfe eines Mixers zerkleinern und mischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701e9a4e-1f31-4903-a4d2-0a226e435f3a",
                                                "sense_id": "54369063-6567-34f5-9ab8-0368fbc4304a",
                                                "text": "Bei der Zubereitung eines Karotten-Ingwer-Saftes werden im ersten Schritt gehäutete, in Stücke geschnittene Tomaten, Karottensaft und Zitronensaft in den Mixer gegeben und kurz gemixt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2df2a2a0-417b-3d34-8a8b-89e32714bdc0",
                                        "entry_id": "c53b1367-df36-34e0-a8e8-1c15e9592c62",
                                        "glosses": [
                                            "Geräusche, Musik und Sprache aufeinander abstimmen und auf eine Tonspur aufbringen"
                                        ],
                                        "tags": [
                                            "Rundfunk",
                                            "Fernsehen",
                                            "Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5900975d-3e53-41dd-973e-fc8f5e2ee87e",
                                                "sense_id": "2df2a2a0-417b-3d34-8a8b-89e32714bdc0",
                                                "text": "Für die Verwendung in den Clubs wurden die Salsoul-Hits nur von den besten DJs und Produzenten gemixt: Tom Moulton, Walter Gibbons, Larry Levan und Frankie Knuckles fertigten bahnbrechende Versionen an, die den Klang von Disco veränderten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
