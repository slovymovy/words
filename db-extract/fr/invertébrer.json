                ],
                "senses": [
                    {
                        "sense_id": "42ad0ed5-f5ad-32a2-847d-6c8174f9b36d",
                        "entry_id": "e1f26378-7fbc-3f54-bfeb-be1e3f132325",
                        "glosses": [
                            "Rendre invertébré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ae3393-9480-4857-8ee4-b8c75decfd6e",
                                "sense_id": "42ad0ed5-f5ad-32a2-847d-6c8174f9b36d",
                                "text": "Il faut invertébrer sa charité, se soumettre au réel pour être libre."
                            }
                        ]
                    },
                    {
                        "sense_id": "3afb632b-c6d2-3a71-a484-408fc1ab75af",
                        "entry_id": "e1f26378-7fbc-3f54-bfeb-be1e3f132325",
                        "glosses": [
                            "Devenir invertébré."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "cf6fc0b0-73e5-4f57-a274-fdb7806eab60",
                                "sense_id": "3afb632b-c6d2-3a71-a484-408fc1ab75af",
                                "text": "Bientôt j’allais m'invertébrer, me changer en mollusque, quitter cette chemise affreuse et me retrouver sur ma péniche, dans mes chiottes à moi."
                            },
                            {
                                "example_id": "f427bd7d-c078-43c8-8e24-5b673ca3a44f",
                                "sense_id": "3afb632b-c6d2-3a71-a484-408fc1ab75af",
                                "text": "J’ai honte de moi, mon orgueil endolore, mon énergie poisse, mon respect humain coule comme du Brie, ma volonté s’invertèbre, je me démembrane, me débandade, me disloque, me neutralise, me disperse."
                            }
                        ]
                    }
                ],
