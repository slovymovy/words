                            {
                                "example_id": "c215f9fd-4321-4f66-8827-197f520d8f91",
                                "sense_id": "924518a8-4f3b-32a3-bd9b-103ad0c41097",
                                "text": "Ein Kindermund ist ein beliebtes Fotomotiv."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37cf0e64-e66a-397c-be65-bcd9f6856dca",
                        "entry_id": "b6643d0c-517f-379a-a731-efddf164995f",
                        "glosses": [
                            "kindliche Ausdrucksweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4dcf6c-a86a-4658-8c44-a84f0f47f4a0",
                                "sense_id": "37cf0e64-e66a-397c-be65-bcd9f6856dca",
                                "text": "So mancher Mensch bewahrt sich den Kindermund bis ins höhere Alter."
                            },
                            {
                                "example_id": "4aef3d04-8a6a-4c14-9861-6a5f1c8f629a",
                                "sense_id": "37cf0e64-e66a-397c-be65-bcd9f6856dca",
                                "text": "„Das ist ein Chefwitz oder ein Witz über den gefürchteten Kindermund, es ist ein Witz, der als Chefwitz eine gewisse Ausführlichkeit, ja eine epische Breite beansprucht, damit die Pointe knapp und überraschend explodieren kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
