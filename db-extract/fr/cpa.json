                                "example_id": "07b868a5-6116-410c-a28e-5689af6330f1",
                                "sense_id": "52ac8a1b-2898-3951-9bd6-62d1019e989e",
                                "text": "Le président du syndicat des coureurs (CPA), Adam Hansen, a annoncé plusieurs mesures pour les descentes dangereuses des étapes 14 et 17 de ce Tour de France, notamment l’installation d’avertissements sonores en amont de certains virages dangereux."
                            },
                            {
                                "example_id": "db8fb21d-f32f-4ed5-8226-b114eaf0b727",
                                "sense_id": "52ac8a1b-2898-3951-9bd6-62d1019e989e",
                                "text": "Le CPA réunit des associations nationales qui travaillent en contact étroit avec les Fédérations dans les différents pays."
                            },
                            {
                                "example_id": "e2ce051b-90ab-4f0f-bb9e-ec473d6145f2",
                                "sense_id": "52ac8a1b-2898-3951-9bd6-62d1019e989e",
                                "text": "Diverses mesures vont être prises, a indiqué le syndicat des coureurs CPA."
                            }
                        ]
