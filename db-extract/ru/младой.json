                        "glosses": [
                            "поэт. или устар. молодой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88112b01-a936-48db-be67-a4ec3eb99db0",
                                "sense_id": "7cebe9d2-f2d7-3fe6-a690-9164cf5a56b4",
                                "text": "И у жены его младой // Спаситель есть ― кинжал двойной."
                            },
                            {
                                "example_id": "114f67de-3e44-4a0c-974e-ae66e70893d2",
                                "sense_id": "7cebe9d2-f2d7-3fe6-a690-9164cf5a56b4",
                                "text": "Вьется младой виноград, меж двух посаженный вязов."
                            }
                        ]
                    }
                ],
