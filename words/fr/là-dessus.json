    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                    "sense_definition": "Sur cela ; sur la partie supérieure de cet objet ou de cet endroit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne pose pas ton sac par terre, mets-le plutôt <w>là-dessus</w>."
                        },
                        {
                            "text": "Cette table est fragile, tu ne devrais rien poser de lourd <w>là-dessus</w>."
                        }
                    ],
                    "antonyms": [
                        "là-dessous"
                    ],
                    "common_phrases": [
                        "poser là-dessus",
                        "mettre là-dessus"
                    ]
                },
                {
                    "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                    "sense_definition": "Au sujet de cette affaire, sur ce point particulier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sujet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons déjà discuté de ce projet, inutile de revenir <w>là-dessus</w>."
                        },
                        {
                            "text": "Si tu as besoin de conseils avisés, tu peux toujours compter <w>là-dessus</w>."
                        }
                    ],
                    "common_phrases": [
                        "compter là-dessus",
                        "revenir là-dessus"
                    ]
                },
                {
                    "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                    "sense_definition": "Aussitôt après cela ; sur ces entrefaites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a conclu son discours et est parti <w>là-dessus</w> sans répondre aux questions."
                        },
                        {
                            "text": "<w>Là-dessus</w>, un coup de tonnerre a éclaté et la pluie a commencé à tomber."
                        }
                    ],
                    "synonyms": [
                        "sur ce",
                        "sur ces entrefaites"
                    ]
                }
            ]
        }
    ]
