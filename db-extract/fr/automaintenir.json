                        "examples": [
                            {
                                "example_id": "1720c46b-cf9a-4a50-8ffa-cf50fb2835a1",
                                "sense_id": "1ca75618-bc51-32cc-a3da-be5e5798d194",
                                "text": "La définition communément admise de ce type cellulaire est une cellule capable de s'automaintenir au moins pendant la durée de vie normale de l'organisme."
                            },
                            {
                                "example_id": "4f9f87f9-c673-4bcd-9859-fb9b08e32ab6",
                                "sense_id": "1ca75618-bc51-32cc-a3da-be5e5798d194",
                                "text": "Les institutions ont une tendance établie à s'autoconserver, à s'automaintenir, et ceci en dépit du sujet."
                            },
                            {
                                "example_id": "0d065e9c-48e6-42ae-84cf-c8672d276284",
                                "sense_id": "1ca75618-bc51-32cc-a3da-be5e5798d194",
                                "text": "Elles ne fournissaient pas aux applications les moyens de s'autoréparer ou de s'automaintenir après leur installation."
                            }
                        ]
                    }
