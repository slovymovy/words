                "senses": [
                    {
                        "sense_id": "741de1c9-db79-3a7f-9d46-9a2223646ca5",
                        "entry_id": "660bd2ca-7b1b-3b24-a77c-4bfa13aa396c",
                        "glosses": [
                            "in manchen Städten abgegrenzter Bereich, in den man nur mit Fahrzeugen einfahren darf, die bestimmte Abgasbedingungen erfüllen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6aaa00-6b2e-478f-a8c3-85d39756a1ce",
                                "sense_id": "741de1c9-db79-3a7f-9d46-9a2223646ca5",
                                "text": "„In einer Studie des ADAC verglichen Verkehrsexperten die Schadstoffbelastungen vor und nach der Einführung sogenannter Umweltzonen.“"
                            },
                            {
                                "example_id": "4da1969f-8ed7-44ca-86e0-0f285d4df47b",
                                "sense_id": "741de1c9-db79-3a7f-9d46-9a2223646ca5",
                                "text": "Voraussetzung dafür, dass man in eine Umweltzone einfahren darf, ist, dass man für sein Fahrzeug eine bestimmte Plakette erhalten hat, die als Nachweis für eine relativ geringe Abgasbelastung gilt."
                            },
                            {
                                "example_id": "62bb3354-8e7f-49ad-9f07-3302e6f76ad8",
                                "sense_id": "741de1c9-db79-3a7f-9d46-9a2223646ca5",
                                "text": "„Und wer heute noch so richtig schädliche Abgase einatmen will, der muss raus aus den Umweltzonen der Innenstädte und sich auf dem Land hinter einen alten ungefilterten Diesel-Trecker stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
