    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1358f390-3de7-30fc-ba39-900aaba1b53d",
                    "sense_definition": "osoba darzona miłością, bardzo komuś bliska",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "osoba_ukochana",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moje <w>kochanie</w> wraca dzisiaj późnym wieczorem z delegacji.",
                            "target_lang_translations": {
                                "en": "My <w>darling</w> is returning from a business trip late tonight."
                            }
                        },
                        {
                            "text": "Kupuję zawsze dobre owoce, bo moje <w>kochanie</w> bardzo je lubi.",
                            "target_lang_translations": {
                                "en": "I always buy good fruit because my <w>sweetheart</w> likes it very much."
                            }
                        }
                    ],
                    "synonyms": [
                        "miłość",
                        "złotko",
                        "serduszko",
                        "słoneczko"
                    ],
                    "common_phrases": [
                        "moje kochanie"
                    ],
                    "target_lang_definitions": {
                        "en": "a beloved person, someone very dear to one"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darling",
                                "target_lang_sense_clarification": "beloved person"
                            },
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "loved person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fbb7d71-44e5-3080-8d8f-c7653a1c4de8",
                    "sense_definition": "rzeczownik odczasownikowy od: <w>kochać</w>; darzenie kogoś lub czegoś uczuciem miłości",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uczucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od tego wielkiego <w>kochania</w> całkiem już straciła głowę.",
                            "target_lang_translations": {
                                "en": "From all this grand <w>loving</w>, she has completely lost her head."
                            }
                        },
                        {
                            "text": "Jej bezgraniczne serce było stworzone do <w>kochania</w> innych ludzi.",
                            "target_lang_translations": {
                                "en": "Her boundless heart was made for <w>loving</w> other people."
                            }
                        }
                    ],
                    "synonyms": [
                        "miłość",
                        "miłowanie"
                    ],
                    "common_phrases": [
                        "do kochania",
                        "od kochania"
                    ],
                    "target_lang_definitions": {
                        "en": "verbal noun from to love; the act or state of loving someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loving",
                                "target_lang_sense_clarification": "the act of feeling love"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "37a3797b-66b2-3264-ac43-6d8206219a1a",
                    "sense_definition": "zwrot używany przy zwracaniu się do osoby ukochanej lub bliskiej, wyrażający czułość",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wolatyw_czulosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzień dobry, <w>kochanie</w>, jak ci się dzisiaj spało?",
                            "target_lang_translations": {
                                "en": "Good morning, <w>darling</w>, how did you sleep today?"
                            }
                        },
                        {
                            "text": "Czy możesz mi podać sól, <w>kochanie</w>?",
                            "target_lang_translations": {
                                "en": "Could you pass me the salt, <w>sweetheart</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "skarbie",
                        "kotku",
                        "misiu",
                        "słoneczko"
                    ],
                    "target_lang_definitions": {
                        "en": "term of address used affectionately towards a loved one or someone dear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darling",
                                "target_lang_sense_clarification": "affectionate address"
                            },
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "affectionate address"
                            },
                            {
                                "target_lang_word": "honey",
                                "target_lang_sense_clarification": "affectionate address"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0fe7dc8-3647-39bc-9a22-996835cea832",
                    "sense_definition": "zwrot do kogoś wyrażający sympatię, życzliwość lub niekiedy protekcjonalność",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wolatyw_czulosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kochanie</w>, jeszcze cię wiele rzeczy w życiu mocno zdziwi.",
                            "target_lang_translations": {
                                "en": "<w>Honey</w>, many things in life are still going to surprise you greatly."
                            }
                        },
                        {
                            "text": "Nie martw się tym wcale, <w>kochanie</w>, wszystko będzie dobrze.",
                            "target_lang_translations": {
                                "en": "Don't worry about it at all, <w>sweetheart</w>, everything will be fine."
                            }
                        }
                    ],
                    "synonyms": [
                        "złotko",
                        "skarbie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "informal address expressing friendliness, kindness, or sometimes condescension"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "familiar or patronising address"
                            },
                            {
                                "target_lang_word": "honey",
                                "target_lang_sense_clarification": "familiar or condescending address"
                            },
                            {
                                "target_lang_word": "darling",
                                "target_lang_sense_clarification": "familiar address"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}