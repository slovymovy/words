                "translations": [
                    {
                        "translation_id": "4b08df59-608a-422d-9725-5d51cf4488ec",
                        "source_entry_id": "dcd5ac05-667f-381a-a462-f91f42aabeb9",
                        "source_sense_id": "8d3df2f0-a5bd-367f-b786-25ea1e86fe33",
