                        "cross_references": []
                    },
                    {
                        "translation_id": "c6042997-c328-4525-9d80-bd81ebc8270a",
                        "source_entry_id": "45c6e3f0-894f-3a4f-87f5-780a020c5511",
                        "source_sense_id": "0136daa4-beb4-3aae-bdfb-3585058ad50a",
                        "source_sense_description": "Ensemble coordonné constitué d’un cardigan et d’un pull-over",
                        "target_lang_word": "twinset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twinset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd038390-2a8c-37b5-a49f-a03d520c7de4",
                                        "entry_id": "dab60128-555c-3167-8927-c4404afd987f",
                                        "glosses": [
                                            "A combination of a cardigan and a jumper, usually knitted in wool or cashmere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c735f7f-d386-4f18-8df6-b5e6a02a3faa",
                                                "sense_id": "dd038390-2a8c-37b5-a49f-a03d520c7de4",
                                                "text": "She was dressed to receive, as her mother would have said, and she had been standing at the window in her blue twinset for an hour, waiting for the car, waiting for the doorbell, waiting for the soft turn of her husband's key in the latch."
                                            },
                                            {
                                                "example_id": "2aefe04f-2883-4048-926c-cc52d5b34b16",
                                                "sense_id": "dd038390-2a8c-37b5-a49f-a03d520c7de4",
                                                "text": "I need these people, the Sergeant, and Mr. Tighe the shopman in the village, even Miss Broaders, she of the pink twinsets and tight mouth, who presides over the post office."
                                            },
                                            {
                                                "example_id": "883930bf-4d58-493a-b06d-0b9d31adda03",
                                                "sense_id": "dd038390-2a8c-37b5-a49f-a03d520c7de4",
                                                "text": "She had been out all day campaigning and looked stiffly immaculate as ever in a royal blue twinset — except for her nose, which was twitching uncontrollably in disgust."
                                            },
                                            {
                                                "example_id": "dbb2d0f9-6389-4233-b1ab-692276b0ccb9",
                                                "sense_id": "dd038390-2a8c-37b5-a49f-a03d520c7de4",
                                                "text": "Shand's father had missed the whole thing — getting fou in the pub, more than likely—but his mum had been there, in her best green twinset, her court shoes polished to a shine as high as Shand's."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa481c3a-452e-3823-931b-ae20c421bd18",
                                        "entry_id": "dab60128-555c-3167-8927-c4404afd987f",
                                        "glosses": [
                                            "A pair of cars or locomotives that are permanently coupled and treated as a single unit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6308e307-d589-38a9-8888-68e28829143a",
                                        "entry_id": "dab60128-555c-3167-8927-c4404afd987f",
                                        "glosses": [
                                            "A pair of cylinders containing air for the diver to breathe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2799ccd1-2a9d-4ed4-a230-78d7d3d5fa85",
                                                "sense_id": "6308e307-d589-38a9-8888-68e28829143a",
                                                "text": "Tim and Rob both went into the water each armed with a twinset of air and a sling-tank of 50 per cent oxygen for use in decompression."
                                            },
                                            {
                                                "example_id": "9ac41473-dfb7-49e5-9a80-330bbd8518fb",
                                                "sense_id": "6308e307-d589-38a9-8888-68e28829143a",
                                                "text": "However, despite its strength, some say that carrying large twinsets by the manifold should not be recommended."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
