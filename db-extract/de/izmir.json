                ],
                "senses": [
                    {
                        "sense_id": "b0485684-f1e2-34df-b583-e2df3102ae20",
                        "entry_id": "0c7ad2b1-9fe1-3ffb-9432-c83d663ee3ad",
                        "glosses": [
                            "Millionenstadt im Westen der Türkei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c83439e-c0a0-4974-b433-2fcca81d53f1",
                                "sense_id": "b0485684-f1e2-34df-b583-e2df3102ae20",
                                "text": "„Zwei Frauen, die in Istanbul und Izmir von Vorlesungen und Prüfungen ausgeschlossen wurden, weil sie sich weigerten, ihr Kopftuch abzulegen, scheitern mit ihrer Klage.“"
                            },
                            {
                                "example_id": "34da05a9-68f3-4fc6-9768-8fbbbe2cd6ea",
                                "sense_id": "b0485684-f1e2-34df-b583-e2df3102ae20",
                                "text": "„Das Lokal war schmucklos und zurückhaltend eingerichtet: weißer Linoleumboden, eine Vitrine gleich neben der Tür, in der die tägliche Auswahl von Kebabs und Vorspeisen ausgestellt war, und an den Wänden Poster von Izmir, Konja und anderen türkischen Ferienorten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c544a7f7-6c41-3942-84bd-f69e956e2416",
                        "entry_id": "0c7ad2b1-9fe1-3ffb-9432-c83d663ee3ad",
                        "glosses": [
                            "Provinz im Westen der Türkei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234c1183-9aa7-4ea4-b254-27122cceab6b",
                                "sense_id": "c544a7f7-6c41-3942-84bd-f69e956e2416",
                                "text": "Izmir grenzt an die Provinzen Balıkesir, Manisa und Aydın."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95348224-cdaf-435c-85bb-d84155f063bb",
                        "source_entry_id": "0c7ad2b1-9fe1-3ffb-9432-c83d663ee3ad",
                        "source_sense_id": "b0485684-f1e2-34df-b583-e2df3102ae20",
