                        "avertir du danger"
                    ]
                },
                {
                    "sense_id": "e5e44786-ca10-3584-b822-00b8aecfbd8a",
                    "sense_definition": "Infliger une sanction disciplinaire formelle à quelqu'un, notamment un carton jaune dans un sport.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre a décidé d'<w>avertir</w> le joueur après cette faute particulièrement violente."
                        },
                        {
                            "text": "Le défenseur a commis une faute grave et le juge a dû l'<w>avertir</w> immédiatement."
                        }
                    ],
                    "synonyms": [
                        "sanctionner"
                    ],
                    "common_phrases": [
