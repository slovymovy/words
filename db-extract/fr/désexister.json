                                "example_id": "16176a63-32d5-4c78-b3c7-ebd10064ed01",
                                "sense_id": "7e0b6840-403e-31d1-9718-eb608086cace",
                                "text": "Man’s land : le peuple de ceux que rien ne peut faire peuple, la contrée périphérique que chaque regard fait exister et désexister sans s’y attarder, sans cruauté inutile."
                            },
                            {
                                "example_id": "f7392e25-e255-4451-addf-e4a348cfc79b",
                                "sense_id": "7e0b6840-403e-31d1-9718-eb608086cace",
                                "text": "Il y avait ce retour. Cette absence au cours de laquelle il avait cru désexister."
                            },
                            {
                                "example_id": "af008408-af83-4728-8b48-2c9671837909",
                                "sense_id": "7e0b6840-403e-31d1-9718-eb608086cace",
                                "text": "Se fondre. Fondre. Désexister."
                            }
                        ]
                    }
