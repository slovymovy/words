                                        "examples": [
                                            {
                                                "example_id": "4012a47e-c905-4f5c-a51e-4ebec80ef29a",
                                                "sense_id": "fd96e206-2fcf-34c4-8ccc-40ccb1cefe6e",
                                                "text": "She could approach it from her perpetual existentiations due to the extreme reduction of \"moments\" by their seemingly identical character, but of course the circumstance of that ideal epiphanic situation was no longer available."
                                            },
                                            {
                                                "example_id": "e841f8b7-ea7a-47c1-a594-362a9957b20c",
                                                "sense_id": "fd96e206-2fcf-34c4-8ccc-40ccb1cefe6e",
                                                "text": "Each of them reproached the other one for maintaining wrong ideas about God's attributes of action, in particular existentiation (takwīn)."
                                            }
