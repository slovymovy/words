                "senses": [
                    {
                        "sense_id": "23ca6e1c-3ec3-38c0-96aa-2b866a470b96",
                        "entry_id": "aa425635-3595-339a-a37f-458c1ca6afc8",
                        "glosses": [
                            "niet met heel grote zekerheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac389f1f-bb32-4062-90b0-c2517c3f5942",
                                "sense_id": "23ca6e1c-3ec3-38c0-96aa-2b866a470b96",
                                "text": "Het was een rol die ze onstandvastig speelde ten overstaan van Theo's onverschilligheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d228628-d359-35b6-8712-29277ec05ea9",
                        "entry_id": "aa425635-3595-339a-a37f-458c1ca6afc8",
                        "glosses": [
                            "van het weer dat het makkelijk kan veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278cc344-675d-4c2a-9b2b-3b290e0ac389",
                                "sense_id": "8d228628-d359-35b6-8712-29277ec05ea9",
                                "text": "Vrijdag wordt het droger en zachter maar dit zou slechts tijdelijk zijn want verschillende modellen houden vast aan onstandvastig weer met geregeld een sneeuwbui."
                            },
                            {
                                "example_id": "ace45edf-426f-4797-97cc-744127ef11c3",
                                "sense_id": "8d228628-d359-35b6-8712-29277ec05ea9",
                                "text": "Aan het begin van de nieuwe werkweek is het nog onstandvastig. Maandag vallen er enkele buien, met af en toe zon, dinsdag gaat het vooral in de middag vaker en harder regenen. Wat temperatuur betreft verandert er weinig."
                            }
                        ]
                    }
                ],
