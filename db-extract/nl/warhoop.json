                    },
                    {
                        "translation_id": "35c8e972-5adc-47e4-bf20-999961f3a0c5",
                        "source_entry_id": "d13e3818-a526-3ee5-9148-0adf1f39212e",
                        "source_sense_id": "121f3d00-4c6d-3a2d-b727-a4871ada01ee",
                        "source_sense_description": "ongeregelde hoeveelheid dingen",
                        "target_lang_word": "jumble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "652648bd-91a5-3d81-ab4b-75c6f7e1fea3",
                                        "entry_id": "c38e75a7-467f-31c1-b458-c2849f4c5616",
                                        "glosses": [
                                            "To mix or confuse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "662c077f-0a3e-493b-83c1-de6c06a4c186",
                                                "sense_id": "652648bd-91a5-3d81-ab4b-75c6f7e1fea3",
                                                "text": "Every clime and age jumbled together."
                                            },
                                            {
                                                "example_id": "8b6eaa95-a8ce-4a63-95da-8c9794231612",
                                                "sense_id": "652648bd-91a5-3d81-ab4b-75c6f7e1fea3",
                                                "text": "Why dost thou blend and jumble such inconsistencies together?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ac2908-a39e-31ca-b255-0b0ceaefcc84",
                                        "entry_id": "c38e75a7-467f-31c1-b458-c2849f4c5616",
                                        "glosses": [
                                            "To meet or unite in a confused way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eadd70f1-70d6-4c6d-9810-16e1c5838e17",
                                                "sense_id": "69ac2908-a39e-31ca-b255-0b0ceaefcc84",
                                                "text": "I tried to study, but in my half-awake state, all of the concepts seemed to jumble together."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9767489-edff-34ed-bb12-6af357074ab8",
                                        "entry_id": "6053e1cc-1ada-356b-8ea0-3766467aa3b1",
                                        "glosses": [
                                            "A mixture of often unrelated things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bc34f3-92ce-48c9-8e20-5bceeb771255",
                                                "sense_id": "d9767489-edff-34ed-bb12-6af357074ab8",
                                                "text": "His voice was rich and mellow and he had so long been thoroughly persuaded of the weight and import to mankind of any word he said that his words really had come to sound as if there were something in them. But now he can only whisper, and what he whispers sounds like what it is—mere jumble and jargon."
                                            },
                                            {
                                                "example_id": "c706d811-ffce-49fc-be21-74a27f28b16c",
                                                "sense_id": "d9767489-edff-34ed-bb12-6af357074ab8",
                                                "text": "The bufferbeam is another factor that must be carefully considered. The buffing and coupling centre is 3ft 5½in above rail level and the beam carries not only buffers and drawgear but a jumble of train connections such as jumpers and pipes."
                                            },
                                            {
                                                "example_id": "ecabfbdd-13b6-4dae-b3d8-194d6146cc51",
                                                "sense_id": "d9767489-edff-34ed-bb12-6af357074ab8",
                                                "text": "The newspaper letters, all capitals, made up a jumble of typefaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e16654a-0119-3c07-9447-a1020d22c44e",
                                        "entry_id": "6053e1cc-1ada-356b-8ea0-3766467aa3b1",
                                        "glosses": [
                                            "Items for a rummage sale."
                                        ],
                                        "tags": [
                                            "British",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8159b233-103a-4ecf-b72e-fa38368c6d57",
                                                "sense_id": "9e16654a-0119-3c07-9447-a1020d22c44e",
                                                "text": "Hire a stall at a fair or sell your wares at a car boot sale. Adjust your jumble's price to something very reasonable and attractive for people to buy. Your income will depend on the quality and quantity of the jumble […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0c3369-01ee-374c-92df-6544f0794455",
                                        "entry_id": "6053e1cc-1ada-356b-8ea0-3766467aa3b1",
                                        "glosses": [
                                            "A rummage sale."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce4f14c-8ee8-4180-9f7f-f816fe3c1847",
                                                "sense_id": "8f0c3369-01ee-374c-92df-6544f0794455",
                                                "text": "\"That's a nice coat,\" said Bella. \"I used to have one like that. Got it at a jumble. But it didn't suit me. You look great in it.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e97f445-0283-3ef6-8d41-e2337af396a1",
                                        "entry_id": "e53676d0-3bef-3b37-ad1e-3d7ba42ef932",
