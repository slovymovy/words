                        ],
                        "examples": [
                            {
                                "example_id": "02230b82-cfec-4b5d-b1a6-b88e4e126ada",
                                "sense_id": "4130f4f3-47ca-3f4c-822d-a901ca8c22b3",
                                "text": "Myriads of habitants are ever sleeping,\nOr dead, or fled from nameless pestilence!"
                            },
                            {
                                "example_id": "49eee455-67b7-4cce-95b2-2f8222e54fc2",
                                "sense_id": "4130f4f3-47ca-3f4c-822d-a901ca8c22b3",
                                "text": "The last dark branches which intercepted his view gave way, and he saw a heap of blackened ruins. Scarcely aware of his own actions, he sprang from his horse. A single glance convinced him it could harbour no human habitant."
                            }
                        ]
                    }
                ],
