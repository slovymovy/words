                    "sense_id": "48aa018f-326c-3ff9-be70-b4820327b7b2",
                    "sense_definition": "находящийся под запретом, недозволенный правилами или законом",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "not_allowed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ввоз этих медикаментов в страну строго <w>запрещён</w> законом.",
                            "target_lang_translations": {
                                "en": "The importation of these medications into the country is strictly <w>prohibited</w> by law."
                            }
                        },
                        {
                            "text": "Судья сразу остановил бой, потому что спортсмен применил <w>запрещённый</w> приём.",
                            "target_lang_translations": {
                                "en": "The referee stopped the fight immediately because the athlete used an <w>illegal</w> move."
                            }
                        }
                    ],
                    "synonyms": [
                        "недозволенный",
                        "запретный",
                        "воспрещённый",
                        "незаконный",
                        "нелегальный"
                    ],
                    "antonyms": [
                        "разрешённый",
                        "дозволенный"
                    ],
                    "common_phrases": [
