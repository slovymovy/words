                        "entry_id": "7883b04f-8dfe-3689-b28f-69c4545f2292",
                        "glosses": [
                            "Laienbegriff für die eigentliche Narkose oder Allgemeinanästhesie. Wird vom Laien gegen die sogenannte „Teilnarkose“ abgegrenzt, worunter eine Regional- oder Lokalanästhesie verstanden wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de023052-3eda-4e7a-a311-cc034c70267f",
                                "sense_id": "e042b3be-9c96-3fad-86c3-b0b501573831",
                                "text": "Die Operation muss unter Vollnarkose durchgeführt werden."
                            },
                            {
                                "example_id": "ce8a1667-7bcc-4759-ba06-d0666890993b",
                                "sense_id": "e042b3be-9c96-3fad-86c3-b0b501573831",
                                "text": "„Doch der Trend, frisch Operierte direkt nach dem Erwachen aus der Vollnarkose aus dem Bett zu scheuchen, war auch für Schlaganfallpatienten angesagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
