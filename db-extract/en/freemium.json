                                        "entry_id": "2c1fc242-eafc-3eaa-886c-dce16e1878ca",
                                        "glosses": [
                                            "Offre commerciale composée de deux parties distinctes. La première est gratuite, mais limitée (dans les fonctions ou dans le temps). Elle permet de tester le produit. La seconde est payante et complète."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "705b3ade-a149-456b-b2c6-d2899ef0ea6a",
                                                "sense_id": "6487ce58-4ec1-3451-8b39-b0c18440249d",
                                                "text": "Le freemium est un modèle économique qui fonctionne surtout sur internet."
                                            }
                                        ]
                                    }
                                ]
