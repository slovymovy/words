            "senses": [
                {
                    "sense_id": "74ee26ee-7428-3a21-8998-55f64b181a17",
                    "sense_definition": "de plaats waar een reis of een route eindigt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange vlucht bereikten we eindelijk onze <w>bestemming</w> in Spanje.",
                            "target_lang_translations": {
                                "en": "After a long flight, we finally reached our <w>destination</w> in Spain."
                            }
                        },
                        {
                            "text": "Wat is de <w>bestemming</w> van je reis deze zomer?",
                            "target_lang_translations": {
                                "en": "What is the <w>destination</w> of your trip this summer?"
                            }
                        }
                    ],
                    "synonyms": [
                        "eindpunt",
                        "doel"
                    ],
                    "antonyms": [
                        "vertrekpunt",
                        "herkomst"
                    ],
                    "common_phrases": [
                        "eindbestemming bereiken",
                        "populaire bestemming"
                    ],
                    "target_lang_definitions": {
                        "en": "the place where a journey or route ends"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "destination",
                                "target_lang_sense_clarification": "the place where someone is going"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8523230e-0431-307b-8f4c-52baaa310d88",
                    "sense_definition": "het doel of de functie die iets in de toekomst zal hebben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente heeft een nieuwe <w>bestemming</w> voor het oude schoolgebouw gevonden.",
                            "target_lang_translations": {
                                "en": "The municipality has found a new <w>purpose</w> for the old school building."
                            }
                        },
                        {
                            "text": "De <w>bestemming</w> van dit terrein is veranderd van industrie naar woningbouw.",
                            "target_lang_translations": {
                                "en": "The <w>zoning</w> of this site has changed from industrial to residential."
                            }
                        }
                    ],
                    "synonyms": [
                        "functie",
                        "gebruiksdoel",
                        "doel"
                    ],
                    "common_phrases": [
                        "nieuwe bestemming geven",
                        "bestemming van het terrein"
                    ],
                    "target_lang_definitions": {
                        "en": "the purpose or function that something will have in the future"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purpose",
                                "target_lang_sense_clarification": "the reason for which something is done or created"
                            },
                            {
                                "target_lang_word": "use",
                                "target_lang_sense_clarification": "the way in which something is used"
                            },
                            {
                                "target_lang_word": "zoning",
                                "target_lang_sense_clarification": "the legal designation of land use"
                            },
                            {
                                "target_lang_word": "allocation",
                                "target_lang_sense_clarification": "the action of assigning something for a specific purpose"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45ffe3c9-87fa-3cb1-a3df-b167ccb0494a",
                    "sense_definition": "het hogere doel of de roeping in iemands leven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft het gevoel dat ze haar ware <w>bestemming</w> in de kunst heeft gevonden.",
                            "target_lang_translations": {
                                "en": "She feels that she has found her true <w>calling</w> in art."
                            }
                        },
                        {
                            "text": "Veel mensen zoeken hun hele leven naar hun eigenlijke <w>bestemming</w>.",
                            "target_lang_translations": {
                                "en": "Many people spend their whole lives searching for their actual <w>destiny</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "roeping",
                        "lot"
                    ],
                    "common_phrases": [
                        "ware bestemming vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "the higher purpose or calling in someone's life"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "destiny",
                                "target_lang_sense_clarification": "the events that will necessarily happen to a person"
                            },
                            {
                                "target_lang_word": "calling",
                                "target_lang_sense_clarification": "a strong urge toward a particular way of life or career"
                            },
                            {
                                "target_lang_word": "vocation",
                                "target_lang_sense_clarification": "a person's employment or main occupation, especially regarded as worthy"
                            },
                            {
                                "target_lang_word": "fate",
                                "target_lang_sense_clarification": "the development of events beyond a person's control"
                            }
                        ]
                    }
                }
            ]
        }
    ]
