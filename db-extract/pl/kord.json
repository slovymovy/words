                                        "entry_id": "6ebc2b23-69c7-3e4b-ac8c-2c8d472f1450",
                                        "glosses": [
                                            "A short sword with a curved blade, and a convex edge; once used by sailors when boarding an enemy ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf4b823-877c-43b8-afa8-27fe533e75c3",
                                                "sense_id": "e30abf77-fb68-3bb2-9966-ceb644d5a557",
                                                "text": "She could feel Tern’s stare fixed right between her shoulder blades, and knew he was aching to plunge his cutlass there."
                                            },
                                            {
                                                "example_id": "fb2f7492-047a-4264-babc-a1d281ffbc95",
                                                "sense_id": "e30abf77-fb68-3bb2-9966-ceb644d5a557",
                                                "text": "In vain the captain threatened to throw him overboard; suspended a cutlass over his naked wrists; Queequeg was the son of a King, and Queequeg budged not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a41e89a-6531-359d-9db4-906132f68b8f",
                                        "entry_id": "6ebc2b23-69c7-3e4b-ac8c-2c8d472f1450",
                                        "glosses": [
                                            "A similarly shaped tool; a machete."
                                        ],
