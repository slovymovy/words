                                        "entry_id": "1b8bb637-8fde-361b-98dc-8b84452efc60",
                                        "glosses": [
                                            "bardzo drobny opad, składający się z kropelek wody o średnicy poniżej 0,5 mm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d789cbf-1755-4c0d-ae3e-690614d2660f",
                                                "sense_id": "fe86fb30-60f5-3e6e-b3ca-e1211542e1ad",
                                                "text": "Myślę, że przy mżawce nie spaceruje się przyjemnie."
