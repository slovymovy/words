                "entry_id": "d4033b69-01ac-38c3-8450-e25a8aa8ac7d",
                "word": "lœss",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2fcb3c8a-c41d-3624-8714-b70837702f13",
                        "entry_id": "d4033b69-01ac-38c3-8450-e25a8aa8ac7d",
                        "glosses": [
                            "Dépôt sédimentaire détritique meuble, d’origine éolienne et périglaciaire, limon jaune clair ou chamois, au toucher farineux et pulvérulent, renfermant à l’origine jusqu’à 50 pour cent de calcaire et riche en argile et en quartz."
                        ],
                        "tags": [
                            "Germanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "6736e6a5-612e-419e-818d-79e7fc5a58a4",
                                "sense_id": "2fcb3c8a-c41d-3624-8714-b70837702f13",
                                "text": "Le lœss est très poreux et très perméable à l’eau ; ses particules font moins de 50 microns de diamètre."
                            },
                            {
                                "example_id": "eedf4201-8192-4049-858b-4f6ff161276b",
                                "sense_id": "2fcb3c8a-c41d-3624-8714-b70837702f13",
                                "text": "Le lœss est un limon fertile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b36f3d18-4887-4df6-9ca6-0cebf4117641",
