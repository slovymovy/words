                    {
                        "sense_id": "ba3867bd-7a25-3d91-a458-bde726af08d1",
                        "entry_id": "b1f9b166-2cc6-3176-bb82-964869ea665a",
                        "glosses": [
                            "Habitante de la Flandre, la partie nord de la Belgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74974620-8d9c-4673-88c2-c93a8dea477d",
                                "sense_id": "ba3867bd-7a25-3d91-a458-bde726af08d1",
                                "text": "Lorenzo. – Proprette comme une Flamande !"
                            },
                            {
                                "example_id": "f13a9558-50fd-411d-acbe-95f5dae8c579",
                                "sense_id": "ba3867bd-7a25-3d91-a458-bde726af08d1",
                                "text": "Parce qu’il était amoureux d’une blonde, une Flamande."
                            },
                            {
                                "example_id": "a95adfa4-f64d-4b42-9317-7d5fd8eeaab5",
                                "sense_id": "ba3867bd-7a25-3d91-a458-bde726af08d1",
                                "text": "Par précaution, Peyrade avait mis un lit de paille, une thibaude et un tapis très épais dans la chambre de la Flamande, sous prétexte de rendre heureuse la nourrice de son enfant."
                            }
                        ]
                    }
