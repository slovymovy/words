                                            {
                                                "example_id": "a2633a7b-4ea6-4310-bd41-b369f77fa53c",
                                                "sense_id": "d56c6bbb-839d-3ab8-9490-f7a8cbdc917a",
                                                "text": "His speech was both witty and informative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f8bd6d8-111a-3907-a13f-c9139ddc5d4c",
                                        "entry_id": "b979d36a-ef26-35c9-a06c-27dd5d501438",
