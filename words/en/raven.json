                            "trait_type": "colloquial",
                            "comment": "Often used in literary or descriptive contexts, especially for hair."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий блестящий черный цвет, как у ворона; иссиня-черный.",
                        "zh": "具有像渡鸦一样有光泽的黑色；漆黑的。",
                        "es": "Que tiene el color negro brillante de un cuervo; negro azabache."
                    },
                    "translations": {
