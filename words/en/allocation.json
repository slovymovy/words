{
    "word_family": [
        "allocate",
        "allocator",
        "misallocation",
        "reallocation",
        "unallocated"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3ba3f44-fe8f-38de-adfb-a08b18a28b80",
                    "sense_definition": "The process or procedure for allocating things, especially money or other resources.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>allocation</w> of new permits is on a first-come, first-served basis.",
                            "target_lang_translations": {
                                "ru": "<w>Распределение</w> новых разрешений осуществляется в порядке живой очереди.",
                                "zh": "新许可证的<w>分配</w>遵循先到先得的原则。"
                            }
                        },
                        {
                            "text": "Efficient resource <w>allocation</w> is vital for the success of any large project.",
                            "target_lang_translations": {
                                "ru": "Эффективное <w>распределение</w> ресурсов жизненно важно для успеха любого крупного проекта.",
                                "zh": "高效的资源<w>配置</w>对任何大型项目的成功都至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distribution",
                        "allotment",
                        "assignment",
                        "apportionment"
                    ],
                    "common_phrases": [
                        "resource allocation",
                        "asset allocation",
                        "budget allocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс распределения вещей, особенно денег или других ресурсов.",
                        "zh": "分配或划拨物品（尤指资金、资源等）的过程或程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределение",
                                "target_lang_sense_clarification": "процесс раздачи или назначения"
                            },
                            {
                                "target_lang_word": "выделение",
                                "target_lang_sense_clarification": "предоставление ресурсов или средств"
                            },
                            {
                                "target_lang_word": "ассигнование",
                                "target_lang_sense_clarification": "назначение денежных средств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分配",
                                "target_lang_sense_clarification": "指资源、资金或额度等的指派与配给过程"
                            },
                            {
                                "target_lang_word": "配置",
                                "target_lang_sense_clarification": "多用于资源或资产的统筹与规划布局"
                            },
                            {
                                "target_lang_word": "划拨",
                                "target_lang_sense_clarification": "指款项或物资的专门调配"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05ac730-e957-3226-9fdb-08257872885b",
                    "sense_definition": "That which is allocated; an allowance or entitlement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer received his full <w>allocation</w> of water from the government.",
                            "target_lang_translations": {
                                "ru": "Фермер получил полную <w>квоту</w> воды от государства.",
                                "zh": "农夫从政府那里获得了全部的用水<w>配额</w>。"
                            }
                        },
                        {
                            "text": "Each student was given a small <w>allocation</w> of printing credits for the semester.",
                            "target_lang_translations": {
                                "ru": "Каждому студенту выделили небольшой <w>лимит</w> на печать на семестр.",
                                "zh": "每位学生在本学期都获得了一小笔打印点数<w>额度</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allowance",
                        "quota",
                        "share",
                        "ration",
                        "portion"
                    ],
                    "common_phrases": [
                        "full allocation",
                        "monthly allocation",
                        "water allocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что выделено; доля, квота или установленная норма.",
                        "zh": "被分配到的份额、配额或拨给的物资、金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квота",
                                "target_lang_sense_clarification": "установленная норма"
                            },
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть чего-либо"
                            },
                            {
                                "target_lang_word": "лимит",
                                "target_lang_sense_clarification": "ограниченное количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配额",
                                "target_lang_sense_clarification": "规定的分配数额或份额"
                            },
                            {
                                "target_lang_word": "分配额",
                                "target_lang_sense_clarification": "分派得到的金额或数量"
                            },
                            {
                                "target_lang_word": "份额",
                                "target_lang_sense_clarification": "分到的一份资源或权益"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73ccd099-ddfd-3bb8-ab11-d7d1e02a288d",
                    "sense_definition": "Restriction of an embryonic cell and its clonal descendants to a particular cell type or body region.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study investigates the <w>allocation</w> of cells during the early stages of development.",
                            "target_lang_translations": {
                                "ru": "В исследовании изучается <w>распределение</w> клеток на ранних стадиях развития.",
                                "zh": "这项研究调查了发育早期阶段细胞的<w>分配</w>与定位情况。"
                            }
                        },
                        {
                            "text": "Genetic mutations can disrupt the normal <w>allocation</w> of tissue types in the embryo.",
                            "target_lang_translations": {
                                "ru": "Генетические мутации могут нарушить нормальное <w>распределение</w> типов тканей в эмбрионе.",
                                "zh": "基因突变会破坏胚胎中组织类型的正常<w>分配</w>分化。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничение эмбриональной клетки и её потомков определенным типом клеток или областью тела.",
                        "zh": "（胚胎学中）胚胎细胞及其克隆后代局限于特定细胞类型或身体区域的定型或归宿分配。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределение",
                                "target_lang_sense_clarification": "клеток или тканей в организме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定位",
                                "target_lang_sense_clarification": "指发育过程中细胞或组织的命运指定与归宿"
                            },
                            {
                                "target_lang_word": "定型",
                                "target_lang_sense_clarification": "指细胞发育方向的限定分配"
                            },
                            {
                                "target_lang_word": "分配",
                                "target_lang_sense_clarification": "指细胞在胚胎不同区域或类型的划分"
                            }
                        ]
                    }
                }
            ]
        }
    ]
