{
    "word_family": [
        "hoedanig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16cac68f-f643-3c35-8da1-040a31fd4a52",
                    "sense_definition": "Een kenmerkende eigenschap of kwaliteit van iets of iemand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>hoedanigheid</w> van het materiaal is uitstekend voor dit project.",
                            "target_lang_translations": {
                                "fr": "La <w>qualité</w> du matériau est excellente pour ce projet."
                            }
                        },
                        {
                            "text": "Elk product heeft een specifieke <w>hoedanigheid</w> die het uniek maakt.",
                            "target_lang_translations": {
                                "fr": "Chaque produit a une <w>propriété</w> spécifique qui le rend unique."
                            }
                        }
                    ],
                    "synonyms": [
                        "eigenschap",
                        "kenmerk",
                        "kwaliteit"
                    ],
                    "target_lang_definitions": {
                        "fr": "Propriété ou qualité caractéristique d'une chose ou d'une personne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "qualité",
                                "target_lang_sense_clarification": "propriété caractéristique"
                            },
                            {
                                "target_lang_word": "propriété",
                                "target_lang_sense_clarification": "caractéristique intrinsèque"
                            },
                            {
                                "target_lang_word": "nature",
                                "target_lang_sense_clarification": "essence, caractère propre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "415029fa-8403-3d1b-b50a-fee8b868a319",
                    "sense_definition": "De officiële rol of functie die iemand bekleedt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik spreek hier in mijn <w>hoedanigheid</w> als voorzitter van de vereniging.",
                            "target_lang_translations": {
                                "fr": "Je m'exprime ici en ma <w>qualité</w> de président de l'association."
                            }
                        },
                        {
                            "text": "Hij bezocht het evenement in zijn <w>hoedanigheid</w> als adviseur.",
                            "target_lang_translations": {
                                "fr": "Il a assisté à l'événement en sa <w>qualité</w> de conseiller."
                            }
                        }
                    ],
                    "synonyms": [
                        "functie",
                        "rol",
                        "ambt"
                    ],
                    "common_phrases": [
                        "in de hoedanigheid van"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rôle officiel, fonction ou titre exercé par quelqu'un."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "qualité",
                                "target_lang_sense_clarification": "titre, rôle officiel (ex. en qualité de)"
                            },
                            {
                                "target_lang_word": "titre",
                                "target_lang_sense_clarification": "à titre de, fonction"
                            },
                            {
                                "target_lang_word": "capacité",
                                "target_lang_sense_clarification": "statut légal ou fonctionnel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df981944-b0a6-3485-b9f7-95d828e5f97a",
                    "sense_definition": "De uiterlijke vorm of de staat waarin iets zich bevindt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het object verkeert in een goede <w>hoedanigheid</w> ondanks zijn ouderdom.",
                            "target_lang_translations": {
                                "fr": "L'objet est en bon <w>état</w> malgré son grand âge."
                            }
                        },
                        {
                            "text": "De <w>hoedanigheid</w> van het oppervlak is na de behandeling sterk verbeterd.",
                            "target_lang_translations": {
                                "fr": "L'<w>état</w> de la surface s'est grandement amélioré après le traitement."
                            }
                        }
                    ],
                    "synonyms": [
                        "toestand",
                        "gesteldheid"
                    ],
                    "antonyms": [
                        "hoeveelheid"
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme extérieure ou état physique dans lequel se trouve quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "état",
                                "target_lang_sense_clarification": "condition physique ou matérielle"
                            },
                            {
                                "target_lang_word": "condition",
                                "target_lang_sense_clarification": "état de conservation ou de forme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43bff37e-5756-3f9f-abb1-613900706df9",
                    "sense_definition": "De gemoedstoestand of gesteldheid van een persoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bevond zich in een sombere <w>hoedanigheid</w> na het slechte nieuws.",
                            "target_lang_translations": {
                                "fr": "Il se trouvait dans un <w>état</w> sombre après la mauvaise nouvelle."
                            }
                        },
                        {
                            "text": "De <w>hoedanigheid</w> van de patiënt is stabiel gebleven gedurende de nacht.",
                            "target_lang_translations": {
                                "fr": "L'<w>état</w> du patient est resté stable pendant la nuit."
                            }
                        }
                    ],
                    "synonyms": [
                        "gemoedstoestand",
                        "gesteldheid"
                    ],
                    "target_lang_definitions": {
                        "fr": "État d'esprit, disposition psychologique ou condition d'une personne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "état",
                                "target_lang_sense_clarification": "état de santé ou d'esprit"
                            },
                            {
                                "target_lang_word": "disposition",
                                "target_lang_sense_clarification": "humeur ou état d'esprit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
