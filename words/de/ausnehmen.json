                    "frequency": "Middle",
                    "semantic_group_id": "ausschluss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Regierung beschloss, kleine Betriebe vorübergehend von der Steuer <w>auszunehmen</w>."
                        },
                        {
                            "text": "Der Lehrer <w>nahm</w> die kranken Schüler von der anstehenden Prüfung <w>aus</w>."
                        }
                    ],
                    "synonyms": [
