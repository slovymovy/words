                                        "entry_id": "52239475-133c-3e00-af7c-1494b8c83247",
                                        "glosses": [
                                            "aus Zentralasien stammende Schafrasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79904d62-567e-4a12-8669-25faaf1ec7be",
                                                "sense_id": "c23bcba4-e7ab-34a0-82b8-c19bbffd4cea",
                                                "text": "„Bis in die 1970er Jahre hinein war das Nomadentum mit Ziegen und Karakulschafen die hauptsächliche Quelle für den Lebenserhalt.“"
                                            }
