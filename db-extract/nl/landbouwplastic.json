                        "glosses": [
                            "stevig plastic dat men gebruikt om landbouwproducten af te schermen of in te pakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78d24ed-23f5-4af3-8197-ee6009b40172",
                                "sense_id": "af4984c1-ae3c-3623-8d43-a365dfad7f91",
                                "text": "\"Dit is mijn tent\", zegt Ana Paula, terwijl ze een bouwseltje van blauw landbouwplastic aanwijst. Ze trekt een stuk van het plastic opzij. \"Een matras, deken en kussen en een speelgoedauto van mijn dochter\", wijst ze aan. Dat is alles."
                            },
                            {
                                "example_id": "f03480d5-03c0-4c02-b771-d0117199186e",
                                "sense_id": "af4984c1-ae3c-3623-8d43-a365dfad7f91",
                                "text": "Die lijkt nu gevonden. Terreinen rond de bedrijven worden bedekt met landbouwplastic, zodat de vogels hier geen nesten kunnen bouwen. Verderop is een braakliggend terrein van 9 hectare ingericht voor de sternen. Er liggen schelpen en er zijn houten lokvogels geplaatst om de sternen over te halen hier hun nesten te bouwen."
                            }
                        ]
                    }
