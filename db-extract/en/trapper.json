                "translations": [
                    {
                        "translation_id": "10a12d8f-8c28-4642-afbf-9aed0ab4efe3",
                        "source_entry_id": "ce7e9c61-3c76-3ff5-b691-f01f66b4fb96",
                        "source_sense_description": "one who traps animals",
                        "target_lang_word": "trappeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trappeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58aae20e-3a1e-30fa-afcd-63a78ebacbfb",
                                        "entry_id": "5c32a227-939b-334b-96a3-70b86a38f955",
                                        "glosses": [
                                            "Chasseur de l’Amérique du Nord, qui se sert ordinairement de trappes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62d901a-cd1d-4878-8e48-ce271e5d985c",
                                                "sense_id": "58aae20e-3a1e-30fa-afcd-63a78ebacbfb",
                                                "text": "Entre autres manies, mon oncle avait celle de tuer tous les chats qu’il rencontrait. Il faisait, à ces pauvres bêtes, une chasse impitoyable, une guerre acharnée de trappeur."
                                            },
                                            {
                                                "example_id": "4d058347-008f-4505-869d-f90c381677c3",
                                                "sense_id": "58aae20e-3a1e-30fa-afcd-63a78ebacbfb",
                                                "text": "Même si l’époque des coureurs des bois se trouve loin derrière nous, des trappeurs de l’Est-du-Québec parcourent toujours des centaines de kilomètres dans la forêt chaque année de manière professionnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c5ca2da-4ed5-38cb-9f1f-239d5c5a9e4a",
                                        "entry_id": "5c32a227-939b-334b-96a3-70b86a38f955",
                                        "glosses": [
                                            "Musicien jouant de la trap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89aec653-d49f-4bd5-9920-facbdcdfe96f",
                                                "sense_id": "5c5ca2da-4ed5-38cb-9f1f-239d5c5a9e4a",
                                                "text": "Ce trappeur joue très bien."
                                            },
                                            {
                                                "example_id": "017c507f-4247-4f77-bd6b-f6071ed58c59",
                                                "sense_id": "5c5ca2da-4ed5-38cb-9f1f-239d5c5a9e4a",
                                                "text": "Ce trappeur est très abile avec sa trap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cce78fd-a4a4-4dfb-962a-eadebecec67c",
                        "source_entry_id": "ce7e9c61-3c76-3ff5-b691-f01f66b4fb96",
                        "source_sense_description": "one who traps animals",
                        "target_lang_word": "Trapper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trapper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                        "entry_id": "d43b47b5-0ddb-37c8-aa14-6ee0d3b0a185",
                                        "glosses": [
                                            "Fallensteller, Pelztierjäger in Nordamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146b0725-0b5f-4ab6-a03f-8d067c4a8a6c",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Aber sie folgen besseren Jägern, um aus deren Jagdglück Nutzen zu ziehen, und schädigen den Trapper, indem sie ihm den Köder aus den Fallen stehlen.“"
                                            },
                                            {
                                                "example_id": "5aa2bc8c-8582-4143-b525-695f46b9fadf",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Vor wilden Thieren fürchtet der Trapper sich nicht, aber die Indianer, welchen er als ein unwillkommener Eindringling erscheint, sind seine geschworenen Feinde, und vor diesen muß er immer auf der Hut sein.“"
                                            },
                                            {
                                                "example_id": "419567ec-e679-4ba7-8827-1887b589015c",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Die Berichte der Siedler, Missionare und Trapper schließlich sind oft von Vorurteilen »den Indianern« gegenüber geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
