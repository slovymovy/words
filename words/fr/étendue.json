                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bateau naviguait sur une vaste <w>étendue</w> d'eau calme sous le soleil."
                        },
                        {
                            "text": "Une immense <w>étendue</w> de sable chaud s'étendait à perte de vue devant les voyageurs."
                        }
                    ],
                    "synonyms": [
