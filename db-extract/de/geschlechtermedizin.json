                ],
                "senses": [
                    {
                        "sense_id": "ce810c68-8018-3045-b888-6ae713ae9661",
                        "entry_id": "8dbe6f7f-a3a0-3ff4-9ad3-c20516d506bf",
                        "glosses": [
                            "Teilgebiet der Medizin, das sich geschlechtsspezifisch mit der Erforschung und Behandlung von Krankheiten beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12c9b9c8-093f-46c8-a1e4-6a1b5e90b72a",
                                "sense_id": "ce810c68-8018-3045-b888-6ae713ae9661",
                                "text": "„Als Vera Regitz-Zagrosek in Frankreich einen Vortrag über die Geschlechtermedizin hielt, empörten sich französische Medien.“"
                            },
                            {
                                "example_id": "f34cd3c0-44a5-4edf-8fe6-012632cd4d35",
                                "sense_id": "ce810c68-8018-3045-b888-6ae713ae9661",
                                "text": "„Geschlechtermedizin oder Gendermedizin ist ein in der Gesundheitsbranche diskutiertes Thema, seitdem klar ist, dass Frauen und Männer bei einigen Krankheiten unterschiedliche Symptome zeigen und die Heilung bei spezifischer Behandlung besser gelingt.“"
                            },
                            {
                                "example_id": "5fa55bfd-4e4f-483b-a4de-21f47ca412c9",
                                "sense_id": "ce810c68-8018-3045-b888-6ae713ae9661",
                                "text": "„Bereits in den 1980er Jahren erkannte die amerikanische Kardiologin und Vorreiterin der Geschlechtermedizin Marianne Legato: Koronare Herzerkrankungen unterscheiden sich bei Männern und Frauen – und zwar gravierend.“"
                            },
                            {
                                "example_id": "c638f7d0-ffed-471f-bdb6-156fcc4b09c7",
                                "sense_id": "ce810c68-8018-3045-b888-6ae713ae9661",
                                "text": "„Sie leitet das einzige Zentrum für Geschlechtermedizin in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
