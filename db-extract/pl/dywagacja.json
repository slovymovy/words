                "senses": [
                    {
                        "sense_id": "cf75a822-0e13-3102-865f-6d4ebd4e132d",
                        "entry_id": "087c8e96-4085-3260-bad2-6f13c3f807b7",
                        "glosses": [
                            "rozwlekłe rozważanie nie na temat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a106ae70-f3fa-4f1f-b5e6-9cdcd8fcbc43",
                                "sense_id": "cf75a822-0e13-3102-865f-6d4ebd4e132d",
                                "text": "Bez tych dywagacji, Adolfie, do rzeczy!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c028b60-065f-46da-9d25-d241430c1818",
                        "source_entry_id": "087c8e96-4085-3260-bad2-6f13c3f807b7",
                        "source_sense_id": "cf75a822-0e13-3102-865f-6d4ebd4e132d",
                        "target_lang_word": "divagation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divagation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b86982c3-b89f-3c89-be16-14727ad04b8e",
                                        "entry_id": "92b5ac09-3419-35eb-8fff-19cd3192f8be",
                                        "glosses": [
                                            "Straying off from a course or way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac62bd34-44dd-4c07-85cc-701549632f3b",
                                                "sense_id": "b86982c3-b89f-3c89-be16-14727ad04b8e",
                                                "text": "It was after the complete revelation that he understood the romantic innuendoes with which his childhood had been surrounded, and of which he had never caught the meaning; they having seemed but part and parcel of the habitual and promiscuous divagations of his too constructive companion. When it came over him that, for years, she had made a fool of him, to himself and to others, he could have beaten her, for grief and shame […]"
                                            },
                                            {
                                                "example_id": "ac4f5cec-4a26-4468-b52c-53a62f2f3fc2",
                                                "sense_id": "b86982c3-b89f-3c89-be16-14727ad04b8e",
                                                "text": "But this was a divagation, and he pulled himself back to the askings of the moment"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd47bd0-bc7b-3c0f-9862-62b32876383c",
                                        "entry_id": "92b5ac09-3419-35eb-8fff-19cd3192f8be",
                                        "glosses": [
                                            "Incoherent or wandering speech and thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23356ad7-bc58-422a-a00f-40d73ea55485",
                        "source_entry_id": "087c8e96-4085-3260-bad2-6f13c3f807b7",
                        "source_sense_id": "cf75a822-0e13-3102-865f-6d4ebd4e132d",
                        "target_lang_word": "divagation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divagation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d611e42d-4fd0-3787-ae74-132f8d7b1a23",
                                        "entry_id": "f0c283c5-5a55-36e4-aea4-9376488f5329",
                                        "glosses": [
                                            "Errance d’un animal sur la voie publique ou sur des propriétés privées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1553f349-9805-47ff-a27b-bec78c08dc06",
                                                "sense_id": "d611e42d-4fd0-3787-ae74-132f8d7b1a23",
                                                "text": "Pour l’application des articles L. 211-21 et L. 211-22, le maire prend toutes dispositions de nature à permettre une prise en charge rapide de tout animal errant ou en état de divagation qui serait trouvé accidenté…"
                                            },
                                            {
                                                "example_id": "29cce19b-c1de-4dcd-847b-999d38bb4e5a",
                                                "sense_id": "d611e42d-4fd0-3787-ae74-132f8d7b1a23",
                                                "text": "Dans une optique agro-écologique, l’agriculture en tire alors des bénéfices significatifs, comme dans la zone cotonnière du sud du Mali : diversification des revenus des paysans, protection des sols et limitation de la divagation des animaux par l’embocagement, enrichissement des sols, utilisation des tourteaux comme engrais organiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3741b07d-3c71-368d-b738-6d0b98989507",
                                        "entry_id": "f0c283c5-5a55-36e4-aea4-9376488f5329",
                                        "glosses": [
                                            "Action de s’écarter de la question, du sujet sur lequel on parle ou on écrit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a676dc-169c-4739-b980-f5cccfb6d6ce",
                                                "sense_id": "3741b07d-3c71-368d-b738-6d0b98989507",
                                                "text": "Se perdre dans les divagations. — Se jeter dans des divagations qui font perdre le sujet de vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3e86c0-9dbc-3f43-8d32-d62c0e173445",
                                        "entry_id": "f0c283c5-5a55-36e4-aea4-9376488f5329",
                                        "glosses": [
                                            "Propos incohérents qui marquent le désordre d’esprit."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c408adc-8b6c-4b3c-9039-ac7cd81b52b5",
                                                "sense_id": "9a3e86c0-9dbc-3f43-8d32-d62c0e173445",
                                                "text": "Les divagations d’un malade, de la fièvre."
                                            },
                                            {
                                                "example_id": "d7c93157-cbf0-4b6f-9944-ae76139588d8",
                                                "sense_id": "9a3e86c0-9dbc-3f43-8d32-d62c0e173445",
                                                "text": "Le récit du chevalier des Aubes devait être considéré comme une divagation de vieillard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
