                    {
                        "translation_id": "01fccf73-c806-498b-a609-1a572f9e0ced",
                        "source_entry_id": "c262e095-1fcb-33e4-8285-bdc15e918c88",
                        "source_sense_id": "ff81d394-4329-30cd-8439-a4264e5a9101",
