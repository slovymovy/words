                                        "entry_id": "b629e8e3-83bd-391a-ae22-3dec48212141",
                                        "glosses": [
                                            "Initialism of driving under the influence [of alcohol or other drugs]: the act of doing so; a charge or conviction for that act."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
