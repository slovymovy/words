                ],
                "translations": [
                    {
                        "translation_id": "87597e95-a2fc-405e-8c4f-df2f2a8ca2ec",
                        "source_entry_id": "9f841f5a-ad38-3e3d-bc92-a1faee6c472c",
                        "source_sense_id": "e5e243e3-3c68-3f5c-9cdc-a9271f1f97e6",
                        "target_lang_word": "нота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b53e0d-73f5-329b-83bf-c55188e25fa3",
                                        "entry_id": "b6dd68ef-4317-3c84-9d36-2ea8b120d6f9",
                                        "glosses": [
                                            "муз. знак для записи высоты и длительности звука в музыкальном произведении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60576727-5581-4230-96fa-cec2cc27b257",
                                                "sense_id": "c2b53e0d-73f5-329b-83bf-c55188e25fa3",
                                                "text": "Нота ля."
                                            },
                                            {
                                                "example_id": "ebe5a330-64d9-4777-8822-eca05c90bd87",
                                                "sense_id": "c2b53e0d-73f5-329b-83bf-c55188e25fa3",
                                                "text": "Нота соль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e71bf7d7-98f2-3e3c-bc3f-368544752882",
                                        "entry_id": "b6dd68ef-4317-3c84-9d36-2ea8b120d6f9",
                                        "glosses": [
                                            "муз., мн. ч. текст музыкального произведения, записанный такими условными графическими знаками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a488e7e-d134-41b5-bba5-d3c73b7ec664",
                                                "sense_id": "e71bf7d7-98f2-3e3c-bc3f-368544752882",
                                                "text": "И те же ноты лежат на рояле: увертюра к «Пиковой даме» и романс «Для берегов отчизны дальней»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b50907cf-2cf3-35e3-a870-2a1b1dabb324",
                                        "entry_id": "b6dd68ef-4317-3c84-9d36-2ea8b120d6f9",
                                        "glosses": [
                                            "муз. музыкальный звук"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86871c1b-cff4-4e20-bab3-7641929551e2",
                                                "sense_id": "b50907cf-2cf3-35e3-a870-2a1b1dabb324",
                                                "text": "Немая тишина царила кругом, только слабо шелестели листы деревьев, и вдруг, прорезая тишину ночи, откуда-то пронеслась звонкая нота заунывной песни."
                                            },
                                            {
                                                "example_id": "01ac9cc2-0886-4ed1-b1f2-c28136930e58",
                                                "sense_id": "b50907cf-2cf3-35e3-a870-2a1b1dabb324",
                                                "text": "Нота, выходящая из-под смычка или из-под пальца музыканта, будет ли она протяжной или подвижной, должна быть каждая слышна в одинаковой степени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b7dfbe-a60d-3b8c-baf9-35f223b76f3a",
                                        "entry_id": "b6dd68ef-4317-3c84-9d36-2ea8b120d6f9",
                                        "glosses": [
                                            "тон, интонация голоса, речи, выражающих какое-либо чувство, отношение к кому-, чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecec97fb-fb03-4c63-8be3-d5322c867330",
                                                "sense_id": "25b7dfbe-a60d-3b8c-baf9-35f223b76f3a",
                                                "text": "[Петанлер] говорил таким голосом, в котором явственно звучала нота бесконечного благожелательства к милому ребёнку."
                                            },
                                            {
                                                "example_id": "4cdd927e-51a0-444e-b2ed-b52bf69b6143",
                                                "sense_id": "25b7dfbe-a60d-3b8c-baf9-35f223b76f3a",
                                                "text": "Её пальцы дрожали. В голосе за твёрдыми нотами вот-вот готовы были возникнуть слёзы новой обиды."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35091106-735f-3353-9725-d4398dea2773",
                                        "entry_id": "b6dd68ef-4317-3c84-9d36-2ea8b120d6f9",
                                        "glosses": [
                                            "спец. оттенок запаха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b4e4a4-605e-4bfe-b9b5-b6becccacce6",
                                                "sense_id": "35091106-735f-3353-9725-d4398dea2773",
                                                "text": "Мэр благоухает грейпфрутом и бергамотом ― хоть ешь. И как легкий фон, намеком, ― цветочная нота."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "нота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a5527317-ed78-3f21-9660-335d8692e23e",
                                        "entry_id": "1335722f-e497-3c01-bebe-aec304fedca8",
                                        "glosses": [
                                            "дипл., полит. официальный уведомительный документ, направляемый властями одного государства властям другого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82156947-4436-407d-b3d4-67099ef790ea",
                                                "sense_id": "a5527317-ed78-3f21-9660-335d8692e23e",
                                                "text": "9-го марта в совете министров обсуждалась германская нота, под угрозами запрещающая Турции покупать боевые припасы во Франции."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
