                                        "entry_id": "259eb94e-089e-363d-af61-0abd2c1f88ae",
                                        "glosses": [
                                            "… wprowadzająca wniosek, który mówca uważa za prawdopodobne wyjaśnienie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbc675f-1eef-4bb6-bc8e-67b448fa3575",
                                                "sense_id": "f5af09a3-29c8-3c38-9db5-358e4d8c5d41",
                                                "text": "Nie widać żadnych gwiazd, widocznie na niebie są chmury."
                                            }
                                        ],
