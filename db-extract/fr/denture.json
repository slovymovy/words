        "fr-extract.jsonl": [
            {
                "entry_id": "ad8b837a-c02f-3d37-ab9c-beed5462c9b3",
                "word": "denture",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b4e7fae-c5e6-4aa9-a9cc-30e26c1c9d91",
                        "entry_id": "ad8b837a-c02f-3d37-ab9c-beed5462c9b3",
                        "tags": [
                            "plural"
                        ],
                        "form": "dentures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "450639f0-8f54-34cf-ba02-e017fec99345",
                        "entry_id": "ad8b837a-c02f-3d37-ab9c-beed5462c9b3",
                        "glosses": [
                            "Ensemble des dents ; ordre dans lequel elles sont rangées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28798c76-fd34-4ef3-bb3e-f01122e252b3",
                                "sense_id": "450639f0-8f54-34cf-ba02-e017fec99345",
                                "text": "Sa bouche, grande et d’un rouge vif, laissait luire par éclairs blancs une denture qui eût fait honneur à un jeune loup."
                            },
                            {
                                "example_id": "e81b9e83-6d6d-4ddb-b12f-5e2f3646936e",
                                "sense_id": "450639f0-8f54-34cf-ba02-e017fec99345",
                                "text": "Une belle, une bonne denture. — Denture artificielle."
                            },
                            {
                                "example_id": "57c9009c-cc57-47e8-a852-a9b5ec7d649a",
                                "sense_id": "450639f0-8f54-34cf-ba02-e017fec99345",
                                "text": "Mon père, Dirk Oldema, était un Frison haut de six pieds, mince et élancé comme un bouleau, et d’une flexibilité incroyable. Il avait le teint très frais, les yeux bleu clair lumineux, une denture merveilleuse, des cheveux châtain clair bouclés, une voix parlée franche et timbrée, et une voix chantante de ténor léger qui faisait s’arrêter les passants."
                            },
                            {
                                "example_id": "1edd0463-a78a-4589-aad3-2c847704affc",
                                "sense_id": "450639f0-8f54-34cf-ba02-e017fec99345",
                                "text": "16 octobre 44 – Il a un sourire adorable, très pointu, les coins de la bouche relevés très haut sur l’admirable denture américaine."
                            },
                            {
                                "example_id": "7337eb3e-e66a-4ec1-95d3-7ce508ec6d2b",
                                "sense_id": "450639f0-8f54-34cf-ba02-e017fec99345",
                                "text": "Elle s’escrimait par intervalles à lui retrousser les babines pour appeler l’assistance à considérer sa denture."
                            }
                        ]
                    },
                    {
                        "sense_id": "634dd1fd-363d-335d-ae69-8569e5fe29d2",
                        "entry_id": "ad8b837a-c02f-3d37-ab9c-beed5462c9b3",
                        "glosses": [
                            "Bord denté d’une roue, d’une lame de scie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d4d737-5696-47b1-9ffe-4cee1fea06b3",
                                "sense_id": "634dd1fd-363d-335d-ae69-8569e5fe29d2",
                                "text": "Une roue à denture d’acier."
                            },
                            {
                                "example_id": "ff5d9d91-fef5-4972-8f3c-4a23db39274f",
                                "sense_id": "634dd1fd-363d-335d-ae69-8569e5fe29d2",
                                "text": "Sciage assez difficile, bois nerveux. Choisir une denture adaptée aux bois durs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc1ec490-7c88-4489-b0b1-8d93f4f1a236",
                        "source_entry_id": "ad8b837a-c02f-3d37-ab9c-beed5462c9b3",
                        "target_lang_word": "Gebiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                        "entry_id": "d57b8730-428d-3b69-ac5b-0aad151260e0",
                                        "glosses": [
                                            "die Gesamtheit der Zähne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2710530-3c4d-45cc-be7e-3ff187ca1fa4",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "Das menschliche Gebiss umfasst 32 Zähne."
                                            },
                                            {
                                                "example_id": "1cac5d5c-6c1f-43c1-ba34-9b5b4133ca96",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Seine Stimme war klar und fest, sein Gebiss unverstümmelt und von strahlendem Weiß.“"
                                            },
                                            {
                                                "example_id": "919ac4ed-1974-440c-ba57-fd7eb7081313",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Als sie grinste, klaffte eine schwarze Lücke im Gebiss.“"
                                            },
                                            {
                                                "example_id": "671d8bdd-c85e-4c86-b569-8df947a8a22b",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Längst hat der Zahnstocher seinen Siegeszug über die festlich gedeckten Tafeln kultivierter Gastlichkeit angetreten und bietet eine ebenso bequeme wie intensive Betreuung des Gebisses, ohne das Tischgespräch zu unterbrechen.“"
                                            },
                                            {
                                                "example_id": "1c25088b-c2dc-4e9f-964d-26cbbfb910d3",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Der Junge zeigte ein Gebiss, in dem ein Vorderzahn fehlte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                                        "entry_id": "d57b8730-428d-3b69-ac5b-0aad151260e0",
                                        "glosses": [
                                            "der Zahnersatz; die künstlichen Zähne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9898c2-ad21-401b-a1b2-c76020e59200",
                                                "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                                                "text": "Das Gebiss liegt auf dem Nachttisch."
                                            },
                                            {
                                                "example_id": "790a8c48-216b-4926-a21e-ec13ea7ec28e",
                                                "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                                                "text": "„Vermutlich saß das Gebiss nicht richtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
