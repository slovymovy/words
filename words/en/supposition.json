            "senses": [
                {
                    "sense_id": "8b09622e-ec6e-33a3-a8fc-f04e9610af0e",
                    "sense_definition": "An idea or theory that is believed to be true without having proof.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His entire argument was based on a mere <w>supposition</w> rather than hard evidence."
                        },
                        {
                            "text": "The police investigation started with the <w>supposition</w> that the suspect had fled the country."
                        }
                    ],
                    "synonyms": [
                        "assumption",
                        "conjecture",
                        "hypothesis",
                        "speculation",
                        "theory"
                    ],
                    "common_phrases": [
