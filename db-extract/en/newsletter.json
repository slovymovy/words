                    {
                        "translation_id": "265f3836-8072-4471-98aa-c952d6da1a8e",
                        "source_entry_id": "4e902dfa-bd1c-32eb-bd30-93e77b053f84",
                        "source_sense_id": "f6295a47-1821-33a2-ab69-a0da95e4d574",
                        "source_sense_description": "publication",
                        "target_lang_word": "bulletin",
                        "target_lang_code": "fr",
