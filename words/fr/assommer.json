                    "frequency": "Middle",
                    "semantic_group_id": "coup_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur a tenté d'<w>assommer</w> le gardien avec une lourde barre de fer."
                        },
                        {
                            "text": "Le boxeur a réussi à <w>assommer</w> son adversaire dès le deuxième round."
                        }
                    ],
                    "synonyms": [
                        "étourdir",
                        "sonner"
                    ],
                    "antonyms": [
                        "ranimer",
                        "réveiller"
                    ],
                    "common_phrases": [
