                    "sense_id": "b57b9b50-e01c-358a-94ab-a41b884b78a0",
                    "sense_definition": "Beinahe, so gut wie; nicht ganz, aber sehr nahe an einem Zustand oder Wert.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "annaeherung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Abendessen ist <w>fast</w> fertig, bitte deckt schon den Tisch.",
                            "target_lang_translations": {
                                "en": "Dinner is <w>almost</w> ready, please set the table already.",
                                "ru": "Ужин <w>почти</w> готов, пожалуйста, накрывайте уже на стол.",
                                "nl": "Het avondeten is <w>bijna</w> klaar, dek de tafel alvast alsjeblieft.",
                                "pl": "Kolacja jest <w>prawie</w> gotowa, nakryjcie już proszę do stołu.",
                                "fr": "Le dîner est <w>presque</w> prêt, mettez déjà la table s'il vous plaît.",
                                "it": "La cena è <w>quasi</w> pronta, per favore apparecchiate già la tavola.",
                                "cs": "Večeře je <w>skoro</w> hotová, prostřete už prosím stůl.",
                                "tr": "Akşam yemeği <w>neredeyse</w> hazır, lütfen masayı hazırlayın.",
                                "es": "La cena está <w>casi</w> lista, por favor poned ya la mesa.",
                                "zh": "晚饭<w>差不多</w>做好了，请先摆好餐桌。"
                            }
                        },
                        {
                            "text": "Wir haben heute <w>fast</w> den ganzen Tag draußen verbracht.",
                            "target_lang_translations": {
                                "en": "We spent <w>nearly</w> the whole day outside today.",
                                "ru": "Мы провели сегодня на улице <w>почти</w> весь день.",
                                "nl": "We hebben vandaag <w>bijna</w> de hele dag buiten doorgebracht.",
                                "pl": "Spędziliśmy dziś na dworze <w>prawie</w> cały dzień.",
                                "fr": "Nous avons passé <w>presque</w> toute la journée dehors aujourd'hui.",
                                "it": "Oggi abbiamo trascorso <w>quasi</w> tutta la giornata all'aperto.",
                                "cs": "Dnes jsme venku strávili <w>téměř</w> celý den.",
                                "tr": "Bugün <w>neredeyse</w> bütün günü dışarıda geçirdik.",
                                "es": "Hoy hemos pasado <w>casi</w> todo el día fuera.",
                                "zh": "今天我们<w>几乎</w>一整天都在户外度过。"
                            }
                        }
