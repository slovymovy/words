                        "glosses": [
                            "Homme costumé avec une tête de cheval et une jupe, élément traditionnel de processions et cortèges dans le folklore de nombreux pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e35a43-1160-4a82-a3c3-84cac25d3b4a",
                                "sense_id": "2afb011b-63b3-3052-bb87-532d8c4e4d96",
                                "text": "Issu de la tradition carnavalesque, Artaban notre cheval-jupon nous accompagne lors de nos festivités."
                            }
                        ]
                    }
                ],
                "translations": [
