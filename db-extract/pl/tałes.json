                                    {
                                        "sense_id": "704ec937-29ca-3dbc-93b3-05dc04491b89",
                                        "entry_id": "9015c013-0d9b-3b70-9c28-64034b107059",
                                        "glosses": [
                                            "Variante orthographique de talith."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9aab70-502e-4e19-980c-94579a254dec",
                                                "sense_id": "704ec937-29ca-3dbc-93b3-05dc04491b89",
                                                "text": "Maurice, le père d’Emma, offre à Jacques son Talit, le grand châle de prière des hommes :\n– Ainsi, il portera son grand-père sur son dos le jour où il montera à la Torah, dit Maurice à sa fille, évoquant ainsi la bar-mitsva de son petit-fils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3489c395-a875-4f86-a7f7-a18fc1e82144",
                        "source_entry_id": "b5f3d326-9da5-335d-8402-d8fbe0d03aa1",
                        "source_sense_id": "fc38f346-e68c-3de1-9ccb-4cb0923552f3",
                        "target_lang_word": "talith",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talith",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab487a2d-317b-3021-9047-7d3e1ca6dda6",
                                        "entry_id": "cca097c1-ef66-3ecf-ae72-d904957b0285",
                                        "glosses": [
                                            "Châle de prière, dans la culture judaïque."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f813bee0-9c8b-4e10-9a55-13984782ae74",
                                                "sense_id": "ab487a2d-317b-3021-9047-7d3e1ca6dda6",
                                                "text": "Le fait que toute personne, pour prier, s’enveloppe d’un talith contribue à accentuer l’idée que nous sommes tous égaux devant Dieu."
                                            },
                                            {
                                                "example_id": "791f24f7-b79e-4749-9ed3-5bb137fa6d72",
                                                "sense_id": "ab487a2d-317b-3021-9047-7d3e1ca6dda6",
                                                "text": "C’est pourquoi le châle de prière, le talith, est garni de franges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdeb67db-82e8-410e-b7a2-ee49c48002cf",
                        "source_entry_id": "b5f3d326-9da5-335d-8402-d8fbe0d03aa1",
