                "senses": [
                    {
                        "sense_id": "601fd14d-2860-34ee-89ec-680170ede8e0",
                        "entry_id": "1549a23d-1d9e-3a24-af9f-41e49b9df2da",
                        "glosses": [
                            "Akte mit Informationen über einen Mordfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f69dc313-8123-40c8-b2b6-148798d4c63f",
                                "sense_id": "601fd14d-2860-34ee-89ec-680170ede8e0",
                                "text": "„Inzwischen hatte sich Pellegrini mehr als ein Jahrzehnt tief in alte Mordakten gewühlt und jeden ungelösten Fall und jede Entführung eines kleinen Mädchens ausgegraben.“"
                            },
                            {
                                "example_id": "bdbd487b-e578-4d68-99f2-43323743e69c",
                                "sense_id": "601fd14d-2860-34ee-89ec-680170ede8e0",
                                "text": "„Um zwölf lenkte der Hunger Griessels Aufmerksamkeit ab von der Mordakte, in die er sich vertieft hatte.“"
                            },
                            {
                                "example_id": "9613f6a8-b55f-4a01-a8fd-e4297687cb61",
                                "sense_id": "601fd14d-2860-34ee-89ec-680170ede8e0",
                                "text": "„Das versetzte mich in mörderische Wut, und mit verdoppeltem Eifer machte ich mich an das Studium der Mordakte, um nicht gleich den Kampf gegen einen neuen Feind aufnehmen zu müssen - die Bürokratie, die mich im Griff hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
