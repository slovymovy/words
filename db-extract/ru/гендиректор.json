                        "source_entry_id": "bbba331b-bff1-33c9-8eca-c4275da6c3ae",
                        "source_sense_id": "8f8a437d-df47-3f71-a4af-c734ae42702f",
                        "target_lang_word": "chief executive officer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chief executive officer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba530521-d105-3ac2-b74b-8a60b11fa120",
                                        "entry_id": "10941209-fc1b-324d-9be0-aeebf93b398e",
                                        "glosses": [
                                            "The highest-ranking corporate officer or executive officer of a corporation, company, or agency, responsible for carrying out the policies of the board of directors on a day-to-day basis; CEO."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb9055ea-1cd5-40cb-a200-ed3e8849c440",
                        "source_entry_id": "bbba331b-bff1-33c9-8eca-c4275da6c3ae",
                        "source_sense_id": "8f8a437d-df47-3f71-a4af-c734ae42702f",
                        "target_lang_word": "CEO",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "CEO",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
                                        "glosses": [
                                            "Initialism of chief executive officer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cdd8d10-afdd-4a44-bbdf-d199a4ce7a1d",
                                                "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                                "text": "CEOs who once made 50 times the average worker’s salary made more than 500 times as much in 2001."
                                            },
                                            {
                                                "example_id": "95de7ea1-9bf7-4d5d-b018-30b6aee3116c",
                                                "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                                "text": "Stack ranking had come into fashion after GE CEO Jack Welch used a similar system, called rank-and-yank, to turn around that company in the 1980s and 1990s."
                                            },
                                            {
                                                "example_id": "ad1e577b-10b2-4375-9c10-7978b7b54072",
                                                "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                                "text": "Swisher then looked back at a number of tech CEOs booked for the conference in the past — from Steve Jobs to Elon Musk — and relayed that “we never promised anything or gave them any heads up. We’re journalists FFS.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57493f22-ffb4-3901-a2af-80762516e146",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
                                        "glosses": [
                                            "Initialism of civil enforcement officer."
                                        ],
                                        "tags": [
                                            "UK",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a987a5e8-6790-3a24-8685-9d5da35df483",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
                                        "glosses": [
                                            "Acronym of current engine option."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
