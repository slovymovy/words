                    },
                    {
                        "translation_id": "3ae91570-db1b-482c-814b-8764118d8ff3",
                        "source_entry_id": "b893ed05-24bd-3758-bf89-3db82e05647d",
                        "source_sense_id": "5d5acf8c-cb30-3503-ad02-21dfd3f2f7bf",
                        "source_sense_description": "een Indiaanse taal die in Zuid-Amerika wordt gesproken",
                        "target_lang_word": "Aymara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aymara",
