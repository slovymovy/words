                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen bouwden een <w>sneeuwen</w> muur om hun fort te beschermen.",
                            "target_lang_translations": {
