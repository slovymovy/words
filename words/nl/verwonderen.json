{
    "word_family": [
        "verwondering",
        "verwonderlijk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a57c4364-d15a-3cd7-9fc4-894b18ae9616",
                    "sense_definition": "iemand verbazen of een gevoel van bewondering of verrassing geven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zal me niets <w>verwonderen</w> als hij morgen te laat op zijn werk komt.",
                            "target_lang_translations": {
                                "en": "It wouldn't <w>surprise</w> me at all if he arrives late for work tomorrow."
                            }
                        },
                        {
                            "text": "De prachtige kleuren van de zonsondergang <w>verwonderen</w> de toeristen elke avond weer.",
                            "target_lang_translations": {
                                "en": "The beautiful colors of the sunset <w>amaze</w> the tourists every single evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbazen"
                    ],
                    "common_phrases": [
                        "niets verwonderen"
                    ],
                    "target_lang_definitions": {
                        "en": "To amaze someone or give them a feeling of admiration or surprise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surprise",
                                "target_lang_sense_clarification": "to cause someone to feel unexpected wonder or amazement"
                            },
                            {
                                "target_lang_word": "amaze",
                                "target_lang_sense_clarification": "to fill someone with great surprise or wonder"
                            },
                            {
                                "target_lang_word": "astonish",
                                "target_lang_sense_clarification": "to surprise someone very much"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14300683-0266-355f-86b5-7c68b840aa51",
                    "sense_definition": "zich verbazen over iets dat men vreemd, onverwacht of bijzonder vindt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verwonderde</w> me over de grote hoeveelheid snoepgoed in die auto.",
                            "target_lang_translations": {
                                "en": "I <w>was surprised</w> by the large amount of candy in that car."
                            }
                        },
                        {
                            "text": "Zij <w>verwonderen</w> zich over de snelle groei van de planten in de tuin.",
                            "target_lang_translations": {
                                "en": "They <w>marvel</w> at the rapid growth of the plants in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbazen"
                    ],
                    "common_phrases": [
                        "zich verwonderen over"
                    ],
                    "target_lang_definitions": {
                        "en": "To be amazed or surprised by something that one finds strange, unexpected, or special."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be surprised",
                                "target_lang_sense_clarification": "to feel surprise about something unexpected"
                            },
                            {
                                "target_lang_word": "marvel",
                                "target_lang_sense_clarification": "to be filled with wonder or astonishment"
                            },
                            {
                                "target_lang_word": "wonder",
                                "target_lang_sense_clarification": "to feel admiration and surprise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}