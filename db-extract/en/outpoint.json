                                "example_id": "6044bd2a-0821-49d7-af65-cfc56622993c",
                                "sense_id": "caacca67-cb3e-3e75-8003-c405d7c8a314",
                                "text": "Speaking from the Philippines, where he easily outpointed Argentine Angel Hugo Ramirez in front of a sellout crowd of almost 10,000 on Saturday night, Katsidis said he was ready to fight in front of Australian fans after an absence of two years."
                            }
                        ]
                    },
