{
    "word_family": [
        "gullibility",
        "gullibly",
        "gull"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f2e71207-e0e0-3857-9f69-e326c4fda75f",
                    "sense_definition": "Easily deceived or tricked because of a lack of experience or being too trusting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naivety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman targeted <w>gullible</w> customers who were likely to believe his exaggerated claims about the product.",
                            "target_lang_translations": {
                                "ru": "Продавец выбирал <w>доверчивых</w> покупателей, которые, скорее всего, поверили бы его преувеличенным заявлениям о товаре."
                            }
                        },
                        {
                            "text": "He was so <w>gullible</w> that he actually believed the prank his friends played on him.",
                            "target_lang_translations": {
                                "ru": "Он был настолько <w>наивным</w>, что действительно поверил в розыгрыш, который устроили его друзья."
                            }
                        }
                    ],
                    "synonyms": [
                        "naive",
                        "credulous",
                        "wide-eyed",
                        "born yesterday"
                    ],
                    "antonyms": [
                        "skeptical",
                        "cynical",
                        "shrewd",
                        "suspicious"
                    ],
                    "common_phrases": [
                        "gullible-enough to believe",
                        "prey on gullible people"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко поддающийся обману или хитрости из-за недостатка опыта или излишней доверчивости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверчивый",
                                "target_lang_sense_clarification": "слишком склонный верить людям"
                            },
                            {
                                "target_lang_word": "легковерный",
                                "target_lang_sense_clarification": "готовый верить всему без доказательств"
                            },
                            {
                                "target_lang_word": "наивный",
                                "target_lang_sense_clarification": "не имеющий жизненного опыта"
                            },
                            {
                                "target_lang_word": "простодушный",
                                "target_lang_sense_clarification": "безобидный и не ожидающий подвоха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da8f3d64-50fe-38a1-8a32-e4c4c7ad6538",
                    "sense_definition": "A person who is easily fooled or tricked by others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naivety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scammer looked for <w>gullibles</w> in the crowd who would fall for his quick-money scheme.",
                            "target_lang_translations": {
                                "ru": "Мошенник искал в толпе <w>простаков</w>, которые клюнули бы на его схему быстрого заработка."
                            }
                        },
                        {
                            "text": "Spurious accounts that snare the <w>gullible</w> are readily available on the internet today.",
                            "target_lang_translations": {
                                "ru": "В интернете сегодня легко найти поддельные аккаунты, заманивающие в ловушку <w>легковерных</w> людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "naif"
                    ],
                    "antonyms": [
                        "skeptic"
                    ],
                    "common_phrases": [
                        "snare the gullible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого легко одурачить или обмануть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простак",
                                "target_lang_sense_clarification": "наивный человек, которого легко обмануть"
                            },
                            {
                                "target_lang_word": "легковерный человек",
                                "target_lang_sense_clarification": "тот, кто верит всему на слово"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}