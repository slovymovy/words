                "senses": [
                    {
                        "sense_id": "c4d2d365-aa68-3682-a07c-a0c67b09737c",
                        "entry_id": "9c7bd909-28a9-3f97-b28c-c60294a96b34",
                        "glosses": [
                            "mit Peperoni belegte Pizza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54cc6a32-913c-4c34-9bd6-b24dcaafb477",
                                "sense_id": "c4d2d365-aa68-3682-a07c-a0c67b09737c",
                                "text": "„Onkel Enzo hat nicht fünfzig Jahre lang seiner Familie und seinem Land gedient, damit er in einem Alter, in dem die meisten Golf spielen oder ihre Enkeltöchter auf den Knien wiegen, tropfnass aus der Badewanne steigen und sich hinknien und die Füße eines sechzehnjährigen Skatepunks küssen muss, dessen Peperonipizza erst nach einunddreißig Minuten zugestellt wurde.“"
                            },
                            {
                                "example_id": "0efaa2ee-115a-4f23-baba-6c56ff8caa1c",
                                "sense_id": "c4d2d365-aa68-3682-a07c-a0c67b09737c",
                                "text": "„Wer ein herzhaftes Essen plant, zum Beispiel Chili con Carne oder Peperonipizza, sollte neben Messer und Gabel auch eine Packung Taschentücher auf den Tisch legen.“"
                            },
                            {
                                "example_id": "f6e69f0e-340c-4d6c-b4cd-fc584e9179d9",
                                "sense_id": "c4d2d365-aa68-3682-a07c-a0c67b09737c",
                                "text": "„Sie gingen mit ihrem Tee und ihrer Peperonipizza aus der Mikrowelle in Ma Stewarts Büro, ein kleines Zimmer im hinteren Teil des Gebäudes.“"
                            },
                            {
                                "example_id": "8d1a41ef-9db9-459e-9415-b3f2f343ba6d",
                                "sense_id": "c4d2d365-aa68-3682-a07c-a0c67b09737c",
                                "text": "„Mit einer Peperonipizza und einer Flasche Jim Beam machten sie es sich im ehemaligen Herrenzimmer bequem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
