            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9dc2f0e3-b897-3a9b-877c-b0b0851427c5",
                    "sense_definition": "deel uitmaken van een bepaalde groep, categorie of verzameling",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lidmaatschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>behoort</w> tot de beste studenten van haar klas.",
                            "target_lang_translations": {
                                "en": "She <w>is among</w> the best students in her class."
                            }
                        },
                        {
                            "text": "Deze tradities <w>behoren</w> tot de oudste van het land.",
                            "target_lang_translations": {
                                "en": "These traditions <w>are among</w> the oldest in the country."
                            }
                        }
                    ],
                    "synonyms": [
                        "deel uitmaken van",
                        "vallen onder"
                    ],
                    "common_phrases": [
                        "behoren tot de groep",
                        "behoren tot de mogelijkheden"
                    ],
                    "target_lang_definitions": {
                        "en": "To be part of a specific group, category, or collection."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "belong to",
                                "target_lang_sense_clarification": "to be a member of a group or category"
                            },
                            {
                                "target_lang_word": "be among",
                                "target_lang_sense_clarification": "to be included in a specific set of people or things"
                            },
                            {
                                "target_lang_word": "rank among",
                                "target_lang_sense_clarification": "to be classified as one of a certain quality"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "742e2d2e-cd4b-348a-9baa-eaa74b69d3b6",
                    "sense_definition": "nodig of verplicht zijn volgens de regels van fatsoen of gebruik",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>behoort</w> je excuses aan te bieden als je een fout maakt.",
                            "target_lang_translations": {
                                "en": "You <w>ought to</w> apologize if you make a mistake."
                            }
                        },
                        {
                            "text": "Dit <w>behoort</w> met een stemming gepaard te gaan volgens de statuten.",
                            "target_lang_translations": {
                                "en": "This <w>should</w> be accompanied by a vote according to the statutes."
                            }
                        }
                    ],
                    "synonyms": [
                        "horen",
                        "dienen",
                        "moeten"
                    ],
                    "common_phrases": [
                        "zoals het behoort",
                        "behoren te doen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt met 'te' + infinitief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be necessary or required according to rules of decency, custom, or regulations."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ought to",
                                "target_lang_sense_clarification": "used to indicate duty or correctness"
                            },
                            {
                                "target_lang_word": "should",
                                "target_lang_sense_clarification": "used to indicate what is proper or expected"
                            },
                            {
                                "target_lang_word": "be supposed to",
                                "target_lang_sense_clarification": "to be expected to behave in a certain way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d65e83b-8b15-3767-95fe-3a83a0c53296",
                    "sense_definition": "passend of gepast zijn voor een bepaalde situatie of persoon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gepastheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>behoort</w> niet aan mij om daarover te oordelen.",
                            "target_lang_translations": {
                                "en": "It does not <w>behoove</w> me to judge that."
                            }
                        },
                        {
                            "text": "Zulk gedrag <w>behoort</w> een heer niet in het openbaar.",
                            "target_lang_translations": {
                                "en": "Such behavior does not <w>befit</w> a gentleman in public."
                            }
                        }
                    ],
                    "synonyms": [
                        "betamen",
                        "passen"
                    ],
                    "common_phrases": [
                        "het behoort niet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak formeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be appropriate or fitting for a specific situation or person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "befit",
                                "target_lang_sense_clarification": "to be appropriate for someone of a certain station"
                            },
                            {
                                "target_lang_word": "behoove",
                                "target_lang_sense_clarification": "to be proper or necessary for someone (formal)"
                            },
                            {
                                "target_lang_word": "be fitting",
                                "target_lang_sense_clarification": "to be suitable or right for the occasion"
                            }
                        ]
                    }
                }
            ]
        }
