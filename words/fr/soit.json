                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Soit</w> un triangle rectangle dont les côtés mesurent trois et quatre centimètres."
                        },
                        {
