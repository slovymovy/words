                                "target_lang_sense_clarification": "overly concerned with material wealth rather than spiritual values"
                            },
                            {
                                "target_lang_word": "money-grubbing",
                                "target_lang_sense_clarification": "excessively obsessed with obtaining money"
                            }
                        ]
                    }
                },
