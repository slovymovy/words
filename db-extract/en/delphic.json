                "senses": [
                    {
                        "sense_id": "2ffcb213-3fe1-3954-8e01-5de8987638d8",
                        "entry_id": "5902276b-a8b4-3b5a-a793-e152cb2d74af",
                        "glosses": [
                            "Of or relating to Delphi or its oracles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3e198650-5db0-3549-ab46-36f0c95934dd",
                        "entry_id": "5902276b-a8b4-3b5a-a793-e152cb2d74af",
                        "glosses": [
                            "Obscurely prophetic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db6f77e-05c8-4e10-a69e-c5b36d1bb92f",
                                "sense_id": "3e198650-5db0-3549-ab46-36f0c95934dd",
                                "text": "He telephoned airlines, government contacts and a whole host of pale, over-brushed acquaintances in the U.S. Consulate, who infuriated him with arch and Delphic answers."
                            },
                            {
                                "example_id": "c3529032-4b0f-4b82-b54f-acdc94029652",
                                "sense_id": "3e198650-5db0-3549-ab46-36f0c95934dd",
                                "text": "Carthage now sent two embassies to Rome, one after the other, essentially to ask forgiveness and avert war. The first was told enigmatically that it would depend on \"if the Carthaginians give satisfaction to the Romans\". The ensuing embassy received the still more delphic reply that \"the Carthaginians knew very well\" what this meant."
                            },
                            {
                                "example_id": "f6589674-ad8a-4bf0-bb54-5dcd96a1dc71",
                                "sense_id": "3e198650-5db0-3549-ab46-36f0c95934dd",
                                "text": "Campbell et al. [&hellip] called the first effect Odyssian—the central bank is committing itself to keeping rates low in the future—and the second Delphic—the central bank is signaling a change in the outlook for the economy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9de67b6e-df31-4a06-b0c9-bb93d2b5c34d",
                        "source_entry_id": "5902276b-a8b4-3b5a-a793-e152cb2d74af",
                        "source_sense_description": "of or relating to Delphi",
                        "target_lang_word": "delphique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delphique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                        "entry_id": "a3adbacc-2650-3863-9d78-7227ac08e7d6",
                                        "glosses": [
                                            "Relatif à Delphes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fefcd4a-8eb7-411b-b2c6-13b3ef0f599c",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "La sibylle delphique : La sibylle qui rendait ses oracles à Delphes."
                                            },
                                            {
                                                "example_id": "824fb475-e22e-461e-92ee-31eb659746fa",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "Le stade pythique ou delphique de 1000 pieds delphiques était de même valeur que le stade olympique."
                                            },
                                            {
                                                "example_id": "88e628c0-5466-40bd-8677-1682ed5bfdc5",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "— Monsieur Le Ménil, si, l’année prochaine, un dauphin vient encore nager autour de votre bateau, je vous prie, jouez pour lui, sur la flûte, l’hymne à Apollon delphique."
                                            },
                                            {
                                                "example_id": "b8730623-3e3e-46c8-a331-c2b2db5a90ad",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "Bien qu’il fasse preuve, des fois, de mansuétudes assez mal explicables, sa parole est pour moi oracle delphique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
