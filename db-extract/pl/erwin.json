                                            {
                                                "example_id": "52062433-39f8-49c2-b2ec-07ea922262ff",
                                                "sense_id": "920f0e92-dccb-3e54-a7a1-2f015b7c1817",
                                                "text": "Du kannst Erwin fragen, der kennt sich mit Motorrädern aus."
                                            }
