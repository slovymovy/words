    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bad01fd0-6b89-322f-ad04-ab86798173e8",
                "word": "tachograph",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "20888036-2bd0-4ece-9f97-38086c57b859",
                        "entry_id": "bad01fd0-6b89-322f-ad04-ab86798173e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "tachographs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec651e47-6794-3935-a8a9-59b8d10b61ea",
                        "entry_id": "bad01fd0-6b89-322f-ad04-ab86798173e8",
                        "glosses": [
                            "A device that records the distance and time traveled by a vehicle (especially a truck or coach), used to check the drivers' working time."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03f1454c-0226-4c85-a325-603d9b8d4668",
                        "source_entry_id": "bad01fd0-6b89-322f-ad04-ab86798173e8",
                        "source_sense_id": "ec651e47-6794-3935-a8a9-59b8d10b61ea",
                        "source_sense_description": "checking device",
                        "target_lang_word": "chronotachygraphe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronotachygraphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b59d14b-6773-3f78-a11d-765a2c4a89d1",
                                        "entry_id": "ad875775-ac3d-3ccc-97d3-6b109aa6956c",
                                        "glosses": [
                                            "Appareil de mesure et d’enregistrement de la vitesse et de temps de conduite des camions et autocars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a95e7af-2ebc-4630-96c9-86d192a0a741",
                                                "sense_id": "0b59d14b-6773-3f78-a11d-765a2c4a89d1",
                                                "text": "Autrefois analogique à tracé sur un disque de papier, le chronotachygraphe est désormais numérique et utilise des supports d'enregistrement flash."
                                            },
                                            {
                                                "example_id": "2c413771-e19b-4faa-a21a-3da2a91b079d",
                                                "sense_id": "0b59d14b-6773-3f78-a11d-765a2c4a89d1",
                                                "text": "Cette fois-ci, il ne s’agissait ni de pneus, ni de freins, mais de cet instrument appelé « chronotachygraphe » qui permet d’enregistrer les durées de route et par là même de vérifier en quelque sorte automatiquement si les dispositions légales relatives à la durée du travail sont respectées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eae98e95-c262-432a-8008-82cc7e9c4d28",
                        "source_entry_id": "bad01fd0-6b89-322f-ad04-ab86798173e8",
                        "source_sense_id": "ec651e47-6794-3935-a8a9-59b8d10b61ea",
                        "source_sense_description": "checking device",
                        "target_lang_word": "mouchard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mouchard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8d81ec-1ca2-3a78-b40b-03ade023fb4c",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Espion, indicateur pour la police."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db00b7c2-70b9-4503-8c12-b714606d7fd1",
                                                "sense_id": "cf8d81ec-1ca2-3a78-b40b-03ade023fb4c",
                                                "text": "Les listes des mouchards de Fouché ne nous ont pas été conservées, le Ministre les ayant brulées en Juin 1810 au moment de sa seconde disgrâce."
                                            },
                                            {
                                                "example_id": "fb253d6a-1863-473d-8d46-943c6c50741f",
                                                "sense_id": "cf8d81ec-1ca2-3a78-b40b-03ade023fb4c",
                                                "text": "Philosophe était le surnom que Peyrade donnait à Contenson, et que méritait cet Épictète des mouchards."
                                            },
                                            {
                                                "example_id": "528174df-876e-4548-ad8b-3da3124eee86",
                                                "sense_id": "cf8d81ec-1ca2-3a78-b40b-03ade023fb4c",
                                                "text": "Sauf des mouchards et des gendarmes,\nOn ne voit plus par les chemins,\nQue des vieillards tristes en larmes,\nDes veuves et des orphelins."
                                            },
                                            {
                                                "example_id": "96a72b56-19dd-409b-967e-aa641c937bba",
                                                "sense_id": "cf8d81ec-1ca2-3a78-b40b-03ade023fb4c",
                                                "text": "Il s'abaisse jusqu'à recevoir dans son cabinet de ministre de l'Intérieur un bas mouchard, un nommé Métivier qu'il veut utiliser pour dissoudre — sans doute (?) — les grèves de Draveil-Vigneux (août 1908)."
                                            },
                                            {
                                                "example_id": "e3e3d261-451b-4b03-a5a8-e0afa8fbf372",
                                                "sense_id": "cf8d81ec-1ca2-3a78-b40b-03ade023fb4c",
                                                "text": "Voyez-vous […] nous avons à Paris plusieurs catégories de malandrins. Pour nous en garantir, il nous faut recourir à des hommes présentant des qualités particulières. Ces hommes sont des mouchards, comme vous les appelez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "662ce67b-d1a8-36b7-a244-925cd5c244b2",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Personne qui observe des agissements pour en rendre compte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "182976f8-866c-3f2f-a7eb-b0ec2362c92f",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Personne qui en dénonce une autre."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cfff874-4e8b-49ce-9e2f-42dc2f95f6a5",
                                                "sense_id": "182976f8-866c-3f2f-a7eb-b0ec2362c92f",
                                                "text": "– Vous allez me dénoncer?\nLe patron m'a regardé, sourcils froncés.\n– J'ai une tête de mouchard?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c552b86-8bf1-3b30-b17b-18da6d04c318",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Trou qui permet d'observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "571fb4d0-e4bb-40ed-8896-b6dbbfd668ee",
                                                "sense_id": "8c552b86-8bf1-3b30-b17b-18da6d04c318",
                                                "text": "D'autant plus que mes frères se disputaient le plaisir de coller leur œil au mouchard lors de votre dernière incursion dans mon domaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2db421b6-3f6e-36d7-9933-5d0e031ea465",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Appareil servant à enregistrer des données pour contrôler la vitesse ou la vigilance de conducteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5de0739-46e9-45ca-81a1-b435eee6838d",
                                                "sense_id": "2db421b6-3f6e-36d7-9933-5d0e031ea465",
                                                "text": "Ainsi, cet ingénieur-traction de l’Est de 1866 à 1908, a laissé à la postérité le « flaman », plus communément appelé le « mouchard », appareil indicateur-enregistreur de vitesse servant à pister les mécaniciens pendant leur temps de conduite d’un train."
                                            },
                                            {
                                                "example_id": "d64f8e52-e694-47ff-bddc-61381a4c913a",
                                                "sense_id": "2db421b6-3f6e-36d7-9933-5d0e031ea465",
                                                "text": "Mais ce que les gendarmes ne pouvaient faire a priori, il leur arrivait parfois de le faire a posteriori : comme le « mouchard » (quand il n’est pas trafiqué) enregistre, sur chaque camion, la vitesse exacte à chaque instant de la conduite, il était facile de contrôler si la vitesse maximale avait été respectée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa9982b-fb0e-3cb5-9975-baf5b8b6ba4d",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Avion de reconnaissance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e68e4243-8363-3f28-a87c-76d2b2471c0e",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Logiciel espion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c721e214-ddda-4fb7-bb89-2622432751a4",
                                                "sense_id": "e68e4243-8363-3f28-a87c-76d2b2471c0e",
                                                "text": "Nos données personnelles, désormais, sont récoltées partout et par tous, dès que l’on utilise un moteur de recherche, un objet connecté, son téléphone, bien sûr, sa montre, son compteur électrique... Les assureurs adorent ces mouchards, qui renseignent sur nos petites manies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "126a82b6-2bcb-3ecf-b2a9-bf28cdddb77d",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Appareil doté d’un logiciel permettant d’espionner et d’enregistrer les conversations, les déplacements etc. d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5537389-8e11-4a7b-b443-1b7a1e23775b",
                                                "sense_id": "126a82b6-2bcb-3ecf-b2a9-bf28cdddb77d",
                                                "text": "Auparavant, poser un mouchard téléphone demandait de véritables connaissances techniques ainsi qu’un savoir faire, mais de nos jours, il n’y a rien de plus facile avec les progrès de la technologie."
                                            },
                                            {
                                                "example_id": "c5757d2a-0c53-440c-ba97-48b34dd4fc22",
                                                "sense_id": "126a82b6-2bcb-3ecf-b2a9-bf28cdddb77d",
                                                "text": "Le mouchard GPS (on parle aussi de GPS miniature, tracker GPS ou GPS espion) est un appareil de taille réduite qui enregistre les modalités des déplacements d’une personne ou d’un véhicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc8cca7d-e2ac-3b99-b59b-cdd97d613c81",
                                        "entry_id": "98063f77-ad5d-34f8-91e3-c1fd713b5f1e",
                                        "glosses": [
                                            "Compas de route inversé suspendu au-dessus du lit du capitaine d'un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c415bba6-8dc4-4e1d-be4e-562d0e5900d4",
                                                "sense_id": "fc8cca7d-e2ac-3b99-b59b-cdd97d613c81",
                                                "text": "Ça c’est un mouchard, un compas qui se fixe au plafond de la cabine du capitaine. C’est pratique quand il est encore au lit..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
