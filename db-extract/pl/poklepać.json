                "senses": [
                    {
                        "sense_id": "1a85a2ef-b334-3bef-b614-5b8c7eb774f8",
                        "entry_id": "9d7a1d19-1f7c-398d-8956-6800b0f5140e",
                        "glosses": [
                            "uderzyć serdecznie dłonią w celu okazania sympatii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe8e585-835d-4798-97c4-465f016cde8e",
                                "sense_id": "1a85a2ef-b334-3bef-b614-5b8c7eb774f8",
                                "text": "Vimes, stworzony przez naturę jako jeden z tych mężczyzn, którzy nie są zdolni do pocałowania publicznie własnej żony, poklepał ją bezradnie po ramieniu"
                            },
                            {
                                "example_id": "d063ade0-3b01-46fa-81fe-262a69922a7a",
                                "sense_id": "1a85a2ef-b334-3bef-b614-5b8c7eb774f8",
                                "text": "Ryza papieru, którą wręczył mi gość, zaskoczyła mnie bardziej, niż jego zdziwił widok mojego ciała sauté. Mimo to wzięłam pakunek w ręce, a on poklepał mnie po pośladkach i mruknął: – Takie dupsko to rozumiem!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
