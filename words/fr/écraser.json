                        "écraser les données"
                    ]
                },
                {
                    "sense_id": "68decbd1-3968-3773-baf3-033585fd82f5",
                    "sense_definition": "Se taire ou renoncer à protester par prudence ou par contrainte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant la colère justifiée de son responsable, il a préféré s'<w>écraser</w> sans répliquer."
                        },
                        {
                            "text": "Tu ferais mieux de t'<w>écraser</w> plutôt que d'aggraver la situation avec tes remarques inutiles."
                        }
                    ],
                    "traits": [
