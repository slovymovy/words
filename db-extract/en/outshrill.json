                "senses": [
                    {
                        "sense_id": "8c646708-5c5d-37c1-aada-edeac620dd1b",
                        "entry_id": "ce2e40dc-c352-3055-bdad-53114542072e",
                        "glosses": [
                            "To surpass in shrilling; to cry louder than."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "677e455e-d8c2-4e7e-bcf9-b877b4923f89",
                                "sense_id": "8c646708-5c5d-37c1-aada-edeac620dd1b",
                                "text": "Once again she had been stricken, beaten down, so violated that to give utterance to her feelings might have outshrilled all the criers in hell."
                            },
                            {
                                "example_id": "02127b14-3784-4fc3-970e-eaf0061e6ac6",
                                "sense_id": "8c646708-5c5d-37c1-aada-edeac620dd1b",
                                "text": "For one terrifying moment, she felt nothing beneath her feet; empty space whirling round and past her, the slang and heckle of the wind outshrilling her own shriek of fear."
                            }
                        ]
                    }
                ],
