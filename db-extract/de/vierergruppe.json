                "senses": [
                    {
                        "sense_id": "e255474a-0a10-3f60-bb3a-1659c7ca3cfb",
                        "entry_id": "5d6e47a2-f746-3437-95b6-106928ece8a6",
                        "glosses": [
                            "Gruppe von vier Personen oder Objekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6191b378-4f00-49be-a02c-9c72f3bc6653",
                                "sense_id": "e255474a-0a10-3f60-bb3a-1659c7ca3cfb",
                                "text": "„Die Kleinsche Vierergruppe V ist eine kommutative, jedoch keine zyklische Gruppe.“"
                            },
                            {
                                "example_id": "4ad254f0-535d-41f5-afca-628345252199",
                                "sense_id": "e255474a-0a10-3f60-bb3a-1659c7ca3cfb",
                                "text": "„Internationale Kontonummern gliedern sich in fünf Vierergruppen und eine Zweiergruppe.“"
                            },
                            {
                                "example_id": "fa3c58ea-6f1e-4448-a8e3-e6b44991eea3",
                                "sense_id": "e255474a-0a10-3f60-bb3a-1659c7ca3cfb",
                                "text": "„Um als Erstplatzierter oder als einer der drei besten Zweiten der fünf Vierergruppen noch eine realistische Chance aufs Weiterkommen zu haben, müssten die Berliner ihre beiden restlichen Gruppenspiele bei Volley Ljubljana aus Slowenien und beim russischen Meister Kuzbass Kemerowo mit 3:0 oder 3:1 gewinnen.“"
                            }
                        ],
