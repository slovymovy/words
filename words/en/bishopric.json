            "senses": [
                {
                    "sense_id": "f7ca70d3-8ab8-3aed-882a-03b8d17ae7db",
                    "sense_definition": "A diocese or church district under the jurisdiction of a bishop.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "episcopal_jurisdiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Later that year, he was appointed to the ancient <w>bishopric</w> of Durham.",
                            "target_lang_translations": {
                                "es": "Más tarde ese año, fue nombrado para el antiguo <w>obispado</w> de Durham."
                            }
                        },
                        {
                            "text": "The lands belonging to the <w>bishopric</w> produced a significant income for the church.",
                            "target_lang_translations": {
                                "es": "Las tierras pertenecientes al <w>obispado</w> generaban ingresos significativos para la iglesia."
                            }
                        }
                    ],
                    "synonyms": [
                        "diocese"
                    ],
                    "common_phrases": [
                        "ancient bishopric"
                    ],
                    "target_lang_definitions": {
                        "es": "Territorio o distrito eclesiástico bajo la jurisdicción de un obispo; diócesis."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "obispado",
                                "target_lang_sense_clarification": "territorio o diócesis"
                            },
                            {
                                "target_lang_word": "diócesis",
                                "target_lang_sense_clarification": "distrito eclesiástico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebf7841a-ae1a-3cde-b67f-e1e21c498f9b",
                    "sense_definition": "The office, rank, or position of a bishop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "episcopal_jurisdiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served faithfully in his <w>bishopric</w> for more than three decades.",
                            "target_lang_translations": {
                                "es": "Sirvió fielmente en su <w>episcopado</w> durante más de tres décadas."
                            }
                        },
                        {
                            "text": "The clergyman was deemed well suited to hold the <w>bishopric</w>.",
                            "target_lang_translations": {
                                "es": "Se consideró que el clérigo era muy idóneo para ostentar el <w>obispado</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a bishopric"
                    ],
                    "target_lang_definitions": {
