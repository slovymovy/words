                    {
                        "translation_id": "4cfedfc0-5223-49a7-8246-31b91a372295",
                        "source_entry_id": "3ce84379-90aa-3b1a-a2cc-4588bc379b71",
                        "source_sense_id": "e6db89d5-16fe-3ae2-8a13-1848cf1286aa",
                        "source_sense_description": "Mitschnitt in Videoform",
                        "target_lang_word": "видеозапись",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "видеозапись",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4db6bf-233d-3487-a76a-d9787e58d54d",
                                        "entry_id": "98b2a4c7-1bb9-38f1-b4df-590492e4e139",
                                        "glosses": [
                                            "процесс записи цифровых или аналоговых сигналов, несущих информацию об изображении и (обычно) о сопутствующем звуке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8350cf2-baff-49d0-bfcf-e673b5374a10",
                                                "sense_id": "9e4db6bf-233d-3487-a76a-d9787e58d54d",
                                                "text": "В нескольких полицейских участках США испытывается видеонасадка на пистолет. Этот приборчик размером с пачку сигарет укрепляется под стволом табельного оружия полицейского, включается, когда пистолет выхватывают из кобуры, и ведёт аудио- и видеозапись на протяжении до часа. Таким образом документируется любое применение оружия полицейскими."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c567c3a1-2a13-3334-86d0-036bfab14278",
                                        "entry_id": "98b2a4c7-1bb9-38f1-b4df-590492e4e139",
                                        "glosses": [
                                            "результат такого процесса; носитель информации с записанными на нём визуальными и звуковыми данными; также сами эти данные"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42956eaf-080c-455c-88f8-0c4d5e0cacd6",
                                                "sense_id": "c567c3a1-2a13-3334-86d0-036bfab14278",
                                                "text": "На восток шёл прямой эфир, а вечером в этот день, в эту субботу на Москву и европейскую часть страны передавалась видеозапись."
                                            },
                                            {
                                                "example_id": "0bcbe611-c489-444f-91ca-8edfbd8c631b",
                                                "sense_id": "c567c3a1-2a13-3334-86d0-036bfab14278",
                                                "text": "4 октября Осечкин сообщил, что в распоряжение проекта Gulagu.net попало около 40 Гб видеозаписей пыток и издевательств в российских местах лишения свободы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
