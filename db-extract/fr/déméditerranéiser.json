                "senses": [
                    {
                        "sense_id": "a5821b47-4d29-3871-bc52-9a8008f70934",
                        "entry_id": "24de59fd-db95-33cb-9abf-8839cba6ddab",
                        "glosses": [
                            "Faire perdre son caractère méditerranéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8dd87f-82fa-4c42-ac74-383aada7efd5",
                                "sense_id": "a5821b47-4d29-3871-bc52-9a8008f70934",
                                "text": "D’Annunzio est fasciné par la France, Corradini par l’Angleterre et les Etats-Unis, Prezzolini lui entend presque déméditerranéiser l’Italie."
                            },
                            {
                                "example_id": "4699a044-356f-40db-8dba-453951c0abf7",
                                "sense_id": "a5821b47-4d29-3871-bc52-9a8008f70934",
                                "text": "On colle son nez à la vitre glacée du train pour Lucerne depuis Bellinzone, et l'on s’ébaubit de l’évolution du paysage qui se déméditerranéise au fur et à mesure qu’on s’approche des orographies escarpées et romantiques de l’Urschweiz."
                            },
                            {
                                "example_id": "525bf350-d656-48af-89ff-a230c3140f7a",
                                "sense_id": "a5821b47-4d29-3871-bc52-9a8008f70934",
                                "text": "C’est triste un grand homme aux yeux clairs Déméditerranéisé"
                            }
                        ]
                    }
                ],
