                        "examples": [
                            {
                                "example_id": "e661879b-bf5e-4bce-830d-0805fa9c5479",
                                "sense_id": "afa722f4-5173-3872-b2dd-81e481144abd",
                                "text": "Le mécanicien, Berthollon, est un invraisemblable trouffion, un tout petit bonhomme pareil au Simplet de Blanche-Neige, avec une capote comme une houppelande de clown, battant ses talons, lui couvrant les doigts jusqu’aux ongles […]"
                            },
                            {
                                "example_id": "2bb639f3-ebc8-4b7f-8e8d-9f83b7ade278",
                                "sense_id": "afa722f4-5173-3872-b2dd-81e481144abd",
                                "text": "Ceux qu'ont l'pognon, ceux-là r'viendront\nCar c'est pour eux qu'on crève\nMais c'est fini, car les trouffions\nVont tous se mettre en grève."
                            },
                            {
                                "example_id": "4fd0cf3a-9b2d-43ad-adab-86eb6202af16",
                                "sense_id": "afa722f4-5173-3872-b2dd-81e481144abd",
                                "text": "Aucun officier, dont la parole aurait eu, certes, plus de poids, n’avait daigné se déranger pour un simple «trouffion»"
                            }
                        ]
                    }
