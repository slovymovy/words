                    },
                    {
                        "form_id": "46a39252-2823-420c-9d98-19c0701b40c1",
                        "entry_id": "c0affdb2-82f0-3225-840b-685d5eda1150",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kunstgriffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                        "entry_id": "c0affdb2-82f0-3225-840b-685d5eda1150",
                        "glosses": [
                            "besonders wirksame Methode, ein bestimmtes Ziel auf einfache Weise zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a63f425-ff88-40ae-a61f-997fc810e38d",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "Mir hilft beim Abnehmen ein kleiner Kunstgriff: Wenn der Appetit immer größer wird, trinke ich ein großes Glas Wasser."
                            },
                            {
                                "example_id": "80f9cdf9-d372-4960-ae8e-31cb5b53311e",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "„Ein einfacher Kunstgriff gestattet jedoch, diese Schwierigkeit zu umgehen.“ (Schwarzschild)"
                            },
                            {
                                "example_id": "529745dd-295b-44e0-bcc5-9d1e725edd46",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "„[…] in dem Roman [wird] Gesines Leben […] rekonstruiert. Johnson wählt dafür einen literarischen Kunstgriff, er lässt Gesindes zehnjährige Tochter Marie die Erinnerung einfordern, die die Mutter mit Fragen löchert.“"
                            },
                            {
                                "example_id": "bbc13eac-dbf6-4a11-85a2-782a3276fb10",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "„Auf das Genre des Dokudramas zurückzugreifen - einen Mix aus dokumentarischen und Spielfilmelementen - erwies sich also als geschickter Kunstgriff.“"
                            },
                            {
                                "example_id": "684509b9-b8ce-41c9-bd11-606f72807024",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "„[Michelangelos] Kunstgriff des Non-Finito, bei dem die Skulptur nur unvollständig aus dem Steinblock herausgeschält zu sein scheint, faszinierte [Rodin] und sollte später viele seiner eigenen Werke kennzeichnen.“"
                            },
                            {
                                "example_id": "563e735c-8412-47d1-b1de-48d8d43e8b81",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "„Besonders die Gefühle [Donald Ducks] wurden durch einen genialen Kunstgriff zum Ausdruck gebracht, der im Laufe der Zeit auch in die deutsche Alltagssprache Eingang fand: den Verben wurden einfach die Endsilben gekappt. Grummel!, Schnarch!, Stöhn!, Keuch!, Ächz!, Schmatz!, Seufz!“"
                            },
                            {
                                "example_id": "50110e10-eeeb-4dfd-9873-f34af311527a",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "[F. Kafka: Die Verwandlung:] „[…] den Expressionisten war zwar der Kunstgriff vertraut, eine innere Befindlichkeit körperhaft nach außen zu stülpen, doch die schrille expressionistische Tonart ist hier ebenso wenig zu vernehmen wie im Urteil.“"
                            },
                            {
                                "example_id": "40856861-1a7f-47b1-bf91-d6d37e41dd3b",
                                "sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                                "text": "[Nürnberg - Ein Viertel der Bevölkerung von Armut bedroht:] „Der Bayerische Landesverband der Arbeiterwohlfahrt kritisiert diese Berechnung [der Armutsgefährdungsquote] und hält sie für \"mehr als einen Kunstgriff in der Statistik“. Wegen der statistisch höheren Einkommen in Bayern müsse man als Grundlage des Vergleichs natürlich auch das bayerische Durchschnittseinkommen heranziehen – nicht das bundesweite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d73c20ec-ae03-4f15-9cfc-f754c671c3f6",
                        "source_entry_id": "c0affdb2-82f0-3225-840b-685d5eda1150",
                        "source_sense_id": "4f31cbed-4295-3262-a98b-e881d1572ed0",
                        "source_sense_description": "besonders wirksame Methode, ein bestimmtes Ziel auf einfache Weise zu erreichen",
                        "target_lang_word": "stratagem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratagem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "A tactic or artifice designed to gain the upper hand, especially one involving underhanded dealings or deception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7825d9-7ae7-472b-beda-cda531d7e58f",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "Near-synonyms: ploy, ruse"
                                            },
                                            {
                                                "example_id": "cbaa8b57-de38-4f4f-84fb-79155fbc9e8a",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "Tis pollicie and ſtratageme muſt doo / That you affect, and ſo muſt you reſolue, / That vvhat you cannot as you vvould atchiue, / You muſt perforce accompliſh as you may: […]"
                                            },
                                            {
                                                "example_id": "e6d24837-aa52-4a2b-b988-5f2a9d48881b",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "She will not yet be permitted to return to the Manor House: it is too convenient for 'treasons, stratagems,' &c.; and it is as well not to be put in the way of temptation: but she will be allowed perfect liberty in London."
                                            },
                                            {
                                                "example_id": "dfb69589-6e32-4bad-8ebb-82d65ee94c1d",
                                                "sense_id": "529c3b85-aca5-3787-bf61-d20357ae379b",
                                                "text": "While Collins does include a love triangle, a coming-of-age story, and other YA-friendly elements in the mix, they serve as a Trojan horse to smuggle readers into a hopeless world where love becomes a stratagem and growing up is a matter of basic survival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a56c9d8-d421-3bb5-ad23-e5ae8056daf1",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "Specifically, such a tactic or artifice in military operation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352df56c-923f-44ad-84f8-dc53263c2e6c",
                                                "sense_id": "0a56c9d8-d421-3bb5-ad23-e5ae8056daf1",
                                                "text": "His fiery eies are fixt vpon the earth.\nAs if he now deuiſ’d some Stratageme:\nOr meant to pierce Auernus darkſome vauts.\nTo pull the triple headed dog from hell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2ec81c-8af5-3703-91d3-e76d289059ff",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "Military deception or artifice."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dfb6acc-860a-3cae-9b5f-4304071d2e69",
                                        "entry_id": "c7be0b5d-9ad0-32e3-8ce8-0bf779e3634d",
                                        "glosses": [
                                            "Cunning and artifice in general."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f607cb0f-8ec5-3e35-bb26-5f3f88d7fa61",
