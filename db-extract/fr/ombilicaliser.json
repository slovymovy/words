                "senses": [
                    {
                        "sense_id": "d85af207-7c56-3099-b424-e489fec1c2a5",
                        "entry_id": "90fa3bfc-bf40-3857-b5f4-0c8506f40fc8",
                        "glosses": [
                            "Donner un caractère ombilical à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31e527f-7f50-49b5-8e1f-aaeca60f0536",
                                "sense_id": "d85af207-7c56-3099-b424-e489fec1c2a5",
                                "text": "Au chaud, nourri, protégé, enfermé, infantilisé, embryonisé, ombilicalisé, sécurisé, cajolé."
                            },
                            {
                                "example_id": "180fef0c-6ef9-4049-a219-92b2372b4499",
                                "sense_id": "d85af207-7c56-3099-b424-e489fec1c2a5",
                                "text": "Est-ce que l'intériorisation m'ombilicalise ?"
                            },
                            {
                                "example_id": "2b6b8b3e-725b-4875-ab8b-dfa3518d6f6b",
                                "sense_id": "d85af207-7c56-3099-b424-e489fec1c2a5",
                                "text": "Dire \"merde\" à sa mère, c'est lui signifier qu'elle ne vienne plus nous rattacher sans cesse à elle, c'est prendre ses distances avec elle, alors que lui casser la gueule j'allais dire \"lui rentrer dedans\", c'est s'ombilicaliser encore plus."
                            }
                        ]
                    }
