                ],
                "senses": [
                    {
                        "sense_id": "7b71301e-dc2c-3b57-98d7-2c03e7371b2d",
                        "entry_id": "0096db8c-c02d-3dfc-88ce-9a96951be8ff",
                        "glosses": [
                            "sowjetische Besatzungszone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0be7cde-1d8d-4130-b265-dad13cc47e27",
                                "sense_id": "7b71301e-dc2c-3b57-98d7-2c03e7371b2d",
                                "text": "„In der Ostzone wurden 30000 Kriegsverbrecherprozesse angestrengt, 200000 Nazis aus Verwaltung und Wirtschaft geworfen, 20000 Lehrer (von 40000) entlassen, 500 Todesurteile gefällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2ed34fb3-a74f-3555-b479-3036423acc67",
                        "entry_id": "0096db8c-c02d-3dfc-88ce-9a96951be8ff",
                        "glosses": [
                            "oft gebrauchte Bezeichnung für die DDR nach deren Gründung"
                        ],
                        "tags": [
                            "pejorativ"
                        ],
                        "examples": [
                            {
                                "example_id": "b76fbcdb-746e-4908-bfc4-d0c216d61c23",
                                "sense_id": "2ed34fb3-a74f-3555-b479-3036423acc67",
                                "text": "„Kallweit zerriß, symbolisch natürlich, den Vertrag, den die Ostzone Anfang Juni mit Warschau geschlossen hatte und in dem die deutschen Gebiete hinter der Oder für alle Zeiten preisgegeben wurden.“"
                            },
                            {
                                "example_id": "d84f59ee-25c4-4044-91a8-84f2f8c9131c",
                                "sense_id": "2ed34fb3-a74f-3555-b479-3036423acc67",
                                "text": "„Er kommt auch aus der Ostzone.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
