                "senses": [
                    {
                        "sense_id": "907d3821-d797-3f6c-983e-121d6d93c87c",
                        "entry_id": "940177fc-7a8c-39db-99a7-6bddf93891de",
                        "glosses": [
                            "Flöte, die beim Blasen quer gehalten wird"
                        ],
                        "tags": [
                            "Musik",
                            "Holzblasinstrumente"
                        ],
                        "examples": [
                            {
                                "example_id": "5593d8e8-b3f5-4be1-b4fd-73f2e3cfccd4",
                                "sense_id": "907d3821-d797-3f6c-983e-121d6d93c87c",
                                "text": "„Die Querflöte intoniert dabei viertel- oder sechsteltönig tiefer als die Traversflöte.“"
                            },
                            {
                                "example_id": "97a215e0-4032-4512-8b48-a3b8be0633b1",
                                "sense_id": "907d3821-d797-3f6c-983e-121d6d93c87c",
                                "text": "„Er ergänzte seine Ausbildung durch weiterführende Studien an der Schola Cantorum Basiliensis, wo er sich im Hauptfach Traversflöte diplomierte.“"
                            },
                            {
                                "example_id": "40c11bd3-07e0-4aad-9bef-697140fb2d5e",
                                "sense_id": "907d3821-d797-3f6c-983e-121d6d93c87c",
                                "text": "„Durch seinen Flötenprofessor im Studium lernte er die Traversflöte kennen und entdeckte sein großes Interesse für das Instrument.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
