                                "target_senses": [
                                    {
                                        "sense_id": "6054f07e-297a-350c-9d7c-4f2e86154491",
                                        "entry_id": "c5db1620-a041-3138-829f-effde0e5cd52",
                                        "glosses": [
                                            "A female given name from Latin, of American usage; variant form Lilian (UK)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "824cc4bd-a908-4d80-a780-6f428b29758a",
                                                "sense_id": "6054f07e-297a-350c-9d7c-4f2e86154491",
                                                "text": "Your mother's name was Lillian, Minnie Lee,\nHer other name I never heard, until\nI stood within the church and saw her wed\nSo she is ever Lillian Lee to me."
                                            },
                                            {
                                                "example_id": "1d243bcc-3ec8-4cf3-b119-c8ed674b440f",
                                                "sense_id": "6054f07e-297a-350c-9d7c-4f2e86154491",
                                                "text": "Lillian Russell was christened Helen Louise Leonard. Tony Pastor gave her the name Lillian Russell, for the very practical reason, I believe, that it had so many \"l's\" in it, and consequently would look well on a bill-board."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
