                ],
                "senses": [
                    {
                        "sense_id": "a0e1aa2e-e592-3f70-b0a8-569a0471ba29",
                        "entry_id": "d47be5ac-116b-30a1-bb01-b172cbbe9220",
                        "glosses": [
                            "der zweite Grasschnitt, die zweite Mahd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7bd4ac-7d7c-40af-911c-2a183ac46044",
                                "sense_id": "a0e1aa2e-e592-3f70-b0a8-569a0471ba29",
                                "text": "Heiko hat sich beim Grummet übel verletzt."
                            },
                            {
                                "example_id": "c8271ed7-d623-4ce7-ad4f-4c231dd49cf3",
                                "sense_id": "a0e1aa2e-e592-3f70-b0a8-569a0471ba29",
                                "text": "Das Grummet steht an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f178b6d9-9b93-3f35-aefe-e5e1a2dc70e6",
                        "entry_id": "d47be5ac-116b-30a1-bb01-b172cbbe9220",
                        "glosses": [
                            "das durch Trocknen haltbar gemachte Heu aus dem zweiten Schnitt der Wiesen, der etwa ein Drittel des gesamten Heuertrages ausmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73b297d2-3c59-4cec-8fa9-b9a44c8c6208",
                                "sense_id": "f178b6d9-9b93-3f35-aefe-e5e1a2dc70e6",
                                "text": "Das Grummet ist meist zarter und besser verdaulich als das Heu der ersten Ernte."
                            },
                            {
                                "example_id": "756af56a-cf94-4948-bf11-ac777c110abf",
                                "sense_id": "f178b6d9-9b93-3f35-aefe-e5e1a2dc70e6",
                                "text": "Das Grummet neigt auf dem Heuboden aufgrund seiner dichteren Lagerung schneller zur Selbstentzündung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5025891f-1441-436a-9b05-ce9bb8edf159",
                        "source_entry_id": "d47be5ac-116b-30a1-bb01-b172cbbe9220",
                        "source_sense_id": "a0e1aa2e-e592-3f70-b0a8-569a0471ba29",
                        "source_sense_description": "der zweite Grasschnitt, die zweite Mahd",
                        "target_lang_word": "aftermath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aftermath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14dc0021-019d-368f-9f18-b67b979ea994",
                                        "entry_id": "49d0bb4d-8cf7-3bbf-a4f0-5ba6febefdb3",
                                        "glosses": [
                                            "A second mowing; the grass which grows after the first crop of hay in the same season; lattermath."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1611fef-7f3c-47bb-bf7e-8ef4851825c9",
                                                "sense_id": "14dc0021-019d-368f-9f18-b67b979ea994",
                                                "text": "They were cutting aftermath on all sides, which gave the neighbourhood, this gusty autumn morning, an untimely smell of hay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e3bc67-8156-3831-9585-4731b1600622",
                                        "entry_id": "49d0bb4d-8cf7-3bbf-a4f0-5ba6febefdb3",
                                        "glosses": [
                                            "That which happens after, that which follows, usually of strongly negative connotation in most contexts, implying a preceding catastrophe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67eaaa8-55d2-4cea-81c5-4ad0cd79c01f",
                                                "sense_id": "14e3bc67-8156-3831-9585-4731b1600622",
                                                "text": "In contrast to most projections of the aftermath of nuclear war, in this there is no rioting or looting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14dbef0-48fd-416c-b5c7-30caad47029b",
                        "source_entry_id": "d47be5ac-116b-30a1-bb01-b172cbbe9220",
                        "source_sense_id": "a0e1aa2e-e592-3f70-b0a8-569a0471ba29",
                        "source_sense_description": "der zweite Grasschnitt, die zweite Mahd",
                        "target_lang_word": "grumereccio",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ba771be-703e-40c8-9a50-b48de5464f46",
                        "source_entry_id": "d47be5ac-116b-30a1-bb01-b172cbbe9220",
                        "source_sense_id": "a0e1aa2e-e592-3f70-b0a8-569a0471ba29",
                        "source_sense_description": "der zweite Grasschnitt, die zweite Mahd",
                        "target_lang_word": "seconda fienagione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5fe6ffcf-cc2f-44d1-9d25-c3bd129e12a5",
                        "source_entry_id": "d47be5ac-116b-30a1-bb01-b172cbbe9220",
                        "source_sense_id": "f178b6d9-9b93-3f35-aefe-e5e1a2dc70e6",
                        "target_lang_word": "regain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                        "entry_id": "7f1ff350-1db7-3578-9449-2eb438457889",
                                        "glosses": [
                                            "Herbe qui repousse dans les prés après qu’ils ont été fauchés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dadc363-b00f-4af4-9627-1666f375740e",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "L’avoine et le blé jaunirent avant d’avoir atteint leur croissance ; le soleil incessant brûla l’herbe et les regains de trèfle."
                                            },
                                            {
                                                "example_id": "308f4231-41af-46f9-8337-a2ff4872f6c1",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Il imaginait la nuit, ce ciel d’août, fourmillant, l’odeur du regain en meule qu’on ne verrait pas."
                                            },
                                            {
                                                "example_id": "2ec8a0fc-74b9-4733-a4c2-07f9e8f2a45c",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Faucher le regain."
                                            },
                                            {
                                                "example_id": "4bd6b8e8-5af5-4e04-8cc8-125aaca8482e",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Et Rodolphe et la Goualeuse de se prendre par la main et de courir à perdre haleine dans une vaste pièce de regain tardif, récemment fauché."
                                            },
                                            {
                                                "example_id": "49cc9901-5d79-43ec-ab5b-e5bd652887a7",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Étourdies par l’odeur du regain fraîchement coupé, par l’odeur des chèvrefeuilles, par l’odeur des blés noirs en fleurs."
                                            },
                                            {
                                                "example_id": "882a7c7c-ba3c-452c-8f8f-1cc26953fe69",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "Les écoliers ont repris le tablier noir, plus que jamais halés d’air vif […] Ils ont gardé les vaches de la herde, fané les regains dans les combes lointaines."
                                            },
                                            {
                                                "example_id": "ba6cff3e-29d3-4f12-ae38-c5bd429096de",
                                                "sense_id": "eab6becd-eb37-3fda-a71a-e48d489d8ef0",
                                                "text": "De sorte que le petit vallon herbu, autrefois pâturé et fauché (il y avait même le regain en août à cause de la fraîcheur du lieu), s’était enfriché au point de devenir difficile de pénétration et par endroit, inextricable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                        "entry_id": "7f1ff350-1db7-3578-9449-2eb438457889",
                                        "glosses": [
                                            "Reprise d’un avantage perdu, recrudescence inattendue, action de regagner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04493454-75c3-4b67-83ee-13b43e340610",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Un regain d'activité."
                                            },
                                            {
                                                "example_id": "134e7c5d-8008-49a9-9a57-a1b80e6cb6ba",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Il connut pendant quelque temps un regain de faveur."
                                            },
                                            {
                                                "example_id": "2dd35d79-22df-4c22-bbc4-d56ab4d87ff0",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "La tiède après-midi d’octobre qui, en donnant au Bois un regain de printemps, avait fait sortir les grandes mondaines en voiture découverte, menaçait de se terminer par une soirée d’une fraîcheur aiguë."
                                            },
                                            {
                                                "example_id": "f07799e3-df9a-407f-b1fd-12e9b6e96279",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Mais cette souffrance et ce regain d’amour pour Gilberte ne furent pas plus longs que ceux qu’on a en rêve."
                                            },
                                            {
                                                "example_id": "5b501c64-6964-41c8-afd4-fb3e259ef555",
                                                "sense_id": "fa21d935-0ea6-385c-9cc6-94dd226eadd2",
                                                "text": "Obtenir un regain de confiance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
