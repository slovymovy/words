{
    "word_family": [
        "bieg",
        "biegać",
        "bieżeć",
        "nabieżąco",
        "wybieg"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1583ec29-733e-3232-8aea-e08c1431ec78",
                    "sense_definition": "odbywający się lub trwający w danej chwili; teraźniejszy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>bieżącym</w> roku nasza firma planuje otworzyć nową filię w Krakowie.",
                            "target_lang_translations": {
                                "ru": "В <w>текущем</w> году наша фирма планирует открыть новый филиал в Кракове."
                            }
                        },
                        {
                            "text": "Wszystkie rachunki staram się opłacać na <w>bieżąco</w>, aby uniknąć odsetek.",
                            "target_lang_translations": {
                                "ru": "Все счета я стараюсь оплачивать <w>своевременно</w>, чтобы избежать процентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "aktualny",
                        "obecny"
                    ],
                    "common_phrases": [
                        "w bieżącym roku",
                        "w bieżącym miesiącu",
                        "na bieżąco"
                    ],
                    "target_lang_definitions": {
                        "ru": "происходящий в данный момент; настоящий, современный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текущий",
                                "target_lang_sense_clarification": "о времени, делах, событиях"
                            },
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "о текущем периоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a8b5450-f1fb-32ea-9fc5-c5ac938b5908",
                    "sense_definition": "płynący lub dostarczany przez instalację wodociągową",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "woda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym domku letniskowym przez kilka dni nie było <w>bieżącej</w> wody.",
                            "target_lang_translations": {
                                "ru": "В старом дачном домике несколько дней не было <w>проточной</w> воды."
                            }
                        },
                        {
                            "text": "Przed posiłkiem należy dokładnie umyć ręce pod ciepłą <w>bieżącą</w> wodą.",
                            "target_lang_translations": {
                                "ru": "Перед едой следует тщательно вымыть руки под тёплой <w>проточной</w> водой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bieżąca woda"
                    ],
                    "target_lang_definitions": {
                        "ru": "льющийся, подаваемый через водопровод"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проточный",
                                "target_lang_sense_clarification": "о воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2642b1d-32fb-371b-a72e-cafd60661181",
                    "sense_definition": "odnoszący się do danego momentu w przeszłości; ówczesny",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziennikarze szczegółowo relacjonowali <w>bieżące</w> wypadki rewolucyjne z tamtych lat.",
                            "target_lang_translations": {
                                "ru": "Журналисты подробно освещали <w>тогдашние</w> революционные события тех лет."
                            }
                        },
                        {
                            "text": "Historyk porównał dawne dokumenty ze stanem <w>bieżącym</w> opisywanej epoki.",
                            "target_lang_translations": {
                                "ru": "Историк сравнил старинные документы с <w>современным</w> положением дел описываемой эпохи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к определённому моменту в прошлом; происходивший тогда"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тогдашний",
                                "target_lang_sense_clarification": "относящийся к тому времени"
                            },
                            {
                                "target_lang_word": "современный",
                                "target_lang_sense_clarification": "современный описываемой эпохе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c3572e1-c9cc-353c-b11f-ef97f533f8a8",
                    "sense_definition": "imiesłów przymiotnikowy czynny od czasownika <w>bieżeć</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rycerz ujrzał posła szybko <w>bieżącego</w> w stronę zamkowej bramy.",
                            "target_lang_translations": {
                                "ru": "Рыцарь увидел гонца, быстро <w>бегущего</w> к замковым воротам."
                            }
                        },
                        {
                            "text": "Na obrazie widać dzieci <w>bieżące</w> przez zieloną łąkę ku rzece.",
                            "target_lang_translations": {
                                "ru": "На картине видны дети, <w>бегущие</w> по зелёному лугу к реке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "forma imiesłowowa czasownika przestarzałego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "действительное причастие настоящего времени от устаревшего глагола bieżeć (бежать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бегущий",
                                "target_lang_sense_clarification": "устар. форма przych."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}