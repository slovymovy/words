            "senses": [
                {
                    "sense_id": "f9dbf3d7-305e-3aa5-8ab6-293458290d71",
                    "sense_definition": "Określona praca lub czynność, którą ktoś musi lub powinien wykonać.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obowiazek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moje główne <w>zadanie</w> w tej firmie to kontakt z klientami.",
                            "target_lang_translations": {
                                "ru": "Моя главная <w>задача</w> в этой компании — это контакт с клиентами.",
                                "en": "My main <w>task</w> in this company is contacting clients."
                            }
                        },
                        {
                            "text": "Szef dał mi trudne <w>zadanie</w> do wykonania na jutro.",
                            "target_lang_translations": {
                                "ru": "Шеф дал мне трудное <w>задание</w> на завтра.",
                                "en": "The boss gave me a difficult <w>job</w> to do for tomorrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "praca"
                    ],
                    "common_phrases": [
                        "trudne zadanie",
                        "wykonać zadanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная работа или действие, которое кто-то должен или обязан выполнить.",
                        "en": "A specific piece of work, duty, or activity that someone has to or should perform."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задание",
                                "target_lang_sense_clarification": "поручение для выполнения"
                            },
                            {
                                "target_lang_word": "задача",
                                "target_lang_sense_clarification": "цель, требующая выполнения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "task",
                                "target_lang_sense_clarification": "a piece of work to be done"
                            },
                            {
                                "target_lang_word": "job",
                                "target_lang_sense_clarification": "a particular task or duty"
                            },
                            {
                                "target_lang_word": "assignment",
                                "target_lang_sense_clarification": "a task given to someone as part of a job or course of study"
                            }
