                        "entry_id": "f89288ae-03e5-3a5f-bb16-7a1bc7687c91",
                        "glosses": [
                            "female equivalent of ныря́льщик (nyrjálʹščik): female diver"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6f264ec6-25ce-4bfc-b3fd-41a42da3a341",
                                "sense_id": "2cc5314c-3f8e-3fcb-a7f8-2bf2ecf0b51a",
                                "text": "Такеда не своди́л с неё глаз. Его́ ка́рие зрачки́ улыба́лись. Три мину́ты и две секу́нды! Ни одна́ ныря́льщица так до́лго ещё не остава́лась под водо́й.",
                                "translation": "Boris L. Tageev",
                                "english": "Boris L. Tageev"
                            }
                        ]
                    }
