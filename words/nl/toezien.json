{
    "word_family": [
        "toezicht",
        "toezichthouder",
        "toezienend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f00093da-dadf-321c-ac63-1658af50ac3c",
                    "sense_definition": "Nauwlettend in de gaten houden of controleren dat iets goed verloopt of volgens de regels gebeurt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toezicht_houden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid moet streng <w>toezien</w> op de naleving van de nieuwe milieuwetten.",
                            "target_lang_translations": {
                                "en": "The government must strictly <w>supervise</w> compliance with the new environmental laws."
                            }
                        },
                        {
                            "text": "De provincie en gemeente gaan erop <w>toezien</w> dat de voorschriften worden nageleefd.",
                            "target_lang_translations": {
                                "en": "The province and municipality will <w>ensure</w> that the regulations are complied with."
                            }
                        }
                    ],
                    "synonyms": [
                        "controleren",
                        "surveilleren",
                        "bewaken"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "toezien op de naleving",
                        "erop toezien dat"
                    ],
                    "target_lang_definitions": {
                        "en": "To closely monitor or check that something is going well or happening according to the rules."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "supervise",
                                "target_lang_sense_clarification": "to oversee an activity or process to ensure it is done correctly"
                            },
                            {
                                "target_lang_word": "ensure",
                                "target_lang_sense_clarification": "to make sure that a rule or condition is complied with"
                            },
                            {
                                "target_lang_word": "oversee",
                                "target_lang_sense_clarification": "to watch and direct an activity or organization"
                            },
                            {
                                "target_lang_word": "monitor",
                                "target_lang_sense_clarification": "to observe and check the progress or quality of something over time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e5516ad-51b7-3d7d-99a2-376bac056729",
                    "sense_definition": "Als toeschouwer kijken naar een gebeurtenis zonder zelf actief deel te nemen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De omstanders <w>zagen</w> rustig <w>toe</w> hoe de brandweer de kat uit de boom redde.",
                            "target_lang_translations": {
                                "en": "The bystanders quietly <w>looked on</w> as the fire brigade rescued the cat from the tree."
                            }
                        },
                        {
                            "text": "De muziekindustrie <w>zag</w> tandenknarsend <w>toe</w> hoe de inkomsten daalden.",
                            "target_lang_translations": {
                                "en": "The music industry <w>watched</w> with gnashing teeth as revenues declined."
                            }
                        }
                    ],
                    "synonyms": [
                        "gadeslaan",
                        "toekijken",
                        "aanzien"
                    ],
                    "antonyms": [
                        "ingrijpen",
                        "meedoen"
                    ],
                    "common_phrases": [
                        "lijdelijk toezien",
                        "toezien hoe"
                    ],
                    "target_lang_definitions": {
                        "en": "To watch an event as a spectator without actively participating."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look on",
                                "target_lang_sense_clarification": "to watch something happen without getting involved"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to observe an event or situation as a bystander"
                            },
                            {
                                "target_lang_word": "stand by",
                                "target_lang_sense_clarification": "to watch something happen without taking action"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}