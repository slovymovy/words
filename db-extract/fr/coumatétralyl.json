                "senses": [
                    {
                        "sense_id": "602fb0cf-19e0-3502-bed2-226159fc6fe6",
                        "entry_id": "7913e380-35fa-3956-9cd9-8b32d5746b34",
                        "glosses": [
                            "Substance chimique, de formule chimique C₁₉H₁₆O₃ , à usage de rodenticide, sur le rat noir, le surmulot et la souris domestique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e9ea56-e72a-4715-8f7e-c7d5e38b7d35",
                                "sense_id": "602fb0cf-19e0-3502-bed2-226159fc6fe6",
                                "text": "La nécessité d'une répétition des ingestions au-delà de 3 consommations paraît nécessaire pour le coumafuryl, le coumatétralyl et le diphacinone, et bien plus encore pour le coumafène, le CPPH et le pivaldione."
                            },
                            {
                                "example_id": "86010467-f2d5-4892-b60d-364f2c3242f4",
                                "sense_id": "602fb0cf-19e0-3502-bed2-226159fc6fe6",
                                "text": "En raison des risques mis en évidence, il convient de n'inscrire le coumatétralyl à l'annexe I que pour une période de cinq ans et de le soumettre à une évaluation comparative des risques conformément à l'article 10, paragraphe 5, point i), deuxième alinéa, de la directive 98/8/CE avant le renouvellement de son inscription à l'annexe I."
                            }
                        ]
                    }
