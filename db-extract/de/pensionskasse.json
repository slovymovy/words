                                "target_senses": [
                                    {
                                        "sense_id": "89cf80a8-f650-32e4-affd-2027d46cf24b",
                                        "entry_id": "f676ca45-0aa7-3387-9f1d-e38211d8a3a5",
                                        "glosses": [
                                            "Caisse servant à alimenter et effectuer des versements de retraites de salariés ou de travailleurs indépendants, par un procédé de capitalisation ou de répartition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc22fac8-a077-4160-85a2-2b8a61580019",
                                                "sense_id": "89cf80a8-f650-32e4-affd-2027d46cf24b",
                                                "text": "D'un coup, une avalanche de calendriers, d’horloges biologiques, de dates de naissance et d’avis de caisse de retraite lui tombèrent sur le râble. Mais qui intéresserait-il encore ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "722bf5f5-5d8c-41e2-8f95-9a9925afbdd6",
                        "source_entry_id": "37664be5-4edf-348b-b2bb-6f4804a96d56",
                        "source_sense_id": "b0b56bc8-e85d-3c78-baed-5c2778fc5dbe",
