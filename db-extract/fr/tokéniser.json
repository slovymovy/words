                        "glosses": [
                            "Découper automatiquement un texte en unités lexicales grâce à une analyse lexicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a970fc5-895a-41dd-8df7-89bc0cf3b378",
                                "sense_id": "2978479e-3143-36ff-ad26-26d807637632",
                                "text": "Enfin on \"tokénise\" : on crée une liste de mots en découpant à chaque séparateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "30f9cfcf-b583-3a8a-90bc-664ddb1160ff",
