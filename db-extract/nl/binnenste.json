                ],
                "senses": [
                    {
                        "sense_id": "47db77d5-9203-3b61-b7e2-3abf181c4e13",
                        "entry_id": "3561faf9-d67f-3bfb-a3c5-525e02e67d9d",
                        "glosses": [
                            "inwendige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "433168ae-831f-4b98-a8c9-b4bf9d4b84c4",
                                "sense_id": "47db77d5-9203-3b61-b7e2-3abf181c4e13",
                                "text": "Het binnenste van de bonbon was gevuld met drank."
                            },
                            {
                                "example_id": "6b365fc2-4b19-451d-adce-18a79ee2ab9a",
                                "sense_id": "47db77d5-9203-3b61-b7e2-3abf181c4e13",
                                "text": "Antimateriehypernuclei: Antihyperhelium-4 bestaat uit een mix van antimaterieversies van protonen, neutronen en deeltjes die hyperonen worden genoemd. Hyperonen zijn op zichzelf al exotisch, omdat ze een of meer quarks van het ‘vreemde’ type bevatten. Deze ‘vreemdheid’ is moeilijk te vinden en moeilijk te maken. Daarom begrijpen onderzoekers nog steeds niet helemaal hoe hyperonen zich gedragen in de natuur, waar ze vermoedelijk voorkomen in exotische omgevingen zoals het binnenste van neutronensterren, zegt Dönigus. Bovendien blijven er vragen bestaan over hoe antimaterieversies van deze en andere deeltjes op elkaar reageren."
                            },
                            {
                                "example_id": "6ced8eae-7e91-40b2-974c-30295e0d9a80",
                                "sense_id": "47db77d5-9203-3b61-b7e2-3abf181c4e13",
                                "text": "Terwijl mijn zoon in mijn binnenste begon aan een duizelingwekkende ontwikkeling van klompje cellen naar prehistorisch weekdier naar foetus, begon ik me af te vragen wat zijn aanstaande komst precies betekende."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b74a111-8c7a-3940-b446-8b7810a88aba",
                        "entry_id": "3561faf9-d67f-3bfb-a3c5-525e02e67d9d",
                        "glosses": [
                            "het geestelijk leven van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b6c7c1-067d-449f-9994-555a5bbed072",
                                "sense_id": "1b74a111-8c7a-3940-b446-8b7810a88aba",
                                "text": "Alleen al het feit dat niemand het mag weten van Jos en dat zelfs het noemen van zijn naam taboe is, maakt dat de druk in haar binnenste elke dag wordt opgevoerd."
                            },
                            {
                                "example_id": "6521aa69-58e3-4669-8179-a1d22769127a",
                                "sense_id": "1b74a111-8c7a-3940-b446-8b7810a88aba",
                                "text": "Chantal voelde de woede vanuit haar binnenste naar haar hoofd stijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
