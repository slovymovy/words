                                    {
                                        "sense_id": "ab5d0f74-4add-38bd-9527-b49cf78dc779",
                                        "entry_id": "05c2ca86-303c-31be-8bf0-7264916f18d9",
                                        "glosses": [
                                            "Messgerät zur Bestimmung der Dichte und des spezifischen Gewichts von Flüssigkeiten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746f60ba-750d-439d-80ad-9311397e5f7e",
                                                "sense_id": "ab5d0f74-4add-38bd-9527-b49cf78dc779",
                                                "text": "Beim Schnapsbrennen werden Aräometer zur Bestimmung des Alkoholgehaltes verwendet."
                                            },
                                            {
                                                "example_id": "c9076896-fca8-4a21-ae91-57b512a1d308",
                                                "sense_id": "ab5d0f74-4add-38bd-9527-b49cf78dc779",
                                                "text": "„Da die Dichte einer Lösung konzentrationsabhängig ist, können Aräometer auch zur Konzentrationsbestimmung eingesetzt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6557694-7434-48f2-8765-580ba35b0a28",
                        "source_entry_id": "0af72ef7-66cd-3c0b-8d48-cc43bdb5314f",
                        "source_sense_id": "c8fe0a9c-53e8-39b9-8c6f-2744b0f62c10",
                        "target_lang_word": "Alkoholometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkoholometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17152bf9-334b-35e2-8a03-a09761f3121e",
                                        "entry_id": "c18fe433-1ddf-3914-b8a3-6f8ad5571e93",
                                        "glosses": [
                                            "Messgerät zur Bestimmung des Ethanolgehaltes eines Wasser-Ethanol-Gemisches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615f299d-156a-48a0-a511-a1d1cfa77713",
                                                "sense_id": "17152bf9-334b-35e2-8a03-a09761f3121e",
                                                "text": "„Das Instrument, welches man zur Bestimmung des Alkoholgehaltes des Spiritus benützt, ist das Alkoholometer.“"
                                            },
                                            {
                                                "example_id": "93290832-cf40-41f0-8d63-a7a7ef9d23fc",
                                                "sense_id": "17152bf9-334b-35e2-8a03-a09761f3121e",
                                                "text": "„Bei allen Beobachtungen mit Hilfe des Alkoholometers bedarf es somit auch einer Feststellung der Temperatur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
