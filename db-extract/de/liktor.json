                "senses": [
                    {
                        "sense_id": "3ec8e451-b5d3-3f1d-9b1d-c0582d24af5b",
                        "entry_id": "de8cdea7-c57d-3e23-a796-fe03d8f96ea3",
                        "glosses": [
                            "im römischen Reich Diener, Begleiter, Leibwächter hochgestellter Amtsträger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0d9767-8e03-4840-9758-e8008fa453bb",
                                "sense_id": "3ec8e451-b5d3-3f1d-9b1d-c0582d24af5b",
                                "text": "„Die Polizei des Altertums ist durch die Wachsfiguren eines Caesaren und zweier Liktoren und durch einige Fascesbündel dargestellt, was herzlich albern ist, wenn es nicht eine Huldigung für die modernen Faschisten bedeuten soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef4c82e2-cfd9-4657-9ce8-324271103713",
                        "source_entry_id": "de8cdea7-c57d-3e23-a796-fe03d8f96ea3",
                        "source_sense_id": "3ec8e451-b5d3-3f1d-9b1d-c0582d24af5b",
                        "source_sense_description": "im römischen Reich Diener, Begleiter, Leibwächter hochgestellter Amtsträger",
                        "target_lang_word": "lictor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lictor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a947ca8b-2795-3579-ab4a-a89adbce613b",
                                        "entry_id": "74bdbe5c-581b-3da1-843e-eb9ce284bc96",
                                        "glosses": [
                                            "An officer in Ancient Rome, attendant on a consul or magistrate, who bore the fasces and was responsible for punishing criminals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2659e934-86af-498e-8b4a-41cb0e9ffbb6",
                                                "sense_id": "a947ca8b-2795-3579-ab4a-a89adbce613b",
                                                "text": "‘Beware the power of the mob, Caesar.’ Then, schooled in needful agility, he ran away before a lictor’s whip could reach him."
                                            },
                                            {
                                                "example_id": "595030ed-9bc6-4d03-9b30-35a31a283e9c",
                                                "sense_id": "a947ca8b-2795-3579-ab4a-a89adbce613b",
                                                "text": "Hee brought-in likevvise the ancient cuſtome againe, that in vvhat moneth hee had not the Knitches of rods vvith Axes borne before him, a publique Officer called Accensvs ſhould huiſher him before, and the Serjeants or Lictours follovv after behinde."
                                            },
                                            {
                                                "example_id": "a2067331-da4d-4fda-b3c3-dd6b2ec2e810",
                                                "sense_id": "a947ca8b-2795-3579-ab4a-a89adbce613b",
                                                "text": "“Regard not that, my brother,” answered Magdalen Græme; “the first successors of Saint Peter himself, were elected not in sunshine but in tempests—not in the halls of the Vatican, but in the subterranean vaults and dungeons of Heathen Rome—they were not gratulated with shouts and salvos of cannon-shot and of musquetry, and the display of artificial fire—no, my brother—but by the hoarse summons of Lictors and Prætors, who came to drag the Fathers of the Church to martyrdom.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db26ffb6-0a12-4519-b84a-9543cc2c0b57",
                        "source_entry_id": "de8cdea7-c57d-3e23-a796-fe03d8f96ea3",
                        "source_sense_id": "3ec8e451-b5d3-3f1d-9b1d-c0582d24af5b",
                        "source_sense_description": "im römischen Reich Diener, Begleiter, Leibwächter hochgestellter Amtsträger",
                        "target_lang_word": "licteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "licteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30674a50-3abc-36ee-ae55-f274b1f7b102",
                                        "entry_id": "e273235e-ecb6-3561-99bc-2f714a48c22f",
                                        "glosses": [
                                            "Officier public qui marchait devant les premiers magistrats de la Rome antique, qui portait une hache placée dans un faisceau de verges, et qui faisait à la fois office d’appariteur et de bourreau. (Le consul avait douze licteurs, le dictateur en avait vingt-quatre.)"
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d081d8-d0e1-48ba-88b5-24bdbf649857",
                                                "sense_id": "30674a50-3abc-36ee-ae55-f274b1f7b102",
                                                "text": "Le jeune homme contempla Senatus Populusque romanus : le consul, les licteurs, les toges bordées de pourpre, les luttes du Forum."
                                            },
                                            {
                                                "example_id": "4c9cdab8-46d0-4d31-b214-b72bc869b5ef",
                                                "sense_id": "30674a50-3abc-36ee-ae55-f274b1f7b102",
                                                "text": "Dion Cassius raconte qu’un jour Claude fut très choqué de voir qu’un affranchi non seulement citait son patron devant les tribuns du peuple, mais encore avait obtenu l’intervention d’un licteur pour le faire mener au tribunal."
                                            },
                                            {
                                                "example_id": "70be0479-760b-457b-a86b-2970538b514d",
                                                "sense_id": "30674a50-3abc-36ee-ae55-f274b1f7b102",
                                                "text": "Glabrio, qui était pour le moins quelqu’un d’irritable, le prévint qu’il ferait mieux de tenir sa langue s’il ne voulait pas qu’il lui envoie ses licteurs pour le faire sortir du tribunal, tout consul qu’il était."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ff2a50-9dd0-3958-98a6-ce862b71f0fb",
                                        "entry_id": "e273235e-ecb6-3561-99bc-2f714a48c22f",
                                        "glosses": [
                                            "Officier public ayant certaines attributions en matière de police judiciaire."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893dfbc4-7b20-4c62-bb81-1be64ed59a11",
                                                "sense_id": "10ff2a50-9dd0-3958-98a6-ce862b71f0fb",
                                                "text": "Les licteurs étaient le bras armé du Magistère, chargés de faire appliquer le règlement, défaire les sorts dangereux ou raté, détruire les talismans maléfiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6ff4f9f-9951-4689-9d59-e13534aa4f37",
                        "source_entry_id": "de8cdea7-c57d-3e23-a796-fe03d8f96ea3",
