                                        "entry_id": "f2e4e6f0-ba99-3e5a-9f37-19e2d105efb7",
                                        "glosses": [
                                            "der Vorgang des Badens, der Aufenthalt in Wasser, Licht, Luft zum Vergnügen, zur Heilung oder zur Reinigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb7e9f4-81d8-44ea-951f-340f72f22d00",
                                                "sense_id": "4c637525-e949-3d71-b0c4-5c2594ed5998",
                                                "text": "Nimm doch wieder mal ein Bad."
                                            },
                                            {
                                                "example_id": "ee8e2842-8db4-41e2-b378-fe4eb09ab8f1",
                                                "sense_id": "4c637525-e949-3d71-b0c4-5c2594ed5998",
                                                "text": "„Er hatte eine Rasur nötig, einen Haarschnitt, ein Bad.“"
                                            },
                                            {
                                                "example_id": "a7fa8da5-c4d9-4467-9c37-3ab85c2d4af6",
                                                "sense_id": "4c637525-e949-3d71-b0c4-5c2594ed5998",
                                                "text": "„Sehr zu empfehlen sind Bäder aus geilen Lustkräutern, die eine immense erogene Wirkung haben, hat Bruni gesagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8400d595-6a11-3272-b29b-2ba9403a3e41",
                                        "entry_id": "f2e4e6f0-ba99-3e5a-9f37-19e2d105efb7",
                                        "glosses": [
                                            "eine Flüssigkeit, in die ein Gegenstand zu einer, meist chemischen, Behandlung getaucht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36471f4-bb2a-4b4c-a67a-039308aab05c",
                                                "sense_id": "8400d595-6a11-3272-b29b-2ba9403a3e41",
                                                "text": "Das Bad, in das der Rohling eingetaucht wird, hat eine Temperatur von 300 °C."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "33ad443e-8a64-326d-869c-c98efaa13a46",
                                        "entry_id": "f2e4e6f0-ba99-3e5a-9f37-19e2d105efb7",
                                        "glosses": [
                                            "Badeanstalt, Badestrand"
                                        ],
                                        "tags": [
                                            "verkürzt für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2718f5-3a2c-4665-86d3-7ed27dd90574",
                                                "sense_id": "33ad443e-8a64-326d-869c-c98efaa13a46",
                                                "text": "Kommt ihr mit ins Bad?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "487f7526-a72d-3b44-816b-752a57f56e0f",
                                        "entry_id": "f2e4e6f0-ba99-3e5a-9f37-19e2d105efb7",
                                        "glosses": [
                                            "Badezimmer, Badestube, Badehaus"
                                        ],
                                        "tags": [
                                            "verkürzt für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1428ab1e-d6c6-44be-8378-12bc62fced4a",
                                                "sense_id": "487f7526-a72d-3b44-816b-752a57f56e0f",
                                                "text": "„Mit Weintrauben und warmen Bädern bot Rom mehr Labsal und Luxus als die germanische Provinz.“"
                                            },
                                            {
                                                "example_id": "75ea330b-db89-4162-b3e4-fd9c57105168",
                                                "sense_id": "487f7526-a72d-3b44-816b-752a57f56e0f",
                                                "text": "So, ich gehe ins Bad."
                                            },
                                            {
                                                "example_id": "fc0ac51e-5975-4ad3-93f9-4ff12b70cc45",
                                                "sense_id": "487f7526-a72d-3b44-816b-752a57f56e0f",
                                                "text": "„Ich hatte den Eindruck, dass er sich im Bad besonders viel Zeit ließ, vielleicht aus Taktgefühl, sodass ich in meinem Pyjama unter die Bettdecke kriechen konnte, bevor er ins Zimmer kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e44fc167-6b44-3472-b1d3-a8c6fd72b7a7",
                                        "entry_id": "f2e4e6f0-ba99-3e5a-9f37-19e2d105efb7",
                                        "glosses": [
                                            "ein amtlicher Beiname, Namenzusatz bei Toponymen für Orte in denen Heil- und Erholungseinrichtungen ansässig sind, meist mit örtlich vorhandenen natürlichen Ressourcen, die dazu genutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e529b36-8920-4571-a182-e3f23544e2e8",
                                                "sense_id": "e44fc167-6b44-3472-b1d3-a8c6fd72b7a7",
                                                "text": "In Bad Schandau kann man nicht nur Bäder nehmen, sondern auch in den Felsgebieten wandern und klettern."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
