                "senses": [
                    {
                        "sense_id": "dd0cf64f-fb1e-35fb-89c0-70a83ed88e68",
                        "entry_id": "a5bc2e18-23f9-33cf-b6f8-c4ed69e9cd51",
                        "glosses": [
                            "Staat, der am Persischen Golf liegt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "203dd34a-5a57-4208-9ffc-061f42ebdf99",
                                "sense_id": "dd0cf64f-fb1e-35fb-89c0-70a83ed88e68",
                                "text": "Er machte eine Reise durch die arabischen Golfstaaten."
                            },
                            {
                                "example_id": "b4105ef8-2b4f-4b71-893a-7887ae3defd3",
                                "sense_id": "dd0cf64f-fb1e-35fb-89c0-70a83ed88e68",
                                "text": "„Tausende junge äthiopische Frauen gehen jedes Jahr in die Golfstaaten, um sich dort als Hausangestellte zu verdingen.“"
                            },
                            {
                                "example_id": "e32f6b2a-25c1-45c2-be0d-8c069c4a6db6",
                                "sense_id": "dd0cf64f-fb1e-35fb-89c0-70a83ed88e68",
                                "text": "„Angesichts des steigenden Energiebedarfs ist Pakistan vermehrt von Lieferungen aus den Golfstaaten abhängig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
