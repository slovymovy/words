                        "examples": [
                            {
                                "example_id": "f630e6bc-b927-4def-beb5-ffebdcff3bbb",
                                "sense_id": "d67201bd-e4ed-3f9e-87f9-ec4ca962c7ca",
                                "text": "In het cultuurdebat vroeg de PVV om een onderzoek van de minister naar seksueel misbruik in de cultuursector."
                            },
                            {
                                "example_id": "d500ce4a-e872-418e-9be6-9d0cf76643f3",
                                "sense_id": "d67201bd-e4ed-3f9e-87f9-ec4ca962c7ca",
                                "text": "Het lijkt niet waarschijnlijk dat popmuzikanten op korte termijn kunnen fluiten naar hun geld. Minister Ingrid van Engelshoven van Onderwijs, Cultuur en Wetenschap zei in het cultuurdebat niets te zien in het idee van coalitiepartner VVD."
                            },
                            {
                                "example_id": "4b389997-3b7f-483e-a1a4-f7ca9ea3bbd0",
                                "sense_id": "d67201bd-e4ed-3f9e-87f9-ec4ca962c7ca",
                                "text": "Maar staatssecretaris Halbe Zijlstra is voorlopig niet te vermurwen. \"Er gaan instellingen verdwijnen. Laten we elkaar niet voor de gek houden\", zei Zijlstra in het cultuurdebat in december vorig jaar. Coalitiepartijen VVD en CDA, en gedoogpartner PVV steunen de staatssecretaris."
                            }
                        ]
                    }
