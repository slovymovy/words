                {
                    "sense_id": "65c72786-2b55-3aa5-b352-c8f1b05bb352",
                    "sense_definition": "To camp overnight inside a historic church as a recreational activity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_camp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went <w>champing</w> in a beautiful Victorian church last summer.",
                            "target_lang_translations": {
