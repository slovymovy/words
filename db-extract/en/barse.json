                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee6fcc1-2a48-301d-8a2e-cdaeaf155243",
                                        "entry_id": "2680780f-ac2a-3c75-9fde-0b0a32610420",
                                        "glosses": [
                                            "der Flussbarsch , ein Speisefisch aus der Familie der Barsche (Percidae) und der Ordnung der Barschartigen (Perciformes)"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f130514-0c84-4e87-9eed-1e672ab56aed",
                                                "sense_id": "3ee6fcc1-2a48-301d-8a2e-cdaeaf155243",
                                                "text": "Barsche lieben Twister, aber natürlich auch Würmer, und mit kleinen Spinnern kann man auch einen Erfolg verbuchen."
                                            },
                                            {
                                                "example_id": "0c476b18-a429-4e4b-8f68-f4be278610df",
                                                "sense_id": "3ee6fcc1-2a48-301d-8a2e-cdaeaf155243",
                                                "text": "Kleine Barsche in Mehl gewälzt und kurz ausgebacken sind eine wahre Delikatesse."
                                            },
                                            {
                                                "example_id": "5c3faddd-42a1-49c5-85d6-a9583cb59f3c",
                                                "sense_id": "3ee6fcc1-2a48-301d-8a2e-cdaeaf155243",
                                                "text": "„Die Strömung war vorteilhaft, und unter den Algenbänken wimmelte es von Weißfischen, Barschen und Karpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a0b787b-706c-4183-92de-eba9c661a273",
                        "source_entry_id": "be8489e2-be10-3bd3-b4de-6c22a6d033cb",
                        "source_sense_id": "d0aca372-4fab-3fff-863d-744ce4b609b4",
                        "source_sense_description": "fish",
                        "target_lang_word": "о́кунь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "о́кунь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db6bf954-64a5-36ed-a39c-82a1bdbe66fc",
                                        "entry_id": "f05db388-456f-3586-a504-94f8313183ff",
                                        "glosses": [
                                            "ихтиол. пресноводная хищная костистая рыба семейства окуневых зеленовато-жёлтого цвета, с чёрными поперечными полосами и красноватыми нижними плавниками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77cbf12b-a527-4dbb-972d-2c50a9ef32aa",
                                                "sense_id": "db6bf954-64a5-36ed-a39c-82a1bdbe66fc",
                                                "text": "Всего более водилось в озере окуней и особенно лещей."
                                            },
                                            {
                                                "example_id": "8ec2608c-b282-4dd3-9909-45e724776614",
                                                "sense_id": "db6bf954-64a5-36ed-a39c-82a1bdbe66fc",
                                                "text": "Лунки бурили недалеко от берега, так как знали по прошлым рыбалкам, что зимой окунь идёт именно сюда, где побольше корма."
                                            },
                                            {
                                                "example_id": "bf472293-9e7b-43c0-a1d4-cc5f5d07a702",
                                                "sense_id": "db6bf954-64a5-36ed-a39c-82a1bdbe66fc",
                                                "text": "Но если прикормки окажется слишком много, а рыб мало, то они, скорее, опустятся за ней вниз, чем более крупные окуни поднимутся вверх."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e476bf-b333-3fc4-ba08-4e6962ff54e0",
                                        "entry_id": "f05db388-456f-3586-a504-94f8313183ff",
                                        "glosses": [
                                            "кулин. мясо такой рыбы, употребляемое в пищу; также кушанье из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82503378-fa12-49b4-a61c-58c77ace2a56",
                                                "sense_id": "39e476bf-b333-3fc4-ba08-4e6962ff54e0",
                                                "text": "На ужин предполагался жареный окунь с картошкой."
                                            },
                                            {
                                                "example_id": "50919223-7702-4218-b80f-d21bd525d2f1",
                                                "sense_id": "39e476bf-b333-3fc4-ba08-4e6962ff54e0",
                                                "text": "Наилучший по вкусу бульон готовится из судака, окуня, ершей и рыб осетровых пород."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a108aff0-645b-3aee-a3fc-2a8a3a343d52",
                                        "entry_id": "f05db388-456f-3586-a504-94f8313183ff",
                                        "glosses": [
                                            "ихтиол. род морских лучепёрых рыб из семейства скорпеновых"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
