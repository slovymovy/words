                "senses": [
                    {
                        "sense_id": "a3d862f5-afd6-39b5-8b28-8035818e6944",
                        "entry_id": "d74701c8-eb1c-3a64-a250-ab31dac26664",
                        "glosses": [
                            "Having or full of forethought; provident; proactive; visionary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53faa6f-1c89-4c65-a516-3e2bd86ee1fe",
                                "sense_id": "a3d862f5-afd6-39b5-8b28-8035818e6944",
                                "text": "But we live in an age of the world when a spirit is abroad which is more than directly and blessedly influential on the present,— which is forethoughtful and prospective, casting its relations like strong grappling-irons over the future, and claiming its issues."
                            },
                            {
                                "example_id": "7b3f5fb6-8abd-46ff-a45f-a84daeab8cf2",
                                "sense_id": "a3d862f5-afd6-39b5-8b28-8035818e6944",
                                "text": "Meal times always caught the majority unaware. They tumbled and jostled down the companionways only to find the wise and forethoughtful had preëmpted every chair."
                            },
                            {
                                "example_id": "dacee94b-1e38-4eb0-a200-003f6948bde1",
                                "sense_id": "a3d862f5-afd6-39b5-8b28-8035818e6944",
                                "text": "And I should have been forethoughtful enough to see the looming danger."
                            }
                        ]
                    }
                ],
