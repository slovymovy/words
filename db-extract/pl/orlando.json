                                        "glosses": [
                                            "A male given name from Italian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6c8273-8758-4256-9859-961d946d6183",
                                                "sense_id": "02f2062c-37c8-38e8-bc95-709bc5be6233",
                                                "text": "St. Oswald's boys were not called Ben. St Oswald's boys were called Leon, or Jasper, or Rufus or Sebastian. A St Oswald's boy can pass off a name like Orlando, can make it sound like peppermint."
                                            }
                                        ]
