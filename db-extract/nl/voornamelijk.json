                        "cross_references": [
                            {
                                "target_word": "mainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de8c6f3f-8efd-315c-b02f-32ecf20b47ce",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "Chiefly; for the most part."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c611281-7900-4468-bce6-a678acc47ffd",
                                                "sense_id": "de8c6f3f-8efd-315c-b02f-32ecf20b47ce",
                                                "text": "She had Lord James' collar in one big fist and she pounded the table with the other and talked a blue streak. Nobody could make out plain what she said, for she was mainly jabbering Swede lingo, but there was English enough, of a kind, to give us some idee."
                                            },
                                            {
                                                "example_id": "f12e6d1c-f71d-479c-a346-36300a0fb718",
                                                "sense_id": "de8c6f3f-8efd-315c-b02f-32ecf20b47ce",
                                                "text": "If you’re looking for the most breathable mask, Lukovics says, “Cotton is preferable, mainly for absorbing moisture/sweat.” She says multiple layers may be more protective but will also impact breathability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48842080-bd9e-3eeb-af2c-e96f99e8a8ad",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "Forcefully, vigorously."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9dc792-e7f5-4c58-b3e5-6a5522e985d3",
                                                "sense_id": "48842080-bd9e-3eeb-af2c-e96f99e8a8ad",
                                                "text": "Such breadth of ſhoulders as might mainely beare\nOlde Atlas burthen, […]"
                                            },
                                            {
                                                "example_id": "ab9258e4-70c9-4cd1-bdd3-db41ea0f67c5",
                                                "sense_id": "48842080-bd9e-3eeb-af2c-e96f99e8a8ad",
                                                "text": "Mainly they all attonce vpon him laid, / And sore beset on euery side around […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d1e9fc-0700-3bff-b602-3f62ee8c1e5d",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
                                        "glosses": [
                                            "Of the production of a sound: loudly, powerfully."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "284fc8bc-08de-43a3-a48c-49015dbc7370",
                                                "sense_id": "e3d1e9fc-0700-3bff-b602-3f62ee8c1e5d",
                                                "text": "But in the end, mainly crying out, he fell to raling and wringing his master, upbraiding him that he was not a true Philosopher[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833b6ef3-df0a-3287-9b5b-9c4495df10cb",
                                        "entry_id": "e3d6daaf-1a37-3956-8c9d-46e2e93b0560",
