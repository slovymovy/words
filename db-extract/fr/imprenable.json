        "fr-extract.jsonl": [
            {
                "entry_id": "80b401d2-5a9c-312f-9820-2305bd3e186f",
                "word": "imprenable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "87e4c456-9739-4000-b7aa-5f64b29d2ff7",
                        "entry_id": "80b401d2-5a9c-312f-9820-2305bd3e186f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "imprenables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "834cb29b-0eb8-3e38-90b9-a4e35b192aa1",
                        "entry_id": "80b401d2-5a9c-312f-9820-2305bd3e186f",
                        "glosses": [
                            "Qui ne peut être pris, en parlant de villes, de forteresses, etc., que l'on ne peut pas conquérir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8088ea-3ee3-493a-9e28-ff861d32e2ee",
                                "sense_id": "834cb29b-0eb8-3e38-90b9-a4e35b192aa1",
                                "text": "Pendant tout le cours du moyen âge, cette forteresse fut considérée comme imprenable. Le fait est qu’elle ne fut point attaquée et n’ouvrit ses portes au prince Noir, Édouard, en 1355, que quand tout le pays du Languedoc se fut soumis à ce conquérant."
                            },
                            {
                                "example_id": "50e1b66c-771f-4173-bc31-54a2ea2baa9d",
                                "sense_id": "834cb29b-0eb8-3e38-90b9-a4e35b192aa1",
                                "text": "La ville avait la réputation d'être imprenable ; son château s'élevait à l'est et la ceinture de murailles qui entourait la cité venait s'y attacher; des portes, des bastions, des fossés formaient un respectable appareil de défense."
                            },
                            {
                                "example_id": "04f7b3d4-79b2-4101-b7ff-8ad54b0a152c",
                                "sense_id": "834cb29b-0eb8-3e38-90b9-a4e35b192aa1",
                                "text": "La garnison se composait de trente-deux Suisses et de quatre-vingt-deux invalides. La Bastille n'était-elle pas imprenable ?"
                            },
                            {
                                "example_id": "3eb1acbb-22eb-48ec-876a-edfd3912528d",
                                "sense_id": "834cb29b-0eb8-3e38-90b9-a4e35b192aa1",
                                "text": "C’est une des raisons qui me font chérir mon masque, mon incognito, mon imprenable forteresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bf4f327-ce27-3439-9b5c-49b320f2c10c",
                        "entry_id": "80b401d2-5a9c-312f-9820-2305bd3e186f",
                        "glosses": [
                            "Que l'on ne peut prendre, saisir ou attraper."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "7677414c-e6f3-4c33-a3e3-4a6b283fb91c",
                                "sense_id": "5bf4f327-ce27-3439-9b5c-49b320f2c10c",
                                "text": "Mais les propriétaires du domaine craignent que le no-kill aboutisse à une population de truites \"éduquées\", qui deviennent imprenables et se comportent finalement comme des parasites, au détriment des autres poissons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17bd5197-954d-4b58-8cec-bf5b58eb72ea",
                        "source_entry_id": "80b401d2-5a9c-312f-9820-2305bd3e186f",
                        "target_lang_word": "impregnable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impregnable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee3ce781-867e-37b1-ad64-e840d1e693e3",
                                        "entry_id": "de61e212-106b-3cda-854a-974911d8323b",
                                        "glosses": [
                                            "Of a fortress or other fortified place: able to withstand all attacks; impenetrable, inconquerable, unvanquishable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1b8b8e-8ec0-4392-9a6f-ae50dcf0dd9b",
                                                "sense_id": "ee3ce781-867e-37b1-ad64-e840d1e693e3",
                                                "text": "Unerringly impelling this dead, impregnable, uninjurable wall, and this most buoyant thing within; there swims behind it all a mass of tremendous life, only to be adequately estimated as piled wood is—by the cord; and all obedient to one volition, as the smallest insect."
                                            },
                                            {
                                                "example_id": "c37cde34-37d3-4fa8-97f2-dfb98b471c6f",
                                                "sense_id": "ee3ce781-867e-37b1-ad64-e840d1e693e3",
                                                "text": "Jurgis got up, wild with rage; but the door was shut and the great castle was dark and impregnable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7501b175-4989-3358-80e2-a643a44f15d6",
                                        "entry_id": "de61e212-106b-3cda-854a-974911d8323b",
                                        "glosses": [
                                            "Too strong to be defeated or overcome; invincible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f11790-fbaa-4f6d-a6de-a395bef8df5c",
                                                "sense_id": "7501b175-4989-3358-80e2-a643a44f15d6",
                                                "text": "[A]s for the Friendſhip of the World; […] he may at laſt be no more able to get into the other's Heart, than he is to thruſt his Hand into a Pillar of Braſs. The Man's Affection, amidſt all theſe Kindneſſes done him, remaining wholly unconcerned, and impregnable; juſt like a Rock, which being plied continually by the Waves, ſtill throws them back again into the Boſom of the Sea that ſent them, but is not at all moved by any of them."
                                            },
                                            {
                                                "example_id": "15f21097-8880-445a-b6af-a5d50d582879",
                                                "sense_id": "7501b175-4989-3358-80e2-a643a44f15d6",
                                                "text": "And with Bolton suffering a wretched run of five straight home defeats – their worst run in 109 years – Chelsea fans would have been forgiven for expecting a comfortable win. But surely they did not anticipate the ease with which their team raced into an almost impregnable half-time lead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impregnable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "627984b2-60f9-3b6f-8aa2-13260d445a18",
                                        "entry_id": "472f44b3-eb15-3e16-9350-464454239a1a",
                                        "glosses": [
                                            "Capable of being impregnated; impregnatable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42433f36-b561-4974-ae10-ea782846ec4a",
                                                "sense_id": "627984b2-60f9-3b6f-8aa2-13260d445a18",
                                                "text": "The reproductive strategies of troop members, especially those of impregnable females, are suggested to influence patterns of range use."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
