                "senses": [
                    {
                        "sense_id": "6976580f-f93c-3f6d-918a-b83261f96b7c",
                        "entry_id": "7d351a22-3b24-31cc-aa1e-4bfd7e1aa2fc",
                        "glosses": [
                            "der Teil eines Strumpfes, der den Fuß umschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9539029a-e304-40df-ab34-cbb05bacea0d",
                                "sense_id": "6976580f-f93c-3f6d-918a-b83261f96b7c",
                                "text": "Am Füßling des Strumpfes ist eine Masche gelaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85acd62b-86ab-36bd-ad1b-190a281dbe44",
                        "entry_id": "7d351a22-3b24-31cc-aa1e-4bfd7e1aa2fc",
                        "glosses": [
                            "nur die Zehen und die Ferse umfassende Socke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78bcf3c9-5c22-459c-9233-73ea9fd22062",
                                "sense_id": "85acd62b-86ab-36bd-ad1b-190a281dbe44",
                                "text": "„\"Das machen Frauen oft\", sagt Andreas Gummer vom Hanse Strumpf Kontor. Das Knoten ist ein beliebtes Verfahren für Nylonkniestrümpfe,-söckchen oder sogenannte Füßlinge , das sind die Teile, die nur knapp Zehen und Ferse bedecken, so daß sie in Pumps nicht zu sehen sind. Pflücken.‟"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8c1f0678-f7dc-3860-bc17-1c4e4a312e10",
                        "entry_id": "7d351a22-3b24-31cc-aa1e-4bfd7e1aa2fc",
                        "glosses": [
                            "ein Tauchschuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c2487c-a9d8-46a3-8bf0-5d6db497910a",
                                "sense_id": "8c1f0678-f7dc-3860-bc17-1c4e4a312e10",
                                "text": "Für den Höhlentauchgang hatte er sich besondere Füßlinge gekauft, die man auf dem Markt nicht leicht finden konnte."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
