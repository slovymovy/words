                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts onderzocht de patiënt op <w>inwendige</w> bloedingen na het ongeluk.",
                            "target_lang_translations": {
                                "en": "The doctor examined the patient for <w>internal</w> bleeding after the accident."
                            }
                        },
                        {
                            "text": "Hij had last van een <w>inwendige</w> parasiet die operatief verwijderd diende te worden.",
                            "target_lang_translations": {
                                "en": "He suffered from an <w>internal</w> parasite that had to be removed surgically."
                            }
                        }
