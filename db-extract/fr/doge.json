                                        "glosses": [
                                            "Specifically, a Shiba Inu, as in the doge meme."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910e1a40-2ae5-4f9a-ae3e-4ab56605b222",
                                                "sense_id": "9a2ac3d2-bc25-3e80-aca0-b5763dd4f43b",
                                                "text": "Bobsled wasn't the only Dogecoin-backed sporting success. Fans of Nascar will recognise the car driven by Josh Wise, emblazoned, as it is, with the adorable little doge on its bonnet (pictured above)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90b579db-f2d6-3879-90cc-1639f19aa4d5",
