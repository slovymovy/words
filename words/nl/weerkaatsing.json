    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31670425-4cec-3d0f-93df-6256a72796e6",
                    "sense_definition": "het beeld, licht of geluid dat door een oppervlak wordt teruggeworpen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "optisch en akoestisch effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag de <w>weerkaatsing</w> van de zon in het stille water van het meer.",
                            "target_lang_translations": {
                                "en": "I saw the <w>reflection</w> of the sun in the still water of the lake."
                            }
                        },
                        {
                            "text": "De felle <w>weerkaatsing</w> in de spiegel verblindde hem voor een kort moment.",
                            "target_lang_translations": {
                                "en": "The bright <w>reflection</w> in the mirror blinded him for a short moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflectie",
                        "terugkaatsing"
                    ],
                    "common_phrases": [
                        "felle weerkaatsing",
                        "weerkaatsing in het water"
                    ],
                    "target_lang_definitions": {
                        "en": "the image, light, or sound that is thrown back by a surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reflection",
                                "target_lang_sense_clarification": "an image or light seen in a surface"
                            },
                            {
                                "target_lang_word": "reverberation",
                                "target_lang_sense_clarification": "the reflection of sound or light"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc951399-ae12-3237-9022-2611774cb20a",
                    "sense_definition": "het proces of de handeling van het <w>weerkaatsen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "optisch en akoestisch effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>weerkaatsing</w> van geluidsgolven tegen de muren zorgde voor een sterke echo.",
                            "target_lang_translations": {
                                "en": "The <w>reflection</w> of sound waves against the walls caused a strong echo."
                            }
                        },
                        {
                            "text": "Door de <w>weerkaatsing</w> van het licht op de witte muren lijkt de kamer veel groter.",
                            "target_lang_translations": {
                                "en": "Due to the <w>reflection</w> of light on the white walls, the room seems much larger."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflectie",
                        "terugkaatsing"
                    ],
                    "common_phrases": [
                        "weerkaatsing van geluid",
                        "weerkaatsing van licht"
                    ],
                    "target_lang_definitions": {
                        "en": "the process or act of reflecting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reflection",
                                "target_lang_sense_clarification": "the physical process of reflecting waves"
                            },
                            {
                                "target_lang_word": "mirroring",
                                "target_lang_sense_clarification": "the act of reflecting an image or behavior"
                            }
                        ]
                    }
                }
            ]
        }
    ]
