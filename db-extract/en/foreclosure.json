                                    },
                                    {
                                        "sense_id": "4286570b-b289-3124-b7c8-08ae7339b434",
                                        "entry_id": "1b82936a-1a2c-3f4e-b613-a7d8cb3c6e3c",
                                        "glosses": [
                                            "Prise de possession par une autorité publique de meubles ou d’immeubles, dont la propriété est revendiquée ou sur lesquels un créancier veut se faire payer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce1b866c-b7e9-4470-a6a2-eb4f1ac328ee",
                                                "sense_id": "4286570b-b289-3124-b7c8-08ae7339b434",
                                                "text": "Vers 1932, les banquiers commencèrent à redouter l'insolvabilité permanente des fermiers. Prenant peur, ils exigèrent le remboursement ou la saisie des gages."
                                            },
                                            {
                                                "example_id": "8728264e-74b9-4842-ac21-711d058a7c11",
                                                "sense_id": "4286570b-b289-3124-b7c8-08ae7339b434",
                                                "text": "Le ménage Fagerolle se débattit parmi les exploits d'huissiers, le menaces de saisie. Il grêlait des papiers bleus, verts, jaunes."
                                            },
                                            {
                                                "example_id": "1a3209ff-0b05-4c81-b2c3-7b4891cdf944",
                                                "sense_id": "4286570b-b289-3124-b7c8-08ae7339b434",
                                                "text": "Des descentes de police visent les « cayennes ». Pour éviter leur saisie, les compagnons détruisent eux-mêmes leurs documents régulièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77364dc2-e379-37ef-a6ad-0561e1ede5c2",
                                        "entry_id": "1b82936a-1a2c-3f4e-b613-a7d8cb3c6e3c",
                                        "glosses": [
                                            "Action de s’emparer provisoirement des choses qui sont l’objet d’une contravention, d’une poursuite, ou qui peuvent fournir la preuve d’un crime, d’un délit."
                                        ],
                                        "tags": [
                                            "Fiscal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b46d7e-1de8-4423-8919-db1b9e231d35",
                                                "sense_id": "77364dc2-e379-37ef-a6ad-0561e1ede5c2",
                                                "text": "C’est ainsi que la Fondation assistance aux animaux (FAA) décrit le pavillon de Maisons-Alfort (Val-de-Marne) dans lequel elle est intervenue, lundi matin, pour une opération de saisie de chiens, menée conjointement avec les services de la Direction départementale de la protection des populations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95de6e9e-f934-3b54-882f-c7f2e609fed7",
                                        "entry_id": "1b82936a-1a2c-3f4e-b613-a7d8cb3c6e3c",
                                        "glosses": [
                                            "Numérisation par entrée, généralement au clavier, de documents par une personne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
