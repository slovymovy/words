                                        "entry_id": "7cb102fa-78a8-3027-99ff-15bcbe0d0fcf",
                                        "glosses": [
                                            "In a historic manner; with reference to history or the historical record."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de91f95-a065-4bdd-8e39-4be59a40f5b5",
                                                "sense_id": "62097213-8e63-38f6-9c60-f4850558470b",
                                                "text": "Historically speaking, this company has always collected payment before starting work."
                                            },
                                            {
                                                "example_id": "a075626d-9578-4989-8285-a35e4699420e",
                                                "sense_id": "62097213-8e63-38f6-9c60-f4850558470b",
                                                "text": "Virtually all modern scholars of antiquity agree that Jesus existed historically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79d6102c-9d49-3230-a522-de7770552bfe",
                                        "entry_id": "7cb102fa-78a8-3027-99ff-15bcbe0d0fcf",
                                        "glosses": [
                                            "According to history: formerly, in the past, traditionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b668b272-fc69-47a3-92c8-b8c13cd9d0d0",
                                                "sense_id": "79d6102c-9d49-3230-a522-de7770552bfe",
                                                "text": "Historically, this company collected payment before starting work."
                                            },
                                            {
                                                "example_id": "77b21c61-ac84-4a23-bd3b-f8f3a841a9ad",
                                                "sense_id": "79d6102c-9d49-3230-a522-de7770552bfe",
                                                "text": "Holden Matthews, 21, has been charged in connection with fires at three historically black churches in Louisiana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3698ab4-1fb7-36a5-9aaa-8ad4da3f2199",
                                        "entry_id": "7cb102fa-78a8-3027-99ff-15bcbe0d0fcf",
                                        "glosses": [
                                            "To an unprecedented or extremely rare degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a82c45c6-7f15-4183-b25b-a6ac961a5c63",
                                                "sense_id": "f3698ab4-1fb7-36a5-9aaa-8ad4da3f2199",
                                                "text": "In January, the anti-corruption organization Citizens for Responsibility and Ethics in Washington, or CREW, released a detailed report on the historically unethical presidency of Donald Trump."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
