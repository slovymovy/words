                "senses": [
                    {
                        "sense_id": "fb1ff528-95a3-35b8-96d5-3e55a133ef93",
                        "entry_id": "fe3656a5-0ab8-3f3d-83da-0dd4e1119e31",
                        "glosses": [
                            "vat waarin men bier kan bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17dbab4-eb9e-43bc-9198-20a2e4c2e3d8",
                                "sense_id": "fb1ff528-95a3-35b8-96d5-3e55a133ef93",
                                "text": "Michiel de Ruyter illustreert het betoog van De Witt met allerlei beelden van succesvolle Nederlandse expansie. We zien in vogelvlucht een markt in Azië waar een hand in een volle zak specerijen graait, daarna een bierton die over de kade rolt. Er staat overduidelijk Grolsch op geschreven."
                            },
                            {
                                "example_id": "05871881-9951-4616-a507-2538ab647cb3",
                                "sense_id": "fb1ff528-95a3-35b8-96d5-3e55a133ef93",
                                "text": "De biertenten waren al goed gevuld met heel wat dorstige kelen, toen burgemeester Christian Ude van München zaterdag het jaarlijkse festival van het bier met twee slagen van de hamer op een bierton opende. Zijn boodschap: 'Drink met mate. Niet iedereen hoeft te weten, dat je een idioot bent'. De Standaard 21/09/2013 om 13:17"
                            }
                        ]
                    }
                ],
