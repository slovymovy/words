                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2485b818-d5c7-4874-8ab9-7a2fd3e845e9",
                                                "sense_id": "65f0ffe3-47ee-30ca-bf8c-4a18774ea967",
                                                "text": "Elle a cessé de croire au luthérianisme qu’on pratique autour d’elle ; elle ne croit même plus, ou ne croit pas complètement au dogme chrétien tel qu’il est partout institutionnalisé et vécu."
                                            },
                                            {
                                                "example_id": "58bb7f74-e474-4c70-b88b-a8956774f8b3",
                                                "sense_id": "65f0ffe3-47ee-30ca-bf8c-4a18774ea967",
                                                "text": "Cette introduction rappelle l’épineuse question du luthérianisme."
                                            }
