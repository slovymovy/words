                "senses": [
                    {
                        "sense_id": "bf3f93de-ff80-3c10-accd-40caa294afaa",
                        "entry_id": "85e8e43d-9e27-3f0e-8190-acd9406ccf6c",
                        "glosses": [
                            "Faire perdre son caractère absurde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e7911d-e688-453f-84b7-c7df7e4192c3",
                                "sense_id": "bf3f93de-ff80-3c10-accd-40caa294afaa",
                                "text": "J’écris, j’écris pour exister, pour être, être ici, en ce lieu avec quelque raison, justifier ma présence, la désabsurdiser."
                            },
                            {
                                "example_id": "03d357ad-0402-48c4-98b8-4ca44cf2f714",
                                "sense_id": "bf3f93de-ff80-3c10-accd-40caa294afaa",
                                "text": "Tu as désabsurdisé ma vie…"
                            },
                            {
                                "example_id": "6dddf729-43f1-4f07-a05e-9cab4f557088",
                                "sense_id": "bf3f93de-ff80-3c10-accd-40caa294afaa",
                                "text": "Dans le fond, j’ai peint, simplement, pour désabsurdiser l’existence."
                            }
                        ]
                    }
