                        "examples": [
                            {
                                "example_id": "3a45aacc-2030-43e2-bd08-f187e71874b1",
                                "sense_id": "1562eb85-4e54-377c-99f6-a09bf5a06667",
                                "text": "Da diese Zahlen sich durch hohe Geburtsraten und niedrige Verluste alle zwanzig Jahre verdoppeln, scheint die Zukunft des Pennsylvaniadeutschen gesichert.",
                                "translation": "Так как эти цифры удваиваются каждые двадцать лет за счёт высокой рождаемости и низкой смертности, будущее пенсильванско-немецкого диалекта в безопасности."
                            }
                        ]
                    }
