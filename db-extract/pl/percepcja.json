                                        "sense_id": "fb0fae26-e200-3f0c-9da1-1e446e1f3443",
                                        "entry_id": "38cd98bb-4615-34f1-b9c4-4bc4457dd4cc",
                                        "glosses": [
                                            "Facultad mental y acción de recibir, elaborar e interpretar información proveniente del entorno, especialmente a través de los sentidos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a57160e-d074-4687-9ca3-c52f50bd6af2",
                                                "sense_id": "fb0fae26-e200-3f0c-9da1-1e446e1f3443",
                                                "text": "La percepción se refiere al proceso activo de percibir la realidad y organizarla en interpretaciones o visiones sensatas"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "342a4cc1-448d-3ee1-a5f0-f15fa00d5872",
                                        "entry_id": "38cd98bb-4615-34f1-b9c4-4bc4457dd4cc",
                                        "glosses": [
                                            "Imagen o representación de un objeto o concepto en la mente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa0fb7e-b914-44ff-85bd-a602be602ddd",
                                                "sense_id": "342a4cc1-448d-3ee1-a5f0-f15fa00d5872",
                                                "text": "Con esto aumentó el nivel de angustia social y la percepción de inseguridad, circunstancia que propició un aumento del índice de delincuencia"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b4586e-1396-4d91-a12a-a67373534ab1",
                        "source_entry_id": "e2503652-b179-33b2-81a9-d341cfd9deba",
                        "source_sense_id": "29789dbc-6c8a-3cb6-b037-f4195c867176",
                        "target_lang_word": "Perzeption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perzeption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                        "entry_id": "8be0900f-3f8f-3340-9c2a-f8a4f4112ad3",
                                        "glosses": [
                                            "sinnliche Wahrnehmung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402ec703-4618-4355-954a-ea64924ed67c",
                                                "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                                "text": "„Dies ist nahezu einzigartig in allen 25 EU-Mitgliedstaaten und, gelinde gesagt, in der ausländischen Perzeption undemokratisch für ein europäisches Kernland.“"
                                            },
                                            {
                                                "example_id": "6a28b035-e394-4c6e-a835-71f5ef64fa07",
                                                "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                                "text": "„Die ganze Kunstgeschichte ist letzlich die Geschichte der verschiedenen Arten visueller Perzeption, also eine Geschichte der sich wandelnden Art und Weise, wie der Mensch die Welt gesehen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2323420d-c25f-3ecd-bd7d-f6d05cbea252",
                                        "entry_id": "8be0900f-3f8f-3340-9c2a-f8a4f4112ad3",
                                        "glosses": [
                                            "Wahrnehmung und Verarbeitung sprachlicher Äußerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df911faf-fbf3-45e6-9091-08b8b583ad4a",
                                                "sense_id": "2323420d-c25f-3ecd-bd7d-f6d05cbea252",
                                                "text": "„Wenn das aber so ist, dann ist die Unfähigkeit Erwachsener, bestimmte distinktive Laute in anderen Sprachen zu unterscheiden, einfach auf ihre automatisierte Perzeption zurückzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
