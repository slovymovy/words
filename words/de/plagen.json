                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seit mehreren Wochen <w>plagen</w> den alten Mann heftige Rückenschmerzen bei der täglichen Arbeit."
                        },
