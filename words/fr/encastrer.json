    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e730531-ee11-3779-9755-86d1e6477eaf",
                    "sense_definition": "Insérer ou fixer un objet dans une ouverture ou un logement ménagé à cet effet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "encastrer_fixer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier va <w>encastrer</w> le nouveau four directement dans le meuble de cuisine."
                        },
                        {
                            "text": "Ils ont choisi d'<w>encastrer</w> de petits spots lumineux dans le plafond du salon."
                        }
                    ],
                    "synonyms": [
                        "emboîter",
                        "enchâsser",
                        "incruster",
                        "intégrer"
                    ],
                    "antonyms": [
                        "dégager",
                        "extraire"
                    ],
                    "common_phrases": [
                        "encastrer dans le mur",
                        "spots à encastrer"
                    ]
                },
                {
                    "sense_id": "be6936ba-dbbc-3b8a-b8c8-3abea6b9ad07",
                    "sense_definition": "S'enfoncer violemment dans un obstacle ou se coincer étroitement entre des éléments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "encastrer_choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a dérapé sur le verglas avant de s'<w>encastrer</w> dans un platane."
                        },
                        {
                            "text": "Pendant la tempête, un bateau sans amarres est venu s'<w>encastrer</w> entre les rochers du port."
                        }
                    ],
                    "synonyms": [
                        "coincer",
                        "enfoncer"
                    ],
                    "antonyms": [
                        "désencastrer"
                    ],
                    "common_phrases": [
                        "s'encastrer dans un arbre",
                        "s'encastrer dans un mur"
                    ]
                },
                {
                    "sense_id": "5e583b43-e21b-3a41-8836-4d9c52d73b48",
                    "sense_definition": "Se placer ou se tenir immobile dans l'encadrement d'une porte ou d'une fenêtre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "encastrer_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'homme s'<w>encastra</w> dans l'encadrement de la porte pour empêcher quiconque de sortir."
                        },
                        {
                            "text": "Elle s'<w>encastre</w> silencieusement dans l'embrasure de la fenêtre pour observer la rue."
                        }
                    ],
                    "synonyms": [
                        "se caler",
                        "se poster"
                    ],
                    "common_phrases": [
                        "s'encastrer dans l'embrasure"
                    ]
                }
            ]
        }
    ]
