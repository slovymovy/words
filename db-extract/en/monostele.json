                "senses": [
                    {
                        "sense_id": "8ff8f309-e7fa-3ab9-a179-733b4fbeafd8",
                        "entry_id": "292734d5-e23d-3061-b468-5e051a467feb",
                        "glosses": [
                            "Synonym of protostele."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4584834e-e9c1-4f9f-9be6-b5081f567300",
                                "sense_id": "8ff8f309-e7fa-3ab9-a179-733b4fbeafd8",
                                "text": "Again, in ectophloic medullated monosteles the presence of an internal endodermis between xylem and central parenchyma is rare ; on the other hand when an amphiphloic condition obtains, an endodermis often cuts off the internal phloem from the central parenchyma."
                            },
                            {
                                "example_id": "de39c195-9fde-4884-9a9e-23d97be1020a",
                                "sense_id": "8ff8f309-e7fa-3ab9-a179-733b4fbeafd8",
                                "text": "This is most readily done by reference to the sporeling: for there the axis is found to be traversed by a coherent monostele: and it is to the disintegration of this, together with the formation of commissural connections, that the complex structure of the adult is due."
                            },
                            {
                                "example_id": "81d10a30-b7ba-4e0d-a12b-4d8cfa601535",
                                "sense_id": "8ff8f309-e7fa-3ab9-a179-733b4fbeafd8",
                                "text": "This condition be conceived to be derived by repeated division of the monostele."
                            },
                            {
                                "example_id": "4b508ef2-e921-4617-b4d6-86f37bdc368e",
                                "sense_id": "8ff8f309-e7fa-3ab9-a179-733b4fbeafd8",
                                "text": "'Monosteles' comprising a ring of alternating xylem and phloem elements surrounding parenchymatous pith; 'monosteles' occurring in most genera..."
                            }
                        ]
                    }
