                },
                {
                    "sense_id": "4383384c-9468-3337-b920-7b42e9a700cc",
                    "sense_definition": "oddział szpitala zajmujący się leczeniem operacyjnym pacjentów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "szpital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz zdecydował, że pacjent musi natychmiast trafić na <w>chirurgię</w>.",
                            "target_lang_translations": {
                                "ru": "Врач решил, что пациент должен немедленно попасть в <w>хирургию</w>."
                            }
                        },
                        {
                            "text": "Mój brat leży na <w>chirurgii</w> po wczorajszym wypadku samochodowym.",
                            "target_lang_translations": {
                                "ru": "Мой брат лежит в <w>хирургическом отделении</w> после вчерашней автомобильной аварии."
                            }
                        }
                    ],
                    "common_phrases": [
