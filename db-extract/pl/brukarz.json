                                        "sense_id": "b56628dd-3181-3f85-bdd5-a96ad0d97ff9",
                                        "entry_id": "694c6015-c02d-3ca0-a2ed-10a7543d92b7",
                                        "glosses": [
                                            "Alternative form of pavior."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33880c99-8bd6-42ca-b14f-be28659d651d",
                                                "sense_id": "b56628dd-3181-3f85-bdd5-a96ad0d97ff9",
                                                "text": "The ground beneath her feet is extraordinarily smooth, as near as cobble-stones can get to parquetry; she imagines an army of paviours patiently completing it like a jigsaw puzzle while the placid citizens look on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11a898c5-9b51-4dfd-a2e4-bea04d7a0244",
                        "source_entry_id": "3041dff1-cba8-3402-a391-bbb122bde237",
                        "source_sense_id": "5c9db85f-bf3b-35c5-8f15-54ef8cb8ac17",
                        "target_lang_word": "pavior",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pavior",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31944b69-466e-3015-b61e-1959dbda084d",
                                        "entry_id": "eaf8f023-0e0c-3bc5-b96d-952a1862ad9f",
                                        "glosses": [
                                            "A person who lays paving slabs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796140b2-bee4-4e95-9951-c4aaa38223e6",
                                                "sense_id": "31944b69-466e-3015-b61e-1959dbda084d",
                                                "text": "[T]he Contract with the Pipe-water Pavior was, as he recollects, to keep the Pavement in Repair for ſix Weeks; […]"
                                            },
                                            {
                                                "example_id": "d1e05cee-bdae-4a30-b33a-123fabe712cb",
                                                "sense_id": "31944b69-466e-3015-b61e-1959dbda084d",
                                                "text": "A \"mooner,\" fond of staring into shop windows, or watching the labourers pulling up the pavement to inspect the gas-pipes, or listening stolidly to the dull \"pech\" of the paviour's rammer on the flags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5fd57a7-0340-3f97-a0e7-28021588f713",
                                        "entry_id": "eaf8f023-0e0c-3bc5-b96d-952a1862ad9f",
                                        "glosses": [
                                            "A brick or slab used for paving."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f17fbd8f-12e1-3958-8443-5d77ea487034",
                                        "entry_id": "eaf8f023-0e0c-3bc5-b96d-952a1862ad9f",
                                        "glosses": [
                                            "A machine that is used to tamp down paving slabs."
                                        ],
