                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28d2e773-c0fb-49bd-8daf-6f9de6d83621",
                                "sense_id": "7a88d17a-1a40-3b3e-867a-25932393f2a6",
                                "text": "„Der Großkundenrabatt beträgt derzeit 5% auf den Normalpreis der Fahrkarte, dieser Rabatt wird beim Kauf sofort vom Fahrpreis abgezogen.“"
                            },
                            {
                                "example_id": "c3393019-0731-49fa-ad96-b1fc4975237e",
                                "sense_id": "7a88d17a-1a40-3b3e-867a-25932393f2a6",
                                "text": "„Die Verhandlungen mit dem Deutschen Apothekerverband über die Höhe des gesetzlich vorgeschriebenen Großkundenrabatts für die gesetzliche Krankenversicherung ab dem 1. Januar 2013 gestalten sich äußerst schwierig.“"
                            },
                            {
                                "example_id": "58f987b7-ffe7-43d6-981b-3286ee3f87eb",
                                "sense_id": "7a88d17a-1a40-3b3e-867a-25932393f2a6",
                                "text": "„Denn die aktuelle BGH-Entscheidung zum Werksangehörigenrabatt lässt auch die Fragen zum Großkundenrabatt in neuem Licht erscheinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
