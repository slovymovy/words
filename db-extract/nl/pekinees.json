                                "target_senses": [
                                    {
                                        "sense_id": "771ba594-d92c-30bb-9a73-7cf6356cc8bc",
                                        "entry_id": "4a45d5a9-fb02-397c-945a-5fb11919a2dc",
                                        "glosses": [
                                            "Synonyme d’épagneul pékinois (race de chien)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ff8d1a-d98c-4c1e-b2da-3c4390964129",
                                                "sense_id": "771ba594-d92c-30bb-9a73-7cf6356cc8bc",
                                                "text": "Une Diane à la biche, dont la biche n’était d’ailleurs qu’un pékinois hargneux aux gros yeux de dorade morte, sous un petit crâne plat de crétin."
                                            },
                                            {
                                                "example_id": "473c4909-79c8-4b37-9595-000ace448c2e",
                                                "sense_id": "771ba594-d92c-30bb-9a73-7cf6356cc8bc",
                                                "text": "Le vétérinaire de Louvigny-Cambrouse lui avait empoisonné son pékinois en le bourrant de médicaments ; moi, je le lui ai retapé en deux jours avec une tisane d'herbes."
                                            }
