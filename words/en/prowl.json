{
    "word_family": [
        "prowler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38c8fcd0-ffaa-30f6-bd45-9343e965940c",
                    "sense_definition": "To move quietly and carefully, especially when hunting or looking for something to steal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry tiger <w>prowled</w> through the tall grass looking for its next meal."
                        },
                        {
                            "text": "Security guards <w>prowl</w> the building at night to ensure everything is safe."
                        }
                    ],
                    "synonyms": [
                        "stalk",
                        "creep",
                        "sneak"
                    ],
                    "common_phrases": [
                        "prowl around"
                    ]
                },
                {
                    "sense_id": "ce7dc1fd-c974-3946-b1d7-0d08ed71b52a",
                    "sense_definition": "To walk around without a clear purpose or destination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had nothing to do, so he just <w>prowled</w> around the city center all afternoon."
                        },
                        {
                            "text": "The bored teenagers <w>prowled</w> the mall without buying anything."
                        }
                    ],
                    "synonyms": [
                        "wander",
                        "roam",
                        "loiter"
                    ]
                },
                {
                    "sense_id": "e9bb9125-974c-3770-a2ee-53dfa42918ba",
                    "sense_definition": "To obtain items or money through theft or looting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thieves <w>prowled</w> the abandoned houses for anything of value."
                        },
                        {
                            "text": "They <w>prowled</w> the ruins hoping to find hidden treasures."
                        }
                    ],
                    "synonyms": [
                        "plunder",
                        "loot"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f8d461a-7aff-36ce-9725-85f086dfcb68",
                    "sense_definition": "The act of moving stealthily or searching for something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat went on a midnight <w>prowl</w> through the garden."
                        },
                        {
                            "text": "The police officer was on the <w>prowl</w> for speeding drivers."
                        }
                    ],
                    "common_phrases": [
                        "on the prowl"
                    ]
                }
            ]
        }
    ]
