                "senses": [
                    {
                        "sense_id": "9360fc09-1455-386a-8b1b-aa21afd688ef",
                        "entry_id": "e82869d4-4f11-3851-a724-8a48eb803cbd",
                        "glosses": [
                            "reproduzierbare Angaben zu einem Geruchsstoff und dessen geruchliche Wahrnehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf0912d2-b510-43d1-8afc-e272362667bd",
                                "sense_id": "9360fc09-1455-386a-8b1b-aa21afd688ef",
                                "text": "„Es ist daher für einen Validierungsdatensatz wünschenswert, dass diese Geruchsdaten möglichst ergänzt werden durch Vergleichsdaten mit einem Tracergas, das mit herkömmlichen Meßmethoden erfasst werden kann.“"
                            },
                            {
                                "example_id": "4ac5f78d-f88d-449d-9e73-d88c8a91d9a2",
                                "sense_id": "9360fc09-1455-386a-8b1b-aa21afd688ef",
                                "text": "„Das Programm nutzt die mitgelieferte Geruchsdatenbank, es können aber auch eigene Werte eingegeben werden.“"
                            },
                            {
                                "example_id": "f881a422-01ad-451b-8d7b-a84a7585e8bd",
                                "sense_id": "9360fc09-1455-386a-8b1b-aa21afd688ef",
                                "text": "„Eine andere Art Geruchsdaten aufzuzeichnen ist mittels Handapparat gestärkt mit einem datenbasierten Apparat verbunden mit einem GPS System.“"
                            },
                            {
                                "example_id": "2979b436-8fb0-4438-8321-38972c910dc8",
                                "sense_id": "9360fc09-1455-386a-8b1b-aa21afd688ef",
                                "text": "„Von ihm werden die Geruchsdaten über Stria lateralis und Area praepiriformis zum Hippocampus geleitet, um dort als Geruchseindrücke und Geruchserlebnisse abgespeichert zuwerden.“"
                            }
                        ],
