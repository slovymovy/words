                "senses": [
                    {
                        "sense_id": "21ba7bce-74fc-3bb5-b575-1e47be824b1e",
                        "entry_id": "aa000548-281f-37fc-b056-d32870c98b7f",
                        "glosses": [
                            "Abréviation de École royale forestière, établissement appelé aujourd'hui École nationale des eaux et forêts."
                        ],
                        "tags": [
                            "ellipsis",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a072b3f5-3d23-4870-9102-ec0d35a1a309",
                                "sense_id": "21ba7bce-74fc-3bb5-b575-1e47be824b1e",
                                "text": "Le frère de cet écolier, solide, fort, déjà moustachu, qui se préparait à la Forestière, sauta par-dessus la table, et vint, à son tour, frapper le maître d’étude, et le bouscula et le battit."
                            }
                        ]
                    }
                ],
