                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ded0b1-b33a-440d-9e53-e1016cf8c5b2",
                                                "sense_id": "370f63e3-83c7-3350-ab21-55c72293c305",
                                                "text": "Ik had een klamme rug van het zweet en het plafond leek lager dan een uur geleden."
                                            },
                                            {
                                                "example_id": "e26e732e-e08a-40c4-85be-aff6d648f331",
                                                "sense_id": "370f63e3-83c7-3350-ab21-55c72293c305",
                                                "text": "Op het steile pad kwam ik nog altijd grote sneeuwvelden tegen en op een van de laatste hiervan zag ik in de verte opeens twee meisjes vlak achter elkaar de berg af glijden. Ik schrok me rot, ze kwamen pas 70 meter lager tot stilstand."
                                            }
                                        ]
                                    }
                                ]
                            }
