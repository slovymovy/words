                        "form": "die Nutztiere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bbb67b0-bfd9-3c0c-aee8-360cd6f19043",
                        "entry_id": "b83247f0-ea19-3649-a838-f93f8c1ce27b",
                        "glosses": [
                            "nicht frei lebendes, an den Menschen gewöhntes Tier, dessen Nutzwert überwiegt, zum Beispiel die Kuh als Milchlieferant oder beim Bauern die Katze als Mäusefänger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b4ccaa-ca2f-41a5-9ae1-f2b0019c807d",
                                "sense_id": "7bbb67b0-bfd9-3c0c-aee8-360cd6f19043",
                                "text": "Die Katze ist ein Haustier und Nutztier des Bauern."
                            },
                            {
                                "example_id": "6269508e-8692-4ade-873c-9858e72ead53",
                                "sense_id": "7bbb67b0-bfd9-3c0c-aee8-360cd6f19043",
                                "text": "„Die affektive Bindung des Menschen zu Nutztieren, die er letztendlich ausbeutet, ist weitaus geringer.“"
                            },
                            {
                                "example_id": "2428e71b-5cf8-454b-b2b1-a8ac161962f8",
                                "sense_id": "7bbb67b0-bfd9-3c0c-aee8-360cd6f19043",
                                "text": "„Mit den geraubten Arbeitssklaven und Nutztieren bauten die Comanchen ein Handelsimperium auf, das in seiner Blüte eine verblüffende Wirtschaftskraft erlangte.“"
                            },
                            {
                                "example_id": "52182883-b4b6-4407-8e67-8dc2450e6736",
                                "sense_id": "7bbb67b0-bfd9-3c0c-aee8-360cd6f19043",
                                "text": "„Zwar verarbeiten die Skythen primär die Häute ihrer Nutztiere, aber in einigen Fällen scheuten sie offenbar nicht davor zurück, auch Menschenhaut zu verwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
