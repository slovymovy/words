                        "examples": [
                            {
                                "example_id": "f53b2c01-6580-4a18-8ba4-e59e47f7d4bf",
                                "sense_id": "d8a54984-45c5-3d4e-802a-c015159f95f3",
                                "text": "Other Early Paleozoic cephalopods have holochoanitic siphuncles"
                            },
                            {
                                "example_id": "96d65871-5de7-47f6-ab25-d236c4d460b2",
                                "sense_id": "d8a54984-45c5-3d4e-802a-c015159f95f3",
                                "text": "He accepted the Plectronoceratidae as primitive, and the Ellesmeroceratidae as the derived next step, one characterized by holochoanitic structure and diaphragms, and leading to a group of endoceroids;"
                            },
                            {
                                "example_id": "8e571217-1c08-4141-bf7a-b0af128a61f9",
                                "sense_id": "d8a54984-45c5-3d4e-802a-c015159f95f3",
                                "text": "However, over a short period of time (less than 10 Ma) during the late Devonian, the Clymeniida developed a dorsal (or internal) holochoanitic siphon."
                            }
                        ]
                    }
