                "senses": [
                    {
                        "sense_id": "1e4cea29-8df8-352d-b5f3-b438f4875b5e",
                        "entry_id": "f53fc375-f19f-3851-b8fc-3cd6a676226f",
                        "glosses": [
                            "Faire perdre son caractère vierge à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de76cf5a-8f47-4e6f-94ea-3df9002ee74e",
                                "sense_id": "1e4cea29-8df8-352d-b5f3-b438f4875b5e",
                                "text": "Vierge je te déviergiserai et me dis pas que ce mot existe pas"
                            },
                            {
                                "example_id": "52e93403-f9eb-49fd-a7ee-19f15f4bcbdf",
                                "sense_id": "1e4cea29-8df8-352d-b5f3-b438f4875b5e",
                                "text": "Que l'on dise que Marie n'est vierge que pour Jésus, pour ensuite la 'déviergiser' sous prétexte que l'on lit dans les évangiles 'les frères et soeurs de jésus', cela n'enlève ni ne retire rien à Marie, c'est évident !"
                            },
                            {
                                "example_id": "c8f2958b-acab-433b-876d-e046dba7e7b7",
                                "sense_id": "1e4cea29-8df8-352d-b5f3-b438f4875b5e",
                                "text": "Et des mecs en blouses blanches viendront te déviergiser."
                            }
                        ]
                    }
