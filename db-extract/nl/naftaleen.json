                        "glosses": [
                            "motten dodende cyclische koolwaterstof die ook dient als grondstof voor plastics"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47bb6223-c5a7-4315-a21a-4f85ae71ac8f",
                                "sense_id": "6298b8e9-d58b-3e79-acb7-51da1104941d",
                                "text": "Bij het begin van de werkzaamheden aan de Dannenberg, ruim twee maanden geleden, kwam het gevaarlijke naftaleen vrij."
                            },
                            {
                                "example_id": "37ed7b61-e6df-4065-997e-f405bd212114",
                                "sense_id": "6298b8e9-d58b-3e79-acb7-51da1104941d",
                                "text": "Tauw merkt daarbij wel op dat het grondwater – mocht dat worden opgepompt – niet moet worden gedronken. Tenslotte wijst de onderzoeker er nog op dat plaatselijk lichte overschrijdingen van de streefwaarden zijn gemeten voor Arseen, Chroom, Nikkel en Koper, benzeen, xyleen en naftaleen."
                            }
                        ]
                    }
