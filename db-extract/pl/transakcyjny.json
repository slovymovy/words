                                        "glosses": [
                                            "Of, pertaining to or involving transactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c3b4c11-0a79-4b96-b022-6efada0829d2",
                                                "sense_id": "adbf1841-c7b9-3231-a4e4-00bdcf098dd7",
                                                "text": "The primary function of the transactional HR SSC is the performance of the back- and front-office functions and processes through deployment of the operational service delivery capabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4ed02f-a5fb-3b9a-957d-fd5a04cad9d9",
                                        "entry_id": "c6004274-7328-3434-865d-80149ca4f9ed",
                                        "glosses": [
                                            "Based on value derived from transactions rather than on morals, ethics, or principles; pragmatic or amoral rather than moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f806e6-c08e-4541-b68f-efdc30ee8887",
                                                "sense_id": "5b4ed02f-a5fb-3b9a-957d-fd5a04cad9d9",
                                                "text": "Musk’s Israel tour was transparently transactional and frankly insulting. The antisemitic sentiment Musk endorsed had nothing to do with Israel; “replacement theory” is generally an unsupported allegation that Jews and other immigrants in the US and Europe are destroying Western civilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fba0134-80d5-31cf-ab29-56f15b6f85b5",
                                        "entry_id": "c6004274-7328-3434-865d-80149ca4f9ed",
                                        "glosses": [
                                            "Pertaining to a particular psychoanalytic theory about this."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
