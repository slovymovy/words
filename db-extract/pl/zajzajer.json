                        "entry_id": "d61d76de-2fe6-3e93-8d91-aa6595315f2e",
                        "glosses": [
                            "bardzo mocny, ostry i niesmaczny napój"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "c376b8c4-db85-489a-a2c7-0ec02efc1c40",
                                "sense_id": "d738f7e4-8eee-3a6c-a638-376d01c796d3",
                                "text": "W języku potocznym niezwykłą popularnością cieszy się też słowo „zajzajer” oznaczające w sensie dosłownym „kwas solny”, zaś w bardziej przenośnym „mocny, palący, niesmaczny, gorzki napój”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
