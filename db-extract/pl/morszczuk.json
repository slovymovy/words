                                        "entry_id": "6f068ed7-433c-323a-a68e-050aa379c7af",
                                        "glosses": [
                                            "A drying shed, as for unburned tile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dcb7b34-bc6e-49ee-9bdb-2dd5998847c1",
                                                "sense_id": "d3386253-9fde-39b5-836b-23e8b4dd01c6",
                                                "text": "The clay is taken direct from the bank and made into brick the right temper to place direct from the Machine in the hake on the yard. … take the brick direct from the Machine and put them in the hake to dry."
                                            }
                                        ]
                                    }
                                ]
