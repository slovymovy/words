                    },
                    {
                        "translation_id": "ec6750b7-ba45-4099-9338-06ed649671cb",
                        "source_entry_id": "5e4436da-0c54-39bf-a79d-acb7cd586a02",
                        "source_sense_id": "8a0b3be5-c323-370c-aad0-bff100e9a48b",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Bacchanal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bacchanal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "606c4c77-f1e9-3dec-b937-b046035be3e2",
                                        "entry_id": "8901e300-5049-3ce5-b319-18c2a85ea611",
                                        "glosses": [
                                            "Bacchusfest (Weinfest) im antiken Rom, das jedes Jahr am 16. und 17. März auf dem Aventin gefeiert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415b970e-e9df-4eae-9139-fe9f74019890",
                                                "sense_id": "606c4c77-f1e9-3dec-b937-b046035be3e2",
                                                "text": "„Ein wesentlicher Grund für die Exzesse der Bacchanalien war die Kombination großer Mengen Alkohol mit psychedelischen Substanzen wie halluzinogenen Pilzen und sogar Tollkirschen.“"
                                            },
                                            {
                                                "example_id": "5127da6c-7d1a-418e-a053-87cdca4e7a19",
                                                "sense_id": "606c4c77-f1e9-3dec-b937-b046035be3e2",
                                                "text": "„Selbst die schillernde Atmosphäre der alten Bacchanalien, die noch in den Salons im Hause der Mysterien atmete, wirkte abgestanden und schal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df338d58-cccc-3001-b328-6914af20d6b6",
                                        "entry_id": "8901e300-5049-3ce5-b319-18c2a85ea611",
                                        "glosses": [
                                            "ungezügeltes, ausschweifendes Trinkgelage"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc0375d-f03c-4059-b6d7-40cb947fcbd0",
                                                "sense_id": "df338d58-cccc-3001-b328-6914af20d6b6",
                                                "text": "„Die Musik lässt sich auch ganz ohne literarischen Hintergrund hören, ohne zu wissen, dass der Held durch die Alpen irrte, dass er ein Hirtenidyll und ein Bacchanal erlebte, bevor er starb – umrauscht von Orgelklängen.“"
                                            },
                                            {
                                                "example_id": "17f8be42-cb8e-4b55-9c76-79399598acc4",
                                                "sense_id": "df338d58-cccc-3001-b328-6914af20d6b6",
                                                "text": "„Diese Bacchanalien entarteten manchmal zu Orgien – etliche Paare umschlangen sich in den Alkoven der Gesandtschaft, …“"
                                            },
                                            {
                                                "example_id": "13da956b-464a-4e38-a9e4-b2939bd7ef2a",
                                                "sense_id": "df338d58-cccc-3001-b328-6914af20d6b6",
                                                "text": "„Dieses Bacchanal versetzte die alte Bossi in Glut; sie bemühte sich, ihren Gatten zu einer Probe seiner ehelichen Zärtlichkeit anzuspornen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
