                "translations": [
                    {
                        "translation_id": "db9c144c-cfde-4b99-99df-96426bb07727",
                        "source_entry_id": "bcac5d16-e316-3d90-9f3c-35f0a2ea9ce5",
                        "source_sense_id": "180cf90e-9bc1-3d66-b82b-d0f8f29ad25b",
                        "source_sense_description": "een soort papier zoals waarop de kranten gedrukt worden",
                        "target_lang_word": "Zeitungspapier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitungspapier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "817a2aa6-949b-31a6-9b13-d2997f1a7721",
                                        "entry_id": "7d8f2a86-b430-3f9c-b550-c6f21739725b",
                                        "glosses": [
                                            "Papier, das für den Druck von Zeitungen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebc26c6-bf5f-41ee-b835-fa3c104a3eef",
                                                "sense_id": "817a2aa6-949b-31a6-9b13-d2997f1a7721",
                                                "text": "„Die Spannung steigt und steigt; unter einer trüben Beleuchtung tanzen die Buchstaben und Wörter auf dem dürftigen Zeitungspapier vor meinen Augen wie Irrlichter.“"
                                            },
                                            {
                                                "example_id": "f4e2e18e-db4d-4dad-8cf9-79ef916003c0",
                                                "sense_id": "817a2aa6-949b-31a6-9b13-d2997f1a7721",
                                                "text": "„Und das Zeitungspapier war knapp, zumal es nicht nur fürs Tabaktrocknen oder zum Ausstopfen nassen Schuhwerks gebraucht wurde, sondern – in kleine Rechtecke zerschnitten und auf angespitzte Haken gespießt – auch das Klopapier ersetzen musste.“"
                                            },
                                            {
                                                "example_id": "561cfee2-509e-4fe3-9cda-2ad949e46696",
                                                "sense_id": "817a2aa6-949b-31a6-9b13-d2997f1a7721",
                                                "text": "„Als die Shrimps gar waren, schöpften sie sie mit der Kelle aus dem Kochkessel und legten sie auf Zeitungspapier, schälten sie dann mit der Hand und stippten sie in die mit Worcestershire und Ketchup angemachte Soße.“"
                                            },
                                            {
                                                "example_id": "0c8b6069-f30b-43ed-bf53-a745bd8e37b2",
                                                "sense_id": "817a2aa6-949b-31a6-9b13-d2997f1a7721",
                                                "text": "„Es dauerte länger, als er dachte, aber er hatte Zeitungspapier, um die Stoffetzen zu verbrennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42e226fa-15c7-4dd6-b2db-4f140c04f45a",
