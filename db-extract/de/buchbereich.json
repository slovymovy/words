                "senses": [
                    {
                        "sense_id": "229f5f14-ef8b-3988-b429-4af8239aec24",
                        "entry_id": "b8ca69de-e47e-3378-adce-4fcc425e8d23",
                        "glosses": [
                            "derjenige Teil eines Unternehmens/Marktes, der sich mit gedruckter Lektüre in Buchformat beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "822513b7-9b0f-4371-beed-912d7b499f56",
                                "sense_id": "229f5f14-ef8b-3988-b429-4af8239aec24",
                                "text": "„Der Buchbereich kann sich mit Mini-Bänden und Regionalkochbüchern noch behaupten. In seinem 50. Jubiläumsjahr erscheint der Titel »Wir kochen gut« in 27. Auflage […].“"
                            },
                            {
                                "example_id": "a5139ee3-9b9c-4fb5-acf7-240619cb8246",
                                "sense_id": "229f5f14-ef8b-3988-b429-4af8239aec24",
                                "text": "„Alles was im Buchbereich angesagt ist, ist für uns interessant. Weniger interessant sind Kinofilme und ähnliches, auch wenn wir das auch schon gemacht haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
