                        "glosses": [
                            "The act of reviving; restoration of life."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d84a808-3d16-4239-ae06-2a9548de4de9",
                                "sense_id": "e243ee65-96fd-3c6b-8aea-c4c8f01ed16e",
                                "text": "Fir-cones and snakes from their very forms were emblems of male fertility; snakes, too, from their habit of gliding out of their own skins with renewed brightness and color were suggestive of resurrection and re-vivification; pigs and sows by their exceeding fruitfulness would in their hour of sacrifice remind old mother Earth of what was expected from her!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ffc98804-6de5-321e-bc79-778b0244b695",
                        "entry_id": "191532f0-49a5-3182-9605-935691ab156f",
                        "glosses": [
                            "The reduction of a metal from a state of combination to its metallic state."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2fe423ac-337b-4b18-b4d9-de38b772f748",
                                "sense_id": "ffc98804-6de5-321e-bc79-778b0244b695",
                                "text": "I have often beheld as a miracle, that artificiall resurrection and revivification of Mercury, how being mortified into a thousand shapes, it assumes again its owne, and returns to its numericall selfe."
                            }
                        ]
                    }
