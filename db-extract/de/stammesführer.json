                "senses": [
                    {
                        "sense_id": "242da300-d38f-3445-895a-0a14a6ea082b",
                        "entry_id": "fc943081-7653-38da-a286-eb298769cf8e",
                        "glosses": [
                            "der Anführer eines Stammes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b0da22-0c49-4eaf-8e33-22e7032a8b36",
                                "sense_id": "242da300-d38f-3445-895a-0a14a6ea082b",
                                "text": "Chief Gilbert „Gibby“ Jacob, der Stammesführer der Squamish Nation, ist einer der einflussreichsten Stammesführer unter den First Nations (Ureinwohner) in Kanada."
                            },
                            {
                                "example_id": "0d5f7522-379a-4601-b971-afecff376ada",
                                "sense_id": "242da300-d38f-3445-895a-0a14a6ea082b",
                                "text": "Bei einem Treffen in Kairo haben Stammesführer aus Libyen die Gründung eines Rats zur Förderung von Friedensverhandlungen in ihrer Heimat beschlossen."
                            },
                            {
                                "example_id": "d5e75b8c-7b98-420c-881a-e55794736f27",
                                "sense_id": "242da300-d38f-3445-895a-0a14a6ea082b",
                                "text": "Somit war nicht mehr sicher, ob die Stammesführer umfassend wussten, was sich in ihren Trupps und Sippen abspielte."
                            },
                            {
                                "example_id": "a9fd3408-261d-46c8-ac33-7b5379252d70",
                                "sense_id": "242da300-d38f-3445-895a-0a14a6ea082b",
                                "text": "„Die Stammesführer der Bugti hatten damals der Regierung die Erschließung neuer Gasfelder auf ihrem Territorium verwehrt.“"
                            },
                            {
                                "example_id": "96ed078e-96b6-4708-9f4a-8f8316b1dad1",
                                "sense_id": "242da300-d38f-3445-895a-0a14a6ea082b",
                                "text": "„So betraute er keinen einzigen Stammesführer mit einem wichtigen Regierungsposten, und die tatsächlichen Entscheidungskompetenzen der loya jirga blieben beschränkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
