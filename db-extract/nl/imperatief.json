                                    {
                                        "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Essential; crucial; extremely important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e04abe-83cb-4f4f-b19b-3c90d8ad0510",
                                                "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                                "text": "That you come here right now is imperative."
                                            },
                                            {
                                                "example_id": "b098dacb-a84a-4816-91e2-cab92d21dfca",
                                                "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                                "text": "Meantime, alterations at King William Street had become imperative, and by December 22, 1895, the station had been remodelled, as at Stockwell, to provide an island platform with lines each side, and a scissors crossing."
                                            },
                                            {
                                                "example_id": "5d862352-340c-4e0e-a13e-490d81f4cf8c",
                                                "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                                                "text": "Give this document to Ozzy. It's imperative that he reads and understands it. Got it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2f8a2a-6db1-332e-84de-7f895fe25c49",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Of, or relating to the imperative mood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc78d5f-f124-3277-911f-0756c25271b4",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Having semantics that incorporates mutable variables."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                                        "entry_id": "d57f3c15-b5a9-3a98-b21e-1961d60488d6",
                                        "glosses": [
                                            "Expressing a command; authoritatively or absolutely directive."
                                        ],
