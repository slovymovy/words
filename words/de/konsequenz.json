    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                    "sense_definition": "Logische oder unausweichliche Folge oder Auswirkung einer vorangegangenen Handlung oder Entscheidung.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wer unvorsichtig handelt, muss am Ende auch die <w>Konsequenzen</w> tragen.",
                            "target_lang_translations": {
                                "en": "Whoever acts carelessly must in the end also bear the <w>consequences</w>."
                            }
                        },
                        {
                            "text": "Die Ministerin wollte nach dem Skandal keine persönlichen <w>Konsequenzen</w> ziehen.",
                            "target_lang_translations": {
                                "en": "The minister did not want to take any personal <w>consequences</w> after the scandal."
                            }
                        }
                    ],
                    "synonyms": [
                        "Folge"
                    ],
                    "common_phrases": [
                        "die Konsequenzen tragen",
                        "Konsequenzen ziehen"
                    ],
                    "target_lang_definitions": {
                        "en": "A logical or inevitable result or effect of a preceding action or decision."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consequence",
                                "target_lang_sense_clarification": "result or outcome of an action"
                            },
                            {
                                "target_lang_word": "repercussion",
                                "target_lang_sense_clarification": "negative or far-reaching result"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60e0f5d3-b60f-3870-9893-343501c1ecbb",
                    "sense_definition": "Zielstrebiges, beharrliches und unnachgiebiges Festhalten an einer bestimmten Linie oder Vorgehensweise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er verfolgte seinen Plan von Beginn an mit großer <w>Konsequenz</w>.",
                            "target_lang_translations": {
                                "en": "He pursued his plan with great <w>consistency</w> right from the start."
                            }
                        },
                        {
                            "text": "Der Trainer forderte von der gesamten Mannschaft mehr <w>Konsequenz</w> in der Abwehr.",
                            "target_lang_translations": {
                                "en": "The coach demanded more <w>resoluteness</w> in defence from the entire team."
                            }
                        }
                    ],
                    "antonyms": [
                        "Inkonsequenz"
                    ],
                    "common_phrases": [
                        "mit äußerster Konsequenz"
                    ],
                    "target_lang_definitions": {
                        "en": "Determined, persistent, and unwavering adherence to a particular line of action or principle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consistency",
                                "target_lang_sense_clarification": "steadfast adherence to principles or a course"
                            },
                            {
                                "target_lang_word": "resoluteness",
                                "target_lang_sense_clarification": "unwavering determination and firmness"
                            },
                            {
                                "target_lang_word": "determination",
                                "target_lang_sense_clarification": "firmness of purpose"
                            }
                        ]
                    }
                }
            ]
        }
    ]
