                "senses": [
                    {
                        "sense_id": "60988abf-4c60-3b31-ab0e-a6be4f3b3e10",
                        "entry_id": "b3d2a7bf-2a86-3817-b4f2-d3af37cfb146",
                        "glosses": [
                            "Bereich, in welcher der Check-in beziehungsweise die Anmeldung des Reisegastes erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6147751-b779-4695-a073-f6eba5d7e65b",
                                "sense_id": "60988abf-4c60-3b31-ab0e-a6be4f3b3e10",
                                "text": "Stundenlang standen wir im Check-in-Bereich Schlange."
                            },
                            {
                                "example_id": "ca16983c-733b-43ad-8bdf-26669de4b8fb",
                                "sense_id": "60988abf-4c60-3b31-ab0e-a6be4f3b3e10",
                                "text": "„Am Morgen hatten sich Hunderte Koffer im Check-in-Bereich des Airports ohne ihre Besitzer gestaut, wie ein dpa-Reporter berichtete.“"
                            },
                            {
                                "example_id": "45223209-da9c-45d1-9633-e8aace08dee9",
                                "sense_id": "60988abf-4c60-3b31-ab0e-a6be4f3b3e10",
                                "text": "„Schwer bewaffnete Soldaten des rumänischen Inlandsgeheimdienstes SRI patrouillieren vor dem Gebäude und im Check-in-Bereich.“"
                            },
                            {
                                "example_id": "64cb3bdd-6b69-4ef5-87b7-d7d0ae196343",
                                "sense_id": "60988abf-4c60-3b31-ab0e-a6be4f3b3e10",
                                "text": "„Los geht’s im Check-in-Bereich, in dem sich die Urlaubswilligen zum Start der Reise einfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
