{
    "word_family": [
        "простой",
        "простота",
        "упростить",
        "упрощение"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9fe8949e-baa1-31de-92da-9e8724e003dc",
                    "sense_definition": "Без лишних сложностей, прямо или обыденно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <w>просто</w> хочется нравиться ему.",
                            "target_lang_translations": {
                                "en": "I <w>simply</w> want him to like me."
                            }
                        },
                        {
                            "text": "Они живут <w>просто</w> и скромно.",
                            "target_lang_translations": {
                                "en": "They live <w>simply</w> and modestly."
                            }
                        }
                    ],
                    "synonyms": [
                        "легко"
                    ],
                    "antonyms": [
                        "сложно"
                    ],
                    "common_phrases": [
                        "просто сказать"
                    ],
                    "target_lang_definitions": {
                        "en": "In a straightforward, plain, or unpretentious manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simply",
                                "target_lang_sense_clarification": "Used to describe doing something in a plain or unadorned way."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68082808-6ed0-38ab-a34b-e8e5b38ed5f5",
                    "sense_definition": "Не требуя больших усилий или затрат.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Понять его характер не так <w>просто</w>.",
                            "target_lang_translations": {
                                "en": "Understanding his character is not so <w>easy</w>."
                            }
                        },
                        {
                            "text": "Сделать это <w>просто</w> если знать секрет.",
                            "target_lang_translations": {
                                "en": "It is <w>simple</w> to do if you know the secret."
                            }
                        }
                    ],
                    "synonyms": [
                        "легко",
                        "несложно"
                    ],
                    "antonyms": [
                        "трудно",
                        "сложно"
                    ],
                    "common_phrases": [
                        "не так просто"
                    ],
                    "target_lang_definitions": {
                        "en": "Without requiring much effort, difficulty, or expense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easy",
                                "target_lang_sense_clarification": "Used to indicate that a task or situation is not difficult."
                            },
                            {
                                "target_lang_word": "simple",
                                "target_lang_sense_clarification": "Used to indicate that something is uncomplicated or easy to do."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12498d7a-27e5-3179-b073-84197140c9fa",
                    "sense_definition": "Используется для эмоционального усиления высказывания.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>просто</w> прелесть!",
                            "target_lang_translations": {
                                "en": "She is <w>simply</w> delightful!"
                            }
                        },
                        {
                            "text": "Этот фильм <w>просто</w> невероятный.",
                            "target_lang_translations": {
                                "en": "This movie is <w>simply</w> incredible."
                            }
                        }
                    ],
                    "common_phrases": [
                        "просто прелесть"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize a statement or express strong feeling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simply",
                                "target_lang_sense_clarification": "Used as an intensifier to express that something is absolutely or truly a certain way."
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "Used to emphasize the quality or nature of something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eb6a03a-be97-3c3f-b23e-61f6a65e6cf4",
                    "sense_definition": "Указывает на то, что действие является единственным или основным мотивом, не более того.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>просто</w> струсил в тот момент.",
                            "target_lang_translations": {
                                "en": "He <w>just</w> got scared at that moment."
                            }
                        },
                        {
                            "text": "Сообщники <w>просто</w> хотели избавиться от него.",
                            "target_lang_translations": {
                                "en": "The accomplices <w>just</w> wanted to get rid of him."
                            }
                        }
                    ],
                    "common_phrases": [
                        "просто хотел"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that an action is the sole or primary motive, nothing more."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "Used to mean 'merely' or 'only' when describing a motive."
                            },
                            {
                                "target_lang_word": "simply",
                                "target_lang_sense_clarification": "Used to mean 'merely' or 'only' when explaining the reason for an action."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba831358-31e9-3a21-b054-2a882207cf8a",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>простой</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это решение было <w>просто</w>.",
                            "target_lang_translations": {
                                "en": "This solution was <w>simple</w>."
                            }
                        },
                        {
                            "text": "Задание оказалось <w>просто</w>.",
                            "target_lang_translations": {
                                "en": "The task turned out to be <w>easy</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the neuter adjective 'simple'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simple",
                                "target_lang_sense_clarification": "Used as a predicate to describe a situation or solution as uncomplicated."
                            },
                            {
                                "target_lang_word": "easy",
                                "target_lang_sense_clarification": "Used as a predicate to describe a task or solution as not difficult."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}