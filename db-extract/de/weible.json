                ],
                "senses": [
                    {
                        "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                        "entry_id": "bf1666c3-02ce-30d3-acf7-607f50dca5cf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea950c62-2afc-4dd2-a921-8ccdc92e47e8",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Frau Weible ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8e22658a-9408-4d4f-915a-743edb8af69d",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Herr Weible wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "63920ca0-a9d4-46ae-8097-e7372ea4ea98",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Die Weibles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6e521c3e-6414-480d-a288-847d8c1cd67b",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Der Weible trägt nie die Schals, die die Weible ihm strickt."
                            },
                            {
                                "example_id": "55aa78f1-5cdb-420f-9f75-5b57ee5cc785",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weible kommt, geht der Herr Weible.“"
                            },
                            {
                                "example_id": "341dfa02-6ea2-4f49-b2a4-4a427d78f42a",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Weible kommt und geht."
                            },
                            {
                                "example_id": "a4428cdf-96b3-4909-b69d-7e8648e5a94d",
                                "sense_id": "a4ec4243-45d6-367e-9f46-58329a20ed45",
                                "text": "Weibles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
