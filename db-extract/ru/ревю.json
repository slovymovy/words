                                        "entry_id": "f82e3fd5-dc76-3533-897c-d6878cb37855",
                                        "glosses": [
                                            "Participe passé féminin singulier de revoir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f8ae2a6-1684-4b80-990c-40e12bd6865a",
                                                "sense_id": "db1ac0c3-ad93-38b2-952f-c9093ab47e01",
                                                "text": "Sagittaria ne fut plus revue pendant le long espace de cent soixante ans."
                                            }
                                        ]
                                    }
