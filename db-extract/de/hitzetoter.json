                "senses": [
                    {
                        "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                        "entry_id": "2d5539cb-7798-358d-bd39-e950f1390d67",
                        "glosses": [
                            "Person, die infolge andauernd hoher Temperaturen (= Hitze) stirbt; Zahl der hitzebedingten Sterbefälle"
                        ],
                        "tags": [
                            "Gebrauch aber meist im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "087b3160-fae5-4946-92ca-cde0262c437e",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "Hitzetote kann man durch die Übersterblichkeit statistisch nachweisen, aber es selten möglich zu sagen: Diese Person hier ist ein Hitzetoter."
                            },
                            {
                                "example_id": "994a50a0-918c-44c1-9283-413f7b3eb47e",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Alexandra Schneider hebt hervor, dass die meisten Hitzetoten und Hitzefolgen noch immer von Ärzten nicht erkannt werden.“"
                            },
                            {
                                "example_id": "2ec2911a-8b0e-4ab5-a135-35244f04f259",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "[Schlagzeile:] „Studie des Robert-Koch-Instituts – Fast 500 Hitzetote in Berlin im vergangenen Jahr“"
                            },
                            {
                                "example_id": "37f69b6d-190e-4497-9b81-d8e3e4e2fe9b",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "[Schlagzeile:] „Klimaforscherin über Umgang mit Hitze – »Mehr Hitzetote als Verkehrstote«“"
                            },
                            {
                                "example_id": "f98eb44b-caf7-4cb5-bbc4-c106b5877ca4",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Allein in diesem Sommer hat es Tausende Hitzetote in Deutschland gegeben.“"
                            },
                            {
                                "example_id": "aa5a9394-2306-4a84-a89c-f51db35bfa89",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Da Hitze nur in seltenen Fällen als direkte Todesursache benannt wird, nahmen die Experten statistische Modelle zu Hilfe, um die Zahl der Hitzetoten abzuschätzen: Demnach gab es 2018 - dem zweitwärmsten Sommer seit Beginn der Aufzeichnungen im Jahr 1881 - etwa 8700 davon.“"
                            },
                            {
                                "example_id": "a65e9b78-f979-4d4a-be5d-3f0ebe628d3e",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Eine im Mai in der Zeitschrift Nature Climate Change veröffentlichte Studie fand heraus, dass einer von drei Hitzetoten während der warmen Jahreszeiten seit 1991 auf den Klimawandel zurückzuführen ist.“"
                            },
                            {
                                "example_id": "b1d02dd3-4fc1-446e-88ba-bc46a6f83626",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Aber auch in der Schweiz sind die Hitzerisiken ein Problem: Die Klimaerwärmung ist für 30 Prozent der Hitzetoten verantwortlich.“"
                            },
                            {
                                "example_id": "3d84d98d-7e1f-45b9-9e7c-17db53f87e99",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Die WHO rechnet aufgrund der Klimaentwicklung ab 2030 mit 250.000 Hitzetoten pro Jahr.“"
                            },
                            {
                                "example_id": "78d6e8d2-9e5c-486b-b06f-128010e9b076",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Weiter südlich, in den US-Bundesstaaten Washington und Oregon, herrschen ebenfalls rekordverdächtige Temperaturen. In Oregon stieg die Zahl der Hitzetoten auf 94.“"
                            },
                            {
                                "example_id": "c1d74b1e-8b96-4208-beba-c7d2e5f7b03b",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Immer wieder gibt es Meldungen über Hitzetote in Indien - gerade im Norden um Neu-Delhi und im Bundesstaat Rajastan.“"
                            },
                            {
                                "example_id": "5224c175-b62a-4643-83d2-aecce9b53188",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Die Hitzewelle in Indien und Pakistan dauert an. Temperaturen deutlich über 40 Grad und hohe Luftfeuchtigkeit bringen die Menschen an ihre Belastungsgrenze. 25 Hitzetote wurden bisher offiziell gemeldet.“"
                            },
                            {
                                "example_id": "5189188d-593b-446b-84f1-0ee329a93e02",
                                "sense_id": "1ce79bc2-63fe-3d36-aa73-89fe762bb0d8",
                                "text": "„Zwei Hitzetote gab es in Spanien: Ein 17 Jahre alter Landarbeiter sei am Donnerstag nach einem Hitzschlag bei der Ernte in der Provinz Córdoba im Süden gestorben, teilten die Gesundheitsbehörden der Region Andalusien am Freitag mit. In Valladolid nordwestlich von Madrid erlag ein 93 Jahre alter Mann bei einem Spaziergang einem Hitzschlag, wie die Polizei mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
