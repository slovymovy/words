                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46b27f5-38cd-43c3-b0d7-5878afa3099d",
                                "sense_id": "52af2c79-85bc-352a-b7e4-9f57572c00ec",
                                "text": "The Town Mouse came, and they sat down to a dinner of barleycorns and roots, the latter of which had a distinctly earthy flavour."
                            }
                        ]
                    },
                    {
                        "sense_id": "56a932f9-83b6-3e96-a8e0-18e1b058bb0e",
                        "entry_id": "a6656270-85d3-32ce-bfed-5f73e20cd565",
                        "glosses": [
                            "The length of such a grain; a unit of length of approximately one third (or sometimes one quarter) of an inch or eight millimetres, still used as a basis for shoe sizes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9e73bb6f-20c0-4ea8-ab5e-315c8f2c3d39",
                                "sense_id": "56a932f9-83b6-3e96-a8e0-18e1b058bb0e",
                                "text": "This trip to Italy has actually enlarged the diameter of my head thirteen barleycorns!"
                            },
                            {
                                "example_id": "f7616e2c-5000-4f9e-a5a7-c463872504e8",
                                "sense_id": "56a932f9-83b6-3e96-a8e0-18e1b058bb0e",
                                "text": "Then shewed the devil the booke unto the friar, and the friar saw it was an uncut unique of incalculable value; the height of it was half a cubit and the breadth of it the fourth part of a cubit and the thickness of it five barleycorns lacking the space of three horsehairs."
                            }
                        ]
                    },
                    {
                        "sense_id": "57c1b135-11e3-396d-82d5-1bdcfdc5fa65",
                        "entry_id": "a6656270-85d3-32ce-bfed-5f73e20cd565",
                        "glosses": [
                            "A small groove between two moldings."
                        ],
