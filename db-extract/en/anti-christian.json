                                        "entry_id": "7c240bd0-efde-3edb-b95e-3738d966d785",
                                        "glosses": [
                                            "Qui est opposé à la religion chrétienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35262b21-f5a8-4069-ac27-0cdaf7d73028",
                                                "sense_id": "bb0bb40c-7218-3ddc-acd0-ca7673ef77d4",
                                                "text": "Nous donnons le nom d’apostasie privée à la renonciation complète qu'un homme fait de sa religion , soit dans son cœur seulement, soit même au dehors par des discours, sans s'associer publiquement à une religion antichrétienne."
                                            },
                                            {
                                                "example_id": "33f862ea-c10c-42af-8db7-ab60b2dd6914",
                                                "sense_id": "bb0bb40c-7218-3ddc-acd0-ca7673ef77d4",
                                                "text": "Ce siècle a enfanté quelques auteurs qui ont produit un athéisme se voulant radical et entier, et ceci dans un contexte toujours plus virulemment antichrétien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antichrétien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43bc32c9-334b-3054-9c1a-cb09f75832e3",
                                        "entry_id": "b3516e2e-5fa7-397e-8dc2-9d3689c70313",
                                        "glosses": [
                                            "Celui qui est est opposé à la religion chrétienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1043a31-0e2e-4d2e-a8fa-69a2386fa54f",
                                                "sense_id": "43bc32c9-334b-3054-9c1a-cb09f75832e3",
                                                "text": "On a voulu voir en Faust un antichrétien, du fait de son pacte diabolique, de sa révolte contre l’ordre divin, de son abandon aux sens."
                                            },
                                            {
                                                "example_id": "37f5d362-b290-497b-970c-6ef8206f26dc",
                                                "sense_id": "43bc32c9-334b-3054-9c1a-cb09f75832e3",
                                                "text": "Ce n’est pas l’Évangile qui est cause de notre désobéissance, mais bien les antichrétiens, qui, souillés par le diable sont sourds à la parole de Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
