                        "glosses": [
                            "Tout mot issu d'un nom propre."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "f733fcd3-589e-41ef-aa79-58e074d6859c",
                                "sense_id": "a93e39a8-e7f6-372f-a687-29b20685401b",
                                "text": "L’onomastisme rabelaisien est formé à partir du nom de Rabelais."
                            },
                            {
                                "example_id": "bba7bc3c-b662-46a0-9d76-3310fe511867",
                                "sense_id": "a93e39a8-e7f6-372f-a687-29b20685401b",
                                "text": "Le gentilé Parisien est un onomastisme."
                            },
                            {
                                "example_id": "311a7f0d-8fa3-4d66-8f39-62db781d50ac",
                                "sense_id": "a93e39a8-e7f6-372f-a687-29b20685401b",
                                "text": "Il y a quelques années, l’un de nous écrivait que la linguistique n’avait pas encore trouvé de terme satisfaisant pour désigner les différents types de dérivés et de composés issus des noms propres (voir Boulanger 1986 : 86). À cette occasion, le néologisme onomastisme était proposé pour combler cette lacune lexicale."
                            },
                            {
                                "example_id": "edbe0e70-df1e-4079-b975-fd338a7d2780",
                                "sense_id": "a93e39a8-e7f6-372f-a687-29b20685401b",
                                "text": "Ces onomastismes (mots dérivés de noms propres) font partie intégrante du français québécois, leur adoubement lexicographique étant assuré depuis 1992 par le Dictionnaire québécois d’aujourd’hui (DQA), qui les consigne dans une liste annexe."
                            }
                        ]
                    }
