                        ],
                        "examples": [
                            {
                                "example_id": "e3412d9e-f153-41a5-af11-f6724ae76251",
                                "sense_id": "73b7290b-60af-32ff-ac70-e19932d38b1f",
                                "text": "Ce territoire est ainsi comme affermé à des pachas, qui sous-afferment, à leur tour, ses subdivisions à d'autres employés, tels que les mutzelins, qaïmaqans, agas, et jusqu'aux deli- bachis."
                            },
                            {
                                "example_id": "2700a2b8-9aa5-46d1-aaec-1d0e6ccdfc9d",
                                "sense_id": "73b7290b-60af-32ff-ac70-e19932d38b1f",
                                "text": "Le mutzelin de Naplouse, Soleïman-Abdalassi, une des créatures de Méhémet-Ali, gouverne toute la Samarie, comme l'émir Beschir gouverne le Liban : à titre de fermage."
                            }
                        ]
                    }
