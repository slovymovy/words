                    {
                        "sense_id": "8843087f-a59b-30b8-81ee-1b3e7dbb8af3",
                        "entry_id": "064bca87-6684-3baf-99eb-6b9d5d87021f",
                        "glosses": [
                            "Beau, gracieux, élégant."
                        ],
                        "tags": [
                            "literary",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b3725372-6e1a-4aae-b26e-ce8e46f93e23",
                                "sense_id": "8843087f-a59b-30b8-81ee-1b3e7dbb8af3",
                                "text": "Il aimait la souffrance […] : sa colère poursuivit tout ce qui est beau, vénuste et joyeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "394c3858-aff9-3962-b971-4df4eabdefb3",
                        "entry_id": "064bca87-6684-3baf-99eb-6b9d5d87021f",
                        "glosses": [
                            "Destiné à l’amour, dédié à Vénus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "688ea910-13ec-4f31-b68f-0c1d8cd90429",
                                "sense_id": "394c3858-aff9-3962-b971-4df4eabdefb3",
                                "text": "Le cadre prêtait aux rêveries audacieuses, dans son romantisme. Les pavillons de chasse sont vénustes, essentiellement, et nul n’en ignore."
                            },
                            {
                                "example_id": "96ec9cb9-4787-4128-b0af-3834bfd3219e",
                                "sense_id": "394c3858-aff9-3962-b971-4df4eabdefb3",
                                "text": "C'est une laide de Boucher\nSans poudre dans sa chevelure\nFollement blonde et d'une allure\nVénuste à tous nous débaucher."
                            }
                        ]
                    }
                ],
