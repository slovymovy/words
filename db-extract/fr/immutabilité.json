                ],
                "senses": [
                    {
                        "sense_id": "4ad4ac66-8bc3-3ab0-a90d-9495c00b064b",
                        "entry_id": "d8e44bc0-f4c7-366a-9dc5-809ab2fc4ab8",
                        "glosses": [
                            "Caractère de ce qui est immuable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2d1f5d-5ff9-4930-b00f-e5ef31f9af9e",
                                "sense_id": "4ad4ac66-8bc3-3ab0-a90d-9495c00b064b",
                                "text": "Ainsi Descartes, dès le commencement, établit l'unité et immutabilité de Dieu ; mais il lui arrive ensuite de regarder son action comme constante et continue."
                            },
                            {
                                "example_id": "88f8d280-ebf2-4bd2-a9af-159170323971",
                                "sense_id": "4ad4ac66-8bc3-3ab0-a90d-9495c00b064b",
                                "text": "C'est précisément la question de l’immutabilité des petites espèces qui va occuper, vers 1885, un botaniste hollandais de grand mérite, Hugo de Vries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42877058-a4ec-4c80-9e3f-231a764ef201",
                        "source_entry_id": "d8e44bc0-f4c7-366a-9dc5-809ab2fc4ab8",
                        "source_sense_id": "4ad4ac66-8bc3-3ab0-a90d-9495c00b064b",
                        "target_lang_word": "immutability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immutability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c24b772c-ad2f-32aa-b74d-2732bafb1e5e",
                                        "entry_id": "7e170d9a-1526-3c33-bf28-f0fee1628c15",
                                        "glosses": [
                                            "The state or quality of being immutable; immutableness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10227dee-ffc7-465a-9cff-72843adb25dc",
                                                "sense_id": "c24b772c-ad2f-32aa-b74d-2732bafb1e5e",
                                                "text": "But, one might ask, how can the temporal event of God in our midst be the same as God's event to himself in his eternity if so absolute a distinction is drawn between the enarrable contents of history and the \"eternal dynamism\" of God's immutability, apatheia, and perfect fullness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a27f4d0-dd9e-3dea-945c-ad34d0cfba2c",
                                        "entry_id": "7e170d9a-1526-3c33-bf28-f0fee1628c15",
                                        "glosses": [
                                            "The state of being unchangeable in the memory after creation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
