                "senses": [
                    {
                        "sense_id": "f63476bf-d5cd-3d62-bbf0-1578c7368126",
                        "entry_id": "3cd01f69-53c1-3246-afb9-45331cf1977a",
                        "glosses": [
                            "Gebiet zwischen dem aktuellen Gletscherrand und den Moränen, die den letzten Höchststand markieren (in den Alpen meist um 1850)"
                        ],
                        "tags": [
                            "Glaziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "95c910d8-57b4-455f-aeb4-3e6120172179",
                                "sense_id": "f63476bf-d5cd-3d62-bbf0-1578c7368126",
                                "text": "„Mit dem Rückgang des Gletschers ist das Gletschervorfeld gewachsen.“"
                            },
                            {
                                "example_id": "f8b6c68a-78ed-4382-a0a1-03ed07ae2879",
                                "sense_id": "f63476bf-d5cd-3d62-bbf0-1578c7368126",
                                "text": "„Im Gletschervorfeld ist in den letzten Jahren ein See entstanden.“"
                            },
                            {
                                "example_id": "429fb565-6099-4e2d-a60b-9a11368fba05",
                                "sense_id": "f63476bf-d5cd-3d62-bbf0-1578c7368126",
                                "text": "Das Gletschervorfeld ist erst seit wenigen Jahren von Pionierpflanzen besiedelt."
                            },
                            {
                                "example_id": "03a2a603-b291-4052-9042-a500b1c81d0f",
                                "sense_id": "f63476bf-d5cd-3d62-bbf0-1578c7368126",
                                "text": "Am Rand des Gletschervorfeldes sind die ehemaligen Seitenmoränen streckenweise noch sichtbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
