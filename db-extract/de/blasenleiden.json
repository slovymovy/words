                        "examples": [
                            {
                                "example_id": "8b0b8a4a-297e-4f92-9572-5e561c3ba7e5",
                                "sense_id": "2f00ffb0-40e7-397e-ab31-187f7ab1f4cf",
                                "text": "„Ausgerechnet in Borodino, der Schlacht aller Schlachten, war L’Empereur wegen eines Blasenleidens unpässlich.“"
                            },
                            {
                                "example_id": "f3e93a2e-ba0f-404b-b201-d9183d89aa68",
                                "sense_id": "2f00ffb0-40e7-397e-ab31-187f7ab1f4cf",
                                "text": "„St. Blasius beispielsweise, ebenfalls einer der Volksheiligen, wurde bei vielen körperlichen Leiden im Gebet konsultiert, vom Zahnweh bis zur Pest, bei Blutungen und Blasenleiden.“"
                            }
                        ],
