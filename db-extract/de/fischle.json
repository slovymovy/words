                ],
                "senses": [
                    {
                        "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                        "entry_id": "4454cd72-3ea9-32ee-91d2-84ca73378809",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157de214-8111-4e35-850f-9d18a4ba3ba6",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Frau Fischle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f37899a0-c934-45be-bd4f-98a2abe390af",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Herr Fischle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aa16edd8-9b64-4cdf-90d3-df9882410a6f",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Die Fischles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "38f2b2d4-9b63-4452-b18a-298cbec83d8c",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Der Fischle trägt nie die Pullover, die die Fischle ihm strickt."
                            },
                            {
                                "example_id": "3eef7206-e5d4-45aa-94c0-c97fdba8b443",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fischle kommt, geht der Herr Fischle.“"
                            },
                            {
                                "example_id": "a064c861-ecf4-41f9-956e-beec3c1c114f",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Fischle kommt und geht."
                            },
                            {
                                "example_id": "bc12b878-38a8-458e-845f-4dc9665505d1",
                                "sense_id": "59bc2d75-4985-3c33-bd59-9487ffda0bc0",
                                "text": "Fischles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
