                    "sense_definition": "De melodie of de toon van een lied of muziekstuk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zong het oude volkslied op een vrolijke <w>wijze</w>.",
                            "target_lang_translations": {
                                "en": "She sang the old folk song to a cheerful <w>tune</w>.",
                                "ru": "Она спела старый народный гимн на веселый <w>мотив</w>."
                            }
                        },
                        {
                            "text": "De muzikant speelde een bekende <w>wijze</w> op zijn viool.",
                            "target_lang_translations": {
                                "en": "The musician played a well-known <w>melody</w> on his violin.",
                                "ru": "Музыкант исполнил известную <w>мелодию</w> на своей скрипке."
                            }
