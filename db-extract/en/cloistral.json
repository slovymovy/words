    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                "word": "cloistral",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ddcdfd77-f97f-4db8-a2fe-25d77cacdbea",
                        "entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more cloistral"
                    },
                    {
                        "form_id": "b64c878d-3a41-4ddb-87da-4c1e9025e7f6",
                        "entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most cloistral"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9f52bfb-590a-3d1d-b8e4-16ca570e9c88",
                        "entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "glosses": [
                            "Of, pertaining to, resembling or living in a cloister."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4202a36f-8e57-48f2-8ede-cbe2c5c49a29",
                                "sense_id": "d9f52bfb-590a-3d1d-b8e4-16ca570e9c88",
                                "text": "1606, Samuel Daniel, The Queen’s Arcadia, in The Poetical Works of Mr. Samuel Daniel, London: R. Gosling, 1717, The Epistle, pp. 151-152,\n… it is in that Kind [of Words], as best accords\nWith rural Passions, which use not to reach\nBeyond the Groves, and Woods, where they were bred\nAnd best become a Cloistral Exercise,\nWhere Men shut out retir’d, and sequestred\nFrom publick Fashion, seem to sympathize\nWith innocent and plain Simplicity:"
                            },
                            {
                                "example_id": "022ba8fa-d487-4c77-9b26-346181692b85",
                                "sense_id": "d9f52bfb-590a-3d1d-b8e4-16ca570e9c88",
                                "text": "As to the marriage of the friars in this cloystral house, their founder, Ivon, in my opinion, was quite right in this notion."
                            },
                            {
                                "example_id": "64867baf-46ec-4932-8794-bd6fadddc19e",
                                "sense_id": "d9f52bfb-590a-3d1d-b8e4-16ca570e9c88",
                                "text": "Coming straight from the convent, she had gone in behind the high walls of the manor-house that was almost more cloistral than any convent could have been."
                            },
                            {
                                "example_id": "1727fefe-6fbf-45a6-8600-5a27eff7cee0",
                                "sense_id": "d9f52bfb-590a-3d1d-b8e4-16ca570e9c88",
                                "text": "[T]he three men followed, rushing into the hall, pausing, bringing with them into its stale and cloistral dimness something of the savage summer sunlight which they had just left."
                            }
                        ]
                    },
                    {
                        "sense_id": "82c9be27-96df-3695-9d25-e47f371c57ef",
                        "entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "glosses": [
                            "Sheltered from the world; monastic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33a55d6-709d-45fb-8bba-2c3d76e848b0",
                                "sense_id": "82c9be27-96df-3695-9d25-e47f371c57ef",
                                "text": "Speak not! he is consecrated— / Breathe no breath across his eyes: / Lifted up and separated / On the hand of God he lies, / In a sweetness beyond touching,—held in cloistral sanctities."
                            },
                            {
                                "example_id": "884443d5-7558-4a36-bcae-52f3b28f30b6",
                                "sense_id": "82c9be27-96df-3695-9d25-e47f371c57ef",
                                "text": "[H]owever cloistral our elementary schools may be, sheltering the eternal flame of the high ideal of human existence, Jimmy Shepherd, aged twelve, and Nancy Shepherd, aged thirteen, know very well that the eternal flame of the high ideal is all my-eye."
                            }
                        ]
                    },
                    {
                        "sense_id": "5357884a-d48a-306f-8812-a9475f12cb3c",
                        "entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "glosses": [
                            "Secluded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a937818b-376f-4b5d-b932-cb8a2c763066",
                                "sense_id": "5357884a-d48a-306f-8812-a9475f12cb3c",
                                "text": "[C]loistral avenues, / Where silence dwells if music be not there: […]"
                            },
                            {
                                "example_id": "6c656749-8aac-41c4-a83d-fddb23d8efdc",
                                "sense_id": "5357884a-d48a-306f-8812-a9475f12cb3c",
                                "text": "Then, responsive to the bird’s insistence, / From the margin of some cloistral shore / Came a murmur up the hollow distance, / “On the morrow will I ope the door!”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cdb89a0-6683-45e7-8bca-eadef21fd1a2",
                        "source_entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "source_sense_description": "of, pertaining to, or living in a cloister",
                        "target_lang_word": "klášterní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klášterní",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d67efd13-6c77-3868-9914-f16ba380e7d4",
                                        "entry_id": "3f8ee686-4ba3-3ec6-bbb3-41b427b69de1",
                                        "glosses": [
                                            "související s klášterem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951a5692-7a14-46a5-ac2a-e082b8d67bdf",
                                                "sense_id": "d67efd13-6c77-3868-9914-f16ba380e7d4",
                                                "text": "Po smrti manžele svého přijala opět roucho klášterní a vstoupila roku 1302 do řádu Benediktinek kláštera sv. Jiří na hradě pražském,..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28a9c4f7-6b73-4ed0-a37c-40078396edcd",
                        "source_entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "source_sense_description": "of, pertaining to, or living in a cloister",
                        "target_lang_word": "claustral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claustral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfdb8365-75ee-3e85-b9a9-6d4031e4e1de",
                                        "entry_id": "6312e699-570e-3136-a68c-e9569009f620",
                                        "glosses": [
                                            "Relatif au cloître ou monastère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0488ad31-481b-4a5f-a394-e67b6c039fd8",
                                                "sense_id": "bfdb8365-75ee-3e85-b9a9-6d4031e4e1de",
                                                "text": "Les revenus seront distribués par le prieur claustral entre les chanoines claustraux. Le chapitre de 1413, 13 janvier, réuni à Thonon ratifie cette dotation."
                                            },
                                            {
                                                "example_id": "f59ca560-b72c-4d62-b134-3faeaff3a21f",
                                                "sense_id": "bfdb8365-75ee-3e85-b9a9-6d4031e4e1de",
                                                "text": "Cette activité était à l’époque tout ce qu’il a de plus novatrice, car les couvents dits actifs, aux mariages simples et sans limite claustrale stricte, n’en étaient qu’au début de leur histoire."
                                            },
                                            {
                                                "example_id": "fe63c098-8213-4b0a-830f-c971ae384e10",
                                                "sense_id": "bfdb8365-75ee-3e85-b9a9-6d4031e4e1de",
                                                "text": "Incapables d’accorder leurs idées claustrales avec les difficultés de la vie, et ne comprenant même pas leur situation, … ."
                                            },
                                            {
                                                "example_id": "3070a925-9646-486f-b1ec-67306b088416",
                                                "sense_id": "bfdb8365-75ee-3e85-b9a9-6d4031e4e1de",
                                                "text": "Élevée par les soins du général dans une retraite presque claustrale, elle ne l’avait quittée que pour le suivre dans le voyage qu’il avait entrepris dans les prairies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "claustral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b732eb7-0119-3e4f-8228-ac3c13106648",
                                        "entry_id": "dbd8844f-fb5f-3ff5-8e4f-83de61301089",
                                        "glosses": [
                                            "Personne qui est au cloitre, au monastère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a99148c6-a6a7-4fc8-90e6-795c4fdbf6cf",
                                                "sense_id": "3b732eb7-0119-3e4f-8228-ac3c13106648",
                                                "text": "Reconnaissances par les feudataires des seigneurs de Daillens en faveur des claustraux de Mont-Joux.\nLes claustraux ont encore la moitié d’un cens du moulin sur l’Aubonne et un four à Bière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76c598c0-ca0b-4082-8d57-acd948f2858d",
                        "source_entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "source_sense_description": "of, pertaining to, or living in a cloister",
                        "target_lang_word": "klösterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klösterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                        "entry_id": "383df975-eee1-374a-9370-a78baa7ada6c",
                                        "glosses": [
                                            "auf das Leben in einem Kloster bezogen; der Lebensweise von Mönchen/Nonnen entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c82160-8799-4fc5-8293-26edfddea88d",
                                                "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                                "text": "Das unscheinbare Haus war sein [Samuel Becketts] Refugium. Hier schrieb er in klösterlicher Abgeschiedenheit, während er weniger klösterlich zum Whiskey griff …."
                                            },
                                            {
                                                "example_id": "f80a8506-2a98-4a31-b951-8e2da54bcb65",
                                                "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                                "text": "In beiden Büchern auch wird das Heil einer klösterlich weltenthobenen Männergemeinschaft gepriesen."
                                            },
                                            {
                                                "example_id": "d967bd3c-2a03-4f43-ba99-968d5419662f",
                                                "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                                "text": "Deshalb hat Marie-Therese Cramer das Ensemble in aufwendige historische Kostüme gesteckt, das Bühnenbild aber klösterlich, geradezu spartanisch einfach gehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "801ebb79-961f-3af5-bec7-e8bbf97eb0fc",
                                        "entry_id": "383df975-eee1-374a-9370-a78baa7ada6c",
                                        "glosses": [
                                            "zu einem Kloster gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55792b1a-a673-4b90-a210-d9d10b3cd636",
                                                "sense_id": "801ebb79-961f-3af5-bec7-e8bbf97eb0fc",
                                                "text": "Klösterliche Wirtschaftsbetriebe stehen im Wettbewerb wie jedes andere Unternehmen, egal ob wir von Brauereien, Gemüseversorgern oder Zimmervermietungen mit spiritueller Sinnsuche reden."
                                            },
                                            {
                                                "example_id": "0956b1b0-bf6c-453b-9d82-abc9cf6ae57d",
                                                "sense_id": "801ebb79-961f-3af5-bec7-e8bbf97eb0fc",
                                                "text": "Černošice blieb bis zur Auflösung des Klosters im Zuge der Josephinischen Reformen im Jahre 1785 klösterlicher Besitz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
