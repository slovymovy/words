                    {
                        "translation_id": "080371b0-ff0c-4d46-b38e-054799158769",
                        "source_entry_id": "eaff224a-cf03-3376-9b49-19bc14938c41",
                        "source_sense_id": "ee559d02-dc5b-3ba5-953d-343ca9e1e0d2",
                        "source_sense_description": "keukenkruid",
                        "target_lang_word": "chervil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chervil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c15510-7297-3825-b39c-2d4630db4748",
                                        "entry_id": "7012b154-f3b5-3993-a1d1-7768f9d81013",
                                        "glosses": [
                                            "A leafy herb, Anthriscus cerefolium, resembling parsley."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b65ec751-90e4-4bd4-8bb1-3e877a11b34f",
                                                "sense_id": "66c15510-7297-3825-b39c-2d4630db4748",
                                                "text": "The life of one plant would be affected by another. Rue was definitely hostile to basil, rosemary to hyssop, but coriander, dill and chervil lived on the friendliest of terms[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ace4594-4ac9-3fa8-9d42-6a6a92ee18e9",
                                        "entry_id": "7012b154-f3b5-3993-a1d1-7768f9d81013",
                                        "glosses": [
                                            "Leaves from the plant, used as an herb in cooking, which have a mild flavor of anise."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68cfb8b-b84e-4ae0-bc90-f5f1b35de37c",
                                                "sense_id": "5ace4594-4ac9-3fa8-9d42-6a6a92ee18e9",
                                                "text": "No herb, except perhaps tarragon, is quite so French as chervil, an association that is not surprising for a nation known for its celebration of fine food and the subtle use of herbs."
                                            },
                                            {
                                                "example_id": "c09327a4-194b-4f10-81d7-60ebbc059b6c",
                                                "sense_id": "5ace4594-4ac9-3fa8-9d42-6a6a92ee18e9",
                                                "text": "Cook fresh chervil leaves very little, if at all. They are best when added to a dish after it has been cooked, or toward the end of the cooking time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
