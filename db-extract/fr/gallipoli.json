                        "sense_id": "ae9a6e53-f768-3811-b63a-fa501232b08b",
                        "entry_id": "7c174975-63a3-3845-ac5f-f324e1fbf6ce",
                        "glosses": [
                            "Commune d’Italie de la province de Lecce dans la région des Pouilles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ebed7440-29e0-3825-bb74-a056e9c8c6f4",
                        "entry_id": "7c174975-63a3-3845-ac5f-f324e1fbf6ce",
                        "glosses": [
                            "Autre nom de Gelibolu, ville turque située près du détroit des Dardanelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117b52b7-6989-493a-ae33-f9e508ac2168",
                                "sense_id": "ebed7440-29e0-3825-bb74-a056e9c8c6f4",
                                "text": "La bataille de Gallipoli."
                            },
                            {
                                "example_id": "a2ae594f-e01c-4dc2-982c-69aaa0a93125",
                                "sense_id": "ebed7440-29e0-3825-bb74-a056e9c8c6f4",
                                "text": "À Paris, où il venait se faire soigner d’un reste de malaria, j’ai assez souvent vu en 1916 cet homme sombre et trapu, d’apparence froide, ou plutôt fermée, qui racontait d’un ton de voix égal les horreurs de Gallipoli."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b57f6c3-d753-3025-9eed-7edf36a92627",
                        "entry_id": "7c174975-63a3-3845-ac5f-f324e1fbf6ce",
                        "glosses": [
                            "Péninsule turque où se situe Gelibolu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f3a243-89ca-4bd1-a7a4-b7f09cfa4125",
                                "sense_id": "1b57f6c3-d753-3025-9eed-7edf36a92627",
                                "text": "En 1915, des troupes alliées débarquaient dans la péninsule de Gallipoli, point de départ d’une campagne malheureuse destinée à arracher le détroit des Dardanelles au contrôle de l’Empire ottoman."
                            }
                        ]
                    }
                ],
