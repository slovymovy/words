                                    {
                                        "sense_id": "c7eaa3e9-8f3e-3ad8-933c-8bf99d90bdd0",
                                        "entry_id": "6be668b7-fb1c-3175-a342-fd47b43bbebf",
                                        "glosses": [
                                            "ziarno owsa (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df26c14b-2ee1-4bde-a22d-c42fa6f3de1d",
                                                "sense_id": "c7eaa3e9-8f3e-3ad8-933c-8bf99d90bdd0",
                                                "text": "Mleko owsiane zwykle robi się z owsa, wody i oleju słonecznikowego, ale można je też wzbogacić wapniem, wanilią i witaminami."
                                            }
                                        ],
