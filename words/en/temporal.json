                    "frequency": "Middle",
                    "semantic_group_id": "secular",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king exercised <w>temporal</w> power over his subjects, while the church handled their spiritual needs.",
                            "target_lang_translations": {
