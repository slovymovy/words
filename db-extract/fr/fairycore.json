        "fr-extract.jsonl": [
            {
                "entry_id": "241dcbcb-936e-385a-97a4-1b3932e3de37",
                "word": "fairycore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e23a031-2aaf-3591-ba92-bdecb2589fca",
                        "entry_id": "241dcbcb-936e-385a-97a4-1b3932e3de37",
                        "glosses": [
                            "Type d’aesthetic, tendance qui s’inspire des fées et de l’univers qui les entoure (elfes, nymphes, sylphides) et qui prône un retour à un mode de vie plus naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906b4dc5-6150-4655-8576-73ba6f0e256f",
                                "sense_id": "0e23a031-2aaf-3591-ba92-bdecb2589fca",
                                "text": "Le fairycore traditionnel se caractérise principalement avec des tons pastels. Des nœuds, des rubans et des tissus chatoyants accentuent des looks légers et aérés. Le nouveau fairycore mixe le grunge féerique, suffisamment sombre pour se donner un certain crédit avant-gardiste et suffisamment léger pour permettre à ses porteurs de puiser dans leur côté féminin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c7a210b-c8a7-4eb5-a0b1-8d5ea2153641",
                        "source_entry_id": "241dcbcb-936e-385a-97a4-1b3932e3de37",
                        "source_sense_id": "0e23a031-2aaf-3591-ba92-bdecb2589fca",
                        "target_lang_word": "fairycore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fairycore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                        "entry_id": "3d22d3c4-c637-39dd-8de6-3cf5722360f1",
                                        "glosses": [
                                            "An aesthetic focusing on imagery and fashion related to fairies."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc0268f5-243d-4964-a317-61d931f16338",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "Aesthetics Wiki Rabbit hole for anyone seeking clarity on online aesthetics. (Ghostcore, Fairycore, Vaporwave, anyone?)"
                                            },
                                            {
                                                "example_id": "6372b3d5-0649-4413-9395-38defee54519",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "Fairycore, for example, incorporates things like soft pastels, butterflies, mushrooms, springtime and a sense of magic."
                                            },
                                            {
                                                "example_id": "a08965ec-d3aa-4457-8026-7e63c56dee37",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "The homepage has all themes organized in folders for your choosing such as horoscope, autumn vibes, summer vibes, fairycore, cinematic and more."
                                            },
                                            {
                                                "example_id": "6cd811fb-9df0-42c7-8660-6a8911478702",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "Fairycore also exists as an ode to the fairytales we read growing up, primarily consisting of whimsical, fairy-like clothing."
                                            },
                                            {
                                                "example_id": "b9f856f3-58eb-44c3-a078-dc69e99d368a",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "Adults and teens can sculpt their own mini fairycore landscape at the Westside Learning Lab’s Mushroom Forest Centrepiece program Aug. 13 and Aug. 20 from 2 to 4 p.m."
                                            },
                                            {
                                                "example_id": "01390cc1-e3f1-48e0-895f-9986e171da6b",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "With the rise of social media, consuming fashion has become increasingly more accessible and has taken a new turn when it comes to its marketing by boxing it into certain aesthetics/styles (street style, grunge, fairycore, Y2K, dark academia, and more)."
                                            },
                                            {
                                                "example_id": "bc1e1775-56d5-4309-9a3c-86a13255d838",
                                                "sense_id": "c011a527-f31a-3503-8886-6367125305bf",
                                                "text": "The kids are on board, with #WitchTok (a sect of video platform TikTok populated by purple-nailed, crystal-collecting modern practitioners of Wicca) attracting thousands of users and “fairycore aesthetic” (think Pinterest boards filled with mushroom-shaped lamps and vine-covered wind chimes) blowing up across social media."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
