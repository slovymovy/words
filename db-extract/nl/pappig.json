                "senses": [
                    {
                        "sense_id": "0d1bae1f-0e51-31c2-b4e2-7489e5c3a4f4",
                        "entry_id": "2ce116cc-96f5-3b74-abf1-4fc21f146cc8",
                        "glosses": [
                            "van iets dat het halfzacht, halfvloeibaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ddcd96-6c6c-4464-ade8-025f8c4eaafb",
                                "sense_id": "0d1bae1f-0e51-31c2-b4e2-7489e5c3a4f4",
                                "text": "Het enige obstakel is een grote berg rijstebrij. Op het schilderij Luilekkerland (1567) van Pieter Brueghel de Oude zie je rechtsboven hoe een arme stakker zich een weg probeert te banen door de pappige witte massa."
                            },
                            {
                                "example_id": "87092cb2-687a-4ad9-93bc-7f4543cd6f74",
                                "sense_id": "0d1bae1f-0e51-31c2-b4e2-7489e5c3a4f4",
                                "text": "De sneeuw werd er pappig van waardoor ik er tot mijn knieën in zakte (het zogenaamde postholing)."
                            }
                        ]
                    },
                    {
                        "sense_id": "92ae4f33-e1f0-386c-bf25-c4d0e0af90fe",
                        "entry_id": "2ce116cc-96f5-3b74-abf1-4fc21f146cc8",
                        "glosses": [
                            "niet heel erg stevig"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ef0b04b3-9896-4852-9753-b8a7d5b11639",
                                "sense_id": "92ae4f33-e1f0-386c-bf25-c4d0e0af90fe",
                                "text": "Volgens Detroit Free Press noemt een lid van de Republikeinse Partij van Michigan Kid Rock de ideale kandidaat, omdat de zanger \"een grote naam is, out of the box denkt en ervoor zorgt dat de Republikeinen van hun pappige imago afkomen\". Hij voegt eraan toe: \"Ik durf te wedden dat hij net zoveel losmaakt als Trump.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "c9e003a5-4093-35b0-bba2-e06b80b8f5eb",
                        "entry_id": "2ce116cc-96f5-3b74-abf1-4fc21f146cc8",
                        "glosses": [
                            "van een mens of dier: te dik, te vet, te corpulent"
