                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce6d59c1-f8e1-3d49-9a87-1bd63eb6226c",
                        "entry_id": "99f669ed-015d-328b-aa30-e64b00e18287",
                        "glosses": [
                            "Une certaine étendue de fil, coupée de la longueur qu’il faut pour travailler à l’aiguille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed9d45f-3356-41fd-8b69-3ad5d13362d3",
                                "sense_id": "ce6d59c1-f8e1-3d49-9a87-1bd63eb6226c",
                                "text": "…, Modeste, […], restait ébahie, et avait lâché sa broderie qui ne tenait plus à ses doigts que par l’aiguillée de coton."
                            },
                            {
                                "example_id": "4c1404f5-62a1-4f1e-94f7-8440d1b1ab87",
                                "sense_id": "ce6d59c1-f8e1-3d49-9a87-1bd63eb6226c",
                                "text": "Je vois tout notre petit logement, les enfants qui reviennent de l’école ; la mère au fond de l’atelier en train de finir quelque chose contre la croisée, et s’efforçant de retenir ce brin de jour qui baisse, jusqu’à la fin de son aiguillée."
                            },
                            {
                                "example_id": "af40b031-3da0-47fd-b7ef-6f1e2c6c497e",
                                "sense_id": "ce6d59c1-f8e1-3d49-9a87-1bd63eb6226c",
                                "text": "Elle vient de couper une aiguillée de soie et pose ses ciseaux auprès d’elle."
                            },
                            {
                                "example_id": "7ba6c288-271b-4750-96cd-eb28838e2c64",
                                "sense_id": "ce6d59c1-f8e1-3d49-9a87-1bd63eb6226c",
                                "text": "Elle disait : « Je vais bâtir. » Je savais bien qu’elle allait prendre une aiguillée de fil et coudre à grands points."
                            },
                            {
                                "example_id": "0b639f78-11cd-441d-b21f-43760befac0d",
                                "sense_id": "ce6d59c1-f8e1-3d49-9a87-1bd63eb6226c",
                                "text": "Elle diagnostiqua une crise d'appendicite aigüe... aussi aigüe que la voix de ce prof hystérique qui raisonnait en moi “c'est une aiguillée de feignante que vous me faites là “... et je voyais cette folle brandir mon aiguille et le fil que j'avais eu tant de mal à enfiler, trop, trop, beaucoup trop long à mon goût."
                            }
                        ]
                    }
