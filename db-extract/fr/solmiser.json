                "senses": [
                    {
                        "sense_id": "8231e552-0aad-30c2-9b2f-b50d987d9985",
                        "entry_id": "f829ea00-e2a5-3d93-bbe9-30ec47b4b374",
                        "glosses": [
                            "Chanter, lire (un morceau de plain-chant), en prononçant la syllabe assignée à chaque note par la méthode des hexacordes et des muances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f4fbad-5226-4a18-93b8-ed4440ac16f2",
                                "sense_id": "8231e552-0aad-30c2-9b2f-b50d987d9985",
                                "text": "Ce propos a quelque chose d'ambigu puisque solmiser signifie précisément ne pas entonner au moyen des lettres (claves) (3), mais avec la série des syllabes(voces) dans laquelle passent les degrés sol et mi."
                            },
                            {
                                "example_id": "9b4e932d-9bed-40ce-b8bb-9a880dac5804",
                                "sense_id": "8231e552-0aad-30c2-9b2f-b50d987d9985",
                                "text": "Même après avoir adopté le si, on continua à solmiser : E par exemple s'appelait E-la-mi-si."
                            }
                        ]
                    }
                ],
