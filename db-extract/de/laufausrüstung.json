                ],
                "senses": [
                    {
                        "sense_id": "f042605a-dcbd-33dd-bc9e-0c0e7e5306f9",
                        "entry_id": "035f5bb9-5ca0-31ed-ade0-d6f7f7609489",
                        "glosses": [
                            "Gesamtheit der Gegenstände (Kleidung und Zubehör), die man beim Laufen verwendet oder mitführt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f76bb494-94b7-4423-8d00-8b5ed6658c09",
                                "sense_id": "f042605a-dcbd-33dd-bc9e-0c0e7e5306f9",
                                "text": "„Atmungsaktiv, windabweisend, wasserdicht, um nur einige Schlagworte zu nennen, die für den Kauf der Laufausrüstung wichtig sind.“"
                            },
                            {
                                "example_id": "6f1ab448-22ca-43ca-bd4e-ac71045dd1b2",
                                "sense_id": "f042605a-dcbd-33dd-bc9e-0c0e7e5306f9",
                                "text": "„Viele Einsteiger denken, dass sie beim Joggen besonders viel schwitzen und deshalb unbedingt in Sachen Laufausrüstung die dickste Schicht anziehen sollten, um nicht auszukühlen.“"
                            },
                            {
                                "example_id": "b6f1a8c1-25cd-4427-8b62-9163775058de",
                                "sense_id": "f042605a-dcbd-33dd-bc9e-0c0e7e5306f9",
                                "text": "„In unserem Magazin RUNNER’S WORLD und in der Rubrik Laufbekleidung auf dieser Website stellen wir regelmäßig empfehlenswerte Laufausrüstung vor.“"
                            },
                            {
                                "example_id": "883a60dc-b0c3-4c0e-9ef9-6000e5127155",
                                "sense_id": "f042605a-dcbd-33dd-bc9e-0c0e7e5306f9",
                                "text": "„Denn mal abgesehen von dem vom Dauerregen gezeichneten Untergrund, welcher der Laufausrüstung einen lustigen, neuen Look verpasste, genoss man auf der 5 km-Runde deutlich mehr Platz als gewohnt.“"
                            },
                            {
                                "example_id": "b3ee1330-b61b-46fb-abad-510c5e715cb1",
                                "sense_id": "f042605a-dcbd-33dd-bc9e-0c0e7e5306f9",
                                "text": "„Stöbere einfach mal durch diesen Artikel über meine persönliche Laufausrüstung und lass dich inspirieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
