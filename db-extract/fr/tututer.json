                    },
                    {
                        "sense_id": "98ad2763-ab19-317b-92eb-0ecfc5c3c12b",
                        "entry_id": "eac85387-03f6-3a85-ba85-00551fe38369",
                        "glosses": [
                            "Boire (de l’alcool)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "68472d65-4f24-4f24-9c09-9e4ef481deba",
                                "sense_id": "98ad2763-ab19-317b-92eb-0ecfc5c3c12b",
                                "text": "Il tutute la chopine."
                            },
                            {
                                "example_id": "40181d1e-2e90-4a6c-ac72-9b5240b542e9",
                                "sense_id": "98ad2763-ab19-317b-92eb-0ecfc5c3c12b",
                                "text": "Ça l'empêchait pas, ce prêcheur d'espéranto, de tututer ferme. Il avait sous son matelas de cure son petit litron, il se remontait un peu le moral..."
                            },
                            {
                                "example_id": "fef99c4f-178f-433c-93e7-4f796cbf0c80",
                                "sense_id": "98ad2763-ab19-317b-92eb-0ecfc5c3c12b",
                                "text": "Je buvais plus que de la flotte et dans la chambrée, à part Stalag qui tututait un peu en lousdoc et en suisse, les autres ça les tenaillait pas du tout..."
                            }
                        ]
                    }
