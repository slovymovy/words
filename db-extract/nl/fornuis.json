                        ]
                    },
                    {
                        "translation_id": "4c17d193-5786-4710-b47b-79b573639f52",
                        "source_entry_id": "b04a008c-54b0-3d05-9325-885a891b1db0",
                        "source_sense_id": "083d980c-ee04-3deb-8dfe-0d2d85b742b9",
                        "target_lang_word": "cuisinière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuisinière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "271ca803-5484-388f-98b1-a93f61d5b065",
                                        "entry_id": "74401e7b-aa4c-3074-b53a-22dc0f68f81e",
                                        "glosses": [
                                            "Celle qui cuisine, qui prépare, qui cuit la nourriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6667ec34-a98e-4708-b0ed-fd92ae1e8373",
                                                "sense_id": "271ca803-5484-388f-98b1-a93f61d5b065",
                                                "text": "Je me désélégantise, je me désuavise, je vais devenir une vraie cuisinière, une fermière, ou tout ce que vous voudrez, et c’est effrayant à quel point je me trouve faite pour cela."
                                            },
                                            {
                                                "example_id": "6f79377f-dcc4-48ae-a54f-4c006c99b69a",
                                                "sense_id": "271ca803-5484-388f-98b1-a93f61d5b065",
                                                "text": "Enfin, en guise de dessert, la cuisinière avait confectionné une sorte de rabote garnie de trois pommes offertes par la bonne du curé, mademoiselle Alice."
                                            },
                                            {
                                                "example_id": "1c30de42-4d54-49b1-924a-f764a42ec986",
                                                "sense_id": "271ca803-5484-388f-98b1-a93f61d5b065",
                                                "text": "En sa qualité de gourmande, la Tonsard devint excellente cuisinière, et quoique ses talents ne s’exerçassent que sur les plats en usage dans la campagne, le civet, la sauce du gibier, la matelote, l’omelette, elle passa dans le pays pour savoir admirablement cuisiner un de ces repas qui se mangent sur le bout de la table et dont les épices, prodiguées outre mesure, excitent à boire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213aaf1b-c1dc-378c-91dd-4d6b7ac32ac1",
                                        "entry_id": "74401e7b-aa4c-3074-b53a-22dc0f68f81e",
                                        "glosses": [
                                            "Celle que l’on prend à gages dans une maison, un restaurant pour y faire la cuisine."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3688cda1-d4b4-4990-bc7a-9b6a12546844",
                                                "sense_id": "213aaf1b-c1dc-378c-91dd-4d6b7ac32ac1",
                                                "text": "La cuisinière annonça que le potage de Monsieur était servi."
                                            },
                                            {
                                                "example_id": "d2925e57-fb9f-41ab-90e9-342c0fb188c5",
                                                "sense_id": "213aaf1b-c1dc-378c-91dd-4d6b7ac32ac1",
                                                "text": "Le 15 avril prochain, la meilleure cuisinière de France, trois étoiles au Guide Michelin, ouvre un nouveau restaurant gastronomique."
                                            },
                                            {
                                                "example_id": "124f6f64-f554-4ef7-a6f2-abe6155e9660",
                                                "sense_id": "213aaf1b-c1dc-378c-91dd-4d6b7ac32ac1",
                                                "text": "Vous me placez cuisinière chez Madame, vous me prenez pour dix ans, j’ai mille francs de gages, vous payez les cinq dernières années d’avance (un denier-à-Dieu, quoi !)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdc047e2-96ef-3a56-8eda-cad7334dda5a",
                                        "entry_id": "74401e7b-aa4c-3074-b53a-22dc0f68f81e",
                                        "glosses": [
                                            "Épouse d’un cuisinier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e40fd569-37a9-3824-a564-14c6b965b453",
                                        "entry_id": "74401e7b-aa4c-3074-b53a-22dc0f68f81e",
                                        "glosses": [
                                            "Ustensile de fer-blanc traversé par une broche, et qui sert à faire rôtir la viande."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12893aaf-f8cb-4300-801d-35ca080f504b",
                                                "sense_id": "e40fd569-37a9-3824-a564-14c6b965b453",
                                                "text": "Les riches n’imagineraient pas la simplicité de la batterie de cuisine qui consistait en une cuisinière, un chaudron, un gril, une casserole, deux ou trois marabouts, et une poêle à frire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17507f44-36bf-3df7-b91e-7c76a0224fe0",
                                        "entry_id": "74401e7b-aa4c-3074-b53a-22dc0f68f81e",
                                        "glosses": [
                                            "Fourneau de cuisine servant à chauffer ou faire cuire les aliments, souvent muni d’éléments chauffants sur sa surface de travail."
                                        ],
                                        "tags": [
                                            "Électroménager"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49218805-e6a1-46a1-9c7a-553f70b2145a",
                                                "sense_id": "17507f44-36bf-3df7-b91e-7c76a0224fe0",
                                                "text": "Cuisinières. — On appelle cuisinières les fourneaux complets à gaz. On en fait de types très divers. Celles pour les ménages bourgeois, comportent généralement quatre flammes de réchauds, une rôtissoire, un four et un réservoir d’eau chaude."
                                            },
                                            {
                                                "example_id": "aa149746-58b6-4824-bca2-30186cd55c22",
                                                "sense_id": "17507f44-36bf-3df7-b91e-7c76a0224fe0",
                                                "text": "— Le charbon, on ne peut pas le brûler, expliqua le vieil homme, notre cuisinière n’est pas faite pour ça, et elle est trop vieille pour être transformée…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
