                ],
                "senses": [
                    {
                        "sense_id": "eb7f3569-5a12-33cf-ae69-120a5ee57aa4",
                        "entry_id": "f235e9c3-eeaf-3e9f-b892-9cfcda27b26e",
                        "glosses": [
                            "Action d’aboucher ou de s’aboucher."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a5ca3e0f-b04f-48b8-b598-a86322d5fd97",
                                "sense_id": "eb7f3569-5a12-33cf-ae69-120a5ee57aa4",
                                "text": "On avait ménagé un abouchement entre eux."
                            },
                            {
                                "example_id": "49267d45-e90d-43a7-850c-d892ee3e83b3",
                                "sense_id": "eb7f3569-5a12-33cf-ae69-120a5ee57aa4",
                                "text": "L’abouchement des deux princes n’eut pas le succès qu’on en attendait."
                            }
                        ]
                    },
                    {
                        "sense_id": "06801d17-a25d-3085-8a4b-221fed1abc6a",
                        "entry_id": "f235e9c3-eeaf-3e9f-b892-9cfcda27b26e",
                        "glosses": [
                            "Entrevue, rencontre, conférence, entretien."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3745a816-08cc-33e2-80e1-a4127aad42b4",
                        "entry_id": "f235e9c3-eeaf-3e9f-b892-9cfcda27b26e",
                        "glosses": [
                            "Union, jonction de deux vaisseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34587eb3-db88-4e07-a49d-2206a22e6606",
                                "sense_id": "3745a816-08cc-33e2-80e1-a4127aad42b4",
                                "text": "L’abouchement de deux tubes, de deux tuyaux."
                            },
                            {
                                "example_id": "15ab6ae6-f441-445c-ae4a-6dd8135f12b3",
                                "sense_id": "3745a816-08cc-33e2-80e1-a4127aad42b4",
                                "text": "La proximité de la terminaison du canal de Wolff et du canal de Müller expliquerait l’abouchement de l’uretère dans ce dernier (vagin, utérus, utricule prostatique), à moins qu’il ne faille faire intervenir dans la genèse de ces ectopies des communications anormales entre canaux de Wolff et de Müller."
                            }
                        ]
                    }
                ],
