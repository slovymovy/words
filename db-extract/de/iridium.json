                                    {
                                        "sense_id": "9995b09d-1ad2-3305-be54-1db0a5b78306",
                                        "entry_id": "6d962d24-02b3-3d9b-b796-02ddf89cb6f0",
                                        "glosses": [
                                            "A chemical element (symbol Ir) with an atomic number of 77: a very hard, brittle, silvery-white transition metal of the platinum group."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397d161d-02d0-4af7-a293-58b37d932e26",
                                                "sense_id": "9995b09d-1ad2-3305-be54-1db0a5b78306",
                                                "text": "Iridium is extremely rare on the surface of the earth but much more common in meteorites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320214be-a296-363e-8e27-3012e421dbf9",
                                        "entry_id": "6d962d24-02b3-3d9b-b796-02ddf89cb6f0",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c05b24c5-60ff-4f33-a620-5adf4898028f",
                        "source_entry_id": "d193e615-df88-3f00-81c5-6b95227e8b07",
                        "source_sense_id": "fe83eaf8-7d89-3cea-8e0b-9c362c1cf7ea",
                        "source_sense_description": "chemisches Element mit der Ordnungszahl 77",
                        "target_lang_word": "iridium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iridium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc037552-16f1-3868-80ab-100d73f849fb",
                                        "entry_id": "26f0f25e-7ff8-3da4-93b7-9b34979916e7",
                                        "glosses": [
                                            "Élément chimique appartenant à la série des métaux de transition. Son symbole chimique est Ir et son numéro atomique 77."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d630a8a9-cba6-46ae-b014-feca3155fa2e",
                                                "sense_id": "fc037552-16f1-3868-80ab-100d73f849fb",
                                                "text": "Anciennement, le symbole chimique de l’iridium fut J."
                                            },
                                            {
                                                "example_id": "b281cb99-1593-4c8e-82e7-d82836b4b2a1",
                                                "sense_id": "fc037552-16f1-3868-80ab-100d73f849fb",
                                                "text": "Ce scénario se base principalement sur la présence de teneurs élevées en iridium dans les météorites et la structure géologique plus ou moins circulaire du Yucatan."
                                            },
                                            {
                                                "example_id": "52342e0d-27d2-4098-a8e2-b93982d56678",
                                                "sense_id": "fc037552-16f1-3868-80ab-100d73f849fb",
                                                "text": "La découverte de spinelles nickélifères (magnétites), à signatures géochimiques extraterrestres dans la couche à iridium de nombreux sites, dont Bidart, fait clairement pencher les données vers une origine cosmique de l’excès d’iridium (impact de Chicxulub (Mexique) daté de 65 Ma)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24fe8ab0-e740-33a5-9c17-625bf649c105",
                                        "entry_id": "26f0f25e-7ff8-3da4-93b7-9b34979916e7",
                                        "glosses": [
                                            "Corps simple métallique blanc d’argent."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904140ad-3a29-40d2-a4e4-a4fdbe28605f",
                                                "sense_id": "24fe8ab0-e740-33a5-9c17-625bf649c105",
                                                "text": "La pointe des plumes des stylographes est en iridium."
                                            },
                                            {
                                                "example_id": "e8d8f2af-9c1a-4e99-a5a6-956d8ec7d355",
                                                "sense_id": "24fe8ab0-e740-33a5-9c17-625bf649c105",
                                                "text": "Les dispositifs existants font appel à des métaux rares, chers et parfois toxiques : des cellules photovoltaïques de silicium dopé avec de l’indium, du gallium et de l’arsenic, par exemple, ou des électrodes en iridium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
