                "senses": [
                    {
                        "sense_id": "c34b79f0-a881-3b89-9edf-d486839b4cdc",
                        "entry_id": "137de712-6e4e-3fe2-a307-e4495d18b415",
                        "glosses": [
                            "Wissenschaftler, der sich mit Protisten beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf235ed4-7163-4a35-afa8-a61de328bb39",
                                "sense_id": "c34b79f0-a881-3b89-9edf-d486839b4cdc",
                                "text": "„Mit Untersuchungen über Einzeller und andere Kleinstlebewesen machte sich Ernst Bresslau zudem einen Namen als Protistologe.“"
                            },
                            {
                                "example_id": "79cccc41-fef1-47d6-ad3a-84ddecd578dc",
                                "sense_id": "c34b79f0-a881-3b89-9edf-d486839b4cdc",
                                "text": "„Insbesondere sind es die zahlreichen bizarr gebauten Vertreter der Polymastiginen, welche von jeher das Interesse der Protistologen erweckten.“"
                            },
                            {
                                "example_id": "8c486f9f-e6fe-4178-8176-518f4f983a20",
                                "sense_id": "c34b79f0-a881-3b89-9edf-d486839b4cdc",
                                "text": "„Wenn man weiterhin bedenkt, daß Viele Routinetreffen von Protistologen, Botanikern, Paläontologen, Limnologen, Ozeanographen, Pedologen, Cytologen, Mikrobiologen usw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
