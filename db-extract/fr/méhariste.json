                        "glosses": [
                            "Celui qui monte un dromadaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fbc8723-2548-4704-b48d-b0503fdb5ae9",
                                "sense_id": "2211f4b8-1258-3200-a65c-d40b5b20e9e6",
                                "text": "Par suite, plus le méhariste sera éloigné du centre supposé de ces ondes, plus grands seront les arcs qu’il décrira pendant les oscillations longitudinales que provoquera la marche."
                            },
                            {
                                "example_id": "087ae42b-acdf-474b-a936-6d79f812c428",
                                "sense_id": "2211f4b8-1258-3200-a65c-d40b5b20e9e6",
                                "text": "Par bonheur, ils étaient arrivés près de la piste menant de Deir-er-Zoor à Palmyre, où des méharistes les retrouvèrent et les sauvèrent."
                            }
                        ]
                    }
