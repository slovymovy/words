                "word": "Celtiberian",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e308fdeb-958e-3f24-ad21-e8b295111d26",
                        "entry_id": "fd9a40ff-2e28-3d51-86a4-9492664fcdc6",
                        "glosses": [
                            "An extinct Indo-European language of the Celtic branch spoken by these people in an area of the Iberian Peninsula lying between the headwaters of the Duero, Tajo, Júcar and Turia rivers and the Ebro river."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5e6436d-fed6-456a-b340-dbcab3597e85",
                        "source_entry_id": "fd9a40ff-2e28-3d51-86a4-9492664fcdc6",
                        "source_sense_id": "e308fdeb-958e-3f24-ad21-e8b295111d26",
                        "source_sense_description": "language",
                        "target_lang_word": "keltiberština",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e5a8f881-4453-4036-9826-ff01878be6ad",
                        "source_entry_id": "fd9a40ff-2e28-3d51-86a4-9492664fcdc6",
                        "source_sense_id": "e308fdeb-958e-3f24-ad21-e8b295111d26",
                        "source_sense_description": "language",
                        "target_lang_word": "Keltiberisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keltiberisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12c09cbd-8e5f-342b-8046-807cb58364f2",
                                        "entry_id": "42828408-783a-32a3-90bd-6a56f4147a12",
                                        "glosses": [
                                            "untergegangene festlandkeltische Sprache auf der iberischen Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70feff2-e8b3-4ff7-912f-7ceec4f94b78",
                                                "sense_id": "12c09cbd-8e5f-342b-8046-807cb58364f2",
                                                "text": "„Die Sprache der Keltiberer (lateinisch »celtiberi«), das Keltiberische, war eine altertümliche Form des Keltischen.“"
                                            },
                                            {
                                                "example_id": "a1659ae9-e23b-4efb-800d-8a0c2fc5afa4",
                                                "sense_id": "12c09cbd-8e5f-342b-8046-807cb58364f2",
                                                "text": "„In vorrömischer Zeit wurden Varianten des Festlandkeltischen in Spanien (Keltiberisch), Frankreich (Gallisch), Norditalien (Lepontisch), in Mitteleuropa bis nach Rumänien und Bulgarien gesprochen.“"
                                            },
                                            {
                                                "example_id": "9a18f704-3ac9-49e2-b409-1829c913409e",
                                                "sense_id": "12c09cbd-8e5f-342b-8046-807cb58364f2",
                                                "text": "„Die nach Spanien gewanderten Kelten werden als Keltiberer bezeichnet; das Keltiberische ist in (nur zum Teil entschlüsselten) Inschriften erhalten, vor allem im Norden und im Osten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
