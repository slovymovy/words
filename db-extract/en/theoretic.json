                        "sense_id": "d08b7991-5759-32db-a947-7270c4691d70",
                        "entry_id": "489d75e7-c34a-385e-ab3e-875c720334d9",
                        "glosses": [
                            "Concerned with theories or hypotheses rather than with practical matters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a98098d-4ce3-4c55-a0c3-c609b0825d0f",
                                "sense_id": "d08b7991-5759-32db-a947-7270c4691d70",
                                "text": "We shall, therefore, only very humbly submit whether the whole statement be not rather too theoretic and somewhat too darkly adumbrated in ambiguous phraseology for plain, uncollegian understandings."
                            }
                        ]
                    },
                    {
                        "sense_id": "af8a4832-9c1c-302d-a936-8b61192c5957",
                        "entry_id": "489d75e7-c34a-385e-ab3e-875c720334d9",
                        "glosses": [
                            "Existing only in theory, not proven in reality."
                        ],
                        "tags": [],
                        "examples": []
