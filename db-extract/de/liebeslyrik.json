                "senses": [
                    {
                        "sense_id": "aaf1beea-4f1b-3d1d-b6f9-3973af6c39da",
                        "entry_id": "df8d7c42-543f-3cd1-aa44-6c2180217c07",
                        "glosses": [
                            "Lyrik, die sich thematisch mit der Liebe befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54725a7b-15bb-43b8-8439-e19b3d374983",
                                "sense_id": "aaf1beea-4f1b-3d1d-b6f9-3973af6c39da",
                                "text": "„Die thematische Vielfalt reichte von Liebeslyrik und nachdenklicher Miniaturprosa bis hin zu humoristischer Wortakrobatik und abstraktem Sprachspiel.“"
                            },
                            {
                                "example_id": "0c0488b7-b8eb-4f44-bb0b-3bca7d4626b0",
                                "sense_id": "aaf1beea-4f1b-3d1d-b6f9-3973af6c39da",
                                "text": "„Gleichviel – schon sie bildeten nur Varianten der Liebeslyrik von Adam und Eva.“"
                            },
                            {
                                "example_id": "466a648d-337c-4237-9b12-58fe683b2049",
                                "sense_id": "aaf1beea-4f1b-3d1d-b6f9-3973af6c39da",
                                "text": "„Und die zerbrochene Einheit hatte er mit Liebeslyrik zu kitten versucht.“"
                            },
                            {
                                "example_id": "b1a3acc1-f6df-4733-b1fd-2865558462d7",
                                "sense_id": "aaf1beea-4f1b-3d1d-b6f9-3973af6c39da",
                                "text": "„Lesen und Schreiben eroberten Bereiche jenseits der Theologie: den Handel, die Diplomatie und sogar die Liebeslyrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
