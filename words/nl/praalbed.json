    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86ff1d55-7b98-3d4b-8a7b-975da66b7b64",
                    "sense_definition": "Een plechtig opgemaakt bed waarop het lichaam van een belangrijk persoon ligt opgebaard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overleden vorst lag opgebaard op een rijkversierd <w>praalbed</w> in de grote zaal van het paleis.",
                            "target_lang_translations": {
                                "de": "Der verstorbene Monarch lag auf einem reich verzierten <w>Paradebett</w> im großen Saal des Palastes aufgebahrt."
                            }
                        },
                        {
                            "text": "Duizenden burgers kwamen langs het <w>praalbed</w> lopen om hun laatste eer aan de staatsman te bewijzen.",
                            "target_lang_translations": {
                                "de": "Tausende Bürger zogen am <w>Paradebett</w> vorbei, um dem Staatsmann die letzte Ehre zu erweisen."
                            }
                        }
                    ],
                    "synonyms": [
                        "staatiebed",
                        "paradebed"
                    ],
                    "common_phrases": [
                        "op het praalbed liggen",
                        "opgebaard op een praalbed"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein feierlich hergerichtetes Bett, auf dem der Leichnam einer hochgestellten Persönlichkeit aufgebahrt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Paradebett",
                                "target_lang_sense_clarification": "zum Aufbahren"
                            },
                            {
                                "target_lang_word": "das Prunkbett",
                                "target_lang_sense_clarification": "beim Aufbahren"
                            },
                            {
                                "target_lang_word": "das Katafalk",
                                "target_lang_sense_clarification": "Aufbahrungsgestell"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4b780f8-78cd-3606-aa30-94228e112482",
                    "sense_definition": "Een buitengewoon weelderig, fraai versierd of pronkend bed.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meubilair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het museum zagen we een prachtig <w>praalbed</w> met gouden details en zware gordijnen.",
                            "target_lang_translations": {
                                "de": "Im Museum sahen wir ein prächtiges <w>Prunkbett</w> mit goldenen Verzierungen und schweren Vorhängen."
                            }
                        },
                        {
                            "text": "Ze hadden een luxueus <w>praalbed</w> in de logeerkamer staan waar eigenlijk nooit iemand in sliep.",
                            "target_lang_translations": {
                                "de": "Sie hatten ein luxuriöses <w>Prunkbett</w> im Gästezimmer stehen, in dem eigentlich nie jemand schlief."
                            }
                        }
                    ],
                    "synonyms": [
                        "pronkbed"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein außergewöhnlich prunkvolles, reich verziertes oder repräsentatives Bett."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Prunkbett",
                                "target_lang_sense_clarification": "prunkvoll verziertes Möbelstück"
                            },
                            {
                                "target_lang_word": "das Paradebett",
                                "target_lang_sense_clarification": "historisches Repräsentationsbett"
                            }
                        ]
                    }
                }
            ]
        }
    ]
