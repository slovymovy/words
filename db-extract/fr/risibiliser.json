                "senses": [
                    {
                        "sense_id": "c9be2266-f35e-39bb-89f8-b53e41a2016f",
                        "entry_id": "d0ce72fd-61f6-36b6-9bf4-81c88f579394",
                        "glosses": [
                            "Donner un caractère risible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93608865-1f9a-4c47-a5e3-380d0fb4a853",
                                "sense_id": "c9be2266-f35e-39bb-89f8-b53e41a2016f",
                                "text": "L'avocat en employant cette expression risible ne risibilise-t-il pas son client et son affaire ?"
                            },
                            {
                                "example_id": "df121fa6-fef9-4021-9677-3fbeedc1a511",
                                "sense_id": "c9be2266-f35e-39bb-89f8-b53e41a2016f",
                                "text": "Alors, de grâce arrête de nous pomper l'air avec tes réflexions de dragueur de HLM ! ... ou alors accepte d'être \"risibilisé\" !"
                            },
                            {
                                "example_id": "69302caa-6294-4d43-9c3e-9cc9db802f13",
                                "sense_id": "c9be2266-f35e-39bb-89f8-b53e41a2016f",
                                "text": "Avec refus, rejet voir risibiliser tout ce qui n'est pas chrétien (Bouddhisme, paganisme anciens, mysticisme chrétien-Cathare, gnostique, manichéisme-)"
                            }
                        ]
                    }
