                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8519d9-07e4-3085-8e42-2c9ac84f5011",
                                        "entry_id": "b9a7ef25-8cd0-358e-9bfc-5870705169d9",
                                        "glosses": [
                                            "A person whose net worth is greater than one hundred billion (10¹¹) dollars, or other currency."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41b16f0-304c-40b8-bbaa-2b16fd6eddb2",
                                                "sense_id": "4e8519d9-07e4-3085-8e42-2c9ac84f5011",
                                                "text": "Of course we can never know these things for sure, but Oprah being the world's first black woman billionaire is just as certain as Bill Gates being the world's first centibillionaire (he was briefly at his peak)."
                                            },
                                            {
                                                "example_id": "5d09ea86-4a23-4adb-86e3-1f008d82970a",
                                                "sense_id": "4e8519d9-07e4-3085-8e42-2c9ac84f5011",
                                                "text": "With TikTok's future now increasingly unclear, and Facebook reporting a stronger than expected performance in Q2, Zuckerberg is now a centibillionaire, joining Jeff Bezos and Bill Gates in the $100 billion club, according to the Bloomberg Billionaires Index."
                                            },
                                            {
                                                "example_id": "1adae9f0-9d91-41f9-a341-1c7dbcd16c02",
                                                "sense_id": "4e8519d9-07e4-3085-8e42-2c9ac84f5011",
                                                "text": "Two years ago, Bezos was the only “centibillionaire” on earth — the trendy neologism for people whose wealth exceeds $100 billion. Now there are five — in addition to Bezos, there’s Bill Gates, Mark Zuckerberg, Elon Musk and Bernard Arnault, the French luxury tycoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
