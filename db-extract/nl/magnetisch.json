                    {
                        "sense_id": "6159446a-98c2-30f9-807a-fe2edecd585e",
                        "entry_id": "8ae65cd6-6cfb-3577-97ac-e1e28784a762",
                        "glosses": [
                            "verschijnselen vertonend die toegeschreven kunnen worden aan een kringstroom of roterende lading"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b209bb1-c4be-43dd-84b0-95ea9f970398",
                                "sense_id": "6159446a-98c2-30f9-807a-fe2edecd585e",
                                "text": "Magnetiet was het eerste materiaal waarvan men de magnetische eigenschappen opmerkte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "074466cf-db6e-44f4-9a0c-8b92c8bf748e",
                        "source_entry_id": "8ae65cd6-6cfb-3577-97ac-e1e28784a762",
                        "source_sense_id": "6159446a-98c2-30f9-807a-fe2edecd585e",
                        "source_sense_description": "verschijnselen vertonend die toegeschreven kunnen worden aan een kringstroom...",
                        "target_lang_word": "magnetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "443bb025-e1dd-34a3-9cb8-0230b7b280a8",
                                        "entry_id": "1da1a58d-ab0d-3fb7-8ec4-f0d73f7612de",
                                        "glosses": [
                                            "Of, relating to, operating by, or caused by magnetism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c563ad3e-f94c-4f75-8bfd-8cc90a03f608",
                                                "sense_id": "443bb025-e1dd-34a3-9cb8-0230b7b280a8",
                                                "text": "a magnetic recorder"
                                            },
                                            {
                                                "example_id": "8974d926-3e70-4f37-a5dd-e696fa42667d",
                                                "sense_id": "443bb025-e1dd-34a3-9cb8-0230b7b280a8",
                                                "text": "[M]agnetic action […] is the subsequence of the motion of iron to the approach of a loadstone."
                                            },
                                            {
                                                "example_id": "538cb3ba-b5cb-452a-b2e0-08b36cda473c",
                                                "sense_id": "443bb025-e1dd-34a3-9cb8-0230b7b280a8",
                                                "text": "Retrieving that fingerprint involves a series of magnetic experiments that repeatedly heat and cool the object, exposing it to magnetic fields and then removing them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc339b8b-b284-345f-b6e9-66034f88a8f1",
                                        "entry_id": "1da1a58d-ab0d-3fb7-8ec4-f0d73f7612de",
                                        "glosses": [
                                            "Having the properties of a magnet, especially the ability to draw or pull."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ab5e4af-421c-347b-8375-a726ba0dbcfe",
                                        "entry_id": "1da1a58d-ab0d-3fb7-8ec4-f0d73f7612de",
                                        "glosses": [
                                            "Determined by earth's magnetic fields."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2bc78e1-44ff-40d3-acc8-dfe6e23ccb86",
                                                "sense_id": "7ab5e4af-421c-347b-8375-a726ba0dbcfe",
                                                "text": "magnetic north"
                                            },
                                            {
                                                "example_id": "d50c8665-3a1d-45b9-b5a6-d7ddedaf0b83",
                                                "sense_id": "7ab5e4af-421c-347b-8375-a726ba0dbcfe",
                                                "text": "the magnetic meridian"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b473d11-d09f-3e9c-af19-526cf7ae5f3b",
                                        "entry_id": "1da1a58d-ab0d-3fb7-8ec4-f0d73f7612de",
                                        "glosses": [
                                            "Having an extraordinary ability to attract: attractive, alluring, persuasive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97cd745-b2fc-4dec-b798-8e4ff65b230a",
                                                "sense_id": "1b473d11-d09f-3e9c-af19-526cf7ae5f3b",
                                                "text": "He has a magnetic personality."
                                            },
                                            {
                                                "example_id": "551217f4-4c75-4c30-b2a1-e20c37675103",
                                                "sense_id": "1b473d11-d09f-3e9c-af19-526cf7ae5f3b",
                                                "text": "she that had all magnetic force alone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf32248-2b74-3a3a-8e48-983d4b6edf7a",
                                        "entry_id": "1da1a58d-ab0d-3fb7-8ec4-f0d73f7612de",
                                        "glosses": [
                                            "Having, susceptible to, or induced by, animal magnetism."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0acd8702-830b-4404-ab09-a2e27babeef1",
                                                "sense_id": "edf32248-2b74-3a3a-8e48-983d4b6edf7a",
                                                "text": "a magnetic sleep"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc719139-cc5e-4115-a3d5-e5015ca33fc1",
                        "source_entry_id": "8ae65cd6-6cfb-3577-97ac-e1e28784a762",
                        "source_sense_id": "6159446a-98c2-30f9-807a-fe2edecd585e",
                        "source_sense_description": "verschijnselen vertonend die toegeschreven kunnen worden aan een kringstroom...",
                        "target_lang_word": "магнитный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "магнитный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e2c11f9-f45b-3a39-9d2c-30216e7380b2",
                                        "entry_id": "cc191c45-b433-3681-a3a1-fd9f218631e0",
                                        "glosses": [
                                            "обладающий магнетизмом, магнитными свойствами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7f5c48-5bb7-4c21-a013-0a5c7e84c563",
                                                "sense_id": "2e2c11f9-f45b-3a39-9d2c-30216e7380b2",
                                                "text": "Я забыл посмотреть на магнитную стрелку, когда мы проходили магнитный экватор, отстоящий на три градуса от настоящего."
                                            },
                                            {
                                                "example_id": "1fc49a50-45a0-4c96-af01-5add035a7543",
                                                "sense_id": "2e2c11f9-f45b-3a39-9d2c-30216e7380b2",
                                                "text": "Это магнитный железняк притянул к себе и ваш молоток и моё ружьё!"
                                            },
                                            {
                                                "example_id": "fb2d59cb-219b-47b0-aca5-07bbe37373ce",
                                                "sense_id": "2e2c11f9-f45b-3a39-9d2c-30216e7380b2",
                                                "text": "Следовательно, камень был сильно магнитный и, очевидно, представлял железный метеорит, состоящий, как установлено наукой, из никелистого железа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0106bf6d-d355-3526-8d32-8e9e1b765aa9",
                                        "entry_id": "cc191c45-b433-3681-a3a1-fd9f218631e0",
                                        "glosses": [
                                            "основанный на явлении магнетизма; использующий магнетизм для функционирования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f92c0c-cfcc-4ad7-8432-6b439127e445",
                                                "sense_id": "0106bf6d-d355-3526-8d32-8e9e1b765aa9",
                                                "text": "Во-вторых, магнитный билет придает владельцу некоторую исключительность: ты, как VIP, проходишь через особый турникет, с которым опасающаяся новшеств метропублика предпочитает дела не иметь."
                                            },
                                            {
                                                "example_id": "27e0787b-c0c1-4048-8ac5-0c70a8dd8cd1",
                                                "sense_id": "0106bf6d-d355-3526-8d32-8e9e1b765aa9",
                                                "text": "Над разгрузочным конвейером установлен магнитный сепаратор."
                                            },
                                            {
                                                "example_id": "b8fdbc6e-2659-4e63-829c-b1e7b26873d7",
                                                "sense_id": "0106bf6d-d355-3526-8d32-8e9e1b765aa9",
                                                "text": "Паша шёл по ковровой дорожке среди деревянных панелей, вертел в руке пластиковый магнитный ключ от двери: чёрт его знает каким концом всовывать в замок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985c2ed2-817a-3435-af55-dfdac11744f9",
                                        "entry_id": "cc191c45-b433-3681-a3a1-fd9f218631e0",
                                        "glosses": [
                                            "относящийся к магнетизму"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37b6ea3-2e8d-47e7-b282-c18e458febbb",
                                                "sense_id": "985c2ed2-817a-3435-af55-dfdac11744f9",
                                                "text": "Магнитный момент — векторная величина, характеризующая вещество как источник магнитного поля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae3ed2c9-05a9-3fae-bcfb-c17abf36b163",
                                        "entry_id": "cc191c45-b433-3681-a3a1-fd9f218631e0",
                                        "glosses": [
                                            "геогр. связанный с магнитным полем Земли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1754f6b9-d958-4427-98ec-41e7757b04a3",
                                                "sense_id": "ae3ed2c9-05a9-3fae-bcfb-c17abf36b163",
                                                "text": "Я забыл посмотреть на магнитную стрелку, когда мы проходили магнитный экватор, отстоящий на три градуса от настоящего."
                                            },
                                            {
                                                "example_id": "502a805f-eaa8-4f62-8fac-f6d083988f24",
                                                "sense_id": "ae3ed2c9-05a9-3fae-bcfb-c17abf36b163",
                                                "text": "Да, кстати, ты знаешь, что мы тогда нашли второй северный магнитный полюс в районе недоступности?"
                                            },
                                            {
                                                "example_id": "77573793-7793-4113-b60a-833b023faeb2",
                                                "sense_id": "ae3ed2c9-05a9-3fae-bcfb-c17abf36b163",
                                                "text": "Затем определяется расстояние до основного ориентира и магнитный азимут на этот ориентир."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
