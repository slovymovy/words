                "senses": [
                    {
                        "sense_id": "abb2e2cf-b4bb-351e-8090-fb3b3337539b",
                        "entry_id": "cad83273-8f77-3cca-b599-115cf00f68de",
                        "glosses": [
                            "Caractéristique sportive d'une personne, d'un objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0084fe02-d407-4e5a-887b-80988e0f0f02",
                                "sense_id": "abb2e2cf-b4bb-351e-8090-fb3b3337539b",
                                "text": "Les roadsters associent plaisir, sportivité et économie."
                            }
                        ]
                    },
                    {
                        "sense_id": "c64a8ca2-2fc1-3255-be43-68c348780af0",
                        "entry_id": "cad83273-8f77-3cca-b599-115cf00f68de",
                        "glosses": [
                            "Ensemble de traits éthiques et personnels considérés comme dignes d'un athlète, dont l'honnêteté, la courtoisie envers les opposants et l'acceptation gracieuse de la victoire ou la défaite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8b3af89-1aa2-4c07-8fd3-97bbcf5cd566",
                                "sense_id": "c64a8ca2-2fc1-3255-be43-68c348780af0",
                                "text": "Une bonne sportivité repose autant sur l'engagement au fair play, le comportement éthique et l'intégrité de l'entraîneur que de l'athlète."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ec894bb-9c1f-44a3-b1c0-fc75b84c9a2a",
                        "source_entry_id": "cad83273-8f77-3cca-b599-115cf00f68de",
                        "target_lang_word": "sportiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sportiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe26b14-5be3-3a42-8b66-368dec1e02d4",
                                        "entry_id": "eb3309bc-9910-344d-898f-c9d91fb0b4bf",
                                        "glosses": [
                                            "the state of being sportive"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e544cf-7698-4cd3-b9d2-43c3f0e32b4c",
                                                "sense_id": "2fe26b14-5be3-3a42-8b66-368dec1e02d4",
                                                "text": "You will see the tame horse in the paddock gallop about for his pleasure, and the wild horse on the prairie will start and run for miles in mere sportiveness."
                                            },
                                            {
                                                "example_id": "1b76021c-e3ab-40e3-b360-5902c08f1e37",
                                                "sense_id": "2fe26b14-5be3-3a42-8b66-368dec1e02d4",
                                                "text": "Then he would play with his vixen, she encouraging him with her pretty sportiveness."
                                            },
                                            {
                                                "example_id": "9ae4e4d9-4728-4bd4-9a68-4943188a2ffb",
                                                "sense_id": "2fe26b14-5be3-3a42-8b66-368dec1e02d4",
                                                "text": "OMAR KHAYYAM, astronomer-poet of Persia, born at Naishapur, in Khorassan; lived in the later half of the 11th century, and died in the first quarter of the 12th; wrote a collection of poems which breathe an Epicurean spirit, and while they occupy themselves with serious problems of life, do so with careless sportiveness, intent he on the enjoyment of the sensuous pleasures of life, like an easy-going Epicurean."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae4b00a6-89c6-4ff7-b5e6-8cb6cfeb66d5",
                        "source_entry_id": "cad83273-8f77-3cca-b599-115cf00f68de",
                        "target_lang_word": "sportsmanship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sportsmanship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cacd9ae-947f-3661-ae7e-362f80eb2eb7",
                                        "entry_id": "43292b8c-248d-30a0-9584-87c1c0e4299f",
                                        "glosses": [
                                            "The good attitude/behaviour displayed by players of a game; fairness, determination, magnanimity, courtesy towards opponents, and winning or losing gracefully."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f1d6804-6ce7-3dc5-bd36-dfdee89e2b92",
                                        "entry_id": "43292b8c-248d-30a0-9584-87c1c0e4299f",
                                        "glosses": [
                                            "The behaviour exhibited in playing sports, either good or bad."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e70b63cf-b6d3-44ab-8a46-2bf48fc9f300",
                                                "sense_id": "5f1d6804-6ce7-3dc5-bd36-dfdee89e2b92",
                                                "text": "James showed good sportsmanship in consoling Shankar after his wicket fell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
