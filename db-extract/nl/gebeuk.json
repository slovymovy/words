                            {
                                "example_id": "9212952d-da16-4ec1-853b-c47fcc961d45",
                                "sense_id": "20037e79-4d2d-3bbf-bda6-df5d67418b03",
                                "text": "De refozuil wordt niet allereerst bedreigd door het gebeuk van buitenaf, maar door interne secularisatie, stelt dr. A. J. Kunz. Het besef dat we hier niet thuis zijn maar onderweg zijn naar een hemels vaderland, is verdwenen."
                            },
                            {
                                "example_id": "23e211f7-afd9-4de1-b65f-b49c7758e82b",
                                "sense_id": "20037e79-4d2d-3bbf-bda6-df5d67418b03",
                                "text": "Op Spaanse mannen met dynamiet in hun benen als Alejandro Valverde is het bijvoorbeeld – zo kort na de Ronde van Baskenland - nog even wachten. Peter Sagan, de winnaar van 2013, laat de Brabantse Pijl ook links liggen, na al het gebeuk op de kasseien."
                            }
                        ]
