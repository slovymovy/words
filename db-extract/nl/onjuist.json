                "senses": [
                    {
                        "sense_id": "22a4b84e-6a59-3e2c-8c18-19d1cc2ed90a",
                        "entry_id": "a8b05a68-f3d1-35c5-9524-8ab26716bdb6",
                        "glosses": [
                            "niet correct"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ae678c-d1d8-41d2-b5a0-d65e8363e1e0",
                                "sense_id": "22a4b84e-6a59-3e2c-8c18-19d1cc2ed90a",
                                "text": "‘Er staat bijvoorbeeld dat we failliet gaan’, zegt Atasoy. ‘Dat is aantoonbaar onjuist. We hebben de rechter ook laten zien dat het niet klopt. Dan moet dat toch uit het rapport geschrapt worden?’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "215cf660-5309-4942-9ee6-ee0abd7058c1",
                        "source_entry_id": "a8b05a68-f3d1-35c5-9524-8ab26716bdb6",
                        "source_sense_id": "22a4b84e-6a59-3e2c-8c18-19d1cc2ed90a",
                        "source_sense_description": "niet correct",
                        "target_lang_word": "falsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff17d1a3-cc86-3bff-9610-c16f5ab9a485",
                                        "entry_id": "06ea1b59-bec7-358a-b4e6-92e43840872b",
                                        "glosses": [
                                            "unrichtig (durch Irrtum oder Unwissenheit), tatsächlich anders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630bc6f6-d1f4-44bd-af3a-8ff675453bc8",
                                                "sense_id": "ff17d1a3-cc86-3bff-9610-c16f5ab9a485",
                                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                                            },
                                            {
                                                "example_id": "1f0b1303-aa27-45f0-8f77-015fd5ee78c0",
                                                "sense_id": "ff17d1a3-cc86-3bff-9610-c16f5ab9a485",
                                                "text": "Was habe ich denn falsch gemacht?"
                                            },
                                            {
                                                "example_id": "f420e7de-46b3-4123-95f3-d02edd99221f",
                                                "sense_id": "ff17d1a3-cc86-3bff-9610-c16f5ab9a485",
                                                "text": "„Wir produzieren falsch, wir bauen falsch und wohnen falsch, wir bewegen uns falsch, und wir ernähren uns falsch.“ (Fritz Kuhn, September 2006)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c1dbe29-4b6b-33e1-b645-5ea8e136ce75",
                                        "entry_id": "06ea1b59-bec7-358a-b4e6-92e43840872b",
                                        "glosses": [
                                            "gelogen, nicht den Tatsachen entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b654eaf-0125-455f-8a2e-49fb3f46f645",
                                                "sense_id": "6c1dbe29-4b6b-33e1-b645-5ea8e136ce75",
                                                "text": "Du sollst nicht falsch Zeugnis reden."
                                            },
                                            {
                                                "example_id": "6f023b0d-093f-4f1a-99f5-40e759ee10ef",
                                                "sense_id": "6c1dbe29-4b6b-33e1-b645-5ea8e136ce75",
                                                "text": "Eine falsche Aussage kann unter Strafe gestellt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be65ba24-d09c-3d44-9cbb-536a904f0f71",
                                        "entry_id": "06ea1b59-bec7-358a-b4e6-92e43840872b",
                                        "glosses": [
                                            "betrügerisch"
                                        ],
                                        "tags": [
                                            "beim Spiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b4d788c-7267-456e-ba7d-59fb08039136",
                                                "sense_id": "be65ba24-d09c-3d44-9cbb-536a904f0f71",
                                                "text": "Ich glaube, hier spielt einer falsch!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3b9fc710-161f-3387-bd56-9ee03528d4cd",
                                        "entry_id": "06ea1b59-bec7-358a-b4e6-92e43840872b",
                                        "glosses": [
                                            "nachgemacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d5af372-6179-4acf-b278-cac4bfdc60cf",
                                                "sense_id": "3b9fc710-161f-3387-bd56-9ee03528d4cd",
                                                "text": "Im Fasching trat sie mit falschen Zähnen als Vampir auf."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6ec8b5e9-6269-3b59-a426-ec4c4ee3561b",
                                        "entry_id": "06ea1b59-bec7-358a-b4e6-92e43840872b",
                                        "glosses": [
                                            "verlogen"
                                        ],
                                        "tags": [
                                            "als Charakter"
                                        ],
                                        "examples": [
                                            {
