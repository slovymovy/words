                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db88dbc-e8b1-42a5-9991-e304e4865108",
                                                "sense_id": "8118ff68-0e1f-3031-9cb2-b2a23de32ca1",
                                                "text": "Ce nouveau Orange Orange est encore plus sucré, lustré, raffiné, destiné aux DJ, aussi wannabe soient-ils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dadb2325-2588-416b-902c-711bd06477b6",
                        "source_entry_id": "87ca364b-c4a5-3c44-b0e6-c498dde1de2b",
