                                                "sense_id": "e294fc40-ab6b-32f1-a4f6-686468504dcf",
                                                "text": "glass, crystal, gems, and other compact bodies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81d71a9d-b3b3-3aba-a848-5d950b491455",
                                        "entry_id": "5b637d60-c6a4-3f08-ba5f-5ba07128fbea",
