            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47d06b65-5f76-3884-8c4f-845bc1ce03df",
                    "sense_definition": "A quantity of money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid a large <w>sum</w> for the vintage car.",
                            "target_lang_translations": {
                                "ru": "Он заплатил большую <w>сумму</w> за старинный автомобиль.",
                                "zh": "他花了一大笔<w>金额</w>买了那辆老爷车。"
                            }
                        },
                        {
                            "text": "She managed to save a tidy <w>sum</w> over the years.",
                            "target_lang_translations": {
                                "ru": "Ей удалось скопить приличную <w>сумму</w> за эти годы.",
                                "zh": "这些年来，她设法存下了一笔可观的<w>款项</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amount",
                        "figure",
                        "total"
                    ],
                    "common_phrases": [
                        "lump sum",
                        "large sum",
                        "tidy sum",
                        "sum of money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное количество денег.",
                        "zh": "一笔钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумма",
                                "target_lang_sense_clarification": "денег"
                            }
                        ],
                        "zh": [
                            {
