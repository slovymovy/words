        "fr-extract.jsonl": [
            {
                "entry_id": "079f32e1-0ca5-3670-903a-49adf94bdfc0",
                "word": "palpitation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f8d0afcd-5cf1-4712-b8ae-3332031493c2",
                        "entry_id": "079f32e1-0ca5-3670-903a-49adf94bdfc0",
                        "tags": [
