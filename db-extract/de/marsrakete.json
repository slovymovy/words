                "senses": [
                    {
                        "sense_id": "87ab2849-74cb-330f-b8de-5f84f54590ec",
                        "entry_id": "52b76e0c-7d26-3d86-9edd-ab1fce871b27",
                        "glosses": [
                            "Rakete, die ihre Nutzlast bis zum Planeten Mars bringen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de5a8116-f7a0-4f33-b743-7afd752dd6a8",
                                "sense_id": "87ab2849-74cb-330f-b8de-5f84f54590ec",
                                "text": "„Pirquet veröffentlicht 1928 sein Buch ‚Die Möglichkeiten der Weltraumfahrt‘ und berechnet Antriebe einer Marsrakete sowie Flugbahnen zur Venus.“"
                            },
                            {
                                "example_id": "813b1163-42e9-402c-844b-62f9598b2084",
                                "sense_id": "87ab2849-74cb-330f-b8de-5f84f54590ec",
                                "text": "„Die Marsrakete hat eine Schubkraft von 127 800kN, verglichen mit 7607 kN der Falcon 9.“"
                            },
                            {
                                "example_id": "134b1105-dedf-43a0-89fb-0ac9a1b69fcd",
                                "sense_id": "87ab2849-74cb-330f-b8de-5f84f54590ec",
                                "text": "„In einer Ecke steht das große Modell einer Marsrakete.“"
                            }
                        ],
