                        "translation_id": "b4ffc1d9-cf94-49ba-85b5-1daf1b55f5bf",
                        "source_entry_id": "b8962358-2558-3e7b-a378-2ccaedbec8b3",
                        "source_sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                        "source_sense_description": "artillery soldier who maintains and operates a cannon, or some other piece of heavy artillery",
                        "target_lang_word": "Kanonier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanonier",
