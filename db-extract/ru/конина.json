                "senses": [
                    {
                        "sense_id": "b3572995-3e7f-3764-ba1d-cc29bc72b206",
                        "entry_id": "001a4ec8-3ef9-3b69-b736-1a0bbd0bbeb8",
                        "glosses": [
                            "кулин. мясо лошади, употребляемое в пищу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f80009e5-c208-4a4f-9d26-2199c32ba103",
                                "sense_id": "b3572995-3e7f-3764-ba1d-cc29bc72b206",
                                "text": "Кроме говядины и зверины, в древности употреблялась и конина."
                            },
                            {
                                "example_id": "a08e66dc-a8e2-4b59-8569-d56fed53f58b",
                                "sense_id": "b3572995-3e7f-3764-ba1d-cc29bc72b206",
                                "text": "До сих пор помню прекрасный вкус котлет, приготовленных мамой из конины, купленной на базаре."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dcff416-6d30-3419-985c-d0b6858adc62",
                        "entry_id": "001a4ec8-3ef9-3b69-b736-1a0bbd0bbeb8",
                        "glosses": [
                            "гастрон. кушанье, приготовленное из такого мяса"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
