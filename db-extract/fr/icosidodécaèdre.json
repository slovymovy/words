                                "target_senses": [
                                    {
                                        "sense_id": "90081d1f-6654-32ed-bef7-9cc39b29577c",
                                        "entry_id": "ff8e84bf-86b0-32aa-84f7-567f5b5f0e74",
                                        "glosses": [
                                            "геометр. полуправильный многогранник, состоящий из 32 граней (12 правильных пятиугольников и 20 правильных треугольников)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e91e508a-8355-4bf8-8144-574525252565",
                                                "sense_id": "90081d1f-6654-32ed-bef7-9cc39b29577c",
                                                "text": "Это было удивительное пространство, напоминающее внутренность платоновского икосододекаэдра: не менее двух десятков углов, не столько встроенные, сколько вынесенные, как в центре Помпиду, коммуникации."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
