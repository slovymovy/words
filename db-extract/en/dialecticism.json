                    {
                        "translation_id": "358dacfc-ad5b-49e4-a23e-21133c5b5e40",
                        "source_entry_id": "dcaa85c2-dba9-36fb-bed3-80cf509da692",
                        "source_sense_id": "b91df82d-8eaa-3237-92cf-43b7da0fe429",
