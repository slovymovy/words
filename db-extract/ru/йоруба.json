                        ]
                    },
                    {
                        "translation_id": "a9670fd7-ea8d-4a9f-9859-0b0a3e85d21d",
                        "source_entry_id": "c7850b39-e561-3fa3-bcf3-e7b0ebb267ae",
                        "source_sense_description": "народ",
                        "target_lang_word": "Yoruba",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yoruba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10d3036d-9e8f-3ea2-be16-131234f7575d",
                                        "entry_id": "f4d0f045-5c32-34e8-9280-0a207f3651f7",
                                        "glosses": [
                                            "hauptsächlich im Südwesten Nigerias lebendes Volk"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b765bb2f-62e4-4c7e-a169-35c59cb726de",
                                                "sense_id": "10d3036d-9e8f-3ea2-be16-131234f7575d",
                                                "text": "„Bei vielen Völkern sind auch Geschichten lebendig, die man Ursprungsmythen nennt; die Fulbe in weiten Teilen Westafrikas, die Yoruba und Edo im heutigen Nigeria, die nach ihrer Sprache Bantu-Völker genannten Gruppen und viele andere afrikanische Völker kennen solche Überlieferungen, in denen von Wanderungen aus einer fernen Heimat in einer mythischen Vergangenheit die Rede ist.“"
                                            },
                                            {
                                                "example_id": "ecc6383b-311c-4921-b723-b44ccd8c9d22",
                                                "sense_id": "10d3036d-9e8f-3ea2-be16-131234f7575d",
                                                "text": "„Bei den Yoruba ist es Brauch, Zwillinge Taiwo und Kehinde zu nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65e0185d-95e9-350b-ba16-6384c72cc922",
                                        "entry_id": "f4d0f045-5c32-34e8-9280-0a207f3651f7",
                                        "glosses": [
                                            "ein Angehöriger des gleichnamigen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42294375-24c7-4daf-848f-e845a2db3051",
                                                "sense_id": "65e0185d-95e9-350b-ba16-6384c72cc922",
                                                "text": "„Er ist Yoruba, kommt aus Ilorin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Yoruba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b772aaf4-920b-393a-93d7-f0e296febdfa",
                                        "entry_id": "f99caead-a9d1-3505-8c9d-305b505fc6a6",
                                        "glosses": [
                                            "in Nigeria, Benin und Togo gesprochenes Dialektkontinuum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faaa059d-f3e7-499e-85c3-a1fa4f26265b",
                                                "sense_id": "b772aaf4-920b-393a-93d7-f0e296febdfa",
                                                "text": "„Die rund 15 Yoruboid-Sprachen sind mit dem Yoruba relativ eng verwandt; sie werden von etwa 22 Millionen Menschen in Südwest-Nigeria, Benin und Togo gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1f6c034-0225-3f0a-a28c-8c2ffaccb845",
                                        "entry_id": "f99caead-a9d1-3505-8c9d-305b505fc6a6",
                                        "glosses": [
                                            "die Standardvarietät der Dialekte, die als eine der Nationalsprache Benins und Nigerias gilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a839d46-4d57-4290-a750-b38ea844bbbd",
                                                "sense_id": "c1f6c034-0225-3f0a-a28c-8c2ffaccb845",
                                                "text": "„Nasallaute werden im Yoruba nach französischem Muster durch Anhängen eines n an den Vokal dargestellt, dessen ursprünglicher Lautwert jedoch erhalten bleibt.“"
                                            },
                                            {
                                                "example_id": "0b00fb87-7273-40dd-97f1-9751f5729050",
                                                "sense_id": "c1f6c034-0225-3f0a-a28c-8c2ffaccb845",
                                                "text": "„Yoruba erlaubt bei einem dreistelligen Verb wie geben lediglich die strukturelle Realisierung des mittleren Arguments (=Rezipient).“"
                                            },
                                            {
                                                "example_id": "ff93a7f6-d2cc-49c8-934d-e33d0338db48",
                                                "sense_id": "c1f6c034-0225-3f0a-a28c-8c2ffaccb845",
                                                "text": "„In Yoruba beginnen viele Vornamen in Bezug auf Elfen mit Win.“"
                                            },
                                            {
                                                "example_id": "e11fed89-f404-42c6-8b4c-31ba5706f9f9",
                                                "sense_id": "c1f6c034-0225-3f0a-a28c-8c2ffaccb845",
                                                "text": "„Im schnellsten Yoruba bellte er etwas ins Telefon und beendete nach einer Minute das Gespräch.“"
                                            },
                                            {
                                                "example_id": "64da37b4-a362-42f6-8f12-5019266ea381",
                                                "sense_id": "c1f6c034-0225-3f0a-a28c-8c2ffaccb845",
                                                "text": "„Malam Abdul-Nur sagte was auf Yoruba zu ihm und ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97fde699-7379-4d43-94ef-498ad08f6a06",
                        "source_entry_id": "c7850b39-e561-3fa3-bcf3-e7b0ebb267ae",
                        "source_sense_description": "народ",
                        "target_lang_word": "yoruba",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoruba",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd84180-918c-39ad-a880-ca320a3ba903",
                                        "entry_id": "1f2483ee-3ef3-393d-a19e-f0fe3ba4a0ab",
                                        "glosses": [
                                            "Relatif aux Yorubas en tant que peuple, à leur culture, à leur langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751de4b5-13bd-4aa9-aae0-2eb743e882ae",
                                                "sense_id": "1fd84180-918c-39ad-a880-ca320a3ba903",
                                                "text": "Ife fut fondée vers 500 EC par le peuple yoruba — peuple de langue kwa du sud-ouest du Nigeria et du Bénin — mais ne prospéra qu’au début du 2^(ème) millénaire de notre ère."
                                            },
                                            {
                                                "example_id": "41fe2244-698b-4ac8-ac08-7e5a860d762e",
                                                "sense_id": "1fd84180-918c-39ad-a880-ca320a3ba903",
                                                "text": "Considérés comme une bénédiction sacrée, les jumeaux sont privilégiés dans la société yoruba."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoruba",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e9651a-e9a3-3064-b7e7-659bf217b414",
                                        "entry_id": "4c2037b1-93b6-3fd7-acff-e02514e54fca",
                                        "glosses": [
                                            "Langue tonale de la famille nigéro-congolaise parlée dans certaines régions du Nigeria, du Bénin et du Togo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e306a7c4-60b0-4db9-afea-09b042ccb89f",
                                                "sense_id": "a2e9651a-e9a3-3064-b7e7-659bf217b414",
                                                "text": "Le terme ibeji, qui désigne les jumeaux en yoruba, se réfère également à une sorte de divinité qui « annonce généralement la paix, le progrès, la prospérité et porte chance aux parents », explique le oba (roi)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7313bca2-c8c3-47a5-bdac-2dff0369ab20",
                        "source_entry_id": "c7850b39-e561-3fa3-bcf3-e7b0ebb267ae",
                        "source_sense_description": "язык",
                        "target_lang_word": "Yoruba",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yoruba",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d06447-3d55-311e-afa4-b1fff3e5d0f8",
                                        "entry_id": "baded3a2-0b56-324d-a295-b00188312792",
                                        "glosses": [
                                            "A member of an ethnic group or tribe living mainly in southwest Nigeria, southern Benin, and eastern Togo and, as well as in communities elsewhere in West Africa, United States, Brazil and Cuba."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3e2b34-bb59-4199-bb4c-b9004eeb3964",
                                                "sense_id": "e8d06447-3d55-311e-afa4-b1fff3e5d0f8",
                                                "text": "Approximately 40 percent of Yorubas in Nigeria are Muslim and 60 percent are Christian. […] Its members express a strong preference for being among Yorubas during their worship service: “Since I am a Yoruba and we Yorubas have our own Church. . . .\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Yoruba",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae324666-b12c-3ffd-a627-fb6a421e443d",
                                        "entry_id": "0e144c23-ea1f-3fa6-9a76-35fc008a17ca",
                                        "glosses": [
                                            "A sub-Saharan language. It belongs to the Benue-Congo branch of the Niger-Congo language family, and has nearly 40 million speakers in Nigeria, Benin, Togo, and Sierra Leone, as well as communities in The United States, Brazil and Cuba."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ce326b-750d-4ac2-9e15-4254b8147c43",
                                                "sense_id": "ae324666-b12c-3ffd-a627-fb6a421e443d",
                                                "text": "In the parlour, she could hear Aunty Biola attempting to teach her father Yoruba, collapsing into helpless giggles whenever he mispronounced his vowels, giving them the flat English sound instead of lifting them upwards with the slight outward puff of breath that was required."
                                            },
                                            {
                                                "example_id": "b7d7ac11-a953-4e87-8660-c652ebd74914",
                                                "sense_id": "ae324666-b12c-3ffd-a627-fb6a421e443d",
                                                "text": "Comparative wordlists of two dialects of Yoruba with Igala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea4c92e-262f-3cc8-a973-44513f0b083e",
                                        "entry_id": "0e144c23-ea1f-3fa6-9a76-35fc008a17ca",
                                        "glosses": [
                                            "An African traditional religion which spawned various offshoots in the Americas in the 15th to 19th centuries, including santería and Lucumí. (See Yoruba religion.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002cb81d-4bae-4741-9935-1d3b21bcb118",
                                                "sense_id": "4ea4c92e-262f-3cc8-a973-44513f0b083e",
                                                "text": "The Yoruba practitioner describes it as a condition where a man's semen will flow out of the vagina before fertilization can take place."
                                            },
                                            {
                                                "example_id": "144a05cf-81b4-482a-beee-4a924caa35c7",
                                                "sense_id": "4ea4c92e-262f-3cc8-a973-44513f0b083e",
                                                "text": "The Yoruba practitioner has no difficulty in knowing the difference between what we have classified as magic, medicine or sorcery."
                                            },
                                            {
                                                "example_id": "76cf27e0-dcaa-4f74-a9fe-6c05d69c6cb3",
                                                "sense_id": "4ea4c92e-262f-3cc8-a973-44513f0b083e",
                                                "text": "This is because when the Yoruba practitioner heals a stomach ache, he uses medicine, when he protects someone from accident, he uses magic, and when he invokes for the purpose of harming or killing a person, he uses sorcery."
                                            },
                                            {
                                                "example_id": "4b387e63-a886-435e-9b37-400d61314919",
                                                "sense_id": "4ea4c92e-262f-3cc8-a973-44513f0b083e",
                                                "text": "She was not a Yoruba practitioner but nevertheless had asked for a “birth reading” for her newborn daughter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
