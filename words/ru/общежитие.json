                        "нормы общежития",
                        "человеческое общежитие"
                    ],
                    "target_lang_definitions": {
                        "en": "The shared life, social relations, and norms arising from living together in a community.",
                        "pl": "Wspólne życie ludzi, zasady współżycia społecznego i relacje wynikające ze wspólnego zamieszkiwania."
