                                    },
                                    {
                                        "sense_id": "30fc09f3-3be0-34ed-8d4b-80d240a27f44",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "počet 18"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d30ac0a-c6de-4931-9fa5-725a9b22be64",
                                                "sense_id": "30fc09f3-3be0-34ed-8d4b-80d240a27f44",
                                                "text": "Osmnáctka hráčů se rozdělila na straší a mladší."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2669a8-50ae-3550-8448-e57d3fe54b34",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "tým hráčů do 18 let"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa538b38-8568-43e7-a693-b46f3733d12f",
                                                "sense_id": "ae2669a8-50ae-3550-8448-e57d3fe54b34",
                                                "text": "Česká hokejová osmnáctka zdolala v úvodním utkání Turnaje pěti zemí ve švédském městě Tjörn Finsko 2:1 po samostatných nájezdech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7684c67c-a774-3a44-abb3-d996c9563567",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "dívka ve věku 18 let"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf7463c-352f-42b4-acb6-4d206c9bb1de",
                                                "sense_id": "7684c67c-a774-3a44-abb3-d996c9563567",
                                                "text": "Potřebuje rozevřené oči osmnáctek, kterým vypráví o svých geniálních nápadech."
                                            },
                                            {
                                                "example_id": "4d582712-5794-427f-8ae6-9115bbf36bb3",
                                                "sense_id": "7684c67c-a774-3a44-abb3-d996c9563567",
                                                "text": "Na svém středečním narozeninovém koncertě v Lucerně se zaskvěla postavou osmnáctky!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122ec4ba-5296-31d3-8a50-a40799f15052",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "ten, kdo je na 18. místě žebříčku nebo jiného pořadí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce5321c-3698-4bbf-ba85-49123d85cff9",
                                                "sense_id": "122ec4ba-5296-31d3-8a50-a40799f15052",
                                                "text": "Světová osmnáctka hledá pomoc rovněž u fyzioterapeuta Pavla Koláře, kterému věří, a v motolské nemocnici podstoupil Štěpánek kontrolní vyšetření."
                                            },
                                            {
                                                "example_id": "754430c7-81aa-434b-b501-edbf5e5a1ec2",
                                                "sense_id": "122ec4ba-5296-31d3-8a50-a40799f15052",
                                                "text": "„Radost samozřejmě mám, ale euforie to není,“ řekla turnajová osmnáctka v rozhovoru pro Český rozhlas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90bc6ba2-326d-3edc-af4f-5d054249492c",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "silnice č. 18"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3987631-81fe-447b-bf40-66fc01f8d792",
                                                "sense_id": "90bc6ba2-326d-3edc-af4f-5d054249492c",
                                                "text": "Rekonstrukce chodníku podél osmnáctky vypadla z plánu investic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f37587f-71ae-3a1b-8b72-e641fe5cd6f2",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "tramvaj, autobus, trolejbus atp. č. 18"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a76bf4f-96f8-4845-88ac-07a73dc0e0f8",
                                                "sense_id": "2f37587f-71ae-3a1b-8b72-e641fe5cd6f2",
                                                "text": "Nasednu na Albertově na osmnáctku, načež vyděšeně zjistím, že jedu opačným směrem."
                                            },
                                            {
                                                "example_id": "abda90c2-3348-4552-867a-08c7db340d31",
                                                "sense_id": "2f37587f-71ae-3a1b-8b72-e641fe5cd6f2",
                                                "text": "Využívá autobusovou osmnáctku asi třikrát měsíčně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0fd881c-c954-3d6d-82f4-084d76c03c8f",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "18stupňové pivo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2dfbf9-81a0-4013-b147-88823e842e92",
                                                "sense_id": "d0fd881c-c954-3d6d-82f4-084d76c03c8f",
                                                "text": "Obyčejnou desítku jsem tu neměl, protože jsme čepovali vzácná, a tudíž vícestupňová piva. Musím ale přiznat, že jsem ochutnal jednu patnáctku a osmnáctku a byla to docela síla,\" zhodnotil vydařenou akci Fikr."
                                            },
                                            {
                                                "example_id": "2c717d80-1ce0-435f-b33c-fbd2b361d218",
                                                "sense_id": "d0fd881c-c954-3d6d-82f4-084d76c03c8f",
                                                "text": "V naší Koutské pivnici jsme od pátku do neděle vytočili 72 padesátilitrových sudů desítky, 30 sudů dvanáctky, pět sudů čtrnáctky a tři sudy osmnáctky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4102e077-2b30-3fb3-a833-fcfd1315930e",
                                        "entry_id": "5429014a-0408-3cff-b2da-368c167b0749",
                                        "glosses": [
                                            "18. jamka na golfovém hřišti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eec843e-115d-4d38-8c7d-856422873439",
                                                "sense_id": "4102e077-2b30-3fb3-a833-fcfd1315930e",
                                                "text": "Nepříliš dlouhá osmnáctka s parem 73 byla otevřena v roce 1994."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
