                },
                {
                    "sense_id": "55cafd42-6d18-32e7-af4a-ae63b7170bca",
                    "sense_definition": "To a ridiculous or extreme degree; extremely.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rumors about the company's failure were <w>wildly</w> exaggerated.",
                            "target_lang_translations": {
                                "ru": "Слухи о крахе компании были <w>крайне</w> преувеличены.",
                                "tr": "Şirketin iflasına dair söylentiler <w>aşırı derecede</w> abartılmıştı."
                            }
                        },
                        {
                            "text": "Her new book was <w>wildly</w> successful all over the world.",
                            "target_lang_translations": {
                                "ru": "Её новая книга была <w>невероятно</w> успешной во всём мире.",
                                "tr": "Yeni kitabı tüm dünyada <w>inanılmaz</w> başarılı oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "exceedingly",
                        "incredibly",
                        "immensely"
                    ],
                    "antonyms": [
                        "slightly",
                        "moderately"
                    ],
                    "common_phrases": [
