        "fr-extract.jsonl": [
            {
                "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                "word": "commentateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89ebed32-d887-45ae-9f4f-65193545493a",
                        "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                        "tags": [
                            "plural"
                        ],
                        "form": "commentateurs"
                    },
                    {
                        "form_id": "f52b3350-f746-4734-9b22-44cb715cf96f",
                        "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                        "tags": [
                            "feminine"
                        ],
                        "form": "commentatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                        "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                        "glosses": [
                            "Auteur de commentaires littéraires, historiques, juridiques, sportifs, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7829a2d-dce5-407f-943b-a8e38c01814d",
                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                "text": "Mon livre, le voilà tel que je l'ai fait et tel qu'on doit le lire, avant que les commentateurs ne l'obscurcissent de leurs éclaircissements."
                            },
                            {
                                "example_id": "05ad6707-f832-4101-9a56-ae1ba2b45d7f",
                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                "text": "Raschi, en se cantonnant dans son rôle de commentateur, s'est attiré, lui, la reconnaissance de tous."
                            },
                            {
                                "example_id": "c5172410-8b07-41d8-afe0-2766e7aa83b2",
                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                "text": "Suivant les positions qu'ils adoptent à l'égard de l'évolution politique de Thèbes et des cités béotiennes, les commentateurs de Ps-Xénophon interprètent son allusion à l'intervention athénienne en Béotie de façons très différentes."
                            },
                            {
                                "example_id": "4c4ab3d0-45b1-40ff-941c-b65ba894c3b2",
                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                "text": "On écrit toujours de la même façon sur le plaisir du Prophète et la virginité d'Aïsha. Aucun commentateur n'a remis en cause ses prédécesseurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                        "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                        "glosses": [
                            "Celui qui fait divers commentaires sur ce qu’il ignore."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "48767fe4-3eb2-41dc-9273-9efc3e4fcf59",
                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                "text": "Au quotidien The Globe and Mail, à Toronto, les commentateurs grimpaient aux rideaux, montaient aux barricades, prédisaient l'érosion, la balkanisation imminente du Canada. Ici ? Presque rien, si peu, bof. Étonnant, non ?"
                            },
                            {
                                "example_id": "2c4991f7-ca5e-49e4-9ac5-a37bf0af2348",
                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                "text": "Le silence du docteur laissait le champ libre aux commentateurs; l'abbé Moulle s'élança dans l'arène."
                            },
                            {
                                "example_id": "72248a77-ea5c-45ed-9fb1-25c57b384eea",
                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                "text": "Pourquoi ? Parce que les journalistes politiques et autres commentateurs qui donnent le la sont rabougris du cervelet ? Infirmes de la comprenette à force de s'enfermer eux-mêmes dans la boite à chaussure des schémas normalisateurs ?"
                            },
                            {
                                "example_id": "bee66e26-e83d-44ce-bbd1-38518818ef61",
                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                "text": "son look a étonné, y compris ses collègues : un bandana aux motifs bleus sur le front lui donnant, selon les commentateurs, des airs de hippie, de biker ou d’Indien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4515dc51-ce48-4816-9594-e9cbe721fc89",
                        "source_entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                        "source_sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                        "source_sense_description": "Personne qui commente",
                        "target_lang_word": "commentator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commentator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb453a0-7729-4dab-a531-7877b5f5cb51",
                                                "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                                "text": "He was a commentator for football two years before retiring."
                                            },
                                            {
                                                "example_id": "d4ca3f88-0f00-4162-b552-b1dbbeb6c351",
                                                "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                                "text": "Specifically, and unforgivably, she restarted the Heathrow Third Runway bandwagon, which had been stalled for more than a decade and even declared dead by most commentators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb89546c-7160-338a-a49c-f5819d899f83",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "Synonym of historian or chronicler, a person who compiles an annotated history."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7bf2f0d-b348-320b-8569-642df43cab1a",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations and critical notes on a text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae0a37d8-78b2-334c-865f-8e51c16a0d70",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations of the law, particularly (historical) comparatively innovative European jurists in the 14th century, as opposed to earlier glossators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd34c356-c2f4-4f7b-b27d-11645ffe19f1",
                                                "sense_id": "ae0a37d8-78b2-334c-865f-8e51c16a0d70",
                                                "text": "It would be well into the fourteenth century before the commentators came into their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23cee1f2-9e0e-3fc0-9069-b4b83d2b7714",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations of biblical passages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "353966ef-0532-3cad-8963-d9a76c7724b0",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who provides an instantaneous description of a public event, particularly a sporting event, for a mass media audience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02fd0665-7f1e-3f76-9566-62630c7272bd",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who provides analysis or opinion on current events, especially for a mass media audience."
                                        ],
                                        "tags": [],
