{
    "word_family": [
        "bespatter",
        "spatterdash",
        "spatterdock"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a774b3c-159a-3b14-81c2-8525129a952d",
                    "sense_definition": "To splash someone or something with small droplets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passing truck <w>spattered</w> my coat with dirty puddle water.",
                            "target_lang_translations": {
                                "ru": "Проезжавший грузовик <w>обрызгал</w> моё пальто грязной водой из лужи."
                            }
                        },
                        {
                            "text": "Hot oil began to <w>spatter</w> the stove while he was frying the fish.",
                            "target_lang_translations": {
                                "ru": "Горячее масло стало <w>забрызгивать</w> плиту, пока он жарил рыбу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spattered with mud",
                        "spattered with paint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окатывать или пачкать мелкими каплями жидкости кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрызгивать",
                                "target_lang_sense_clarification": "покрывать брызгами (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "обрызгать",
                                "target_lang_sense_clarification": "покрыть брызгами (совершенный вид)"
                            },
                            {
                                "target_lang_word": "забрызгивать",
                                "target_lang_sense_clarification": "пачкать брызгами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                    "sense_definition": "To scatter or fly out in small droplets, especially on or against a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful because the sauce tends to <w>spatter</w> as it boils.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, потому что соус при кипении <w>разбрызгивается</w>."
                            }
                        },
                        {
                            "text": "Raindrops began to <w>spatter</w> against the windowpanes during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время бури капли дождя начали <w>барабанить</w> по оконным стёклам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter against",
                        "spatter on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разлетаться или падать мелкими каплями, брызгами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брызгать",
                                "target_lang_sense_clarification": "разлетаться каплями во все стороны"
                            },
                            {
                                "target_lang_word": "разбрызгиваться",
                                "target_lang_sense_clarification": "лететь в разные стороны брызгами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e305cf8-4e5b-30c5-b65c-975eaa3ce9c0",
                    "sense_definition": "To scatter or sprinkle a liquid in small droplets.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist liked to <w>spatter</w> paint across the canvas to create texture.",
                            "target_lang_translations": {
                                "ru": "Художнику нравилось <w>разбрызгивать</w> краску по холсту для создания текстуры."
                            }
                        },
                        {
                            "text": "He shook the wet brush to <w>spatter</w> water over the dry soil.",
                            "target_lang_translations": {
                                "ru": "Он встряхнул мокрую кисть, чтобы <w>побрызгать</w> водой на сухую почву."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter paint",
                        "spatter water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распылять или разбрасывать жидкость мелкими каплями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбрызгивать",
                                "target_lang_sense_clarification": "распылять каплями по поверхности"
                            },
                            {
                                "target_lang_word": "брызгать",
                                "target_lang_sense_clarification": "сыпать брызгами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                    "sense_definition": "To cover or lie scattered upon a surface, as if splashed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A few bright wildflowers <w>spattered</w> the grassy hillsides.",
                            "target_lang_translations": {
                                "ru": "Несколько ярких полевых цветов <w>усеивали</w> поросшие травой склоны холмов."
                            }
                        },
                        {
                            "text": "Faint stars were seen to <w>spatter</w> the clear evening sky.",
                            "target_lang_translations": {
                                "ru": "Тусклые звёзды <w>усыпали</w> ясное вечернее небо."
                            }
                        }
                    ],
                    "synonyms": [
                        "strew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Усеивать или пятнать поверхность, словно каплями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усеивать",
                                "target_lang_sense_clarification": "покрывать множеством разрозненных точек"
                            },
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "покрывать редкими вкраплениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb331a1f-0b01-3a79-9dbf-2fc1933dbc2a",
                    "sense_definition": "To send out or disperse non-liquid objects or words as if in droplets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nervous tourist <w>spattered</w> a few broken phrases in the local language.",
                            "target_lang_translations": {
                                "ru": "Нервничающий турист <w>выпалил</w> несколько ломаных фраз на местном языке."
                            }
                        },
                        {
                            "text": "The weapon began to <w>spatter</w> bullets across the abandoned warehouse wall.",
                            "target_lang_translations": {
                                "ru": "Оружие начало <w>сеять</w> пулями по стене заброшенного склада."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сыпать или беспорядочно выкрикивать слова, пули и т. п., словно брызгами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыпать",
                                "target_lang_sense_clarification": "произносить или выпускать прерывисто"
                            },
                            {
                                "target_lang_word": "выпаливать",
                                "target_lang_sense_clarification": "выбрасывать отрывисто слова или пули"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7197b2db-ab66-3b6b-9b69-15d90e3d7353",
                    "sense_definition": "To injure someone's reputation by aspersion; to defame or slander.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His political opponents sought to <w>spatter</w> his good name with wild rumors.",
                            "target_lang_translations": {
                                "ru": "Его политические оппоненты стремились <w>запятнать</w> его доброе имя дикими слухами."
                            }
                        },
                        {
                            "text": "The pamphlet was designed only to <w>spatter</w> the minister with malicious falsehoods.",
                            "target_lang_translations": {
                                "ru": "Памфлет был создан лишь для того, чтобы <w>опорочить</w> министра злобной ложью."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or historical texts to mean defame"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очернять репутацию или порочить чьё-либо имя (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "очернять доброе имя"
                            },
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "опорочить репутацию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "149023dc-2bdb-35ef-8670-f3c3b5b80210",
                    "sense_definition": "A spot or mark left by a substance splashed or scattered on a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wiped a small <w>spatter</w> of grease off his glasses.",
                            "target_lang_translations": {
                                "ru": "Он вытер с очков маленькую <w>каплю</w> жира."
                            }
                        },
                        {
                            "text": "There was a faint <w>spatter</w> of red ink on the desk.",
                            "target_lang_translations": {
                                "ru": "На столе виднелись мелкие <w>брызги</w> красных чернил."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter of blood",
                        "spatter of mud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятно или след от брызг жидкости на какой-либо поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брызга",
                                "target_lang_sense_clarification": "капля, след от брызг"
                            },
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "след от попавшей жидкости"
                            },
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "одиночный след жидкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22126315-cbae-3bef-b1b2-ce3b112fed6b",
                    "sense_definition": "A light spray or shower of droplets hitting a surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We felt a sudden <w>spatter</w> of raindrops on our faces.",
                            "target_lang_translations": {
                                "ru": "Мы почувствовали на лицах внезапные редкие <w>брызги</w> капель дождя."
                            }
                        },
                        {
                            "text": "The fountain threw an occasional <w>spatter</w> of cool water over the pedestrians.",
                            "target_lang_translations": {
                                "ru": "Фонтан время от времени осыпал прохожих <w>брызгами</w> прохладной воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter of rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий дождь или мелкая россыпь брызг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брызги",
                                "target_lang_sense_clarification": "россыпь летящих капель"
                            },
                            {
                                "target_lang_word": "крап",
                                "target_lang_sense_clarification": "накрапывающий редкий дождь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb83d7f-e85f-338d-8db1-489b0a084eec",
                    "sense_definition": "The sound produced by droplets hitting a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She listened to the quiet <w>spatter</w> of rain against the window.",
                            "target_lang_translations": {
                                "ru": "Она прислушивалась к тихому <w>стуку</w> дождя по окну."
                            }
                        },
                        {
                            "text": "The rhythmic <w>spatter</w> of fat in the pan signaled that breakfast was cooking.",
                            "target_lang_translations": {
                                "ru": "Ритмичное <w>шкворчание</w> жира на сковороде говорило о том, что завтрак готовится."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter of rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук ударяющихся о поверхность капель; барабанящий шум."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "дробный звук ударов капель"
                            },
                            {
                                "target_lang_word": "шуршание",
                                "target_lang_sense_clarification": "шорох или дробь дождя"
                            },
                            {
                                "target_lang_word": "шкворчание",
                                "target_lang_sense_clarification": "звук брызжущего горячего жира"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "361c3a62-c36b-31d1-bad3-c3ca30ffc90e",
                    "sense_definition": "A rapid burst or succession of sharp sounds resembling drops striking a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A brief <w>spatter</w> of applause greeted the guest speaker.",
                            "target_lang_translations": {
                                "ru": "Приглашённого оратора встретили короткие редкие <w>аплодисменты</w>."
                            }
                        },
                        {
                            "text": "Soldiers ducked as a distant <w>spatter</w> of gunfire echoed through the alley.",
                            "target_lang_translations": {
                                "ru": "Солдаты пригнулись, когда по переулку эхом прокатилась далёкая <w>дробь</w> выстрелов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter of applause",
                        "spatter of gunfire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая серия отрывистых звуков (например, редких аплодисментов или выстрелов)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "внезапный короткий звук аплодисментов или хлопков"
                            },
                            {
                                "target_lang_word": "дробь",
                                "target_lang_sense_clarification": "отрывистые звуки выстрелов или хлопков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c185f31b-6cfd-37ed-abbb-3caa64ab3fb5",
                    "sense_definition": "A scattered collection or grouping of small objects or features.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_splash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child had a light <w>spatter</w> of freckles across his nose.",
                            "target_lang_translations": {
                                "ru": "Нос ребёнка покрывала лёгкая <w>россыпь</w> веснушек."
                            }
                        },
                        {
                            "text": "A careless <w>spatter</w> of papers covered the director's broad oak desk.",
                            "target_lang_translations": {
                                "ru": "Широкий дубовый стол директора был небрежно <w>завален</w> бумагами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spatter of freckles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочная россыпь или скопление мелких предметов или отметин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "россыпь",
                                "target_lang_sense_clarification": "рассыпанные мелкие объекты, веснушки"
                            },
                            {
                                "target_lang_word": "крапинки",
                                "target_lang_sense_clarification": "мелкие пятнышки или крапины"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}