                },
                {
                    "sense_id": "c526adc1-dbcc-3d48-aae3-606fd4050054",
                    "sense_definition": "To perform operations on data, information, or materials to change or preserve them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer <w>processes</w> millions of calculations per second.",
                            "target_lang_translations": {
                                "ru": "Компьютер <w>обрабатывает</w> миллионы вычислений в секунду.",
                                "tr": "Bilgisayar saniyede milyonlarca hesaplama <w>işler</w>.",
                                "zh": "计算机每秒钟能<w>处理</w>数百万次计算。"
                            }
                        },
                        {
                            "text": "This factory <w>processes</w> raw milk into cheese and yogurt.",
                            "target_lang_translations": {
                                "ru": "Этот завод <w>перерабатывает</w> сырое молоко в сыр и йогурт.",
                                "tr": "Bu fabrika ham sütü <w>işleyerek</w> peynir ve yoğurda dönüştürür.",
                                "zh": "这家工厂将生乳<w>加工</w>成奶酪和酸奶。"
                            }
