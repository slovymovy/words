                "senses": [
                    {
                        "sense_id": "482f9aee-33d1-3498-a413-9cfb83cc016b",
                        "entry_id": "437c230d-1595-3233-8998-4f533d417724",
                        "glosses": [
                            "Laufen auf asphaltierten Straßen oder Wegen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "6b73cb20-539f-490b-99c3-9d0a03c2de81",
                                "sense_id": "482f9aee-33d1-3498-a413-9cfb83cc016b",
                                "text": "„Nach meinem persönlichen Empfinden sind beim Asphaltlaufen auch nicht die Belastungen der knöchernen oder faszial/muskulären Strukturen das Problem, denn die werden auf weichen Untergründen, z.B. Waldboden oder Sand, deutlich mehr gefordert.“"
                            },
                            {
                                "example_id": "7d2af453-8ede-4ed1-b1f1-88c2972b1dff",
                                "sense_id": "482f9aee-33d1-3498-a413-9cfb83cc016b",
                                "text": "„Die flachen Etappen waren einfach zu langweilig und Asphaltlaufen tödlich für die Füße.“"
                            },
                            {
                                "example_id": "b58f8db2-4777-4196-8ec8-e1d942a559c2",
                                "sense_id": "482f9aee-33d1-3498-a413-9cfb83cc016b",
                                "text": "„Der Schuh drückt nicht und die Dämpfung ist perfekt fürs Asphaltlaufen.“"
                            },
                            {
                                "example_id": "45b0f8ff-6db3-4e81-9c1f-2dc0c990d10e",
                                "sense_id": "482f9aee-33d1-3498-a413-9cfb83cc016b",
                                "text": "„Das Asphaltlaufen habe ich mir jetzt fast abgewöhnt, und ich bin hauptsächlich im Wald auf Wegen und Trails unterwegs.“"
                            },
                            {
                                "example_id": "3e16a2be-3e86-470b-aabb-ccc3571312b1",
                                "sense_id": "482f9aee-33d1-3498-a413-9cfb83cc016b",
                                "text": "„Viel Spaß trotzdem beim Asphaltlaufen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
