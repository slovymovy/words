                                "example_id": "0d2b9a0e-4c73-4526-86ca-c2327e59fe74",
                                "sense_id": "8780181f-fe99-368d-932c-41917059b99d",
                                "text": "seeing Mrs. Bute's beady eyes"
                            },
                            {
                                "example_id": "c2e1eafd-3a69-4549-9fec-e24ce333fc2f",
                                "sense_id": "8780181f-fe99-368d-932c-41917059b99d",
                                "text": "I shivered in every limb, and a cold beady dew sprang out on my temples as I stood with eyes riveted on the spectral figure before me."
                            }
