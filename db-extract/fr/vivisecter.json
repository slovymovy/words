                "senses": [
                    {
                        "sense_id": "ba9c889f-c299-3fe8-ba18-10f05089e907",
                        "entry_id": "8a455c73-abd2-3cac-9b1c-92407f05de76",
                        "glosses": [
                            "Disséquer (un animal vivant)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3297e85f-6a5c-4937-93af-dbf3f1b835db",
                                "sense_id": "ba9c889f-c299-3fe8-ba18-10f05089e907",
                                "text": "Un homme qui aurait de la science, non la semblance, mais la substance, demanderait-il à l'anatomiste et au physiologiste d'user leur imagination à bâtir des organismes nouveaux, des chimères, au lieu de disséquer et de vivisecter les animaux de l'inconsciente nature?"
                            },
                            {
                                "example_id": "73294f36-d4d9-4ffb-b54b-e737659a4a37",
                                "sense_id": "ba9c889f-c299-3fe8-ba18-10f05089e907",
                                "text": "N’allais-je pas, moi, vivisecter longuement une âme ?"
                            }
                        ]
                    }
