        "fr-extract.jsonl": [
            {
                "entry_id": "d6156350-3db3-3d80-8586-1086bf36df0e",
                "word": "paronym",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8274eac8-0912-4337-996c-0dfe5b370602",
                        "entry_id": "d6156350-3db3-3d80-8586-1086bf36df0e",
                        "tags": [
                            "plural"
                        ],
                        "form": "paronyms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45acd234-f721-304d-9cea-0752e8a7c9fe",
                        "entry_id": "d6156350-3db3-3d80-8586-1086bf36df0e",
                        "glosses": [
                            "Mot étymologiquement apparenté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb5c7fb-0d63-431b-9bb3-991f40c69a8b",
                                "sense_id": "45acd234-f721-304d-9cea-0752e8a7c9fe",
                                "text": "Words are said to be Paronyms when they are derived from the same root, whether that root belongs to the original English (Anglo-Saxon) stock, or has been introduced into the language from some other tongue. For instance, the following words are paronyms, being all derived from the Latin root, signifying to put or place: compose, depose, interpose, oppose, dispose, impose, expose, repose, transpose, propose, and suppose."
                            },
                            {
                                "example_id": "0009b783-047d-4db5-b0c1-5d7ed924a7da",
                                "sense_id": "45acd234-f721-304d-9cea-0752e8a7c9fe",
                                "text": "Paronyms are morphologically variant (and, for the most part meaning related, but not univocal) n-tuples derived (synchronically) from a common root. […] for example ‘explain’, ‘explanation’, ‘explicable’ and ‘explicability’, and, in Latin, explaneo and explanatio."
                            }
                        ]
                    },
                    {
                        "sense_id": "25d0a1f9-da5c-30b9-b269-52aaddd04173",
                        "entry_id": "d6156350-3db3-3d80-8586-1086bf36df0e",
                        "glosses": [
                            "Paronyme."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b6bf565c-a3d6-443e-bdca-715fae0b35ac",
                                "sense_id": "25d0a1f9-da5c-30b9-b269-52aaddd04173",
                                "text": "Two words are paronyms when their phonemic representations are similar but not identical."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
