                    {
                        "translation_id": "fff73a4d-f393-42cd-b19e-7d828397781d",
                        "source_entry_id": "a3068e62-9c37-3cbc-8afd-d0b02ef4a7d7",
                        "source_sense_id": "ab982b30-b867-3b67-a0d7-570887a5206a",
                        "source_sense_description": "in a legitimate manner",
                        "target_lang_word": "légitimement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légitimement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a86595e4-b3ab-35e8-b7d6-fc084c2a11ab",
                                        "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                                        "glosses": [
                                            "D’une manière légitime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5e511a-7290-4ebd-accf-295ea711fbbc",
                                                "sense_id": "a86595e4-b3ab-35e8-b7d6-fc084c2a11ab",
                                                "text": "Cette somme lui est due légitimement."
                                            },
                                            {
                                                "example_id": "5def8c55-8d09-459c-905c-98ffd50d4459",
                                                "sense_id": "a86595e4-b3ab-35e8-b7d6-fc084c2a11ab",
                                                "text": "Ce n'étaient plus un petit bûcheron et une petite pêcheuse, - mais un Sylphe et une Ondine, lesquels, plus tard, furent unis légitimement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487c9450-476e-331d-aa2e-0ce93f4afe8d",
                                        "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                                        "glosses": [
                                            "À bon droit, avec raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1675086-b8d3-4aa2-910c-31d648d34ae9",
                                                "sense_id": "487c9450-476e-331d-aa2e-0ce93f4afe8d",
                                                "text": "Ceux à qui Dieu a donné la religion par sentiment du cœur sont bien heureux et bien légitimement persuadés."
                                            },
                                            {
                                                "example_id": "1eef5389-264b-4c75-b125-f5f3f2e98a0b",
                                                "sense_id": "487c9450-476e-331d-aa2e-0ce93f4afe8d",
                                                "text": "Un homme de quatre-vingts ans, qui ne doit espérer que trois ans et sept mois de vie, peut encore espérer tout aussi légitimement trois ans lorsqu'il a atteint quatre-vingt-cinq ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aa0c3c5-49bf-3397-b900-d0f487a44331",
                                        "entry_id": "ae0d71d7-7877-3d9f-abfe-f98898984361",
                                        "glosses": [
                                            "D’une façon excusable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0954b7eb-d8c9-41c5-9aa8-a933a906ac42",
                                                "sense_id": "7aa0c3c5-49bf-3397-b900-d0f487a44331",
                                                "text": "Afin que je sois légitimement ingrat, étant infiniment obligé, ne me laissez pas même des paroles avec lesquelles je puisse vous remercier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f1756c8-1e6f-4730-9cc7-8716319d66ba",
                        "source_entry_id": "a3068e62-9c37-3cbc-8afd-d0b02ef4a7d7",
                        "source_sense_id": "ab982b30-b867-3b67-a0d7-570887a5206a",
