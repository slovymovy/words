                                "target_senses": [
                                    {
                                        "sense_id": "4f20310b-5373-3782-94bc-c3a01877df05",
                                        "entry_id": "25b58600-8789-368c-b4e5-b494b009daa3",
                                        "glosses": [
                                            "Technique de ravitaillement continu, par avion, d'un lieu isolé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac49e48-0bef-4dd5-b6a2-363eff960221",
                                                "sense_id": "4f20310b-5373-3782-94bc-c3a01877df05",
                                                "text": "Dès le 26 juin, les Américains mettent sur pied un gigantesque pont aérien afin de ravitailler Berlin-Ouest."
                                            },
                                            {
                                                "example_id": "da00a2a3-65c6-42af-91b7-5179ae016771",
                                                "sense_id": "4f20310b-5373-3782-94bc-c3a01877df05",
                                                "text": "Demiansk marque une date dans l'histoire militaire : pour la première fois, un pont aérien ravitaille un corps d'armée d'environ 100 000 hommes."
                                            },
                                            {
                                                "example_id": "f00fff62-7f8e-4b8a-b9df-3f78addcff9c",
                                                "sense_id": "4f20310b-5373-3782-94bc-c3a01877df05",
                                                "text": "Cyclone Chido : avec un Antonov et cinq A400M, le pont aérien vers Mayotte s'intensifie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd626d0-0998-3b51-8840-f567c7d57636",
                                        "entry_id": "25b58600-8789-368c-b4e5-b494b009daa3",
                                        "glosses": [
                                            "Pont situé au-dessus d’une voie pour permettre le passage sans danger de la faune sauvage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737d2e56-5241-4428-b11c-5c65ef652bca",
                                                "sense_id": "2fd626d0-0998-3b51-8840-f567c7d57636",
                                                "text": "On voit apparaître une diversité de dispositifs. Des écoponts, des écoducs, des tunnels, des ponts aériens, des banquettes sous les ouvrages pour les loutres et castors, des échelles de corde pour les écureuils…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
