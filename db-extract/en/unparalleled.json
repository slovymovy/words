                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                                "text": "Dieses Automobil aus den 20er Jahren ist weltweit ohnegleichen."
                                            },
                                            {
                                                "example_id": "1e5b2032-bd0f-47d4-8cfb-e9579605fccb",
                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                                "text": "Claudius ist ein Angeber ohnegleichen."
                                            },
                                            {
                                                "example_id": "23e2c402-30bf-4307-8549-9a8f500e8c98",
                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
