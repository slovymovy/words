                {
                    "sense_id": "d8e05648-4612-39af-89d3-db0742c420b8",
                    "sense_definition": "goederen of personen per schip vervoeren of wegzenden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het aantal Nederlandse munten dat naar Curaçao werd <w>verscheept</w> bleef onvoldoende.",
                            "target_lang_translations": {
                                "en": "The number of Dutch coins that were <w>shipped</w> to Curaçao remained insufficient."
                            }
                        },
                        {
                            "text": "Het bedrijf gaat de nieuwe auto's volgende week naar Amerika <w>verschepen</w>.",
                            "target_lang_translations": {
                                "en": "The company is going to <w>ship</w> the new cars to America next week."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzenden",
                        "transporteren"
                    ],
                    "common_phrases": [
                        "goederen verschepen",
                        "per schip verschepen"
                    ],
                    "target_lang_definitions": {
                        "en": "to transport or send goods or persons by ship"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to ship",
                                "target_lang_sense_clarification": "to transport goods by sea or other means"
                            },
                            {
                                "target_lang_word": "to transport",
                                "target_lang_sense_clarification": "to move goods or people from one place to another"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96847c03-0395-3ef0-bc4d-32f98f099d62",
                    "sense_definition": "aan boord van een schip gaan om een reis te beginnen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten moesten zich in de vroege ochtend <w>verschepen</w> naar het front.",
                            "target_lang_translations": {
                                "en": "The soldiers had to <w>embark</w> for the front in the early morning."
                            }
                        },
                        {
                            "text": "Na het afscheid van hun familie gingen de emigranten zich <w>verschepen</w> voor de lange reis.",
                            "target_lang_translations": {
                                "en": "After saying goodbye to their families, the emigrants <w>embarked</w> for the long journey."
                            }
                        }
                    ],
                    "synonyms": [
                        "inschepen"
                    ],
                    "antonyms": [
                        "uitschepen"
                    ],
                    "common_phrases": [
                        "zich verschepen"
                    ],
                    "target_lang_definitions": {
