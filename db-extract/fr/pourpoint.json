                                    },
                                    {
                                        "sense_id": "2569148b-40e3-31dd-a7d9-5b8c23f3e350",
                                        "entry_id": "f68d8668-b1c9-3f94-bd3d-1d78af63b142",
                                        "glosses": [
                                            "Dipole antenna."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5de2b83f-eedc-3efb-99f2-07dfe0cc3d5f",
                                        "entry_id": "f68d8668-b1c9-3f94-bd3d-1d78af63b142",
                                        "glosses": [
                                            "A man’s waistcoat."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d26af8-ed43-47dd-841b-c3bf22b6df00",
                                                "sense_id": "5de2b83f-eedc-3efb-99f2-07dfe0cc3d5f",
                                                "text": "I must comfort the weaker vessel, as\ndoublet and hose ought to show itself courageous to petticoat […]"
                                            },
                                            {
                                                "example_id": "59dd20c3-d1c8-43b8-8565-7c68fd1bfb37",
                                                "sense_id": "5de2b83f-eedc-3efb-99f2-07dfe0cc3d5f",
                                                "text": "Expression is the dress of thought, and still\nAppears more decent, as more suitable;\nA vile conceit in pompous words express'd,\nIs like a clown in regal purple dress'd:\n[…]\nThese sparks with awkward vanity display\nWhat the fine gentleman wore yesterday;\nAnd but so mimic ancient wits at best,\nAs apes our grandsires, in their doublets drest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doublet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08f3f8a7-a136-3407-bcce-a07a2b6c998c",
                                        "entry_id": "6c026dd7-52a8-37d9-be2d-2528daedb6b7",
                                        "glosses": [
                                            "A man’s close-fitting jacket, with or without sleeves, worn by European men from the 1400s to the 1600s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d3b405-6233-4617-a7c5-c1db35c8f3b3",
                                                "sense_id": "08f3f8a7-a136-3407-bcce-a07a2b6c998c",
                                                "text": "Lord Hamlet, with his doublet all unbraced […]"
                                            },
                                            {
