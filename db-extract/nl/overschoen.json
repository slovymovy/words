                        "entry_id": "9ebc479d-f8d6-3869-a009-187ab6945a0c",
                        "glosses": [
                            "een (vaak rubberen) schoen die ter bescherming tegen nat en vuil over een andere wordt aangetrokken"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed109b7-44b2-4344-9ee1-f2cde9391310",
                                "sense_id": "eb277cd3-f5b1-3823-b184-17d15593e78b",
                                "text": "Daarna sloeg ze een grote sjaal om haar hoofd, trok overschoenen en de luipaardbontjas aan en was verdwenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7fb7cd6-e069-30a5-837a-97d268bdea33",
