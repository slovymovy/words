                ],
                "senses": [
                    {
                        "sense_id": "655e9566-4911-37bc-986b-6f4ce2a233e4",
                        "entry_id": "14620f9b-d946-323b-b4c5-a0ce7f96e3b2",
                        "glosses": [
                            "Ein- und Ausgangstür eines Büros"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59efe8ac-7e89-4c72-9f6b-9fcdfd908b64",
                                "sense_id": "655e9566-4911-37bc-986b-6f4ce2a233e4",
                                "text": "„Noby öffnete seine Bürotür und deutete mit einer einladenden Handbewegung an, das Gespräch in seinem Büro fortzusetzen.“"
                            },
                            {
                                "example_id": "5dc75c15-c91a-4622-97bb-4c2cca34ef1c",
                                "sense_id": "655e9566-4911-37bc-986b-6f4ce2a233e4",
                                "text": "„Er schloss die Bürotür, setzte sich an den Besprechungstisch und winkte Ferris und Azhar zu sich.“"
                            },
                            {
                                "example_id": "ae2cf14c-8d5f-4434-9208-1b2bc6627c6b",
                                "sense_id": "655e9566-4911-37bc-986b-6f4ce2a233e4",
                                "text": "„Sie warf beim Hinausgehen einen schnellen Blick auf seine Bürotür und war froh, dass sie außerhalb seines Blickfelds war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
