                "senses": [
                    {
                        "sense_id": "12eed89d-eff9-3f14-9b13-1e58e1412296",
                        "entry_id": "9f464fe7-d037-3c8e-8c75-5cbc169b6707",
                        "glosses": [
                            "Verringerung der Empfindlichkeit; Abhärtung; Steigerung der Resistenz (Abwehrkräfte); Steigerung der Leistungsfähigkeit (der immunologischen Abwehr)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c3a704-d9a9-4de8-87a3-6afdbc39b4be",
                                "sense_id": "12eed89d-eff9-3f14-9b13-1e58e1412296",
                                "text": "„Die Besserung hielt an, es trat langsam innerhalb der folgenden 5 Wochen eine zunehmende Roborierung auf, nach 10 Wochen Therapie insgesamt konnte die Patientin mit ihrem Ehemann in das benachbarte Ausland fliegen, um dort im eigenen Haus einen 3-wöchigen Urlaub zu verbringen.“"
                            },
                            {
                                "example_id": "cc70918c-4559-4543-be1a-10b814e6019f",
                                "sense_id": "12eed89d-eff9-3f14-9b13-1e58e1412296",
                                "text": "„Im Sinne der somatischen Roborierung empfehlen sich insbesondere bei vegetativ labilen Migränepatienten zur Migräneprophylaxe ergänzende balneophysikalische Therapieansätze wie Wassergymnastik […]“"
                            },
                            {
                                "example_id": "d2ca3970-099a-458f-a01c-104b80d9e87e",
                                "sense_id": "12eed89d-eff9-3f14-9b13-1e58e1412296",
                                "text": "„Spaziergänge und im Sommer zusätzlich durchgeführte Luftbäder dienen der allgemeinen Roborierung“."
                            },
                            {
                                "example_id": "d0c02bda-0f4e-4a94-bc7e-7416a66592bf",
                                "sense_id": "12eed89d-eff9-3f14-9b13-1e58e1412296",
                                "text": "„Ziel ist die vegetative Regulierung, körperliche Erholung und die psychosomatische Roborierung.“"
                            },
                            {
                                "example_id": "2d3c3c07-2877-409a-a782-55c94b281576",
                                "sense_id": "12eed89d-eff9-3f14-9b13-1e58e1412296",
                                "text": "„Zur Roborierung, aber auch zur Behandlung der aplastischen Anämie werden vereinzelt Androgene eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
