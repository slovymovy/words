                "senses": [
                    {
                        "sense_id": "f9bb89be-dc18-31f5-b495-19c959fd8e26",
                        "entry_id": "94d0f189-ad32-3a6b-bd5b-57fd448e6256",
                        "glosses": [
                            "Supprimer. [Alt: attention] Il s’agit d’un terme utilisé qui n’est pas d’un usage standard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43997455-1dce-4b7d-ac0b-69b4ed5fcdb2",
                                "sense_id": "f9bb89be-dc18-31f5-b495-19c959fd8e26",
                                "text": "En attendant, les météorologistes ne pourraient-ils écrire, pour supprimer (ou : suppressionner) la difficulté : « La dépression persiste sur l'Océan » ?"
                            },
                            {
                                "example_id": "16e7df71-35e4-44fd-8e67-97045af1f63c",
                                "sense_id": "f9bb89be-dc18-31f5-b495-19c959fd8e26",
                                "text": "Le cas serait tout différent si l'on prétendait substituer suppressionner à supprimer."
                            },
                            {
                                "example_id": "52bfe2f6-28ea-4755-8464-df49d920b360",
                                "sense_id": "f9bb89be-dc18-31f5-b495-19c959fd8e26",
                                "text": "Si tu prends la Frag ça sert à rien, juste à suppressionner à mort maintenant."
                            },
                            {
                                "example_id": "a901169c-b3c1-47d5-8906-d4b806978733",
                                "sense_id": "f9bb89be-dc18-31f5-b495-19c959fd8e26",
                                "text": "suis désolée mais j'ai dû suppressionner presque toute la ponctuation pour que ça rentre !!"
                            },
                            {
                                "example_id": "d149742a-cacc-4183-9b55-a2fe89cc7c08",
                                "sense_id": "f9bb89be-dc18-31f5-b495-19c959fd8e26",
                                "text": "Par contre Tonio pourrais-tu suppressionner deux des trois messages de notre ami CC72074 please ?"
                            }
                        ]
                    }
