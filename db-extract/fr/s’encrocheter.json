        "fr-extract.jsonl": [
            {
                "entry_id": "03621b33-7bf2-3112-a178-eb0ae40d54ce",
                "word": "s’encrocheter",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc82ccfd-c073-3a2b-a716-4ad23796ed5c",
                        "entry_id": "03621b33-7bf2-3112-a178-eb0ae40d54ce",
                        "glosses": [
                            "(Acadie) Trébucher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c4a4d7-3f02-4b1d-865f-eb0565b016bb",
                                "sense_id": "bc82ccfd-c073-3a2b-a716-4ad23796ed5c",
                                "text": "Je me suis encrocheté sur le lit en marchant dans le noir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "185865d2-c8c7-4174-9555-583ae0a0ba6f",
                        "source_entry_id": "03621b33-7bf2-3112-a178-eb0ae40d54ce",
                        "source_sense_id": "bc82ccfd-c073-3a2b-a716-4ad23796ed5c",
                        "target_lang_word": "trip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7479cc80-1893-396e-9093-3c7a624c6b9f",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A journey; an excursion or jaunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6be649e-bfc8-4287-8d10-eeda27a91be5",
                                                "sense_id": "7479cc80-1893-396e-9093-3c7a624c6b9f",
                                                "text": "We made a trip to the beach."
                                            },
                                            {
                                                "example_id": "8081f30e-a46f-4e1b-b0d5-6cf0a9ca62ad",
                                                "sense_id": "7479cc80-1893-396e-9093-3c7a624c6b9f",
                                                "text": "I sold my horse and took a trip to Ceylon and back on an Orient boat as a passenger,"
                                            },
                                            {
                                                "example_id": "8e26a603-c0e4-4c1c-ba33-b458506f33e5",
                                                "sense_id": "7479cc80-1893-396e-9093-3c7a624c6b9f",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner. He could not be induced to remain permanently at Mohair because Miss Trevor was at Asquith, but he appropriated a Hempstead cart from the Mohair stables and made the trip sometimes twice in a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffc0103f-d16d-3031-9333-087e41b16881",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A stumble or misstep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89949749-007a-4e96-abc8-3511f2bc7963",
                                                "sense_id": "ffc0103f-d16d-3031-9333-087e41b16881",
                                                "text": "He was injured due to a trip down the stairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "302a9081-4ae0-3aae-9dbf-b7d33cf7ead3",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "An error; a failure; a mistake."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64e8afef-52d9-42e4-9df7-d0d90b02faae",
                                                "sense_id": "302a9081-4ae0-3aae-9dbf-b7d33cf7ead3",
                                                "text": "Imperfect words, with childish trips."
                                            },
                                            {
                                                "example_id": "d26f3583-b255-4935-b191-83b7c2386587",
                                                "sense_id": "302a9081-4ae0-3aae-9dbf-b7d33cf7ead3",
                                                "text": "Each seeming trip, and each digressive start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c29692dd-1d23-31a0-9a7d-1438be6857c8",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A period of time in which one experiences drug-induced reverie or hallucinations."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1cf1c9-934e-4020-b073-f7c043d3bae3",
                                                "sense_id": "c29692dd-1d23-31a0-9a7d-1438be6857c8",
                                                "text": "He had a strange trip after taking LSD."
                                            },
                                            {
                                                "example_id": "af052c6b-24c4-4fc1-8c24-590a66b3eef9",
                                                "sense_id": "c29692dd-1d23-31a0-9a7d-1438be6857c8",
                                                "text": "Unlike other accepted stimuli, from nicotine to liquor, the hallucinogens promise those who take the “trip” a magic-carpet escape from dull reality in which perceptions are heightened, sense distorted, and the imagination permanently bedazzled with ecstatic visions of teleological verity."
                                            },
                                            {
                                                "example_id": "cfc346d2-90c9-46f0-9ab5-6efdd14c50e8",
                                                "sense_id": "c29692dd-1d23-31a0-9a7d-1438be6857c8",
                                                "text": "We don't smoke marijuana in Muskogee / We don't take our trips on LSD"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae00091-8006-34ee-b7b8-83a9e32ed328",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "Intense involvement in or enjoyment of a condition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4fd1bde-e083-4a7e-bae9-7518cb185b18",
                                                "sense_id": "1ae00091-8006-34ee-b7b8-83a9e32ed328",
                                                "text": "ego trip"
                                            },
                                            {
                                                "example_id": "9cc628e6-64ba-4cbc-a862-793461be967e",
                                                "sense_id": "1ae00091-8006-34ee-b7b8-83a9e32ed328",
                                                "text": "power trip"
                                            },
                                            {
                                                "example_id": "ab179277-96b5-4a4e-976b-6c4663076122",
                                                "sense_id": "1ae00091-8006-34ee-b7b8-83a9e32ed328",
                                                "text": "nostalgia trip"
                                            },
                                            {
                                                "example_id": "550a8752-fdf1-40b9-8828-38fe83b84fa2",
                                                "sense_id": "1ae00091-8006-34ee-b7b8-83a9e32ed328",
                                                "text": "guilt trip"
                                            },
                                            {
                                                "example_id": "afbe85a6-2d79-468b-ba97-07682e07fad6",
                                                "sense_id": "1ae00091-8006-34ee-b7b8-83a9e32ed328",
                                                "text": "Many of them admit to having suppressed any tendency toward homosexual behavior for the greater part of their lives—yet—denial becomes too heavy a trip after a period of time, and eventually curiosity wins out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d6142c-90a4-3b6f-95f4-ef864e63ac8d",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A faux pas, a social error."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95c43eb3-7017-3dc3-b1d7-a7837b09e5d7",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A mechanical cutout device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56d5d7f2-ea96-3667-b59b-61725e1e99cd",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A trip-switch or cut-out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c60b3c3-b786-4aa1-b401-d0dd3ffa53c8",
                                                "sense_id": "56d5d7f2-ea96-3667-b59b-61725e1e99cd",
                                                "text": "It's dark because the trip operated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccc148c3-39f8-3413-a8a5-1779d8d7fc17",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A quick, light step; a lively movement of the feet; a skip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ea6164-fa34-488c-9d48-809bef257211",
                                                "sense_id": "ccc148c3-39f8-3413-a8a5-1779d8d7fc17",
                                                "text": "His heart bounded as he sometimes could distinctly hear the trip of a light female step glide to or from the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480afa67-583d-3f83-8ac5-b5ffc996bafb",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "The act of tripping someone, or causing them to lose their footing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5afe43c-fee8-4d02-b718-1975510088cf",
                                                "sense_id": "480afa67-583d-3f83-8ac5-b5ffc996bafb",
                                                "text": "It is the sudden trip in wrestling that fetches a man to the ground."
                                            },
                                            {
                                                "example_id": "f4489d7a-af0a-4a0a-a3b7-d4da62e345d2",
                                                "sense_id": "480afa67-583d-3f83-8ac5-b5ffc996bafb",
                                                "text": "And watches with a trip his foe to foil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e39cdd87-2956-3409-998f-34ed541e1b47",
                                        "entry_id": "d98b7e32-3408-3856-ad67-f0b9a8836420",
                                        "glosses": [
                                            "A single tack while beating (sailing to windward)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "662fe926-b182-32b9-afc7-cc26dcc85ae4",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To fall over or stumble over an object as a result of striking it with one's foot"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5edec99f-ae7e-4bc9-93b6-d7726f02fbe0",
                                                "sense_id": "662fe926-b182-32b9-afc7-cc26dcc85ae4",
                                                "text": "Be careful not to trip on those tree roots. You tripped over the cat and fell downstairs just last week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa5e474f-fa74-3c01-9a64-a6ed4e5a6847",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To cause (a person or animal) to fall or stumble by knocking their feet from under them."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7230a41a-29d4-4ce6-b2af-f3a64ece8516",
                                                "sense_id": "fa5e474f-fa74-3c01-9a64-a6ed4e5a6847",
                                                "text": "A pedestrian was able to trip the burglar as he was running away."
                                            },
                                            {
                                                "example_id": "27ad6d96-dc4c-4f33-90af-20b794402d80",
                                                "sense_id": "fa5e474f-fa74-3c01-9a64-a6ed4e5a6847",
                                                "text": "Early in his boyhood he had learned to form ropes by twisting and tying long grasses together, and with these he was forever tripping Tublat or attempting to hang him from some overhanging branch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e922e71a-a0b1-3e3d-a064-d6123ae9dbc7",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To be guilty of a misstep or mistake; to commit an offence against morality, propriety, etc"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fa6aa52-e7bd-4371-8ede-69859f6680c2",
                                                "sense_id": "e922e71a-a0b1-3e3d-a064-d6123ae9dbc7",
                                                "text": "And the Pharasay / Then durst nothynge say, / But let the matter slyp, / And made truth to tryp;"
                                            },
                                            {
                                                "example_id": "dbcb9996-121c-4a65-8558-7f6caa1f0cb2",
                                                "sense_id": "e922e71a-a0b1-3e3d-a064-d6123ae9dbc7",
                                                "text": "[T]ill his Tongue trips"
                                            },
                                            {
                                                "example_id": "876a853c-c1d2-4821-bcff-492235e13e00",
                                                "sense_id": "e922e71a-a0b1-3e3d-a064-d6123ae9dbc7",
                                                "text": "A blind will thereupon comes to be led by a blind understanding; there is no remedy, but it must trip and stumble."
                                            },
                                            {
                                                "example_id": "999ce0af-be6e-437f-90f3-c822497258f4",
                                                "sense_id": "e922e71a-a0b1-3e3d-a064-d6123ae9dbc7",
                                                "text": "Virgil is so exact in every word that none can be changed but for a worse; he pretends sometimes to trip, but it is to make you think him in danger when most secure."
                                            },
                                            {
                                                "example_id": "b127605c-42d2-47a1-bfe8-0bdab515fe80",
                                                "sense_id": "e922e71a-a0b1-3e3d-a064-d6123ae9dbc7",
                                                "text": "\"No, Mrs. Curzon-Bowlby,\" he said; \"if I danced I should be tripping indeed, in Gleicester opinion.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24cac67-8300-3690-b8ef-a74771b4a2ef",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To detect in a misstep; to catch; to convict."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c32c93a5-c0ab-444b-bac4-cda50bb332a9",
                                                "sense_id": "e24cac67-8300-3690-b8ef-a74771b4a2ef",
                                                "text": "These her women can trip me if I err."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba8705a-1e28-3b97-a4cc-0d1d01633027",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To activate or set in motion, as in the activation of a trap, explosive, or switch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47c3e00-9fa0-4123-8726-39f5c225ce8c",
                                                "sense_id": "fba8705a-1e28-3b97-a4cc-0d1d01633027",
                                                "text": "When we get into the factory, trip the lights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1edaa69f-c6dc-3008-bdce-44e881f55b6a",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To be activated, as by a signal or an event"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "350b7308-ae13-4685-a7cf-f5cd5c6b3b63",
                                                "sense_id": "1edaa69f-c6dc-3008-bdce-44e881f55b6a",
                                                "text": "The alarm system tripped, throwing everyone into a panic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15fbddee-e2d5-3b7f-bcc6-4ac5d5461a08",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "Of an electrical circuit, to trip out (through overload, a short circuit)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0618a1-5a7a-4563-b6b7-587a5adcd461",
                                                "sense_id": "15fbddee-e2d5-3b7f-bcc6-4ac5d5461a08",
                                                "text": "From the evidence of witnesses and of the recorded passing times, including the time at which the circuit breakers were tripped when the wires were brought down, the train was travelling at a speed of not less than 70 m.p.h."
                                            },
                                            {
                                                "example_id": "bdcccc0a-619c-4281-8b70-5c0546ffd1ce",
                                                "sense_id": "15fbddee-e2d5-3b7f-bcc6-4ac5d5461a08",
                                                "text": "The 25kV had repeatedly tripped and the two had split from a larger group to operate an overhead line isolating switch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a77187-cacf-326b-a9e3-8367e7b3bbc1",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To experience a state of reverie or to hallucinate, due to consuming psychoactive drugs."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "838691a0-d5c6-4487-872d-d7b082b47e8e",
                                                "sense_id": "60a77187-cacf-326b-a9e3-8367e7b3bbc1",
                                                "text": "After taking the LSD, I started tripping about fairies and colors."
                                            },
                                            {
                                                "example_id": "9085b4f9-8808-4422-917f-19fc29066db3",
                                                "sense_id": "60a77187-cacf-326b-a9e3-8367e7b3bbc1",
                                                "text": "So, I went to the doctor, see what he could give me / He said, \"Son, son, you've gone too far / 'Cause smokin' and trippin’ is all that you do,\" / Yeeeeeeaaaaaah"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f612f4-0125-3c9e-97e5-7a24518d3f21",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To journey, to make a trip."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db953c1e-2d0f-4dbb-90d1-287be7afaf83",
                                                "sense_id": "13f612f4-0125-3c9e-97e5-7a24518d3f21",
                                                "text": "Last summer, we tripped to the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa5caa88-d797-3b73-8aed-20ff0781c363",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To move with light, quick steps; to walk or move lightly; to skip."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d70b10-8373-40ab-86b3-b5847fdcae13",
                                                "sense_id": "fa5caa88-d797-3b73-8aed-20ff0781c363",
                                                "text": "Come, and trip it, as ye go, / On the light fantastic toe."
                                            },
                                            {
                                                "example_id": "c0f3aeac-031a-4383-9d4c-71aed490c0ab",
                                                "sense_id": "fa5caa88-d797-3b73-8aed-20ff0781c363",
                                                "text": "She bounded by, and tripped so light / They had not time to take a steady sight."
                                            },
                                            {
                                                "example_id": "8fdf1700-e806-4811-b3a4-3558f1dfa6db",
                                                "sense_id": "fa5caa88-d797-3b73-8aed-20ff0781c363",
                                                "text": "A bright beautiful face glanced out at the window, and vanished—a light footstep was heard—and Mary came tripping forth to meet us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8270671-b23a-3f27-93fb-807a071cf4a5",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To raise (an anchor) from the bottom, by its cable or buoy rope, so that it hangs free."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea2a64d9-437e-371e-ac9e-9c380da52c2a",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To pull (a yard) into a perpendicular position for lowering it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e29ba6ba-c61a-3e06-88b9-8dc54996649c",
                                        "entry_id": "8188686e-820e-38bc-80ab-d7645719c84b",
                                        "glosses": [
                                            "To become unreasonably upset, especially over something unimportant; to cause a scene or a disruption."
                                        ],
                                        "tags": [
