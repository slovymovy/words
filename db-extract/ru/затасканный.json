                "senses": [
                    {
                        "sense_id": "fb28957c-59c2-35ab-82ec-6cb8ff7f564b",
                        "entry_id": "d5db6599-779a-3a0c-8ae5-70d4e6fc1f40",
                        "glosses": [
                            "страд. прич. прош. вр. от затаскать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "d373b1f4-bca9-44f6-863c-31294e9668a4",
                                "sense_id": "fb28957c-59c2-35ab-82ec-6cb8ff7f564b",
                                "text": "Долго мялся возле дверей, крутил в руках затасканную зелёную будёновку, тоскливо и заискивающе улыбался."
                            },
                            {
                                "example_id": "dd3d8eef-8716-4e3b-ae6c-8bc084069339",
                                "sense_id": "fb28957c-59c2-35ab-82ec-6cb8ff7f564b",
                                "text": "Я вижу, как он мучается, что «Бегущая по волнам» ходит туда-сюда с мешками, затасканная воровской рукой."
                            }
                        ]
                    }
