                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7cb57a-1c10-4023-9ba2-689b597f0982",
                                "sense_id": "3c8127b9-f398-3c46-8bd2-64d8e4011f1f",
                                "text": "Мне страшен мир, мне скучен дневный свет; / Пойду в леса, в которых жизни нет, / Где мёртвый мрак — я радость ненавижу; / Во мне застыл её минутный след."
                            }
                        ]
