                                "example_id": "8b00ae6c-795d-4bf8-9b1c-ed3f1032686a",
                                "sense_id": "f00d39ea-ec2b-3c84-a4cd-fdf0df731f6e",
                                "text": "„Die eroberten Gebiete werden systematisch durch Militärposten kontrolliert und gesichert, Einheimische von ihren angestammten Ländereien vertrieben.“"
                            },
                            {
                                "example_id": "db70ef7b-cdfc-4c0c-984e-b3384c1a2ab6",
                                "sense_id": "f00d39ea-ec2b-3c84-a4cd-fdf0df731f6e",
                                "text": "„Der Name der Ortschaft prangte fetter auf den Landkarten, als die Südafrikanischen Verteidigungsstreitkräfte 1978 dort einen Militärposten errichteten.“"
                            }
                        ],
