                        "glosses": [
                            "Insuffisamment médicaliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2677047c-48ab-4fcb-a00c-7442a0846410",
                                "sense_id": "56204709-4d01-343c-ba03-76f68ea4f230",
                                "text": "Il ne faut pas trop médicaliser le problème de surpoids mais il ne faut pas non plus le \"sous-médicaliser\"."
                            },
                            {
                                "example_id": "f7f12a7c-9f73-45d0-b092-4913d9d486ba",
                                "sense_id": "56204709-4d01-343c-ba03-76f68ea4f230",
                                "text": "Attention cependant à ne pas « sous-médicaliser » un trouble sous prétexte qu'il est déjà traité en homéopathie."
                            }
                        ]
                    }
