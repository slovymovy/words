                "senses": [
                    {
                        "sense_id": "2b8d42fa-5c97-3a79-9cf7-c302cdebe390",
                        "entry_id": "574661ab-1808-3e34-8557-98ebb3c77190",
                        "glosses": [
                            "Einstellung/Haltung einer Person, die von ihren eigenen Vorstellungen so überzeugt ist, dass sie nicht bereit ist, andere, abweichende Ideen auch nur zu erwägen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39920a99-1088-4c87-9c39-fcd6bda909bd",
                                "sense_id": "2b8d42fa-5c97-3a79-9cf7-c302cdebe390",
                                "text": "Gegen seine Borniertheit kamen wir trotz aller Bemühungen nicht an."
                            },
                            {
                                "example_id": "a127bf20-4a54-4a58-81f0-555e3608a042",
                                "sense_id": "2b8d42fa-5c97-3a79-9cf7-c302cdebe390",
                                "text": "Der Außenpolitikexperte Christian Hacke stellte dem Politiker Guido Westerwelle ein vernichtendes Urteil aus und unterstellte ihm eine Borniertheit, die er mit Hitlers Gefolgsmann Ribbentrop verglich."
                            },
                            {
                                "example_id": "4f2723c6-00d5-405b-bf5a-0467a6b88d15",
                                "sense_id": "2b8d42fa-5c97-3a79-9cf7-c302cdebe390",
                                "text": "„Insgesamt war die Rhetorik der Zivilisierungsmission geprägt von einer Spannung zwischen Borniertheit und Universalismus, Sendungsbewusstsein und Herrschaftswahn.“"
                            },
                            {
                                "example_id": "865a0f03-f774-4a4f-8fa0-1858c9dfd0fe",
                                "sense_id": "2b8d42fa-5c97-3a79-9cf7-c302cdebe390",
                                "text": "„Die scheinbar neonazistischen Witze gegen die Juden haben oft eine satirische Tendenz gegen nazistische Borniertheit und Dummheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
