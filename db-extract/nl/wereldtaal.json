                    {
                        "sense_id": "810f381d-4215-3109-80ef-694a18e5fd3e",
                        "entry_id": "f0442ef9-39a8-3b03-b323-18bbeb8a5bbf",
                        "glosses": [
                            "een taal die je over de hele wereld kunt gebruiken als communicatie middel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ea13c6-dcdb-42c7-b39b-9b3ad464fa48",
                                "sense_id": "810f381d-4215-3109-80ef-694a18e5fd3e",
                                "text": "Nu wordt door de talenlobby gezegd dat het niet anders kan, omdat Engels nu eenmaal de wereldtaal is. Maar in landen als Frankrijk, Italië, Spanje en Duitsland worden de technische opleidingen gewoon gegeven in de eigen taal en het Engels wordt erbij gedaan voor hen die dat willen."
                            },
                            {
                                "example_id": "61cb274a-235b-4beb-b993-f55755d3f11b",
                                "sense_id": "810f381d-4215-3109-80ef-694a18e5fd3e",
                                "text": "De grootste boosdoener lijkt onze taal te zijn. Alle functies die nog niet in ons land ondersteund worden, hebben met spraakinvoer- of ondersteuning te maken. Siri spreekt bijvoorbeeld alleen grote wereldtalen en ook 'Predictive Input'op het nieuwe QuickType-toetsenbord werkt alleen talen als het Engels, Chinees, Frans, Spaans en Duits."
                            }
                        ]
                    }
