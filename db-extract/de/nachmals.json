                                            "Singlish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c17f87-4d2c-4684-a36c-fb40f1863d1f",
                                                "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                                "text": "Compare Malay nanti (“later; if not”)"
                                            },
                                            {
                                                "example_id": "9c0c58fe-83aa-4efa-8c68-6d217c2750dd",
                                                "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                                "text": "Later you fall asleep how?",
                                                "translation": "What if you fall asleep?",
                                                "english": "What if you fall asleep?"
                                            }
                                        ]
                                    }
                                ]
                            },
