                                            "iemand die ruikt of goed ruiken kan"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "718e829a-49ee-487d-bfc3-2c0708fe8148",
                        "source_entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "source_sense_description": "A flower",
                        "target_lang_word": "boeket",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boeket",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c81d69-0dc0-356c-bdd3-7f0662f278cb",
                                        "entry_id": "9b5a9932-3244-3d17-94b8-229d56f31966",
                                        "glosses": [
                                            "een bos snijbloemen, vaak sierlijk gerangschikt en aan elkaar gebonden om in een vaas te kunnen zetten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495e3858-5186-460b-a3a0-4e4381b95ba1",
                                                "sense_id": "b6c81d69-0dc0-356c-bdd3-7f0662f278cb",
                                                "text": "Hij kwam met een prachtig boeket aanzetten."
                                            },
                                            {
                                                "example_id": "671030ea-a4f0-4558-92d5-bdf3f2ca515e",
                                                "sense_id": "b6c81d69-0dc0-356c-bdd3-7f0662f278cb",
                                                "text": "Want ik was niet naar Grand Hotel Europa gekomen om de tijd weemoedig te laten verglijden te midden van afgebladderde luxe en krakende glorie in passieve afwachting van een of ander inzicht, dat mij op een gegeven moment zou toevallen als een bloemblad uit een vergeeld boeket. Dat inzicht wilde ik afdwingen en daarom moest ik aan het werk."
                                            },
                                            {
                                                "example_id": "a1b0b983-abfe-4086-b9ec-3ff21eab79f7",
                                                "sense_id": "b6c81d69-0dc0-356c-bdd3-7f0662f278cb",
                                                "text": "Geen boeketje op de begrafenis namens GoSunny of een telefoontje van iemand van toi die zijn deelneming betuigde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "733d834c-f708-3e10-8e74-95dd65b68f1c",
                                        "entry_id": "9b5a9932-3244-3d17-94b8-229d56f31966",
                                        "glosses": [
                                            "aroma"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cc522eb-8929-455e-b98c-43bb45eed6af",
                        "source_entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "source_sense_description": "A flower",
                        "target_lang_word": "Blumensträußchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blumensträußchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26c31c6d-f3b8-3a54-9eb4-74455faaf7c4",
                                        "entry_id": "6a9b648d-90f5-31e2-bb0f-433559e95db3",
                                        "glosses": [
                                            "kleiner Blumenstrauß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff657bc1-18f5-4391-a5bb-2830044ad2e8",
                                                "sense_id": "26c31c6d-f3b8-3a54-9eb4-74455faaf7c4",
                                                "text": "„Ein Mann hat eine Blume zum Schlag erhoben, während ihm ein anderer den nackten Hintern entgegenreckt, aus dem ein Blumensträußchen ragt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b06e8b2-d6a4-4f42-b0a0-bcbe4284bef2",
                        "source_entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "source_sense_description": "A flower",
                        "target_lang_word": "mazzo di fiori",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4d420d0c-2d9d-4c0c-aeef-d698be8ef444",
                        "source_entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "source_sense_description": "A flower",
                        "target_lang_word": "mazzolino",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3fd87822-c9e9-4202-b60e-b58ae5670865",
                        "source_entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "source_sense_description": "A flower",
                        "target_lang_word": "mazzetto",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b6f15ac-4d54-467f-8ab6-1ce559dc24c9",
                        "source_entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "source_sense_description": "A flower",
                        "target_lang_word": "буке́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "буке́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "63923e44-2167-3a4e-a625-bb90b464f9a1",
                                        "entry_id": "575472f2-081c-34a7-b42b-b83d70bdd1a7",
                                        "glosses": [
                                            "цветы, собранные вместе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c8f70c4-a548-49f9-b675-b272234bcb38",
                                                "sense_id": "63923e44-2167-3a4e-a625-bb90b464f9a1",
                                                "text": "Много аплодировали, срезали и поднесли букет великолепных гвоздик, провожали целой группой и очень просили приезжать ещё."
                                            },
                                            {
                                                "example_id": "fc19940e-71ff-4d88-9c11-edf635e6868b",
                                                "sense_id": "63923e44-2167-3a4e-a625-bb90b464f9a1",
                                                "text": "На платформе было полно народу, повсюду стояли узлы и чемоданы, корзины с яблоками и с грибами, чуть не у каждого в руке был осенний букет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b288b28-9714-3258-87db-9f5dd46c8de4",
                                        "entry_id": "575472f2-081c-34a7-b42b-b83d70bdd1a7",
                                        "glosses": [
                                            "спец. совокупность ароматических, вкусовых свойств чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3286ce6-20e7-43b2-88c8-fb174ea48ae5",
                                                "sense_id": "6b288b28-9714-3258-87db-9f5dd46c8de4",
                                                "text": "Известно, что свинец, перемешиваясь с напитком, меняет его букет, поэтому приверженцы традиционного винопития не допускают наличия этого элемента в хрустальных бокалах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43c9f79-5788-386b-973d-2e0674800c50",
                                        "entry_id": "575472f2-081c-34a7-b42b-b83d70bdd1a7",
                                        "glosses": [
                                            "перен., разг. ряд, набор чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a1772f-ed36-4750-8914-937862a5a13d",
                                                "sense_id": "b43c9f79-5788-386b-973d-2e0674800c50",
                                                "text": "Кроме того, у него был обнаружен ещё целый букет болезней, включая диабет и ишемию."
                                            },
                                            {
                                                "example_id": "841af990-9b23-4069-b6c4-25f8dc9a74a6",
                                                "sense_id": "b43c9f79-5788-386b-973d-2e0674800c50",
                                                "text": "Гинкас меня, кажется, понял и развил роль: моя героиня периодически появлялась в течение всего спектакля, молча бродя по сцене, олицетворяя собой то память, то совесть, то благородство, в общем, неся зрителю букет вечных ценностей и иллюстрируя немой укор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1839acb8-0d20-31dd-be00-0af03bd22947",
                                        "entry_id": "575472f2-081c-34a7-b42b-b83d70bdd1a7",
                                        "glosses": [
                                            "истор. прислуга, располагавшаяся на запятках кареты во время выезда вельможи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4260a11c-845e-42fd-8bb9-3b94cde1d720",
                                                "sense_id": "1839acb8-0d20-31dd-be00-0af03bd22947",
                                                "text": "Громыхает золочёная карета с графским гербом, кони в перьях, на запятках букет — два здоровенных лакея во фраках, на козлах красномордый тучный кучер, которого для поддержания внушительных размеров живота каждый вечер до краёв потчуют портером."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
