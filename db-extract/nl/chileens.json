                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046ba53b-85b3-487c-9806-4cb8d9ed5edc",
                                                "sense_id": "49827fff-4722-341c-92b6-4caae3d699e1",
                                                "text": "Bei Festen sieht man immer wieder, wie die Cueca, der chilenische Nationaltanz getanzt wird."
                                            },
                                            {
                                                "example_id": "9fb30210-9b8b-459b-b149-222a7050cea0",
                                                "sense_id": "49827fff-4722-341c-92b6-4caae3d699e1",
                                                "text": "Als er sie auf ihr Neunzehntes-Jahrhundert-Bett niederlegte, rezitierte sie, anstatt einen Bolero zu singen, das schönste, das berühmteste und auch, wie sie fand, das chilenischste Liebesgedicht: Ich liebte sie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
