                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8719f3b-7e74-337e-a031-0d0e9b9bfb9c",
                        "entry_id": "238f13c0-5e78-37a6-a869-aec27244b029",
                        "glosses": [
                            "zich verder verplaatsend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac55c8a1-cafe-4c24-9b5a-91aa4e2f68de",
                                "sense_id": "f8719f3b-7e74-337e-a031-0d0e9b9bfb9c",
                                "text": "De kwartiermakers verkozen het Java-eiland in Amsterdam Oost boven het Marineterrein in het centrum en het Nelson Mandelapark in Amsterdam-Zuidoost. In het advies noemen ze de locatie \"een waardige en prominente plek\" die grenst aan \"doorgaand stromend water\", een verwijzing naar het transport van tot slaaf gemaakte mensen per schip."
                            }
                        ]
                    },
                    {
                        "sense_id": "feb54c79-bbe2-3653-8283-21eff50ae339",
                        "entry_id": "238f13c0-5e78-37a6-a869-aec27244b029",
                        "glosses": [
                            "zich verder voortzettend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113ce2d9-8da8-43df-bb14-f431acb75c67",
                                "sense_id": "feb54c79-bbe2-3653-8283-21eff50ae339",
                                "text": "Een pauze van acht jaar tussen de laatste twee albums geeft de gemiddelde band geen garantie op doorgaand succes en daar lijkt de hele band zich van bewust."
                            }
                        ]
                    },
                    {
                        "sense_id": "254bba44-4721-3e59-92f9-9c4457b57d92",
                        "entry_id": "238f13c0-5e78-37a6-a869-aec27244b029",
                        "glosses": [
