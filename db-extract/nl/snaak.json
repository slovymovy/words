                    },
                    {
                        "sense_id": "aeba2946-2fe9-3f3b-bb57-b2a269f30ba0",
                        "entry_id": "0ebb0f95-9145-38b9-8a48-5fdf91712dd0",
                        "glosses": [
                            "jonge, vreemde snuiter, rare man"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a847532-d601-44bf-93a2-733b75ad2d82",
                                "sense_id": "aeba2946-2fe9-3f3b-bb57-b2a269f30ba0",
                                "text": "'t Is zoo, had de snaak nog eene goede pakkaadje bij zich; maar, och armen, een bundeltje! ik geloof, bij mijn' Patroon! dat het niets anders dan boeken zijn. Boeken! ik wilde toch wel eens weten, waar boeken nuttig voor waren; maar nu staat het vast, ondanks Stijntje en haar gekijf, ondanks Stijntje en haar gegrien, de vreemdeling zal mijne deur uit, en dat nog wel vóór den noen.’ Met dit heusche voornemen was het, dat de waard zijnen gast een zoo hoffelijk gelaat toonde."
                            }
                        ]
                    }
