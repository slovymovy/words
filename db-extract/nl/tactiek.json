                    {
                        "sense_id": "e1980bfe-cb1a-3046-aa96-d5d2914556d8",
                        "entry_id": "2a94553c-6e5d-3b6c-ad35-dcd9512efe07",
                        "glosses": [
                            "een manier om onder gegeven omstandigheden een doel te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c95bd3e-e304-4380-b707-e035e311c4bb",
                                "sense_id": "e1980bfe-cb1a-3046-aa96-d5d2914556d8",
                                "text": "Hij heeft een goede tactiek, zeg!"
                            },
                            {
                                "example_id": "560d6344-e936-4607-8b99-3f1bd3607502",
                                "sense_id": "e1980bfe-cb1a-3046-aa96-d5d2914556d8",
                                "text": "De Certeaus onderscheid tussen strategieën en tactieken geeft daarbij een nuttige aanvulling. Met behulp van dit onderscheid kan zichtbaar gemaakt worden hoe de verschillende actoren zich verhouden tot de normaliserende machtsstrategieën."
                            },
                            {
                                "example_id": "2c9cd55d-01a7-44fa-a94d-5ddbb5f4920c",
                                "sense_id": "e1980bfe-cb1a-3046-aa96-d5d2914556d8",
                                "text": "Hoewel ik twijfelde aan mama's tactiek besloot ik toch te proberen of het in ieder geval een beetje werkte. Het werkte heel goed."
                            },
                            {
                                "example_id": "7689424e-e837-430b-8a0a-30fb9cffac1d",
                                "sense_id": "e1980bfe-cb1a-3046-aa96-d5d2914556d8",
                                "text": "Ze wekte de indruk van een soort kuise elegantie, of ze die tactiek nu zelf had gekozen of dat ze wijze raad van haar verdediger had gekregen."
                            }
                        ]
                    },
                    {
                        "sense_id": "157c6734-57e8-3aa5-b628-e12077cbd2b4",
                        "entry_id": "2a94553c-6e5d-3b6c-ad35-dcd9512efe07",
                        "glosses": [
                            "leer van de gevechtsvoering"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a115b160-31ee-43aa-a657-07f02bf6c3de",
                        "source_entry_id": "2a94553c-6e5d-3b6c-ad35-dcd9512efe07",
                        "source_sense_id": "e1980bfe-cb1a-3046-aa96-d5d2914556d8",
                        "source_sense_description": "een manier om onder gegeven omstandigheden een doel te bereiken",
