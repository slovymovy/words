                                                "sense_id": "54aaf79c-7eda-3921-8dc6-3db85aac33ad",
                                                "text": "Die Valenz von Sauerstoff ist II."
                                            },
                                            {
                                                "example_id": "0adb852a-3b74-44a7-b00e-5f65f0bd9b71",
                                                "sense_id": "54aaf79c-7eda-3921-8dc6-3db85aac33ad",
                                                "text": "„Es sind dies syntagmatische Beziehungen, die im System als Valenz, Kompatibilität und Inkompatibilität gespeichert sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0996a7ad-254e-32f4-934b-4fbd6b393795",
                                        "entry_id": "f528519d-a1e9-318b-818d-1507217f21f3",
                                        "glosses": [
                                            "Eigenschaft eines Verbs oder anderer Wortarten, im Satz Ergänzungen zu fordern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d1c73e-00ff-4cc8-b9b7-7421ec59a4eb",
                                                "sense_id": "0996a7ad-254e-32f4-934b-4fbd6b393795",
                                                "text": "Das Verb „hoffen“ ist zweiwertig: „Er hofft auf gutes Wetter“; das Substantiv „Hoffnung“ ist nur einwertig: „Die Hoffnung auf gutes Wetter“; Die Valenzen des Verbs und des substantivierten Verbs sind also unterschiedlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
