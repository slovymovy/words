                        "translation_id": "f8f49008-bd03-467e-936d-66080e78cd71",
                        "source_entry_id": "66544947-72b3-36db-9333-aeb289f10a2d",
                        "source_sense_id": "ac83cd57-a368-3c4b-a06b-c7c4a33b1261",
                        "source_sense_description": "generation of physical symptoms for a psychiatric disorder",
                        "target_lang_word": "Somatisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Somatisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7390ec34-0c18-3411-bcac-2ddde856188c",
                                        "entry_id": "2c0da202-b45e-3139-891a-7ce6efcabd8b",
                                        "glosses": [
                                            "Umstand, dass sich psychische Gründe (vermutlich unbewusst) in körperlichen Beschwerden niederschlagen, diese sich also nicht oder nicht ausreichend nur auf organische Erkrankungen zurückführen lassen"
                                        ],
                                        "tags": [
                                            "Gesundheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11b5199-7c22-497d-8821-0fd3442b2123",
                                                "sense_id": "7390ec34-0c18-3411-bcac-2ddde856188c",
                                                "text": "„Aus solchem Mangel resultierten früher oder später Krankheiten, psychische oder, in Form einer Somatisierung, auch körperliche.“"
                                            },
                                            {
                                                "example_id": "6a9fae3a-6f56-47c7-94a9-e3c39db8b414",
                                                "sense_id": "7390ec34-0c18-3411-bcac-2ddde856188c",
                                                "text": "„Fälle sind typisch für die Untersuchungen der Psychosomatik, die beide, Psyche und Soma, Seele und Leib, des Menschen gleich, beachtet. Sie sind aber auch typisch für die heutigen Patienten, deren Krankheiten oft deshalb so rätselhaft sind, weil irgendwann eine „Psychisierung“ oder „Somatisierung“ der Beschwerden eingetreten ist.“ (1952)"
                                            },
                                            {
                                                "example_id": "0555f60b-5e22-4f11-9e31-3ed2719db5ef",
                                                "sense_id": "7390ec34-0c18-3411-bcac-2ddde856188c",
                                                "text": "Somatisierung wird definiert als die „Neigung, körperliche Beschwerden als Antwort auf psychosoziale Belastungen zu erfahren und zu vermitteln, und medizinische Hilfe dafür in Anspruch zu nehmen“."
                                            },
                                            {
                                                "example_id": "da695541-849a-4b5a-a0ed-696ebdb0d7c5",
                                                "sense_id": "7390ec34-0c18-3411-bcac-2ddde856188c",
                                                "text": "Gelingt es ihm, den Zwiespalt zwischen verschiedenen seelischen Motiven zu erkennen, lässt die Tendenz zu Konversion und Somatisierung nach."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
