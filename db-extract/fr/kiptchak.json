                        "sense_id": "2bdc9843-5a4e-374f-a877-57594f55da33",
                        "entry_id": "6be3dbe5-3bea-3610-9706-f87f9374f435",
                        "glosses": [
                            "Langue turque parlée par les Kiptchaks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389a76ab-3ca3-4049-9751-ad11e4f7942f",
                                "sense_id": "2bdc9843-5a4e-374f-a877-57594f55da33",
                                "text": "Les arméniens de Pologne avaient fini par perdre l'usage de la langue maternelle et parlé et écrit d'abord en kiptchak et ensuite en polonais. Les inscriptions en question reflètent l'évolution de ce changement linguistique."
                            },
                            {
                                "example_id": "1902b63e-4dbe-47cd-a56a-0e1fb2f311da",
                                "sense_id": "2bdc9843-5a4e-374f-a877-57594f55da33",
                                "text": "Il existe même une grammaire du kiptchak et un dictionnaire franco-arméno-kiptchak."
                            }
                        ]
                    }
                ],
