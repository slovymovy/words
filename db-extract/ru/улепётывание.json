                                    },
                                    {
                                        "sense_id": "cbab7475-e09f-3410-be21-5b661f9ccc91",
                                        "entry_id": "1e733962-3b29-3ca0-aa08-6d6d44cb6a28",
                                        "glosses": [
                                            "The feathers on an arrow or dart used to help it follow an even path."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "309ae355-86c3-46df-81a0-c09f76d80c03",
                                                "sense_id": "cbab7475-e09f-3410-be21-5b661f9ccc91",
                                                "text": "Baſſ. In my ſchoole dayes, when I had loſt one ſhaft / I ſhot his fellow of the ſelfeſame flight / The ſelfeſame way, with more aduiſed watch / To finde the other forth, and by aduenturing both, / I oft found both. I vrge this child-hoode proofe, […]"
                                            }
                                        ]
                                    },
