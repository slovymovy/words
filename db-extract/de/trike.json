                        "glosses": [
                            "dreirädriges Kraftfahrzeug, das Elemente von Motorrädern und Autos kombiniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d117c6-89e9-4430-a665-8b2476b879f7",
                                "sense_id": "cba8a53f-59d3-3efa-b53f-6fbd32cbdf73",
                                "text": "Ein Trike ist eine gute Alternative für Motorrad-Freunde, die sich auf zwei Rädern unsicher fühlen."
                            },
                            {
                                "example_id": "f2156aa8-63bf-4f43-817d-31b9ec4deb40",
                                "sense_id": "cba8a53f-59d3-3efa-b53f-6fbd32cbdf73",
                                "text": "Eine Frau cruist mit ihrem Trike über die Fahrbahnen."
                            },
                            {
                                "example_id": "b06042bf-4f28-4517-a204-7872eb1107f0",
                                "sense_id": "cba8a53f-59d3-3efa-b53f-6fbd32cbdf73",
                                "text": "Ein Trike ist ein dreispuriges und somit ein mehrspuriges Kraftfahrzeug."
                            }
                        ],
