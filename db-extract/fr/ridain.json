                                                "sense_id": "15c7add5-1d1b-349b-a940-ac5e09703bfd",
                                                "text": "Some of these CD rips don't sound very good: what bitrate did you use?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ee88fc-98bb-3c19-9bab-eefcfd259f62",
                                        "entry_id": "93939675-b497-3a90-8e2c-5ea630dba338",
