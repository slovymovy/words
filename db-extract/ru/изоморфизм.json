                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "Similarity of form",
                                            "the similarity in the crystal structures of similar chemical compounds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b562e12f-e38a-4b6c-80df-f8f9a5e040dc",
                                                "sense_id": "23d1bdaf-401c-3101-a338-324be7f0c65a",
                                                "text": "The isomorphism of compounds does not prove the isomorphism of their respective constituents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a966fa14-ead9-3f98-9ac7-dfa9919f6738",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "Similarity of form",
                                            "the similarity in the structure or processes of different organizations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
