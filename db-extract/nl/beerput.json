                        "source_entry_id": "ab4e0b0d-2d45-368a-9f4b-ec4347b72713",
                        "source_sense_id": "cd36d6e2-0ed3-365c-b4fd-3f76603e590d",
                        "source_sense_description": "een put waarin fecaliën verzameld worden",
                        "target_lang_word": "merdier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merdier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6159b3-5cc9-3a9a-8090-38b3db12bf4f",
                                        "entry_id": "0e04e814-464d-325d-a44a-e824e72473d8",
                                        "glosses": [
                                            "Bordel, désordre."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d336d6f0-090a-4acf-ad9b-7b0c9d712ed3",
                                                "sense_id": "5f6159b3-5cc9-3a9a-8090-38b3db12bf4f",
                                                "text": "C’est le merdier ici !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869820d9-f25e-3e64-b603-64aeeeb23bc1",
                                        "entry_id": "0e04e814-464d-325d-a44a-e824e72473d8",
                                        "glosses": [
                                            "Pétrin, panade, mauvaise situation, situation chaotique."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8bc52de-705e-4526-b4a7-1f3d8153c39d",
                                                "sense_id": "869820d9-f25e-3e64-b603-64aeeeb23bc1",
                                                "text": "Pierre s'est foutu dans un sacré merdier !"
                                            },
                                            {
                                                "example_id": "dc34b094-4f8c-4867-9d19-e5ad29a8295c",
                                                "sense_id": "869820d9-f25e-3e64-b603-64aeeeb23bc1",
                                                "text": "— Nous voilà propres ! Tu ne pouvais pas me dire que c’était là qu’on risquait de rester pris ! Je serais venu voir, et j’aurais mis des branches sur ce merdier !"
                                            },
                                            {
                                                "example_id": "609eb830-5edb-4a4e-929b-80732014921e",
                                                "sense_id": "869820d9-f25e-3e64-b603-64aeeeb23bc1",
                                                "text": "Je sais aujourd’hui – alors que je ne suis même pas encore à la moitié du vaste chantier dans lequel je me suis empêtrée (j’ai failli écrire : du vaste merdier dans lequel je me suis foutue), combien j’ai présumé de mes forces."
                                            },
                                            {
                                                "example_id": "a70f66a5-6725-4dd1-b830-f9bbdc1f0003",
                                                "sense_id": "869820d9-f25e-3e64-b603-64aeeeb23bc1",
                                                "text": "À l’inverse, avec Joe Biden gagnant, les mêmes démocrates auront aussi de quoi être accablés: les républicains ont le don de laisser un merdier derrière eux."
                                            },
                                            {
                                                "example_id": "cc273aa2-c038-4dce-b53b-d0835932e124",
                                                "sense_id": "869820d9-f25e-3e64-b603-64aeeeb23bc1",
                                                "text": "« Qu’est-ce qu’il fout, en plein merdier, à un colloque sur le wokisme ? » interroge ainsi un communiquant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
