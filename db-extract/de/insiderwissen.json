                "senses": [
                    {
                        "sense_id": "6df14425-1b43-3484-a613-38fb16ed7c3b",
                        "entry_id": "e4212788-0dcf-3dda-a2e2-35a97d221623",
                        "glosses": [
                            "Wissen, über das nur eingeweihte Personen verfügen, das einem bestimmten Personenkreis vorbehalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8014c5e5-13c0-4fc0-a432-5e35d0241140",
                                "sense_id": "6df14425-1b43-3484-a613-38fb16ed7c3b",
                                "text": "„Russ vermittelte ihm das Gefühl, dass der Personalchef aus ihrem Gespräch mehr lernte als er; Russ glänzte mit umfangreichem Insiderwissen über Sicherheitsarbeit in besonders gefährlichen Gegenden, und nach einigem Fachsimpeln erkundigte sich der andere Mann bei ihm nach Geheimtipps, an welchen ›Hotspots‹ die Firma denn in nächster Zukunft investieren solle.“"
                            },
                            {
                                "example_id": "a5168b69-b86b-4441-9db0-3878c59d7f1d",
                                "sense_id": "6df14425-1b43-3484-a613-38fb16ed7c3b",
                                "text": "„Hin und wieder meldete er sich sogar ungefragt und half ihnen mit Insiderwissen zu wichtigen Themen.“"
                            },
                            {
                                "example_id": "6a7f46cb-4150-4b4f-9ecc-92b9e0df4f25",
                                "sense_id": "6df14425-1b43-3484-a613-38fb16ed7c3b",
                                "text": "„Man braucht Insiderwissen, um wirklich plausible Alibis für die Klienten zu entwerfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
