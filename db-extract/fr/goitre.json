        "fr-extract.jsonl": [
            {
                "entry_id": "c5ab0742-57f9-389d-a39f-b9584f256d64",
                "word": "goitre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "895a95df-2eef-407d-9123-b6ce3383d411",
                        "entry_id": "c5ab0742-57f9-389d-a39f-b9584f256d64",
                        "tags": [
                            "plural"
                        ],
                        "form": "goitres"
                    },
                    {
                        "form_id": "4171b51a-b680-477d-9b04-98a1e79c2ae4",
                        "entry_id": "c5ab0742-57f9-389d-a39f-b9584f256d64",
                        "tags": [],
                        "form": "goître"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                        "entry_id": "c5ab0742-57f9-389d-a39f-b9584f256d64",
                        "glosses": [
                            "Hypertrophie diffuse de la glande thyroïde au-devant de la trachée-artère et du larynx et qui déforme le cou. Ce nom est aussi parfois donné à d’autres sortes d’atteintes de la thyroïde, quelle qu’en soit l’étiologie (goitre tuberculeux, goitre cancéreux, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8b4a72-bc55-46a5-9e7a-5096bfdfafee",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "Elle [la duchesse de Bourgogne] avait le cou long avec un soupçon de goitre qui ne lui seyait point mal."
                            },
                            {
                                "example_id": "0d9697e9-a088-4333-9062-e8e8825a6ebd",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "Ces femmes qui passaient devant la maison de mon oncle, paysannes avec des goitres, revenant des champs et des vignes avec des corbeilles de fruits sur la tête, s’arrêtaient toujours pour m’offrir les raisins les plus dorés, les plus délicieuses pêches."
                            },
                            {
                                "example_id": "cf82f771-b642-4b3e-9a8b-896303c6b110",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "LYON – […] Vilaine population ; beaucoup de goitres. Mes jeunes officiers disent que les cheveux et les dents tombent vite."
                            },
                            {
                                "example_id": "bc00617c-23a6-4992-b64e-8b3e34b19a90",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "La peur des goitres me faisait obéissant et silencieux. J’en avais vu beaucoup, au marché, à la gorge des montagnardes qui vendent les châtaignes, et notre beurrière aussi en portait un, gonflé au-dessus des deux autres comme un troisième sein."
                            },
                            {
                                "example_id": "3869c4c4-be9b-4336-acaf-b3fe8278db70",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "Leur égoïsme monstrueux pousse comme un goitre à la place de leur cœur atrophié."
                            },
                            {
                                "example_id": "adb8824d-ee23-4bd5-a16e-43c60a33a4b4",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "Vers dix heures, un vieillard parut au seuil de la coutellerie, et rien de lui ne me frappa d’abord, sinon un goitre que dérobait mal un foulard de soie blanche."
                            },
                            {
                                "example_id": "4d081717-da0c-4e6b-93fc-35fd2867439a",
                                "sense_id": "0613ebf7-f147-3261-8c7e-b633ca626cd0",
                                "text": "Quand tout va bien, la petite glande se tient coite. C’est donc par l’une de ses déviances majeures qu’elle parvint tout d’abord à attirer l’attention : le goitre, caractérisé par un corps thyroïde de volume supérieur à la normale, aurait été mentionné dès 2800 avant J.-C. par un empereur chinois."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dfd2bde-5f64-3620-bf25-55013f21f46d",
                        "entry_id": "c5ab0742-57f9-389d-a39f-b9584f256d64",
                        "glosses": [
                            "Expansion cutanée qui pend sous le cou de plusieurs batraciens, reptiles ou oiseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b87230d-27f1-467a-be9d-35015b1af88d",
                                "sense_id": "6dfd2bde-5f64-3620-bf25-55013f21f46d",
                                "text": "La rainette, atteinte en plein flanc, écartait les pattes et ouvrait la gueule en montrant son goitre blanc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7548c0d6-17d8-4071-8b07-db2b7c3359cd",
                        "source_entry_id": "c5ab0742-57f9-389d-a39f-b9584f256d64",
                        "target_lang_word": "Kropf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kropf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a22d6a6e-e623-3f5b-83a8-5e4cfccfa5b2",
                                        "entry_id": "ccf95036-cb54-3ea4-986b-784f33eed2c7",
                                        "glosses": [
                                            "krankhafte Verdickung der Schilddrüse beim Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dee0446a-b3ec-4ac3-bd4a-abcc22d7099d",
                                                "sense_id": "a22d6a6e-e623-3f5b-83a8-5e4cfccfa5b2",
                                                "text": "Der Kropf kam früher in Gebirgsgegenden wie zum Beispiel im Schwarzwald gehäuft vor."
                                            },
                                            {
                                                "example_id": "0a9def44-9534-4762-9804-ec7607a60cac",
                                                "sense_id": "a22d6a6e-e623-3f5b-83a8-5e4cfccfa5b2",
                                                "text": "Schon 1816 wurde Jod zur Behandlung des Kropf angewendet."
                                            },
                                            {
                                                "example_id": "69b18299-c061-4edb-8fad-d8e7302e1242",
                                                "sense_id": "a22d6a6e-e623-3f5b-83a8-5e4cfccfa5b2",
                                                "text": "„In der Straßenbahn sitzt ein Mann mit einem gewaltigen Kropf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "403eb461-b3b2-3730-bc9f-e109b809b091",
                                        "entry_id": "ccf95036-cb54-3ea4-986b-784f33eed2c7",
                                        "glosses": [
                                            "drüsenreiche Ausstülpung der Speiseröhre zur Vorverdauung der Nahrung"
                                        ],
                                        "tags": [
                                            "bei Vögeln, insbesondere bei Tauben und Geflügel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9963ad36-5e89-4b3f-855b-4156f1a49ace",
                                                "sense_id": "403eb461-b3b2-3730-bc9f-e109b809b091",
                                                "text": "Eine Taube kann sehr schnell sehr viele Körner fressen und diese erst einmal im Kropf aufnehmen."
                                            },
                                            {
                                                "example_id": "4a95d78f-b3a8-4e68-bfd5-4b56b8ca28a8",
                                                "sense_id": "403eb461-b3b2-3730-bc9f-e109b809b091",
                                                "text": "Samen und Körner werden im Kropf von Mama Taube vorverdaut und zur Fütterung der Brut verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "60be2eaf-16cf-3c87-82a7-0601049717a3",
                                        "entry_id": "ccf95036-cb54-3ea4-986b-784f33eed2c7",
                                        "glosses": [
                                            "Teil des Vorderdarms vor dem Kaumagen zum Aufsaugen der Nahrung"
                                        ],
                                        "tags": [
                                            "Insekten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad3144c-8269-4e1e-bbb5-42cf201782ea",
                                                "sense_id": "60be2eaf-16cf-3c87-82a7-0601049717a3",
                                                "text": "Schmetterlinge haben einen Kropf, in den sie ihre flüssige Nahrung aufnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e21a56b-1f8b-3b6f-bb44-5350f6dac97e",
                                        "entry_id": "ccf95036-cb54-3ea4-986b-784f33eed2c7",
                                        "glosses": [
                                            "durch Bakterien hervorgerufene Wucherungen an Pflanzen, zum Beispiel am Kohl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69fd275c-517e-4ffc-88d4-884c1c75a972",
                                                "sense_id": "8e21a56b-1f8b-3b6f-bb44-5350f6dac97e",
                                                "text": "Es bildete sich ein Kropf am Kohl."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
