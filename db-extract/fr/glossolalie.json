                                            {
                                                "example_id": "0218d749-fd53-4f19-98ff-14abeb39ae55",
                                                "sense_id": "49274809-b1f2-3975-a032-23fd465c40ef",
                                                "text": "방언은 흔히 한 지방의 서민들의 구어에서 발전한다."
                                            },
                                            {
                                                "example_id": "c72dd591-2800-42ae-b3cc-180916ad60bc",
                                                "sense_id": "49274809-b1f2-3975-a032-23fd465c40ef",
                                                "text": "제주도의 방언은 다른 한국어의 방언에 비해 매우 독특하다."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "방언",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "969097d7-8f7f-30a6-abd8-d091fd409d3e",
                                        "entry_id": "637a2b61-886b-30b2-ad2e-a2c8c6066c66",
                                        "glosses": [
                                            "낮잡거나 비방하는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2199ef0-19e2-430e-ae73-cde7cc88f60a",
                                                "sense_id": "969097d7-8f7f-30a6-abd8-d091fd409d3e",
                                                "text": "방언을 함부로 쓰는 것은 바람직하지 않다."
                                            }
