                        "examples": [
                            {
                                "example_id": "f312b359-f511-4087-9cbd-0c6de992ba6a",
                                "sense_id": "efac26e3-55a2-3e5b-8e4d-2352019faf5c",
                                "text": "Ces mouvemens étoient occasionés par les efforts que faisoit la Chrysalide pour désengrainer ses piquans."
                            },
                            {
                                "example_id": "4449b200-9567-42da-bd4f-bae92b8ac5cb",
                                "sense_id": "efac26e3-55a2-3e5b-8e4d-2352019faf5c",
                                "text": "La Reine, qui d’abord avoit voulu par prudence maintenir les tabourets, suivant son inclination et les sentimens de son ministre parut aussitôt ne point désagréer ce qui se faisoit ; et les soirs, à son coucher, elle souffroit que ceux qui étoient les plus animés contre les faux princes lui parlassent librement contre eux."
                            }
                        ]
                    }
