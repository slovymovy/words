                        "glosses": [
                            "Relatif à la ville de Bayreuth en Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4823fc05-82ae-4e22-bf63-d0a8cc039c06",
                                "sense_id": "1763b40b-e315-365a-b1ea-ce89c34cd48a",
                                "text": "Richard Wagner fait connaître au président du conseil municipal bayreuthien, le banquier Friedrich Feustel, ses intentions relatives au Festival."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebb72244-2b23-36c4-95c2-23eb46a5fb1e",
                        "entry_id": "f1e234d7-bc12-3f39-9fb0-8e0d0cc2fca2",
                        "glosses": [
                            "Relatif au festival de Bayreuth."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6e44228b-bff8-4068-9a06-2ef91abd013a",
                                "sense_id": "ebb72244-2b23-36c4-95c2-23eb46a5fb1e",
                                "text": "Ce Ring demandait effectivement une connaissance particulièrement fine de l’univers et l’histoire de la RDA et du monde marxiste / communiste − ce qui n’est pas forcément le cas du spectateur bayreuthien moyen, et encore moins du spectateur français."
                            },
                            {
                                "example_id": "155cee1f-a4e1-4c03-bc39-33d69186ec73",
                                "sense_id": "ebb72244-2b23-36c4-95c2-23eb46a5fb1e",
                                "text": "Ce procédé classieux serait-il la signature de Dieter Dorn ? Il servait déjà fort à propos son Fliegende Holländer bayreuthien de 1990 (qui avait eu le seul tort de succéder au choc historique de celui d’Harry Kupfer mais qui était, rappelons-le, celui, tout de même marquant, où la maison de Daland effectuait une mémorable rotation de 360°!)"
                            }
                        ]
                    }
