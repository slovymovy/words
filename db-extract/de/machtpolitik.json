                ],
                "senses": [
                    {
                        "sense_id": "73022046-6960-3d71-b3a4-ee5dabff7915",
                        "entry_id": "4b889db1-c87e-313c-a3ea-87afc0f29f78",
                        "glosses": [
                            "Politik, welche einzig auf Entfaltung und Behauptung von Macht gerichtet ist"
                        ],
                        "tags": [
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "35689aca-3134-4006-8951-2443f38779a9",
                                "sense_id": "73022046-6960-3d71-b3a4-ee5dabff7915",
                                "text": "„Das ist eine der Regeln der Machtpolitik: Man kann etliche glänzende Einfälle haben - sobald man dabei einen schweren Fehler begeht, wird man fortgejagt. Also versucht man das Risiko, das jeder Originalität innewohnt, zu vermeiden, um die Führungsposition zu erhalten.“"
                            },
                            {
                                "example_id": "7c136142-77fd-4481-82fd-6288cf6f88fc",
                                "sense_id": "73022046-6960-3d71-b3a4-ee5dabff7915",
                                "text": "„Durch die gemeinsam erlebten politischen Umwälzungen seit 1914 pflegen die Europäer ein ganz eigenes, hoch entwickeltes Verständnis von Machtpolitik und politischer Verantwortung.“"
                            },
                            {
                                "example_id": "73619e34-ee8c-4e28-9b7b-e7650e953ce3",
                                "sense_id": "73022046-6960-3d71-b3a4-ee5dabff7915",
                                "text": "„Aber die Rückabwicklung der Nachkriegsordnung und die Wiederkehr der überwunden geglaubten Machtpolitik könnte alte nationale Erfahrungen in neuem Licht erscheinen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
