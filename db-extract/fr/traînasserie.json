                        "glosses": [
                            "Action de traîner en longueur."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7cc27679-cd0b-42c5-a46c-b6150e0bccd3",
                                "sense_id": "9ca2f912-d4a2-38e7-a45f-f614000127d5",
                                "text": "Cette vivacité dont je suis fier est-elle la vitesse ? Ou bien une traînasserie déguisée, un moyen de temporiser, d’éluder les vraies réponses, de suspendre, grâce à des sautillements, le grand saut que chaque homme doit faire dans l’inconnu ?"
                            },
                            {
                                "example_id": "eb5dbe7b-3531-4a35-9bfd-7f7f8ebbadca",
                                "sense_id": "9ca2f912-d4a2-38e7-a45f-f614000127d5",
                                "text": "Après une heure de traînasserie, les enfant se décidèrent enfin à lever le siège."
                            }
                        ]
                    }
