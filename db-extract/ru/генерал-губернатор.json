                                                "example_id": "a52db223-0777-4f7d-b933-bbf47e02d63a",
                                                "sense_id": "7d992ba9-2439-3e25-8725-6344613070a5",
                                                "text": "„Am 26. März 1873 erklärte der in Batavia residierende niederländische Generalgouverneur dem Sultan von Aceh den Krieg.“"
                                            },
                                            {
                                                "example_id": "3591c36b-ceb9-4293-9723-dac86c97593c",
                                                "sense_id": "7d992ba9-2439-3e25-8725-6344613070a5",
                                                "text": "„Der französische Generalgouverneur Dupleix war der Pionier auf dem Gebiet der Rekrutierung und Ausbildung indischer Infanterietruppen gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
