    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95ccab3d-b8c7-3ef4-af3f-41ef500518f6",
                    "sense_definition": "Занимающий более низкое, зависимое положение по сравнению с кем-то, подотчётный кому-то.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "subordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый <w>подчинённый</w> обязан выполнять распоряжения своего руководителя.",
                            "target_lang_translations": {
                                "en": "Every <w>subordinate</w> is obliged to carry out the orders of their manager."
                            }
                        },
                        {
                            "text": "Опытный начальник всегда прислушивается к мнению своих <w>подчинённых</w> лиц.",
                            "target_lang_translations": {
                                "en": "An experienced manager always listens to the opinions of their <w>subordinates</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "зависимый"
                    ],
                    "antonyms": [
                        "руководящий",
                        "начальник",
                        "командир",
                        "руководитель"
                    ],
                    "common_phrases": [
                        "непосредственный подчинённый"
                    ],
                    "target_lang_definitions": {
                        "en": "Occupying a lower, dependent position compared to someone; accountable to someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subordinate",
                                "target_lang_sense_clarification": "Placed in a lower rank or position."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5318d04-f074-3286-b94b-6b6bf2e53d23",
                    "sense_definition": "Второстепенный, менее важный.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "subordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это лишь <w>подчинённый</w> вопрос, который не требует немедленного решения.",
                            "target_lang_translations": {
                                "en": "This is only a <w>secondary</w> issue that does not require an immediate decision."
                            }
                        },
                        {
                            "text": "Все <w>подчинённые</w> детали проекта были согласованы заранее.",
                            "target_lang_translations": {
                                "en": "All <w>subordinate</w> details of the project were agreed upon in advance."
                            }
                        }
                    ],
                    "synonyms": [
                        "второстепенный"
                    ],
                    "antonyms": [
                        "главный",
                        "важнейший"
                    ],
                    "target_lang_definitions": {
                        "en": "Secondary, less important."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "secondary",
                                "target_lang_sense_clarification": "Of lesser importance or rank."
                            },
                            {
                                "target_lang_word": "subordinate",
                                "target_lang_sense_clarification": "Made subservient or secondary."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acbc418e-f88f-3dbc-823c-00e9b8b773b5",
                    "sense_definition": "Исполнитель, лицо, подчиняющееся какому-либо начальнику или руководителю.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "subordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Объясните <w>подчинённым</w>, что такое диффамация и какие риски создаёт пост в блоге.",
                            "target_lang_translations": {
                                "en": "Explain to your <w>subordinates</w> what defamation is and what risks a blog post creates."
                            }
                        },
                        {
                            "text": "Хороший руководитель всегда защищает своего <w>подчинённого</w> перед вышестоящим начальством.",
                            "target_lang_translations": {
                                "en": "A good manager always defends their <w>subordinate</w> before higher management."
                            }
                        }
                    ],
                    "synonyms": [
                        "служащий",
                        "исполнитель"
                    ],
                    "antonyms": [
                        "начальник",
                        "руководитель"
                    ],
                    "common_phrases": [
                        "группа подчинённых"
                    ],
                    "target_lang_definitions": {
                        "en": "An executor, a person who obeys a superior or manager."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subordinate",
                                "target_lang_sense_clarification": "A person under the authority of another."
                            },
                            {
                                "target_lang_word": "employee",
                                "target_lang_sense_clarification": "A person employed for wages or salary."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aee6d460-c741-3ae3-9f6d-2cd44f1c170e",
                    "sense_definition": "Страдательное причастие прошедшего времени от глагола <w>подчинить</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Территория, <w>подчинённая</w> местному губернатору, была полностью восстановлена.",
                            "target_lang_translations": {
                                "en": "The territory <w>subordinated</w> to the local governor was completely restored."
                            }
                        },
                        {
                            "text": "Всё было <w>подчинено</w> одной главной цели — победе в соревновании.",
                            "target_lang_translations": {
                                "en": "Everything was <w>subordinated</w> to one main goal — victory in the competition."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'to subordinate'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subordinated",
                                "target_lang_sense_clarification": "Made subservient or placed in a lower rank."
                            },
                            {
                                "target_lang_word": "subject to",
                                "target_lang_sense_clarification": "Under the authority or control of."
                            }
                        ]
                    }
