                        "entry_id": "0bd5950d-d59c-33af-9c66-a7ee35eece18",
                        "glosses": [
                            "verlengde luxe personenwagen met chauffeur, vaak voorzien van getinte ruiten"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c23572c6-7645-4c98-9cae-149e3790abcf",
                                "sense_id": "0d8877c6-c5bc-3a65-af3a-f8cfc46fadb8",
                                "text": "Vertel mij niets over omroepen: ze halen je met een blauwe limo van huis en 's nachts mag je lopend in de regen vertrekken."
                            }
                        ]
