                    },
                    {
                        "translation_id": "e72297c1-3d98-4d4a-9d3f-8b7fcd6470dc",
                        "source_entry_id": "5c254e2b-4ed0-3d23-b74a-66b46cc0e082",
                        "source_sense_id": "b1133940-71bd-394f-881b-9565a5ea8b5d",
