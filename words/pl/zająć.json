            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc397b5d-73df-3463-9c34-91a2c785052d",
                    "sense_definition": "osiągnąć określoną pozycję w rankingu lub zawodach",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pozycja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasza drużyna zdołała <w>zająć</w> pierwsze miejsce w turnieju.",
                            "target_lang_translations": {
                                "en": "Our team managed to <w>take</w> first place in the tournament.",
                                "ru": "Нашей команде удалось <w>занять</w> первое место в турнире."
                            }
                        },
                        {
                            "text": "Musisz się postarać, aby <w>zająć</w> wysokie miejsce w klasyfikacji.",
                            "target_lang_translations": {
                                "en": "You must try hard to <w>take</w> a high position in the rankings.",
                                "ru": "Тебе нужно постараться, чтобы <w>занять</w> высокое место в рейтинге."
                            }
