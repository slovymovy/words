                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "419c92ca-51ce-46a6-81dc-645f6191395e",
                        "source_entry_id": "6e78ca32-4bd4-3a1b-8103-fbfa5daf9bc6",
                        "source_sense_id": "e778d7bd-80d5-3791-921c-1fc8e91d070c",
                        "source_sense_description": "producer or director of films / movies",
                        "target_lang_word": "cinéaste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinéaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3510566-8ad0-3ce6-a8ef-16a76d171a5d",
                                        "entry_id": "21d5b0f6-dbf1-37c0-9408-7a307f6ba8ce",
                                        "glosses": [
                                            "Réalisateur ou réalisatrice de film de cinéma qui a pour particularité de considérer son travail comme un art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df36036-6663-412a-b174-2201c78ebcaa",
                                                "sense_id": "a3510566-8ad0-3ce6-a8ef-16a76d171a5d",
                                                "text": "Si une image vaut mille mots et qu'un film est composé de plusieurs centaines de milliers d'images, le film devient le meilleur outil pour transférer pleinement au spectateur l'idée que le cinéaste veut véhiculer."
                                            },
                                            {
                                                "example_id": "a619eb4f-3a0c-43d5-84e9-35a9df1ad855",
                                                "sense_id": "a3510566-8ad0-3ce6-a8ef-16a76d171a5d",
                                                "text": "Son diplôme en poche, Léon était parti tenter sa chance à Los Angeles, où, c’est bien connu, on manque de cinéastes."
                                            },
                                            {
                                                "example_id": "6f1e758e-f4ec-4e8e-add2-8c04d4087123",
                                                "sense_id": "a3510566-8ad0-3ce6-a8ef-16a76d171a5d",
                                                "text": "La star internationale, hyperglamour sur les marches du Palais — le 20 mai, aux côtés des deux cinéastes belges et de Fabrizio Rongione — peut-elle encore s’effacer au profit de son personnage ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37d31400-1add-4e80-a33d-9173c2380878",
                        "source_entry_id": "6e78ca32-4bd4-3a1b-8103-fbfa5daf9bc6",
                        "source_sense_id": "e778d7bd-80d5-3791-921c-1fc8e91d070c",
                        "source_sense_description": "producer or director of films / movies",
                        "target_lang_word": "Filmemacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Filmemacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e760e523-b59f-31b1-bdd6-eea67059d3bf",
                                        "entry_id": "8a7d8d35-c83a-3bd7-90ea-e01607e41b36",
                                        "glosses": [
                                            "jemand, der bei Spiel-, Kurz- oder Dokumentarfilmen Regie führt, meist auch deren Autor ist und seine Arbeit als künstlerisches Werk betrachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe39dea-51ae-46da-829e-81637be02fc8",
                                                "sense_id": "e760e523-b59f-31b1-bdd6-eea67059d3bf",
                                                "text": "Der wahrscheinlich erste Filmemacher des Landes war Mirza Ebrahim Khan Akkas Bashi, Hoffotograf des Schah Muzaffar ad-Din."
                                            },
                                            {
                                                "example_id": "2938c6bb-b022-416f-bd40-473ec2895bbc",
                                                "sense_id": "e760e523-b59f-31b1-bdd6-eea67059d3bf",
                                                "text": "Die Schauspieler, alles begabte und ansehnliche junge Leute, dürfen dabei die meiste Zeit improvisieren, statt einem spießigen Drehbuch zu folgen, und der Filmemacher probiert dabei die Möglichkeiten aus, die das Kino bietet."
                                            },
                                            {
                                                "example_id": "e524201b-4790-421d-b90d-451d5ffacf37",
                                                "sense_id": "e760e523-b59f-31b1-bdd6-eea67059d3bf",
                                                "text": "„Ein Filmemacher ist nicht etwa einer, der diesen einen Film gemacht hat, von dem gerade alle sprechen.“"
                                            },
                                            {
                                                "example_id": "8a71ea54-a4a9-42c0-8144-86d54574a910",
                                                "sense_id": "e760e523-b59f-31b1-bdd6-eea67059d3bf",
                                                "text": "„Wer sich als deutscher Filmemacher auf das Niveau von Hollywood herablässt, verliert jede künstlerische Glaubwürdigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
