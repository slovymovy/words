                "senses": [
                    {
                        "sense_id": "a904078d-3e26-3751-b780-79e59dbce9b0",
                        "entry_id": "ddd73d51-c922-3b73-9571-8824f320848e",
                        "glosses": [
                            "Einstellung/Haltung, die die Ausübung von Gewalt begünstigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f428bb-38ae-4f1c-9a9c-4a36b3434cf3",
                                "sense_id": "a904078d-3e26-3751-b780-79e59dbce9b0",
                                "text": "„Zur Gewaltbereitschaft kam die schwierige Frage des Glaubens.“"
                            },
                            {
                                "example_id": "4bf8d8dc-e8b7-4ee9-aa76-978a353f55f9",
                                "sense_id": "a904078d-3e26-3751-b780-79e59dbce9b0",
                                "text": "„Die Gewaltbereitschaft war nicht das Resultat einer Eskalation, sondern sie stand bereits am Anfang einer Konfliktgeschichte, deren Protagonisten die Intellektuellen waren.“"
                            },
                            {
                                "example_id": "5af71260-0b1f-46c5-898e-7db47d30980b",
                                "sense_id": "a904078d-3e26-3751-b780-79e59dbce9b0",
                                "text": "„In seinen Schritten lag eine mühsam unterdrückte Gewaltbereitschaft wie bei einem Berufsboxer auf dem Weg in den Ring.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
