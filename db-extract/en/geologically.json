                    },
                    {
                        "sense_id": "38412d9c-dd71-34d9-9aa1-b557cfeecfdb",
                        "entry_id": "a29ff276-cf48-37eb-b423-2480ff3e4bad",
                        "glosses": [
                            "Concerning geology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "48492cdf-7773-428e-9bb6-6fcdf9065558",
                                "sense_id": "38412d9c-dd71-34d9-9aa1-b557cfeecfdb",
                                "text": "The El Dorado-Searchlight area is geologically a north-south trending orogenous zone, paralleled on the east by the valley of the Colorado, and by an alluvial valley on the west."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07073003-0ea3-4ea0-9743-03140ed15adf",
                        "source_entry_id": "a29ff276-cf48-37eb-b423-2480ff3e4bad",
                        "source_sense_description": "as part of a geologic process",
                        "target_lang_word": "géologiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géologiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                        "entry_id": "c63bd2cb-c34e-323c-afd0-31778f3664c2",
                                        "glosses": [
                                            "D'une manière conforme à la géologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d8430e-247d-4b54-a8f5-f7395de8b10d",
                                                "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                                "text": "Les lieux qui forment le département des Ardennes, considérés géologiquement, sont constitués par le terrain ardoisier au nord, le terrain calcaire jurassique au milieu, le terrain crétacé au midi."
                                            },
                                            {
                                                "example_id": "6a2ab979-cbe1-49ae-b379-376a4e57768d",
                                                "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                                "text": "Géologiquement parlant, ces puissantes gibbosités [pics des Alpes] sont le produit d’un entre-croisement d’au moins deux dislocations."
                                            },
                                            {
                                                "example_id": "6e42015e-706c-4f04-8db1-8c75adbb6025",
                                                "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                                "text": "Il se peut que, géologiquement parlant, ce jour ne doit pas être très éloigné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
