                "senses": [
                    {
                        "sense_id": "f91fe551-1548-383d-9ba1-06bb5fd2c7f9",
                        "entry_id": "1c7a9f88-3b15-3423-afc6-6f453d17f0b4",
                        "glosses": [
                            "Donner un caractère pharisien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07cf1c39-5b0b-4848-88ea-0ca740d7a08a",
                                "sense_id": "f91fe551-1548-383d-9ba1-06bb5fd2c7f9",
                                "text": "Elle s’explique semble-t-il par l’impatience des Sages, soucieux de « pharisianiser » si l’on peut dire le judaïsme après 70, devant la négligence, voire l’indifférence halakhique, d’une partie des enfants d’Israël."
                            },
                            {
                                "example_id": "d3622749-acbf-484c-8a78-4213331e5459",
                                "sense_id": "f91fe551-1548-383d-9ba1-06bb5fd2c7f9",
                                "text": "Jusqu’à nos jours le pouvoir et donc l’autorité, au sens de l’empire, au sens laïcisé, au sens pharisianisé n’ont pas encore été admis comme la loi de l’Église catholique."
                            }
                        ]
                    }
