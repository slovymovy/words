                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом году зима наступила <w>ранее</w> обычного.",
                            "target_lang_translations": {
                                "en": "This year winter arrived <w>earlier</w> than usual.",
                                "zh": "今年冬天比往年<w>更早</w>到来。",
                                "nl": "Dit jaar begon de winter <w>eerder</w> dan gebruikelijk.",
                                "pl": "W tym roku zima nadeszła <w>wcześniej</w> niż zwykle.",
                                "de": "In diesem Jahr begann der Winter <w>früher</w> als gewöhnlich.",
                                "fr": "Cette année, l'hiver est arrivé <w>plus tôt</w> que d'habitude.",
                                "it": "Quest'anno l'inverno è arrivato <w>prima</w> del solito.",
                                "cs": "Letos zima nastala <w>dříve</w> než obvykle.",
                                "tr": "Bu yıl kış, normalden <w>daha erken</w> geldi.",
                                "es": "Este año el invierno llegó <w>antes</w> de lo habitual."
                            }
                        },
                        {
                            "text": "Мы должны выехать <w>ранее</w>, чтобы не опоздать на поезд.",
                            "target_lang_translations": {
                                "en": "We must leave <w>earlier</w> so as not to miss the train.",
                                "zh": "我们必须<w>提早</w>出发，以免错过火车。",
                                "nl": "We moeten <w>eerder</w> vertrekken om de trein niet te missen.",
                                "pl": "Musimy wyjechać <w>wcześniej</w>, żeby nie spóźnić się na pociąg.",
                                "de": "Wir müssen <w>früher</w> losfahren, um den Zug nicht zu verpassen.",
                                "fr": "Nous devons partir <w>plus tôt</w> pour ne pas rater le train.",
                                "it": "Dobbiamo partire <w>prima</w> per non perdere il treno.",
                                "cs": "Musíme vyjet <w>dříve</w>, abychom nezmeškali vlak.",
                                "tr": "Treni kaçırmamak için <w>daha erken</w> yola çıkmalıyız.",
                                "es": "Debemos salir <w>más temprano</w> para no perder el tren."
                            }
