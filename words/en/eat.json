                    "frequency": "Low",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old printer <w>ate</w> my paper and now it is jammed.",
                            "target_lang_translations": {
                                "ru": "Старый принтер <w>зажевал</w> бумагу, и теперь её заклинило."
                            }
                        },
                        {
                            "text": "Be careful because the vending machine <w>eats</w> coins without giving snacks.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, потому что торговый автомат <w>съедает</w> монеты, не выдавая еду."
                            }
