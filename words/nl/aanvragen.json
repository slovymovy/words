                            },
                            {
                                "target_lang_word": "request",
                                "target_lang_sense_clarification": "to ask for something formally or politely"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "to request a product or service, like a brochure"
