                                "sense_id": "d7c84f44-c002-3fce-a891-fa36bc46f886",
                                "text": "Corps bulbeux. Substance bulbeuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fb75ff7-a61c-3545-a9dc-4cb5a2d7f4ab",
                        "entry_id": "76b97ea6-2c0f-32f1-850f-ad25fac7c39c",
                        "glosses": [
                            "Qui a la forme d'un bulbe."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0c05749f-ff46-4334-b243-d84be20c8bfb",
                                "sense_id": "6fb75ff7-a61c-3545-a9dc-4cb5a2d7f4ab",
                                "text": "Il fut accueilli par une grande dame pâle, large de hanches, avec une verrue glabre placée près de l'une des narines de son nez bulbeux."
                            },
                            {
                                "example_id": "e21af60b-3ad4-4271-8628-b987ea160f4f",
                                "sense_id": "6fb75ff7-a61c-3545-a9dc-4cb5a2d7f4ab",
                                "text": "Le clocher carré à toit bulbeux est typiquement franc-comtois, voire haut-patatois."
                            }
                        ]
                    }
