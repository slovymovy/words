                ],
                "senses": [
                    {
                        "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                        "entry_id": "1cf80866-a0a8-376b-b29e-16109459f98e",
                        "glosses": [
                            "Organisation einer Datenbank, also vereinfacht der Beziehungen von Tabellen untereinander in einem gemeinsamen System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e9f780-7011-4ada-969d-748223e24902",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Bevor wir das System aktivieren können, bedarf es noch diverser Vorbereitungen. Dazu gehört unter anderem die Initialisierung der Datenbankstruktur.“"
                            },
                            {
                                "example_id": "4310ee5a-66c1-4875-9bad-52572b5ada31",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Bevor es ans Programmieren geht, müssen wir uns zunächst eine möglichst sinnvolle Datenbankstruktur ausdenken.“"
                            },
                            {
                                "example_id": "87f5d225-d624-43d9-aa55-5978e9bdddbe",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Viele Webframeworks bieten migrations, Unterprogramme, welche die Datenbankstruktur anpasst, mit an, um nötige Datenbankänderungen automatisch auszuführen.“"
                            },
                            {
                                "example_id": "d7a1ac0a-501a-470d-a561-0527617ee88c",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Die Baumgrafik des Datenbankschemas (Abbildung 1) ist hilfreich, um den Aufbau einer Datenbank zu verstehen. Richtig nützlich wird ein grafisches Tool zur Datenbankverwaltung jedoch erst, wenn es das Anpassen von Datenbankstruktur und -inhalt erleichtert.“"
                            },
                            {
                                "example_id": "74f28cd2-d5ed-4112-a3d0-ad2626ff976e",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Wenn der Datenbankserver Benchmark-Funktionen unterstützt, kann der Angreifer diese dazu nutzen, um Informationen über die Datenbankstruktur in Erfahrung zu bringen.“"
                            },
                            {
                                "example_id": "ac11e492-a7e2-4266-93c5-9988baf04319",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Weiterhin ermöglicht das Programm die graphische Darstellung von Tabellen und ihrer Beziehungen zueinander, sodass man sich auf diese Weise einen Überblick über die Datenbankstruktur verschaffen kann.“"
                            },
                            {
                                "example_id": "bd07ec16-a529-46b7-b4f2-99970c80e076",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„LDAP ist in NDS (Novell Directory Services) und in Microsofts Active Directory integriert. Es ist ein offener Standard für einen Informationsdienst auf Basis einer baumähnlichen Datenbankstruktur.“"
                            },
                            {
                                "example_id": "493da835-c9fa-4686-9360-6eb028ebb5ea",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Ein sehr gutes und etwas komplexeres Beispiel zu einer möglichen Datenbankstruktur inklusive einer Erklärung zur »Best Practice« bei der Wahl der Schlüsselnamen, ist auch in der offiziellen Redis-Dokumentation zu finden.“"
                            },
                            {
                                "example_id": "3c161d2e-1261-4104-b501-342e10bdf0ff",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Nach dem Start präsentiert sich Kexi in einem einfach gehaltenen Fenster (Abbildung 6). Über die Menüstruktur links baut der Anwender entweder schrittweise eine Datenbankstruktur auf oder lädt eine bereits vorhandene Datenbank.“"
                            },
                            {
                                "example_id": "a39861b3-9448-4bfd-ab75-9e4c578846e4",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Schwierigkeiten bereiten Datenstrukturen des Altsystems, die sich so nicht in die neue Datenbankstruktur migrieren lassen.“"
                            },
                            {
                                "example_id": "c69b0a39-6bbb-4626-9c83-a83ae4d159e8",
                                "sense_id": "462b23f7-b137-3540-a6dc-af05b9a7d64e",
                                "text": "„Mit einer einzigen Datensatzart bzw. Tabelle kommt man also im vorliegenden Fall nicht zu einer guten Datenbankstruktur. Eine gute Datenbankstruktur findet man nur dann, wenn die Datenfelder auf mehrere Datensatzarten bzw. Tabellen verteilt werden, wie dies die Abb. 1.7 zeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
