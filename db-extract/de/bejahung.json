                "senses": [
                    {
                        "sense_id": "8a14d108-454c-31b6-8e29-7ef7a3e140d9",
                        "entry_id": "43b9bca2-fddd-3441-8b15-a09e5f7417a7",
                        "glosses": [
                            "das Bejahen oder die Tatsache, dass man zu einem Sachverhalt „ja“ gesagt hat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef166e4d-e094-4e26-ad58-1f9ad1328a51",
                                "sense_id": "8a14d108-454c-31b6-8e29-7ef7a3e140d9",
                                "text": "Seine Bejahung dieses Regimes wog um so schwerer, als er sich dessen Unrechtscharakters sehr wohl bewusst war."
                            },
                            {
                                "example_id": "7e9d10e2-6ed2-4775-8a6a-7c30f20db85a",
                                "sense_id": "8a14d108-454c-31b6-8e29-7ef7a3e140d9",
                                "text": "„Bemerkenswert ist seine fröhliche Bejahung der Abschaffung des Erbadels.“"
                            },
                            {
                                "example_id": "f18488be-b5e8-49a0-81d8-e88a8d8bec06",
                                "sense_id": "8a14d108-454c-31b6-8e29-7ef7a3e140d9",
                                "text": "„Ihre Vorsicht verflüchtigte sich in seiner Bejahung, sie bemerkten – und suchten – seine Sympathie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
