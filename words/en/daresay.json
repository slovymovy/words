{
    "word_family": [
        "dare",
        "say"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f879fa8-1557-3263-a266-d9bee16de8e5",
                    "sense_definition": "to venture to say or assume that something is likely to be true; to presume or think something is probable",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>daresay</w> he's got other things to think of, so I will set all that right tomorrow.",
                            "target_lang_translations": {
                                "ru": "<w>Полагаю</w>, у него есть другие заботы, так что я улажу это завтра."
                            }
                        },
                        {
                            "text": "The weather is looking quite grey, so I <w>daresay</w> it will rain before we reach the house.",
                            "target_lang_translations": {
                                "ru": "Небо совсем серое, так что, <w>осмелюсь предположить</w>, до того как мы доберемся до дома, пойдет дождь."
                            }
                        }
                    ],
                    "synonyms": [
                        "presume",
                        "suppose",
                        "expect",
                        "assume"
                    ],
                    "common_phrases": [
                        "I daresay"
                    ],
                    "target_lang_definitions": {
                        "ru": "осмелиться предположить или допустить, что что-то, вероятно, является правдой; полагать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полагаю",
                                "target_lang_sense_clarification": "вводное слово для выражения вероятности"
                            },
                            {
                                "target_lang_word": "осмелюсь сказать",
                                "target_lang_sense_clarification": "вежливое или осторожное предположение"
                            },
                            {
                                "target_lang_word": "вполне вероятно",
                                "target_lang_sense_clarification": "указание на высокую степень вероятности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "161209c4-91ca-3828-92d8-be4f13a3c2db",
                    "sense_definition": "to state something boldly or to affirm a position with confidence",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>daresays</w> he has had several conversations with the owner and remains satisfied with the outcome.",
                            "target_lang_translations": {
                                "ru": "Он <w>смело утверждает</w>, что провел несколько бесед с владельцем и остается доволен результатом."
                            }
                        },
                        {
                            "text": "She <w>daresays</w> that the project will be a success despite the many challenges they faced.",
                            "target_lang_translations": {
                                "ru": "Она <w>утверждает</w>, что проект будет успешным, несмотря на многочисленные трудности, с которыми они столкнулись."
                            }
                        }
                    ],
                    "synonyms": [
                        "assert",
                        "affirm",
                        "maintain"
                    ],
                    "antonyms": [
                        "deny",
                        "retract"
                    ],
                    "target_lang_definitions": {
                        "ru": "смело заявлять или уверенно подтверждать свою позицию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смело утверждать",
                                "target_lang_sense_clarification": "уверенное заявление вопреки сомнениям"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "официальное или решительное утверждение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}