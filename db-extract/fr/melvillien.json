                "senses": [
                    {
                        "sense_id": "ba0e22e8-fea3-3ab8-b5ce-a873e2040692",
                        "entry_id": "71b6e060-154b-379a-bd5b-ec3d68392011",
                        "glosses": [
                            "Propre ou relatif à Jean-Pierre Melville et à ses films."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc62ca2-6ba2-4c04-94b7-8d5dc02345a4",
                                "sense_id": "ba0e22e8-fea3-3ab8-b5ce-a873e2040692",
                                "text": "Gian Maria Volonte, lui, incarne une autre figure melvillienne. Remake en couleurs d’un Ventura noir et blanc, Volonte veut en finir avec un cauchemar récurrent chez Melville : cavaler, à perdre haleine, pour échapper à l’enfermement."
                            },
                            {
                                "example_id": "2e692cca-19ff-4667-b0d1-a4d47880c00e",
                                "sense_id": "ba0e22e8-fea3-3ab8-b5ce-a873e2040692",
                                "text": "Le héros melvillien est un homme anachronique qui accomplit son destin dans un monde qu'il a déjà quitté de son vivant."
                            },
                            {
                                "example_id": "22e3bcd8-a3ba-4255-af1b-c0559d329f7c",
                                "sense_id": "ba0e22e8-fea3-3ab8-b5ce-a873e2040692",
                                "text": "Dilater, voilà la grande affaire du cinéma melvillien, à l'honneur tout le mois de novembre à la Cinémathèque française de Paris."
                            }
                        ]
                    }
