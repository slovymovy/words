                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"диссоциативное расстройство идентичности\" (раздвоение личности).",
                        "es": "Sigla en inglés de \"dissociative identity disorder\" (trastorno de identidad disociativo)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ДРИ",
                                "target_lang_sense_clarification": "аббревиатура"
