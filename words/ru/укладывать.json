                                "target_lang_sense_clarification": "one's hair"
                            },
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "hair in a hairstyle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb92f2c6-a930-341e-ad2a-cfdd4f2d9065",
                    "sense_definition": "помещать строительные материалы или предметы в определённом порядке, ровными слоями",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "laying_construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Строители быстро и качественно <w>укладывали</w> кирпич при возведении стены.",
                            "target_lang_translations": {
                                "en": "The builders were <w>laying</w> brick quickly and skillfully while constructing the wall."
                            }
                        },
                        {
                            "text": "Рабочие уже неделю <w>укладывают</w> асфальт на центральной улице города.",
                            "target_lang_translations": {
                                "en": "Workers have been <w>laying</w> asphalt on the city's main street for a week already."
                            }
                        }
                    ],
                    "synonyms": [
