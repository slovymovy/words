                        "entry_id": "dd5ecd4b-9b72-3ff1-8d92-17dd5ba899f9",
                        "glosses": [
                            "A person who lives in the slums of cities."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7104864c-0acf-41c9-a664-2438a4850c39",
                                "sense_id": "5d319276-efcd-3f9b-a5b3-6a3d87d2e8be",
                                "text": "Priya, 17, has chosen to be a slumdog, and her life reads like a film script."
                            },
                            {
                                "example_id": "c71cbbf4-048e-4418-aa0f-b569c5316aba",
                                "sense_id": "5d319276-efcd-3f9b-a5b3-6a3d87d2e8be",
                                "text": "\"I am poor, but don't call me slumdog,\" said Rekha Dhamji, 18."
                            },
                            {
                                "example_id": "34c908c0-b8e8-49d7-af76-d9fed702b9a6",
                                "sense_id": "5d319276-efcd-3f9b-a5b3-6a3d87d2e8be",
                                "text": "“India is not really about ‘Slumdog Millionaire.’ It’s about slumdogs versus millionaires, and that’s what you’re seeing in Delhi now.”"
                            },
                            {
                                "example_id": "5064b450-3ae4-43d0-b2af-bec584215506",
                                "sense_id": "5d319276-efcd-3f9b-a5b3-6a3d87d2e8be",
                                "text": "This trope appeals to audiences and award juries alike, while avoiding the obvious issue that there’s a lot of slumdogs who will never become millionaires."
                            }
                        ]
                    }
