                        "glosses": [
                            "lästige, unerwünschte, schädliche kleine Tiere, vor allem Insekten"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "d746fa76-c52c-4a3d-ae30-89dc03f4acad",
                                "sense_id": "e7b6db2c-26e6-306e-9f39-5f33f8060e22",
                                "text": "Im ganzen Haus wimmelte es vor Spinnen, Mücken und anderem Geziefer."
                            },
                            {
                                "example_id": "e66550de-c67e-4f45-bac0-c7ff511cd5e1",
                                "sense_id": "e7b6db2c-26e6-306e-9f39-5f33f8060e22",
                                "text": "„Aber das unter diesem Jagen und Schlagen immer nur ängstlicher werdende Geziefer schien sich zu verdoppeln und summte nur dichter und lauter als vorher um ihn herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
