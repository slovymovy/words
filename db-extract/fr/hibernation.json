        "fr-extract.jsonl": [
            {
                "entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                "word": "hibernation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8fc548cc-6fe1-4a1a-87b1-b0315410791c",
                        "entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "hibernations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df3c3198-0b9f-3ff1-9f8f-9f9848ddb8eb",
                        "entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                        "glosses": [
                            "Sommeil hivernal de certains animaux comme la marmotte et le hérisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2cf0feb-3676-4186-a237-5460cbf52c68",
                                "sense_id": "df3c3198-0b9f-3ff1-9f8f-9f9848ddb8eb",
                                "text": "Dès avant l’hibernation, les ovaires s’étaient considérablement accrus et remplissaient la cavité générale ; ils ont encore un peu grossi pendant l’hibernation aux dépens des réserves nutritives accumulées dans l’organisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "d22336c8-d070-32a4-9de2-7a71c4634954",
                        "entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                        "glosses": [
                            "Arrêt, volontaire ou non, d'activité pendant un certain laps de temps."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2521d709-3f36-4e76-954e-cffd4c9cefbe",
                                "sense_id": "d22336c8-d070-32a4-9de2-7a71c4634954",
                                "text": "Alors que les équipes de l'Agence spatiale européenne craignaient que Philae n'ait pas assez d'énergie pour établir avec la sonde Rosetta un dernier contact avant d'entrer en « hibernation », une liaison stable s'est établie entre 23 h 29 (heure de Paris) et 1 h 36 samedi matin."
                            }
                        ]
                    },
                    {
                        "sense_id": "28989238-f778-3ed7-8664-e9148c39db46",
                        "entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                        "glosses": [
                            "Temps de latence."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7f7e1bda-7021-4269-b72c-45984c988b1f",
                                "sense_id": "28989238-f778-3ed7-8664-e9148c39db46",
                                "text": "C'est ainsi que l'on retrouve des détails en apparence insignifiants qui étaient restés en hibernation dans la nuit des temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d44aa1c-aad5-367c-a043-9827702c95ba",
                        "entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                        "glosses": [
                            "État d’un ordinateur dans lequel il est à l’arrêt tout en gardant stocké l’état actif en mémoire non-volatile."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78a7a306-b488-41bf-b5f1-19644ab4b25e",
                        "source_entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
                        "source_sense_id": "df3c3198-0b9f-3ff1-9f8f-9f9848ddb8eb",
                        "source_sense_description": "Sommeil hivernal",
                        "target_lang_word": "Winterschlaf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winterschlaf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                        "entry_id": "6312a896-acec-38fa-b7ce-705b6b6979c8",
                                        "glosses": [
                                            "schlafähnlicher Zustand, in dem sich manche Säugetiere und vereinzelte Vogelarten während der kalten Jahreszeit befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b6b22b-2c23-41a2-98a7-d50f94feb2f7",
                                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                                "text": "„Für den Winterschlaf legen die Fledermäuse spezielle Fettvorräte an, deren alleiniger Zweck es ist, während des Aufwachens die notwendige Energie zu liefern, mit der wieder die normale Körpertemperatur erreicht werden kann.“"
                                            },
                                            {
                                                "example_id": "318917fe-5e81-40f5-8c89-290e1f1160a4",
                                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                                "text": "„Irgendwann in unserer oder zumindest in meiner zoologischen Vergangenheit muß der Winterschlaf ein wichtiger Faktor gewesen sein.“"
                                            },
                                            {
                                                "example_id": "af0996b1-9f46-4645-a702-728174d35638",
                                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                                "text": "Als ich ihn fragte, woher er so müde ist, meinte er: \"Auf den Winterschlaf folgt die Frühjahrsmüdigkeit gefolgt von der Sommerlethargie.\""
                                            },
                                            {
                                                "example_id": "540673d6-346a-49d5-a120-c05c833069e6",
                                                "sense_id": "edebfc5a-6dc2-3a64-965f-fb84a339ab6b",
                                                "text": "„Rosa knirschte mit den Zähnen, schlug sich selbst an die Brust und dann ins Gesicht, als stünde sie im Kampf mit einem inneren Wesen, das gerade wutentbrannt aus seinem Winterschlaf erwachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bea5d4bd-1561-43c6-90e9-29c1392c8994",
                        "source_entry_id": "af76686e-06b6-38ea-9329-1396bc4f85e0",
