                ],
                "senses": [
                    {
                        "sense_id": "4d9d30e2-0f91-3ef5-a3fd-3a638060ca36",
                        "entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "glosses": [
                            "To eject or throw (someone or something) from or through a window."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ef0eb0f8-d00c-43a5-a143-706b8b668874",
                                "sense_id": "4d9d30e2-0f91-3ef5-a3fd-3a638060ca36",
                                "text": "I defenestrated a clock to see if time flies!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2d42b30-1cf9-39a6-8753-374f25eced7d",
                        "entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "glosses": [
                            "To throw out; to remove or dismiss (someone) from a position of power or authority."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f15aa70-c549-4f9b-9761-528fffa888f0",
                                "sense_id": "e2d42b30-1cf9-39a6-8753-374f25eced7d",
                                "text": "The cultural historians of science 'feel the need to defenestrate science, or at least take it off its pedestal' (Pumfrey. Rossi & Slawinski 1991. p. 3)."
                            },
                            {
                                "example_id": "216449d4-93b8-4f61-8f52-8c5b1a4dcbc2",
                                "sense_id": "e2d42b30-1cf9-39a6-8753-374f25eced7d",
                                "text": "Ever since he helped to defenestrate Richard Nixon in 1974, Mr Woodward has been a sort of super-reporter ..."
                            },
                            {
                                "example_id": "697313b2-bd19-4c7b-b27b-d3ff8e2f53f5",
                                "sense_id": "e2d42b30-1cf9-39a6-8753-374f25eced7d",
                                "text": "According to the guidebooks, they do it so strenuously that women would very much like to defenestrate the custom."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f73cf3b-9d14-33b1-914b-fe2be897b53e",
                        "entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "glosses": [
                            "To remove a Windows operating system from (a computer)."
                        ],
                        "tags": [
                            "humorous",
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "175ec596-c200-4b3f-8263-416597a22231",
                                "sense_id": "9f73cf3b-9d14-33b1-914b-fe2be897b53e",
                                "text": "This posting was written on a Windows 95 PC,\nDefenestrate it immediately. Install Linux. :-)"
                            },
                            {
                                "example_id": "ce45907d-f5ea-4393-91dc-6ce23806288d",
                                "sense_id": "9f73cf3b-9d14-33b1-914b-fe2be897b53e",
                                "text": "◦ Enable one-click uninstalls of unwanted OS and application features with a Defenestrate icon."
                            },
                            {
                                "example_id": "7cced0cd-abcb-4bde-a364-6ec0343ac23d",
                                "sense_id": "9f73cf3b-9d14-33b1-914b-fe2be897b53e",
                                "text": "2007 May 16, Richard Stallman, speech, Free Software and Beyond: Human Rights in the Use of Software and Other Published Works,\nNow of course people who want freedom shouldn't use Windows at all, you've got to defenestrate your computer, which means either you throw Windows out of the computer, or you throw the computer out the window."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "987b4e5c-e170-4eb9-9142-44b98c3cb506",
                        "source_entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "source_sense_description": "eject from a window",
                        "target_lang_word": "defenestreren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
