                ],
                "senses": [
                    {
                        "sense_id": "bdac2e54-b81f-354f-b83b-ed5a14222e25",
                        "entry_id": "b2da6398-4597-3ee0-a145-c60e2dfebd64",
                        "glosses": [
                            "Celui qui faisait partie de la Ligue, du temps de Henri III et de Henri IV."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1019cd05-5547-4f61-adb4-6bcaad481dbf",
                                "sense_id": "bdac2e54-b81f-354f-b83b-ed5a14222e25",
                                "text": "Tantôt un protestant y a signé sa foi, tantôt un ligueur y a maudit Henri IV."
                            },
                            {
                                "example_id": "559cd207-4a4b-425c-8d3c-b49a7f41913d",
                                "sense_id": "bdac2e54-b81f-354f-b83b-ed5a14222e25",
                                "text": "Les combats entre les armées de Henri IV ([…]) et les Ligueurs durèrent plusieurs années. Dans la région, des combats eurent lieu à Mondrepuis et à Gomont en mai 1590 où les Ligueurs sont battus. En octobre de la même année, les Ligueurs s'emparent de Vic-sur-Aisne."
                            }
                        ]
                    },
                    {
                        "sense_id": "d56b17f6-03ce-3abc-9332-55e906d4442d",
                        "entry_id": "b2da6398-4597-3ee0-a145-c60e2dfebd64",
                        "glosses": [
                            "Ceux qui font partie d’une ligue politique, plutôt conservatrice, voire réactionnaire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "88d67c1f-6989-4ee7-b1ab-70c28dab8d18",
                                "sense_id": "d56b17f6-03ce-3abc-9332-55e906d4442d",
                                "text": "… je m’étonnais que Montaigne écrivît si gaillardement dans un château dont il ne pouvait faire le tour sans courir le risque d’être enlevé par des bandes de ligueurs ou de protestants."
                            }
                        ]
                    }
                ],
