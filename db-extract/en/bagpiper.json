                        "target_lang_word": "волы́нщица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "волы́нщица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a8298b76-6922-3225-b0b9-34bbfceb594e",
                                        "entry_id": "0efb3251-94d4-3aec-8a1e-13a8dc9de2bd",
                                        "glosses": [
                                            "женск. к волынщик (музыкант)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b79d60-f7e6-4668-8a52-0d83714276d4",
                                                "sense_id": "a8298b76-6922-3225-b0b9-34bbfceb594e",
                                                "text": "Волынщица, старательно раздувая щёки, наполняла воздухом мех."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e52f6d-b803-3022-946f-4d067678c725",
                                        "entry_id": "0efb3251-94d4-3aec-8a1e-13a8dc9de2bd",
                                        "glosses": [
                                            "разг. женск. к волынщик (тот, кто волынит)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc37874-bc5d-415e-9fed-55b524dac66b",
                                                "sense_id": "e6e52f6d-b803-3022-946f-4d067678c725",
                                                "text": "Катрин, менеджер небольшой типографии, — типичная волынщица. Объём возложенных на неё обязанностей представляется Катрин невыполнимым, что и заставляет её постоянно откладывать дела «на потом»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
