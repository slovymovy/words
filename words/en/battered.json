{
    "word_family": [
        "batter",
        "battering",
        "batterer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08484a25-d1f5-36e6-9505-f269728a63c0",
                    "sense_definition": "Damaged, worn out, or in rough condition through hard use or weathering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damaged_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carried his books in a <w>battered</w> leather briefcase that had belonged to his grandfather.",
                            "target_lang_translations": {
                                "ru": "Он носил свои книги в <w>потрёпанном</w> кожаном портфеле, который принадлежал его дедушке.",
                                "cs": "Své knihy nosil v <w>opotřebovaném</w> koženém kufříku, který patřil jeho dědečkovi."
                            }
                        },
                        {
                            "text": "After years of traveling, her <w>battered</w> suitcase was covered in colorful stickers from different countries.",
                            "target_lang_translations": {
                                "ru": "После многих лет путешествий её <w>побитый</w> чемодан был покрыт разноцветными наклейками из разных стран.",
                                "cs": "Po letech cestování byl její <w>otlučený</w> kufr pokrytý barevnými nálepkami z různých zemí."
                            }
                        }
                    ],
                    "synonyms": [
                        "worn-out",
                        "shabby",
                        "weathered",
                        "beaten-up"
                    ],
                    "antonyms": [
                        "pristine",
                        "brand-new"
                    ],
                    "common_phrases": [
                        "battered old suitcase",
                        "battered cardboard box"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поврежденный, изношенный или находящийся в плохом состоянии из-за активного использования или погодных условий.",
                        "cs": "Poškozený, opotřebovaný nebo ve špatném stavu v důsledku intenzivního používání nebo vlivu počasí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрёпанный",
                                "target_lang_sense_clarification": "о вещах, книгах, одежде"
                            },
                            {
                                "target_lang_word": "побитый",
                                "target_lang_sense_clarification": "о вещах, имеющих вмятины или повреждения"
                            },
                            {
                                "target_lang_word": "помятый",
                                "target_lang_sense_clarification": "о вещах, потерявших форму"
                            },
                            {
                                "target_lang_word": "видавший виды",
                                "target_lang_sense_clarification": "разговорное о старых, изношенных вещах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "opotřebovaný",
                                "target_lang_sense_clarification": "o věcech, které jsou dlouho používané"
                            },
                            {
                                "target_lang_word": "otlučený",
                                "target_lang_sense_clarification": "o věcech s viditelnými známkami poškození"
                            },
                            {
                                "target_lang_word": "omšelý",
                                "target_lang_sense_clarification": "o starých, ošoupaných věcech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c80bab3-d513-37b5-a97c-cb79993219a0",
                    "sense_definition": "Coated in a liquid mixture of flour, egg, and milk before being fried.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant is famous for serving crispy <w>battered</w> fish with a side of thick-cut chips.",
                            "target_lang_translations": {
                                "ru": "Ресторан знаменит тем, что там подают хрустящую рыбу <w>в кляре</w> с гарниром из толсто нарезанного картофеля фри.",
                                "cs": "Restaurace je proslulá podáváním křupavé ryby <w>v těstíčku</w> s přílohou ze silných hranolků."
                            }
                        },
                        {
                            "text": "I prefer <w>battered</w> onion rings over breaded ones because they are much lighter.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю луковые кольца <w>в кляре</w> панированным, потому что они гораздо легче.",
                                "cs": "Dávám přednost cibulovým kroužkům <w>v těstíčku</w> před těmi v trojobalu, protože jsou mnohem lehčí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "battered fish",
                        "deep-fried and battered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый жидким тестом (кляром) из муки, яиц и молока перед обжариванием.",
                        "cs": "Obalený v tekutém těstíčku z mouky, vajec a mléka před smažením."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в кляре",
                                "target_lang_sense_clarification": "о кулинарных блюдах"
                            },
                            {
                                "target_lang_word": "обваленный в жидком тесте",
                                "target_lang_sense_clarification": "о способе приготовления"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "v těstíčku",
                                "target_lang_sense_clarification": "o způsobu přípravy jídla"
                            },
                            {
                                "target_lang_word": "v trojobalu",
                                "target_lang_sense_clarification": "častější český ekvivalent pro smažené pokrmy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b552eec4-1b03-36db-826a-0258094312ca",
                    "sense_definition": "Having suffered repeated physical blows or abuse.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "damaged_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity provides a safe shelter for <w>battered</w> women and their children.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация предоставляет безопасный приют для женщин, <w>подвергающихся домашнему насилию</w>, и их детей.",
                                "cs": "Charita poskytuje bezpečné útočiště pro <w>zbité</w> ženy a jejich děti."
                            }
                        },
                        {
                            "text": "The boxer had a <w>battered</w> face after twelve rounds of intense fighting.",
                            "target_lang_translations": {
                                "ru": "У боксера было <w>избитое</w> лицо после двенадцати раундов напряженного боя.",
                                "cs": "Boxer měl po dvanácti kolech intenzivního boje <w>zbitý</w> obličej."
                            }
                        }
                    ],
                    "synonyms": [
                        "beaten",
                        "bruised"
                    ],
                    "common_phrases": [
                        "battered wife",
                        "battered child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергшийся многократным физическим ударам или домашнему насилию.",
                        "cs": "Osoba, která utrpěla opakované fyzické údery nebo domácí násilí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвергающийся насилию",
                                "target_lang_sense_clarification": "о жертвах домашнего насилия"
                            },
                            {
                                "target_lang_word": "избитый",
                                "target_lang_sense_clarification": "о человеке или лице после побоев"
                            },
                            {
                                "target_lang_word": "побитый",
                                "target_lang_sense_clarification": "о человеке, получившем удары"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zbitý",
                                "target_lang_sense_clarification": "o člověku, který utrpěl fyzické násilí"
                            },
                            {
                                "target_lang_word": "oběť násilí",
                                "target_lang_sense_clarification": "o osobě trpící domácím násilím"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82dac2a9-ab0f-30d9-82af-38a0cd14e67f",
                    "sense_definition": "Extremely drunk or under the influence of drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went to the pub after work and got completely <w>battered</w>.",
                            "target_lang_translations": {
                                "ru": "После работы они пошли в паб и напились <w>в стельку</w>.",
                                "cs": "Po práci šli do hospody a opili se <w>namol</w>."
                            }
                        },
                        {
                            "text": "He could barely stand up because he was so <w>battered</w> from the party.",
                            "target_lang_translations": {
                                "ru": "Он едва мог стоять на ногах, потому что был <w>никаким</w> после вечеринки.",
                                "cs": "Sotva mohl stát na nohou, protože byl po večírku úplně <w>na šrot</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wasted",
                        "hammered",
                        "plastered",
                        "drunk"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "get completely battered"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Mainly British and Australian slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно пьяный или находящийся под сильным воздействием наркотиков.",
                        "cs": "Extrémně opilý nebo pod silným vlivem drog."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный в стельку",
                                "target_lang_sense_clarification": "разговорное, очень пьяный"
                            },
                            {
                                "target_lang_word": "упившийся",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "никакой",
                                "target_lang_sense_clarification": "разговорное, о сильном опьянении"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "namol",
