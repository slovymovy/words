                                    {
                                        "sense_id": "760116b0-0cc5-3c10-96cd-391006d63ef4",
                                        "entry_id": "5ca65a23-23c0-3c65-9c8b-94d69b041e6b",
                                        "glosses": [
                                            "Organisme affecté, à la suite d’une manipulation effectuée par l’homme, d’un ou plusieurs gènes qu’il ne possède pas naturellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660f0252-f115-45f6-897b-cc6d53b4eb93",
                                                "sense_id": "760116b0-0cc5-3c10-96cd-391006d63ef4",
                                                "text": "— Après le feu vert argentin au premier blé OGM jamais conçu, les semenciers européens aimeraient utiliser des outils de sélection génétique plus rapides. Et ce, pour adapter les plantes au changement climatique et à la sécheresse."
                                            },
                                            {
                                                "example_id": "4629c392-7804-4c98-93bb-45861d8b4a74",
                                                "sense_id": "760116b0-0cc5-3c10-96cd-391006d63ef4",
                                                "text": "Les OGM s’affranchissent des frontières entre genres et espèces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
