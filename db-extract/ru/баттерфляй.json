                "senses": [
                    {
                        "sense_id": "0052fb90-0209-3ac8-ada3-4c6ec6c70a44",
                        "entry_id": "a01a9ec1-800b-3b22-ba0f-2a32bfed0f52",
                        "glosses": [
                            "спорт. стиль плавания с одновременным выносом обеих рук над водой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e145f8ea-6ec4-4699-ab73-c446396449c9",
                                "sense_id": "0052fb90-0209-3ac8-ada3-4c6ec6c70a44",
                                "text": "Лишь на одной дистанции ― 100 м баттерфляем ― Майкл опередил соперника всего на одну сотую секунды."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abae833e-689f-49c6-ac5b-c6a156cc8d75",
                        "source_entry_id": "a01a9ec1-800b-3b22-ba0f-2a32bfed0f52",
                        "source_sense_id": "0052fb90-0209-3ac8-ada3-4c6ec6c70a44",
                        "target_lang_word": "butterfly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butterfly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8762fd1-ada2-359e-98e8-23e284b8fb40",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A flying insect of the order Lepidoptera, distinguished from moths by their diurnal activity and generally brighter colouring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e2ea787-11d4-43ab-8bd1-a28f7a876934",
                                                "sense_id": "f8762fd1-ada2-359e-98e8-23e284b8fb40",
                                                "text": "It is true. I am like a butterfly, and I shall only live a little while."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f01f41c-16aa-3e62-b88c-dae83145c22d",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A use of surgical tape, cut into thin strips and placed across an open wound to hold it closed."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f95f4b38-186e-4405-840b-31070f430f72",
                                                "sense_id": "2f01f41c-16aa-3e62-b88c-dae83145c22d",
                                                "text": "butterfly tape; butterfly bandage; butterfly strips"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "770aaadd-4bbc-36d9-b280-48a976cc78e7",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "The butterfly stroke."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56316d3d-3d8e-3e0f-9fb3-22130b73e7f4",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "Any of several plane curves that look like a butterfly; see Butterfly curve (transcendental) and Butterfly curve (algebraic)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "007c3183-2f82-3eed-a280-18a1756005d5",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "Ellipsis of butterflies in one’s stomach (“A sensation of excited anxiety felt in the stomach”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c4fb02-d35c-4753-85be-86280e7936e1",
                                                "sense_id": "007c3183-2f82-3eed-a280-18a1756005d5",
                                                "text": "I get terrible butterflies before an exam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f9148d-c8d8-3d6d-8c0e-121bdda78d81",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "Someone seen as being unserious and (originally) dressed gaudily; someone flighty and unreliable."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464aca3f-9804-4d16-b175-72fd901c5997",
                                                "sense_id": "e7f9148d-c8d8-3d6d-8c0e-121bdda78d81",
                                                "text": "He was affable; therefore he was frivolous. The women liked him; therefore he was a butterfly."
                                            },
                                            {
                                                "example_id": "0b911c83-2c15-4f62-85fd-9a79c9ee9d4c",
                                                "sense_id": "e7f9148d-c8d8-3d6d-8c0e-121bdda78d81",
                                                "text": "The day came indeed when her breathless auditors learnt from her in bewilderment that what ailed him was that he was, alas, simply not serious. Maisie wept on Mrs. Wix's bosom after hearing that Sir Claude was a butterfly[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18607a53-b87d-3006-86d8-918fff39343e",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A combination of four options of the same type at three strike prices giving limited profit and limited risk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89741058-3b3e-3ec1-87e9-d30366b3c2b8",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A random change in an aspect of the timeline seemingly unrelated to the primary point of divergence, resulting from the butterfly effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d64f470-6d3c-4ff2-83c0-7d4b866232bb",
                                                "sense_id": "89741058-3b3e-3ec1-87e9-d30366b3c2b8",
                                                "text": "One potential butterfly could be JFK having another son the year after the POD instead of a daughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fbb4af7-a58c-3fa0-939b-dd7bf791e664",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A type of stretch in which one sits on the ground with the legs folded into a shape like that of a butterfly's wings, slightly rocking them up and down, resembling the wings fluttering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1fa3573-6e32-384d-b609-27705787b816",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A person who changes partners frequently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c47a22-deea-4ae7-948f-78a1c0205342",
                                                "sense_id": "c1fa3573-6e32-384d-b609-27705787b816",
                                                "text": "What does it mean to be a butterfly in Pattaya? It means, just like a butterfly briefly visits many flowers, you will briefly visit many different girls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f6cf048-de24-3a17-9373-1f3d90cbbb50",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "A safety link or detaching hook above the cage attached to the winding rope to prevent the cage from being overwound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56aa3f7c-f1ae-35e6-8574-af61767b29e0",
                                        "entry_id": "8e06adcc-b8f3-3435-9c2e-5502f0c1bc93",
                                        "glosses": [
                                            "party switcher; turncoat."
                                        ],
                                        "tags": [
                                            "Philippine",
                                            "Philippines",
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "butterfly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98ec9ef6-9926-3982-9aa2-af489f0adf52",
                                        "entry_id": "b570896c-f3ba-3af8-83ac-885caaa5315d",
                                        "glosses": [
                                            "To cut (food) almost entirely in half and spread the halves apart, in a shape suggesting the wings of a butterfly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfea8692-5d1e-4d1a-a423-4a48887d62fb",
                                                "sense_id": "98ec9ef6-9926-3982-9aa2-af489f0adf52",
                                                "text": "butterflied shrimp"
                                            },
                                            {
                                                "example_id": "53759b21-2c6f-4bb9-a5c7-3f10ca9f9222",
                                                "sense_id": "98ec9ef6-9926-3982-9aa2-af489f0adf52",
                                                "text": "Butterfly the chicken before you grill it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f9c091-a16f-3f56-9db4-86ad177621a2",
                                        "entry_id": "b570896c-f3ba-3af8-83ac-885caaa5315d",
                                        "glosses": [
                                            "To cut strips of surgical tape or plasters into thin strips, and place across (a gaping wound) to close it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "343fcca0-f7d8-428a-b47d-8654aaac733e",
                                                "sense_id": "c5f9c091-a16f-3f56-9db4-86ad177621a2",
                                                "text": "After everyone had obeyed his commands, the lieutenant motioned for two medics that now appeared to enter the room and attend to Dr. Carter. They bandaged him up, butterflying some of the deeper gashes and gave him a couple of shots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45805dc6-2792-3fb7-81a3-fa322d0209b7",
                                        "entry_id": "b570896c-f3ba-3af8-83ac-885caaa5315d",
                                        "glosses": [
                                            "To cause events after the point of divergence to not happen as they did in real history, and people conceived after the point of divergence to not exist in recognizable form, due to the random variations introduced by the butterfly effect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a69fd82-8d96-458b-807a-0cea11bdb617",
                                                "sense_id": "45805dc6-2792-3fb7-81a3-fa322d0209b7",
                                                "text": "Pearl Harbor not happening would've butterflied Taylor Swift."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
