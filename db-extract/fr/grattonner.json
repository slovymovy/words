                        "glosses": [
                            "Escalader en utilisant les aspérités de la roche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c204716-aad5-4c33-a9b6-bda8b51dfe08",
                                "sense_id": "7eaa893f-6858-3a5f-a4bb-71ccf0a14ccb",
                                "text": "Sa forme excentrée sur le pouce en fait un chausson parfait pour grattonner."
                            },
                            {
                                "example_id": "f1d8e0df-eed5-4b00-9d83-82205963fca4",
                                "sense_id": "7eaa893f-6858-3a5f-a4bb-71ccf0a14ccb",
                                "text": "Le bouquetin est meilleur grimpeur, son sabot rigide lui permet de grattonner sur les dalles."
                            },
                            {
                                "example_id": "1bae832f-1e9e-4524-a1a4-0784b3ae6ddc",
                                "sense_id": "7eaa893f-6858-3a5f-a4bb-71ccf0a14ccb",
                                "text": "Sensation et précision, avec une gomme exceptionnelle, ils garantissent une bonne tenue sur les petites prises à grattonner et une bonne adhérence."
                            }
                        ]
