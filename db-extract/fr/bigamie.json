                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ccdb816-7d9b-4279-841f-d1d069c559ca",
                        "source_entry_id": "d21aba8e-53ef-31bd-ad42-d25b03449eac",
                        "target_lang_word": "двоежёнство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "двоежёнство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1dfb4bb7-ca5b-3559-bd83-f204e96615ac",
                                        "entry_id": "c2668292-af6a-3d10-8230-ec9dfb64e663",
                                        "glosses": [
                                            "состояние в браке одновременно с двумя женщинами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5c7684-cbcd-4fe7-bb3c-cb0d3cd59e1a",
                                                "sense_id": "1dfb4bb7-ca5b-3559-bd83-f204e96615ac",
                                                "text": "Я почувствовал ужасный соблазн на новое преступление, то есть совершить двоежёнство (потому что я уже женат)."
                                            },
                                            {
                                                "example_id": "49f3bf8f-dbff-4d1b-aacf-e9f49039410c",
                                                "sense_id": "1dfb4bb7-ca5b-3559-bd83-f204e96615ac",
                                                "text": "Затем подали шампанского и условились, что мы с Глумовым будем участвовать в двоежёнстве в качестве шаферов, а Очищенный в качестве посажёного отца."
                                            },
                                            {
                                                "example_id": "b1f2045d-05d2-44df-9791-232d17c291a5",
                                                "sense_id": "1dfb4bb7-ca5b-3559-bd83-f204e96615ac",
                                                "text": "Говорят, что ответа на запрос в Россию по поводу возможного двоежёнства (двоемужия) надо ждать месяц-полтора."
                                            }
                                        ]
                                    }
