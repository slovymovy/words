                                "target_senses": [
                                    {
                                        "sense_id": "6461bc77-72f9-3d1a-8e1a-6bbc2ef2fe9a",
                                        "entry_id": "789a305f-5cf9-3e26-abbe-83a540dce2b1",
                                        "glosses": [
                                            "Of or pertaining to the Baltic region or the Baltic Sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17da0a99-0744-4872-bec1-c695c6f103e7",
                                                "sense_id": "6461bc77-72f9-3d1a-8e1a-6bbc2ef2fe9a",
                                                "text": "The Teutonic Knights were newly established in the Baltic region, where they owed their first possessions to Mazovian policy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22e07d58-d24b-3357-8fed-9f0e88d4e333",
                                        "entry_id": "789a305f-5cf9-3e26-abbe-83a540dce2b1",
                                        "glosses": [
                                            "Of or pertaining to any of the Baltic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb9717a-ff6f-4112-bc05-a89495b40205",
                                                "sense_id": "22e07d58-d24b-3357-8fed-9f0e88d4e333",
                                                "text": "The Baltic division of the group embraces the Lithuanian and Lettic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b44d51d8-6c3d-367c-a3ac-7468b1a6abae",
                                        "entry_id": "789a305f-5cf9-3e26-abbe-83a540dce2b1",
                                        "glosses": [
                                            "Of or pertaining to the Balts (the Baltic peoples)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ddf4568-1594-30de-886b-9e6cc259c704",
                                        "entry_id": "789a305f-5cf9-3e26-abbe-83a540dce2b1",
                                        "glosses": [
                                            "Extremely cold."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edaf00d3-cb68-4dc4-aa26-86bf62ae7a9f",
                                                "sense_id": "7ddf4568-1594-30de-886b-9e6cc259c704",
                                                "text": "It's twenty-three degrees outside, freezing is thirty two and with the wind chill factor it's Baltic out there."
                                            },
                                            {
                                                "example_id": "306cdc85-91ac-4c23-b901-d71c15f4cc68",
                                                "sense_id": "7ddf4568-1594-30de-886b-9e6cc259c704",
                                                "text": "Apart from anything else, it's absolutely Baltic outside. In the past 24 hours, a freeze has abruptly descended on the whole of Europe, and here in the northwest corner of France, the cold claws of the Atlantic are particularly sharp."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Baltic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2e5fbe-246a-33ac-9309-4487196927ff",
                                        "entry_id": "f5b61c2e-5cd8-34e3-b60b-c367ef719c15",
                                        "glosses": [
                                            "The Baltic Sea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9e8e4b5-e36d-3bed-be02-fc1db4f391d2",
                                        "entry_id": "f5b61c2e-5cd8-34e3-b60b-c367ef719c15",
                                        "glosses": [
                                            "A geographic region of Northern Europe, surrounding the Baltic Sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a00aac7f-e9e5-4033-97ad-6add2bc77a0b",
                                                "sense_id": "b9e8e4b5-e36d-3bed-be02-fc1db4f391d2",
                                                "text": "Well, you see, I was temporarily in command of the cruiser coming down the Baltic, and passing an island rock a few miles away, I thought it would be a good opportunity to test a new gun that had been put aboard when we left England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6a1270d-6df3-3d2e-8d31-c9742eba97ca",
                                        "entry_id": "f5b61c2e-5cd8-34e3-b60b-c367ef719c15",
                                        "glosses": [
                                            "A geographic region of Northern Europe, consisting of the three countries to the east of the Baltic Sea, i.e. Latvia, Lithuanian and Estonia; in full, the Baltics or the Baltic states."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0bc86f-e491-40ac-b196-cab1d74a3121",
                                                "sense_id": "e6a1270d-6df3-3d2e-8d31-c9742eba97ca",
                                                "text": "It appears from the evidence, that the corn from the Baltic is often very heavily taxed, and that this tax is generally raised in proportion to our necessities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51d6dffd-e994-35dd-9533-d6d807060f95",
                                        "entry_id": "f5b61c2e-5cd8-34e3-b60b-c367ef719c15",
