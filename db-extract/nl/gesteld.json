                        "examples": [
                            {
                                "example_id": "d5bd4025-db91-41d9-b79d-9607abf8e3a5",
                                "sense_id": "97ad0c90-2202-3084-9c82-7362ab29fef4",
                                "text": "Een eerste kind, zo citeert hij bijvoorbeeld uit een studie die begin twintigste eeuw werd uitgevoerd, is 'als regel ernstiger, serieuzer en gevoeliger', 'gewetensvol' en 'braaf' en - dit is mijn favoriet - 'erg gesteld op boeken'."
                            }
                        ]
