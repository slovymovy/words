        "fr-extract.jsonl": [
            {
                "entry_id": "2a6ba38a-590b-3399-8b49-bb44c063f8bd",
                "word": "asservissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ec3761d-2eb4-4c1c-b6ef-595ae22269c2",
                        "entry_id": "2a6ba38a-590b-3399-8b49-bb44c063f8bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "asservissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c183f280-85f6-3bf8-b9e9-cf0c30ceaf48",
                        "entry_id": "2a6ba38a-590b-3399-8b49-bb44c063f8bd",
                        "glosses": [
                            "Action d’asservir ou état de ce qui est asservi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae450e6-a028-470c-ae8a-f4eb54159137",
                                "sense_id": "c183f280-85f6-3bf8-b9e9-cf0c30ceaf48",
                                "text": "[…] la Société secrète du Lotus Bleu pousse à la suppression de la natte, emblème de l’asservissement des Chinois aux Tartares Mandchous."
                            },
                            {
                                "example_id": "f927df98-1d4a-41aa-a9cd-36cfe451a0a0",
                                "sense_id": "c183f280-85f6-3bf8-b9e9-cf0c30ceaf48",
                                "text": "Cependant, malgré l'attitude nouvelle pour eux de ce docteur, les indigènes ne s'ouvrirent pas, n'allèrent pas au-devant de lui. Des siècles de méfiance et d'asservissement étaient entre eux."
                            },
                            {
                                "example_id": "32e07822-c923-4f7f-9efc-7dc67fcd14ce",
                                "sense_id": "c183f280-85f6-3bf8-b9e9-cf0c30ceaf48",
                                "text": "Le traitement qu'elle a subi aux mains de l'accusé n'est rien de moins que de l'asservissement, puisqu'il l'utilisait comme une marionnette, poursuit le magistrat. [Sarah] a été abusée de façon répétée pendant trois ans et elle est maintenant orpheline."
                            }
                        ]
                    },
                    {
                        "sense_id": "8397e595-99d7-3007-b94a-ea84787d47c4",
                        "entry_id": "2a6ba38a-590b-3399-8b49-bb44c063f8bd",
                        "glosses": [
                            "Régulation ; contrôle."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba56ca64-6986-4b36-bbdb-0ec9dff2890f",
                        "source_entry_id": "2a6ba38a-590b-3399-8b49-bb44c063f8bd",
                        "target_lang_word": "enslavement",
