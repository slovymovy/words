                    "sense_id": "4958169a-b647-3a69-8318-3ff3093da2ef",
                    "sense_definition": "Qui est dur, strict ou contraignant, en parlant d'une règle, d'une mesure ou d'un cadre imposé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "severite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'établissement a mis en place une discipline particulièrement <w>rigoureuse</w> pour garantir le calme.",
                            "target_lang_translations": {
                                "en": "The school has introduced a particularly <w>strict</w> discipline to ensure calm.",
                                "ru": "В учебном заведении ввели особенно <w>строгую</w> дисциплину, чтобы обеспечить тишину.",
                                "de": "Die Schule hat eine besonders <w>strenge</w> Disziplin eingeführt, um für Ruhe zu sorgen.",
                                "es": "El centro ha implantado una disciplina especialmente <w>estricta</w> para garantizar la tranquilidad.",
                                "zh": "学校实行了特别<w>严格</w>的纪律，以保证校园安静。"
                            }
