                        "sense_id": "ad64fed4-f953-3ce7-bfe8-3643b923d382",
                        "entry_id": "dae33974-07bb-39a2-b15c-a018faa15916",
                        "glosses": [
                            "Dach mit grünen Rasenziegeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2d21c2-ee46-4894-821e-1186d4785d20",
                                "sense_id": "ad64fed4-f953-3ce7-bfe8-3643b923d382",
                                "text": "„Ein Bauernhof mit Torfdach ist nicht so, wie er in einer hellen Sommernacht im Juli von fern aussieht; nichts hat weniger mit einem Bauernhof zu tun.“"
                            },
                            {
                                "example_id": "d34e2e5d-3a06-4f13-9228-8447f9c57a0b",
                                "sense_id": "ad64fed4-f953-3ce7-bfe8-3643b923d382",
                                "text": "„Im Birkenwald steht Hütte an Hütte; rot angestrichen, mit grünem Torfdach, vorn Fahnenftangen; sie sind von Stadtleuten gebaut, die sich hier im Sommer aufhalten und die Gebirgsluft genießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
