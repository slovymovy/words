                },
                {
                    "sense_id": "a888c2d6-382b-3c1c-bc68-63491063951f",
                    "sense_definition": "Gottesdienstliche Zusammenkunft von Gläubigen; der Gottesdienst selbst.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Veranstaltung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am Sonntagmorgen beginnt die <w>Kirche</w> pünktlich um zehn Uhr."
                        },
                        {
                            "text": "Nach der <w>Kirche</w> trafen sich die Nachbarn auf dem Marktplatz für ein Gespräch."
