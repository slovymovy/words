                ],
                "senses": [
                    {
                        "sense_id": "b6068e25-5770-3499-aafa-864c55f25f28",
                        "entry_id": "e1515406-406a-3e74-b5fd-9d17315b9554",
                        "glosses": [
                            "Ensemble instrumental indonésien de type traditionnel composé principalement de percussions en bronze posées sur des caisses de résonance en bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e02e74-f9b2-4233-96af-a7a5563a2882",
                                "sense_id": "b6068e25-5770-3499-aafa-864c55f25f28",
                                "text": "On connaît bien les kratons de Solo et celui de Djogjakarta. Le gamelan y accompagne le plus souvent les danseurs qui représentent des épisodes de la version javanaise du Ramayana indien."
                            }
                        ]
                    },
                    {
                        "sense_id": "82084274-7f54-3cbd-9560-b5dde764f0b9",
                        "entry_id": "e1515406-406a-3e74-b5fd-9d17315b9554",
                        "glosses": [
                            "Sorte de grand xylophone en bambou qui produit une gamme limitée de sons peu subtils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7773492-45c1-4bcf-adeb-c4d913dd1ad5",
                                "sense_id": "82084274-7f54-3cbd-9560-b5dde764f0b9",
                                "text": "Le rythme s’accéléra progressivement, et le son abrutissant des gamelans s’amplifia, prenant possession de mon cerveau et hantant mon âme qui n’était déjà plus tout à fait mienne."
                            },
                            {
                                "example_id": "74778ec2-bb38-4238-a60c-8d63b0e02bab",
                                "sense_id": "82084274-7f54-3cbd-9560-b5dde764f0b9",
                                "text": "Le duo de gabber gamelan a fait appel aux talents de Kathleen Malay, du groupe indus Ora Iso, pour réaliser leur nouvelle vidéo."
                            }
                        ]
                    }
                ],
