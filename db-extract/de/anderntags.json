                                "example_id": "611f08f0-9ce6-49ae-b308-da15bbc43abd",
                                "sense_id": "e8d383c1-769b-3489-a9ee-be9a515820ea",
                                "text": "Die Veranstaltung wurde unterbrochen und anderntags fortgeführt."
                            },
                            {
                                "example_id": "ea6f1ac4-a1a5-44ae-a304-48873322b3a0",
                                "sense_id": "e8d383c1-769b-3489-a9ee-be9a515820ea",
                                "text": "„Anderntags fing mich Katja in der Mensa ab.“"
                            },
                            {
                                "example_id": "1fb0f717-28f0-48b1-b9a2-3b42497afba9",
                                "sense_id": "e8d383c1-769b-3489-a9ee-be9a515820ea",
                                "text": "„Anderntags ging ich zum Monte Cavallo und geradewegs in das Gemach, in dem sich der Papst aufhielt, sobald man mir gesagt hatte, ich könne hineingehen, er sei allein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
