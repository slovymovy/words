                    {
                        "sense_id": "a0541905-fa9b-3240-a767-5c5fb9f8b649",
                        "entry_id": "2a6c7f6a-a476-3372-83bb-feb03f07245c",
                        "glosses": [
                            "keramiek van gresklei gebakken op een temperatuur van meer dan 1200 graden Celsius"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0015c956-41f6-4d90-a7b3-5508a063d926",
                                "sense_id": "a0541905-fa9b-3240-a767-5c5fb9f8b649",
                                "text": "- Hij kan vermoedelijk genieten van het poëtische Japanse steengoed van kunsthandel Aalderink, van het stormachtige zeegezicht van Hendrick Cornelisz Vroom bij kunsthandel P. de Boer, of het delicate Delfts Blauw bij Aronson. Maar tussen die stands zal hij zich verbazen over heel wat hedendaagse kunst die hij niet kent van bezoeken aan het Stedelijk of Boijmans."
                            }
                        ]
                    }
