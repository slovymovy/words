                "senses": [
                    {
                        "sense_id": "752a7af7-315d-3dc7-92f4-5b4ee5e5a44d",
                        "entry_id": "245587f2-e126-3c5d-8677-dd71d6d8bfad",
                        "glosses": [
                            "comparative form of well: more well"
                        ],
                        "tags": [
                            "comparative",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "05eda013-6746-4230-8f86-488bdc9f3328",
                                "sense_id": "752a7af7-315d-3dc7-92f4-5b4ee5e5a44d",
                                "text": "Emma is looking weller and handsomer (as you say) than ever."
                            },
                            {
                                "example_id": "ca32d4cb-0a93-4b00-b1fd-71ff7438813e",
                                "sense_id": "752a7af7-315d-3dc7-92f4-5b4ee5e5a44d",
                                "text": "He forgot the Huns; forgot John the Baptist; forgot even his sick, till one of the weller of them (as we may assume) knocked memorially upon his door...."
                            },
                            {
                                "example_id": "6970d3ef-8df8-4073-8673-60e2b33f31b0",
                                "sense_id": "752a7af7-315d-3dc7-92f4-5b4ee5e5a44d",
                                "text": "Now we come home he is already weller."
                            },
                            {
                                "example_id": "31e8137b-a7fe-4649-b76d-511526dbfbaa",
                                "sense_id": "752a7af7-315d-3dc7-92f4-5b4ee5e5a44d",
                                "text": "“I’m not ill. I’m weller than you,” said Michael rudely."
                            }
                        ]
                    }
                ],
