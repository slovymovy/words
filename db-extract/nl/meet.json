                "senses": [
                    {
                        "sense_id": "dbe881e4-ce59-3db8-ac78-48a1d4edbd9c",
                        "entry_id": "f5465922-5e67-39d6-b982-859855b59b35",
                        "glosses": [
                            "een grensstreep, een eindstreep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7653d66-af6a-4880-bf5c-eb7f47a2bb42",
                                "sense_id": "dbe881e4-ce59-3db8-ac78-48a1d4edbd9c",
                                "text": "Aan de meet kwam hij net een wiellengte te kort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb6b02dd-3af8-44ba-ab28-b5e1ff8d36bd",
                        "source_entry_id": "f5465922-5e67-39d6-b982-859855b59b35",
                        "source_sense_id": "dbe881e4-ce59-3db8-ac78-48a1d4edbd9c",
                        "source_sense_description": "een grensstreep, een eindstreep",
                        "target_lang_word": "Ziellinie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziellinie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                        "entry_id": "1ce72ff8-c248-3982-a681-24103ecbb80b",
                                        "glosses": [
                                            "Linie, die für die Teilnehmer eines Wettbewerbs das Ziel markiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9655001d-1fc3-419b-a36e-cfe009de475e",
                                                "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                                "text": "„Am 15. April 2013 explodierten bei der Ziellinie des Marathons in Boston zwei Bomben.“"
                                            },
                                            {
                                                "example_id": "160cd860-009f-42aa-b2de-9be05338cf48",
                                                "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                                "text": "„Der spätere Sieger (8:25,30 Minuten) zog sich bereits 50 Meter vor dem Ziel das Trikot aus und rannte feiernd mit nacktem Oberkörper als Erster über die Ziellinie.“"
                                            },
                                            {
                                                "example_id": "17775d7d-bc5e-4db1-b05c-8ffaa5f985cd",
                                                "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                                "text": "„Ich machte praktisch kurz hinter der Ziellinie schlapp.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e142bcb0-762d-4bcc-a2bc-4bc95ec2a0c1",
                        "source_entry_id": "f5465922-5e67-39d6-b982-859855b59b35",
                        "source_sense_id": "dbe881e4-ce59-3db8-ac78-48a1d4edbd9c",
                        "source_sense_description": "een grensstreep, een eindstreep",
                        "target_lang_word": "Ziel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                        "entry_id": "34ab064f-95c0-3f3b-8c65-c618e79914f6",
                                        "glosses": [
                                            "Ausrichtung oder Endpunkt einer Bestrebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9726694-2883-49df-ac7e-69c515089d71",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "Unser gemeinsames Ziel ist die Verbesserung der Lebensqualität."
                                            },
                                            {
                                                "example_id": "a40c8d3e-98b7-4097-b93c-d1ca22a2ceb5",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "„Beide Bergnamen sind auch in der Neuzeit als Symbolbegriffe hochgesteckter Ziele und Erwartungen geläufig geblieben.“"
                                            },
                                            {
                                                "example_id": "440bf724-815b-44c3-8c2d-69ed2387d4f0",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "„Den Schleichweg nach Karzin kenne ich nun schon, und wieder erreiche ich mein Ziel ohne Zwischenfall.“"
                                            },
                                            {
                                                "example_id": "5ff756b8-837e-4038-a759-6352cc11c7c0",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07a94500-cf5a-336b-8b58-1f0bbc70d458",
                                        "entry_id": "34ab064f-95c0-3f3b-8c65-c618e79914f6",
                                        "glosses": [
                                            "Objekt, das von einem Geschoss getroffen werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c58422-3ed2-4206-9b84-7f054365db42",
                                                "sense_id": "07a94500-cf5a-336b-8b58-1f0bbc70d458",
                                                "text": "Der Schuss traf mitten ins Ziel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a047914-e69d-49b3-aaaf-7bf5a3f3a481",
                        "source_entry_id": "f5465922-5e67-39d6-b982-859855b59b35",
                        "source_sense_id": "dbe881e4-ce59-3db8-ac78-48a1d4edbd9c",
                        "source_sense_description": "een grensstreep, een eindstreep",
                        "target_lang_word": "finish line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finish line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc6368f-95ab-373c-af74-ac59948af4c1",
                                        "entry_id": "9feec098-2b2a-33bd-9411-690e47f91be1",
                                        "glosses": [
                                            "A line marking the end of a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60026fdf-8b7f-4912-9577-9b0815eb451a",
                                                "sense_id": "ecc6368f-95ab-373c-af74-ac59948af4c1",
                                                "text": "The five exhausted runners crossed the finish line one after the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61dc94cb-70bb-3cee-9546-428d3900a9c1",
                                        "entry_id": "9feec098-2b2a-33bd-9411-690e47f91be1",
                                        "glosses": [
                                            "The end of a process."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86638981-4d44-4b5c-bff1-85874d88d948",
                                                "sense_id": "61dc94cb-70bb-3cee-9546-428d3900a9c1",
                                                "text": "The race to the finish line has started already according to Jürgen Klopp and by those punishing standards Liverpool have faltered badly."
                                            },
                                            {
                                                "example_id": "5440bb0c-28b4-46fd-8624-2543122c3f37",
                                                "sense_id": "61dc94cb-70bb-3cee-9546-428d3900a9c1",
                                                "text": "“In the fight for voting rights, this vote was the starting gun, not the finish line,” said Senator Chuck Schumer, Democrat of New York and the majority leader. “We will not let it go. We will not let it die. This voter suppression cannot stand.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7df60007-221a-4d77-9704-16e7838e61e6",
                        "source_entry_id": "f5465922-5e67-39d6-b982-859855b59b35",
