                "translations": [
                    {
                        "translation_id": "0a9eb7cf-48db-467f-a368-bc0a8c454d19",
                        "source_entry_id": "54580bfc-7ddc-39f4-8b0c-e64de9115a6e",
                        "source_sense_id": "ca2aaec3-ef2e-3bd3-93b3-b0558516ef2d",
                        "target_lang_word": "Khazaria",
