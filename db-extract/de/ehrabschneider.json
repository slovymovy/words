                "senses": [
                    {
                        "sense_id": "a412ca81-da7f-33a8-8223-e952a86e1554",
                        "entry_id": "473bd211-1064-387b-81d7-3cce17aeba40",
                        "glosses": [
                            "männliche Person, die andere Personen verleumdet"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "322c952b-a11e-46dd-aac3-b72fa6ec7dbf",
                                "sense_id": "a412ca81-da7f-33a8-8223-e952a86e1554",
                                "text": "„Der Beschuldigte hatte gute Argumente auf seiner Seite: An Hand einiger Lexika, darunter dem katholischen ‚Lexikon für Theologie und Kirche‘, wurde nachgewiesen, daß der Begriff ‚Ehrabschneider‘ nicht in jedem Falle eine Beleidigung ist, sondern die sachliche Umschreibung eines Tatbestandes.“"
                            },
                            {
                                "example_id": "d1a0a958-49a8-4d5c-9b80-46b6d4a8fc75",
                                "sense_id": "a412ca81-da7f-33a8-8223-e952a86e1554",
                                "text": "Dieser Ehrabschneider redet allezeit den Abwesenden übel nach."
                            },
                            {
                                "example_id": "bc5da462-18b3-46b5-92b6-ae2300d8745e",
                                "sense_id": "a412ca81-da7f-33a8-8223-e952a86e1554",
                                "text": "„Unser Gastgeber und seine Frau beruhigten mich mit den Worten, daß die Leute ihnen bekannt seien; als er mir aber die Serviette ins Gesicht warf, weil ich ihn einen Ehrabschneider genannt hatte, führte ihn unser Wirt mit sanfter Gewalt in ein Nebenzimmer und schloß ihn dort ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
