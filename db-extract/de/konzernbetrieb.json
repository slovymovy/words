                "senses": [
                    {
                        "sense_id": "efafee50-05c5-3dee-a13f-08237230eda5",
                        "entry_id": "41531c3a-6f8d-3199-9ad1-664c6849f1a0",
                        "glosses": [
                            "Unternehmen (Betrieb), das als Zusammenschluss einzelner Teilunternehmen, zum Beispiel als Muttergesellschaft mit Tochtergesellschaften, organisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d46779-31b1-4805-a094-a37aa766d9a5",
                                "sense_id": "efafee50-05c5-3dee-a13f-08237230eda5",
                                "text": "„Die Konsolidierungsmaßnahme zur radikalen Reduktion der Personalkosten im Konzernbetrieb steht in engem Zusammenhang mit Äußerungen des Gesamtkonzernvorsitzenden auf einer Konzernvorstandssitzung.“"
                            },
                            {
                                "example_id": "3022cdb2-841a-4f8b-81ac-733acd87c261",
                                "sense_id": "efafee50-05c5-3dee-a13f-08237230eda5",
                                "text": "„Demgegenüber besitzen die juristisch selbständigen Betriebe einer Reihe von Zweigbetrieben, die Trustbetriebe und die Konzernbetriebe Rechtssubjektivität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
