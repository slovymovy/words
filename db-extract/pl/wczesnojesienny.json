                        "glosses": [
                            "odbywający się w początkowym okresie jesieni, przypadający na ten okres, charakterystyczny dla wczesnej jesieni"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "402b175d-653a-4cdf-9675-081bf5485616",
                                "sense_id": "abb14b1a-39b5-3ee3-bf97-41ec21d28ec8",
                                "text": "Wczesnojesienne słońce wciąż pobudza do aktywności."
                            },
                            {
                                "example_id": "cd84619b-03b0-4822-9577-be95e38ecc15",
                                "sense_id": "abb14b1a-39b5-3ee3-bf97-41ec21d28ec8",
                                "text": "Podczas letnich i wczesnojesiennych wędrówek po Tatrach zwracałem baczniejszą uwagę na ten problem, zasięgając również opinii na ten temat u innych turystów"
