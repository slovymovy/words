                        "glosses": [
                            "Relating to, or exhibiting, kyphosis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ee7fdf-6e7e-4943-9a89-ac61910bc57d",
                                "sense_id": "8787f64e-a206-35a1-a166-9a3b32c0d857",
                                "text": "Kyphosis is an increase of the spinal curve in the sagittal plane that results in a greater than normal posterior convexity (anterior concavity). An increased kyphotic curve is encountered more often in the thoracic spine, where it produces a rounded upper back, or 'humped back'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dcacfab-6d2d-4af2-b7b8-afa446806d78",
                        "source_entry_id": "582c62da-c27e-3633-89f3-41ed9b967f12",
                        "source_sense_id": "8787f64e-a206-35a1-a166-9a3b32c0d857",
                        "source_sense_description": "relating to, or exhibiting, kyphosis",
                        "target_lang_word": "kyphotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kyphotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "071770f4-33aa-3386-aacf-ef68a21dc05e",
                                        "entry_id": "28b28800-0d26-3a6e-812f-4f884032a472",
                                        "glosses": [
                                            "in der Art einer Kyphose verkrümmt; an Kyphose leidend"
                                        ],
                                        "tags": [
                                            "von der Wirbelsäule"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18bcb7fd-9850-4967-b46e-8e87f42b9692",
                                                "sense_id": "071770f4-33aa-3386-aacf-ef68a21dc05e",
                                                "text": "Dabei befindet sich der Oberkörper in einer kyphotischen Verspannung, d.h. der obere Rücken ist mehr oder weniger gerundet."
                                            },
                                            {
                                                "example_id": "f3793195-07da-4493-9b6a-29d718588633",
                                                "sense_id": "071770f4-33aa-3386-aacf-ef68a21dc05e",
                                                "text": "Die Wirbelsäule ist im lumbalen Bereich kyphotisch, wobei die aktive Aufrichtung bei Muskelhypotonie nicht gelingt."
                                            },
                                            {
                                                "example_id": "0a71f072-6633-491e-945b-8d1984d12ab2",
                                                "sense_id": "071770f4-33aa-3386-aacf-ef68a21dc05e",
                                                "text": "Wenn eine ältere Frau (und immer häufiger auch ältere Männer) mit kyphotisch verkrümmtem und verkürztem Oberkörper schmerzgeplagt vor uns steht, ist die Diagnose \"Osteoporose\" eindeutig … zu spät."
                                            },
                                            {
                                                "example_id": "608aea2c-0ab3-4f1d-b30f-646401d72c55",
                                                "sense_id": "071770f4-33aa-3386-aacf-ef68a21dc05e",
                                                "text": "Eines dieser Muster ist die Kombination einer starken Hohlkreuzbildung in der Lendenwirbelsäule mit einer starken kyphotischen Krümmung der Brustwirbelsäule (…)."
                                            },
                                            {
                                                "example_id": "e261d347-e9e2-48d1-bb78-40ea13013062",
                                                "sense_id": "071770f4-33aa-3386-aacf-ef68a21dc05e",
                                                "text": "Ist die Brustwirbelsäule jedoch zu stark kyphotisch gekrümmt – wie beim »Rundrücken« –, so steht das Schulterblatt am Rücken ab und die Schultern »fallen nach vorn«."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
