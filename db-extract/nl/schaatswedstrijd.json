                "senses": [
                    {
                        "sense_id": "18e3fdf6-624e-300e-9e03-ac0be06c8b46",
                        "entry_id": "518c609d-0ad1-3699-807f-6731049888c0",
                        "glosses": [
                            "een wedstrijd waarbij de snelste schaatser wint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ae747f-c2c2-48c5-bc14-4cf74b600184",
                                "sense_id": "18e3fdf6-624e-300e-9e03-ac0be06c8b46",
                                "text": "Ready... Pang! Al decennia lang zijn het de vertrouwde geluiden voor de start van een schaatswedstrijd. Als de scheidsrechter en het startpistool hun werk hebben gedaan, schieten de schaatsers weg. Maar die procedure zou in de toekomst wel eens kunnen verdwijnen."
                            },
                            {
                                "example_id": "e1ea0b97-f009-4cae-a7d6-6d8619fe5188",
                                "sense_id": "18e3fdf6-624e-300e-9e03-ac0be06c8b46",
                                "text": "Het is nog onduidelijk onder welke voorwaarden de schaatswedstrijd zal worden verreden. Zo is het nog niet bekend hoeveel schaatsers elk land mag afvaardigen."
                            },
                            {
                                "example_id": "d5d77d33-b623-424c-9210-96fd32e678a0",
                                "sense_id": "18e3fdf6-624e-300e-9e03-ac0be06c8b46",
                                "text": "De schaatswedstrijd stond afgelopen schaatsseizoen voor de eerste keer op het programma bij de WK afstanden in Heerenveen. Dat leidde tot twee keer goud voor Nederland. Irene Schouten won bij de vrouwen, Arjan Stroetinga was de beste bij de mannen."
                            }
                        ]
                    }
