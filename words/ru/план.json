                            "target_lang_translations": {
                                "en": "The factory was able to fulfill the annual <w>plan</w> ahead of schedule.",
                                "de": "Das Werk konnte das Jahres<w>soll</w> vorzeitig erfüllen.",
                                "zh": "工厂提前完成了年度生产<w>指标</w>。"
                            }
                        },
                        {
                            "text": "Менеджер получил премию за то, что перевыполнил <w>план</w> продаж.",
                            "target_lang_translations": {
                                "en": "The manager received a bonus for exceeding the sales <w>target</w>.",
                                "de": "Der Manager erhielt eine Prämie dafür, dass er das Verkaufs<w>ziel</w> übertroffen hat.",
                                "zh": "经理因为超额完成了销售<w>指标</w>而获得了奖金。"
                            }
