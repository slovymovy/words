                    {
                        "sense_id": "6ced3e01-7888-3274-af28-9dd669415454",
                        "entry_id": "8c16fc60-bac0-33e7-a343-4697fcc4a5bf",
                        "glosses": [
                            "ein Gefühl, das man plötzlich empfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06d0761-ba5c-491c-a9ed-8d65ea203dc4",
                                "sense_id": "6ced3e01-7888-3274-af28-9dd669415454",
                                "text": "In seinem Gesicht zeigte sich keinerlei Regung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "918d81a2-2fe4-486d-817b-6639f4ec7a87",
                        "source_entry_id": "8c16fc60-bac0-33e7-a343-4697fcc4a5bf",
                        "source_sense_id": "6ced3e01-7888-3274-af28-9dd669415454",
                        "source_sense_description": "ein Gefühl, das man plötzlich empfindet",
                        "target_lang_word": "emotion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emotion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be306bfd-e7e9-31c6-8196-6cc269783696",
                                        "entry_id": "293b426a-7dde-38fd-943a-8e2ecc3ba4a8",
                                        "glosses": [
                                            "Movement; agitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55ab39f-b10e-488d-956c-d0436530e31b",
                                                "sense_id": "be306bfd-e7e9-31c6-8196-6cc269783696",
                                                "text": "and the water continuing in the caverns[…]caused the emotion or earthquake"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43de13b5-d480-3950-a94c-d0cfc62b4225",
                                        "entry_id": "293b426a-7dde-38fd-943a-8e2ecc3ba4a8",
                                        "glosses": [
                                            "A person's internal state of being and involuntary physiological response to an object or a situation, based on or tied to physical state and sensory data."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "217cc845-62fe-404d-a995-4617de586558",
                                                "sense_id": "43de13b5-d480-3950-a94c-d0cfc62b4225",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            },
                                            {
                                                "example_id": "d860e6fb-472a-4b2d-b763-50f7e4f824ba",
                                                "sense_id": "43de13b5-d480-3950-a94c-d0cfc62b4225",
                                                "text": "“Just think about the last big decision you made. How much of it was based in emotion and how much was based in intellect? Most all big decisions are based in both.” […] Historically, placing weight on emotions has been dismissed. “What’s remarkable is that for so many years, people didn’t see emotions as conveying important messages,” he says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f2b8287-a314-30ae-90a6-0ff90f821ac2",
                                        "entry_id": "293b426a-7dde-38fd-943a-8e2ecc3ba4a8",
                                        "glosses": [
                                            "A reaction by a non-human organism with behavioral and physiological elements similar to a person's response."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "890a8123-d4f8-4980-8e6b-5155204aeeba",
                        "source_entry_id": "8c16fc60-bac0-33e7-a343-4697fcc4a5bf",
                        "source_sense_id": "6ced3e01-7888-3274-af28-9dd669415454",
                        "source_sense_description": "ein Gefühl, das man plötzlich empfindet",
                        "target_lang_word": "émotion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "émotion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                        "entry_id": "e746a991-ca74-342b-bdd2-5790e75c815d",
                                        "glosses": [
                                            "Réaction affective subite, temporaire et involontaire, souvent accompagnée de manifestations physiques, provoquée par un sentiment intense de peur, de colère, de surprise, d’admiration, de déception etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa57dacd-b76b-4e08-a451-8ae0e6326f04",
                                                "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                                "text": "Les émotions se caractérisent en biologie par des modifications d’apparence, notamment dans l’expression faciale, des actes caractéristiques (cris, fuites ou attaques) et des bouleversements à l’intérieur du corps ( battements de cœur, pression artérielle, irrigation sanguine de la peau et des viscères, sécrétion d’hormones...)."
                                            },
                                            {
                                                "example_id": "207da1b4-2edb-41ce-83c4-afa26bbe96ad",
                                                "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                                "text": "Tous les états de la sensibilité sont moteurs. Le langage lui-même en contient la preuve. Il les appelle des émotions."
                                            },
                                            {
                                                "example_id": "aaf2baf8-1343-4387-bc3b-adf6d273134c",
                                                "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                                "text": "« L’émotion est un jugement » a écrit Edmond Haraucourt. Avec lui je le tiens pour le moins faillible de tous."
                                            },
                                            {
                                                "example_id": "e42b1b4c-a3f2-4e20-af26-f903228d531b",
                                                "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                                "text": "Lorsqu’au bout de quelques semaines Elhamy la remercia, avec une cordialité souriante, du bien qu’elle avait fait à son fils, une émotion sourde étreignit sa gorge."
                                            },
                                            {
                                                "example_id": "d55b82ed-fbf5-4e41-80ee-f749d3321d9b",
                                                "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                                "text": "La généralité des Américains s’imaginaient la guerre d’après les campagnes limitées, avantageuses et pittoresques, qui avaient eu lieu autrefois. […]. Ils étaient enclins aussi à la regretter, comme un exercice ennoblissant, à déplorer qu’il ne fût plus possible d’en expérimenter les émotions."
                                            },
                                            {
                                                "example_id": "56279deb-eae4-492f-b802-3c6c918312bc",
                                                "sense_id": "a0c956bb-2eaa-304b-89e1-24f2ecdef18c",
                                                "text": "Malraux, fait prisonnier, adresse à Josette des mots signés d'une tête de chat. Enceinte, elle lui rend visite en prison, à Collemiers, suscitant l’émotion des villageois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c565fb9-fbaa-3c61-821b-ff56bd9b76cf",
                                        "entry_id": "e746a991-ca74-342b-bdd2-5790e75c815d",
                                        "glosses": [
