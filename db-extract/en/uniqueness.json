                        "entry_id": "30b2782a-b42a-3679-8568-23893dd03f69",
                        "glosses": [
                            "The state or quality of being unique or one of a kind."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4192d6cb-e348-45a0-b0d5-c454f2a85c51",
                                "sense_id": "ded48eb2-9087-3169-b53e-7b56d322e521",
                                "text": "In fact, the rebel flag is so prolific in the revival some musicians intentionally avoid using it not because of racially charged meanings but to affirm their own uniqueness and individuality as southern rockers."
                            }
                        ]
                    }
                ],
                "translations": [
