                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cb23a3-ea5b-4a1a-8d1a-adcc371b4ef1",
                                                "sense_id": "79477d4c-cff7-3de9-9012-e6868c655ef9",
