{
    "word_family": [
        "jagen",
        "jager",
        "jacht"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74cfa612-2ece-3343-91f5-9df04ee04b42",
                    "sense_definition": "Actief proberen een bepaald doel, ideaal of verlangen te bereiken of te verkrijgen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "streven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>joeg</w> zijn hele leven lang rijkdom en succes <w>na</w>.",
                            "target_lang_translations": {
                                "en": "He <w>pursued</w> wealth and success his whole life long."
                            }
                        },
                        {
                            "text": "Het is belangrijk om je eigen dromen <w>na</w> te <w>jagen</w>.",
                            "target_lang_translations": {
                                "en": "It is important to <w>chase</w> your own dreams."
                            }
                        }
                    ],
                    "synonyms": [
                        "nastreven",
                        "vervolgen",
                        "beoogd"
                    ],
                    "antonyms": [
                        "opgeven",
                        "laten_varen"
                    ],
                    "common_phrases": [
                        "dromen najagen",
                        "geluk najagen",
                        "doelen najagen"
                    ],
                    "target_lang_definitions": {
                        "en": "Actively trying to achieve or obtain a certain goal, ideal, or desire."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pursue",
                                "target_lang_sense_clarification": "to strive to achieve a goal or dream"
                            },
                            {
                                "target_lang_word": "chase",
                                "target_lang_sense_clarification": "to seek to attain a goal or ambition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96a8739-ffaa-3309-8452-3d1b93a1d7c3",
                    "sense_definition": "Achter iemand of iets aanrennen of jagen om diegene of datgene in te halen of te vangen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "achtervolgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie <w>joeg</w> de dief door de smalle straten <w>na</w>.",
                            "target_lang_translations": {
                                "en": "The police <w>chased</w> the thief through the narrow streets."
                            }
                        },
                        {
                            "text": "De hond <w>joeg</w> de weggelopen kat fanatiek <w>na</w>.",
                            "target_lang_translations": {
                                "en": "The dog fanatically <w>pursued</w> the runaway cat."
                            }
                        }
                    ],
                    "synonyms": [
                        "achtervolgen",
                        "achternazitten",
                        "achtervolg"
                    ],
                    "antonyms": [
                        "ontvluchten",
                        "ontwijken"
                    ],
                    "common_phrases": [
                        "een dief najagen",
                        "de vijand najagen"
                    ],
                    "target_lang_definitions": {
                        "en": "Running after or hunting someone or something in order to catch up with or capture them."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chase",
                                "target_lang_sense_clarification": "to run after someone or something to catch them"
                            },
                            {
                                "target_lang_word": "pursue",
                                "target_lang_sense_clarification": "to follow or hunt with intent to capture"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}