                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2fef1f0-70c1-4c0d-bfef-d3aa83b66a73",
                                                "sense_id": "adb87021-db4f-33fa-959c-da299a49f65c",
                                                "text": "Consommation collaborative, production distribuée, finance participative, éducation et savoir ouverts. Ces mouvements nés de la rencontre de l’innovation numérique et sociale sont les piliers d’une nouvelle économie : l’économie collaborative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d44d38e-29da-4ff3-a551-e1d7421d442c",
                        "source_entry_id": "d1c83756-5542-3c99-accd-a53423b7c444",
                        "source_sense_id": "6ea38a00-9ed5-3279-8907-aad901886f55",
                        "source_sense_description": "pooling of money for a common goal",
                        "target_lang_word": "sociofinancement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociofinancement",
