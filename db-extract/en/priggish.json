    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "848fb62e-a1ce-3e9d-b0f5-25136bc129d5",
                "word": "priggish",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "15fcee64-c633-4527-ac9c-418ac836b1ba",
                        "entry_id": "848fb62e-a1ce-3e9d-b0f5-25136bc129d5",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more priggish"
                    },
                    {
                        "form_id": "f365fff9-89da-4755-b9ed-602e1a900307",
                        "entry_id": "848fb62e-a1ce-3e9d-b0f5-25136bc129d5",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most priggish"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c7be4bd-f1a2-33b7-8d65-3833f646ff0e",
                        "entry_id": "848fb62e-a1ce-3e9d-b0f5-25136bc129d5",
                        "glosses": [
                            "Like a prig."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ffd4b0e-3738-473e-a3e9-d8c7979e5a8a",
                                "sense_id": "1c7be4bd-f1a2-33b7-8d65-3833f646ff0e",
                                "text": "To ride; to dance; she had adored all that. Or going long walks in the country, talking, about books, what to do with one’s life, for young people were amazingly priggish—oh, the things one had said!"
                            },
                            {
                                "example_id": "d845bf54-10f5-4e97-9a21-959b5becb924",
                                "sense_id": "1c7be4bd-f1a2-33b7-8d65-3833f646ff0e",
                                "text": "When the Voice of Britain is heard at nine o'clock, better far and infinitely less ludicrous to hear aitches honestly dropped than the present priggish, inflated, inhibited, school-ma'amish arch braying of blameless bashful mewing maidens!"
                            },
                            {
                                "example_id": "dba6e6d7-9c6d-475e-973c-bf33a8545e62",
                                "sense_id": "1c7be4bd-f1a2-33b7-8d65-3833f646ff0e",
                                "text": "Great ancient columns and rich marbles inspired him with respect, apart from their beauty; and this proprietary human esteem for the arts was a good corrective to the priggish aestheticism of my English-speaking artistic friends."
                            },
                            {
                                "example_id": "742d75dd-7c4a-4123-8599-25e4945a71f6",
                                "sense_id": "1c7be4bd-f1a2-33b7-8d65-3833f646ff0e",
                                "text": "With the advantage of hindsight, [Jess] Stein may seem priggish. But dictionary editors throughout history would sympathize. Figuring out how to put sex in the dictionary—which terms to include and how to define them—is actually one of the most challenging tasks we face."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bb5bc51-e99c-499e-98e7-ab0679fce33e",
                        "source_entry_id": "848fb62e-a1ce-3e9d-b0f5-25136bc129d5",
                        "source_sense_id": "1c7be4bd-f1a2-33b7-8d65-3833f646ff0e",
                        "source_sense_description": "like a prig",
                        "target_lang_word": "preuts",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preuts",
