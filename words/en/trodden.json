                        },
                        {
                            "text": "The fallen leaves had been <w>trodden</w> into the damp mud by passing hikers.",
                            "target_lang_translations": {
                                "ru": "Опавшие листья были <w>втоптаны</w> в сырую грязь проходившими туристами."
                            }
                        }
                    ],
                    "synonyms": [
