                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f70a68-d023-4d2f-a538-96f43d9f07e5",
                                "sense_id": "23e83c17-d742-3d6a-813e-396d83e8720c",
                                "text": "C’est pour moi une victoire hyperpolitique, très symbolique."
                            },
                            {
                                "example_id": "cca83316-8a39-478b-86a4-50a168605856",
                                "sense_id": "23e83c17-d742-3d6a-813e-396d83e8720c",
                                "text": "Dès que l’on met en cause le politique même, l’appareil d’État et la possibilité de « créer une autre société », des partis « hyperpolitiques » comme le parti communiste sont profondément remis en question."
                            },
                            {
                                "example_id": "d6171ca6-92cf-4f71-9190-bae1b8954ab0",
                                "sense_id": "23e83c17-d742-3d6a-813e-396d83e8720c",
                                "text": "Le populisme n’est pas antipolitique, comme il est parfois stigmatisé, mais hyperpolitique, parce qu’il porte cet espoir que la politique change le monde."
                            }
                        ]
                    }
