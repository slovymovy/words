                                                "example_id": "c32d9e42-174b-4f3b-a35e-619efe4ea6a6",
                                                "sense_id": "75246216-531d-3104-b3fe-3dcb2dc9c5d4",
                                                "text": "The tornado lingered, tearing through town, leaving nothing upright."
                                            },
