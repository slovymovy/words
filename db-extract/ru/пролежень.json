                    {
                        "translation_id": "448f6c9f-ae68-4a29-9d20-b3413b350f82",
                        "source_entry_id": "97727754-7b80-3f34-a252-55ad917f8666",
                        "source_sense_id": "69a1ff13-59d6-30c4-a75e-deebf1e974e8",
                        "target_lang_word": "bedsore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bedsore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "570d34d3-12b7-359a-ba0c-6c63ba2390a4",
                                        "entry_id": "5094a517-a6bf-370b-9748-b5ae1154b5ed",
                                        "glosses": [
                                            "A lesion caused by unrelieved pressure to any part of the body, especially portions over bony or cartilaginous areas, such as frequently develops on a person confined to a bed by infirmity."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbca0876-3692-41f0-92c8-58e49947e14c",
                                                "sense_id": "570d34d3-12b7-359a-ba0c-6c63ba2390a4",
                                                "text": "With the slightest movement shooting pain through her thin frame, she developed bedsores under her thighs and back that got infected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21ac1bdf-1ce8-421c-a102-bb8edbba4403",
                        "source_entry_id": "97727754-7b80-3f34-a252-55ad917f8666",
                        "source_sense_id": "69a1ff13-59d6-30c4-a75e-deebf1e974e8",
                        "target_lang_word": "pressure ulcer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressure ulcer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7453dfae-8c88-32db-8e8d-cb7effe62a1f",
                                        "entry_id": "b175eba6-e6d1-33b9-9661-0c6f01dfd497",
                                        "glosses": [
                                            "An ulcer caused by prolonged pressure on the skin as a person lies in a bed or sits in a chair or wheelchair; preventable with sufficient nursing care."
                                        ],
