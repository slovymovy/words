                                        "glosses": [
                                            "Any of a number of filamentous unicellular protists of the class Oomycetes; the water molds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "143e7b34-aae1-4313-b21b-0a579a667f9d",
                                                "sense_id": "1a1a6a3f-42cb-3c8f-95d3-38c1110bb318",
                                                "text": "Chromistas are oomycetes whereas fungi includes chytridiomycetes, zygomycetes, ascomycetes, basidiomycetes, and mitosporic fungi."
                                            }
                                        ]
                                    }
                                ]
