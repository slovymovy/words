                "senses": [
                    {
                        "sense_id": "779bf177-a4f3-3969-aa46-52b9ca70fe31",
                        "entry_id": "52bb29cb-e26f-395f-b57c-b0aa8fe33db4",
                        "glosses": [
                            "Transparent, diaphane."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a632544b-05f4-4afe-8c6b-a02d87390bb2",
                                "sense_id": "779bf177-a4f3-3969-aa46-52b9ca70fe31",
                                "text": "Nostre œil est une substance, de sa nature, pellucide et lumineuse."
                            },
                            {
                                "example_id": "cd75d5b5-2d73-4ebd-9fce-8a88cd229ba6",
                                "sense_id": "779bf177-a4f3-3969-aa46-52b9ca70fe31",
                                "text": "C’était le crépuscule ; dans une glace trouble, ovale de pénombre pellucide posé de champ, elle s’entrevit, spectre menu, ombre pâle, se déplaçant sans la profondeur insondable de l’ombre."
                            },
                            {
                                "example_id": "241b575d-8531-4d95-b1c2-5f62f3a650e3",
                                "sense_id": "779bf177-a4f3-3969-aa46-52b9ca70fe31",
                                "text": "Les narines pincées, Hsiu-Tung s’immergea dans les flots et fit quelques brasses sous l’eau. De la berge, le mandarin avait l’impression qu’une anguille géante ou un poulpe pellucide se mouvait sous la surface."
                            }
                        ]
                    },
                    {
                        "sense_id": "95c91c00-3f12-305d-b755-4a3df7067587",
                        "entry_id": "52bb29cb-e26f-395f-b57c-b0aa8fe33db4",
                        "glosses": [
                            "Relatif à la zone de l'ovocyte située sous la corona radiata."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5ad92811-c9a2-4702-9eaf-d4ddbdbdead5",
                                "sense_id": "95c91c00-3f12-305d-b755-4a3df7067587",
                                "text": "La zone pellucide est la couche acellulaire située entre l’ovocyte et les cellules de la granulosa. Les anticorps dirigés contre les glycoprotéines de la zone pellucide vont provoquer une infertilité selon différents mécanismes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a8d9c32-5369-4479-9d5a-ca165d4296aa",
                        "source_entry_id": "52bb29cb-e26f-395f-b57c-b0aa8fe33db4",
                        "target_lang_word": "durchsichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchsichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "275ff892-8611-3e74-bb77-cd45072e1e87",
                                        "entry_id": "bed6b656-f0aa-3b59-9edd-9ab4b691ae9a",
                                        "glosses": [
                                            "so, dass man hindurchsehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51737b95-a391-4622-9aae-2a92177e65ac",
                                                "sense_id": "275ff892-8611-3e74-bb77-cd45072e1e87",
                                                "text": "Das ist eine durchsichtige Oberfläche."
                                            },
                                            {
                                                "example_id": "acc12f02-4fb0-4931-bc59-a87ffdb0fdbb",
                                                "sense_id": "275ff892-8611-3e74-bb77-cd45072e1e87",
                                                "text": "Dass diese Wand durchsichtig war, hatte er zu spät erkannt."
                                            },
                                            {
                                                "example_id": "4c1cfe8f-61e0-4432-af1e-5229eee89de4",
                                                "sense_id": "275ff892-8611-3e74-bb77-cd45072e1e87",
                                                "text": "Im Trend liegen jetzt große Glasflächen in der Hausfassade selbst, die eine Außenwand komplett transparent machen, einen Giebel von Kopf bis Fuß durchsichtig werden lassen oder dem Wohnbereich mit Galerie eine Lichtinsel verschaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71fe5d7b-3166-3191-b2b3-0c71b31db2bc",
                                        "entry_id": "bed6b656-f0aa-3b59-9edd-9ab4b691ae9a",
                                        "glosses": [
                                            "leicht zu durchschauen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34116dcb-0f0e-401a-ac4d-065014d424e6",
                                                "sense_id": "71fe5d7b-3166-3191-b2b3-0c71b31db2bc",
                                                "text": "Allzu durchsichtig, was Manuela da im Schilde führt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "36fe4c00-1f58-3db5-83e0-68de61eace89",
                                        "entry_id": "bed6b656-f0aa-3b59-9edd-9ab4b691ae9a",
                                        "glosses": [
                                            "so strukturiert, dass man von den Bestandteilen auf die Bedeutung der ganzen Form (vor allem: des Gesamtwortes) schließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0e4602-0f6f-4b56-9e7d-b1bb0db9abf3",
                                                "sense_id": "36fe4c00-1f58-3db5-83e0-68de61eace89",
                                                "text": "Das Wort Schreibtisch ist durchsichtig, da beide Bestandteile (der Wortstamm schreib- und das Wort Tisch) auf die Bedeutung des Wortes schließen lassen; bei Wörtern wie Hahnrei, Salbader und vielen anderen gilt das nicht mehr."
                                            },
                                            {
                                                "example_id": "fa86b7f4-de59-4929-a9bb-6005ef0e932e",
                                                "sense_id": "36fe4c00-1f58-3db5-83e0-68de61eace89",
                                                "text": "„Nicht ganz durchsichtig sind auch Wortbildungen mit -mut als zweitem Bestandteil wie Demut…“"
                                            },
                                            {
                                                "example_id": "acb7c2ed-8555-4382-b0e7-66e924e55f39",
                                                "sense_id": "36fe4c00-1f58-3db5-83e0-68de61eace89",
                                                "text": "„Bei manchen von ihnen gilt eben auch, dass sie wegen ihrer durchsichtigen Wortbildung Hinweise auf ihre Bedeutung enthalten und deswegen eigentlich nicht unverstanden bleiben oder missverstanden werden müssten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
