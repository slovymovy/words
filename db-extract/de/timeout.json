                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "time-out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c463140-c6e0-3a70-a402-550908f00b7b",
                                        "entry_id": "8652fa5d-cc54-383a-927b-42377cff687a",
                                        "glosses": [
                                            "A short break in the action of a sport, for substitution, consultation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee484bfb-aa91-4bf8-ab97-29973680b619",
                                                "sense_id": "1c463140-c6e0-3a70-a402-550908f00b7b",
                                                "text": "We're being beaten! We need a time-out!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b41d633-c5eb-3ddb-b80e-b5cc8c96cd4a",
                                        "entry_id": "8652fa5d-cc54-383a-927b-42377cff687a",
                                        "glosses": [
                                            "A break from a tense, heated or stressful situation (often enforced, sometimes as a disciplinary measure); a cooling-off period."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e15248c-95d9-4463-8d39-f23f9fdee587",
                                                "sense_id": "6b41d633-c5eb-3ddb-b80e-b5cc8c96cd4a",
                                                "text": "I'm going to take a brief time-out from this job."
                                            },
                                            {
                                                "example_id": "e3317a1b-35aa-43fa-b3f3-7761fce098c1",
                                                "sense_id": "6b41d633-c5eb-3ddb-b80e-b5cc8c96cd4a",
                                                "text": "Hitting people is not acceptable! Go to your room and take a time-out!"
                                            },
                                            {
                                                "example_id": "5ca44e3f-d5ba-48f1-92a1-4f016c1ea96d",
                                                "sense_id": "6b41d633-c5eb-3ddb-b80e-b5cc8c96cd4a",
                                                "text": "As punishment, my mom gave me a 15-minute time-out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec51a8e-8970-3755-9d97-e657b5c69528",
                                        "entry_id": "8652fa5d-cc54-383a-927b-42377cff687a",
                                        "glosses": [
                                            "The abortion of an incomplete task after a time limit considered long enough for it to end normally."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
