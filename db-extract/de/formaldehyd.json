                        "examples": [
                            {
                                "example_id": "ae0bdf60-415e-4009-a5af-30ab0c6cb80a",
                                "sense_id": "50979477-5325-3bdb-a571-e86c0625eeb1",
                                "text": "Formaldehyd wurde vom russischen Chemiker Butlerow 1855 entdeckt."
                            },
                            {
                                "example_id": "4ec83ec9-dcd4-442f-82b7-a0d563e0f27d",
                                "sense_id": "50979477-5325-3bdb-a571-e86c0625eeb1",
                                "text": "„Damien Hirst und sein in Formaldehyd gelagerter Tigerhai werden zum Symbol einer dekadenten, raffgierigen Kunstwelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8de0e17-403c-4301-841d-791f87755942",
                        "source_entry_id": "66697757-f06e-334e-a099-3be20558221b",
                        "source_sense_id": "50979477-5325-3bdb-a571-e86c0625eeb1",
