                },
                {
                    "sense_id": "89da4c43-a5cf-38a9-92f2-4e3331dc0729",
                    "sense_definition": "Prendre de nouveau avec soi ce que l'on avait apporté ou emporter quelque chose d'un endroit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>remporter</w> ton parapluie en quittant le restaurant.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>take</w> your umbrella with you when you leave the restaurant.",
                                "ru": "Не забудь <w>забрать</w> зонт, уходя из ресторана.",
                                "de": "Vergiss nicht, deinen Regenschirm <w>mitzunehmen</w>, wenn du das Restaurant verlässt.",
                                "es": "No olvides <w>llevarte</w> el paraguas al salir del restaurante.",
                                "zh": "离开餐厅时别忘了把你的雨伞<w>带走</w>。"
                            }
                        },
                        {
                            "text": "Les clients peuvent <w>remporter</w> les restes de leur repas dans une boîte.",
                            "target_lang_translations": {
                                "en": "Customers can <w>take</w> their leftovers home in a box.",
                                "ru": "Посетители могут <w>унести</w> остатки обеда в коробке.",
                                "de": "Die Gäste können ihre Essensreste in einer Box <w>mitnehmen</w>.",
                                "es": "Los clientes pueden <w>llevarse</w> las sobras de su comida en una caja.",
                                "zh": "顾客可以把剩下的饭菜装在盒子里<w>带走</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rapporter",
                        "reprendre"
                    ],
                    "antonyms": [
                        "laisser"
                    ],
                    "common_phrases": [
                        "remporter ses affaires",
                        "remporter les restes"
                    ],
                    "target_lang_definitions": {
                        "en": "To take back with oneself something one had brought, or carry something away from a place.",
                        "ru": "Забрать с собой то, что приносил, или унести что-либо из какого-либо места.",
                        "de": "Etwas, das man mitgebracht hat, wieder mitnehmen oder etwas von einem Ort wegtragen.",
                        "es": "Llevarse consigo algo que se había traído, o sacar algo de un lugar.",
                        "zh": "把之前带来的东西重新带走，或从某个地方拿走某物。"
                    },
                    "translations": {
