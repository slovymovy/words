                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e14b8259-f1dc-3560-a8f3-ec29fb0a8a72",
                        "entry_id": "c428c495-b20b-3f6d-89e6-7d5123d18d73",
                        "glosses": [
                            "Ancienne monnaie d'or de France qui valait 10 deniers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeaa200b-b9e1-4821-8c60-fefee899efe7",
                                "sense_id": "e14b8259-f1dc-3560-a8f3-ec29fb0a8a72",
                                "text": "Avant de s'aller mettre au lit, songeant que le doyen voudrait bien avoir sa part du butin sinon tout, il compta son gain, y trouva plus d’or que d'argent, car il y avait bien là trois cents carolus."
                            },
                            {
                                "example_id": "cae173a6-225a-4d44-b92b-4524c0f35b54",
                                "sense_id": "e14b8259-f1dc-3560-a8f3-ec29fb0a8a72",
                                "text": "Oh! qu’il est doux, quand l’heure tremble au clocher, de regarder la lune qui a le nez fait comme un carolus d’or!"
                            },
                            {
                                "example_id": "4da55f6f-af62-42fd-bf77-7f676937b167",
                                "sense_id": "e14b8259-f1dc-3560-a8f3-ec29fb0a8a72",
                                "text": "Puis il fit emplir leurs besaces de vivres, leurs bouteilles de vin, leur donna à chacun un cheval pour leur adoucir le reste du chemin, et quelques carolus pour vivre."
                            }
                        ]
                    }
