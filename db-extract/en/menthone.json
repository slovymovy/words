                    {
                        "sense_id": "88626c66-5c53-3a9a-b06f-9e9d00045ff5",
                        "entry_id": "394c243d-432b-300c-aef5-35ccce3742c2",
                        "glosses": [
                            "A minty-flavoured monoterpenoid ketone that is used in perfumery, cosmetics and flavouring."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da15bb58-8a9f-483e-a4b9-33723106ef19",
                                "sense_id": "88626c66-5c53-3a9a-b06f-9e9d00045ff5",
                                "text": "Menthone occurs naturally in a number of essential oils and exists as four possible stereoisomers."
                            },
                            {
                                "example_id": "c2fa04d5-8516-4f73-8a34-dfbc47611378",
                                "sense_id": "88626c66-5c53-3a9a-b06f-9e9d00045ff5",
                                "text": "Upon oxidation, menthol yields the ketone menthone."
                            },
                            {
                                "example_id": "5bfc3966-65b1-4687-b14c-8ee784655e8c",
                                "sense_id": "88626c66-5c53-3a9a-b06f-9e9d00045ff5",
                                "text": "The steady decline in salivary sucrose concentration in contrast with a rise in menthone concentration is air in the mouth that goes into the nose up the back of the throat."
                            },
                            {
                                "example_id": "98afd546-1e26-4261-87ae-71bda09e9874",
                                "sense_id": "88626c66-5c53-3a9a-b06f-9e9d00045ff5",
                                "text": "Physical constants of industrially important menthone isomers are listed in Table 2.1.\nThe menthones are converted into the corresponding menthols by means of hydrogenation; for example, (−)-menthone yields (+)-neomenthol and (−)-menthol."
                            }
                        ]
                    }
                ],
