                                                "sense_id": "44f364ff-697d-380c-9adb-5cd8b17d65e7",
                                                "text": "praise of God"
                                            },
                                            {
                                                "example_id": "7b478705-2b45-4ca2-b5a2-75c96c709bc2",
                                                "sense_id": "44f364ff-697d-380c-9adb-5cd8b17d65e7",
                                                "text": "Let every thing that hath breath praise the Lord."
