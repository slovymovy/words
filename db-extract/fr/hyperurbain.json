                "senses": [
                    {
                        "sense_id": "ea598097-4406-39fc-8bf9-b5fe3d498a3f",
                        "entry_id": "89d26ded-2643-37e9-ac58-178b5869c1ef",
                        "glosses": [
                            "Extrêmement urbain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5306da3d-4670-4397-af6b-b21a840f2511",
                                "sense_id": "ea598097-4406-39fc-8bf9-b5fe3d498a3f",
                                "text": "Dans cet animé, de beaux paysages poétiques de neige et de fleurs font contrepoint au Tokyo hyperurbain."
                            },
                            {
                                "example_id": "61b3104e-0010-42b2-8072-7afb2314b4af",
                                "sense_id": "ea598097-4406-39fc-8bf9-b5fe3d498a3f",
                                "text": "La ressource en eau est globalement suffisante dans le Rhône, département hyperurbain, même si des étiages sévères ont donné lieu ces dernières années à des arrêtés sécheresse par mesure de précaution."
                            },
                            {
                                "example_id": "2ec259f5-59af-452a-8130-8e775eb8a8e8",
                                "sense_id": "ea598097-4406-39fc-8bf9-b5fe3d498a3f",
                                "text": "Comme on le voit dans Metropolis de Fritz Lang, l’aéroport s’est fondu dans l'espace hyperurbain."
                            },
                            {
                                "example_id": "053d4b8a-63c0-4e39-844e-62ac69f80440",
                                "sense_id": "ea598097-4406-39fc-8bf9-b5fe3d498a3f",
                                "text": "Il faut à présent envisager ce qu’on lui attribue, les valeurs qu’on lui attache et qui définissent son urbanité, donc le qualifient comme hyperurbain, puisque l’interrogation porte sur le centre-ville."
                            }
                        ]
                    }
