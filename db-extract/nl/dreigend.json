                                    {
                                        "sense_id": "e1e74cce-160c-3775-90ae-613bcf24f4da",
                                        "entry_id": "147e61e6-d2cf-3f05-8438-8b144acc844a",
                                        "glosses": [
                                            "An act of threatening; a threat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
