                        "form": "der Langue"
                    },
                    {
                        "form_id": "305e700b-e918-4194-9025-2df677345315",
                        "entry_id": "a29d37c6-0733-3495-b7a5-d990ba5f1c1c",
                        "tags": [
                            "accusative",
