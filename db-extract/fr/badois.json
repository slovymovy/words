                ],
                "senses": [
                    {
                        "sense_id": "433a927b-4bb1-3854-bd6d-f9793a26f541",
                        "entry_id": "d6356e9e-b7c8-3de2-9786-b8e2f89b1980",
                        "glosses": [
                            "Relatif au pays de Bade et à ses habitants."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4ab5ba57-102f-4f2b-a481-d6ca98eaaf05",
                                "sense_id": "433a927b-4bb1-3854-bd6d-f9793a26f541",
                                "text": "Les troupe badoises commencent ainsi à quitter nos environs pour entrer en cantonnement dans les arrondissements de Saverne et de Wissembourg. Le quartier-général badois a été transféré avant-hier à Brumath."
                            },
                            {
                                "example_id": "6f2d6deb-3c88-43a3-91e3-4aaac7870764",
                                "sense_id": "433a927b-4bb1-3854-bd6d-f9793a26f541",
                                "text": "Une valise de poëte n’est pas bien longue à visiter, et, au bout de quelques minutes, nous étions dans la salle d’attente, qui est en même temps une salle de restauration du petit chemin de fer badois. Les voyageurs, qui venaient probablement de déjeuner chez eux ou à leur auberge, mangeaient et buvaient déjà, car l’idéale Allemagne ne passe pas tout son temps à cueillir des vergiss-mein-nicht et à dire : « O Klopstock ! »"
                            },
                            {
                                "example_id": "cb75fa46-c19a-42e0-bdbd-e47f388bfe2e",
                                "sense_id": "433a927b-4bb1-3854-bd6d-f9793a26f541",
                                "text": "Il fallait voir la figure des hôteliers badois, le soir, quand nous entrions dans la grande salle du Gasthaus et que, sitôt nos sacs débouclés, nous entonnions d’une voix retentissante :\nVir vollen trinken bier (bis)\nVir vollen, ya, vir vollen\nYa !\nVir vollen trinken bier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21950b3f-1adc-4c88-a40a-f52944fd270b",
                        "source_entry_id": "d6356e9e-b7c8-3de2-9786-b8e2f89b1980",
                        "source_sense_id": "433a927b-4bb1-3854-bd6d-f9793a26f541",
                        "target_lang_word": "badisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "badisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84512f32-f238-3177-8634-7c84e5310b88",
                                        "entry_id": "6b046b6b-020b-3325-8cc7-305863ef5f98",
                                        "glosses": [
                                            "zu Baden oder den Badenern gehörig, Baden oder die Badener betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fae0300-49c7-44b8-8fef-b5e24ba933bd",
                                                "sense_id": "84512f32-f238-3177-8634-7c84e5310b88",
                                                "text": "Die badische Landschaft gefällt mir sehr."
                                            },
                                            {
                                                "example_id": "331874a9-7c22-4f21-89d0-87e60e72bc9a",
                                                "sense_id": "84512f32-f238-3177-8634-7c84e5310b88",
                                                "text": "Mit den badischen Eigenheiten sind wir noch nicht vertraut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
