                        "glosses": [
                            "die Fährte des angeschossenen Wildes, in der Blut liegt"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "ae0d50dc-297e-4def-ad2e-7d9a9ba78100",
                                "sense_id": "44773b98-508f-3c36-939f-b9e5b22775ce",
                                "text": "„Der nun jagdberechtigte deutsche Bürger wünschte sich einen allround-Jagdhund, der sowohl Wild finden, vorstehen, nach dem Schuss apportieren, in Dickungen eindringen, Wasserarbeit leisten, der Rotfährte folgen, das Stück niederziehen, es verbellen oder den Jäger hinführen konnte.“"
                            }
                        ],
