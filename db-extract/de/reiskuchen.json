                        "examples": [
                            {
                                "example_id": "eea8d22f-4a7f-47a1-8d44-234e5c3cbb81",
                                "sense_id": "786c5cfe-a2c9-3103-875f-91cdb339fc43",
                                "text": "„Verägert beobachten zwei Mädchen, die aus durchsichtigen Plastikeimerchen Reiskuchen verkaufen, wie die Menschen vom Jeep weggehen, der die Säcke mit dem Essen gebracht hat.“"
                            },
                            {
                                "example_id": "967a03d6-8335-49ec-ab84-5cd66646b121",
                                "sense_id": "786c5cfe-a2c9-3103-875f-91cdb339fc43",
                                "text": "„Eine Zofe schob den Shoji für Fujiko auf, die ein Tablett mit Cha, einer Schale Reisbrei und süßem Reiskuchen trug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
