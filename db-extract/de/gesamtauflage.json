                    {
                        "sense_id": "c335b4fc-2d80-3ca6-a74a-5a44ff360583",
                        "entry_id": "d78949ae-f372-3bff-8c37-f0df5bcd7f50",
                        "glosses": [
                            "gesamte Anzahl einer Auflage von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9640731a-90d5-46a2-8f5a-1ce337cff3c0",
                                "sense_id": "c335b4fc-2d80-3ca6-a74a-5a44ff360583",
                                "text": "„Im Jahr 2005 erscheinen in Deutschland 347 Tageszeitungen mit 1.550 lokalen Ausgaben und einer Gesamtauflage von gut 22 Millionen.“"
                            },
                            {
                                "example_id": "13f25326-cae2-4b50-a70e-4849b1751e41",
                                "sense_id": "c335b4fc-2d80-3ca6-a74a-5a44ff360583",
                                "text": "„Ich weiß von Bauer, daß die Gesamtauflage zweihundertfünfzig Exemplare war; verkauft worden sind achtundzwanzig, davon heimlich von Hungermann angekauft neunzehn.“"
                            }
                        ],
