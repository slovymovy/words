    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "838e07ff-0b4b-32ff-b0ca-f89c649a9f64",
                    "sense_definition": "A thin, flat material made from crushed wood or cloth, used for writing, printing, drawing, or packaging.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a pen and a piece of <w>paper</w> to write a note.",
                            "target_lang_translations": {
                                "ru": "Мне нужна ручка и листок <w>бумаги</w>, чтобы написать записку.",
                                "pl": "Potrzebuję długopisu i kartki <w>papieru</w>, żeby napisać notatkę."
                            }
                        },
                        {
                            "text": "Please do not waste <w>paper</w> when you print documents.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не тратьте <w>бумагу</w> впустую при печати документов.",
                                "pl": "Proszę, nie marnuj <w>papieru</w> podczas drukowania dokumentów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "piece of paper",
                        "sheet of paper",
                        "pen and paper",
                        "toilet paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий плоский материал из измельченной древесины или ткани, используемый для письма, печати или упаковки.",
                        "pl": "Cienki, płaski materiał wykonany z rozdrobnionego drewna lub tkaniny, używany do pisania, drukowania, rysowania lub pakowania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бумага",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "единица бумаги"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "papier",
                                "target_lang_sense_clarification": "materiał"
                            },
                            {
                                "target_lang_word": "kartka",
                                "target_lang_sense_clarification": "pojedynczy arkusz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0738bba8-e2ac-39d3-b238-e118ffcc795c",
                    "sense_definition": "A set of printed sheets containing news, articles, and advertisements, published daily or weekly; a newspaper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father reads the morning <w>paper</w> while drinking his coffee.",
                            "target_lang_translations": {
                                "ru": "Мой отец читает утреннюю <w>газету</w>, пока пьет кофе.",
                                "pl": "Mój ojciec czyta poranną <w>gazetę</w>, pijąc kawę."
                            }
                        },
                        {
                            "text": "Did you see the article about the election in today's <w>paper</w>?",
                            "target_lang_translations": {
                                "ru": "Ты видел статью о выборах в сегодняшней <w>газете</w>?",
                                "pl": "Widziałeś artykuł o wyborach w dzisiejszej <w>gazecie</w>?"
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "morning paper",
                        "local paper",
                        "read the paper",
                        "daily paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор печатных листов с новостями, статьями и рекламой, выходящий ежедневно или еженедельно; газета.",
                        "pl": "Zbiór zadrukowanych arkuszy zawierających wiadomości, artykuły i reklamy, publikowany codziennie lub co tydzień; gazeta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газета",
                                "target_lang_sense_clarification": "периодическое издание"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gazeta",
                                "target_lang_sense_clarification": "dziennik lub czasopismo"
                            },
                            {
                                "target_lang_word": "pismo",
                                "target_lang_sense_clarification": "publikacja prasowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd4d6c67-24c3-3ac9-917b-b24408d74c75",
                    "sense_definition": "A written essay or report submitted for school, university, or a specific assignment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have to write a history <w>paper</w> about World War II this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мне нужно написать <w>реферат</w> по истории о Второй мировой войне.",
                                "pl": "W ten weekend muszę napisać <w>pracę</w> z historii o II wojnie światowej."
                            }
                        },
                        {
                            "text": "The professor graded my <w>paper</w> and gave me a very good score.",
                            "target_lang_translations": {
                                "ru": "Профессор проверил мою <w>работу</w> и поставил мне очень хорошую оценку.",
                                "pl": "Profesor ocenił moją <w>pracę</w> i wystawił mi bardzo dobrą ocenę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "term paper",
                        "research paper",
                        "write a paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменное эссе или доклад, сдаваемые в школе или университете в качестве учебного задания.",
                        "pl": "Pisemne wypracowanie lub raport składany w szkole, na uniwersytecie lub jako konkretne zadanie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реферат",
                                "target_lang_sense_clarification": "учебная работа"
                            },
                            {
                                "target_lang_word": "письменная работа",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "доклад",
                                "target_lang_sense_clarification": "выступление с текстом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "praca",
                                "target_lang_sense_clarification": "pisemne zadanie szkolne/akademickie"
                            },
                            {
                                "target_lang_word": "referat",
                                "target_lang_sense_clarification": "opracowanie tematu"
                            },
                            {
                                "target_lang_word": "wypracowanie",
                                "target_lang_sense_clarification": "tekst pisany przez ucznia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e04b3833-6873-3256-8ffb-f80eee120f53",
                    "sense_definition": "A formal written report of research or expert opinion published in an academic journal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists published a <w>paper</w> on the effects of climate change.",
                            "target_lang_translations": {
                                "ru": "Ученые опубликовали <w>статью</w> о последствиях изменения климата.",
                                "pl": "Naukowcy opublikowali <w>artykuł</w> na temat skutków zmian klimatu."
                            }
                        },
                        {
                            "text": "She presented her <w>paper</w> at an international conference in London.",
                            "target_lang_translations": {
                                "ru": "Она представила свой <w>доклад</w> на международной конференции в Лондоне.",
                                "pl": "Przedstawiła swój <w>referat</w> na międzynarodowej konferencji w Londynie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scientific paper",
                        "academic paper",
                        "publish a paper"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "academic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный письменный отчет об исследовании или экспертном мнении, опубликованный в научном журнале.",
                        "pl": "Formalny raport pisemny z badań lub opinia ekspercka opublikowana w czasopiśmie naukowym."
                    },
                    "translations": {
