                "senses": [
                    {
                        "sense_id": "bd14d986-f322-35c0-8f37-b6f0485b682a",
                        "entry_id": "120bff2c-de68-332c-b92a-3b4f1cf20e7b",
                        "glosses": [
                            "Technique de dissimulation de la forme de l’ensemble du pénis et des testicules, afin qu’ils ne soit pas devinés à travers les vêtements ; pratiquée par les femmes trans et les hommes transformistes."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "8b9997fe-befa-4084-97b5-e6b4e42d68df",
                                "sense_id": "bd14d986-f322-35c0-8f37-b6f0485b682a",
                                "text": "Le tucking peut grandement alléger la dysphorie ou le confort des personnes concernées. Cette pratique consiste à masquer la proéminence pénienne."
                            },
                            {
                                "example_id": "5da268fa-491c-4c17-9811-006f4a6d837e",
                                "sense_id": "bd14d986-f322-35c0-8f37-b6f0485b682a",
                                "text": "Autre pratique fréquente, le tucking : il s'agit là de scotcher ses parties génitales et les plaquer vers l'arrière afin de les dissimuler. « Moi je ne le fais pas forcément, je m'arrange plutôt avec mes collants pour que tout soit bien rangé ! »"
                            }
                        ]
                    }
