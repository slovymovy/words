                "translations": [
                    {
                        "translation_id": "14e2c9a6-c79c-41a5-8f4a-56f3f34a9842",
                        "source_entry_id": "fbea5baf-923b-33a1-bcb0-bc82e43cdaad",
                        "source_sense_id": "8f0b84d2-c3ca-3682-ad33-2365cebd1658",
                        "source_sense_description": "Gefangener, Gefangene",
                        "target_lang_word": "Gefangener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefangener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "653a43f9-f078-368b-87b2-e70394c02835",
                                        "entry_id": "e647ff17-56af-338c-b28b-0ca3ddf9aadd",
                                        "glosses": [
                                            "jemand, der gefangen ist, sich also nicht frei bewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695369d8-90f1-4e23-af92-194f9f1b6b39",
                                                "sense_id": "653a43f9-f078-368b-87b2-e70394c02835",
                                                "text": "„Kurt fiel Kruglanken ein, wo sie den polnischen Gefangenen manchmal Polack genannt hatten.“"
                                            },
                                            {
                                                "example_id": "9bb53c4a-c4b7-4ef1-a97f-efd582cba72b",
                                                "sense_id": "653a43f9-f078-368b-87b2-e70394c02835",
                                                "text": "„Er tat dies aber, als fünf Tage später ein weiterer Gefangener starb, und zwar an Skorbut, wie er schrieb.“"
                                            },
                                            {
                                                "example_id": "c8540f26-b699-4ca6-bb2a-87387b9f169a",
                                                "sense_id": "653a43f9-f078-368b-87b2-e70394c02835",
                                                "text": "„Die Essensrationen entsprachen diesem theoretischen Maximum, nicht der tatsächlichen Anzahl von Gefangenen.“"
                                            },
                                            {
                                                "example_id": "01643c7e-05f0-44f6-ad5f-952c47a62c0a",
                                                "sense_id": "653a43f9-f078-368b-87b2-e70394c02835",
                                                "text": "„Das Gefängnis ist mit Deserteuren überfüllt, um Platz für neue Gefangene zu schaffen, stellt man die Soldaten vor die Wahl, sich für die Front oder fürs Zuchthaus zu entscheiden.“"
                                            },
                                            {
                                                "example_id": "26108056-9658-458c-a65e-46695da50759",
                                                "sense_id": "653a43f9-f078-368b-87b2-e70394c02835",
                                                "text": "„Hier ist man Gefangener und sonst nichts, solche Dinge gehören nicht hierher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gefangener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0942f54f-95d2-3780-b4eb-2cdd6c015988",
