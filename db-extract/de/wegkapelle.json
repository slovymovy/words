                "senses": [
                    {
                        "sense_id": "cefe8979-ca6f-3720-a62e-0bf0e2eb7b77",
                        "entry_id": "b6d0ebc6-e034-3ac6-8f9d-63719458da40",
                        "glosses": [
                            "sehr kleine Kapelle am Wegrand, in der gebetet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "576c19f2-6821-4cf3-961b-3af0687c299d",
                                "sense_id": "cefe8979-ca6f-3720-a62e-0bf0e2eb7b77",
                                "text": "„Wegkapellen finden sich entweder entlang von Pilgerwegen oder an Abzweigungen, wo einst ein Kreuz stand.“"
                            },
                            {
                                "example_id": "6e0b1a1a-8d0b-4d40-8bb9-26130bca15df",
                                "sense_id": "cefe8979-ca6f-3720-a62e-0bf0e2eb7b77",
                                "text": "„Die reizvolle Wegkapelle wurde laut Inschrift im Jahr 1652 erbaut.“"
                            },
                            {
                                "example_id": "0bb127e7-80d5-43d8-a8f8-51aa40b82beb",
                                "sense_id": "cefe8979-ca6f-3720-a62e-0bf0e2eb7b77",
                                "text": "„Im Norden an der Straße nach Bühlingen gelegen, befindet sich auf der rechten Seite eine kleine Wegkapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
