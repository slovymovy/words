{
    "word_family": [
        "lodger",
        "lodging",
        "dislodge",
        "relodge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2dbd59d-f87f-3ade-9254-b5fa8eb0bc68",
                    "sense_definition": "A small house in the country, used especially by people on holiday or taking part in sports, or a hotel in a rural area.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We rented a wooden <w>lodge</w> in the mountains for our winter vacation.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали деревянный <w>домик</w> в горах для нашего зимнего отпуска.",
                                "zh": "我们租了一间山里的木制<w>度假小屋</w>来度寒假。"
                            }
                        },
                        {
                            "text": "The hunting <w>lodge</w> was decorated with antlers and rustic furniture.",
                            "target_lang_translations": {
                                "ru": "<w>Охотничий домик</w> был украшен оленьими рогами и грубой мебелью.",
                                "zh": "这座狩猎<w>小屋</w>装饰着鹿角和乡村风格的家具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ski lodge",
                        "hunting lodge",
                        "mountain lodge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой загородный дом, используемый для отдыха или занятий спортом, либо отель в сельской местности.",
                        "zh": "位于乡村的度假小屋，或乡村地区的旅馆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "до́мик",
                                "target_lang_sense_clarification": "небольшое строение для отдыха"
                            },
                            {
                                "target_lang_word": "охо́тничий до́мик",
                                "target_lang_sense_clarification": "для охоты"
                            },
                            {
                                "target_lang_word": "котте́дж",
                                "target_lang_sense_clarification": "современный загородный дом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "度假小屋",
                                "target_lang_sense_clarification": "用于度假的乡村小木屋"
                            },
                            {
                                "target_lang_word": "山间旅馆",
                                "target_lang_sense_clarification": "位于山区的住宿设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee13e98-e9b7-3de5-8e34-983bf67c3552",
                    "sense_definition": "A shelter constructed by a beaver on a pond or lake, typically made of mud and sticks.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_animal_home",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beaver swam back to its <w>lodge</w> carrying a fresh branch.",
                            "target_lang_translations": {
                                "ru": "Бобр поплыл обратно в свою <w>хатку</w>, неся свежую ветку.",
                                "zh": "海狸衔着一根新鲜的树枝游回了它的<w>巢穴</w>。"
                            }
                        },
                        {
                            "text": "You can see the top of the beaver <w>lodge</w> sticking out of the water.",
                            "target_lang_translations": {
                                "ru": "Вы можете видеть верхушку бобровой <w>хатки</w>, торчащую из воды.",
                                "zh": "你可以看到海狸<w>巢穴</w>的顶部露出水面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "beaver lodge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жилище бобра, построенное из веток и ила на пруду или озере.",
                        "zh": "海狸在池塘或湖泊中用泥土和树枝筑成的巢穴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ха́тка",
                                "target_lang_sense_clarification": "жилище бобра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海狸巢",
                                "target_lang_sense_clarification": "海狸的住所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc533e9a-629c-36d3-8a31-178eaaf15753",
                    "sense_definition": "A small house or room at the entrance of a large estate, park, or college, often used by a porter or caretaker.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Visitors must report to the porter's <w>lodge</w> before entering the university grounds.",
                            "target_lang_translations": {
                                "ru": "Посетители должны отметиться в <w>сторожке</w> привратника перед входом на территорию университета.",
                                "zh": "访客进入大学校园前必须先到<w>门房</w>登记。"
                            }
                        },
                        {
                            "text": "He collected his mail from the gate <w>lodge</w> on his way out.",
                            "target_lang_translations": {
                                "ru": "Он забрал свою почту из <w>сторожки</w> у ворот по пути наружу.",
                                "zh": "他出门时从<w>门房</w>取走了邮件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "porter's lodge",
                        "gate lodge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK, Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой дом или помещение у ворот усадьбы, парка или колледжа, часто для привратника.",
                        "zh": "位于庄园、公园或大学入口处的小屋，通常供门房或看守人使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторо́жка",
                                "target_lang_sense_clarification": "помещение для сторожа"
                            },
                            {
                                "target_lang_word": "до́мик привратника",
                                "target_lang_sense_clarification": "у ворот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "门房",
                                "target_lang_sense_clarification": "入口处的看守室"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d7b893a-42c2-35a5-a0a0-58047fa32762",
                    "sense_definition": "A traditional home of some indigenous North American peoples, such as a tipi or wigwam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tribe gathered inside the ceremonial <w>lodge</w> for the council meeting.",
                            "target_lang_translations": {
                                "ru": "Племя собралось внутри церемониального <w>вигвама</w> для совета.",
                                "zh": "部落成员聚集在仪式用的<w>帐篷</w>里参加议事会议。"
                            }
                        },
                        {
                            "text": "Smoke rose slowly from the center of the wooden <w>lodge</w>.",
                            "target_lang_translations": {
                                "ru": "Дым медленно поднимался из центра деревянного <w>жилища</w>.",
                                "zh": "烟雾从木制<w>小屋</w>的中心缓缓升起。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sweat lodge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционное жилище некоторых коренных народов Северной Америки (например, вигвам или типи).",
                        "zh": "北美原住民的传统住所，如圆锥形帐篷或圆顶小屋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вигва́м",
                                "target_lang_sense_clarification": "традиционное жилище"
                            },
                            {
                                "target_lang_word": "ти́пи",
                                "target_lang_sense_clarification": "коническая палатка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆锥形帐篷",
                                "target_lang_sense_clarification": "北美原住民传统住所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e679d3f4-5f95-30cb-a9a6-e07f4bc1d209",
                    "sense_definition": "A local branch or chapter of certain organizations or societies, such as the Freemasons.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_org",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was elected as the master of his local Masonic <w>lodge</w> last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году он был избран мастером своей местной масонской <w>ложи</w>.",
                                "zh": "去年他被选为当地共济会<w>分会</w>的会长。"
                            }
                        },
                        {
                            "text": "Members of the <w>lodge</w> meet every month to discuss charity work.",
                            "target_lang_translations": {
                                "ru": "Члены <w>ложи</w> встречаются каждый месяц, чтобы обсудить благотворительную работу.",
                                "zh": "该<w>分会</w>的成员每月聚会讨论慈善工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Masonic lodge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Местное отделение или филиал определенных организаций, например, масонов.",
                        "zh": "某些组织或社团（如共济会）的地方分会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ло́жа",
                                "target_lang_sense_clarification": "отделение организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分会",
                                "target_lang_sense_clarification": "社团的基层组织"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38ef3563-2a15-3364-818a-974515ca2faf",
                    "sense_definition": "To become firmly fixed, stuck, or embedded in a particular place or position.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_fix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bullet missed the target and <w>lodged</w> deep in the tree trunk.",
                            "target_lang_translations": {
                                "ru": "Пуля не попала в цель и глубоко <w>застряла</w> в стволе дерева.",
                                "zh": "子弹偏离了目标，深深地<w>嵌入</w>了树干中。"
                            }
                        },
                        {
                            "text": "A piece of popcorn <w>lodged</w> between his teeth, causing irritation.",
                            "target_lang_translations": {
                                "ru": "Кусочек попкорна <w>застрял</w> у него в зубах, вызывая раздражение.",
                                "zh": "一块爆米花<w>卡在</w>了他的牙缝里，让他很不舒服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lodge in",
                        "lodge between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно застрять или закрепиться в определенном месте или положении.",
                        "zh": "牢固地卡在或嵌入某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застрева́ть",
                                "target_lang_sense_clarification": "несов. вид"
                            },
                            {
                                "target_lang_word": "застря́ть",
                                "target_lang_sense_clarification": "сов. вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡住",
                                "target_lang_sense_clarification": "被固定在某处"
                            },
                            {
                                "target_lang_word": "嵌入",
                                "target_lang_sense_clarification": "深入某物内部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4a4d9ec-ad93-36c1-95d2-9a232a87d306",
                    "sense_definition": "To live in a room or house, usually paying rent to the owner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During his university years, he <w>lodged</w> with a kind elderly couple.",
                            "target_lang_translations": {
                                "ru": "В студенческие годы он <w>квартировал</w> у доброй пожилой пары.",
                                "zh": "大学期间，他<w>寄宿</w>在一位和蔼的老夫妇家中。"
                            }
                        },
                        {
                            "text": "They decided to <w>lodge</w> at a nearby inn while their house was being repaired.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>остановиться</w> на соседнем постоялом дворе, пока их дом ремонтировали.",
                                "zh": "在房屋维修期间，他们决定<w>投宿</w>在附近的一家旅店。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stay",
                        "quarter",
                        "sojourn",
                        "stop over",
                        "sleep over",
                        "tarry"
                    ],
                    "common_phrases": [
                        "lodge with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить в комнате или доме, обычно снимая их у владельца; временно останавливаться.",
                        "zh": "寄宿或临时居住在某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снима́ть жильё",
                                "target_lang_sense_clarification": "арендовать комнату"
                            },
                            {
                                "target_lang_word": "квартирова́ть",
                                "target_lang_sense_clarification": "проживать у кого-то"
                            },
                            {
                                "target_lang_word": "остана́вливаться",
                                "target_lang_sense_clarification": "временно жить (в отеле)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寄宿",
                                "target_lang_sense_clarification": "租住他人房屋"
                            },
                            {
                                "target_lang_word": "投宿",
                                "target_lang_sense_clarification": "临时住宿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "780e0131-7214-360b-96a4-b00b0cc5a3ec",
                    "sense_definition": "To provide someone with a place to sleep or stay for a time.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university can <w>lodge</w> up to five hundred students in its dormitories.",
                            "target_lang_translations": {
                                "ru": "Университет может <w>разместить</w> до пятисот студентов в своих общежитиях.",
                                "zh": "大学宿舍可以<w>安置</w>多达五百名学生。"
                            }
                        },
                        {
                            "text": "The refugees were <w>lodged</w> in temporary shelters near the border.",
                            "target_lang_translations": {
                                "ru": "Беженцы были <w>размещены</w> во временных убежищах недалеко от границы.",
                                "zh": "难民们被<w>安置</w>在边境附近的临时住所里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quarter",
                        "keep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставить кому-либо место для проживания или ночлега.",
                        "zh": "为某人提供住宿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размеща́ть",
                                "target_lang_sense_clarification": "предоставлять жилье"
                            },
                            {
                                "target_lang_word": "сели́ть",
                                "target_lang_sense_clarification": "поселять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安置",
                                "target_lang_sense_clarification": "提供住处"
                            },
                            {
                                "target_lang_word": "留宿",
                                "target_lang_sense_clarification": "提供过夜场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "554363e2-7bfe-3b72-af69-27c6ee409380",
                    "sense_definition": "To make an official complaint, appeal, or statement to the relevant authorities.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "verb_formal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>lodge</w> a formal complaint against the unfair treatment.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>подать</w> официальную жалобу на несправедливое отношение.",
                                "zh": "他决定就这种不公正待遇<w>提出</w>正式投诉。"
                            }
                        },
                        {
                            "text": "The lawyer helped the defendant <w>lodge</w> an appeal with the higher court.",
                            "target_lang_translations": {
                                "ru": "Адвокат помог обвиняемому <w>подать</w> апелляцию в вышестоящий суд.",
                                "zh": "律师协助被告向高等法院<w>提出</w>了上诉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lodge a complaint",
                        "lodge an appeal",
                        "lodge a claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подать официальную жалобу, апелляцию или заявление властям.",
                        "zh": "向有关当局正式提出投诉、上诉或声明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подава́ть",
                                "target_lang_sense_clarification": "заявление, жалобу"
                            },
                            {
                                "target_lang_word": "заявля́ть",
                                "target_lang_sense_clarification": "официально сообщать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提出",
                                "target_lang_sense_clarification": "正式提交申请或投诉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe3ae62a-f242-34dd-aa61-5e082560f058",
                    "sense_definition": "To become flattened by wind or rain (used specifically regarding crops like grass or grain).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_agri",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storm caused the wheat to <w>lodge</w> across the entire field.",
                            "target_lang_translations": {
                                "ru": "Сильный шторм заставил пшеницу <w>полечь</w> по всему полю.",
                                "zh": "强烈的风暴导致整片麦田的麦子都<w>倒伏</w>了。"
                            }
                        },
                        {
                            "text": "Farmers worry that the tall barley might <w>lodge</w> if the wind picks up.",
                            "target_lang_translations": {
                                "ru": "Фермеры беспокоятся, что высокий ячмень может <w>полечь</w>, если поднимется ветер.",
                                "zh": "农民们担心如果风力增强，高大的大麦可能会<w>倒伏</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "agricultural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пригибаться к земле, ложиться (о сельскохозяйственных культурах под воздействием ветра или дождя).",
                        "zh": "指农作物因风雨而倒伏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полега́ть",
                                "target_lang_sense_clarification": "о посевах"
                            },
                            {
                                "target_lang_word": "поле́чь",
                                "target_lang_sense_clarification": "сов. вид, о посевах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒伏",
                                "target_lang_sense_clarification": "农作物因风雨倾倒"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "73a217f1-7ba6-32dc-9d2b-cf3dbc27da09",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Lodge</w> will see you now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Лодж</w> примет вас сейчас.",
                                "zh": "<w>洛奇</w>先生现在可以见你了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
