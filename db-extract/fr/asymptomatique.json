                    {
                        "form_id": "e638a632-743f-4e1c-9803-22bec4adcfd5",
                        "entry_id": "99d805d7-433c-3f6e-875a-07435b65e06b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "asymptomatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97846861-89ba-372c-8e87-2f41ce47a61f",
                        "entry_id": "99d805d7-433c-3f6e-875a-07435b65e06b",
                        "glosses": [
                            "Qui ne se manifeste par aucun symptôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b90344b-a2c0-41b4-9584-5733026c82a0",
                                "sense_id": "97846861-89ba-372c-8e87-2f41ce47a61f",
                                "text": "La thyroïdite d’Hashimoto est une maladie auto-immune qui peut être asymptomatique au début."
                            },
                            {
                                "example_id": "096713ca-df97-44c4-927b-d9a40eefb637",
                                "sense_id": "97846861-89ba-372c-8e87-2f41ce47a61f",
                                "text": "[Le virus] a été latent (on dit asymptomatique…), il a été visible; chez tel ou tel il est parti, mais il est revenu, puis il a fait semblant de partir, mais il était resté […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd6e74a7-5e27-34da-be66-9a7b44cf36b9",
                        "entry_id": "99d805d7-433c-3f6e-875a-07435b65e06b",
                        "glosses": [
                            "Qui ne présente pas de symptôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0496b5-8b82-4287-9be5-6c8ee7439668",
                                "sense_id": "cd6e74a7-5e27-34da-be66-9a7b44cf36b9",
                                "text": "De multiples études ont mis en évidence que des personnes asymptomatiques avaient infecté des gens proches d'eux dans des églises, dans une chorale ou un cours de chant, dans les maisons de retraite…"
                            },
                            {
                                "example_id": "ade6456e-5929-4912-a9d7-e26dce772e81",
                                "sense_id": "cd6e74a7-5e27-34da-be66-9a7b44cf36b9",
                                "text": "Le stade asymptomatique de la maladie."
                            },
                            {
                                "example_id": "8e3b5122-096d-4547-b4c3-d7b51f8fd34a",
                                "sense_id": "cd6e74a7-5e27-34da-be66-9a7b44cf36b9",
                                "text": "-On tousse et on l’accuse de nous avoir refilé le Covid. - Mince, d’ailleurs si on est asymptomatiques, on risque de contaminer tout le village."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6636236-8019-4349-9c2f-57513f3e3e9b",
                        "source_entry_id": "99d805d7-433c-3f6e-875a-07435b65e06b",
                        "target_lang_word": "asymptomatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asymptomatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de02d6c-0528-3a40-881a-d860124fb96f",
                                        "entry_id": "fa327699-635c-3e6a-aebc-bf27426b1405",
                                        "glosses": [
                                            "keine Symptome zeigend, die üblicherweise zu einem bestimmten Krankheitsbild gehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbaa5008-0461-40b0-9d76-7bf86791721d",
                                                "sense_id": "7de02d6c-0528-3a40-881a-d860124fb96f",
                                                "text": "„Ungefähr 25-30% der Rötelnerkrankungen verlaufen asymptomatisch. Sonst kommt es nach einer Inkubationszeit von 14-21 Tagen zum Erkrankungsausbruch mit in der Regel mildem Verlauf.“"
                                            },
                                            {
                                                "example_id": "7579edf7-2548-4c35-94b9-f38af0e47317",
                                                "sense_id": "7de02d6c-0528-3a40-881a-d860124fb96f",
                                                "text": "Eine Infektion kann asymptomatisch (symptomlos) oder symptomatisch verlaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "089a61f5-2076-46aa-9d2e-5e88c87be211",
                        "source_entry_id": "99d805d7-433c-3f6e-875a-07435b65e06b",
                        "target_lang_word": "asymptomatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asymptomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8efca56-0ba6-3ac2-ae04-5adeb15c162b",
                                        "entry_id": "277a8e7c-3adc-3ca1-b9fb-b981806fab79",
                                        "glosses": [
                                            "Not exhibiting any symptoms of disease, as for example in a case which is subclinical (“without signs detectable by physical examination or laboratory test”)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "asymptomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1641747b-c291-3f5a-82c3-795e05c05bd1",
                                        "entry_id": "a46cc2d1-b823-3e64-b30e-52dbb75260b9",
                                        "glosses": [
                                            "A person or an animal that exhibits no symptoms of disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f48d609-b9eb-4782-b5a4-c55363a6e05d",
                                                "sense_id": "1641747b-c291-3f5a-82c3-795e05c05bd1",
                                                "text": "After a 10-day observation period, group 1 was divided into subgroup 1A (symptomatics) and subgroup 1B (asymptomatics)."
                                            },
                                            {
                                                "example_id": "ee52be16-e14b-493e-b47e-274259068f1d",
                                                "sense_id": "1641747b-c291-3f5a-82c3-795e05c05bd1",
                                                "text": "[S]uch a high adult prevalence of parasites emphasises the relevance of the adult malaria parasite reservoir on the transmission of disease in both children and adults and it supports the need for further consideration and research evaluation of treatment of asymptomatics, including approaches such as intermittent screening and treatment (IST) as part of an integrated malaria control programme, if malaria elimination is to be achieved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35cbff15-9a53-3426-8dbe-13dfbb2a5959",
                                        "entry_id": "a46cc2d1-b823-3e64-b30e-52dbb75260b9",
                                        "glosses": [
                                            "Preceded by the: people or animals that exhibit no symptoms of disease regarded collectively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56acf269-2aff-4030-93d8-7c7ba854d05d",
                                                "sense_id": "35cbff15-9a53-3426-8dbe-13dfbb2a5959",
                                                "text": "At the end of the observation period, those who are still symptomatic require second-line treatment, whereas the asymptomatic are discharged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec509f7-264d-410b-b1ae-8f349365e60a",
