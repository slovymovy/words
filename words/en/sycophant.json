{
    "word_family": [
        "sycophancy",
        "sycophantic",
        "sycophantical",
        "sycophantically",
        "sycophantish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                    "sense_definition": "A person who acts obsequiously toward someone important in order to gain advantage; a servile flatterer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flattery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The CEO was surrounded by every <w>sycophant</w> in the building, all hoping for a promotion.",
                            "target_lang_translations": {
                                "ru": "Генерального директора окружал каждый <w>подхалим</w> в здании, и все они надеялись на повышение."
                            }
                        },
                        {
                            "text": "Everyone knew he was a <w>sycophant</w> who would agree with anything the director said.",
                            "target_lang_translations": {
                                "ru": "Все знали, что он <w>подлиза</w>, который соглашался с чем угодно, что скажет директор."
                            }
                        }
                    ],
                    "synonyms": [
                        "toady",
                        "flatterer",
                        "yes man",
                        "bootlicker",
                        "lickspittle",
                        "fawner"
                    ],
                    "antonyms": [
                        "boss",
                        "ruler"
                    ],
                    "common_phrases": [
                        "servile sycophant",
                        "political sycophant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя подобострастно по отношению к кому-то важному, чтобы получить выгоду; раболепный льстец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подхалим",
                                "target_lang_sense_clarification": "льстец, угодничающий ради выгоды"
                            },
                            {
                                "target_lang_word": "лизоблюд",
                                "target_lang_sense_clarification": "презрительное обозначение прислужника"
                            },
                            {
                                "target_lang_word": "льстец",
                                "target_lang_sense_clarification": "тот, кто склонен к лести"
                            },
                            {
                                "target_lang_word": "подлиза",
                                "target_lang_sense_clarification": "угодливый человек, ищущий расположения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                    "sense_definition": "A person who provides information about others to those in authority; an informer or talebearer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient court, a <w>sycophant</w> would often report private conversations to the king to gain favor.",
                            "target_lang_translations": {
                                "ru": "В древнем суде <w>доносчик</w> часто пересказывал королю частные разговоры, чтобы добиться расположения."
                            }
                        },
                        {
                            "text": "The tyrant relied on more than one <w>sycophant</w> to keep track of potential rebels within the city.",
                            "target_lang_translations": {
                                "ru": "Тиран полагался не на одного <w>осведомителя</w>, чтобы следить за потенциальными мятежниками в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "informer",
                        "talebearer",
                        "tattletale"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense relates to the original Greek meaning of an informer."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который предоставляет информацию о других лицам, облеченным властью; осведомитель или доносчик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доносчик",
                                "target_lang_sense_clarification": "тот, кто сообщает властям о чужих действиях"
                            },
                            {
                                "target_lang_word": "осведомитель",
                                "target_lang_sense_clarification": "тайный информатор"
                            },
                            {
                                "target_lang_word": "сикофант",
                                "target_lang_sense_clarification": "в контексте Древней Греции: профессиональный доносчик"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "abfb8419-5bda-3708-b79a-90ead1b0f720",
                    "sense_definition": "To act as a <w>sycophant</w> toward someone; to flatter in an obsequious or servile manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flattery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire evening <w>sycophanting</w> the guest of honor to secure a business deal.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>подхалимничая</w> перед почетным гостем, чтобы обеспечить себе деловую сделку."
                            }
                        },
                        {
                            "text": "It was painful to watch him <w>sycophant</w> his way into the inner circle of the aristocracy.",
                            "target_lang_translations": {
                                "ru": "Было больно смотреть, как он пытается <w>выслужиться</w>, чтобы попасть в узкий круг аристократии."
                            }
                        }
                    ],
                    "synonyms": [
                        "flatter",
                        "fawn",
                        "grovel",
                        "bootlick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя как подхалим по отношению к кому-либо; льстить подобострастным или раболепным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подхалимничать",
                                "target_lang_sense_clarification": "льстить и угодничать"
                            },
                            {
                                "target_lang_word": "лебезить",
                                "target_lang_sense_clarification": "угодничать, заискивать перед кем-либо"
                            },
                            {
                                "target_lang_word": "выслуживаться",
                                "target_lang_sense_clarification": "стараться заслужить чье-то расположение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                    "sense_definition": "To inform against someone or to maliciously misrepresent their actions to an authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic was accused of <w>sycophanting</w> the author's work to the censors to have it banned.",
                            "target_lang_translations": {
                                "ru": "Критика обвинили в том, что он <w>донес</w> цензорам на работу автора, чтобы ее запретили."
                            }
                        },
                        {
                            "text": "He attempted to <w>sycophant</w> his rival by reporting minor infractions to the supervisor.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>наговорить</w> на своего соперника, сообщив руководителю о незначительных нарушениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "calumniate",
                        "inform",
                        "slander"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The verbal use for informing is rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доносить на кого-либо или злонамеренно искажать чьи-либо действия перед властями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доносить",
                                "target_lang_sense_clarification": "сообщать властям о чьих-то проступках"
                            },
                            {
                                "target_lang_word": "клеветать",
                                "target_lang_sense_clarification": "распространять ложные сведения"
                            },
                            {
                                "target_lang_word": "наговаривать",
                                "target_lang_sense_clarification": "возводить напраслину"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
