                "translations": [
                    {
                        "translation_id": "9e2d6196-4d13-4148-b605-e59373cda6cc",
                        "source_entry_id": "96fdbc10-a2e1-3c8e-b06b-0dc70e79ad0f",
                        "source_sense_id": "f806f46d-a72d-3d22-b865-161c2da02bf0",
                        "source_sense_description": "Botanik: bei Pflanzen ein Gewebe aus undifferenzierten Zellen, die zur Teilung fähig sind",
                        "target_lang_word": "meristem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meristem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26d2a270-2428-32b6-a109-06fccf1ee5d6",
                                        "entry_id": "e72b6036-cd1f-350e-bc07-9ad2c559de3f",
                                        "glosses": [
                                            "The plant tissue composed of totipotent cells that allows plant growth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244a4201-c4aa-4508-aa40-221c8967f9cd",
                                                "sense_id": "26d2a270-2428-32b6-a109-06fccf1ee5d6",
                                                "text": "By looking back at a past populated by beings of grotesque difference, humans could place themselves at the apical meristem—the growing tip—of the future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b448413-d233-480a-8f70-adf9d7bcaf79",
                        "source_entry_id": "96fdbc10-a2e1-3c8e-b06b-0dc70e79ad0f",
                        "source_sense_id": "f806f46d-a72d-3d22-b865-161c2da02bf0",
                        "source_sense_description": "Botanik: bei Pflanzen ein Gewebe aus undifferenzierten Zellen, die zur Teilung fähig sind",
                        "target_lang_word": "méristème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méristème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bffe199d-e94f-3c73-8da4-271440c4a1c9",
                                        "entry_id": "7e74ffe1-57c8-3cb7-9425-f9b5beff3063",
                                        "glosses": [
                                            "Tissu constitué de cellules indifférenciées en division active, responsable de la formation des tissus primaires et secondaires ainsi que de la croissance des organes des plantes."
                                        ],
                                        "tags": [
                                            "Histologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95dc9511-0250-4654-974e-deb752c30d2c",
                                                "sense_id": "bffe199d-e94f-3c73-8da4-271440c4a1c9",
                                                "text": "Les méristèmes permettent aux plantes de croître."
                                            },
                                            {
                                                "example_id": "fee6d29f-625c-4b16-bf28-e90de2cd1807",
                                                "sense_id": "bffe199d-e94f-3c73-8da4-271440c4a1c9",
                                                "text": "Leur histogénèse explique leur parfaite superposition en tout point : leurs cellules sont en effet issues des divisions d’un même méristème, le méristème cambial, qui s’étend entre eux comme un mince tissu."
                                            },
                                            {
                                                "example_id": "7fe3fbf5-9423-4a5d-a8c4-0e80c27c9442",
                                                "sense_id": "bffe199d-e94f-3c73-8da4-271440c4a1c9",
                                                "text": "C’était pourtant bien parti. Un hiver pas trop méchant, bien froid en janvier et assez sec, avait donné des fourmis dans les méristènes des bourgeons qui, plus tôt que d’habitude, faisaient une apparition aussi fournie que précoce sur les vignes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97a47061-75ea-4e87-8243-b8405bf35980",
                        "source_entry_id": "96fdbc10-a2e1-3c8e-b06b-0dc70e79ad0f",
