                    {
                        "sense_id": "05b3c28f-a1be-3226-935e-8fbe54468fcb",
                        "entry_id": "210df331-bea2-3aa3-9374-1938f0a62fcb",
                        "glosses": [
                            "Suppe, die aus Bohnen gekocht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf0ea3f-a92b-4474-a0c8-ddc6ee7510ed",
                                "sense_id": "05b3c28f-a1be-3226-935e-8fbe54468fcb",
                                "text": "Kocht man sie nach altem Familienrezept, bracht eine Grüne Bohnensuppe Zeit."
                            },
                            {
                                "example_id": "6eca168d-c2b5-4810-961e-cf9bed91ee96",
                                "sense_id": "05b3c28f-a1be-3226-935e-8fbe54468fcb",
                                "text": "„Dort faßte er einen Schlag Bohnensuppe, sein Brot und seine Wurstration für das Nachtessen; so brauchte er nicht noch einmal ins Dorf zurück.“"
                            }
                        ],
