                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "394735a1-ba1c-4c35-a9c5-f2add51bda6d",
                                                "sense_id": "53dbd002-e59e-3e9c-82df-1553b001135d",
                                                "text": "He lives next door but one (= two houses from mine)."
                                            },
                                            {
                                                "example_id": "dceb94c6-cca1-4513-bc03-2e1a8ba068eb",
                                                "sense_id": "53dbd002-e59e-3e9c-82df-1553b001135d",
                                                "text": "\"Yeh know Tom Jamison, he lives next door t' me up home."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "next door",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8317437f-eda7-379f-bdb1-9969792077c2",
                                        "entry_id": "3042f342-6862-3a4c-9399-947a13c923aa",
                                        "glosses": [
                                            "That is in an adjacent place; that is located next door."
                                        ],
                                        "tags": [
