                            {
                                "example_id": "5ef2edae-d738-47f4-b301-fc9a45fb22ee",
                                "sense_id": "45ebe7ac-3076-3bfe-abba-df182d7d9f9d",
                                "text": "Trotz diesen Unvollkommenheiten wird die Kartothek schon seit vielen Jahren für verschiedene und vielseitige Zwecke häufig genutzt; sie gehört zu einer der am meisten benutzten Karteien im Lettischen Folklorearchiv."
                            },
                            {
                                "example_id": "22a7fdcb-fc39-4fc1-b13e-f10b4367357f",
                                "sense_id": "45ebe7ac-3076-3bfe-abba-df182d7d9f9d",
                                "text": "„Der Beamte lächelte flüchtig und wies Robert auf eine umfangreiche Kartothek hin, die in einer Anzahl von ausziehbaren Kästen geordnet auf dem Schreibtisch stand.“"
                            }
                        ],
