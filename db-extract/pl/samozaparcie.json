                "senses": [
                    {
                        "sense_id": "274e950c-7cc7-3c3e-bf2d-ee1d13f2988a",
                        "entry_id": "315cd85e-02fc-39c4-97be-d1d269b4abb2",
                        "glosses": [
                            "wyrzeczenie się spraw osobistych, poświęcenie ich dla jakich wyższych celów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edea10c3-0828-4f6a-ab5c-8f0608508c53",
                                "sense_id": "274e950c-7cc7-3c3e-bf2d-ee1d13f2988a",
                                "text": "Prawdziwa tolerancja wymaga wysiłku i pracy. Można nawet powiedzieć więcej — i samozaparcia"
                            },
                            {
                                "example_id": "2f6ccb42-1735-4423-ae55-78a1c810ce79",
                                "sense_id": "274e950c-7cc7-3c3e-bf2d-ee1d13f2988a",
                                "text": "Trening długodystansowca wymaga ogromnego poświęcenia się i samozaparcia, wyrzeczenia się niejednej uciechy życiowej"
                            },
                            {
                                "example_id": "85132632-beb8-44ee-8e49-7efb7d8f5a48",
                                "sense_id": "274e950c-7cc7-3c3e-bf2d-ee1d13f2988a",
                                "text": "Przykład prawdziwego bohaterstwa i samozaparcia daje Szmidt. Od pierwszej chwili aż do ostatniej zawsze pamięta o wszystkich, nigdy o sobie"
                            },
                            {
                                "example_id": "3eff456c-1d4e-46f8-99ec-ce4420ff38ef",
                                "sense_id": "274e950c-7cc7-3c3e-bf2d-ee1d13f2988a",
                                "text": "W słowach, znajdzie się wiele ludzi, którzy nadużywają szumnie tytułu przyjaciół ludu, lecz skoro zstąpimy w zakres ofiary i samozaparcia, nie są to zawsze ci sami ludzie, którzy tak dobrze rozumieją obowiązki i godność"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
