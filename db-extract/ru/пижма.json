                                "target_senses": [
                                    {
                                        "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                        "entry_id": "81aec625-2c49-37db-91c7-3e4dbe42dd2e",
                                        "glosses": [
                                            "Astéracée à fleurs jaunes et flosculeuses, et qui a une odeur forte et une saveur amère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb6e5e89-cc78-4462-9ed7-fc65502b1d81",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "D’une cour où se trouvait Paša avec ses amies, une fleur de tanaisie avait été lancée, qui était tombée aux pieds du Borgne."
                                            },
                                            {
                                                "example_id": "b0928953-b531-4812-8126-78b75c038bd6",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "La tanaisie n’est pas adaptée aux petites surfaces car elle est envahissante."
                                            },
                                            {
                                                "example_id": "2a031d01-81ea-44af-8b4d-870aa4e4e1bf",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "La tanaisie a pu être utilisé autrefois comme vermifuge, elle contient une huile essentielle dont un constituant, la thujone, est très toxique à dose élevée."
                                            },
                                            {
                                                "example_id": "08535389-95aa-4a17-82c4-f7c6ca9f0dd3",
                                                "sense_id": "6d8bef75-1f46-395b-8804-fd452ff5a5c6",
                                                "text": "Prenez des feuilles de Pervenche, de Tanaisie & d’Eupatoire d’Avicenne, de chacune deux poignées.\nPilez les un peu, & faites-les macérer pendant vingt-quatre heures dans six livres de lait de vache nouvellement trait.\nDistillez ensuite le tout […]"
                                            }
                                        ]
