                                            {
                                                "example_id": "e4f8657b-c2ae-46d4-80dd-9f5901bea0a7",
                                                "sense_id": "d5b09c97-c629-348b-8fed-a27efa6643d4",
                                                "text": "If one man could be said to be responsible for the creation of the Russian bogy, it was a much-decorated British general named Sir Robert Wilson."
                                            },
                                            {
                                                "example_id": "0019a0f5-4572-40c3-aaa1-e80d1f62976d",
                                                "sense_id": "d5b09c97-c629-348b-8fed-a27efa6643d4",
                                                "text": "England could have been forgiven for believing the fates were against them as they trailed to their League A Group Four opponents, who have become something of a bogey side over the years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe9a9e3-b42f-3adc-8e06-37a97ef5cd83",
                                        "entry_id": "403dab56-7859-347c-9c3c-1564043412e0",
                                        "glosses": [
                                            "A police officer."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0cc811d-df34-3a09-8a4d-cff832ecc514",
                                        "entry_id": "403dab56-7859-347c-9c3c-1564043412e0",
                                        "glosses": [
                                            "A standard of performance set up as a mark to be aimed at in competition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "143f92ed-d325-3db1-81b9-8044733b075f",
                                        "entry_id": "403dab56-7859-347c-9c3c-1564043412e0",
                                        "glosses": [
                                            "An unidentified aircraft, especially as observed as a spot on a radar screen and suspected to be hostile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48eb2b17-365e-4139-bb74-522c4f347028",
                                                "sense_id": "143f92ed-d325-3db1-81b9-8044733b075f",
                                                "text": "He stood on the sand near the gravel road that passed within two miles of the site of the disintegrated bogey, binoculars hanging on a leather strap from his neck, face streaming with sweat under the brim of his hat... Army and government trucks passed along the road every few minutes, some bearing radiation stickers; many of those outward bound, he knew, carried fragments of the bogey. He was not privy to what they were finding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd668e0b-a013-3128-afe2-8edc17985b24",
                                        "entry_id": "403dab56-7859-347c-9c3c-1564043412e0",
                                        "glosses": [
                                            "Synonym of bandit: an enemy aircraft."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91fe13d3-d5f4-41f9-93ba-e598ede3e0ad",
                                                "sense_id": "cd668e0b-a013-3128-afe2-8edc17985b24",
                                                "text": "God dammit, Mustang! This is Ghost Rider 117. This bogey is all over me. He's got missile lock on me. Do I have permission to fire?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cdf31b-bd98-3fa3-95cc-faa0886aaed2",
                                        "entry_id": "403dab56-7859-347c-9c3c-1564043412e0",
                                        "glosses": [
                                            "The notional opponent of a golfer playing alone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a629c439-339b-423c-b782-5d878f6f1329",
                                                "sense_id": "33cdf31b-bd98-3fa3-95cc-faa0886aaed2",
                                                "text": "‘I was just having a practice round against bogey,’ he said. ‘I caddied for myself, so there were no witnesses.’"
                                            }
                                        ]
                                    },
