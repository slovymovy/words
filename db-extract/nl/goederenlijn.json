                        "entry_id": "f72e8d61-1839-32f0-a4da-4cb01151e538",
                        "glosses": [
                            "spoorweg voor het vervoer van waren en goederen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c70d1b-5654-41e4-b73a-9e80779b33c3",
                                "sense_id": "75b3a749-3692-3d47-9fbd-d2c4f72e8820",
                                "text": "Een woordvoerder van de provincie Overijssel laat weten dat de nieuwe goederenlijn kan worden aangelegd als uit het onderzoek zal blijken dat die veiliger is dan aanpassing van het bestaande spoor. Ook vindt de provincie dat de overlast door treinen op de lijn kleiner moet zijn dan bij de plannen van Mansveld."
                            },
                            {
                                "example_id": "38f4a533-6db8-4b2d-bcf9-5609fc932a00",
                                "sense_id": "75b3a749-3692-3d47-9fbd-d2c4f72e8820",
                                "text": "Burgemeesters van gemeenten langs een goederenlijn weten niet van tevoren wat er door hun gemeente wordt vervoerd. Welten zou dat graag anders zien."
                            }
                        ]
                    }
