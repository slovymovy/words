                        "source_sense_description": "Gesamtheit der Betriebe und Unternehmen, die Abfall zu Wertstoffen recycelen und Müll trennen, entsorgen",
                        "target_lang_word": "afvalbeheer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afvalbeheer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "494b300f-2a05-3a2b-84bc-4f946517b330",
                                        "entry_id": "b7ae4a95-b360-3712-81cf-d21db86262da",
                                        "glosses": [
                                            "het zorgen voor een verantwoorde manier van omgaan met afvalstoffen; alle zaken de hebben te maken met het verzamelen, vervoer, verwerken en opslaan van afvalstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e313c0-fb38-4d34-8eaa-bfe0406966ea",
                                                "sense_id": "494b300f-2a05-3a2b-84bc-4f946517b330",
                                                "text": "De Nederlandse economie verdiende in 2015 2,7 miljard euro aan de export van staal, waarvan de helft door de basismetaalindustrie, zoals staalfabrikant Tata Steel. De andere helft wordt verdiend door bedrijfstakken zoals de groothandel, uitzendbureaus, afvalbeheer, machinebouwers en de banken."
                                            },
                                            {
                                                "example_id": "4d9eb0e0-370b-4091-aca1-1e68457d6b37",
                                                "sense_id": "494b300f-2a05-3a2b-84bc-4f946517b330",
                                                "text": "Volgens de inspectie zijn de dodelijke ongevallen een gevolg van een op zich positieve ontwikkeling: de groeiende economie. Juist in groeisectoren als de industrie, bouw, handel en afvalbeheer kwamen de werknemers om het leven."
                                            }
                                        ]
