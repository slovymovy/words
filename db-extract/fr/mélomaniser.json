                "senses": [
                    {
                        "sense_id": "1f986310-b328-3e98-a4a1-0f7d5dfee555",
                        "entry_id": "c0285253-33ee-39ef-9f50-cc8af8808336",
                        "glosses": [
                            "Donner un caractère mélomane à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc9de6c-54c4-4301-afcb-a68e73c54ff4",
                                "sense_id": "1f986310-b328-3e98-a4a1-0f7d5dfee555",
                                "text": "Il n'est jamais trop tard pour se mélomaniser."
                            },
                            {
                                "example_id": "2082cb1c-5bc4-45c9-8b31-3386bfe01581",
                                "sense_id": "1f986310-b328-3e98-a4a1-0f7d5dfee555",
                                "text": "Aussi, j'attendrai (comme la chanson) que vous reveniez m'informer, me cultiver, m'enchanter, me \"mélomaniser\"."
                            },
                            {
                                "example_id": "2681c1b9-a3ec-4541-82ac-f7d9747f4068",
                                "sense_id": "1f986310-b328-3e98-a4a1-0f7d5dfee555",
                                "text": "Douches aussi en accordéon mais super bonne séance avant de se saluer après une pause au Pub de Neuilly sur Seine où ils avaient décidé de se mélomaniser sans grandes convictions."
                            }
                        ]
                    }
