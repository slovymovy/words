                ],
                "senses": [
                    {
                        "sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                        "entry_id": "d15bef80-5dfe-3b67-b133-d41675157f6e",
                        "glosses": [
                            "Variante de détective."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f60949fb-f810-46c7-b429-0e951c1df304",
                                "sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                                "text": "Il semblait si embarrassé de son personnage, le pauvre détectif de Corbeil, si humilié, si vexé, que le juge d’instruction crut devoir venir à son secours."
                            },
                            {
                                "example_id": "82c7713c-2712-4c2e-8265-a6aad25083f2",
                                "sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                                "text": "Il savait regarder les murailles comme un détectif habile examine le visage grimé d’un suspect."
                            },
                            {
                                "example_id": "0c13d30b-13f7-42fa-92d1-a520a560c819",
                                "sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                                "text": "— Excusez-moi si je vous dérange, m’sieu Garneau, mais c’est rapport à un renseignement. Je suis le détectif Dagenais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4bc8e18-ff8d-4ac8-a374-9b1f8a3eea4e",
                        "source_entry_id": "d15bef80-5dfe-3b67-b133-d41675157f6e",
                        "source_sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                        "target_lang_word": "Ermittler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ermittler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                        "entry_id": "166b3173-b25f-3b34-bdea-0e7202a56416",
                                        "glosses": [
                                            "Person, die Ermittlungen/Nachforschungen durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8f9353-fcf9-4db2-bdbb-8ef4d011e51a",
                                                "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                                "text": "„Noch mehr Kopfzerbrechen aber bereitete den Ermittlern der Inhalt seiner Hosentasche: Dort fanden sie zwei beschriebene Papierzettel - die einzig möglichen Hinweise auf die mysteriösen Umstände dieses Todesfalls.“"
                                            },
                                            {
                                                "example_id": "db417eb5-5ef1-4b34-a3eb-4e1e0c458546",
                                                "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                                "text": "„Im Umgang mit Zeugen müssen die Ermittler besonders aufpassen.“"
                                            },
                                            {
                                                "example_id": "29b16d74-954a-4eeb-8ab1-46a0979354a1",
                                                "sense_id": "f7b76001-aaf4-31a5-823f-18220a217644",
                                                "text": "„Internationale Ermittler haben nach Angaben von Europol eine Bande von Bücherdieben gefasst, die einen enormen finanziellen und einen unschätzbaren kulturellen Schaden angerichtet haben sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4467dfa1-e29f-4c5f-b5c5-65101a1be7bf",
                        "source_entry_id": "d15bef80-5dfe-3b67-b133-d41675157f6e",
                        "source_sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                        "target_lang_word": "Detektiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Detektiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                        "entry_id": "6fb164bd-cced-37d4-9e94-49365d17b5c7",
                                        "glosses": [
                                            "(meist privater) Ermittler, der nach Beweismitteln für etwas sucht"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e29ca4-198e-4b04-a42d-47b8ddcd3f40",
                                                "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                                "text": "Wir sollten zuerst einen Detektiv beauftragen, bevor wir die Polizei einschalten."
                                            },
                                            {
                                                "example_id": "731a2371-6134-4a6b-86d9-e67e9d7ab8ad",
                                                "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                                "text": "„Ich war ein Detektiv, der für nichts eine Lösung fand.“"
                                            },
                                            {
                                                "example_id": "deade15d-ee13-4873-ba52-7bd1615b26e3",
                                                "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                                "text": "„Zwei Schutzleute bewachten das schmale Pförtchen, aber sie ließen mich mit dem Hund passieren, als ich des Detektivs Namen nannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1232495-0be2-456b-8b10-3ae2293020c8",
                        "source_entry_id": "d15bef80-5dfe-3b67-b133-d41675157f6e",
                        "source_sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
