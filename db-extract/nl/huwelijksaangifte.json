                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d276559-2e69-440d-9037-c9a8e07311a7",
                                "sense_id": "938731d7-3c37-393b-bf66-3628b718617b",
                                "text": "De tijd tussen huwelijksaangifte en het daadwerkelijke huwelijk is 14 dagen tot maximaal 1 jaar."
