                "senses": [
                    {
                        "sense_id": "f6c2122e-53ec-3615-9495-970862e3a149",
                        "entry_id": "405cb7a0-20ec-3928-ae3b-5afa507ddccb",
                        "glosses": [
                            "ein unter dem oberen Fußbodenbelag angebrachtes Material, das der Dämmung gegen Trittschall dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1976af0-0b4e-456d-babc-886e6d0dcbdc",
                                "sense_id": "f6c2122e-53ec-3615-9495-970862e3a149",
                                "text": "„Der Clou des Adahan aber ist sein Dachrestaurant. Zwar arbeitet Aklan noch immer an der Trittschalldämmung der Terrasse und muss Gästen mit leichtem Schlaf vorerst empfehlen, bestimmte Zimmer in der vierten Etage besser nicht zu nehmen. Aber da oben auf dem Dach den späten Nachmittag zu verbringen, während ein Dutzend Störche über dem nahen Galata-Turm kreist, dann den Sonnenuntergang zu sehen über dem Goldenen Horn und schließlich die beleuchteten Kuppeln und Minarette der Süleyman- und der Fatih-Moschee, während zum Abendessen eine Pide an den Tisch kommt, jene längliche türkische Pizza, die hier mit saftigen Lammfleischwürfeln belegt wird und so frisch und delikat schmeckt, dass man am liebsten gleich noch eine ordern möchte ( oder den Koch nach seinem Geheimnis fragen ) das versöhnt für eine Zeit lang mit dem Lärm der Stadt und des Lebens […].“"
                            },
                            {
                                "example_id": "66969436-5349-42bf-8a7b-3745189b0e73",
                                "sense_id": "f6c2122e-53ec-3615-9495-970862e3a149",
                                "text": "Auch ein Teppich kann als Trittschalldämmung verwendet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
