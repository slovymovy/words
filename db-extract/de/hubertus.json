                        ],
                        "form": "die Hubertusse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                        "entry_id": "d1f4779e-4e69-386b-b2d0-d992f8205248",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61fb0bbe-9884-4bfd-a617-f88833f76221",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Frau Hubertus ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b82fc2b6-e96c-46ff-9aab-53970695934e",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Herr Hubertus wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d4c3a3da-525d-458c-b552-6c2d8ad802b3",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Die Hubertus fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8d5e88f0-2b33-4588-a1d6-821f7ab0e258",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Der Hubertus trägt nie die Schals, die die Hubertus ihm strickt."
                            },
                            {
                                "example_id": "8aec5097-94ea-4484-a74c-b125dd0edf21",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hubertus kommt, geht der Herr Hubertus.“"
                            },
                            {
                                "example_id": "eb9870ea-1507-4de5-bb3d-7e608917393b",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Hubertus kommt und geht."
                            },
                            {
                                "example_id": "683b83c0-1718-4ab8-b691-197602110de7",
                                "sense_id": "69af7254-1f7e-36f0-9f2a-d45de13d3fad",
                                "text": "Hubertusse kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
