{
    "word_family": [
        "cierpieć",
        "cierpienie",
        "cierpliwy",
        "cierpliwość",
        "cierpiętnik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1461e4a-e790-3e20-9630-53d95f7fb48f",
                    "sense_definition": "doznać szkody, uszczerbku na zdrowiu lub ran w wyniku jakiegoś zdarzenia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "szkoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żadne zwierzę nie <w>ucierpiało</w> podczas kręcenia tego filmu przygodowego.",
                            "target_lang_translations": {
                                "ru": "Ни одно животное не <w>пострадало</w> во время съёмок этого приключенческого фильма."
                            }
                        },
                        {
                            "text": "Na szczęście w tym groźnym wypadku nikt poważnie nie <w>ucierpiał</w>.",
                            "target_lang_translations": {
                                "ru": "К счастью, в этой страшной аварии никто серьёзно не <w>пострадал</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "poszkodować się"
                    ],
                    "common_phrases": [
                        "poważnie ucierpieć",
                        "ucierpieć w wypadku"
                    ],
                    "target_lang_definitions": {
                        "ru": "получить вред, ущерб здоровью или ранения в результате какого-либо происшествия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пострадать",
                                "target_lang_sense_clarification": "о людях или животных, физический ущерб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d16a1f51-84ab-3447-a139-bd5f108eebaa",
                    "sense_definition": "ponieść straty materialne lub ulec uszkodzeniu, zniszczeniu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "szkoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiele zabytkowych budynków bardzo <w>ucierpiało</w> podczas wczorajszej nawałnicy.",
                            "target_lang_translations": {
                                "ru": "Многие исторические здания сильно <w>пострадали</w> во время вчерашней бури."
                            }
                        },
                        {
                            "text": "Gospodarka regionu mocno <w>ucierpiała</w> na skutek trwającego kryzysu finansowego.",
                            "target_lang_translations": {
                                "ru": "Экономика региона сильно <w>пострадала</w> в результате продолжающегося финансового кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ucierpieć na skutek",
                        "mocno ucierpieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "понести материальные убытки либо получить повреждения, подвергнуться разрушению"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пострадать",
                                "target_lang_sense_clarification": "о зданиях, экономике, имуществе"
                            },
                            {
                                "target_lang_word": "понести ущерб",
                                "target_lang_sense_clarification": "о материальных потерях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8478c50e-276d-35cf-9565-85a9a58ff6d2",
                    "sense_definition": "zostać naruszonym, pogorszyć się w sensie abstrakcyjnym lub wizerunkowym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "szkoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ujawnieniu skandalu reputacja polityka bardzo poważnie <w>ucierpiała</w>.",
                            "target_lang_translations": {
                                "ru": "После разоблачения скандала репутация политика очень серьёзно <w>пострадала</w>."
                            }
                        },
                        {
                            "text": "Jego duma <w>ucierpiała</w>, kiedy musiał publicznie przyznać się do popełnionego błędu.",
                            "target_lang_translations": {
                                "ru": "Его гордость <w>пострадала</w>, когда ему пришлось публично признать совершённую ошибку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "duma ucierpiała",
                        "reputacja ucierpiała"
                    ],
                    "target_lang_definitions": {
                        "ru": "ухудшиться, быть задетым в абстрактном смысле или в плане имиджа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пострадать",
                                "target_lang_sense_clarification": "о репутации, гордости, качестве"
                            },
                            {
                                "target_lang_word": "пошатнуться",
                                "target_lang_sense_clarification": "об авторитете или репутации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}