                "senses": [
                    {
                        "sense_id": "f0567c7a-9fcf-31e5-a380-8944f04026c2",
                        "entry_id": "027ae00d-c456-34c5-8998-3745dea887c9",
                        "glosses": [
                            "Woche, in der eine Mietpartei eines Gebäudes zur Reinigung des Treppenhauses, der Schneeräumung des Bürgersteigs o. Ä. Aufgaben verpflichtet ist"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb3b90a-9b29-44fc-bae4-61879f2ba647",
                                "sense_id": "f0567c7a-9fcf-31e5-a380-8944f04026c2",
                                "text": "„Wie alle guten Schwaben machen auch sie immer gewissenhaft ihre Kehrwoche.“"
                            },
                            {
                                "example_id": "16a58693-d6b2-4264-b26f-85114fd870aa",
                                "sense_id": "f0567c7a-9fcf-31e5-a380-8944f04026c2",
                                "text": "„Auch die Kehrwoche fällt bei dem Albstädter, der seit seinem Studium in Berlin wohnt, nicht aus.“"
                            },
                            {
                                "example_id": "f59549fb-6881-410d-8531-f939f272462f",
                                "sense_id": "f0567c7a-9fcf-31e5-a380-8944f04026c2",
                                "text": "„Und vielleicht schaffen es die Schwaben, dass es auch in Berlin mal eine Kehrwoche gibt.“"
                            },
                            {
                                "example_id": "4140f440-d7ca-4c09-9afb-a189fca23fb4",
                                "sense_id": "f0567c7a-9fcf-31e5-a380-8944f04026c2",
                                "text": "„Auch heute findet man in Mietshäusern teilweise noch das typische Schild mit der Aufschrift „Kehrwoche“, das an der Wohnungstür des jeweils für die Kehrwoche zuständigen Mieters aufgehängt wird oder es wird einfach der Besen beim Betroffenen abgestellt.“"
                            },
                            {
                                "example_id": "b3950a41-651e-4170-b479-17dcfbc64afd",
                                "sense_id": "f0567c7a-9fcf-31e5-a380-8944f04026c2",
                                "text": "„Bei Blitzeis und Schnee wird die schwäbische Kehrwoche zur besonderen Herausforderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
