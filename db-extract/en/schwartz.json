                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9b9723-2f88-3701-ab5b-62cb1afa3111",
                                        "entry_id": "7c15ca9b-8c9b-34c9-96ea-f2868ead549c",
                                        "glosses": [
                                            "Name des schwarzen, des dunkelsten Farbtons, Malfarbe, Streichfarbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f88a40-6273-4751-b0ce-a6abec389fcd",
                                                "sense_id": "7e9b9723-2f88-3701-ab5b-62cb1afa3111",
                                                "text": "Das Schwarz ihrer Augen war schwärzer als die Nacht."
                                            },
                                            {
                                                "example_id": "44535701-a692-4771-ba23-9b0d025c88a8",
                                                "sense_id": "7e9b9723-2f88-3701-ab5b-62cb1afa3111",
                                                "text": "„Das Schwarz ist daher nichts, was von selbst Bestand hätte.“"
                                            },
                                            {
                                                "example_id": "116a40aa-503a-4b3b-b0a6-c5ffa051567a",
                                                "sense_id": "7e9b9723-2f88-3701-ab5b-62cb1afa3111",
                                                "text": "„Ihre Haut hebt sich sanft strahlend gegen das Schwarz ihres Kleides ab, und sie scheint wieder in der Stimmung rebellischen Übermuts zu sein, die für sie so typisch ist, wenn sie trinkt.“"
                                            },
                                            {
                                                "example_id": "72747028-c32f-409c-8e84-18bd8c61ac37",
                                                "sense_id": "7e9b9723-2f88-3701-ab5b-62cb1afa3111",
                                                "text": "„Das Schwarz von Pik scheint zu zerlaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schwarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "465ba25f-d3d7-3c91-a4a3-8ddcaaacb6cb",
                                        "entry_id": "b72026e8-884d-3286-86dc-79548d54f7cc",
                                        "glosses": [
                                            "in den Spielen Schach, Dame, Mühle und Go der Spieler mit den schwarzen Spielsteinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23546125-350a-471e-82c3-32ab6eb9d5b1",
                                                "sense_id": "465ba25f-d3d7-3c91-a4a3-8ddcaaacb6cb",
                                                "text": "Schwarz ist am Zug."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a655ba92-d896-36e2-bfe1-e6bdeb2bfac4",
                                        "entry_id": "b72026e8-884d-3286-86dc-79548d54f7cc",
                                        "glosses": [
                                            "Farbe, Farbton der Bekleidung; im westlichen Kulturkreis ist Schwarz die Farbe der Trauer und des Todes, Farbe der Trauerkleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33dda46-85e5-4eb1-bf14-6a4f8b52bab0",
                                                "sense_id": "a655ba92-d896-36e2-bfe1-e6bdeb2bfac4",
                                                "text": "Seitdem ihr Mann tot ist, geht Monique nur noch in Schwarz."
                                            },
                                            {
                                                "example_id": "2157f461-43dc-46c9-8398-aadda69f6743",
                                                "sense_id": "a655ba92-d896-36e2-bfe1-e6bdeb2bfac4",
                                                "text": "Hanni trägt heute ein Abendkleid in Schwarz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schwarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                        "entry_id": "0faaad24-1042-3522-a771-73144613a8ea",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname, in Deutschland und Österreich flächendeckend vorkommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb3dac76-089a-49dd-b1f4-21bd6fd78039",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Frau Schwarz ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "aa3f3442-42bc-4de9-bd3f-7c178637e640",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Herr Schwarz wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d7a44abf-c496-49b3-9ef5-60fa0571d34e",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Die Schwarz kommen heute von Langeooge."
                                            },
                                            {
                                                "example_id": "22222c21-8051-4afb-a0e3-7c27f9a41d1d",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Der Schwarz trägt nie die Schals, die die Schwarz ihm strickt."
                                            },
                                            {
                                                "example_id": "72a4794c-a5a2-4ec2-9cdf-9277480efcaa",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwarz kommt, geht der Herr Schwarz.“"
                                            },
                                            {
                                                "example_id": "09fb9437-229c-4be6-a295-85eca950b408",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Schwarz kommt und geht."
                                            },
                                            {
                                                "example_id": "b41b404f-c6a7-4756-bdfd-0d20127da5f1",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "Schwarzens kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "230cb129-5edc-4571-81a2-8563e7d89fec",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "An verregneten Herbsttagen ist Familie Schwarz liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "790e35c6-9486-46a9-bc35-f7e9fdc9e7ac",
                                                "sense_id": "6b40b4c0-ff6c-3d2f-b3f5-ecf0caaaeabd",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Schwarz das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
