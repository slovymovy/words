                    },
                    {
                        "translation_id": "5cb59801-7fe2-4dfa-bdc9-683235db8e28",
                        "source_entry_id": "1ffee32b-f06e-372b-b471-fca206f1c216",
                        "source_sense_id": "cdef3555-4898-3b40-9b4c-e172da24b6d1",
                        "target_lang_word": "Nuremberg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nuremberg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0679deae-6393-3b05-b607-079bda77dad6",
                                        "entry_id": "aac4c78e-7e28-33ce-90b9-aad3aa088a7c",
                                        "glosses": [
                                            "Ville, commune et arrondissement d’Allemagne, située dans le Land de Bavière ; ville la plus peuplée du district de Moyenne-Franconie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d3360d-40af-409f-8e51-67cbe8c3efd6",
                                                "sense_id": "0679deae-6393-3b05-b607-079bda77dad6",
                                                "text": "Il possédait, en outre, une manière automatique de remuer le menton en prononçant ses phrases qui le faisait ressembler à un casse-noisette de Nuremberg et mettait en joie tous les polissons."
                                            },
                                            {
                                                "example_id": "764be6ee-4f07-4a92-a446-14f36cb8592e",
                                                "sense_id": "0679deae-6393-3b05-b607-079bda77dad6",
                                                "text": "Après Coblence, ils sont allés à Nuremberg dans un monospace noir de la marque Mercédès puis à Stuttgart dans un van Renault bleu foncé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52047c5b-a0c0-4194-9a01-1372e92eabc7",
                        "source_entry_id": "1ffee32b-f06e-372b-b471-fca206f1c216",
                        "source_sense_id": "cdef3555-4898-3b40-9b4c-e172da24b6d1",
                        "target_lang_word": "Nürnberg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nürnberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12a42b7a-6646-35b6-9d26-02415024b8d3",
                                        "entry_id": "5c5b68cc-2409-393e-9469-01c98472d570",
                                        "glosses": [
                                            "Stadt in Bayern, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9287805-c53c-4420-8734-16049b86926d",
                                                "sense_id": "12a42b7a-6646-35b6-9d26-02415024b8d3",
                                                "text": "Nürnberg ist das wirtschaftliche und kulturelle Zentrum Frankens."
                                            },
                                            {
                                                "example_id": "6431df69-dd91-4102-8925-520030742b38",
                                                "sense_id": "12a42b7a-6646-35b6-9d26-02415024b8d3",
                                                "text": "„Deutsche Städte wie Mainz, Frankfurt, Augsburg und Nürnberg waren Vorreiter des Buchdrucks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9fd9c1d-f162-47f1-9e61-1775f2a451b0",
                        "source_entry_id": "1ffee32b-f06e-372b-b471-fca206f1c216",
                        "source_sense_id": "cdef3555-4898-3b40-9b4c-e172da24b6d1",
                        "target_lang_word": "Нюрнберг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Нюрнберг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "57eb8b08-096c-31b3-8e71-2e8e0c5b9fbc",
                                        "entry_id": "ef90ed9f-e4b5-314c-b449-a7245e8a7430",
                                        "glosses": [
                                            "город в земле Бавария, Германия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7521db41-574d-44a0-9616-a34b6e61f251",
                                                "sense_id": "57eb8b08-096c-31b3-8e71-2e8e0c5b9fbc",
                                                "text": "Лет четыреста пятьдесят тому назад какой-то предприниматель или капитан корабля привёз в славный город Нюрнберг носорога и выставил его в балагане, а художник Дюрер протискался через толпу зевак, открыл альбом и начал рисовать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c09d51-ad2b-3998-b218-d18e08c5a4f4",
                                        "entry_id": "ef90ed9f-e4b5-314c-b449-a7245e8a7430",
                                        "glosses": [
                                            "истор., разг. то же, что Нюрнбергский процесс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a816863e-7f09-42ee-9b3b-612b03c158ad",
                                                "sense_id": "43c09d51-ad2b-3998-b218-d18e08c5a4f4",
                                                "text": "Что касается собственно процесса, автору, конечно, было трудно сказать что-то новое, а тем более превзойти современников-репортёров и мастеров искусств, изображавших Нюрнберг позднее."
                                            },
                                            {
                                                "example_id": "35a875b9-6783-4bdd-905a-0f462f8a5617",
                                                "sense_id": "43c09d51-ad2b-3998-b218-d18e08c5a4f4",
                                                "text": "Довести дело до конца ― добиться Нюрнберга для КПСС."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
