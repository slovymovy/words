                                "target_senses": [
                                    {
                                        "sense_id": "e6299a92-5a2b-30f0-8f23-520dd79f7556",
                                        "entry_id": "8b48439f-a33e-3af4-a412-7355c26e6b26",
                                        "glosses": [
                                            "Ville et capitale de Turquie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6faf7b58-c76a-4f4b-8a1e-07d79256e4ab",
                                                "sense_id": "e6299a92-5a2b-30f0-8f23-520dd79f7556",
                                                "text": "Un pied à Stamboul sur la rive européenne, l’autre à Ankara sur le plateau asiatique, Kemal Ataturk, vainqueur des Grecs et régénérateur de la jeune Turquie, règne en dictateur souverain sur ce qui reste de l’ancien Empire ottoman."
                                            },
                                            {
                                                "example_id": "1d3534f3-866a-43d5-bc08-3dca69e5dc50",
                                                "sense_id": "e6299a92-5a2b-30f0-8f23-520dd79f7556",
                                                "text": "Le PKK a revendiqué un attentat contre le siège de la police à Ankara, en Turquie, qui a fait deux blessés dimanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869514d4-6625-30a3-859c-7cd60aaff259",
                                        "entry_id": "8b48439f-a33e-3af4-a412-7355c26e6b26",
                                        "glosses": [
                                            "Le gouvernement turc."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf187816-fd72-4be9-9292-2d60f580f14b",
                                                "sense_id": "869514d4-6625-30a3-859c-7cd60aaff259",
                                                "text": "Ankara a ordonné le bombardement de la zone en représailles."
                                            },
                                            {
                                                "example_id": "90116f6e-85a2-4263-a7b4-05e5afd58627",
                                                "sense_id": "869514d4-6625-30a3-859c-7cd60aaff259",
                                                "text": "Ankara a proposé vendredi à l’Égypte son remorqueur Nene Hatun pour tracter le porte-conteneurs, un nouveau signe de l’offensive de charme d’Ankara envers Le Caire après des années de crise."
                                            },
                                            {
                                                "example_id": "c990395b-feb4-4b0b-b5f2-fd7c506c4a4f",
                                                "sense_id": "869514d4-6625-30a3-859c-7cd60aaff259",
                                                "text": "Une zone tampon des Nations unies sépare le Sud, hellénophone et majoritairement chrétien, de la République turque de Chypre du Nord (RTCN), reconnue uniquement par Ankara."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
