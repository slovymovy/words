                                                "example_id": "4f33ddf0-0c68-4744-b18e-a3222febf306",
                                                "sense_id": "25726cc0-d693-38f7-9d66-79d3f91f6717",
                                                "text": "„Die Tuareg bestehen aus mehreren Stämmen, die in Algerien, Mali und im Niger nomadisieren.“"
                                            },
                                            {
                                                "example_id": "cfaadaa5-3bfc-4540-aa7c-8bcabbb5c915",
                                                "sense_id": "25726cc0-d693-38f7-9d66-79d3f91f6717",
                                                "text": "„Gar erst in Amerika, wo die Leute ohne Unterlaß ihren Aufenthalt ändern und sozusagen nomadisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd0933f9-b6b9-3c8c-a406-7ee37dceb892",
                                        "entry_id": "988b152f-2c0d-3743-ab3d-369f1a2eae8a",
                                        "glosses": [
                                            "jemanden nomadisch machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9af0955-25e6-495e-b881-a2980cdfa159",
                                                "sense_id": "bd0933f9-b6b9-3c8c-a406-7ee37dceb892",
                                                "text": "„Teile von ihnen gingen im Chinesentum auf, andere gerieten wenigstens als Randvölker in den Sog der chinesischen Kultur, wieder andere Teile wurden nomadisiert […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6c59bb0-adcc-47cb-8e02-80c0b4fa18ee",
                        "source_entry_id": "d6edf707-1a68-37fd-9455-b361d1cdd992",
                        "source_sense_description": "переходить, переезжать с места на место со своим жильём и имуществом",
                        "target_lang_word": "umherziehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umherziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f23f8be8-7744-39e5-8952-ef3c81ea19f0",
                                        "entry_id": "d6c0da7b-4989-365b-8d27-6ad05a0e396f",
                                        "glosses": [
                                            "ohne zur Ruhe kommend, von einem Ort zum nächsten ziehen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a49b94d-299e-4ad4-9467-2de2a4518bbf",
                                                "sense_id": "f23f8be8-7744-39e5-8952-ef3c81ea19f0",
                                                "text": "„Die Troubadours waren Hofdichter, Fürsten selbst oder meist Herren und Bürger, die an den Höfen umherzogen und ihre meist der Liebe gewidmeten Lieder oft ertönen ließen, denen wie bei den Arabern mit Geschenken belohnt wurde.“"
                                            },
                                            {
                                                "example_id": "b55f3825-624e-45e6-a09a-8dc1937e568e",
                                                "sense_id": "f23f8be8-7744-39e5-8952-ef3c81ea19f0",
                                                "text": "„Er zog umher und stiftete Klöster, denen er tüchtige Vorsteher gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e16d2f2-b08f-4501-a9b0-479b561cf7c7",
                        "source_entry_id": "d6edf707-1a68-37fd-9455-b361d1cdd992",
                        "source_sense_description": "переходить, переезжать с места на место со своим жильём и имуществом",
                        "target_lang_word": "errer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "errer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33950948-cfcc-3a73-b9b5-febfdf4530d9",
                                        "entry_id": "7945167d-fd9a-3800-a5f6-ef0f4cfc2830",
                                        "glosses": [
                                            "Vaguer de côté et d’autre ; aller çà et là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06048130-504f-4728-b9a0-b96893f5a967",
                                                "sense_id": "33950948-cfcc-3a73-b9b5-febfdf4530d9",
                                                "text": "Combien de temps encore errèrent-ils ainsi, ballottés sur ces eaux furieuses?"
                                            },
                                            {
                                                "example_id": "2f554dc1-aafa-412b-9aa6-5fe035f0af61",
                                                "sense_id": "33950948-cfcc-3a73-b9b5-febfdf4530d9",
                                                "text": "Pour la première fois je vis ici, dans le Koutei, des karbaux (bœufs) qui paissaient dans les champs ainsi que des troupeaux de porcs qui erraient partout."
                                            },
                                            {
                                                "example_id": "601c6ce7-d507-48d6-8404-5263fcaf956b",
                                                "sense_id": "33950948-cfcc-3a73-b9b5-febfdf4530d9",
                                                "text": "Je lui dis de me retrouver chez Prévost dès qu’elle serait libre et tuai le temps jusqu’à ce moment-là, errant comme un chien perdu à travers le labyrinthe de ces quartiers morts de Saint-Michel et de Sainte-Croix."
                                            },
                                            {
                                                "example_id": "aa0ee1a9-7052-48c1-8479-d1399c8850db",
                                                "sense_id": "33950948-cfcc-3a73-b9b5-febfdf4530d9",
                                                "text": "Plutôt que de jouir d'un au-delà béni, l'organe serait aussitôt jeté en pâture à Âmmout, une bête hideuse, dévoreuse de morts. Incapable de ressusciter, l'âme du défunt errerait sans repos sur la Terre, perdue à jamais."
                                            },
                                            {
                                                "example_id": "fe0bdac3-542c-4aac-9e27-e172fdf48964",
                                                "sense_id": "33950948-cfcc-3a73-b9b5-febfdf4530d9",
                                                "text": "— Henri posa son porte-plume sur la table et ses regards errèrent au hasard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                        "entry_id": "7945167d-fd9a-3800-a5f6-ef0f4cfc2830",
                                        "glosses": [
                                            "Se tromper ; avoir une fausse opinion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7610e15-16b1-43b2-b4bc-5fc0bc683934",
                                                "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                                "text": "Il n’y a personne qui ne puisse errer, qui ne soit sujet à errer."
                                            },
                                            {
                                                "example_id": "146d2ca1-dd78-4c5f-8c6b-fe6d50302755",
                                                "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                                "text": "Vous errez dans votre calcul. — Errer dans les principes. Redresser ceux qui errent."
                                            },
                                            {
                                                "example_id": "05569cd5-d3fb-4249-9f60-8b5a340f0f49",
                                                "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                                "text": "M. Georges Gaudion, on en peut juger par cette citation, n’est pas encore tout à fait maître des mots et la nécessité du rythme l’induit à ne pas respecter toujours la syntaxe : en quoi il erre gravement."
                                            },
                                            {
                                                "example_id": "d25bbdcc-333b-4783-8f10-279af6628d31",
                                                "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                                "text": "Il péchait en esprit ; il errait en matière de foi avec une précocité surprenante ; à l’âge où l’on n’a pas encore d’idées, il abondait en idées fausses."
                                            },
                                            {
                                                "example_id": "73b7ee56-c40d-42cd-a734-c837b6140fde",
                                                "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                                "text": "Si je me trompe, laissez-moi errer."
                                            },
                                            {
                                                "example_id": "47d08942-4bed-49bc-9fd6-0de5ef3801b2",
                                                "sense_id": "81b56021-2334-3471-887c-b6a0d61100e7",
                                                "text": "« L’Écriture ne peut errer. Tu crois. Tu es sauvé. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
