                                "example_id": "14fa544b-6d01-435d-81f8-fc53e4b6453d",
                                "sense_id": "7e476530-a75a-3ee9-9c1f-1399071cd180",
                                "text": "„Profiautoren wissen dagegen, dass man Texte nur veredeln kann, indem man etwas weglässt.“"
                            },
                            {
                                "example_id": "b8180e41-fd24-4bdb-a97f-d4e704c6d530",
                                "sense_id": "7e476530-a75a-3ee9-9c1f-1399071cd180",
                                "text": "„Die Wegberger Siebenschreiber beschäftigen sich mit dem literarischen Genre und lassen sich von Profiautor Ulrich Land aus Freiburg beraten.“"
                            },
                            {
                                "example_id": "cad92981-6f4f-4af4-adf6-332a20d0bd52",
                                "sense_id": "7e476530-a75a-3ee9-9c1f-1399071cd180",
                                "text": "„Das Studium brach er ab, da er Profiautor werden wollte.“"
                            }
                        ],
