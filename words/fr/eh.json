                    "frequency": "Middle",
                    "semantic_group_id": "interpellation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Eh</w> ! Regarde où tu marches, tu as failli faire tomber cette pile d'assiettes !"
