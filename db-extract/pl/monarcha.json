                ],
                "senses": [
                    {
                        "sense_id": "64325511-6a19-3bef-92eb-79c66278eebf",
                        "entry_id": "f662d782-fdc9-3439-a5d5-89a78eeacf5f",
                        "glosses": [
                            "osoba, która rządzi krajem o ustroju nierepublikańskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ad821b-b2f9-4f31-9e6e-7333be0d9f1c",
                                "sense_id": "64325511-6a19-3bef-92eb-79c66278eebf",
                                "text": "Podobnie jak w przypadku pozostałych monarchów (z wyjątkiem grobu Kazimierza Wielkiego), nagrobek stanowi swojego rodzaju kenotafium – ciało Kazimierza Jagiellończyka, nie spoczywa we wnętrzu tumby, ale pochowane jest pod posadzką kaplicy."
                            },
                            {
                                "example_id": "bf08d9e6-84b3-4e71-b58f-a48b3ced2a42",
                                "sense_id": "64325511-6a19-3bef-92eb-79c66278eebf",
                                "text": "Surowy odwet ze strony monarchy stłumił zamiary ludowego buntu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dc5af91-60e1-4e9f-afa1-55867ddd683c",
                        "source_entry_id": "f662d782-fdc9-3439-a5d5-89a78eeacf5f",
                        "source_sense_id": "64325511-6a19-3bef-92eb-79c66278eebf",
                        "target_lang_word": "monarch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5cb75ad-0010-3c02-a94c-0770b6ea0ef1",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "The ruler of an absolute monarchy or the head of state of a constitutional monarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ee79e8-ad8d-4eca-9c85-23ef7a1da1c8",
                                                "sense_id": "c5cb75ad-0010-3c02-a94c-0770b6ea0ef1",
                                                "text": "Never was monarch better fear'd and lov'd / Than is your Majesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "864de590-2267-30c2-9a9e-9490d32d0506",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "A monarch butterfly (Danaus plexippus) and others of genus Danaus, found primarily in North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca79651-30c6-4312-a01a-8e704057766d",
                                                "sense_id": "864de590-2267-30c2-9a9e-9490d32d0506",
                                                "text": "But I know the monarchs are close by, their orange-and-black wings folded, dusted, and baked by heat, ready to flee south."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff3d8576-3a92-3cd1-843f-e743452bbbb7",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "A police officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45112110-c49e-4d61-8003-9ee2117fc7c7",
                                                "sense_id": "ff3d8576-3a92-3cd1-843f-e743452bbbb7",
                                                "text": "‘Skippy gets off. An ya know the first thing e says to them monarch? E turns round on em an yelps, “An now ya can just gimme back that bottle.”’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838225a8-c0ca-356e-a3f3-b08ed6e57e42",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "A stag which has sixteen or more points or tines on its antlers."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e67987a1-dcc8-30c9-8888-8181c99eb013",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "The chief or best thing of its kind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e15084c-495c-3786-b77f-e08cc2d046f3",
                                        "entry_id": "d13cd7ea-df8c-309c-a732-54974657a09c",
                                        "glosses": [
                                            "Any bird of the family Monarchidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b27e81-e7ba-4087-bb2b-c3afd6578dd5",
                        "source_entry_id": "f662d782-fdc9-3439-a5d5-89a78eeacf5f",
                        "source_sense_id": "64325511-6a19-3bef-92eb-79c66278eebf",
                        "target_lang_word": "monarque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6c1b6f7-de65-3b44-9e7a-670b2970bf1c",
                                        "entry_id": "a4c9b5a3-201b-3024-ae38-d25805bdb79c",
                                        "glosses": [
                                            "Chef d’une monarchie, qui règne seul dans un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6964070b-6d92-4550-82a7-4556e6be94b8",
                                                "sense_id": "d6c1b6f7-de65-3b44-9e7a-670b2970bf1c",
                                                "text": "Nous n’avons pas de monarque, une figure importante à laquelle est attachée la nation, a expliqué la jeune Vénézuélienne."
                                            },
                                            {
                                                "example_id": "6c1e2a30-8620-46e8-ab7c-477a00b8009b",
                                                "sense_id": "d6c1b6f7-de65-3b44-9e7a-670b2970bf1c",
                                                "text": "Le roi, la reine et la princesse se levèrent en poussant un cri d’horreur. Le monarque allongea à l’insolent commissionnaire un grand coup de pied qui l’envoya cogner de la tête un domestique."
                                            },
                                            {
                                                "example_id": "055037b5-2687-494d-9c50-f867064ad8b5",
                                                "sense_id": "d6c1b6f7-de65-3b44-9e7a-670b2970bf1c",
                                                "text": "Ils le mirent au courant de leur projet de rébellion contre le monarque pour venger la mort de leur père et l’incitèrent à y participer aussi."
                                            },
                                            {
                                                "example_id": "d0089c0f-2edf-43b0-9982-6033682c7eba",
                                                "sense_id": "d6c1b6f7-de65-3b44-9e7a-670b2970bf1c",
                                                "text": "Depuis qu’elle a connu des problèmes de santé à l’automne, qui ont entraîné une nuit d’hospitalisation consécutive à des examens dont la nature n’a jamais été précisée, les apparitions publiques de la monarque sont rares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb911d97-d9a5-3281-a318-5a57a8f81f06",
                                        "entry_id": "a4c9b5a3-201b-3024-ae38-d25805bdb79c",
                                        "glosses": [
                                            "(sens étroit) Synonyme de grand monarque (papillon)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86867d26-555f-4f09-abab-affea427318f",
                                                "sense_id": "bb911d97-d9a5-3281-a318-5a57a8f81f06",
                                                "text": "C’est sans doute l’un des spectacles les plus fascinants de la nature : des nuées de papillons monarques (Danaus plexippus), orange et noir, qui s’envolent dans les rayons du soleil tandis qu’une multitude d’autres se serrent en rangs bien alignés sur les branches des sapins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5195172c-df76-3430-a710-15e696f460e2",
                                        "entry_id": "a4c9b5a3-201b-3024-ae38-d25805bdb79c",
                                        "glosses": [
                                            "(sens large) Synonyme de danaïné (papillon)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
