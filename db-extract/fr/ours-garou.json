                    {
                        "sense_id": "53ab9565-0060-3ddb-bf30-4931e282404f",
                        "entry_id": "473b5946-6a0e-3ae1-a7c1-674b52697aaf",
                        "glosses": [
                            "Celui qui se transforme d’un être humain en un ours et vice versa, de façon complète ou partielle."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "dd016c21-ffd6-4eb2-ba93-8190a57f1ab4",
                                "sense_id": "53ab9565-0060-3ddb-bf30-4931e282404f",
                                "text": "[…] c’était peut-être un loup-garou; si un ours se précipitait dans la salle des banquets et attrapait un gâteau au miel, c’était sûrement un ours-garou."
                            },
                            {
                                "example_id": "dc806098-e75a-4a80-abb2-c52a98ddc773",
                                "sense_id": "53ab9565-0060-3ddb-bf30-4931e282404f",
                                "text": "Quelques légendes semblent avoir disparu comme celle des lutins de maison ou celle de l’ours-garou, légendes qui existaient au XIXᵉ siècle en Acadie."
                            }
                        ]
                    }
                ],
