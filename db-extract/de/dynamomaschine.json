                        "source_sense_id": "96d7c593-380e-3eeb-982a-49211a884cf8",
                        "source_sense_description": "Elektrotechnik: Maschine zur Erzeugung von elektrischem Strom aus mechanischer Energie",
                        "target_lang_word": "dynamo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f5660d6-b6e6-3aa1-a285-15c1d3760cc2",
                                        "entry_id": "180c0171-100b-35b2-b4ef-2f3a607b3246",
                                        "glosses": [
                                            "An electricity generator; a dynamo-electric machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df2fa16-f01d-4850-9a63-b99d0b1e5b25",
                                                "sense_id": "2f5660d6-b6e6-3aa1-a285-15c1d3760cc2",
                                                "text": "\"As usual, it isn't telling the truth about it or you. But your body is. I can feel its vitality like the pulse of a dynamo.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b6e5604-e0fe-3ec3-9bba-13ae087fe626",
                                        "entry_id": "180c0171-100b-35b2-b4ef-2f3a607b3246",
                                        "glosses": [
                                            "The mechanism by which a celestial body, such as the Earth or a star, generates a magnetic field."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43e74529-9f42-35ad-9060-4ec5c901584d",
                                        "entry_id": "180c0171-100b-35b2-b4ef-2f3a607b3246",
                                        "glosses": [
                                            "An energetic person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90603ecd-d3a0-4ac1-aacf-e9cb9f8515e5",
                                                "sense_id": "43e74529-9f42-35ad-9060-4ec5c901584d",
                                                "text": "That new Vice President of Marketing is a real dynamo; sales have already gone up this quarter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d36c7409-f33f-4f78-9b33-3071769e7754",
                        "source_entry_id": "7e67e931-de41-37ce-bb90-801a2c506aa9",
                        "source_sense_id": "96d7c593-380e-3eeb-982a-49211a884cf8",
                        "source_sense_description": "Elektrotechnik: Maschine zur Erzeugung von elektrischem Strom aus mechanischer Energie",
                        "target_lang_word": "dynamo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                        "entry_id": "30cd44ee-bfb7-3d04-852a-30f29e77c65f",
                                        "glosses": [
                                            "Machine à courant continu fonctionnant en générateur électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86febea8-75cf-4c4e-b332-aa8512003dc1",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "Il fallut passer la première nuit sans feu et sans lumière. Les moteurs qui alimentaient les dynamos avaient été mis en pièces, et personne ne possédait d’allumettes ; […]."
                                            },
                                            {
                                                "example_id": "7aa53c02-827c-431d-8e0e-a6f8cb8baa65",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "La machine est commandée soit par une courroie, soit par une dynamo directement."
                                            },
                                            {
                                                "example_id": "9d803a9c-33d1-41c4-8101-a0276e329919",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "Les électro-aimants inducteurs N, S, N, S, etc., sont pourvus d'un enroulement de fil unique, dont le sens alterne de l'un à l'autre; les noyaux de ces electros sont en fer doux ou en fonte; le courant d'excitation est fourni par une petite dynamo à courant continu, du type supérieur Gramme, montée sur le même arbre que l'inducteur de l'alternateur."
                                            },
                                            {
                                                "example_id": "7557c8d1-2dfc-4ba5-ad73-259a3b21fee0",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "[…] ; l'autre par une triple dérivation aboutissant à une large plaque métallique terminée par un balai frotteur, dans le genre de ceux des collecteurs de dynamos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e29a823-83f5-3524-af35-ddea09305787",
                                        "entry_id": "30cd44ee-bfb7-3d04-852a-30f29e77c65f",
                                        "glosses": [
                                            "Petit alternateur fixé à une roue de bicyclette produisant du courant alternatif."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
