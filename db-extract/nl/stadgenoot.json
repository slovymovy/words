                            {
                                "example_id": "8888fdd6-2b63-4b03-819d-bd70ec8ed576",
                                "sense_id": "a4cd8dd2-3704-3a1a-8f1d-300ac4dd17d0",
                                "text": "Weet je, dat Vic van Vriesland je stadgenoot wordt?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ab6fce2b-17b1-3c0c-a916-4225d6a85282",
                        "entry_id": "377a7bfc-59f1-3200-8432-4ca02de9b775",
                        "glosses": [
                            "iemand die in dezelfde grote plaats is geboren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc07f9ca-293d-49cf-9d0f-1971d2e84daa",
                                "sense_id": "ab6fce2b-17b1-3c0c-a916-4225d6a85282",
                                "text": "Voor het geval u daar een vriend heeft die van plan is naar Frankfurt te gaan, zou ik het op prijs stellen als die het geld overbrengt aan de boekhandelaar Johann Froben, mijn stadgenoot, eveneens met zo min mogelijk verlies voor mij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c6906c7-fa87-4666-bb44-76fbdb6f53a3",
                        "source_entry_id": "377a7bfc-59f1-3200-8432-4ca02de9b775",
                        "source_sense_id": "ab6fce2b-17b1-3c0c-a916-4225d6a85282",
                        "source_sense_description": "iemand die in dezelfde grote plaats is geboren",
                        "target_lang_word": "Landsmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3efc9757-d838-3af3-81f2-79b2e091e8db",
                                        "entry_id": "a47f530e-57eb-3874-b132-3ddbdad4b2dd",
                                        "glosses": [
                                            "Einwohner eines Landes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683e2e71-a99e-4ae0-a9e4-cbb52ff18053",
                                                "sense_id": "3efc9757-d838-3af3-81f2-79b2e091e8db",
                                                "text": "Er war französischer Landsmann."
                                            },
                                            {
                                                "example_id": "c9518cce-834e-4cf4-ad71-639f7e1e5369",
                                                "sense_id": "3efc9757-d838-3af3-81f2-79b2e091e8db",
                                                "text": "Und was sind Sie für ein Landsmann? — Ich bin Schwabe!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                        "entry_id": "a47f530e-57eb-3874-b132-3ddbdad4b2dd",
                                        "glosses": [
                                            "Person, die aus dem gleichen Land wie der Sprechende bzw. aus einem genannten Land kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1be0fbe-084d-4e99-a127-c36a55cab044",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "Es stellte sich bald heraus, dass mein Gesprächspartner ein Landsmann war und wir auch deutsch miteinander sprechen konnten."
                                            },
                                            {
                                                "example_id": "0a8778c9-3089-49db-8860-10b6af02ff20",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Wir wurden zwar Deutschländer genannt, aber die Türken sahen uns als Landsleute, die jederzeit zurückkonnten.“"
                                            },
                                            {
                                                "example_id": "bd26a688-3368-4b39-8a14-c348271e9036",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Doch der erfahrene Reisende versteht seine Landsleute nur zu gut.“"
                                            },
                                            {
                                                "example_id": "74b80e78-7314-4345-b1c1-ee5185a5a6ca",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Bald musste ich feststellen, dass viele Landsleute dieses Mannes dessen Gesinnung teilten.“"
                                            },
                                            {
                                                "example_id": "3f6c4f82-a121-4f7d-9822-a25b61bdfb4f",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Der Gouverneur hatte mit seinen Begründungen nicht unrecht gehabt, die Mitmenschlichkeit verlangte, mich meines Landsmanns anzunehmen.“"
                                            },
                                            {
                                                "example_id": "25ebbf37-0a96-4f49-9e96-74e1e3324dcd",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„In diesem Zusammenhang fiel Claire auf, daß Hector Burch und John D. John junior ihre einzigen echten Landsleute in diesem Kreis waren, nämlich geborene Amerikaner.“."
                                            },
                                            {
                                                "example_id": "b667a8d4-ef70-4c91-b217-ca644238763e",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Dies entpuppte sich aber als schwerer als erwartet, nicht nur aufgrund meiner linguistischen Untauglichkeit, sondern weil ich ständig auf meine Landsmänner traf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "639b29e0-c1ec-4fd0-9cdd-71ff88877622",
                        "source_entry_id": "377a7bfc-59f1-3200-8432-4ca02de9b775",
