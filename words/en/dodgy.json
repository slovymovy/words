                            },
                            {
                                "target_lang_word": "стремный",
                                "target_lang_sense_clarification": "сленг: пугающий или неприятный"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий опасения своим поведением"
                            }
                        ]
                    }
                }
            ]
