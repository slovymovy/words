{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75db5749-42f5-3843-94f4-9463a0958afc",
                    "sense_definition": "A direct result, natural consequence, or secondary outcome of something else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Increased stress is often an unfortunate <w>corollary</w> of rapid career advancement.",
                            "target_lang_translations": {
                                "ru": "Повышенный стресс часто оказывается неприятным <w>следствием</w> быстрого продвижения по службе."
                            }
                        },
                        {
                            "text": "Finally getting that cracked window fixed was a pleasant <w>corollary</w> of redoing the whole storefront.",
                            "target_lang_translations": {
                                "ru": "Ремонт треснувшего окна в итоге стал приятным <w>побочным результатом</w> обновления всей витрины."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequence",
                        "byproduct",
                        "result"
                    ],
                    "antonyms": [
                        "cause",
                        "precursor"
                    ],
                    "common_phrases": [
                        "natural corollary",
                        "inevitable corollary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямой результат, естественное последствие или побочный итог чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следствие",
                                "target_lang_sense_clarification": "результат или итог чего-либо"
                            },
                            {
                                "target_lang_word": "вывод",
                                "target_lang_sense_clarification": "логический итог"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "последствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0eaef49-16f0-3027-bc6c-9523ff0f5852",
                    "sense_definition": "A proposition or truth that follows with little or no proof from one already established.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an immediate <w>corollary</w> to the primary theorem, the angles must be equal.",
                            "target_lang_translations": {
                                "ru": "В качестве прямого <w>следствия</w> из основной теоремы эти углы должны быть равны."
                            }
                        },
                        {
                            "text": "We proved the initial lemma, and the subsequent <w>corollary</w> resolved the entire problem.",
                            "target_lang_translations": {
                                "ru": "Мы доказали исходную лемму, а последующее <w>следствие</w> решило проблему целиком."
                            }
                        }
                    ],
                    "synonyms": [
                        "deduction",
                        "inference"
                    ],
                    "antonyms": [
                        "axiom",
                        "postulate"
                    ],
                    "common_phrases": [
                        "direct corollary"
                    ],
                    "target_lang_definitions": {
                        "ru": "В математике и логике: утверждение или истина, непосредственно и легко вытекающие из уже доказанного положения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следствие",
                                "target_lang_sense_clarification": "в математике и логике"
                            },
                            {
                                "target_lang_word": "королларий",
                                "target_lang_sense_clarification": "термин в математике и логике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80ca4c3a-7834-3a30-9b6c-cf6bdad240a8",
                    "sense_definition": "Something given beyond what is strictly due; an addition or surplus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bonus served as a gracious <w>corollary</w> to their contractual fee.",
                            "target_lang_translations": {
                                "ru": "Небольшая премия послужила приятным <w>дополнением</w> к их оплате по договору."
                            }
                        },
                        {
                            "text": "He offered the extra vintage wine as an unexpected <w>corollary</w> to the meal.",
                            "target_lang_translations": {
                                "ru": "Он предложил бутылку марочного вина в качестве неожиданного <w>дополнения</w> к трапезе."
                            }
                        }
                    ],
                    "synonyms": [
                        "gratuity",
                        "surplus"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage denoting an extra gift or surplus."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, даваемое сверх должного; дополнение или излишек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "прибавление сверх нормы"
                            },
                            {
                                "target_lang_word": "надбавка",
                                "target_lang_sense_clarification": "добавочная плата или бонус"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0dae3932-e84f-31a8-a04e-33db114cb22c",
                    "sense_definition": "Occurring as a natural consequence, accompaniment, or result; attendant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid expansion of the city brought many <w>corollary</w> problems in public transit.",
                            "target_lang_translations": {
                                "ru": "Стремительное расширение города породило множество <w>сопутствующих</w> проблем в общественном транспорте."
                            }
                        },
                        {
                            "text": "Researchers had to navigate multiple administrative hurdles and <w>corollary</w> review processes.",
                            "target_lang_translations": {
                                "ru": "Исследователям пришлось преодолевать многочисленные административные преграды и <w>сопутствующие</w> процедуры согласования."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequential",
                        "attendant",
                        "accompanying"
                    ],
                    "antonyms": [
                        "antecedent"
                    ],
                    "common_phrases": [
                        "corollary effect",
                        "corollary result"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникающий как естественное последствие, сопровождающий или сопутствующий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопутствующий",
                                "target_lang_sense_clarification": "сопровождающий процесс или явление"
                            },
                            {
                                "target_lang_word": "сопутствующий",
                                "target_lang_sense_clarification": "вытекающий из чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dceffec7-3a44-3617-b000-0dea5399bbdd",
                    "sense_definition": "Forming or relating to a proposition that follows logically from one already proved.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor presented a <w>corollary</w> argument derived directly from the fundamental theorem.",
                            "target_lang_translations": {
                                "ru": "Профессор представил <w>вытекающий</w> аргумент, основанный непосредственно на фундаментальной теореме."
                            }
                        },
                        {
                            "text": "Each major mathematical proof is followed by several <w>corollary</w> statements.",
                            "target_lang_translations": {
                                "ru": "За каждым крупным математическим доказательством следует несколько <w>сопутствующих</w> утверждений."
                            }
                        }
                    ],
                    "synonyms": [
                        "deducible",
                        "inferential"
                    ],
                    "antonyms": [
                        "axiomatic"
                    ],
                    "common_phrases": [
                        "corollary proposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к суждению, логически вытекающему из уже доказанного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытекающий",
                                "target_lang_sense_clarification": "логически следующий"
                            },
                            {
                                "target_lang_word": "сопутствующий",
                                "target_lang_sense_clarification": "дополнительно доказанный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}