                        "cross_references": [
                            {
                                "target_word": "Bedeutungslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26141d4d-bac3-3a40-b874-1533bfb42bff",
                                        "entry_id": "2786d3b9-a7b5-30d0-a6a4-fcbb7fd551b7",
                                        "glosses": [
                                            "Eigenschaft, keine Bedeutung/Relevanz zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
