{
    "word_family": [
        "principe",
        "principaal",
        "principieel-ethisch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4fda5017-0666-3d8c-8428-0f0b53b9892a",
                    "sense_definition": "betrekking hebbend op een principe of een vaste overtuiging",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overtuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij weigerde de opdracht uit een <w>principieel</w> bezwaar tegen de werkwijze van het bedrijf.",
                            "target_lang_translations": {
                                "en": "She refused the assignment out of a <w>principled</w> objection to the company's methods."
                            }
                        },
                        {
                            "text": "Het is voor hem een <w>principiële</w> kwestie waarover hij niet wil onderhandelen.",
                            "target_lang_translations": {
                                "en": "For him, it is a matter of <w>principle</w> about which he does not want to negotiate."
                            }
                        }
                    ],
                    "synonyms": [
                        "fundamenteel",
                        "wezenlijk"
                    ],
                    "antonyms": [
                        "onprincipieel"
                    ],
                    "common_phrases": [
                        "principiële kwestie",
                        "principieel bezwaar",
                        "principiële beslissing"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to a principle or a firm conviction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "principled",
                                "target_lang_sense_clarification": "based on moral principles"
                            },
                            {
                                "target_lang_word": "fundamental",
                                "target_lang_sense_clarification": "relating to basic principles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba15046d-ce9c-3087-b668-ae17ab8604b0",
                    "sense_definition": "de grondslag of de kern van iets betreffend",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "grondslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een <w>principieel</w> verschil tussen deze twee wetenschappelijke benaderingen.",
                            "target_lang_translations": {
                                "en": "There is a <w>fundamental</w> difference between these two scientific approaches."
                            }
                        },
                        {
                            "text": "De partij voert een <w>principieel</w> debat over de toekomst van de gezondheidszorg.",
                            "target_lang_translations": {
                                "en": "The party is conducting a <w>fundamental</w> debate about the future of healthcare."
                            }
                        }
                    ],
                    "synonyms": [
                        "basis",
                        "essentieel"
                    ],
                    "common_phrases": [
                        "principieel verschil",
                        "principieel debat"
                    ],
                    "target_lang_definitions": {
                        "en": "concerning the foundation or the core of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fundamental",
                                "target_lang_sense_clarification": "affecting the basic nature of something"
                            },
                            {
                                "target_lang_word": "basic",
                                "target_lang_sense_clarification": "relating to the core foundation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bfa263c7-5666-31e9-9659-b9f2ca9fc229",
                    "sense_definition": "op een wijze die gebaseerd is op grondbeginselen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is <w>principieel</w> tegen het gebruik van geweld in elke situatie.",
                            "target_lang_translations": {
                                "en": "He is <w>on principle</w> against the use of violence in any situation."
                            }
                        },
                        {
                            "text": "Zij weigert <w>principieel</w> om vlees te eten vanwege haar liefde voor dieren.",
                            "target_lang_translations": {
                                "en": "She refuses to eat meat <w>on principle</w> because of her love for animals."
                            }
                        }
                    ],
                    "synonyms": [
                        "fundamenteel",
                        "stelselmatig"
                    ],
                    "common_phrases": [
                        "principieel tegen",
                        "principieel weigeren"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner based on fundamental principles"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "on principle",
                                "target_lang_sense_clarification": "because of a fixed belief"
                            },
                            {
                                "target_lang_word": "fundamentally",
                                "target_lang_sense_clarification": "in a way that relates to basic principles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}