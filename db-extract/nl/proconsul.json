                        "examples": [
                            {
                                "example_id": "aefcfc3f-5f64-4ccb-aee5-918724b47585",
                                "sense_id": "6074a4e7-62e5-3273-a105-6c60a8318a84",
                                "text": "Paulus is in die tijd ook in de stad. Hij heeft ook geen gemakkelijke week, omdat hij voor de proconsul Gallio moet verschijnen in een rechtszaak die de Joden in Korinthe tegen hem hebben aangespannen. In de ontknoping van het boek speelt de apostel een beslissende rol."
                            },
                            {
                                "example_id": "78a14893-93a0-462c-8037-42d4e3e3db88",
                                "sense_id": "6074a4e7-62e5-3273-a105-6c60a8318a84",
                                "text": "Als onderdeel van het verhaal noemt Lukas bijna terloops allerlei plaatsen en personen, met verschillende titels zoals stadhouder of proconsul (Hand 13:7), hoofden (leiders) van de synagoge (13:15), oversten (bestuurders) en hoofdmannen (magistraten; 16:19-20)."
                            }
                        ]
