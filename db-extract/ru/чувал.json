                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "bf6084f1-e766-4623-890d-750e8c1b0415",
                                "sense_id": "8a948362-f044-37b3-a298-671acd911506",
                                "text": "Он стоя́л во́зле лежа́нки, заложи́в ру́ки за́ спину, широкопле́чий, большеголо́вый и пло́тный, как чува́л с зерно́м.",
                                "translation": "He stood by the sleeping ledge, his hands behind his back, wide-shouldered, big-headed, and solid as a gunny sack of grain.",
                                "english": "He stood by the sleeping ledge, his hands behind his back, wide-shouldered, big-headed, and solid as a gunny sack of grain."
                            }
                        ]
