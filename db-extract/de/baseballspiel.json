                "senses": [
                    {
                        "sense_id": "d1a1131d-8e09-3675-9fba-6ab9576dbd6b",
                        "entry_id": "a4c98efd-d8c9-38d7-b417-6511de91cfb4",
                        "glosses": [
                            "einzelner Wettkampf zwischen zwei Mannschaften im Baseball"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c53fd6-34f3-4a03-a8ae-803ef4fff228",
                                "sense_id": "d1a1131d-8e09-3675-9fba-6ab9576dbd6b",
                                "text": "„Ein Baseballspiel dauert für gewöhnlich neun Innings, und genau so lange hatte Trisl auch erfolgreich mitgehalten gegen den Bonner Kontrahenten namens Markus Solbach, den viele für den besten deutschen Pitcher halten.“"
                            },
                            {
                                "example_id": "aad80e1d-d9d2-47ce-a8b3-b96567366b0d",
                                "sense_id": "d1a1131d-8e09-3675-9fba-6ab9576dbd6b",
                                "text": "„Die Frauen hatten ihre Mahjong-Runden, die Männer spielten in der Küche Binokel und alberten herum, und im Sommer veranstalteten die Familien gemeinsame Picknicks in der South Mountains Reservation; dort spielte man Softball, warf Hufeisen und hörte sich in einem »knisternden, rauschenden Kofferradio, das jemand mitgebracht hatte«, ein Baseballspiel an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
