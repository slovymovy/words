                "senses": [
                    {
                        "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                        "entry_id": "08643415-be24-39ca-9a41-bf843469a455",
                        "glosses": [
                            "Wasser, das ein Fluss mit sich führt, das er enthält oder das aus ihm stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b1bd6e-7fe6-49c3-b929-5e2bc62a75e0",
                                "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                "text": "Flusswasser wird häufig zur Trinkwassergewinnung benutzt."
                            },
                            {
                                "example_id": "06dc0ab2-65e9-434f-a1aa-1c50e9cf6d59",
                                "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                "text": "„Im Grand Canyon hat sich Flusswasser durch 1,6 km starkes Gestein seinen Weg nach unten gebahnt - der tiefste Einschnitt, der auf der Welt sichtbar ist.“"
                            },
                            {
                                "example_id": "45cb0b4b-956a-4c24-8fef-2b66629909d2",
                                "sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                                "text": "„So ist das Flusswasser in den letzten Jahrzehnten zu einer umkämpften Ressource geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c92bd1b1-3dbf-4447-953e-4823dafd08c5",
                        "source_entry_id": "08643415-be24-39ca-9a41-bf843469a455",
                        "source_sense_id": "9172b4b1-1861-3e3b-9f06-e00cc746b55f",
                        "source_sense_description": "Wasser, das ein Fluss mit sich führt, das er enthält oder das aus ihm stammt",
                        "target_lang_word": "river water",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "river water",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                        "entry_id": "c97338b0-2037-349a-94ba-228a3a569d3b",
                                        "glosses": [
                                            "Water found in or taken from a river."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a597fe8-96e2-4877-8714-ae6a56f179d4",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "They can be changed in various ways; for instance, river water is more turbid than that of lakes, since rivers drain water from the land, ..."
                                            },
                                            {
                                                "example_id": "9301577d-e053-45b1-90ce-9f6843de8acd",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "All these five directly use Pavana River, thus river water quality is very important for them."
                                            },
                                            {
                                                "example_id": "16dcf443-23b5-407e-a54a-7c4516dcbdca",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "River waters are used as drinking water and irrigation water for agricultural fields."
                                            },
                                            {
                                                "example_id": "19e5a17d-d16c-4761-b543-0ac65b1ded7b",
                                                "sense_id": "50c9e593-f76d-356e-b951-ad163dfaa68b",
                                                "text": "Bad weather, therefore, cannot disrupt the metronomic existence of its regular users, but river water does come in, both from the Thames and its tributary the Walbrook. [...] This may be why the line is nicknamed 'The Drain', [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
