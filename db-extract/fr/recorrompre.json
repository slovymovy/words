                ],
                "senses": [
                    {
                        "sense_id": "a6336796-846e-31c6-97b7-e467a10e1680",
                        "entry_id": "846713fa-9433-3bf7-b4cb-3ed6bab05216",
                        "glosses": [
                            "Séduire, débaucher de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ec4c94-614e-4950-a44e-2ec8f613cac9",
                                "sense_id": "a6336796-846e-31c6-97b7-e467a10e1680",
                                "text": "Comment pouvez-vous vous laisser recorrompre par un homme qui vous a trahi autrefois ?"
                            },
                            {
                                "example_id": "801042f7-e7b0-427a-bb44-e2ad38da7e2f",
                                "sense_id": "a6336796-846e-31c6-97b7-e467a10e1680",
                                "text": "Yaura toujours moyen de les recorrompre après, une fois qu'on aura mieux cerné leurs goûts."
                            },
                            {
                                "example_id": "72b3ef5c-b805-493e-957e-ff0dcf3ab3a3",
                                "sense_id": "a6336796-846e-31c6-97b7-e467a10e1680",
                                "text": "Non, surtout pas, mon G5 est en train de me recorrompre de nouveau aux jeux d'ordis, il ne faudrait surtout pas que j'aie accès à tous les jeux PC!"
                            }
                        ]
                    },
                    {
                        "sense_id": "b369f4e8-0dff-3f9c-b92d-51564141dd34",
                        "entry_id": "846713fa-9433-3bf7-b4cb-3ed6bab05216",
                        "glosses": [
                            "Changer en mal une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da0cb41-8b29-4b6d-9bad-636dd6f49adf",
                                "sense_id": "b369f4e8-0dff-3f9c-b92d-51564141dd34",
                                "text": "Il est dangereux de lire une carte mémoire sur une autre console que celle de départ, car vous risquez à chaque fois de recorrompre définitivement les fichiers."
                            },
                            {
                                "example_id": "c52b8b1a-22e4-4a42-92de-99963f50b06c",
                                "sense_id": "b369f4e8-0dff-3f9c-b92d-51564141dd34",
                                "text": "De plus en faisant ça, ça doit recorrompre la FAT et le PVR essaiera encore de réparer derrière ou en tout cas risque d'afficher un message d'erreur de corruption quelconque."
                            }
                        ]
                    }
                ],
