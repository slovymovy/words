                        "entry_id": "61d63d8e-c2cf-32ab-9f9f-a00716ae2690",
                        "glosses": [
                            "Doctrine politique ou idéologie qui s'oppose au communisme."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "7dad9554-61b9-4198-a402-960c6750dc66",
                                "sense_id": "b1b1af5b-01be-335a-9946-3e7d61be9ada",
                                "text": "A tout seigneur tout honneur, commençons par citer Sartre. Lui du moins n'est pas soupçonnable d’anticommunisme primaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4acb794-0edc-42bb-ad56-454036c72d3f",
                        "source_entry_id": "61d63d8e-c2cf-32ab-9f9f-a00716ae2690",
                        "source_sense_id": "b1b1af5b-01be-335a-9946-3e7d61be9ada",
