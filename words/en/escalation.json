                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>escalation</w> in prices caused many families to struggle with their monthly budgets."
                        },
                        {
                            "text": "Experts are worried about the rapid <w>escalation</w> of global temperatures over the last decade."
                        }
                    ],
                    "synonyms": [
                        "intensification",
                        "growth",
                        "rise"
                    ],
                    "antonyms": [
