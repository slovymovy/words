                                    {
                                        "sense_id": "4db02dd4-02e2-3aac-b614-5eda5f131f0b",
                                        "entry_id": "4cad9821-62b9-38c6-827f-76a388787025",
                                        "glosses": [
                                            "Lactarius deliciosus, an edible mushroom native to Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b35b2f7-7080-48b2-8277-688c19f113ba",
                                                "sense_id": "4db02dd4-02e2-3aac-b614-5eda5f131f0b",
                                                "text": "Saffron milk cap has brittle flesh which, when broken, exudes a saffron coloured milk which quickly turns to orange and emits an acid odour. The fungus is edible but not as delicious as its name might imply."
                                            }
                                        ]
                                    }
                                ]
                            }
