                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d6cfdf-3361-4584-812b-286c8ccedb8f",
                        "source_entry_id": "c1b98356-74b6-38a8-8ed5-99e0affa002d",
                        "source_sense_description": "cleric below a deacon",
                        "target_lang_word": "sous-diacre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-diacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb18e762-84e0-31d0-9e95-4d83b46b00d7",
                                        "entry_id": "9e2aa253-6174-39ec-b451-cee5ce3d2301",
                                        "glosses": [
                                            "Celui qui est promu au sous-diaconat, qui est au-dessous du diacre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b728b01-9753-4ca8-b741-6b277193f21f",
                                                "sense_id": "cb18e762-84e0-31d0-9e95-4d83b46b00d7",
                                                "text": "M. Chélan demanda et obtint une lettre d’invitation pour Julien qui devait l’accompagner en qualité de sous-diacre."
                                            },
                                            {
                                                "example_id": "65a8920e-83fc-4f94-9932-4a58183d5c62",
                                                "sense_id": "cb18e762-84e0-31d0-9e95-4d83b46b00d7",
                                                "text": "C’est au sous-diacre à lire, à chanter l’épître à la grand-messe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "962545c6-67b5-4857-a552-d28d30c2a84f",
                        "source_entry_id": "c1b98356-74b6-38a8-8ed5-99e0affa002d",
                        "source_sense_description": "cleric below a deacon",
                        "target_lang_word": "Subdiakon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Subdiakon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                        "entry_id": "fc5898fc-6e82-3d7d-880e-fba6eb1facc2",
                                        "glosses": [
                                            "jemand, der die erste der höheren Weihen empfangen hat und damit auf der Weihestufe unter der des Diakons steht (vom 3. Jahrhundert bis 1972)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fde8789-6c0c-4d91-b29f-53bf367ae5da",
                                                "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                                "text": "Der Subdiakon trug bei der Feier der Heiligen Messe zum Zeichen seines Amtes den Manipel."
                                            },
                                            {
                                                "example_id": "84e40226-06bb-4fce-b8a6-567b379ea45d",
                                                "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                                "text": "„3. Während der Oktav wird die Messe feierlich gehalten mit zwei Altardienern, Diakon und Subdiakon, und Weihrauch wird verwendet zur Opferung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a177b6de-bdbc-3c4d-8295-045724490b23",
                                        "entry_id": "fc5898fc-6e82-3d7d-880e-fba6eb1facc2",
                                        "glosses": [
                                            "Amtsträger einer Stufe der niederen Weihen"
                                        ],
                                        "tags": [
                                            "Ostkirchen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f474bb-c47d-4572-af6e-edc54eb37e17",
                                                "sense_id": "a177b6de-bdbc-3c4d-8295-045724490b23",
                                                "text": "„Immer wieder öffnet sich die Tür und nacheinander erscheinen Diakone, Subdiakone und mehrere Frauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
