                ],
                "senses": [
                    {
                        "sense_id": "60e14fd0-8cd7-32e3-a02a-7b99d5d371c0",
                        "entry_id": "1f637d95-37fc-38c1-8764-93801dc2a556",
                        "glosses": [
                            "das Verständnis der Welt, die Sicht auf die Dinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4e7aef-a91e-49b0-acbf-afe81c92fa74",
                                "sense_id": "60e14fd0-8cd7-32e3-a02a-7b99d5d371c0",
                                "text": "„Und schon brach ein winziger Teil meiner Weltsicht zusammen, was mir in diesem Falle nichts ausmacht, denn Kapern sind für meine Weltsicht nicht so entscheidend.“"
                            },
                            {
                                "example_id": "ccedb71d-5c10-41c8-9f4f-7cfd9fb64a1c",
                                "sense_id": "60e14fd0-8cd7-32e3-a02a-7b99d5d371c0",
                                "text": "„Unsere demokratischen Gesellschaften stützen sich in der Tat auf eine meritokratische Weltsicht oder zumindest auf eine meritokratische Hoffnung, das heißt den Glauben an eine Gesellschaft, in der Ungleichheiten auf Verdienst und Arbeit eher denn auf Herkunft und Kapitalrendite beruhen.“"
                            },
                            {
                                "example_id": "00a0376e-e7c8-4cd3-8779-d8d3b344ab41",
                                "sense_id": "60e14fd0-8cd7-32e3-a02a-7b99d5d371c0",
                                "text": "„Viele kamen enttäuscht zurück, andere mussten ihre Weltsicht stark korrigieren.“"
                            },
                            {
                                "example_id": "5d1702db-4f16-4f1b-be6b-7c1dd411d865",
                                "sense_id": "60e14fd0-8cd7-32e3-a02a-7b99d5d371c0",
                                "text": "„Mephisto kann wie Hippias sein Gegenüber in seine Weltsicht einordnen, er kann ihn »deuten«, aber nicht wirklich verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
