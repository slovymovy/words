                                        "entry_id": "bc42ab5c-c7c3-392b-8c50-5b09487e1f1a",
                                        "glosses": [
                                            "A woman, wife; especially a Native American woman."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fb35ee-d18a-41a8-bf04-bea5176aa374",
                                                "sense_id": "d31f6219-c61c-30cc-bb78-67e577e88e30",
                                                "text": "The Indian maids, of course, turned out to be a few fat old squaws who knew all about white men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
