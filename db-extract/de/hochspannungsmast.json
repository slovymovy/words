                "senses": [
                    {
                        "sense_id": "94b91127-8fe9-3520-bba3-15a46b8c7ddb",
                        "entry_id": "bc494f56-266a-3147-a69a-179b0618a731",
                        "glosses": [
                            "Mast für Hochspannungsleitungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552601cf-b846-4317-9948-1fd3b4ff75c5",
                                "sense_id": "94b91127-8fe9-3520-bba3-15a46b8c7ddb",
                                "text": "„Nach erfolglosen Versuchen, Hochspannungsmasten zu zerstören, ermordeten sie einen weißen Farmer und dessen Frau – in Mugabes Worten «eine ruhmreiche Schlacht», die eine symbolische Verbindung zwischen dem Ersten und Zweiten Chimurenga herstellte.“"
                            },
                            {
                                "example_id": "15d4276e-0b67-47da-8036-90b740b7f1fe",
                                "sense_id": "94b91127-8fe9-3520-bba3-15a46b8c7ddb",
                                "text": "„Durch den Hintergrund des Bildes stelzen Hochspannungsmasten, vorn aber beherrscht Ginster den Anblick.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
