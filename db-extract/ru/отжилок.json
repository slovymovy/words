                                        "glosses": [
                                            "Petite branche d’arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03865d76-ccc9-47a3-9985-6d24019855a4",
                                                "sense_id": "c0f2eb2a-6ad6-361c-90b3-034fe1c4dc05",
                                                "text": "On cultive le loganberry comme le framboisier, en lui laissant, toutefois, plus d'espace : le loganberry a une végétation exubérante, et ses rameaux, ont souvent quatre à cinq mètres de longueur."
                                            },
                                            {
                                                "example_id": "9dc43215-e203-4c63-9117-93ca53383528",
                                                "sense_id": "c0f2eb2a-6ad6-361c-90b3-034fe1c4dc05",
                                                "text": "Un rameau d’olivier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756076c5-2146-33f4-bda9-a3dc01ba8314",
                                        "entry_id": "38e9baa7-ee4c-38ff-bae8-676477c42d62",
                                        "glosses": [
                                            "Branche, divisions des artères, des veines, des nerfs, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "126a1c57-902e-4d8b-a9bc-984b3c9b1730",
                                                "sense_id": "756076c5-2146-33f4-bda9-a3dc01ba8314",
                                                "text": "Cette veine a plusieurs rameaux."
                                            },
                                            {
                                                "example_id": "37a84059-84e7-414f-8423-81dea7b43059",
                                                "sense_id": "756076c5-2146-33f4-bda9-a3dc01ba8314",
                                                "text": "Cette artère, ce nerf se partage en plusieurs rameaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "252b4a8b-cb0f-3e82-b447-4333967485d6",
                                        "entry_id": "38e9baa7-ee4c-38ff-bae8-676477c42d62",
                                        "glosses": [
                                            "Branche d’une mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1af7bf-df1b-4256-8597-3a2822a8f041",
                                                "sense_id": "252b4a8b-cb0f-3e82-b447-4333967485d6",
                                                "text": "Une mine qui a plusieurs rameaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c28ed8b-924c-30c9-9024-c50ccb0a1d69",
