                    {
                        "sense_id": "12794151-7ce7-3ed2-8d88-e29873d83fb4",
                        "entry_id": "72e618f5-afd8-3330-8538-96d24dfb8bd0",
                        "glosses": [
                            "État de la matière qui apparaît à très basses températures et qui se manifeste par une résistance nulle au passage d’un liquide à l’intérieur de son réseau cristallin."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "13be7520-2671-41e0-a205-863dd35a4a3e",
                                "sense_id": "12794151-7ce7-3ed2-8d88-e29873d83fb4",
                                "text": "Parmi les propriétés remarquables des solides quantiques discutées dans le passé, la possibilité d’une population finie de lacunes à température nulle a été envisagée. En formant un condensat de Bose dans le solide, ces lacunes conféreraient des propriétés remarquables au solide, appelée « supersolidité »."
                            }
                        ]
                    }
                ],
