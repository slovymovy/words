                ],
                "senses": [
                    {
                        "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                        "entry_id": "571f022e-f689-38a6-ad68-b0932667fc3d",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de7ae95-e550-4dfa-966a-d43c021c94d7",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Trumpps kamen, sahen und siegten."
                            },
                            {
                                "example_id": "8d06299d-9b9d-436f-9e96-f91e56ed9d3b",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Trumpp kommt und geht."
                            },
                            {
                                "example_id": "11e5f781-820b-4e4d-9519-a99cf11baa87",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Trumpp kommt, geht der Herr Trumpp.“"
                            },
                            {
                                "example_id": "c569d6fb-67f8-44f1-9f9b-48f778435c1e",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Frau Trumpp ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "298a6d62-e0c5-4de8-8816-3aa7fd2b67ce",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Herr Trumpp wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "48f4ebe9-4e2b-4c93-9c02-a63846fdd4d0",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Die Trumpps fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fff9b5c7-2645-4962-8036-3b1c06799f88",
                                "sense_id": "6f92bf2a-e495-3cff-b046-fcb691a17d1e",
                                "text": "Der Trumpp trägt nie die Schals, die die Trumpp ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
