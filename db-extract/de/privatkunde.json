                        "source_entry_id": "a478b11d-4804-3a15-a88a-a3c739853cbf",
                        "source_sense_id": "c3ec702b-686c-3261-8d1e-70d19ee28bc9",
                        "source_sense_description": "einzelne Person(en) (Privatpersonen) - im Gegensatz zu Firmen oder Institutionen - als Kunde",
                        "target_lang_word": "private customer",
