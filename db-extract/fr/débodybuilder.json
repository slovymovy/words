                "senses": [
                    {
                        "sense_id": "b745a72e-6f61-3b60-9ed1-3f78b8d8bcbd",
                        "entry_id": "9ded3789-9bed-34b3-a4bc-d39c6abcdc22",
                        "glosses": [
                            "Faire perdre son caractère bodybuildé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00bd9bd4-c5bb-47b2-b31c-7420d742f801",
                                "sense_id": "b745a72e-6f61-3b60-9ed1-3f78b8d8bcbd",
                                "text": "Faut-il aller jusqu’à gonfler les muscles défaillants et dégonfler les excessifs, \"bodybuilder\" les uns et \"débodybuilder\" les autres pour construire le « corps » qu’il faut ?"
                            },
                            {
                                "example_id": "331e28d5-ecac-49ae-ae84-b6ac55e624e5",
                                "sense_id": "b745a72e-6f61-3b60-9ed1-3f78b8d8bcbd",
                                "text": "Ce livre est l’occasion de découvrir un autre John Rambo, débodybuildé, sensible, mais néanmoins forgé par la grande verte et le Vietnam pour devenir une machine à tuer."
                            },
                            {
                                "example_id": "fd27fd4a-b4c2-41d7-b806-5452eb1862f5",
                                "sense_id": "b745a72e-6f61-3b60-9ed1-3f78b8d8bcbd",
                                "text": "On attendra donc que la version civile \"débodybuildée\" sorte pour voir les dimensions finales."
                            }
                        ]
                    }
