                        "sense_id": "bf46e77e-8e7f-3c7f-a6e4-dc7ace0f3deb",
                        "entry_id": "12de1d56-fe04-3d75-be9d-3d2b5a05220f",
                        "glosses": [
                            "Why ever: an emphatic form of why."
                        ],
                        "tags": [
                            "interrogative",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4789cb26-b9ef-4725-a95f-c92576bb188c",
                                "sense_id": "bf46e77e-8e7f-3c7f-a6e4-dc7ace0f3deb",
                                "text": "Whyever would someone do that?"
                            }
                        ]
                    },
                    {
                        "sense_id": "aa5cfd2c-f036-3122-8f60-b6ae31f474fc",
                        "entry_id": "12de1d56-fe04-3d75-be9d-3d2b5a05220f",
                        "glosses": [
                            "For whatever reason."
                        ],
                        "tags": [
                            "not-comparable",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "adb85cc8-9dc7-48df-8319-124a1a95105b",
                                "sense_id": "aa5cfd2c-f036-3122-8f60-b6ae31f474fc",
                                "text": "You can use it whenever you want and whyever you want."
                            },
                            {
                                "example_id": "b9910383-015a-402f-9df8-af1b88249a5b",
                                "sense_id": "aa5cfd2c-f036-3122-8f60-b6ae31f474fc",
                                "text": "Whatever we do, and whyever we do it, does not every motive originate in self, and does not every act proceed out of the individual's instinct for self-fulfilment ?"
                            },
                            {
                                "example_id": "31f4b314-fcd1-42c9-b173-dea360d5b7d5",
                                "sense_id": "aa5cfd2c-f036-3122-8f60-b6ae31f474fc",
                                "text": "Whyever they began, there was no perceptible wolf at their door."
                            },
                            {
                                "example_id": "adb4c33c-bfaf-4792-95da-e85b24e878e4",
                                "sense_id": "aa5cfd2c-f036-3122-8f60-b6ae31f474fc",
                                "text": "\"And whyever they were doing it, they were the ones responsible for what happened to her and all of the rest of my friends in the first place.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5e184ac0-1184-3a35-82f7-58a20a563c0d",
                        "entry_id": "12de1d56-fe04-3d75-be9d-3d2b5a05220f",
                        "glosses": [
                            "Regardless of the reason (why)."
                        ],
                        "tags": [
                            "not-comparable",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "c4a0281f-7021-4dda-afd3-60cf5a518d08",
                                "sense_id": "5e184ac0-1184-3a35-82f7-58a20a563c0d",
                                "text": "I don't care what you want. Whyever you're here, please go away."
                            }
                        ]
                    }
                ],
