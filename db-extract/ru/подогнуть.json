                    {
                        "sense_id": "409aad83-44be-3e09-ab52-d8d477276ad5",
                        "entry_id": "1bf52c8a-569a-3cfd-a253-b04940898b56",
                        "glosses": [
                            "слегка согнуть (ноги в коленях)"
