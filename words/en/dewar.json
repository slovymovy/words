        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce2969b7-b442-3004-9dbd-73c95ef11fe3",
                    "sense_definition": "A double-walled container with a vacuum between the walls used to maintain the temperature of its contents, especially for scientific or cryogenic purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vacuum_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory technician carefully poured the liquid nitrogen into the large <w>dewar</w> to keep it stable.",
                            "target_lang_translations": {
                                "ru": "Лаборант осторожно перелил жидкий азот в большой <w>сосуд Дьюара</w>, чтобы сохранить его стабильность."
                            }
                        },
                        {
                            "text": "A large thermos-like container called a <w>dewar</w> contained 645 gallons of liquid helium to be cooled.",
                            "target_lang_translations": {
                                "ru": "Большой похожий на термос контейнер, называемый <w>сосудом Дьюара</w>, содержал 645 галлонов жидкого гелия для охлаждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "Dewar flask",
                        "Dewar vessel",
                        "vacuum flask"
                    ],
                    "common_phrases": [
                        "liquid nitrogen dewar",
                        "cryogenic dewar"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд с двойными стенками и вакуумом между ними, предназначенный для теплоизоляции содержимого, особенно в научных или криогенных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосуд Дьюара",
                                "target_lang_sense_clarification": "научный термин"
                            },
                            {
                                "target_lang_word": "дьюар",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ]
                    }
                }
            ]
        },
