                "senses": [
                    {
                        "sense_id": "7bffd52c-4602-3fa3-99f8-39e49303e1b1",
                        "entry_id": "399103d1-78ef-334b-95c0-12410490ab21",
                        "glosses": [
                            "Fischer, der riesige Mengen Fisch fängt, meistens mit krassen Methoden und zur Fischmehlherstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed661712-6b1b-4f00-ace9-b1f1ffc35ea0",
                                "sense_id": "7bffd52c-4602-3fa3-99f8-39e49303e1b1",
                                "text": "„ Die so genannten Gammelfischer fangen Sandaale, Stintdorsche und Sprotten in riesigen Mengen für die Verarbeitung zu Fischmehl und Fischöl.“"
                            },
                            {
                                "example_id": "a5baf7a0-5de6-43a4-b5ca-0b101d394003",
                                "sense_id": "7bffd52c-4602-3fa3-99f8-39e49303e1b1",
                                "text": "„[…] Außerdem sind die Maschen der vor allem dänischen Gammelfischer so klein, dass nicht einmal die jungen Speisefische entkommen.“"
                            },
                            {
                                "example_id": "348db68a-59e7-476e-89a3-f27d0380f1e5",
                                "sense_id": "7bffd52c-4602-3fa3-99f8-39e49303e1b1",
                                "text": "„Mit großem persönlichen Einsatz versuchen Greenpeace-Aktivisten, dänische Gammelfischer aufzuhalten, die vor der schottischen Nordseeküste die Fischgründe plündern.“"
                            },
                            {
                                "example_id": "4f8b5e02-8a27-4a37-8990-9d86a2a9feb2",
                                "sense_id": "7bffd52c-4602-3fa3-99f8-39e49303e1b1",
                                "text": "„[…] Margarine- und Backwarenhersteller erklären ihren Verzicht auf Fischöl; die deutsche Fischindustrie distanziert sich von den Methoden der Gammelfischer.“"
                            },
                            {
                                "example_id": "4cc239ae-8e86-433f-a7a4-231977b2bfff",
                                "sense_id": "7bffd52c-4602-3fa3-99f8-39e49303e1b1",
                                "text": "„Gammelfischer fangen Fisch hauptsächlich zur Fischmehlherstellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
