                "senses": [
                    {
                        "sense_id": "1f491721-e436-3c2d-85df-c478c9adc165",
                        "entry_id": "152aabd8-bdce-30db-bb83-f1c2f59f4e58",
                        "glosses": [
                            "deel van een stoel of bank waartegen men de rug kan laten rusten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0de1ad-0320-4ba7-b496-4a14ec8d0717",
                                "sense_id": "1f491721-e436-3c2d-85df-c478c9adc165",
                                "text": "Een stoeltje zonder rugleuning noemt men meestal een krukje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb7ab014-bc97-4a03-9f9f-ebebc87c51dd",
                        "source_entry_id": "152aabd8-bdce-30db-bb83-f1c2f59f4e58",
                        "source_sense_id": "1f491721-e436-3c2d-85df-c478c9adc165",
                        "target_lang_word": "Rückenlehne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückenlehne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a4d1af3-0f4c-3403-ba69-69dc00e777fd",
                                        "entry_id": "ab8f6155-9385-3c7d-addb-7b9d5b940b25",
                                        "glosses": [
                                            "rückwärtige erhöhte Fläche eines Stuhles, Sessels oder von Ähnlichem, die zum Anlehnen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c9bc583-be44-41fe-9b86-61743460f71e",
                                                "sense_id": "7a4d1af3-0f4c-3403-ba69-69dc00e777fd",
                                                "text": "„Ich fand einen Sitzplatz, wo sich die Rückenlehne kippen ließ, sodass ich schlafen konnte.“"
                                            },
                                            {
                                                "example_id": "7a561460-c5c7-472d-b116-b8c396eaef7e",
                                                "sense_id": "7a4d1af3-0f4c-3403-ba69-69dc00e777fd",
                                                "text": "„Die dritte ging durch die Rückenlehne des Beifahrersitzes und machte ein Loch in die Klappe des Handschuhfachs.“"
                                            },
                                            {
                                                "example_id": "c07344a4-9249-47a6-908f-ab13138a679e",
                                                "sense_id": "7a4d1af3-0f4c-3403-ba69-69dc00e777fd",
                                                "text": "„Er hatte einen Kartentisch ins Wohnzimmer gestellt, damit sie dort essen konnten, und dazu zwei Küchenstühle, der eine aus Holz mit steifer Rückenlehne, der andre aus Stahlrohr mit Formica-Sitz und -Lehne.“"
                                            },
                                            {
                                                "example_id": "5d39f9eb-8942-4498-82d4-392d1e31ce65",
                                                "sense_id": "7a4d1af3-0f4c-3403-ba69-69dc00e777fd",
                                                "text": "„Jürgen Loose hebt den Kopf und lässt seinen Oberkörper gegen die Rückenlehne der Küchenbank fallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b3751ff-94b4-4ea0-84aa-c8c7c3a8d0d8",
                        "source_entry_id": "152aabd8-bdce-30db-bb83-f1c2f59f4e58",
                        "source_sense_id": "1f491721-e436-3c2d-85df-c478c9adc165",
                        "target_lang_word": "back rest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f9ee872d-5e46-4fff-a9d8-b3afe3325e6d",
                        "source_entry_id": "152aabd8-bdce-30db-bb83-f1c2f59f4e58",
                        "source_sense_id": "1f491721-e436-3c2d-85df-c478c9adc165",
                        "target_lang_word": "dossier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dossier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Partie d’un siège contre laquelle on pose le dos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04abe9cf-2556-47d8-855b-d02a2facca53",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Sur les crédences en style de la Renaissance se dressaient des figures de sirènes, et les chaises en bois sculpté avaient des dossiers surmontés de têtes de femmes dans le goût Henri II."
                                            },
                                            {
                                                "example_id": "cc950c09-98c9-4b18-9a72-53b38056a6e0",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Assis dans un petit fauteuil à dossier bref, papa travaillait."
                                            },
                                            {
                                                "example_id": "b8917d4a-190b-4d00-90e7-45276c12a056",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Il chevaucha une chaise, s'approcha du poêle et se croisa les bras sur le dossier."
                                            },
                                            {
                                                "example_id": "625cdba6-4f68-41a3-86f0-a8cf20cc61c0",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "[…] ; la gorge nouée, Adeline s'était mise à triturer un petit morceau de cuir qui dépassait d'un clou tapissier mal fixé au dossier du fauteuil fauve qu'elle regardait avec intensité pour détourner ses larmes."
                                            },
                                            {
                                                "example_id": "48c8167e-616f-4bc8-b8ae-8c27ffbb0800",
                                                "sense_id": "1a80c1c0-534e-3b24-a8ed-8029df13c297",
                                                "text": "Jordan pointa un doigt interrogateur sur un appareil doté d'une seringue, fixé au dossier du fauteuil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70da6ed-e9c3-3793-abbd-852bd1851c24",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Assemblage de documents regroupés dans un but déterminé. (Une liasse de papiers étiquetée au dos)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd1fc838-4101-4cfa-a896-247f1488c450",
                                                "sense_id": "c70da6ed-e9c3-3793-abbd-852bd1851c24",
                                                "text": "Concentrez-vous sur vos dossiers."
                                            },
                                            {
                                                "example_id": "79c3316e-86c8-4d48-a054-3113cc6a0470",
                                                "sense_id": "c70da6ed-e9c3-3793-abbd-852bd1851c24",
                                                "text": "« Voilà le dossier de votre père… » dit-elle en lui tendant une mince chemise. Le mot de dossier paraissait un peu exagéré: il y avait une feuille recto-verso, rédigée en suisse allemand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "331ba470-ee28-3c8d-b928-09cc7e6d90ed",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Pièces d’un procès ou d’archives."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e01edb-cc57-46b9-afab-e331d4821d70",
                                                "sense_id": "331ba470-ee28-3c8d-b928-09cc7e6d90ed",
                                                "text": "Le secours allait venir aux révisionnistes du côté où on l'attendait le moins. Une pièce du dossier secret, deux fois rendue publique, se trouva être un faux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2313f114-6a80-35c1-8256-8fa4475560a1",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Ensemble de pièces concernant telle ou telle personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecdc2ac2-38c9-4d60-b0f0-af419adb53a0",
                                                "sense_id": "2313f114-6a80-35c1-8256-8fa4475560a1",
                                                "text": "Il s'agit de se tenir à l'affut des affaires, de les suivre de près, de constituer des dossiers sur chacun des as de la finance tripatouillarde, d'étudier leurs faiblesses et même leurs vices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1b3786-83e1-3d96-ba32-c413d17bbe7c",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Répertoire, emplacement virtuel dans lequel peuvent se trouver d’autres dossiers ou des fichiers informatiques d’un système de fichier en arborescence."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cbf1f4f-bfdf-3b26-a373-fa9fa082ae99",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Anecdote embarrassante concernant une personne."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9962027-0fb7-350b-b16e-1e9c19b2a62e",
                                        "entry_id": "e15326a5-5885-3103-80e0-5ec4bbe5d132",
                                        "glosses": [
                                            "Sur un wagon couvert de chemin de fer, partie étroite de la caisse positionnée du côté des attelages, reliant le châssis au toit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
