                    {
                        "sense_id": "7deb4b91-0bcc-3a87-9013-04275fa4dc04",
                        "entry_id": "f488e9d4-0aa9-3609-986c-28571bbec9d7",
                        "glosses": [
                            "cashmere"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "4837e2d9-f5bd-4498-8e22-16cc543a0d53",
                                "sense_id": "7deb4b91-0bcc-3a87-9013-04275fa4dc04",
                                "text": "Но Оле́ся уже́ наки́нула на го́лову кра́сный кашеми́ровый плато́к и вдруг, подбежа́в к ба́бушке, обняла́ её́ и зво́нко поцелова́ла.",
                                "translation": "But Olyessia had already put a red cashmere shawl on. Suddenly she ran up to her grandmother, embraced her and gave her a loud kiss.",
                                "english": "But Olyessia had already put a red cashmere shawl on. Suddenly she ran up to her grandmother, embraced her and gave her a loud kiss."
                            }
                        ]
                    }
                ],
