                    "sense_id": "93c86424-7a33-3632-99c7-b70aa6c10680",
                    "sense_definition": "Taki, który narzuca swoją wolę innym i wymaga bezwzględnego posłuchu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "osobowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej <w>władczy</w> ton głosu sprawił, że wszyscy natychmiast przestali rozmawiać.",
                            "target_lang_translations": {
                                "ru": "Её <w>властный</w> тон голоса заставил всех немедленно замолчать."
                            }
                        },
                        {
                            "text": "Miał bardzo <w>władczy</w> charakter i zawsze chciał kontrolować każdy szczegół pracy zespołu.",
                            "target_lang_translations": {
                                "ru": "У него был очень <w>властный</w> характер, и он всегда хотел контролировать каждую деталь работы команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "apodyktyczny",
                        "autorytarny",
                        "despotyczny"
                    ],
                    "common_phrases": [
                        "władczy ton",
                        "władczy charakter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто навязывает свою волю другим и требует беспрекословного подчинения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "властный",
                                "target_lang_sense_clarification": "склонный повелевать, подчинять себе"
                            },
                            {
                                "target_lang_word": "повелительный",
                                "target_lang_sense_clarification": "выражающий власть, свидетельствующий об обладании властью"
                            },
                            {
                                "target_lang_word": "авторитарный",
                                "target_lang_sense_clarification": "требующий беспрекословного подчинения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a1aec62-8cf5-3348-a950-a4ae14da5612",
                    "sense_definition": "Dotyczący sprawowania władzy państwowej lub administracyjnej.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Decyzja administracyjna jest typowym przykładem działania w sferze <w>władczej</w> państwa.",
                            "target_lang_translations": {
                                "ru": "Административное решение является типичным примером действия в <w>властной</w> сфере государства."
                            }
                        },
                        {
                            "text": "Urząd podjął <w>władcze</w> kroki w celu wyegzekwowania zaległych opłat od przedsiębiorcy.",
                            "target_lang_translations": {
                                "ru": "Ведомство предприняло <w>властные</w> меры с целью взыскания задолженности с предпринимателя."
                            }
                        }
                    ],
                    "synonyms": [
