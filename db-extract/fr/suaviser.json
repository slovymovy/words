                "senses": [
                    {
                        "sense_id": "33e772d0-e8e0-377a-b19c-6d3caefdb943",
                        "entry_id": "817f7371-d7d1-34d5-9d7d-9bc797c359e1",
                        "glosses": [
                            "Donner un caractère suave à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f40334d-e525-4e80-955d-2222600d0c78",
                                "sense_id": "33e772d0-e8e0-377a-b19c-6d3caefdb943",
                                "text": "Dans la carte il parlait aussi de la peine profonde de son père, se sentant incapable de la « suaviser » (c’était son mot)."
                            },
                            {
                                "example_id": "f13219fb-0c0c-4682-b932-01238c231bc5",
                                "sense_id": "33e772d0-e8e0-377a-b19c-6d3caefdb943",
                                "text": "Mais celle-ci ne saurait améliorer l’idée même de développement. Elle ne fait que la suaviser, de l’enrober d’une douce pommade."
                            },
                            {
                                "example_id": "1d88f509-3fcf-4a9e-bfd1-5bd94a435147",
                                "sense_id": "33e772d0-e8e0-377a-b19c-6d3caefdb943",
                                "text": "Bouche à l'équilibre parfait où le sucre n’intervient que pour “suaviser” l'ensemble."
                            }
                        ]
                    }
                ],
