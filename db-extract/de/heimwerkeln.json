                        "entry_id": "24570c7a-6384-3f28-96fb-048ffb4688dd",
                        "glosses": [
                            "zu Hause als Laie allerlei Arbeiten nachgehen, die in den Bereich des Handwerks fallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a38aee-0e71-45cf-8d9c-0ce91ed3a107",
                                "sense_id": "5a3e3528-331e-3930-9723-a1b6e54a7ab5",
                                "text": "„Für den Mieter war das prima –solange das Haus nicht einstürzte und er in Privatinitiative hier und da heimwerkeln konnte.“"
                            },
                            {
                                "example_id": "6bc77aea-f015-4975-b5cf-7e177d7a5bd8",
                                "sense_id": "5a3e3528-331e-3930-9723-a1b6e54a7ab5",
                                "text": "„Väter, die kochen, oder Mütter, die heimwerkeln, seien dagegen immer noch selten.“"
                            }
                        ],
