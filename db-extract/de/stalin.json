                            {
                                "example_id": "ff09f8d0-ceff-4562-857b-575f308f0120",
                                "sense_id": "9c013d1a-abca-3670-a578-0e95747c411c",
                                "text": "Stalin heißt mit vollem Namen „Jossif Wissarionowitsch Stalin“."
                            },
                            {
                                "example_id": "5736e187-7336-467a-af39-5ad910fe0b90",
                                "sense_id": "9c013d1a-abca-3670-a578-0e95747c411c",
                                "text": "„Stalin wiederum ließ mehr als 900000 Deutsche, die auf russischem Gebiet lebten, in östliche Sowjetrepubliken deportieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
