                ],
                "senses": [
                    {
                        "sense_id": "e41a8304-487a-36ff-a43e-c755b784581d",
                        "entry_id": "61840adf-a162-33e3-ae5e-a52a57fd021e",
                        "glosses": [
                            "spezifischer Faktor, dem ein Zustand oder Prozess unterliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f18562-4394-472f-a31f-6fe6bb7ca4b0",
                                "sense_id": "e41a8304-487a-36ff-a43e-c755b784581d",
                                "text": "„Dabei wird explizit oder implizit die Meinung vertreten, dass ein Modell für alle Texte aller Sprachen gelten müsse, ohne Rücksicht auf die Randbedingungen, die von Mathematikern notgedrungen vernachlässigt werden, da diese im Normalfall keine ausgebildeten Linguisten sind.“"
                            },
                            {
                                "example_id": "3b211a0e-c074-46ed-92e8-27cffc569786",
                                "sense_id": "e41a8304-487a-36ff-a43e-c755b784581d",
                                "text": "Ein Testfall in der Software umfasst die zur Ausführung festgelegten Randbedingungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7495959a-50bf-3f59-8a6c-7ce520eb559f",
                        "entry_id": "61840adf-a162-33e3-ae5e-a52a57fd021e",
                        "glosses": [
                            "bestimmte Anforderung, die an das Verhalten der Lösungsfunktionen einer Differentialgleichung am Rand des Definitionsbereiches gestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c30b22-4337-4cea-8621-5cb576e3d8e0",
                                "sense_id": "7495959a-50bf-3f59-8a6c-7ce520eb559f",
                                "text": "„Die Anwendung dieser partiellen Differentialgleichung vierter Ordnung (deren strenge Lösung nicht besonders verwickelt ist) stößt in praktischen Fällen auf Schwierigkeiten, weil die zur Lösung nötigen Randbedingungen sich in der Wirklichkeit kaum ermitteln lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ac53fef-41b7-455b-9cc2-12fd660bfbd5",
                        "source_entry_id": "61840adf-a162-33e3-ae5e-a52a57fd021e",
                        "source_sense_id": "e41a8304-487a-36ff-a43e-c755b784581d",
                        "source_sense_description": "spezifischer Faktor, dem ein Zustand oder Prozess unterliegt",
                        "target_lang_word": "boundary condition",
