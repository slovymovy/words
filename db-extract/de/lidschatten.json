                "senses": [
                    {
                        "sense_id": "c9e47474-7580-330e-92d2-83e5ffd5a42d",
                        "entry_id": "4fb6109f-9487-31ae-8d18-dc003820314d",
                        "glosses": [
                            "farbiges Kosmetikprodukt, das auf das Augenlid und unter der Augenbraue aufgetragen wird, um es zu betonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b19c12e-348b-473b-a45c-28767ff034ee",
                                "sense_id": "c9e47474-7580-330e-92d2-83e5ffd5a42d",
                                "text": "Mit Lidschatten kann durch entsprechende Farbgebung die Augenpartie zur Erhöhung der erotischen Ausstrahlung optisch vergrößert erscheinen."
                            },
                            {
                                "example_id": "5146cfbd-8ef5-4d90-a3e9-96a6fb7bdf3a",
                                "sense_id": "c9e47474-7580-330e-92d2-83e5ffd5a42d",
                                "text": "Die Frau trägt braunen Lidschatten auf das bewegliche Lid auf und hellen Lidschatten unter der Augenbraue."
                            },
                            {
                                "example_id": "5240224f-7eea-4928-aea0-c0b84a606aa0",
                                "sense_id": "c9e47474-7580-330e-92d2-83e5ffd5a42d",
                                "text": "Emily, fünf Jahre, sieht mit ihrem lila Lidschatten und dem grellgeschminkten Mündchen aus wie eine Partyqueen in Miniatur."
                            },
                            {
                                "example_id": "b8acd633-ee41-43ac-bb37-ce4a7013dd24",
                                "sense_id": "c9e47474-7580-330e-92d2-83e5ffd5a42d",
                                "text": "„Sie legte sandfabenen Lidschatten auf.“"
                            },
                            {
                                "example_id": "90dc93df-62d6-459f-a58f-0ae278ac8608",
                                "sense_id": "c9e47474-7580-330e-92d2-83e5ffd5a42d",
                                "text": "„Jeden Tag stand sie auf und leimte sich von Neuem zusammen, drehte sich Locken in die Haare und malte sich die Lippen an, schmierte sich Foundation ins Gesicht, zog einen kleinen scharzen Strich über die Augenlider, ehe sie Lidschatten auftrug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab89f53-129b-4736-95ba-4952c35a88fb",
                        "source_entry_id": "4fb6109f-9487-31ae-8d18-dc003820314d",
