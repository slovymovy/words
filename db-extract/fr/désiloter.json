            {
                "entry_id": "a5a5a3ed-e92c-3a90-bead-5375171d7252",
                "word": "désiloter",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9bc150b0-0aef-426f-b539-86d5521336ee",
                        "entry_id": "a5a5a3ed-e92c-3a90-bead-5375171d7252",
                        "tags": [],
                        "form": "désîloter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90d96249-78f8-30bd-a451-d5dca14c9e85",
                        "entry_id": "a5a5a3ed-e92c-3a90-bead-5375171d7252",
                        "glosses": [
                            "Modifier un type d’organisation pour y supprimer la logique d’ilots organisationnels ou techniques (chacun dans son coin), pour la décloisonner."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "ff17b42e-b3f6-4f3c-a9b9-61d84f61c71b",
                                "sense_id": "90d96249-78f8-30bd-a451-d5dca14c9e85",
                                "text": "L’objectif est de « désiloter » ces îlots de données pour pouvoir transmettre la puissance de la donnée à l’ensemble des collaborateurs de l’entreprise, prendre des décisions à un instant T, en passant par l’application de modèles d’IA et de machine learning, explique Stéphanie Achard."
                            },
                            {
                                "example_id": "232e363d-e624-4423-94ae-686d250fcf35",
                                "sense_id": "90d96249-78f8-30bd-a451-d5dca14c9e85",
                                "text": "Désilotez l’information et prenez des décisions plus rapides et plus éclairées."
                            },
                            {
                                "example_id": "7dc72683-b457-45f5-b76a-7e69879a4a85",
                                "sense_id": "90d96249-78f8-30bd-a451-d5dca14c9e85",
                                "text": "La DRH se retrouve à être un catalyseur de changement. Sa force et son succès reposeront sur sa capacité à rassembler, convaincre au plus haut et désiloter."
                            },
                            {
                                "example_id": "b7dedc1b-717b-4fbe-ba3c-7e80f88a4ffa",
                                "sense_id": "90d96249-78f8-30bd-a451-d5dca14c9e85",
                                "text": "Le succès passera a minima par la rupture, pour ne pas dire la disruption, et de toute façon, seule une approche « désilotée » permettra l’émergence d’un modèle d’économie collaborative et inclusive."
                            }
                        ]
                    }
                ],
