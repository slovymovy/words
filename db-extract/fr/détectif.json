                    {
                        "translation_id": "b872a477-263e-47c9-a9da-b786c82ac4e6",
                        "source_entry_id": "d15bef80-5dfe-3b67-b133-d41675157f6e",
                        "source_sense_id": "14a1d7b7-4bd9-307d-b2ef-035579a75c32",
                        "target_lang_word": "сыщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сыщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aef5a9be-a481-3b75-a328-68210ac11d40",
                                        "entry_id": "42b3778b-dcdd-3174-b47c-0fd41d0a2600",
                                        "glosses": [
                                            "тайный агент, занимающийся слежкой, сыском"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ca6e5f-cf89-42c4-aba8-33d1a6c7b888",
                                                "sense_id": "aef5a9be-a481-3b75-a328-68210ac11d40",
                                                "text": "Пугачёв был снова пойман и отправлен под караулом к сыщику, старшине Макарову, в Нижнюю Чирскую станицу, а оттуда в Черкасск."
                                            },
                                            {
                                                "example_id": "895b3f29-a590-4e3e-98b4-db314227c3ac",
                                                "sense_id": "aef5a9be-a481-3b75-a328-68210ac11d40",
                                                "text": "Часто по возникавшим уголовным делам посылались из Москвы нарочные сыщики, ненавидимые народом за свои злоупотребления и насилия."
                                            },
                                            {
                                                "example_id": "32092114-a40c-4d85-959b-94beba29b576",
                                                "sense_id": "aef5a9be-a481-3b75-a328-68210ac11d40",
                                                "text": "Ей надоели все эти таинственные убийства, хитросплетения сыщиков и необыкновенная находчивость допрашивающих следователей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "783b0046-bdff-3ac9-8443-9feb31bb1217",
                                        "entry_id": "42b3778b-dcdd-3174-b47c-0fd41d0a2600",
                                        "glosses": [
                                            "разг. тот, кто разыскивает кого-либо, что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ffea29-dc58-4b41-a36e-6db8f04a4db6",
                                                "sense_id": "783b0046-bdff-3ac9-8443-9feb31bb1217",
                                                "text": "Вы, может быть, желаете похвалиться ловкостью ваших изысканий, выставить пред нами и пред князем, какой вы хороший следователь, сыщик?"
                                            },
                                            {
                                                "example_id": "312cc363-7a5c-4b46-b815-3ad5e902d234",
                                                "sense_id": "783b0046-bdff-3ac9-8443-9feb31bb1217",
                                                "text": "Проходит день, другой; вы рассылаете по всем дорогам гонцов, сыщиков, сами мечетесь туда и сюда, теряете сон, аппетит, сходите с ума."
                                            },
                                            {
                                                "example_id": "4710ab18-2c1b-4b2d-945e-235419664d4d",
                                                "sense_id": "783b0046-bdff-3ac9-8443-9feb31bb1217",
                                                "text": "— Постоянные заглядывания в мою душу, — продолжал Лаевский, — оскорбляют во мне человеческое достоинство, и я прошу добровольных сыщиков прекратить своё шпионство!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
