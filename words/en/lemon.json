    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cbc2af0-a691-33fb-898f-d22c00c98256",
                    "sense_definition": "A yellowish, oval citrus fruit with sour juice.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She squeezed a fresh <w>lemon</w> over the grilled fish to add some flavor.",
                            "target_lang_translations": {
                                "ru": "Она выжала свежий <w>лимон</w> на рыбу на гриле, чтобы придать ей вкус."
                            }
                        },
                        {
                            "text": "I need to buy a <w>slice</w> of <w>lemon</w> for my tea.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить <w>ломтик</w> <w>лимона</w> для чая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slice of lemon",
                        "squeeze of lemon",
                        "lemon zest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтый овальный цитрусовый фрукт с кислым соком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лимон",
                                "target_lang_sense_clarification": "фрукт"
                            }
                        ]
