                            {
                                "target_lang_word": "最糟糕的",
                                "target_lang_sense_clarification": "最令人不快"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f562b77f-b3fe-37c4-b7f4-ed032be91b72",
                    "sense_definition": "The superlative form of <w>badly</w>: in the least effective or successful way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My injured leg hurts <w>worst</w> when the weather is cold and rainy.",
                            "target_lang_translations": {
                                "ru": "Моя травмированная нога болит <w>сильне́е всего́</w>, когда погода холодная и дождливая.",
                                "es": "Mi pierna lesionada duele <w>peor</w> cuando el clima es frío y lluvioso.",
                                "zh": "天气又冷又下雨时，我受伤的腿疼得<w>最厉害</w>。"
                            }
                        },
                        {
                            "text": "The team played <w>worst</w> during the second half of the game.",
                            "target_lang_translations": {
                                "ru": "Команда играла <w>ху́же всего́</w> во второй половине матча.",
                                "es": "El equipo jugó <w>peor</w> durante la segunda mitad del partido.",
                                "zh": "球队在下半场表现得<w>最差</w>。"
                            }
