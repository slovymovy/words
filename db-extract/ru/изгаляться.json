                                "target_word": "mock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccbc6c12-f8b6-3628-b89d-a8eae9cf77ce",
                                        "entry_id": "64d6eea3-3648-34b0-8bfd-c69320d4f4b5",
                                        "glosses": [
                                            "Imitation, not genuine; fake."
