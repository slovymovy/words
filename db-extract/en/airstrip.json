                                        "sense_id": "cbc93403-7384-3954-920f-76c6d531948e",
                                        "entry_id": "c3987116-07e3-3eb8-a27e-723910f54d59",
                                        "glosses": [
                                            "Terrain balisé, pourvu d'un revêtement bétonné ou bitumeux, aménagé sur l'aire d'un aéroport pour les manœuvres au sol des avions lors du décollage et de l'atterrissage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46339839-dfd8-44c7-9709-69f285f8a9ff",
                                                "sense_id": "cbc93403-7384-3954-920f-76c6d531948e",
                                                "text": "C'est pas une piste d'atterrissage, l'amour, pas besoin qu'on fasse des signes. Ça se ressent par en dedans, comprends-tu?"
                                            },
                                            {
                                                "example_id": "d7c8865d-ed0a-432e-a974-a5cbea5a8376",
                                                "sense_id": "cbc93403-7384-3954-920f-76c6d531948e",
                                                "text": "La famille Kretz doit satisfaire des ultrariches en quête de piste d’atterrissage pour leur hélicoptère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
