                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fa70d5-dd83-4973-b037-10f2bf91b7e6",
                                                "sense_id": "43bd13bc-816b-34e4-97fe-e18c22f7b655",
                                                "text": "Die Gefühle und Empfindungen, von denen heute jeder literarische Anatom weiß, daß sie im Herzen geistern, wurden einst in der Leber vermutet; und selbst Gascoygne nennt die emotionelle Seite der menschlichen Natur „unseren hepatischen Theil\"."
                                            },
                                            {
                                                "example_id": "908ab42c-f9c7-4b30-b55f-e132e4ad64b7",
                                                "sense_id": "43bd13bc-816b-34e4-97fe-e18c22f7b655",
                                                "text": "Dem hepatischen Ikterus liegt meist eine Lebererkrankung zu Grunde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
