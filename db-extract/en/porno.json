                    {
                        "translation_id": "59ba72c6-0a0f-4e13-a809-6e5f1764c151",
                        "source_entry_id": "a3dd1e09-d5c3-3639-b44f-654665be9c39",
                        "source_sense_description": "pornography",
                        "target_lang_word": "по́рно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
