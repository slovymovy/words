                                    {
                                        "sense_id": "b4709911-2981-3038-81ce-7c7f4dc24b36",
                                        "entry_id": "bec6b1de-1352-3e1b-a094-28f7f7e0cb85",
                                        "glosses": [
                                            "Gesamtheit der technischen Bestandteile eines Computers (oder anderer technischer Systeme), die nicht ausschließlich aus Daten bestehen, sondern physisch vorhanden sind, z. B. ein Mainboard oder eine Tastatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1774dec9-092d-4ec4-b146-5a23d70d56c8",
                                                "sense_id": "b4709911-2981-3038-81ce-7c7f4dc24b36",
                                                "text": "Mit heutiger Hardware lassen sich tausende von Berechnungen pro Sekunde durchführen."
