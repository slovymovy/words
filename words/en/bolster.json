                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy served as a <w>bolster</w> for the struggling economy.",
                            "target_lang_translations": {
                                "zh": "这项新政策成为了陷入困境的经济的<w>支柱</w>。"
                            }
                        },
