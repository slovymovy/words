                            {
                                "target_word": "jakuza",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "4bdb0527-9be5-3c86-bf96-2577ff0f5f0a",
                                        "entry_id": "a504c297-e94d-3f75-bbf1-f9b20f3ac150",
                                        "glosses": [
                                            "mafia japońska"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910cb3be-c182-4213-ae29-d543758da1d2",
                                                "sense_id": "4bdb0527-9be5-3c86-bf96-2577ff0f5f0a",
                                                "text": "Policja dorwała bossa jakuzy w jednym z kasyn w Jokohamie."
                                            }
                                        ],
