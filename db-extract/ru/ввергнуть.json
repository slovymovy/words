                "senses": [
                    {
                        "sense_id": "a4a346bc-67f4-37b6-8fe1-c83e5ebf4b7c",
                        "entry_id": "dd866502-2524-3198-b32d-7d8276c00acc",
                        "glosses": [
                            "устар. силой вовлечь, поместить куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2b62ad-d1e3-4e77-8ea5-0383de3dc260",
                                "sense_id": "a4a346bc-67f4-37b6-8fe1-c83e5ebf4b7c",
                                "text": "Ввергнуть в темницу."
                            },
                            {
                                "example_id": "c663c3f9-969f-405e-a42b-5e8c5f26bc43",
                                "sense_id": "a4a346bc-67f4-37b6-8fe1-c83e5ebf4b7c",
                                "text": "но скажу вам, кого бояться: бойтесь Того, Кто, по убиении, может ввергнуть в геенну: ей, говорю вам, того бойтесь."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0bb4c30-681d-364e-b445-a77f89c17558",
                        "entry_id": "dd866502-2524-3198-b32d-7d8276c00acc",
                        "glosses": [
                            "перен., высок. привести в какое-либо состояние: отчаяние, уныние, скорбь, тоску"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b859459-1248-4bbf-83ee-c38595e3a1df",
                        "source_entry_id": "dd866502-2524-3198-b32d-7d8276c00acc",
                        "target_lang_word": "plunge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plunge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97cbc49c-629f-3cb3-b4dc-5f2306c7c292",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To thrust into liquid, or into any penetrable substance; to immerse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887bd534-a98a-47a0-b117-270311d83470",
                                                "sense_id": "97cbc49c-629f-3cb3-b4dc-5f2306c7c292",
                                                "text": "to plunge the body into water"
                                            },
                                            {
                                                "example_id": "59fdcbbe-fcc4-4666-aed1-85bebdfd1192",
                                                "sense_id": "97cbc49c-629f-3cb3-b4dc-5f2306c7c292",
                                                "text": "\"Most of them don't wash. Those who do usually plunge their head into some brook or rill, if there happens to be one about.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To cast, stab or throw deep and fast into some thing, state, condition or action."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f7c261-b975-4ffd-8dcd-02b1425bde09",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "to plunge a dagger into the breast"
                                            },
                                            {
                                                "example_id": "76a6e251-7026-4af7-a207-d0ff567020e0",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "to plunge a nation into war"
                                            },
                                            {
                                                "example_id": "18d65688-e343-449f-bde1-b2d00c823a01",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "the city was plunged into darkness"
                                            },
                                            {
                                                "example_id": "296fe07c-c07b-4b74-9c62-88ba9711f5b6",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "Jon isn’t lying when he tells her she will always be his queen, right before plunging a knife into her. He genuinely swore obedience, and sees himself as a traitor when he commits the deeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f843e4-a302-3f5a-a0e1-bc3027761e02",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To baptize by immersion."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccb90a03-4f60-3687-9b4d-4dfa0224ec06",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
