                        "target_lang_word": "gélotologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gélotologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c496904-7fa4-3a67-93e2-b2557fddbae1",
                                        "entry_id": "4949ff24-3e58-3636-9ce8-da5047df1bdf",
                                        "glosses": [
                                            "Étude scientifique du rire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842a136e-4293-4b32-bddb-c70acf1394ad",
                                                "sense_id": "6c496904-7fa4-3a67-93e2-b2557fddbae1",
                                                "text": "Grâce à l’étude de la gélotologie, la science du rire (du grec gelos, rire,), ils sont en train de confirmer ce que nous avons toujours soupçonné : que le rire agrémente notre vie."
                                            }
                                        ]
                                    }
                                ]
