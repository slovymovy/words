                ],
                "senses": [
                    {
                        "sense_id": "33b5fff1-b314-3c01-a060-7c94f97dbb03",
                        "entry_id": "717bbd11-da6c-383f-9455-909e371cea3b",
                        "glosses": [
                            "tangled mass of hair"
                        ],
                        "tags": [
                            "Lviv",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "6de7c5f4-4d14-4f68-b0ee-aae23a579415",
                                "sense_id": "33b5fff1-b314-3c01-a060-7c94f97dbb03",
                                "text": "Stały chłopy przysadziste z gębami pomarszczonemi od wiatru i deszczu, z chyrami na oczy spadającemi, o ciężkich, od pracy obwisłych rękach, przygarbieni.",
                                "translation": "Stoopy peasants stood with their mouths wrinkled from the wind and rain, with tangled hair falling over their eyes, with heavy hands drooping from work, hunched over.",
                                "english": "Stoopy peasants stood with their mouths wrinkled from the wind and rain, with tangled hair falling over their eyes, with heavy hands drooping from work, hunched over."
                            },
                            {
                                "example_id": "a38b8f26-6ada-4800-b8b4-00f19c969742",
                                "sense_id": "33b5fff1-b314-3c01-a060-7c94f97dbb03",
                                "text": "Inne jeszcze w kąt chaty wciśniętė, zupełnie nagie, wpakowało oba kułaki w usta i patrzyło spod pokudłanej chyry na Józia nieufnie i chmurnie.",
                                "translation": "The other two, still crammed into the corner of the hut, completely naked, stuffed both fists into their mouths and looked from under their disheveled tangled heads of hair at Józio distrustfully and sullenly.",
                                "english": "The other two, still crammed into the corner of the hut, completely naked, stuffed both fists into their mouths and looked from under their disheveled tangled heads of hair at Józio distrustfully and sullenly."
                            }
                        ]
                    },
