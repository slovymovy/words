                                            {
                                                "example_id": "22349a4c-af3d-4093-8747-e97976574657",
                                                "sense_id": "ec058ff2-d324-347c-9d82-8281ee35135a",
                                                "text": "„Bauchfellentzündungen führen zu Übelkeit, Brechreiz und nachlassender Darmperistaltik (deshalb wird beim Verdacht der Bauch nach Darmgeräuschen abgehört).“"
                                            },
                                            {
                                                "example_id": "50b39d09-eaea-438e-9ef8-2b808b4b26a4",
                                                "sense_id": "ec058ff2-d324-347c-9d82-8281ee35135a",
                                                "text": "„1920, im Alter von neunundzwanzig Jahren, erlitt Morris einen Blinddarmdurchbruch und starb an einer Bauchfellentzündung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
