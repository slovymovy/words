{
    "word_family": [
        "twirl"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c63b3989-6736-3242-a984-7f76bd039c45",
                    "sense_definition": "The present participle and gerund of <w>twirl</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>twirling</w> her hair while waiting for the bus.",
                            "target_lang_translations": {
                                "fr": "Elle <w>faisait tournoyer</w> ses cheveux en attendant le bus."
                            }
                        },
                        {
                            "text": "The dancer enjoyed <w>twirling</w> across the stage during the performance.",
                            "target_lang_translations": {
                                "fr": "La danseuse aimait <w>tournoyer</w> sur scène pendant le spectacle."
                            }
                        }
                    ],
                    "synonyms": [
                        "spinning",
                        "rotating",
                        "whirling"
                    ],
                    "common_phrases": [
                        "twirling around"
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent et gérondif du verbe tourner ou faire tournoyer."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tournoyer",
                                "target_lang_sense_clarification": "indique un mouvement circulaire rapide"
                            },
                            {
                                "target_lang_word": "faire tournoyer",
                                "target_lang_sense_clarification": "indique l'action de faire tourner quelque chose"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a986b85-4301-3add-8fcb-bf1b73274a7c",
                    "sense_definition": "The act or motion of something that spins or rotates quickly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>twirling</w> of the ballerina's skirt created a beautiful blur of color.",
                            "target_lang_translations": {
                                "fr": "Le <w>tournoiement</w> de la jupe de la ballerine créait un magnifique flou de couleur."
                            }
                        },
                        {
                            "text": "He watched the <w>twirling</w> of the autumn leaves as they fell to the ground.",
                            "target_lang_translations": {
                                "fr": "Il regardait le <w>tournoiement</w> des feuilles d'automne alors qu'elles tombaient au sol."
                            }
                        }
                    ],
                    "synonyms": [
                        "spin",
                        "rotation",
                        "whirl"
                    ],
                    "target_lang_definitions": {
                        "fr": "L'action ou le mouvement de quelque chose qui tourne rapidement sur lui-même."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tournoiement",
                                "target_lang_sense_clarification": "le mouvement de rotation rapide"
                            },
                            {
                                "target_lang_word": "rotation",
                                "target_lang_sense_clarification": "terme plus général pour un mouvement circulaire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "221fe120-18ec-3ade-b79e-801ef3e6920e",
                    "sense_definition": "The sport or performance art of spinning a baton.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She practiced her <w>twirling</w> for hours before the parade.",
                            "target_lang_translations": {
                                "fr": "Elle a pratiqué son <w>twirling</w> pendant des heures avant le défilé."
                            }
                        },
                        {
                            "text": "The team showed off their impressive <w>twirling</w> skills at the halftime show.",
                            "target_lang_translations": {
                                "fr": "L'équipe a montré ses impressionnantes compétences en <w>twirling</w> lors du spectacle de la mi-temps."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baton twirling"
                    ],
                    "target_lang_definitions": {
                        "fr": "Le sport ou l'art de faire tournoyer un bâton."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "twirling",
                                "target_lang_sense_clarification": "terme utilisé en français pour désigner le sport du bâton"
                            },
                            {
                                "target_lang_word": "maniement du bâton",
                                "target_lang_sense_clarification": "description technique de l'activité"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}