    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c94b31d-39c6-3392-91f9-74f1b63756da",
                    "sense_definition": "Homme qui s'engage à accompagner un enfant sur le plan spirituel ou moral lors d'un baptême religieux ou républicain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille_religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon oncle a accepté de devenir le <w>parrain</w> de mon deuxième fils."
                        },
                        {
                            "text": "Pour la cérémonie, les parents ont choisi un <w>parrain</w> et une marraine très proches de la famille."
                        }
                    ],
                    "common_phrases": [
                        "parrain et marraine",
                        "parrain de baptême",
                        "choisir un parrain"
                    ]
                },
                {
                    "sense_id": "e92f3a5b-0d5d-32a7-bc65-f68aa07f8ecc",
                    "sense_definition": "Chef tout-puissant d'une organisation criminelle ou mafieuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "criminalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a finalement arrêté le redoutable <w>parrain</w> du réseau criminel."
                        },
                        {
                            "text": "Dans ce film célèbre, le <w>parrain</w> dirige ses affaires d'une main de fer."
                        }
                    ],
                    "common_phrases": [
                        "parrain de la mafia"
                    ]
                },
                {
                    "sense_id": "c3d7e70e-ec5d-3a40-a013-4c1cfe2917a9",
                    "sense_definition": "Personne expérimentée qui présente, soutient ou guide un nouvel arrivant dans une association, une école ou une entreprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tutorat_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque nouvel employé bénéficie du soutien d'un <w>parrain</w> pour faciliter son intégration."
                        },
                        {
                            "text": "Ce scientifique reconnu a été le <w>parrain</w> de notre promotion d'ingénieurs."
                        }
                    ],
                    "synonyms": [
                        "répondant",
                        "tuteur"
                    ],
                    "common_phrases": [
                        "parrain de promotion",
                        "avoir un parrain"
                    ]
                },
                {
                    "sense_id": "34f6954e-0f0e-363f-a67e-d63a9f6b1715",
                    "sense_definition": "Personne choisie pour assister à la bénédiction ou au baptême d'un navire ou d'une cloche et lui attribuer un nom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceremonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire de la commune a agi comme <w>parrain</w> lors de la bénédiction de la nouvelle cloche."
                        },
                        {
                            "text": "Le navigateur solitaire a été choisi comme <w>parrain</w> de ce voilier de course."
                        }
                    ]
                },
                {
                    "sense_id": "0cfbd858-35f6-3960-86fb-77bae81077ca",
                    "sense_definition": "Autrefois, témoin qui assistait un combattant dans un duel pour veiller au respect scrupuleux des règles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "duel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque gentilhomme s'est présenté sur le pré accompagné de son fidèle <w>parrain</w>."
                        },
                        {
                            "text": "Les deux <w>parrains</w> se sont entretenus pour vérifier les armes avant le combat."
                        }
                    ],
                    "synonyms": [
                        "témoin"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme lié aux duels d'autrefois"
                        }
                    ]
                }
            ]
        }
