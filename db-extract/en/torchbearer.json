                    }
                ],
                "senses": [
                    {
                        "sense_id": "51bd5979-5e43-3378-8549-db15fdda4718",
                        "entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "glosses": [
                            "A person who carries a torch (flaming brand)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc3849e1-96c5-3d59-9b01-ddeb352d8c76",
                        "entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "glosses": [
                            "The leader of a campaign, or one who gives inspiration to others."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "298632d5-2fed-386e-8308-69d9ba35e5c2",
                        "entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "glosses": [
                            "One who carries on a movement or organization from someone else."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "854b4fe0-7fcd-42f9-b2b5-0fa1b089d0c0",
                                "sense_id": "298632d5-2fed-386e-8308-69d9ba35e5c2",
                                "text": "The Roman Empire could be considered the torchbearer of Ancient Greek knowledge and wisdom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3237342-26bd-479b-aa42-37819d6696b3",
                        "source_entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "source_sense_description": "one who carries a torch",
                        "target_lang_word": "porte-flambeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porte-flambeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "433a3ca9-a758-3371-b831-634f51494760",
                                        "entry_id": "ffc28955-831c-3a40-90a7-47e4178af90b",
                                        "glosses": [
                                            "Celui qui porte un flambeau, une torche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72aadc9-dc4d-4cc3-b752-0bbb3b9fb5c9",
                                                "sense_id": "433a3ca9-a758-3371-b831-634f51494760",
                                                "text": "Quelques minutes après, les soixante volontaires enveloppés de toutes parts, hébétés par la surprise d’apercevoir autour d’eux un si grand nombre de soldats et ne recevant aucun ordre de tirer sur des ennemis qui ne tiraient pas eux-mêmes, virent arriver un officier supérieur accompagné d’un porte-flambeau qui s’adressa tout de suite au lieutenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97f57da0-a9be-3705-973b-529ff12b5e2f",
                                        "entry_id": "ffc28955-831c-3a40-90a7-47e4178af90b",
                                        "glosses": [
                                            "Celui qui mène, qui ouvre la voie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e63b4f7-cd85-4556-8395-fbb36383c47a",
                                                "sense_id": "97f57da0-a9be-3705-973b-529ff12b5e2f",
                                                "text": "Il surgira parmi ces tout-puissants, plus puissant qu’eux ; il leur apparaîtra comme le porte-flambeau, car il leur montrera la vérité, et comme le porte-glaive, car il leur montrera la justice."
                                            },
                                            {
                                                "example_id": "58070661-28ba-4ca1-afd6-849f5db950e9",
                                                "sense_id": "97f57da0-a9be-3705-973b-529ff12b5e2f",
                                                "text": "Avec le petit serrement de cœur qu’on a toujours en pareil cas, le jeune homme s’aperçoit que la France a cessé d’être pour ses enthousiastes jeunes amis un porte-flambeau. Les grands espoirs qu’elle a suscités en 1830 ont, dit-il, été déçus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9816953b-1208-4938-bf43-70819d7c6428",
                        "source_entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "source_sense_description": "one who carries a torch",
                        "target_lang_word": "porte-torche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porte-torche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa9e026-9b19-3c91-aefc-9da6186f59ae",
                                        "entry_id": "879ee0e8-8f49-3371-a64d-1025b1455eab",
                                        "glosses": [
                                            "Celui qui porte une torche, un flambeau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdcc35db-3ae7-4927-8c39-37fda0c40ab6",
                                                "sense_id": "2aa9e026-9b19-3c91-aefc-9da6186f59ae",
                                                "text": "Un porte-torche descend suivi de deux Soldats, un Assesseur et Henri."
                                            },
                                            {
                                                "example_id": "c0e67f3c-dbbd-419a-a245-e9a5a5a42cda",
                                                "sense_id": "2aa9e026-9b19-3c91-aefc-9da6186f59ae",
                                                "text": "Quant à la procession en elle-même, outre le personnel d’un nombreux clergé, prêtres, chantres, porte-châsses, porte-bannières, etc., elle s’avançait précédée de deux tambours, avec une escorte de six hallebardiers et douze porte-torches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5bb4ec-e2ac-37ed-bb0d-239adfe12dba",
                                        "entry_id": "879ee0e8-8f49-3371-a64d-1025b1455eab",
                                        "glosses": [
                                            "Support permettant de maintenir une torche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5411b9-4558-431d-b564-f43da5cc0ddc",
                                                "sense_id": "ec5bb4ec-e2ac-37ed-bb0d-239adfe12dba",
                                                "text": "Derrière leurs grilles en fer, ses fenêtres sont obscures. Les porte-torches sont vides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9dbb7d8-f549-4ddf-96c9-ef2447882a88",
                        "source_entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "source_sense_description": "one who carries a torch",
                        "target_lang_word": "факелоно́сец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "факелоно́сец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce9f178-4ab9-38bf-ac67-ba76ee7b8eb4",
                                        "entry_id": "599649a3-7d37-3640-baef-26ebc7bd3a6c",
                                        "glosses": [
                                            "истор. тот, кто несёт факел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb695a1-34b0-4da4-b9cc-ec2503169fd9",
                                                "sense_id": "0ce9f178-4ab9-38bf-ac67-ba76ee7b8eb4",
                                                "text": "За жрецами шли чиновники, а потом факелоносцы, биченосцы, расстилатели ковров, жезлоносцы, виночерпии и хлебодары, а за этими следовали на мулах однообразно раскрашенные двухколёски, на которых помещались ярко расцвеченные корзины и бочонки〈…〉"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65710545-ea2f-4f64-8a6b-a61c64cebbcc",
                        "source_entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                        "source_sense_description": "one who carries a torch",
                        "target_lang_word": "фа́кельщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фа́кельщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "25197b5a-9ce2-3731-9858-8961b41ea156",
                                        "entry_id": "cc7de8d7-f684-3cbd-8911-22cd32c64361",
                                        "glosses": [
                                            "тот, кто несёт факел в процессии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f310037d-1d86-474f-abc8-b4697827d7bd",
                                                "sense_id": "25197b5a-9ce2-3731-9858-8961b41ea156",
                                                "text": "Две тёмные фигуры стоят под навесом подъезда и о чём-то беседуют. Их смеющиеся лица, громкий говор как-то странно не гармонируют с трауром их одежды. Молодой бритый факельщик, сдвинув цилиндр на затылок, рассказывает что-то своему товарищу с рыженькой бородкой, часто припадая к его уху и сообщая что-то, очевидно, пикантное, – и тот смеётся и прищёлкивает языком…"
                                            },
                                            {
                                                "example_id": "9678cfe0-a11c-4581-ac40-1f2df243e48e",
                                                "sense_id": "25197b5a-9ce2-3731-9858-8961b41ea156",
                                                "text": "Сижу я в трактире, … подсаживается рядом один малый в цилиндре. Факельщик, говорит. С похорон зашел глотку промочить…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
