                ],
                "senses": [
                    {
                        "sense_id": "3599c6f7-858f-3b6f-a9c1-65eb8f8f4788",
                        "entry_id": "9a11dbf7-19c9-37e6-8451-69653d97e1f5",
                        "glosses": [
                            "Qui a deux fonctions, deux usages."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2650178c-088b-4e15-af49-f107bfeae3fc",
                                "sense_id": "3599c6f7-858f-3b6f-a9c1-65eb8f8f4788",
                                "text": "Notre vaccin bivalent cible le variant BA1, mais il se révèle aussi efficace pour les autres sous-lignages BA4 et BA5."
                            }
                        ]
                    },
                    {
                        "sense_id": "eea025be-40e0-384a-afa8-1447cbf0aa09",
                        "entry_id": "9a11dbf7-19c9-37e6-8451-69653d97e1f5",
                        "glosses": [
                            "Désigne un élément chimique qui n’accepte que deux liaisons chimiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "719d130e-6eaa-40a8-9666-600e89eca93b",
                                "sense_id": "eea025be-40e0-384a-afa8-1447cbf0aa09",
                                "text": "L’atome de calcium est bivalent."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e25217f-6ce5-3265-b52e-4aa4622b190f",
                        "entry_id": "9a11dbf7-19c9-37e6-8451-69653d97e1f5",
                        "glosses": [
                            "Désigne un verbe qui demande deux actants, exprimés ou sous-entendus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bcc9796d-3dbb-3725-8a21-66b5f9ee599e",
                        "entry_id": "9a11dbf7-19c9-37e6-8451-69653d97e1f5",
                        "glosses": [
                            "Qui ne considère que deux valeurs de vérité, le vrai et le faux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79bf5451-09fa-4794-9028-be99ba96c57b",
                                "sense_id": "bcc9796d-3dbb-3725-8a21-66b5f9ee599e",
                                "text": "La logique bivalente."
                            }
                        ]
                    },
                    {
                        "sense_id": "72906b7a-d52f-3a2b-8f64-c81deae1da00",
                        "entry_id": "9a11dbf7-19c9-37e6-8451-69653d97e1f5",
                        "glosses": [
                            "Désigne en biologie cellulaire, une paire de chromosomes homologues appariés lors de la première prophase de la méiose chez un diploïde."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "27277a60-221d-4ee0-8408-ff2f6963efa8",
                                "sense_id": "72906b7a-d52f-3a2b-8f64-c81deae1da00",
                                "text": "Les chromosomes bivalents sont la règle à la méiose ; dans une espèce, C. glauca, cependant, on trouve des quadrivalents, et même parfois un octovalent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89432843-1cc3-4b0f-b698-39e44609b5bc",
                        "source_entry_id": "9a11dbf7-19c9-37e6-8451-69653d97e1f5",
                        "source_sense_description": "Chimie",
                        "target_lang_word": "zweiwertig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweiwertig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d0cc0ad-d7d0-36f5-8a72-4d9dea171109",
                                        "entry_id": "9300cb7a-34bc-3bb7-b822-2b43c5143cda",
                                        "glosses": [
                                            "fähig, sich mit zwei Valenzen (etwa einwertigen Wasserstoffatomen) zu verbinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf28814-f2f0-43af-b00e-41521acc0ae9",
                                                "sense_id": "6d0cc0ad-d7d0-36f5-8a72-4d9dea171109",
                                                "text": "„Dass dasselbe auch in den Oxydulverbindungen zweiwertig ist, geht aus der Dampfdichte des Chlorürs hervor, nach welcher dasselbe die Zusammensetzung Cu, Cl, besitzt.“"
                                            },
                                            {
                                                "example_id": "08ae14da-fca6-436a-8056-e996193128a0",
                                                "sense_id": "6d0cc0ad-d7d0-36f5-8a72-4d9dea171109",
                                                "text": "„Ebenso wie wir ein Metall zweiwertig nannten, das sich mit zwei Verbindungsgewichten Chlor vereinigen kann, so werden wir die Gruppe CH2 zweiwertig, CH dreiwertig nennen; dem Kohlenstoff kommt in solchem Sinne Vierwertigkeit zu.“"
                                            },
                                            {
                                                "example_id": "a6820e1c-5809-4cb2-8bc7-88d67c8192ed",
                                                "sense_id": "6d0cc0ad-d7d0-36f5-8a72-4d9dea171109",
                                                "text": "„Das Eisenmolekül im Häm ist normalerweise im zweiwertigen Zustand, was die Sauerstoffbindung erleichtert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "13d3ccce-6ffd-3e8c-913d-480e25e58283",
                                        "entry_id": "9300cb7a-34bc-3bb7-b822-2b43c5143cda",
                                        "glosses": [
                                            "zwei obligatorische Aktanten habend"
                                        ],
                                        "tags": [
                                            "bei einem Verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9b414d-6418-4d46-9bd0-62c34c3745f9",
                                                "sense_id": "13d3ccce-6ffd-3e8c-913d-480e25e58283",
                                                "text": "„Verben können nur einwertig, zweiwertig oder dreiwertig sein und neben dem Subjekt höchstens zwei Objekte fordern.“"
                                            },
                                            {
                                                "example_id": "b12691a6-78f5-4029-88c7-923049e0b3b2",
                                                "sense_id": "13d3ccce-6ffd-3e8c-913d-480e25e58283",
                                                "text": "„Alle transitiven Verben sind mindestens zweiwertig, denn sie lassen ein Akkusativobjekt zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf422b84-a860-3581-bfb5-a5e05622737a",
                                        "entry_id": "9300cb7a-34bc-3bb7-b822-2b43c5143cda",
                                        "glosses": [
                                            "gleichzeitig gegen zwei unterschiedliche Erreger immunisierend"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "220e75e6-bfe1-4593-ba9f-293969240400",
                                                "sense_id": "cf422b84-a860-3581-bfb5-a5e05622737a",
                                                "text": "„Der zweiwertige Impfstoff ist besonders für das Schaf geeignet.“"
                                            },
                                            {
                                                "example_id": "39e06eb6-5975-4707-b005-5950e559509f",
                                                "sense_id": "cf422b84-a860-3581-bfb5-a5e05622737a",
                                                "text": "„Bis kurzem war es nur möglich, in ausreichenden Quantitäten eine zweiwertige Vakzine zu produzieren.“"
                                            },
                                            {
                                                "example_id": "aed14de9-ac2c-4416-b307-4949a3c4e1b5",
                                                "sense_id": "cf422b84-a860-3581-bfb5-a5e05622737a",
                                                "text": "„Die Wiederkäuer müssen am Ursprungsort mindestens 10 Tage vor dem Versand mit einem zweiwertigen Impfstoff (O-C) gegen Maul- und Klauenseuche geimpft worden sein.“"
                                            },
                                            {
                                                "example_id": "106c5ee4-e5a5-4d2f-8b09-71c750f2d6fe",
                                                "sense_id": "cf422b84-a860-3581-bfb5-a5e05622737a",
                                                "text": "„Am Ende spendeten die Pharmaunternehmen A/Victoria- und zweiwertige (A/Victoria plus A/New Jersey-)Impfstoffe der Bundesregierung, aus Sorge, der Kongreß könne zu einem späteren Zeitpunkt eine festumrissene Gewinnspannbreite definieren.“"
                                            },
                                            {
                                                "example_id": "7e41ffdb-8b11-4bfe-910f-e20e629b91e2",
                                                "sense_id": "cf422b84-a860-3581-bfb5-a5e05622737a",
                                                "text": "„Im ‚Lancet‘ ist am Donnerstag eine Studieerschienen, die erstmals für England eine Schutzrate von 87 Prozent für den zweiwertigen Impfstoff gegen die zwei gefährlichsten Varianten der Viren (HPV 16 und HPV 18) nachweist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
