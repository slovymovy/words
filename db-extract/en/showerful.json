                        "examples": [
                            {
                                "example_id": "f56f97bb-c8f5-4f5d-b002-e7dce783304e",
                                "sense_id": "e717068d-06ff-34f2-8907-87048dc0103e",
                                "text": "The last tall son of Lot and Bellicent, And tallest, Gareth, in a showerful spring Stared at the spate."
                            },
                            {
                                "example_id": "a93bd1c0-8349-4f6f-a006-d82bb9f2dfcf",
                                "sense_id": "e717068d-06ff-34f2-8907-87048dc0103e",
                                "text": "Why so woe-begone ? and why, Philaenis, these reckless tearings of hair, and suffusion of showerful eyes ?"
                            },
                            {
                                "example_id": "83e0b8b5-f354-4623-bc05-ddea1c9166e6",
                                "sense_id": "e717068d-06ff-34f2-8907-87048dc0103e",
                                "text": "It was warm there too in the last icy spasms of winter. The spring was showerful."
                            }
                        ]
                    }
