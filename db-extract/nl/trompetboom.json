                "senses": [
                    {
                        "sense_id": "47b707da-9ca8-35c2-b0d5-fd33e3e92b81",
                        "entry_id": "591ced84-d7cc-31e6-9b48-79ea5295ef48",
                        "glosses": [
                            "Catalpa een geslacht van bomen die tot de trompetboomfamilie Bignoniaceae behoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d25c401-e107-4c02-8b26-bec8335ef1e5",
                                "sense_id": "47b707da-9ca8-35c2-b0d5-fd33e3e92b81",
                                "text": "Quispel, wie de aanblik te veel werd, liep de brede galerij op die de binnenplaats omgaf, en bleef in gedachten naar de trompetboom staan kijken."
                            },
                            {
                                "example_id": "2f9e27ed-0063-4547-a537-42aa8ce018a3",
                                "sense_id": "47b707da-9ca8-35c2-b0d5-fd33e3e92b81",
                                "text": "Sommige bolvormen op een stam zijn zo geknipt, andere hebben van nature een ronde kroon - zoals de Catalpa bignonioides Nana, een trompetboom. De laatste groeit vooral in particuliere tuinen."
                            }
                        ]
                    }
                ],
