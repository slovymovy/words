                            {
                                "example_id": "74ef9d60-aba7-4a4c-9a24-15c82849e179",
                                "sense_id": "d46aeec7-4d7c-3719-a065-b0a44d1da762",
                                "text": "As the day passes away, and body clocks begin to stutter, there are also physical assaults with Zimmers locked in combat like the horns of fighting stags."
                            },
                            {
                                "example_id": "3ae65743-85ec-42ad-86eb-5bcd06bcbad2",
                                "sense_id": "d46aeec7-4d7c-3719-a065-b0a44d1da762",
                                "text": "He cites Rockers Reunion, in January, the first big rock’n’roll all-dayer of the year. “My reviewer made the point that everybody seems to be on sticks and Zimmers.”"
                            }
                        ]
                    }
