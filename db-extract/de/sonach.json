                                "example_id": "7a211681-a129-41c4-847b-2bd35379217d",
                                "sense_id": "c1cf962d-9030-3019-9716-c30967bd65e5",
                                "text": "Ich habe das Glas Wasser ausgetrunken; sonach ist das Glas leer."
                            }
