                "senses": [
                    {
                        "sense_id": "08d06029-a7a4-34d2-893a-eb3e3dc87f9b",
                        "entry_id": "915b76b9-ef10-3bc5-8117-0fde8cf6c621",
                        "glosses": [
                            "Person, mit der man zumindest einen Teil der Reise gemeinsam verbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bcad01d-f146-4ec7-9669-36264f06d52d",
                                "sense_id": "08d06029-a7a4-34d2-893a-eb3e3dc87f9b",
                                "text": "„Mein Reisekamerad schlägt vor, dem Mann ein paar Rubel zu geben.“"
                            },
                            {
                                "example_id": "5e4a96f8-a142-4b3a-a22d-ae7c41ae252d",
                                "sense_id": "08d06029-a7a4-34d2-893a-eb3e3dc87f9b",
                                "text": "„Der beste Reisekamerad ist Alexandre Desvachez, ein Cellist, der im ganzen Fernen Osten konzertiert und damit ein kleines Vermögen gesammelt hat, ein aufgeschlossener, für alles interessierter Mann und nebenbei ein guter Causeur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
