    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "705ce6f5-24f1-34ef-99de-ac3f18987145",
                    "sense_definition": "present participle and gerund of <w>glisten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning dew was <w>glistening</w> on the spider webs in the quiet garden.",
                            "target_lang_translations": {
                                "de": "Der Morgentau <w>glänzte</w> auf den Spinnweben im ruhigen Garten."
                            }
                        },
                        {
                            "text": "Sweat was <w>glistening</w> on his forehead after the strenuous afternoon workout.",
                            "target_lang_translations": {
                                "de": "Nach dem anstrengenden Nachmittagstraining <w>schimmerte</w> der Schweiß auf seiner Stirn."
                            }
                        }
                    ],
                    "synonyms": [
                        "shining",
                        "sparkling",
                        "glimmering"
                    ],
                    "common_phrases": [
                        "glistening in the sun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „glisten“; glänzend, schimmernd oder glitzernd, oft durch Feuchtigkeit oder Reflexion."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "glänzend",
                                "target_lang_sense_clarification": "durch Feuchtigkeit oder Licht reflektierend"
                            },
                            {
                                "target_lang_word": "schimmernd",
                                "target_lang_sense_clarification": "sanft glänzend oder schillernd"
                            },
                            {
                                "target_lang_word": "glitzernd",
                                "target_lang_sense_clarification": "funkelnd, funkelnde Lichtreflexe werfend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f05fa95c-1101-3538-8b8a-4aeb6789fe2b",
                    "sense_definition": "A flash, gleam, or sparkling appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the dim moonlight, faint <w>glistenings</w> appeared across the surface of the lake.",
                            "target_lang_translations": {
                                "de": "Im schwachen Mondlicht zeigte sich ein zartes <w>Glitzern</w> auf der Oberfläche des Sees."
                            }
                        },
                        {
                            "text": "The jeweler admired the subtle <w>glistening</w> of the polished stones under the lamp.",
                            "target_lang_translations": {
                                "de": "Der Juwelier bewunderte das feine <w>Schimmern</w> der polierten Steine unter der Lampe."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "gleam",
                        "sparkle"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Aufblitzen, Schimmern oder glitzerndes Erscheinungsbild."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Glänzen",
                                "target_lang_sense_clarification": "das Vorhandensein von Glanz"
                            },
                            {
                                "target_lang_word": "das Schimmern",
                                "target_lang_sense_clarification": "ein sanftes Leuchten oder Schimmer"
                            },
                            {
                                "target_lang_word": "das Glitzern",
                                "target_lang_sense_clarification": "funkelnde Lichtpunkte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f0c2caa-4058-3442-9526-7974660d2b81",
                    "sense_definition": "A microscopic, fluid-filled space that forms inside an artificial intraocular lens.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ophthalmologist checked the implant for the development of any <w>glistening</w> over time.",
                            "target_lang_translations": {
                                "de": "Der Augenarzt untersuchte das Implantat im Laufe der Zeit auf das Entstehen von <w>Glistenings</w>."
                            }
                        },
                        {
                            "text": "Severe <w>glistenings</w> can scatter light and impair the patient's visual quality.",
                            "target_lang_translations": {
                                "de": "Starke <w>Glistenings</w> können das Licht streuen und die Sehqualität des Patienten beeinträchtigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "microvacuole"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein mikroskopisch kleiner, flüssigkeitsgefüllter Hohlraum, der sich in einer künstlichen Intraokularlinse bildet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Glistening",
                                "target_lang_sense_clarification": "Fachbegriff in der Augenheilkunde für Vakuolen in Intraokularlinsen"
                            },
                            {
                                "target_lang_word": "die Mikrovakuole",
                                "target_lang_sense_clarification": "mikroskopischer Hohlraum in IOLs"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}