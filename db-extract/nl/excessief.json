                ],
                "senses": [
                    {
                        "sense_id": "7270b80c-f294-3092-b7ed-c99c298d1345",
                        "entry_id": "c9b85033-4989-3241-9cc9-1e8e26083b04",
                        "glosses": [
                            "overdreven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7c2cde-52b6-4aed-b68e-945f59f657d3",
                                "sense_id": "7270b80c-f294-3092-b7ed-c99c298d1345",
                                "text": "Siebelink heeft zich zijn hele schrijversleven verbonden gevoeld met Ferron. \"Wij wilden allebei de literatuur veranderen\", zei Siebelink recent. \"Geen Hollands realisme, maar overdadigheid: excessief en hartstochtelijk.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a551e537-7a9e-40b1-84bb-2d0ea269c005",
                        "source_entry_id": "c9b85033-4989-3241-9cc9-1e8e26083b04",
                        "source_sense_id": "7270b80c-f294-3092-b7ed-c99c298d1345",
                        "target_lang_word": "excessive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excessive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe6beb6f-dfa2-35bc-ae71-37c23484fa02",
                                        "entry_id": "f199466c-235b-3a91-b782-51d2dc9ff710",
                                        "glosses": [
                                            "Exceeding the usual bounds of something; too much (of amount); extravagant; immoderate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef51147-2b1c-4d04-ba98-160a8291840f",
                                                "sense_id": "fe6beb6f-dfa2-35bc-ae71-37c23484fa02",
                                                "text": "Putting a wide vibrato on a single 16th triplet note at 160 beats per minute seems rather excessive."
                                            },
                                            {
                                                "example_id": "90e3dccb-53d0-4e02-975f-903e80991715",
                                                "sense_id": "fe6beb6f-dfa2-35bc-ae71-37c23484fa02",
                                                "text": "\"You can throw off your cumbersome disguise here,\" said Lucy, though the words could scarcely be distinguished, from her excessive agitation, Evelyn hastily caught up a cloak and cap laid ready for him, and a few minutes brought them into the sitting-room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a4da0c5-7030-4ab7-b6b3-9b73a3cea70d",
                        "source_entry_id": "c9b85033-4989-3241-9cc9-1e8e26083b04",
                        "source_sense_id": "7270b80c-f294-3092-b7ed-c99c298d1345",
                        "target_lang_word": "excessif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excessif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b980ea-fd26-3e1e-ac31-20c329d9ba53",
                                        "entry_id": "a10b39dd-e24d-30d7-be17-2cfaaf8865c8",
                                        "glosses": [
                                            "Qui excède la règle, la mesure, le degré ordinaire ou convenable."
                                        ],
                                        "tags": [],
                                        "note": "Se dit des choses physiques ou morales",
                                        "examples": [
                                            {
                                                "example_id": "026b8c26-3c7f-420c-a1c8-7af1907bf436",
                                                "sense_id": "f1b980ea-fd26-3e1e-ac31-20c329d9ba53",
                                                "text": "Cependant, il convient de retenir que les honoraires du radiesthésiste ne doivent pas être excessifs, sans quoi il perdrait rapidement sa clientèle."
                                            },
                                            {
                                                "example_id": "7b913403-abb1-4660-98a9-ae62f85e2ee6",
                                                "sense_id": "f1b980ea-fd26-3e1e-ac31-20c329d9ba53",
                                                "text": "L'aération de l'eau peut être maintenue au moyen de bulleurs. Il est conseillé de placer les bulleurs à des endroits où ils n'entraînent pas de stress excessif chez les têtards."
                                            },
                                            {
                                                "example_id": "07e091a5-b709-428c-96a9-ffcbe67c84d4",
                                                "sense_id": "f1b980ea-fd26-3e1e-ac31-20c329d9ba53",
                                                "text": "Ces dépenses injustifiées et excessives sont communément appelées, reprenant ainsi le terme de la jurisprudence des juridictions du contentieux de la tarification, abusives."
                                            },
                                            {
                                                "example_id": "7577ad94-8ca8-496d-a6d5-0f24b86fd8d3",
                                                "sense_id": "f1b980ea-fd26-3e1e-ac31-20c329d9ba53",
                                                "text": "Tout acte, tout énoncé considéré « excessif » par une personne, pourrait être considéré comme parfaitement raisonnable et mesuré par d'autres. Une grève dans un milieu de travail peut être considérée comme un moyen de pression excessif si le maintien du statu quo est une norme fondamentale pour la personne qui juge, et comme un moyen banal si on considère le changement social conflictuel comme une norme de progrès."
                                            },
                                            {
                                                "example_id": "60cb87d8-7e6a-4724-a147-9a23b72c5e4a",
                                                "sense_id": "f1b980ea-fd26-3e1e-ac31-20c329d9ba53",
                                                "text": "Ce fut un grand Vaisseau taillé dans l’or massif :\nSes mâts touchaient l’azur, sur des mers inconnues ;\nLa Cyprine d’amour, cheveux épars, chairs nues\nS’étalait à sa proue, au soleil excessif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "905e3dbe-4733-3619-b0fe-b505218b2025",
                                        "entry_id": "a10b39dd-e24d-30d7-be17-2cfaaf8865c8",
                                        "glosses": [
                                            "Se dit des personnes portées à l’excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244da15d-42fe-44b1-b0ea-dd3a9813f1e3",
                                                "sense_id": "905e3dbe-4733-3619-b0fe-b505218b2025",
                                                "text": "Cet homme est excessif en tout ce qu’il fait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excessif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f364d8-cfe1-3cfe-8f6d-7de21ffca4ee",
                                        "entry_id": "ad712878-28e2-36fd-9c58-cd0290612ee7",
                                        "glosses": [
                                            "Réalité considérée comme constituant un excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d97a51-d0d5-492e-9966-0609fe393d56",
                                                "sense_id": "a1f364d8-cfe1-3cfe-8f6d-7de21ffca4ee",
                                                "text": "Les Français, qui sont d'un naturel modéré, trouvent volontiers de l'excessif aux façons et manières qui ne sont pas dans l'ordinaire de leurs moeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe3adc2-28ea-3a2a-a004-28943d5a2e1c",
                                        "entry_id": "ad712878-28e2-36fd-9c58-cd0290612ee7",
                                        "glosses": [
                                            "Cas exprimant une transition à partir d’un état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcdb356d-575b-4b52-be2f-b573545ec570",
                                                "sense_id": "3fe3adc2-28ea-3a2a-a004-28943d5a2e1c",
                                                "text": "L’excessif est un des cas du finnois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
