                                            {
                                                "example_id": "66377edb-1106-4baa-bb9e-44c2e0f56efe",
                                                "sense_id": "6e1ebff1-9606-3c30-b55a-a8fb66337648",
                                                "text": "By the time this mysterious knight died in the 1360s, his book was available in every European language, including Dutch, Gaelic, Czech, Catalan, and Walloon."
                                            },
                                            {
                                                "example_id": "2c18eb30-cf1f-4fd9-b020-0379f222e5be",
                                                "sense_id": "6e1ebff1-9606-3c30-b55a-a8fb66337648",
                                                "text": "She taught herself some Gaelic as a child. It’s hard to pronounce, and with no other Gaelic speakers around that she could practice on, she’s forgotten nearly all of what she learned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f8e9554-fd48-3caf-b27f-cabf77e0aabc",
