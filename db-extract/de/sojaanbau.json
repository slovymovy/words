                "senses": [
                    {
                        "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                        "entry_id": "02fc9a97-568a-3c06-8094-7c0493d04321",
                        "glosses": [
                            "geplantes Anpflanzen, Düngen, Wässern und Ernten von Sojabohnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c63d857-f89e-4f91-841a-acb41451a212",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Wie der Agrarbericht des Bundesamts für Landwirtschaft zeigt, legt der Sojaanbau in der Schweiz immer mehr zu.“"
                            },
                            {
                                "example_id": "50b1cdce-768f-4b5f-bb00-09e67c6d641a",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Der Sojaanbau breitet sich immer stärker aus; […].“"
                            },
                            {
                                "example_id": "3e89f3db-3a32-4c97-86e7-702ae5d1f666",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Zwischen 2000 und 2010 wurden allein in Südamerika 24 Millionen Hektar Land zu Ackerflächen für den Sojaanbau umgewandelt.“"
                            },
                            {
                                "example_id": "94d17400-c202-4456-a160-97a885be2fed",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "[Schlagzeile:] „Sojaanbau in Paraguay – Entwaldung für deutsches Tierfutter“"
                            },
                            {
                                "example_id": "0133357a-c9b8-4f08-b754-8d591deddd10",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Im Gebiet des Gran Chaco leben viele indigene Völker, denen durch den Sojaanbau die Lebensgrundlage entzogen wird.“"
                            },
                            {
                                "example_id": "3287b278-f18c-4665-9bbd-7b2abbbe1d16",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Die weltweite Ackerfläche für Sojaanbau ist 10 mal so groß wie ganz Deutschland.“"
                            },
                            {
                                "example_id": "d133c36d-3c28-4d0b-b864-55d14385983a",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Um mehr als ein Drittel ist der weltweite Sojaanbau für Fleischproduktion oder Biokraftstoff in den letzten 15 Jahren gestiegen. Die Folgen für Regenwälder wie den Amazonas sind verheerend.“"
                            },
                            {
                                "example_id": "d9311820-6a90-43d1-872c-8b3777f522c3",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "Der Sojaanbau geht oft zulasten des Regenwaldes."
                            },
                            {
                                "example_id": "3ff3f570-2d87-419f-9324-eb76e839e31e",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Der Sojaanbau hat auch zahlreiche negative Auswirkungen für das Klima und die Umwelt in den Anbauländern.“"
                            },
                            {
                                "example_id": "ad516946-df6e-4795-b5d3-543548d813c3",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„Seit in der EU wegen der Rinderkrankheit BSE das Verfüttern von Tiermehl verboten ist, erlebt der Sojaanbau einen Boom.“"
                            },
                            {
                                "example_id": "818de0aa-fe1e-47c1-8d7a-db4d49d2f2d2",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„»Regionalität der produzierten landwirtschaftlichen Güter sollten wieder eine wesentlich höhere Bedeutung erhalten, um so auf eine entsprechende Reduktion der Abholzung von Regenwald für den Sojaanbau hinzuwirken«, so eine Sprecherin des Ministeriums […].“"
                            },
                            {
                                "example_id": "10bae1f9-d056-432d-8283-b7bd6a9c07c4",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "„2012 wurden in den USA etwa 750 t Imidacloprid verwendet, davon knapp die Hälfte im Sojaanbau.“"
                            },
                            {
                                "example_id": "5b2e5669-357b-412e-b9e8-baafb555bddc",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "[Über die chemische Verbindung Picarbutrazox:] „Anwendung findet es als Saatgutbehandlungsmittel im Mais- und Sojaanbau, wo es gegen Phytophthora und Pythium wirken soll.“"
                            },
                            {
                                "example_id": "2ecb7d9c-0791-41ae-9731-9b009d12f1c7",
                                "sense_id": "c89648f7-6341-3eab-a7a3-07f475e3c750",
                                "text": "[Londrina(Brasilien:] „Größter Wirtschaftszweig der Stadt ist der Sojaanbau, gefolgt von Kaffeeanbau und anderen landwirtschaftlichen Erzeugnissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
