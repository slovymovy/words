                        ],
                        "examples": [
                            {
                                "example_id": "ea0af4f6-36bc-4c6b-86ba-20ecee4ac20f",
                                "sense_id": "f515e94d-3d16-3207-8298-999739f30f5c",
                                "text": "Die Orientierungssitzung, die Eschenbach wie jeden Montag um acht einberief, und bei der es zur Tradition gehörte, dass Kaffee und Gipfeli bereitstanden, brachte nichts Neues."
                            },
                            {
                                "example_id": "61591691-7088-40eb-9f2a-80a8f3b46ba4",
                                "sense_id": "f515e94d-3d16-3207-8298-999739f30f5c",
                                "text": "Um mir Mut zu machen, beschloss ich, zunächst zum nächsten Bäcker zu gehen, um Gipfeli zu holen."
                            }
                        ]
                    }
                ],
