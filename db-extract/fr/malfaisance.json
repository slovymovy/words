                                        "examples": [
                                            {
                                                "example_id": "db571b81-76c5-423b-9bda-6294b13e9cd7",
                                                "sense_id": "0f46023c-e7fe-3570-846d-8a43c93454ec",
                                                "text": "For starters, back-burnering malfeasance, usually in the form of graft, risks repeating the kind of disastrous mistakes that the United States made in Afghanistan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b18c4385-97a1-30ae-8fec-b34cb2d4a044",
                                        "entry_id": "eafd54ee-dd7a-366b-bf9e-d9f5a06af829",
                                        "glosses": [
                                            "Misconduct or wrongdoing, especially by a public official and causing damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a1c111-9c7f-49b6-8526-df9cc3053694",
                                                "sense_id": "b18c4385-97a1-30ae-8fec-b34cb2d4a044",
                                                "text": "By then, Mr. Altman had gathered more allies. Mr. Nadella, now confident that Mr. Altman was not guilty of malfeasance, threw Microsoft’s weight behind him."
                                            }
                                        ]
