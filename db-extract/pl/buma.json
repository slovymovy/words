                "senses": [
                    {
                        "sense_id": "5fd2910b-6fb3-3a1a-8abf-9ba2dd93baa4",
                        "entry_id": "b69c8c88-5d9f-3e77-aff0-dbf8355e2479",
                        "glosses": [
                            "BMW"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8e36de26-ff2d-438b-a7c8-8a3fcb2a1c68",
                                "sense_id": "5fd2910b-6fb3-3a1a-8abf-9ba2dd93baa4",
                                "text": "Gdyby nie to że mam bumę, to prawdopodobnie bym się nawet mocniej uśmiechnął niż teraz."
                            },
                            {
                                "example_id": "06f47461-f2b7-47e0-855f-103c9effb7c1",
                                "sense_id": "5fd2910b-6fb3-3a1a-8abf-9ba2dd93baa4",
                                "text": "Piszę, gdyż mam problem z moją bumą, otóż ostatnio borykam się ze spadkiem mocy, zaznaczam, że wymieniłem przewody podciśnieniowe, czyściłem elektrozaworki, […]"
                            },
                            {
                                "example_id": "5eaf8552-3ec1-4e36-9040-c514d4f6764f",
                                "sense_id": "5fd2910b-6fb3-3a1a-8abf-9ba2dd93baa4",
                                "text": "[…] też nie przepadałem za bumami, do czasu aż dane mi było ten sprzęt wypróbować. Żaden przednionapędowy dupowóz nie ma porównania."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
