                                    {
                                        "sense_id": "561a16a7-9b1b-3342-81cf-f571338e8d40",
                                        "entry_id": "2465bb42-feb8-3841-842a-4ff4f6c8c3b2",
                                        "glosses": [
                                            "Un million de quadrillions ou un million à la puissance cinq, soit 10³⁰."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0084fc15-622d-476a-8917-caa615af19a2",
                                                "sense_id": "561a16a7-9b1b-3342-81cf-f571338e8d40",
                                                "text": "Il a pu être synthétisé mi-août après 553 jours de bombardement d’une couche de bismuth par 130 quintillions (10³⁰) d’atomes de zinc dans l’accélérateur de particules du Riken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4940bd9-5338-3abf-bdc1-4f260e94cad6",
