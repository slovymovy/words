                    },
                    {
                        "translation_id": "3c62c24e-7233-40c7-8883-6d069f8d3746",
                        "source_entry_id": "952de415-cc44-3a7b-869f-3b602921af9a",
                        "source_sense_id": "6d499bbb-d01a-3af0-8141-682b6cc12e36",
                        "target_lang_word": "keynésianisme",
                        "target_lang_code": "fr",
