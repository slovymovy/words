                        "glosses": [
                            "getal dat een identificatiecode is voor een rekening bij een bank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66033c5e-7918-4206-8b14-114e84ad6e16",
                                "sense_id": "79509da4-6950-3729-a4dd-de341ec0a3b1",
                                "text": "Nederlanders die in de Verenigde Staten zijn geboren of een Amerikaanse ouder hebben, moeten belasting betalen in Amerika. Dat leidt tot problemen, want Nederlandse banken dreigen binnenkort hun bankrekeningnummer te blokkeren of op te heffen. Om dat te voorkomen, is nu een overgangsregeling bedacht."
                            },
                            {
                                "example_id": "ff6f66db-8853-42a3-8160-601ac7b494e3",
                                "sense_id": "79509da4-6950-3729-a4dd-de341ec0a3b1",
                                "text": "Uit jaarlijks onderzoek van de Consumentenbond bleek vorig jaar dat veel klanten wel willen overstappen, maar dat niet doen omdat het te veel gedoe is. Een van de drempels is het nieuwe bankrekeningnummer dat klanten bij een overstap krijgen."
                            }
                        ]
                    }
