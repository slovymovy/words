                    "target_lang_definitions": {
                        "ru": "Металлический брусок (квадрат), используемый для заполнения пробелов в строке при традиционном наборе текста.",
                        "zh": "传统印刷中用于填充行间空白的金属块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квадрат",
                                "target_lang_sense_clarification": "типографский пробельный материал"
