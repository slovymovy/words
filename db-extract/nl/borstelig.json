                    {
                        "sense_id": "811931d6-56c6-3719-a8b2-52459f2a3359",
                        "entry_id": "9fb2c5db-070a-3a10-9241-a7ec2696c9da",
                        "glosses": [
                            "ruigharig, ruwharig net zo als een borstel"
