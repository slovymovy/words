                {
                    "sense_id": "97ddcacc-70e9-34b0-85fb-863f2b800e9f",
                    "sense_definition": "Well-trodden or well-researched, previously explored.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explored",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor chose a topic that was not already <w>ploughed</w> by other researchers.",
                            "target_lang_translations": {
                                "de": "Der Professor wählte ein Thema, das nicht bereits von anderen Forschern <w>durchackert</w> worden war.",
                                "zh": "教授选择了一个尚未被其他研究人员<w>深入探讨</w>过的课题。",
                                "es": "El profesor eligió un tema que no había sido ya <w>trillado</w> por otros investigadores.",
                                "tr": "Profesör, diğer araştırmacılar tarafından henüz <w>derinlemesine incelenmemiş</w> bir konu seçti."
                            }
                        },
                        {
                            "text": "He wanted to find a new angle rather than writing on a well <w>ploughed</w> subject.",
                            "target_lang_translations": {
                                "de": "Er wollte einen neuen Blickwinkel finden, anstatt über ein bereits viel <w>durchackertes</w> Thema zu schreiben.",
                                "zh": "他想寻找一个新的切入点，而不是写一个已经被<w>反复研究</w>过的课题。",
                                "es": "Quería encontrar un nuevo enfoque en lugar de escribir sobre un tema muy <w>explorado</w>.",
                                "tr": "Üzerinde çok <w>çalışılmış</w> bir konu hakkında yazmak yerine yeni bir bakış açısı bulmak istedi."
                            }
                        }
                    ],
