                "senses": [
                    {
                        "sense_id": "9e0b422c-bd13-3e81-8dfc-60d70ff70fc6",
                        "entry_id": "b913442c-0709-3031-8d87-12c59e2cfd83",
                        "glosses": [
                            "bewoner van een stad, stadsbewoner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28ccbde-7458-47a3-9bd6-1959d4f4db3f",
                                "sense_id": "9e0b422c-bd13-3e81-8dfc-60d70ff70fc6",
                                "text": "Sinds het begin van de 21ste eeuw is meer dan de helft van de wereldbevolking een stedeling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c269737-0140-4c82-a854-4b4efe1c95b1",
                        "source_entry_id": "b913442c-0709-3031-8d87-12c59e2cfd83",
                        "source_sense_id": "9e0b422c-bd13-3e81-8dfc-60d70ff70fc6",
                        "target_lang_word": "Stadtbewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stadtbewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                        "entry_id": "5c778b3a-5204-3ffb-9747-851adce655fd",
                                        "glosses": [
                                            "Person, die in einer Stadt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53b3bda-f4e8-4bb7-9a74-d1fcd6b790de",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„Die planmäßige Durchgrünung von überbauten Gebieten trägt zur Linderung der negativen Auswirkungen von Stadtökosystemen bei, z.B. durch geringere Schwülebelastung im Hochsommer, Frischluftzufuhr oder durch visuelle und psychische Erholung für Stadtbewohner.“"
                                            },
                                            {
                                                "example_id": "f4f4e009-6cac-4f32-8d47-d85e971871df",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„Drei Viertel der afrikanischen Stadtbewohner leben in abstoßenden Slums und Squattersiedlungen.\""
                                            },
                                            {
                                                "example_id": "4e8ddb73-3853-4ac0-8315-c7e6f9d43a95",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„Britische Mediziner wollen sogar herausgefunden haben, dass Stadtbewohner ein deutlich höheres Risiko besitzen, an Psychosen zu erkranken.“"
                                            },
                                            {
                                                "example_id": "04832aa2-7431-4c66-a273-c72ccc2f8896",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„In der Tat hatte Robert, als er sich darauf besann, keinen der Stadtbewohner jemals rauchen sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "027b99d0-4dde-4b05-b9fc-476a2e9e9bef",
                        "source_entry_id": "b913442c-0709-3031-8d87-12c59e2cfd83",
                        "source_sense_id": "9e0b422c-bd13-3e81-8dfc-60d70ff70fc6",
                        "target_lang_word": "Städter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Städter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                        "entry_id": "9838ccf7-fcf3-3f19-b2c6-68a898bce732",
                                        "glosses": [
                                            "Person, die in einer Stadt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4f59ad-0c26-46ad-a054-7c2d58237485",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "Mein Kollege hieß Stetter und war Städter."
                                            },
                                            {
                                                "example_id": "d83ba071-970e-4af0-ab37-5e41a820c0e1",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Die Städter ackerten und asteten, bis sie in der grimmigen Kälte völlig durchgeschwitzt waren.“"
                                            },
                                            {
                                                "example_id": "a6e2dcbc-f2a5-4dfe-94e7-7e106b492301",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Ich bin nicht auf Landarbeit versessen, ich bin durch und durch Städter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bac1095-e72d-49a8-abee-251eb474d18e",
                        "source_entry_id": "b913442c-0709-3031-8d87-12c59e2cfd83",
                        "source_sense_id": "9e0b422c-bd13-3e81-8dfc-60d70ff70fc6",
                        "target_lang_word": "citizen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citizen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A resident of a city or town, especially one with legally recognized rights or duties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d13012-078e-479c-9000-66ca7c0fcdad",
                                                "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                                                "text": "[T]hat large body of the working men who were not counted as citizens and had not so much as a vote to serve as an anodyne to their stomachs were likely to get impatient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A legally recognized member of a state, with associated rights and obligations; a person considered in terms of this role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb44d00e-cc7f-4195-b9c0-eb8a20dd1cfe",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "I am a Roman citizen."
                                            },
                                            {
                                                "example_id": "ada4b222-0dd6-4f0e-8e09-3086b4b59b98",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "Assistant: You'll meet with the managing director and Dr Sinita Brahmachari, the engineer who designed the chair.\nPeter Mackenzie: Indian, is he?\nAssistant: She is a British citizen, Minister. Born in Coventry."
                                            },
                                            {
                                                "example_id": "20e989f2-1d1d-40e8-8d7c-aee57d9f43c9",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            },
                                            {
                                                "example_id": "a8faac22-f95c-4c36-9297-17a0ee3cae2b",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "He is also a citizen of Antigua, because he purchased a home – where he now resides with his family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "An inhabitant or occupant: a member of any place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdafd5d-ba2c-48a1-accd-6a006de13e03",
                                                "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                                "text": "Diogenes reckoned himself a citizen of the world."
                                            },
                                            {
                                                "example_id": "3d96c168-5fa4-4c8b-933f-f895b775fd95",
                                                "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                                "text": "A jellyfish... carries poison cells that can sting other citizens of the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5c5c64-3ca2-3add-bdfd-adb3a4e359d8",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A resident of the heavenly city or (later) of the kingdom of God: a Christian; a good Christian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad3b978a-95d4-34a7-b748-2c7e56352fd4",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A civilian, as opposed to a police officer, soldier, or member of some other specialized (usually state) group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eb707cd-5377-36d0-9a2a-c7d455f6a489",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "An ordinary person, as opposed to nobles and landed gentry on one side and peasants, craftsmen, and laborers on the other."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0162a3-fc2b-44f1-a36b-11a6676b669f",
                                                "sense_id": "6eb707cd-5377-36d0-9a2a-c7d455f6a489",
                                                "text": "[W]ould Mr. Delvile, who hardly ever spoke but to the high-born, without seeming to think his dignity somewhat injured, deign to receive for a daughter in law the child of a citizen and tradesman?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A term of address among supporters of the French Revolution in France or elsewhere; (later, dated) a term of address among socialists and communists."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b38505-a36c-47b2-ad0e-8a672d303113",
                                                "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                                                "text": "Citizen, I desire nothing more than to get to Paris, though I could dispense with the escort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A notional inhabitant of a software system; an object or a software application."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff3b5fe-d30b-4384-be71-be75784d5249",
                                                "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                                                "text": "The HIG delivers Apple's design commandments, the company's definition of what it means to be a good iPhone citizen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a5f1b9-8677-4bf4-b592-3e88410024d9",
                        "source_entry_id": "b913442c-0709-3031-8d87-12c59e2cfd83",
                        "source_sense_id": "9e0b422c-bd13-3e81-8dfc-60d70ff70fc6",
                        "target_lang_word": "citadin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citadin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2428a7e-346c-35d1-af2f-b7018fade7e0",
                                        "entry_id": "c8f16c49-b3cf-388d-8270-43fb684f2b6b",
                                        "glosses": [
                                            "Celui qui habite une ville ou une zone urbaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eda4781-3fba-4440-ba68-13ada8695dda",
                                                "sense_id": "b2428a7e-346c-35d1-af2f-b7018fade7e0",
                                                "text": "[…] ô riche et chanceux Hérault, toi qui verses au cœur des citadins déprimés l'intarissable joie liquide de tes litres vendus par toi trente sous et revendus, par l'épicier ou sur le zinc, trois francs."
                                            },
                                            {
                                                "example_id": "eff90df8-3826-4d35-897b-314d1d5581ba",
                                                "sense_id": "b2428a7e-346c-35d1-af2f-b7018fade7e0",
                                                "text": "Pour le monde développé , le XIXᵉ siècle est le siècle par excellence de l’urbanisation. Pour l'Europe (sans la Russie), le nombre de citadins (critère des 2 mille habitants) passe de 31 millions en 1800 à 170 millions en 1910."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "citadin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f052973f-b1e1-34ac-84cf-24aac72fea3d",
                                        "entry_id": "06c7ec26-66df-3ace-b060-3a53c75718e8",
                                        "glosses": [
                                            "Qui vit dans une ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd3bc55-0970-48aa-bf59-6cb083222840",
                                                "sense_id": "f052973f-b1e1-34ac-84cf-24aac72fea3d",
                                                "text": "Au moment des luttes politiques, les électeurs du Léon, encadrés par leurs prêtres, font, grâce à leur discipline, échec aux aspirations sociales des populations citadines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
