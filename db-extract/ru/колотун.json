                        "tags": [],
                        "examples": [
                            {
                                "example_id": "503fc7ff-cb11-427e-b9c8-643dfb480d13",
                                "sense_id": "7205d1f4-3b34-3edd-9b2a-dd1171e7cffb",
                                "text": "Я перешёл через дорогу, сел в машину, на заднее сиденье в угол, и меня охватил такой колотун, что я придерживал челюсть рукой, чтобы не стучали зубы."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb8486cc-fdee-3a5f-8b06-53bea7d2c023",
                        "entry_id": "7a645e94-700d-3911-ba99-e05998882c77",
                        "glosses": [
                            "разг. сильный холод"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0d08da7-1158-46a9-880b-065dee82cf3f",
                                "sense_id": "fb8486cc-fdee-3a5f-8b06-53bea7d2c023",
                                "text": "Слышь, земеля, у вас в роте тоже колотун?"
                            }
                        ]
                    }
