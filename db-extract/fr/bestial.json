            {
                "entry_id": "ea04afbd-817f-353b-91c5-f5dc2253b47d",
                "word": "bestial",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d09521ff-5973-4929-b664-fc8a85ed9c91",
                        "entry_id": "ea04afbd-817f-353b-91c5-f5dc2253b47d",
                        "tags": [
