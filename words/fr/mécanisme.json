                    "frequency": "High",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'horloger a démonté soigneusement le <w>mécanisme</w> de la vieille pendule pour le réparer."
                        },
                        {
                            "text": "Le voleur a réussi à bloquer le <w>mécanisme</w> de fermeture de la porte coulissante."
                        }
                    ],
                    "synonyms": [
                        "dispositif",
                        "rouage",
                        "appareil"
                    ],
                    "common_phrases": [
