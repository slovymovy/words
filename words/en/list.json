    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "620e0700-a8f4-3a1a-a485-cb91dd8c984a",
                    "sense_definition": "A series of names, words, or numbers written down or printed, typically one below the other.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "record_series",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I made a shopping <w>list</w> so I would not forget anything at the store.",
                            "target_lang_translations": {
                                "ru": "Я составил <w>список</w> покупок, чтобы ничего не забыть в магазине.",
                                "zh": "我写了一份购物<w>单子</w>，这样在商店里就不会忘记买什么了。"
                            }
                        },
                        {
                            "text": "Please check the guest <w>list</w> to see if your name is included.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте <w>список</w> гостей, чтобы узнать, есть ли там ваше имя.",
                                "zh": "请查看一下宾客<w>列表</w>，看看有没有你的名字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shopping list",
                        "to-do list",
                        "make a list",
                        "on the list",
                        "bucket list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд имен, слов или чисел, записанных или напечатанных, обычно одно под другим.",
                        "zh": "一系列书写或打印出来的名字、词语或数字，通常一个接一个地排列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "список",
                                "target_lang_sense_clarification": "перечень имен или предметов"
                            },
                            {
                                "target_lang_word": "перечень",
                                "target_lang_sense_clarification": "список, перечисление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "列表",
                                "target_lang_sense_clarification": "将资料依次呈现的清单"
                            },
                            {
                                "target_lang_word": "单子",
                                "target_lang_sense_clarification": "口语中常用的清单"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51fdf1eb-a066-3ce1-93a2-18f9cb3cc822",
                    "sense_definition": "A leaning or tilting to one side, especially of a ship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tilt_lean",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damaged vessel developed a severe <w>list</w> to starboard after the storm.",
                            "target_lang_translations": {
                                "ru": "У поврежденного судна появился сильный <w>крен</w> на правый борт после шторма.",
                                "zh": "风暴过后，受损的船只向右舷严重<w>倾斜</w>。"
                            }
                        },
                        {
                            "text": "Due to the shifting cargo, the ferry had a noticeable <w>list</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за смещения груза у парома был заметный <w>крен</w>.",
                                "zh": "由于货物移位，渡轮出现了明显的<w>侧倾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a list",
                        "list to port",
                        "list to starboard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклон судна на один бок.",
                        "zh": "向一侧倾斜，尤指船只。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крен",
                                "target_lang_sense_clarification": "наклон судна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "物体偏离垂直位置"
                            },
                            {
                                "target_lang_word": "侧倾",
                                "target_lang_sense_clarification": "船只或车辆向一侧倾斜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ee81b57-d3c3-3051-a537-3133faa99712",
                    "sense_definition": "An enclosed area where knights fought in tournaments in the past.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jousting_arena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave knights rode into the <w>lists</w> to compete for the king's favor.",
                            "target_lang_translations": {
                                "ru": "Храбрые рыцари выехали на <w>ристалище</w>, чтобы побороться за благосклонность короля.",
                                "zh": "勇敢的骑士们骑马进入<w>比武场</w>，争夺国王的青睐。"
                            }
                        },
                        {
                            "text": "He challenged his rival to meet him in the <w>lists</w> at dawn.",
                            "target_lang_translations": {
                                "ru": "Он вызвал своего соперника встретиться на <w>ристалище</w> на рассвете.",
                                "zh": "他向对手发起挑战，约定在黎明时分于<w>比武场</w>决斗。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter the lists"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огороженное место, где в прошлом рыцари сражались на турнирах.",
                        "zh": "过去骑士在锦标赛中进行比武的封闭场地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ристалище",
                                "target_lang_sense_clarification": "место для рыцарских турниров"
                            },
                            {
                                "target_lang_word": "арена",
                                "target_lang_sense_clarification": "место состязаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "比武场",
                                "target_lang_sense_clarification": "古代骑士竞技的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a3445b9-140f-3c5e-8ae7-4eff29a85720",
                    "sense_definition": "Cunning, skill, or craftiness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cunning_skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fox is often described in fables as a creature full of <w>list</w>.",
                            "target_lang_translations": {
                                "ru": "Лису в баснях часто описывают как существо, полное <w>хитрости</w>.",
                                "zh": "在寓言中，狐狸常被描述为一种充满<w>机敏</w>的生物。"
                            }
                        },
                        {
                            "text": "He won the battle not by strength, but by <w>list</w> and strategy.",
                            "target_lang_translations": {
                                "ru": "Он выиграл битву не силой, а <w>хитростью</w> и стратегией.",
                                "zh": "他赢得这场战斗靠的不是力量，而是<w>机敏</w>和策略。"
                            }
                        }
