                "senses": [
                    {
                        "sense_id": "f26c163f-efa1-3d86-a66b-034ec9db1d2d",
                        "entry_id": "2479c978-4a2c-3a8d-a982-368efd6cb8d0",
                        "glosses": [
                            "Zeitraum, den man verstreichen lässt, bevor man unpassende oder zum vorhergehenden Vorgehen widersprüchliche Maßnahmen setzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ae7a09-06cc-4d81-af65-f8fa14ed7b29",
                                "sense_id": "f26c163f-efa1-3d86-a66b-034ec9db1d2d",
                                "text": "„Welche Schamfrist muss ein Steinmetz verstreichen lassen, bevor er die trauernden Angehörigen per Werbebrief von seinem Angebot an Grabsteinen in Kenntnis setzen darf?“"
                            },
                            {
                                "example_id": "45ec6783-6211-48fe-a963-7cd0e0fac712",
                                "sense_id": "f26c163f-efa1-3d86-a66b-034ec9db1d2d",
                                "text": "„Nach einer Schamfrist meldet sich die ‚Klon-Werkstatt‘ des der Fälschung überführten südkoreanischen Professors Hwang Woo-suk zurück.“"
                            },
                            {
                                "example_id": "8af0d31a-8764-4daa-8c62-8f46b786d60f",
                                "sense_id": "f26c163f-efa1-3d86-a66b-034ec9db1d2d",
                                "text": "„‚Wenn wir einen Vorschlag machen - und ich noch dazu -, dann kommt zunächst Entrüstung, bundesweite Entrüstung. Dann vergeht eine gewisse Schamfrist. Dann kommt die Ernüchterung. Dann vergeht wieder eine gewisse Schamfrist. Und dann kommt die Zustimmung.‘ Das, so Seehofer, sei ein Naturgesetz.“"
                            },
                            {
                                "example_id": "8fead015-8397-4982-b676-854dcfe2ebce",
                                "sense_id": "f26c163f-efa1-3d86-a66b-034ec9db1d2d",
                                "text": "„Eine Indiskretion hat zu Jahresbeginn offenbart, was eigentlich erst nach einer mehrmonatigen Schamfrist bekanntwerden sollte.“"
                            },
                            {
                                "example_id": "df5f0068-3765-4cd4-85bd-79a85bc03b62",
                                "sense_id": "f26c163f-efa1-3d86-a66b-034ec9db1d2d",
                                "text": "„Damit würde Weber genau die einjährige Schamfrist einhalten, die sich Notenbanker nach ihrem Ausscheiden aus dem Amt auferlegt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
