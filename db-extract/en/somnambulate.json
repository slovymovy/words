                        ]
                    },
                    {
                        "translation_id": "da5f1a46-0963-499f-ae8b-2cf0aa4445db",
                        "source_entry_id": "b2db2e56-5f30-3942-bcc8-bb0c29676a63",
                        "source_sense_id": "0f81ecae-552d-3fdb-ade4-0b598c79c165",
                        "source_sense_description": "to walk while sleeping",
                        "target_lang_word": "somnambuler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somnambuler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88222872-a330-3e32-8013-9a635a79f209",
                                        "entry_id": "40ffc623-a3ef-3d49-a454-5bd551a3566e",
                                        "glosses": [
                                            "Agir en somnambule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0dc0e4-15c1-4176-b56d-603675452336",
                                                "sense_id": "88222872-a330-3e32-8013-9a635a79f209",
                                                "text": "Bref il va sûrement somnambuler cette nuit."
                                            },
                                            {
                                                "example_id": "247a6ff7-dc05-4e51-8a5c-04eb5ca7df5b",
                                                "sense_id": "88222872-a330-3e32-8013-9a635a79f209",
                                                "text": "L’apathie soudaine qu’il ressentait ne l’étonna pas vraiment, il somnambulait depuis des mois, se regardait agir comme s’il était un autre, économisant au maximum sa participation à sa propre vie."
                                            },
                                            {
                                                "example_id": "c6f7428e-ad1b-4d00-825d-a25625cc0f36",
                                                "sense_id": "88222872-a330-3e32-8013-9a635a79f209",
                                                "text": "Fernandel continue à somnambuler, Brigitte et Linda se roulent des pelles, Monk joue Trinkle Tinkle en quartet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b66470c4-6d90-4380-8b8c-8ac6cfe16974",
                        "source_entry_id": "b2db2e56-5f30-3942-bcc8-bb0c29676a63",
                        "source_sense_id": "0f81ecae-552d-3fdb-ade4-0b598c79c165",
                        "source_sense_description": "to walk while sleeping",
                        "target_lang_word": "schlafwandeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlafwandeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                        "entry_id": "c4e9c052-b5b9-38d6-b1c7-7e83f942b2cb",
                                        "glosses": [
                                            "im Schlafzustand herumgehen und handeln, ohne sich dessen bewusst zu sein"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0ed154-e712-499c-97e0-289fb5880a5a",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Wer schlafwandelt, ist nur halb wach."
                                            },
                                            {
                                                "example_id": "4f3ef3d4-00cf-4af5-86af-3ccb94e1ab7b",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Möglicherweise gibt es einen Zusammenhang mit unvollständigen Reifungsprozessen im zentralen Nervensystem. Dadurch wäre auch zu erklären, dass Kinder sehr viel häufiger schlafwandeln als Erwachsene."
                                            },
                                            {
                                                "example_id": "b61f345a-1511-4fc8-860a-d0b3e9b1127f",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Die Frau sei mit Alkohol und Schlaftabletten im Blut geschlafwandelt, erklärte der Richter."
                                            },
                                            {
                                                "example_id": "6eae7b2b-2059-4447-a578-a2ed84470ac1",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Mehr als ein Viertel der Studienteilnehmer gab an, sie hätten als Kind geschlafwandelt, aber nicht mehr in den letzten Jahren."
                                            },
                                            {
                                                "example_id": "876fa9c4-acc8-4499-a9c7-6f8107fb1fdd",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Wenn der Erdtrabant in voller Pracht am Firmament leuchtet, verliert so mancher den Verstand, schlafwandelt, fängt wolfsgleich an zu heulen oder legt gar Hand an seinen Nächsten."
                                            },
                                            {
                                                "example_id": "78f0c777-f4a7-4509-bf7a-edb418bc3270",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Ich habe gesehen, wie es diesen Burschen geht, wenn sie nachts weinten und schlafwandelten."
                                            },
                                            {
                                                "example_id": "5b8d335b-f13b-4d9a-99ac-1e328e5721c5",
                                                "sense_id": "14d7338c-245b-333c-b48f-b1f2c2cb9e01",
                                                "text": "Er [Christopher Clark] geht vielmehr davon aus, dass die von ihm hinsichtlich ihrer politischen und mentalen Dispositionen untersuchten europäischen Staatsmänner in den Krieg schlafwandelten, sich der Tragweite ihres Handels nicht voll bewusst waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3147c7c9-4a6a-4f83-a5cf-7de8b5ab7c13",
                        "source_entry_id": "b2db2e56-5f30-3942-bcc8-bb0c29676a63",
                        "source_sense_id": "0f81ecae-552d-3fdb-ade4-0b598c79c165",
                        "source_sense_description": "to walk while sleeping",
                        "target_lang_word": "nachtwandeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachtwandeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab024c6-0a34-33a1-b23b-c075f5329647",
                                        "entry_id": "72ad4dca-dd2c-36ca-b2aa-84fea990add9",
                                        "glosses": [
                                            "aufstehen und gehen, während man schläft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba03a42f-797d-4e6f-84e3-874ceacd6d4f",
                                                "sense_id": "7ab024c6-0a34-33a1-b23b-c075f5329647",
                                                "text": "„Ich schalte hier ein, daß andere Nachtwandler ihr Bett oft nicht wiederfinden können, wie dies auch bei einem kleinen Mädchen der Fall war, das ebenfalls im Alter von 8–10 Jahren nachtwandelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
