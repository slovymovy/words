                        "target_lang_word": "sériosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sériosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "accbf839-651f-3797-9890-87bb7e605967",
                                        "entry_id": "c2ed440c-73b9-3a31-b680-5731ede83f28",
                                        "glosses": [
                                            "Caractère de ce qui est sérieux ; qualité d’une personne ou d’une chose sérieuse."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e1c1749-ca9e-4d4f-a0e5-8c049ca0fede",
                                                "sense_id": "accbf839-651f-3797-9890-87bb7e605967",
                                                "text": "Avec la sériosité d’un « Herr Professor » mon amie a répondu qu’en Roumanie tous les gens bien parlaient français !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a6bf7c-3917-3225-9383-6492e0badfa7",
                                        "entry_id": "c2ed440c-73b9-3a31-b680-5731ede83f28",
                                        "glosses": [
                                            "Tendance à tout prendre au sérieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6e8616-b516-45f3-9053-275634b7f7c8",
                                                "sense_id": "42a6bf7c-3917-3225-9383-6492e0badfa7",
                                                "text": "Il y a eu des civilisations florissantes, des civilisations de bâtisseurs, des civilisations artistiques ; la civilisation actuelle est sérieuse. Une vague de sériosité la submerge."
                                            },
                                            {
                                                "example_id": "b6d2d88e-3d59-4233-b93e-07ea35b31177",
                                                "sense_id": "42a6bf7c-3917-3225-9383-6492e0badfa7",
                                                "text": "La « sériosité », cette maladie qui consiste à être sérieux tout le temps, est génératrice d’un terrible ennui … »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "642ea1e0-7376-45f0-b792-48d53ea9f142",
                        "source_entry_id": "b73c1504-5415-3014-b3fb-c85e200f5d94",
                        "source_sense_id": "f74dbf7c-7fe7-3c3e-812b-4e371b019caa",
                        "source_sense_description": "state of being serious",
                        "target_lang_word": "gravité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d25723f9-5a44-3cd3-bb17-948f383db25c",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Champ de force gravitationnel d’un corps massif ; pesanteur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c697853-3510-4418-8f53-3c3b3be3e0aa",
                                                "sense_id": "d25723f9-5a44-3cd3-bb17-948f383db25c",
                                                "text": "La matière solide contenue dans la vis reste dans la zone d’interpénétration ou tombe par gravité dans la partie basse du chenal, où elle est poussée par les filets arrières […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Sentiment ou qualité d’une personne ou d’une chose grave ; l’air, le ton grave et sérieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3711e8-6b62-4203-a5d9-1c3b332f7cd6",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "[…] en outre, la gravité de son maintien et de son langage, et aussi bien le ton sonore qu’il affectait en parlant de l’autorité de l’Église et du clergé, engageait chacun à le tenir presque en odeur de sainteté."
                                            },
                                            {
                                                "example_id": "38333746-5df6-4e4f-b918-bbf48db99458",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "Lorsque tout le monde fut assis, il y eut un moment de silence, pendant lequel la gravité du président parut se communiquer à l’assemblée."
                                            },
                                            {
                                                "example_id": "1fda53d4-edc4-4723-9f4f-62082e041878",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "La physionomie de la Renaude prit une expression de gravité et de tristesse profonde."
                                            },
                                            {
                                                "example_id": "4b7afdfe-e984-48c0-8b5f-d00e944c78fb",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "L’animal sortait de sa torpeur, ouvrait ses yeux d’or, faisait mine d’allonger sa patte griffue. Puis il bâillait voluptueusement, et se rendormait aussitôt ; car c’était une bête raisonnable, à qui l’âge avait donné toutes sortes de gravités."
                                            },
                                            {
                                                "example_id": "10e6e31c-6084-40ee-8a93-6628c46dd43d",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "Une question doit alors être posée dans toute sa gravité : en France, l’antisémitisme nouveau est-il arrivé sous le couvert de l’antisionisme ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Grande importance ; lourde conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e17a864-0dba-4e07-a197-bca5395e7c7e",
                                                "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                                "text": "Cette gravité de l’œuvre poursuivie par le prolétariat ne saurait convenir à la clientèle jouisseuse de nos politiciens."
                                            },
                                            {
                                                "example_id": "374c3026-ff82-4a9d-95a6-c9a72a1bea2a",
                                                "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                                "text": "Je ne me pardonne pas d’être né. C’est comme si, en m’insinuant dans ce monde, j’avais […] commis une faute d’une gravité sans nom."
                                            },
                                            {
                                                "example_id": "a565f452-282d-4914-9276-c9f5031f1edd",
                                                "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                                "text": "On connait plus de 300 arbovirus, et on en isole toujours de nouveaux […] Parmi les infections qu’ils provoquent, il faut citer à cause de leur grande incidence et de leur gravité la fièvre jaune, les méningo-encéphalites américaines, l’encéphalite japonaise B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38050bed-3c85-3f53-b922-36ed1d09b367",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Caractère d’un son quelconque par rapport aux sons plus élevés, dans l’échelle générale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e871affe-3e36-48f9-bf48-616ea9e49014",
                                                "sense_id": "38050bed-3c85-3f53-b922-36ed1d09b367",
                                                "text": "Un son a plus ou moins de gravité selon que la corde qui le rend a plus ou moins de grosseur, plus ou moins de longueur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gravité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56e9a968-417c-356a-a1b5-5ab2da5fd67e",
                                        "entry_id": "f6df0764-cb61-371e-92be-46b119b4444e",
                                        "glosses": [
                                            "Participe passé masculin singulier de graviter."
                                        ],
