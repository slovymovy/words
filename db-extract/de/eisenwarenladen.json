                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80d6e4a-d73e-40ee-bbf1-dddb13bd6dfd",
                                "sense_id": "dfe95bd5-df48-3e26-a18f-eb779874b396",
                                "text": "„Die Mutter hatte den kleinen Eisenwarenladen geführt, während Louis in der Schule glänzte.“"
                            },
                            {
                                "example_id": "e556c1fd-ee20-4732-96c7-0f4b21f8fd23",
                                "sense_id": "dfe95bd5-df48-3e26-a18f-eb779874b396",
                                "text": "„Wenn Sie ’n Moment Zeit haben, zeig ich Ihnen, wie man ’ne Axt so herrichtet, dass sie doppelt so gut schneidet wie jedes Stück Schund, das Sie nagelneu im Eisenwarenladen kaufen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
