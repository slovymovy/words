                    },
                    {
                        "form_id": "ceb29d8e-9a1d-436b-aa4b-e844327a1bc3",
                        "entry_id": "ff07f594-d001-3c08-881c-b222c233ed6b",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "caressante"
                    },
                    {
                        "form_id": "fe32e06c-4a18-4fd1-b433-280b366078a2",
                        "entry_id": "ff07f594-d001-3c08-881c-b222c233ed6b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "caressantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02b3688c-579d-38fb-9b33-9a7d4b0b1f80",
                        "entry_id": "ff07f594-d001-3c08-881c-b222c233ed6b",
                        "glosses": [
                            "Qui aime à caresser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9530c110-fbc0-4042-a6dd-8f8f3e25f454",
                                "sense_id": "02b3688c-579d-38fb-9b33-9a7d4b0b1f80",
                                "text": "Cet enfant est fort caressant. Il est d’humeur caressante. Un chien caressant."
                            },
                            {
                                "example_id": "93c3560c-0a14-4164-9929-257dbf564d3d",
                                "sense_id": "02b3688c-579d-38fb-9b33-9a7d4b0b1f80",
                                "text": "Elle vécut au jour le jour, comme une enfant, comme une bête caressante qui cède à ses instincts."
                            }
                        ]
                    },
                    {
                        "sense_id": "300f749f-16e0-3bdf-93c0-139c6bd40f07",
                        "entry_id": "ff07f594-d001-3c08-881c-b222c233ed6b",
                        "glosses": [
                            "Se dit de l’air, des manières, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4333dd9f-9249-484f-9133-91f9424f730c",
                                "sense_id": "300f749f-16e0-3bdf-93c0-139c6bd40f07",
                                "text": "Ces morceaux câlins, naïfs, pleins de tendresse, ces vers calmes, purs comme la glace des lacs ; cette caressante poésie femelle a pour auteur un petit ambitieux, …."
                            },
                            {
                                "example_id": "f58c9958-1d3c-4d8e-98bb-1b7e7708546c",
                                "sense_id": "300f749f-16e0-3bdf-93c0-139c6bd40f07",
                                "text": "Quand les mots ont été très caressants, nous nous taisons pour sentir leur douceur s’élargir à l’infini et, d’un accord spontané, nous nous retournons pour attendre les parents qui sourient derrière nous…"
                            },
                            {
                                "example_id": "c9d67552-0b74-4e98-a737-126b3e2540bc",
                                "sense_id": "300f749f-16e0-3bdf-93c0-139c6bd40f07",
                                "text": "La voix se posait sur le nom de Marino avec cette nuance de respect caressant rituelle à l’Amirauté, et qui ce soir m’était insupportable."
                            },
                            {
                                "example_id": "1098d747-f947-40a3-9b0e-6c90e66460a9",
                                "sense_id": "300f749f-16e0-3bdf-93c0-139c6bd40f07",
                                "text": "Je pensais moins aux livres, aux tableaux, aux films, qu’à cette lumière caressante dans ses yeux quand je lui parlais de moi."
                            },
                            {
                                "example_id": "a7a14697-d1a0-4cf2-af69-236f059757c9",
                                "sense_id": "300f749f-16e0-3bdf-93c0-139c6bd40f07",
                                "text": "Je ne me souviens pas du tout d’elle, mais je sens sa présence par les petites lettres caressantes qu’elle m’envoie de là-bas, par ces boîtes en bois tendre gravées de jolies images dont on peut suivre les contours creux avec son doigt, ces coupes de bois peint couvertes d’un vernis doux au toucher…"
                            }
                        ]
                    }
                ],
