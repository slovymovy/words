    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "33890a79-88a8-37db-b5c0-80f7ac3ea972",
                    "sense_definition": "À quel endroit, dans quel lieu ou vers quel lieu.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Où</w> habitez-vous depuis votre arrivée en France ?"
                        },
                        {
                            "text": "Je ne sais pas par <w>où</w> passer pour éviter les embouteillages."
                        }
                    ],
                    "common_phrases": [
                        "par où passer",
                        "savoir où aller"
                    ]
                },
                {
                    "sense_id": "7e9f793d-51c4-3cfb-adf7-0f38a6a4277b",
                    "sense_definition": "Dans lequel, auquel ou vers lequel, en marquant le lieu.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est la maison <w>où</w> mes grands-parents ont vécu pendant cinquante ans."
                        },
                        {
                            "text": "Nous retournons souvent dans l'endroit <w>où</w> nous nous sommes rencontrés."
                        }
                    ],
                    "common_phrases": [
                        "l'endroit où",
                        "la ville où",
                        "la maison où"
                    ]
                },
                {
                    "sense_id": "28df13c2-70e5-392c-81f5-33c8ac8a77d1",
                    "sense_definition": "À quel moment, pendant lequel ou au cours duquel, en parlant du temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me souviens très bien du jour <w>où</w> nous avons acheté cette voiture."
                        },
                        {
                            "text": "Le téléphone a sonné exactement au moment <w>où</w> je fermais la porte."
                        }
                    ],
                    "common_phrases": [
                        "au moment où",
                        "le jour où",
                        "à l'heure où"
                    ]
                },
                {
                    "sense_id": "998ff02b-f371-31c1-b803-69b1c49694f3",
                    "sense_definition": "Dans quelle situation ou dans quel état.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous me dire <w>où</w> en est le projet de rénovation ?"
                        },
                        {
                            "text": "Après cette longue discussion, nous ne savons plus très bien <w>où</w> nous en sommes."
                        }
                    ],
                    "common_phrases": [
                        "où en est",
                        "savoir où en est"
                    ]
                }
            ]
        }
    ]
