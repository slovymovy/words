                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa7059da-3bee-4d6c-8a08-472b0c8f3427",
                        "source_entry_id": "7cce4711-9ad6-37c6-9bc5-73b3cd5cdcd2",
                        "source_sense_id": "613c07a7-ad19-3c36-b0dd-2fa17edfb570",
                        "source_sense_description": "umgangssprachlich: Loser, Versager, Verlierer",
                        "target_lang_word": "Loser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Loser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e041530-1cc2-3458-9cce-e2ade31e83bf",
                                        "entry_id": "bbc96f7b-1f27-3e3c-ac7c-fa6c680516a1",
                                        "glosses": [
                                            "Jugendsprache, Verlierer, Versager"
                                        ],
                                        "tags": [
                                            "Yuppiesprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b45f79-52a7-4a39-855a-576ee1824eda",
                                                "sense_id": "1e041530-1cc2-3458-9cce-e2ade31e83bf",
                                                "text": "Loser! Verlierer!"
                                            },
                                            {
                                                "example_id": "243249a9-b193-4c60-b778-777df7d60828",
                                                "sense_id": "1e041530-1cc2-3458-9cce-e2ade31e83bf",
                                                "text": "„Die Loser Europas sahen den Kapitalismus als einen Weg in ein anderes Leben an, und dieser Glaube wurde von Generation zu Generation weitergegeben.“"
                                            },
                                            {
                                                "example_id": "f7bb28e2-2dcb-4d59-9cd3-f446cfc5160f",
                                                "sense_id": "1e041530-1cc2-3458-9cce-e2ade31e83bf",
                                                "text": "„Der zweite machte ihr einen Sohn und wurde irgendwann ein Säufer, ein Loser (seine Arztpraxis wurde zwangsgeräumt), ein Schuldengangster und (Ehefrau-)Schläger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03cf9d7d-badc-3b07-bbf9-16f15b1ab172",
                                        "entry_id": "bbc96f7b-1f27-3e3c-ac7c-fa6c680516a1",
                                        "glosses": [
                                            "Trottel"
                                        ],
                                        "tags": [
                                            "Jugendsprache derb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b385b9e-ba51-4492-ac0e-c9509fdf63ac",
                                                "sense_id": "03cf9d7d-badc-3b07-bbf9-16f15b1ab172",
                                                "text": "Schau dir mal den Loser an, der trägt sein Hemd verkehrt herum."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Loser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51c6dabb-b512-356c-b03a-f6054e3881c9",
                                        "entry_id": "03914f7e-8005-35cb-a262-db2f50c80422",
                                        "glosses": [
                                            "Mann, der es mit der Tugend nicht so genau nimmt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f619374-fd39-4913-a18d-6d671d88fb57",
                                                "sense_id": "51c6dabb-b512-356c-b03a-f6054e3881c9",
                                                "text": "Du Loser, du Lieber, da bist du ja!"
                                            },
                                            {
                                                "example_id": "6e0171b3-7be0-4c9e-aa22-f1e85cae7b03",
                                                "sense_id": "51c6dabb-b512-356c-b03a-f6054e3881c9",
                                                "text": "Du bist mir ja ein ganz Loser, du!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c46e581d-2b53-49df-8d03-41878e7268ad",
                        "source_entry_id": "7cce4711-9ad6-37c6-9bc5-73b3cd5cdcd2",
                        "source_sense_id": "613c07a7-ad19-3c36-b0dd-2fa17edfb570",
                        "source_sense_description": "umgangssprachlich: Loser, Versager, Verlierer",
                        "target_lang_word": "Versager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                        "entry_id": "6ff6b2ea-a8df-3829-8aba-e2202e690271",
                                        "glosses": [
                                            "Person, die sehr häufig nicht das Erwartete erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584ae27c-3968-4de3-8004-e363bc9f0ccd",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "Schon wieder nichts verkauft! Du bist echt ein Versager!"
                                            },
                                            {
                                                "example_id": "0100c27d-2fe6-40eb-87aa-8b343f916e00",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "„Doch nicht nur Gabi, auch Mutter hat in mir den typischen Versager gesehen.“"
                                            },
                                            {
                                                "example_id": "6a23b684-1ff2-4dcf-9552-f868ec9ad433",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "Männer mit Erektionsstörungen fühlen sich schnell als Versager."
                                            },
                                            {
                                                "example_id": "4547057b-48cc-45ab-be4b-e06f97c7a5a0",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "„Mein Vater hatte mir gesagt, ich würde immer ein Versager sein.“"
                                            },
                                            {
                                                "example_id": "e80e7a5a-3a97-4b40-9813-9becdbe4e997",
                                                "sense_id": "80271feb-ee18-3a9b-87d6-1e2c76ca552a",
                                                "text": "„Mugabe zeigte immer großes Geschick bei Machtkämpfen und als Propagandist, während er als Wirtschaftspolitiker ein Versager war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a39a279b-718f-363f-8c54-78bd26d9b536",
                                        "entry_id": "6ff6b2ea-a8df-3829-8aba-e2202e690271",
                                        "glosses": [
                                            "etwas, das nicht den Anforderungen entspricht und/oder den erhofften Erfolg hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb2d559-6dc9-4eb3-81f2-8a93dad77dc1",
                                                "sense_id": "a39a279b-718f-363f-8c54-78bd26d9b536",
                                                "text": "Sein neuerster Roman ist ein Versager."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34200a56-2c14-3717-8662-9e93380d5938",
                                        "entry_id": "6ff6b2ea-a8df-3829-8aba-e2202e690271",
                                        "glosses": [
                                            "plötzliches, meist kurzes Aussetzen oder Versagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5550b069-21a4-4d7b-9786-8baeeb2775c2",
                                                "sense_id": "34200a56-2c14-3717-8662-9e93380d5938",
                                                "text": "Die Eiskunstläuferin hatte einige Versager in der Kür."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b48af236-3443-4101-9020-eaf91815dbb9",
                        "source_entry_id": "7cce4711-9ad6-37c6-9bc5-73b3cd5cdcd2",
                        "source_sense_id": "613c07a7-ad19-3c36-b0dd-2fa17edfb570",
                        "source_sense_description": "umgangssprachlich: Loser, Versager, Verlierer",
                        "target_lang_word": "Verlierer",
