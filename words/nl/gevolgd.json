                {
                    "sense_id": "758b7e2f-397f-33cb-bd41-b2446b737f08",
                    "sense_definition": "voltooid deelwoord van <w>volgen</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas een hele tijd later klonk in de verte een politiesirene, <w>gevolgd</w> door het geluid van blaffende honden.",
                            "target_lang_translations": {
                                "en": "Only quite some time later, a police siren sounded in the distance, <w>followed</w> by the sound of barking dogs.",
                                "ru": "Лишь спустя значительное время вдалеке раздалась полицейская сирена, за которой <w>последовал</w> лай собак.",
                                "pl": "Dopiero po dłuższym czasie w oddali rozległa się syrena policyjna, <w>poprzedzona</w> dźwiękiem szczekających psów."
                            }
                        },
                        {
                            "text": "Het nieuws over de verkiezingen werd door iedereen in het land op de voet <w>gevolgd</w>.",
                            "target_lang_translations": {
                                "en": "The news about the elections was closely <w>followed</w> by everyone in the country.",
                                "ru": "За новостями о выборах пристально <w>следили</w> все жители страны.",
                                "pl": "Wiadomości o wyborach były przez wszystkich w kraju uważnie <w>śledzone</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worden gevolgd",
                        "hebben gevolgd",
                        "op de voet gevolgd"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
