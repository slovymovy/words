                                    {
                                        "sense_id": "d7717815-34a1-3cff-bc5c-8b41dc4e9cc4",
                                        "entry_id": "b8274d6f-25be-3027-940e-1b621ae785c2",
                                        "glosses": [
                                            "de soldaten die te voet vechten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91d5b2a-2d5c-4397-815b-44ff32cb1b38",
                                                "sense_id": "d7717815-34a1-3cff-bc5c-8b41dc4e9cc4",
                                                "text": "De infanterie werd ondersteund door de cavalerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98d5ab69-49af-4056-b3b6-013f665dded2",
                        "source_entry_id": "4f815e53-cb0e-3c0b-a781-3c285b872965",
