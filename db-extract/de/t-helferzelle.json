                "senses": [
                    {
                        "sense_id": "a270383c-214b-33c1-8c91-5e67a800ab26",
                        "entry_id": "3648db79-30ab-3845-9a0a-11942f61b868",
                        "glosses": [
                            "Zelle des adaptiven Immunsystems, die entweder an der zellulären (Typ 1) oder der humoralen (Typ 2) Immunreaktion mitwirkt"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a0caf865-5a5e-496b-b2fb-6c2ed521977e",
                                "sense_id": "a270383c-214b-33c1-8c91-5e67a800ab26",
                                "text": "„Auf dem Weg zur reifen T-Zelle, kommt es zur Expression von Oberflächenmolekülen wie dem Corezeptor CD3 und den typischen T-Helferzell-Molekülen CD4 oder CD8. T-Helferzellen zeichnen sich durch das Vorhandensein von CD4-Molekülen aus, T-Killerzellen durch das von CD8-Molekülen.“"
                            },
                            {
                                "example_id": "2eeffcf9-3248-4c0c-9283-b94444669359",
                                "sense_id": "a270383c-214b-33c1-8c91-5e67a800ab26",
                                "text": "„T-Helferzellen geben den B-Zellen die Information, welche Antikörperproduktion im Augenblick erforderlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
