                "senses": [
                    {
                        "sense_id": "7c368f67-054b-3ec4-9af6-b91f588eaf63",
                        "entry_id": "ed541c50-b157-323e-aaa5-0fdbc2c9eade",
                        "glosses": [
                            "die in Ägypten gesprochene Form des Arabischen, die teilweise als Dialekt oder Dialektgruppe bezeichnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c68e41-7a37-47be-805f-861b2381b83c",
                                "sense_id": "7c368f67-054b-3ec4-9af6-b91f588eaf63",
                                "text": "„Selbst wenn ich das rasend schnell gesprochene Ägyptisch-Arabisch kaum verstand (ich las den Text später nach), war das Spiel der Darsteller hinreißend.“"
                            },
                            {
                                "example_id": "84bd6db2-388c-4345-be22-a2be3e8bd13c",
                                "sense_id": "7c368f67-054b-3ec4-9af6-b91f588eaf63",
                                "text": "„Das hängt wohl auch damit zusammen, daß der Übergang zwischen Ägyptisch-Arabisch und Hocharabisch fließender ist, als der zwischen Marokkanisch-Arabisch und Hocharabisch.“"
                            },
                            {
                                "example_id": "fc9ee0d9-55be-401e-b6cc-00834470ba63",
                                "sense_id": "7c368f67-054b-3ec4-9af6-b91f588eaf63",
                                "text": "„Mit ein paar Floskeln Ägyptisch-Arabisch, das sich vom Hoch-Arabischen gewaltig unterscheidet, können Sie bei den Ägyptern schon einige Pluspunkte verbuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
