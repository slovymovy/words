                        "glosses": [
                            "Région sud-est de l’Angleterre encaissée entre les escarpements crayeux parallèles des Downs."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "a280d201-dd2d-406b-a83d-ebeb551222fe",
                                "sense_id": "58db040d-2f76-3fa7-bcdd-e9a1f3298ee7",
                                "text": "D'un point de vue géologique, le Weald est le pendant anglais du Boulonnais français."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c3b705d-4dc9-3f51-868c-d76481c17908",
                        "entry_id": "cf4b2917-76af-30d2-9bc8-3b37f4393069",
                        "glosses": [
                            "Terrain situé au-dessous du grès inférieur, ainsi dit parce qu’il a été primitivement étudié dans le Weald, partie des comtés de Kent, de Surrey et de Sussex, en Angleterre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d92e393-6973-494a-8aa5-1d12b2e8e2d8",
                                "sense_id": "5c3b705d-4dc9-3f51-868c-d76481c17908",
                                "text": "Le Weald constitue les vestiges d’un anticlinal, à savoir le dôme d'un pli rocheux du Crétacé inférieur, dont l’érosion a mis à nu le substrat, formé de crêtes de grès et de vallées argileuses."
                            }
                        ]
                    }
