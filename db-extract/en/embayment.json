                        "sense_id": "94b6f5a8-1fc4-3a52-8492-2d4314dd73d4",
                        "entry_id": "b220692c-2905-3b02-9d15-2cef9cfc6960",
                        "glosses": [
                            "A bay. (the water)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2241e13-c4ec-42c6-a591-38b496f18783",
                                "sense_id": "94b6f5a8-1fc4-3a52-8492-2d4314dd73d4",
                                "text": "The path climbed along a wall of purple sandstone above an embayment and in the sunlit shadows below him he could see the long cataphracted forms of gars lying in a kind of electric repose among the reeds."
                            }
                        ]
                    },
                    {
