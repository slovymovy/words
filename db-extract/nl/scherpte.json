                    {
                        "translation_id": "a0bd32e6-484b-446e-9a3a-9b920278c9c4",
                        "source_entry_id": "0e68577e-d69d-3f1a-9065-2f8d393a17c8",
                        "source_sense_id": "ba0ed8ae-6e96-33fe-b619-8528c4f7149c",
                        "target_lang_word": "acerbity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acerbity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc53eada-3da9-3dab-9758-1271c5578a09",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Sourness of taste, with bitterness and astringency, like that of unripe fruit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Harshness, bitterness, or severity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92e51c8-e32f-4df8-9733-9207d224593f",
                                                "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                                "text": "acerbity of temper, of language, of pain"
                                            },
                                            {
                                                "example_id": "a53e5f6d-9f0a-40d9-b5c6-2678de8ba287",
                                                "sense_id": "2b82cdad-6920-3684-81f6-754808c15bba",
                                                "text": "“Well ?” I repeated with some acerbity. I had been wondering for the last ten minutes how many more knots he would manage to make in that same bit of string before he actually started undoing them again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                        "entry_id": "0dd8ab83-39c5-32f3-a9ca-36c6e0131d82",
                                        "glosses": [
                                            "Something harsh (e.g. a remark, act or experience)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0d67dd-2320-4e22-b4ac-c27d88597ce9",
                                                "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                                "text": "[…] the recollection of that yesterday […] made him bear with the meekness and patience of a true-hearted man all the worrying little acerbities of to-day;"
                                            },
                                            {
                                                "example_id": "57c4facd-f6c2-4413-9f39-c712c701f6aa",
                                                "sense_id": "fd87b7cd-e103-3d9d-ada6-ff343322d494",
                                                "text": "This opera was mainly in the style of late Puccini, with acerbities stolen from Stravinsky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f7f9a9a-2af0-4dce-b382-695a6c308d8c",
                        "source_entry_id": "0e68577e-d69d-3f1a-9065-2f8d393a17c8",
                        "source_sense_id": "ba0ed8ae-6e96-33fe-b619-8528c4f7149c",
                        "target_lang_word": "acrimony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrimony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e59508bb-09b4-37c1-86dc-8ba59e7af555",
                                        "entry_id": "dce07cee-53ca-3014-8e1e-360e4fe0c15d",
                                        "glosses": [
                                            "A sharp and bitter hatred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "579a784e-3319-448f-a6f8-ad839faf1737",
                                                "sense_id": "e59508bb-09b4-37c1-86dc-8ba59e7af555",
                                                "text": "Her acrimony for her neighbors manifests itself with shouting and stomping."
                                            },
                                            {
                                                "example_id": "a7733a6b-da16-425c-bcbb-bce2f666d310",
                                                "sense_id": "e59508bb-09b4-37c1-86dc-8ba59e7af555",
                                                "text": "In her resentful mood, these expressions had been remembered with acrimony and disdain; [...]."
                                            },
                                            {
                                                "example_id": "5d835c22-4dcc-488f-ba80-8f11ef007818",
                                                "sense_id": "e59508bb-09b4-37c1-86dc-8ba59e7af555",
                                                "text": "In the rumbustious atmosphere of the mania years, 1845 and 1846, this state of things gave rise to acrimony which both sides faced with confidence; but as the reaction set in during 1847, it seemed better to come to terms."
                                            },
                                            {
                                                "example_id": "459a4246-f0ae-4b16-8285-96d86d3bc242",
                                                "sense_id": "e59508bb-09b4-37c1-86dc-8ba59e7af555",
                                                "text": "Liverpool manager Jurgen Klopp was prepared to play a game of patience to land Virgil van Dijk after his initial move to sign the Netherlands captain from Southampton in the summer of 2017 ended in acrimony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecd67cf6-e64f-49c6-9214-b775bbd7cb74",
                        "source_entry_id": "0e68577e-d69d-3f1a-9065-2f8d393a17c8",
                        "source_sense_id": "ba0ed8ae-6e96-33fe-b619-8528c4f7149c",
                        "target_lang_word": "acuity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acuity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e27f174-41b4-3801-b1df-a60ba5c7acc4",
                                        "entry_id": "1aa2c88f-c44b-373b-9bba-190dd55aa1f9",
                                        "glosses": [
                                            "Sharpness or acuteness, as of a needle, wit, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0199ba7-e2eb-36eb-bec1-9b98e1250a13",
                                        "entry_id": "1aa2c88f-c44b-373b-9bba-190dd55aa1f9",
                                        "glosses": [
                                            "The ability to think, see, or hear clearly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb53386-c0d5-4c0d-a3db-63840289aac3",
                                                "sense_id": "c0199ba7-e2eb-36eb-bec1-9b98e1250a13",
                                                "text": "The old woman with dementia lost her mental acuity."
                                            },
                                            {
                                                "example_id": "34be6ea4-28af-4517-b061-172ac02ac057",
                                                "sense_id": "c0199ba7-e2eb-36eb-bec1-9b98e1250a13",
                                                "text": "And yet [Ray] Dalio’s acuity prompts an awkward question: how much of Bridgewater’s success comes not from the way it is organized, or any notion of “radical transparency,” but from the boss’s raw investment abilities?"
                                            },
                                            {
                                                "example_id": "369f4d22-d4b9-4fac-8d21-de55d5e408f9",
                                                "sense_id": "c0199ba7-e2eb-36eb-bec1-9b98e1250a13",
                                                "text": "Donald Trump’s frequently bizarre public appearances[…] have once again raised questions about his mental acuity, experts say. […] During his presidency, Joe Biden was subjected to intense speculation over his mental acuity – including from Trump."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96f360b-9ac0-4f08-aa4d-822fa59525dd",
                        "source_entry_id": "0e68577e-d69d-3f1a-9065-2f8d393a17c8",
                        "source_sense_id": "ba0ed8ae-6e96-33fe-b619-8528c4f7149c",
