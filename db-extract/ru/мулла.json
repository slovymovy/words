                    {
                        "sense_id": "93a9af4b-e75e-32c2-9aca-4f65991ea752",
                        "entry_id": "aea71de3-f060-3d57-8267-d6d97f5a79a9",
                        "glosses": [
                            "религ. служитель религиозного культа у мусульман"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5ca864-783f-4a83-8614-ba4cc7c4b0fb",
                                "sense_id": "93a9af4b-e75e-32c2-9aca-4f65991ea752",
                                "text": "Вешний полдень сиял над высью Кавказа, и громкие клики мулл звали жителей Чечни к молитве."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "622f6788-99c9-4a4a-aa1c-99b393712349",
                        "source_entry_id": "aea71de3-f060-3d57-8267-d6d97f5a79a9",
                        "source_sense_id": "93a9af4b-e75e-32c2-9aca-4f65991ea752",
