                "senses": [
                    {
                        "sense_id": "1ac51832-435b-3452-99a0-56724a1d88e3",
                        "entry_id": "6f8579cf-b7ff-3c65-a077-5247ec57e4a3",
                        "glosses": [
                            "Savourer, déguster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18adce5c-3105-413a-8fc7-3658fc16661f",
                                "sense_id": "1ac51832-435b-3452-99a0-56724a1d88e3",
                                "text": "Mes sauces cuisinées à la main sont un parfait raccourci pour succuler un délicieux plat gastronomique."
                            },
                            {
                                "example_id": "0f300da6-0f28-40cc-b08d-acd106de36fb",
                                "sense_id": "1ac51832-435b-3452-99a0-56724a1d88e3",
                                "text": "Je vais relire et succuler le texte, mais tout d'abord, quelle est cette belle photo ?"
                            },
                            {
                                "example_id": "5e070bc5-a8bb-465a-ba32-608e67975bdb",
                                "sense_id": "1ac51832-435b-3452-99a0-56724a1d88e3",
                                "text": "Décapoté, c'est bien la meilleure façon de succuler son V6 puissant et coupleux."
                            }
                        ]
                    },
                    {
                        "sense_id": "73c030b2-7778-3d38-a449-320aa349fd41",
                        "entry_id": "6f8579cf-b7ff-3c65-a077-5247ec57e4a3",
                        "glosses": [
                            "Être excellent, succulent."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd00af0-886c-4765-a814-d75910f6f396",
                                "sense_id": "73c030b2-7778-3d38-a449-320aa349fd41",
                                "text": "La daube succulait, la tarte fondait et le petit vin blanc aurait rendu joyeux un régiment de veufs."
                            }
                        ]
                    }
