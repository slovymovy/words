                        {
                            "text": "He is known for passing <dimes> rather than scoring points himself.",
                            "target_lang_translations": {
                                "ru": "Он известен тем, что раздает <w>ассисты</w>, а не набирает очки сам.",
                                "zh": "他以送出<w>助攻</w>而不是自己得分闻名。"
                            }
                        }
