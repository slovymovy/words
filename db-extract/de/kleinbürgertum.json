                        "entry_id": "c4f664ed-4ffd-3dbb-a67a-c801b62ae543",
                        "glosses": [
                            "bürgerliche Gruppe der Bevölkerung mit vergleichsweise niedrigem Sozialstatus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f09c1a10-59da-494a-9ce9-ef42bca8bc02",
                                "sense_id": "5ea25ed5-ea8a-3d2c-b8ef-289dde8e64a9",
                                "text": "„Das tschechische Element dagegen war das aufstrebende Kleinbürgertum.“"
                            },
                            {
                                "example_id": "cb5ead46-dda1-4807-b08d-caef6a4e319e",
                                "sense_id": "5ea25ed5-ea8a-3d2c-b8ef-289dde8e64a9",
                                "text": "„Die Mitglieder rekrutierten sich vor allem aus dem Kleinbürgertum; daneben waren aber auch Arbeiter überraschend stark vertreten.“"
                            },
                            {
                                "example_id": "1d6dac1b-24c0-425d-b4a5-1b21cbebbcbe",
                                "sense_id": "5ea25ed5-ea8a-3d2c-b8ef-289dde8e64a9",
                                "text": "„Schrebergärten haben sich vielerorts vom kleinkarierten Kleinbürgertum zum urbanen Trend gewandelt.“"
                            }
                        ],
