                        "examples": [
                            {
                                "example_id": "14ae713b-0a38-45e3-b2c1-7f29b3f2ace9",
                                "sense_id": "edf8ec42-5796-3efe-866f-fbe2805fbde3",
                                "text": "Thou art foredoomed to view the Stygian state."
                            },
                            {
                                "example_id": "00405a92-1d5d-468c-9dbc-92bb4e085b08",
                                "sense_id": "edf8ec42-5796-3efe-866f-fbe2805fbde3",
                                "text": "[W]hen to the inherent difficulties of so delicate and nice a social operation were added the spite and hate of conflict, the hell of war; when suspicion and cruelty were rife, and gaunt Hunger wept beside Bereavement,—in such a case, the work of any instrument of social regeneration was in large part foredoomed to failure."
                            },
                            {
                                "example_id": "6710ef79-d659-4094-8f66-8e5ca7d30bdb",
                                "sense_id": "edf8ec42-5796-3efe-866f-fbe2805fbde3",
                                "text": "[O]ne feels that no community can really be as purged of peccant humours as the typical American has for the most part found itself foredoomed to look."
                            },
                            {
                                "example_id": "f84b3a79-341c-4f08-8a17-a8c469df79e5",
                                "sense_id": "edf8ec42-5796-3efe-866f-fbe2805fbde3",
                                "text": "To search for Tara of Helium in the vast, dim labyrinth of the pits of O-Tar seemed to the Gatholian a hopeless quest, foredoomed to failure."
                            },
                            {
                                "example_id": "5d0dd6d2-0a29-4d20-a1d0-059175844ac4",
                                "sense_id": "edf8ec42-5796-3efe-866f-fbe2805fbde3",
                                "text": "They appeared, upon the surface, to possess all the qualities which were likely to recommend them to the fashionable society of the day; but their mission was foredoomed to failure."
                            }
                        ]
                    }
                ],
