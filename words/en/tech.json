                {
                    "sense_id": "e3ed1a1f-9127-3fb8-bdd0-6857e7f140bd",
                    "sense_definition": "Technique; a specific method or skill used to accomplish a task.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His lifting <w>tech</w> is dangerous and could cause an injury.",
                            "target_lang_translations": {
                                "ru": "Его <w>техника</w> подъема веса опасна и может привести к травме.",
                                "zh": "他举重的<w>技巧</w>很危险，可能会导致受伤。"
                            }
