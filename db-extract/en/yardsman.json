                "senses": [
                    {
                        "sense_id": "ee8459ee-6d87-38f2-911f-256c9c809b31",
                        "entry_id": "0284c0ef-e468-39a1-a7cf-09c8ba390f38",
                        "glosses": [
                            "The foreman or man in charge of the activities in a yard (train yard, prison yard, stock yard, etc)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6350b865-ca1b-42d5-bbe2-06769a9a73d7",
                                "sense_id": "ee8459ee-6d87-38f2-911f-256c9c809b31",
                                "text": "He had been sentenced to imprisonment, but without the imposition of hard labour, and he had purchased his post of yardsman in the division allotted to those prisoners, equally with himself, exempt from labour—a class which, at that period, passed their time in utter idleness."
                            },
                            {
                                "example_id": "4a7bb1ee-4963-4742-98ec-623c5ff54eee",
                                "sense_id": "ee8459ee-6d87-38f2-911f-256c9c809b31",
                                "text": "This is frequently left to a porter or yardsman, and more especially where an agent is not what is termed an “ outside man.”"
                            },
                            {
                                "example_id": "d6f501a9-162d-45d0-b6ee-9ba5075bff8b",
                                "sense_id": "ee8459ee-6d87-38f2-911f-256c9c809b31",
                                "text": "On each shift is a melting-shop yardsman, working under the traffic department, who is responsible for the fulfilment of the requisition."
                            },
                            {
                                "example_id": "1e640470-88a4-4744-a7fc-2b0fb6f0e466",
                                "sense_id": "ee8459ee-6d87-38f2-911f-256c9c809b31",
                                "text": "On presentation by the drover of this docket to the yardsman it was the yardsman's duty to give delivery to the drover of the stock which are in fact at that time in the yard referred to in the docket."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff350fcb-7772-3e29-af6f-ac239565f70d",
                        "entry_id": "0284c0ef-e468-39a1-a7cf-09c8ba390f38",
                        "glosses": [
                            "A general laborer in a yard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e805121-6111-4433-9b7c-5d433ed6da9f",
                                "sense_id": "ff350fcb-7772-3e29-af6f-ac239565f70d",
                                "text": "The duties of a yardsman shall consist of general labourer's work, including unloading and loading goods, stacking and re-stacking material, preparing and making fire for tyring, carrying water for tyring, putting on and taking off wheels, lifting and helping to lift, carrying generally."
                            },
                            {
                                "example_id": "955cd806-17ad-4433-b389-addd5200ecda",
                                "sense_id": "ff350fcb-7772-3e29-af6f-ac239565f70d",
                                "text": "The yardsman from the leading cart held out a work-gnarled hand."
                            }
                        ]
                    }
