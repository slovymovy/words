                    {
                        "translation_id": "ec870967-4edd-49bc-90f2-82dc54f2fc58",
                        "source_entry_id": "889f4f07-8d18-395c-a77a-d2d982466587",
                        "source_sense_id": "5b35a096-1238-3bfa-abdd-7f2ac28461a4",
