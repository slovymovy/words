                ],
                "senses": [
                    {
                        "sense_id": "fd182236-da32-366c-b4ba-7c862d7d0089",
                        "entry_id": "08c83ee0-ae82-32e8-9b78-4f88402b7a0c",
                        "glosses": [
                            "Se pirater soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7c0dc8-ace7-4340-be6f-ee532bec85b7",
                                "sense_id": "fd182236-da32-366c-b4ba-7c862d7d0089",
                                "text": "Être obligé de s'auto-pirater pour ré-avoir accès à son compte, ça la fout mal quand même."
                            },
                            {
                                "example_id": "db04793a-4169-4d36-a678-f544dcf575b9",
                                "sense_id": "fd182236-da32-366c-b4ba-7c862d7d0089",
                                "text": "Permettez juste un instant de m'auto-pirater, de me voler (ce qui est juridiquement impossible) un de mes commentaires à ce sujet."
                            },
                            {
                                "example_id": "a6cbfb51-8a64-4608-866c-7cdb3f57eae6",
                                "sense_id": "fd182236-da32-366c-b4ba-7c862d7d0089",
                                "text": "Faudra que j'essaie de m'auto-pirater en générant un max de trafic, un de ces jours."
                            }
                        ]
                    }
