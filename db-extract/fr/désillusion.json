                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb3b8b4-bee7-4a31-8161-11aa19d4a290",
                                "sense_id": "4cc05329-b311-31fd-ad14-c0cbfb99a7ec",
                                "text": "Ses cinq ans de gouvernement ont entraîné la frustration, la désillusion et la déception.",
                                "translation": "Pięć lat jego rządów doprowadziło do frustracji, rozczarowania i oszustwa."
                            }
