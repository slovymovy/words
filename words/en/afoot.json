                    "sense_definition": "Happening or in progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "in_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Change is <w>afoot</w> in all directions as the company prepares for a major merger.",
                            "target_lang_translations": {
                                "zh": "随着公司准备进行重大合并，各方面变革都<w>正在进行</w>。"
                            }
                        },
                        {
                            "text": "There are plans <w>afoot</w> to renovate the old library building next summer.",
                            "target_lang_translations": {
                                "zh": "明年夏天翻修旧图书馆大楼的计划<w>正在酝酿中</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ongoing",
                        "underway"
                    ],
                    "common_phrases": [
                        "plans afoot"
                    ],
                    "target_lang_definitions": {
                        "zh": "正在发生或进行中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "正在进行",
                                "target_lang_sense_clarification": "指某事处于进行状态"
                            },
                            {
                                "target_lang_word": "在酝酿中",
                                "target_lang_sense_clarification": "指计划或变化正在筹备中"
                            }
                        ]
                    }
                }
            ]
        },
