                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjonctive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                        "entry_id": "277e32b8-979b-3eae-a211-e41cc549a557",
                                        "glosses": [
                                            "Membrane muqueuse transparente qui tapisse l’intérieur des paupières et les unit au globe oculaire sur lequel elle se poursuit jusqu’à la cornée. Cette membrane produit le mucus qui tapisse et lubrifie la surface de l’œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97ec8c9-8e2f-41d6-aa9c-71d656c714c2",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "Le front était brûlant ; il y avait de la rougeur aux conjonctives ; la température de tout le corps était très haute."
                                            },
                                            {
                                                "example_id": "e8b08fb4-d597-4d6a-b500-f81282df4df2",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "Ces allergies, qui portent aussi le nom de conjonctivites allergiques car elles se manifestent par une inflammation de la conjonctive, sont de deux ordres : la forme saisonnière, la plus fréquente, et la forme permanente."
                                            },
                                            {
                                                "example_id": "afea5cac-4a1f-40e6-aeb9-e07aee647b8b",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "Le liquide lacrymal est aqueux et salé.\nIl s'écoule à la surface externe de la cornée et de la conjonctive de l'œil."
                                            },
                                            {
                                                "example_id": "9da7882e-b1eb-4940-83da-62facebc5d70",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "La conjonctivite est l’inflammation de la conjonctive."
                                            }
                                        ]
                                    }
                                ]
                            },
