                        "translation_id": "389c21e7-5744-4328-977a-31b476701f7f",
                        "source_entry_id": "9b3187b6-3b03-3f02-8a05-28614006b61b",
                        "source_sense_id": "1c01ada9-4665-3983-ab55-7b83959352b6",
