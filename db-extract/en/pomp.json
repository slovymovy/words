                "senses": [
                    {
                        "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                        "entry_id": "0ac85a72-154d-33d3-a377-38ce00cbc61d",
                        "glosses": [
                            "Show of magnificence; parade; display; power."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a1fb21-f377-4bfd-ae2f-295a5647f70e",
                                "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                "text": "'Tis a gross visible errour, which Tertullian teaches in his Book of Idolatry cap. 18. That all the marks of Dignity and Power, and all the ornaments annexed to Office, are forbid Christians, and that Jesus Christ hath plac'd all these things amongst the pomps of the Devil, since he himself appeared in a condition so far from all pomp and splendour."
                            },
                            {
                                "example_id": "7731f2f9-41b0-41bb-9bbb-7159d1dc9378",
                                "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                "text": "The deafening claps of thunder and the dazzling flashes of lightning which lit up the ghastly scene testified that the artillery of heaven had lent its supernatural pomp to the already gruesome spectacle."
                            },
                            {
                                "example_id": "42c482cf-fb94-4722-b4e2-d5c8cdeb93ff",
                                "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                "text": "In its pomp Victoria had 17 platforms, but many of the through platforms were demolished in the early 1990s to make way for the Manchester Arena."
                            }
                        ]
                    },
                    {
                        "sense_id": "5826d98e-8b99-3951-b2c1-d7880ed75080",
                        "entry_id": "0ac85a72-154d-33d3-a377-38ce00cbc61d",
                        "glosses": [
                            "A procession distinguished by ostentation and splendor; a pageant."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ef80b0db-7cc0-450c-8baf-c77a60c0f2f6",
                                "sense_id": "5826d98e-8b99-3951-b2c1-d7880ed75080",
                                "text": "[…] a more beautiful expression of joy and thanksgiving than could have been exhibited by all the pomps of a Roman triumph."
                            }
                        ]
                    }
                ],
