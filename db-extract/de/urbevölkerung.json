                "senses": [
                    {
                        "sense_id": "0a84c9d7-7613-34f8-9278-26d032829752",
                        "entry_id": "06955a6a-a246-3872-b01a-027171d73e45",
                        "glosses": [
                            "ursprünglich in einem Gebiet ansässige Bevölkerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede31ed3-0210-43c9-a555-6416fdd05191",
                                "sense_id": "0a84c9d7-7613-34f8-9278-26d032829752",
                                "text": "„Hingegen nennt er die indianische Urbevölkerung, die Mi'kmaq, nur in einem Nebensatz.“"
                            },
                            {
                                "example_id": "629d4dd0-491f-4030-8a5d-9ee18dded967",
                                "sense_id": "0a84c9d7-7613-34f8-9278-26d032829752",
                                "text": "„Aus dieser Vermischung von Indogermanen und nicht indogermanischer alteuropäischer Urbevölkerung gingen dann neue, unterschiedliche Kulturen mit neuen, eigenständigen Sprachentwicklungen hervor, die zu neuen Sprach- und Volksgruppen führten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
