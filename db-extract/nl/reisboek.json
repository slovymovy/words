                "senses": [
                    {
                        "sense_id": "271b4392-de81-357a-9de6-a136854a098d",
                        "entry_id": "e1a85b54-e5f6-347a-ae4a-8eafc1d6f3ec",
                        "glosses": [
                            "is een publicatie die bedoeld is om reizigers informatie te verschaffen over de plaats of plaatsen die zij van plan zijn te gaan bezoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14c25a1-5ac4-46e6-97b6-92ce8435db41",
                                "sense_id": "271b4392-de81-357a-9de6-a136854a098d",
                                "text": "Het spoorboekje en de vliegtijdentabel zouden als de eenvoudigste vorm van een reisboek kunnen worden beschouwd. Zij verschaffen echter niet genoeg informatie om tot het genre te kunnen worden gerekend; het zijn slechts reistijdentabellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "967bba22-93e0-47da-a67e-f49c04facddd",
                        "source_entry_id": "e1a85b54-e5f6-347a-ae4a-8eafc1d6f3ec",
                        "source_sense_id": "271b4392-de81-357a-9de6-a136854a098d",
                        "target_lang_word": "Reiseführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiseführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                        "entry_id": "66e8e287-7489-3b21-bfa8-424e68811865",
                                        "glosses": [
                                            "Person, die Reisende informiert und gegebenenfalls betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b1e227-616e-4c43-adc8-f7eb4e44318b",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "Der Reiseführer war sehr kompetent und stets hilfsbereit."
                                            },
                                            {
                                                "example_id": "94543d5e-e17a-469c-997d-deee74efd1af",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "„Der Reiseführer setzte unbeirrt seine Tour fort, und bald darauf betraten wir die Altstadt von Kairo mit ihren vielen Kirchen.“"
                                            },
                                            {
                                                "example_id": "6b81a520-81cf-4d6a-9c7d-c1641926541b",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "„In der Botschaft in London wurde mir bestätigt, dass ich ohne Begleitung eines offiziellen algerischen Reiseführers keinen Fuß in das Land setzen würde.“"
                                            },
                                            {
                                                "example_id": "7938f6a6-9b9c-4e89-acfd-a4f60b66eb2b",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "„Innen in der »Porta Nigra« wanderten Reisegruppen herum, und jede Gruppe folgte einer Reiseführerin oder einem Reiseführer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                        "entry_id": "66e8e287-7489-3b21-bfa8-424e68811865",
                                        "glosses": [
                                            "Publikation mit touristischen Informationen und Tipps für Reisende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c1b5e9-a00c-4737-81b9-35d91ed6a72f",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "Ich habe mir einen Reiseführer über Indien gekauft."
                                            },
                                            {
                                                "example_id": "ad61fb38-c263-4b86-ab92-646fe255aa6f",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Bei einem Abendessen auf dem Balkon kann ein Mann ja wer weiß was erzählen, seine Beziehungstauglichkeit beweist er erst, wenn er bei vierzig Grad Hitze Mofabenzin durch einen Gartenschlauch aus dem Kanister ansaugt und gleichzeitig zuhört, wie die Frau griechische Sagen aus dem Reiseführer vorliest.“"
                                            },
                                            {
                                                "example_id": "995255de-3f64-4208-85cc-8f711d8945ab",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„In jedem Reiseführer steht, daß es die berühmteste Burg Polens ist.“"
                                            },
                                            {
                                                "example_id": "fcac05c0-b27e-45ab-9a89-761b2c24656a",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Spätestens als der Koblenzer Verleger Karl Baedeker im Jahr 1828 die »Rheinreise von Mainz bis Cöln. Handbuch für Schnellreisende« publizierte und damit die Reihe seiner Reiseführer eröffnete, war Forster widerlegt.“"
                                            },
                                            {
                                                "example_id": "bec52ce9-cf7c-4ea0-858b-80123d1fa7a5",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Touristen bewegen sich im Bekannten, in dem, was sie sorgfältig im Reiseführer und im Hotelprospekt studiert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
