                        "glosses": [
                            "Relatif aux corpuscules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93012494-a907-4236-bdd8-465c6498ffc9",
                                "sense_id": "41f3d9b5-b88c-38f2-a21a-4cc510588d90",
                                "text": "Physique ou philosophie corpusculaire, système d’Épicure, qui prétend expliquer tout l’ordre de la nature par le mouvement de certains corpuscules."
                            }
                        ]
                    }
                ],
                "translations": [
