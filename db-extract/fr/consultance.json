                        "examples": [
                            {
                                "example_id": "4643b572-d342-4afc-a948-968431a470ee",
                                "sense_id": "d48d317a-b708-355e-9fd7-f1c1c6fe2068",
                                "text": "Une autorité - Cour des comptes ou société de consultance externe - vérifiera que les budgets restent en équilibre."
                            },
                            {
                                "example_id": "c2c4f2a7-89d8-4c4f-b8d9-daee8fe15c78",
                                "sense_id": "d48d317a-b708-355e-9fd7-f1c1c6fe2068",
                                "text": "La majorité des habitants des États-Unis posséderont un téléphone multifonctions ou une tablette numérique en 2015, certains possédant les deux, a indiqué mardi la société de consultance In-Stat."
                            },
                            {
                                "example_id": "14f28ed2-e9a4-452c-93c4-83d520ffec6e",
                                "sense_id": "d48d317a-b708-355e-9fd7-f1c1c6fe2068",
                                "text": "Le consommateur belge prévoit de dépenser en moyenne 570 euros durant la période des fêtes, un montant en baisse pour la cinquième année consécutive, selon une étude de la société de consultance Deloitte sur les intentions d’achat du consommateur européen pour les fêtes de fin d’année."
                            },
                            {
                                "example_id": "8e62cc4e-635c-4c33-9535-29547a30c5cb",
                                "sense_id": "d48d317a-b708-355e-9fd7-f1c1c6fe2068",
                                "text": "… ils n’ont pas encore retrouvé leur niveau d’avant la crise, selon une étude du bureau de consultance Mercer."
                            }
                        ]
                    }
