                    },
                    {
                        "translation_id": "ce080069-84c1-484a-a8ce-183d01024a6d",
                        "source_entry_id": "24f9367b-6e61-3a7d-9ab1-b80c13d21f94",
                        "source_sense_id": "e99063cb-a3d5-36f6-b0a6-d2e2400be329",
                        "source_sense_description": "stemming waarin men de dingen in hun wezenlijke waarde wil zien",
                        "target_lang_word": "seriousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seriousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f74dbf7c-7fe7-3c3e-812b-4e371b019caa",
                                        "entry_id": "b73c1504-5415-3014-b3fb-c85e200f5d94",
                                        "glosses": [
                                            "The state or quality of being serious."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ff3e78-1ce3-4e7b-a15e-4636c725a220",
                                                "sense_id": "f74dbf7c-7fe7-3c3e-812b-4e371b019caa",
                                                "text": "“[…] She takes the whole thing with desperate seriousness. But the others are all easy and jovial—thinking about the good fare that is soon to be eaten, about the hired fly, about anything.”"
                                            },
                                            {
                                                "example_id": "bb9bde4f-7d4a-462a-aca4-173d84fc4119",
                                                "sense_id": "f74dbf7c-7fe7-3c3e-812b-4e371b019caa",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police […]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            },
                                            {
                                                "example_id": "b7527e2a-7822-46c2-be38-7f7e4453d088",
                                                "sense_id": "f74dbf7c-7fe7-3c3e-812b-4e371b019caa",
                                                "text": "Though Bane’s sing-song voice gives his pronouncements a funny lilt, he doesn’t have any of the Joker’s deranged wit, and Nolan isn’t interested in undercutting his seriousness for the sake of a breezier entertainment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "606d48d0-f774-4d0d-a36f-f1376b8ffa00",
                        "source_entry_id": "24f9367b-6e61-3a7d-9ab1-b80c13d21f94",
                        "source_sense_id": "e99063cb-a3d5-36f6-b0a6-d2e2400be329",
                        "source_sense_description": "stemming waarin men de dingen in hun wezenlijke waarde wil zien",
                        "target_lang_word": "sérieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui est grave ; qui agit avec réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1bce8bb-7c38-40cc-9dd1-12cc9aa0b96a",
                                                "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                                "text": "C’est un homme très sérieux."
                                            },
                                            {
                                                "example_id": "c599c456-b8db-4825-ab6f-e9b053fad7d5",
                                                "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                                "text": "Visage sérieux."
                                            },
                                            {
                                                "example_id": "389497e8-ee1d-43f1-9108-aadaef4e35a0",
                                                "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                                "text": "Air, maintien sérieux."
                                            },
                                            {
                                                "example_id": "801eaf45-c9b4-42a8-a182-53729a2174bd",
                                                "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                                "text": "Mine sérieuse."
                                            },
                                            {
                                                "example_id": "d00244b9-6605-43ff-acdb-6922f940b0f3",
                                                "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                                "text": "Conversation sérieuse."
                                            },
                                            {
                                                "example_id": "fbdc88f3-c2e3-4f6c-9d19-eaf17a6470a9",
                                                "sense_id": "d15aeed4-4617-371f-b459-d51d2b9a11d6",
                                                "text": "Vous n’êtes pas sérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed4120c0-a541-391e-a4b9-6196d95b4874",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui ne fait pas d’écart de conduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7217296-5f27-4781-b0f1-f22f567d35dd",
                                                "sense_id": "ed4120c0-a541-391e-a4b9-6196d95b4874",
                                                "text": "Il était sérieux, c’est-à-dire, pour un ouvrier, ni feignant, ni buveur, ni noceur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4998870-40ae-3cd9-8377-eab5a7fdf42b",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui est solide ou important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34502b0-3e88-4e00-b073-b663e6b1b966",
                                                "sense_id": "d4998870-40ae-3cd9-8377-eab5a7fdf42b",
                                                "text": "En 1240, ce jeune vicomte Raymond de Trincavel, […] s’empare, sans se heurter à une sérieuse résistance, des châteaux de Montréal, des villes de Montolieu, de Saissac, de Limoux, d’Azillan, de Laurens et se présente devant Carcassonne."
                                            },
                                            {
                                                "example_id": "740cd6b6-901d-472d-9baf-7daf93304b22",
                                                "sense_id": "d4998870-40ae-3cd9-8377-eab5a7fdf42b",
                                                "text": "Cet homme n’a rien de sérieux dans le caractère."
                                            },
                                            {
                                                "example_id": "2e067b0b-acb9-4cbd-ad4b-76f4e1ab4738",
                                                "sense_id": "d4998870-40ae-3cd9-8377-eab5a7fdf42b",
                                                "text": "Faire des propositions sérieuses."
                                            },
                                            {
                                                "example_id": "e9938db4-369e-44de-9f2e-237f7c5f28e8",
                                                "sense_id": "d4998870-40ae-3cd9-8377-eab5a7fdf42b",
                                                "text": "L’affaire dont il s’agit est sérieuse."
                                            },
                                            {
                                                "example_id": "e8da7ee7-f927-4453-8518-e26aaadd0227",
                                                "sense_id": "d4998870-40ae-3cd9-8377-eab5a7fdf42b",
                                                "text": "Avoir avec quelqu’un une explication sérieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da41056-9ad4-3fff-ab50-a6986e61c045",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui est crédible ou digne de confiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607279eb-2348-4a17-a79f-a171d1b2f809",
                                                "sense_id": "5da41056-9ad4-3fff-ab50-a6986e61c045",
                                                "text": "Nous souhaitons que vous trouviez un fournisseur sérieux pouvant fabriquer dans les délais voulus et à des conditions avantageuses pour l’État."
                                            },
                                            {
                                                "example_id": "8274d92b-b483-4e41-a72f-140f3c1805d9",
                                                "sense_id": "5da41056-9ad4-3fff-ab50-a6986e61c045",
                                                "text": "[…] : à leurs procédés s'applique le terme : « Fuite des capitaux ». Mais aucun industriel sérieux n'a voulu recourir à ces moyens. S'il a des capitaux à l'étranger, c'est pour couvrir ses achats de matières premières; […]."
                                            },
                                            {
                                                "example_id": "69f80e9f-7c73-4fcf-a760-6c77967756bc",
                                                "sense_id": "5da41056-9ad4-3fff-ab50-a6986e61c045",
                                                "text": "Je me suis amusé à rechercher comment, tel journaliste sérieux et compétent, tel historien, tel psychologue, avaient pu reprendre à leur compte la fable du 80%; chacun en fait la répétait pour l'avoir trop souvent lue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90eb6936-ddb7-3864-b1a0-f77cf19db1f6",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui est sincère ou vrai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4e38f9-dea5-4bd7-9f29-5255f2fa5d48",
                                                "sense_id": "90eb6936-ddb7-3864-b1a0-f77cf19db1f6",
                                                "text": "Ce que je vous dis là est sérieux."
                                            },
                                            {
                                                "example_id": "57229b06-b080-42e6-b2c5-663370a8f8e7",
                                                "sense_id": "90eb6936-ddb7-3864-b1a0-f77cf19db1f6",
                                                "text": "Les protestations d’amitié qu’il vous fait sont sérieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1097d0d9-daee-33b3-8e63-3b5edcd7e832",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui peut avoir des suites fâcheuses ou de graves conséquences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cc8d5d-e584-4fb9-8ad7-a8ce6649e6ca",
                                                "sense_id": "1097d0d9-daee-33b3-8e63-3b5edcd7e832",
                                                "text": "Ce combat semblait n’être qu’une escarmouche, mais l’affaire devint sérieuse."
                                            },
                                            {
                                                "example_id": "9bb359f1-d515-47e7-be2e-393a39ef7a23",
                                                "sense_id": "1097d0d9-daee-33b3-8e63-3b5edcd7e832",
                                                "text": "C'est une affaire sérieuse."
                                            },
                                            {
                                                "example_id": "5260eea9-c631-46cc-b4bd-050b38de0514",
                                                "sense_id": "1097d0d9-daee-33b3-8e63-3b5edcd7e832",
                                                "text": "Maladie sérieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35ec30fa-ee0f-3b2f-9a3f-6abf10298150",
                                        "entry_id": "552f811c-0351-39a3-8e52-5c74abfbf054",
                                        "glosses": [
                                            "Qui est fait sérieusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d631f5a8-457e-4b73-af78-d9f190aabaf9",
                                                "sense_id": "35ec30fa-ee0f-3b2f-9a3f-6abf10298150",
                                                "text": "Toute réparation sérieuse était impossible, mais on gréa une sorte de gouvernail utilisable par beau temps."
                                            },
                                            {
                                                "example_id": "4ebe1346-3aa5-48c5-aaee-1c54494676c7",
                                                "sense_id": "35ec30fa-ee0f-3b2f-9a3f-6abf10298150",
                                                "text": "Le repas était, comme toujours en Polynésie, une affaire très sérieuse et tout le monde mangeait en silence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sérieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61b5c1f4-89a7-3cf3-86d5-309dabf71d90",
                                        "entry_id": "766796f6-88da-3960-a820-e4d347929bc8",
                                        "glosses": [
                                            "Gravité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e984da81-d7e7-42ee-ba81-182fd664ee0b",
                                                "sense_id": "61b5c1f4-89a7-3cf3-86d5-309dabf71d90",
                                                "text": "Les voilà qui m'entourent ; les voilà qui me contemplent ; les voilà qui me disent en leurs provocations : « Jeune dieu d'Amour, enseigne aux nymphes bocagères la mollesse et le désir, l'inconstance et la passion , le sourire et le sérieux. »"
                                            },
                                            {
                                                "example_id": "ac4b01da-8507-42d7-870c-a812398463a1",
                                                "sense_id": "61b5c1f4-89a7-3cf3-86d5-309dabf71d90",
                                                "text": "Tout le génie de Milton sort de là : il a porté l’éclat de la Renaissance dans le sérieux de la Réforme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c0165b-6acc-34ae-81f2-66156ebb0315",
                                        "entry_id": "766796f6-88da-3960-a820-e4d347929bc8",
                                        "glosses": [
                                            "Qualité de quelqu’un de posé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e914409-f379-42ad-a807-4f65c2a02af8",
                                                "sense_id": "90c0165b-6acc-34ae-81f2-66156ebb0315",
                                                "text": "Vous gérez vos finances avec sérieux."
                                            },
                                            {
                                                "example_id": "a2f75b87-4bf0-43ad-8982-15aee4c0d0a7",
                                                "sense_id": "90c0165b-6acc-34ae-81f2-66156ebb0315",
                                                "text": "Charles-Amédée de Courson, député depuis 1993, centriste et chantre du sérieux budgétaire, «populiste» ? Il faut avouer qu’on ne l’aurait pas dit comme ça."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2eded8-3588-3c25-91f3-7861e28fa8a1",
                                        "entry_id": "766796f6-88da-3960-a820-e4d347929bc8",
                                        "glosses": [
                                            "Caractère de ce qui mérite attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb7a72a-38d1-40d1-9157-8cf64645765f",
                                                "sense_id": "ca2eded8-3588-3c25-91f3-7861e28fa8a1",
                                                "text": "Cet aperçu très superficiel montre en tous les cas le sérieux et l’aléa de la navigation dans ces régions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb5abd2d-3ef8-379b-99e7-7b6f1ea52234",
                                        "entry_id": "766796f6-88da-3960-a820-e4d347929bc8",
                                        "glosses": [
                                            "Chope de bière d’un demi-litre, ou parfois de deux litres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1849ed5c-d3f0-4cc0-b169-4fc15c2274f6",
                                                "sense_id": "bb5abd2d-3ef8-379b-99e7-7b6f1ea52234",
                                                "text": "Ma mère se levait à l'autre bout de la table, un sérieux de bière à la main."
                                            },
                                            {
                                                "example_id": "19bd4865-7d21-421d-b2d5-4d972e5409a9",
                                                "sense_id": "bb5abd2d-3ef8-379b-99e7-7b6f1ea52234",
                                                "text": "… un sérieux = 2 litres … Lire en ligne"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sérieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d1028e5-63f6-388b-8dea-999b3931cae1",
                                        "entry_id": "b4a109fc-0ec2-3164-9bac-ce9af51d7752",
                                        "glosses": [
                                            "Sérieusement (se dit pour tenter d’introduire un point grave dans une conversation peu sérieuse)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e35da159-53cb-4468-97b8-47d986d2aec7",
                                                "sense_id": "8d1028e5-63f6-388b-8dea-999b3931cae1",
                                                "text": "Non mais sérieux, il faut un concours pour être bibliothécaire ?"
                                            }
