                "senses": [
                    {
                        "sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                        "entry_id": "26135fba-0aff-3660-938f-3f438115c5c4",
                        "glosses": [
                            "Figur, die der Repräsentation dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be8608f-928c-411f-a7c5-3b02c98e2700",
                                "sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                                "text": "„Als künstlerische Gründer-, Stifter- und Repräsentationsfiguren der DDR sind sie gewissermaßen typischer als die (meist jüngeren) erklärten oder unerklärten \"Dissidenten\"-Kollegen.“"
                            },
                            {
                                "example_id": "60968ab9-787e-4682-9d92-82d92d8999e3",
                                "sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                                "text": "„Der parteilose Oberbürgermeister Arthur Werner war nur eine Repräsentationsfigur, die tatsächliche Macht übte sein erster Stellvertreter, Karl Maron, aus, der Stiefvater der Schriftstellerin Monika Maron.“"
                            },
                            {
                                "example_id": "b07e8532-43a4-4ecf-9d9c-8e5440bafa49",
                                "sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                                "text": "„Allmählich sind die Exzesse der Achtziger auch hier einer neuen Nüchternheit gewichen mit Repräsentationsfiguren wie der Deutschen Claudia Schiffer an der Spitze.“"
                            },
                            {
                                "example_id": "8069082b-91b4-4c64-920d-0f13d69a06ab",
                                "sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                                "text": "„Das scheint folgerichtig, hat sich Meier doch in den letzten Jahren von einer eher stillen Parlamentarierin zu einer Repräsentationsfigur der Partei gewandelt.“"
                            },
                            {
                                "example_id": "f97b8551-c41d-44b5-a164-43cbfb4878e1",
                                "sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                                "text": "„Aber ganz ohne Repräsentationsfigur wirkt die Republik doch etwas karg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e21994c-0286-453b-9000-dba8a65e9408",
                        "source_entry_id": "26135fba-0aff-3660-938f-3f438115c5c4",
                        "source_sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                        "source_sense_description": "Figur, die der Repräsentation dient",
                        "target_lang_word": "figurehead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurehead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e207f1e0-a99e-3d4c-b4a4-90e9ce5b075e",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "A carved figure on the prow of a sailing ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "Someone in a nominal position of leadership who has little to no actual power."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f27d9ef-a9f8-45f0-8683-fc6b33dd9d2f",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Evidently he did not mean to be a mere figurehead, but to carry on the old tradition of Wilsthorpe's; and that was considered to be a good thing in itself and an augury for future prosperity."
                                            },
                                            {
                                                "example_id": "d37432da-8daa-4496-8643-7db23139b423",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Instead she played, largely impeccably, the part of a modern constitutional monarch, a symbolic figurehead with a right to be consulted and to advise and warn political leaders privately and to show herself publicly as a focus of national life, celebration and commemoration."
                                            },
                                            {
                                                "example_id": "fb9e707b-f047-4585-903a-8ec0d943d83e",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Supporters of Wagenknecht, a controversial but prominent figurehead, are already hatching plans for a breakaway party to compete in the 2024 European elections, the German newspaper Taz reported this week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba44fb2a-a2e2-3fa0-a6d7-5ab563e8e211",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "A person's face."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0a748f-587d-4680-8b00-e75ddf62b3ee",
                                                "sense_id": "ba44fb2a-a2e2-3fa0-a6d7-5ab563e8e211",
                                                "text": "HATCHET. Bring up, I say, or I'll spoil your figurehead. [Lifting his cudgel]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dd8acf5-96d7-4ef0-b21e-9f6e6ce6932e",
                        "source_entry_id": "26135fba-0aff-3660-938f-3f438115c5c4",
                        "source_sense_id": "e1b9c447-bc13-3020-8a30-f33508477c88",
                        "source_sense_description": "Figur, die der Repräsentation dient",
                        "target_lang_word": "potiche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb07f20-ea22-32eb-809b-52b3784e1a2e",
                                        "entry_id": "29cc7f6d-d65a-3dd3-9c67-50a47c49c97e",
                                        "glosses": [
                                            "Vase de porcelaine de Chine ou du Japon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad450e20-6a32-445c-98ce-0795b08d3c4d",
                                                "sense_id": "8cb07f20-ea22-32eb-809b-52b3784e1a2e",
                                                "text": "Il évitait la chute d’une grosse potiche japonaise, qu’il avait apostrophée d’un coup de poing."
                                            },
                                            {
                                                "example_id": "b27e42cf-8a62-410d-a497-00c6c10141a3",
                                                "sense_id": "8cb07f20-ea22-32eb-809b-52b3784e1a2e",
                                                "text": "Le faux cousin regardait le Conseiller d’État comme il eût examiné quelque grosse potiche chinoise."
                                            },
                                            {
                                                "example_id": "e7aa3d12-69bb-4a55-b0f0-6d6d5bec1fa9",
                                                "sense_id": "8cb07f20-ea22-32eb-809b-52b3784e1a2e",
                                                "text": "Potiche à col étroit, à goulot brisé, faïence fond bleu avec ornements peints en blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84581bb1-7427-3334-be90-d74e5e9ed012",
                                        "entry_id": "29cc7f6d-d65a-3dd3-9c67-50a47c49c97e",
                                        "glosses": [
                                            "Personne dont la fonction est de peu d’utilité."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a157b75-9bef-47fa-b6d8-b8947eed3f4e",
                                                "sense_id": "84581bb1-7427-3334-be90-d74e5e9ed012",
                                                "text": "Aliénation et exploitation de la femme par la bourgeoisie et le prolétariat. La bourgeoise, objet inutile et coûteux est le triomphe de la femme potiche; la femme salariée, moins dominée doit acheter une liberté relative au prix d'une exploitation abrutissante."
                                            },
                                            {
                                                "example_id": "67e06c48-1667-4773-9ea5-b804f73d77ae",
                                                "sense_id": "84581bb1-7427-3334-be90-d74e5e9ed012",
                                                "text": "Il ne s'était pas diverti à paraître dans les salons, hauts lieux du papillonnage, où paonnaient des sots éventés et des sirènes plâtrées, et où cancanaient des caillettes d'alcôve et des potiches au ventre rembourré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
