    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc182ca1-c898-3a19-8d10-71b606277b40",
                    "sense_definition": "het eten van snoepgoed of andere lekkernijen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>snoepen</w> graag van de chocolaatjes die op tafel staan.",
                            "target_lang_translations": {
                                "en": "The children love <w>eating</w> the chocolates that are on the table."
                            }
                        },
                        {
                            "text": "Je mag niet te veel <w>snoepen</w> vlak voor het avondeten.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>eat too many sweets</w> right before dinner."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lekker snoepen",
                        "stiekem snoepen"
                    ],
                    "target_lang_definitions": {
                        "en": "eating sweets, candy, or other treats"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to eat sweets",
                                "target_lang_sense_clarification": "consuming candy or sugary treats"
                            },
                            {
                                "target_lang_word": "to have candy",
                                "target_lang_sense_clarification": "eating confectionery"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43a834b7-d711-37f2-b3ba-f40c46127f12",
                    "sense_definition": "tussendoor iets kleins eten, vaak buiten de reguliere maaltijden om",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik probeer minder te <w>snoepen</w> tussen de middag en het avondeten.",
                            "target_lang_translations": {
                                "en": "I am trying to <w>snack</w> less between lunch and dinner."
                            }
                        },
                        {
                            "text": "Zit je alweer te snacken en te <w>snoepen</w> terwijl we bijna gaan eten?",
                            "target_lang_translations": {
                                "en": "Are you <w>snacking</w> and eating treats again even though we're about to eat?"
                            }
                        }
                    ],
                    "synonyms": [
                        "snacken"
                    ],
                    "common_phrases": [
                        "tussendoor snoepen"
                    ],
                    "target_lang_definitions": {
                        "en": "eating small amounts of food between regular meals, often snacks"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snack",
                                "target_lang_sense_clarification": "eating between meals"
                            },
                            {
                                "target_lang_word": "to nibble",
                                "target_lang_sense_clarification": "eating small bits of food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bbd7eb6-d5f8-3bfd-a11d-4a1017dde0f8",
                    "sense_definition": "met veel plezier ergens van genieten of proeven, ook in figuurlijke zin",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "genieten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De voetballiefhebbers konden <w>snoepen</w> van de prachtige doelpunten tijdens de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The football fans could <w>relish</w> the beautiful goals during the match."
                            }
                        },
                        {
                            "text": "Hij stond stiekem te <w>snoepen</w> van de saus die nog in de pan zat.",
                            "target_lang_translations": {
                                "en": "He was secretly <w>sneaking a taste</w> of the sauce that was still in the pan."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snoepen van"
                    ],
                    "target_lang_definitions": {
                        "en": "to enjoy or taste something with great pleasure, often used figuratively"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to feast on",
                                "target_lang_sense_clarification": "to enjoy something immensely"
                            },
                            {
                                "target_lang_word": "to relish",
                                "target_lang_sense_clarification": "to get great pleasure from something"
                            },
                            {
                                "target_lang_word": "to sample",
                                "target_lang_sense_clarification": "to taste or experience a small part of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}