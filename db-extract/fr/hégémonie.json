        "fr-extract.jsonl": [
            {
                "entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                "word": "hégémonie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b44cc89-b0c8-495e-a120-432a9e76647a",
                        "entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "tags": [
                            "plural"
                        ],
                        "form": "hégémonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7608347d-7010-37a6-a1be-deb77b46c1d0",
                        "entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "glosses": [
                            "Domination souveraine d’une puissance, d’une nation sur d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ad96c99-81f9-4409-a552-b524c9cd7048",
                                "sense_id": "7608347d-7010-37a6-a1be-deb77b46c1d0",
                                "text": "[…], l’Europe occidentale nous apparaît divisée en nations, dont quelques-unes, à certaines époques, ont cherché à exercer une hégémonie sur les autres, sans jamais y réussir d’une manière durable."
                            },
                            {
                                "example_id": "8769c5cf-ff6a-4d7e-8027-5ddc8cdbf79f",
                                "sense_id": "7608347d-7010-37a6-a1be-deb77b46c1d0",
                                "text": "Le projet était hardi, mais le fait de l’entreprendre prouvait que le Danemark entendait conserver son hégémonie sur tout le Groenland."
                            },
                            {
                                "example_id": "bfbe6289-33a8-49cf-82fc-2280ee6e717c",
                                "sense_id": "7608347d-7010-37a6-a1be-deb77b46c1d0",
                                "text": "Mais cette même classe allait accepter, au lendemain de la guerre du Pacifique, durant la même décennie 1880-1890, de se livrer à l’impérialisme britannique, plus puissant et doté d’une plus forte hégémonie : […]."
                            },
                            {
                                "example_id": "5b79fdb3-47f9-41ea-9571-8c4a34170b75",
                                "sense_id": "7608347d-7010-37a6-a1be-deb77b46c1d0",
                                "text": "Le Moyen Âge […] est la période au cours de laquelle se sont mis en place les fondements de l’hégémonie historique de l’Occident à l’échelle planétaire, bien que le discours techniciste ambiant tende à limiter les causes de cette hégémonie à la Révolution Industrielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "96f33f33-fba1-3388-8d33-8f0752242a24",
                        "entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "glosses": [
                            "Suprématie ; supériorité."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4bfd9679-4211-47d9-9899-a82ca51709ef",
                                "sense_id": "96f33f33-fba1-3388-8d33-8f0752242a24",
                                "text": "[…] or, après trois décennies d’hégémonie idéologique néolibérale et de pari sur la main invisible du marché, les retombées délétères du capitalisme de casino et l’effilochage du lien social qu’il entraine semble redonner, au moins sur une partie de la scène académique, une nouvelle actualité à ce souci."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ae357d5-dbac-35a1-855a-e6fd866f30a1",
                        "entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "glosses": [
                            "Suprématie d’une cité, d'un peuple, dans les fédérations ou amphictyonies."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "f0683057-bde3-4813-ac2a-302ad70115bb",
                                "sense_id": "6ae357d5-dbac-35a1-855a-e6fd866f30a1",
                                "text": "Athènes et Sparte se disputèrent l’hégémonie de la Grèce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2426489b-15a0-45d1-b017-52c961c83d3f",
                        "source_entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "target_lang_word": "Hegemonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hegemonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e88f37e8-878c-39b1-af9a-b46a34f8fd3d",
                                        "entry_id": "6dcbc656-d62a-3a35-a570-e2e52c74e0e3",
                                        "glosses": [
                                            "Vormachtstellung und die damit verbundene Vorherrschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3a0a11-21e5-4f7c-917b-5f39d4805fc0",
                                                "sense_id": "e88f37e8-878c-39b1-af9a-b46a34f8fd3d",
                                                "text": "Die Hegemonie der Deutschen im Bereich Zentraleuropas wurde aufgebrochen."
                                            },
                                            {
                                                "example_id": "11143478-c810-443c-a714-6a6cbdc4c5f8",
                                                "sense_id": "e88f37e8-878c-39b1-af9a-b46a34f8fd3d",
                                                "text": "„Tatsächlich ordnet sich der gegen Philipp V. ausgebrochene 2. Römisch-Makedonische Krieg in eine lange Reihe imperialistischer Übergriffe ein, die so alt waren wie die Errichtung der römischen Hegemonie über Italien.“"
                                            },
                                            {
                                                "example_id": "f2a2bb6a-67d1-4d1f-a149-e44087d0885b",
                                                "sense_id": "e88f37e8-878c-39b1-af9a-b46a34f8fd3d",
                                                "text": "„Wer die kulturelle Hegemonie in den verschiedenen gesellschaftlichen Bereichen gewönne, dem würden schlußendlich Staat und Politik in den Schoß fallen wie eine reife Frucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a38d142d-3e9a-41c9-8fd0-077619f1c292",
                        "source_entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "target_lang_word": "Vorherrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorherrschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50d357e8-c6d4-38ad-a541-986539774d86",
                                        "entry_id": "5169b081-ecd6-3958-94b5-3474919505f5",
                                        "glosses": [
                                            "überlegene Macht/überlegener Einfluss in wesentlichen Belangen in einem bestimmten Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10442139-d579-4f27-8fb8-ebc69650acac",
                                                "sense_id": "50d357e8-c6d4-38ad-a541-986539774d86",
                                                "text": "„Hobhouse hatte im Dezember 1900 Südafrika besucht, wo seit einem Jahr ein erbitterter Krieg um die Vorherrschaft am Kap tobte.“"
                                            },
                                            {
                                                "example_id": "5f70f8cb-4b12-40b9-95c2-bac883babe55",
                                                "sense_id": "50d357e8-c6d4-38ad-a541-986539774d86",
                                                "text": "„Der lebensweltliche und literarische Standardkonflikt der früheren Zeiten, der Kampf des Einzelnen gegen Zwänge und Vorherrschaften, scheint der Literatur nicht mehr angemessen.“"
                                            },
                                            {
                                                "example_id": "6645b33d-3a2b-46da-b817-9231f0c9e188",
                                                "sense_id": "50d357e8-c6d4-38ad-a541-986539774d86",
                                                "text": "„Sein Amtsbonus als Regierungschef und Staatsmann soll dabei helfen, die kommunalen Vorherrschaften in Kopenhagen und Arhus zu verteidigen.“"
                                            },
                                            {
                                                "example_id": "af063ff0-4e01-4a4f-993a-9defeae8d3b7",
                                                "sense_id": "50d357e8-c6d4-38ad-a541-986539774d86",
                                                "text": "„Viele schicken ihre Familien nach Europa oder gehen nach Rhodesien und Südafrika, wo die weiße Vorherrschaft unangetastet ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63928b1c-4f22-4e7e-bdb2-1031be3e6171",
                        "source_entry_id": "3aae1411-f1cf-314c-88c3-4a9968b1c211",
                        "target_lang_word": "hegemony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hegemony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7390bf5-92d2-316d-bff6-ac572dfc3a23",
                                        "entry_id": "ab8ff8d7-4243-3706-819f-0a3833c2f235",
                                        "glosses": [
                                            "Domination, influence, or authority over another, especially by one political group over a society or by one nation over others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab08703c-f0cd-4d0f-b457-a38920a0c32a",
                                                "sense_id": "e7390bf5-92d2-316d-bff6-ac572dfc3a23",
                                                "text": "The idea of a German republic and confederacy like the American, is surely less fantastical than a hegemony to which nobody is willing to submit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07168a8c-ae50-3706-9b6f-3555d72044a3",
                                        "entry_id": "ab8ff8d7-4243-3706-819f-0a3833c2f235",
                                        "glosses": [
                                            "Dominance of one social group over another, such that the ruling group or hegemon acquires some degree of consent from the subordinate, as opposed to dominance purely by force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93eb7ede-6739-43c9-a254-65ba118821c7",
                                                "sense_id": "07168a8c-ae50-3706-9b6f-3555d72044a3",
                                                "text": "The two political parties battled viciously for hegemony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
