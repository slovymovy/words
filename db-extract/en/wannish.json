                        "examples": [
                            {
                                "example_id": "4f8e643d-db8e-42c0-9253-0e5906f04963",
                                "sense_id": "86736b62-636d-30d8-bfd0-8c78554f5972",
                                "text": "Upon her crest she wore a wannish fire / Sprinkled with stars, like Ariadne's tiar: [...]"
                            },
                            {
                                "example_id": "456cb95e-82db-4e81-98ad-7156eb50d7b3",
                                "sense_id": "86736b62-636d-30d8-bfd0-8c78554f5972",
                                "text": "The moon turns the smoke into wannish clouds of white and yellow, which slowly rise, break, and disappear."
                            },
                            {
                                "example_id": "5f6da500-37df-4f74-a28f-5eae68a956b0",
                                "sense_id": "86736b62-636d-30d8-bfd0-8c78554f5972",
                                "text": "Sheer slanting down the sky an opal light Pierces the snow-blur's veil of wannish gray, In iridescent sheen, tingeing the dazzling white With amethystine, gold or beryl ray."
                            }
                        ]
