                "senses": [
                    {
                        "sense_id": "50e10eff-13be-35f0-94cd-b648030e21dc",
                        "entry_id": "13723dfa-c611-37fa-af96-b410bd0dd42c",
                        "glosses": [
                            "dat wat een vader of moeder doen bij de opvoeding van kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d4ff15-9cab-4fd2-885e-68b453eb9235",
                                "sense_id": "50e10eff-13be-35f0-94cd-b648030e21dc",
                                "text": "Merz promoveerde vandaag aan de Vrije Universiteit in Amsterdam op een onderzoek naar de ouder-kindrelatie gedurende de levensloop. Ouders vinden het moeilijk om hun ouderrol weg te geven, stelt Merz vast."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fea8d8b-7d2d-3aa6-9fdf-442fe83b5096",
                        "entry_id": "13723dfa-c611-37fa-af96-b410bd0dd42c",
                        "glosses": [
                            "het spelen van een vader of moeder zonder het werkelijk te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877664a1-f37b-4eeb-baf2-198d0776f9f8",
                                "sense_id": "4fea8d8b-7d2d-3aa6-9fdf-442fe83b5096",
                                "text": "Korte tijd later kwam ik in contact met Jeffrey Young, de Amerikaanse grondlegger van de schematherapie. In die therapie bleek hij de ervaringsgerichte oefeningen te koppelen aan limited reparenting: als therapeut neem je een soort ouderrol aan, om de patiënten te helpen bij de rijping van hun emotionele ontwikkeling tot volwassenheid.”"
                            },
                            {
                                "example_id": "d7631352-3eeb-4f34-b8b3-58a6fd58ec73",
                                "sense_id": "4fea8d8b-7d2d-3aa6-9fdf-442fe83b5096",
                                "text": "Een gz-psycholoog uit Nijmegen mag haar vak nooit meer uitoefenen vanwege haar behandeling van een 22-jarige patiënte die in 2011 zelfmoord pleegde. De psycholoog en haar partner namen de anorexiapatiënte meerdere keren in huis en lieten zich door haar ‘papa’ en ‘mama’ noemen, waarna de psycholoog plotseling met die ouderrol brak en de patiënte zelfmoord pleegde."
                            },
                            {
                                "example_id": "09c9b0af-0d01-46e6-9e4c-4ef6a8b934d2",
                                "sense_id": "4fea8d8b-7d2d-3aa6-9fdf-442fe83b5096",
                                "text": "Imanuelle Grives (Alleen maar nette mensen) speelt de rol van moeder Shirley. Andere ouderrollen zijn voor Tatum Dagelet en Terence Schreurs. Acteur Mohamed Chaara speelt de rol van coach Choukri."
                            }
                        ]
                    }
