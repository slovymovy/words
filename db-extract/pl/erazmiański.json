                    }
                ],
                "translations": [
                    {
                        "translation_id": "508426b9-22e7-4361-a5b3-611cf7f58cc2",
                        "source_entry_id": "ffddab33-80fa-3f3c-a583-7673119c2649",
                        "source_sense_id": "c27d9dc3-6c4d-3213-af38-fcf7879bbd81",
                        "target_lang_word": "Erasmian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erasmian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f02a85-d276-3c0c-a24f-b2cc72174a6d",
                                        "entry_id": "a1f57ef5-ad49-36f9-9c06-3f0a42a1264e",
                                        "glosses": [
                                            "Of or pertaining to Erasmus (Catholic priest and theologian)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206b5de6-103f-46ba-90e3-1d89aedb59d9",
                                                "sense_id": "11f02a85-d276-3c0c-a24f-b2cc72174a6d",
                                                "text": "It was not, as Juan de Valdes very clearly attests, repugnant to an Erasmian Evangelical, even if he otherwise admired Luther."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Erasmian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b1fb02a-8e82-35ad-a1da-bb30aac9e02b",
                                        "entry_id": "9ece34ee-c4d6-3786-879c-72348b4472c6",
                                        "glosses": [
                                            "A follower of Erasmus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b5011f-03d7-4b03-adf6-e1a24402d125",
                                                "sense_id": "7b1fb02a-8e82-35ad-a1da-bb30aac9e02b",
                                                "text": "The spirit of the Spanish Erasmians was in fact different from the spirit that inspired Erasmus and his followers in the rest of Western Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1b9fe79-1a40-4193-877d-34f26f8bfd1b",
                        "source_entry_id": "ffddab33-80fa-3f3c-a583-7673119c2649",
                        "source_sense_id": "c27d9dc3-6c4d-3213-af38-fcf7879bbd81",
                        "target_lang_word": "érasmien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "érasmien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "739ed41c-42d0-39e7-b905-36eef36005bb",
                                        "entry_id": "8c387255-358a-3284-b07b-e8479ef01ac8",
                                        "glosses": [
                                            "Relatif à la vie ou à l’œuvre d’Érasme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "160b0991-0e28-4141-9f05-673223c6009e",
                                                "sense_id": "739ed41c-42d0-39e7-b905-36eef36005bb",
                                                "text": "L’école, la réforme érasmienne."
                                            },
                                            {
                                                "example_id": "6478265d-aada-4d6f-8be3-eafc169c5319",
                                                "sense_id": "739ed41c-42d0-39e7-b905-36eef36005bb",
                                                "text": "L’influence de la réforme érasmienne s’étend même au produit de au qu’elle fait repasser au o ouvert du Vᵉ siècle."
                                            },
                                            {
                                                "example_id": "e35f3a96-4e25-4c68-a920-9963f35dde05",
                                                "sense_id": "739ed41c-42d0-39e7-b905-36eef36005bb",
                                                "text": "En France, l’enseignement du grec ancien utilise la prononciation érasmienne du grec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87bfa14c-8aee-3ecb-b1de-6eb2d2672ad7",
                                        "entry_id": "8c387255-358a-3284-b07b-e8479ef01ac8",
                                        "glosses": [
                                            "Favorable à la philosophie, aux idées d’Érasme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "érasmien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2384fcf3-7b86-3515-bc4a-d3e12871c9b4",
                                        "entry_id": "22ac25c9-9098-3609-b82a-24e224da39fb",
                                        "glosses": [
                                            "Partisan d’Érasme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f275cc-48a2-4cd6-98e9-47c138678a28",
                                                "sense_id": "2384fcf3-7b86-3515-bc4a-d3e12871c9b4",
                                                "text": "Très doué pour les langues, Michel Servet étudia le latin, le grec et l’hébreu et, à l’âge de quinze ans, il entra au service d’un érasmien franciscain du nom de Juan de Quintana."
                                            },
                                            {
                                                "example_id": "cbb217d9-4570-4260-bfca-ea171c2e054c",
                                                "sense_id": "2384fcf3-7b86-3515-bc4a-d3e12871c9b4",
                                                "text": "Avec les douze ouvrages et les quatre préfaces de Philippe Mélanchthon, nous retrouvons un intellectuel, un érasmien et un philosophe ainsi qu’un grand théologien systématique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
