                "senses": [
                    {
                        "sense_id": "790860ae-4c12-33c7-853c-3c815df83382",
                        "entry_id": "2a272ed6-3b65-3d19-954d-01ab9e914705",
                        "glosses": [
                            "Rendre analogique (au sens opposé à celui de numérique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe5c97b-bd16-47dc-9bb8-9643c85026d8",
                                "sense_id": "790860ae-4c12-33c7-853c-3c815df83382",
                                "text": "J'ai entendu dire que l'on pouvait analogiser un N° SDA (sortir ce N° SDA de la suite SDA pour le transformer en ligne analogique)."
                            },
                            {
                                "example_id": "bbe634d7-2bb5-49d3-8923-e88a880b8c96",
                                "sense_id": "790860ae-4c12-33c7-853c-3c815df83382",
                                "text": "On remarque que, pour analogiser un son digital, que ce soit dans le monde studio comme dans celui de la hifi, il faut un convertisseur bien pensé/conçu, qui n'est jamais le chantre de l'abordabilité."
                            },
                            {
                                "example_id": "23983495-4dba-4d9a-86e8-480ef0e3e87d",
                                "sense_id": "790860ae-4c12-33c7-853c-3c815df83382",
                                "text": "il est plus facile de numériser un 33t que d'analogiser un CD."
                            }
                        ]
                    },
