                    {
                        "sense_id": "23f7af4d-e363-3313-a6fa-cd14fd1fccfc",
                        "entry_id": "a89daf54-2ae0-36c4-81f0-72a7ad428a02",
                        "glosses": [
                            "Auteur d’un attentat, celui qui commet un attentat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a587bce5-c77d-4cef-a09c-83553e5193a8",
                                "sense_id": "23f7af4d-e363-3313-a6fa-cd14fd1fccfc",
                                "text": "Der Attentäter konnte von der Polizei gefasst werden.",
                                "translation": "La police a réussi à appréhender l’auteur de l’attentat."
                            },
                            {
                                "example_id": "cce34736-09fe-46a0-bf33-eaae2e59e374",
                                "sense_id": "23f7af4d-e363-3313-a6fa-cd14fd1fccfc",
                                "text": "Der Attentäter ist seit zwölf Jahren ohne Kontakt zu Mithäftlingen in Hochsicherheitsgefängnissen untergebracht.",
                                "translation": "L'agresseur est détenu depuis douze ans dans des prisons de haute sécurité, sans contact avec des codétenus."
                            }
                        ]
                    }
                ],
