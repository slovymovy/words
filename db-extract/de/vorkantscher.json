                "senses": [
                    {
                        "sense_id": "38d88e5d-cb35-3ac2-b009-649abbfd7950",
                        "entry_id": "11c59830-cc4a-3559-832e-b969bf658339",
                        "glosses": [
                            "pre-Kantian, coming before Immanuel Kant, the philosopher"
                        ],
                        "tags": [
                            "no-predicative-form",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0e8cd70-db6f-4972-9d38-26ffc37de4d7",
                                "sense_id": "38d88e5d-cb35-3ac2-b009-649abbfd7950",
                                "text": "Man glaubt sich mit jener Ansicht erhaben über die vorkantsche «Naivität», die die Dinge im Raume und in der Zeit für Wirklichkeit hield, wie es der naive Mensch, der keine wissenschaftliche Bildung hat, heute noch tut.",
                                "translation": "With this vision, one imagines oneself above this pre-Kantian «naivity», which holds the things in space and time for reality, just like the naive man does, who has no scientific education.",
                                "english": "With this vision, one imagines oneself above this pre-Kantian «naivity», which holds the things in space and time for reality, just like the naive man does, who has no scientific education."
                            }
                        ]
