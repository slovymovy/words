                                        "glosses": [
                                            "przerwa między aktami, w trakcie spektaklu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06764a5-a308-45c0-8f2d-b1b77188dbd5",
                                                "sense_id": "6d4c88b3-cd87-3481-8ea4-73dabb43f81a",
                                                "text": "Wykwintny poczęstunek dla widzów Loży Prezydenckiej serwowany jest przed spektaklem bądź w antrakcie"
                                            }
