                                        "entry_id": "19fecffd-fb45-38f9-a4fe-19fd4c36f261",
                                        "glosses": [
                                            "To become detached, come away, especially in flakes or strips; to shed skin in such a way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c53d51b7-d005-4208-a14c-f42a8250966d",
                                                "sense_id": "8a871739-7e79-3b8b-b8a8-19aae914cb6c",
                                                "text": "I had been out in the sun too long, and my nose was starting to peel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aebf9aa2-6c85-3660-8279-44d89ed0cbc1",
