                            "comment": "academic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать подстрочник или шпаргалку при переводе.",
                        "zh": "在翻译时使用小抄或作弊条。"
                    },
                    "translations": {
