                "senses": [
                    {
                        "sense_id": "7b4a60c4-4f5b-3cce-86de-335550afb07f",
                        "entry_id": "af9cd0e2-5723-3071-9765-2362046079e8",
                        "glosses": [
                            "Remplacer dans une page l’appel d’un modèle par le résultat après traitement de ce modèle."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "c7b43fd2-7c44-428c-9ff0-b75b67dbf5da",
                                "sense_id": "7b4a60c4-4f5b-3cce-86de-335550afb07f",
                                "text": "Pourquoi on subste le modèle exactement ?"
                            },
                            {
                                "example_id": "82261634-9297-425e-b97a-8759bed3d2a9",
                                "sense_id": "7b4a60c4-4f5b-3cce-86de-335550afb07f",
                                "text": "Ce modèle est à apposer sur les modèles à subster, afin d'afficher des informations importantes dans la gestion du modèle, et de l'ajouter la catégorie de maintenance correspondante."
                            },
                            {
                                "example_id": "694b5f99-33c7-430a-9549-12214cacad61",
                                "sense_id": "7b4a60c4-4f5b-3cce-86de-335550afb07f",
                                "text": "Ce modèle devra être « substé » pour une raison bien simple, la liste change en fin de saison."
                            }
                        ]
                    }
