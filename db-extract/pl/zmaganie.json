                    },
                    {
                        "sense_id": "8e93cef1-e5f6-319d-a54d-eb38291ff6a0",
                        "entry_id": "aeec2043-a3d0-378b-80e9-169d57f0794c",
                        "glosses": [
                            "spór lub walka wręcz z kimś"
                        ],
