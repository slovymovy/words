                            {
                                "example_id": "9587f42c-cf9b-4391-805b-c9f98ab855ba",
                                "sense_id": "3acb6eb5-aee2-33cc-9886-011869ba5372",
                                "text": "Voor het slapen gaan bidt ik een weesgegroetje."
