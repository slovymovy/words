                        "glosses": [
                            "In a spectacular manner, extraordinarily, amazingly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4da3399-7f4c-4ac2-aa8b-9ed6279eb0bb",
                                "sense_id": "ee81434f-4082-355b-9057-a19d025d64c6",
                                "text": "This argument turns out to be spectacularly mistaken. When fiction works, the individual and the universal are frictionlessly combined."
                            },
                            {
                                "example_id": "895fc71a-b465-476d-9676-fc357523ca22",
                                "sense_id": "ee81434f-4082-355b-9057-a19d025d64c6",
                                "text": "Obsessed only with cost, 'Sir Humphrey' saw that Transport for London 'got away' with ticket office closures on the Tube with only minor public pushback and miscalculated that it could do the same on the national network. This assumption backfired spectacularly."
                            }
                        ]
                    }
                ],
