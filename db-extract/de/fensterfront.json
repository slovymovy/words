                "senses": [
                    {
                        "sense_id": "8f267135-8c69-338a-bc24-5af3d61e279a",
                        "entry_id": "975d4199-a1de-36ec-8751-2cfa96644c3e",
                        "glosses": [
                            "Außenseite eines Gebäudes mit vielen Fenstern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bba4430-ab3d-44ff-8aa7-5dc1e233b36f",
                                "sense_id": "8f267135-8c69-338a-bc24-5af3d61e279a",
                                "text": "„Mit verschränkten Armen, die Augen zur Fensterfront gerichtet, blies der bärtige Hüne Ringe aus Zigarrenrauch in die Luft, die sich wie Ringe auf einer Wasseroberfläche ausdehnten.“"
                            },
                            {
                                "example_id": "d2b1e2cf-c83e-46fd-82f9-1821c388e794",
                                "sense_id": "8f267135-8c69-338a-bc24-5af3d61e279a",
                                "text": "„Ich ging, in das Handtuch eingewickelt, vor der Fensterfront auf und ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
