                        "form": "*трусца́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abb084b1-7bc7-32df-91fc-2ebc2a8e0ee9",
                        "entry_id": "b13a43e4-6fab-3ec3-aa54-9bdae54bcfbe",
                        "glosses": [
                            "неторопливый бег"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2d4794-ae2d-49d6-9838-0cc487b622ee",
                                "sense_id": "abb084b1-7bc7-32df-91fc-2ebc2a8e0ee9",
                                "text": "Выходило даже смешно, когда этот тучный старик, подобрав полы монашеской рясы, жалкою трусцой семенил через двор."
                            },
                            {
                                "example_id": "a760188f-9953-48b9-8d46-fadb0fa45336",
                                "sense_id": "abb084b1-7bc7-32df-91fc-2ebc2a8e0ee9",
                                "text": "Мускулы как бы увядали зимой; бега ― не было; была ― трусца; верховая езда заменялась корпением в лаборатории; и увядали все образы."
                            },
                            {
                                "example_id": "01cac6f9-5a31-4c75-8096-ab314cd97557",
                                "sense_id": "abb084b1-7bc7-32df-91fc-2ebc2a8e0ee9",
                                "text": "По тропинкам сновали жизнерадостные любители трусцы."
                            }
                        ]
                    },
                    {
                        "sense_id": "0486e1b8-0f39-397b-8578-e3d6f23903ef",
                        "entry_id": "b13a43e4-6fab-3ec3-aa54-9bdae54bcfbe",
                        "glosses": [
                            "мелкая рысь (аллюр у лошади)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecffcda-8987-4683-a734-2cf681f170ef",
                                "sense_id": "0486e1b8-0f39-397b-8578-e3d6f23903ef",
                                "text": "За ним ехал донской казак, то отстававший, то трусцою догонявший ходкого коня «барина»"
                            },
                            {
                                "example_id": "9a03482e-8e43-46ed-8d29-5193a63b71d4",
                                "sense_id": "0486e1b8-0f39-397b-8578-e3d6f23903ef",
                                "text": "Войсковой старшина Сафронов, ведший дивизион, скомандовал «рысью», и три сотни, рассыпаясь, вытягиваясь, пошли тяжкой трусцой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff214c67-6a26-4b46-9ac4-d70fb264e5b3",
                        "source_entry_id": "b13a43e4-6fab-3ec3-aa54-9bdae54bcfbe",
