                                "example_id": "d4abe741-f981-4e9e-9bf7-ce0ee2c81e68",
                                "sense_id": "96cd4746-345a-39da-8991-05cda40bd55a",
                                "text": "„Ich kann Major Kiyanis Fahrkünste nur bewundern.“"
                            },
                            {
                                "example_id": "15fb63b8-61f9-4beb-8e71-059952868d13",
                                "sense_id": "96cd4746-345a-39da-8991-05cda40bd55a",
                                "text": "„Eggert war zurückhaltend, was seine Fahrkünste betraf, und ging noch deutlich versierter mit dem Boot um, als Ari erwartet hatte.“"
                            },
                            {
                                "example_id": "6d6fc435-aadd-4ad4-b211-a3c66060ec59",
                                "sense_id": "96cd4746-345a-39da-8991-05cda40bd55a",
                                "text": "„Bei einer möglichen Verfolgungsjagd konnte man sich auf seine Fahrkünste verlassen.“"
                            }
                        ],
