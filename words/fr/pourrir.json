                    "frequency": "High",
                    "semantic_group_id": "alteration_matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fruits non consommés <w>pourrissent</w> vite quand il fait très chaud."
                        },
                        {
                            "text": "Si tu laisses ce bois dehors sous la pluie, il va <w>pourrir</w>."
                        }
                    ],
                    "synonyms": [
