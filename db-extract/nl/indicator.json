                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094f4d16-c2ad-4848-9e52-83a631a23db8",
                                "sense_id": "831926ae-8581-3b42-85ae-ce468536b8e1",
                                "text": "Door de extreme weersomstandigheden als gevolg van klimaatverandering laait in de VS de discussie op over de leefbaarheid in risicogebieden. De keuzes die verzekeringsmaatschappijen maken zijn daar een goede indicator van. Experts zijn somber over de situatie."
                            }
                        ]
                    },
                    {
