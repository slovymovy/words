                "senses": [
                    {
                        "sense_id": "58aa7f10-f6eb-3b8c-85bf-3368e01d852d",
                        "entry_id": "121777a2-0661-3266-9bce-b8e359967736",
                        "glosses": [
                            "Zeitraum, der den Anfang von etwas (beispielsweise einer Entwicklung) darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c10453-67a5-4cd6-a565-85abe32ad052",
                                "sense_id": "58aa7f10-f6eb-3b8c-85bf-3368e01d852d",
                                "text": "„In der Frühzeit der modernen Psychiatrie wurde Forschung fast ausschließlich in Anstalten betrieben und befasste sich vor allem mit der Klassifizierung von Patienten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb6a621c-f44b-4e98-bb73-3dccc957ddb8",
                        "source_entry_id": "121777a2-0661-3266-9bce-b8e359967736",
                        "source_sense_id": "58aa7f10-f6eb-3b8c-85bf-3368e01d852d",
                        "source_sense_description": "Zeitraum, der den Anfang von etwas (beispielsweise einer Entwicklung) darstellt",
                        "target_lang_word": "early days",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "early days",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ea2723-6f11-36c8-9e70-4932a9b6b374",
                                        "entry_id": "316f4638-3c6d-3a63-801d-b0a0183823f1",
                                        "glosses": [
                                            "A time too soon to make a decision or come to a conclusion."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e826666-92bc-45e0-b7b7-f3172f561b93",
                                                "sense_id": "a5ea2723-6f11-36c8-9e70-4932a9b6b374",
                                                "text": "It’s early days (yet) to know for certain."
                                            },
                                            {
                                                "example_id": "9c5f9592-9440-462a-acd7-24eb119e5981",
                                                "sense_id": "a5ea2723-6f11-36c8-9e70-4932a9b6b374",
                                                "text": "Lorna liked the sudden transition from urban overcrowding to the rural isolation of Kintrawe House, but she knew it was early days yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1fe7dac-f630-3511-a93c-f11daa1b5952",
                                        "entry_id": "316f4638-3c6d-3a63-801d-b0a0183823f1",
                                        "glosses": [
                                            "The initial period of an innovation"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed3c181c-0bc4-47d3-b6ca-8e5b9fbd3816",
                                                "sense_id": "c1fe7dac-f630-3511-a93c-f11daa1b5952",
                                                "text": "In the early days of television, the service was always breaking down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fc0b36-5e04-3b0d-ada9-ec6d83f576ad",
                                        "entry_id": "316f4638-3c6d-3a63-801d-b0a0183823f1",
                                        "glosses": [
                                            "Initial stages of a project."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c23792b-3243-4278-8ab0-d0a43900f5e1",
                                                "sense_id": "11fc0b36-5e04-3b0d-ada9-ec6d83f576ad",
                                                "text": "Hold on. We're still early days on this."
                                            },
                                            {
                                                "example_id": "4fbb579a-9f6c-4dd7-8770-d3372c1c1ef5",
                                                "sense_id": "11fc0b36-5e04-3b0d-ada9-ec6d83f576ad",
                                                "text": "This is still early days, with more to wrap up in the morning and […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3f8e9d1-6608-4acc-adcc-c2dc86a23e09",
                        "source_entry_id": "121777a2-0661-3266-9bce-b8e359967736",
                        "source_sense_id": "58aa7f10-f6eb-3b8c-85bf-3368e01d852d",
                        "source_sense_description": "Zeitraum, der den Anfang von etwas (beispielsweise einer Entwicklung) darstellt",
                        "target_lang_word": "début",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "début",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Commencement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e06834d-2260-4e17-a435-255e61c0b737",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "Le café noir très fort qu’il a pris au début de la veille, empêche Arsène André de s’endormir."
                                            },
                                            {
                                                "example_id": "1aef38a6-7cad-4a7d-a068-3a1b0d0d0158",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "Après des débuts réussis, le FC Nantes s’est sèchement incliné, jeudi, (3-0) sur la pelouse du FC Qarabag, à Bakou (Azerbaïdjan)."
                                            },
                                            {
                                                "example_id": "1d836899-fbed-46a5-8f28-d927eee2cfd5",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "C’est après avoir su nous remettre complètement dans le bain que Peter Jakcson nous ramène là où il nous avait laissé, autrement dit dans la Comté. En créant de manière subtile le lien entre ce film et le début de La Communauté de l’anneau, il nous prouve une fois encore qu’il a tout compris au principe d’adaptation."
                                            },
                                            {
                                                "example_id": "d095bc69-40af-428e-b563-19cc023da2f5",
                                                "sense_id": "42fd3ae9-4866-3f44-963c-2d9c7f5beb86",
                                                "text": "Accroche-cœur –\nAux larmes de cendre,\nelle regarda\nla rouflaquette de l’écrin,\nsouvenir\nd’une époque crépusculaire,\npeu avant le début\n…\nde sa chimiothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Premiers essais sur les planches, au théâtre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c32846-d0a9-4ed2-846c-d4b15abdacd3",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Un rôle de début."
                                            },
                                            {
                                                "example_id": "ae6ba40c-db7c-4ef7-a7b4-38da01d70a48",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Premier, second début."
                                            },
                                            {
                                                "example_id": "07122021-91fb-43b9-8183-c7c22d69de6a",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Il a obtenu un ordre de début."
                                            },
                                            {
                                                "example_id": "c982e4ed-a21c-4f37-b078-e4de196ab8ba",
                                                "sense_id": "c18f7732-03f6-3049-afcd-cd4e8c2be8c3",
                                                "text": "Cet acteur a terminé ses débuts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398990d4-a567-3674-b214-09d1e2d2bf92",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Premier ouvrage d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13a6aa9-ded2-442e-ba50-daba9249edba",
                                                "sense_id": "398990d4-a567-3674-b214-09d1e2d2bf92",
                                                "text": "Mélite fut le début de Corneille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107f5879-0558-30cb-9513-940571056b8d",
                                        "entry_id": "6540ec01-d24d-33b9-97dd-2733ac449127",
                                        "glosses": [
                                            "Départ dans la vie, dans une profession ou dans une entreprise."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a1703e9-baa2-4377-86f0-1c190bc3d03b",
                                                "sense_id": "107f5879-0558-30cb-9513-940571056b8d",
                                                "text": "Vraiment, par expérience, je plains le jeune prêtre que l’on envoie, pour ses débuts, évangéliser la Beauce."
                                            },
                                            {
                                                "example_id": "f58e1593-7eb4-4ed6-8081-1b510dcba57d",
                                                "sense_id": "107f5879-0558-30cb-9513-940571056b8d",
                                                "text": "Cet avocat n’a pas réalisé les espérances que son début avait fait concevoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
