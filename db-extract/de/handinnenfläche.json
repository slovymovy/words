                "senses": [
                    {
                        "sense_id": "78401308-fbca-381c-a989-fb04071580cf",
                        "entry_id": "42adb232-0eeb-3dcd-8910-fe6f4637c263",
                        "glosses": [
                            "innere Fläche der Hand (ohne Finger)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b8a25d-320d-434d-8f7a-6c302818b2d9",
                                "sense_id": "78401308-fbca-381c-a989-fb04071580cf",
                                "text": "„Ich nehme die Seife, tauche sie ein und seife mir die Hände, die Handinnenfläche, den Handrücken kräftig ein.“"
                            },
                            {
                                "example_id": "adceb1c6-f8b8-4f43-b742-a3c10b87c1e8",
                                "sense_id": "78401308-fbca-381c-a989-fb04071580cf",
                                "text": "„Dabei überprüft der Kellner mit der Handinnenfläche gleichzeitig die Temperatur der Flasche Wein.“"
                            },
                            {
                                "example_id": "f86fe027-f92c-4aac-9077-02367561e068",
                                "sense_id": "78401308-fbca-381c-a989-fb04071580cf",
                                "text": "„Starke Nerven und viel Hornhaut an den Handinnenflächen brauchten die Fans der SOBA Dragons Rhöndorf bei der Partie gegen die Bremen Roosters.“"
                            },
                            {
                                "example_id": "fb1998e2-11d6-4875-829d-67fa6cb291ac",
                                "sense_id": "78401308-fbca-381c-a989-fb04071580cf",
                                "text": "„Der Brustmuskel wird bei einem normalen Klimmzug auch trainiert, also wenn die Handinnenflächen weg vom Körper zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
