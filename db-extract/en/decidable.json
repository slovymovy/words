                        "glosses": [
                            "describing a set for which there exists an algorithm that will determine whether any element is or is not within the set in a finite amount of time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa07414-44e6-4009-88df-e2d6a617319a",
                                "sense_id": "b497478e-1524-3b88-85d2-24e78cab5e2d",
                                "text": "It is easy to show that the set of even numbers is decidable by creating the relevant Turing machine."
                            }
                        ]
                    },
                    {
