                ],
                "senses": [
                    {
                        "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                        "entry_id": "589ac27a-7eeb-3bf8-b5e5-49b8e73bbd86",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1eae7ec-43da-4650-a960-76c02c079a9c",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Frau Kühner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c063eccd-064b-48d7-98f7-c3180c521350",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Herr Kühner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e8d317de-0390-4673-afd7-d5388abc0772",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Die Kühners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "986e1098-80ac-40ae-84e0-fac3a8dd06e3",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Der Kühner trägt nie die Schals, die die Kühner ihm strickt."
                            },
                            {
                                "example_id": "8768b6b3-da11-4867-9909-d786432a0292",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kühner kommt, geht der Herr Kühner.“"
                            },
                            {
                                "example_id": "7d703b03-b3f4-4978-b2c2-23262e3b437a",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Kühner kommt und geht."
                            },
                            {
                                "example_id": "26374b71-07f6-43e6-b8b8-4f8b5f8fa9d7",
                                "sense_id": "75377b7b-dc70-3baa-9ea1-ff9d058ad6dd",
                                "text": "Kühners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
