                                        "examples": [
                                            {
                                                "example_id": "6fa94fce-ad49-46f3-90d2-9333a6bd041c",
                                                "sense_id": "a5aa9400-1046-3aea-9497-969bbc9bc641",
                                                "text": "Un brasseur de Lviv, en Ukraine, se plaît à donner une couleur politique à ses bières."
                                            },
                                            {
                                                "example_id": "0cee5f99-bd4a-4fb6-b2b9-fa9d22465d1c",
                                                "sense_id": "a5aa9400-1046-3aea-9497-969bbc9bc641",
                                                "text": "Poignée de main entre Recep Tayyip Erdogan et Volodymyr Zelensky, le 18 août à Lviv (Ukraine)."
                                            },
                                            {
                                                "example_id": "7efbe980-fee5-4508-9ef7-a13cd61deb6f",
                                                "sense_id": "a5aa9400-1046-3aea-9497-969bbc9bc641",
                                                "text": "« Avant la guerre, il n’y avait pas de vraie communauté ukrainienne ici. L’Église ukrainienne était la seule structure un peu formelle où les gens se réunissaient », rappelle le révérend Taras Khomych, originaire de Lviv en Ukraine et installé depuis dix ans à Liverpool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13aeffc7-dc4c-4caa-89e3-83d97c9fd4a4",
                        "source_entry_id": "51c008ec-7ad4-35c6-88e0-e6b9568459ec",
                        "source_sense_id": "471efe88-c71c-3fb1-8ecb-90fddb41edd6",
