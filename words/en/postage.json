{
    "word_family": [
        "post",
        "postal",
        "postman",
        "postmark",
        "postbox"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dab6e44e-fb23-3863-a80e-4a8e809456df",
                    "sense_definition": "The amount of money charged for sending an item by mail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mail_costs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total cost of the book includes five dollars for <w>postage</w> and handling.",
                            "target_lang_translations": {
                                "ru": "Общая стоимость книги включает пять долларов за <w>почтовые расходы</w> и оформление."
                            }
                        },
                        {
                            "text": "You must pay <w>postage</w> before the courier can deliver the heavy package to your house.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>оплатить</w> <w>пересылку</w>, прежде чем курьер сможет доставить тяжелую посылку к вам домой."
                            }
                        }
                    ],
                    "synonyms": [
                        "shipping",
                        "delivery charge"
                    ],
                    "common_phrases": [
                        "pay postage",
                        "postage and packing",
                        "return postage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, взимаемая за пересылку отправления по почте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почтовые расходы",
                                "target_lang_sense_clarification": "общие затраты на пересылку"
                            },
                            {
                                "target_lang_word": "почтовый сбор",
                                "target_lang_sense_clarification": "официальная плата за услугу"
                            },
                            {
                                "target_lang_word": "стоимость пересылки",
                                "target_lang_sense_clarification": "цена доставки почтой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c36852a-4056-3329-9e51-62877fd501a4",
                    "sense_definition": "A stamp or mark placed on a piece of mail to show that the fee has been paid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mail_stamps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure that the <w>postage</w> stamp is clearly visible in the top right corner of the envelope.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что почтовая <w>марка</w> отчетливо видна в правом верхнем углу конверта."
                            }
                        },
                        {
                            "text": "The letter was returned to the sender because it did not have sufficient <w>postage</w> attached.",
                            "target_lang_translations": {
                                "ru": "Письмо было возвращено отправителю, так как на нем не было <w>знаков почтовой оплаты</w> на достаточную сумму."
                            }
                        }
                    ],
                    "synonyms": [
                        "postage stamp"
                    ],
                    "common_phrases": [
                        "sufficient postage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Марка или штамп на почтовом отправлении, подтверждающие оплату услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почтовая марка",
                                "target_lang_sense_clarification": "знак оплаты в виде наклейки"
                            },
                            {
                                "target_lang_word": "марка",
                                "target_lang_sense_clarification": "краткое название почтовой марки"
                            },
                            {
                                "target_lang_word": "почтовый штемпель",
                                "target_lang_sense_clarification": "оттиск, подтверждающий оплату"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}