                        "assombrir le décor"
                    ]
                },
                {
                    "sense_id": "aee141e8-b9c8-3765-826c-6be1486f5065",
                    "sense_definition": "Devenir obscur ou perdre sa clarté, particulièrement en parlant du ciel ou du temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "luminosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel s'<w>assombrit</w> rapidement juste avant le déclenchement du violent orage d'été."
                        },
                        {
                            "text": "Lorsque le soir commence à tomber, tout le paysage s'<w>assombrit</w> doucement sous nos yeux."
                        }
                    ],
                    "common_phrases": [
                        "le ciel s'assombrit",
                        "l'horizon s'assombrit"
                    ]
                },
                {
                    "sense_id": "d205c1a5-3f49-3695-9a3b-dd8b8d8a8130",
                    "sense_definition": "Rendre morose, triste, inquiet ou sérieux.",
