                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b598ec-bf58-4711-b166-c9b72681e60d",
                                                "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                                "text": "Law is a cutthroat business, you always have to look out to see who is trying to outdo you."
                                            },
                                            {
                                                "example_id": "ecede780-e397-41da-a58c-d34cc0c5b51a",
                                                "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                                "text": "More specifically, Scrabblers are diehard, competitive, and occasionally cutthroat players who treat the game like it's chess or baseball..."
                                            },
                                            {
                                                "example_id": "d8507804-7e0f-434d-9fe9-1e6d5ecfe859",
                                                "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                                "text": "While these esports are often framed as battles of mental strategies and mechanical skills, how players juggle their hundreds, or thousands, of simultaneously ticking clocks and timers defines their ability to succeed in cutthroat competitions."
                                            }
                                        ]
