                        "entry_id": "fccb07b6-79e7-3a96-9eae-0b8564a73591",
                        "glosses": [
                            "Used to mark the beginning of the last in a list of items or propositions."
                        ],
                        "tags": [
                            "not-comparable",
                            "sequence"
                        ],
                        "examples": [
                            {
                                "example_id": "1c0647e1-b25c-456f-b0d2-464d4d66ad56",
                                "sense_id": "063c7b5e-f0d2-36c1-90df-915158a16242",
                                "text": "Firstly, that's illegal; secondly, it has serious disadvantages; thirdly, it's not necessary; and lastly, did I mention that it's illegal?"
                            }
                        ]
                    },
                    {
                        "sense_id": "6e08c9e1-d0cf-3d49-89b6-dab3f1c262bf",
                        "entry_id": "fccb07b6-79e7-3a96-9eae-0b8564a73591",
                        "glosses": [
