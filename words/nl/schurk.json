    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9b327ac-1478-35f2-b649-2e8e46c52997",
                    "sense_definition": "Een slecht of gemeen persoon die misdaden pleegt of kwaad in de zin heeft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slechterik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die spannende film probeert de held de gemene <w>schurk</w> te vangen.",
                            "target_lang_translations": {
                                "de": "In diesem spannenden Film versucht der Held, den gemeinen <w>Schurken</w> zu fangen."
                            }
                        },
                        {
                            "text": "Die dief is een echte <w>schurk</w> die al vele mensen heeft opgelicht.",
                            "target_lang_translations": {
                                "de": "Dieser Dieb ist ein echter <w>Gauner</w>, der schon viele Menschen betrogen hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "bandiet",
                        "boef",
                        "booswicht",
                        "misdadiger",
                        "schoft",
                        "slechterik"
                    ],
                    "common_phrases": [
                        "een echte schurk"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine böse oder gemeine Person, die Verbrechen begeht oder Böses im Schilde führt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schurke",
                                "target_lang_sense_clarification": "eine moralisch verwerfliche Person, oft in Geschichten oder Filmen"
                            },
                            {
                                "target_lang_word": "Gauner",
                                "target_lang_sense_clarification": "eine Person, die andere betrügt oder bestiehlt"
                            },
                            {
                                "target_lang_word": "Bösewicht",
                                "target_lang_sense_clarification": "eine böse Figur in einer Erzählung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69a06eda-9ba6-3852-9990-8302536330fd",
                    "sense_definition": "Een ondeugend persoon, in het bijzonder een kind dat speels of ondeugend is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ondeugend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat ben je toch een kleine <w>schurk</w> als je stiekem snoepjes pakt!",
                            "target_lang_translations": {
                                "de": "Was bist du doch für ein kleiner <w>Schlingel</w>, wenn du heimlich Süßigkeiten nimmst!"
                            }
                        },
                        {
                            "text": "De lachende <w>schurk</w> rende snel weg nadat hij een grap had uitgehaald.",
                            "target_lang_translations": {
                                "de": "Der lachende <w>Schelm</w> rannte schnell weg, nachdem er einen Streich gespielt hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "boef",
                        "deugniet",
                        "ondeugd",
                        "rakker",
                        "schavuit"
                    ],
                    "common_phrases": [
                        "kleine schurk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used affectionately for children"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine freche oder schelmische Person, insbesondere ein Kind, das verspielt oder unartig ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schlingel",
                                "target_lang_sense_clarification": "ein liebevoll gemeintes Wort für ein freches Kind"
                            },
                            {
                                "target_lang_word": "Lausbub",
                                "target_lang_sense_clarification": "ein frecher, aber sympathischer Junge"
                            },
                            {
                                "target_lang_word": "Schelm",
                                "target_lang_sense_clarification": "eine Person, die gerne harmlose Streiche spielt"
                            },
                            {
                                "target_lang_word": "Fratz",
                                "target_lang_sense_clarification": "ein kleines, oft freches Kind"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}