                ],
                "senses": [
                    {
                        "sense_id": "2c24f401-6716-3181-8886-b621c5198220",
                        "entry_id": "cd0f6506-8eda-3240-a955-9a382a0fc308",
                        "glosses": [
                            "Sur un paquebot, pont destiné à la promenade des passagers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca134c6a-c6a4-4474-8ecb-aa28b3b8a3c8",
                                "sense_id": "2c24f401-6716-3181-8886-b621c5198220",
                                "text": "Une foule animée se presse sur le pont-promenade commun aux première et seconde classes, à tribord, le long des chaloupes."
                            },
                            {
                                "example_id": "7ccf2cd3-9880-4755-b598-2205406a96b4",
                                "sense_id": "2c24f401-6716-3181-8886-b621c5198220",
                                "text": "Il suivit le plan du navire qu’on lui avait remis, monta jusqu’au pont-promenade et gagna la cabine nᵒ 7."
                            },
                            {
                                "example_id": "5246b63f-6127-4d37-9cfe-2aa67b4e1b36",
                                "sense_id": "2c24f401-6716-3181-8886-b621c5198220",
                                "text": "Le pont A, ou pont-promenade supérieur, est réservé aux premières classes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7bd4ce0-aec0-4e04-a06e-6a34ebd9e3fb",
                        "source_entry_id": "cd0f6506-8eda-3240-a955-9a382a0fc308",
                        "source_sense_id": "2c24f401-6716-3181-8886-b621c5198220",
                        "target_lang_word": "Promenadendeck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Promenadendeck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                        "entry_id": "5e7d71df-1b4e-3b59-a73e-695d6711b150",
                                        "glosses": [
                                            "(oft um das Schiff umlaufender) Bereich auf Passagierschiffen im Freien zwischen Außenreling und Innenräumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f078704-21a0-44dc-a8f7-b392434e3c79",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„Auf der Back und dem vorderen Promenadendeck ſind zum Schutze vor überwogenden Seen drei Wellenbrecher angebracht.“"
                                            },
                                            {
                                                "example_id": "18963b0f-5975-4acf-8b35-afc6d808a809",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "Ich stand im Gespräch mit einem Bekannten etwas abseits von diesem Getümmel auf dem Promenadendeck, […]."
                                            },
                                            {
                                                "example_id": "b40cd6db-dbf5-4ec2-9edd-4ea466cd911b",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„Manchmal schritt er zwar über das Promenadendeck, aber dann immer die Hände auf dem Rücken verschränkt mit jener stolz in sich versenkten Haltung, wie Napoleon auf dem bekannten Bilde;“ […]."
                                            },
                                            {
                                                "example_id": "68052c80-1987-41bf-a2ca-f7bb8791a1f6",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„Man hörte plötzlich die Wellen rauschen und das Radio aus dem Salon herüberjazzen, man vernahm jeden Schritt vom Promenadendeck und das leise, feine Sausen des Winds, der durch die Fugen der Fenster fuhr.“"
                                            },
                                            {
                                                "example_id": "40035f04-1f3c-48b4-a812-b4fb87f7c07d",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„Ich benötigte nicht lange, um auf dem Promenadendeck den so eilig Entflüchteten aufzufinden.“"
                                            },
                                            {
                                                "example_id": "32ea07f5-79f2-40c3-a79d-c8845a2a7660",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "[Titanic:] „Eigentlich brauchte das Schiff 32 Rettungsboote. Und so hatte der erste Designer des Luxusdampfers es auch geplant, doch die Reederei war überzeugt: Der Liner ist sicher, mehr Rettungsboote würde nur die Promenadendecks versperren.“"
                                            },
                                            {
                                                "example_id": "0f8be626-212b-4036-b0e4-474e68b54079",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "[Titanic:] „Ein Knirschen und Schrammen war zu hören, dann stoppten die Maschinen. Edith Rosenbaum lief hinaus aufs Promenadendeck.“"
                                            },
                                            {
                                                "example_id": "daec063e-5df5-453c-b2d5-e43363acc7dc",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "[John Jacob Astor IV auf der Titanic:] „Der Hotelier und seine Frau fanden sich schließlich auf der Backbordseite des Promenadendecks ein, wo Madeleine und andere Frauen in Rettungsboot Nr. 4 stiegen.“"
                                            },
                                            {
                                                "example_id": "df22db47-d019-4c59-af42-6d92d43bb677",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "[30. Jan. 1945, Untergang der Wilhelm Gustloff:] „Durch eine offene Tür gelangt Heinz Schön schließlich - von der Masse der nachdrängenden Menschen getrieben - auf das obere Promenadendeck.“"
                                            },
                                            {
                                                "example_id": "68c4c6ba-b168-418c-89e6-ac20aa14fe0a",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„Tenderboote werden in Davits über dem Promenadendeck mitgeführt und sind damit auch im Seenotfall leicht zu erreichen.“"
                                            },
                                            {
                                                "example_id": "7e4c0aa3-664d-44e6-97d4-397397aa59b6",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„So befanden sich beispielsweise auf dem 1912 in Dienst genommenen Ozeanriesen „France“ an verschwiegenen Stellen des Promenadendecks echte Pariser Laternenpfähle – an die vom Personal ausgeführte Hunde der Passagiere pinkeln konnten.“"
                                            },
                                            {
                                                "example_id": "7d66b1f8-04a1-4b56-b448-43e1ca5f2fd3",
                                                "sense_id": "8c10f614-ff55-35a7-b1cc-874f2586a4df",
                                                "text": "„Unmittelbar vor dem Fallreep erhebt ſich das Promenadendeck, das höchſtgelegene Deck des Dampfers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
