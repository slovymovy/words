                        "target_lang_word": "somewhat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somewhat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                                        "entry_id": "00aeb4e0-705a-373e-a55d-cc934906aa52",
                                        "glosses": [
                                            "To a limited extent or degree; not completely."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0406b63-7cff-4dd5-8f4d-2f5e54ff42ad",
                                                "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                                                "text": "The crowd was somewhat larger than expected, perhaps due to the good weather."
                                            },
                                            {
                                                "example_id": "143ce9ff-832c-40c8-bb08-baef4a5e07d4",
                                                "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                                                "text": "The decision to shave or not is a somewhat personal one."
                                            },
                                            {
                                                "example_id": "3f056d28-bafb-4b83-9344-f7692deb166e",
                                                "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                                                "text": "The searing heat cooled somewhat as the sun set in the evening."
                                            },
                                            {
                                                "example_id": "994c2f92-aa74-4783-850c-6708fbcbf541",
                                                "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […] and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "8d768a92-27ce-4246-b348-edff45a0a874",
                                                "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                                                "text": "its taste, which is plainly acid, and somewhat rough"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "475b5ab1-de40-34da-9b7b-b31c9f77be76",
                                        "entry_id": "00aeb4e0-705a-373e-a55d-cc934906aa52",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [
                                            "UK",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba6f356-e3e4-4919-bbc6-1effe6ed09ef",
                                                "sense_id": "475b5ab1-de40-34da-9b7b-b31c9f77be76",
                                                "text": "Two of the coaches are still on the site of the line; one, a first class observation coach carrying the S.R. number 6991, is at Snapper Halt, where it still stands, in fair condition but somewhat weatherbeaten […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somewhat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                                        "entry_id": "d92541bd-0d1b-30f8-bc75-f904e3552dbc",
                                        "glosses": [
                                            "Something."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94554d73-3f21-4569-9b04-5273b580e45c",
                                                "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                                                "text": "Proceeding to the midst he stil did stand,\n As if in minde he somewhat had to say […]"
                                            },
                                            {
                                                "example_id": "8e66f04a-6e80-4c9f-b4a8-6f70f18d7368",
                                                "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                                                "text": "a. 1716, Robert Trail, sermon on the Lord's Prayer\nBut this text and theme I am upon, relates to somewhat far higher and greater, than all the beholdings of his glory that ever any saint on earth received."
                                            },
                                            {
                                                "example_id": "24068670-3f58-4c6f-83c5-482b3e8739f6",
                                                "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                                                "text": "Mr Jones had somewhat about him, which, though I think writers are not thoroughly agreed in its name, doth certainly inhabit some human breasts […]"
                                            },
                                            {
                                                "example_id": "c97b7a37-093e-402e-80f9-4e716501cd87",
                                                "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                                                "text": "Not seldom in this life, when, on the right side, fortune's favourites sail close by us, we, though all adroop before, catch somewhat of the rushing breeze, and joyfully feel our bagging sails fill out."
                                            },
                                            {
                                                "example_id": "0251a0fa-40c8-4b6a-adbb-343df604fe3a",
                                                "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                                                "text": "Somewhat he knoweth of art magical, yet useth not that art; for it sappeth the life and strength, nor is it held worthy that a Demon should put trust in that art, but rather in his own might and main."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somewhat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d84a370-7c7f-3736-8300-fcc7d1dc2bfe",
                                        "entry_id": "de262028-a5d4-38e6-9345-494cbdad1803",
                                        "glosses": [
                                            "More or less; a certain quantity or degree; a part, more or less; something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e52c75-64eb-4977-95d5-5e0dd2ad89c3",
                                                "sense_id": "1d84a370-7c7f-3736-8300-fcc7d1dc2bfe",
                                                "text": "its taste, which is plainly acid, and somewhat rough"
                                            },
                                            {
                                                "example_id": "ecc37484-f96e-419c-bfe0-1e7aaea5b7e0",
                                                "sense_id": "1d84a370-7c7f-3736-8300-fcc7d1dc2bfe",
                                                "text": "Somewhat of his good sense will suffer, in this transfusion, and much of the beauty of his thoughts will be lost."
                                            },
                                            {
                                                "example_id": "9126ddc2-92c1-4441-badb-b34675e13dbc",
                                                "sense_id": "1d84a370-7c7f-3736-8300-fcc7d1dc2bfe",
                                                "text": "To these ladies a man often recommends himself while he is commending another woman; and, while he is expressing ardour and generous sentiments for his mistress, they are considering what a charming lover this man would make to them, who can feel all this tenderness for an inferior degree of merit. Of this, strange as it may seem, I have seen many instances besides Mrs Fitzpatrick, to whom all this really happened, and who now began to feel a somewhat for Mr Jones, the symptoms of which she much sooner understood than poor Sophia had formerly done."
                                            },
                                            {
                                                "example_id": "2238a761-72db-4bf3-8973-c7dc51f5f4c4",
                                                "sense_id": "1d84a370-7c7f-3736-8300-fcc7d1dc2bfe",
                                                "text": "Then they set somewhat of food before me, whereof I ate my fill, and gave me somewhat of clothes wherewith I clad myself anew and covered my nakedness; after which they took me up into the ship, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af0d665-464d-36dc-9aa5-7114d2936bc7",
                                        "entry_id": "de262028-a5d4-38e6-9345-494cbdad1803",
                                        "glosses": [
                                            "A person or thing of importance; a somebody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850489d0-5a3c-45d5-929b-f61854451acc",
                                                "sense_id": "0af0d665-464d-36dc-9aa5-7114d2936bc7",
                                                "text": "c. 1810-1820, Samuel Taylor Coleridge, Notes on Troilus and Cressida\nPity that the researchful notary has not either told us in what century, and of what history, he was a writer, or been simply content to depose, that Lollius, if a writer of that name existed at all, was a somewhat somewhere."
                                            },
                                            {
                                                "example_id": "4efc330f-0d44-4f30-ba54-df2812bda1d5",
                                                "sense_id": "0af0d665-464d-36dc-9aa5-7114d2936bc7",
                                                "text": "Am I to blame for this, / That here come those that worship me? Ha! ha! / They think that I am somewhat. What am I?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
