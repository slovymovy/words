                        "glosses": [
                            "Alternative form of valence (“the combining capacity of an atom, functional group, or radical determined by the number of atoms of hydrogen with which it will unite, or the number of electrons that it will gain, lose, or share when it combines with other atoms, etc.”).",
                            "The capacity of something to combine with other things, as for example the capability of a vaccine as measured by the number of pathogen serotypes that it can counteract."
                        ],
                        "tags": [
                            "Britain",
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c96f0f82-7f25-4788-82e7-e2a762e36fa4",
                                "sense_id": "4bdf55bb-503f-3666-ab5b-55f33af369ff",
                                "text": "vaccine valency"
                            },
                            {
                                "example_id": "75a8f88c-1ef6-4ccc-8d06-68400abca503",
                                "sense_id": "4bdf55bb-503f-3666-ab5b-55f33af369ff",
                                "text": "Some etymons appear to have greater valency than others when it comes to the formation of portmanteau words."
                            },
                            {
                                "example_id": "c9c24e0b-04d3-4a4b-a150-94e9e6968b35",
                                "sense_id": "4bdf55bb-503f-3666-ab5b-55f33af369ff",
                                "text": "The rationale behind GSK's buy is that bigger is better, in terms of vaccine valency. It has been shown that including more disease-causing serotypes decreases the incidence of invasive pneumococcal disease. To this end, Pfizer and Merck last year got the nod for 20-valent and 15-valent vaccines respectively. Affinivax's AFX3772, meanwhile, is a 24-valent jab."
                            }
                        ]
