                "senses": [
                    {
                        "sense_id": "2df66f30-6cc6-355f-8399-c1d48849be68",
                        "entry_id": "2b11ad20-b523-3006-af67-a53a8869cfc8",
                        "glosses": [
                            "im Rahmen der Zwangsvollstreckung Personen (Mieter) und Gegenstände aus einer Wohnung oder von einem Grundstück entfernen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9ca11d59-26c0-4e4c-93dd-161876a3e0ad",
                                "sense_id": "2df66f30-6cc6-355f-8399-c1d48849be68",
                                "text": "„Begleitet von Protesten ist in Berlin-Wedding die Wohnung einer Wohngemeinschaft zwangsgeräumt worden.“"
                            },
                            {
                                "example_id": "bb7569f9-8c07-4eee-bb98-62be3c16cd6f",
                                "sense_id": "2df66f30-6cc6-355f-8399-c1d48849be68",
                                "text": "„Bleibt ein Hausbesitzer in den USA mit seinen Hypothekenzinsen mehrere Monate im Rückstand, darf der Gläubiger ihn aus seinem Haus zwangsräumen lassen und dieses zur Versteigerung freigeben.“"
                            },
                            {
                                "example_id": "dce5db52-cffd-49f3-af9f-12dcec3fd199",
                                "sense_id": "2df66f30-6cc6-355f-8399-c1d48849be68",
                                "text": "Die Mieter*innenvernetzung [sic] der Wohnhäuser des Eigentümers Akelius berichtet, dass am heutigen Mittwoch um acht Uhr morgens versucht worden sei, eine wegen des Coronavirus unter Quarantäne stehende Mieterin zwangszuräumen."
                            },
                            {
                                "example_id": "1b4a49c8-6ae0-4db1-aba2-fdd1b8c50dcb",
                                "sense_id": "2df66f30-6cc6-355f-8399-c1d48849be68",
                                "text": "„Diejenigen, die nicht dazugehören, lernen derweil das Militär von einer anderen Seite kennen, nämlich als Land aneignende (land grabbing) Organisation, die weder davor zurückschreckt, Dörfer zwangsräumen zu lassen, um die Flächen in eigene profitorientierte Liegenschaftsprojekte zu integrieren, noch davor, Bauern durch unrechtmäßige Pachtvertragsänderungen zu Rechtlosen zu degradieren, um an Land zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8df389f-5a23-44d7-8e12-738b5ab54099",
                        "source_entry_id": "2b11ad20-b523-3006-af67-a53a8869cfc8",
                        "source_sense_id": "2df66f30-6cc6-355f-8399-c1d48849be68",
