                "senses": [
                    {
                        "sense_id": "326f8c41-5591-31be-b700-0f515fb4bb06",
                        "entry_id": "06bec583-41ff-3ccb-8157-db335070c057",
                        "glosses": [
                            "seit dem Sechstagekrieg 1967 von Israel besetztes, beanspruchtes und größtenteils verwaltetes Gebiet westlich des Jordans und des Toten Meeres, in dem überwiegend Palästinenser in unzusammenhängenden Enklaven (Palästinensische Autonomiegebiete) leben, von denen einige unter vollständiger Selbstverwaltung (Zone A-Gebiete), andere unter geteilter palästinensischer und israelischer Verwaltung (Zone B-Gebiete) stehen, wohingegen das große restliche, die Enklaven umschließende Gebiet (Zone C-Gebiete) vollständig israelisch verwaltet wird"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "50fe401d-dd73-4b59-8fb6-beba5bb0e3c0",
                                "sense_id": "326f8c41-5591-31be-b700-0f515fb4bb06",
                                "text": "„Der israelische Anti-Terror-Krieg in Cisjordanien hat seit dem Ende des gepanzerten Einmarschs am 10. Mai einem Netz von Würgeschlingen rund um die Palästinenserstädte Platz gemacht.“"
                            },
                            {
                                "example_id": "91f28247-fe09-4a2b-987e-d52c308e303f",
                                "sense_id": "326f8c41-5591-31be-b700-0f515fb4bb06",
                                "text": "„Olmerts Plan beraubt die PalästinenserInnen [sic] jeder Perspektive. Von der «vagen Aussicht auf einige verzettelte Fetzen Land in etwas mehr als der Hälfte von Cisjordanien und im Gasastreifen, welche kaum die Grundlage für einen zusammenhängenden, lebensfähigen Staat bilden» schreibt die «Neue Zürcher Zeitung».“"
                            },
                            {
                                "example_id": "50c92c73-fc33-49dc-8fb5-67cfc05a16c4",
                                "sense_id": "326f8c41-5591-31be-b700-0f515fb4bb06",
                                "text": "„Die Frist, die das israelische Oberste Gericht für die Evakuierung der Siedlung Migron in Cisjordanien gesetzt hat, rückt näher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
