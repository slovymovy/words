                "senses": [
                    {
                        "sense_id": "ae5a1a35-7072-3923-bf6e-e66aaa2e5cde",
                        "entry_id": "2a92f740-acea-3826-9b36-c8207bad64d7",
                        "glosses": [
                            "Decke in einem Gebäude, deren Tragfähigkeit durch Beton in Verbindung mit Armierungsstahl gegeben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5bcee9f-a8cf-4dd8-9bce-b379eb083d83",
                                "sense_id": "ae5a1a35-7072-3923-bf6e-e66aaa2e5cde",
                                "text": "In alten Häusern werden häufig Holbalkendecken durch Betondecken ersetzt."
                            },
                            {
                                "example_id": "6ae6b577-0026-4ec8-abbb-7d9607ff77eb",
                                "sense_id": "ae5a1a35-7072-3923-bf6e-e66aaa2e5cde",
                                "text": "„Sein kahler Kopf berührte die Betondecke, und die Wasseroberfläche umspielte seinen speckigen Hals.“"
                            },
                            {
                                "example_id": "7cbe3650-73fb-4c7d-acdb-dcfbbb8abae5",
                                "sense_id": "ae5a1a35-7072-3923-bf6e-e66aaa2e5cde",
                                "text": "„Unter fünf Meter dicken Betondecken vollendete sich so das Drama des Dritten Reiches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b3cd0f61-9bec-358a-abf9-a610640bb05b",
                        "entry_id": "2a92f740-acea-3826-9b36-c8207bad64d7",
                        "glosses": [
                            "der oberste Belag einer Fahrbahn aus Beton"
                        ],
                        "tags": [
                            "Straßenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "edac8d10-81a4-419c-b27c-64d79b172b6e",
                                "sense_id": "b3cd0f61-9bec-358a-abf9-a610640bb05b",
                                "text": "Betondecken von Autobahnen dehnen sich bei großer Hitze häufig zu viel aus."
                            },
                            {
                                "example_id": "6929e57c-5711-44f9-afee-7e84831397b3",
                                "sense_id": "b3cd0f61-9bec-358a-abf9-a610640bb05b",
                                "text": "„Die Betondecke ist aufgerissen, Salzwasser eingedrungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
