                "senses": [
                    {
                        "sense_id": "cdb3f7ed-d443-36b6-8c6c-b3a70cb9213f",
                        "entry_id": "1620d2c3-021b-3e31-b28b-fda14aecd035",
                        "glosses": [
                            "een grap die op 1 april wordt gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d29fc0d-eb5d-437b-b003-dddc0fe4fc85",
                                "sense_id": "cdb3f7ed-d443-36b6-8c6c-b3a70cb9213f",
                                "text": "De 1 aprilgrap is een wereldwijd fenomeen. Fransen kennen 'Poisson d'avril', Vlamingen 'een 1 aprilvis', Engelsen en Amerikanen 'April Fool's Day'."
                            },
                            {
                                "example_id": "1e64e5f7-68cc-444e-9749-67ff74db2bfe",
                                "sense_id": "cdb3f7ed-d443-36b6-8c6c-b3a70cb9213f",
                                "text": "De aprilvis is met uitsterven bedreigd. Jarenlang was het traditie: 1 april in het tv-journaal of in de krant. Maar anno 2018 doen de media niet meer mee. Hoe moet het nu verder met de aprilvis? Kamagurka voorspelt het."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7acaa43d-127d-4a7e-9d89-3493d77ca55f",
                        "source_entry_id": "1620d2c3-021b-3e31-b28b-fda14aecd035",
                        "source_sense_id": "cdb3f7ed-d443-36b6-8c6c-b3a70cb9213f",
                        "target_lang_word": "April fool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "April fool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e8ad5e2-7dc0-35ec-9c54-910ffcb97bd3",
                                        "entry_id": "8d7fd2ce-35ed-3499-b3a9-2c8cf7aae030",
                                        "glosses": [
                                            "A person subjected to a practical joke on April Fools' Day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3b3c95-16cd-4921-9e46-6d5c5a39eea6",
                                                "sense_id": "9e8ad5e2-7dc0-35ec-9c54-910ffcb97bd3",
                                                "text": "APRIL FOOL, Any one imposed on, or sent on a bootless errand on the first of April, on which day it is the custom among the lower people, children, and servants, by dropping empty papers carefully doubled up, sending persons on absurd messages, and such like contrivances, to impose on every one they can, and then to salute them with the title of April-fool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b7773e1-6dd6-3253-b31e-a8931aeaad3d",
                                        "entry_id": "8d7fd2ce-35ed-3499-b3a9-2c8cf7aae030",
                                        "glosses": [
                                            "A practical joke played on April Fools' Day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdd77fb-83d1-4034-b226-ae39add2e7eb",
                                                "sense_id": "1b7773e1-6dd6-3253-b31e-a8931aeaad3d",
                                                "text": "The best April fool ever perpetrated was 1 April 1698 and made a laughing stock of the gentry of London, great numbers of whom turned up in their carriages and finery at the Tower of London to 'see the lions being washed' as instructed on their gilt-edged invitation cards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
