                "senses": [
                    {
                        "sense_id": "dda423a4-b411-335c-81bc-d8da50370310",
                        "entry_id": "710dd9b5-a7da-3abd-ae31-e7515dc605bd",
                        "glosses": [
                            "Bruch mit einer 1 als Zähler und einer positiven ganzen Zahl als Nenner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b975d0-eb37-4f05-8899-a5a3bcd71de5",
                                "sense_id": "dda423a4-b411-335c-81bc-d8da50370310",
                                "text": "„Später, beim Multiplizieren einer ganzen Zahl mit einem Bruch (siehe unten S. 45), wird sich zeigen, daß man, dem Wesen der Aufgabe entsprechend, zuerst die Zahl mit dem Stammbruche multiplizieren muß.“"
                            },
                            {
                                "example_id": "3eee75ee-e674-4f97-a666-5b8101bcd23e",
                                "sense_id": "dda423a4-b411-335c-81bc-d8da50370310",
                                "text": "„Natürlich traten auch viele andere Brüche auf; diese musste man dann als Summe von Stammbrüchen darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
