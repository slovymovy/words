                "senses": [
                    {
                        "sense_id": "aede296d-ec84-31b8-b310-739a9e4aaf07",
                        "entry_id": "fcd3b0b8-d201-3ca8-bb13-30e87b6bc777",
                        "glosses": [
                            "rodzaj sztyletu pochodzenia wschodniego, używany do końca XVI w."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4622bc51-162d-418b-a9b8-5dc7cc78c32b",
                                "sense_id": "aede296d-ec84-31b8-b310-739a9e4aaf07",
                                "text": "Skoczyłem na pomoc. Wydobytym z ukrytej pochwy puginałem dźgałem na oślep w tę żywą, rozedrganą plątaninę rąk, nóg i wychudłych kadłubów, modląc się w duchu do wszystkich bóstw niebiańskich i piekielnych, abym nie wyrządził przy okazji krzywdy memu siostrzeńcowi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d42478e1-f0a7-47f0-8dfb-ea13a1eecc36",
                        "source_entry_id": "fcd3b0b8-d201-3ca8-bb13-30e87b6bc777",
                        "source_sense_id": "aede296d-ec84-31b8-b310-739a9e4aaf07",
                        "target_lang_word": "dagger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "A stabbing weapon, similar to a sword but with a short, double-edged blade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb6aed6-dd9a-43d7-ba40-ce805402282c",
                                                "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                                                "text": "The dagger, under the title cultellum and misericorde, has been the constant companion of the sword, at least from the days of Edward I. and is mentioned in the statute of Winchester."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d8dfaa-9cf2-3191-9522-83b51bd095d0",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "The typographical mark †."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "A point scored near the end of the game (clutch time) to take or increase the scorer's team lead, so that they are likely to win."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd14770f-0437-4a1a-99c9-67b136979caa",
                                                "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                                                "text": "His last-minute 3-point dagger silenced the criticism for his so-called failure to come up big in big moments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a0d884f-b98f-349b-89ba-0c4ade1fb9de",
                                        "entry_id": "7271ed29-a53c-3023-8e17-994cf3ef5929",
