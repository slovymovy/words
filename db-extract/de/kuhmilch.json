                                        "sense_id": "fff6456f-8ec6-309e-8909-5597d123ce7e",
                                        "entry_id": "17702fa8-8f28-3739-9784-9c147cdaaf71",
                                        "glosses": [
                                            "wydzielina gruczołów mlecznych samic ssaków służąca jako pokarm dla swojego potomstwa dostępna w okresie laktacji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08916e33-aa36-4b4b-a9b2-7aa4a4bd94dd",
                                                "sense_id": "fff6456f-8ec6-309e-8909-5597d123ce7e",
                                                "text": "Jeśli mleko wypływa z piersi zbyt szybko, maluch może nie chcieć ssać, może się prężyć, odpychać i płakać, pomimo głodu"
                                            },
                                            {
                                                "example_id": "7c90ba8e-d8ec-44e4-92b9-781c653b193f",
                                                "sense_id": "fff6456f-8ec6-309e-8909-5597d123ce7e",
                                                "text": "Dla szczeniąt konieczne jest rozpoczęcie pobierania mleka jak najszybciej po porodzie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5b355e63-304a-38ec-bd27-6aeaef87a0a7",
                                        "entry_id": "17702fa8-8f28-3739-9784-9c147cdaaf71",
                                        "glosses": [
                                            "wydzielina gruczołów mlecznych, najczęściej krowy, spożywana przez ludzi jako dodatek do pokarmu lub jako sam pokarm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e9b2833-7495-4eba-b116-24d16ee9db56",
                                                "sense_id": "5b355e63-304a-38ec-bd27-6aeaef87a0a7",
                                                "text": "Wielu Azjatów nie toleruje mleka."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "38812708-8d96-3b42-8272-5f42ef2cd6cc",
                                        "entry_id": "17702fa8-8f28-3739-9784-9c147cdaaf71",
                                        "glosses": [
                                            "porcja, np. butelka, karton mleka (1.2)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41fb2ea4-9cc5-4bae-a529-ecadd7ff3d2f",
                                                "sense_id": "38812708-8d96-3b42-8272-5f42ef2cd6cc",
                                                "text": "Na stole stały trzy mleka."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "09c92ced-a58f-35d4-a4e8-f1e4396d60e7",
                                        "entry_id": "17702fa8-8f28-3739-9784-9c147cdaaf71",
                                        "glosses": [
                                            "białawy płyn przypominający mleko (1.2), np. sporządzany z niektórych roślin, wydzielający się ze skał wapiennych"
                                        ],
                                        "tags": [
                                            "itd."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c860ff86-6dbf-452c-82d9-d771688214b8",
                                                "sense_id": "09c92ced-a58f-35d4-a4e8-f1e4396d60e7",
                                                "text": "Napoje roślinne, takie jak mleko owsiane i mleko sojowe, obciążają klimat mniej niż mleko od krowy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "07b807ea-de8a-3f18-ad5a-ada25d3b53bf",
                                        "entry_id": "17702fa8-8f28-3739-9784-9c147cdaaf71",
                                        "glosses": [
                                            "gęsta mgła"
                                        ],
                                        "tags": [
                                            "literary",
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c589d89-c7b5-4b1c-91c8-72d8f530e1fe",
                                                "sense_id": "07b807ea-de8a-3f18-ad5a-ada25d3b53bf",
                                                "text": "Nagle wjechaliśmy w mleko i musieliśmy znacznie zwolnić."
