                "senses": [
                    {
                        "sense_id": "0f4ddb55-beeb-37f6-82fd-e742a0444125",
                        "entry_id": "41f81ec1-fe7e-38b8-8ae8-7d855a8a8e63",
                        "glosses": [
                            "Tracé graphique de l’activité musculaire du cœur enregistré lors d'une cardiographie par un cardiographe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcecacf5-9f4c-433b-97f6-f7d9228a7ba2",
                                "sense_id": "0f4ddb55-beeb-37f6-82fd-e742a0444125",
                                "text": "Le cardiogramme était très mauvais. Il m’a dit qu’une hospitalisation devait être immédiate et qu’elle pourrait, selon lui, être courte."
                            },
                            {
                                "example_id": "b86f03c1-01d8-40f5-aa36-e4eb17f73f4b",
                                "sense_id": "0f4ddb55-beeb-37f6-82fd-e742a0444125",
                                "text": "L’auteur localise dans la paroi même du cœur, c’est-à-dire dans la forme de la contraction du muscle cardiaque, la cause des ondulations du plateau systolique du cardiogramme."
                            }
                        ]
                    }
                ],
