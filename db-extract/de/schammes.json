                                        "examples": [
                                            {
                                                "example_id": "56a21b83-fb96-4178-838b-07ef185279cf",
                                                "sense_id": "658b1b6a-d2a4-3812-86a8-0f01a733f717",
                                                "text": "Šames, tj. kostelník, nám rozdal svíčky. Držíme je rozžaté v rukou, abychom při studiu neusli."
                                            },
                                            {
                                                "example_id": "5f816ee5-7233-4e82-b3e9-e652bdf219c9",
                                                "sense_id": "658b1b6a-d2a4-3812-86a8-0f01a733f717",
                                                "text": "Zpovzdáli ho sleduje šames: malý hubený mužík, tenčí než ty velké knihy, co jsou na sebe naskládány na stolku vedle něho. Šames je se svými modlitbami hotov už dávno. Končí jako první, aby na něho ostatní řádní židé nemuseli čekat."
                                            }
                                        ]
