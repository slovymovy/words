                        ],
                        "examples": [
                            {
                                "example_id": "ce3cc65f-5e9c-4355-9b94-f80b89f315d0",
                                "sense_id": "ca5d0427-6332-33f9-8629-6e68f269371e",
                                "text": "Perhaps we are disposed to smile at seeing so much made of titles; but after what we have learned of Lord Timothy Dexter and the high-sounding names appropriated by many of our own compatriots, who have no more claim to them than we plain Misters and Misseses, we may feel to them something as our late friend Mr. Appleton felt to the real green turtle soup set before him, when he said that it was almost as good as mock."
                            }
                        ]
                    }
                ],
