                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5822c6d-7f33-48b8-bbf0-85a789ede345",
                        "entry_id": "007e15e0-b64d-36e7-ba42-a607f8697720",
                        "tags": [
