{
    "word_family": [
        "crimsonness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                    "sense_definition": "Having a deep, rich red color inclining to purple.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_red",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn leaves turned a beautiful shade of <w>crimson</w> before falling to the ground.",
                            "target_lang_translations": {
                                "ru": "Осенние листья приобрели красивый <w>багряный</w> оттенок перед тем, как опасть на землю.",
                                "de": "Die Herbstblätter nahmen einen wunderschönen <w>karmesinroten</w> Farbton an, bevor sie zu Boden fielen."
                            }
                        },
                        {
                            "text": "She wore a stunning <w>crimson</w> dress that immediately caught everyone's attention at the gala.",
                            "target_lang_translations": {
                                "ru": "На ней было потрясающее <w>темно-красное</w> платье, которое сразу же привлекло всеобщее внимание на торжественном вечере.",
                                "de": "Sie trug ein atemberaubendes <w>purpurrotes</w> Kleid, das auf der Gala sofort alle Blicke auf sich zog."
                            }
                        }
                    ],
                    "synonyms": [
                        "red",
                        "ruby",
                        "scarlet"
                    ],
                    "common_phrases": [
                        "crimson dress",
                        "crimson leaves",
                        "crimson sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий глубокий, насыщенный красный цвет с фиолетовым или малиновым оттенком.",
                        "de": "Eine tiefe, satte rote Farbe mit einem Stich ins Violette oder Purpurne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малиновый",
                                "target_lang_sense_clarification": "о цвете, близком к спелой малине"
                            },
                            {
                                "target_lang_word": "багряный",
                                "target_lang_sense_clarification": "о глубоком красном цвете, часто о листве или закате"
                            },
                            {
                                "target_lang_word": "пунцовый",
                                "target_lang_sense_clarification": "ярко-красный, густо-красный"
                            },
                            {
                                "target_lang_word": "алый",
                                "target_lang_sense_clarification": "ярко-красный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "karmesinrot",
                                "target_lang_sense_clarification": "ein tiefes, sattes Rot"
                            },
                            {
                                "target_lang_word": "purpurrot",
                                "target_lang_sense_clarification": "ein dunkles Rot mit bläulichem Unterton"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2cab433-221c-36ca-b970-a82b6c429ad6",
                    "sense_definition": "Immodest or indecent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puritanical elders condemned what they perceived as her <w>crimson</w> behavior.",
                            "target_lang_translations": {
                                "ru": "Пуританские старейшины осудили то, что они сочли ее <w>непристойным</w> поведением.",
                                "de": "Die puritanischen Ältesten verurteilten ihr Verhalten, das sie als <w>unsittlich</w> empfanden."
                            }
                        },
                        {
                            "text": "He was shocked by the <w>crimson</w> tales told by the sailors in the tavern.",
                            "target_lang_translations": {
                                "ru": "Он был потрясен <w>неприличными</w> историями, которые рассказывали матросы в таверне.",
                                "de": "Er war schockiert über die <w>unzüchtigen</w> Geschichten, die sich die Seeleute in der Kneipe erzählten."
                            }
                        }
                    ],
                    "synonyms": [
                        "immodest",
                        "indecent",
                        "shameless"
                    ],
                    "antonyms": [
                        "modest",
                        "decent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean immodest."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нескромный, непристойный или бесстыдный (устаревшее значение).",
                        "de": "Unanständig oder unsittlich (veralteter Sprachgebrauch)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непристойный",
                                "target_lang_sense_clarification": "нарушающий правила приличия"
                            },
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "греховный, предосудительный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unsittlich",
                                "target_lang_sense_clarification": "gegen die guten Sitten verstoßend"
                            },
                            {
                                "target_lang_word": "unzüchtig",
                                "target_lang_sense_clarification": "im Sinne von moralisch verwerflich"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd74fff9-9156-3e06-ae1b-569f76de1426",
                    "sense_definition": "A deep, slightly bluish red color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_red",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist mixed several pigments on her palette to achieve the perfect <w>crimson</w>.",
                            "target_lang_translations": {
                                "ru": "Художница смешала несколько пигментов на своей палитре, чтобы добиться идеального <w>малинового цвета</w>.",
                                "de": "Die Künstlerin mischte mehrere Pigmente auf ihrer Palette, um das perfekte <w>Karmesin</w> zu erzielen."
                            }
                        },
                        {
                            "text": "The sunset painted the horizon in brilliant shades of gold and <w>crimson</w>.",
                            "target_lang_translations": {
                                "ru": "Закат окрасил горизонт в великолепные оттенки золотого и <w>багрянца</w>.",
                                "de": "Der Sonnenuntergang malte den Horizont in leuchtenden Gold- und <w>Purpurtönen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "carmine"
                    ],
                    "common_phrases": [
                        "shade of crimson",
                        "deep crimson"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий, слегка синевато-красный цвет; темно-красный или малиновый цвет.",
                        "de": "Eine tiefe, leicht bläulich-rote Farbe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малиновый цвет",
                                "target_lang_sense_clarification": "густой красный цвет с синеватым оттенком"
                            },
                            {
                                "target_lang_word": "багрянец",
                                "target_lang_sense_clarification": "густой красный, багровый цвет"
                            },
                            {
                                "target_lang_word": "пурпур",
                                "target_lang_sense_clarification": "темно-красный или ярко-красный цвет"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Purpur",
                                "target_lang_sense_clarification": "die Farbe zwischen Rot und Blau"
                            },
                            {
                                "target_lang_word": "Karmesin",
                                "target_lang_sense_clarification": "ein kräftiger, tiefroter Farbton"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                    "sense_definition": "To become deep red in color; to blush deeply.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reddening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt her cheeks <w>crimson</w> with embarrassment when everyone turned to look at her.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как ее щеки <w>залились румянцем</w> от смущения, когда все повернулись, чтобы посмотреть на нее.",
                                "de": "Sie spürte, wie ihre Wangen vor Verlegenheit <w>purpurn anliefen</w>, als sich alle nach ihr umdrehten."
                            }
                        },
                        {
                            "text": "The sky began to <w>crimson</w> as the sun dipped below the distant mountains.",
                            "target_lang_translations": {
                                "ru": "Небо начало <w>окрашиваться в багровые тона</w>, когда солнце опустилось за далекие горы.",
                                "de": "Der Himmel begann sich <w>purpurn zu färben</w>, als die Sonne hinter den fernen Bergen versank."
                            }
                        }
                    ],
                    "synonyms": [
                        "blush",
                        "flush",
                        "redden"
                    ],
                    "antonyms": [
                        "pale"
                    ],
                    "common_phrases": [
                        "crimson with embarrassment",
                        "crimson with anger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in literary contexts to describe blushing."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окрашиваться в глубокий красный цвет; сильно краснеть, заливаться румянцем.",
                        "de": "Sich tiefrot färben; stark erröten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "багроветь",
                                "target_lang_sense_clarification": "становиться багровым, сильно краснеть"
                            },
                            {
                                "target_lang_word": "заливаться румянцем",
                                "target_lang_sense_clarification": "густо краснеть от смущения"
                            },
                            {
                                "target_lang_word": "краснеть",
                                "target_lang_sense_clarification": "становиться красным"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erröten",
                                "target_lang_sense_clarification": "vor Scham oder Aufregung rot werden"
                            },
                            {
                                "target_lang_word": "purpurn anlaufen",
                                "target_lang_sense_clarification": "sich stark rot oder violett verfärben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                    "sense_definition": "To dye or color something deep red; to make red.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reddening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spilled wine threatened to <w>crimson</w> the pristine white tablecloth.",
                            "target_lang_translations": {
                                "ru": "Пролитое вино грозило <w>окрасить в красный цвет</w> белоснежную скатерть.",
                                "de": "Der verschüttete Wein drohte, die makellos weiße Tischdecke <w>karmesinrot zu färben</w>."
                            }
                        },
                        {
                            "text": "The setting sun seemed to <w>crimson</w> the entire western sky with its warm light.",
                            "target_lang_translations": {
                                "ru": "Казалось, заходящее солнце своим теплым светом <w>окрасило в багрянец</w> все западное небо.",
                                "de": "Die untergehende Sonne schien den gesamten Westhimmel mit ihrem warmen Licht <w>purpurn zu färben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "redden",
                        "dye"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mainly literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окрашивать в глубокий красный цвет; делать красным.",
                        "de": "Etwas tiefrot färben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окрашивать в багряный цвет",
                                "target_lang_sense_clarification": "делать темно-красным"
                            },
                            {
                                "target_lang_word": "багрить",
                                "target_lang_sense_clarification": "окрашивать в багровый или багряный цвет"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "purpurn färben",
                                "target_lang_sense_clarification": "in einen tiefen Rotton tauchen"
                            },
                            {
                                "target_lang_word": "karmesinrot färben",
                                "target_lang_sense_clarification": "intensiv rot einfärben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}