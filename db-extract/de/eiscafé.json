                                "example_id": "70d9a0d3-d640-45e9-9708-57a9d0c0933b",
                                "sense_id": "74bd3f17-7ed1-39e6-b802-44e29161d6a6",
                                "text": "In unserer kleinen Stadt gibt es mehrere Eiscafés."
                            },
