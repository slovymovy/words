                                "target_senses": [
                                    {
                                        "sense_id": "8452faa9-18f0-32a5-a7f0-f4a68f97581b",
                                        "entry_id": "b8119002-43bf-3991-99a5-cde1678cf1a2",
                                        "glosses": [
