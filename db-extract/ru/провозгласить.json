                                            {
                                                "example_id": "aef7450c-08b7-4777-b58c-32d6f297b67e",
                                                "sense_id": "d4cb8f82-1cae-3207-81a5-4b4e581e969d",
                                                "text": "a highly-acclaimed novel"
                                            },
                                            {
                                                "example_id": "a079e3b2-8e9e-4fff-bfa5-7eaee696f0e7",
                                                "sense_id": "d4cb8f82-1cae-3207-81a5-4b4e581e969d",
                                                "text": "a widely-acclaimed article"
                                            },
                                            {
                                                "example_id": "08abbe07-14bc-4480-9928-f87235ad785d",
                                                "sense_id": "d4cb8f82-1cae-3207-81a5-4b4e581e969d",
                                                "text": "The design, when finally developed, was a slight disappointment to Monsieur Deplis, who had suspected Icarus of being a fortress taken by Wallenstein in the Thirty Years' War, but he was more than satisfied with the execution of the work, which was acclaimed by all who had the privilege of seeing it as Pincini's masterpiece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac3f3300-d4f6-3440-8ca1-ba89978f94e3",
                                        "entry_id": "6c78eb4b-8825-34e1-b806-bf7f0bae66dd",
                                        "glosses": [
                                            "To salute or praise with great approval; to compliment; to applaud; to welcome enthusiastically."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69450e92-490d-35d9-b452-3660118c47d7",
                                        "entry_id": "6c78eb4b-8825-34e1-b806-bf7f0bae66dd",
                                        "glosses": [
                                            "To claim."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "350895e1-a0fa-3c54-a954-32d13e4f8b28",
                                        "entry_id": "6c78eb4b-8825-34e1-b806-bf7f0bae66dd",
                                        "glosses": [
                                            "To declare by acclamations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0969dfef-6509-404b-b75b-fa8ed003c695",
                                                "sense_id": "350895e1-a0fa-3c54-a954-32d13e4f8b28",
                                                "text": "Thou ſhalt be crown'd— / An Iron Crown, intenſely hot, ſhall gird / Thy hoary Temples; while the ſhouting Crowd / Acclaims thee King of Traitors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af35ede-a54c-3e15-a157-c132cb9e2458",
                                        "entry_id": "6c78eb4b-8825-34e1-b806-bf7f0bae66dd",
                                        "glosses": [
                                            "To elect (a politician, etc.) to an office automatically because no other candidates run; elect by acclamation."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
