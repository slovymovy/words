                ],
                "translations": [
                    {
                        "translation_id": "2df68da3-930e-4ca1-a9ae-56213c971ff3",
                        "source_entry_id": "bc3e7c55-a9b3-3ef4-bedb-8756de66c547",
                        "source_sense_id": "16db43ce-3f91-3e37-80b8-95d4940f121b",
                        "target_lang_word": "horror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "946a998d-ceaa-393c-9c25-71b4d28b3132",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "An intense distressing emotion of fear or repugnance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e4f4e9-aaeb-4e78-ac38-5dc92a7e68ae",
                                                "sense_id": "946a998d-ceaa-393c-9c25-71b4d28b3132",
                                                "text": "Their swarthy Hosts wou'd darken all our Plains, / Doubling the native Horror of the War, / And making Death more grim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "Something horrible; that which excites horror."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46517ae4-ec80-4e24-85cc-dce3b660c9d2",
                                                "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                                "text": "I saw many horrors during the war."
                                            },
                                            {
                                                "example_id": "3de8c5e0-0402-478c-9909-830ae45deaec",
                                                "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                                "text": "The Home Magazine for July (Binghamton and New York) contains ‘The Patriots' War Chant,’ a poem by Douglas Malloch; ‘The Story of the War,’ by Theodore Waters; ‘A Horseman in the Sky,’ by Ambrose Bierce, with a portrait of Mr. Bierce, whose tales of horror are horrible of themselves, not as war is horrible; ‘A Yankee Hero,’ by W. L. Calver; ‘The Warfare of the Future,’ by Louis Seemuller; ‘Florence Nightingale,’ by Susan E. Dickenson, with two rare portraits, etc."
                                            },
                                            {
                                                "example_id": "cb7ddbc1-55d3-48eb-837d-879641fd8b4f",
                                                "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                                                "text": "Could there be stories with more horror than these?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da2b6084-b161-3b40-b222-6d5cccb33531",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "Intense dislike or aversion; an abhorrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0bcdf3-6a67-4d98-8ccd-8888907878df",
                                                "sense_id": "da2b6084-b161-3b40-b222-6d5cccb33531",
                                                "text": "“Mrs. Yule's chagrin and horror at what she called her son's base ingratitude knew no bounds ; at first it was even thought that she would never get over it. […] ”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "A genre of fiction designed to evoke a feeling of fear and suspense."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482ae9b7-9600-484a-962e-7d90be6d1565",
                                                "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                                "text": "Those who enjoy horror, stories overflowing with blood and black mystery, will be grateful to Richard Marsh for writing ‘The Beetle.’"
                                            },
                                            {
                                                "example_id": "a41f7892-5df0-460f-885c-2f939daa1b08",
                                                "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                                "text": "A well-received Johnny Fuller R & B horror called \"Haunted House.\""
                                            },
                                            {
                                                "example_id": "a08870ad-4d06-4803-8d12-8c4879383d06",
                                                "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                                                "text": "[…] there were hastily produced B movies, such as the peplums, the spaghetti westerns, the detective stories, the horrors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aba2599-43f1-354d-a876-ae4e59d96c0b",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "A genre of fiction designed to evoke a feeling of fear and suspense.",
                                            "An individual work in this genre."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f673c6b-aff7-3cb9-bbf9-c3019beb0b8d",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "A nasty or ill-behaved person; a rascal or terror."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d3908f-5ffb-455a-811f-5dd45cd91aad",
                                                "sense_id": "2f673c6b-aff7-3cb9-bbf9-c3019beb0b8d",
                                                "text": "The neighbour's kids are a pack of little horrors!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e670ef-bc45-3959-b8f0-7ec23c9f7e8d",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "An intense anxiety or a nervous depression; often the horrors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17614222-7e8b-3c2c-b499-a0628c89a6db",
                                        "entry_id": "97f5dfef-b29a-37bc-9f7f-283ed5986a32",
                                        "glosses": [
                                            "Delirium tremens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218ac332-7393-4e06-bd51-7b3c93ad844f",
                                                "sense_id": "17614222-7e8b-3c2c-b499-a0628c89a6db",
                                                "text": "`My belief is that he had the horrors without knowin' it.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
