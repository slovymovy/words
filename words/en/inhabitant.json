    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                    "sense_definition": "A person or animal that lives permanently in a particular place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "residents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>inhabitants</w> of the small coastal town decided to build their own railway.",
                            "target_lang_translations": {
                                "ru": "Местные <w>жители</w> небольшого прибрежного городка решили построить свою собственную железную дорогу."
                            }
                        },
                        {
                            "text": "Scientists are still searching for any sign of a living <w>inhabitant</w> on the planet Mars.",
                            "target_lang_translations": {
                                "ru": "Ученые все еще ищут любые признаки живого <w>обитателя</w> на планете Марс."
                            }
                        }
                    ],
                    "synonyms": [
                        "resident",
                        "dweller",
                        "denizen"
                    ],
                    "antonyms": [
                        "visitor",
                        "tourist",
                        "guest"
                    ],
                    "common_phrases": [
                        "local inhabitant",
                        "island inhabitant",
                        "original inhabitant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, постоянно проживающее в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель",
                                "target_lang_sense_clarification": "человек, проживающий в каком-либо месте"
                            },
                            {
                                "target_lang_word": "обитатель",
                                "target_lang_sense_clarification": "человек или животное, населяющее территорию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                    "sense_definition": "A possible value that belongs to a specific data type.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In type theory, we can count the <w>inhabitants</w> of a type to determine its cardinality.",
                            "target_lang_translations": {
                                "ru": "В теории типов мы можем подсчитать <w>обитателей</w> типа, чтобы определить его мощность."
                            }
                        },
                        {
                            "text": "Each <w>inhabitant</w> of this specific type must satisfy the defined logical constraints.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>обитатель</w> этого конкретного типа должен удовлетворять определенным логическим ограничениям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "type inhabitant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in mathematics and computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможное значение, принадлежащее к определенному типу данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обитатель",
                                "target_lang_sense_clarification": "в теории типов: элемент, принадлежащий типу"
                            },
                            {
                                "target_lang_word": "инхабитант",
                                "target_lang_sense_clarification": "калька, используемая в технической литературе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "275a7689-faf7-3788-b72f-3e22b71c2026",
                    "sense_definition": "Living or residing in a specific place; <w>resident</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "residing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inhabitant</w> population of the forest has decreased significantly over the last decade.",
                            "target_lang_translations": {
                                "ru": "<w>Населяющая</w> лес популяция значительно сократилась за последнее десятилетие."
                            }
                        },
                        {
                            "text": "He studied the <w>inhabitant</w> tribes of the region to understand their ancient customs.",
                            "target_lang_translations": {
                                "ru": "Он изучал <w>проживающие</w> в этом регионе племена, чтобы понять их древние обычаи."
                            }
                        }
                    ],
                    "synonyms": [
                        "resident"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проживающий или обитающий в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проживающий",
                                "target_lang_sense_clarification": "находящийся на постоянном жительстве"
                            },
                            {
                                "target_lang_word": "населяющий",
                                "target_lang_sense_clarification": "обитающий на какой-либо территории"
                            }
                        ]
                    }
                }
            ]
        }
    ]
