                "senses": [
                    {
                        "sense_id": "d0cdfefd-b76d-372b-ba20-f65eb026bbc9",
                        "entry_id": "08a86465-b630-3643-920a-b0de39ec4f4c",
                        "glosses": [
                            "sich wiederholender zeitlicher Abstand von jeweils 15 Minuten zwischen zwei Ereignissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a615006b-e01c-4109-875b-7925f7147fc3",
                                "sense_id": "d0cdfefd-b76d-372b-ba20-f65eb026bbc9",
                                "text": "Die Flugzeuge heben im Viertelstundentakt ab."
                            },
                            {
                                "example_id": "d420d417-21b3-4663-b734-1a10cb702e8e",
                                "sense_id": "d0cdfefd-b76d-372b-ba20-f65eb026bbc9",
                                "text": "„Im Viertelstundentakt füllt er aus einem großen Krug sein Glas auf und gießt sich Wasser in den Wein.“"
                            },
                            {
                                "example_id": "3e426fdb-60a2-412d-bb2d-f2a6e560bab3",
                                "sense_id": "d0cdfefd-b76d-372b-ba20-f65eb026bbc9",
                                "text": "„Ab 2021 sollen in der Schweiz Fernverkehrszüge im Viertelstundentakt fahren.“"
                            },
                            {
                                "example_id": "fdc2ccb8-9609-4694-a7fb-a9696734512e",
                                "sense_id": "d0cdfefd-b76d-372b-ba20-f65eb026bbc9",
                                "text": "„Viertelstundentakte sieht der Bund auch für die Kernbereiche der S-Bahnen Genf, Lausanne, Bern, Basel, Luzern, Zürich, St. Gallen und Tessin vor.“"
                            }
                        ],
