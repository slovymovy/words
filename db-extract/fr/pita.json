                    },
                    {
                        "translation_id": "69b8a48d-5152-4370-9b5e-be75c8a448ee",
                        "source_entry_id": "5b481d58-3752-3a2f-8364-f76923ea82d1",
                        "source_sense_id": "7e416202-941e-3b57-93c8-d5d2c01194fc",
                        "source_sense_description": "galette de pain méditerranéenne",
                        "target_lang_word": "pita",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pita",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec2d7cf8-4d8d-35e7-b4d0-db4e28b9d1f3",
                                        "entry_id": "05a2c468-8942-3811-bde9-2f58ff2cc46f",
                                        "glosses": [
                                            "A piece of pita bread; a flatbread pouch used for making sandwiches such as gyros or falafels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f66a4bea-c270-412f-b608-4ba9a33775d2",
                                                "sense_id": "ec2d7cf8-4d8d-35e7-b4d0-db4e28b9d1f3",
                                                "text": "There is a wide variety of pites, small triangles of butter laden crispy filo dough, voluptuously filled with cheeses, vegetables or spiced meats."
                                            },
                                            {
                                                "example_id": "b5eb199a-562c-4059-9393-0bddf8d71282",
                                                "sense_id": "ec2d7cf8-4d8d-35e7-b4d0-db4e28b9d1f3",
                                                "text": "A sweet smell of cheese and milk pites permeates the air of the homes of Greek housewives who prepare the pites according to the tradition of their forefathers."
                                            },
                                            {
                                                "example_id": "f805c80c-bd9b-4c29-a740-50108e9941d6",
                                                "sense_id": "ec2d7cf8-4d8d-35e7-b4d0-db4e28b9d1f3",
                                                "text": "Most often pites are made with filo dough, but certainly not always. They can be filled with anything and everything, and they are."
                                            },
                                            {
                                                "example_id": "05975107-3172-4644-8801-f488d7b65e39",
                                                "sense_id": "ec2d7cf8-4d8d-35e7-b4d0-db4e28b9d1f3",
                                                "text": "They served pita, my old nemesis. I ordered one, and it arrived oozing with hummus and studded with bright green falafel. It was horribly delicious."
                                            }
                                        ]
                                    }
                                ]
                            },
