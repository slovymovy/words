                    {
                        "sense_id": "e25a7412-530f-350f-888f-56769dd34f61",
                        "entry_id": "0d12fbde-a702-332c-8c96-0bb63bae478a",
                        "glosses": [
                            "To organize workers into a union."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad266af8-1d5f-4aba-894d-eabcaece2401",
                                "sense_id": "e25a7412-530f-350f-888f-56769dd34f61",
                                "text": "The company laid off all the workers when they tried to unionize."
                            },
                            {
                                "example_id": "e40b164e-8ebe-41c7-a57c-4378a3547375",
                                "sense_id": "e25a7412-530f-350f-888f-56769dd34f61",
                                "text": "My uncle got roughed up by some corporate thugs after they caught him trying to unionize their workers."
                            },
                            {
                                "example_id": "c096feff-5b34-4fd0-92a9-71a0d5784546",
                                "sense_id": "e25a7412-530f-350f-888f-56769dd34f61",
                                "text": "She attended a teach-in to learn how to unionize her workplace."
                            },
                            {
                                "example_id": "12937a80-46db-407a-a102-30ecdf49ec76",
                                "sense_id": "e25a7412-530f-350f-888f-56769dd34f61",
                                "text": "Even if workers succeed at unionizing, the law offers few tools for forcing employers to negotiate a contract."
                            }
                        ]
                    }
                ],
