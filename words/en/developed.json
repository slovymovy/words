                },
                {
                    "sense_id": "e8429188-3636-3834-a729-c5d5e551ee87",
                    "sense_definition": "Containing man-made structures such as buildings, roads, and utilities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is running out of <w>developed</w> land for new housing projects.",
                            "target_lang_translations": {
                                "ru": "В городе заканчивается <w>освоенная</w> земля для новых жилищных проектов.",
                                "nl": "De stad heeft een tekort aan <w>bebouwde</w> grond voor nieuwe woningbouwprojecten."
                            }
                        },
                        {
                            "text": "They prefer to hike in wild areas rather than <w>developed</w> parks.",
                            "target_lang_translations": {
                                "ru": "Они предпочитают ходить в походы по диким местам, а не по <w>благоустроенным</w> паркам.",
                                "nl": "Ze wandelen liever in wilde gebieden dan in <w>aangelegde</w> parken."
                            }
