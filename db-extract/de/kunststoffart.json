                "senses": [
                    {
                        "sense_id": "6db9dd65-efde-33d4-a320-8b5467142c72",
                        "entry_id": "7d4b0698-e403-3260-bf78-73c26d76ee1c",
                        "glosses": [
                            "Menge von Kunststoffen, die sich durch besondere Merkmale auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690e6aad-baae-4bbf-ad97-17d9507996ed",
                                "sense_id": "6db9dd65-efde-33d4-a320-8b5467142c72",
                                "text": "„Als die Chemikerin Jeannette Garcia einen milchig-weißen Klumpen in einem Laborkolben entdeckte, dachte sie, ihr sei ein Experiment missglückt. Die erste Überraschung war: Sie benötigte einen Hammer, um das Material aus seinem Glasgefängnis zu befreien. Die zweite: Dem Kunststoff selbst machte die unsanfte Behandlung überhaupt nichts aus. Am Ende zeigte sich: Garcia hatte eine neue Kunststoffart mit herausragenden Eigenschaften hergestellt – die sich auch noch gut recyceln lässt.“"
                            },
                            {
                                "example_id": "14aadc0f-e45a-4a22-abc1-4832fc492c8d",
                                "sense_id": "6db9dd65-efde-33d4-a320-8b5467142c72",
                                "text": "„Die vorliegende Statistik zeigt durchschnittliche jährliche Wachstumsrate (CAGR) der Kunststoffproduktion in Deutschland nach Kunststoffart im Zeitraum von 2011 bis 2013.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
