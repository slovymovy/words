                    {
                        "sense_id": "84f9c858-c345-3265-91a9-78f6dfaad848",
                        "entry_id": "9867df6a-58bc-3dc7-899c-2b7006e2b546",
                        "glosses": [
                            "auf dem Land praktizierender Arzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3941add-cd16-4380-b3bc-2d4d2e4b09c8",
                                "sense_id": "84f9c858-c345-3265-91a9-78f6dfaad848",
                                "text": "„Lautes Klopfen an der Haustür weckt den Landarzt.“"
                            },
                            {
                                "example_id": "5cf61471-79f5-42da-871a-3babaf219364",
                                "sense_id": "84f9c858-c345-3265-91a9-78f6dfaad848",
                                "text": "„Anfangs, als Landarzt in der preußischen Provinz, schien all das für ihn unerreichbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88158cd4-f2aa-4085-a1df-298c018ad675",
                        "source_entry_id": "9867df6a-58bc-3dc7-899c-2b7006e2b546",
                        "source_sense_id": "84f9c858-c345-3265-91a9-78f6dfaad848",
                        "source_sense_description": "auf dem Land praktizierender Arzt",
                        "target_lang_word": "médecin de campagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médecin de campagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f4c77b8-5c32-3d25-8125-511fd191a493",
                                        "entry_id": "07ffc4ee-5ded-3f3e-ba10-eb70ee17cd95",
                                        "glosses": [
                                            "Médecin généraliste qui pratique hors des centres urbains, caractérisé par une grande polyvalence et, du moins dans l'imaginaire populaire, par sa débrouillardise et son dévouement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c72d12f5-d6c9-40ea-b278-26be398cba5b",
                                                "sense_id": "6f4c77b8-5c32-3d25-8125-511fd191a493",
                                                "text": "Le docteur Marcoux était un fier médecin de campagne, c'est-à-dire spécialiste en tout."
                                            },
                                            {
                                                "example_id": "ea4a9b24-c014-4ecf-a088-418ced4eee18",
                                                "sense_id": "6f4c77b8-5c32-3d25-8125-511fd191a493",
                                                "text": "Les médecins de campagne pouvaient passer vingt-quatre heures sans dormir en allant accoucher les femmes chez elles dans les rangs éloignés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
