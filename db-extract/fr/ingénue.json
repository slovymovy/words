        "fr-extract.jsonl": [
            {
                "entry_id": "1fc2fa1b-9dfc-3ec7-b66f-506fa0bcc952",
                "word": "ingénue",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92071698-3091-33f6-8ee1-f268a3d7933b",
                        "entry_id": "1fc2fa1b-9dfc-3ec7-b66f-506fa0bcc952",
                        "glosses": [
                            "Féminin singulier de ingénu."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "80f3636b-e7ae-4795-b582-a4eff2538e1c",
                                "sense_id": "92071698-3091-33f6-8ee1-f268a3d7933b",
                                "text": "Une naïade ingénue, qui s’échappe de sa source, n’est pas plus timide, plus blanche ni plus naïve."
                            },
                            {
                                "example_id": "56976ba7-b213-498c-a342-aea75e218fca",
                                "sense_id": "92071698-3091-33f6-8ee1-f268a3d7933b",
                                "text": "Il semblerait que ce soit une gêne pour la réserve anglaise d’avoir à nommer en public ce livre bizarre ou s’étale, décrite avec la franchise la plus ingénue, et par instants grandie jusqu’à un tragique sublime, une passion amoureuse toute frissonnante de désirs instinctifs et de sensualité."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fde7a1a3-aed7-3752-9c43-6936565dc65e",
                "word": "ingénue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8bab2ecb-8bf7-4b00-9a7e-7ea3f1b9b44a",
                        "entry_id": "fde7a1a3-aed7-3752-9c43-6936565dc65e",
                        "tags": [
                            "plural"
                        ],
                        "form": "ingénues"
                    },
                    {
                        "form_id": "054035e5-0993-4533-b18a-8059b2c608bd",
                        "entry_id": "fde7a1a3-aed7-3752-9c43-6936565dc65e",
                        "tags": [
                            "masculine"
                        ],
                        "form": "ingénu"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6871b930-9aec-3ea5-bcfd-2e9d0eba817e",
                        "entry_id": "fde7a1a3-aed7-3752-9c43-6936565dc65e",
                        "glosses": [
                            "Femme simple et presque naïve dans la franchise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ce9be9-59ca-480e-acf6-813082900c48",
                                "sense_id": "6871b930-9aec-3ea5-bcfd-2e9d0eba817e",
                                "text": "Cette fausse ingénue qui n’a rien d’une nunuche, se trémousse dans une nuisette à écourter les études d’un séminariste."
                            }
                        ]
                    },
                    {
                        "sense_id": "c189d3d8-2a53-31e8-891e-225fd81f9daf",
                        "entry_id": "fde7a1a3-aed7-3752-9c43-6936565dc65e",
                        "glosses": [
                            "Rôles de jeunes filles naïves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ebf9d75-94fc-40e0-a07b-3cfa175f7fe1",
                                "sense_id": "c189d3d8-2a53-31e8-891e-225fd81f9daf",
                                "text": "Avec ça, je m’exhibe dans les boîtes de nuit et les grands restaurants la plus superbe poule qui se puisse rêver, ma dactylo, Suzanne, une enfant de dix-huit ans, fraîche, brune, émoustillante en diable, avec des yeux spirituels, dans une frimousse d’ingénue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b0c08aa-e8a1-411d-b7c0-688fdfc0eaf4",
                        "source_entry_id": "fde7a1a3-aed7-3752-9c43-6936565dc65e",
                        "source_sense_id": "c189d3d8-2a53-31e8-891e-225fd81f9daf",
                        "source_sense_description": "théâtre",
                        "target_lang_word": "ingenue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingenue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6472635-f345-3445-9def-ab2f4fc1dac7",
                                        "entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                                        "glosses": [
                                            "An innocent, unsophisticated, naïve, wholesome girl or young woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d7543dc-2ee2-49cc-b39b-44210dc90888",
                                                "sense_id": "b6472635-f345-3445-9def-ab2f4fc1dac7",
                                                "text": "She was seen as a gifted pop-country ingenue when, in a now infamous moment, Kanye West interrupted Swift onstage at the 2009 VMAs while she was accepting an award. The incident set in motion a chain of events that would shape the next decade of both artists’ lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64bed022-fcfe-3b1a-b543-e21bcafaf5ba",
                                        "entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                                        "glosses": [
                                            "A dramatic role of such a woman; an actress playing such a role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "938e973c-b455-4616-8a3e-1554006649c8",
                                                "sense_id": "64bed022-fcfe-3b1a-b543-e21bcafaf5ba",
                                                "text": "The intelligent and talented blonde who was fluent in English, French and Spanish was interested in art and joined a local theater group to work on set designs but wound up on stage playing an ingenue in Liliom and was spotted by director Vincente Minnelli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                        "entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                                        "glosses": [
                                            "Misspelling of ingenu."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec4fb66f-7370-45c8-9294-7094e4a048eb",
                                                "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                                "text": "Mr. Acheson's failure as Secretary of State ... has been an inability to understand people or to be understood by them."
                                            },
                                            {
                                                "example_id": "0f525b85-e422-4f34-a086-150483f92819",
                                                "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                                "text": "I cannot resist citing, slightly out of context, another bit of Baudelaire: \"Satan s'est fait ingénu\" (Satan has made himself into an ingenue [Oeuvres Completes 640])"
                                            },
                                            {
                                                "example_id": "7a4ec4ae-8fd7-4e91-bc8e-35d14d0b611d",
                                                "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                                "text": "America why callow ingenue bile?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
