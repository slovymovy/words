                "translations": [
                    {
                        "translation_id": "1e57f835-1371-4c40-87a9-7a0e15d89721",
                        "source_entry_id": "e9a3e332-9042-33a7-8d6a-1e0e4fe5d721",
                        "source_sense_id": "7d47ee37-711d-3753-8c50-5ae5e472830e",
                        "target_lang_word": "Bildschirmfoto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bildschirmfoto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                                        "entry_id": "447977f4-4192-3314-90ec-5e30233813b4",
                                        "glosses": [
                                            "digitales oder ausgedrucktes Bild des aktuellen Bildschirminhalts oder eines Teiles davon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380c00e0-fa47-4cfb-a72e-bae12a908e50",
                                                "sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                                                "text": "„Er veröffentlicht in einer Facebook-Diskussion mit Nutzern ein Bildschirmfoto eines Wikipedia-Eintrages über das Grundgesetz, den er in der Diskussion präsentieren wollte.“"
                                            },
                                            {
                                                "example_id": "e3ab7112-d121-42bc-bc62-c70c20bee5c3",
                                                "sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                                                "text": "„Ob das Speichern von Bildern, die man sonst nicht sichern kann, oder das Erklären von Funktionen: Bildschirmfotos sind ein nützliches Werkzeug vieler Computernutzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b9aca76-1743-4d63-8fca-22a076e157a8",
                        "source_entry_id": "e9a3e332-9042-33a7-8d6a-1e0e4fe5d721",
                        "source_sense_id": "7d47ee37-711d-3753-8c50-5ae5e472830e",
                        "target_lang_word": "Bildschirmabzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bildschirmabzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                        "entry_id": "7691112a-714e-3364-bfb8-533db4294069",
                                        "glosses": [
                                            "Abspeichern des aktuellen Inhalts des Bildschirms als Rastergrafik in den Zwischenspeicher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2783993f-fe0c-43f6-9659-a7b61e97075e",
                                                "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                                "text": "Unter Microsoft Windows kann man ab dem Betriebssystem XP mit den Tasten Steuerung + Alt + Druck den Bildschirmabzug des aktuellen Dialogs in den Zwischenspeicher nehmen."
                                            },
                                            {
                                                "example_id": "41052d00-4792-4b4a-b965-e5b156dcd275",
                                                "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                                "text": "„Schnell kann sich der Nutzer in den Fenstern „verirren”, dh, er klickt in der Online-Hilfe auf ein Symbol im Bildschirmabzug und wundert sich, dass nichts passiert. Gerade für kontextsensitive Hilfen ist es nicht empfehlenswert, Bildschirmabzüge zu verwenden. … Wenn es für einen Hilfe-Autor unerlässlich ist, einen Bildschirmabzug zum besseren Verständnis anzubieten, sollte er dafür sorgen, dass der Bildschirmabzug auch als solcher erkennbar ist […]“"
                                            },
                                            {
                                                "example_id": "d0408be9-ad27-494e-b30b-7b724a0efdf4",
                                                "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                                "text": "„Anschließend können Sie bei gedrückter linker Maustaste mit dem Stift bestimmte Bereiche des Bildschirmabzugs anzeichnen.“"
                                            },
                                            {
                                                "example_id": "7bb670d6-4930-4ba9-9019-50c428a2dcd6",
                                                "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                                "text": "„Über die Schaltflächen der Symbolleiste des Snipping Tool-Fensters lässt sich der Bildschirmabzug noch markieren bzw. auswerten.“"
                                            },
                                            {
                                                "example_id": "1e443178-e0b3-47d0-ae8b-df36af5bd0fb",
                                                "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                                "text": "„Manche Diagramme sind informell, wie der Bildschirmabzug einer Dialog-Box oder eine schematische Zeichung, die einen Objektbaum zeigt.“"
                                            },
                                            {
                                                "example_id": "1474e832-557f-4113-93f6-0377e137ed0b",
                                                "sense_id": "235d38b9-d147-3ad3-a9f2-d4ce6b4dcc3a",
                                                "text": "„Ein einfacher Bildschirmabzug, bei dem größere Flächen einheitlich gefärbt sind (z. B. Abbildung 6.24), lässt sich ohne den geringsten Informationsverlust leicht auf 5% seiner Ursprungsgröße komprimieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a15be23b-893f-4010-af10-7d7aa3bed547",
                        "source_entry_id": "e9a3e332-9042-33a7-8d6a-1e0e4fe5d721",
