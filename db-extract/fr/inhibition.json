            {
                "entry_id": "7b3ce917-034d-3fd5-894d-5a7352450e47",
                "word": "inhibition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2357dc22-a74a-4af1-a0f9-a4aebfb4a1c4",
                        "entry_id": "7b3ce917-034d-3fd5-894d-5a7352450e47",
                        "tags": [
                            "plural"
