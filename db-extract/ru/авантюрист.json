                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a6b99fc-d1b7-3abb-98cf-0a0dce87529e",
                        "entry_id": "76a877dc-5bed-3e47-9efe-794dfe626994",
                        "glosses": [
                            "тот, кто склонен к авантюрам; беспринципный делец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c8bc99-ca03-4a11-95ab-a3de4bc4ac69",
                                "sense_id": "5a6b99fc-d1b7-3abb-98cf-0a0dce87529e",
                                "text": "Он всюду настойчиво проводил мысль, будто восстание — это дело рук кучки авантюристов, сбивших народ с толку."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b471a0d-ab4c-3234-b0f6-9c227ac4dd5d",
                        "entry_id": "76a877dc-5bed-3e47-9efe-794dfe626994",
                        "glosses": [
                            "устар. искатель приключений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab56ed2-99d1-4712-941f-ab07fc18e785",
                                "sense_id": "6b471a0d-ab4c-3234-b0f6-9c227ac4dd5d",
                                "text": "Но так как на этот раз отказ последовал прежде, чем он успел назвать цифру, то Питт сразу мысленно перечислил Штааля из разряда авантюристов продажных в разряд бескорыстных искателей приключений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "339fbde2-e31e-424c-b72f-9f825e1af5ca",
                        "source_entry_id": "76a877dc-5bed-3e47-9efe-794dfe626994",
                        "source_sense_description": "тот, кто склонен к авантюрам; беспринципный делец",
                        "target_lang_word": "adventurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adventurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e74caca8-4300-3c01-a89c-70964d9c49c0",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "One who enjoys adventures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb94115f-988e-4eee-9483-709d5adce082",
                                                "sense_id": "e74caca8-4300-3c01-a89c-70964d9c49c0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43aaed4b-b0cc-3c0d-bdfc-f36b3cb09704",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A person who seeks a fortune in new and possibly dangerous enterprises."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d462da-e20f-3bb9-b757-07cdd0fffd44",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A soldier of fortune, a speculator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3967e50b-1d81-34f4-a883-a479f6163ae0",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A person who tries to advance their social position by somewhat devious means."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A player of adventure games or text adventures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e2d7a7-7001-400c-806d-dfec1639d647",
                                                "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                                "text": "Meanwhile, the ranks of adventurers grow, be they manic puzzle-solvers or people like me, who like to look under the Robners' beds just for the hell of it."
                                            },
                                            {
                                                "example_id": "207b0c72-6830-4f0c-9d9a-70bcaef66c9a",
                                                "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                                "text": "It's a challenging game for the inexperienced adventurer, and should even give the hardened pros a bit of a run for their money."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "810c5e31-d32f-454f-b442-b7d1976453dc",
                        "source_entry_id": "76a877dc-5bed-3e47-9efe-794dfe626994",
                        "source_sense_description": "тот, кто склонен к авантюрам; беспринципный делец",
                        "target_lang_word": "Abenteurer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abenteurer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                        "entry_id": "5603c5a8-a338-3515-a95f-7419a9a3e5c6",
                                        "glosses": [
                                            "Person, die gefährliche Herausforderungen sucht/erlebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76a8aac-4a99-4164-9682-62c224fdb265",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Skrupellose Abenteurer und Geschäftemacher ringen um die Ressourcen des Staates.“"
                                            },
                                            {
                                                "example_id": "db5f7b3f-310c-4c96-826e-6f0c6016bedf",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Er ging nach Lissabon, wo zahlreiche Genuesen lebten, denn diese Hauptstadt war damals die Weltbörse für Seefahrer und Abenteurer.“"
                                            },
                                            {
                                                "example_id": "1be208db-2da3-472b-af18-0ecb22e8e7f9",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Als müsste man mehr als nur Grenzgänger sein, nämlich auch Glücksritter und Idealist, Falschmünzer und Abenteurer.“<"
                                            },
                                            {
                                                "example_id": "c7ebe3c3-6e2e-42af-95f9-61ee8210c460",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.\""
                                            },
                                            {
                                                "example_id": "407a6f3f-6dfb-43ea-b14e-42e4dd49a073",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Mit Bergen kennt sich der 51jährige Abenteurer und Extremkletterer aus wie kein Zweiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97facbd6-d2f1-402a-adcc-4e5c593cd09f",
