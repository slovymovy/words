                                                "example_id": "7b450ff1-fadb-4406-afc1-2f288678f95f",
                                                "sense_id": "d76cab59-24b7-3afb-9a32-7875aa25390e",
                                                "text": "to dispute the possession of the ground with the Spaniards"
                                            }
                                        ]
                                    },
