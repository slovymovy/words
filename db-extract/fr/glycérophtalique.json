                        "examples": [
                            {
                                "example_id": "5b83687e-9a1b-478f-92c1-ba4472f13e74",
                                "sense_id": "4591f41c-3c4f-31f5-9362-791a06463ee2",
                                "text": "Peinture microporeuse satinée aux résines glycérophtaliques pour bois intérieur et extérieur."
                            },
                            {
                                "example_id": "0dce7f96-e752-48e3-a014-04702c718947",
                                "sense_id": "4591f41c-3c4f-31f5-9362-791a06463ee2",
                                "text": "En tenue de chantier, il avait l’air de sortir de chez Marlboro Classics. Outre ces afféteries, il enfilait, pour travailler, des gants et une casquette de peau beiges. Et rien ne semblait le dégoûter davantage que le contact ou l’odeur prégnante des peintures, qu’elles fussent acryliques ou glycérophtaliques."
                            }
                        ]
                    }
                ],
