                                "target_senses": [
                                    {
                                        "sense_id": "0590c850-ebe7-3cc0-ba2e-20d560a66e5b",
                                        "entry_id": "895edaaa-d63f-372d-a1e8-8f693bb0ba0a",
                                        "glosses": [
                                            "In a special manner; specially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79341ba3-f870-489b-8e0b-59351187e197",
                                                "sense_id": "0590c850-ebe7-3cc0-ba2e-20d560a66e5b",
                                                "text": "He got up early especially."
                                            },
                                            {
                                                "example_id": "cc7ad020-0b84-4ab2-956f-4d0d11f3934f",
                                                "sense_id": "0590c850-ebe7-3cc0-ba2e-20d560a66e5b",
                                                "text": "L.N.E.R. class \"Y6\" 3 ft. 1 in. 0-4-0 steam tram locomotive No. 7133\nThis locomotive, constructed at the Stratford works of the former Great Eastern Railway in 1897, was one of six which were built between 1883 and 1897 especially to work the Wisbech and Upwell Tramway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a332044a-a0a6-3d26-83a7-9f443f047394",
                                        "entry_id": "895edaaa-d63f-372d-a1e8-8f693bb0ba0a",
                                        "glosses": [
                                            "Particularly; to a greater extent than is normal."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf89d709-707e-437b-97e9-47e1321d5b96",
                                                "sense_id": "a332044a-a0a6-3d26-83a7-9f443f047394",
                                                "text": "There is now such an immense \"microliterature\" on hepatics that, beyond a certain point I have given up trying to integrate (and evaluate) every minor paper published—especially narrowly floristic papers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada5c324-8813-3021-835d-b1ef609cc44a",
                                        "entry_id": "895edaaa-d63f-372d-a1e8-8f693bb0ba0a",
                                        "glosses": [
                                            "Used to place greater emphasis upon someone or something."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2654e51-47b6-4107-93e4-4e9a0c71b2c4",
                                                "sense_id": "ada5c324-8813-3021-835d-b1ef609cc44a",
                                                "text": "Invite them all, especially Molly."
                                            },
                                            {
                                                "example_id": "adf39a2c-6ebe-49b8-b2ce-b667d54fe14b",
                                                "sense_id": "ada5c324-8813-3021-835d-b1ef609cc44a",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            },
                                            {
                                                "example_id": "34fb7f52-ca94-48cf-b61a-e8a78437fd1a",
                                                "sense_id": "ada5c324-8813-3021-835d-b1ef609cc44a",
                                                "text": "There is now such an immense \"microliterature\" on hepatics that, beyond a certain point I have given up trying to integrate (and evaluate) every minor paper published—especially narrowly floristic papers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdc5e23d-2949-4c57-960d-bee49de3fc7e",
                        "source_entry_id": "1311c47f-f88b-31c6-a6eb-ad61fa0279fb",
                        "source_sense_id": "9852f0b3-e79e-3739-872e-980af4b7c36d",
