    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d140fecb-579f-394a-a4d7-3efb44e40318",
                "word": "mislight",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f019c23a-b0af-4eb3-9fbb-c78e05e93c62",
                        "entry_id": "d140fecb-579f-394a-a4d7-3efb44e40318",
                        "tags": [
                            "plural"
                        ],
                        "form": "mislights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd9777ab-26f5-3b9f-b0bd-92def4c7c36e",
                        "entry_id": "d140fecb-579f-394a-a4d7-3efb44e40318",
                        "glosses": [
                            "An error in projection in which the projected image is a combination of two frames."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf357d2-f825-4ca9-8a56-fde2aa05e345",
                                "sense_id": "cd9777ab-26f5-3b9f-b0bd-92def4c7c36e",
                                "text": "This error is obviated to a large degree when the perforated strip arrangement is used. If a machine is threaded properly and has made one correct print, it is impossible for a mislight to occur if the machine is set properly before the motor switch is snapped on,"
                            },
                            {
                                "example_id": "9fd4b5df-b695-4fdd-a0b8-da08b1529fe5",
                                "sense_id": "cd9777ab-26f5-3b9f-b0bd-92def4c7c36e",
                                "text": "Notches weaken the negative, and tabs sometimes come off, causing mislights."
                            }
                        ]
                    },
                    {
                        "sense_id": "58c14d18-bf9e-3961-880f-0904cde5111d",
                        "entry_id": "d140fecb-579f-394a-a4d7-3efb44e40318",
                        "glosses": [
                            "An instance when an afterburner does not light the injected fuel properly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7dab079-dbf4-4e57-91e4-ff34a9be1abf",
                                "sense_id": "58c14d18-bf9e-3961-880f-0904cde5111d",
                                "text": "This improved by 11,000 ft. the repeatable afterburner operation capability, without mislight or stall."
                            },
                            {
                                "example_id": "ab60bf50-66ed-4183-a77c-42c28af39658",
                                "sense_id": "58c14d18-bf9e-3961-880f-0904cde5111d",
                                "text": "The F-14A fleet aircraft with TF30-P-412A engines were experiencing numerous afterburner mislights on lighting attempts during sustained high \"g\" load maneuvers."
                            },
                            {
                                "example_id": "2e1aa594-89da-4731-ad18-b2a7e204a11f",
                                "sense_id": "58c14d18-bf9e-3961-880f-0904cde5111d",
                                "text": "Mislights, blowouts, or stalls should not occur since there is more than enough adequate margin to allow for normal transient operation."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
