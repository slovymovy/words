                {
                    "sense_id": "246cfe1b-48af-35e1-9596-55f156a85098",
                    "sense_definition": "Поместить предмет куда-либо, обычно в вертикальном положении или на определенное место.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_placement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не знаю, куда <поставить> эту большую вазу.",
                            "target_lang_translations": {
                                "en": "I don't know where to <w>put</w> this big vase.",
                                "de": "Ich weiß nicht, wohin ich diese große Vase <w>stellen</w> soll."
                            }
                        },
                        {
                            "text": "Официант вежливо попросил <поставить> стакан на поднос.",
                            "target_lang_translations": {
                                "en": "The waiter politely asked to <w>place</w> the glass on the tray.",
                                "de": "Der Kellner bat höflich, das Glas auf das Tablett zu <w>stellen</w>."
                            }
                        },
                        {
                            "text": "Папа помог мне <поставить> машину в гараж.",
                            "target_lang_translations": {
                                "en": "Dad helped me <w>park</w> the car in the garage.",
                                "de": "Papa hat mir geholfen, das Auto in die Garage zu <w>parken</w>."
                            }
