                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To make one's way through or between (a constriction or obstacles)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82fefd8a-fa49-43d4-a6f5-96e62f2d16e4",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "Picking the ball up in his own half, Januzaj threaded a 40-yard pass into the path of Rooney to slice Southampton open in the blink of an eye."
                                            },
                                            {
                                                "example_id": "359b94f3-8fc8-4f62-bb75-617424347bae",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "to thread through narrow passages"
                                            },
                                            {
                                                "example_id": "8faddf13-2044-40d6-8115-7d588aebe6c5",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "I think I can thread my way through here, but it’s going to be tight."
                                            },
                                            {
                                                "example_id": "f31d063a-70e6-4019-afe0-08b10619b43f",
                                                "sense_id": "5158ce42-538f-3f74-95e4-23dba8287d47",
                                                "text": "The line to Uganda goes up the side of a slope in a series of S-bends, and as the telegraph wires follow the line, from below they look like a forest as they thread backwards and forwards about six times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b648c4ab-555f-3fb4-adc0-3183700a7df7",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To make one's way through or between (a constriction or obstacles).",
                                            "To cautiously make (one's way) through a precarious place or situation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c717e54-7aa4-4cd9-b21b-8c8bdc9736be",
                                                "sense_id": "b648c4ab-555f-3fb4-adc0-3183700a7df7",
                                                "text": "He threaded his way through legal entanglements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To pass through; to pierce through; to penetrate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1a8aa3-4127-44b3-9eb3-6a78119699d1",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "And when the Miners by theſe Shafts or Adits do ſtrike or threed a Vein of any Metal […] then the Metal which is digged […] is called Oar […]"
                                            },
                                            {
                                                "example_id": "390e9fca-7948-4f6b-aeda-b632c57b3bf6",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "Tom out here will have leave to thrid you with bullets."
                                            },
                                            {
                                                "example_id": "c87153cd-009c-491f-8561-77b492c3a998",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "Only the swifts were alert and busy, flashing, poising, diving under the eaves; thridding Ned's brain as they passed with a receding sound like that made by pebbles hopping over ice."
                                            },
                                            {
                                                "example_id": "b60f68f3-6301-42c1-9d59-15cca1ac867c",
                                                "sense_id": "70d428a5-3fe4-3980-9e2c-dffdf2d04e7d",
                                                "text": "On the descent the line is often in cuttings; some are high, such as at Scarcroft, where a cut through firestone and fireclay was necessary, and near Bardsey, where the line threads a deep tree-lined gorge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To interweave as if with thread; to intersperse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da195be0-4884-486e-9fdf-0da9abf8921a",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] the urban landscape threaded with parks and trees to the horizon. The enormous sky over that flat line dazzled clear blue or filled with towers of cumulus clouds."
                                            },
                                            {
                                                "example_id": "f021b7a2-18df-4381-904c-c2d67c43e1ea",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] dark hair threaded with gray pulled back from a face still beautiful in spite of clear evidence of the passage of time."
                                            },
                                            {
                                                "example_id": "9cf2bb23-370d-4e56-8474-ce1f08eeb2f9",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] landscape threaded with rivers, roads, tracks, pathways and an airport runway; one peppered with villages, farms, crofts and distilleries. Visitors to Islay, especially those coming from densely populated urban areas, often mistakenly[…]"
                                            },
                                            {
                                                "example_id": "61c0f3bc-ff5e-4178-b657-d4e4412cb1ad",
                                                "sense_id": "b467a6cd-d263-30fd-8d6a-eca2dc731ec9",
                                                "text": "[...] dark hair threaded with early silver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d308fd7f-0ad8-3a72-9772-3f5d7446b731",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To form a screw thread on or in (a bolt, hole, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4135e40e-61a4-41f9-9f8f-e26f2661022b",
                                                "sense_id": "d308fd7f-0ad8-3a72-9772-3f5d7446b731",
                                                "text": "Coordinate term: tap"
                                            },
                                            {
                                                "example_id": "022c7b49-f988-4952-8f73-50444110111e",
                                                "sense_id": "d308fd7f-0ad8-3a72-9772-3f5d7446b731",
                                                "text": "to thread a bolt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d37617-844b-3063-a33a-3e4f584a2541",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To remove (facial hair) by way of a looped thread that is tightly wound in the middle."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dac26f8-e33e-4dd8-b095-9e176bf8d40f",
                                                "sense_id": "17d37617-844b-3063-a33a-3e4f584a2541",
                                                "text": "to thread your eyebrows and trim them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95fc4471-1276-3137-ae54-e6f7cc82f93f",
                                        "entry_id": "1054e193-99fc-3dc5-a2e6-bf7c4ca748b4",
                                        "glosses": [
                                            "To feed (a sewing machine or otherwise a projecting or exposing mechanism, such as a projector, a camera, etc.) with film."
                                        ],
