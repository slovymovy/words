                "senses": [
                    {
                        "sense_id": "739b3381-d68b-3e97-92c0-6ade84f440af",
                        "entry_id": "06c06a8b-4cf9-3878-9b5a-b2398b6d35c1",
                        "glosses": [
                            "ein kleiner, länglich geformter Knochen im Handgelenk, der daumenseitig gelegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5fb2b1-b596-43ee-b598-2efc595dfb75",
                                "sense_id": "739b3381-d68b-3e97-92c0-6ade84f440af",
                                "text": "Bei einem Kahnbeinbruch ist es sowohl für die Diagnostik als auch für die Therapie von großer Bedeutung festzustellen, ob das Kahnbein nur gebrochen ist oder ob zusätzlich eine Verschiebung der Bruchteile vorliegt."
                            },
                            {
                                "example_id": "5efea49f-6689-47f1-a114-0f504fc27829",
                                "sense_id": "739b3381-d68b-3e97-92c0-6ade84f440af",
                                "text": "Der Patient hat sich das Kahnbein beim Fußballspielen gebrochen."
                            },
                            {
                                "example_id": "b9f76d5a-568e-48f8-bdac-2d61de02ba59",
                                "sense_id": "739b3381-d68b-3e97-92c0-6ade84f440af",
                                "text": "Ein Bruch des Kahnbeins kommt an der Hand wesentlich häufiger vor als am Fuß."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
