{
    "word_family": [
        "coherence",
        "coherency",
        "cohere",
        "coherently",
        "incoherent",
        "incoherence"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e575afe2-3d0d-3f0b-a25a-f64a2de22963",
                    "sense_definition": "Logical, orderly, and consistent in thought or argument.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "logical_consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician failed to provide a <w>coherent</w> explanation for the sudden change in policy.",
                            "target_lang_translations": {
                                "ru": "Политику не удалось дать <w>связного</w> объяснения внезапному изменению курса."
                            }
                        },
                        {
                            "text": "You need to present a <w>coherent</w> argument if you want to convince the committee.",
                            "target_lang_translations": {
                                "ru": "Вам нужно представить <w>последовательную</w> аргументацию, если вы хотите убедить комитет."
                            }
                        }
                    ],
                    "synonyms": [
                        "logical",
                        "consistent",
                        "rational",
                        "lucid"
                    ],
                    "antonyms": [
                        "incoherent"
                    ],
                    "common_phrases": [
                        "coherent argument",
                        "coherent strategy",
                        "coherent plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Логичный, упорядоченный и последовательный в мыслях или аргументации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связный",
                                "target_lang_sense_clarification": "о речи или аргументации"
                            },
                            {
                                "target_lang_word": "последовательный",
                                "target_lang_sense_clarification": "логически выверенный"
                            },
                            {
                                "target_lang_word": "вразумительный",
                                "target_lang_sense_clarification": "понятный и логичный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35618580-34cb-3747-bd29-1426f22eac29",
                    "sense_definition": "Forming a unified whole; sticking together as a single entity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The various tribes eventually merged to form a <w>coherent</w> kingdom with a shared identity.",
                            "target_lang_translations": {
                                "ru": "Различные племена в конечном итоге объединились, чтобы сформировать <w>единое</w> королевство с общей идентичностью."
                            }
                        },
                        {
                            "text": "The artist struggled to create a <w>coherent</w> whole from the many different styles of painting.",
                            "target_lang_translations": {
                                "ru": "Художник пытался создать <w>целостное</w> произведение из множества различных стилей живописи."
                            }
                        }
                    ],
                    "synonyms": [
                        "unified",
                        "cohesive",
                        "integrated"
                    ],
                    "antonyms": [
                        "disjointed"
                    ],
                    "common_phrases": [
                        "coherent whole",
                        "coherent unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образующий единое целое; сплоченный или объединенный в одну структуру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целостный",
                                "target_lang_sense_clarification": "образующий единство"
                            },
                            {
                                "target_lang_word": "единый",
                                "target_lang_sense_clarification": "сплоченный"
                            },
                            {
                                "target_lang_word": "связный",
                                "target_lang_sense_clarification": "структурно объединенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4f9440e-6e33-36f8-af17-8aa7489e4b35",
                    "sense_definition": "Describing waves, such as light, that have the same direction, wavelength, and phase.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A laser produces a beam of <w>coherent</w> light that can travel long distances without spreading.",
                            "target_lang_translations": {
                                "ru": "Лазер создает луч <w>когерентного</w> света, который может проходить большие расстояния без рассеивания."
                            }
                        },
                        {
                            "text": "The experiment required a <w>coherent</w> source of radiation to measure the interference pattern.",
                            "target_lang_translations": {
                                "ru": "Для эксперимента потребовался <w>когерентный</w> источник излучения, чтобы измерить интерференционную картину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coherent light",
                        "coherent radiation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает волны (например, световые), имеющие одинаковое направление, длину и фазу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когерентный",
                                "target_lang_sense_clarification": "физический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ff11997-f0d2-3412-aabd-a48ba47b2972",
                    "sense_definition": "Relating to specific algebraic properties of modules or sheaves in mathematics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study of <w>coherent</w> sheaves is fundamental to modern algebraic geometry.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>когерентных</w> пучков является фундаментальным для современной алгебраической геометрии."
                            }
                        },
                        {
                            "text": "Every finitely generated module over a Noetherian ring is <w>coherent</w>.",
                            "target_lang_translations": {
                                "ru": "Любой конечно порожденный модуль над нётеровым кольцом является <w>когерентным</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coherent sheaf",
                        "coherent module"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к специфическим алгебраическим свойствам модулей или пучков в математике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когерентный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}