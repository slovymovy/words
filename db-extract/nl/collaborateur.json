                    },
                    {
                        "sense_id": "fdfd0d36-6372-3b1b-a1f7-1924e50700eb",
                        "entry_id": "dc125a93-07ab-31fb-8d16-b6e4a2f751b1",
                        "glosses": [
                            "iemand die in bezette landen met de vijand samenwerkt"
