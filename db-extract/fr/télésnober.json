                "senses": [
                    {
                        "sense_id": "a907f653-6049-3a9a-a0fe-314406b5cefb",
                        "entry_id": "d9a0d532-9b31-351d-83b3-ff3657e88df9",
                        "glosses": [
                            "Ignorer (snober) des personnes physiquement présentes en consultant son téléphone ou un autre appareil mobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95ed062-e146-46f3-91e1-b0f36dcc9f96",
                                "sense_id": "a907f653-6049-3a9a-a0fe-314406b5cefb",
                                "text": "Le phubbing inspire aussi l’art : à la gare de Saint-Pancras, à Londres, on peut maintenant observer un bas-relief intitulé The Meeting Place (\"Le lieu de rendez-vous\"), où une jeune femme télésnobe son ami."
                            },
                            {
                                "example_id": "690d77a4-1f8d-4deb-a2ed-2cda7d2fb8df",
                                "sense_id": "a907f653-6049-3a9a-a0fe-314406b5cefb",
                                "text": "Si le fait de télésnober vous est encore inconnu, il y a fort à parier que vous êtes pourtant familier de cette attitude qui consiste à snober les personnes en votre compagnie au profit de votre cercle social virtuel, en tapotant hystériquement sur votre smartphone."
                            },
                            {
                                "example_id": "56713637-11a6-4f17-aa36-559868f0e2ab",
                                "sense_id": "a907f653-6049-3a9a-a0fe-314406b5cefb",
                                "text": "Nous avons tous un supérieur, un collègue ou un ami qui est constamment sur son smartphone, qui nous télésnobe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "671d64eb-63ec-43bb-9310-ed5758035011",
                        "source_entry_id": "d9a0d532-9b31-351d-83b3-ff3657e88df9",
                        "source_sense_id": "a907f653-6049-3a9a-a0fe-314406b5cefb",
                        "target_lang_word": "phub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6d369f-91d5-34f1-89bd-7c89205ec610",
                                        "entry_id": "857afbc0-8eca-3c0e-ad73-dff37de8a722",
                                        "glosses": [
                                            "To ignore the conversation around oneself by focusing on one's smartphone."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "219d4be0-0799-4d55-a813-ce11b4543c37",
                                                "sense_id": "0f6d369f-91d5-34f1-89bd-7c89205ec610",
                                                "text": "Phubbing has been theorized to provoke conflict in romantic relationships because the partner being phubbed feels unimportant and deprioritized compared to the digital content delivered through their partner's mobile phone."
                                            },
                                            {
                                                "example_id": "31e0935c-ac1a-431f-9d91-c395952ad95c",
                                                "sense_id": "0f6d369f-91d5-34f1-89bd-7c89205ec610",
                                                "text": "Individuals who were phubbed during a conversation, felt less valued, less close, and less important to the individual who phubbed them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a37f08e-b55a-34c6-8ef6-ec732ea64fb2",
                                        "entry_id": "b9925ebc-1fed-35cc-b6ee-ece3e13f0a84",
                                        "glosses": [
                                            "An instance of phubbing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d5aee0-06e7-4186-bb03-121794928cba",
                                                "sense_id": "3a37f08e-b55a-34c6-8ef6-ec732ea64fb2",
                                                "text": "Researchers have found that phubs damage relationships and increase dissatisfaction and depression. About 25% of couples have fought over phubs (Goldberg, 2018)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
