        "fr-extract.jsonl": [
            {
                "entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                "word": "souverainement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ef0e645c-a5bb-3209-98dc-c102ed8a1da1",
                        "entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                        "glosses": [
                            "Excellemment, parfaitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af1d621-b304-4c64-867b-509e598bafb7",
                                "sense_id": "ef0e645c-a5bb-3209-98dc-c102ed8a1da1",
                                "text": "Mandez-moi des nouvelles…. de votre santé, de vos affaires ; voilà ce qui me tient à cœur souverainement,"
                            },
                            {
                                "example_id": "d3fa161e-2af0-44d7-ba8d-006bdd3b5ed8",
                                "sense_id": "ef0e645c-a5bb-3209-98dc-c102ed8a1da1",
                                "text": "Muserolle.– Franchement, vous êtes souverainement belle !"
                            },
                            {
                                "example_id": "1f7ccfd4-ba53-4ecd-af75-d2271eee3136",
                                "sense_id": "ef0e645c-a5bb-3209-98dc-c102ed8a1da1",
                                "text": "Les propos du gros garçon se mirent à charlestonner dans son cerveau où la lucidité s'insinuait souverainement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1f28367-a132-33d3-9a7d-870fd901bf44",
                        "entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                        "glosses": [
                            "Extrêmement."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f93a01e0-8eaf-4768-98c5-7be1b5c15ff5",
                                "sense_id": "b1f28367-a132-33d3-9a7d-870fd901bf44",
                                "text": "Madame la comtesse de Sérizy […] était souverainement jugeuse. Littérature, politique, hommes et femmes, tout subissait sa censure ; […]."
                            },
                            {
                                "example_id": "7f80ddf1-4068-46fd-8046-c13762b0be62",
                                "sense_id": "b1f28367-a132-33d3-9a7d-870fd901bf44",
                                "text": "Il [M. de Gordes] a souverainement deux choses, une grande défiance et une grande incertitude, de sorte qu’il se jette à l’écart à tout moment,"
                            },
                            {
                                "example_id": "50952049-d974-4712-a8c0-7563fa17bcbd",
                                "sense_id": "b1f28367-a132-33d3-9a7d-870fd901bf44",
                                "text": "Soumis et docile à la critique quand elle lui paraissait juste, il la méprisait souverainement quand il la croyait déraisonnable,"
                            }
                        ]
                    },
                    {
                        "sense_id": "4013a123-1361-329b-aa56-f2d285409fd1",
                        "entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                        "glosses": [
                            "D’une manière souveraine, sans appel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0853330f-20ad-4847-a3d1-a2900283d15c",
                                "sense_id": "4013a123-1361-329b-aa56-f2d285409fd1",
                                "text": "Les confesseurs sont obligés de se rapporter à nous [jésuites] pour les cas de conscience ; car c’est nous qui en jugeons souverainement,"
                            }
                        ]
                    },
                    {
                        "sense_id": "3fbfa8be-b351-3336-9538-677b2f80d2a6",
                        "entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                        "glosses": [
                            "En son pouvoir, et avec autorité de ses fonctions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1ac565-87b1-400f-9f9c-6255919a1616",
                                "sense_id": "3fbfa8be-b351-3336-9538-677b2f80d2a6",
                                "text": "Ayant souverainement estimé que la communication commerciale et la publicité via un site internet n’entraient pas dans le champ de l’activité principale d’un architecte, au sens de l’article L. 121-16-1 III, devenu L. 221-3 du code de la consommation, une cour d’appel n’a pu qu’en déduire que, celui-ci ayant conclu un contrat de création et de licence d’exploitation de site internet avec un professionnel, bénéficiait du droit de rétractation prévu à l’article L. 121-1 du code de la consommation, dans sa rédaction antérieure à celle issue de l’ordonnance nᵒ 2016-301 du 14 mars 2016."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a4fa838-35dc-471a-929a-40bc9d1d6f1e",
                        "source_entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                        "target_lang_word": "sovereignly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sovereignly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                        "entry_id": "9b21365d-9e60-366c-8de6-e6aff462fc02",
                                        "glosses": [
                                            "To the highest degree; wholly; utterly"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377c48fc-b155-48a4-8313-e4fc5e422d1c",
                                                "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                                "text": "They are sovereignly unjust, for all the parties are human beings with the same essential interests, and no one of them is the wholly perverse demon which another often imagines him to be."
                                            },
                                            {
                                                "example_id": "ccc91fde-eb9e-4d7f-9d29-c2b8f5ada22c",
                                                "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                                "text": "There is something almost magical at first sight in the transformation which the Australian colonies have undergone in a very limited space of time; yet it is but the natural result of the untrammelled energy of a race sovereignly fitted to \"subdue the earth.\""
                                            },
                                            {
                                                "example_id": "6fd30ab0-b8ba-4bd1-b8c7-e32a291f0221",
                                                "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                                "text": "Yet here was this girl, who called him up to the heights of young life again: and a brave girl; and she bled for the weak, had no shrinking from the women underfoot: for the reason, that she was a girl sovereignly pure, angelically tender."
                                            },
                                            {
                                                "example_id": "6252bfe0-015e-495e-bd87-047f71dfe8b8",
                                                "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                                "text": "All his glorious plays would not be worth (bookseller's value) some scraps of thought and feeling, or mere personal detail, or even commonplace (he must have been sovereignly commonplace) impartment of theatrical business news and gossip to his fellow-players, or Scotch Drummond, or my Lord Southampton, or the Dark Woman of the sonnets."
                                            },
                                            {
                                                "example_id": "b757a9e4-e262-43ef-baf7-8c0de9368367",
                                                "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                                "text": "To speak truly, it has but one declaration to make: to proclaim anew the constitutional law, by virtue of which each State sovereignly decides its own affairs, and consequently excludes all interference of Congress in the matter of slavery."
                                            },
                                            {
                                                "example_id": "2730d6db-ea1e-4123-a2e9-6b370969d99d",
                                                "sense_id": "57566edc-42e7-3212-8a1b-d9305b0908fd",
                                                "text": "CAMILLO. Sir, my lord, I could do this; and that with no rash potion, But with a ling'ring dram, that should not work Maliciously like poison: but I cannot Believe this crack to be in my dread mistress, So sovereignly being honourable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f703f2f2-cbf4-4012-9dad-a1c2faa128c2",
                        "source_entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
                        "target_lang_word": "supremely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supremely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7a81ef-1813-36ba-9781-6ffaa3b303ae",
                                        "entry_id": "343a39f8-e4a2-3e00-a8c8-0c316f4400bb",
                                        "glosses": [
                                            "To the greatest, highest, or utmost degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a4c5ee3-5a2d-42cf-bb9f-ec2a78950217",
                                                "sense_id": "cd7a81ef-1813-36ba-9781-6ffaa3b303ae",
                                                "text": "They were supremely confident at the beginning of the season."
                                            },
                                            {
                                                "example_id": "7438fcd7-7364-4cae-b096-486d8db30d07",
                                                "sense_id": "cd7a81ef-1813-36ba-9781-6ffaa3b303ae",
                                                "text": "The second half was a test United passed supremely. They began with an equaliser that again illustrated how ruthless their attacking play can be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13cc966b-6c65-4612-94af-40ce180c436e",
                        "source_entry_id": "f7e6655a-ae87-35da-b207-f25f07ffca7d",
