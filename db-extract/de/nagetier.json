                "senses": [
                    {
                        "sense_id": "33948d3e-4fad-3b7c-bbc1-8de47cb9e3b3",
                        "entry_id": "9aa7e197-a495-3622-9261-978b8798c161",
                        "glosses": [
                            "Rongeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a8e717b-c934-44b9-93eb-366c1d4662ca",
                                "sense_id": "33948d3e-4fad-3b7c-bbc1-8de47cb9e3b3",
                                "text": "Das Lokalblatt, das sonst sehr abwechslungsreich ist, wird jetzt vollständig von einer Kampagne gegen die Stadtverwaltung beherrscht: ‹Sind sich unsere Stadtväter der Gefahr bewusst, die die verwesten Kadaver dieser Nagetiere darstellen können?›",
                                "translation": "La chronique locale, qui d’habitude est très variée, est maintenant occupée tout entière par une campagne contre la municipalité : “Nos édiles se sont-ils avisés du danger que pouvaient présenter les cadavres putréfiés de ces rongeurs ?”"
                            },
                            {
                                "example_id": "e20a026c-8a8e-47cd-a0d8-0dc9cdc41018",
                                "sense_id": "33948d3e-4fad-3b7c-bbc1-8de47cb9e3b3",
                                "text": "Woma Pythons (Aspidites ramsayi) kommen in Australien vor. Die Fleischfresser können bis zu zweieinhalb Meter lang werden. Sie ernähren sich von Mäusen, Ratten und anderen Nagetieren.",
                                "translation": "Les python de Ramsay (Aspidites ramsayi) vivent en Australie. Ces carnivores peuvent mesurer jusqu'à deux mètres et demi de long. Ils se nourrissent de souris, de rats et d'autres rongeurs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
