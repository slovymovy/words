                ],
                "senses": [
                    {
                        "sense_id": "073458d8-1246-3458-86d6-cf850d268ea0",
                        "entry_id": "47f12cc2-0352-32a6-a13d-254d5c6ff7da",
                        "glosses": [
                            "Nom de famille français ^([Ins])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f651ed9-7050-4b94-b6a5-fb96882732c6",
                                "sense_id": "073458d8-1246-3458-86d6-cf850d268ea0",
                                "text": "L’équipe de France de basket peine à trouver la trace d’un match plein de son leadeur, Evan Fournier, alors que se profile la demi-finale de l’Euro, contre la Pologne."
                            },
                            {
                                "example_id": "c7e71e45-fa05-4659-b246-0faf54060c80",
                                "sense_id": "073458d8-1246-3458-86d6-cf850d268ea0",
                                "text": "Selon lui, la fin de l’exigence remonte à l’épilogue de l’ère Hubert Fournier, limogé en décembre 2015 : « Durant les trois ans et demi avec Bruno Genesio, il y avait des excuses à tout va pour surprotéger et dédouaner les joueurs »."
                            }
                        ]
                    }
                ],
