                        "examples": [
                            {
                                "example_id": "e89c74a7-f572-4efa-a32b-af291ee5b323",
                                "sense_id": "e047c5c2-02a5-35c1-99d9-9f4061464be6",
                                "text": "Aufgrund von Zeitmangel können wir heute leider nicht alle Themen besprechen."
                            },
                            {
                                "example_id": "0407ceb0-8d0f-4f9e-b422-2ef4269558ec",
                                "sense_id": "e047c5c2-02a5-35c1-99d9-9f4061464be6",
                                "text": "„Signor Rosa kam und ließ mich das Schriftstück lesen, das er aus Zeitmangel noch nicht notariell hatte ausfertigen lassen.“"
                            },
                            {
                                "example_id": "04bed0db-3ccd-42b7-a7e4-693e249652d0",
                                "sense_id": "e047c5c2-02a5-35c1-99d9-9f4061464be6",
                                "text": "„Fallada solle sich mit Zeitmangel entschuldigen, er selbst werde sich ähnlich verhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
