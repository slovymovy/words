                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4895f488-5bf6-483b-88cb-53874611fe98",
                                                "sense_id": "34654cad-5fe4-326b-8127-b756c46e89c0",
                                                "text": "Il renroule ses cartes et les glisse dans un fourreau, puis il replie sa longue vue qu’il range dans un étui et met à son tour dans la valise."
                                            },
                                            {
                                                "example_id": "2ed2d598-7958-4220-bfd1-b7da1d65e47a",
                                                "sense_id": "34654cad-5fe4-326b-8127-b756c46e89c0",
                                                "text": "L’avion revient vers nous, plane un moment sur nos têtes, glisse, remonte et, dans une dernière caracole, pique vers son hangar."
                                            }
                                        ]
                                    },
