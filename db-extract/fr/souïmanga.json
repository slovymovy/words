                        ],
                        "examples": [
                            {
                                "example_id": "0d3b6ad4-d68c-42cc-a33a-074b0ab94dbb",
                                "sense_id": "14dd066a-4ab6-34a1-bcb3-b97043bf6a16",
                                "text": "Le delta de l’Okavango est aussi un lieu de rendez-vous pour des millions d’oiseaux, hérons, pélicans, cigognes, marabouts, jacanas, aigles, vautours, faucons, touracos, tisserins, guêpiers, rolliers, calaos, martins-pêcheurs, pics, martinets, hirondelles, souïmangas, perroquets, outardes, gangas, etc."
                            },
                            {
                                "example_id": "8e23f844-228b-4ddd-b278-e73e6b32b36f",
                                "sense_id": "14dd066a-4ab6-34a1-bcb3-b97043bf6a16",
                                "text": "Le souïmanga est un des oiseaux les plus communs sur Aldabra. Ses ancêtres se sont répandus dans l’océan Indien depuis l’Afrique, colonisant les Comores, Madagascar, puis Aldabra."
                            }
                        ]
