                ],
                "senses": [
                    {
                        "sense_id": "47c7e3a7-ac78-3efe-80c0-1d59f40aa27b",
                        "entry_id": "8bf20f1a-13f6-3ea9-9a91-337be97adb1d",
                        "glosses": [
                            "sich gegen den Islam richtend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4424f71-345f-48dc-9911-4c738c71acdc",
                                "sense_id": "47c7e3a7-ac78-3efe-80c0-1d59f40aa27b",
                                "text": "„Der Bauer beeilte sich mit dem Beten, denn jeden Moment konnte die nächste russische Reisegruppe vom Eingang her hereintreten, wo sie noch in dem Buchladen stöberten, der atheistische Literatur und antiislamische Traktate verkaufte.“"
                            },
                            {
                                "example_id": "ad624e57-b7c5-444c-a0e9-c49f3812d504",
                                "sense_id": "47c7e3a7-ac78-3efe-80c0-1d59f40aa27b",
                                "text": "„Das traditionelle afghanische Neujahrsfest Nawroz wurde als antiislamisch verboten.“"
                            },
                            {
                                "example_id": "0f05eeae-e164-42ef-bf77-f175a0b525db",
                                "sense_id": "47c7e3a7-ac78-3efe-80c0-1d59f40aa27b",
                                "text": "„Mit einem spektakulären Auftritt versuchte dort ein Vertreter der Fatah - sie war inzwischen zur neuen dominanten Kraft in der PLO geworden -, die aus mehr als dreißig mehrheitlich islamischen Ländern angereisten Konferenzteilnehmer für die palästinensische Sache zu gewinnen: Er spielte eine Tonbandaufnahme ab, auf der angeblich zu hören war, wie Israelis, ohne ihre Schuhe ausgezogen zu haben, die Al-Aqsa-Moschee betraten und antiislamische Parolen skandierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
