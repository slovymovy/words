{
    "word_family": [
        "damp",
        "dampen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cd5ff54-79b2-336d-9461-50a38ce034d8",
                    "sense_definition": "A valve or plate used to regulate airflow in a stove or furnace",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adjust the <w>damper</w> to reduce the heat in the wood stove.",
                            "target_lang_translations": {
                                "pl": "Wyreguluj <w>szyber</w>, aby zmniejszyć temperaturę w piecu."
                            }
                        },
                        {
                            "text": "The fire burned slowly after he closed the <w>damper</w>.",
                            "target_lang_translations": {
                                "pl": "Ogień palił się wolniej, gdy zamknął <w>szyber</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stove damper"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zawór lub klapa służąca do regulacji przepływu powietrza w piecu lub kominku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szyber",
                                "target_lang_sense_clarification": "element regulujący ciąg w przewodzie kominowym lub piecu"
                            },
                            {
                                "target_lang_word": "przepustnica",
                                "target_lang_sense_clarification": "mechanizm regulujący przepływ powietrza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a55a1426-c960-312a-ace1-606c90011f42",
                    "sense_definition": "A mechanism in a piano that stops strings from vibrating",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The piano <w>damper</w> failed to stop the string from ringing.",
                            "target_lang_translations": {
                                "pl": "<w>Tłumik</w> w pianinie nie zatrzymał drgania struny."
                            }
                        },
                        {
                            "text": "Pressing the pedal lifts the <w>damper</w> off the strings.",
                            "target_lang_translations": {
                                "pl": "Naciśnięcie pedału unosi <w>tłumik</w> ze strun."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mechanizm w pianinie, który zatrzymuje drgania strun."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tłumik",
                                "target_lang_sense_clarification": "część mechanizmu pianina wyciszająca struny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c2b4780-b94e-3859-9647-28cd31a9759d",
                    "sense_definition": "Something that discourages enthusiasm or ruins a mood",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_check",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news acted as a <w>damper</w> on the party atmosphere.",
                            "target_lang_translations": {
                                "pl": "Złe wieści zadziałały jak <w>kubeł zimnej wody</w> na atmosferę imprezy."
                            }
                        },
                        {
                            "text": "His constant complaining put a <w>damper</w> on our excitement.",
                            "target_lang_translations": {
                                "pl": "Jego ciągłe narzekanie <w>zepsuło nam nastrój</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "killjoy"
                    ],
                    "common_phrases": [
                        "put a damper on"
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś, co studzi entuzjazm lub psuje nastrój."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "coś, co psuje nastrój",
                                "target_lang_sense_clarification": "idiomatyczne określenie czynnika psującego zabawę"
                            },
                            {
                                "target_lang_word": "kubeł zimnej wody",
                                "target_lang_sense_clarification": "metaforyczne określenie czegoś, co studzi zapał"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3992d653-2883-3fe7-993f-879d197b9ee1",
                    "sense_definition": "A device that reduces the oscillations or vibrations of a system",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer installed a <w>damper</w> to stabilize the tall building.",
                            "target_lang_translations": {
                                "pl": "Inżynier zainstalował <w>tłumik drgań</w>, aby ustabilizować wysoki budynek."
                            }
                        },
                        {
                            "text": "This mechanical <w>damper</w> prevents excessive shaking in the machine.",
                            "target_lang_translations": {
                                "pl": "Ten mechaniczny <w>tłumik</w> zapobiega nadmiernym wstrząsom maszyny."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Urządzenie redukujące drgania lub wibracje w systemie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tłumik drgań",
                                "target_lang_sense_clarification": "urządzenie techniczne redukujące wibracje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c4aacb3-a526-308e-af22-d1ad74b3ffe1",
                    "sense_definition": "A shock absorber used in vehicles to smooth out the ride",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car needs a new <w>damper</w> because the ride feels very bumpy.",
                            "target_lang_translations": {
                                "pl": "Samochód potrzebuje nowego <w>amortyzatora</w>, ponieważ jazda jest bardzo wyboista."
                            }
                        },
                        {
                            "text": "Worn out <w>damper</w> units can make driving quite dangerous.",
                            "target_lang_translations": {
                                "pl": "Zużyte <w>amortyzatory</w> mogą sprawić, że jazda stanie się niebezpieczna."
                            }
                        }
                    ],
                    "synonyms": [
                        "shock absorber"
                    ],
                    "target_lang_definitions": {
                        "pl": "Amortyzator używany w pojazdach do wygładzania jazdy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "amortyzator",
                                "target_lang_sense_clarification": "element zawieszenia pojazdu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "706a4d9e-739d-33a0-949d-4ec08ccf6fe3",
                    "sense_definition": "A simple bread made of flour and water, traditionally baked in ashes",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers baked a fresh <w>damper</w> over the campfire.",
                            "target_lang_translations": {
                                "pl": "Podróżnicy upiekli świeży chleb typu <w>damper</w> nad ogniskiem."
                            }
                        },
                        {
                            "text": "They ate the warm <w>damper</w> with butter and honey.",
                            "target_lang_translations": {
                                "pl": "Zjedli ciepły <w>damper</w> z masłem i miodem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Prosty chleb z mąki i wody, tradycyjnie pieczony w popiele."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "damper",
                                "target_lang_sense_clarification": "tradycyjny australijski chleb wypiekany w popiele"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "920a328d-4131-3221-b04c-045ef4bef039",
                    "sense_definition": "A cash register or shop till",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief attempted to break into the shop <w>damper</w>.",
                            "target_lang_translations": {
                                "pl": "Złodziej próbował włamać się do sklepowej <w>kasy</w>."
                            }
                        },
                        {
                            "text": "He emptied the <w>damper</w> at the end of his shift.",
                            "target_lang_translations": {
                                "pl": "Opróżnił <w>kasę</w> pod koniec swojej zmiany."
                            }
                        }
                    ],
                    "synonyms": [
                        "till"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Victorian era slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Kasa sklepowa (przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kasa",
                                "target_lang_sense_clarification": "miejsce przechowywania pieniędzy w sklepie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77eb15a2-d5f9-31b5-9b0b-5f276d6da0ea",
                    "sense_definition": "Comparative form of <w>damp</w>: more damp",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grass is <w>damper</w> today than it was yesterday morning.",
                            "target_lang_translations": {
                                "pl": "Trawa jest dzisiaj <w>bardziej wilgotna</w> niż wczoraj rano."
                            }
                        },
                        {
                            "text": "This side of the forest is much <w>damper</w> because of the shade.",
                            "target_lang_translations": {
                                "pl": "Ta strona lasu jest znacznie <w>wilgotniejsza</w> z powodu cienia."
                            }
                        }
                    ],
                    "antonyms": [
                        "drier"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stopień wyższy przymiotnika 'wilgotny': bardziej wilgotny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bardziej wilgotny",
                                "target_lang_sense_clarification": "stopień wyższy przymiotnika wilgotny"
                            },
                            {
                                "target_lang_word": "wilgotniejszy",
                                "target_lang_sense_clarification": "stopień wyższy przymiotnika wilgotny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}