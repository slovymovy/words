{
    "word_family": [
        "décalage",
        "cale",
        "caler",
        "calage",
        "recaler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6da5dfc6-eb4b-3103-b5f7-a281882c2d12",
                    "sense_definition": "Reporter ou avancer la date ou l'heure d'un événement, d'une activité ou d'un rendez-vous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>décaler</w> notre rendez-vous de demain car le directeur est absent."
                        },
                        {
                            "text": "Le professeur a proposé de <w>décaler</w> l'examen d'une semaine pour nous laisser réviser."
                        }
                    ],
                    "synonyms": [
                        "reporter",
                        "différer",
                        "avancer"
                    ],
                    "common_phrases": [
                        "décaler un rendez-vous",
                        "décaler d'une heure"
                    ]
                },
                {
                    "sense_id": "7c91b92e-754e-3220-938c-438479de7b51",
                    "sense_definition": "Déplacer ou se déplacer légèrement sur le côté pour libérer de la place ou modifier une position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu te <w>décaler</w> un peu pour laisser passer la personne avec la poussette ?"
                        },
                        {
                            "text": "Le photographe lui a demandé de se <w>décaler</w> vers la gauche afin d'éviter l'ombre."
                        }
                    ],
                    "synonyms": [
                        "pousser",
                        "déplacer"
                    ],
                    "common_phrases": [
                        "se décaler sur le côté"
                    ]
                },
                {
                    "sense_id": "b694fccb-6158-39f2-87ac-600041f4d1e2",
                    "sense_definition": "Quitter un lieu, partir ou se mettre en route pour aller quelque part.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "depart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est déjà tard, je pense qu'on va bientôt <w>décaler</w> vers la maison."
                        },
                        {
                            "text": "Les pompiers viennent de recevoir un appel urgent et doivent <w>décaler</w> immédiatement."
                        }
                    ],
                    "synonyms": [
                        "partir",
                        "bouger",
                        "s'en aller"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "4999f12f-d6e1-313c-b808-06d66f2039f6",
                    "sense_definition": "Enlever la cale qui immobilise ou maintient un objet en place.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a fini la réparation et commence à <w>décaler</w> la roue du véhicule."
                        },
                        {
                            "text": "Avant de démarrer, le chauffeur doit <w>décaler</w> le camion en retirant les cales des roues."
                        }
                    ],
                    "antonyms": [
                        "caler"
                    ]
                }
            ]
        }
    ]
}