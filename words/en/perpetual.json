    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "410792a0-aae8-3de0-bcc2-791a45c14c23",
                    "sense_definition": "Lasting forever or for an indefinitely long period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eternal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain peaks are covered in <w>perpetual</w> snow that never melts even in summer.",
                            "target_lang_translations": {
                                "ru": "Горные вершины покрыты <w>вечными</w> снегами, которые не тают даже летом.",
                                "tr": "Dağ zirveleri, yazın bile erimeyen <w>ebedi</w> karlarla kaplıdır."
                            }
                        },
                        {
                            "text": "Ancient myths often speak of a <w>perpetual</w> flame that must never be extinguished.",
                            "target_lang_translations": {
                                "ru": "Древние мифы часто повествуют о <w>вечном</w> огне, который никогда не должен угасать.",
                                "tr": "Eski mitler genellikle asla söndürülmemesi gereken <w>ebedi</w> bir ateşten bahseder."
                            }
                        }
                    ],
                    "synonyms": [
                        "eternal",
                        "everlasting",
                        "permanent",
                        "unending",
                        "undying",
                        "timeless"
                    ],
                    "antonyms": [
                        "temporary",
                        "brief",
                        "momentary",
                        "transient",
                        "ephemeral"
                    ],
                    "common_phrases": [
                        "perpetual snow",
                        "perpetual motion",
                        "perpetual flame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длящийся вечно или в течение неопределенно долгого периода времени.",
                        "tr": "Sonsuz veya belirsiz derecede uzun bir süre devam eden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "бесконечный во времени"
                            },
                            {
                                "target_lang_word": "бессменный",
                                "target_lang_sense_clarification": "не прекращающийся"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ebedi",
                                "target_lang_sense_clarification": "zaman sınırı olmayan, sonsuz"
                            },
                            {
                                "target_lang_word": "sonsuz",
                                "target_lang_sense_clarification": "hiç bitmeyen"
                            }
                        ]
