                ],
                "senses": [
                    {
                        "sense_id": "b115849f-8523-337e-b177-0a0201031d29",
                        "entry_id": "46c065dc-1f76-3e37-8342-1a1fde5b4e88",
                        "glosses": [
                            "een jaarlijkse geldprijs voor wetenschappers en anderen die een opmerkelijke prestatie hebben geleverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57eea8aa-86ba-4d16-ad1c-ca5b52d84273",
                                "sense_id": "b115849f-8523-337e-b177-0a0201031d29",
                                "text": "Moniz kreeg in 1949 de Nobelprijs voor de Fysiologie of Geneeskunde voor de ontdekking van het therapeutische effect van lobotomie."
                            },
                            {
                                "example_id": "582df436-a2e2-40df-b239-4538c296af69",
                                "sense_id": "b115849f-8523-337e-b177-0a0201031d29",
                                "text": "Getooid met een valse baard vluchtte Fritz Haber, uitvinder van het mosterdgas (en Zyklon-B), na de oorlog naar Zwitserland, bang dat hij zou worden berecht als oorlogsmisdadiger. In plaats daarvan kreeg hij in 1919 de Nobelprijs voor de scheikunde, tot grote woede van de academische wereld."
                            },
                            {
                                "example_id": "ee980e29-9afd-4d4f-9df5-f00e379fba76",
                                "sense_id": "b115849f-8523-337e-b177-0a0201031d29",
                                "text": "De Nobelprijzen worden komende week toegekend. Mogelijke winnaars zouden dit jaar veelal jong, vrouw en niet-Europees zijn."
                            },
                            {
                                "example_id": "3d7009a1-035e-4e11-b8e0-191f3efc68ea",
                                "sense_id": "b115849f-8523-337e-b177-0a0201031d29",
                                "text": "De Nobelprijs voor Economie gaat dit jaar naar de Turks-Amerikaanse Daron Acemoglu, de Brits-Amerikaanse Simon Johnson en de Brit James A. Robinson. Ze krijgen de prijs voor hun onderzoek naar hoe het verschil in welvaart tussen landen ontstaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f3bcc69-e43a-4773-817e-d9e762193966",
                        "source_entry_id": "46c065dc-1f76-3e37-8342-1a1fde5b4e88",
                        "source_sense_id": "b115849f-8523-337e-b177-0a0201031d29",
                        "source_sense_description": "een jaarlijkse geldprijs voor wetenschappers en anderen die een opmerkelijke prestatie hebben geleverd",
                        "target_lang_word": "Nobelpreis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nobelpreis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "381f4606-6f0d-36b0-a4c8-637af6dc26be",
                                        "entry_id": "152095d0-2a72-3be0-87a1-60d698d3809a",
                                        "glosses": [
                                            "ein für bedeutende wissenschaftliche und literarische Leistungen sowie Verdienste um den Weltfrieden gestifteter Preis des schwedischen Chemikers und Industriellen Alfred Nobel ^(→ WP)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b351ca16-4fe4-4154-8543-d8b2dca56905",
                                                "sense_id": "381f4606-6f0d-36b0-a4c8-637af6dc26be",
                                                "text": "Deutsche Wissenschaftler haben schon viele Nobelpreise erhalten."
                                            },
                                            {
                                                "example_id": "301626bd-bece-427d-9aa7-5279e1cb8b2f",
                                                "sense_id": "381f4606-6f0d-36b0-a4c8-637af6dc26be",
                                                "text": "„Für Hiroshima wurden keine Nobelpreise verliehen, aber die theoretischen Entdeckungen, die man damit auszeichnete, hatten den Weg nach Hiroshima gebahnt.“"
                                            },
                                            {
                                                "example_id": "93649062-00dd-4d6a-a7ac-ddb6f92b902f",
                                                "sense_id": "381f4606-6f0d-36b0-a4c8-637af6dc26be",
                                                "text": "„Dazwischen wird - wie jedes Jahr - der Nobelpreis für Literatur bekannt gegeben, und zu meinem Schreck bekommt den ausgerechnet dieses Jahr Elfriede Jelinek.“"
                                            },
                                            {
                                                "example_id": "cf4e7832-5ce0-46ae-accd-575d02da47eb",
                                                "sense_id": "381f4606-6f0d-36b0-a4c8-637af6dc26be",
                                                "text": "„Der Nobelpreis für Literatur verhilft einem Autor häufig erstmals zu einem materiell sorgenfreien Leben.“"
                                            },
                                            {
                                                "example_id": "aebc9ac6-5f1b-4f0a-b389-a482273b5867",
                                                "sense_id": "381f4606-6f0d-36b0-a4c8-637af6dc26be",
                                                "text": "„Als Einstein 1921 den Nobelpreis erhielt, überschrieb er die damit verbundene Geldsumme an Mileva.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
