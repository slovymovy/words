                "senses": [
                    {
                        "sense_id": "f2b1e598-bc3f-38ef-a764-2c3ec2ae2b29",
                        "entry_id": "0afe0354-b812-38dc-bc26-ece649012486",
                        "glosses": [
                            "Empfindung von Mensch und höheren Tieren bei der Nahrungsaufnahme über den Mund beziehungsweise das Maul bei Kunststoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf9bf6d-3f43-4eca-86ee-835a473c3eb1",
                                "sense_id": "f2b1e598-bc3f-38ef-a764-2c3ec2ae2b29",
                                "text": "„So erkläre ich mir den komischen Kunststoffgeschmack, den ich auch schon lange vorher bemerkte, aber nicht so stark.“"
                            },
                            {
                                "example_id": "4ce25257-6c43-41fd-a2ac-875bfd069583",
                                "sense_id": "f2b1e598-bc3f-38ef-a764-2c3ec2ae2b29",
                                "text": "„Um diesen Kunststoffgeschmack und -geruch zu beseitigen empfehlen wir, Ihren Wasserbeutel nach jeder Verwendung gut zu waschen.“"
                            },
                            {
                                "example_id": "8c45447a-a771-4499-bd24-b9ce8986049d",
                                "sense_id": "f2b1e598-bc3f-38ef-a764-2c3ec2ae2b29",
                                "text": "„Das gekochte Wasser hatte keinerlei Chemie- oder Kunststoffgeschmack – was man bei einem Premium-Produkt dieser Klasse auch erwarten darf.“"
                            },
                            {
                                "example_id": "81d324f9-70fa-4d38-9d75-a62f3603fc99",
                                "sense_id": "f2b1e598-bc3f-38ef-a764-2c3ec2ae2b29",
                                "text": "„Dran hat sich die Wahrnehmung der Weintrinker aber gewöhnt und Kunststoffgeschmack liegt den Noten im Wein normalerweise recht fern.“"
                            },
                            {
                                "example_id": "765218f5-1d0f-4573-90ed-5dc13f480e49",
                                "sense_id": "f2b1e598-bc3f-38ef-a764-2c3ec2ae2b29",
                                "text": "„Bei einem neuen Kunststoff Trinksystem kann es passieren, dass die Flüssigkeit leicht den Kunststoffgeschmack abgibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
