                                "target_senses": [
                                    {
                                        "sense_id": "1b2f0c24-91bd-3bbe-836c-469c1e646377",
                                        "entry_id": "594b03cb-d276-3925-9986-7fcbc52b1ed4",
                                        "glosses": [
