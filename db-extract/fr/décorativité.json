                        "examples": [
                            {
                                "example_id": "2fa843b3-a274-420c-ac62-3a1008923531",
                                "sense_id": "b7f8ed58-c7e5-3c0a-be9f-1a675c941139",
                                "text": "De cette manière, toute la composition est arrangée dans une unité soit délicatement artistique, soit, grâce aux contrastes accentués, d'une décorativité attractive et tendue."
                            },
                            {
                                "example_id": "9a51c874-919d-4b19-a9a9-39b33881cd1d",
                                "sense_id": "b7f8ed58-c7e5-3c0a-be9f-1a675c941139",
                                "text": "Il y a lieu de parler de la question de la décorativité concernant l’art de Matisse et de Hantaï, puisque en observant les découpés et les pliages leur qualité décorative dominante devenait manifeste."
                            }
                        ]
                    }
