                "senses": [
                    {
                        "sense_id": "e8b4648e-52c4-39a6-b461-04f9781d0c1f",
                        "entry_id": "2b7a75ef-b814-3716-aa83-a342dcbef111",
                        "glosses": [
                            "Incinérer quelque chose en même temps que ce qu’on incinère normalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a331da2d-61c2-4c28-ae57-386a00d43f99",
                                "sense_id": "e8b4648e-52c4-39a6-b461-04f9781d0c1f",
                                "text": "La société HOLCIM France Sa est autorisée à poursuivre l'exploitation de sacimenterie située sur la commune de LUMBRES et autorisée par errêté préfectoral complémentaire du 13/04/2000 à coincinérer des déchets industriels spéciaux, sous réserve des dispositions du présent arrêté préfectoral."
                            },
                            {
                                "example_id": "cb4e0ed5-afc9-4eba-9282-2328efa0d8f4",
                                "sense_id": "e8b4648e-52c4-39a6-b461-04f9781d0c1f",
                                "text": "Cette utilisation des farines en cimenterie ne peut cependant se faire que si l'installation est titulaire d'une autorisation administrative pour coincinérer des déchets."
                            },
                            {
                                "example_id": "40f3fff0-57ba-4482-8364-704733b57c54",
                                "sense_id": "e8b4648e-52c4-39a6-b461-04f9781d0c1f",
                                "text": "Procédé selon l'une quelconque des revendications précédentes caractérisé en ce que le combustible liquide est chargé d'un déchet à coincinérer."
                            }
                        ]
                    }
