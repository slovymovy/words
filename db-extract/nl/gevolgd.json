                        "glosses": [
                            "achter iets of iemand aangegaan zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52e2f21-a19a-4e4c-9150-407f7db34f7b",
                                "sense_id": "48c64c00-a844-3d05-9192-20d36ff9d0da",
                                "text": "Een op de zes deelnemers aan de Zevenheuvelenloop komt oververhit over de eindstreep. Van 227 gevolgde deelnemers aan deze Nijmeegse hardloopwedstrijd over 15 kilometer hadden er 31 een lichaamstemperatuur van boven de 40 graden Celsius toen zij finishten."
                            }
                        ]
                    }
