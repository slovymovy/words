                    "frequency": "High",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les paysans ont choisi cette vallée parce que la terre y est exceptionnellement <w>fertile</w>."
                        },
                        {
                            "text": "Un sol <w>fertile</w> permet de cultiver de nombreux légumes sans utiliser d'engrais chimiques."
                        }
                    ],
                    "synonyms": [
