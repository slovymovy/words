                        "glosses": [
                            "Femelle de l’éléphantidé du genre Mammuthus dont l’espèce a disparu et qu’on retrouve à l’état fossile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c3ed73-a6cb-454a-94fb-3cdf684d799d",
                                "sense_id": "89c99244-3254-3db7-a9c0-c1539d798ac9",
                                "text": "Ah, et le mammouth a une mammouthesse. Et une mammoutheaude."
                            }
                        ]
                    },
                    {
                        "sense_id": "6597e25b-332f-3b05-bb52-adb3ed3c4f81",
                        "entry_id": "92c503b8-5b93-3500-94d8-dccc07d19dc6",
                        "glosses": [
                            "Femme imposante."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1a26b57b-7868-4b2b-9239-4e1df3ed5349",
                                "sense_id": "6597e25b-332f-3b05-bb52-adb3ed3c4f81",
                                "text": "On ne remplace pas une fille comme Blanche ! J’ai engagé à sa place une espèce de truie, une orque en chaleur, une mammouthesse dégoulinante !"
                            },
                            {
                                "example_id": "ea4ee169-5421-49e1-a587-b942700b899c",
                                "sense_id": "6597e25b-332f-3b05-bb52-adb3ed3c4f81",
                                "text": "La Mammouthesse écarte le nuage de vapeur qui l’enrobe et me virgule un sourire épais comme de la gelée de groseille."
                            }
                        ]
                    }
