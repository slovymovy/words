                                    {
                                        "sense_id": "e486c626-4dbd-3b0c-8fe3-061ef2d4a130",
                                        "entry_id": "c2d71cbf-6b73-3913-abc1-c8bd5fc56e9a",
                                        "glosses": [
                                            "nach Art von Modulen (komplexen Bausteinen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d40f3cd-105c-444a-9378-738239bcf45f",
                                                "sense_id": "e486c626-4dbd-3b0c-8fe3-061ef2d4a130",
                                                "text": "„Durch die Ausbildung der Anzeigeeinheit als modularer Baustein besteht die Möglichkeit, für die unterschiedlichsten Anwendungsfälle, z. B. als Namensschild für eine Klingel oder als Hausnummer, die Lichtleitkörper in den baulichen Abmessungen an diese Einsatzfälle anzupassen und somit einen hohen Vorfertigungsgrad und einen universellen Einsatz abzusichern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6fa6014-c12d-3bd2-aa54-0fdea9ea6df9",
                                        "entry_id": "c2d71cbf-6b73-3913-abc1-c8bd5fc56e9a",
                                        "glosses": [
                                            "aus Modulen aufgebaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2d4dfc1-8db6-40f2-9a02-97ee7d95fddc",
                                                "sense_id": "c6fa6014-c12d-3bd2-aa54-0fdea9ea6df9",
                                                "text": "Die neuen Studiengänge sind modular strukturiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57755b1c-9927-49ac-9289-eec785395d66",
                        "source_entry_id": "c2960a34-ee4d-3e8b-9646-1e1934d28862",
                        "target_lang_word": "modular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
