                                    {
                                        "sense_id": "b1418589-1e50-38b8-b44e-c1d60428f342",
                                        "entry_id": "ac763cc1-0f37-3148-8ee6-031c1735855a",
                                        "glosses": [
                                            "植物细胞叶绿体中的一种红橙色色素。最早从胡萝卜中提取而得名。能吸收蓝紫光，传递给叶绿素a进行光合作用。也存在于奶油和蛋黄中。"
                                        ],
