                    {
                        "form_id": "ade4696c-4f7e-4c97-a29b-577293f6a362",
                        "entry_id": "667641b9-ae89-36f6-86ed-7cf04726b4e7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Legionäre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dddd632a-d942-3284-a7cb-274c1e525728",
                        "entry_id": "667641b9-ae89-36f6-86ed-7cf04726b4e7",
                        "glosses": [
                            "Mitglied einer römischen Legion"
                        ],
                        "tags": [
                            "römische Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "7d2168c5-3d3d-4164-8f37-91140bbc4457",
                                "sense_id": "dddd632a-d942-3284-a7cb-274c1e525728",
                                "text": "„Selbst der Steinbruch in der Eifel ist bekannt, aus dem der Mühlstein stammt, mit dem Legionäre in Hedemünden ihr Getreide mahlten.“"
                            },
                            {
                                "example_id": "c1bb0518-b2c9-4ab4-aefa-0eed2e85c7ca",
                                "sense_id": "dddd632a-d942-3284-a7cb-274c1e525728",
                                "text": "„Seine beiden Söhne Flavus und Arminius hatten als Legionäre Kriegsdienst geleistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e28fc9ea-9cfa-3573-a805-149a253c7fb3",
                        "entry_id": "667641b9-ae89-36f6-86ed-7cf04726b4e7",
                        "glosses": [
                            "Soldat eines Söldnerheeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e3b4b2-4772-47ec-a8e3-12e17d219228",
                                "sense_id": "e28fc9ea-9cfa-3573-a805-149a253c7fb3",
                                "text": "Die Legionäre wurden sehr gut besoldet."
                            },
                            {
                                "example_id": "fd783b9e-7c29-4492-b267-c0822db93b83",
                                "sense_id": "e28fc9ea-9cfa-3573-a805-149a253c7fb3",
                                "text": "„Der Legionär mit den vielen Medaillen drang bei mir ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "782a39c8-bd57-3af2-8b4b-d7c4596297e2",
                        "entry_id": "667641b9-ae89-36f6-86ed-7cf04726b4e7",
                        "glosses": [
                            "jemand, der als Spieler im Ausland tätig wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbc8f87-5079-4bb0-8ec7-266797382e2a",
                                "sense_id": "782a39c8-bd57-3af2-8b4b-d7c4596297e2",
                                "text": "Er spielte lange in England Fußball, aber nun hat es ihn als Legionär nach Italien verschlagen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
