                                    {
                                        "sense_id": "68af582b-b2ed-33e8-8b8b-717275e773e4",
                                        "entry_id": "71bee34e-28e8-3636-a83f-c1fedc58b146",
                                        "glosses": [
                                            "Wide open."
                                        ],
