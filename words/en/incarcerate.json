{
    "word_family": [
        "incarceration",
        "incarcerator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "573e8fdc-07cc-3337-b9c1-1fa7e37d7532",
                    "sense_definition": "To put someone in prison or jail, usually as a punishment for a crime.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>incarcerate</w> the defendant for five years.",
                            "target_lang_translations": {
                                "cs": "Soudce se rozhodl <w>uvěznit</w> obžalovaného na pět let."
                            }
                        },
                        {
                            "text": "Many people are <w>incarcerated</w> for non-violent offenses in the current system.",
                            "target_lang_translations": {
                                "cs": "Mnoho lidí je v současném systému <w>uvězněno</w> za nenásilné trestné činy."
                            }
                        }
                    ],
                    "synonyms": [
                        "imprison",
                        "jail"
                    ],
                    "common_phrases": [
                        "wrongfully incarcerate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Uvěznit někoho, obvykle jako trest za spáchaný zločin."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uvěznit",
                                "target_lang_sense_clarification": "obecný výraz pro poslání do vězení"
                            },
                            {
                                "target_lang_word": "zavřít do vězení",
                                "target_lang_sense_clarification": "popisný výraz pro omezení svobody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb8301b7-a594-3c2c-af18-6f15ebeaa389",
                    "sense_definition": "To restrict someone or something within a confined space or area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bird was <w>incarcerated</w> in a tiny cage for most of its life.",
                            "target_lang_translations": {
                                "cs": "Ten malý ptáček byl většinu svého života <w>uvězněn</w> v malé kleci."
                            }
                        },
                        {
                            "text": "He felt <w>incarcerated</w> by the high walls of the old stone garden.",
                            "target_lang_translations": {
                                "cs": "Cítil se <w>uvězněn</w> vysokými zdmi staré kamenné zahrady."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Omezit někoho nebo něco v uzavřeném prostoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uvěznit",
                                "target_lang_sense_clarification": "v přeneseném smyslu pro uzavření v prostoru"
                            },
                            {
                                "target_lang_word": "uzavřít",
                                "target_lang_sense_clarification": "omezení pohybu v prostoru"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33e9ae67-65a7-3ab3-875a-a32238d66e1f",
                    "sense_definition": "Being kept in a prison or a confined space.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>incarcerate</w> man spent his days reading in the library.",
                            "target_lang_translations": {
                                "cs": "<w>Vězněný</w> muž trávil své dny čtením v knihovně."
                            }
                        },
                        {
                            "text": "The <w>incarcerate</w> soul longed for the freedom of the open fields.",
                            "target_lang_translations": {
                                "cs": "<w>Uvězněná</w> duše toužila po svobodě otevřených polí."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adjective form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav, kdy je někdo držen ve vězení nebo v uzavřeném prostoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vězněný",
                                "target_lang_sense_clarification": "osoba, která je držena v zajetí"
                            },
                            {
                                "target_lang_word": "uvězněný",
                                "target_lang_sense_clarification": "stav omezení svobody"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}