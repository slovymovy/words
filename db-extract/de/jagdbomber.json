                "senses": [
                    {
                        "sense_id": "4f44b27c-7e14-3064-810e-000905f60668",
                        "entry_id": "49f605b8-7ef4-3247-a007-20ee52fab179",
                        "glosses": [
                            "Kampfflugzeug, welches sowohl Luft- als auch Bodenziele wirksam bekämpfen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c533220-ccb3-43a4-aef1-356596a23c5c",
                                "sense_id": "4f44b27c-7e14-3064-810e-000905f60668",
                                "text": "Die Entwicklung von Jagdbombern ist eine logische Konsequenz aus der Verringerung der Stärke der Luftstreitkräfte, ohne gleichzeitig auch deren Aufgaben einzuschränken."
                            },
                            {
                                "example_id": "c4ed645c-880d-4e5d-9129-c353c1a90c3a",
                                "sense_id": "4f44b27c-7e14-3064-810e-000905f60668",
                                "text": "„Sie enthielt sechs engbeschriebene Listen sowie neue Konstruktionspläne von schweren Panzern, Flammenwerfern und einem Jagdbomber.“"
                            },
                            {
                                "example_id": "ebe87a4a-bb3d-426d-bc68-65e0626ccc72",
                                "sense_id": "4f44b27c-7e14-3064-810e-000905f60668",
                                "text": "„Schlechtes Wetter gibt uns Schutz vor feidlichen Jagdbombern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39da60e9-b735-4bd0-9c07-3c1caac89f43",
