                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minirok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4d31a5-1e5f-3551-b4e8-dfe4274e70fb",
                                        "entry_id": "d2daf357-d1de-3b74-bf54-1d71adb74c8c",
                                        "glosses": [
                                            "zeer kort rokje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cfa7814-961d-4515-a8a7-57a5db23eb34",
                                                "sense_id": "ac4d31a5-1e5f-3551-b4e8-dfe4274e70fb",
                                                "text": "De Saudische vrouw die door de Saudische politie opgepakt werd na een filmpje waarin ze onder meer met een minirok gespot werd, is opnieuw vrij."
                                            },
                                            {
                                                "example_id": "542fa59b-58c1-419e-85ce-1ad02e6ba843",
                                                "sense_id": "ac4d31a5-1e5f-3551-b4e8-dfe4274e70fb",
                                                "text": "Je moeder die gekleed gaat in een minirok, of je opa die door de huiskamer danst op de hits van dj Martin Garrix. Je bent zo oud als dat je jezelf voelt, wordt er wel eens gezegd. Hoor jij wel thuis in jouw generatie? Ofwel, wat is je ware leeftijd? Doe de test!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfcbcf93-9841-4384-8798-e02082882cd7",
                        "source_entry_id": "b746984d-1a85-37b8-9c58-d90747bc9675",
                        "source_sense_id": "97c6e116-5863-3abb-8216-b63538c42af3",
