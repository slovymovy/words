                "senses": [
                    {
                        "sense_id": "20f01aee-3f66-38ae-a7e6-3b37a1399fb5",
                        "entry_id": "3b6349d3-07a8-3207-b0f5-1bc17d4238c3",
                        "glosses": [
                            "Schuh, der für einen Notfall in Reserve gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b49051-ebc6-49de-b363-f750561e9807",
                                "sense_id": "20f01aee-3f66-38ae-a7e6-3b37a1399fb5",
                                "text": "„Die Soldaten tragen Socken und Unterhosen im Tornister, vielleicht auch noch ein paar Reserveschuhe.“"
                            },
                            {
                                "example_id": "f4d4a8c2-ee12-4e19-a819-5a5082ecebff",
                                "sense_id": "20f01aee-3f66-38ae-a7e6-3b37a1399fb5",
                                "text": "„Auf den Tornister wurde eine Stoffbeutel zur Aufbewahrung von Reserveschuhen sowie das 1852 eingeführte Kochgeschirr getragen.“"
                            },
                            {
                                "example_id": "66d67f0a-491a-46d7-ab00-03df175ac6a6",
                                "sense_id": "20f01aee-3f66-38ae-a7e6-3b37a1399fb5",
                                "text": "„Zum damaligen Zeitpunkt wurde auf dem Tornister ein Stoffbeutel zur Aufbewahrung von Reserveschuhen sowie das 1852 eingeführte Kochgeschirr getragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
