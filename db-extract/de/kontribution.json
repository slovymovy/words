                "senses": [
                    {
                        "sense_id": "dabe8dce-6d6a-3119-b579-381d47765b7b",
                        "entry_id": "556402b9-f508-3013-b2c9-fb10e38f56c5",
                        "glosses": [
                            "einem Land oder seiner Bevölkerung auferlegte Geld- oder Sachforderung während der Besetzung; gemäß Genfer Konventionen heute völkerrechtswidrig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35870808-1308-43a2-80ab-3902fdf05f70",
                                "sense_id": "dabe8dce-6d6a-3119-b579-381d47765b7b",
                                "text": "„Ein einheimischer Dolmetscher hatte über jene Zeit minuziös Tagebuch geführt und darin allerlei über Saeveckes Rolle bei der Rekrutierung jüdischer Zwangsarbeiter und der Eintreibung der Kontribution festgehalten.“"
                            },
                            {
                                "example_id": "b79babd0-738b-4ebc-ae78-d9fc98287948",
                                "sense_id": "dabe8dce-6d6a-3119-b579-381d47765b7b",
                                "text": "„Aber doch zog man in den Folgejahren lange hin und her, bezog Quartiere und räumte sie wieder, plünderte und erhob willkürlich Kontributionen, um den murrenden Truppen etwas Sold zahlen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b323024c-1c33-3acc-a056-e9c1e8b3cbb8",
                        "entry_id": "556402b9-f508-3013-b2c9-fb10e38f56c5",
                        "glosses": [
                            "in der Neuzeit vom Fürsten eines Landes erhobene Sondersteuer, insbesondere zur Finanzierung des Militärs"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "47a52e59-ac76-4196-91a6-102c228a930a",
                                "sense_id": "b323024c-1c33-3acc-a056-e9c1e8b3cbb8",
                                "text": "„Die Kontribution, welche fortan eine neue regelmäßige Steuer als Grundlage für die Heeresausgaben bildete, wurde kreisweise auf die Kurmark verteilt und durch die ständischen Organe der sich jetzt bildenden Kreisverwaltungen erhoben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
