                    {
                        "sense_id": "d3aab4f3-f13a-342a-9c0d-2447377507cd",
                        "entry_id": "d0077062-1233-3577-95bd-7c4516deaec1",
                        "glosses": [
                            "Gesamtheit der Gesetze und juristischen Bestimmungen, die zur Zeit der DDR gültig waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb95636-de0c-4843-9ea6-9ae63c3be745",
                                "sense_id": "d3aab4f3-f13a-342a-9c0d-2447377507cd",
                                "text": "„Gemäß DDR-Recht wäre die Tat eigentlich nach 25 Jahren verjährt, also im Jahr 1999.“"
                            },
                            {
                                "example_id": "5b71fd74-16f6-42fd-999b-2f2f6e92b385",
                                "sense_id": "d3aab4f3-f13a-342a-9c0d-2447377507cd",
                                "text": "„Aber es gibt auch andere Gründe, warum Verhandlungen kurzerhand ausfallen. Mal fehlen die beiden Schöffen, die nach DDR-Recht dem Berufsrichter assistieren müssen - die Laien fürchten um ihre Arbeitsplätze, wenn sie sich für die Gerichtstermine freinehmen.“"
                            }
                        ],
