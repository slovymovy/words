                        "examples": [
                            {
                                "example_id": "5648431a-c94d-4940-b083-efed86d95452",
                                "sense_id": "c2166e9a-8283-36c0-bc9f-9b132e17817b",
                                "text": "Dans la journée elle fait la manche. Le soir elle chourave des larfeuils dans les boîtes de nuit. Les temps sont durs."
                            },
                            {
                                "example_id": "124f8d91-3fa8-4753-a95d-e65b1aedcc03",
                                "sense_id": "c2166e9a-8283-36c0-bc9f-9b132e17817b",
                                "text": "Le facétieux bonhomme peut se réjouir, il vient d’alourdir son larfeuil de quinze à vingt euros."
                            },
                            {
                                "example_id": "9000df7d-fad9-46fa-91c9-8f97865e4c7b",
                                "sense_id": "c2166e9a-8283-36c0-bc9f-9b132e17817b",
                                "text": "Alors il se tire pour aller passer une journée aux courses ; le larfeuil plein dans la poche ; deux ou trois mille livres il avait."
                            }
                        ]
                    }
