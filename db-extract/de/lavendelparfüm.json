                "senses": [
                    {
                        "sense_id": "8b41823c-470a-3572-9002-66863c05047b",
                        "entry_id": "1a1a9aea-eb7e-384a-81d3-067fa256143d",
                        "glosses": [
                            "Parfüm mit dem Duftstoff des Lavendels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab758be6-e890-413e-986b-3731a6ea68b5",
                                "sense_id": "8b41823c-470a-3572-9002-66863c05047b",
                                "text": "„Er roch das Lavendelparfüm, das von ihrem Halsbündchen und den Ärmeln ihrer gehäkelten Jacke ausging und sich mit dem strengen Geruch des Torfs vermischte, in dem sie ihre Pflanzen zog.“"
                            },
                            {
                                "example_id": "11fb8d7b-ef1a-4c70-9d18-31324e057829",
                                "sense_id": "8b41823c-470a-3572-9002-66863c05047b",
                                "text": "„Schließlich erschien sie wieder und duftete nach frisch aufgetragenem Lavendelparfüm.“"
                            },
                            {
                                "example_id": "935d0f91-319d-4da6-8ced-65e00b39027f",
                                "sense_id": "8b41823c-470a-3572-9002-66863c05047b",
                                "text": "„Anstatt einer Person in der sich öffnenden Hotelzimmertür erschien die ihm wohlbekannte Geisterdame aus dem Zug in seinem Zimmer, bewegte sich durch die Möbel hindurch, umschwebt von einer Wolke Lavendelparfüm.“"
                            },
                            {
                                "example_id": "aa77450e-5623-44a1-927d-ed0fe332ab15",
                                "sense_id": "8b41823c-470a-3572-9002-66863c05047b",
                                "text": "„Ich kann den leichten Duft von Lavendelparfüm auf ihrer dunklen Haut wahrnehmen und frage mich, seit wann sie es benutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
