                "senses": [
                    {
                        "sense_id": "fb5b0592-b6a6-38d4-8803-e13ed3812d77",
                        "entry_id": "82981f0f-2e9b-3a56-9de9-94deac7208f3",
                        "glosses": [
                            "andauernde Streitigkeit/Uneinigkeit unter Ehepartnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39e63410-4c5c-4955-83e1-fc5459a0bf18",
                                "sense_id": "fb5b0592-b6a6-38d4-8803-e13ed3812d77",
                                "text": "„Ein intimer Ehezwist vor den Augen von zehn Millionen Fernsehfreunden wird durch ebenso viele Ferngespräche schon kurz nach der Sendung geschlichtet, eine fristlose Entlassung auf dem gleichen Wege rückgängig gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b384651-c490-406e-8198-4e7412c489ee",
                        "source_entry_id": "82981f0f-2e9b-3a56-9de9-94deac7208f3",
                        "source_sense_id": "fb5b0592-b6a6-38d4-8803-e13ed3812d77",
                        "source_sense_description": "andauernde Streitigkeit/Uneinigkeit unter Ehepartnern",
                        "target_lang_word": "scène de ménage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scène de ménage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1482361e-9b28-34c3-affa-3dc28bc932ca",
                                        "entry_id": "5235cc3d-5fe1-38bb-aa09-df77c210e241",
                                        "glosses": [
                                            "Vive querelle entre conjoints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be284eaf-3031-431a-ab92-e31e67835055",
                                                "sense_id": "1482361e-9b28-34c3-affa-3dc28bc932ca",
                                                "text": "Depuis quelques temps, Stéphanie et Victor se querellent souvent ; leurs enfants assistent fréquemment, impuissants, à leurs scènes de ménage."
                                            },
                                            {
                                                "example_id": "28c7000b-c7d9-4cd5-a96c-b83cf2de3337",
                                                "sense_id": "1482361e-9b28-34c3-affa-3dc28bc932ca",
                                                "text": "On avait l'impression gênante de tomber dans une scène de ménage et c'était cela, en somme, à un seul personnage, mais en plus hallucinant."
                                            },
                                            {
                                                "example_id": "1eb722be-a127-4ca1-aef4-773feca533d7",
                                                "sense_id": "1482361e-9b28-34c3-affa-3dc28bc932ca",
                                                "text": "Les larmes lui viennent aux yeux à chaque réponse un peu sèche de Paul, et elle sait que ce signe de chagrin, d’irritation aussi, est l’équivalent pour elle de ce que serait pour une autre femme une scène de ménage."
                                            },
                                            {
                                                "example_id": "c70912db-c177-49c3-ab41-0d615be90aaf",
                                                "sense_id": "1482361e-9b28-34c3-affa-3dc28bc932ca",
                                                "text": "Gilbert (Didier Bénureau) et Catherine (Fanny Cottençon) intégreront la galerie de personnages principaux de Scènes de ménage, dès ce lundi à 20 h 30 sur M6."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f2b398-cfc9-3939-941c-880c0304efa5",
                                        "entry_id": "5235cc3d-5fe1-38bb-aa09-df77c210e241",
                                        "glosses": [
                                            "Dispute entre deux personnes ou deux groupes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b9a140b-8cd3-4122-9ff7-0a1a6586c37b",
                                                "sense_id": "00f2b398-cfc9-3939-941c-880c0304efa5",
                                                "text": "Trop d’intérêts réciproques, à commencer par l’intérêt national, trop d’actions complémentaires entre Paris et les territoires, trop de liens et de dépendances financières l’interdisent. Mais cela n’empêche pas, bien au contraire, les scènes de ménage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
