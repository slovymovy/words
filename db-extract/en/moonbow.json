    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0e7fca27-9969-35bc-9d2e-3bdfda8338f7",
                "word": "moonbow",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5c02805a-b244-4633-86db-6b4aa3ab102a",
                        "entry_id": "0e7fca27-9969-35bc-9d2e-3bdfda8338f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "moonbows"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd6235d0-e5d8-3400-bc12-6a8a7099f434",
                        "entry_id": "0e7fca27-9969-35bc-9d2e-3bdfda8338f7",
                        "glosses": [
                            "A rainbow formed by moonlight diffracted by water droplets in the air, usually fainter than a daytime rainbow and with fewer distinguishable colours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c4d386-35a2-484d-a4ec-42316e3bd7de",
                                "sense_id": "bd6235d0-e5d8-3400-bc12-6a8a7099f434",
                                "text": "Often rainbows by night or moonbows span the lake."
                            },
                            {
                                "example_id": "2fda93dd-73a6-4bc9-b8e7-bf9fd23cd93e",
                                "sense_id": "bd6235d0-e5d8-3400-bc12-6a8a7099f434",
                                "text": "Among the rarer optical effects associated with the moon are also moonbows or lunar rainbows."
                            },
                            {
                                "example_id": "3d5c8a86-4b69-4e01-9d46-bf007075b004",
                                "sense_id": "bd6235d0-e5d8-3400-bc12-6a8a7099f434",
                                "text": "When the sun shines over Kentucky's Cumberland Falls, the mist creates a rainbow on most days. If the moon shines brightly enough, it can create a moonbow, too!"
                            }
                        ]
                    }
                ],
                "translations": [
