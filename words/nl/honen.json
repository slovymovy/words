                    "sense_id": "0a758ca0-aaab-3ed4-aab5-5ae927a8afe9",
                    "sense_definition": "Op een wrede of gemene manier de spot drijven met iemand of iets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet goed om iemands fouten openlijk te <w>honen</w>. ",
                            "target_lang_translations": {
                                "en": "It is not good to openly <w>mock</w> someone's mistakes."
                            }
                        },
                        {
                            "text": "De tegenstanders bleven de verliezers genadeloos <w>honen</w> na de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The opponents kept <w>jeering at</w> the losers mercilessly after the match."
