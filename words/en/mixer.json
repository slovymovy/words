{
    "word_family": [
        "mix",
        "mixture",
        "mixing",
        "mixed",
        "mixable",
        "admix",
        "intermix",
        "premix"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f45aaf91-b14c-36e6-8043-e1130634d671",
                    "sense_definition": "A kitchen appliance with blades used for combining or beating ingredients in a bowl.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used an electric <w>mixer</w> to whip the cream until it was thick.",
                            "target_lang_translations": {
                                "ru": "Она использовала электрический <w>миксер</w>, чтобы взбить сливки до густоты."
                            }
                        },
                        {
                            "text": "You should use a food <w>mixer</w> to ensure the cake batter is smooth.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать кухонный <w>миксер</w>, чтобы тесто для торта было однородным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric mixer",
                        "food mixer",
                        "hand mixer",
                        "stand mixer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кухонный прибор с насадками для смешивания или взбивания ингредиентов в чаше."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миксер",
                                "target_lang_sense_clarification": "кухонный прибор"
                            },
                            {
                                "target_lang_word": "блендер",
                                "target_lang_sense_clarification": "для измельчения и смешивания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "382d4b2f-2448-385a-a58f-a40772d21d4d",
                    "sense_definition": "A non-alcoholic drink, such as soda or juice, that is added to an alcoholic spirit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have plenty of gin, but we need to buy some <w>mixer</w> like tonic water.",
                            "target_lang_translations": {
                                "ru": "У нас полно джина, но нужно купить какой-нибудь <w>напиток</w> для разбавления, например, тоник."
                            }
                        },
                        {
                            "text": "I prefer to drink with a <w>mixer</w> because I do not like the taste of plain vodka.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю пить <w>с</w> <w>чем-то</w> <w>безалкогольным</w>, потому что мне не нравится вкус чистой водки."
                            }
                        }
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "drink with a mixer",
                        "tonic mixer",
                        "soda mixer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безалкогольный напиток (газировка или сок), который добавляют в крепкий алкоголь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напиток для разбавления",
                                "target_lang_sense_clarification": "безалкогольный компонент коктейля"
                            },
                            {
                                "target_lang_word": "миксер",
                                "target_lang_sense_clarification": "в контексте барной культуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01e439bc-b384-3cca-9d6b-d1ff7598ad0d",
                    "sense_definition": "A social event or party organized to help people meet and get to know each other.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university organized a social <w>mixer</w> for all the new international students.",
                            "target_lang_translations": {
                                "ru": "Университет организовал <w>вечеринку</w> <w>для</w> <w>знакомства</w> всех новых иностранных студентов."
                            }
                        },
                        {
                            "text": "I felt nervous about attending the <w>mixer</w> alone, but I met several interesting people.",
                            "target_lang_translations": {
                                "ru": "Я нервничал из-за того, что иду на <w>встречу</w> один, но познакомился с несколькими интересными людьми."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social mixer",
                        "student mixer",
                        "business mixer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественное мероприятие или вечеринка, организованная для знакомства людей друг с другом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечеринка для знакомств",
                                "target_lang_sense_clarification": "социальное мероприятие"
                            },
                            {
                                "target_lang_word": "миксер",
                                "target_lang_sense_clarification": "неформальная встреча"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e74e27fd-3cf5-33c7-8490-dc67fe6a3de4",
                    "sense_definition": "A tap or valve that combines hot and cold water to come out of a single spout.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bathroom has a modern <w>mixer</w> tap that makes it easy to set the temperature.",
                            "target_lang_translations": {
                                "ru": "В ванной установлен современный <w>смеситель</w>, который позволяет легко настроить температуру."
                            }
                        },
                        {
                            "text": "Our old shower had separate handles, but the new one uses a single <w>mixer</w>.",
                            "target_lang_translations": {
                                "ru": "В нашем старом душе были раздельные краны, а в новом используется один <w>смеситель</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mixer tap",
                        "shower mixer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сантехнический кран, смешивающий горячую и холодную воду в одном изливе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смеситель",
                                "target_lang_sense_clarification": "водопроводный кран"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "043b1643-b73e-3875-9a03-97e83d1457f5",
                    "sense_definition": "An electronic device used in audio production to combine and adjust different sound signals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound engineer adjusted the levels on the audio <w>mixer</w> during the live concert.",
                            "target_lang_translations": {
                                "ru": "Звукорежиссер настраивал уровни на <w>микшере</w> во время живого концерта."
                            }
                        },
                        {
                            "text": "He plugged his microphone and guitar into the <w>mixer</w> before starting the recording.",
                            "target_lang_translations": {
                                "ru": "Он подключил микрофон и гитару к <w>микшеру</w> перед началом записи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "audio mixer",
                        "sound mixer",
                        "digital mixer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное устройство для объединения и регулировки различных звуковых сигналов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "микшер",
                                "target_lang_sense_clarification": "звуковой пульт"
                            },
                            {
                                "target_lang_word": "микшерный пульт",
                                "target_lang_sense_clarification": "аудиооборудование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13190a51-80d1-31b4-a33f-06905f737e7f",
                    "sense_definition": "A person who interacts with others in a social setting, often described by how well they do so.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a good <w>mixer</w> who can start a conversation with anyone in the room.",
                            "target_lang_translations": {
                                "ru": "Он <w>общительный</w> <w>человек</w>, который может завести разговор с кем угодно в комнате."
                            }
                        },
                        {
                            "text": "Being a bad <w>mixer</w>, she often felt uncomfortable at large corporate parties.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>необщительной</w>, она часто чувствовала себя неловко на больших корпоративных вечеринках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good mixer",
                        "bad mixer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который определенным образом взаимодействует с окружающими в обществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общительный человек",
                                "target_lang_sense_clarification": "о том, кто легко сходится с людьми"
                            },
                            {
                                "target_lang_word": "душа компании",
                                "target_lang_sense_clarification": "хороший собеседник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0119546-f7e4-3704-8aaf-988c8ce5505e",
                    "sense_definition": "A dedicated fan of the British girl group Little Mix.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fandom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every <w>Mixer</w> in the stadium sang along to every word of the hit song.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>фанат</w> на стадионе подпевал каждому слову хита."
                            }
                        },
                        {
                            "text": "She has been a loyal <w>Mixer</w> since the band first appeared on television.",
                            "target_lang_translations": {
                                "ru": "Она остается преданной <w>поклонницей</w> группы с тех пор, как они впервые появились на телевидении."
                            }
                        }
                    ],
                    "synonyms": [
                        "Little Mixer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "fandom terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преданный фанат британской женской группы Little Mix."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миксер",
                                "target_lang_sense_clarification": "фанат группы Little Mix"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dc3c9795-34ff-37d7-8db5-2213b846cdcb",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family with the last name <w>Mixer</w> living on Oak Street.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике была указана семья с фамилией <w>Миксер</w>, проживающая на Оук-стрит."
                            }
                        },
                        {
                            "text": "Professor <w>Mixer</w> published several influential papers on historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Миксер</w> опубликовал несколько влиятельных работ по исторической лингвистике."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Миксер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}