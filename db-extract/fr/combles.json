                                                "sense_id": "aab4269d-e208-3745-b1e5-7efd627d7074",
                                                "text": "Eutychus […] fell down from the third loft."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afe8010-64c1-3588-8a99-8445be802f7d",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To propel high into the air."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f114a4-4a66-4a0e-a9bc-df923b560ce6",
                                                "sense_id": "6afe8010-64c1-3588-8a99-8445be802f7d",
                                                "text": "Marouane Chamakh then spurned a great chance to kill the game off when he ran onto Andrey Arshavin's lofted through ball but shanked his shot horribly across the face of goal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7361251-91e7-3ccd-85ab-c42c04423aa9",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To fly or travel through the air, as though propelled"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddea5da4-baa2-4176-b256-4daacc9406e2",
                                                "sense_id": "f7361251-91e7-3ccd-85ab-c42c04423aa9",
                                                "text": "When she saw houses lofting past her window, she ran to the child, who slept on a feather bed and she gathered the coverlet around them both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de6e54f6-954e-302a-b69b-1f16db24b419",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To throw the ball erroneously through the air instead of releasing it on the lane's surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a609939-73d2-3643-9b24-e3fb09695c7e",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To furnish with a loft space."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c21f2a1-8176-425a-9753-4c721bf4f271",
                                                "sense_id": "0a609939-73d2-3643-9b24-e3fb09695c7e",
                                                "text": "Two sisters, one under fifteen years of age, have lofted the house, so as to have a room for themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b84f67-1a31-32f5-8f5b-ee62f95be84b",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To raise (a bed) on tall supports so that the space beneath can be used for something else."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df0f56f-14ce-45be-a2e4-035b0c73cc01",
                                                "sense_id": "53b84f67-1a31-32f5-8f5b-ee62f95be84b",
                                                "text": "Lofting a bed is much harder work than it seems, and pulling a nail out with the back of a hammer is much simpler than using your own nails."
                                            }
                                        ]
                                    }
                                ]
                            },
