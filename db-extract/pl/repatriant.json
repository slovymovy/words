                "senses": [
                    {
                        "sense_id": "64206fd5-8eb7-34a3-a612-1e3dc7abe56c",
                        "entry_id": "025e1966-0162-3e22-8bbd-c14f7338acaa",
                        "glosses": [
                            "osoba powracająca zza granicy, gdzie przebywała niedobrowolnie"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "ccf994fb-557f-44d0-bf73-0ee6e564a6d5",
                                "sense_id": "64206fd5-8eb7-34a3-a612-1e3dc7abe56c",
                                "text": "Miasto nie miało pieniędzy na przyjęcie repatriantów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a916151b-45eb-37a0-9881-e33cacff3c7f",
                        "entry_id": "025e1966-0162-3e22-8bbd-c14f7338acaa",
                        "glosses": [
                            "osoba przesiedlona po II wojnie światowej z dawnych ziem polskich na wschodzie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2763e30-13ee-4134-8639-e65a743c7a7a",
                                "sense_id": "a916151b-45eb-37a0-9881-e33cacff3c7f",
                                "text": "Wypędzono Niemców, napłynęła fala repatriantów z dawnych kresów wschodnich, a tożsamość i mit śląskości wiązano przede wszystkim klasowo – z górnictwem i hutnictwem"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69529126-1f0d-4f1e-952e-bd8a02a31a19",
                        "source_entry_id": "025e1966-0162-3e22-8bbd-c14f7338acaa",
                        "source_sense_id": "64206fd5-8eb7-34a3-a612-1e3dc7abe56c",
                        "target_lang_word": "repatriate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repatriate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf7e140-78f1-37b7-9bdd-4df9918907c5",
                                        "entry_id": "aeb928ff-40f6-3eb0-8dc1-ed46ef86daa2",
                                        "glosses": [
                                            "A person who has returned to their country of origin or whose original citizenship has been restored."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "repatriate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "033ea07e-ec17-3c31-aba7-19e441c29792",
                                        "entry_id": "db540d32-2d41-35b7-825d-9a14cbf62aa4",
                                        "glosses": [
                                            "To restore (a person) to their own country."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92880efb-6a59-4beb-9990-16abae6f0658",
                                                "sense_id": "033ea07e-ec17-3c31-aba7-19e441c29792",
                                                "text": "Early in 1948, a rumor spread through camp that the Japanese prisoners of war were finally going to be allowed to go home, that a ship would be sent to repatriate us in the spring."
                                            },
                                            {
                                                "example_id": "80ddfb3d-6a58-4c4e-a1f4-2a7f600fa822",
                                                "sense_id": "033ea07e-ec17-3c31-aba7-19e441c29792",
                                                "text": "A woman staying with us came down with cholera. This person had evacuated with her family from Haerbin, which was under Communist control, thinking that it would be easier to repatriate from Changchun than northern Haerbin.",
                                                "translation": "Japanese Girl at the Siege of Changchun: How I Survived China's Wartime Atrocity",
                                                "english": "Japanese Girl at the Siege of Changchun: How I Survived China's Wartime Atrocity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbe73ac6-6d77-3499-bdfe-8388e3c68e96",
                                        "entry_id": "db540d32-2d41-35b7-825d-9a14cbf62aa4",
                                        "glosses": [
                                            "To return or restore (artworks, museum exhibits, etc.) to their country of origin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28abe6ae-cbdd-409d-b2aa-7e4c430adf82",
                                                "sense_id": "fbe73ac6-6d77-3499-bdfe-8388e3c68e96",
                                                "text": "Greece repatriated an Athenian frieze from France, arranging for it to be sent back to Athens."
                                            },
                                            {
                                                "example_id": "e1cf3dad-334e-445a-a0b7-9d5f5b5cdf4c",
                                                "sense_id": "fbe73ac6-6d77-3499-bdfe-8388e3c68e96",
                                                "text": "France repatriated an Athenian frieze back to Greece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "358e17f3-6d2e-3766-abea-43bf62be1f9b",
                                        "entry_id": "db540d32-2d41-35b7-825d-9a14cbf62aa4",
                                        "glosses": [
                                            "To convert a foreign currency into the currency of one's own country."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
