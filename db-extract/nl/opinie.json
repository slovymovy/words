                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f02c4ce-8f6f-4ad5-9533-1184525fc541",
                                "sense_id": "405881eb-5bdf-3b74-9ba8-efb3bf828991",
                                "text": "Uw opinie telt ook!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c399d330-e7a3-4f7e-a196-064a5a79f675",
                        "source_entry_id": "81a64b86-8896-317d-ac20-6e02dd432b45",
                        "source_sense_id": "405881eb-5bdf-3b74-9ba8-efb3bf828991",
                        "source_sense_description": "een mening of oordeel",
                        "target_lang_word": "Meinung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meinung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                        "entry_id": "e5926223-89a5-316c-99ee-2470958b5582",
                                        "glosses": [
                                            "der selbst gebildete Standpunkt eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac24f9b-e9f8-4d29-b225-6f1b04c4d5ea",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Theodor vertritt seine Meinung ziemlich hart."
                                            },
                                            {
                                                "example_id": "0e8e6f77-1d7c-48ee-b23c-6b5998bfce79",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Ich würde mir an deiner Stelle eine eigene Meinung verschaffen, anstatt mich auf Andere zu verlassen."
                                            },
                                            {
                                                "example_id": "9f5b9e11-5f52-4972-a7e7-0b9dbbf6aa79",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Bist du nicht der gleichen Meinung?"
                                            },
                                            {
                                                "example_id": "c1c27c62-0bdd-433d-926b-be3c271d2b54",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Die beiden sind fast immer unterschiedlicher Meinung."
                                            },
                                            {
                                                "example_id": "5aa430ce-933f-4410-bd8d-7e1752313c6f",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Dürfte ich Sie nach Ihrer Meinung fragen?"
                                            },
                                            {
                                                "example_id": "d9a59784-c51c-4138-87eb-ff2c43fe67ba",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Niemand hatte ihn um seine Meinung gebeten."
                                            },
                                            {
                                                "example_id": "e31e172a-d3d4-4244-90e9-951b03fd884a",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Annika hat ihrer Kollegin ordentlich die Meinung gesagt, und jetzt herrscht dort eine gereizte Stimmung."
                                            },
                                            {
                                                "example_id": "08f56784-dedb-486c-9ccf-e34e0537a0b7",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "„Zu ihren Aufgaben, Herr Graumann, gehört es zu verhindern, dass jene in der jüdischen Gemeinschaft, die andere Meinungen vertreten, ausgegrenzt werden.“"
                                            },
                                            {
                                                "example_id": "d1f8f4c7-a368-491a-9b99-a3d8bc78a195",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "Es gibt Tatsachen und es gibt Meinungen, aber mancher Leute Meinungen sind Tatsachen."
                                            },
                                            {
                                                "example_id": "62bd3949-08c7-41f9-91a4-0788159b02c2",
                                                "sense_id": "bd01f339-bf52-301b-a469-b6c858c3839c",
                                                "text": "„Nach der in meiner Befragung erkundeten öffentlichen Meinung zählen […] die Extremformen des Bergsteigens, Skifahrens, Snowboardens und Skatens, die unterschiedlichen Fallschirmsportarten, die Flugsportarten Gleitschirm-, Drachen- und Segelfliegen, die Wildwassersportarten, Formen des Tiefseetauchens wie Wracktauchen und Haitauchen, aber auch das Bahnsurfen und das Bungee-Jumping zu den meistgenannten spielerisch-sportlichen Betätigungen mit hohem Wagnischarakter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                        "entry_id": "e5926223-89a5-316c-99ee-2470958b5582",
                                        "glosses": [
                                            "die persönliche Bewertung einer Sache oder Person, auch die Bewertung durch eine Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b97a9c-e053-4702-8808-5de5177fe6be",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "Es gibt Tatsachen und es gibt Meinungen, aber mancher Leute Meinungen sind Tatsachen."
                                            },
                                            {
                                                "example_id": "4303eaf5-0f0d-43fa-9bbf-c0b9b4bc1a24",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "„Nach der in meiner Befragung erkundeten öffentlichen Meinung zählen […] die Extremformen des Bergsteigens, Skifahrens, Snowboardens und Skatens, die unterschiedlichen Fallschirmsportarten, die Flugsportarten Gleitschirm-, Drachen- und Segelfliegen, die Wildwassersportarten, Formen des Tiefseetauchens wie Wracktauchen und Haitauchen, aber auch das Bahnsurfen und das Bungee-Jumping zu den meistgenannten spielerisch-sportlichen Betätigungen mit hohem Wagnischarakter.“"
                                            },
                                            {
                                                "example_id": "61489c6b-95ff-4f59-8bf5-ba04dff6741b",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "Tina hat eine hohe Meinung von dir, wusstest du das eigentlich?"
                                            },
                                            {
                                                "example_id": "23ea938c-ecff-4066-9f9a-42a5fc8c5f99",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "In der öffentlichen Meinung steht eben dieser Minister nicht gerade sehr hoch im Kurs."
                                            },
                                            {
                                                "example_id": "e47a88c4-d32c-4389-b8e8-a8368ca5e39b",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "„Wer von seinen eigenen Leuten in die Ecke gestellt wird, der bleibt dort, denn alle anderen schließen sich der vermeintlich politisch korrekten Meinung an. Wehe dem, der gegen den Strom schwimmt!“"
                                            },
                                            {
                                                "example_id": "66c2c7af-0bc5-4a28-850c-4849751c6275",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "„Wenn AfD-Politiker und -Anhänger […] ihre Meinungen äußern, haben andere Menschen oft die Frechheit, diese Meinungen nicht zu übernehmen. Ja, sie geben sogar Widerworte!“"
                                            },
                                            {
                                                "example_id": "9b40d3c8-12c0-43d8-b73c-6a1d6c1d0d8e",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "„Es liegt nahe, sich zu fragen, ob man als Nichtbeteiligter in Bezug auf Extrembergsteigen überhaupt eine Meinung entwickeln kann, die relevant ist, als nie annähernd in diese Situationen Hineinversetzter.“"
                                            },
                                            {
                                                "example_id": "ce2a39e3-4b90-4910-9f18-699da006bd28",
                                                "sense_id": "5fed965f-e842-3a67-9061-27a1b3bc8e46",
                                                "text": "„In solchen Tagen trug Pécuchet die Zuavenmütze, die er noch von Paris her besaß, denn er war der Meinung, dies stünde in engerer Beziehung zu dem künstlerischen Milieu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d07dc51-37bd-3245-893b-5fd2dac3c795",
                                        "entry_id": "e5926223-89a5-316c-99ee-2470958b5582",
                                        "glosses": [
                                            "die Absicht mit einer Handlung"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b049657-b308-45e4-9df9-43316d4b9354",
                                                "sense_id": "0d07dc51-37bd-3245-893b-5fd2dac3c795",
                                                "text": "Die Bauarbeit dauerte 3 Stunden, aber eigentlich war die Meinung, dass diese nur 30 Minuten dauern würde."
                                            },
                                            {
                                                "example_id": "924c51f9-bc30-47f5-8a3d-63d6ed968aac",
                                                "sense_id": "0d07dc51-37bd-3245-893b-5fd2dac3c795",
                                                "text": "Gottes Meinung ist nicht, uns zu strafen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6566f448-e1ef-4cf7-ae7f-5ef997689b83",
                        "source_entry_id": "81a64b86-8896-317d-ac20-6e02dd432b45",
                        "source_sense_id": "405881eb-5bdf-3b74-9ba8-efb3bf828991",
                        "source_sense_description": "een mening of oordeel",
                        "target_lang_word": "opinion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opinion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee8145a9-988b-3f78-a80a-6d549a5b1495",
                                        "entry_id": "6ec8e538-6cac-36ac-8e74-e7e3b13060bc",
                                        "glosses": [
                                            "A belief, judgment or perspective that a person has formed, either through objective or subjective reasoning, about a topic, issue, person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7c00e07-0446-4547-bd7a-163646fa10ab",
                                                "sense_id": "ee8145a9-988b-3f78-a80a-6d549a5b1495",
                                                "text": "I would like to know your opinions on the new filing system."
                                            },
                                            {
                                                "example_id": "3ff808e1-c60c-4cef-944c-e1a46cd9e124",
                                                "sense_id": "ee8145a9-988b-3f78-a80a-6d549a5b1495",
                                                "text": "In my opinion, white chocolate is better than milk chocolate."
                                            },
                                            {
                                                "example_id": "685bfa04-f11e-4d07-9379-5a1e708753b1",
                                                "sense_id": "ee8145a9-988b-3f78-a80a-6d549a5b1495",
                                                "text": "Every man is a fool in some man's opinion."
                                            },
                                            {
                                                "example_id": "a4007fca-1a95-4bcf-ab7d-7308d829148f",
                                                "sense_id": "ee8145a9-988b-3f78-a80a-6d549a5b1495",
                                                "text": "We invite you to state your opinions about the suggestions."
                                            },
                                            {
                                                "example_id": "7dbde910-557b-440f-81ff-e1465cfd009d",
                                                "sense_id": "ee8145a9-988b-3f78-a80a-6d549a5b1495",
                                                "text": "Truth, in matters of religion, is simply the opinion that has survived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce61c63-8ba6-374f-973e-c4c48ceb3bb1",
                                        "entry_id": "6ec8e538-6cac-36ac-8e74-e7e3b13060bc",
                                        "glosses": [
                                            "The judgment or sentiment which the mind forms of persons or things; estimation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3c7847-236e-47d0-b9ea-1edc4cc744a8",
                                                "sense_id": "8ce61c63-8ba6-374f-973e-c4c48ceb3bb1",
                                                "text": "I haue bought / Golden Opinions from all ſorts of people, […]"
                                            },
                                            {
                                                "example_id": "27aaf8fa-ae53-47eb-90b4-50e510819481",
                                                "sense_id": "8ce61c63-8ba6-374f-973e-c4c48ceb3bb1",
                                                "text": "Friendship […] gives a man a peculiar right and claim to the good opinion of his friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049ea72d-965f-3cd4-bf4b-9367ecfe01a4",
                                        "entry_id": "6ec8e538-6cac-36ac-8e74-e7e3b13060bc",
                                        "glosses": [
                                            "Favorable estimation; hence, consideration; reputation; fame; public sentiment or esteem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ef1aa2-4316-457d-bd24-81babd5f96a8",
                                                "sense_id": "049ea72d-965f-3cd4-bf4b-9367ecfe01a4",
                                                "text": "Thou haſt redeemed thy loſt opinion, […]"
                                            },
                                            {
                                                "example_id": "84e538f8-146a-4fd2-81ab-d4c51405fbae",
                                                "sense_id": "049ea72d-965f-3cd4-bf4b-9367ecfe01a4",
                                                "text": "This gain’d Agricola much opinion; who […] had made ſuch early progreſs into laborious […] enterpriſes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceccc40d-7023-3a2c-adbf-6d5756d6945e",
                                        "entry_id": "6ec8e538-6cac-36ac-8e74-e7e3b13060bc",
                                        "glosses": [
                                            "Obstinacy in holding to one's belief or impression; opiniativeness; conceitedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e917cc-a357-461e-8e91-a70441488930",
                                                "sense_id": "ceccc40d-7023-3a2c-adbf-6d5756d6945e",
                                                "text": "[…] your reaſons at Dinner haue been ſharpe & ſententious: pleaſant without ſcurillitie, wittie without affection, audatious without impudencie, learned without opinion, and ſtrange without hereſie: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c91ccc-4c5c-38a4-9a3d-82366c4da0f1",
                                        "entry_id": "6ec8e538-6cac-36ac-8e74-e7e3b13060bc",
                                        "glosses": [
                                            "The formal decision, or expression of views, of a judge, an umpire, a doctor, or other party officially called upon to consider and decide upon a matter or point submitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e51653e4-24ad-3940-a99e-17fe22f5c82f",
                                        "entry_id": "6ec8e538-6cac-36ac-8e74-e7e3b13060bc",
                                        "glosses": [
                                            "A judicial opinion delivered by an Advocate General to the European Court of Justice where he or she proposes a legal solution to the cases for which the court is responsible."
                                        ],
                                        "tags": [
                                            "European-Union",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "opinion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9da21b40-da40-3300-9f16-0d3ba76c7c80",
                                        "entry_id": "9552c8ab-27a7-3821-a636-caa286b870a5",
                                        "glosses": [
                                            "To have or express as an opinion."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f80539-7324-439b-a8c1-cfdbfff36dd5",
                                                "sense_id": "9da21b40-da40-3300-9f16-0d3ba76c7c80",
                                                "text": "Philoſophers that opinioned the vvorlds deſtruction by fire, did never dreame of annihilation, vvhich is beyond the povver of ſublunary cauſes; for the laſt and proper action of that element [fire] is but vitrification, or a reduction of a body into Glaſſe, and therefore ſome of our Chymicks factiouſly affirme; yea, and urge Scripture for it, that at the laſt fire all ſhall be cryſtallized and reverberated into Glaſſe, vvhich is the utmoſt action of that element."
                                            },
                                            {
                                                "example_id": "baabdcd5-c6bb-4875-9f87-6f949abf9d7d",
                                                "sense_id": "9da21b40-da40-3300-9f16-0d3ba76c7c80",
                                                "text": "But if (as some opinion) King Ahasuerus were Artaxerxes Mnemon[…], our magnified Cyrus was his second Brother […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
