                        "glosses": [
                            "Genre de libellules comprenant deux espèces reconnues pour être migratrices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711a2e87-49c2-4d72-8a65-d7c4748efb26",
                                "sense_id": "9e8b8f94-d2d4-34be-89ae-ee79df1a0c81",
                                "text": "La femelle de la pantale flavescente n’a pas de tache à l’apex des ailes."
                            },
                            {
                                "example_id": "e74b50e0-b9e1-4dd1-bf2d-9e5521d1816e",
                                "sense_id": "9e8b8f94-d2d4-34be-89ae-ee79df1a0c81",
                                "text": "Ces pantales, au total, auront besoin de quatre générations pour compléter leur migration vers le sud et parcourront jusqu’à 18000 kilomètres."
                            },
                            {
                                "example_id": "7c38ae63-29ac-4ef8-83fc-e3ea0c560d8f",
                                "sense_id": "9e8b8f94-d2d4-34be-89ae-ee79df1a0c81",
                                "text": "L’espèce de loin la plus abondante était la Pantale bimaculée (Pantala hymenaea), mais il y avait également beaucoup de Pantales flavescentes et de Tramea onusta."
                            }
                        ]
