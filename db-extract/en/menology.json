                        "glosses": [
                            "Alternative letter-case form of menology, particularly in reference to particular editions."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "03a0d368-72db-4ef3-8355-af40c9343229",
                                "sense_id": "364c9498-c367-3470-889f-c2195199c5a8",
                                "text": "In the Mart. of Donegal, this is the day of St. Comgall (Comhgall), placed in the Menology on the 27th June, as having no day."
                            }
