                "senses": [
                    {
                        "sense_id": "af59bfc1-e22f-3371-ae0f-dbdc096fc412",
                        "entry_id": "1b51bf64-ab96-3543-a497-707326e7ec83",
                        "glosses": [
                            "durch Dynamit ausgelöste Explosion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3937d2e6-712e-4487-9978-2ff0391225f4",
                                "sense_id": "af59bfc1-e22f-3371-ae0f-dbdc096fc412",
                                "text": "„Ein hartes Landleben, aber eingebettet in ausgesprochen ruhige Atmosphäre - selbst die Dynamitexplosionen der Fischer oder das metallische Kreischen einer Säge wirkten unaufdringlich und wie aus weiter Ferne.“"
                            },
                            {
                                "example_id": "d988206c-fb64-4c4d-9faa-ec8b9714021d",
                                "sense_id": "af59bfc1-e22f-3371-ae0f-dbdc096fc412",
                                "text": "„Wenn man das Leben in der Hölle mit irgendetwas vergleichen kann, dann mit diesen alten Zeichentrickfilmen, wo die Figuren ständig guillotiniert und von Dynamitexplosionen zerrissen werden und im nächsten Moment wiederhergestellt sind, nur damit man aufs Neue über sie herfallen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
