                "senses": [
                    {
                        "sense_id": "7f185c6d-ac3d-311a-b414-ab539d67f7c9",
                        "entry_id": "52f99d54-73e3-3e91-ada2-3dfa49aa5aad",
                        "glosses": [
                            "Former une variable aléatoire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d5294a0a-f88a-3f86-b712-f88e1bf66b7e",
                        "entry_id": "52f99d54-73e3-3e91-ada2-3dfa49aa5aad",
                        "glosses": [
                            "Introduire un caractère aléatoire dans un calcul statistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2915516-a9ec-41ff-a44f-941fa11b264d",
                                "sense_id": "d5294a0a-f88a-3f86-b712-f88e1bf66b7e",
                                "text": "Randoniser une liste d’objets signifie remplacer leur ordre d’origine (par exemple, alphabétique) par un autre ordre choisi au hasard."
                            },
                            {
                                "example_id": "4a15aaff-39c8-4630-a204-77be96009a60",
                                "sense_id": "d5294a0a-f88a-3f86-b712-f88e1bf66b7e",
                                "text": "Randoniser un ensemble, une liste, un ordre, une spirale."
                            },
                            {
                                "example_id": "21b5e8ab-1b6e-4c00-bb71-ec6442025a76",
                                "sense_id": "d5294a0a-f88a-3f86-b712-f88e1bf66b7e",
                                "text": "Ayant coupé un cube en 8, la séparation comporte 5 carrés de côté 1/2, et il faut en randoniser la position parmi 12 possibilités."
                            },
                            {
                                "example_id": "47ec8f9e-622a-464f-94a0-fa7f671ff756",
                                "sense_id": "d5294a0a-f88a-3f86-b712-f88e1bf66b7e",
                                "text": "randoniser (v.) randomize (v.) Introduire un élément de hasard dans un calcul ou un raisonnement."
                            },
                            {
                                "example_id": "3f912f3b-c849-48d4-99af-b5114e54f6cb",
                                "sense_id": "d5294a0a-f88a-3f86-b712-f88e1bf66b7e",
                                "text": "Durant ma soutenance, j’ai fait un clin d’oeil à Benoît Mandelbrot, certains comprendront avec cette citation : « Ne confondez pas randoniser avec le franglais randomiser !"
                            }
                        ]
                    }
                ],
