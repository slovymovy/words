                "senses": [
                    {
                        "sense_id": "def45463-789d-3ccf-94cf-c05f897d5997",
                        "entry_id": "9c0632e2-d3de-37c1-a36a-86e98b946e51",
                        "glosses": [
                            "The act of ministering."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3469909c-698c-446f-9e32-60e0ef869d45",
                                "sense_id": "def45463-789d-3ccf-94cf-c05f897d5997",
                                "text": "Bobby Castleton, who was cured of homosexuality on the Phil Donahue Show through the ministrations of Feona."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec31df28-afc1-44c9-8338-0acdabbb9249",
                        "source_entry_id": "9c0632e2-d3de-37c1-a36a-86e98b946e51",
                        "source_sense_id": "def45463-789d-3ccf-94cf-c05f897d5997",
                        "source_sense_description": "act of ministering",
                        "target_lang_word": "Dienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "das Arbeitsverhältnis, die regelmäßige bezahlte Arbeit, die Amtspflichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1198544-a77c-4908-9774-a1a6faec5fbf",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "Sein Dienst geht von acht bis siebzehn Uhr."
                                            },
                                            {
                                                "example_id": "895fbaea-f4f8-4f00-bd3d-04c7350a10f9",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„An diesem Gründonnerstag hatte er noch Dienst, danach begannen seine Osterferien.“"
                                            },
                                            {
                                                "example_id": "6cc9be34-cf49-45ae-9e6c-fb980ee8bb67",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„Mit anderen Fahndern wurde er vor vier Jahren aus dem Dienst geworfen - nachdem er intern gegen einen zu laxen Umgang mit Steuersünden protestiert hatte.“"
                                            },
                                            {
                                                "example_id": "24aebdb4-8116-40f4-a934-c26b4bd61805",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„Denn je weiter die Digitalisierung voranschreitet, desto weniger wird die Wirtschaft auf die Dienste von Mittelsmännern angewiesen sein.“"
                                            },
                                            {
                                                "example_id": "be039f03-dc83-4958-8fe1-c6d756bd2274",
                                                "sense_id": "6adb8d03-3483-3ee2-93c9-11c1c8f44f04",
                                                "text": "„Ein Lohndiener erschien denn auch, um ihr seine Dienste zur Verfügung zu stellen, und um die sechste Stunde hielt eine mittelelegante Mietchaise vor dem Gasthause, da sich das von Berlin her benutzte Gefährt, nach seiner halbtägigen Anstrengung im Sommersand, als durchaus ruhebedürftig herausgestellt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08210a3e-70bf-3f94-b7e8-9f1979528939",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "das Dienen, für etwas Gutes, für die Allgemeinheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbcd7a1-be86-41b8-9c26-d6de81e77785",
                                                "sense_id": "08210a3e-70bf-3f94-b7e8-9f1979528939",
                                                "text": "Mit ihrer Hilfe im Altersheim, leistete sie Dienst am Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "abceda7e-6b7a-3037-901d-b7d07d2d0cce",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "der Betrieb, das Funktionieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d352269-dc37-4b6e-9242-f16f815cde6f",
                                                "sense_id": "abceda7e-6b7a-3037-901d-b7d07d2d0cce",
                                                "text": "Heute wurde ein neues Flugzeug in Dienst gestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a3d79e70-37af-38e7-ac25-199d67b4c3aa",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "die Hilfe, der Beistand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52547e4a-0243-48ad-a4cf-6d666f9583ac",
                                                "sense_id": "a3d79e70-37af-38e7-ac25-199d67b4c3aa",
                                                "text": "Obwohl das Fahrrad schon 20 Jahre alt ist, leistet es immer noch gute Dienste."
                                            },
                                            {
                                                "example_id": "03d1cd98-1dd5-4659-b492-8c67576a3c5d",
                                                "sense_id": "a3d79e70-37af-38e7-ac25-199d67b4c3aa",
                                                "text": "„Als ich noch in England mein Bike vorbereitete, hatte ich die Dienste von David Lambeth in Anspruch genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a9ca2ece-a9b3-346a-bffd-129e30324411",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "eine Organisation, Behörde oder ein Unternehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aefbc77-ab7b-4676-a32c-11d816ec6a4a",
                                                "sense_id": "a9ca2ece-a9b3-346a-bffd-129e30324411",
                                                "text": "Da muss man am besten so einen Dienst anrufen, jemanden, der Schlüssel nachmachen kann oder Türen aufbrechen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b7ce1dee-d57b-3756-bbf1-a9953959baba",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "eine Gruppe von Personen, die für dieselbe Sache tätig sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7446a0ed-83c5-45d9-9508-16e1779bb7d1",
                                                "sense_id": "b7ce1dee-d57b-3756-bbf1-a9953959baba",
                                                "text": "Bei uns im Dienst wechseln wir uns mit der Schichten an Feiertagen ab."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "76688b96-87b3-31ef-859c-6327ec1fac52",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "dünne Säule eines Bündel- oder Wandpfeilers"
                                        ],
                                        "tags": [
                                            "Baukunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30460787-2346-4676-ac35-d308e6aa73cb",
                                                "sense_id": "76688b96-87b3-31ef-859c-6327ec1fac52",
                                                "text": "Einen dicht von Diensten umstandenen Pfeiler nennt man auch einen Bündelpfeiler."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "e9bb42da-0064-3578-b616-9ed4edd33789",
                                        "entry_id": "4f10fb51-a020-369a-be3f-491703b6be3f",
                                        "glosses": [
                                            "Programm, das ohne Benutzeroberfläche läuft"
                                        ],
                                        "tags": [
                                            "Computer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25abbf08-51af-4b2e-a7b0-a3257aa87ae8",
                                                "sense_id": "e9bb42da-0064-3578-b616-9ed4edd33789",
                                                "text": "Natürlich bekommst du keine Verbindung, da der Dienst des Servers auf dem Host-Rechner nicht gestartet ist."
                                            },
                                            {
                                                "example_id": "0f59dac0-6467-46dd-8843-e114113f6d99",
                                                "sense_id": "e9bb42da-0064-3578-b616-9ed4edd33789",
                                                "text": "„Debian-Entwickler planen eine soziale Plattform, die mehrere Dienste zur besseren Vernetzung der Debian-Gemeinschaft unterhalten will. Erste Dienste sollen noch 2020 zugänglich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3cbba88-a705-41d8-9148-3d7a576c125e",
                        "source_entry_id": "9c0632e2-d3de-37c1-a36a-86e98b946e51",
                        "source_sense_id": "def45463-789d-3ccf-94cf-c05f897d5997",
                        "source_sense_description": "act of ministering",
                        "target_lang_word": "Fürsorge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürsorge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                        "entry_id": "32db3673-bd51-3390-9fde-b67cc1cdd5e2",
                                        "glosses": [
                                            "Einsatz/Bemühung zugunsten Hilfsbedürftiger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48fa9372-60ce-4835-a3dd-8c6b80e7eb02",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Der Begriff Fürsorge wurde in den 60er Jahren durch die Begriffe Sozialarbeit/Sozialpädagogik und Soziale Arbeit abgelöst.“"
                                            },
                                            {
                                                "example_id": "7756679e-0fa9-4482-b858-15886926d88f",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Seine Ehrlichkeit und seine Fürsorge für die Gefangenen waren beispielhaft.“"
                                            },
                                            {
                                                "example_id": "f7217ff7-6a8a-4307-b5f0-1c13be73f273",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Alles ist neu und beseligend, Wärme und Stille und Bücher und Worte der Freunde, die Fürsorge der Wirtin, das heiße Bad, das Bett.“"
                                            },
                                            {
                                                "example_id": "e88bc4af-e511-450c-a724-734c9cd0200e",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Ebenso wie die übrigen hoffnungslos Verwundeten wurde auch Fürst Andrej dann der Fürsorge der Zivilbevölkerung überlassen.“"
                                            },
                                            {
                                                "example_id": "18285038-8d1d-46a2-bb7b-e5165fc8cbdd",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Der Stiefbruder, die Schwägerin und Rotermund amüsierten sich über die Fürsorge der Mutter, die, wie die Schwägerin sagte, da ausgebreitet vor ihnen auf dem Tisch lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1ab0a1b-f515-3305-bdd7-9919685a7201",
                                        "entry_id": "32db3673-bd51-3390-9fde-b67cc1cdd5e2",
                                        "glosses": [
                                            "öffentliche Einrichtung zur Betreuung von Hilfsbedürftigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b74782-a3c8-4ca3-a69b-2428755c5d99",
                                                "sense_id": "e1ab0a1b-f515-3305-bdd7-9919685a7201",
                                                "text": "Wenn du den Jungen nicht in den Griff bekommst, müssen wir die Fürsorge einschalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b4fa902e-11cd-3cb1-9e0a-59a37ff5c898",
                                        "entry_id": "32db3673-bd51-3390-9fde-b67cc1cdd5e2",
                                        "glosses": [
                                            "finanzielle Unterstützung für Bedürftige durch das Sozialamt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02369190-0425-4080-89a0-e81ab90ba5d9",
                                                "sense_id": "b4fa902e-11cd-3cb1-9e0a-59a37ff5c898",
                                                "text": "Sehr vielen war es peinlich, von Fürsorge leben zu müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32ecdff3-b72c-48d7-bdb6-f29ed1468377",
                        "source_entry_id": "9c0632e2-d3de-37c1-a36a-86e98b946e51",
                        "source_sense_id": "def45463-789d-3ccf-94cf-c05f897d5997",
                        "source_sense_description": "act of ministering",
                        "target_lang_word": "Pflege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                        "entry_id": "1bb75fd1-fe42-3d99-bf1c-291de4a10a5c",
                                        "glosses": [
                                            "Fürsorge, Betreuung und Versorgung von Menschen oder Tieren, die gewisse Hilfe benötigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befec080-625f-4ce4-9137-a5929432cfb6",
                                                "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                                "text": "Die Pflege eines behinderten Kindes kann nicht jede Familie zu Hause leisten."
                                            },
                                            {
                                                "example_id": "89215594-d49a-445b-9256-fdbb5c0c9f5a",
                                                "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                                "text": "„Wurde die Versorgung anfangs noch von ungelernten Kräften oder Krankenpflegern übernommen, sah man immer mehr die Notwendigkeit, die Betreuung und Pflege von Senioren als speziellen Berufszweig zu etablieren.“"
                                            },
                                            {
                                                "example_id": "5fd1949b-f2d8-4372-9962-0f7556105781",
                                                "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                                "text": "„Später jedoch, als sich Mrs. Smart bereit erklärt hatte, die kranke Frau in Pflege zu nehmen, teilte Tom den wahren Sachverhalt mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                        "entry_id": "1bb75fd1-fe42-3d99-bf1c-291de4a10a5c",
                                        "glosses": [
                                            "sämtliche Maßnahmen und Handlungen, die dazu dienen, etwas (Materielles oder Geistiges) zu erhalten, zu bewahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1af8e19-509f-4887-99e3-7881c4e41463",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "Die Pflege des Datenbestandes ist ebenso wichtig wie die Erfassung."
                                            },
                                            {
                                                "example_id": "c1add20b-0ef2-422e-b342-daca6c32e4c0",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "Tragen Sie dieses Mittel zur Pflege der Haut regelmäßig auf."
                                            },
                                            {
                                                "example_id": "2f919209-45dd-4911-9b2f-bdd0c07c9bb6",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "Viele erachten die Pflege der deutschen Sprache für notwendig."
                                            },
                                            {
                                                "example_id": "abe17746-9295-407c-8ced-6b21724b3756",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "„Unter der geistigen Kultur endlich versteht man den Umfang und die Intensität der Pflege von Wissenschaft und Kunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
