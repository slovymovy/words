                        "examples": [
                            {
                                "example_id": "5e63e194-5767-4e49-bbc5-e44001a81480",
                                "sense_id": "5660f52a-dd81-329d-a118-b3c793fefb56",
                                "text": "La ville de Multan a beaucoup de banians & de gentils qu’on nomme raspoutes."
                            },
                            {
                                "example_id": "f14a2597-5840-4f08-9a6a-846ecd091825",
                                "sense_id": "5660f52a-dd81-329d-a118-b3c793fefb56",
                                "text": "Le nom de raspoutes, signifie homme courageux, parce qu’en général ceux de cette secte sont intrépides. Le grand-mogol s’en sert dans ses armées, & ce sont sans doute les mêmes que M. de la Martiniere nomme ragéputes, & qui composent les troupes des rajas ou petits rois indiens, vassaux & tributaires du grand-mogol."
                            }
                        ]
                    }
