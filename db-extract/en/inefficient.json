                        "glosses": [
                            "A person who cannot or does not work efficiently."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2686362-a8de-4f54-8d5e-c36f21caee60",
                                "sense_id": "d318ef61-f510-3690-aff9-ba4085878494",
                                "text": "Two men were put to work who could not set their looms; a third man was taken on who helped the inefficients to set the looms. The other weavers thought this was a breach of their union rules and 18 of them struck […]"
                            },
                            {
                                "example_id": "a0f51158-e7aa-43d9-8fa8-5deaacf1fb53",
                                "sense_id": "d318ef61-f510-3690-aff9-ba4085878494",
                                "text": "A general shaking up of the workers from top to bottom would result; and when equilibrium had been restored, the number of the inefficients at the bottom of the Abyss would have been increased by hundreds of thousands."
                            }
                        ]
                    }
