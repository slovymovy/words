                                        "entry_id": "d494e49b-4edf-313f-a89b-c9b5dbd09fe5",
                                        "glosses": [
                                            "Personne qui souffre de mythomanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22347137-4a72-403c-ad42-4a1f00cfbd7e",
                                                "sense_id": "c2d2fe72-a424-369f-b77e-654341097900",
                                                "text": "Judith, ma chérie, ne tient aucun compte de ces médisances, il faut être un mythomaniaque pour oser salir toute une famille de cette façon !"
                                            }
                                        ]
                                    }
                                ]
