                    {
                        "sense_id": "40a9d425-bcf0-3cbe-b6a0-cdb3f3728609",
                        "entry_id": "b81a7b6e-acb4-3fa2-ad59-96aea7114541",
                        "glosses": [
                            "Ayant un rapport, un lien avec Honduras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabc9794-2404-4b9c-ab4f-8cff201355c5",
                                "sense_id": "40a9d425-bcf0-3cbe-b6a0-cdb3f3728609",
                                "text": "Une nouvelle caravane de migrants honduriens est en route vers les États-Unis. Encouragées par l’élection du démocrate Joe Biden, ces 300 personnes espèrent traverser le Guatemala et le Mexique pour enfin atteindre la frontière américaine."
                            },
                            {
                                "example_id": "0d9cb606-b527-4b38-8023-173c18f06368",
                                "sense_id": "40a9d425-bcf0-3cbe-b6a0-cdb3f3728609",
                                "text": "Un exemple concret : l’attaquant hondurien Alberth Elis, annoncé par la presse de son pays en partance pour le club turc de Galatasaray."
                            }
                        ]
                    }
                ],
                "translations": [
