                "senses": [
                    {
                        "sense_id": "8ca22623-c577-3c97-8b9e-b324e8bdf49e",
                        "entry_id": "85477669-5996-31a8-b909-24a020d25599",
                        "glosses": [
                            "(besonders deutlich) erkennbar werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c904a8e8-1147-47f7-9694-ed5b9b1e500f",
                                "sense_id": "8ca22623-c577-3c97-8b9e-b324e8bdf49e",
                                "text": "„Ja, schon in Rousseaus Menschenliebe hat Jean Pauls Witz vorgeschienen, diese brüderliche Weisheit des Hanswurst.“"
                            },
                            {
                                "example_id": "6b623d13-8d05-4813-970d-b426d974b257",
                                "sense_id": "8ca22623-c577-3c97-8b9e-b324e8bdf49e",
                                "text": "„Was man sein mag, oder was immer man thue, niemals soll man auf Achtung in der Freunde Augen rechnen, wenn man nicht in den Augen der übrigen Welt vorscheint.“"
                            },
                            {
                                "example_id": "43249000-549a-4722-a2be-1b4f1da210e9",
                                "sense_id": "8ca22623-c577-3c97-8b9e-b324e8bdf49e",
                                "text": "„Das dritte bis siebente Segment haben einen so breiten, bandförmigen, schwarzen Hinterrand, dass die gelbe Grundfarbe nur wenig vorscheint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
