{
    "word_family": [
        "польза",
        "полезный",
        "полезно"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "226dc870-2372-3470-92eb-afb7bd275224",
                    "sense_definition": "Применять что-либо для достижения цели или удовлетворения потребностей.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я часто <w>пользуюсь</w> этим словарем для перевода текстов.",
                            "target_lang_translations": {
                                "en": "I often <w>use</w> this dictionary to translate texts."
                            }
                        },
                        {
                            "text": "Чтобы доехать до центра, лучше <w>пользоваться</w> метро.",
                            "target_lang_translations": {
                                "en": "To get to the center, it is better to <w>use</w> the metro."
                            }
                        }
                    ],
                    "synonyms": [
                        "использовать",
                        "применять"
                    ],
                    "antonyms": [
                        "использоваться",
                        "применяться"
                    ],
                    "common_phrases": [
                        "пользоваться метро",
                        "пользоваться интернетом",
                        "пользоваться словарем"
                    ],
                    "target_lang_definitions": {
                        "en": "To use something to achieve a goal or satisfy a need."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "use",
                                "target_lang_sense_clarification": "To utilize or employ something for a specific purpose."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e17732e3-0dec-317d-90bf-2e5f72db88b4",
                    "sense_definition": "Обладать чем-либо, иметь доступ к чему-либо или иметь определенную репутацию.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "possession_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот актер <w>пользуется</w> большой популярностью среди молодежи.",
                            "target_lang_translations": {
                                "en": "This actor <w>enjoys</w> great popularity among young people."
                            }
                        },
                        {
                            "text": "Все граждане <w>пользуются</w> равными правами в нашей стране.",
                            "target_lang_translations": {
                                "en": "All citizens <w>have</w> equal rights in our country."
                            }
                        }
                    ],
                    "synonyms": [
                        "обладать"
                    ],
                    "common_phrases": [
                        "пользоваться популярностью",
                        "пользоваться успехом",
                        "пользоваться доверием"
                    ],
                    "target_lang_definitions": {
                        "en": "To possess something, have access to it, or enjoy a certain reputation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enjoy",
                                "target_lang_sense_clarification": "To have the benefit or possession of something, such as rights or popularity."
                            },
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "To possess or hold something at one's disposal."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ee6a3c1-80c9-3cea-a01e-28a29eca8fb3",
                    "sense_definition": "Извлекать выгоду или преимущество из сложившейся ситуации.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <w>пользоваться</w> случаем, пока есть такая возможность.",
                            "target_lang_translations": {
                                "en": "You need to <w>take advantage of</w> the opportunity while it exists."
                            }
                        },
                        {
                            "text": "Он умеет <w>пользоваться</w> своим преимуществом в переговорах.",
                            "target_lang_translations": {
                                "en": "He knows how to <w>exploit</w> his advantage in negotiations."
                            }
                        }
                    ],
                    "synonyms": [
                        "прибегать"
                    ],
                    "common_phrases": [
                        "пользоваться случаем"
                    ],
                    "target_lang_definitions": {
                        "en": "To derive benefit or advantage from a given situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take advantage of",
                                "target_lang_sense_clarification": "To profit from a situation or opportunity deliberately."
                            },
                            {
                                "target_lang_word": "exploit",
                                "target_lang_sense_clarification": "To use a situation or resource to one's own benefit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20ea36c7-8c09-3c5e-997d-dfd0893656f2",
                    "sense_definition": "Проходить курс лечения у врача.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи посоветовали ему <w>пользоваться</w> у известного специалиста в столице.",
                            "target_lang_translations": {
                                "en": "Doctors advised him to <w>be treated by</w> a well-known specialist in the capital."
                            }
                        },
                        {
                            "text": "Она долго не хотела ехать в город, чтобы <w>пользоваться</w> у докторов.",
                            "target_lang_translations": {
                                "en": "For a long time, she did not want to go to the city to <w>be treated by</w> doctors."
                            }
                        }
                    ],
                    "synonyms": [
                        "лечиться"
                    ],
                    "antonyms": [
                        "пользовать",
                        "лечить"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Устаревшее значение, связанное с лечением."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To undergo medical treatment under a doctor's care (dated)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be treated by",
                                "target_lang_sense_clarification": "To receive medical care from a professional."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}