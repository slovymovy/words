                                    {
                                        "sense_id": "3cddae73-3fb1-364a-8abd-acf862b452a3",
                                        "entry_id": "4fd01090-1d2e-3616-9429-7c3e04632f51",
                                        "glosses": [
                                            "ein essbarer Pilz"
                                        ],
