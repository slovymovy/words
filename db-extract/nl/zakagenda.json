                    {
                        "translation_id": "383c5300-b11b-498a-bcb0-499d9c43f731",
                        "source_entry_id": "1e3551db-5045-3fa9-8a4e-e588abd9361d",
                        "source_sense_id": "2ff8adcd-0278-38e6-b6d1-00ecc5705e09",
                        "source_sense_description": "een klein formaat agenda",
                        "target_lang_word": "agenda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agenda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ec57e5-b08f-3611-ab89-7ac87ca20975",
                                        "entry_id": "09ab2431-7511-39b0-ba33-8a221c9d31d6",
                                        "glosses": [
                                            "A temporally organized plan for matters to be attended to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c861698-b304-4c9a-97d8-1bbe328b2403",
                                                "sense_id": "c9ec57e5-b08f-3611-ab89-7ac87ca20975",
                                                "text": "Where the Joker preys on our fears of random, irrational acts of terror, Bane has an all-consuming, dictatorial agenda that’s more stable and permanent, a New World Order that’s been planned out with the precision of a military coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9c7e99-8145-3257-9571-d513cb7ee9b9",
                                        "entry_id": "09ab2431-7511-39b0-ba33-8a221c9d31d6",
                                        "glosses": [
                                            "A list of matters to be taken up (as at a meeting)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc1a128f-cd37-3cea-8110-1a44d221f999",
                                        "entry_id": "09ab2431-7511-39b0-ba33-8a221c9d31d6",
                                        "glosses": [
                                            "A notebook used to organize and maintain such plans or lists, an agenda book, an agenda planner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03e76e6-f6bf-4f89-b6a3-293cdf3c814f",
                                                "sense_id": "bc1a128f-cd37-3cea-8110-1a44d221f999",
                                                "text": "A homework agenda, sometimes called a student planner, is a notebook often used to help your child keep track of daily homework assignments."
                                            },
                                            {
                                                "example_id": "763884d7-2e7d-4d7a-983f-2ad6a7fe7e64",
                                                "sense_id": "bc1a128f-cd37-3cea-8110-1a44d221f999",
                                                "text": "It may be better to simply buy an agenda at the drug store for five dollars, but you need to keep this stuff accurate."
                                            },
                                            {
                                                "example_id": "73b45ed8-22b5-45ad-b236-f1455cc58a76",
                                                "sense_id": "bc1a128f-cd37-3cea-8110-1a44d221f999",
                                                "text": "The children will use an agenda book that the school provides to organize their homework information. Before leaving for home, the children will neatly write their assignments and related directions in their agendas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b59ea1d5-6fb7-39d6-a4b5-b66d5421eb3d",
                                        "entry_id": "09ab2431-7511-39b0-ba33-8a221c9d31d6",
                                        "glosses": [
                                            "An ulterior motive; a program of various such motives."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e640ae36-c520-4dca-a2cf-8711b0f82e90",
                                                "sense_id": "b59ea1d5-6fb7-39d6-a4b5-b66d5421eb3d",
                                                "text": "These plans are the complete opposite of the path pursued by Emmanuel Macron since 2017. His agenda has exacerbated both income and wealth inequality, while there has been no change in investment, job creation or growth."
                                            },
                                            {
                                                "example_id": "9b9d1488-818a-40de-b7b3-b96d538a0911",
                                                "sense_id": "b59ea1d5-6fb7-39d6-a4b5-b66d5421eb3d",
                                                "text": "I haven't got an agenda / I haven't еven got a gender"
                                            },
                                            {
                                                "example_id": "cee56f80-52a6-4097-93d5-5a229969ede8",
                                                "sense_id": "b59ea1d5-6fb7-39d6-a4b5-b66d5421eb3d",
                                                "text": "By invoking a wartime authority in service of a peacetime deportation agenda, he has gone beyond what even this draconian power permits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06df0b3c-06b3-3d5a-b133-3295b830d4ef",
                                        "entry_id": "09ab2431-7511-39b0-ba33-8a221c9d31d6",
                                        "glosses": [
                                            "A ritual."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
