                ],
                "senses": [
                    {
                        "sense_id": "466b5f40-4179-3a88-9a71-25f05b2c3a0b",
                        "entry_id": "d62388d1-afa5-3c6d-acc1-9abc2344a48c",
                        "glosses": [
                            "Apprendre par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ac4b867-a83e-4796-891e-6a18c36eb343",
                                "sense_id": "466b5f40-4179-3a88-9a71-25f05b2c3a0b",
                                "text": "En effet, il est capable de créer des personnages virtuels sur son ordinateur, capable de parler et de s'auto-apprendre."
                            },
                            {
                                "example_id": "5e8305e7-394f-4619-ba1c-44cb1025d994",
                                "sense_id": "466b5f40-4179-3a88-9a71-25f05b2c3a0b",
                                "text": "Il peut même être facile à auto-apprendre chez quelqu'un qui va adhérer aux principes de la communauté."
                            },
                            {
                                "example_id": "e44512c3-d46b-453e-ad1a-e82ff8bb2024",
                                "sense_id": "466b5f40-4179-3a88-9a71-25f05b2c3a0b",
                                "text": "Il commença à auto-apprendre la guitare, car il économisait depuis qu'il avait 10 ans pour s'en acheter une."
                            }
                        ]
                    }
