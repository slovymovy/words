{
    "word_family": [
        "pretence",
        "pretender",
        "pretension",
        "pretentious",
        "unpretending",
        "unpretentious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "196292ab-8023-399f-9461-b1f4e75e34a8",
                    "sense_definition": "To behave in a way that gives a false appearance or impression of something being true.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You do not have to <w>pretend</w> to like the soup if it tastes bad.",
                            "target_lang_translations": {
                                "ru": "Тебе не нужно <w>делать вид</w>, что суп тебе нравится, если он невкусный.",
                                "tr": "Çorbanın tadı kötüyse beğenmiş <w>gibi davranmak</w> zorunda değilsin."
                            }
                        },
                        {
                            "text": "He tried to <w>pretend</w> to be happy even though he was very sad.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>притвориться</w> счастливым, хотя ему было очень грустно.",
                                "tr": "Çok üzgün olmasına rağmen mutluymuş <w>gibi yapmaya</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "make like"
                    ],
                    "common_phrases": [
                        "pretend to be",
                        "pretend to like",
                        "pretend to know"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя так, чтобы создать ложное впечатление о чем-либо.",
                        "tr": "Bir şey doğruymuş gibi davranmak, öyleymiş gibi görünmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "принимать какой-либо вид для обмана"
                            },
                            {
                                "target_lang_word": "делать вид",
                                "target_lang_sense_clarification": "создавать видимость"
                            },
                            {
                                "target_lang_word": "прикидываться",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "numara yapmak",
                                "target_lang_sense_clarification": "bir şey yapıyormuş gibi görünmek"
                            },
                            {
                                "target_lang_word": "rol yapmak",
                                "target_lang_sense_clarification": "yapmacık davranmak"
                            },
                            {
                                "target_lang_word": "gibi davranmak",
                                "target_lang_sense_clarification": "öyleymiş hissi vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2497162b-af13-3574-86a4-3a1b078a3edc",
                    "sense_definition": "To engage in imaginative play or make-believe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children like to <w>pretend</w> they are astronauts exploring a new planet.",
                            "target_lang_translations": {
                                "ru": "Детям нравится <w>представлять</w>, что они астронавты, исследующие новую планету.",
                                "tr": "Çocuklar yeni bir gezegeni keşfeden astronotlarmış <w>gibi oynamayı</w> seviyor."
                            }
                        },
                        {
                            "text": "She moved her fingers across the desk, <w>pretending</w> to play the piano.",
                            "target_lang_translations": {
                                "ru": "Она водила пальцами по столу, <w>изображая</w> игру на пианино.",
                                "tr": "Piyano çalıyormuş <w>gibi yaparak</w> parmaklarını masanın üzerinde gezdirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "make like"
                    ],
                    "common_phrases": [
                        "pretend to play",
                        "just pretending"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в воображаемой игре или фантазировать.",
                        "tr": "Hayali veya mış gibi oyunlar oynamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "воображать себя кем-то"
                            },
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "в значении понарошку"
                            },
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "в контексте игры"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mış gibi yapmak",
                                "target_lang_sense_clarification": "oyunda öyle hayal etmek"
                            },
                            {
                                "target_lang_word": "gibi oynamak",
                                "target_lang_sense_clarification": "rolünü canlandırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77beeb46-60fd-3daf-ad83-ea5f0d699f3b",
                    "sense_definition": "To feign or affect a specific state, quality, or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>pretending</w> illness to get out of the long business meeting.",
                            "target_lang_translations": {
                                "ru": "Она <w>симулирует</w> болезнь, чтобы избежать долгого делового совещания.",
                                "tr": "Uzun iş toplantısından kaçmak için hastalık <w>numarası yapıyor</w>."
                            }
                        },
                        {
                            "text": "The company cannot <w>pretend</w> ignorance when such serious abuses are committed.",
                            "target_lang_translations": {
                                "ru": "Компания не может <w>разыгрывать</w> неосведомленность, когда совершаются такие серьезные нарушения.",
                                "tr": "Böyle ciddi ihlaller yapılırken şirket haberinin olmadığını <w>iddia edemez</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pretend ignorance",
                        "pretend indifference",
                        "pretend illness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Симулировать или имитировать определенное состояние, качество или чувство.",
                        "tr": "Belirli bir durumu, duyguyu veya niteliği numaradan gösterip belli etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симулировать",
                                "target_lang_sense_clarification": "болезнь или состояние"
                            },
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "чувства или качества"
                            },
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "незнание или безразличие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "numara yapmak",
                                "target_lang_sense_clarification": "yalandan hasta vb. görünmek"
                            },
                            {
                                "target_lang_word": "numara yapmak",
                                "target_lang_sense_clarification": "yalandan duygu veya durum sergilemek"
                            },
                            {
                                "target_lang_word": "taklidi yapmak",
                                "target_lang_sense_clarification": "bir hali göstermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84f247ee-ce0d-3e3a-977b-96fb57d6dc6b",
                    "sense_definition": "To lay claim to a specific ability, status, or advantage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "claim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family's exile was intended to stop them <w>pretending</w> to the throne.",
                            "target_lang_translations": {
                                "ru": "Изгнание семьи было направлено на то, чтобы помешать им <w>претендовать</w> на трон.",
                                "tr": "Ailenin sürgün edilmesinin amacı, tahta <w>hak iddia etmelerini</w> engellemekti."
                            }
                        },
                        {
                            "text": "He did not <w>pretend</w> to any great knowledge of the subject.",
                            "target_lang_translations": {
                                "ru": "Он не <w>заявлял</w> о каких-то глубоких знаниях в этом предмете.",
                                "tr": "Konu hakkında derin bir bilgiye sahip olduğunu <w>iddia etmedi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pretend to the throne",
                        "pretend to knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявлять права на определенную способность, статус или преимущество.",
                        "tr": "Belirli bir yetenek, statü veya hak iddia etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претендовать",
                                "target_lang_sense_clarification": "на трон или знания"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "о своих правах или умениях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iddia etmek",
                                "target_lang_sense_clarification": "hak veya yetenek sürmek"
                            },
                            {
                                "target_lang_word": "hak iddia etmek",
                                "target_lang_sense_clarification": "taht vb. üzerinde iddiada bulunmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ac1faf4-c575-3e3d-ba12-6f11c197b659",
                    "sense_definition": "To intend, design, or plot a specific action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were accused of <w>pretending</w> malicious practices against the state.",
                            "target_lang_translations": {
                                "ru": "Их обвинили в <w>замышлении</w> злонамеренных действий против государства.",
                                "tr": "Devlete karşı kötü niyetli eylemler <w>tasarlamakla</w> suçlandılar."
                            }
                        },
                        {
                            "text": "He <w>pretended</w> a great change in the law but never followed through.",
                            "target_lang_translations": {
                                "ru": "Он <w>задумал</w> серьезное изменение в законе, но так и не довел дело до конца.",
                                "tr": "Yasada büyük bir değişiklik <w>planladı</w> ancak gerisini getirmedi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намереваться, замышлять или планировать определенное действие (устаревшее).",
                        "tr": "Belirli bir eylemi tasarlamak, planlamak veya niyetlenmek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "планировать действие"
                            },
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "иметь намерение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tasarlamak",
                                "target_lang_sense_clarification": "plan kurmak"
                            },
                            {
                                "target_lang_word": "niyetlenmek",
                                "target_lang_sense_clarification": "amaçlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b952c14e-78fb-3384-a875-97ba81787b8a",
                    "sense_definition": "To hold something out or extend it in front of oneself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier <w>pretended</w> his shield over the fallen comrade to protect him.",
                            "target_lang_translations": {
                                "ru": "Солдат <w>выставил</w> щит над павшим товарищем, чтобы защитить его.",
                                "tr": "Asker, düşen arkadaşını korumak için kalkanını onun üzerine <w>uzattı</w>."
                            }
                        },
                        {
                            "text": "He <w>pretended</w> his hand to catch the falling fruit.",
                            "target_lang_translations": {
                                "ru": "Он <w>протянул</w> руку, чтобы поймать падающий плод.",
                                "tr": "Düşen meyveyi yakalamak için elini <w>uzattı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete and found in historical texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выставлять что-либо перед собой или протягивать (устаревшее).",
                        "tr": "Bir şeyi önüne doğru uzatmak veya tutmak (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "вперед для защиты"
                            },
                            {
                                "target_lang_word": "протягивать",
                                "target_lang_sense_clarification": "руку или предмет"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzatmak",
                                "target_lang_sense_clarification": "öney doğru sürmek"
                            },
                            {
                                "target_lang_word": "öne tutmak",
                                "target_lang_sense_clarification": "koruma amacıyla siper etmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96475aac-e659-3eb5-b281-c952ca19dee5",
                    "sense_definition": "Imaginary or feigned; not real.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children had a <w>pretend</w> tea party with their stuffed animals.",
                            "target_lang_translations": {
                                "ru": "Дети устроили <w>игрушечное</w> чаепитие со своими мягкими игрушками.",
                                "tr": "Çocuklar pelüş oyuncaklarıyla <w>evcilik</w> çay partisi düzenledi."
                            }
                        },
                        {
                            "text": "He used a <w>pretend</w> phone to talk to his imaginary friend.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>ненастоящий</w> телефон, чтобы поговорить со своим воображаемым другом.",
                                "tr": "Hayali arkadaşıyla konuşmak için <w>oyuncak</w> bir telefon kullandı."
                            }
                        }
                    ],
                    "antonyms": [
                        "real",
                        "actual"
                    ],
                    "common_phrases": [
                        "pretend money",
                        "pretend world",
                        "pretend tea party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воображаемый или притворный; ненастоящий.",
                        "tr": "Gerçek olmayan, hayal ürünü veya yapmacık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игрушечный",
                                "target_lang_sense_clarification": "о предметах для игры"
                            },
                            {
                                "target_lang_word": "понарошку",
                                "target_lang_sense_clarification": "не настоящий"
                            },
                            {
                                "target_lang_word": "воображаемый",
                                "target_lang_sense_clarification": "существующий в фантазии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sözde",
                                "target_lang_sense_clarification": "gerçekte olmayan"
                            },
                            {
                                "target_lang_word": "oyuncak",
                                "target_lang_sense_clarification": "oyun amaçlı yapay"
                            },
                            {
                                "target_lang_word": "sahte",
                                "target_lang_sense_clarification": "gerçek dışı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54fe0bf3-f61e-3e25-abf8-a54da96ceadd",
                    "sense_definition": "The act of engaging in imaginative or make-believe play.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We used to dress up in old clothes and play <w>pretend</w> for hours.",
                            "target_lang_translations": {
                                "ru": "Раньше мы часами переодевались в старую одежду и <w>играли</w> в разные истории.",
                                "tr": "Eski kıyafetler giyer ve saatlerce <w>hayal oyunu</w> oynardık."
                            }
                        },
                        {
                            "text": "The game of <w>pretend</w> helped the children develop their creativity.",
                            "target_lang_translations": {
                                "ru": "Игра в <w>воображение</w> помогла детям развить творческие способности.",
                                "tr": "<w>Mış gibi yapma oyunu</w> çocukların yaratıcılıklarını geliştirmelerine yardımcı oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "make like"
                    ],
                    "common_phrases": [
                        "play pretend",
                        "game of pretend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт участия в воображаемой игре.",
                        "tr": "Hayal gücüne dayalı veya mış gibi yapma oyunu oynama eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игра в воображение",
                                "target_lang_sense_clarification": "процесс игры"
                            },
                            {
                                "target_lang_word": "притворство",
                                "target_lang_sense_clarification": "в игровом смысле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mış gibi yapma oyunu",
                                "target_lang_sense_clarification": "çocuk oyunu türü"
                            },
                            {
                                "target_lang_word": "evcilik/hayal oyunu",
                                "target_lang_sense_clarification": "sembolik oyun eylemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}