                "forms": [
                    {
                        "form_id": "2c740fa1-7e77-4114-8013-6c7b19fb5a5d",
                        "entry_id": "8e2ac708-43f1-375d-855c-38f707cc78a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "offensives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                        "entry_id": "8e2ac708-43f1-375d-855c-38f707cc78a7",
                        "glosses": [
                            "Attaque que l’on fait sans avoir été provoqué par l’adversaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29ea299-ca9a-4940-81b6-8c61e31150c6",
                                "sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                                "text": "La soudaine irruption d’un ennemi prêt à l’offensive n’eut d’autre effet immédiat sur New York que d’accroître sa véhémence habituelle."
                            },
                            {
                                "example_id": "bebde645-6a5a-4586-be64-f5d0ac9fc399",
                                "sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                                "text": "C'est le 6 avril 1917, le jour du Vendredi-Saint, une semaine avant l'offensive du Chemin des Dames, que le maréchal des logis Clérisse s'envola sur un Sopwith-Clerget."
                            },
                            {
                                "example_id": "1e2ef607-b6d3-46d5-a190-f8086b44a1eb",
                                "sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                                "text": "Au début de l'année 1918, ils ont mené l’offensive, ils ont déployé toutes leurs forces, et ils méritaient de gagner, ils méritaient la victoire, comme le vieux Pindur et son grand-père Otto Magnor, à la bataille de Sedan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6d12b09-aa08-442d-a855-7f8f5726d4a5",
                        "source_entry_id": "8e2ac708-43f1-375d-855c-38f707cc78a7",
                        "source_sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                        "target_lang_word": "Offensive",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Offensive",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b0bc010-3e2d-3cea-a96a-0b906d0165ca",
                                        "entry_id": "991b00f6-09c1-3c2b-873e-8baf789785e0",
                                        "glosses": [
                                            "Vorgehen gegen einen Gegner oder Feind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1748495f-f6bf-47b6-9ebe-9644373549ea",
                                                "sense_id": "0b0bc010-3e2d-3cea-a96a-0b906d0165ca",
                                                "text": "„Es wird von einer Offensive gemunkelt.“"
                                            },
                                            {
                                                "example_id": "cd6b32c8-0b63-480d-b348-03bc82cfe3b6",
                                                "sense_id": "0b0bc010-3e2d-3cea-a96a-0b906d0165ca",
                                                "text": "„Man wußte, wann die Offensive losging, die Mädchen brachten es mit, die bei den hohen Offizieren bedienten.“"
                                            },
                                            {
                                                "example_id": "df3a05f1-9663-4a72-8533-d562ca2051d3",
                                                "sense_id": "0b0bc010-3e2d-3cea-a96a-0b906d0165ca",
                                                "text": "„Von dem Erfolg bei Kursk befeuert, war das sowjetische Oberkommando mit Zuversicht und Kühnheit zur Offensive übergegangen.“"
                                            },
                                            {
                                                "example_id": "44a19e6c-99cd-4d99-8293-b13b67d64a87",
                                                "sense_id": "0b0bc010-3e2d-3cea-a96a-0b906d0165ca",
                                                "text": "„Ich war nach Riga gefahren, um die Einzelheiten der nächsten Offensive zu besprechen, und hatte in dem aus amerikanischen Lustspielfilmen bekannten wackligen Fordwagen zwei Kameraden mitgenommen.“"
                                            },
                                            {
                                                "example_id": "9c86ae26-b5e0-4110-92f8-d6bcf36c2deb",
                                                "sense_id": "0b0bc010-3e2d-3cea-a96a-0b906d0165ca",
                                                "text": "„Am 10. Mai brach die deutsche Offensive los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aad8d7b4-aac7-3211-9e69-9a71f732c27b",
                                        "entry_id": "991b00f6-09c1-3c2b-873e-8baf789785e0",
                                        "glosses": [
                                            "entschlossener Einsatz; festes Vorhaben, etwas durchzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b39114-ce47-4482-a69d-fee63494bf04",
                                                "sense_id": "aad8d7b4-aac7-3211-9e69-9a71f732c27b",
                                                "text": "„Der tunesische Präsident Habib Bourguiba hat wieder einmal eine diplomatische Offensive gestartet, durch die er die Gründung eines ‚Staates Palästina‘ schmackhaft machen will.“"
                                            },
                                            {
                                                "example_id": "2aa37256-ae03-4635-aacc-4f057758dab4",
                                                "sense_id": "aad8d7b4-aac7-3211-9e69-9a71f732c27b",
                                                "text": "„Gleichzeitig begann er eine psychologische Offensive gegen die in der Sierra Maestra zusammengezogenen Armeetruppen.“"
                                            },
                                            {
                                                "example_id": "d7d1afc1-9dc7-40f6-bdc0-e75683c4ad46",
                                                "sense_id": "aad8d7b4-aac7-3211-9e69-9a71f732c27b",
                                                "text": "„Ich fragte mich mal wieder, wie das Leben wohl war, bevor die EU im Jahre 2002 ihre Offensive gegen die Tabakindustrie mit dem Verbot von Tabak-Werbung startete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56acf251-74e6-4813-b44c-dfbb0243ddd9",
                        "source_entry_id": "8e2ac708-43f1-375d-855c-38f707cc78a7",
                        "source_sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                        "target_lang_word": "offensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb56e515-69fe-3c17-9e98-e02334352389",
                                        "entry_id": "5bf27c41-5d99-3176-bb77-94ba021a265c",
                                        "glosses": [
                                            "Causing offense; arousing a visceral reaction of disgust, anger, hatred, sadness, or indignation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377f34ab-1dce-47e8-b32e-c98be8064d09",
                                                "sense_id": "bb56e515-69fe-3c17-9e98-e02334352389",
                                                "text": "Some people find pornography offensive."
                                            },
                                            {
                                                "example_id": "b83971eb-e2eb-4444-a710-b346a26d8705",
                                                "sense_id": "bb56e515-69fe-3c17-9e98-e02334352389",
                                                "text": "An offensive smell."
                                            },
                                            {
                                                "example_id": "956db94e-a36b-4bbb-909c-80d5267fc573",
                                                "sense_id": "bb56e515-69fe-3c17-9e98-e02334352389",
                                                "text": "A survey at Yale University had 63% of students wanting professors to issue “trigger warnings” before saying anything that some might find offensive or could cause painful emotions."
                                            },
                                            {
                                                "example_id": "2cb2c18d-4ffb-427d-ba77-109968c66929",
                                                "sense_id": "bb56e515-69fe-3c17-9e98-e02334352389",
                                                "text": "Britain’s police are especially zealous. Officers spend thousands of hours sifting through potentially offensive posts and arrest 30 people a day. Among those collared were a man who ranted about immigration on Facebook and a couple who criticised their daughter’s primary school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62177d67-d740-3090-8829-00aa5508a485",
                                        "entry_id": "5bf27c41-5d99-3176-bb77-94ba021a265c",
                                        "glosses": [
                                            "Relating to an offense or attack, as opposed to defensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8816a25a-d511-4a04-997e-20acf7b4ba4f",
                                                "sense_id": "62177d67-d740-3090-8829-00aa5508a485",
                                                "text": "The army's offensive capabilities. An offensive weapon."
                                            },
                                            {
                                                "example_id": "78c385b0-c487-4204-863a-dd6e6f3146f3",
                                                "sense_id": "62177d67-d740-3090-8829-00aa5508a485",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31b27cbf-1bbc-3dd0-8762-0dd51cc5ffb2",
                                        "entry_id": "5bf27c41-5d99-3176-bb77-94ba021a265c",
                                        "glosses": [
                                            "Having to do with play directed at scoring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0205613-dae3-4550-9bab-0d48b955be18",
                                                "sense_id": "31b27cbf-1bbc-3dd0-8762-0dd51cc5ffb2",
                                                "text": "The offensive coordinator is responsible for ordering all rushing plays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aefc1ddf-a8a3-318a-a63d-26f260163986",
                                        "entry_id": "79580623-5d20-3807-8b0b-07a1187335ad",
                                        "glosses": [
                                            "An attack."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac271f8a-027a-4d1d-8bf3-1025131d20f9",
                                                "sense_id": "aefc1ddf-a8a3-318a-a63d-26f260163986",
                                                "text": "The Marines today launched a major offensive."
                                            },
                                            {
                                                "example_id": "abfc06d0-9ace-43ae-aa20-f60ace2b9ddd",
                                                "sense_id": "aefc1ddf-a8a3-318a-a63d-26f260163986",
                                                "text": "In Central Hupeh, the Japanese launched another offensive from the Kingshan region, but instead of moving southwestward to cooperate with another column of theirs to capture Shasi, this column swerved to the northwest and succeeded in capturing Chunghsiang on the Han River."
                                            },
                                            {
                                                "example_id": "4af6ceb9-3dd9-413b-a498-87493fccf21a",
                                                "sense_id": "aefc1ddf-a8a3-318a-a63d-26f260163986",
                                                "text": "Israel has launched a major aerial and ground offensive into the occupied West Bank city of Jenin, its biggest military operation in the Palestinian territory in years, in what it described as an “extensive counter-terrorism effort”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc205e8-df02-36d0-a736-d2c1c8d60f4a",
                                        "entry_id": "79580623-5d20-3807-8b0b-07a1187335ad",
                                        "glosses": [
                                            "The posture of attacking or being able to attack."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a302c2d-7393-4754-9c9a-b5bb76c3ee5f",
                                                "sense_id": "abc205e8-df02-36d0-a736-d2c1c8d60f4a",
                                                "text": "He took the offensive in the press, accusing his opponent of corruption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
