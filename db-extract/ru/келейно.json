                "senses": [
                    {
                        "sense_id": "b87e5c5e-f418-303c-8b03-6bb1f7c82797",
                        "entry_id": "41cb1344-edec-31bf-92e8-5c9ea5dad743",
                        "glosses": [
                            "церк. у себя дома, не в церкви"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd221c88-6b15-44cd-a8aa-888b25a89ead",
                                "sense_id": "b87e5c5e-f418-303c-8b03-6bb1f7c82797",
                                "text": "По примеру прошлых лет надо бы утреню совершить келейно, а я понадеялся на свои силы и отправился в храм."
                            }
                        ]
                    },
                    {
                        "sense_id": "bce79dfa-36eb-3972-821f-67caa5d349d0",
                        "entry_id": "41cb1344-edec-31bf-92e8-5c9ea5dad743",
                        "glosses": [
                            "перен. скрыто, тайно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "662badc3-303d-43f1-81c5-2b2b59cb353b",
                                "sense_id": "bce79dfa-36eb-3972-821f-67caa5d349d0",
                                "text": "Председатель, казалось, уже был уведомлен Собакевичем о покупке, потому что принялся поздравлять, что сначала несколько смешало нашего героя, особливо когда он увидел, что и Собакевич и Манилов, оба продавцы, с которыми дело было улажено келейно, теперь стояли вместе лицом друг к другу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3be2f6b-2b20-4f0d-ac51-5677c7dc8db8",
                        "source_entry_id": "41cb1344-edec-31bf-92e8-5c9ea5dad743",
                        "target_lang_word": "secretly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
