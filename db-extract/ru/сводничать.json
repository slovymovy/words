                    }
                ],
                "senses": [
                    {
                        "sense_id": "021ab826-c386-3046-b1cc-a307c64c4373",
                        "entry_id": "68802d8e-0a9e-3164-a285-093b2ad8ded6",
                        "glosses": [
                            "быть посредником между двумя лицами, способствуя их вступлению во внебрачную половую связь; чаще всего — быть посредником между проституткой и клиентом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2022e87-ec30-4e2e-ae94-69c39ecbbb00",
                                "sense_id": "021ab826-c386-3046-b1cc-a307c64c4373",
                                "text": "В Америке я не был и тамошней проституции не знаю. Писать о том, чего не видал, не умею. Если же попаду когда-нибудь в Америку, то ― пожалуй, commère, с которою я теперь расстаюсь на 34-м её году от рождения, я застану там уже в том почтенном возрасте, когда женщинам её профессии, по их собственной поговорке, остаётся только Богу молиться да сводничать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "460ee233-fef3-41ed-924c-1991b72884d6",
                        "source_entry_id": "68802d8e-0a9e-3164-a285-093b2ad8ded6",
                        "source_sense_id": "021ab826-c386-3046-b1cc-a307c64c4373",
                        "target_lang_word": "procure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a561c6-4db4-3b48-8f03-e9ffa5c7f59c",
                                        "entry_id": "f1bca570-4128-36e4-b371-3de697642611",
                                        "glosses": [
                                            "To acquire or obtain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22fa3b54-c174-48b4-8ca9-a7707bf07f67",
                                                "sense_id": "b9a561c6-4db4-3b48-8f03-e9ffa5c7f59c",
                                                "text": "if we procure not to ourselves more woe"
                                            },
                                            {
                                                "example_id": "4af6f157-6632-464f-9858-6f228e0ede69",
                                                "sense_id": "b9a561c6-4db4-3b48-8f03-e9ffa5c7f59c",
                                                "text": "Later there would also be need for seeds and artificial manures, besides various tools and, finally, the machinery for the windmill. How these were to be procured, no one was able to imagine."
                                            },
                                            {
                                                "example_id": "2ae50044-f7ff-4113-b8d5-2d958ae7345d",
                                                "sense_id": "b9a561c6-4db4-3b48-8f03-e9ffa5c7f59c",
                                                "text": "Folkestone: Network Rail and the White Cliffs Countryside Project have procured a herd of goats to keep vegetation on the slopes of Folkestone Warren under control, and to encourage rare species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c665d092-fbaa-3e7a-a5e6-1356e9d49d0b",
                                        "entry_id": "f1bca570-4128-36e4-b371-3de697642611",
                                        "glosses": [
                                            "To obtain a person as a prostitute for somebody else."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46e2f3d5-2778-39aa-a859-872a4e29bceb",
                                        "entry_id": "f1bca570-4128-36e4-b371-3de697642611",
                                        "glosses": [
                                            "To induce or persuade someone to do something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f73d52e-b0c9-3c63-8a38-822a877d5baf",
                                        "entry_id": "f1bca570-4128-36e4-b371-3de697642611",
                                        "glosses": [
                                            "To contrive; to bring about; to effect; to cause."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7300acb7-f671-4fd4-8f15-9702b120d936",
                                                "sense_id": "9f73d52e-b0c9-3c63-8a38-822a877d5baf",
                                                "text": "By all means possible they procure to have gold and silver among them in reproach."
                                            },
                                            {
                                                "example_id": "f0d8e9ed-ea10-4916-8ce5-0666cd9b2544",
                                                "sense_id": "9f73d52e-b0c9-3c63-8a38-822a877d5baf",
                                                "text": "Proceed, Solinus, to procure my fall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbbd17ec-cc0c-373a-88cf-28fcce28db0f",
                                        "entry_id": "f1bca570-4128-36e4-b371-3de697642611",
                                        "glosses": [
                                            "To solicit; to entreat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a905cb-9c31-4e58-be8d-c6f28e339a2a",
                                                "sense_id": "dbbd17ec-cc0c-373a-88cf-28fcce28db0f",
                                                "text": "The famous Briton prince and faery knight, […] / Of the fair Alma greatly were procured / To make there lenger soiourne and abode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21b1350-0c4b-3994-b056-6343035f854a",
                                        "entry_id": "f1bca570-4128-36e4-b371-3de697642611",
                                        "glosses": [
                                            "To cause to come; to bring; to attract."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5114ed-0ae9-4253-9cc9-4f7d28ef5e71",
                                                "sense_id": "e21b1350-0c4b-3994-b056-6343035f854a",
                                                "text": "What unaccustomed cause procures her hither?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c640526f-fa42-462f-8625-fd0110834068",
                        "source_entry_id": "68802d8e-0a9e-3164-a285-093b2ad8ded6",
                        "source_sense_id": "021ab826-c386-3046-b1cc-a307c64c4373",
                        "target_lang_word": "pander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b61a53f-aa5b-3cc1-8bcc-4ebdbb646549",
                                        "entry_id": "8378c9aa-5f5a-3a16-9f9c-1bc75cf1de61",
                                        "glosses": [
                                            "A person who furthers the illicit love-affairs of others; a pimp or procurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47fe358a-4690-4833-b768-6be58975150b",
                                                "sense_id": "0b61a53f-aa5b-3cc1-8bcc-4ebdbb646549",
                                                "text": "[…] if ever you prove false one, to another since I have taken such paine to bring you together let all pittifull goers betweene be cald to the worlds end after my name, call them all Panders, let all constant men be Troylusses all false woemen Cressids, and all brokers betweene panders"
                                            },
                                            {
                                                "example_id": "648ed00c-3559-4630-b10b-0180a5442e81",
                                                "sense_id": "0b61a53f-aa5b-3cc1-8bcc-4ebdbb646549",
                                                "text": "It was not only the brilliant phalanx of virtuous dowagers, generals and academicians with whom he was most intimately associated that Swann so cynically compelled to serve him as panders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e1050f5-6b51-3ed4-934f-59417fca9818",
                                        "entry_id": "8378c9aa-5f5a-3a16-9f9c-1bc75cf1de61",
                                        "glosses": [
                                            "An offer of illicit sex with a third party."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa366781-3095-389d-8f5e-02b9fa114ff2",
                                        "entry_id": "8378c9aa-5f5a-3a16-9f9c-1bc75cf1de61",
                                        "glosses": [
                                            "An illicit or illegal offer, usually to tempt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "311f45b9-241a-37b9-8e3d-8e1e0809b84c",
                                        "entry_id": "8378c9aa-5f5a-3a16-9f9c-1bc75cf1de61",
                                        "glosses": [
                                            "One who ministers to the evil designs and passions of another."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da64f59-2cee-415f-806e-f622b19c1ec4",
                                                "sense_id": "311f45b9-241a-37b9-8e3d-8e1e0809b84c",
                                                "text": "Camillo was his helpe in this, his Pandar:\nThere is a Plot against my Life, my Crowne;\nAll's true that is mistrusted: that false Villaine,\nWhom I employ'd, was pre-emplot'd"
                                            },
                                            {
                                                "example_id": "1ea3e082-ea59-4130-9ddb-04228c5344d4",
                                                "sense_id": "311f45b9-241a-37b9-8e3d-8e1e0809b84c",
                                                "text": "Those wicked panders to avarice and ambition."
                                            },
                                            {
                                                "example_id": "518b0918-beed-441c-972f-9f0b6429a20d",
                                                "sense_id": "311f45b9-241a-37b9-8e3d-8e1e0809b84c",
                                                "text": "Two small Hindu boys were waiting for me outside—small for their years (about fourteen) but infinitely worldly-wise. Hindu boys are, first, panders, and second, remarkably skillful and pertinacious beggars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53d543a0-8a99-342b-8bf0-5716eab74d9b",
                                        "entry_id": "a6862746-b9ac-3c61-bcf5-194dbce18a11",
                                        "glosses": [
                                            "To tempt with, to appeal or cater to (improper motivations, etc.); to assist in gratification."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "017358cd-9ec0-45da-841b-3924a5da9244",
                                                "sense_id": "53d543a0-8a99-342b-8bf0-5716eab74d9b",
                                                "text": "His latest speech panders to the worst instincts of the electorate."
                                            },
                                            {
                                                "example_id": "ac87393c-c059-4374-b8e2-60005c14b69a",
                                                "sense_id": "53d543a0-8a99-342b-8bf0-5716eab74d9b",
                                                "text": "[...] both the Conservatives and Labour are guilty of pandering to the road lobby at the time of Beeching's The Reshaping of Britain's Railways report published in 1963."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "658b5998-ea30-312e-8a82-382e47116139",
                                        "entry_id": "a6862746-b9ac-3c61-bcf5-194dbce18a11",
                                        "glosses": [
                                            "To offer (something or someone) in order to tempt or appeal, especially to base or improper motivations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "febabe40-5935-4795-948e-792f74d754ec",
                                                "sense_id": "658b5998-ea30-312e-8a82-382e47116139",
                                                "text": "Who knows what Brill really thought? But he pandered the rumor linking Spear to a whole string of dastardly deeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae09c0c7-7886-31f5-822e-513d5feb5d2d",
                                        "entry_id": "a6862746-b9ac-3c61-bcf5-194dbce18a11",
                                        "glosses": [
                                            "To offer illicit sex with a third party; to pimp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a665b81d-6eac-323a-a116-17a2486ec87d",
                                        "entry_id": "a6862746-b9ac-3c61-bcf5-194dbce18a11",
                                        "glosses": [
                                            "To act as a pander for (somebody)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
