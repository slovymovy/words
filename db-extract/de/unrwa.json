                "senses": [
                    {
                        "sense_id": "224d4593-dd72-3acf-8845-a54ad7fd58bd",
                        "entry_id": "a7da4ae4-27dc-3604-8a8b-15b4f8b4be7a",
                        "glosses": [
                            "Hilfsprogramm der Vereinten Nationen für palästinensische Flüchtlinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef64eb19-9f22-4147-9bcc-f65b5dfbc908",
                                "sense_id": "224d4593-dd72-3acf-8845-a54ad7fd58bd",
                                "text": "„Die UNRWA sollte sich also allgemein um die Alltagsbelange der Flüchtlinge kümmern.“"
                            },
                            {
                                "example_id": "e6c4dd4e-72d0-4b27-8622-ce094c99cc41",
                                "sense_id": "224d4593-dd72-3acf-8845-a54ad7fd58bd",
                                "text": "„Als Endokrinologin und alleinerziehende Mutter von einundfünfzig Jahren führte sie eine mobile Krankenstation der UNRWA, des Hilfswerks der Vereinten Nationen für Palästina-Flüchtlinge im Nahen Osten.“"
                            },
                            {
                                "example_id": "9c447560-e743-433b-9e21-eb96823430ff",
                                "sense_id": "224d4593-dd72-3acf-8845-a54ad7fd58bd",
                                "text": "„Seit 2018 hat die UNRWA die Zahlen für die registrierten Flüchtlinge und Personen in den Flüchtlingslagern nicht mehr ausgewiesen, da sie nicht mehr der Realität entsprachen, vor allem aufgrund der Zerstörung der Lager in Syrien.“"
                            },
                            {
                                "example_id": "1baafd42-111b-4175-be2c-762633baa46b",
                                "sense_id": "224d4593-dd72-3acf-8845-a54ad7fd58bd",
                                "text": "„Angegriffen wurde aber auch das kleine palästinensische Flüchtlingslager Wavel, wo neben zahlreichen Häusern auch die vollbesetzte Al-Qastel-Schule des UN-Palästina-Hilfswerks UNRWA und eine Moschee massiv getroffen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
