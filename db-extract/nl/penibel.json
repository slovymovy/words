                                        "examples": [
                                            {
                                                "example_id": "de9dbf8c-cffc-4f05-baac-58fe6b8f36c1",
                                                "sense_id": "7abde5c0-d684-3191-b530-740eaad17a3f",
                                                "text": "The second undamped system criticals show a greater percentage depression than the first."
                                            },
