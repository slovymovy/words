{
    "word_family": [
        "brassy",
        "brazen",
        "brassware"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8fcc7a24-1190-3959-a5f3-0d7536bba7f3",
                    "sense_definition": "A yellow metallic alloy of copper and zinc, used for making musical instruments, ornaments, and fittings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique door handle was made of solid <w>brass</w> and felt very heavy.",
                            "target_lang_translations": {
                                "ru": "Старинная дверная ручка была сделана из цельной <w>латуни</w> и казалась очень тяжелой.",
                                "zh": "那个古董门把手是用实心<w>黄铜</w>做的，拿起来很沉。"
                            }
                        },
                        {
                            "text": "She spent the whole afternoon polishing the <w>brass</w> until it shined like gold.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день, полируя <w>латунь</w>, пока та не засияла как золото.",
                                "zh": "她整个下午都在擦拭<w>黄铜</w>，直到它亮得像金子一样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "solid brass",
                        "brass fittings",
                        "polished brass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтый металлический сплав меди и цинка, используемый для изготовления музыкальных инструментов, украшений и фурнитуры.",
                        "zh": "一种黄色的铜锌合金，常用于制作乐器、装饰品和五金配件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латунь",
                                "target_lang_sense_clarification": "сплав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄铜",
                                "target_lang_sense_clarification": "铜锌合金，这个词最常用的意思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba5cadd3-a28e-3009-baf1-ed841e14a9bb",
                    "sense_definition": "A class of wind instruments made of metal, such as trumpets, trombones, and tubas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>brass</w> section of the orchestra played a loud and triumphant fanfare.",
                            "target_lang_translations": {
                                "ru": "Секция <w>медных духовых</w> оркестра сыграла громкую и торжествующую фанфару.",
                                "zh": "管弦乐队的<w>铜管声部</w>奏起了响亮而雄壮的号角曲。"
                            }
                        },
                        {
                            "text": "He has played in a local <w>brass</w> band since he was a child.",
                            "target_lang_translations": {
                                "ru": "Он играл в местном <w>духовом</w> оркестре с самого детства.",
                                "zh": "他从小就在当地的<w>铜管乐队</w>里演奏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brass band",
                        "brass section",
                        "brass instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класс духовых инструментов, изготовленных из металла, таких как трубы, тромбоны и тубы.",
                        "zh": "指由小号、长号、大号等金属吹奏乐器组成的一类乐器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медные духовые инструменты",
                                "target_lang_sense_clarification": "группа инструментов"
                            },
                            {
                                "target_lang_word": "медь",
                                "target_lang_sense_clarification": "музыкальный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜管乐器",
                                "target_lang_sense_clarification": "这类金属吹奏乐器的总称"
                            },
                            {
                                "target_lang_word": "铜管声部",
                                "target_lang_sense_clarification": "在管弦乐队中的铜管组"
                            },
                            {
                                "target_lang_word": "铜管乐队",
                                "target_lang_sense_clarification": "主要由铜管乐器组成的乐队"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef157ef-ea4f-36eb-8750-1cdd6e1c732d",
                    "sense_definition": "High-ranking officers in the military or senior executives in an organization.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "people_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The top <w>brass</w> are meeting today to decide on the new company strategy.",
                            "target_lang_translations": {
                                "ru": "Высшее <w>начальство</w> встречается сегодня, чтобы принять решение о новой стратегии компании.",
                                "zh": "公司的<w>高层</w>今天正在开会，决定新的公司战略。"
                            }
                        },
                        {
                            "text": "We need to get approval from the <w>brass</w> before we can proceed with the operation.",
                            "target_lang_translations": {
                                "ru": "Нам нужно получить одобрение от <w>начальства</w>, прежде чем мы сможем продолжить операцию.",
                                "zh": "我们得先得到<w>上级</w>的批准，才能继续这次行动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top brass",
                        "military brass"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокопоставленные офицеры в армии или высшее руководство в организации.",
                        "zh": "指军队中的高级军官，或机构、公司中的高层领导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начальство",
                                "target_lang_sense_clarification": "руководство"
                            },
                            {
                                "target_lang_word": "верхушка",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "высшее командование",
                                "target_lang_sense_clarification": "воен."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高层",
                                "target_lang_sense_clarification": "组织中的高层管理者"
                            },
                            {
                                "target_lang_word": "上级",
                                "target_lang_sense_clarification": "上面负责拍板的人"
                            },
                            {
                                "target_lang_word": "高层领导",
                                "target_lang_sense_clarification": "较正式，指军队或机构的高级领导"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a4a2f59-0d61-3adb-9981-92293be0593f",
                    "sense_definition": "Excessive self-confidence, impudence, or effrontery.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe he had the <w>brass</w> to ask for a promotion after missing so much work.",
                            "target_lang_translations": {
                                "ru": "Я не могу поверить, что ему хватило <w>наглости</w> просить о повышении после стольких пропусков работы.",
                                "zh": "真不敢相信，他缺勤了这么多次以后竟还有这种<w>厚脸皮</w>去要求升职。"
                            }
                        },
                        {
                            "text": "You have got a lot of <w>brass</w> showing your face here after what you did.",
                            "target_lang_translations": {
                                "ru": "У тебя много <w>нахальства</w>, раз ты показался здесь после того, что сделал.",
                                "zh": "你做了那种事以后还敢来这里，真够<w>厚脸皮</w>的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have the brass",
                        "bold as brass"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерная самоуверенность, наглость или бесстыдство.",
                        "zh": "过分自信、无礼或厚颜无耻的态度；也就是“竟敢”的那种胆大无耻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "поведение"
                            },
                            {
                                "target_lang_word": "нахальство",
                                "target_lang_sense_clarification": "поведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厚脸皮",
                                "target_lang_sense_clarification": "口语，指不知羞耻的大胆"
                            },
                            {
                                "target_lang_word": "无耻",
                                "target_lang_sense_clarification": "较书面，指无耻和冒犯人的大胆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e2a7c5-8b80-34e5-9c1c-2651126cd493",
                    "sense_definition": "Money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has plenty of <w>brass</w> to spend on fancy cars and expensive clothes.",
                            "target_lang_translations": {
                                "ru": "У него куча <w>денег</w> на модные машины и дорогую одежду.",
                                "zh": "他有的是<w>钱</w>，可以买豪车和昂贵的衣服。"
                            }
                        },
                        {
                            "text": "Where there is muck, there is <w>brass</w>, as the old saying goes.",
                            "target_lang_translations": {
                                "ru": "Где грязь, там и <w>деньги</w>, как гласит старая поговорка.",
                                "zh": "老话说得好：哪里有脏活，哪里就有<w>钱</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Northern English"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги.",
                        "zh": "钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деньги",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钱",
                                "target_lang_sense_clarification": "一般说法"
                            },
                            {
                                "target_lang_word": "钞票",
                                "target_lang_sense_clarification": "口语一些"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0041b39-0a7b-39bc-94aa-215a575cd427",
                    "sense_definition": "Spent cartridge casings left over after bullets have been fired.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the shooting practice, the recruits had to pick up all the <w>brass</w> from the floor.",
                            "target_lang_translations": {
                                "ru": "После стрельб новобранцам пришлось собрать все <w>гильзы</w> с пола.",
                                "zh": "射击训练结束后，新兵们得把地上所有的<w>弹壳</w>都捡起来。"
                            }
                        },
                        {
                            "text": "The police found several pieces of <w>brass</w> at the scene of the crime.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла несколько <w>гильз</w> на месте преступления.",
                                "zh": "警方在犯罪现场发现了几个<w>弹壳</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick up brass"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "military or technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стреляные гильзы, оставшиеся после выстрелов.",
                        "zh": "子弹射出后留下的弹壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гильзы",
                                "target_lang_sense_clarification": "стреляные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹壳",
                                "target_lang_sense_clarification": "射击后留下的弹药外壳"
                            },
                            {
                                "target_lang_word": "空弹壳",
                                "target_lang_sense_clarification": "强调是打过后的壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e499a3e-76a7-35fc-af27-17d5ac8979f6",
                    "sense_definition": "A prostitute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old neighborhood has changed, and you rarely see a <w>brass</w> on the corner anymore.",
                            "target_lang_translations": {
                                "ru": "Старый район изменился, и теперь редко увидишь <w>проститутку</w> на углу.",
                                "zh": "老街区已经变了，现在几乎看不到街角站着的<w>妓女</w>了。"
                            }
                        },
                        {
                            "text": "He used a derogatory slang term, calling the woman a <w>brass</w>.",
                            "target_lang_translations": {
                                "ru": "Он использовал унизительный сленговый термин, назвав женщину <w>шлюхой</w>.",
                                "zh": "他用了一个带侮辱性的俚语，骂那个女人是<w>婊子</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British, Cockney rhyming slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проститутка.",
                        "zh": "妓女；这是带有侮辱性的俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проститутка",
                                "target_lang_sense_clarification": "прямое значение"
                            },
                            {
                                "target_lang_word": "шлюха",
                                "target_lang_sense_clarification": "грубое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妓女",
                                "target_lang_sense_clarification": "中性直白说法"
                            },
                            {
                                "target_lang_word": "婊子",
                                "target_lang_sense_clarification": "粗俗侮辱性说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99350bf8-aae5-39b7-ac1a-f9ae082246ba",
                    "sense_definition": "Made of or resembling the metal alloy brass.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "material_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a beautiful <w>brass</w> candlestick at the market.",
                            "target_lang_translations": {
                                "ru": "Она купила красивый <w>латунный</w> подсвечник на рынке.",
                                "zh": "她在市场上买了一个漂亮的<w>黄铜制的</w>烛台。"
                            }
                        },
                        {
                            "text": "The captain wore a coat with shiny <w>brass</w> buttons.",
                            "target_lang_translations": {
                                "ru": "Капитан носил пальто с блестящими <w>латунными</w> пуговицами.",
                                "zh": "船长穿着一件带闪亮<w>黄铜的</w>纽扣的外套。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brass button",
                        "brass plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из латуни или напоминающий этот металлический сплав.",
                        "zh": "由黄铜做成的，或外观看起来像黄铜的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латунный",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄铜的",
                                "target_lang_sense_clarification": "表示材质是黄铜"
                            },
                            {
                                "target_lang_word": "黄铜制的",
                                "target_lang_sense_clarification": "强调由黄铜制成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c640140d-4f9b-350e-a088-01cab958a1ab",
                    "sense_definition": "Having the bright yellow color of brass.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky turned a strange <w>brass</w> color before the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Небо приобрело странный <w>латунный</w> цвет перед началом шторма.",
                                "zh": "暴风雨来临前，天空变成了一种奇怪的<w>黄铜色</w>。"
                            }
                        },
                        {
                            "text": "Her hair was dyed a harsh, <w>brass</w> shade of blonde.",
                            "target_lang_translations": {
                                "ru": "Ее волосы были покрашены в резкий <w>латунный</w> оттенок блонда.",
                                "zh": "她把头发染成了一种刺眼的<w>黄铜色</w>金发。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий ярко-желтый цвет латуни.",
                        "zh": "具有黄铜那种明亮的黄颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латунный",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "цвета латуни",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄铜色",
                                "target_lang_sense_clarification": "像黄铜一样的亮黄色"
                            },
                            {
                                "target_lang_word": "黄铜色的",
                                "target_lang_sense_clarification": "作定语时更自然"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "737e4efa-2757-3f85-9bd9-baa9f431a2eb",
                    "sense_definition": "Impertinent, bold, or brazen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>brass</w> enough to ask for a refund even though he had broken the item himself.",
                            "target_lang_translations": {
                                "ru": "Он был достаточно <w>нагл</w>, чтобы попросить возврат денег, хотя сам сломал вещь.",
                                "zh": "东西明明是他自己弄坏的，他竟然还<w>厚脸皮</w>到要求退款。"
                            }
                        },
                        {
                            "text": "It was a very <w>brass</w> move to challenge the director in front of the whole board.",
                            "target_lang_translations": {
                                "ru": "Это был очень <w>дерзкий</w> поступок — бросить вызов директору перед всем советом.",
                                "zh": "当着整个董事会的面质疑主管，这是非常<w>放肆</w>的举动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наглый, дерзкий или бесстыжий.",
                        "zh": "无礼的、厚颜的、恬不知耻的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглый",
                                "target_lang_sense_clarification": "характер"
                            },
                            {
                                "target_lang_word": "бесстыжий",
                                "target_lang_sense_clarification": "характер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厚脸皮",
                                "target_lang_sense_clarification": "口语，指人无礼又不知羞"
                            },
                            {
                                "target_lang_word": "放肆",
                                "target_lang_sense_clarification": "指举动大胆而无礼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64ed7012-5672-3242-97cf-10363f7045c9",
