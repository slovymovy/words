        "fr-extract.jsonl": [
            {
                "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                "word": "plonge",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3f2288ae-d386-4fc9-89d7-fbf179d743fb",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "tags": [
                            "plural"
                        ],
                        "form": "plonges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e837182-8516-3348-9a2f-df38c06f6faa",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "glosses": [
                            "Fait de plonger quelque chose dans l’eau ou dans un liquide."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "acfa4363-6237-42f8-9465-baef43a39777",
                                "sense_id": "3e837182-8516-3348-9a2f-df38c06f6faa",
                                "text": "La position de la cloison règle la hauteur de plonge des tuyaux plongeurs."
                            },
                            {
                                "example_id": "b5dfb5ee-4570-4ced-84e4-cde06487286b",
                                "sense_id": "3e837182-8516-3348-9a2f-df38c06f6faa",
                                "text": "[…] je décidai de passer l'après midi avec eux, d'étudier leurs méthodes de plonge et de prendre plusieurs films."
                            }
                        ]
                    },
                    {
                        "sense_id": "18bfb23e-fb1f-3567-9625-84a2f2ca768f",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "glosses": [
                            "Lieu où se fait cette plongée."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c99c5a21-3d04-3614-a0fc-e1329dff881a",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "glosses": [
                            "Période où se fait cette plongée."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ce061709-1c6f-497e-86ee-287d8f1f1acf",
                                "sense_id": "c99c5a21-3d04-3614-a0fc-e1329dff881a",
                                "text": "Aussi, en me promettant de revenir, quelques années plus tard, au moment de la plonge, je mis mon berthon à la mer et me dirigeai vers Rikitea […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "910ac8ba-1f96-3f31-8e50-3420c34dd58f",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "glosses": [
                            "Lavage de la vaisselle dans un restaurant ou une cantine."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "24cd279f-91ea-4733-af49-0a948629d646",
                                "sense_id": "910ac8ba-1f96-3f31-8e50-3420c34dd58f",
                                "text": "— Nous ne sommes peut-être pas riches, mais tu ne vas pas aller faire la plonge comme si nous étions à la misère, non !"
                            },
                            {
                                "example_id": "0488572f-1690-4a90-81bc-586b26bff4e2",
                                "sense_id": "910ac8ba-1f96-3f31-8e50-3420c34dd58f",
                                "text": "Les quelques Africains que je rencontre font la plonge dans les restaurants ou vendent des bibelots aux vacanciers, qui s’habituent à leur petite approche de séduction."
                            },
                            {
                                "example_id": "ad7a40c7-84bd-46e7-8f2f-0166c25a4d8a",
                                "sense_id": "910ac8ba-1f96-3f31-8e50-3420c34dd58f",
                                "text": "Missions :\nVeiller à l’entretien des équipements (petite plonge, grosse plonge)\nGarantir le respect des règles d’hygiène et de sécurité Club Med ainsi que l’entretien du patrimoine"
                            },
                            {
                                "example_id": "ef85868e-0636-47e3-b925-135d55b484b6",
                                "sense_id": "910ac8ba-1f96-3f31-8e50-3420c34dd58f",
                                "text": "Nous proposons aussi les équipements de lavage les moins chers pour les professionnels installés, les plus exigeants, qui connaissent bien la problématique de la plonge et qui recherchent un lave vaisselle performant, fiable et économique à l’usage"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c0709dc-81be-36bf-8349-b99ed5295ff6",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "glosses": [
                            "Lieu où on fait la vaisselle dans un restaurant."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "48d6157e-adb7-4bdb-b124-400e04a22cdb",
                                "sense_id": "1c0709dc-81be-36bf-8349-b99ed5295ff6",
                                "text": "Cette catégorie d’établissements a d’ailleurs accru de 21 % en un an ses effectifs à la plonge, alors que la rémunération grimpait de 12% en moyenne."
                            }
                        ]
                    },
                    {
                        "sense_id": "5af0748e-3a37-367c-807a-2255a3dde0ca",
                        "entry_id": "7c087aa0-f4bd-3180-ad57-2a590b1f4eaf",
                        "glosses": [
                            "Mobilier pour laver la vaisselle en restauration."
                        ],
                        "tags": [
                            "metonymically",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "03698066-3c33-4f65-90ef-1e6ed1163ede",
                                "sense_id": "5af0748e-3a37-367c-807a-2255a3dde0ca",
                                "text": "Plonge (entre autres : meubles plonge, meubles plonge spécial lave-vaisselle, accessoires...)"
                            },
                            {
                                "example_id": "ad38fcdb-774c-4960-afd8-13d06bce4f03",
                                "sense_id": "5af0748e-3a37-367c-807a-2255a3dde0ca",
                                "text": "Le gros type solitaire, un torchon à la main, une main large comme un battoir, essuyait distraitement le dessus du bar et laissait glisser des verres dans la plonge de métal inoxydable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
