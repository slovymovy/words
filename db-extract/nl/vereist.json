                "senses": [
                    {
                        "sense_id": "dba329f1-05c2-3bb6-ad5a-dac9190926ff",
                        "entry_id": "f8247dc7-68b6-3bfe-9fce-11db0d3dd0b9",
                        "glosses": [
                            "benodigd, noodzakelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e6dcea-eec4-4b8a-a934-950fccbb4388",
                                "sense_id": "dba329f1-05c2-3bb6-ad5a-dac9190926ff",
                                "text": "Een aanwezigheidsquorum van tweederde van de leden is vereist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3017e48-34be-4d8b-acd2-30366f7f011e",
                        "source_entry_id": "f8247dc7-68b6-3bfe-9fce-11db0d3dd0b9",
                        "source_sense_id": "dba329f1-05c2-3bb6-ad5a-dac9190926ff",
                        "source_sense_description": "benodigd, noodzakelijk",
                        "target_lang_word": "erforderlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erforderlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                        "entry_id": "9426be6e-4d17-367f-8feb-24240517da79",
                                        "glosses": [
                                            "jemand/etwas ist nötig, wird gebraucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c13ed30c-54b9-48c4-8aa3-66f8bcd1670c",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "Es sind noch zwei Eier erforderlich, damit der Teig weicher wird."
                                            },
                                            {
                                                "example_id": "70542a2e-76d0-4dcd-ad0b-02d11afa5848",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "Für den Eintritt in den Staatsdienst sind zwei mindestens mit vollbefriedigend bestandene juristische Staatsexamina erforderlich."
                                            },
                                            {
                                                "example_id": "20b46f15-8726-4c6a-9264-9249febc9aa2",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Darf ein Staat notfalls Unschuldige opfern, wenn dies zur Terrorabwehr erforderlich ist?“"
                                            },
                                            {
                                                "example_id": "b54750fe-b72b-467a-8e90-96db557a4fe5",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Auch eine Unfallversicherung kann sinnvoll sein, für extravagante Hobbys wie Fallschirmspringen oder Extrembergsteigen sind allerdings Zusatzdeckungen erforderlich.“"
                                            },
                                            {
                                                "example_id": "98b36ad0-90d7-4468-ae14-4fc75890efd6",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Mehrperspektivische Betrachtungsweisen werden erforderlich, um dem Phänomenkomplex gerecht werden zu können.“"
                                            },
                                            {
                                                "example_id": "0b486751-5c86-4a45-b8a9-6f73e1df919c",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Sand und Heide erwärmen sich bei Sonneneinstrahlung schnell und geben die Wärme in Form der für den Segelflug erforderlichen Thermik wieder ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
