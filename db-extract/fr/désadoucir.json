                "senses": [
                    {
                        "sense_id": "2b1e7ed8-98f9-3a51-ab38-2615ea644842",
                        "entry_id": "af3db9a9-4d8b-3e7f-af43-feea82b4a573",
                        "glosses": [
                            "Rendre moins doux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58b9bf80-5970-443c-a6d9-f7296fdcdf64",
                                "sense_id": "2b1e7ed8-98f9-3a51-ab38-2615ea644842",
                                "text": "Si vous constatez que vous avez trop adouci un bord de sélection, vous pouvez le désadoucir avec l’outil désadoucir."
                            },
                            {
                                "example_id": "960e83b1-2640-4df8-9767-71b5965c4182",
                                "sense_id": "2b1e7ed8-98f9-3a51-ab38-2615ea644842",
                                "text": "Je commençais à me désadoucir."
                            },
                            {
                                "example_id": "9cf4c749-1e83-44f2-b6a5-d6bff9ed1af6",
                                "sense_id": "2b1e7ed8-98f9-3a51-ab38-2615ea644842",
                                "text": "Insensiblement, la température se laisse façonner par l’averse devenue pénétrante et par le vent désadouci."
                            }
                        ]
                    }
