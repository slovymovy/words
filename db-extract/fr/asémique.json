                        "sense_id": "f7d4b228-87a1-3f9e-9bd4-f600404b0f3b",
                        "entry_id": "23c10591-6310-3c46-9c2e-87944be92cde",
                        "glosses": [
                            "Dénué de contenu sémantique, dénué de signification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae52f121-b09b-4677-84b0-47299a4c5da5",
                                "sense_id": "f7d4b228-87a1-3f9e-9bd4-f600404b0f3b",
                                "text": "C’est donc par opposition au son indivisible et au son asémique (syllabe, article, conjonction) que le nom est défini comme son complexe doté de signification."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f31891f-5457-4d6f-8962-ceb5468a0b1f",
                        "source_entry_id": "23c10591-6310-3c46-9c2e-87944be92cde",
                        "target_lang_word": "asemic",
                        "target_lang_code": "en",
