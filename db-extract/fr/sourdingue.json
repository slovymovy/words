                                                "sense_id": "0a807d31-90bf-31f9-aae8-6b11defb2a3f",
                                                "text": "Er ist von Geburt an taub"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f4efb4e-1fbd-30f8-9488-666a5b0b4a5d",
                                        "entry_id": "e661deee-6e5d-39c8-8318-c05847fadec8",
                                        "glosses": [
                                            "für einen Moment schlechter oder nicht hörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0999f07e-938e-4e4e-ad11-c8dda906401d",
                                                "sense_id": "7f4efb4e-1fbd-30f8-9488-666a5b0b4a5d",
                                                "text": "Nach dem lauten Konzert war ich ganz schön taub."
                                            },
                                            {
                                                "example_id": "96fefd22-5b5f-47ed-935c-ff4990be8294",
                                                "sense_id": "7f4efb4e-1fbd-30f8-9488-666a5b0b4a5d",
                                                "text": "«He! Bist du taub? Ob du würfeln willst, hab ich gefragt!»"
                                            },
                                            {
                                                "example_id": "6665ea34-8c07-4c8e-86b8-83e01c65b9df",
                                                "sense_id": "7f4efb4e-1fbd-30f8-9488-666a5b0b4a5d",
                                                "text": "Wo – ich bin ganz taub von dem Rattern … George hält den Spiegel zwischen den schmalen grauen Handschuh-Händen und sieht sorgenvoll hinein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ee28cac5-b8c8-30e3-b1ee-e73d37774ad0",
                                        "entry_id": "e661deee-6e5d-39c8-8318-c05847fadec8",
                                        "glosses": [
                                            "empfindungslos, gefühllos, betäubt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba55970-4b9d-415c-acd4-4204cd54a066",
                                                "sense_id": "ee28cac5-b8c8-30e3-b1ee-e73d37774ad0",
                                                "text": "Sein Bein fühlt sich seit dem Unfall taub an."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5a4fa5ba-30f3-3cb7-897c-62e1851df946",
                                        "entry_id": "e661deee-6e5d-39c8-8318-c05847fadec8",
                                        "glosses": [
                                            "eine Identität als taube Person habend, der Taubenkultur zugehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e794d534-cec9-420b-a4d6-c655edbdc048",
                                                "sense_id": "5a4fa5ba-30f3-3cb7-897c-62e1851df946",
                                                "text": "Ich bin taub. Ich habe eine taube Identität. Das ist eine taube Welt."
                                            },
                                            {
                                                "example_id": "e12c44f8-4609-4aab-aede-9838c74b69d3",
                                                "sense_id": "5a4fa5ba-30f3-3cb7-897c-62e1851df946",
                                                "text": "„Im Konzept der Deaf Ethnicity definieren Ladd und Lane (2014) die Gehörlosengemeinschaft als ethnische Gruppe, denn „… Sprache, Bindung an seinesgleichen, Kultur, soziale Institutionen und die Aufrechterhaltung der Grenzen nach außen“ (42) sind Kriterien, die eine taube Gruppenidentität schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "56032927-b786-3f4f-9f89-422c17b24fc0",
                                        "entry_id": "e661deee-6e5d-39c8-8318-c05847fadec8",
                                        "glosses": [
                                            "leer im Kopf, die üblichen Erwartungen nicht erfüllend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d3110a-dd7c-4351-a41f-b68967973555",
                                                "sense_id": "56032927-b786-3f4f-9f89-422c17b24fc0",
                                                "text": "Er ist eine taube Nuss."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "84d44229-987a-3cd5-a338-ca644fd2389d",
                                        "entry_id": "e661deee-6e5d-39c8-8318-c05847fadec8",
                                        "glosses": [
                                            "ohne nützlichen Inhalt"
                                        ],
                                        "tags": [
                                            "Bergbau",
                                            "vom Gestein",
                                            "Erz oder von anderen Rohstoffen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac26f06-64bd-4305-aa24-90a0994a1227",
                                                "sense_id": "84d44229-987a-3cd5-a338-ca644fd2389d",
                                                "text": "Die aus der Mine geförderten Steine waren alle taub."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "866c2eb6-6969-3544-b78b-67691141b84a",
                                        "entry_id": "e661deee-6e5d-39c8-8318-c05847fadec8",
                                        "glosses": [
