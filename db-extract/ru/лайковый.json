                                                "example_id": "42fb9015-a6a0-4d16-b04d-aa80a8433aed",
                                                "sense_id": "9ba1dde3-14c1-3c4e-9fa4-273bcce00226",
                                                "text": "I'm only kidding!"
                                            },
                                            {
                                                "example_id": "9587ad53-076e-4b37-be78-8833b669b7c4",
                                                "sense_id": "9ba1dde3-14c1-3c4e-9fa4-273bcce00226",
                                                "text": "No kidding!"
