                "senses": [
                    {
                        "sense_id": "7b8dad1e-1b95-37fe-81ed-58824c5d8acf",
                        "entry_id": "73dc8ddb-a4a9-3597-9e8d-1bfe163f9429",
                        "glosses": [
                            "Mord, der mittels Folter erfolgt ist"
                        ],
                        "tags": [
                            "Kriminalität"
                        ],
                        "examples": [
                            {
                                "example_id": "cc80f615-3d21-479d-9dfe-cf9a8547a2e2",
                                "sense_id": "7b8dad1e-1b95-37fe-81ed-58824c5d8acf",
                                "text": "„Schauprozess in Teheran, Vergewaltigungen in den Gefängnissen, ungeklärte Foltermorde von Häftlingen – der neue Justizchef des Iran tritt sein Amt an während der schwersten Krise der Islamischen Republik seit ihrer Gründung.“"
                            },
                            {
                                "example_id": "c3f3eba0-27c9-4942-9171-eedb30ed222f",
                                "sense_id": "7b8dad1e-1b95-37fe-81ed-58824c5d8acf",
                                "text": "„Der Fall erinnert an den Foltermord in der nordrhein-westfälischen Haftanstalt Siegburg.“"
                            },
                            {
                                "example_id": "c5d42592-f462-4d0e-aa30-38a3c0dac7bb",
                                "sense_id": "7b8dad1e-1b95-37fe-81ed-58824c5d8acf",
                                "text": "„Der Kripo wird schnell klar, dass bei diesem Foltermord ein Profi am Werk war, der sein grausames Handwerk perfekt beherrscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
