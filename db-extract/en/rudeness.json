    "word": "rudeness",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                "word": "rudeness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "747cbc77-ad6a-41d7-a65b-1e574036a40c",
                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                        "tags": [
                            "plural"
                        ],
                        "form": "rudenesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                        "glosses": [
                            "The property of being rude."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "42eb88f4-086a-4f56-b6fa-59ec8f692701",
                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                "text": "His rudeness was inexcusable."
                            },
                            {
                                "example_id": "46cde39f-45b4-4e68-9e66-24bd843d8d29",
                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                "text": "The rudeness of the cabin gave it a rustic charm but little comfort."
                            },
                            {
                                "example_id": "e833ba91-26f7-4879-87c3-1d4c4a3e8e16",
                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                "text": "The house was apparently very old; it had an almost prehistoric look about it, so rude and weatherbeaten was it, but the rudeness of the masonry and the lichening of the stones were no real indications of antiquity […]"
                            },
                            {
                                "example_id": "e4afbf98-c900-4029-988c-7bdc0b17f05e",
                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                "text": "The woman who deliberately yelled out in the second set, when Henin was about to serve at 5-3 for the championship, was the epitome of the absolute self-centered rudeness that was exhibited at the Open, as well as in our society today."
                            }
                        ]
                    },
                    {
                        "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                        "glosses": [
                            "A rude remark or behaviour."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0c48072-9ab4-4cfb-884d-38226ad61fea",
                                "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                "text": "I'm sick of his rudenesses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b66e733d-270b-4fe3-95e8-dcabd2b6f426",
                        "source_entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                        "source_sense_description": "property of being rude",
                        "target_lang_word": "grofheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grofheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3af4176a-00f8-3284-ab07-fd19395b1f1e",
                                        "entry_id": "f07e764e-4f1b-3455-9cc2-958ff0554997",
                                        "glosses": [
                                            "het grof zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c71cbbb-17fd-4d0a-a4a8-e1de8b5b052f",
                                                "sense_id": "3af4176a-00f8-3284-ab07-fd19395b1f1e",
                                                "text": "Wij verkopen schuurpapier met verschillende graden van grofheid"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebb37f9d-6c62-302a-b119-545445835318",
                                        "entry_id": "f07e764e-4f1b-3455-9cc2-958ff0554997",
                                        "glosses": [
                                            "een onbeschofte, onbeleefde uiting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f49a2b44-8cde-44dd-9ffa-9170bfc37bbe",
                                                "sense_id": "ebb37f9d-6c62-302a-b119-545445835318",
                                                "text": "Met een schoen naar iemand gooien is in bepaalde culturen een enorme grofheid."
                                            },
                                            {
                                                "example_id": "6451174a-14ce-4b68-959f-df66659ca004",
                                                "sense_id": "ebb37f9d-6c62-302a-b119-545445835318",
                                                "text": "„Ik ben op een rare manier best blij dat ik niet zo lang meer zal leven. Maar ik heb wel zorgen over de toekomst van mijn kleinkinderen. Ik vind de samenleving zo ongelofelijk grimmig geworden. Ik leef zelf heel comfortabel, op mijn eigen smalle pad. Maar als ik even naar buiten kijk en zie wat er allemaal aan grofheid, populisme en racisme opkomt… Ook die hele Zwarte Piet-discussie, met dat geschreeuw van: ‘wij laten ons onze cultuur niet afpakken’. Hoezo ‘onze cultuur afpakken’? Omdat er iets minder zwart op de gezichten wordt geverfd in een spróókje? Doodeng.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59550add-6c0a-4dfa-806e-381da4bb0d78",
                        "source_entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                        "source_sense_description": "property of being rude",
                        "target_lang_word": "botheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "botheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40bf6cd2-2854-330d-9a49-b2b7bcba08db",
                                        "entry_id": "40cb53dc-cdc0-3d71-b1d5-6976f7c78c18",
                                        "glosses": [
                                            "van een persoon dat deze weinig meelevend is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795ebacc-06f1-493c-bcb2-646e9c63a50b",
                                                "sense_id": "40bf6cd2-2854-330d-9a49-b2b7bcba08db",
                                                "text": "Dit soort kwesties brengt de discrepantie aan het licht tussen de fraaie woorden die bestuurders en politici altijd weer weten te vinden, wanneer zij bijvoorbeeld op 4 mei stilstaan bij de verschrikkingen van de Tweede Wereldoorlog, en de kille botheid van hun ambtelijke apparaat. Dat heeft immers onder hun gezag deze maatregelen uitgevoerd - of kwam niet of veel te laat op de gedachte om de gemaakte fout te herstellen."
                                            },
                                            {
                                                "example_id": "d0a3cf9c-97a5-4882-9802-ef2280db5b36",
                                                "sense_id": "40bf6cd2-2854-330d-9a49-b2b7bcba08db",
                                                "text": "Die mix van talent, lef, botheid en ongrijpbaarheid heeft Van Zweden bekocht met een zeker kritisch wantrouwen. Bij het Concertgebouworkest keert hij in mei terug, maar daarop werd sinds de laatste keer negen jaar gewacht - Van Zwedens hele internationale bloeitijd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6615e1c-9c35-3b1e-a75b-7257886418d1",
                                        "entry_id": "40cb53dc-cdc0-3d71-b1d5-6976f7c78c18",
                                        "glosses": [
                                            "domheid, grofheid en onbeschaafd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a19b154c-2134-4fb9-9e28-749fd2e19875",
                                                "sense_id": "b6615e1c-9c35-3b1e-a75b-7257886418d1",
                                                "text": "Want wat bedoelt de auteur met die Lof der botheid? Stipriaan zegt dat de Hollanders vóór de Gouden Eeuw al een reputatie en cultuur van botheid hadden die ze toen snel aflegden, maar die daarna weer terugkwam en ons tot op vandaag vergezelt. Dat overtuigt niet erg. Al te snel wordt een hedendaags imago dat deels voortvloeit uit de cultuuromslag van de jaren zestig en dat voor sommige perioden veel minder geldt, een continue eigenschap van ‘echte Hollanders’ die altijd ‘hechten aan hun botheid’ en ‘ongepolijste eenvoud’ en die zelfs de huidige houding tegenover asielzoekers moet verklaren. Amsterdammers hebben een ‘aangeboren’ neiging tot debat, dat klinkt wel heel definitief. Opeens slaat Van Stipriaan de nuances over. Die stijlbreuk is jammer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c1ceb08-5eba-4542-bb4f-b6f55d88de9b",
                        "source_entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                        "source_sense_description": "property of being rude",
                        "target_lang_word": "impolitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impolitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64e529e2-f9dd-37b7-a45a-9500a3604f62",
                                        "entry_id": "7aaa89fe-688d-3940-a75d-19df2c59964b",
                                        "glosses": [
                                            "Manque de politesse, ignorance ou mépris des règles de la politesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef4b413-579a-4825-9487-c22fc158e9c1",
                                                "sense_id": "64e529e2-f9dd-37b7-a45a-9500a3604f62",
                                                "text": "L’infatuation et le manque d’éducation sont les sources ordinaires de l’impolitesse."
                                            },
                                            {
                                                "example_id": "a5344b7d-1b17-4110-9dfb-3e8b1cd2f5d8",
                                                "sense_id": "64e529e2-f9dd-37b7-a45a-9500a3604f62",
                                                "text": "N’êtes- vous pas choqué de son impolitesse ? Cette réponse est d’une impolitesse grossière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c239db74-f955-34a7-aa3a-287f97d4bb58",
                                        "entry_id": "7aaa89fe-688d-3940-a75d-19df2c59964b",
                                        "glosses": [
                                            "Action, procédé contraire à la politesse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c08bdb-e4aa-4e3f-8018-867c11d386ec",
                                                "sense_id": "c239db74-f955-34a7-aa3a-287f97d4bb58",
                                                "text": "… ; il poussa même l’impolitesse jusqu'à planter là ces dames pour se mettre à la recherche de la maîtresse de maison et de sa fille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "543f0891-32b2-4b38-9aa5-6074b93bf95e",
