                ],
                "senses": [
                    {
                        "sense_id": "813d00d2-1ffb-31e2-aa14-660f5987778c",
                        "entry_id": "3f79736b-04e8-3318-89d0-0355939d21d4",
                        "glosses": [
                            "мед. дефект зрения, при котором изображение в фокусе формируется не на сетчатке глаза, а перед ней, в результате чего на сетчатке оно нечёткое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3048d2-b256-4fd4-b35e-0a21aaecc97f",
                                "sense_id": "813d00d2-1ffb-31e2-aa14-660f5987778c",
                                "text": "Известно, что степные жители отлично видят вдаль и между ними не встречается миопов, тогда как миопия сильно выражена между городскими жителями, которые проводят все свое время преимущественно в стенах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8706e67-b18f-4dbb-957a-ce48624e6ced",
                        "source_entry_id": "3f79736b-04e8-3318-89d0-0355939d21d4",
                        "source_sense_id": "813d00d2-1ffb-31e2-aa14-660f5987778c",
                        "target_lang_word": "myopia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myopia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcc0803d-bc94-31fa-aaa4-8f847b25e107",
                                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                                        "glosses": [
                                            "A disorder of the vision where distant objects appear blurred because the eye focuses their images in front of the retina instead of on it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691d5e84-a8b4-469a-b71e-b01f587d1266",
                                                "sense_id": "fcc0803d-bc94-31fa-aaa4-8f847b25e107",
                                                "text": "The modern rise in myopia mirrored a trend for children in many countries to spend more time engaged in reading, studying or — more recently — glued to computer and smartphone screens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49264d8-22c2-320f-bd7b-a796f7570bef",
                                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                                        "glosses": [
                                            "A lack of imagination, discernment or long-range perspective in thinking or planning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "863bf9e0-ebb5-45cc-8b6d-1d6102ebdac7",
