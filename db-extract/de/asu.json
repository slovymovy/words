                ],
                "senses": [
                    {
                        "sense_id": "37952393-545a-3f66-a9fa-2bc4e419e11f",
                        "entry_id": "971f1328-8d99-3d45-b9d4-174f4831107b",
                        "glosses": [
                            "Abgassonderuntersuchung, in 1985 eingeführte regelmäßige Untersuchung des Abgases von Kraftfahrzeugen mit Ottomotor; seit 1993 umbenannt in AU"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44dd5a5c-4610-4064-9154-67b2b07f6e17",
                                "sense_id": "37952393-545a-3f66-a9fa-2bc4e419e11f",
                                "text": "„Die Autos mussten sauberer werden. So wurde 1985 die Idee der Abgassonderuntersuchung – der ASU – geboren. Die gefürchtete Abgassonde kam zum Einsatz und zeigte erstmals, wie viel Gift hinten rauskam.“"
                            },
                            {
                                "example_id": "2ea65d0b-c8f9-4d52-89dd-75e63e143a6d",
                                "sense_id": "37952393-545a-3f66-a9fa-2bc4e419e11f",
                                "text": "„Gemessen wird bei einem Benziner nur das Kohlenmonoxid, und bei einem Diesel die Abgastrübung. So ähnlich wie bei der ASU in den 80er und 90er Jahren. Stickoxid oder Feinstaub werden überhaupt nicht kontrolliert.“"
                            },
                            {
                                "example_id": "3a808f6c-fd42-4f51-a47b-f38b63dd1dd9",
                                "sense_id": "37952393-545a-3f66-a9fa-2bc4e419e11f",
                                "text": "„Der rote Audi A4 mit 101 PS-starkem Benzinmotor, Baujahr 1995, soll 500 Euro kosten. Nächste Hauptuntersuchung für TÜV und Abgastest (ASU): Januar 2019.“"
                            },
                            {
                                "example_id": "6174364b-6b35-4fce-8767-0abfd3ea53f9",
                                "sense_id": "37952393-545a-3f66-a9fa-2bc4e419e11f",
                                "text": "„»Ohne TÜV, ohne ASU, bisschen verrostet, bisschen vergammelt«, so sah jahrelang das typische Afrika-Auto aus, sagt Ali.“"
                            },
                            {
                                "example_id": "22ff9dbc-2bf7-4ed1-aa01-3d18fc10e6b6",
                                "sense_id": "37952393-545a-3f66-a9fa-2bc4e419e11f",
                                "text": "„Alle übrigen schadstoffarmen KFZ mit Ottomotoren werden in die jährliche ASU I einbezogen, wie sie bisher schon für Fahrzeuge ohne Schadstoffbegrenzung gilt. Bei Diesel-PKW und leichten Nutzfahrzeugen bis 3,5 Tonnen Gesamtgewicht wird der Rußausstoß gemessen. Bei PKW erstmals nach drei Jahren und danach jeweils alle zwei Jahre, für die übrigen Fahrzeuge gelten zweijährige Prüffristen. Diesel-Nutzfahrzeuge über 3,5 Tonnen Gesamtgewicht müssen jedes Jahr zur ASU II.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
