                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a321c67-29f6-476a-89a3-902c832de0c3",
                                "sense_id": "d60d94d5-d259-39d3-b440-a50adb87d4f3",
                                "text": "Information indicating current associations of mask bits and nodal access ports, is preexchanged between access nodes via control signaling segments of multiple frames and maintained in storage at nodal concentration centers."
                            },
                            {
                                "example_id": "e86ddfb7-5193-470e-b227-b021e68ccae0",
                                "sense_id": "d60d94d5-d259-39d3-b440-a50adb87d4f3",
                                "text": "The zeolite may be preexchanged to the desired metal form and calcined to lock the exchangeable, metal ions into position before compositing with the other ingredients."
                            },
                            {
                                "example_id": "572d5f63-4679-4e32-9488-517a088eec63",
                                "sense_id": "d60d94d5-d259-39d3-b440-a50adb87d4f3",
                                "text": "The protein ligand is unfolded in denaturant in which all labile hydrogen atoms are preexchanged for deuterium and added to a D2O solution containing GroEL (method described in detail in ref. 28)."
