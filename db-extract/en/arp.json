        "de-extract.jsonl": [
            {
                "entry_id": "cc066eb2-aabd-3d16-a3c3-146f48b335bf",
                "word": "ARP",
                "pos": "abbrev",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c41bb31-4c8f-3ce6-b088-d37e01f99250",
                        "entry_id": "cc066eb2-aabd-3d16-a3c3-146f48b335bf",
                        "glosses": [
                            "Abkürzung für Address Resolution Protocol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f82281-a680-4c73-a0ab-649f389f9a7b",
                                "sense_id": "1c41bb31-4c8f-3ce6-b088-d37e01f99250",
                                "text": "„In Internet Protocol Version 6 (IPv6) networks, the functionality of ARP is provided by the Neighbor Discovery Protocol (NDP).“",
                                "translation": "„In Netzwerken mit der Internet-Protokollversion 6 (IPv6), wird die Funktionalität des ARP durch das ‚Nachbar-Entdeckungsprotokoll‘ (NDP) zur Verfügung gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb541331-6435-3fc9-a18d-3812133b3e2b",
                        "entry_id": "cc066eb2-aabd-3d16-a3c3-146f48b335bf",
                        "glosses": [
                            "Abkürzung für Adaptive Routing Protocol"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f199533-38e0-4880-92ec-0250eba2535c",
                        "source_entry_id": "cc066eb2-aabd-3d16-a3c3-146f48b335bf",
                        "source_sense_id": "1c41bb31-4c8f-3ce6-b088-d37e01f99250",
                        "source_sense_description": "Abkürzung für Address Resolution Protocol",
                        "target_lang_word": "ARP",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ARP",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9e69951-4867-3bcc-82d7-8d15014f871f",
                                        "entry_id": "33bd2617-c746-33c7-b288-b7790e68865f",
                                        "glosses": [
                                            "Netzwerkprotokoll, das hauptsächlich zur Ermittlung der MAC-Adressen von gegebenen IP-Adressen benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae16a790-784e-4b87-8fd3-ce8803b81ffe",
                                                "sense_id": "e9e69951-4867-3bcc-82d7-8d15014f871f",
                                                "text": "„Stattdessen ermittelt er dann mit Hilfe des ARP zunächst die MAC-Adresse des Zielrechners.“"
                                            },
                                            {
                                                "example_id": "c8c650a2-4ee0-43b0-af47-23dab4fd7317",
                                                "sense_id": "e9e69951-4867-3bcc-82d7-8d15014f871f",
                                                "text": "„Egal welche Namenskonvention in Ihrem Netzwerk gilt, die Zieladresse muss in eine Hardware-Adresse (MAC-Adresse) aufgelöst werden. Diese Funktionalität wird durch das ARP (Address Resolution Protocol) sichergestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
