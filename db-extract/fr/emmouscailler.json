                ],
                "senses": [
                    {
                        "sense_id": "4be141cf-6aa6-3a99-9e3c-0cfc839848bd",
                        "entry_id": "496730b6-29db-3edf-87e0-7e519dba7ebe",
                        "glosses": [
                            "Embêter, emmerder (vulgaire), ennuyer, importuner, être pénible ou fastidieux."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bd0f8573-bdd7-433c-931f-2f3e3c739bd8",
                                "sense_id": "4be141cf-6aa6-3a99-9e3c-0cfc839848bd",
                                "text": "Il nous emmouscaille depuis son arrivée."
                            },
                            {
                                "example_id": "e3faa67c-6573-455a-aa7d-abdb5f0be5f0",
                                "sense_id": "4be141cf-6aa6-3a99-9e3c-0cfc839848bd",
                                "text": "Briller à Paris pour emmouscailler Riyad et Le Caire, ce n’est plus foot, c’est du billard !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5354278-33b4-3563-b1d8-3eaa1f8352da",
                        "entry_id": "496730b6-29db-3edf-87e0-7e519dba7ebe",
                        "glosses": [
                            "Couvert de matières fécales."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "df476953-8bee-4b6c-a21f-58c212b7a7a0",
                                "sense_id": "f5354278-33b4-3563-b1d8-3eaa1f8352da",
                                "text": "Naturellement, je l’ai fait repêcher presque aussitôt. D’ailleurs, il ne s’était pas fait le moindre petit bobo, il était seulement emmouscaillé jusqu’aux sourcils. Mais de ma vie je n’ai vu un type aussi furibard."
                            }
                        ]
                    },
                    {
                        "sense_id": "099a8343-f3ba-30b1-bd27-c3dc767a1ff4",
                        "entry_id": "496730b6-29db-3edf-87e0-7e519dba7ebe",
                        "glosses": [
                            "Se compliquer la vie."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "beb32027-bd66-472b-9292-925dffaa3498",
                                "sense_id": "099a8343-f3ba-30b1-bd27-c3dc767a1ff4",
                                "text": "On ne va pas s’emmouscailler."
                            }
                        ]
                    }
