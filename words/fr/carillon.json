    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                    "sense_definition": "Ensemble de cloches accordées pour jouer des mélodies, souvent installé dans un clocher, un beffroi ou une pendule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique_cloche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>carillon</w> du beffroi résonne dans toute la ville aux heures importantes de la journée."
                        },
                        {
                            "text": "Elle a hérité d'une pendule ancienne équipée d'un beau <w>carillon</w> mécanique."
                        }
                    ],
                    "common_phrases": [
                        "pendule à carillon",
                        "carillon à vent"
                    ]
                },
                {
                    "sense_id": "67feba3d-796d-396d-b825-6bfb1773cab7",
                    "sense_definition": "Signal sonore bref, souvent électronique, qui annonce une entrée, une notification ou un message.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signal_sonore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un léger <w>carillon</w> retentit à l'entrée de la boutique chaque fois qu'un client pousse la porte."
                        },
                        {
                            "text": "L'ordinateur émet un doux <w>carillon</w> pour prévenir de la réception d'un courrier."
                        }
                    ],
                    "synonyms": [
                        "sonnerie"
                    ],
                    "common_phrases": [
                        "carillon de porte"
                    ]
                },
                {
                    "sense_id": "170d4ba6-d46a-3ac3-9d53-0bcb73dd7f6c",
                    "sense_definition": "Mélodie ou air musical joué sur un ensemble de cloches.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique_cloche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La foule s'est rassemblée sur la place pour écouter le magnifique <w>carillon</w> des fêtes de fin d'année."
                        },
                        {
                            "text": "Ce musicien virtuose interprète un ancien <w>carillon</w> composé au dix-huitième siècle."
                        }
                    ]
                },
                {
                    "sense_id": "a94801b6-929d-3242-82a2-d4fe461795d5",
                    "sense_definition": "Battement de cloches précipité et cadencé, exprimant une fête ou une solennité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique_cloche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin de la cérémonie, les cloches partirent en joyeux <w>carillon</w>."
                        },
                        {
                            "text": "Le village tout entier a célébré l'événement avec un formidable <w>carillon</w>."
                        }
                    ],
                    "synonyms": [
                        "volée"
                    ],
                    "common_phrases": [
                        "sonner le carillon"
                    ]
                },
                {
                    "sense_id": "fa510b72-4897-33a6-bd49-cf6326f1a48d",
                    "sense_definition": "Grand vacarme, réprimande bruyante ou dispute éclatante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En découvrant la vaisselle brisée dans la cuisine, les voisins ont entendu un fameux <w>carillon</w>."
                        },
                        {
                            "text": "Il préféra se cacher pour éviter le terrible <w>carillon</w> qui allait suivre sa maladresse."
                        }
                    ],
                    "synonyms": [
                        "vacarme",
                        "chahut",
                        "tapage"
                    ],
                    "antonyms": [
