        "fr-extract.jsonl": [
            {
                "entry_id": "fbb830b9-f93d-3def-a6ff-5afb583445ca",
                "word": "Marcotte",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3c178f5-2999-33ae-963e-3e02de61e8ef",
                        "entry_id": "fbb830b9-f93d-3def-a6ff-5afb583445ca",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f72d541-118d-4bff-8e78-a908a674d245",
                                "sense_id": "c3c178f5-2999-33ae-963e-3e02de61e8ef",
                                "text": "Elle doit être dans ses règles, murmura Suzanne Marcotte à l’oreille de son frère qui, assis devant un registre de comptabilité, observait la serveuse, étonné."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7fbb68f7-a331-3631-bb53-a99f41d506a5",
                "word": "marcotte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0a3cd0f-85a4-475d-af67-2c55bcf9a3c8",
                        "entry_id": "7fbb68f7-a331-3631-bb53-a99f41d506a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "marcottes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "957ef2bb-a873-33c5-bdce-93704de17363",
                        "entry_id": "7fbb68f7-a331-3631-bb53-a99f41d506a5",
                        "glosses": [
                            "Branche enterrée (naturellement ou artificiellement), sans la détacher de la plante, pour qu’elle prenne racine, et qu'on sèvre ensuite, en la détachant lorsqu’elle a des racines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2f0634-1e0f-4359-9311-57e5fdf8480f",
                                "sense_id": "957ef2bb-a873-33c5-bdce-93704de17363",
                                "text": "La reproduction par semis, même sous cloche, est très-difficile et très-lente à notre climat; la propagation par marcottes, et surtout par éclats, est de beaucoup préférable."
                            },
                            {
                                "example_id": "2965a18e-1c5f-4a29-b3e5-0f7f70807169",
                                "sense_id": "957ef2bb-a873-33c5-bdce-93704de17363",
                                "text": "Le marcottage consiste à provoquer, en un point déterminé du rameau, la formation de racines adventives capables d'alimenter la marcotte, qu’on sèvre ensuite, en la séparant du pied mère."
                            },
                            {
                                "example_id": "a0f6cb8c-5642-4fa9-be8c-c96f326d20e6",
                                "sense_id": "957ef2bb-a873-33c5-bdce-93704de17363",
                                "text": "Un oranger dans mon jardin. La marcotte s’obtient en enfermant dans un vase rempli de terre légère une branche à laquelle on a fait une forte ligature pour la forcer à émettre des racines. La marcotte sera séparée de la plante-mère en automne, après un ou deux ans de culture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c70690b5-06b5-4716-8b9c-b075e8a0ee87",
                        "source_entry_id": "7fbb68f7-a331-3631-bb53-a99f41d506a5",
                        "source_sense_id": "957ef2bb-a873-33c5-bdce-93704de17363",
