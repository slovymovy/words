                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83ccffbb-942a-3038-b972-2c98bf12aa0f",
                                        "entry_id": "32fef8f7-fb96-3a56-9bc7-1fb69248f755",
                                        "glosses": [
                                            "Large; bulky."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a3206a-aa99-4c3f-be68-b813d5e9933d",
                                                "sense_id": "83ccffbb-942a-3038-b972-2c98bf12aa0f",
                                                "text": "Yossarian walked out of the office and down the stairs into the dark, tomblike street, passing in the hall the stout woman with warts and two chins, who was already on her way back in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8111489c-91cf-3ad6-bf67-8202dc7a296c",
                                        "entry_id": "32fef8f7-fb96-3a56-9bc7-1fb69248f755",
                                        "glosses": [
                                            "Bold, strong-minded."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af8580e4-44e6-4bac-ba03-90dfd3f4cc21",
                                                "sense_id": "8111489c-91cf-3ad6-bf67-8202dc7a296c",
                                                "text": "Art thou but Captaine of a thouſand horſe,\nThat by Characters grauen in thy browes,\nAnd by thy martiall face and ſtout aſpect,\nDeſeru’ſt to haue the leading of an hoſte?"
                                            },
                                            {
                                                "example_id": "695a3d91-33fe-48fc-adfc-9affe905df86",
                                                "sense_id": "8111489c-91cf-3ad6-bf67-8202dc7a296c",
                                                "text": "a stouter champion never handled sword."
                                            },
                                            {
                                                "example_id": "fd651718-01b0-4d6a-94b7-41e821901b5f",
                                                "sense_id": "8111489c-91cf-3ad6-bf67-8202dc7a296c",
                                                "text": "He quickly lost the character of a bold, stout, magnanimous man."
                                            },
                                            {
                                                "example_id": "d4a49d9f-b5f2-4f57-a25c-d6b045677533",
                                                "sense_id": "8111489c-91cf-3ad6-bf67-8202dc7a296c",
                                                "text": "The lords all stand / To clear their cause, most resolutely stout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f91d0a12-02b8-3e10-8354-5a73e166f46f",
                                        "entry_id": "32fef8f7-fb96-3a56-9bc7-1fb69248f755",
                                        "glosses": [
                                            "Proud; haughty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11d2803-f5ce-4ad8-95a3-71fe5fdd87e1",
                                                "sense_id": "f91d0a12-02b8-3e10-8354-5a73e166f46f",
                                                "text": "Your words have been stout against me."
                                            },
                                            {
                                                "example_id": "7f383540-67b3-49c2-8ce8-51d0283ec9a9",
                                                "sense_id": "f91d0a12-02b8-3e10-8354-5a73e166f46f",
                                                "text": "Commonly […] they that be rich are lofty and stout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0626e60c-978b-3344-bd60-3b59f077305c",
                                        "entry_id": "32fef8f7-fb96-3a56-9bc7-1fb69248f755",
                                        "glosses": [
                                            "Firm; resolute; dauntless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208e7c7f-0898-46b9-8cae-932d7c767d7d",
                                                "sense_id": "0626e60c-978b-3344-bd60-3b59f077305c",
                                                "text": "he had reason to be extremely grateful to Sterling, his Manchester City teammate, who won and converted the penalty that appeared to have broken Iceland’s stout resistance."
                                            },
                                            {
                                                "example_id": "a615777f-341c-445b-bc1b-a6d9710a1316",
                                                "sense_id": "0626e60c-978b-3344-bd60-3b59f077305c",
                                                "text": "So, Andover featured in the Glorious Revolution, which involved the deposition of Catholic fraterniser James II and his replacement by stout Protestants William and Mary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e530149-534b-3dd5-9e1b-94e94023d65d",
                                        "entry_id": "32fef8f7-fb96-3a56-9bc7-1fb69248f755",
                                        "glosses": [
                                            "Materially strong, enduring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6328d610-db19-48a1-be7a-bc93b417201c",
                                                "sense_id": "0e530149-534b-3dd5-9e1b-94e94023d65d",
                                                "text": "Campers prefer stout vessels, sticks and cloth."
                                            },
                                            {
                                                "example_id": "a39925cd-543a-4496-87d7-a7fc77c170a7",
                                                "sense_id": "0e530149-534b-3dd5-9e1b-94e94023d65d",
                                                "text": "[…] Pipes, who acted as the enemy's forlorn hope, advanced to the gate with great intrepidity, and clapping his foot to the door, which was none of the ſtouteſt, with the execution and diſpatch of a petard, ſplit it into a thouſand pieces."
                                            },
                                            {
                                                "example_id": "b0206909-f448-4a66-9482-0b3e3a57b4ae",
                                                "sense_id": "0e530149-534b-3dd5-9e1b-94e94023d65d",
                                                "text": "Nothing could be more business-like than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins … ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d3c08ed-4a91-3ef0-8aa9-d558bf5922b1",
                                        "entry_id": "32fef8f7-fb96-3a56-9bc7-1fb69248f755",
                                        "glosses": [
                                            "Obstinate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "095cbcf1-43bd-342c-90c8-f8d01ea8d139",
                                        "entry_id": "9f332028-dd48-36f7-a872-e1a5702db2c4",
                                        "glosses": [
                                            "A dark and strong malt brew made with toasted grain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab39b1e-ccfd-4bec-a961-f2778beeac9c",
                                                "sense_id": "095cbcf1-43bd-342c-90c8-f8d01ea8d139",
                                                "text": "Stout is darker, stronger and sweeter than porter beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683c7687-7b56-39cc-9fff-c4e2be7c738d",
                                        "entry_id": "9f332028-dd48-36f7-a872-e1a5702db2c4",
                                        "glosses": [
                                            "An obese person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e0935b-3409-4407-b075-25fa0688cb3c",
                                                "sense_id": "683c7687-7b56-39cc-9fff-c4e2be7c738d",
                                                "text": "Incidentally the survey pointed up the sad plight of the stylish stouts, today's “forgotten men.” The clothing situation is getting so critical for them that they may have to choose between eating and dressing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91c8cb26-910d-38f0-8122-120a6c518511",
                                        "entry_id": "9f332028-dd48-36f7-a872-e1a5702db2c4",
                                        "glosses": [
                                            "A large clothing size."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b35830c-c6e8-46e8-8034-661695637b94",
                                                "sense_id": "91c8cb26-910d-38f0-8122-120a6c518511",
                                                "text": "1918, Isidor Rosenfeld, The Practical Designer for Women's and Misses' Underwear - The Study of the Stout Form\nThe all-around waist is increased or over-built, according to size, which makes this form a stout."
                                            }
                                        ]
                                    }
                                ]
