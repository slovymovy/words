                        "sense_id": "1b6d2245-c026-33b7-801b-bcc5e2c095d9",
                        "entry_id": "82b270cd-96b2-342d-986d-9340627107ea",
                        "glosses": [
                            "A plant community characterized by scrub vegetation, consisting of low shrubs, mixed with grasses, herbs, and geophytes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0762bff7-9050-4935-b213-5fea7895811f",
                                "sense_id": "1b6d2245-c026-33b7-801b-bcc5e2c095d9",
                                "text": "The scrubland I'd be crossing looked desolate, but at least it wasn't a desert."
                            },
                            {
                                "example_id": "d4b0326e-acdf-4b89-9334-39860a5ecc66",
                                "sense_id": "1b6d2245-c026-33b7-801b-bcc5e2c095d9",
                                "text": "New lakes had appeared as if by magic in the arid scrublands. Instead of hunting for puddles in the sandstone, she could lead her 100 animals to drink their fill."
                            },
                            {
                                "example_id": "3dd5a068-bf73-46cf-af90-2dfc57226353",
                                "sense_id": "1b6d2245-c026-33b7-801b-bcc5e2c095d9",
                                "text": "It was then a further 21 years until the construction of Bramley Ordnance Depot (which became Central Ammunition Depot from 1946) began on an area of scrubland just south of the village."
                            }
                        ]
                    }
