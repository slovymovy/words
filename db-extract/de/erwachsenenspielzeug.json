                        "examples": [
                            {
                                "example_id": "bb2c0249-e612-4b8a-9f45-21bd601bf0b7",
                                "sense_id": "157bac2c-1b45-3c56-a6ed-b207d8011d6b",
                                "text": "„Selbst wenn Sie kein Kind sind und auch auf Erwachsenenspielzeug aus Silikon oder Plastik verzichten können, kann sich heute kein Mensch mehr den Weichmachern entziehen.“"
                            },
                            {
                                "example_id": "2e00b00a-7566-458d-b2d8-7eb29ce6a6bf",
                                "sense_id": "157bac2c-1b45-3c56-a6ed-b207d8011d6b",
                                "text": "„An diesem Abend wurden farbenfrohe Schaumstoff- und Stoffkreationen der Künstlerin Justyna Koeke sowie Erwachsenenspielzeug zugunsten eines Projekts versteigert, das Frauen beim Ausstieg aus der Prostitution hilft.“"
                            },
                            {
                                "example_id": "1c7a370d-88b8-40f6-ada0-26c005ce86ce",
                                "sense_id": "157bac2c-1b45-3c56-a6ed-b207d8011d6b",
                                "text": "„Ich drehte mich um, betrachtete meinen Körper im Schaufenster eines längst vergessenen Ladens für Erwachsenenspielzeug.“"
                            }
                        ],
