                                        "sense_id": "17b12acc-5f6c-349e-b5b5-c465681b959e",
                                        "entry_id": "b2341f4c-c256-3d71-9ba5-429800458d7d",
                                        "glosses": [
                                            "A device used for injecting or drawing fluids through a membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef38720-8334-4a34-8105-346938f3caa4",
                                                "sense_id": "17b12acc-5f6c-349e-b5b5-c465681b959e",
                                                "text": "In Kelly’s case, once the baby was admitted to the hospital, she began to use formula, fed through a syringe—she was told to avoid bottles because the baby would reject the breast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f9e62e-5ba9-35c0-932a-29c538f45c35",
                                        "entry_id": "b2341f4c-c256-3d71-9ba5-429800458d7d",
                                        "glosses": [
                                            "A device consisting of a hypodermic needle, a chamber for containing liquids, and a piston for applying pressure (to inject) or reducing pressure (to draw); a hypodermic syringe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
