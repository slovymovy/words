{
    "word_family": [
        "fear",
        "fearless",
        "fearlessly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f1ea97a-54d9-36b9-b42e-e7a9a692e867",
                    "sense_definition": "Tending to feel fear easily; timid or shy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fearful_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fearful</w> child hid behind his mother when the stranger spoke to him.",
                            "target_lang_translations": {
                                "ru": "<w>Боязливый</w> ребенок спрятался за маму, когда незнакомец заговорил с ним.",
                                "fr": "L'enfant <w>craintif</w> s'est caché derrière sa mère quand l'inconnu lui a parlé."
                            }
                        },
                        {
                            "text": "She was too <w>fearful</w> to ask for help in front of the whole class.",
                            "target_lang_translations": {
                                "ru": "Она была слишком <w>пуглива</w>, чтобы попросить о помощи перед всем классом.",
                                "fr": "Elle était trop <w>peureuse</w> pour demander de l'aide devant toute la classe."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightened",
                        "timid",
                        "timorous"
                    ],
                    "antonyms": [
                        "brave",
                        "courageous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный легко испытывать страх; робкий или застенчивый.",
                        "fr": "Qui a tendance à avoir peur facilement ; timide ou craintif."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боязливый",
                                "target_lang_sense_clarification": "склонный к страху, робкий"
                            },
                            {
                                "target_lang_word": "пугливый",
                                "target_lang_sense_clarification": "легко пугающийся"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "craintif",
                                "target_lang_sense_clarification": "qui est sujet à la crainte"
                            },
                            {
                                "target_lang_word": "peureux",
                                "target_lang_sense_clarification": "qui est facilement effrayé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "216c9d5d-019c-3c9f-9e7e-1d87f5cda136",
                    "sense_definition": "Feeling or showing terror or extreme anxiety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fearful_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fearful</w> passengers held onto their seats during the heavy storm.",
                            "target_lang_translations": {
                                "ru": "<w>Испуганные</w> пассажиры вцепились в свои кресла во время сильного шторма.",
                                "fr": "Les passagers <w>effrayés</w> se sont agrippés à leurs sièges pendant la violente tempête."
                            }
                        },
                        {
                            "text": "He gave a <w>fearful</w> look at the dark forest before turning back home.",
                            "target_lang_translations": {
                                "ru": "Он бросил <w>испуганный</w> взгляд на темный лес, прежде чем повернуть обратно домой.",
                                "fr": "Il a jeté un regard <w>effrayé</w> vers la forêt sombre avant de retourner chez lui."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightened"
                    ],
                    "antonyms": [
                        "calm",
                        "unafraid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или выражающий ужас или сильную тревогу.",
                        "fr": "Qui ressent ou manifeste de la terreur ou une anxiété extrême."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "находящийся в состоянии страха"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "effrayé",
                                "target_lang_sense_clarification": "qui est dans un état de peur"
                            },
                            {
                                "target_lang_word": "terrifié",
                                "target_lang_sense_clarification": "qui ressent une peur intense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57739382-f0e1-34ee-b4a7-b834a68e82df",
                    "sense_definition": "Causing or likely to cause fear; frightening.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fearful_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers heard a <w>fearful</w> roar coming from the deep cave.",
                            "target_lang_translations": {
                                "ru": "Туристы услышали <w>страшный</w> рев, доносившийся из глубокой пещеры.",
                                "fr": "Les randonneurs ont entendu un rugissement <w>effrayant</w> provenant de la grotte profonde."
                            }
                        },
                        {
                            "text": "The storm brought <w>fearful</w> winds that damaged many houses in the village.",
                            "target_lang_translations": {
                                "ru": "Шторм принес <w>ужасные</w> ветры, которые повредили многие дома в деревне.",
                                "fr": "La tempête a apporté des vents <w>redoutables</w> qui ont endommagé de nombreuses maisons dans le village."
                            }
                        }
                    ],
                    "antonyms": [
                        "comforting",
                        "reassuring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий или способный вызвать страх; пугающий.",
                        "fr": "Qui cause ou est susceptible de causer de la peur ; effrayant."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "внушающий страх"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "вызывающий сильный испуг"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "effrayant",
                                "target_lang_sense_clarification": "qui fait peur"
                            },
                            {
                                "target_lang_word": "redoutable",
                                "target_lang_sense_clarification": "qui inspire la crainte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1d956c5-1812-3215-b615-f25ff0466185",
                    "sense_definition": "Extremely bad, unpleasant, or severe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fearful_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>fearful</w> accident on the highway this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром на шоссе произошла <w>ужасная</w> авария.",
                                "fr": "Il y a eu un <w>affreux</w> accident sur l'autoroute ce matin."
                            }
                        },
                        {
                            "text": "The team suffered a <w>fearful</w> defeat in the final match of the season.",
                            "target_lang_translations": {
                                "ru": "Команда потерпела <w>ужасное</w> поражение в финальном матче сезона.",
                                "fr": "L'équipe a subi une <w>terrible</w> défaite lors du dernier match de la saison."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, неприятный или тяжелый.",
                        "fr": "Extrêmement mauvais, désagréable ou grave."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "очень плохой, тяжелый"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "affreux",
                                "target_lang_sense_clarification": "très désagréable ou pénible"
                            },
                            {
                                "target_lang_word": "terrible",
                                "target_lang_sense_clarification": "très grave ou excessif"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a41a3b64-37b1-3b83-a8af-b4ec72d66b59",
                    "sense_definition": "To an extreme or intense degree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather was <w>fearful</w> cold during the winter months in the mountains.",
                            "target_lang_translations": {
                                "ru": "Погода была <w>ужасно</w> холодной в зимние месяцы в горах.",
                                "fr": "Le temps était <w>terriblement</w> froid pendant les mois d'hiver en montagne."
                            }
                        },
                        {
                            "text": "He was <w>fearful</w> tired after working for twelve hours without a break.",
                            "target_lang_translations": {
                                "ru": "Он был <w>ужасно</w> уставшим после двенадцатичасовой работы без перерыва.",
                                "fr": "Il était <w>terriblement</w> fatigué après avoir travaillé douze heures sans pause."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крайней или интенсивной степени.",
                        "fr": "À un degré extrême ou intense."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "в очень высокой степени"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "terriblement",
                                "target_lang_sense_clarification": "à un degré très élevé"
                            },
                            {
                                "target_lang_word": "extrêmement",
                                "target_lang_sense_clarification": "très intensément"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}