                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e470b51d-62ed-45b4-8bdc-dc9e6bad04fb",
                                                "sense_id": "df5a6ba9-b836-3a00-804c-82b06dc6161b",
                                                "text": "La loi de comportement du matériau thermoélastique linéaire, isotrope dans la configuration de référence s’obtient en combinant les résultats des paragraphes 4.5 et 5.2."
                                            }
                                        ]
                                    },
