                            {
                                "example_id": "7497c04b-e541-40bd-b2ef-f51c16a035ff",
                                "sense_id": "37f3dfc9-c99a-32fd-a8ea-b510b08a62ee",
                                "text": "Ze kunnen sterlicht waarnemen dat twintig maal zo zwak is als wat met aardse telescopen kan worden bekeken - een miljard maal zo zwak als wat het ongewapende oog ziet."
                            },
                            {
                                "example_id": "768519cf-367a-43d0-9408-646183a67e76",
                                "sense_id": "37f3dfc9-c99a-32fd-a8ea-b510b08a62ee",
                                "text": "Het waargenomen sterlicht wordt in de telescoop gebundeld door een holle spiegel (vergelijkbaar met een grote scheerspiegel), en het oppervlak van die spiegel wijkt nergens meer dan een veertigduizendste millimeter van de perfecte paraboolvorm af."
                            }
                        ]
