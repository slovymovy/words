                    "frequency": "Middle",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Né dans un vieux château normand, ce <w>gentilhomme</w> descendait d'une longue lignée de chevaliers."
                        },
                        {
                            "text": "À cette époque, la société divisait nettement les <w>gentilshommes</w> et les roturiers."
                        }
                    ],
                    "synonyms": [
                        "noble",
                        "aristocrate"
                    ],
                    "antonyms": [
                        "roturier",
                        "vilain"
                    ],
                    "common_phrases": [
