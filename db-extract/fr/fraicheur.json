                ],
                "senses": [
                    {
                        "sense_id": "344d1db2-7044-338c-8911-bae101ba12c6",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Froid doux et modéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763702ba-b517-4295-9e18-e45fac552e0f",
                                "sense_id": "344d1db2-7044-338c-8911-bae101ba12c6",
                                "text": "La fraicheur du temps, de l’air."
                            },
                            {
                                "example_id": "f7c6e2e6-92e6-4cfc-8954-cc0801bc4e84",
                                "sense_id": "344d1db2-7044-338c-8911-bae101ba12c6",
                                "text": "La fraicheur de la nuit, des matinées."
                            },
                            {
                                "example_id": "f2ab6ff0-fbb8-4cd4-96d7-89a295dd014c",
                                "sense_id": "344d1db2-7044-338c-8911-bae101ba12c6",
                                "text": "La fraicheur de l’eau, d’une boisson, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f8cef84-fb93-3f34-a143-33768d54797c",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Vent très faible qui suit ou qui précède le calme."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "40bcfd1b-5442-4289-b3f3-f0daf225331a",
                                "sense_id": "8f8cef84-fb93-3f34-a143-33768d54797c",
                                "text": "Il vient un peu de fraicheur."
                            },
                            {
                                "example_id": "222d92a0-7b5f-4993-bfdd-cf6f138d482b",
                                "sense_id": "8f8cef84-fb93-3f34-a143-33768d54797c",
                                "text": "La brise est finie, il n’y a plus qu’une légère fraicheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "52e682dc-31e8-326b-94e7-e27b9b80d98a",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Froidure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285abf46-4a30-48c2-a538-ce71aafd1719",
                                "sense_id": "52e682dc-31e8-326b-94e7-e27b9b80d98a",
                                "text": "La fraicheur du soir est perfide dans cette saison."
                            },
                            {
                                "example_id": "956589bc-c260-4ee0-ac59-d2f2e5d47620",
                                "sense_id": "52e682dc-31e8-326b-94e7-e27b9b80d98a",
                                "text": "Il fait quelquefois des fraicheurs qui nuisent à la vigne."
                            }
                        ]
                    },
                    {
                        "sense_id": "fde5cf30-c738-3ef0-91ba-9aa20082679a",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Froissage musculaire causée par un froid humide."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c3bec010-1f72-4654-8569-e0c43c3cff0c",
                                "sense_id": "fde5cf30-c738-3ef0-91ba-9aa20082679a",
                                "text": "Cela cause des fraicheurs."
                            },
                            {
                                "example_id": "09656b09-eb33-45f9-89ad-3ee28b0031b9",
                                "sense_id": "fde5cf30-c738-3ef0-91ba-9aa20082679a",
                                "text": "Ce n’est pas un rhumatisme, ce n’est qu’une fraicheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba493aff-a340-3e2f-b48f-334fd4862906",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Lustre, brillant, éclat agréable des fleurs, du teint, des couleurs, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "acaf3166-b337-47bf-8931-391440116477",
                                "sense_id": "ba493aff-a340-3e2f-b48f-334fd4862906",
                                "text": "Cette rose a perdu sa fraicheur."
                            },
                            {
                                "example_id": "119e6a6f-24c0-40f2-b6dd-c6cc4d724d59",
                                "sense_id": "ba493aff-a340-3e2f-b48f-334fd4862906",
                                "text": "La fraicheur du visage de la jeunesse."
                            },
                            {
                                "example_id": "86013fe9-4da5-4014-a8cd-3b26b751c878",
                                "sense_id": "ba493aff-a340-3e2f-b48f-334fd4862906",
                                "text": "La fraicheur du coloris, dans un tableau."
                            }
                        ]
                    },
                    {
                        "sense_id": "34f40ba6-5926-3265-a483-7a1c109e58e1",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "État de ce qui est frais, de ce qui reste sans altération, conserve son premier état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0e9efe-e584-4d3b-8ed6-60664b35d409",
                                "sense_id": "34f40ba6-5926-3265-a483-7a1c109e58e1",
                                "text": "Côté cuisine, les plats sont d'une grande fraicheur et les assiettes bien présentées : raviolis niçois à la ricotta et copeaux de truffes, cabillaud demi-sel en aïoli et légumes du jardin, tapas crevettes sauce piquante au piment d'Espelette, […]"
                            },
                            {
                                "example_id": "1bf045e1-3510-4fa8-8a67-8022dd1b7753",
                                "sense_id": "34f40ba6-5926-3265-a483-7a1c109e58e1",
                                "text": "La fraicheur d’un costume."
                            }
                        ]
                    },
                    {
                        "sense_id": "14049190-5b36-358a-980f-9ba1476c3dbb",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Grâce naturelle, légèreté, pureté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bfdecd9d-9bb5-4ca6-96e5-858950cb5f51",
                                "sense_id": "14049190-5b36-358a-980f-9ba1476c3dbb",
                                "text": "La fraicheur des pensées, de l’imagination, du style."
                            }
                        ]
                    },
                    {
                        "sense_id": "509b2d29-242d-309f-b79c-b990ceab3e28",
                        "entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "glosses": [
                            "Spontanéité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966a1d24-8e9f-4daa-aa99-bbc687412bd7",
                                "sense_id": "509b2d29-242d-309f-b79c-b990ceab3e28",
                                "text": "La fraicheur des sentiments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f5ea65b-6ed4-4a87-96b4-f316fca9b685",
                        "source_entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "target_lang_word": "Frische",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frische",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0e5632-4f6c-3c76-987a-cd9c933824e6",
                                        "entry_id": "3a04a650-1c95-38d9-b172-1042032348f0",
                                        "glosses": [
                                            "als angenehm empfundene kühlende Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd31c1cc-416e-48af-8899-b62c4ef9efdd",
                                                "sense_id": "8a0e5632-4f6c-3c76-987a-cd9c933824e6",
                                                "text": "Die Frische der hereinbrechenden Nacht ließ uns die Tageshitze vergessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "886ac7f9-e37a-3ddb-bb70-50e4c853853b",
                                        "entry_id": "3a04a650-1c95-38d9-b172-1042032348f0",
                                        "glosses": [
                                            "ein Zustand, in dem noch keine (unerwünschten) Alterungs- oder Verfallsprozesse eingesetzt haben"
                                        ],
                                        "tags": [
                                            "von Lebensmitteln"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2038de39-52ee-4864-953e-c58892095d01",
                                                "sense_id": "886ac7f9-e37a-3ddb-bb70-50e4c853853b",
                                                "text": "Mit der Frische ist es bei diesem Fisch aber nicht weit her."
                                            },
                                            {
                                                "example_id": "c0b500ef-bc94-4103-a072-d0a2c4013bdd",
                                                "sense_id": "886ac7f9-e37a-3ddb-bb70-50e4c853853b",
                                                "text": "Für unsere Küche ist Frische das oberste Gebot."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2d4a9d82-5d77-301d-b043-dff3241d1246",
                                        "entry_id": "3a04a650-1c95-38d9-b172-1042032348f0",
                                        "glosses": [
                                            "ein unverbrauchter Zustand ohne Ermüdungs- oder Alterungserscheinungen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b813d529-6944-436a-b922-18bd54245571",
                                                "sense_id": "2d4a9d82-5d77-301d-b043-dff3241d1246",
                                                "text": "Wir treffen uns morgen in alter Frische zur gleichen Zeit am vereinbarten Treffpunkt."
                                            },
                                            {
                                                "example_id": "fff8622c-d71b-4e93-8b19-a3d306484224",
                                                "sense_id": "2d4a9d82-5d77-301d-b043-dff3241d1246",
                                                "text": "„Sehr überrascht war ich von seiner ungeheuren Belesenheit, vor allem aber waren es die seltene Frische und Lebendigkeit seiner Phantasie, die mich interessierten und anregten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "078bd5ab-0903-4307-80b2-1769eea2a890",
                        "source_entry_id": "ba0bd00f-ce55-3ca8-8ca1-5c74ec3c57dd",
                        "target_lang_word": "Kühle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3316e2e5-a85e-32f9-b425-f54a12b8170e",
                                        "entry_id": "e663a718-ba56-3870-918b-effb28d80655",
                                        "glosses": [
                                            "Zustand, nur relativ niedrige Temperatur aufzuweisen/kühl zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d786ad-da55-45fb-881d-84385698d315",
                                                "sense_id": "3316e2e5-a85e-32f9-b425-f54a12b8170e",
                                                "text": "„Sie schlafen bewegungslos, die Decke gegen die Kühle der Dämmerung über sich gezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f07d0e87-3d66-3a8e-b507-40090d64a0c7",
                                        "entry_id": "e663a718-ba56-3870-918b-effb28d80655",
                                        "glosses": [
                                            "kühle/distanzierte Art oder Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kühle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                        "entry_id": "99b6adda-4731-31c6-beb0-eaf07b4cc545",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8537dc20-f72f-499b-98ab-179588b9c711",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Frau Kühle ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "80f6e73c-fda3-4f01-be21-9bcbef1608dc",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Herr Kühle wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "0a6b6cb8-2231-45aa-a27f-aa6516fe43b1",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Die Kühles fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "313a3e5e-c658-4829-baa4-5cb3ff20d8b2",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Der Kühle trägt nie die Pullover, die die Kühle ihm strickt."
                                            },
                                            {
                                                "example_id": "532a0783-1cbc-498b-949d-543034f12c31",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kühle kommt, geht der Herr Kühle.“"
                                            },
                                            {
                                                "example_id": "f263ac71-ca91-446c-86fb-af0255934664",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Kühle kommt und geht."
                                            },
                                            {
                                                "example_id": "a130736e-1de6-43e5-8986-92cdbab0d8cb",
                                                "sense_id": "a33bd11b-401e-3e75-86d1-ad256b0a892e",
                                                "text": "Kühles kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6983618c-79a5-4cb3-b467-cefcce0b2489",
