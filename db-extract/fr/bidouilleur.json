                        "source_sense_id": "48841f03-423e-3830-b113-6310736b0c61",
                        "source_sense_description": "Informatik: Hacker",
                        "target_lang_word": "Hacker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hacker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "688b68ff-5b61-3007-a236-5e231d5378b3",
                                        "entry_id": "9a417343-6577-344f-944a-7b1f87954514",
                                        "glosses": [
                                            "Computerspezialist, der insbesondere Sicherheitsbarrieren überwinden und, meistens unerlaubt, in fremde Systeme eindringen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0bc3a8-4883-49ce-8ea9-2e7e2d486b02",
                                                "sense_id": "688b68ff-5b61-3007-a236-5e231d5378b3",
                                                "text": "Pro-palästinensische Hacker haben erneut gezielt Webseiten in Israel angegriffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "460f38e9-a572-3305-ad61-97189857f909",
                                        "entry_id": "9a417343-6577-344f-944a-7b1f87954514",
                                        "glosses": [
                                            "Person mit außergewöhnlich guten Fähigkeiten in ihrem Fachgebiet, oder allgemein für ein Improvisationstalent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea60c46-7f89-4d41-a9e2-0b5a3bf89ad6",
                                                "sense_id": "460f38e9-a572-3305-ad61-97189857f909",
                                                "text": "Hacker können so Nachrichten unter Ihrem Namen verschicken und empfangen – und sogar den Account übernehmen, ohne dass Sie etwas dagegen tun können."
                                            },
                                            {
                                                "example_id": "138b7e38-fe7c-414c-ba13-a3b8899d877d",
                                                "sense_id": "460f38e9-a572-3305-ad61-97189857f909",
                                                "text": "„Ich bin der Hacker im System, ich schleich mich in die NATO ein, ich könnte auch ein Russe sein.",
                                                "translation": "Papi, schenk mir einen Computer! Hilfe für die ganze Familie! Liebling, nimm die Rüstungsspirale! Tanz den Gummitwist!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f02c9d9e-172d-315f-bb80-a901eed7983f",
                                        "entry_id": "9a417343-6577-344f-944a-7b1f87954514",
                                        "glosses": [
                                            "Entwickler von freier Software, die ihren Quellcode offenlegen, werden pauschal als Hacker betitelt, was einen Ausdruck des Respekts für deren ethische Einstellung gegenüber der Gesellschaft darstellt"
                                        ],
                                        "tags": [
                                            "Programmierszene"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d00b8e-da63-49d7-b2b4-a393df028a7b",
                                                "sense_id": "f02c9d9e-172d-315f-bb80-a901eed7983f",
                                                "text": "Hacker folgen einem philosophischen Gedanken, nämlich der Freiheit von Informationen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hacker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a89d93a-2971-3d93-a1dd-1ca77ac6df73",
