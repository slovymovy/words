                        "sense_id": "fca2f964-6c79-38cc-86a4-0232e2a8df33",
                        "entry_id": "a231f19b-bb18-3814-a9db-34141be78827",
                        "glosses": [
                            "kledingstuk voor mannen dat gebruikt wordt om in te zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea2c1c7-6371-4c77-830c-f28de6d4826d",
                                "sense_id": "fca2f964-6c79-38cc-86a4-0232e2a8df33",
                                "text": "De badgast banjert in zijn zwembroek over de boulevard."
                            },
                            {
                                "example_id": "0fd40176-55f5-4646-a7fe-0ab0d2a4714c",
                                "sense_id": "fca2f964-6c79-38cc-86a4-0232e2a8df33",
                                "text": "Mijn moeder en vader stonden in badkleding bij de steiger en glimlachten naar de camera, zij in een tweedelig badpak, dus geen bikini, hij in zo'n strakke zwembroek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d136faa4-a364-4fef-b057-5c36deba8765",
                        "source_entry_id": "a231f19b-bb18-3814-a9db-34141be78827",
                        "source_sense_id": "fca2f964-6c79-38cc-86a4-0232e2a8df33",
                        "source_sense_description": "kledingstuk voor mannen dat gebruikt wordt om in te zwemmen",
                        "target_lang_word": "Badehose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Badehose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eebc6c30-72fd-3d33-8740-f20d29e14867",
                                        "entry_id": "a902085b-99b2-3205-a80d-f3724a958545",
                                        "glosses": [
                                            "Kleidungsstück, das zum Schwimmen oder um sich zu sonnen über den Unterleib angezogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "068d63c7-9de9-4db5-b6e9-20c35a50cd51",
                                                "sense_id": "eebc6c30-72fd-3d33-8740-f20d29e14867",
                                                "text": "Vergiss die Badehose nicht!"
                                            },
                                            {
                                                "example_id": "ea68d48d-e16d-4071-9f28-525e9eced981",
                                                "sense_id": "eebc6c30-72fd-3d33-8740-f20d29e14867",
                                                "text": "„Sie kramte ihren Bikini aus einem Koffer und seine Badehose - es war so warm.“"
                                            },
                                            {
                                                "example_id": "88c9d5a5-e2ee-4ef7-aede-ec887ae2e4a3",
                                                "sense_id": "eebc6c30-72fd-3d33-8740-f20d29e14867",
                                                "text": "„Meine Badehose mochte ich nicht anziehen, weil sie zu lang war.“"
                                            },
                                            {
                                                "example_id": "0d04f489-69ef-4b6f-b909-3e2db9f7c559",
                                                "sense_id": "eebc6c30-72fd-3d33-8740-f20d29e14867",
                                                "text": "„Nach einer Raucherpause packten Nikolai und die Jugendlichen ihre Badehosen aus dem Kofferraum und sprangen in die Fluten.“"
                                            },
                                            {
                                                "example_id": "0c9d3b81-8a84-4dcb-95e9-ffd501f88f8d",
                                                "sense_id": "eebc6c30-72fd-3d33-8740-f20d29e14867",
                                                "text": "„Unter der Badehose ist das Weiß von frischen Verbänden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
