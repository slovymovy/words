                "senses": [
                    {
                        "sense_id": "1a755279-7bb0-39ca-ba11-f48ba81b595f",
                        "entry_id": "8861dac9-8abf-3b3b-80c8-fdb1a3305a13",
                        "glosses": [
                            "von einem Arzt ausgestelltes Dokument, das die Erkrankung oder Verletzung einer Person bescheinigt, sodass keiner Erwerbstätigkeit nachgegangen werden kann"
                        ],
                        "tags": [
                            "Arbeitsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "95792407-87fc-4588-90ce-ebef27726c83",
                                "sense_id": "1a755279-7bb0-39ca-ba11-f48ba81b595f",
                                "text": "„Der ‚gelbe Zettel‘ – juristisch ausgedrückt: die Arbeitsunfähigkeitsbescheinigung – hat in Betrieben eine große Macht. Mit ihr weist der Arbeitnehmer seine krankheitsbedingte Arbeitsunfähigkeit nach und schafft so die Voraussetzung für die Entgeltfortzahlung im Krankheitsfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
