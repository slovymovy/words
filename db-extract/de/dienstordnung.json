                ],
                "senses": [
                    {
                        "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                        "entry_id": "617c6460-1d78-359f-bb32-a950cf06b889",
                        "glosses": [
                            "Gesamtheit aller Regelungen und Verpflichtungen für eine ordnungsmäßige Ausübung eines bestimmten Amtes, Berufes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4879324b-a7bb-4726-a0cf-d3681d08b214",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Eine klare Dienstordnung sei in diesem Gefängnis unbekannt.“"
                            },
                            {
                                "example_id": "1d806e71-c564-4c34-b372-71b8eacb4b0e",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Schweine hatten schlicht keinen Platz in der Bürokratie, weder im Besoldungsrecht noch in der Dienstordnung.“"
                            },
                            {
                                "example_id": "5fd85dff-94be-48d5-af7b-8f22c9027c1c",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Selbst mit der Dienstwohnung, die der Hausverwalter laut Dienstordnung verpflichtend bewohnen muss, lassen sich nicht mehr ausreichend qualifizierte Bewerber locken.“"
                            },
                            {
                                "example_id": "67e2c922-a610-475b-9b89-e4f46b1781c2",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Allerdings bezogen sich diese Zahlen nur auf Soldaten, denen die Ausrüstung nach Dienstordnung zustand.“"
                            },
                            {
                                "example_id": "b4558ce4-3e18-4aa2-a0ca-da378442f9da",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„In der Dienstordnung gebe es zudem den klaren Befehl, dass keine Fotos oder Videos von Einsätzen [der Schweizer Armee] hochgeladen werden dürfen.“"
                            },
                            {
                                "example_id": "682de4e9-49fb-4fe1-a60f-0c817454fa69",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„In Hessen zum Beispiel regelt die Dienstordnung der Lehrkräfte, dass die Schulleiter für den Arbeitsschutz verantwortlich sind.“"
                            },
                            {
                                "example_id": "cf2eee8c-6370-45c7-81cd-bc5c56051f91",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Mit diesen, umgangssprachlich ‚Beifang‘ genannten Aufzeichnungen muss jedoch besonders verfahren werden; die Dienstordnung des BND sieht vor, dass sie vernichtet werden, nachdem die unbeabsichtigten Aufzeichnungen erkannt worden sind.“"
                            },
                            {
                                "example_id": "33bb25cf-e643-4212-b85c-abb5cd902a23",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Noch eine Konzession hat Spaenle offenbar gemacht: Er will durch eine Änderung der Dienstordnung festlegen, dass beim Aufklärungsunterricht, den in der Regel externe Fachkräfte durchführen, an weiterführenden Schulen künftig zwingend ein Lehrer anwesend ist.“"
                            },
                            {
                                "example_id": "bbcb1ce9-6eb3-4365-ae8b-557bc806684c",
                                "sense_id": "695fc49f-99e4-3162-8e9c-9c9cd0886acd",
                                "text": "„Die Dienstordnungen definierten Homosexualität damals als Grund für einen Ausschluss aus den Streitkräften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
