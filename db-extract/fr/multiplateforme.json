                "senses": [
                    {
                        "sense_id": "794cd4cd-680b-3f3b-a28a-d8a742dc5bcc",
                        "entry_id": "c3759ff0-ff71-3661-a8ed-3feb98703a4c",
                        "glosses": [
                            "Se dit d’un logiciel conçu pour fonctionner sur plusieurs plates-formes, c’est-à-dire le couple liant ordinateur et système d’exploitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb80e44e-cc8e-41d0-b456-c813411b52a2",
                                "sense_id": "794cd4cd-680b-3f3b-a28a-d8a742dc5bcc",
                                "text": "On préfère employer une bibliothèque plus simple d'utilisation et multiplateforme comme GTK+ (sous Gnome) ou Qt (sous KDE). Comme vous le voyez, il y a en gros une bibliothèque « de base » pour chaque OS."
                            },
                            {
                                "example_id": "bd4127c4-8b36-465c-8d83-f91375e4f643",
                                "sense_id": "794cd4cd-680b-3f3b-a28a-d8a742dc5bcc",
                                "text": "Avec la multiplication des applications multiplateformes (et web),le principal système d'échanges de données est le WebService, qui utilise généralement le protocole HTTP et des requêtes relativement simples."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d02703e-d35f-4297-a02c-32f0c1fbf2af",
                        "source_entry_id": "c3759ff0-ff71-3661-a8ed-3feb98703a4c",
                        "source_sense_id": "794cd4cd-680b-3f3b-a28a-d8a742dc5bcc",
                        "source_sense_description": "(Informatique) Conçu pour fonctionner sur plusieurs plates-formes",
                        "target_lang_word": "plattformunabhängig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plattformunabhängig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8079230e-e841-3ed0-b711-6d55da7a098f",
                                        "entry_id": "9e9d8d56-8bd4-3d2a-b1c9-ece683996cad",
                                        "glosses": [
                                            "auf unterschiedlichen Plattformen lauffähig"
                                        ],
                                        "tags": [
                                            "Software"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d7f651-5407-4d64-a8f0-ff03f045ce33",
                                                "sense_id": "8079230e-e841-3ed0-b711-6d55da7a098f",
                                                "text": "Wer hat dir den Blödsinn erzählt, dass Java-Programme plattformunabhängig sind, weil sie alle auf einer virtuellen Maschine namens „Java Virtual Machine“ laufen?"
                                            },
                                            {
                                                "example_id": "e6e8b025-e059-40a2-96a3-15d56b1bd87c",
                                                "sense_id": "8079230e-e841-3ed0-b711-6d55da7a098f",
                                                "text": "Wer hat dir den Blödsinn erzählt, dass C++ plattformunabhängiger als Java ist?"
                                            },
                                            {
                                                "example_id": "db0bded7-ffe0-4a9f-af9f-a86feefa329e",
                                                "sense_id": "8079230e-e841-3ed0-b711-6d55da7a098f",
                                                "text": "„Im jährlichen Report von Kaspersky Labs führt Java seit Jahren die Liste der am häufigsten angegriffenen Software an. 2012 zielte die Hälfte aller Angriffe auf Java JRE. Früher führte der Adobe Reader diese Liste an. Auch er ist plattformunabhängig nutzbar und damit auch heute noch ein beliebtes Ziel.“"
                                            },
                                            {
                                                "example_id": "bdfc6752-a1d1-4780-a9c5-75df6fe356b2",
                                                "sense_id": "8079230e-e841-3ed0-b711-6d55da7a098f",
                                                "text": "„Die Software ec2use ist webfähig, plattformunabhängig und somit auf jedem gängigen Betriebssystem ausführbar.“"
                                            },
                                            {
                                                "example_id": "14f67a39-2015-46a3-ab49-efa1ab259b84",
                                                "sense_id": "8079230e-e841-3ed0-b711-6d55da7a098f",
                                                "text": "„Ein Vorteil von Dropbox ist, dass plattformunabhängiger als bei Live Mesh agiert werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
