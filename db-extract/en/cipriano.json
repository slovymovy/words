                                                "sense_id": "028bc240-0b1b-39b8-844e-b9acfe226b6f",
                                                "text": "In Bälde wird Zyprian an der Bandscheibe operiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zyprian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                        "entry_id": "221bdb58-4870-38fc-875f-3c67d23697e6",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c3175d-44c1-4086-baaf-a586b882fae7",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Frau Zyprian ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "56e51d78-16d1-4094-812a-56b2b139f2cf",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Herr Zyprian wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "3fce3f3f-1552-4263-9167-300cd3efff81",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Die Zyprian fliegen heute nach Paris."
                                            },
                                            {
                                                "example_id": "fde3323e-47c5-41ee-af4a-9b4af4f8ebdf",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Der Zyprian trägt nie die Pullover, die die Zyprian ihm strickt."
                                            },
                                            {
                                                "example_id": "a3d3626e-dcb3-49b2-9422-421eeb5ec122",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zyprian kommt, geht der Herr Zyprian.“"
                                            },
                                            {
                                                "example_id": "afdcf8b0-19b7-457d-82c6-420c9286b13b",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Zyprian kommt und geht."
                                            },
                                            {
                                                "example_id": "7f19e578-dc08-4b37-9e11-5b65df182a10",
                                                "sense_id": "719ad8a9-908e-3185-8fbc-a3422ae0fbbf",
                                                "text": "Zyprians kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
