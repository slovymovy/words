                        "glosses": [
                            "прост. в самом деле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9d5277-2798-4f65-9381-9bf463f62f74",
                                "sense_id": "ac7ea915-0ced-3bbb-90ff-786283e6e814",
                                "text": "Я и впрямь колдун; знать, не ошиблась ты, Катерина! знать, правду сказало сердечко твоё золотое, что один я ему колдун, и правды не потаю от него, простого, нехитрого!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
