                ],
                "senses": [
                    {
                        "sense_id": "bef21292-a125-3121-97a0-b71af3717e9c",
                        "entry_id": "4ccca33d-07c1-3b66-a443-472e070daf41",
                        "glosses": [
                            "устар., воен. стоянка войск для ночлега или отдыха под открытым небом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2f5701-3b93-4242-8ebf-8ad46d55a168",
                                "sense_id": "bef21292-a125-3121-97a0-b71af3717e9c",
                                "text": "Крики и огни в неприятельской армии происходили оттого, что в то время, как по войскам читали приказ Наполеона, сам император верхом объезжал свои бивуаки."
                            }
                        ]
                    },
                    {
                        "sense_id": "2596e553-bfe8-3a0c-b6b1-14dadee40a43",
                        "entry_id": "4ccca33d-07c1-3b66-a443-472e070daf41",
                        "glosses": [
                            "временное месторасположение путешественников"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860d7265-8f2c-4493-b634-a856c101cb5b",
                                "sense_id": "2596e553-bfe8-3a0c-b6b1-14dadee40a43",
                                "text": "Участники должны иметь групповое и личное снаряжение для устройства бивуака."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fe7311a-793b-4560-a6c0-62bffacc7184",
                        "source_entry_id": "4ccca33d-07c1-3b66-a443-472e070daf41",
                        "source_sense_description": "стоянка войск для ночлега или отдыха под открытым небом",
                        "target_lang_word": "bivouac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bivouac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b350fc7f-7bbf-3d27-b1da-9673c831ea2a",
                                        "entry_id": "b2f1f0ee-bac2-34c4-a146-7e4bd10caef6",
                                        "glosses": [
                                            "An encampment for the night, usually without tents or covering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ba5127-b385-4061-b848-32d2feab65f5",
                                                "sense_id": "b350fc7f-7bbf-3d27-b1da-9673c831ea2a",
                                                "text": "Townsend hare inhabit this area, particularly above the cabin, and a skier is likely to have one explode from a tree well and disappear into the whiteness as he skis by. Life is a constant bivouac for them -- they spend days huddled in tree wells during storms -- but I suspect they are as content and warm in their luxurious coats as we are in a cabin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a38419f-ba50-31d7-ab3d-cef71052b43e",
                                        "entry_id": "b2f1f0ee-bac2-34c4-a146-7e4bd10caef6",
                                        "glosses": [
                                            "Any temporary encampment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a292f78-21a0-3c92-ba59-0b7a1bdccd8f",
                                        "entry_id": "b2f1f0ee-bac2-34c4-a146-7e4bd10caef6",
                                        "glosses": [
                                            "A temporary shelter constructed generally for a few nights."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ed5764-63cd-4d27-acf2-d238323d7353",
                                                "sense_id": "4a292f78-21a0-3c92-ba59-0b7a1bdccd8f",
                                                "text": "Behold the Mansion reared by Dædal Jack!\nSee the Malt stored in many a plethoric sack,\nIn the proud cirque of Juan's bivouac!"
                                            },
                                            {
                                                "example_id": "7d4a9261-d765-48ce-852b-b6bddbe63cd2",
                                                "sense_id": "4a292f78-21a0-3c92-ba59-0b7a1bdccd8f",
                                                "text": "The outing begins by Thursday noon, when the recreational vehicles start rumbling into town and their owners set up bivouacs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0825292c-c946-3055-a919-fe3a9835ee9e",
                                        "entry_id": "b2f1f0ee-bac2-34c4-a146-7e4bd10caef6",
                                        "glosses": [
                                            "The watch of a whole army by night, when in danger of surprise or attack."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06b00bb6-5220-386e-9e6e-75ad759001f1",
                                        "entry_id": "b2f1f0ee-bac2-34c4-a146-7e4bd10caef6",
                                        "glosses": [
                                            "A structure formed by migratory ants out of their own bodies to protect the queen and larvae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bivouac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "753ee1c2-0613-363e-9fe3-4c637541a7a9",
                                        "entry_id": "3fe88b26-505a-340a-9727-93b16f140479",
                                        "glosses": [
                                            "To set up camp."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ffa324-a17d-4758-a272-fe72115c09ba",
                                                "sense_id": "753ee1c2-0613-363e-9fe3-4c637541a7a9",
                                                "text": "We'll bivouac here tonight."
                                            },
                                            {
                                                "example_id": "4ac055a6-0db8-4ce3-be66-e167d67d159f",
                                                "sense_id": "753ee1c2-0613-363e-9fe3-4c637541a7a9",
                                                "text": "They reached the fir wood which had caused them so much trouble while it was still daylight, and bivouacked in a hollow just above it. It was tedious gathering the fire wood; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ef0890-9af3-32a2-8316-e9424b54a7f7",
                                        "entry_id": "3fe88b26-505a-340a-9727-93b16f140479",
                                        "glosses": [
                                            "To watch at night or be on guard, as a whole army."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a7aed69-a40f-3be7-824a-ddfabd4309a5",
                                        "entry_id": "3fe88b26-505a-340a-9727-93b16f140479",
                                        "glosses": [
                                            "To encamp for the night without tents or covering."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
