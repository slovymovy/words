                        "examples": [
                            {
                                "example_id": "66183d56-4d8a-46f0-8503-15b11e034921",
                                "sense_id": "2bbf40ff-3c0c-31e4-b13c-77c859a905bf",
                                "text": "„Er konnte einen Torso ohne Gliedmaßen ausmachen, überragt von einem vernarbten, missgestalteten Kopf, flach wie ein Schlangenschädel, dessen breiter Mund und tief liegende Augen zu einem nichtssagenden Lächeln erstarrt schienen.“"
                            },
                            {
                                "example_id": "8add4853-ee5c-43c2-ac2a-9d4bb513fade",
                                "sense_id": "2bbf40ff-3c0c-31e4-b13c-77c859a905bf",
                                "text": "„›Schlangenschädel‹, erklärte Isaac. ›Die werden zu Pulver zermahlen und heilen Schlangenbisse.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
