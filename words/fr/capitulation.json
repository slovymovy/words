    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e71f4acf-2d44-353c-9b1a-c3a632011c35",
                    "sense_definition": "Acte ou convention par lequel une force armée, une place forte ou un État se rend à l'ennemi.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général a refusé d'ordonner la <w>capitulation</w> malgré le siège impitoyable de la ville."
                        },
                        {
                            "text": "Après des semaines de pourparlers, les officiers durent enfin signer la <w>capitulation</w> sans condition."
                        }
                    ],
                    "synonyms": [
                        "reddition"
                    ],
                    "antonyms": [
                        "résistance"
                    ],
                    "common_phrases": [
                        "signer la capitulation",
                        "capitulation sans condition"
                    ]
                },
                {
                    "sense_id": "95f77666-d338-359f-b52e-6bcf563df03b",
                    "sense_definition": "Action de céder, d'abandonner ses principes, ses exigences ou de renoncer à une lutte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Accepter cette transaction financière équivaudrait à une véritable <w>capitulation</w> morale pour notre entreprise."
                        },
                        {
                            "text": "Il refuse toute forme de <w>capitulation</w> face aux injustices sociales dénoncées par la presse."
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "renoncement"
                    ],
                    "antonyms": [
                        "intransigeance",
                        "fermeté"
                    ],
                    "common_phrases": [
                        "capitulation de conscience"
                    ]
                },
                {
                    "sense_id": "a681c557-91d0-33d0-abc9-8c9b16fbb887",
                    "sense_definition": "Traité ou convention accordant des privilèges juridictionnels ou commerciaux à des résidents étrangers sur le territoire d'un État.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne <w>capitulation</w> assurait aux marchands européens une protection juridique spécifique dans le Levant."
                        },
                        {
                            "text": "Le régime des <w>capitulations</w> fut progressivement aboli au cours du vingtième siècle."
                        }
                    ],
                    "synonyms": [
                        "traité",
                        "convention"
                    ],
                    "common_phrases": [
                        "régime des capitulations"
                    ],
                    "traits": [
                        {
