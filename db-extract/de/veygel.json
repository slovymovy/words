                ],
                "senses": [
                    {
                        "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                        "entry_id": "48b91f7b-1a74-3258-8a0c-179a816df075",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e5240a-5d14-435f-934a-280e912dc06b",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Frau Veygel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "439392a6-3a63-4aff-b2a7-478af987c23b",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Herr Veygel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ceaab82f-ba94-4485-bcb3-8c048971c8cc",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Die Veygels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "baf478e8-af3b-436f-b1fa-b3da2e34540e",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Der Veygel trägt nie die Schals, die die Veygel ihm strickt."
                            },
                            {
                                "example_id": "21db4a34-bcf4-412b-bca4-7a1e43b760bb",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Veygel kommt, geht der Herr Veygel.“"
                            },
                            {
                                "example_id": "8f50502e-230b-4563-966d-038d05c4fee2",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Veygel kommt und geht."
                            },
                            {
                                "example_id": "a638cb9f-b381-4236-9eb8-3360db35fd52",
                                "sense_id": "ce8f4502-4043-367f-90f6-5819fb9e7db2",
                                "text": "Veygels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
