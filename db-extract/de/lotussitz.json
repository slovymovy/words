                                            "Yoga"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ff7f82-e8d1-4ff9-81ae-1ade85141baf",
                                                "sense_id": "c9ff152e-0e2f-3b07-a0a3-08c00f865fb2",
                                                "text": "Ils dorment sous les arbres, méditent en position du lotus au milieu des bambous, font la cuisine au coin du feu ou cousent des étoffes pour leurs robes et couvertures."
                                            }
                                        ]
