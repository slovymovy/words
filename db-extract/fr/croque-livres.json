                        "glosses": [
                            "Élément de mobilier urbain où le public est invité à prendre ou à laisser des livres."
                        ],
                        "tags": [
                            "Québec",
                            "Mobilier urbain"
                        ],
                        "examples": [
                            {
                                "example_id": "50328378-d0d9-4727-893b-4a8feac1941e",
                                "sense_id": "e8b0c68a-bf8f-3551-86e6-5d93224bbe35",
                                "text": "On adore le concept des croque-livres, ces petites boîtes communautaires dans lesquelles on peut laisser des bouquins et emporter ceux déposés par d’autres."
                            },
                            {
                                "example_id": "040a63f1-d430-42b1-8e0d-43c6598c368e",
                                "sense_id": "e8b0c68a-bf8f-3551-86e6-5d93224bbe35",
                                "text": "Depuis 2014, les croque-livres envahissent les rues et ruelles de Montréal. Ces bestioles sympathiques sont des bibliothèques collectives et collaboratives qui ne survivent que grâce à la bonne volonté de ceux qui les adoptent."
                            }
                        ]
                    }
