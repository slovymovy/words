                    {
                        "sense_id": "727cb2ee-f2ba-3d5a-a957-111cd92dd310",
                        "entry_id": "10d1e04a-64d5-36c8-b060-e50f35a54a8b",
                        "glosses": [
                            "En France, indemnité versée à un salarié lors de son départ à la retraite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81954ad4-e419-4be3-9b07-3ac75dc2f13f",
                                "sense_id": "727cb2ee-f2ba-3d5a-a957-111cd92dd310",
                                "text": "À son départ à la retraite, un salarié a droit à une indemnité de fin de carrière (IFC), sous conditions, versée par son employeur."
                            },
                            {
                                "example_id": "0d22437e-56e0-4fef-849d-41f121d75572",
                                "sense_id": "727cb2ee-f2ba-3d5a-a957-111cd92dd310",
                                "text": "À chaque départ en retraite, l’entreprise a pour obligation de verser au salarié une Indemnité de Fin de Carrière (IFC)."
                            },
                            {
                                "example_id": "4f502e7c-57b3-4871-bc5c-f0ae14cd662e",
                                "sense_id": "727cb2ee-f2ba-3d5a-a957-111cd92dd310",
                                "text": "L’indemnité de fin de carrière ou IFC est une indemnité versée au salarié par l’employeur lors de son départ à la retraite."
                            }
                        ]
                    }
