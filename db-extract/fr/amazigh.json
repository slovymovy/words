                    {
                        "sense_id": "576bb4a2-e55b-383d-b592-5e1422ceeee6",
                        "entry_id": "a014f55f-20ce-316d-bb22-821d06171576",
                        "glosses": [
                            "Membre des Amazighs, peuple d'Afrique septentrionale et occidentale."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "note": "Endonyme de Berbère",
                        "examples": [
                            {
                                "example_id": "5f6159a2-e639-45fd-8097-c52a91ad4115",
                                "sense_id": "576bb4a2-e55b-383d-b592-5e1422ceeee6",
                                "text": "Les Amazigh célèbrent plusieurs traditions culinaires et culturelles au nouvel an, dont la préparation et le partage du couscous prennent la place d’honneur."
                            },
                            {
                                "example_id": "497e4615-f51f-4107-aca6-9b2e4696648b",
                                "sense_id": "576bb4a2-e55b-383d-b592-5e1422ceeee6",
                                "text": "Cinq répondants sur 11 formulent l’impossibilité d’un racisme anti-Noirs chez les Amazighs en raison de la traite arabo-musulmane des Amazighs : « on ne peut pas avoir été un esclave et être raciste », « mon père m’a toujours dit qu’on descendait d’esclaves comme les Noirs »."
                            }
                        ]
                    }
                ],
