                        "sense_id": "f04498ac-ff6c-3f5c-889e-7f2a60179b26",
                        "entry_id": "78473634-7b22-31fa-a117-28fa58b939c6",
                        "glosses": [
                            "kliniek waar patiënten van hun drugsverslaving afgeholpen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082c9517-18c5-464e-9d5a-56ca3b5dd4aa",
                                "sense_id": "f04498ac-ff6c-3f5c-889e-7f2a60179b26",
                                "text": "De in Milwaukee geboren zanger Alwin Lopez Jarreau deed als zoon van een predikant zijn eerste zangervaringen op in het kerkkoor. Na een studie psychologie werkte hij een tijd als welzijnswerker in een afkickcentrum. Hij koesterde grote liefde voor muziek, maar kon zich niet voorstellen er ooit een cent mee te verdienen, al kwam het moment dat hij als professioneel zanger zijn kostje bij elkaar schraapte in een jazztrio met George Duke in lokale clubs in Californië."
                            },
                            {
                                "example_id": "17f9a24a-f58d-463a-990b-532f92f52b74",
                                "sense_id": "f04498ac-ff6c-3f5c-889e-7f2a60179b26",
                                "text": "Politie probeert te voorkomen dat drugsverslaafden ontsnappen uit een afkickcentrum in Dong Nai in Vietnam."
                            }
                        ]
                    }
