                            {
                                "example_id": "29877a71-c2eb-4b0a-856f-e38946f3f3fe",
                                "sense_id": "7fb8a5a0-87b0-30cb-b062-626cf1c8a3ba",
                                "text": "La temporalité narrative."
                            },
                            {
                                "example_id": "b19eabc0-98fd-436d-bfa3-2e82459ef61a",
                                "sense_id": "7fb8a5a0-87b0-30cb-b062-626cf1c8a3ba",
                                "text": "Régimes sémiotiques de la temporalité."
                            },
                            {
                                "example_id": "a0e6bce0-de77-49df-b391-ce58a737c6c6",
                                "sense_id": "7fb8a5a0-87b0-30cb-b062-626cf1c8a3ba",
                                "text": "Contrairement à d’autres réfugiés français, il s’inscrit dans une temporalité longue de l’exil en apprenant immédiatement l’anglais, qu’il maîtrise mal."
                            }
                        ]
                    }
