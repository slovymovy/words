                        "glosses": [
                            "wet die de status en opvang van vluchtelingen regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8cb7b4-d691-4a2a-ae90-9d36b19e6fb9",
                                "sense_id": "7e694a1e-8b2d-3d90-b334-48fbdabb927b",
                                "text": "Een omstreden asielwet in Australië bepaalt dat alle vluchtelingen die worden tegengehouden bij pogingen om het land per boot te bereiken, naar opvangcentra op Manus en op het eiland Nauru worden gebracht. Zij maken vervolgens geen enkele kans op een legaal verblijf in Australië. De minister van Immigratie Peter Dutton liet weten dat Canberra vasthoudt aan die politiek"
                            },
                            {
                                "example_id": "4ef909c2-a777-46dc-9fe6-010ab33bb3f5",
                                "sense_id": "7e694a1e-8b2d-3d90-b334-48fbdabb927b",
                                "text": "Deens parlement stemt voor strengere asielwet: Het Deense parlement heeft dinsdag een pakket maatregelen aangenomen die het vluchtelingen moeilijker moeten maken asiel aan te vragen."
                            }
                        ]
                    }
