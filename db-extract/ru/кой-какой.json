                ],
                "translations": [
                    {
                        "translation_id": "61725e56-eac4-4263-a152-0228364e344f",
                        "source_entry_id": "1b26ece8-081d-38f9-aa91-482a906cb1e6",
                        "source_sense_id": "0c9dc744-6c87-3082-b064-afba34949368",
                        "target_lang_word": "some",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "some",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c02f1a45-56ab-352a-8b99-baf40d766063",
                                        "entry_id": "95ae05bf-9895-3a0f-adb1-ef66f9cf8f41",
                                        "glosses": [
                                            "A certain number, at least two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d9711b-77c3-4a04-82b0-04e990aad0b4",
                                                "sense_id": "c02f1a45-56ab-352a-8b99-baf40d766063",
                                                "text": "Some enjoy spicy food, others prefer it milder."
                                            },
                                            {
                                                "example_id": "6dafab10-377d-4877-bca9-f7a5ccb67105",
                                                "sense_id": "c02f1a45-56ab-352a-8b99-baf40d766063",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe. Some call it geoeconomics, but it's geopolitics too. The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5730fa-84ec-37d6-a0ea-4ff0704edbff",
                                        "entry_id": "95ae05bf-9895-3a0f-adb1-ef66f9cf8f41",
                                        "glosses": [
                                            "An indefinite quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2de1da5-6718-4751-a78b-1f69936d45d5",
                                                "sense_id": "ea5730fa-84ec-37d6-a0ea-4ff0704edbff",
                                                "text": "Can I have some of them?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a384237b-2ba1-3aba-b8b2-5414ad4540ff",
                                        "entry_id": "95ae05bf-9895-3a0f-adb1-ef66f9cf8f41",
                                        "glosses": [
                                            "An indefinite amount; a part. Used mostly with abstract and nonliving objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdf179d-f9fd-48c9-a665-2504826db8f5",
                                                "sense_id": "a384237b-2ba1-3aba-b8b2-5414ad4540ff",
                                                "text": "Please give me some of the cake."
                                            },
                                            {
                                                "example_id": "3038e0b3-1ac3-45d4-b410-d95e591e3ad4",
                                                "sense_id": "a384237b-2ba1-3aba-b8b2-5414ad4540ff",
                                                "text": "Everyone is wrong some of the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3cbae5-4706-3e42-8f39-53372e8b39b2",
                                        "entry_id": "95ae05bf-9895-3a0f-adb1-ef66f9cf8f41",
                                        "glosses": [
                                            "Someone, a certain person."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38076065-bee9-49db-b4b6-fa53de72a7c5",
                                                "sense_id": "3a3cbae5-4706-3e42-8f39-53372e8b39b2",
                                                "text": "Euery counseller extolleth counsell; but there is some that counselleth for himselfe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "some",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d56bed-207e-3bae-a72a-595154355535",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "A nonzero, unspecified proportion of (a bounded set of countable things): at least two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9978183-e435-45d7-930b-f5c5fba161a6",
                                                "sense_id": "a8d56bed-207e-3bae-a72a-595154355535",
                                                "text": "Near-synonym: any"
                                            },
                                            {
                                                "example_id": "49f55149-4890-44c6-824f-9599311ea495",
                                                "sense_id": "a8d56bed-207e-3bae-a72a-595154355535",
                                                "text": "Some people like camping."
                                            },
                                            {
                                                "example_id": "22daa0a7-19c9-41b0-8020-f41aa21dda49",
                                                "sense_id": "a8d56bed-207e-3bae-a72a-595154355535",
                                                "text": "Many people, especially some evangelical Christians, have been less than optimistic about the Potter influence."
                                            },
                                            {
                                                "example_id": "386fcfe3-881c-485f-921d-26a9f9e5840d",
                                                "sense_id": "a8d56bed-207e-3bae-a72a-595154355535",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            },
                                            {
                                                "example_id": "41703270-f0c2-4d8c-b8f8-621248aa9250",
                                                "sense_id": "a8d56bed-207e-3bae-a72a-595154355535",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18db3ab9-61ac-372d-b5e7-857a21d8ad09",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "A nonzero, unspecified quantity or number of (an unbounded set of countable things)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f14afb-b860-481f-b4cd-867cd192f531",
                                                "sense_id": "18db3ab9-61ac-372d-b5e7-857a21d8ad09",
                                                "text": "Near-synonym: any"
                                            },
                                            {
                                                "example_id": "48e5e4a9-9774-4185-bfac-516772f6cfcc",
                                                "sense_id": "18db3ab9-61ac-372d-b5e7-857a21d8ad09",
                                                "text": "Would you like some grapes?"
                                            },
                                            {
                                                "example_id": "1078b4e9-9d2d-44b8-8ece-b0af4e1aa4d1",
                                                "sense_id": "18db3ab9-61ac-372d-b5e7-857a21d8ad09",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            },
                                            {
                                                "example_id": "87a33a34-8c0b-4a4d-9257-61fb1cbee2f9",
                                                "sense_id": "18db3ab9-61ac-372d-b5e7-857a21d8ad09",
                                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061ae817-f1bb-310b-a6a1-47908082d4ba",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "An unspecified amount of (something uncountable)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fa5268-00d4-47bb-b504-507a31f41bc3",
                                                "sense_id": "061ae817-f1bb-310b-a6a1-47908082d4ba",
                                                "text": "Near-synonym: any"
                                            },
                                            {
                                                "example_id": "63be5065-a5c5-48b7-99e1-2fefb940ae9b",
                                                "sense_id": "061ae817-f1bb-310b-a6a1-47908082d4ba",
                                                "text": "Would you like some water?"
                                            },
                                            {
                                                "example_id": "87d47523-b115-4d0a-a8c7-e08a8d89f852",
                                                "sense_id": "061ae817-f1bb-310b-a6a1-47908082d4ba",
                                                "text": "After some persuasion, he finally agreed."
                                            },
                                            {
                                                "example_id": "40691468-99d0-4511-b6df-aa0cab718a8a",
                                                "sense_id": "061ae817-f1bb-310b-a6a1-47908082d4ba",
                                                "text": "It was a joy to snatch some brief respite, jump upon a tram, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74ca4932-cb50-3ed0-b091-be872b1724e0",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "A certain, an unspecified or unknown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84be0903-9043-4bf9-9390-f5180a12bf8e",
                                                "sense_id": "74ca4932-cb50-3ed0-b091-be872b1724e0",
                                                "text": "I've just met some guy who said he knew you."
                                            },
                                            {
                                                "example_id": "913e1ef3-5e52-4f54-a56e-141db6b93c7e",
                                                "sense_id": "74ca4932-cb50-3ed0-b091-be872b1724e0",
                                                "text": "The sequence S converges to zero for some initial value v."
                                            },
                                            {
                                                "example_id": "57ca80f4-86ef-4c75-883b-baf81c2bb526",
                                                "sense_id": "74ca4932-cb50-3ed0-b091-be872b1724e0",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            },
                                            {
                                                "example_id": "30886642-e82d-4c4c-888c-7dddc63aa909",
                                                "sense_id": "74ca4932-cb50-3ed0-b091-be872b1724e0",
                                                "text": "Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet. Perhaps we assume that our name, address and search preferences will be viewed by some unseen pair of corporate eyes, probably not human, and don't mind that much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c38bfe-9c87-39eb-b7f9-ffe062f1a96f",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "A considerable quantity or number of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3063d78-cede-44d2-b188-952d6bba3acc",
                                                "sense_id": "93c38bfe-9c87-39eb-b7f9-ffe062f1a96f",
                                                "text": "He had edited the paper for some years."
                                            },
                                            {
                                                "example_id": "83c7b5a5-bc58-41a2-a044-3e4681d409ad",
                                                "sense_id": "93c38bfe-9c87-39eb-b7f9-ffe062f1a96f",
                                                "text": "He stopped working some time ago."
                                            },
                                            {
                                                "example_id": "69f816b3-40f4-4900-a4e5-d076776bc0d7",
                                                "sense_id": "93c38bfe-9c87-39eb-b7f9-ffe062f1a96f",
                                                "text": "[…] I took it, in the hope that it was not intended for early use, and would not be missed for some time."
                                            },
                                            {
                                                "example_id": "fb7cdc2c-14ce-4fbe-b3ea-e470a7538aba",
                                                "sense_id": "93c38bfe-9c87-39eb-b7f9-ffe062f1a96f",
                                                "text": "We drove back to the office with some concern on my part at the prospect of so large a case. Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f6e9f0-cba6-3dd1-8276-daf4069536e5",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "Approximately, about (with a number)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90281af9-c638-4167-a5d6-cecffe92ab0f",
                                                "sense_id": "16f6e9f0-cba6-3dd1-8276-daf4069536e5",
                                                "text": "She has worked at the company for some thirty years now. (31 and two months, to be exact.)"
                                            },
                                            {
                                                "example_id": "1c7fa986-c673-4e38-a7f5-62403c634603",
                                                "sense_id": "16f6e9f0-cba6-3dd1-8276-daf4069536e5",
                                                "text": "There were only some three or four cars in the lot at the time."
                                            },
                                            {
                                                "example_id": "d18a6aca-63fa-490f-984b-471f04700f99",
                                                "sense_id": "16f6e9f0-cba6-3dd1-8276-daf4069536e5",
                                                "text": "What other natural experiments might we have to test climate sensitivity? Another one that happens every year is the change in seasons. Winter predictably follows summer, being some fifteen degrees colder in the Northern Hemisphere and five degrees colder than summer in the Southern Hemisphere. The reason the Southern Hemisphere has a smaller seasonal cycle is because it has much more ocean than land,[…]"
                                            },
                                            {
                                                "example_id": "6c720532-1fdd-411c-ba81-edcb971b1aac",
                                                "sense_id": "16f6e9f0-cba6-3dd1-8276-daf4069536e5",
                                                "text": "the local police, who, with the investigator, reportedly placed a compass near the two signs that had rattled and found a deviation of some fifteen degrees. Placed next to the Renault in which they had come, the compass showed a deviation of only four degrees, but there was no deviation at all near the sign that had not rattled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69f5df97-db04-3731-8694-ff8db6ec7fa0",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "Emphasizing a number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da3548e-779f-4b25-9997-bbabd63fdb56",
                                                "sense_id": "69f5df97-db04-3731-8694-ff8db6ec7fa0",
                                                "text": "She has worked at the company for some five years now! How remarkable!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9778477f-56bc-3563-9b1e-b02280a4dd46",
                                        "entry_id": "8baea31d-27c3-3606-b4cc-eb4452b5fada",
                                        "glosses": [
                                            "A remarkable."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad00000-d343-450c-8ade-72f36255464f",
                                                "sense_id": "9778477f-56bc-3563-9b1e-b02280a4dd46",
                                                "text": "He is some acrobat!"
                                            },
                                            {
                                                "example_id": "6e7f43e5-c205-46ce-a4e4-730e8b73d279",
                                                "sense_id": "9778477f-56bc-3563-9b1e-b02280a4dd46",
                                                "text": "That was some speech you gave!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "some",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c250083e-e2a8-3a43-9b8e-dbdee7c419f8",
                                        "entry_id": "9fea073c-0d1e-3afa-9d76-6793de6a32f1",
                                        "glosses": [
                                            "Of a measurement: approximately, roughly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "129f5923-09c5-41dd-9365-6bb81a88dc54",
                                                "sense_id": "c250083e-e2a8-3a43-9b8e-dbdee7c419f8",
                                                "text": "I guess he must have weighed some 90 kilos."
                                            },
                                            {
                                                "example_id": "c7328f1c-6e2b-412f-9f30-28f8ea08ff34",
                                                "sense_id": "c250083e-e2a8-3a43-9b8e-dbdee7c419f8",
                                                "text": "Some 30,000 spectators witnessed the feat."
                                            },
                                            {
                                                "example_id": "977314b3-9d8a-43eb-9098-d3b6242c49d8",
                                                "sense_id": "c250083e-e2a8-3a43-9b8e-dbdee7c419f8",
                                                "text": "Some 4,000 acres of land were flooded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7bd59ec-7489-346e-b083-3f70e69d5d97",
                                        "entry_id": "9fea073c-0d1e-3afa-9d76-6793de6a32f1",
                                        "glosses": [
                                            "To a certain extent, or for a certain period."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c5ea314-be2f-4e62-8c9c-8f41439660dd",
                                                "sense_id": "b7bd59ec-7489-346e-b083-3f70e69d5d97",
                                                "text": "They walked some and talked some."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a113bf81-c599-3141-8815-5e0b527f1bef",
                                        "entry_id": "9fea073c-0d1e-3afa-9d76-6793de6a32f1",
                                        "glosses": [
                                            "Somewhat, a little."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7647a6a-6f41-48d0-96c1-6177a515defe",
                                                "sense_id": "a113bf81-c599-3141-8815-5e0b527f1bef",
                                                "text": "I felt some better and continued taking the preparation through all that day, still ad libitum, and by evening, twenty-four hours after I began its use, felt considerably improved."
                                            },
                                            {
                                                "example_id": "1a435840-3f0a-42a8-9007-71b7526ed520",
                                                "sense_id": "a113bf81-c599-3141-8815-5e0b527f1bef",
                                                "text": "Have felt some better to-day than yesterday but not quite normal. A little nervous all day. Slept better than previous night, but not so well as usual, for about 7 hrs."
                                            },
                                            {
                                                "example_id": "a6d6fe0f-4970-4f8a-9c8e-c6446d8dc910",
                                                "sense_id": "a113bf81-c599-3141-8815-5e0b527f1bef",
                                                "text": "\"She's some better,\" the pilot said, \"but it'll be a long convalescence. Pierre's taking real good care of her. Ongola's a rock, as always, and if Joel would only stop yapping about losing so much cargo...\""
                                            },
                                            {
                                                "example_id": "b54a1a2a-b0c5-46ed-9e79-085500b06dd5",
                                                "sense_id": "a113bf81-c599-3141-8815-5e0b527f1bef",
                                                "text": "It looked some like Muriel, but not enough to be sure by any manner of means."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
