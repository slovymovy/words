                            }
                        ]
                    },
                    {
                        "translation_id": "c84ad5b9-51bb-47df-9055-51b65621b0ef",
                        "source_entry_id": "97e73b70-c9f8-3247-8f51-1fa4563aa4fb",
                        "source_sense_description": "куча чего-либо",
                        "target_lang_word": "Haufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "mehrere Teile, Sachen an einem Ort übereinandergeworfen, unsortiert abgelegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145629e9-ce64-4905-b4a9-e1cac290bb7a",
                                                "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                                "text": "Der Haufen an Schrott im Vorgarten muss noch beseitigt werden."
                                            },
                                            {
                                                "example_id": "ee60e837-2580-4c50-8843-a8f8fd2e6b02",
                                                "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                                "text": "Wir haben immer noch einen Haufen an Problemen, die auf eine Lösung warten."
                                            },
                                            {
                                                "example_id": "ec4b9956-9cce-486b-a9b3-c44769ccbde6",
                                                "sense_id": "2e540066-81b3-3902-970e-3b2b90e79ed0",
                                                "text": "„Einen der Haufen auf dem Boden würde sie ans Rote Kreuz spenden, und der andere gehörte ihrer drei Jahre älteren Schwester Dagný.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "mehrere Menschen, zum Beispiel an einem Ort ungeordnet versammelt"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e1ae835-cc22-49a9-8bc1-729f1140c622",
                                                "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                                "text": "Ein Haufen Menschen hatte sich da vor dem Rathaus versammelt."
                                            },
                                            {
                                                "example_id": "91c196af-d920-435e-a7d8-b84aa20fbf3c",
                                                "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                                "text": "Auf die Anzeige hat sich ein ganzer Haufen in Frage kommender Spender gemeldet."
                                            },
                                            {
                                                "example_id": "50a819ba-2f14-4429-bbfd-a9014acc8ec0",
                                                "sense_id": "0e5098fc-c52e-3b88-bfe9-1cc1c1e73b75",
                                                "text": "„Wir waren ein kurioser Haufen und ich hoffte, dass wir die Herausforderungen, die die Reise durch die Sahara mit sich bringen würde, meistern konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "an exponierter Stelle liegender Kot, meistens von Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64547d2c-e2b1-47c2-8175-60d5c798a611",
                                                "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                                "text": "„Es hätte mindestens eine halbe Stunde gedauert, mit mir nach Hause zu gehen, und er hatte nicht die Absicht, sich so viel wertvolle Zeit stehlen zu lassen, nur weil sein kleiner Bruder einen Haufen machen musste.“"
                                            },
                                            {
                                                "example_id": "4fa0b633-c45b-442b-9e10-915b2fc58f16",
                                                "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                                "text": "Genau in diesen Haufen musste er treten."
                                            },
                                            {
                                                "example_id": "87a0f108-8a39-4e3b-ac8d-9887c873fca6",
                                                "sense_id": "8e4143ad-532e-3e98-9d41-c1e369ba5ff5",
                                                "text": "Der Sportplatz ist von den Haufen der Hunde der Nachbarschaft eingerahmt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "30474c3a-aefb-381d-b7ee-29f44d86c72f",
                                        "entry_id": "e0df366a-7ddd-3142-9ba8-2550cd5e951e",
                                        "glosses": [
                                            "militärische Einheit"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6944a8a0-e6c8-4fa9-859f-f2107058b122",
                                                "sense_id": "30474c3a-aefb-381d-b7ee-29f44d86c72f",
                                                "text": "„Die Fähnlein bilden den Haufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
