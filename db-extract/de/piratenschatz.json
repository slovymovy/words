                "senses": [
                    {
                        "sense_id": "6b5a6bb6-25e1-3927-9247-95762ad1d201",
                        "entry_id": "02289951-ca8a-3705-af4f-83b9b154eda0",
                        "glosses": [
                            "Schatz, der von Piraten erbeutet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79f2768-7731-46ec-a1c3-49756955efa9",
                                "sense_id": "6b5a6bb6-25e1-3927-9247-95762ad1d201",
                                "text": "„Miss Tilton neigte nach dem Vergleich aller möglichen Hypothesen über den Ursprung der Tiara und ihr Erscheinen in Neuengland zu der Ansicht, sie sei Teil eines exotischen Piratenschatzes, den der alte Kapitän Obed Marsh entdeckt habe.“"
                            },
                            {
                                "example_id": "e8f42a06-17db-41b3-b0b4-1525bb6ae8e9",
                                "sense_id": "6b5a6bb6-25e1-3927-9247-95762ad1d201",
                                "text": "„Messingknöpfe schimmerten wie ein Piratenschatz im trüben Licht.“"
                            },
                            {
                                "example_id": "d35f0d54-1593-43dc-be57-a5d804a6458f",
                                "sense_id": "6b5a6bb6-25e1-3927-9247-95762ad1d201",
                                "text": "„Die ganze Zeit folge ich ihm, schleppe ihm diesen Piratenschatz hinterher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
