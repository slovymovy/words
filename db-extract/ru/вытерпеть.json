                ],
                "senses": [
                    {
                        "sense_id": "08ca8885-6152-3428-8b15-7b8e1aa8df9f",
                        "entry_id": "fa243861-6880-3bea-810a-ef5f3be7e45d",
                        "glosses": [
                            "терпеливо перенести (боль, страдание, неудобства и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e0f8b0d-3be7-4611-9093-583adbbe1bae",
                        "source_entry_id": "fa243861-6880-3bea-810a-ef5f3be7e45d",
                        "source_sense_id": "08ca8885-6152-3428-8b15-7b8e1aa8df9f",
                        "target_lang_word": "endurer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endurer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9398e78c-ad15-3e97-b701-10eb196200cb",
                                        "entry_id": "008560ba-6a87-3c6a-ae30-71a176f72d8b",
                                        "glosses": [
                                            "Souffrir, supporter avec fermeté, constance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6450e218-96e2-4512-9b3f-e3895397b9e0",
                                                "sense_id": "9398e78c-ad15-3e97-b701-10eb196200cb",
                                                "text": "Les foules annamites endureront-elles longtemps les assassins payés par la Démocratie ?"
                                            },
                                            {
                                                "example_id": "102340fa-a1ab-49a8-96d8-1170d6a77997",
                                                "sense_id": "9398e78c-ad15-3e97-b701-10eb196200cb",
                                                "text": "Malgré les souffrances physiques que j’endure au moment où je trace ces lignes, je me souviens non sans une mélancolie amusée de l’abominable caban bleu marine dont m’affublait l’autrice de mes jours sans tenir compte de mes supplications : […]."
                                            },
                                            {
                                                "example_id": "3038abd0-4c47-4cca-aa56-418d0e813bf1",
                                                "sense_id": "9398e78c-ad15-3e97-b701-10eb196200cb",
                                                "text": "Notre devoir est enfin de dire aux centaines de milliers de rapatriés pour qui la guerre d’Algérie s’est conclue par le déracinement que la Nation reconnait ce qu’ils ont enduré. Pour eux non plus, la sidération et la déchirure ne se sont pas arrêtés avec les violences armées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "218e27ba-b841-3785-b5d5-afaac5f7cf26",
                                        "entry_id": "008560ba-6a87-3c6a-ae30-71a176f72d8b",
                                        "glosses": [
                                            "Permettre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1834d6bf-4948-4187-b2db-ef308c9b7e5d",
                                                "sense_id": "218e27ba-b841-3785-b5d5-afaac5f7cf26",
                                                "text": "N’endurez pas qu’on fasse tort à votre famille."
                                            },
                                            {
                                                "example_id": "c93af1af-189b-4d4c-89e9-af3b708a1dab",
                                                "sense_id": "218e27ba-b841-3785-b5d5-afaac5f7cf26",
                                                "text": "— Endure au moins qu’i soupe… R’garde comme il est… Tu vois bien qu’il en peut plus, qu’il est à bout d’nerfs, qu’il va s’évanouir !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79d545f7-de88-3397-bbb7-8a7b5233484e",
                                        "entry_id": "008560ba-6a87-3c6a-ae30-71a176f72d8b",
                                        "glosses": [
                                            "Relâcher son effort sur les avirons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519eacf9-16dd-4e81-b774-11b73e554089",
                                                "sense_id": "79d545f7-de88-3397-bbb7-8a7b5233484e",
                                                "text": "Endurez partout ! lança Allday qui se tenait genoux fléchis, barre au poing. Les avirons en dedans !."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b7fb72e-51fd-4505-8bfd-9afa77afa0df",
                        "source_entry_id": "fa243861-6880-3bea-810a-ef5f3be7e45d",
                        "source_sense_id": "08ca8885-6152-3428-8b15-7b8e1aa8df9f",
                        "target_lang_word": "supporter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supporter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c884a155-5c38-3c63-9058-0c1a14b63199",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Porter ; soutenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a127101-0e49-485f-aab8-8307d45cfc00",
                                                "sense_id": "c884a155-5c38-3c63-9058-0c1a14b63199",
                                                "text": "À l'intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f547f1d2-e7b6-3395-94b7-279d17144892",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Soutenir, encourager."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09fa2c0-28b4-4311-9a68-9bc467cc4799",
                                                "sense_id": "f547f1d2-e7b6-3395-94b7-279d17144892",
                                                "text": "Il y a une réelle solidarité africaine : les Sud-Africains supportent leur équipe, les Bafana Bafana, mais aussi les autres équipes africaines."
                                            },
                                            {
                                                "example_id": "61c1c15d-d163-4d82-bf58-b58be16816ce",
                                                "sense_id": "f547f1d2-e7b6-3395-94b7-279d17144892",
                                                "text": "Je m'en suis sortie parce que j'en ai parlé, parce que j'ai eu de l'aide, parce que j'ai pu me confier, parce qu'on m'a supportée…», a-t-elle mentionné."
                                            },
                                            {
                                                "example_id": "b8254116-189d-4f34-90eb-234629a903f7",
                                                "sense_id": "f547f1d2-e7b6-3395-94b7-279d17144892",
                                                "text": "Les gens commencent à voir plus les camionneurs comme un groupe de sauveurs qui vont faire tomber toutes les mesures sanitaires, mais il ne faut pas oublier qu'à la base, ils se sont levés pour dénoncer la vaccination obligatoire aux frontières et je les supporte là-dedans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Souffrir ; endurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33906a42-c017-40ba-8615-bd609b0a0f9e",
                                                "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                                                "text": "Bien qu’il fût Islandais pur sang, il semblait supporter difficilement le climat de son pays : il était affligé d’une toux opiniâtre."
                                            },
                                            {
                                                "example_id": "842f3b53-ea7b-4ead-86a7-da994888e8a2",
                                                "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                                                "text": "Pauvre Mauricia ! Transplantée sous le ciel inclément de la banlieue parisienne, elle paraissait pourtant supporter vaillamment sa captivité."
                                            },
                                            {
                                                "example_id": "091deb37-39ef-4450-8fab-08184d5ebfa0",
                                                "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                                                "text": "Celui qui remarquait que les fils supportent mieux la mort d’un père que la perte de leur patrimoine eût pu voir que les pères le leur rendaient bien : ils supportent mieux la mort de leurs fils que la perte de leur argent. La mort de deux millions de fils fait courir moins de risques à un gouvernement que la réclamation de quelques millions d’impôts."
                                            },
                                            {
                                                "example_id": "562ec882-42a3-40ca-b61a-9a8b3d43abe5",
                                                "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                                                "text": "— Les gars des Stups prétendent que beaucoup de drogués prennent de la méthédrine quand ils ne peuvent se procurer de l’héro. Apparemment, ça les aide à supporter les douleurs du manque."
                                            },
                                            {
                                                "example_id": "4315636c-2e9b-4203-b2f6-ad08dfc28114",
                                                "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                                                "text": "Angie avait bien vite compris les raisons de cette attitude : Petrina ne supportait pas que sa propre enfant lui volât la vedette en société et entendait bien rester le centre d'intérêt de tous..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7590697-cd3c-3479-8a81-8dc70f780a39",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Souffrir avec patience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53bc61c1-5dbe-4ca7-b960-e0a27d4619b2",
                                                "sense_id": "d7590697-cd3c-3479-8a81-8dc70f780a39",
                                                "text": "Ses menaces ? peuh ! des paroles de soulaud. Comment avait-on pu le supporter et le craindre si longtemps !"
                                            },
                                            {
                                                "example_id": "80d6c1aa-2f84-4fdf-993f-745709858c50",
                                                "sense_id": "d7590697-cd3c-3479-8a81-8dc70f780a39",
                                                "text": "La priorité chez eux était la chute de rein. Le cul quoi ! Et sur ce sujet, leur sévérité était impardonnable. Ils ne supportaient pas la moindre stéatopygie. Fusse-t-elle légère."
                                            },
                                            {
                                                "example_id": "163edc62-4696-400d-88d7-acefc936d9da",
                                                "sense_id": "d7590697-cd3c-3479-8a81-8dc70f780a39",
                                                "text": "Pour supporter cette anxiété, nous inventons des mythologies personnelles ou collectives. Plutôt que de céder à la panique, nous construisons des mondes. C’est le moment. Il ne durera peut-être pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50eda212-d44a-38f1-89bf-d637cf1bf879",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Porter ; avoir à charge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6caf504c-792a-40e9-8898-9eb5afa1cb77",
                                                "sense_id": "50eda212-d44a-38f1-89bf-d637cf1bf879",
                                                "text": "Les sociétaires soumis à l’assurance obligatoire auront à supporter deux tiers du montant des cotisations, l'autre tiers est à la charge du patron."
                                            },
                                            {
                                                "example_id": "e2cf2861-50ff-4e38-bbb6-d3fab015e1c8",
                                                "sense_id": "50eda212-d44a-38f1-89bf-d637cf1bf879",
                                                "text": "Il en supportera les conséquences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52905906-df51-30cc-a5a1-a2ecc548f0cf",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Être à l’épreuve de, résister à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77e53ae-a48d-4498-b7eb-faddc194cbd6",
                                                "sense_id": "52905906-df51-30cc-a5a1-a2ecc548f0cf",
                                                "text": "Le gréement dormant en fil d'acier galvanisé, peut supporter un effort de dix tonnes sans se rompre."
                                            },
                                            {
                                                "example_id": "0b44af04-48e7-4b76-b106-77fd39fbfc57",
                                                "sense_id": "52905906-df51-30cc-a5a1-a2ecc548f0cf",
                                                "text": "Ces plantes peuvent supporter un grand froid."
                                            },
                                            {
                                                "example_id": "c9249a27-54a7-496f-afd6-11bdd0cd6f7f",
                                                "sense_id": "52905906-df51-30cc-a5a1-a2ecc548f0cf",
                                                "text": "Cet ouvrage ne supporte pas l’examen, la critique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ef5e8d-de00-38c5-b01c-5e4bbfa60c96",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Fournir, intégrer, prendre en charge."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6729ba-a373-4f4a-b964-23281b4e97ec",
                                                "sense_id": "17ef5e8d-de00-38c5-b01c-5e4bbfa60c96",
                                                "text": "Ce logiciel supporte toutes les fonctionnalités de détection des anglicismes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132c7c55-3b43-31d0-977d-05c5a487b774",
                                        "entry_id": "44c46810-6001-3dd4-abcd-03fe74d20a79",
                                        "glosses": [
                                            "Être compatible avec."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50e1a8a-fbfc-4bc5-a5dc-cf09b512d55d",
                                                "sense_id": "132c7c55-3b43-31d0-977d-05c5a487b774",
                                                "text": "Ce logiciel supporte tous les systèmes d’exploitation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supporter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca23c68-fb9a-3167-9d92-dc27fc91d47e",
                                        "entry_id": "7cc5ee19-d4f9-30d3-96a5-8995aff2da3f",
                                        "glosses": [
                                            "Personne encourageant un sportif ou une équipe sportive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98d6cb4-9bbc-4a4d-8df0-36d4606c0d9b",
                                                "sense_id": "8ca23c68-fb9a-3167-9d92-dc27fc91d47e",
                                                "text": "Des études ont montré, par exemple, que les supporters d'une équipe de football qui perd voient leur niveau de testostérone chuter, contrairement à celui des supporters de l'équipe vainqueure, dont le taux de testostérone augmente (sachant que les niveaux étaient comparables avant le match)."
                                            },
                                            {
                                                "example_id": "d2efb999-4a8f-4558-b183-ad0194f5aff5",
                                                "sense_id": "8ca23c68-fb9a-3167-9d92-dc27fc91d47e",
                                                "text": "À quelques mètres des grilles, le bus est stoppé par des « supporters » qui lancent des pierres et des bombes agricoles sur le véhicule. Bloqués pendant de longues minutes et traumatisés, les joueurs rentrent en Normandie sans avoir joué."
                                            },
                                            {
                                                "example_id": "82caed63-542d-4458-aa5a-83f35326c64d",
                                                "sense_id": "8ca23c68-fb9a-3167-9d92-dc27fc91d47e",
                                                "text": "L'hymne des hirakistes, les manifestants antirégime qui défilent pacifiquement dans les rues chaque vendredi en Algérie, est une adaptation de La Casa del Mouradia, une célèbre chanson des supporters de l'équipe de football USM Alger."
                                            },
                                            {
                                                "example_id": "e57a2db0-4e38-4f7a-8ee9-91a98550d661",
                                                "sense_id": "8ca23c68-fb9a-3167-9d92-dc27fc91d47e",
                                                "text": "Les soirs de match, on observe une recrudescence des violences conjugales, y compris chez les supporters de l’équipe victorieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3282dac-b97d-3102-82e4-d7b8092d1c51",
                                        "entry_id": "7cc5ee19-d4f9-30d3-96a5-8995aff2da3f",
                                        "glosses": [
                                            "Personne encourageant une autre personne ou une entité lors d’une épreuve, d’une compétition."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45796f58-f5cc-46f1-988f-9450feefb9bd",
                                                "sense_id": "c3282dac-b97d-3102-82e4-d7b8092d1c51",
                                                "text": "Qu'il s'agisse de sensualité ou d'expériences préconjugales, les supporters traditionnels du poujadisme ont un comportement absolument prévisible, triste et réactionnaire, là comme ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
