                                                "sense_id": "022d8b6b-3d65-3092-b2f6-bbb7d0faa523",
                                                "text": "Im Kongo leben etwa 4 Millionen Menschen."
                                            },
                                            {
                                                "example_id": "16c0adfd-576f-48b6-882f-760af7640729",
                                                "sense_id": "022d8b6b-3d65-3092-b2f6-bbb7d0faa523",
                                                "text": "Brazzaville ist die Hauptstadt von Kongo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cde6c88-abf8-3f5c-806f-ecac16ae936b",
                                        "entry_id": "849a16a5-2842-3587-823f-6f81b5aaaaff",
                                        "glosses": [
                                            "Staat in Zentralafrika mit der Hauptstadt Kinshasa, drittgrößter Staat Afrikas"
                                        ],
                                        "tags": [
                                            "nicht amtlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e1ec26-1624-4769-95c1-5ea763e91308",
                                                "sense_id": "4cde6c88-abf8-3f5c-806f-ecac16ae936b",
                                                "text": "„Rund zwei Drittel der Fläche des Kongo sind von Tropischem Regen- und Höhenwald bedeckt.“"
                                            },
                                            {
                                                "example_id": "f9def54b-5c32-46c6-9068-30ac5080b57f",
                                                "sense_id": "4cde6c88-abf8-3f5c-806f-ecac16ae936b",
                                                "text": "Die Wahl im Kongo 2006 wurde auch von UNO-Soldaten überwacht."
                                            },
                                            {
                                                "example_id": "46795f49-8a2b-4c81-b502-ae46087703c8",
                                                "sense_id": "4cde6c88-abf8-3f5c-806f-ecac16ae936b",
                                                "text": "Kinshasa ist die Hauptstadt von Kongo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kongo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e93bbb1-9cb0-3852-b4d2-aeb4e5bf7056",
