                ],
                "senses": [
                    {
                        "sense_id": "4da23398-a88f-37a0-a596-6479b02c710a",
                        "entry_id": "7a886cc2-abcb-381a-9c4c-88338f047d26",
                        "glosses": [
                            "ältere Schliffformen, die dem heute üblichen Brillantschliff mit runder Form vorausgehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bbce9bd-370f-402a-97df-8ba804aa894a",
                                "sense_id": "4da23398-a88f-37a0-a596-6479b02c710a",
                                "text": "„Die Brillanten sind jedenfalls durchweg Altschliff mit Weißgoldfassung und hochwertig.“"
                            },
                            {
                                "example_id": "adde60c0-2d29-4831-8994-bc9235d30806",
                                "sense_id": "4da23398-a88f-37a0-a596-6479b02c710a",
                                "text": "„Der Brillantschliff wurde um 1910 entwickelt und löste den bis dahin meist verwendeten Altschliff ab.“"
                            },
                            {
                                "example_id": "1575ffca-76d3-440a-bb07-510327a4e538",
                                "sense_id": "4da23398-a88f-37a0-a596-6479b02c710a",
                                "text": "„Ich traf ihn am Goldschmiedetisch, wo er den Altschliff eines Diamanten überprüfte.“"
                            },
                            {
                                "example_id": "8aade4f0-79c9-4a80-b4eb-72b48bd9f069",
                                "sense_id": "4da23398-a88f-37a0-a596-6479b02c710a",
                                "text": "„Ein Sternrubin im Cabochon Schliff, fast zur Taubenblutfarbe tendierend und wohl drei Karat, zwischen zwei Diamanten im Altschliff mit je wohl ein Karat.“"
                            },
                            {
                                "example_id": "0e775613-cf52-41b6-8e86-6cacbca5ef57",
                                "sense_id": "4da23398-a88f-37a0-a596-6479b02c710a",
                                "text": "„Sehen Sie, das sind kleine Diamantrosen, im Altschliff in Korn gefasst, und die roten Steine, das werden wohl Rubine sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
