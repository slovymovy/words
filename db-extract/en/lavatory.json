                ],
                "senses": [
                    {
                        "sense_id": "315b220d-2372-3b1e-a976-da6a2d27de81",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing, particularly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a15a585d-a05e-461c-ad44-37a43cdd5292",
                                "sense_id": "315b220d-2372-3b1e-a976-da6a2d27de81",
                                "text": "Whon he haþ vsed he walkeþ riht\nTo Lauatorie þer hit is diht\nFor to wassche his hende."
                            },
                            {
                                "example_id": "b93a3fda-12cb-41b4-8327-4ca234f20105",
                                "sense_id": "315b220d-2372-3b1e-a976-da6a2d27de81",
                                "text": "And thow shalt make a brasun lauatory with his foot to wasshe with."
                            }
                        ]
                    },
                    {
                        "sense_id": "e49eeb30-eae6-39fe-92d4-54440ae96e35",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing",
                            "A laver: a washbasin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9d358754-e731-3921-8a3f-e25c4e4432fe",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing",
                            "A bathtub."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aeedd10d-9223-342c-a412-88438be363df",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing",
                            "A piscina: the basin used for washing communion vessels."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "db1d894a-b43e-3ee4-a3e0-8e5ae93e7ec3",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing",
                            "A lavabo: the basin used for washing one's hands before handling the Eucharist."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cba25858-53a1-34c1-9d67-e392653bcc4f",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing",
                            "A baptismal font: the basin used for baptism, used figuratively for the washing away of sins."
                        ],
                        "tags": [
                            "figuratively",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "05881d55-8e95-3c84-a734-caefa37fad5a",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A vessel or fixture for washing",
                            "A plumbing fixture used for washing: a sink."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36686ce3-5ba4-48c9-80e9-d890676ef97a",
                                "sense_id": "05881d55-8e95-3c84-a734-caefa37fad5a",
                                "text": "Their 'bathroom' included a toilet and a lavatory but no bath."
                            },
                            {
                                "example_id": "b6527a1a-7c15-4b0d-b59e-6b70bd1b5782",
                                "sense_id": "05881d55-8e95-3c84-a734-caefa37fad5a",
                                "text": "Lavatories (bathroom sinks) are available in a blizzard of colors, materials, and styles."
                            },
                            {
                                "example_id": "33263b8b-7086-433d-a398-627c9d6803d6",
                                "sense_id": "05881d55-8e95-3c84-a734-caefa37fad5a",
                                "text": "Anywhere a water closet is used, a lavatory (ie, hand-washing sink) must also be installed."
                            }
                        ]
                    },
                    {
                        "sense_id": "17aabae7-ae5f-38e1-b19b-c19fc5d688d0",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "Handwashing as an act, particularly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dcd334e-825a-4bd6-89d1-a6b64e9c835a",
                                "sense_id": "17aabae7-ae5f-38e1-b19b-c19fc5d688d0",
                                "text": "Wᵗ condicion that at the tyme of the Lavatory eueryche of theym turne theym to the people, and exorte theym to pray for ye soules following..."
                            }
                        ]
                    },
                    {
                        "sense_id": "88bf37dd-2886-38ee-8135-1c46227f762f",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "Handwashing as an act, particularly",
                            "The lavabo: the ritual washing of hands before handling the eucharist."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "81a80d37-7127-31e0-b0e9-b8e09cafa4fd",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "Handwashing as an act, particularly",
                            "The ritual washing of hands after using the piscina to clean the communion vessels."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f615a9ca-20e4-39f9-9f81-f3cf86070821",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A liquid used in washing; a lotion; a wash; a rinse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "55d5b12c-d632-4e40-86c8-af899016272b",
                                "sense_id": "f615a9ca-20e4-39f9-9f81-f3cf86070821",
                                "text": "They must be wasshed wyth wyne or wyth some other lauatorye."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf0e673b-04a4-368d-aba8-57aeb9ccf9a4",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A washroom: a room used for washing the face and hands."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "92a6cf6c-09b6-49d8-95eb-1afc546414a4",
                                "sense_id": "cf0e673b-04a4-368d-aba8-57aeb9ccf9a4",
                                "text": "Even the lavatory, a vestibule to the refectory through which the novices would pass on their way to the recreation room, boasted a painting cycle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2403678-8b4e-3e44-a456-5cde3cf42e1e",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A room containing a toilet: a bathroom (US) or WC (UK)."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "98424722-5652-4901-8854-e446253fa4bf",
                                "sense_id": "d2403678-8b4e-3e44-a456-5cde3cf42e1e",
                                "text": "Americans don't know 'WC' and Brits mock 'bathroom' but everyone usually understands 'toilet' or 'lavatory'."
                            },
                            {
                                "example_id": "e3c32f1d-dfce-42f1-b192-be65c37fe5e8",
                                "sense_id": "d2403678-8b4e-3e44-a456-5cde3cf42e1e",
                                "text": "People needing to use the lavatory often ask to use the baño in a restaurant; toilet paper is rarely available, so the experienced traveler always carries a personal supply."
                            },
                            {
                                "example_id": "b7d85487-986a-4637-b222-836121190489",
                                "sense_id": "d2403678-8b4e-3e44-a456-5cde3cf42e1e",
                                "text": "THE RESTROOM ON THE OLDER TRAINS ARE TOO SMALL FOR AN ADULT. ONE CAN'T USE THE TOILET WITHOUT CONSTANTLY ELBOWING THE WALL. AIRPLANES HAVE LARGER LAVATORIES AND A BETTER USEABLE FAUCET."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c8ed6c9-c41d-3fbd-8dba-8cdc3d08b977",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A plumbing fixture for urination and defecation: a toilet."
                        ],
                        "tags": [
                            "New-England",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "38733415-d579-45fc-b059-3df9d2400121",
                                "sense_id": "8c8ed6c9-c41d-3fbd-8dba-8cdc3d08b977",
                                "text": "In a traditional German lavatory, the hole in which shit disappears after we flush water is way in front, so that the shit is first laid out for us to sniff at and inspect for traces of some illness; in the typical French lavatory, on the contrary, the hole is in the back - that is, the shit is supposed to disappear as soon as possible; finally, the Anglo-Saxon (English or American) lavatory presents a kind of synthesis, a mediation between these two opposed poles - the basin is full of water so that the shit floats in it - visible, but not to be inspected."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2e63c96-ba7c-3516-9590-c3e9b3e27439",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A place to wash clothes: a laundry."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6aa9a1a7-1689-306a-9862-b7f9542d9452",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A place where gold is panned."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4d74fc3f-2548-3321-84db-e09c92920c50",
                        "entry_id": "0c688ddf-fd1d-31c1-8afe-e83dee97bdcb",
                        "glosses": [
                            "A paved room in a mortuary where corpses are kept under a shower of disinfecting fluid."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
