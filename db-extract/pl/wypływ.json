                                                "example_id": "aea56706-9ff5-4156-ae34-1997c6088752",
                                                "sense_id": "814d2c6e-d332-36fb-9626-e6899597e7c3",
                                                "text": "Der Hase benötigt einen größeren Auslauf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3af49ffc-f678-3639-9d78-253cae29f17f",
