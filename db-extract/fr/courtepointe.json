                                                "sense_id": "1408f92d-966f-3af7-8735-edae0b1b9c06",
                                                "text": "Een slecht functionerende advocaat kan door de deken uit zijn ambt worden gezet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a705e41e-8457-3b66-a491-15ff17d95e91",
