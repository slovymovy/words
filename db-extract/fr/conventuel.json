                                    {
                                        "sense_id": "39837390-dec2-34e7-9a44-24ec03df433e",
                                        "entry_id": "d7202f7a-3087-3dc2-adaa-fb705919d6ca",
                                        "glosses": [
                                            "Pertaining to a convent or convent life; cloistered, monastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ec1ca9-b067-4410-8604-e2b2e14bf932",
                                                "sense_id": "39837390-dec2-34e7-9a44-24ec03df433e",
                                                "text": "The noise of her steps, light as they were, attracted the stranger's notice, who, turning round and letting her mantle fall as she did so, showed a tall and stately figure, dressed in what appeared to be some conventual costume."
                                            },
                                            {
                                                "example_id": "e3d499ab-3b9a-4535-bdb4-aab8edf7d71a",
                                                "sense_id": "39837390-dec2-34e7-9a44-24ec03df433e",
                                                "text": "The Sunday Times has convinced me I ought to immediately start out on a new regime of positively conventual austerity in order to reduce the burden on a strained NHS by not forcing them to have to cope with my ling cancer or coronary."
                                            },
                                            {
                                                "example_id": "789856f4-22fe-467d-b955-4ff1d735aff5",
                                                "sense_id": "39837390-dec2-34e7-9a44-24ec03df433e",
                                                "text": "The Breton Club resumed its meetings in the refectory of an empty conventual building in the rue Saint-Jacques."
                                            }
                                        ]
                                    }
                                ]
                            },
