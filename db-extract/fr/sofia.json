                    {
                        "translation_id": "4394fb65-7eef-44cb-a241-001a025d4f88",
                        "source_entry_id": "ec20d598-bf50-3729-90a8-e34922ba3d0a",
                        "source_sense_id": "85b11680-1f65-3407-97c9-f506ca4893f0",
                        "target_lang_word": "София",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "София",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "381011a1-0435-3d3f-a826-2f0f88fa5eba",
                                        "entry_id": "c6cbf84b-39f6-3862-b7dd-1784d5ba3ba5",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e036411-ae17-4f2c-a31e-cc6431a4d068",
                                                "sense_id": "381011a1-0435-3d3f-a826-2f0f88fa5eba",
                                                "text": "В семь лет увидел Константин сон и рассказал его наутро своим родителям: «Стратиг, собрав всех девушек нашего града, велел мне: „Избери себе из них, кого хочешь, во супруги“. Я же увидел одну прекраснее всех, с сияющим ликом, украшенную золотыми ожерельями и жемчугом и всей красотой, имя же её было София, то есть Мудрость, и я её избрал»."
                                            },
                                            {
                                                "example_id": "526c1f02-debe-4950-aa4d-0f5aefda6189",
                                                "sense_id": "381011a1-0435-3d3f-a826-2f0f88fa5eba",
                                                "text": "Предложение года «Дадим шар земной детям», ― предложил в 1962 году в стихотворении «Детям» турецкий поэт Назым Хикмет. Но тогда его предложения никто не услышал. А вот когда эти строки положил на музыку Давид Тухманов и спела София Ротару, этот призыв дошел до широких масс."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "София",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3379194-c759-354c-adc9-791a17914d35",
                                        "entry_id": "436255a8-94ac-337a-89a3-f053415ca8bf",
                                        "glosses": [
                                            "город, столица Болгарии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026edd04-3a91-4b8b-83b1-dcc2be559c9b",
                                                "sense_id": "f3379194-c759-354c-adc9-791a17914d35",
                                                "text": "В 330 г. Константин I Великий перенес столицу Рима в Византион (Константинополь/Стамбул), названный болгарами Царьгородом (Городом Царей). Это произошло после известных колебаний, причем одним из вариантов было перенесение столицы в древнюю Сердику ― город, на месте которого находится нынешняя столица Болгарии ― София."
                                            },
                                            {
                                                "example_id": "8c674cef-4e21-489b-adff-92d5184f2b08",
                                                "sense_id": "f3379194-c759-354c-adc9-791a17914d35",
                                                "text": "За упадком Софии во времена Османской империи последовало ее восстановление после освобождения в 1879, когда София была избрана столицей Болгарии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cdd988-711c-3afb-8f16-f5a8e4ac4c79",
                                        "entry_id": "436255a8-94ac-337a-89a3-f053415ca8bf",
                                        "glosses": [
                                            "метоним., полит. правительство Болгарии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bb0099c-54b7-4b73-b2e9-19fa4014e354",
                                                "sense_id": "79cdd988-711c-3afb-8f16-f5a8e4ac4c79",
                                                "text": "Военно-стратегическая ситуация в Балканском регионе после вторжения сил ОВД в Чехословакию в августе 1968 г. рассматривалась официальной Софией с позиций её тесного сотрудничества с Москвой в рамках Варшавского блока."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
