                                                "example_id": "8f4a260d-0906-407f-bc2c-33e206770957",
                                                "sense_id": "d3fc6000-10fb-3e5c-a58b-691d993f53c7",
                                                "text": "ο ταχυδακτυλουργός κινεί τα δάχτυλά του με ταχύτητα και ακρίβεια."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71568ca1-91a2-39e1-81f0-bd5a00a44b5c",
