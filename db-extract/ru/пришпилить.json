                "senses": [
                    {
                        "sense_id": "67fbc7ea-ed8a-3ea0-8cf2-0eff97abfba7",
                        "entry_id": "acc92c39-3be7-37eb-8b8c-27393e88a5db",
                        "glosses": [
                            "прикрепить шпилькой, булавкой, приколоть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b852bbd6-3ad5-4074-8f22-ecfe036c59d5",
                                "sense_id": "67fbc7ea-ed8a-3ea0-8cf2-0eff97abfba7",
                                "text": "Он тоже, по неотступной ее просьбе, согласился пришпилить к своему левому плечу бант и стать нашим товарищем-распорядителем."
                            },
                            {
                                "example_id": "af0981ac-ccde-4ccc-adc6-3f634f2f0802",
                                "sense_id": "67fbc7ea-ed8a-3ea0-8cf2-0eff97abfba7",
                                "text": "Даже Ксеня-сирота какой-то кружавчик из суровых ниток навертела и на темечко пришпилила."
                            }
                        ]
                    }
