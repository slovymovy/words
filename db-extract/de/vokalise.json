                "senses": [
                    {
                        "sense_id": "48c04d1e-e89d-371b-ad7e-d21a43f2fb21",
                        "entry_id": "76031ab7-1f1d-3cc7-b5e0-a59915f0ca13",
                        "glosses": [
                            "Ein Lied ohne Worte, das nur auf Vokale gesungen wird. Ursprünglich wurden Vokalisen zum Zwecke der Tonbildung entwickelt. Es wurde nicht auf die Solmisationssilben, sondern bevorzugt auf Vokale gesungen. Im Laufe des 19. Jahrhunderts hat sich aus diesem Ansatz heraus die Vokalise als eigenständige Musikgattung und Kunstform etabliert."
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ccaadf9f-73e4-42b7-84ca-d44d878e23a8",
                                "sense_id": "48c04d1e-e89d-371b-ad7e-d21a43f2fb21",
                                "text": "Einige Opernkritiker behaupten, dass Opernarien nichts anderes als Vokalisen sind."
                            },
                            {
                                "example_id": "e3d5e789-5898-48a3-8c46-c39599ad54d4",
                                "sense_id": "48c04d1e-e89d-371b-ad7e-d21a43f2fb21",
                                "text": "Sergei Rachmaninows Vokalise op. 34 Nr. 14 aus dem Jahr 1912 ist wohl das bekannteste Stück dieser Musikgattung."
                            },
                            {
                                "example_id": "59e9efa3-5d40-4fd4-a0f7-68d8e3dda05d",
                                "sense_id": "48c04d1e-e89d-371b-ad7e-d21a43f2fb21",
                                "text": "Die meisten Vokalisen gibt es für Frauenstimmen."
                            },
                            {
                                "example_id": "be924bed-c1ac-411a-85c7-9856eb79239f",
                                "sense_id": "48c04d1e-e89d-371b-ad7e-d21a43f2fb21",
                                "text": "Der italienische Gesangsmeister Giuseppe Concone (* Turin 1801 - † Turin 1861) wurde wegen seiner Vokalisen aus seiner Pariser Zeit (1837 - 1848) berühmt. Man nannte diese Vokalisen auch Conconen."
                            },
                            {
                                "example_id": "30e4c463-dd33-4d19-a26b-55f564c970b5",
                                "sense_id": "48c04d1e-e89d-371b-ad7e-d21a43f2fb21",
                                "text": "Über die Zwischenstufe der Vokalise wird das Sprechen zu Gesang. (Quelle: Berliner Zeitung 1997)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
