                    {
                        "form_id": "e52f3acb-e311-40e8-8313-f58a17005c6a",
                        "entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Letalität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b977d90-c293-3290-a146-090155f18a7a",
                        "entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                        "glosses": [
                            "Demografie, Wahrscheinlichkeit, an einer bestimmten Krankheit(s)/Ursache zu sterben"
                        ],
                        "tags": [
                            "Sozialmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "93bd3bb0-a462-4b86-a208-dc7789cbea67",
                                "sense_id": "9b977d90-c293-3290-a146-090155f18a7a",
                                "text": "Die Letalität ist der Anteil der an einer bestimmten Krankheit in einem bestimmten Zeitraum (meist 1 Jahr) Gestorbenen, bezogen auf die Gesamtanzahl der an der betrachteten Krankheit Erkrankten einer definierten Population."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0423ced0-014f-3037-b655-f9d0d3a1f8a1",
                        "entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                        "glosses": [
                            "Tödlichkeit einer bestimmten Erkrankung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa5fb5e-b28c-4831-80df-9cd08f8c023b",
                                "sense_id": "0423ced0-014f-3037-b655-f9d0d3a1f8a1",
                                "text": "Dieser Typ der Hirnblutung hat eine Letalität von 50-80%."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4efdda8-3a0d-4321-97c0-8241467fbb40",
                        "source_entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                        "source_sense_id": "9b977d90-c293-3290-a146-090155f18a7a",
                        "source_sense_description": "Demografie, Sozialmedizin: Wahrscheinlichkeit, an einer bestimmten Krankheit(s)/Ursache zu sterben",
                        "target_lang_word": "lethality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lethality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cabed32f-5fb2-3ad4-88ca-8da16a46e02c",
                                        "entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                                        "glosses": [
                                            "The fact of something being lethal; the ability of something to kill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b76ba53-a33a-4a14-9641-5608792f6ae7",
                                                "sense_id": "cabed32f-5fb2-3ad4-88ca-8da16a46e02c",
                                                "text": "Title 10 section 129a of the US code governing civilian personnel management in the armed forces says that the secretary of defense “may not reduce the civilian workforce programmed full-time equivalent levels unless the Secretary conducts an appropriate analysis” of how those firings could impact the US military’s lethality and readiness."
                                            },
                                            {
                                                "example_id": "f226b4a6-2f0f-4954-a52e-3f104e839dcc",
                                                "sense_id": "cabed32f-5fb2-3ad4-88ca-8da16a46e02c",
                                                "text": "In announcing the review, Robert F. Kennedy Jr., the new health secretary, said in a statement that “antisemitism — like racism — is a spiritual and moral malady that sickens societies and kills people with lethalities comparable to history’s most deadly plagues.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56099017-98ec-3482-9b82-ab9f9823ede7",
                                        "entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                                        "glosses": [
                                            "The degree of lethal (mortal) danger that something (usually a disease or a weapon) presents; the magnitude of its power to kill organisms exposed to it; this property is indirectly measured by any of various proxy rates, including mortality rate, case fatality rate, or infection fatality rate (for diseases) or kill rate (for weapons, pesticides, or parasites)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e22a14d-1cce-4fe1-9945-71c4e055b906",
                                                "sense_id": "56099017-98ec-3482-9b82-ab9f9823ede7",
                                                "text": "According to the US Environmental Protection Agency [ 6 ], long-chain substituted propanediamines, the chemical group these compounds belongs to, are considered to be toxic to aquatic organisms, with observed lethality for plankton and fish at concentrations ranging from 0.75 to 170 µg L −1 ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1a1d315-0119-404e-8329-b1070a20acbd",
                        "source_entry_id": "3e2cb320-c13a-3692-985e-ea5f484c47b0",
                        "source_sense_id": "9b977d90-c293-3290-a146-090155f18a7a",
                        "source_sense_description": "Demografie, Sozialmedizin: Wahrscheinlichkeit, an einer bestimmten Krankheit(s)/Ursache zu sterben",
                        "target_lang_word": "létalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "létalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23cb82ec-34c3-3c0a-a56c-c4da7d408265",
                                        "entry_id": "fba31b22-5252-3b07-928c-05d82eaf82a3",
                                        "glosses": [
                                            "Propension à faire mourir."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6630d72e-ef36-49ca-bfdc-2c3f31e44ae4",
                                                "sense_id": "23cb82ec-34c3-3c0a-a56c-c4da7d408265",
                                                "text": "On pense généralement que le taux élevé de létalité de la rougeole chez les enfants africains est dû à la malnutrition […]. Il a même été suggéré que le taux de létalité de l'infection rougeoleuse pouvait être un bon indicateur de l'état nutritionnel d'une population […]."
                                            },
                                            {
                                                "example_id": "2d85751d-dc4c-4dda-865c-abce596612f7",
                                                "sense_id": "23cb82ec-34c3-3c0a-a56c-c4da7d408265",
                                                "text": "Revenons à la létalité du geste suicidaire proprement dit et à sa définition. La létalité recouvre en fait deux notions distinctes. La première est un risque, la probabilité de mourir en utilisant une méthode donnée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
