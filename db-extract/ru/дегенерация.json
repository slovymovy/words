                "senses": [
                    {
                        "sense_id": "66d2a38d-d02a-3afc-928b-d91b90a7582e",
                        "entry_id": "4a750bea-527b-39fd-998b-edda232606dc",
                        "glosses": [
                            "биол. ухудшение ценных биологических свойств организма в каждом последующем поколении; вырождение"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "76344586-c09d-30f9-8e27-88f4e30a97a9",
                        "entry_id": "4a750bea-527b-39fd-998b-edda232606dc",
                        "glosses": [
                            "биол. уменьшение или исчезновение отдельных органов в процессе нормального индивидуального развития или при болезненных изменениях, а также в ходе эволюции при изменении условий существования организмов"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a38da0f-0860-4ed9-8324-26f5f5520cbd",
                        "source_entry_id": "4a750bea-527b-39fd-998b-edda232606dc",
                        "target_lang_word": "degeneration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degeneration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "The process or state of growing worse, or the state of having become worse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3af38a-33f7-4c26-8a45-c710ddbcd67f",
                                                "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                                "text": "The modern cry of \"more liberty and less creed\" is a degeneration from a vertebrate to a jellyfish."
                                            },
                                            {
                                                "example_id": "f2cabd92-d7b2-4c38-81d8-ea2a6d17dcba",
                                                "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                                "text": "Hence, regional soil degenerations and podsolization was probably an important factor contributing to the retrogressive change in the forest composition at the end of the mesocratic phase.."
                                            },
                                            {
                                                "example_id": "c65364fb-d173-4b3a-9108-4368999ecae0",
                                                "sense_id": "4afdbce5-5a4b-34f0-9a3b-8c105ca7a0e3",
                                                "text": "Emmanuel Macron sounded like a man in grief. Not angry, not defiant, just a little triste. Europe, he lamented, was suffering a “degeneration of democracy”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f61de34b-a49d-3aad-b9f5-99c2bf9a49b4",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "That condition of a tissue or an organ in which its vitality has become either diminished or perverted; a substitution of a lower for a higher form of structure."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8b33d1-bb0c-46de-b03e-7b91f3856408",
                                                "sense_id": "f61de34b-a49d-3aad-b9f5-99c2bf9a49b4",
                                                "text": "fatty degeneration of the liver"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d1f5f4-f52f-31c9-9e1c-068f43593dc5",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "Gradual deterioration, from natural causes, of any class of animals or plants or any particular organ or organs; hereditary degradation of type."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c63b31a-6733-30de-a4ee-06ac9cf0e61d",
                                        "entry_id": "7ea9ab9f-1e30-38a1-b867-90ff04ff63b5",
                                        "glosses": [
                                            "A thing that has degenerated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4da275f-1e0d-4a4a-a59c-3c8b5b647b7d",
                                                "sense_id": "5c63b31a-6733-30de-a4ee-06ac9cf0e61d",
                                                "text": "cockle, aracus, […] and other degenerations"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
