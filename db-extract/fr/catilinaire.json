                        "entry_id": "3ca58c6d-4777-3da5-8cc7-669c66e69346",
                        "glosses": [
                            "Discours de Cicéron contre Catilina."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "989dbac8-55fd-40eb-a10e-e77426eea8dd",
                                "sense_id": "d8859be8-6183-3439-ac24-4b982d00eca0",
                                "text": "Cicéron convoque le sénat et prononce sa première catilinaire qui provoque la fuite de Catilina."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf4680e3-8ed8-3d2c-9271-4da1a98765b4",
                        "entry_id": "3ca58c6d-4777-3da5-8cc7-669c66e69346",
                        "glosses": [
                            "Diatribe contre une personne."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ff31d38e-9952-4448-8930-4b3e893818d1",
                                "sense_id": "cf4680e3-8ed8-3d2c-9271-4da1a98765b4",
                                "text": "Il réitère le droit d’un journaliste indépendant de traiter de tous les sujets, y compris religieux, et refuse de révéler l’identité de l’auteur de cette catilinaire qui portait ombrage à Sa Grandeur."
                            }
                        ]
                    }
                ],
