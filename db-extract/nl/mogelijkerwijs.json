                                "example_id": "d52e68af-d53a-44a4-953f-37de5854ce98",
                                "sense_id": "ed218354-3d88-31c6-8cbd-c555bc863fba",
                                "text": "Ik zou er mogelijkerwijs nog veel meer over te weten willen komen."
