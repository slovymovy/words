    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b1ec189-48bc-3434-abec-813adaa7a357",
                    "sense_definition": "mający dużą tuszę, otyły",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "budowa_ciala",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To był <w>tęgi</w> mężczyzna o szerokich ramionach.",
                            "target_lang_translations": {
                                "ru": "Это был <w>тучный</w> мужчина с широкими плечами."
                            }
                        },
                        {
                            "text": "W drzwiach stanął <w>tęgi</w> gospodarz z uśmiechem na twarzy.",
                            "target_lang_translations": {
                                "ru": "В дверях стоял <w>плотный</w> хозяин с улыбкой на лице."
                            }
                        }
                    ],
                    "synonyms": [
                        "otyły",
                        "puszysty",
                        "gruby"
                    ],
                    "antonyms": [
                        "szczupły",
                        "chudy"
                    ],
                    "common_phrases": [
                        "tęgi mężczyzna"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий крупное телосложение, полный, тучный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тучный",
                                "target_lang_sense_clarification": "о человеке с избыточным весом"
                            },
                            {
                                "target_lang_word": "плотный",
                                "target_lang_sense_clarification": "о крепком, коренастом телосложении"
                            },
                            {
                                "target_lang_word": "крупный",
                                "target_lang_sense_clarification": "о человеке большого размера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6345edd1-c268-3cb3-b326-6adb164a0499",
                    "sense_definition": "bardzo silny, intensywny, dotkliwy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensywnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nocy chwycił <w>tęgi</w> mróz.",
                            "target_lang_translations": {
                                "ru": "Ночью ударил <w>сильный</w> мороз."
                            }
                        },
                        {
                            "text": "Przez całą drogę towarzyszył nam <w>tęgi</w> wiatr.",
                            "target_lang_translations": {
                                "ru": "Всю дорогу нас сопровождал <w>крепкий</w> ветер."
                            }
                        }
                    ],
                    "synonyms": [
                        "silny",
                        "mocny",
                        "dotkliwy"
                    ],
                    "antonyms": [
                        "lekki",
                        "słaby"
                    ],
                    "common_phrases": [
                        "tęgi mróz"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень сильный, интенсивный, суровый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "об интенсивном явлении природы"
                            },
                            {
                                "target_lang_word": "лютый",
                                "target_lang_sense_clarification": "о сильном морозе"
                            },
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "о сильном морозе или ветре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e67e4aeb-53cd-3818-9e81-b4c9ca3256ff",
                    "sense_definition": "bardzo zdolny, wybitny w jakiejś dziedzinie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inteligencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nad tym problemem pracują <w>najtęższe</w> umysły w kraju.",
                            "target_lang_translations": {
                                "ru": "Над этой проблемой работают <w>острейшие</w> умы страны."
                            }
                        },
                        {
                            "text": "To był <w>tęgi</w> fachowiec, który znał się na wszystkim.",
                            "target_lang_translations": {
                                "ru": "Это был <w>выдающийся</w> специалист, который разбирался во всем."
                            }
                        }
                    ],
                    "synonyms": [
                        "wybitny",
                        "zdolny",
                        "bystry"
                    ],
                    "common_phrases": [
                        "tęgie umysły"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень способный, выдающийся, глубокий (об уме)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдающийся",
                                "target_lang_sense_clarification": "о человеке с большими способностями"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "об уме, интеллекте"
                            },
                            {
                                "target_lang_word": "крупный",
                                "target_lang_sense_clarification": "о выдающемся специалисте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
