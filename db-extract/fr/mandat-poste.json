                                        "glosses": [
                                            "A money order purchased at and issued by a post office for redemption at another post office to a named recipient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21531fae-af77-4c7a-8dcd-193520781c4b",
                                                "sense_id": "f9399655-084e-3c4d-9f8b-8fda96775d77",
                                                "text": "...the bill to establish a postal order system..."
                                            }
                                        ]
