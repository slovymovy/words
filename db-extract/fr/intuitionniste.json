                        "sense_id": "0a5ba0ae-9194-3c1c-8493-c6845dc1e5d3",
                        "entry_id": "8eb967e4-2a2b-3d32-8e3d-65d2d26358b3",
                        "glosses": [
                            "Qui a rapport à la doctrine de l’intuition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dbd16b8-3b22-49d4-bc15-fd09734259f3",
                                "sense_id": "0a5ba0ae-9194-3c1c-8493-c6845dc1e5d3",
                                "text": "J’étais convaincu que les écrits et la renommée de sir W. Hamilton étaient la grande forteresse de la philosophie intuitionniste en Angleterre"
                            },
                            {
                                "example_id": "bbcdfeda-58f7-46d0-9124-dca2f9d16035",
                                "sense_id": "0a5ba0ae-9194-3c1c-8493-c6845dc1e5d3",
                                "text": "Il ne suffit pas de mépriser l'adversaire, le jargon des philosophes « intuitionnistes », des syndicalistes et de certains critiques d'art ou peinturologues, il faut se défendre avec un égoïsme féroce contre la contagion."
                            }
                        ]
                    }
