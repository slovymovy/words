                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>shopping</w> for a birthday gift for my brother.",
                            "target_lang_translations": {
                                "ru": "Я <w>ищу</w> подарок на день рождения для брата.",
                                "zh": "我正在为我弟弟<w>选购</w>生日礼物。"
                            }
                        },
                        {
                            "text": "They were <w>shopping</w> in the city center when it started to rain.",
                            "target_lang_translations": {
                                "ru": "Они <w>ходили по магазинам</w> в центре города, когда пошел дождь.",
                                "zh": "他们正在市中心<w>逛街</w>时，天开始下雨了。"
                            }
                        }
