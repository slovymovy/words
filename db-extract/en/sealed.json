                ],
                "translations": [
                    {
                        "translation_id": "b149cacd-704a-4286-855e-3c5659f93f82",
                        "source_entry_id": "4f8cd2f9-9f22-3d3b-84e4-38b152cdbd72",
                        "source_sense_description": "closed by a seal",
                        "target_lang_word": "versiegelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versiegelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                        "entry_id": "db7bae15-28c5-35c5-a7c4-f5d39d3e2fad",
                                        "glosses": [
                                            "mit einem Siegel verschlossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513d3e35-802b-4cc7-86bb-4272380bf65d",
                                                "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                                "text": "„Adieu schrieb ich, und es reute mich hinterher, doch der Brief war schon versiegelt, dem Kutscher übergeben, und da sagte ich mir: fahrt hin, Sorge und Rücksicht, es geht um dich, Amadeus, ausschließlich um dich.“"
                                            },
                                            {
                                                "example_id": "27827e4b-b2e8-457b-bcdb-35562c6615e5",
                                                "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                                "text": "„Daher entspricht eine herkömmliche E-Mail eher einer offenen Postkarte als einem versiegelten Brief.“"
                                            },
                                            {
                                                "example_id": "ccf83084-e51d-4144-a280-9f5fa1490dfa",
                                                "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                                "text": "„Die paar Kuriere, die mit versiegeltem Gepäck noch mitfuhren, zählten wohl nicht.“"
                                            },
                                            {
                                                "example_id": "95d63166-5ef1-4c9c-b792-975d8a0461bb",
                                                "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                                "text": "„Einige wollen lediglich eine kurze Leistungseinschätzung, manche verlangen ein Gutachten in einem versiegelten Umschlag, andere wollen, dass der Gutachter einen standardisierten Fragebogen in einem Onlineportal ausfüllt.“"
                                            },
                                            {
                                                "example_id": "3f85ee25-a1dd-4334-a4d8-31edc734531b",
                                                "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                                "text": "„Er werde, so erklärte er kurz vor seinem Abflug gerührt, seinem Nachfolger einen versiegelten Brief hinterlegen, für den Fall, dass die Lage besonders schlecht sei.“"
                                            },
                                            {
                                                "example_id": "dcd519e0-f61e-4ee2-9d6d-4501a6657f51",
                                                "sense_id": "673014a2-d340-37e1-bb91-b664f1997f75",
                                                "text": "„Zwischen ihnen allen hastet der Gerichtsdiener Abu Ali hin und her, ein dicker Gemüsehändler, der Botschaften in versiegelten Briefumschlägen überbringt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3537eaaf-758f-3068-9553-ce2922eddc78",
                                        "entry_id": "db7bae15-28c5-35c5-a7c4-f5d39d3e2fad",
                                        "glosses": [
                                            "so verschlossen, dass ein unbemerktes Öffnen verhindert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d98a1104-2738-40fe-9cb0-79770b345019",
                                                "sense_id": "3537eaaf-758f-3068-9553-ce2922eddc78",
                                                "text": "„Das neue Oberhaupt der katholischen Kirche hat inzwischen auch die vorübergehend versiegelte päpstliche Wohnung übernommen.“"
                                            },
                                            {
                                                "example_id": "c8906c37-b479-4f87-acb2-cae04422f3f7",
                                                "sense_id": "3537eaaf-758f-3068-9553-ce2922eddc78",
                                                "text": "„Gegen 11.00 Uhr MEZ öffneten Mitarbeiter des Instituts für Biomedizinische Probleme (IMBP) eine versiegelte Luke, um die Isolationsstudie planmäßig zu beenden.“"
                                            },
                                            {
                                                "example_id": "0057c74f-6b07-4408-aa9e-bac6a7acf16d",
                                                "sense_id": "3537eaaf-758f-3068-9553-ce2922eddc78",
                                                "text": "„Eines Tages, sagt Wehrhahn, sei er beim Räumen auf eine versiegelte Filmdose gestoßen.“"
                                            },
                                            {
                                                "example_id": "50bd1a21-b0f4-4f22-9d89-da20b9fac88b",
                                                "sense_id": "3537eaaf-758f-3068-9553-ce2922eddc78",
                                                "text": "„Erst am Montag, zwei Tage nach Landung der Maschine, sei der Verlust der umgerechnet 920000 Euro bei der Kontrolle der versiegelten Container bemerkt worden.“"
                                            },
                                            {
                                                "example_id": "dcf667ce-aa2a-40bb-9d85-b3bb8afdfb35",
                                                "sense_id": "3537eaaf-758f-3068-9553-ce2922eddc78",
                                                "text": "„Allerdings müssen die Einkäufe in versiegelten Plastiktüten stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15e8eef4-4b9f-33a0-b35f-54f0219332e1",
                                        "entry_id": "db7bae15-28c5-35c5-a7c4-f5d39d3e2fad",
                                        "glosses": [
                                            "durch Bauwerke des Menschen bedeckt"
                                        ],
                                        "tags": [
                                            "Boden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8bfb24-d4ed-48d8-aeaa-21aacb5da92c",
                                                "sense_id": "15e8eef4-4b9f-33a0-b35f-54f0219332e1",
                                                "text": "„In einem Land der Intensivwirtschaft und versiegelten Flächen konnten sie einen wildes Fleckchen bewahren.“"
                                            },
                                            {
                                                "example_id": "960cfd54-22f1-40fe-9ef2-f79ce4f0b000",
                                                "sense_id": "15e8eef4-4b9f-33a0-b35f-54f0219332e1",
                                                "text": "„Eine Forderung auf der Tagung werde daher sein, versiegelte Flächen wie alte Stallanlagen oder nicht mehr gebrauchte Wirtschaftsflächen in den natürlichen Zustand zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "63483f0c-bfd6-4919-9044-318bd67eac10",
                                                "sense_id": "15e8eef4-4b9f-33a0-b35f-54f0219332e1",
                                                "text": "„»Auf versiegelten Flächen arbeiten wir schon lange mit anderen Baumarten«, sagt Leander Wilhelm, Leiter der städtischen Baumschule in München.“"
                                            },
                                            {
                                                "example_id": "88ed3c76-c48d-4696-8cdb-f4e872f3f94d",
                                                "sense_id": "15e8eef4-4b9f-33a0-b35f-54f0219332e1",
                                                "text": "„Wenn statt dessen mosaikartig Grünflächen und versiegelte, also bebaute Flächen nebeneinander angeordnet würden, glaubt Mayer, könne damit auch die Lebensqualität verbessert werden.“"
                                            },
                                            {
                                                "example_id": "41ae8302-b571-47d5-a3db-1fcd87bf4912",
                                                "sense_id": "15e8eef4-4b9f-33a0-b35f-54f0219332e1",
                                                "text": "„Die Experten, wenn sie die Überschwemmungen unserer Zeit erklären, verweisen gerne auf die begradigten Flüsse, auf die vom Asphalt versiegelten Landschaften, auf die steppengleichen Flächen der modernen Landwirtschaft – mit anderen Worten: auf Menschenwerk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
