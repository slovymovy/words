                                    {
                                        "sense_id": "f02b627b-d3cb-38e7-b0e0-eddb9a2766ca",
                                        "entry_id": "b039559f-240a-3ce6-b9b7-6281067a8d41",
                                        "glosses": [
                                            "Divine animation; that which brings life into living things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b47a5f5-d6c2-4847-acd2-0ff8eb92ffff",
                                                "sense_id": "f02b627b-d3cb-38e7-b0e0-eddb9a2766ca",
                                                "text": "He it was who had bespangled the soils with russet leaves and reeds and who had breathed the breath of life into beings."
                                            },
                                            {
                                                "example_id": "07b0aa7e-7742-4862-bf43-51fc84700df7",
                                                "sense_id": "f02b627b-d3cb-38e7-b0e0-eddb9a2766ca",
                                                "text": "\"Whether a child is born in the urban sprawl of Detroit or the windswept plains of Nebraska, they look up at the same night sky, they fill their heart with the same dreams, and they are infused with the breath of life by the same almighty Creator.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
