                "senses": [
                    {
                        "sense_id": "858900c6-264e-3000-84ab-e712e97ac709",
                        "entry_id": "46366dd9-2e05-3bb5-9d8b-9289d0ab1eee",
                        "glosses": [
                            "Darstellungsmittel, um die hierarchische Struktur sprachlicher Einheiten (Wörter oder Sätze) zu veranschaulichen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50bcf1cc-0e9c-4f09-aee3-3f5593e772b7",
                                "sense_id": "858900c6-264e-3000-84ab-e712e97ac709",
                                "text": "Ein Strukturbaum veranschaulicht die engeren oder weniger engen Beziehungen zwischen den Bestandteilen einer sprachlichen Einheit, wie sie durch die IC-Analyse ermittelt werden."
                            },
                            {
                                "example_id": "0bb4b28e-d3f4-4135-aaf5-32d89b1fff52",
                                "sense_id": "858900c6-264e-3000-84ab-e712e97ac709",
                                "text": "„Von dieser Tatsache wird auch der schönste Strukturbaum angesägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
