                                            },
                                            {
                                                "example_id": "c49fc7cb-47fe-41eb-8abd-2cfe81ea3985",
                                                "sense_id": "d40e0f0d-bc02-3024-9281-7af2e81208ce",
                                                "text": "half conscious"
                                            },
                                            {
                                                "example_id": "a62652b8-88e9-46e2-b1e2-d97b32ec3c9b",
                                                "sense_id": "d40e0f0d-bc02-3024-9281-7af2e81208ce",
                                                "text": "He does sometimes half wish to change his life, but it is too difficult."
                                            },
                                            {
                                                "example_id": "a921efb0-dbfe-4371-a2fe-33e26c0982b1",
                                                "sense_id": "d40e0f0d-bc02-3024-9281-7af2e81208ce",
                                                "text": "Half loth and half consenting."
                                            },
                                            {
                                                "example_id": "96d3482f-baed-490f-affe-056e9d546bb6",
                                                "sense_id": "d40e0f0d-bc02-3024-9281-7af2e81208ce",
                                                "text": "Their children spoke half in the speech of Ashdod."
