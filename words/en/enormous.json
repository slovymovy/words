            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                    "sense_definition": "Extremely large; greatly exceeding the common size, extent, or degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elephant is an <w>enormous</w> animal that lives in Africa and Asia.",
                            "target_lang_translations": {
                                "ru": "Слон — это <w>огромное</w> животное, обитающее в Африке и Азии.",
                                "tr": "Fil, Afrika ve Asya'da yaşayan <w>kocaman</w> bir hayvandır."
                            }
                        },
                        {
                            "text": "She felt <w>enormous</w> pressure to finish the important project on time.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>огромное</w> давление, стремясь закончить важный проект вовремя.",
                                "tr": "Önemli projeyi zamanında bitirmek için <w>muazzam</w> bir baskı hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "huge",
                        "gigantic",
                        "humongous",
                        "massive",
                        "tremendous",
                        "immense",
                        "vast"
                    ],
                    "antonyms": [
                        "tiny"
                    ],
                    "common_phrases": [
                        "enormous amount",
                        "enormous pressure",
                        "enormous success",
                        "enormous potential",
                        "enormous impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно большой; значительно превышающий обычный размер, объем или степень.",
                        "tr": "Son derece büyük; yaygın boyut, kapsam veya dereceyi büyük ölçüde aşan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "самый общий и употребительный вариант"
                            },
                            {
                                "target_lang_word": "громадный",
                                "target_lang_sense_clarification": "синоним слова «огромный», часто используется для описания физических размеров"
                            },
                            {
                                "target_lang_word": "гигантский",
                                "target_lang_sense_clarification": "исполинский, превышающий все обычные меры"
                            }
