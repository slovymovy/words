                                                "sense_id": "9946df5b-07ad-3a34-8915-447fc029033a",
                                                "text": "Dein Opa hat ein schlimmes Bein und kann nicht so schnell laufen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7146085c-c57a-3ea4-a457-e2b0e6015f4a",
