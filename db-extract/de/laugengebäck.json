                ],
                "senses": [
                    {
                        "sense_id": "e763cfc3-7bca-3fdc-9c98-91f947cbbc9d",
                        "entry_id": "c00f6004-5f00-31a6-b6b8-d67e1603fd32",
                        "glosses": [
                            "Brot, das vor dem Backen mit Natriumhydroxidlösung (Natronlauge) benetzt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0cc15a-46ff-4714-a274-d361189c75f5",
                                "sense_id": "e763cfc3-7bca-3fdc-9c98-91f947cbbc9d",
                                "text": "„Peter öffnet die Brötchentüte, atmet den Duft von frischem Laugengebäck und Schinken ein und legt alles wieder auf seinen Schreibtisch.“"
                            },
                            {
                                "example_id": "e1697ceb-eb7d-4b54-8b9d-e311b897e887",
                                "sense_id": "e763cfc3-7bca-3fdc-9c98-91f947cbbc9d",
                                "text": "„So trug sie in einem Korb ein paar deftige Würsterl und selbstgebackenes Laugengebäck mit sich.“"
                            },
                            {
                                "example_id": "a8909ce4-b337-486a-8949-ada4b052b621",
                                "sense_id": "e763cfc3-7bca-3fdc-9c98-91f947cbbc9d",
                                "text": "„Im Kofferraum stand ein Picknickkorb, gefüllt mit Würstchen, Nudelsalat, Laugengebäck, einer Plastikdose mit Zitronenmuffins und zwei Flaschen Saftschorle.“"
                            },
                            {
                                "example_id": "b6d613bc-48d1-4342-bb65-63fd835fd648",
                                "sense_id": "e763cfc3-7bca-3fdc-9c98-91f947cbbc9d",
                                "text": "„Neben einem Korb mit frischen Semmeln und Laugengebäck standen bald darauf einige Schälchen mit Honig und Marmelade auf dem Tisch.“"
                            },
                            {
                                "example_id": "ac97c48a-6094-44ce-82a3-8f46da2a7807",
                                "sense_id": "e763cfc3-7bca-3fdc-9c98-91f947cbbc9d",
                                "text": "„Kein Bäcker der Welt wird je an die Qualität deines Laugengebäcks kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
