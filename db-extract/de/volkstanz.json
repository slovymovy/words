                "senses": [
                    {
                        "sense_id": "091d0414-a45d-3ba3-ace5-e0fda72d3769",
                        "entry_id": "036b19ce-78be-3a36-8766-d2c194c1e8cf",
                        "glosses": [
                            "Tanz des Volkes im Gegensatz zu Tänzen angeblicher höheren Gesellschaft und im Gegensatz zu den Bühnentänzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65aea472-7eb0-437e-ba8f-7469f2aac4d3",
                                "sense_id": "091d0414-a45d-3ba3-ace5-e0fda72d3769",
                                "text": "„Die Tanzgruppen bringen sich gegenseitig neue Tänze bei, was vor allem für die Litauer eine leichte Übung sein sollte, ist Volkstanz in Litauen sogar ein Schulfach.“"
                            },
                            {
                                "example_id": "8b2b1510-b126-4316-8d02-d071df562368",
                                "sense_id": "091d0414-a45d-3ba3-ace5-e0fda72d3769",
                                "text": "Die Sardana ist der katalanische Volkstanz schlechthin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
