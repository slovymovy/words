                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ebb9495-4a3d-4e60-82da-dd257b50a116",
                                "sense_id": "289a08a0-d34d-302e-8a96-c68cee7bdaa3",
                                "text": "A travers une jonchaie, on distinguait la blancheur des sept arches surélevées d’un aqueduc."
                            },
                            {
                                "example_id": "689c20a4-0523-41bc-a4d6-bb8545557518",
                                "sense_id": "289a08a0-d34d-302e-8a96-c68cee7bdaa3",
                                "text": "Lécluse est un gros village de l’Artois, ceint d’étangs. Ses vastes jonchaies hébergeaient des canards et des foulques ; les eaux grouillaient de poissons."
                            }
                        ]
