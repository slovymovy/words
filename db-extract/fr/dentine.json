                        "entry_id": "689e934f-091d-3ea1-8d55-6dfd404da911",
                        "glosses": [
                            "Substance majoritaire constituant la dent et plus généralement l’organe dentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ffe78ec-ba0c-4ac2-8baa-76aa1331d041",
                                "sense_id": "0cb26738-f15c-3a3a-b9bb-4203c2aa078c",
                                "text": "La dentine est vascularisée et innervée par les vaisseaux et les nerfs venant du desmodonte depuis l’apex radiculaire jusqu’à la chambre pulpaire coronaire"
                            },
                            {
                                "example_id": "04c6c4b1-10b7-4e22-b2fd-333f21905df3",
                                "sense_id": "0cb26738-f15c-3a3a-b9bb-4203c2aa078c",
                                "text": "Autour de la pulpe et des canaux, la dentine est le tissu dur où se fixe le calcium."
                            }
                        ]
                    }
                ],
