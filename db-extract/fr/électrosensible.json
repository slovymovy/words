                                "target_senses": [
                                    {
                                        "sense_id": "ffbc029b-154a-3050-a7e9-c560aacf63fa",
                                        "entry_id": "f6abaa32-2f29-3ae4-8328-a5d913d929e7",
                                        "glosses": [
                                            "Synonym of electrosensitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b931fb-b223-4a7e-8901-140ceb014942",
                                                "sense_id": "ffbc029b-154a-3050-a7e9-c560aacf63fa",
                                                "text": "A large spectrum of techniques was tested by the manufacturers: scanners using photodiodes and CCD line sensors, software or hardware modems, printers using thermic, photosensible, electrosensible and electrochimic papers."
                                            },
                                            {
                                                "example_id": "88d52102-18b5-4fe9-afae-e15df9d8d5ec",
                                                "sense_id": "ffbc029b-154a-3050-a7e9-c560aacf63fa",
                                                "text": "The best least square fit was found for a second log-normal distribution superposed at the sensitive end, again indicating the existence of a very sensitive subgroup among the general population and leading to the estimation that this very electrosensible subgroup could have the size of approximately 2% of the general population [Leitgeb, 1998]"
                                            },
                                            {
                                                "example_id": "60cdc4d7-bfa4-4780-8b9e-545e0e96a7d0",
                                                "sense_id": "ffbc029b-154a-3050-a7e9-c560aacf63fa",
                                                "text": "The existence of the very “electrosensible” subgroup can be seen as the second log-normal distribution on the fig 2."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
