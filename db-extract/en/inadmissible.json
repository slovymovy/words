                    {
                        "sense_id": "ab54feb4-2e6c-3315-82eb-c3bbe4b7bb6b",
                        "entry_id": "7f00cf39-15a5-30b7-8245-4a60a42ec52f",
                        "glosses": [
                            "Not admissible, especially that cannot be admitted as evidence at a trial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab559b7a-beb5-481c-ad32-b8e9c02ee302",
                                "sense_id": "ab54feb4-2e6c-3315-82eb-c3bbe4b7bb6b",
                                "text": "Again, the multiplist would hold that the grounds for separating admissible from inadmissible interpretations cannot be the same as the grounds for preferability among admissible interpretations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9a4a7ca-0dbe-4d22-a9d1-62893ee427be",
                        "source_entry_id": "7f00cf39-15a5-30b7-8245-4a60a42ec52f",
                        "source_sense_id": "ab54feb4-2e6c-3315-82eb-c3bbe4b7bb6b",
