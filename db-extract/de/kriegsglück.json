                                "sense_id": "f2805406-a071-3e23-abab-5edbe90ca14a",
                                "text": "„Jetzt hatte das Kriegsglück sich gewendet und die Weißen flohen Hals über Kopf nach Süden in Richtung Novorossijsk.“"
                            },
                            {
                                "example_id": "f90448e1-7f26-4d59-8831-907ba8f1092c",
                                "sense_id": "f2805406-a071-3e23-abab-5edbe90ca14a",
                                "text": "„Das Kriegsglück blieb den Japanern so wenig treu wie dem deutschen Diktator.“"
                            },
                            {
                                "example_id": "84ecb7b1-176e-4356-8f3f-bcbe5f7e1f5c",
                                "sense_id": "f2805406-a071-3e23-abab-5edbe90ca14a",
                                "text": "„Im Frühjahr 1942 wendete sich das Kriegsglück auf dramatische Weise.“"
                            }
