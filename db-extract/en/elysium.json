                                                "sense_id": "bdac67f6-0a42-37ad-8a5a-d00d88b7afe9",
                                                "text": "„Freude schöner Götterfunken, Tochter aus Elysium (…)“"
                                            },
                                            {
                                                "example_id": "249005d6-3d96-4262-9082-0a2ab246ba21",
                                                "sense_id": "bdac67f6-0a42-37ad-8a5a-d00d88b7afe9",
                                                "text": "„Wieland nimmt in seinem Roman (zuerst 1789 im »Teutschen Merkur« in Fortsetzungen erschienen) die Form von Lukians »Totengesprächen« auf und lässt deren Autor und das Objekt seiner biographischen Kolportage im Elysium einander begegnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76347038-5e4e-30cf-878f-c34e2f069583",
                                        "entry_id": "ee19021d-44b7-35e7-b24d-05122b912e7f",
                                        "glosses": [
                                            "ein Gebiet auf dem Planeten Mars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "982e4240-5f7a-4935-8668-155de6c698e3",
                                                "sense_id": "76347038-5e4e-30cf-878f-c34e2f069583",
                                                "text": "In der Elysium-Ebene nahe dem Marsäquator entdeckte die ESA-Raumsonde \"Mars Express\" einen zugefrorenen See."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
