                        "entry_id": "21bcff35-aad4-3a6d-9461-cf98e031a43a",
                        "glosses": [
                            "Methylated spirits mixed with red wine or Condy's crystals."
                        ],
                        "tags": [
                            "Australia",
                            "historical",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "87657cca-9a3b-4987-a6fc-0ad2d0b55547",
                                "sense_id": "9808b288-843a-3c33-bd0e-6c6d85d671b4",
                                "text": "“Here,” Nigel greeted him, “do try a spot of ‘pinky,’ it's ever so much fun, really.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "5fbdb70d-6959-344f-9f93-f61a6f772b3e",
