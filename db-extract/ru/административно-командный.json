                ],
                "senses": [
                    {
                        "sense_id": "b4401df0-f695-30ed-86b0-55ae62be34bf",
                        "entry_id": "881c0a2f-5709-3f22-998e-64f4102c735c",
                        "glosses": [
                            "неодобр. основанный на принудительном подчинении приказам и распоряжениям начальства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b01c2bd-b5f2-48ba-ab28-4a4688d957ce",
                                "sense_id": "b4401df0-f695-30ed-86b0-55ae62be34bf",
                                "text": "Не изжит административно-командный тон в отношениях аппарата к депутатам."
                            },
                            {
                                "example_id": "763acee3-350f-4406-bbe5-1976f1d92e6c",
                                "sense_id": "b4401df0-f695-30ed-86b0-55ae62be34bf",
                                "text": "Налицо административно-командный тип руководства. Желание навязать свою волю."
                            },
                            {
                                "example_id": "ac82208b-7315-4c67-a2e8-2e868ff9e87b",
                                "sense_id": "b4401df0-f695-30ed-86b0-55ae62be34bf",
                                "text": "Административно-командный монополизм имеет место в странах, где государство полностью осуществляет централизованное управление всем общественным производством на основе государственной собственности."
                            }
                        ]
                    }
                ],
