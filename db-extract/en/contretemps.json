                    },
                    {
                        "translation_id": "e9147d5c-24ac-4f9e-ba39-4ffdb1bcab5e",
                        "source_entry_id": "b14acbb1-07d4-3cf7-9e4c-3d5358d4fbdf",
                        "source_sense_description": "an unforeseen or embarrassing event",
                        "target_lang_word": "Unannehmlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unannehmlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                        "entry_id": "8f3cad81-f8c9-3cd7-841d-d38844303c34",
                                        "glosses": [
                                            "unangenehme Sache, Ärgernis"
                                        ],
                                        "tags": [
                                            "abstract"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37537714-f80c-43e5-9007-22d1febfe541",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Ist der Schnelltest positiv, hat der Fahrer noch keine rechtlichen Folgen, wohl aber Unannehmlichkeiten zu befürchten.“"
                                            },
                                            {
                                                "example_id": "4985ce0e-206e-4c66-8d15-e7a7ce62c554",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "Dieser Plan bereitet erhebliche Unannehmlichkeiten."
                                            },
                                            {
                                                "example_id": "f49dfe7a-48b3-426b-8aa8-c30b6f3ab3a7",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "Ich würde gerne heute Nachmittag vorbeischauen, wenn es Ihnen keine Unannehmlichkeiten bereitet."
                                            },
                                            {
                                                "example_id": "5631eb5e-5a03-4d73-b6ca-76d0aa521caf",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Ich erinnerte mich, daß mir die gleiche Unannehmlichkeit unter ähnlichen Umständen in Köln zugestoßen war.“"
                                            },
                                            {
                                                "example_id": "87af7359-c9a8-4afc-be5f-d3be2b772d2d",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Im Oktober 1759 entschuldigt er Bodmer gegenüber sein langes Schweigen mit Unannehmlichkeiten in seiner Arbeitssituation.“"
                                            },
                                            {
                                                "example_id": "d58da87b-add1-448c-b80c-76efbfcec68b",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Wohl trafen sie mancherlei Unannehmlichkeiten, wie Einkommensteuerformulare, Alkoholknappheit und junge Männer, deren Väter sie gekannt hatte, und die ihr ungedeckte Schecks gaben – aber all das war schnell vergessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5058fc-36b4-4486-bbe7-a83597fd3888",
                        "source_entry_id": "b14acbb1-07d4-3cf7-9e4c-3d5358d4fbdf",
                        "source_sense_description": "an unforeseen or embarrassing event",
                        "target_lang_word": "Zwischenfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwischenfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                        "entry_id": "64e71d0c-b50d-32da-a9d2-1bc4c3d230f6",
                                        "glosses": [
                                            "ein unvorhergesehenes, störendes Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fec2af-2b90-4d78-8207-cc77d718c02e",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "Entschuldigung, dass ich zu spät bin, es gab einen Zwischenfall. Jaja, ich weiß, ich hab mein Bein verloren."
                                            },
                                            {
                                                "example_id": "42181e0e-144a-4d6f-8f25-3698bd4f7aeb",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "Unser Ausflug in die Berge verlief ohne nennenswerte Zwischenfälle."
                                            },
                                            {
                                                "example_id": "f2b94e47-0de4-4e02-8ca4-565657fb7be8",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Der Zwischenfall hat mich noch etwas anderes gelehrt.“"
                                            },
                                            {
                                                "example_id": "24c499bc-f170-46b4-a449-925796fa6877",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Die Mutter hatte den Zwischenfall genossen, da konnte mir ihre perfekt geheuchelte Anteilnahme nichts vormachen.“"
                                            },
                                            {
                                                "example_id": "e3efae69-bfb9-4c78-861e-2788cae3f932",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Der Zwischenfall tat dem Ehrgeiz und Forscherdrang des Deutschen keinen Abbruch.“"
                                            },
                                            {
                                                "example_id": "1a7de2db-3812-405e-bb8b-215273e4e953",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Nach diesem Zwischenfall waren die Nachbarn weggeblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c33e50a-5add-3bbb-9601-d06181007ad7",
                                        "entry_id": "64e71d0c-b50d-32da-a9d2-1bc4c3d230f6",
                                        "glosses": [
                                            "Auflauf und Zusammenstoß von aufgebrachten Menschen"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee67fbcb-b6a2-4480-9265-e6f997496a7e",
                                                "sense_id": "3c33e50a-5add-3bbb-9601-d06181007ad7",
                                                "text": "Während der Demonstration kam es zu blutigen Zwischenfällen."
                                            },
                                            {
                                                "example_id": "0e61043d-9ceb-4be6-95c8-8efa30831b1f",
                                                "sense_id": "3c33e50a-5add-3bbb-9601-d06181007ad7",
                                                "text": "„Der Sprecher meldete schwere Zwischenfälle an der Grenze zu Sierra Leone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
