                                "example_id": "ce0f64d3-e619-4596-a0d2-d967dc332b8a",
                                "sense_id": "00f8bdaa-fe5d-3080-8013-8d753e3d0128",
                                "text": "Désartificialiser le territoire, les modes de production et de consommation, les modes de vie."
                            },
