        "fr-extract.jsonl": [
            {
                "entry_id": "1c64eb8d-f875-3593-a70e-f8ec5fb8556e",
                "word": "inox",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "192f710e-ca6b-33ac-aa9b-78ea76953e64",
                        "entry_id": "1c64eb8d-f875-3593-a70e-f8ec5fb8556e",
                        "glosses": [
                            "Matériau dit inoxydable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8993c4-27e8-41c7-98e8-82563742e913",
                                "sense_id": "192f710e-ca6b-33ac-aa9b-78ea76953e64",
                                "text": "Raphaël monta sur le bar en intox et se mit à danser."
                            },
                            {
                                "example_id": "cf5b614b-5d71-4fed-9cda-34f350c29457",
                                "sense_id": "192f710e-ca6b-33ac-aa9b-78ea76953e64",
                                "text": "Sans doute que la serpillère est humide, car une fois l'opération de dépoussiérage terminée, l'homme la rhabille d'un chiffon blanc immaculé et achève le polissage de l’inox."
                            }
                        ]
                    },
                    {
                        "sense_id": "edddfe7c-311b-30c4-9444-8fda3b8d7d49",
                        "entry_id": "1c64eb8d-f875-3593-a70e-f8ec5fb8556e",
                        "glosses": [
                            "Acier inoxydable."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2094630b-669b-47c7-9903-b698370b323f",
                                "sense_id": "edddfe7c-311b-30c4-9444-8fda3b8d7d49",
                                "text": "Inox est le diminutif d’acier inoxydable, un alliage d’acier composé principalement de carbone, de chrome et de nickel. Son principal atout est d’être un matériau sain qui ne rouille pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "052081c9-4ae4-4f6b-820f-9d6457e4498d",
                        "source_entry_id": "1c64eb8d-f875-3593-a70e-f8ec5fb8556e",
                        "source_sense_description": "Acier inoxydable (2)",
                        "target_lang_word": "stainless steel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stainless steel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6836a20-7cfe-3068-bc70-d7fc12f8be35",
                                        "entry_id": "68e1c6b0-4b16-32d2-b66c-11278485d308",
                                        "glosses": [
                                            "Any of a class of steels that resist corrosion; they are all alloys of iron, chromium, and carbon, and most also contain certain other elements as well (such as molybdenum, nickel, cobalt, or others)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3fc1ae-c5be-4c60-8672-6257d81cf160",
                                                "sense_id": "c6836a20-7cfe-3068-bc70-d7fc12f8be35",
                                                "text": "Near-synonym: CRES (broadly synonymous)"
                                            },
                                            {
                                                "example_id": "28c5e432-3829-4ce4-acba-9665fd36618b",
                                                "sense_id": "c6836a20-7cfe-3068-bc70-d7fc12f8be35",
                                                "text": "Lead is used as part of the tumbler’s vacuum insulation and is covered by a stainless steel layer that protects consumers from lead exposure, according to the Stanley cup manufacturer, Pacific Market International."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stainless steel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25d83ff1-02bf-3eb8-a22a-b6470297ab87",
                                        "entry_id": "41971da0-d111-377d-b002-62fc42531ad8",
                                        "glosses": [
                                            "Made of stainless steel."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba7d8f8-8670-477b-a416-8f1e261c4443",
                                                "sense_id": "25d83ff1-02bf-3eb8-a22a-b6470297ab87",
                                                "text": "stainless steel cutlery"
                                            },
                                            {
                                                "example_id": "333452cb-d518-41e7-ab67-6f3bc1482069",
                                                "sense_id": "25d83ff1-02bf-3eb8-a22a-b6470297ab87",
                                                "text": "Equally I can stand in a station like Lucerne in Switzerland, and watch with ill-concealed admiration the majestic entry of one of the latest Gotthard \"Ae 6/6\" electrics, packing 6,000 horsepower within its 60 ft. of length and 121 tons of weight, with its sleek dark green sides and handsome stainless steel bands and front wings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbf372ed-5e62-4038-87d8-d35fcdb2757c",
                        "source_entry_id": "1c64eb8d-f875-3593-a70e-f8ec5fb8556e",
                        "source_sense_description": "Acier inoxydable (2)",
                        "target_lang_word": "rvs",
                        "target_lang_code": "nl",
