    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "38f8d8d7-bea4-3526-afe6-0709774a5a08",
                "word": "geschenkt",
                "pos": "intj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "368072e5-1d48-3021-be24-438b78bc69ba",
                        "entry_id": "38f8d8d7-bea4-3526-afe6-0709774a5a08",
                        "glosses": [
                            "forget it, forget about it, nevermind, that’s not so problematic, (also in the sense of) that’s one thing, that’s not the worst part"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91b599c-c780-42ed-84c0-b047ac76aec9",
                                "sense_id": "368072e5-1d48-3021-be24-438b78bc69ba",
                                "text": "„Ach, jetzt steht mein Name hier zuerst. Eigentlich müssten Sie ja...“ – „Geschenkt!“",
                                "translation": "“Oh, somehow my name is mentioned first now. Normally you should...” – “Forget about it!”",
                                "english": "“Oh, somehow my name is mentioned first now. Normally you should...” – “Forget about it!”"
                            },
                            {
                                "example_id": "3ac11227-7b2b-42bf-ad2c-34674d4c6c6d",
                                "sense_id": "368072e5-1d48-3021-be24-438b78bc69ba",
                                "text": "Dass Sie sich unabgesprochen mit der Konkurrenz getroffen haben – geschenkt! Aber dass Sie dabei Interna ausgeplaudert haben, hat ein Nachspiel.",
                                "translation": "That you met with our competitors without authority – forget about it! But your disclosing internal information at that meeting will have consequences.",
                                "english": "That you met with our competitors without authority – forget about it! But your disclosing internal information at that meeting will have consequences."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
