                            {
                                "target_lang_word": "пнуть",
                                "target_lang_sense_clarification": "ударить ногой (совершенный вид)"
                            },
                            {
                                "target_lang_word": "ударять ногой",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踢",
                                "target_lang_sense_clarification": "用脚击打"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b359cff-c428-3603-b4a1-108e2d90346c",
                    "sense_definition": "To force someone to leave a place or organization.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>kicked</w> him out of the club for fighting.",
                            "target_lang_translations": {
                                "ru": "Они <w>выгнали</w> его из клуба за драку.",
                                "zh": "因为打架，他们把他<w>踢出</w>了俱乐部。"
                            }
                        },
                        {
                            "text": "She was <w>kicked</w> off the team because she missed practice.",
                            "target_lang_translations": {
                                "ru": "Ее <w>выгнали</w> из команды, потому что она пропускала тренировки.",
                                "zh": "她因为缺席训练被<w>开除</w>出了队伍。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kick out",
                        "get kicked out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо покинуть место или организацию.",
                        "zh": "强迫某人离开某个地方或组织。"
                    },
                    "translations": {
