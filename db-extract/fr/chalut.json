                                    {
                                        "sense_id": "a8bfdac3-18e2-333f-af9e-2b742782170b",
                                        "entry_id": "12095164-24e6-33c2-bd7a-0d885df81e15",
                                        "glosses": [
                                            "ein von einem oder zwei Booten gezogener, großer, trichterförmiger Netzsack als Fischfanggerät in der Seefischerei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36127fe1-5d0a-486b-af5c-6d91c74dd4f3",
                                                "sense_id": "a8bfdac3-18e2-333f-af9e-2b742782170b",
                                                "text": "„Das pelagische Schleppnetz ist heute neben dem Grundschleppnetz das meistverwendete Fanggerät in der Hochseefischerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48a8576e-a909-4c9f-bb2d-05cb845ee42b",
                        "source_entry_id": "636b09fc-ca89-34a3-a96b-fbb255a0f320",
                        "source_sense_id": "7854eb2c-50f2-3cdf-949f-30e51d9c115d",
                        "source_sense_description": "Filet de forme conique",
                        "target_lang_word": "dragnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79e2c28e-1049-3dbf-8bc6-056db6ca8f5d",
                                        "entry_id": "82fbe51c-d7ee-3410-9103-ef5046938142",
                                        "glosses": [
                                            "A net dragged across the bottom of a body of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e3242a4-8e85-4826-9d3d-5b527065a491",
                                                "sense_id": "79e2c28e-1049-3dbf-8bc6-056db6ca8f5d",
                                                "text": "Anchovy dragnets are an important part Korea's fishing sector. Over 99% of catches found in anchovy dragnets are anchovy. Although the annual total catches of anchovy have fluctuated, dragnets catch 55 to 70% of the total annual catch of anchovy. The remaining portion is caught with drift gill nets (10%) and other fishing methods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd20f49-5ab7-3cc9-bdaa-4f6246adc3d6",
                                        "entry_id": "82fbe51c-d7ee-3410-9103-ef5046938142",
                                        "glosses": [
                                            "Heightened efforts by law enforcement personnel undertaken in order to capture suspects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e72a8ad-feeb-4bb5-a515-848eec92c114",
                                                "sense_id": "9dd20f49-5ab7-3cc9-bdaa-4f6246adc3d6",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives.[…]who, if anyone, is policing their use[?] Such concerns were sharpened further by the continuing revelations about how the US National Security Agency (NSA) has been using algorithms to help it interpret the colossal amounts of data it has collected from its covert dragnet of international telecommunications."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dragnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93b20977-95d4-3576-ba22-84dcc388c377",
                                        "entry_id": "73cb1db8-88fb-319f-9a96-e491cc8031a3",
                                        "glosses": [
                                            "To drag a net across the bottom of a body of water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef7a2ce-5859-4f2e-ac46-c1df768d2f08",
                                                "sense_id": "93b20977-95d4-3576-ba22-84dcc388c377",
                                                "text": "When ponds are cleaned out periodically, fish are trapped or dragnetted and finally the pond is drained to remove all fish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171b4f86-a139-3cfd-8035-2c0d05fa3bed",
                                        "entry_id": "73cb1db8-88fb-319f-9a96-e491cc8031a3",
                                        "glosses": [
                                            "To undertake heightened efforts to catch a suspect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ad1a4c6-d267-4f78-a492-e4f1bf6afdb4",
                                                "sense_id": "171b4f86-a139-3cfd-8035-2c0d05fa3bed",
                                                "text": "In fact, Carty was not the man, but, after a police swoop had dragnetted twenty men suspected of having taken part in the business, he was lodged in Sligo jail and accused of this violence to the lady."
                                            },
                                            {
                                                "example_id": "81154f27-1450-4c21-a273-8662484eb2fa",
                                                "sense_id": "171b4f86-a139-3cfd-8035-2c0d05fa3bed",
                                                "text": "A May Day anti-capitalist protest last year in Seattle saw clashes between police and protesters, and the FBI had been dragnetting potential anarchists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
