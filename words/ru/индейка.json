                {
                    "sense_id": "dc954b85-c74a-3047-97ad-197b1ac80184",
                    "sense_definition": "Крупная одомашненная птица семейства фазановых, самка <w>индюка</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "птица",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во дворе дома важной походкой ходила взрослая <w>индейка</w>.",
                            "target_lang_translations": {
                                "en": "In the courtyard of the house, a full-grown <w>turkey</w> was pacing with a stately walk."
                            }
                        },
                        {
                            "text": "Фермер разводит гусей, уток и домашних <w>индеек</w> для продажи.",
                            "target_lang_translations": {
                                "en": "The farmer raises geese, ducks, and domestic <w>turkeys</w> for sale."
                            }
                        }
                    ],
                    "synonyms": [
                        "индюшка"
                    ],
                    "antonyms": [
                        "индюк"
                    ],
                    "common_phrases": [
                        "домашняя индейка"
                    ],
                    "target_lang_definitions": {
                        "en": "A large domesticated bird of the pheasant family; specifically a female turkey (hen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turkey",
                                "target_lang_sense_clarification": "bird"
                            },
                            {
                                "target_lang_word": "turkey hen",
                                "target_lang_sense_clarification": "female bird"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2020cec3-66aa-346b-88f2-196cf988e196",
                    "sense_definition": "Мясо такой птицы как продукт питания; индюшатина.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "мясо",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для легкого и полезного обеда мы купили свежее филе <w>индейки</w>.",
                            "target_lang_translations": {
                                "en": "For a light and healthy lunch, we bought fresh <w>turkey</w> fillet."
                            }
                        },
                        {
                            "text": "Врач посоветовал пациенту заменить жирную свинину на отварную <w>индейку</w>.",
                            "target_lang_translations": {
                                "en": "The doctor advised the patient to replace fatty pork with boiled <w>turkey</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "индюшатина"
                    ],
                    "common_phrases": [
                        "филе индейки",
                        "грудка индейки",
                        "мясо индейки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "употребление названия птицы в значении мяса"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Meat of a turkey used as food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turkey",
                                "target_lang_sense_clarification": "meat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e6f0e20-1282-3e99-b766-fbfd7dd05f2f",
                    "sense_definition": "Кулинарное блюдо, приготовленное из тушки или мяса этой птицы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "блюдо",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На праздничный семейный стол подали большую запеченную <w>индейку</w> с яблоками.",
                            "target_lang_translations": {
                                "en": "A large roast <w>turkey</w> with apples was served for the festive family dinner."
                            }
                        },
                        {
                            "text": "Ароматная жареная <w>индейка</w> стала главным блюдом рождественского ужина.",
                            "target_lang_translations": {
                                "en": "A flavorful roast <w>turkey</w> became the centerpiece of Christmas dinner."
                            }
                        }
                    ],
                    "common_phrases": [
                        "жареная индейка",
                        "запеченная индейка",
                        "рождественская индейка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в значении готового кушанья"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A culinary dish prepared from the carcass or meat of this bird."
                    },
                    "translations": {
                        "en": [
