                                        "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                                        "glosses": [
                                            "The state of being negligent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc6ac3d-b845-437b-a6d7-306490fb0b9a",
                                                "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                                "text": "negligence while driving"
                                            },
                                            {
                                                "example_id": "f1ae1a9d-a15b-4ec3-a96a-4cc14e47149c",
                                                "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                                "text": "The Woodwalton signalman, Rose, who was severely censured in Captain Tyler's report, behaved with great negligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7de9d4-f629-3c22-bfe3-0daee8f29b59",
                                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                                        "glosses": [
                                            "The tort whereby a duty of reasonable care was breached, causing damage: any conduct short of intentional or reckless action that falls below the legal standard for preventing unreasonable injury."
                                        ],
                                        "tags": [
                                            "singular",
                                            "singular-only",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2391426-0d6d-36a5-ac40-9cb8cbcbeef8",
                                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                                        "glosses": [
                                            "The breach of a duty of care: the failure to exercise a standard of care that a reasonable person would have in a similar situation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d04c623d-f192-44e2-a453-22e4d02f9510",
                        "source_entry_id": "63a0ac43-e223-373e-b008-be302532b223",
                        "source_sense_id": "b4cee71c-0163-398a-bc0e-b6a1c20b1a02",
                        "target_lang_word": "Nachlässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachlässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                        "entry_id": "2e38d0bf-628c-3271-a3b9-39eeedf6ca37",
                                        "glosses": [
                                            "kritisierbares Handeln, das darin besteht, dass etwas nicht in der an sich erforderlichen Weise getan wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a2f0a0-58d5-4c91-bdbf-90afe75fcb6f",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Es wäre eine Nachlässigkeit von mir, den Hügel nicht zu erwähnen, der sich auf der Grenze zwischen dem Moorgelände und der Hauswiese befindet.“"
                                            },
                                            {
                                                "example_id": "3e20e9f0-c18e-4bf6-bb4d-350307f8b930",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Evolutionsbiologen erläutern diese Nachlässigkeit der Natur gerne mit dem Beispiel unserer Autos.“"
                                            },
                                            {
                                                "example_id": "589906a1-7b40-4b2a-8277-bf2e08dfd7d7",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Elaine fragt sich, ob eine derartige Nachlässigkeit in der Zeichensetzung ein Hinweis auf ein fehlendes emotionales Interesse an ihrem Leben sein könnte (obwohl sie ihrem Freund davon nichts erzählt.“"
                                            },
                                            {
                                                "example_id": "b5bfa3b5-53bb-4d26-a476-82b2de56b806",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Germaine war nicht fortgegangen, und Gorju kam ab und zu, um den Garten umzugraben; denn aus Nachlässigkeit, aus Gleichgültigkeit gegen die materiellen Dinge hatten sie nachgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d833f853-6497-4b64-a74a-24a87046df56",
                        "source_entry_id": "63a0ac43-e223-373e-b008-be302532b223",
                        "source_sense_id": "b4cee71c-0163-398a-bc0e-b6a1c20b1a02",
                        "target_lang_word": "négligence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négligence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Défaut de soin, d’exactitude, d’application."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3b7329-3dff-4739-a16f-05699140d1c1",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            },
                                            {
                                                "example_id": "2c77602d-5c39-4988-bac0-d6961bc08e93",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Ce texte a été corrigé avec beaucoup de négligence."
                                            },
                                            {
                                                "example_id": "dea35157-175e-49c2-836c-2496075a8b09",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Il aura peine à se faire pardonner ses négligences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148b93df-034f-36fc-af16-848d07f53373",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Le peu de soin qu’une personne apporte à son vêtement, à son extérieur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85935b8-59e8-4d56-8d0e-862eb6308b32",
                                                "sense_id": "148b93df-034f-36fc-af16-848d07f53373",
                                                "text": "Ce savant affecte dans sa mise une excessive négligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "911e4d2d-4228-382f-a529-5d6c5dd1c3bd",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Faute légère que fait un auteur, lorsqu’il n’apporte pas assez de soin à corriger son style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ddd82a-072b-4069-999d-8a099caa3f2d",
                                                "sense_id": "911e4d2d-4228-382f-a529-5d6c5dd1c3bd",
                                                "text": "Il y a dans cet ouvrage des négligences qu’il sera facile de corriger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5f9fa4-07d9-3ccf-9a47-536c1383bc60",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Faute involontaire qui néanmoins peut donner lieu à des poursuites judiciaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfa927b9-d26e-3372-ab6a-b2ef6d1413fd",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Problème neurologique qui empêche un patient d’avoir conscience d’une partie de son environnement ou de son corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86bcdb26-2275-4d2d-840f-2145915184e3",
                                                "sense_id": "cfa927b9-d26e-3372-ab6a-b2ef6d1413fd",
                                                "text": "La négligence ne se limite pas à une modalité sensorielle, mais elle peut affecter l’ensemble de nos sens et toucher notre capacité à agir. Par exemple, un malade négligera aussi bien les informations visuelles, auditives ou tactiles que certaines odeurs. D’autre part, il n’utilisera plus son bras et sa jambe gauche, même si elles ne sont pas paralysées. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 85)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1424ad0b-0f68-4deb-a4a5-bcbad6dd7d02",
                        "source_entry_id": "63a0ac43-e223-373e-b008-be302532b223",
                        "source_sense_id": "b4cee71c-0163-398a-bc0e-b6a1c20b1a02",
                        "target_lang_word": "incurie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incurie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                        "entry_id": "2bc2f390-4093-3864-8b87-a6c35bcc0254",
                                        "glosses": [
                                            "Défaut de soin, négligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb7556f-a4d8-4af9-a7dc-07095c8143be",
                                                "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                                "text": "Au dépeuplement que l’activité, et j’ajoute, l’incurie des chasseurs a provoqué sur les territoires de chasse. On a traqué et tué sans relâche. Ces massacres se sont faits sans discernement."
                                            },
                                            {
                                                "example_id": "e25e3cdf-3f86-480f-8f0a-868259bba0a2",
                                                "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                                "text": "Ce volume, […], convaincra tous ceux qui le liront que, d’avril 1854 à juillet 1870, la France a constamment marché vers le fatal dénoûment de janvier 1871, par le fait de l’impéritie de l’empereur Napoléon III et de l’incurie de ses ministres."
                                            },
                                            {
                                                "example_id": "fb8f0493-97da-48c9-8e75-5cc00c46877e",
                                                "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                                "text": "Des cris d’horreur s'élevèrent de la foule, comme pour protester contre la Providence […], et à plus juste titre, contre l’incurie de l’administration qui avait toléré qu'au centre de Paris on laissât debout une masure dont le peu de solidité constituait une menace permanente pour les maisons du voisinage."
                                            },
                                            {
                                                "example_id": "2158c348-47c6-4128-9ef0-2828d52a73a3",
                                                "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                                "text": "Elle n’en ratait jamais une ma mère pour essayer de me faire croire que le monde était bénin et qu’elle avait bien fait de me concevoir. C’est le grand subterfuge de l’incurie maternelle, cette Providence supposée."
                                            },
                                            {
                                                "example_id": "2a76d6b5-e2dd-42d2-a849-36800a24e320",
                                                "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                                "text": "Dans une ordonnance de renvoi devant la Cour de justice de la République, la commission d'instruction taille en pièces les explications de la patronne du FMI dans l'affaire Tapie, qu'elle juge « affligeantes ». « Le comportement de Mme Lagarde ne procède pas seulement d'une incurie mais aussi d'une conjonction de fautes qui, par leur nature, leur nombre et leur gravité, dépassent le niveau d'une simple négligence », estiment les magistrats."
                                            },
                                            {
                                                "example_id": "8e6ef8e9-dfa8-4f28-86b2-e7b71023d4d6",
                                                "sense_id": "da874653-f7e7-390e-9351-5fca06fd7be3",
                                                "text": "L'incurie de l'archevêque est pointée du doigt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
