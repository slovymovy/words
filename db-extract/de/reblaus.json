                    {
                        "sense_id": "4729e00e-c9cf-3108-9620-60dd28f2a24c",
                        "entry_id": "be12e48a-8f77-3951-84be-c8948a85dc86",
                        "glosses": [
                            "eine eiförmige, gelbe bis grüngelbliche Pflanzenlaus von der Größe eines Stecknadelkopfes, die als Blatt- und als Wurzelreblaus als Schädling an der Rebe auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd41d3a1-95d2-41bc-8708-5fe0119b116c",
                                "sense_id": "4729e00e-c9cf-3108-9620-60dd28f2a24c",
                                "text": "„Die Reblaus verursacht durch Saugen an den feinen Faserwurzeln der Rebe Anschwellungen, an älteren Wurzeln krebsige Knotenbildungen, so dass die Wurzeln absterben und die Rebe vorzeitig eingeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
