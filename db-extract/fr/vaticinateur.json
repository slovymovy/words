                        "entry_id": "b3d9bbbe-2ffb-365a-a214-c85d8630ed19",
                        "glosses": [
                            "Celui qui fait des vaticinations, prédictions de choses futures."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cb88bdb3-df4b-4b0d-af97-968968c5f78e",
                                "sense_id": "8f876f83-54bd-3fca-a56f-21b21ff4b4aa",
                                "text": "Dubois le vaticinateur nous accompagne. Il dit des choses terribles avec la figure innocente d'un curé de campagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "bceab0cb-da26-33c8-a6da-7274d0cde349",
                        "entry_id": "b3d9bbbe-2ffb-365a-a214-c85d8630ed19",
                        "glosses": [
                            "Celui qui délire verbalement, comme s’il était habité par un dieu."
                        ],
                        "tags": [
                            "pejorative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "210dd412-6fe7-4c10-9435-356c95710fe4",
                                "sense_id": "bceab0cb-da26-33c8-a6da-7274d0cde349",
                                "text": "Ce n’était pas le langage d’un vaticinateur : il s’appuyait sur le savoir et l’expérience."
                            }
                        ]
                    }
                ],
