                        "examples": [
                            {
                                "example_id": "3ffecd49-12b7-47ca-baff-683417a912fb",
                                "sense_id": "b6d8d36b-5cf0-350f-bca4-b7afdb8c853b",
                                "text": "As of April 26, the US ranked 22nd in the number of tests performed per capita, according to the Organization for Economic Co-operation and Development (OECD)."
                            },
                            {
                                "example_id": "e1361f98-059e-4855-93ae-b9418d84ab75",
                                "sense_id": "b6d8d36b-5cf0-350f-bca4-b7afdb8c853b",
                                "text": "Although the OECD is not predicting a recession, its forecast is more pessimistic than that of the International Monetary Fund (IMF), which said last month that it expects the world economy to grow by 3.2% this year and 2.7% next year."
                            }
                        ]
                    }
                ],
