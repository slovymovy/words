                        "sense_id": "91fd8115-1975-37b6-b0c5-0935ef80775e",
                        "entry_id": "8f18455f-8674-31e1-9ab9-14ba9a1ff555",
                        "glosses": [
                            "Stadt im Nordwesten der Republik Korea, die südlich von Seoul gelegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50075c73-81f6-45bc-9fce-7b8536b9b1d8",
                                "sense_id": "91fd8115-1975-37b6-b0c5-0935ef80775e",
                                "text": "„Sonderermittler haben heute die Zentrale des größten südkoreanischen Mischkonzerns Samsung durchsucht. Zweck der Razzia in den Büros des Unternehmens in Suwon in der Nähe von Seoul sei die Suche nach Beweismitteln gewesen, die die Existenz von vermuteten schwarzen Kassen belegen könnten, berichtete die nationale Nachrichtenagentur Yonhap.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
