                        "sense_id": "8ae90fb0-e2e9-3553-a163-2e0cfbb2925b",
                        "entry_id": "96b9273e-fdcf-33d5-a59b-5fc7ea36ff32",
                        "glosses": [
                            "A silver coin used during the Roman Empire, equal to two denarii."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e0de2a50-67df-418c-b4e7-8de824591c2c",
                                "sense_id": "8ae90fb0-e2e9-3553-a163-2e0cfbb2925b",
                                "text": "From the 5th year on, Iuppiter conservator coins are continuously produced actually on antoninianuses;"
                            },
                            {
                                "example_id": "dce61a44-770d-4f80-a941-108bd1a444dd",
                                "sense_id": "8ae90fb0-e2e9-3553-a163-2e0cfbb2925b",
                                "text": "The coins were base silver antoninianuses of Decius, coins that had not been in circulation for more than 200 years.[…]The gold are extremely rare, but choice specimens of the debased silver antoninianuses can be purchased for less than $100 each."
                            },
                            {
                                "example_id": "54502cad-508c-46e3-a779-077e157483ec",
                                "sense_id": "8ae90fb0-e2e9-3553-a163-2e0cfbb2925b",
                                "text": "Whether you enjoy coins for their beauty, history, romance, or antiquity, these ancient Roman antoninianuses are sure to please."
                            }
                        ]
                    }
