                "translations": [
                    {
                        "translation_id": "9667abd2-b2d2-4973-8468-644d122b1ff1",
                        "source_entry_id": "4f26039b-a0b1-366b-9c1f-88db5f3a8e22",
                        "source_sense_description": "excellent, grand",
                        "target_lang_word": "super",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "super",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "175b77af-27aa-3346-9f11-49aaf0eea19b",
                                        "entry_id": "936d3dc8-d558-3b77-8a7b-749471a9c01c",
                                        "glosses": [
                                            "Supercarburant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d5a263-9437-4972-b178-6d38a640b4e5",
                                                "sense_id": "175b77af-27aa-3346-9f11-49aaf0eea19b",
                                                "text": "Les huit cylindres en V cognaient, rugissaient, engloutissaient le super, bouffaient l’asphalte."
                                            },
                                            {
                                                "example_id": "cb2d268f-d42e-4108-a5cf-781b142122dd",
                                                "sense_id": "175b77af-27aa-3346-9f11-49aaf0eea19b",
                                                "text": "Le super sans plomb ne se trouve pas partout. Les voitures de location fonctionnent en général au super ou au sans-plomb, à l'exception des 4X4 (gasoil). Le litre de super et l'essence sans plomb coûte environ 9 DH […]."
                                            },
                                            {
                                                "example_id": "d5a9d766-8ce9-45a1-915b-3527449361d1",
                                                "sense_id": "175b77af-27aa-3346-9f11-49aaf0eea19b",
                                                "text": "Depuis le 1ᵉʳ janvier 2002, il n'y a plus, en principe, de rejets de plomb par les pots d'échappement car le super plombé a été remplacé par du super au phosphate. Cette évolution a eu des effets incontestables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3fc3460-17b3-37e5-89cb-97e2308aa869",
                                        "entry_id": "936d3dc8-d558-3b77-8a7b-749471a9c01c",
                                        "glosses": [
                                            "Superphosphate : Engrais phosphaté, à base de phosphate monocalcique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d8b66e-0057-4a7f-b346-85a0b4aa5c6c",
                                                "sense_id": "d3fc3460-17b3-37e5-89cb-97e2308aa869",
                                                "text": "[…]; pour P₂O₅ les doses sont de 40 à 60 kg/ha sous forme solide (200 à 250 kg de super 18) et 40 à 50 kg/ha sous forme liquide et doivent être fractionnées au cours de la saison […]."
                                            },
                                            {
                                                "example_id": "da9d43bb-3cb4-4e8a-b648-d7bed05ea0f4",
                                                "sense_id": "d3fc3460-17b3-37e5-89cb-97e2308aa869",
                                                "text": "Le superphosphate triple de la SIAPE (ou TSP, ou encore super 45) offre de multiples avantages pour la réception en sacs […]."
                                            },
                                            {
                                                "example_id": "6233cb33-cb26-4aad-bceb-10864078aabb",
                                                "sense_id": "d3fc3460-17b3-37e5-89cb-97e2308aa869",
                                                "text": "- les superphosphates (solubilité 50 g/l à pH 7) dosent 25 % P₂O₅ et 20 % CaO pour le super concentré ou 45 % P₂O₅ et 18 % CaO pour le super triple ; […]."
                                            },
                                            {
                                                "example_id": "7d6bf198-e28d-44c2-9de7-c529926b9350",
                                                "sense_id": "d3fc3460-17b3-37e5-89cb-97e2308aa869",
                                                "text": "Arachide - Fertilisation : 15 unités de P₂O₅ sous forme de 75 kg/ha de super simple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb437ed2-285d-310b-9fc7-1e7619d4468d",
                                        "entry_id": "936d3dc8-d558-3b77-8a7b-749471a9c01c",
                                        "glosses": [
                                            "Supermarché."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a991e8f2-4b19-46a8-8b1c-371d6f116124",
                                                "sense_id": "eb437ed2-285d-310b-9fc7-1e7619d4468d",
                                                "text": "Où en étions-nous ? Ah oui ! Saint Temple, familièrement et affectueusement affublé du surnom candide de “super”. J'vais faire les courses au super ! Pour autant, on croirait résumer qu'il est super ; sans doute pourtant n'en a-t-il que le nom. De la nourriture momifiée, pasteurisée, odorisée, ozonisée, et bien entendu, conservatorisée."
                                            },
                                            {
                                                "example_id": "065d50a2-c69e-436e-9664-13266860a594",
                                                "sense_id": "eb437ed2-285d-310b-9fc7-1e7619d4468d",
                                                "text": "Très souvent organisés en mini-boutiques, notamment dans les supers de centre-ville, ces stands traditionnels savent combiner offre de qualité, service professionnel et mise en scène d'exception."
                                            },
                                            {
                                                "example_id": "44c1db8c-c587-4205-9452-420fb7cb904b",
                                                "sense_id": "eb437ed2-285d-310b-9fc7-1e7619d4468d",
                                                "text": "L’accroissement de la longueur des linéaires s'est accompagné d'une plus grande diversité des références: progression de 11% dans les hypers et de 9% dans les supers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "super",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ebe8d7-c6d2-30cc-bbc4-6d3ce691dbaa",
                                        "entry_id": "24e65894-3f2f-3e71-857b-36a3d1ea2252",
                                        "glosses": [
                                            "Très bien, épatant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1abfcd-17b2-4d37-b084-9742b73a4591",
                                                "sense_id": "c0ebe8d7-c6d2-30cc-bbc4-6d3ce691dbaa",
                                                "text": "Il y avait aussi un livre qui s'appelle Kim, que j'ai trouvé super, la suite de Sans Famille, que j'ai trouvé super aussi, et un autre livre qui s'appelle Black Boy, […]."
                                            },
                                            {
                                                "example_id": "f1ec310c-537f-4703-85f1-8f2f4eb48a8e",
                                                "sense_id": "c0ebe8d7-c6d2-30cc-bbc4-6d3ce691dbaa",
                                                "text": "— C'est l'équipe du Brésil, ça ?\n— Oui, c'est l'équipe du Brésil.\n— Ils sont super, hein ?\n— Oui, ils sont super.\n— Bon, eh ben salut, alors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "super",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed2379b5-e9da-36f6-858d-1534c5a82f2b",
                                        "entry_id": "d1e582f5-d5c9-3964-a616-9e7782d4c64d",
                                        "glosses": [
                                            "Très ; extrêmement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71d7d9ed-4104-4c58-a854-7490abdb7dcf",
                                                "sense_id": "ed2379b5-e9da-36f6-858d-1534c5a82f2b",
                                                "text": "Je confirme ma première impression : il n'y aura rien à faire ici, en plus il fait super chaud et peu à peu je perds mon enthousiasme."
                                            },
                                            {
                                                "example_id": "0595fa3c-768b-41fc-ac13-df88f32ec14d",
                                                "sense_id": "ed2379b5-e9da-36f6-858d-1534c5a82f2b",
                                                "text": "J'aime cette notion de spectacle qui nous est donnée à voir: comment l'homme peut se révéler immense et super minuscule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "super",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "101df1d8-c89b-3312-8cc6-66107ba19c19",
                                        "entry_id": "fab6a38c-8396-3a28-9e8d-cf72aafe7568",
                                        "glosses": [
                                            "Aspirer, sucer (quelque chose)."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb534c78-24ae-4d8c-a42a-044af276eeb2",
                                                "sense_id": "101df1d8-c89b-3312-8cc6-66107ba19c19",
                                                "text": "Le matin du quatorzième jour après que le navire avait appareillé dans la rade de Spithead, Bolitho se trouvait dans sa cabine, supant une timbale de café et revenant une fois de plus sur tout ce qu’il avait réussi."
                                            },
                                            {
                                                "example_id": "2725c98a-4a8f-42dc-9397-fd8defeecbfb",
                                                "sense_id": "101df1d8-c89b-3312-8cc6-66107ba19c19",
                                                "text": "Dire que mon argent fut dépensé donnerait une fausse idée de cette opération ; il fut humé, supé, comme on dit en mon pays « northman »."
                                            },
                                            {
                                                "example_id": "ec1357f2-d9c4-4325-818c-b54d60ba8bdc",
                                                "sense_id": "101df1d8-c89b-3312-8cc6-66107ba19c19",
                                                "text": "Puis elle dilue le breuvage qu'elles supent avec un sourire complice"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f322846c-3f81-3e71-aa38-5de3c31ad5d1",
                                        "entry_id": "fab6a38c-8396-3a28-9e8d-cf72aafe7568",
                                        "glosses": [
                                            "Se dit d'une pompe qui aspire aussi l'étoupe une fois toute l'eau de la cale étant vidée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98edf03f-d7df-4529-8fd8-c0ba52034214",
                                                "sense_id": "f322846c-3f81-3e71-aa38-5de3c31ad5d1",
                                                "text": "Un petit placage à jour est placé sous le bout inférieur de chaque pompe pour les empêcher, par leur aspiration, de super l'étoupe des coutures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c9d7b1e-7de5-3edb-aae0-4949141df463",
                                        "entry_id": "fab6a38c-8396-3a28-9e8d-cf72aafe7568",
                                        "glosses": [
                                            "Se dit d'une voie d'eau qui se bouche et aussi d'un cordage qui se coince dans une poulie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937397e1-fee9-4674-8356-63f91ae2b767",
                                                "sense_id": "6c9d7b1e-7de5-3edb-aae0-4949141df463",
                                                "text": "Un cordage est supé quand il est engagé entre le réa. et la paroi de la mortaise d'une poulie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "super",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ee7e22-575a-3113-9c85-70fd488e3056",
                                        "entry_id": "5230596b-95f1-31fa-8679-29855729fe58",
                                        "glosses": [
                                            "Pour marquer une mauvaise nouvelle."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1862d41a-e520-4dc3-8b31-d37fa42c304a",
                                                "sense_id": "d6ee7e22-575a-3113-9c85-70fd488e3056",
                                                "text": "Trois personnes m’ont répondu sur la dizaine contactée, un seul a pris le temps d’un entretien téléphonique pour me dire que si je n’ai pas fait école d’ingé, c’est mort. Super ! Merci des encouragements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5336de8c-5bff-4242-a5e8-1ae34cc7e8f0",
