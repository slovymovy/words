        "fr-extract.jsonl": [
            {
                "entry_id": "b8a75033-2651-3c9a-9c8a-c1147412c3e1",
                "word": "bitte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0c821591-6908-48ed-b62c-0e46ced86bf1",
                        "entry_id": "b8a75033-2651-3c9a-9c8a-c1147412c3e1",
                        "tags": [
                            "plural"
                        ],
                        "form": "bittes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fe5d872-deda-3a0d-a304-c79da39befb9",
                        "entry_id": "b8a75033-2651-3c9a-9c8a-c1147412c3e1",
                        "glosses": [
                            "Pièce verticale, de section ronde ou carrée, que l’on trouve sur le quai d’un port et que l’on utilise pour amarrer les bateaux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ea4488eb-e130-496d-b49f-cde649f6bffd",
                                "sense_id": "7fe5d872-deda-3a0d-a304-c79da39befb9",
                                "text": "Assise sur une bitte\n D’amarrage, elle pleure\nSon homme qui la quitte,\n La mer c’est son malheur."
                            },
                            {
                                "example_id": "e7f3ee9e-a2b4-49e5-8f34-cfc7e19ccc78",
                                "sense_id": "7fe5d872-deda-3a0d-a304-c79da39befb9",
                                "text": "Je suis encore restée quelque temps à regarder les ondulations du canal Saint-George, la ligne granitique des quais, la tension des cordages, la rigidité des bittes – un des premiers mots français dont Monsieur Presle m’ait appris le sens à cause de ses origines scandinaves : « biti, poutre transversale de navire »."
                            },
                            {
                                "example_id": "80aab79a-d66c-455a-bd7b-704cf08341bc",
                                "sense_id": "7fe5d872-deda-3a0d-a304-c79da39befb9",
                                "text": "La bitte d’amarrage est alors enfoncée dans le béton frais de manière à laisser environ 300 mm de tube exposé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ea6e252-755d-34b6-ab12-9708dec9449a",
                        "entry_id": "b8a75033-2651-3c9a-9c8a-c1147412c3e1",
                        "glosses": [
                            "Variante orthographique de bite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5d5eaf-bbbd-40f0-b95c-b930a7c1e5a8",
                                "sense_id": "0ea6e252-755d-34b6-ab12-9708dec9449a",
                                "text": "Évidemment, on pouvait être sûr qu’elle avait vu plus d’une bitte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c590f7f-7c4c-4793-9a38-65dd7748afc4",
                        "source_entry_id": "b8a75033-2651-3c9a-9c8a-c1147412c3e1",
                        "source_sense_description": "Pièce servant à amarrer les bateaux",
                        "target_lang_word": "Poller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                        "entry_id": "af45ea08-8168-3705-96d1-fa682a433984",
                                        "glosses": [
                                            "kurzer Pfahl zum Festmachen eines Schiffes"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21076fc8-096d-4d6d-a419-be9e99d76da4",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "Der Seemann befestigt das Tauwerk am Poller."
                                            },
                                            {
                                                "example_id": "b96b9351-43c8-4087-b82d-db5eec8a09bc",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "„Er zieht und zerrt, um das jetzt straffere Seil an einem Poller festzumachen.“"
                                            },
                                            {
                                                "example_id": "dfaf6884-75c8-4d7f-adbe-a26098f9a3c4",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "„Um den Nachtclub zu erreichen, mußte sie über dicke, an den Pollern befestigte Taue steigen, an denen sich Kleid un Haare verfingen.“"
                                            },
                                            {
                                                "example_id": "44c480ee-2da4-4e7b-8185-9d54edd84146",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "„Er trat mit dem Tau aufs Dock und warf es über einen Poller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21dddd83-92b9-3c9d-b83f-dc1b23d289fc",
                                        "entry_id": "af45ea08-8168-3705-96d1-fa682a433984",
                                        "glosses": [
                                            "kleiner Pfeiler mit dem Zweck, einen Bereich für den Verkehr zu sperren"
                                        ],
                                        "tags": [
                                            "Straßenverkehr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba49fabd-30ea-4460-8c80-03afa8cb7838",
                                                "sense_id": "21dddd83-92b9-3c9d-b83f-dc1b23d289fc",
                                                "text": "Der Fahrer übersah den Poller beim Ausparken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
