                                "target_senses": [
                                    {
                                        "sense_id": "e74778b6-c545-3d76-b9e0-915ad670d5b3",
                                        "entry_id": "c9b9c21d-3416-3f8e-8341-cb9d2902ebbc",
                                        "glosses": [
                                            "etwas, das an etwas anderem anhängt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac9b7eca-6b3f-4fb2-9546-e5698d76c801",
                                                "sense_id": "e74778b6-c545-3d76-b9e0-915ad670d5b3",
                                                "text": "„Dann folgen noch 19 Gegenstände, die seit 1832 geopfert wurden und ebenfalls beim Muttergottesbild aufgehängt waren. Goldene und silberne Anhängsel, Kreuze, Ketten, Münzen, Herzen, Ohrringe oder Figuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45401ae8-d76e-34bc-bfd6-e89854c5c7fa",
                                        "entry_id": "c9b9c21d-3416-3f8e-8341-cb9d2902ebbc",
                                        "glosses": [
                                            "weniger wichtige Begleiterscheinung/Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57c0ef5-153b-4ee5-8005-7876452f6c8f",
                                                "sense_id": "45401ae8-d76e-34bc-bfd6-e89854c5c7fa",
                                                "text": "„Nach dem Kalkül der anderen Fürsten soll er allerdings wohl nicht mehr sein als ein Anhängsel der Kaiserin, kontrolliert vom Rat der Minister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77709e1f-3d98-4f70-9dd5-8e34919fe302",
                        "source_entry_id": "ee546391-615b-313b-a888-d64e6a6a0144",
                        "source_sense_description": "appendage added to something else",
                        "target_lang_word": "Anhang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anhang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f63bb307-c770-3d9f-be7d-e7220eb8223d",
                                        "entry_id": "11830ded-4ae0-3588-97aa-e782adce6701",
                                        "glosses": [
                                            "zusätzlich Beiliegendes, Beigefügtes, etwas daneben übermitteltes, das Weitere, Zusätzliches, das daneben Bestehende oder Vorhandene; auch: (Schriftwesen:) hinten angefügter Abschnitt, einer E-Mail beigefügte Datei, (Wirtschaft:) erläuternde, ergänzende Dokumente des Jahresabschlusses eines Unternehmens(Jurisprudenz:) spezifische Ergänzung eines Gesetzestextes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32bba9f-5acc-4365-9aa9-3844d91a82e4",
                                                "sense_id": "f63bb307-c770-3d9f-be7d-e7220eb8223d",
                                                "text": "Die Mail hatte einen längeren Anhang."
                                            },
                                            {
                                                "example_id": "b9aaa4c1-52db-494c-8de2-632bbe411a76",
                                                "sense_id": "f63bb307-c770-3d9f-be7d-e7220eb8223d",
                                                "text": "Im Anhang steht das Namensregister."
                                            },
                                            {
                                                "example_id": "7dca0881-1fb9-4256-9d11-c11b26887041",
                                                "sense_id": "f63bb307-c770-3d9f-be7d-e7220eb8223d",
                                                "text": "„Die gesetzlichen Vertreter einer Kapitalgesellschaft haben den Jahresabschluß (§ 242) um einen Anhang zu erweitern, der mit der Bilanz und der Gewinn- und Verlustrechnung eine Einheit bildet, sowie einen Lagebericht aufzustellen.“"
                                            },
                                            {
                                                "example_id": "468f715d-ebd4-4d7b-8fc0-15c5c0d92a68",
                                                "sense_id": "f63bb307-c770-3d9f-be7d-e7220eb8223d",
                                                "text": "„Dieses Gesetz gilt für die Emission der in Anhang 1 zu diesem Gesetz genannten Treibhausgase durch die dort genannten Tätigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "130c4e98-0178-3c5a-8468-6de03bfc347c",
                                        "entry_id": "11830ded-4ae0-3588-97aa-e782adce6701",
                                        "glosses": [
                                            "Personen, die ein privates oder politisches Umfeld bilden, Freundeskreis, Gruppe von Anhängern"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f83c52-dcff-47e0-b5d9-ae5c728e5091",
                                                "sense_id": "130c4e98-0178-3c5a-8468-6de03bfc347c",
                                                "text": "Sie erschienen mit ihrem ganzen Anhang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71710c8f-3f1c-4f16-a65f-1034e4d3bf4b",
                        "source_entry_id": "ee546391-615b-313b-a888-d64e6a6a0144",
                        "source_sense_description": "equipment for some specific task",
                        "target_lang_word": "Rüstzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rüstzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                        "entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                                        "glosses": [
                                            "Kenntnisse oder Fertigkeiten, die man für eine Arbeit braucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b172a6fc-2104-438c-85fe-fd656b241e5a",
                                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                                "text": "Das Rüstzeug für ein erfolgreiches Studium erlangen."
                                            },
                                            {
                                                "example_id": "fd1f96d0-d53b-48a2-b567-eeabb47bed3c",
                                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                                "text": "„Das Rüstzeug für seine verfassungsrechtlichen Konzepte holte er sich beim Jurastudium in Wien.“"
                                            },
                                            {
                                                "example_id": "d4088359-89b1-4dc8-8cc0-91a47e8b1a1d",
                                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                                "text": "„Die ernüchtende Besichtigung des Fundaments der Wissenschaft kommt erst, wenn wir das notwendige Rüstzeug und den erforderlichen Mut beisammen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                                        "entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                                        "glosses": [
                                            "Werkzeuge, die man für eine Arbeit braucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7dcd05d-394f-4500-9fc3-ad4f38b8c50a",
                                                "sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                                                "text": "Er hat nicht das richtige Rüstzeug für die auszuführenden Arbeiten dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29169dcd-65ad-4433-927f-1fa081693337",
