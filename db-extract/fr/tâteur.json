                    {
                        "sense_id": "ae11739f-bd54-30f3-9dd7-a2f208c41176",
                        "entry_id": "476b0d3e-8989-3588-a892-2b88c71791c7",
                        "glosses": [
                            "Peloteur, celui qui aime à toucher les fesses des femmes, le cul des vaches (voir exemple)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db1ede0f-fa08-425d-bc74-5d985501a29a",
                                "sense_id": "ae11739f-bd54-30f3-9dd7-a2f208c41176",
                                "text": "Jacques Chirac fut le dernier président gaulois. Un avatar de Vercingétorix, de surcroît grand tâteur de culs de vache, qui aimait l’odeur du foin coupé, de l’herbe mouillée."
                            }
                        ]
                    },
                    {
                        "sense_id": "af1f6cb6-6168-32d8-a9f8-30d22d32e7c5",
                        "entry_id": "476b0d3e-8989-3588-a892-2b88c71791c7",
                        "glosses": [
                            "Expérimentateur."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "43cda83a-4c28-32f6-ba8d-8d756bb3b1c5",
                        "entry_id": "476b0d3e-8989-3588-a892-2b88c71791c7",
                        "glosses": [
                            "Gouteur, celui qui goûte quelque chose pour l’apprécier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ca472e-19bb-458b-ab6e-690c4402b1f9",
                                "sense_id": "43cda83a-4c28-32f6-ba8d-8d756bb3b1c5",
                                "text": "Mon père […] homme d’esprit, gourmet, chasseur, tâteur de vins et connaisseur de crus continuait une longue tradition de robe, d’honneur et de bonne chère."
                            }
                        ]
                    },
                    {
                        "sense_id": "97d1824a-1647-3cee-827e-c5928283694c",
                        "entry_id": "476b0d3e-8989-3588-a892-2b88c71791c7",
                        "glosses": [
                            "Palpeur, dispositif destiné à vérifier avec un contact tactile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0421b19f-e09a-4a4d-85e3-f6f18c3d9b4c",
                                "sense_id": "97d1824a-1647-3cee-827e-c5928283694c",
                                "text": "Tâteur de trame",
                                "translation": "Dans un métier à tisser, dispositif destiné à apprécier à chaque passage de la navette la quantité de trame restant sur la canette ou à indiquer, sur un métier sans navette, la présence ou l’absence de trame et l’arrêtant en cas d’absence."
                            },
                            {
                                "example_id": "4e31e680-a633-46b5-97bf-ae063d5a8491",
                                "sense_id": "97d1824a-1647-3cee-827e-c5928283694c",
                                "text": "Tâteur de niveau",
                                "translation": "Dispositif destiné à mesurer le niveau d’un produit afin d’éviter tout débordement au cours du remplissage d’un contenant."
                            },
                            {
                                "example_id": "9504cc32-1d79-423d-a31e-904f7b0b2b37",
                                "sense_id": "97d1824a-1647-3cee-827e-c5928283694c",
                                "text": "Tâteur de lisières",
                                "translation": "Organe palpeur servant à détecter la position des lisières de l’étoffe."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fa691f9-ec38-3aa2-b0ce-d578e915e7ad",
                        "entry_id": "476b0d3e-8989-3588-a892-2b88c71791c7",
                        "glosses": [
                            "Organe de contrôle des machines à planter (pommes de terre, etc.) et des décolleuses (de betteraves, etc.)."
