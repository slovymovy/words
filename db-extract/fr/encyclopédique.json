        "fr-extract.jsonl": [
            {
                "entry_id": "92729d00-8554-3d8b-9482-efbefb344131",
                "word": "encyclopédique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b88bd773-9fa6-4806-9919-ed0c6fb0defc",
                        "entry_id": "92729d00-8554-3d8b-9482-efbefb344131",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "encyclopédiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57c6d0e5-ea80-320a-8b53-3d9cacb66189",
                        "entry_id": "92729d00-8554-3d8b-9482-efbefb344131",
                        "glosses": [
                            "Qui embrasse toutes les connaissances humaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd25071-689e-429c-89dd-968a1cb09545",
                                "sense_id": "57c6d0e5-ea80-320a-8b53-3d9cacb66189",
                                "text": "Les ouvrages encyclopédiques appartiennent à deux périodes de la vie des peuples, aux époques primitives et aux époques très avancées."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e3df810-f702-39d4-9525-713ab38d7afa",
                        "entry_id": "92729d00-8554-3d8b-9482-efbefb344131",
                        "glosses": [
                            "Qui possède ou qui réunit des connaissances de tout genre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b0eb4402-5858-42c7-abeb-1de92cd63640",
                                "sense_id": "7e3df810-f702-39d4-9525-713ab38d7afa",
                                "text": "Sur deux pages, la spécialiste internationale du jupon nous éblouit de son savoir encyclopédique et de son sabir savant."
                            },
                            {
                                "example_id": "682962e0-b881-4478-b54b-00ceb67bda44",
                                "sense_id": "7e3df810-f702-39d4-9525-713ab38d7afa",
                                "text": "Façon d'être, mode de vie, philosophie du geek ou de la geekette, qui implique une dévotion quasi fanatique aux nouvelles technologies, et optionnellement une addiction aux meuporgs et une connaissance encyclopédique de tous les personnages secondaires de Star Wars ou du Seigneur des anneaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6ecb9bc-f756-45e4-a89c-277e2d5c0e66",
                        "source_entry_id": "92729d00-8554-3d8b-9482-efbefb344131",
                        "target_lang_word": "encyclopedic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encyclopedic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "464443e7-2dfc-3bf6-9eea-433014d95436",
                                        "entry_id": "0ec7c62e-658f-37d0-90b6-2c3eb492c888",
                                        "glosses": [
                                            "Of or relating to the characteristics of an encyclopedia; concerning all subjects, having comprehensive information or knowledge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0447a07c-0fb8-3cac-908b-4c919cac866d",
                                        "entry_id": "0ec7c62e-658f-37d0-90b6-2c3eb492c888",
                                        "glosses": [
                                            "Relating to or containing descriptive information rather than only linguistic or lexical information; about facts and concepts, and not only a word or term; including proper names, biographical and geographical information and illustrations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd497ea0-4fb8-4709-8013-9475a5799fa1",
                                                "sense_id": "0447a07c-0fb8-3cac-908b-4c919cac866d",
                                                "text": "[p 151] Although separate encyclopedic sections have nothing to do with the dictionary proper, there are no compelling logical reasons for condemning them.\n[p 212] Terms derived from names fall into three categories. Some, like Chomskyan, refer to a person and the work done by that person, or to a place or a person from that place (Virginian, Londoner), and should be defined only in relation to the person or place. They are essentially encyclopedic entries and, if the dictionary contains an entry for the person or place in question, could well be run on without a separate definition.\n[p 359] The difficulty of distinguishing between lexical units and items in a nomenclature is especially nettlesome in specialized dictionaries, which are by their nature more encyclopedic than general dictionaries."
                                            },
                                            {
                                                "example_id": "f072a7e6-db16-484f-8670-9edbe44c8cb5",
                                                "sense_id": "0447a07c-0fb8-3cac-908b-4c919cac866d",
                                                "text": "Thus there are 3751 lexical items covered in total. Taking into account polysemy, there are 4315 separate senses. Of these, 1021 terms are proper nouns. Thus 23.7% of the lexis covered consists of encyclopaedic material."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
