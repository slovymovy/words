                                                "example_id": "29daab67-8bb4-4f51-adf2-8fa4338fabea",
                                                "sense_id": "0d6dc8ea-7229-309d-98d6-3453efd458dd",
                                                "text": "On parle de monopsone sur un marché lorsqu'un seul demandeur se trouve face à un grand nombre d'offreurs."
                                            }
