                    "frequency": "Middle",
                    "semantic_group_id": "ausrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das schlechte Wetter diente der gesamten Mannschaft nur als billiges <w>Alibi</w> für die Niederlage."
                        },
                        {
