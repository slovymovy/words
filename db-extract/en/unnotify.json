                        "entry_id": "269e868b-99ff-38e0-ac07-6cd49f732eda",
                        "glosses": [
                            "To notify (a person) that a prior notification should now be disregarded."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "356f4675-1746-4b77-950f-6028a3d2e0c9",
                                "sense_id": "341d4cdb-8312-3aa3-9954-0a0417ed237d",
                                "text": "\"Well, you unnotify the railroad,\" Mugivan stormed."
                            }
                        ]
                    }
