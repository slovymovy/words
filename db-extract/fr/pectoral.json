            {
                "entry_id": "03722564-587f-3b09-b0b4-a990edbd1396",
                "word": "pectoral",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8f0b715d-3045-4e39-a5e7-85600291f839",
                        "entry_id": "03722564-587f-3b09-b0b4-a990edbd1396",
                        "tags": [
                            "plural"
                        ],
                        "form": "pectoraux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9068adaf-69ea-3d71-97c7-d6413f41eb5e",
                        "entry_id": "03722564-587f-3b09-b0b4-a990edbd1396",
                        "glosses": [
                            "Ornement garni de pierres précieuses que le grand-prêtre des juifs portait sur la poitrine. Bijou similaire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "dacc06ce-8e48-4290-bbc5-8ef0cf6ec90d",
                                "sense_id": "9068adaf-69ea-3d71-97c7-d6413f41eb5e",
                                "text": "[…] les petits vitraux en losange avaient pris la transparence profonde, l’infrangible dureté de saphirs qui eussent été juxtaposés sur quelque immense pectoral."
                            },
                            {
                                "example_id": "911ad811-5731-4419-bdb9-e7c119b263d4",
                                "sense_id": "9068adaf-69ea-3d71-97c7-d6413f41eb5e",
                                "text": "Elle portait un diadème de cauris dans ses cheveux et un collier prolongé d’un pectoral qui irriguait sa poitrine d’une pluie de perles."
                            }
                        ]
                    },
                    {
                        "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                        "entry_id": "03722564-587f-3b09-b0b4-a990edbd1396",
                        "glosses": [
                            "Chacun des muscles de la région du thorax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f865ee-cc6b-4678-b43e-b5582d5c7b78",
                                "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                "text": "On y voyait de vastes défilés d’hommes à peu près nus, aux pectoraux bulbeux et le prince égyptien Narkiss, beau garçon vêtu seulement de poudre d’or et d’un cache-sexe."
                            },
                            {
                                "example_id": "53d0b83e-4c79-4182-9e4b-b96b365028dd",
                                "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                "text": "Suivirent des frimeuses téléphonant, des cadres sportifs, des exhibeurs de pectoraux, des enfants aux sourcils froncés d’inquiétude que leurs pères tenaient par la main […]"
                            },
                            {
                                "example_id": "5b784cd5-77f6-4b35-861d-4cd04a7f92c8",
                                "sense_id": "97b3fded-1deb-3ce1-80ce-49904675aecb",
                                "text": "Le grand pectoral, le petit pectoral."
                            }
                        ]
                    }
                ],
