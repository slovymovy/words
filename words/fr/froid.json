{
    "word_family": [
        "froidement",
        "froideur",
        "froidure",
        "refroidir",
        "refroidissement",
        "refroidisseur"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d269a4c1-d7ac-3633-bdc8-a9b3de36b6fb",
                    "sense_definition": "Dont la température est basse ou qui produit une sensation de fraîcheur intense.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, l'eau de la rivière devient particulièrement <w>froide</w> et dangereuse."
                        },
                        {
                            "text": "Un vent <w>froid</w> souffle sur la ville depuis ce matin."
                        }
                    ],
                    "antonyms": [
                        "chaud"
                    ],
                    "common_phrases": [
                        "eau froide",
                        "vent froid",
                        "douche froide"
                    ]
                },
                {
                    "sense_id": "636a3fe6-a42b-3273-8dcc-ae8e97dfca8a",
                    "sense_definition": "Qui a perdu sa chaleur et n'est plus à la température souhaitée pour être consommé.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêche-toi de manger ta soupe avant qu'elle ne soit <w>froide</w>."
                        },
                        {
                            "text": "J'ai oublié ma tasse sur la table et mon thé est maintenant tout <w>froid</w>."
                        }
                    ],
                    "antonyms": [
                        "chaud"
                    ],
                    "common_phrases": [
                        "café froid",
                        "plat froid"
                    ]
                },
                {
                    "sense_id": "e9d6a532-3a5a-36be-b89a-f0e59c6b525e",
                    "sense_definition": "Qui se consomme sans être réchauffé, en parlant d'un aliment ou d'un repas.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les organisateurs ont préparé un buffet <w>froid</w> pour accueillir les invités."
                        },
                        {
                            "text": "En été, nous préférons manger une salade <w>froide</w> pour le déjeuner."
                        }
                    ],
                    "antonyms": [
                        "chaud"
                    ],
                    "common_phrases": [
                        "buffet froid"
                    ]
                },
                {
                    "sense_id": "a3d8d478-113c-3e81-bee8-8a36b3d6ae08",
                    "sense_definition": "Qui reste calme, insensible ou indifférent en toutes circonstances.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le détective garde un tempérament <w>froid</w> même face aux situations les plus stressantes."
                        },
                        {
                            "text": "Malgré l'annonce inattendue, il est resté totalement <w>froid</w> et impassible."
                        }
                    ],
                    "antonyms": [
                        "chaud"
                    ]
                },
                {
                    "sense_id": "bf72dd7a-2ada-3807-954f-0c89a5469254",
                    "sense_definition": "Qui manque de cordialité ou d'enthousiasme, en parlant d'un accueil, d'un ton ou d'une attitude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La directrice lui a réservé un accueil très <w>froid</w> lors de leur entretien."
                        },
                        {
                            "text": "Il a répondu à ma question d'un ton <w>froid</w> qui m'a surpris."
                        }
                    ],
                    "antonyms": [
                        "chaud"
                    ],
                    "common_phrases": [
                        "accueil froid",
                        "ton froid"
                    ]
                },
                {
                    "sense_id": "e96353fb-f579-3196-b496-7c39e8686bc3",
                    "sense_definition": "Qui appartient à la gamme des teintes évoquant la fraîcheur, comme le bleu ou le vert.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre utilise principalement des couleurs <w>froides</w> pour évoquer l'hiver."
                        },
                        {
                            "text": "Cette pièce paraît plus grande grâce à ses teintes <w>froides</w> sur les murs."
                        }
                    ],
                    "antonyms": [
                        "chaud"
                    ],
                    "common_phrases": [
                        "couleurs froides",
                        "tons froids"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ef1abfd-6cc5-3431-aa78-9a8313e42ef9",
                    "sense_definition": "Basse température de l'atmosphère ou sensation physique causée par une déperdition de chaleur.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'hiver, le grand <w>froid</w> oblige les habitants à bien se couvrir."
                        },
                        {
                            "text": "Elle tremble de <w>froid</w> en attendant le bus sous la neige."
                        }
                    ],
                    "synonyms": [
                        "froidure"
                    ],
                    "antonyms": [
                        "chaleur"
                    ],
                    "common_phrases": [
                        "grand froid",
                        "coup de froid"
                    ]
                },
                {
                    "sense_id": "c74595c6-b8dc-3ba6-8a8d-b1d592d2ce61",
                    "sense_definition": "Malaise ou éloignement passager survenant dans les relations entre des personnes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa remarque maladroite a jeté un <w>froid</w> glacial au milieu de la réunion."
                        },
                        {
                            "text": "Il y a un certain <w>froid</w> entre les deux collègues depuis leur dispute."
                        }
                    ],
                    "synonyms": [
                        "froideur"
                    ],
                    "common_phrases": [
                        "jeter un froid"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "26896bd4-15c5-3484-b8a7-07ad3d273978",
                    "sense_definition": "Sans faire chauffer, à basse température.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce rôti de porc peut se manger <w>froid</w> avec de la moutarde."
                        },
                        {
                            "text": "En plein été, nous préférons servir ce plat de légumes <w>froid</w>."
                        }
                    ],
                    "common_phrases": [
                        "manger froid",
                        "servir froid"
                    ]
                }
            ]
        }
    ]
}