            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d453e8fd-4a29-3945-b4c2-4bcc1f79b458",
                    "sense_definition": "Causing someone to feel angry, hostile, or opposed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hostile_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>antagonizing</w> tone made it difficult for the team to reach a peaceful agreement.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>provocerende</w> toon maakte het voor het team moeilijk om tot een vredig akkoord te komen."
                            }
                        },
                        {
                            "text": "The politician used <w>antagonizing</w> language to provoke his opponents during the heated debate.",
                            "target_lang_translations": {
                                "nl": "De politicus gebruikte <w>vijandige</w> taal om zijn tegenstanders uit te lokken tijdens het verhitte debat."
                            }
                        }
                    ],
                    "synonyms": [
                        "provocative",
                        "irritating",
                        "hostile"
                    ],
                    "antonyms": [
                        "conciliatory",
                        "soothing"
                    ],
                    "common_phrases": [
                        "antagonizing behavior",
                        "antagonizing remarks"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand boos, vijandig of afwijzend maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "provocerend",
                                "target_lang_sense_clarification": "Gedrag dat bedoeld is om een reactie uit te lokken."
                            },
                            {
                                "target_lang_word": "vijandig",
                                "target_lang_sense_clarification": "Gedrag dat een vijandige houding uitstraalt."
                            },
                            {
