                "forms": [],
                "senses": [
                    {
                        "sense_id": "319c2630-677c-39f3-82c4-a5b3af46ca86",
                        "entry_id": "6bd2cd70-c49a-34b8-8c91-d8d19a271936",
                        "glosses": [
                            "The group spoken or written to."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "59798edd-873e-4a61-8ca7-e3e01a528637",
                                "sense_id": "319c2630-677c-39f3-82c4-a5b3af46ca86",
                                "text": "What are yous kids doin?"
                            },
                            {
                                "example_id": "582936fd-caec-4ed5-b9ea-4dab63b90487",
                                "sense_id": "319c2630-677c-39f3-82c4-a5b3af46ca86",
                                "text": "“Heh, yous kids want a game?” “Dunno, suppose so.” “Dar and I versus yous; that's fair.” “Short kicks Ern, we hang on to the ball and let them do the chasing.” “You watch me take the marks Dar; them blokes won't know what hit them.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
