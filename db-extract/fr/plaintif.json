                        "form": "plaintive"
                    },
                    {
                        "form_id": "6ab5c57c-9167-4a95-947c-786f60041ae3",
                        "entry_id": "b1026577-6f4e-3eaa-944d-66c6427e72b0",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "plaintives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f5fcde2-9b09-3e72-b7bc-0aea9a5f9f2a",
                        "entry_id": "b1026577-6f4e-3eaa-944d-66c6427e72b0",
                        "glosses": [
                            "Qui a l’accent de la plainte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f774929-41a0-4b77-9826-5a1304227a2d",
                                "sense_id": "8f5fcde2-9b09-3e72-b7bc-0aea9a5f9f2a",
                                "text": "Et doucement, la chanson plaintive s'envolait dans l'espace illimité."
                            },
                            {
                                "example_id": "b49667f0-8323-42f3-b5a9-2925dce8e14d",
                                "sense_id": "8f5fcde2-9b09-3e72-b7bc-0aea9a5f9f2a",
                                "text": "Semblable au déplorable malade d’Edgar Poë, Durtal entendait avec terreur des frôlements de pas dans les escaliers, des cris plaintifs derrière les portes."
                            },
                            {
                                "example_id": "0bf8197d-41af-4382-8250-8682371d1017",
                                "sense_id": "8f5fcde2-9b09-3e72-b7bc-0aea9a5f9f2a",
                                "text": "On ne voyait pas les tramways. […]. Pourtant les quais où ils roulaient, avec des piaulements plaintifs, n'étaient guère éloignés, car la rue, quelquefois, tremblait à leur passage."
                            }
                        ]
                    },
                    {
                        "sense_id": "6823e089-3e77-3c36-bc65-45ae3fae9611",
                        "entry_id": "b1026577-6f4e-3eaa-944d-66c6427e72b0",
                        "glosses": [
                            "Qui se plaint souvent, à tout propos, qui fatigue les autres par ses plaintes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6f4f0f-edf0-4d05-995b-8504e51ce17c",
                                "sense_id": "6823e089-3e77-3c36-bc65-45ae3fae9611",
                                "text": "Il est toujours chagrin, toujours plaintif."
                            },
                            {
                                "example_id": "c9ae3303-8ef2-44e9-99c3-ad5315e8e4be",
                                "sense_id": "6823e089-3e77-3c36-bc65-45ae3fae9611",
                                "text": "Un vieillard plaintif."
                            }
                        ]
                    },
                    {
                        "sense_id": "64fe499e-0b98-36ad-873a-679641134904",
                        "entry_id": "b1026577-6f4e-3eaa-944d-66c6427e72b0",
                        "glosses": [
                            "Se dit de personnes, d’animaux qui font entendre des plaintes."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "79a799f9-defb-4f5c-a606-39776a1c7291",
                                "sense_id": "64fe499e-0b98-36ad-873a-679641134904",
                                "text": "Mânes plaintifs."
                            },
                            {
                                "example_id": "e1688eaa-4ab9-4bb9-8392-a87a252ffead",
                                "sense_id": "64fe499e-0b98-36ad-873a-679641134904",
                                "text": "Ombres plaintives."
                            },
                            {
                                "example_id": "0fb9b6cc-25d5-4d97-a52e-978b27d908ae",
                                "sense_id": "64fe499e-0b98-36ad-873a-679641134904",
                                "text": "La plaintive tourterelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc481053-c3c3-3c04-bff6-838579e633a8",
                        "entry_id": "b1026577-6f4e-3eaa-944d-66c6427e72b0",
                        "glosses": [
                            "Se dit d’un son émis ressemblant à un gémissement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6b4a3776-f399-4ec4-b421-9bdd8a894c1b",
                                "sense_id": "dc481053-c3c3-3c04-bff6-838579e633a8",
                                "text": "Voici la route en sable doux ; des barques ancrées sur le canal bleu ont un grincement plaintif, qui redemande les vagues hautes et le large horizon."
                            }
                        ]
                    }
                ],
                "translations": [
