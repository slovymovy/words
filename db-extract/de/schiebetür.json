                ],
                "senses": [
                    {
                        "sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                        "entry_id": "d1db9715-3cc7-3498-8171-21d679a3a7be",
                        "glosses": [
                            "Tür, die man zum Öffnen und zum Schließen seitlich schiebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae77bce6-85a4-40e3-98d3-3ba0100a2b05",
                                "sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                                "text": "Im Zug klemmte die Schiebetür."
                            },
                            {
                                "example_id": "9b43fec8-a09a-4bc8-a396-6790859679b9",
                                "sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                                "text": "„In diesem Moment öffnet sich die Schiebetür zu ihrem Schlafzimmer.“"
                            },
                            {
                                "example_id": "6cc5fb2d-fe0b-499e-87a5-f2b1eade4eb6",
                                "sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                                "text": "„Ein Schritt noch, und die elektrische Schiebetür würde sich öffnen.“"
                            },
                            {
                                "example_id": "24f0cb09-a308-4233-a804-a326e45443c9",
                                "sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                                "text": "„Nur einmal schreckte ich auf, als mehrere uniformierte Männer mitten in der Nacht die Tür aufrissen, mit prüfendem Blick schauten, wer alles da war, und dann die Schiebetür wieder zuschoben.“"
                            },
                            {
                                "example_id": "54ed123f-e2e3-4033-b779-3dac526dffe7",
                                "sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                                "text": "„Immer wieder fuhr der Fahrstuhl zur Intensivstation herauf, ich lehnte mich lässig an die Mauer, die Schiebetür öffnete sich und fremde Leute sahen mich fragend an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5956d169-d876-43cc-88a2-95a97e9f7d44",
                        "source_entry_id": "d1db9715-3cc7-3498-8171-21d679a3a7be",
                        "source_sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                        "source_sense_description": "Tür, die man zum Öffnen und zum Schließen seitlich schiebt",
                        "target_lang_word": "sliding door",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sliding door",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70217f51-4b53-378f-832e-564e25197e63",
                                        "entry_id": "61763875-071c-347f-8e5d-8d89c7242250",
                                        "glosses": [
                                            "A door that opens and closes by sliding to the side; sometimes one of a pair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd6cc09-15f6-421b-add5-a0e48d457e4f",
                                                "sense_id": "70217f51-4b53-378f-832e-564e25197e63",
                                                "text": "However, before Zoe could open the first cage, Burt’s van, looking decidedly the worse for wear, came thundering into the warehouse, smashing the huge metal sliding door into the air as it did so"
                                            },
                                            {
                                                "example_id": "856e55c1-1b2c-4579-afe6-020341a4b8d6",
                                                "sense_id": "70217f51-4b53-378f-832e-564e25197e63",
                                                "text": "Thus, the ScotRail plan was to totally refurbish the trailer vehicles, with new sliding doors and a host of other improvements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8199907e-52d4-36bf-b812-d78d71d73887",
                                        "entry_id": "61763875-071c-347f-8e5d-8d89c7242250",
                                        "glosses": [
                                            "Denotes a crucial decision point at which outcomes diverge depending on which of two courses is followed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e4d103-6fd5-41cb-9f9a-a9bc940e7283",
                                                "sense_id": "8199907e-52d4-36bf-b812-d78d71d73887",
                                                "text": "sliding door(s) moment, sliding door(s) decision"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "402b2549-1176-472e-9393-61a01f1b8c30",
                        "source_entry_id": "d1db9715-3cc7-3498-8171-21d679a3a7be",
                        "source_sense_id": "17805a77-90bb-3356-ba71-b1bd5c9c7ffa",
                        "source_sense_description": "Tür, die man zum Öffnen und zum Schließen seitlich schiebt",
                        "target_lang_word": "porte coulissante",
