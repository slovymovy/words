{
    "word_family": [
        "chucker",
        "upchuck"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e90a975-8915-3456-a6f1-a18bfbc14a26",
                    "sense_definition": "To throw something, especially in a careless or relaxed way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>chuck</w> me that pen on the table?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>кинуть</w> мне ту ручку на столе?",
                                "zh": "你能把桌上的那支笔<w>扔</w>给我吗？"
                            }
                        },
                        {
                            "text": "He <w>chucked</w> his bag onto the sofa and sat down.",
                            "target_lang_translations": {
                                "ru": "Он <w>швырнул</w> свою сумку на диван и сел.",
                                "zh": "他把包<w>扔</w>在沙发上，然后坐了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toss",
                        "fling",
                        "hurl",
                        "pitch",
                        "cast"
                    ],
                    "antonyms": [
                        "catch",
                        "hold"
                    ],
                    "common_phrases": [
                        "chuck it over",
                        "chuck a ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать что-то, особенно небрежно или расслабленно.",
                        "zh": "指随意或轻松地投掷某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "с силой или злостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "随意地投掷"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "投掷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05a1b96b-1e19-3917-bc2f-bc33eac1e49e",
                    "sense_definition": "To get rid of something because it is no longer wanted or needed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "discarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>chuck</w> all my old clothes and buy new ones.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>выкинуть</w> всю свою старую одежду и купить новую.",
                                "zh": "我决定把旧衣服都<w>扔掉</w>，买些新的。"
                            }
                        },
                        {
                            "text": "Don't <w>chuck</w> that box away; we might need it later.",
                            "target_lang_translations": {
                                "ru": "Не <w>выбрасывай</w> ту коробку, она может нам позже пригодиться.",
                                "zh": "别把那个盒子<w>扔掉</w>，我们以后可能用得着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discard",
                        "dump",
                        "ditch",
                        "throw away",
                        "scrap",
                        "bin"
                    ],
                    "antonyms": [
                        "keep",
                        "retain"
                    ],
                    "common_phrases": [
                        "chuck out",
                        "chuck away"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавляться от чего-то, потому что это больше не нужно.",
                        "zh": "指丢弃不再需要或不想要的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкидывать",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "нейтральное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔掉",
                                "target_lang_sense_clarification": "丢弃"
                            },
                            {
                                "target_lang_word": "丢弃",
                                "target_lang_sense_clarification": "抛弃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3030293b-cf3d-354d-b1f5-2aa90f73a2f3",
                    "sense_definition": "To stop doing a job or an activity; to give up.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got bored with the project and <w>chucked</w> it after a week.",
                            "target_lang_translations": {
                                "ru": "Ему наскучил проект, и он <w>бросил</w> его через неделю.",
                                "zh": "他对那个项目感到厌烦，一周后就<w>放弃</w>了。"
                            }
                        },
                        {
                            "text": "I am going to <w>chuck</w> my job and travel the world.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь <w>бросить</w> работу и путешествовать по миру.",
                                "zh": "我打算<w>辞掉</w>工作去环游世界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quit",
                        "give up",
                        "pack in"
                    ],
                    "antonyms": [
                        "continue",
                        "persist"
                    ],
                    "common_phrases": [
                        "chuck it in"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращать работу или занятие; сдаваться.",
                        "zh": "指放弃某项工作或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "прекращать делать что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "停止做某事"
                            },
                            {
                                "target_lang_word": "辞掉",
                                "target_lang_sense_clarification": "放弃工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd6aca86-5eb3-3300-aaa5-30d5b1f72da9",
                    "sense_definition": "To end a romantic relationship with someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>chucked</w> him because he never wanted to go out.",
                            "target_lang_translations": {
                                "ru": "Она <w>бросила</w> его, потому что он никогда не хотел никуда ходить.",
                                "zh": "她把他<w>甩</w>了，因为他从不想出门。"
                            }
                        },
                        {
                            "text": "I can't believe he <w>chucked</w> his girlfriend for someone else.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что он <w>бросил</w> свою девушку ради другой.",
                                "zh": "真不敢相信他为了别人把女朋友<w>甩</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dump",
                        "ditch",
                        "break up with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрывать романтические отношения с кем-то.",
                        "zh": "指结束一段恋爱关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "уходить от кого-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甩",
                                "target_lang_sense_clarification": "口语，抛弃恋人"
                            },
                            {
                                "target_lang_word": "分手",
                                "target_lang_sense_clarification": "结束关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd51e27b-e4a9-3638-970e-2594b33607a4",
                    "sense_definition": "To vomit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vomiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt sick and <w>chucked</w> up his dinner.",
                            "target_lang_translations": {
                                "ru": "Его замутило, и <w>вырвало</w> ужином.",
                                "zh": "他感到恶心，把晚饭都<w>吐</w>了。"
                            }
                        },
                        {
                            "text": "The smell was so bad it made me want to <w>chuck</w>.",
                            "target_lang_translations": {
                                "ru": "Запах был таким ужасным, что меня чуть не <w>вырвало</w>.",
                                "zh": "那味道太难闻了，让我直想<w>呕吐</w>。"
                            }
                        }
                    ],
