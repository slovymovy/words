        "nl-extract.jsonl": [
            {
                "entry_id": "f8bb4b49-2d6d-3af2-b54a-d72fd6f74e8b",
                "word": "kippenvel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d860ff6b-fb5a-4583-8c94-2b2eae18ec50",
                        "entry_id": "f8bb4b49-2d6d-3af2-b54a-d72fd6f74e8b",
                        "tags": [],
                        "form": "kippevel",
                        "note": "officiële spelling tot 1996"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78149f98-3eff-3119-8888-f9930fab22cb",
                        "entry_id": "f8bb4b49-2d6d-3af2-b54a-d72fd6f74e8b",
                        "glosses": [
                            "het verschijnsel waarbij als gevolg van kou, afgrijzen of schrik de huid er uit ziet als die van een geplukte kip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9ddd6b-3f85-4156-8783-1a781d54cc80",
                                "sense_id": "78149f98-3eff-3119-8888-f9930fab22cb",
                                "text": "Heb je nu al kippenvel?"
                            },
                            {
                                "example_id": "8d01de71-3092-434b-9cf8-750ed1ee2bd7",
                                "sense_id": "78149f98-3eff-3119-8888-f9930fab22cb",
                                "text": "Het was hoogzomer en ik liep tot mijn oksels door het hoge gras, strekte mijn armen uit en liet mijn vingers over de grassprieten glijden. Het veroorzaakte rillingen over mijn rug en kippenvel op mijn armen."
                            },
                            {
                                "example_id": "718388c1-9da5-488b-b32b-88f70df3584d",
                                "sense_id": "78149f98-3eff-3119-8888-f9930fab22cb",
                                "text": "Toen ik me vooroverboog om mijn ene natte kous uit te trekken, werd de stilte in de ruimte verbroken door een diepe zucht, alsof er een steen in een vijver werd geworpen. Ik bevroor in mijn bewegingen en kreeg kippenvel op mijn armen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d9c08ec-8e84-3dce-8a11-d3d19f6c9a80",
                        "entry_id": "f8bb4b49-2d6d-3af2-b54a-d72fd6f74e8b",
                        "glosses": [
                            "een dusdanige positieve sensatie dat men kippenvel krijgt (van schoonheid, geluk etc.) en die het leven de moeite waard maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b2c15aa-db91-4178-b878-d4d8fe15c718",
                                "sense_id": "2d9c08ec-8e84-3dce-8a11-d3d19f6c9a80",
                                "text": "Dertig procent van de Nederlanders blijkt wekelijks kippenvel te hebben, en nog eens dertig procent maandelijks"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92e385a4-c7d7-45a4-9afb-975ffc08af68",
                        "source_entry_id": "f8bb4b49-2d6d-3af2-b54a-d72fd6f74e8b",
                        "source_sense_id": "78149f98-3eff-3119-8888-f9930fab22cb",
                        "source_sense_description": "het verschijnsel waarbij als gevolg van kou de huid gaat kleine bubbeltjes vertoont",
                        "target_lang_word": "Gänsehaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gänsehaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                        "entry_id": "f0d10ac7-0c48-35d4-9af4-d7e1330a834a",
                                        "glosses": [
                                            "durch physische (Kälte) oder psychische (Schreck, Furcht, Ergriffenheit) Reize hervorgerufener Hautreflex, bei dem sich die Haare aufstellen und die Haarbälge hervortreten, wodurch die Hautoberfläche grobkörnig wirkt und der einer gerupften Gans ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114ea905-daea-4287-9b39-b27058a7d69b",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "„Die Musik ist in den nächsten Acten voll Originalität, bald anziehend durch Grazie und überraschende Charakteristik, bald eine Gänsehaut hervorrufend durch phantastische Aufgeregtheit und dämonische Gewalt; […].“"
                                            },
                                            {
                                                "example_id": "59a7b63c-40b0-4eb1-a2ad-53054b4d5bab",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "„Und abermals überlief ihn eine Gänsehaut.“"
                                            },
                                            {
                                                "example_id": "cdf903c2-8af4-4d26-a3d0-c7e8bb9b1044",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "„Sein nackter, eingefallener Oberkörper war von einer Gänsehaut überzogen; er rieb fortwährend seine Arme, seine Brust, seinen Bauch.“"
                                            },
                                            {
                                                "example_id": "d6c52dd3-01dc-4257-9c74-fa6a4c5a7af4",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "„Sie wußte das gibt mir eine Gänsehaut.“"
                                            },
                                            {
                                                "example_id": "f3378cd8-61f7-4cae-a7cd-ad5b2f28da25",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "„Wann bekommst du eine Gänsehaut?“"
                                            },
                                            {
                                                "example_id": "415aba31-0946-452d-8a9b-de9557d9ae05",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "Der Neurowissenschaftler Eckart Altenmüller erklärt, warum wir beim Musikhören manchmal eine Gänsehaut bekommen […]"
                                            },
                                            {
                                                "example_id": "5285a5c1-edac-4747-b521-a8b28fade2fa",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "[Der Filmkomponisten Andreas Weidinger] hat sich auf Gruselmusik spezialisiert. Seine Kompositionen sollen Menschen erschrecken, ihnen Gänsehaut verschaffen und für feuchte Hände sorgen."
                                            },
                                            {
                                                "example_id": "31e822a2-6d6e-499e-91a5-0b8a151598bc",
                                                "sense_id": "009a43e9-af22-37c3-b2d4-98d2718729ed",
                                                "text": "„Ida bekam Gänsehaut und kreuzte die Arme vor der Brust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "997bb973-5d72-38f7-8fa2-da090583052d",
                                        "entry_id": "f0d10ac7-0c48-35d4-9af4-d7e1330a834a",
                                        "glosses": [
                                            "Kleid eines jungen Mädchens, das eng anliegt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
