{
    "word_family": [
        "swarming",
        "swarmer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d1a4d3a-a05c-3db8-ab20-08ca649be38a",
                    "sense_definition": "A large number of insects, especially when in motion or migrating to a new colony.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_entities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A huge <w>swarm</w> of bees settled on the branch of the old apple tree.",
                            "target_lang_translations": {
                                "ru": "Огромный <w>рой</w> пчел осел на ветке старой яблони."
                            }
                        },
                        {
                            "text": "The farmer watched as a <w>swarm</w> of locusts descended upon the wheat field.",
                            "target_lang_translations": {
                                "ru": "Фермер наблюдал, как <w>полчище</w> саранчи опустилось на пшеничное поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloud",
                        "hive",
                        "horde"
                    ],
                    "common_phrases": [
                        "swarm of bees",
                        "swarm of locusts",
                        "swarm of insects"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество насекомых, особенно в движении или при миграции в новую колонию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рой",
                                "target_lang_sense_clarification": "о насекомых"
                            },
                            {
                                "target_lang_word": "полчище",
                                "target_lang_sense_clarification": "о вредителях, например, саранче"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "461ad9f9-c692-3c78-ace1-133799d3aec6",
                    "sense_definition": "A large mass of people, animals, or objects moving in a crowded or confused way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_entities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>swarm</w> of reporters waited outside the courthouse for the celebrity to appear.",
                            "target_lang_translations": {
                                "ru": "<w>Толпа</w> репортеров ждала у здания суда появления знаменитости."
                            }
                        },
                        {
                            "text": "The telescope captured a <w>swarm</w> of meteorites passing through the solar system.",
                            "target_lang_translations": {
                                "ru": "Телескоп зафиксировал <w>скопление</w> метеоритов, проходящих через Солнечную систему."
                            }
                        }
                    ],
                    "synonyms": [
                        "throng",
                        "multitude",
                        "crowd"
                    ],
                    "common_phrases": [
                        "swarm of people",
                        "swarm of tourists",
                        "swarm of meteorites"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая масса людей, животных или объектов, движущихся скученно или беспорядочно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпа",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "о животных или птицах"
                            },
                            {
                                "target_lang_word": "рой",
                                "target_lang_sense_clarification": "переносное значение о множестве"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "об объектах, например, метеоритах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4e4df2d-3c89-3699-942e-8b7dbfbfe99c",
                    "sense_definition": "A series of small earthquakes occurring in a specific area over a short period of time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geological_events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists are monitoring the recent earthquake <w>swarm</w> near the dormant volcano.",
                            "target_lang_translations": {
                                "ru": "Геологи следят за недавним <w>роем</w> землетрясений вблизи спящего вулкана."
                            }
                        },
                        {
                            "text": "The local residents were worried after several seismic <w>swarms</w> were felt throughout the week.",
                            "target_lang_translations": {
                                "ru": "Местные жители были обеспокоены после того, как в течение недели ощущалось несколько сейсмических <w>роев</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster"
                    ],
                    "common_phrases": [
                        "earthquake swarm",
                        "seismic swarm"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия небольших землетрясений, происходящих в определенном районе в течение короткого периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рой",
                                "target_lang_sense_clarification": "сейсмический или землетрясений"
                            },
                            {
                                "target_lang_word": "серия",
                                "target_lang_sense_clarification": "толчков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee2b1ea-609e-341e-8aef-9e78987506fd",
                    "sense_definition": "A group of computers or nodes sharing the same file in a BitTorrent network.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The download speed increased significantly as more peers joined the <w>swarm</w>.",
                            "target_lang_translations": {
                                "ru": "Скорость загрузки значительно выросла, когда к <w>рою</w> присоединилось больше пиров."
                            }
                        },
                        {
                            "text": "A healthy <w>swarm</w> ensures that the file remains available for all users on the network.",
                            "target_lang_translations": {
                                "ru": "Здоровый <w>сворм</w> гарантирует, что файл останется доступным для всех пользователей сети."
                            }
                        }
                    ],
                    "common_phrases": [
                        "torrent swarm",
                        "peer swarm"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа компьютеров или узлов, обменивающихся одним и тем же файлом в сети BitTorrent."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рой",
                                "target_lang_sense_clarification": "в торрент-сетях"
                            },
                            {
                                "target_lang_word": "сворм",
                                "target_lang_sense_clarification": "технический жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6a998d8-653a-3612-9b38-3a433512a3f5",
                    "sense_definition": "To move in a large, dense, and often disorganized group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fans began to <w>swarm</w> around the stage as soon as the concert ended.",
                            "target_lang_translations": {
                                "ru": "Фанаты начали <w>толпиться</w> вокруг сцены, как только закончился концерт."
                            }
                        },
                        {
                            "text": "The children <w>swarmed</w> into the playground the moment the bell rang.",
                            "target_lang_translations": {
                                "ru": "Дети <w>высыпали</w> на игровую площадку в тот момент, когда прозвенел звонок."
                            }
                        }
                    ],
                    "synonyms": [
                        "throng",
                        "flock",
                        "crowd"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "common_phrases": [
                        "swarm around",
                        "swarm into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться большой, плотной и часто неорганизованной группой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпиться",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "роиться",
                                "target_lang_sense_clarification": "двигаться массой"
                            },
                            {
                                "target_lang_word": "хлынуть",
                                "target_lang_sense_clarification": "массово устремиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81f6f3c0-60ba-36ae-a2ed-fef8adf13728",
                    "sense_definition": "To be filled or crowded with a great number of moving things or people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the summer months, the city's main square is <w>swarming</w> with tourists.",
                            "target_lang_translations": {
                                "ru": "В летние месяцы главная площадь города <w>кишит</w> туристами."
                            }
                        },
                        {
                            "text": "The kitchen was <w>swarming</w> with ants after the honey jar was left open.",
                            "target_lang_translations": {
                                "ru": "Кухня <w>кишела</w> муравьями после того, как банку с медом оставили открытой."
                            }
                        }
                    ],
                    "synonyms": [
                        "teem",
                        "abound",
                        "crawl"
                    ],
                    "common_phrases": [
                        "swarming with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть наполненным или переполненным большим количеством движущихся существ или людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишеть",
                                "target_lang_sense_clarification": "быть наполненным кем-либо"
                            },
                            {
                                "target_lang_word": "кишмя кишеть",
                                "target_lang_sense_clarification": "усиленное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e16c827-fcec-3ff3-a122-5ea2bc3cd478",
                    "sense_definition": "To climb a tree or pole by gripping it with the arms and legs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy managed to <w>swarm</w> up the coconut tree to retrieve the fruit.",
                            "target_lang_translations": {
                                "ru": "Мальчику удалось <w>взобраться</w> на кокосовую пальму, чтобы достать плод."
                            }
                        },
                        {
                            "text": "He watched the sailor <w>swarm</w> up the mast with impressive speed.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как матрос с впечатляющей скоростью <w>карабкается</w> вверх по мачте."
                            }
                        }
                    ],
                    "synonyms": [
                        "shin",
                        "clamber"
                    ],
                    "common_phrases": [
                        "swarm up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взбираться на дерево или столб, обхватывая его руками и ногами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "лезть вверх"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "подниматься с усилием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e2061cd-9901-37cd-9750-7be23b1c3dd3",
                    "sense_definition": "To overwhelm an opponent by attacking in large numbers from all sides.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smaller ships tried to <w>swarm</w> the massive battleship to disable its engines.",
                            "target_lang_translations": {
                                "ru": "Малые корабли пытались <w>облепить</w> массивный линкор, чтобы вывести из строя его двигатели."
                            }
                        },
                        {
                            "text": "The defense was quickly <w>swarmed</w> by the opposing team's fast attackers.",
                            "target_lang_translations": {
                                "ru": "Защита была быстро <w>подавлена</w> быстрыми нападающими команды противника."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm",
                        "besiege",
                        "mob"
                    ],
                    "common_phrases": [
                        "swarm the opponent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавить противника, атакуя большим числом со всех сторон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облепить",
                                "target_lang_sense_clarification": "окружить толпой"
                            },
                            {
                                "target_lang_word": "навалиться",
                                "target_lang_sense_clarification": "атаковать массой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}