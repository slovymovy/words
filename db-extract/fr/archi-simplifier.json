                ],
                "senses": [
                    {
                        "sense_id": "740ae952-fd51-3312-a972-25afb50e13f8",
                        "entry_id": "7c09c987-84a6-3141-9b81-fe179e8d55ed",
                        "glosses": [
                            "Simplifier de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c03b200e-1480-447f-9373-c886d2440351",
                                "sense_id": "740ae952-fd51-3312-a972-25afb50e13f8",
                                "text": "Pour archisimplifier le truc il suffit que le remboursement par l'assurance maladie soit le même pour tous les génériques et le princeps."
                            },
                            {
                                "example_id": "d6f43980-c13c-4260-aa4e-74474fca5e9b",
                                "sense_id": "740ae952-fd51-3312-a972-25afb50e13f8",
                                "text": "Faut pas non plus tout archisimplifier."
                            },
                            {
                                "example_id": "4a4ed7e4-48a9-4455-ba85-934a454afed0",
                                "sense_id": "740ae952-fd51-3312-a972-25afb50e13f8",
                                "text": "Sur les conseils avisés d'une couturière pro, j'ai donc changé de tactique et archisimplifié le problème (petit tuto dès que possible si ça intéresse quelqu'un...) et voilà donc la suite de la tunique aux grains de café et aux petits beurres."
                            }
                        ]
                    }
