                "senses": [
                    {
                        "sense_id": "b12e008b-6f03-3b0d-a372-3374259c5368",
                        "entry_id": "92f05ed6-f1fb-390d-a47c-0861b8e5a504",
                        "glosses": [
                            "To undress."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ed126ae2-b346-4dc3-b6b6-add7d00389f1",
                                "sense_id": "b12e008b-6f03-3b0d-a372-3374259c5368",
                                "text": "With shouts of honor here they gather'd round me, Ungarmented my limbs, and in a net With softest feathers lined, a pleasant couch, They laid and left me."
                            },
                            {
                                "example_id": "9a2cdd45-d2e2-4d72-ade7-bbf4f8843e1b",
                                "sense_id": "b12e008b-6f03-3b0d-a372-3374259c5368",
                                "text": "But this thou canst not do, dear spirit rare: One beauty is of color, form and look, And one thine angel loveliness of soul: Thou canst ungarment neither;"
                            },
                            {
                                "example_id": "d0deab7c-0b9f-4a3b-8dfe-41dce153a677",
                                "sense_id": "b12e008b-6f03-3b0d-a372-3374259c5368",
                                "text": "So that when you made me ungarment myself, I knew it was not so much the wise man who resented the semblance of being caught by a peacock's feather, as the strong man who, at the very moment of passion, could still dictate."
                            }
                        ]
                    }
