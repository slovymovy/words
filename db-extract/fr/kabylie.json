                                "target_senses": [
                                    {
                                        "sense_id": "bb1c9e02-c519-3be1-b495-cc71cf1910fa",
                                        "entry_id": "c8dd30a1-5798-3459-bd68-fb39c3047087",
                                        "glosses": [
                                            "A region of Algeria."
