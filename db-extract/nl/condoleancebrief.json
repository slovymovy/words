                    {
                        "sense_id": "d54409f9-30a4-302f-9174-230ebb8758b0",
                        "entry_id": "d3b93b3d-6454-315a-9756-2b9ea459bf4c",
                        "glosses": [
                            "brief die men schrijft aan de nabestaanden, voor het betonen van medeleven, na het overlijden van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6091e4ba-f4b5-44ae-9fbc-33f94fcdf8ab",
                                "sense_id": "d54409f9-30a4-302f-9174-230ebb8758b0",
                                "text": "Burgemeester Aboutaleb van Rotterdam heeft een condoleancebrief geschreven aan de burgemeester van Orlando. In de brief betuigt hij namens alle Rotterdammers zijn medeleven met de slachtoffers en nabestaanden."
                            },
                            {
                                "example_id": "17bcab46-91b9-42bc-a561-5dff32448e21",
                                "sense_id": "d54409f9-30a4-302f-9174-230ebb8758b0",
                                "text": "Boven op het stadhuis van Rotterdam wappert de Turkse vlag vandaag halverwege de mast. Burgemeester Aboutaleb stuurde vanmorgen een condoleancebrief aan zijn collega in Istanbul."
                            },
                            {
                                "example_id": "614de7da-d7ad-4367-9805-cc48ca09b9f8",
                                "sense_id": "d54409f9-30a4-302f-9174-230ebb8758b0",
                                "text": "Rusland reageerde vanmorgen als een van de eerste landen op de dood van Fidel Castro. Op de Russische staatstelevisie werd Castro geroemd als een groot strijder tegen het Amerikaanse imperialisme. President Poetin schrijft in een condoleancebrief aan Castro's broer Raúl dat Fidel Castro een buitengewoon staatsman en inspirerend voorbeeld was in de vorige eeuw. Russische burgers hebben deze \"sterke en wijze\" man voor altijd in hun hart gesloten, aldus Poetin."
                            }
                        ]
                    }
