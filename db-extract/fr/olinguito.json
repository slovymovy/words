                ],
                "senses": [
                    {
                        "sense_id": "300611f5-70a1-33b0-a898-49ebdde4304f",
                        "entry_id": "d5aab2b8-ec59-30b4-a0d0-66a35f75a76a",
                        "glosses": [
                            "Espèce d’olingo de petite taille, petit mammifère carnivore vivant dans le nord des Andes et principalement dans les arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da864ca-1d59-465e-85ac-65efe160f158",
                                "sense_id": "300611f5-70a1-33b0-a898-49ebdde4304f",
                                "text": "L’olinguito a été découvert en 2013 et c'est ainsi le premier mammifère découvert en Amérique depuis 35 ans."
                            },
                            {
                                "example_id": "59282d2e-8587-45b1-aeb8-ff492736def7",
                                "sense_id": "300611f5-70a1-33b0-a898-49ebdde4304f",
                                "text": "L’olinguito, dernière espèce de mammifère identifiée dans les Andes ces 35 dernières années, ressemble à un chat avec une tête d’ours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1829fb65-2e28-49c2-a16f-a508454e86c0",
                        "source_entry_id": "d5aab2b8-ec59-30b4-a0d0-66a35f75a76a",
                        "source_sense_id": "300611f5-70a1-33b0-a898-49ebdde4304f",
                        "target_lang_word": "Anden-Makibär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eebf66b1-db6c-4055-bbc1-5b085d0eab42",
                        "source_entry_id": "d5aab2b8-ec59-30b4-a0d0-66a35f75a76a",
                        "source_sense_id": "300611f5-70a1-33b0-a898-49ebdde4304f",
                        "target_lang_word": "olinguito",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olinguito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                        "entry_id": "8e53e0e9-f14f-3458-8f87-580acd6522d7",
                                        "glosses": [
                                            "A raccoon-like procyonid, of species Bassaricyon neblina, native to the Andean forests of Colombia and Ecuador."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68bd76f5-5177-4e0e-918e-1e1b5cbdebc4",
                                                "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                                "text": "“The discovery of the olinguito shows us that the world is not yet completely explored, its most basic secrets not yet revealed.”"
                                            },
                                            {
                                                "example_id": "990b6e8c-a07e-4709-b382-35e26d085869",
                                                "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                                "text": "A fuzzy fog-dweller with a face like a teddy bear, the olinguito (pictured) is the first carnivore discovered in the Western Hemisphere in more than three decades, a new study says."
                                            },
                                            {
                                                "example_id": "e69e6885-c7e3-43c6-8b3f-a1dfb13f1671",
                                                "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                                "text": "In the year since the announcement, the olinguito has gone from literal unknown to being surprisingly well-documented through photos and videos shot by amateur naturalists, bird watchers, and others, a kind of crowd-sourced science."
                                            },
                                            {
                                                "example_id": "1f9c5edf-1c2b-4097-96e5-2eae5915df76",
                                                "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                                "text": "First, a brand new species of mammal, considered the holy grail of the discipline, was found hiding in plain sight: the olinguito, smallest member of the raccoon family, has been around for decades, but was mistaken for its more substantial cousin, the olingo."
                                            },
                                            {
                                                "example_id": "0e8e4667-b121-4696-b103-9b792143ef4e",
                                                "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                                "text": "The olinguito, one of science's recently discovered species, is part of the same family as raccoons, coatis, and kinkajous."
                                            },
                                            {
                                                "example_id": "8707ca05-9cc8-41db-bfae-0c1a12aaa5e9",
                                                "sense_id": "27499ace-dddf-308e-b5a4-c598d4099259",
                                                "text": "The olinguito was found in the Andes Mountains by Smithsonian scientists in 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39b705ce-0d13-4488-b120-aa0e05282647",
