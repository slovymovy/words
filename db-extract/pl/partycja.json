                                                "sense_id": "c7a10eda-8c41-345a-989a-12cf6c586730",
                                                "text": "a brick partition; lath and plaster partitions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be49e6be-0f08-395c-a2a0-a6ac5a0b1bd4",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "That which divides or separates; that by which different things, or distinct parts of the same thing, are separated; boundary; dividing line or space."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
