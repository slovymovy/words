            {
                "entry_id": "4f1a3ce6-6084-3ebc-8656-0760d3f6d778",
                "word": "merrain",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "62600ba3-84a6-4072-a899-779890c5ebc7",
                        "entry_id": "4f1a3ce6-6084-3ebc-8656-0760d3f6d778",
                        "tags": [
                            "plural"
