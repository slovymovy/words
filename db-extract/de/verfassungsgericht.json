                            }
                        ]
                    },
                    {
                        "translation_id": "c44b8583-afd0-4d40-9d43-096482766fae",
                        "source_entry_id": "f68eb607-aa29-3885-824d-6238ef98ba96",
                        "source_sense_id": "7e417991-6249-32cc-9525-d28f4488aa1a",
