                        "entry_id": "ce1c0290-4469-3ea8-8b3c-4bfe119a1c20",
                        "glosses": [
                            "Territoire situé sur les deux versants de l’extrémité occidentale de la chaîne pyrénéenne, en France et en Espagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5196cd47-aedd-4db7-823d-0e2b6301bb24",
                                "sense_id": "e657754c-4d5a-3218-8601-5b5a1c8ad6f9",
                                "text": "Là des traités inconnus, des échanges occultes, se font entre les deux Navarres, au milieu des brouillards et des vents."
                            }
                        ]
                    }
