        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "747b6c7c-029b-3f9c-8808-64cf76396d8f",
                "word": "progressivism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "570375ef-e19c-4a5e-86ee-03100e2e79e0",
                        "entry_id": "747b6c7c-029b-3f9c-8808-64cf76396d8f",
                        "tags": [
                            "plural"
                        ],
                        "form": "progressivisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abe2f3c0-91ed-3d6a-bb90-ee9d79d75e11",
                        "entry_id": "747b6c7c-029b-3f9c-8808-64cf76396d8f",
                        "glosses": [
                            "A political ideology that favours progress towards better conditions in society."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b338a756-3695-4d65-9a10-184cceff346c",
                                "sense_id": "abe2f3c0-91ed-3d6a-bb90-ee9d79d75e11",
                                "text": "In New York the range of influences is as diverse as anywhere else, even if there unquestionably is a tendency toward Velvet Undergroundish punk rock and British progressivisms."
                            },
                            {
                                "example_id": "cd59e13e-6977-44b5-bfdd-f6d0667b68bc",
                                "sense_id": "abe2f3c0-91ed-3d6a-bb90-ee9d79d75e11",
                                "text": "By adopting big-tentism, conservatism has been allowed to degenerate into pseudo-conservatism, an ideology essentially the same as contemporary progressivism: embracing of every ideology and policy position whose inclusion is politically expedient."
                            },
                            {
                                "example_id": "94c6ffd2-acb7-4840-9ebb-8c5fa660af14",
                                "sense_id": "abe2f3c0-91ed-3d6a-bb90-ee9d79d75e11",
                                "text": "Some aspects of contemporary progressivism look less like actual progress and more like a step in reverse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1b73f48-438c-406c-a7b8-9a78a00ac7d0",
                        "source_entry_id": "747b6c7c-029b-3f9c-8808-64cf76396d8f",
                        "source_sense_id": "abe2f3c0-91ed-3d6a-bb90-ee9d79d75e11",
                        "source_sense_description": "political ideology",
                        "target_lang_word": "progressisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progressisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b076bd5e-573e-3358-8f3f-afede810f526",
                                        "entry_id": "9f2c2db8-424f-374b-97e8-0d0e9821213c",
                                        "glosses": [
                                            "Doctrine qui veut promouvoir le progrès social, les réformes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c3344c-9fd1-41c3-9d7c-c95597c1a638",
                                                "sense_id": "b076bd5e-573e-3358-8f3f-afede810f526",
                                                "text": "Des commentateurs de la gauche américaine soutiennent que l’expression « politiquement correct » a été forgée par les conservateurs américains vers 1980 pour discréditer le progressisme."
                                            },
                                            {
                                                "example_id": "678be1eb-4532-44a8-86c8-596faa13bab3",
                                                "sense_id": "b076bd5e-573e-3358-8f3f-afede810f526",
                                                "text": "Le progressisme se vit comme une épiphanie et se porte comme un bouclier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
