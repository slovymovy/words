                                    },
                                    {
                                        "sense_id": "fc4fc738-75fa-32f6-9052-f07f5c6abbc9",
                                        "entry_id": "9c896704-4d78-302b-b7d0-007917d11b6d",
                                        "glosses": [
                                            "Physically short or truncated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513a3847-b967-48ef-904d-f5e7c4d1bb20",
                                                "sense_id": "fc4fc738-75fa-32f6-9052-f07f5c6abbc9",
                                                "text": "This, however, must refer solely to the length; unfortunately they were far too broad in proportion (the fault I have always observed in them). This directly gives a slightly hoofish look, as in the concise Chinese feet."
                                            }
                                        ]
                                    }
                                ]
                            },
