                "senses": [
                    {
                        "sense_id": "71515408-eba7-3a15-b719-8010efd87314",
                        "entry_id": "658a6af0-1656-3641-ae05-acfbd352f1e3",
                        "glosses": [
                            "Linguistik, speziell Glossematik (ein theoretisches Konzept der Kopenhagener Schule): Untersuchung der Ausdrucksform der Sprache, der Keneme als kleinsten phonologischen Merkmalen der Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d18a97d-e393-4546-80e2-3e7f2676ed46",
                                "sense_id": "71515408-eba7-3a15-b719-8010efd87314",
                                "text": "„Da sich die Glossematik nach dem Willen ihrer Schöpfer nur mit der Form, nicht mit der Substanz, zu befassen hat, ergeben sich als Arbeitsgebiete die Ausdrucksform, für die die sog. Kenematik und die Inhaltsform, für die die sog. Plerematik zuständig ist.“"
                            },
                            {
                                "example_id": "d1fb7258-a79f-406d-8e1e-560b66151e1c",
                                "sense_id": "71515408-eba7-3a15-b719-8010efd87314",
                                "text": "„Daraus ergibt sich, daß die Glossematik in zwei Bereiche geteilt wird: in Kenematik und »Plerematik«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
