                                "target_senses": [
                                    {
                                        "sense_id": "dd407158-1ba9-32b1-9d1e-b95e5f4113b3",
                                        "entry_id": "5a20c309-2949-3ee8-824f-a630130b7ca5",
                                        "glosses": [
                                            "An imitation of laughter, often used to express scorn or disbelief. Often doubled or tripled (haw haw or haw haw haw)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04835180-aa11-42d9-b993-0de4177a31e9",
                                                "sense_id": "dd407158-1ba9-32b1-9d1e-b95e5f4113b3",
                                                "text": "You think that song was good? Haw!"
                                            },
                                            {
                                                "example_id": "85a00fda-7efa-4e02-aa12-4bb3a0c45c2e",
                                                "sense_id": "dd407158-1ba9-32b1-9d1e-b95e5f4113b3",
                                                "text": "The bitter laugh laughs at that which is not good, it is the ethical laugh. The hollow laugh laughs at that which is not true, it is the intellectual laugh. Not good! Not true! Well well. But the mirthless laugh is the dianoetic laugh, down the snout — Haw! — so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d5f6a5-a76f-331e-a68f-b9a77895ee05",
                                        "entry_id": "5a20c309-2949-3ee8-824f-a630130b7ca5",
                                        "glosses": [
                                            "An intermission or hesitation of speech, with a sound somewhat like \\\"haw\\\"; the sound so made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e333030a-9cab-4141-9e81-496fa2059bc9",
                                                "sense_id": "b5d5f6a5-a76f-331e-a68f-b9a77895ee05",
                                                "text": "Hums or haws."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85c95a01-2825-3427-b8ca-776c87e965b5",
                                        "entry_id": "761ac6c2-f7d5-3ff2-9b83-25a305171706",
                                        "glosses": [
                                            "To stop, in speaking, with a sound like haw; to speak with interruption and hesitation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
