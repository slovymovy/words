                "senses": [
                    {
                        "sense_id": "909b320b-165e-3043-8e52-7f2f04451e22",
                        "entry_id": "3b348ece-841f-3c04-8499-18373b30cb2c",
                        "glosses": [
                            "zwei Personen am Tag ihrer Eheschließung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59331c20-73b2-460b-b710-b2cce3c16529",
                                "sense_id": "909b320b-165e-3043-8e52-7f2f04451e22",
                                "text": "„Halb Dondorf erwartete das Brautpaar mit Glückwünschen draußen auf dem Kirchplatz.“"
                            },
                            {
                                "example_id": "57ece1c2-004c-49c0-afcb-e0ff178f9fe0",
                                "sense_id": "909b320b-165e-3043-8e52-7f2f04451e22",
                                "text": "„Das Brautpaar hatte sich bis zur Eheschließung kaum unterhalten, aber das störte sie nicht.“"
                            },
                            {
                                "example_id": "55379a9d-52c2-4c0a-a55a-dd64c64ebaf3",
                                "sense_id": "909b320b-165e-3043-8e52-7f2f04451e22",
                                "text": "„Im Rostowschen Hause herrschte jene Atmosphäre poetisch verklärter Langeweile, Bedrücktheit und Schweigsamkeit, die ein Brautpaar immer zu umgeben pflegt.“"
                            },
                            {
                                "example_id": "46563be2-48c7-43d1-a318-43e0a991ab60",
                                "sense_id": "909b320b-165e-3043-8e52-7f2f04451e22",
                                "text": "„Jeder prostete dem Brautpaar mit recht hübschen Stegreifversen zu, und jeder hielt sich für verpflichtet zu singen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
