{
    "word_family": [
        "odd",
        "oddly",
        "oddness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1746217a-7f58-3f33-9660-196818e1f4ac",
                    "sense_definition": "A strange, unusual, or peculiar thing, feature, or event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peculiarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique shop was filled with interesting curios and geological <w>oddities</w>.",
                            "target_lang_translations": {
                                "cs": "Starožitnictví bylo plné zajímavých kuriozit a geologických <w>zvláštností</w>."
                            }
                        },
                        {
                            "text": "A minor statistical <w>oddity</w> in the data caught the researcher's attention immediately.",
                            "target_lang_translations": {
                                "cs": "Drobná statistická <w>anomálie</w> v datech okamžitě upoutala pozornost výzkumníka."
                            }
                        }
                    ],
                    "synonyms": [
                        "anomaly",
                        "curiosity",
                        "peculiarity",
                        "quirk"
                    ],
                    "common_phrases": [
                        "statistical oddity",
                        "architectural oddity"
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco zvláštního, neobvyklého nebo podivného; kuriozita či anomálie."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zvláštnost",
                                "target_lang_sense_clarification": "neobvyklá věc či jev"
                            },
                            {
                                "target_lang_word": "kuriozita",
                                "target_lang_sense_clarification": "zajímavost, neobvyklý předmět či úkaz"
                            },
                            {
                                "target_lang_word": "podivnost",
                                "target_lang_sense_clarification": "divná věc či rys"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "891a258e-a7c5-38ab-80d4-2f0e81bd26ea",
                    "sense_definition": "A person who is eccentric or behaves in an unusual manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was regarded as a bit of an <w>oddity</w> in the quiet village.",
                            "target_lang_translations": {
                                "cs": "V té klidné vesnici byl považován za tak trochu <w>podivína</w>."
                            }
                        },
                        {
                            "text": "Her unique fashion sense made her an <w>oddity</w> among her conservative peers.",
                            "target_lang_translations": {
                                "cs": "Kvůli svému jedinečnému smyslu pro módu působila mezi konzervativními vrstevníky jako <w>zvláštní úkaz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentric",
                        "oddball",
                        "weirdo"
                    ],
                    "common_phrases": [
                        "a bit of an oddity"
                    ],
                    "target_lang_definitions": {
                        "cs": "Člověk, který se chová výstředně, podivínsky nebo neobvykle."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podivín",
                                "target_lang_sense_clarification": "výstřední člověk"
                            },
                            {
                                "target_lang_word": "zvláštní člověk",
                                "target_lang_sense_clarification": "neobvyklá osoba"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f79b181-a7fb-35cc-82fe-fdff1cee1541",
                    "sense_definition": "The quality or state of being strange or peculiar; strangeness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer <w>oddity</w> of the situation left everyone at a complete loss for words.",
                            "target_lang_translations": {
                                "cs": "Čistá <w>podivnost</w> celé situace způsobila, že všichni zcela ztratili řeč."
                            }
                        },
                        {
                            "text": "He smiled at the <w>oddity</w> of hearing familiar music in such a remote foreign village.",
                            "target_lang_translations": {
                                "cs": "Pousmál se nad <w>zvláštností</w> toho, že v tak odlehlé cizí vesnici slyší povědomou hudbu."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentricity",
                        "oddness",
                        "strangeness",
                        "unusualness",
                        "weirdness"
                    ],
                    "common_phrases": [
                        "sheer oddity"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vlastnost nebo stav toho, co je divné, zvláštní nebo neobvyklé; podivnost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podivnost",
                                "target_lang_sense_clarification": "vlastnost být divný"
                            },
                            {
                                "target_lang_word": "zvláštnost",
                                "target_lang_sense_clarification": "vlastnost být neobvyklý"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}