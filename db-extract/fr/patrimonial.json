                                        "sense_id": "d8308663-8d05-392b-8927-919a33a4f42c",
                                        "entry_id": "526c28e8-45f5-3b3c-b506-2da22ab33b30",
                                        "glosses": [
                                            "Legally (or otherwise) inherited from one or more ancestors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e1eec7a-eafe-4785-b4d4-8dcbd2c9f537",
                                                "sense_id": "d8308663-8d05-392b-8927-919a33a4f42c",
                                                "text": "[…] Cluffe, who had had two or three sharp little visits of his patrimonial gout […]"
                                            },
                                            {
                                                "example_id": "c01bca11-a434-48f9-a9e8-ccf7207cf349",
                                                "sense_id": "d8308663-8d05-392b-8927-919a33a4f42c",
                                                "text": "The general evolution is clear: bubbles aside, what we are witnessing is a strong comeback of private capital in the rich countries since 1970, or, to put it another way, the emergence of a new patrimonial capitalism."
                                            }
                                        ]
                                    }
