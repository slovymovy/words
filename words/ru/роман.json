                    "sense_id": "25a54706-ecf7-3b50-8943-9bbeaf37320c",
                    "sense_definition": "Большое литературное произведение, обычно в прозе, с развернутым сюжетом и развитием характеров героев.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я люблю читать исторический <w>роман</w> перед сном.",
                            "target_lang_translations": {
                                "en": "I like reading a historical <w>novel</w> before bed.",
                                "zh": "我喜欢在睡前读历史<w>小说</w>。",
                                "nl": "Ik lees voor het slapengaan graag een historische <w>roman</w>.",
                                "pl": "Lubię czytać historyczną <w>powieść</w> przed snem.",
                                "de": "Ich lese vor dem Schlafengehen gerne einen historischen <w>Roman</w>.",
                                "fr": "J'aime lire un <w>roman</w> historique avant de dormir.",
                                "it": "Mi piace leggere un <w>romanzo</w> storico prima di dormire.",
                                "cs": "Před spaním si rád čtu historický <w>román</w>.",
                                "tr": "Yatmadan önce tarihi bir <w>roman</w> okumayı severim.",
                                "es": "Me gusta leer una <w>novela</w> histórica antes de dormir."
                            }
                        },
                        {
                            "text": "Этот известный <w>роман</w> был переведён на многие языки мира.",
                            "target_lang_translations": {
                                "en": "This famous <w>novel</w> was translated into many languages of the world.",
                                "zh": "这部著名<w>小说</w>已被翻译成世界上的多种语言。",
                                "nl": "Deze bekende <w>roman</w> is in vele talen wereldwijd vertaald.",
                                "pl": "Ta znana <w>powieść</w> została przetłumaczona na wiele języków świata.",
                                "de": "Dieser berühmte <w>Roman</w> wurde in viele Sprachen der Welt übersetzt.",
                                "fr": "Ce <w>roman</w> célèbre a été traduit dans de nombreuses langues du monde.",
                                "it": "Questo famoso <w>romanzo</w> è stato tradotto in molte lingue del mondo.",
                                "cs": "Tento známý <w>román</w> byl přeložen do mnoha světových jazyků.",
                                "tr": "Bu ünlü <w>roman</w> dünyanın birçok diline çevrildi.",
                                "es": "Esta famosa <w>novela</w> fue traducida a muchos idiomas del mundo."
                            }
