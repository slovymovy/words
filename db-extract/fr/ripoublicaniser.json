                        "glosses": [
                            "Donner un caractère ripoublicain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc973de9-a5c1-4e55-a0e8-3d2a6b81b814",
                                "sense_id": "6685107c-52ed-3ae9-af8f-21ae27b8ef8f",
                                "text": "D'autre part il y a beaucoup de muzz ripoublicanisés, qui se prennent pour le fer de lance d'une prétendue dissidence (…)"
                            },
                            {
                                "example_id": "7c41656d-3f34-4b06-97ca-62a0cb6489c2",
                                "sense_id": "6685107c-52ed-3ae9-af8f-21ae27b8ef8f",
                                "text": "L’héritage national reste protégé et la ripoublique des casseroles Tefal continue à parader aux fenêtres de leur défense immunitaire : l’impunité pénale ripoublicanisée !"
                            },
                            {
                                "example_id": "429ccf30-daab-45a6-9e4b-40f3b7f422bb",
                                "sense_id": "6685107c-52ed-3ae9-af8f-21ae27b8ef8f",
                                "text": "Nous étions déjà ripoublicanisés, serons-nous bananés?"
                            }
                        ]
