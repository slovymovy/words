                    {
                        "sense_id": "4afa1b07-88e0-36c4-86d5-8cc90ef3fe83",
                        "entry_id": "08120833-5d3d-3102-a626-52ae0ead15e7",
                        "glosses": [
                            "Nom vulgaire donné à plusieurs espèces de petits coquillages bivalves de la famille des Unionidae vivant dans les cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0112eb3d-1403-4e5e-a931-0fe48978e589",
                                "sense_id": "4afa1b07-88e0-36c4-86d5-8cc90ef3fe83",
                                "text": "La mulette de rivière se rencontre dans les ruisseaux ou dans les fleuves sur des fonds sableux, sablo-limoneux ou vaseux… La mulette se nourrit par filtration. Son alimentation est essentiellement constituée d’algues filamenteuses, de protistes et de détritus végétaux."
                            },
                            {
                                "example_id": "7e21fd76-cd1b-499f-bfb4-674caa480a7f",
                                "sense_id": "4afa1b07-88e0-36c4-86d5-8cc90ef3fe83",
                                "text": "Le duc de Lorraine dut mettre en place des plantons, surnommés « garde-perles » pour surveiller les cours d’eau et empêcher qu’on ne vienne lui détrousser ses mulettes."
                            }
                        ]
                    }
                ],
