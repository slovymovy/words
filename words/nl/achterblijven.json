                    "sense_id": "77ef9098-512f-3fba-908e-8ac6ce31c31d",
                    "sense_definition": "nog steeds ergens zijn waar anderen of iets anders niet meer aanwezig is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verblijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de rest van de groep naar huis ging, besloot hij nog even in het café <w>achter te blijven</w>.",
                            "target_lang_translations": {
                                "en": "When the rest of the group went home, he decided to <w>stay behind</w> in the cafe for a while.",
                                "ru": "Когда остальная часть группы ушла домой, он решил еще ненадолго <w>остаться</w> в кафе."
                            }
                        },
                        {
                            "text": "Bij het filteren van de vloeistof bleef er een klein beetje goud op het filter <w>achter</w>.",
                            "target_lang_translations": {
                                "en": "When filtering the liquid, a small amount of gold <w>remained</w> on the filter.",
                                "ru": "При фильтрации жидкости на фильтре <w>осталось</w> немного золота."
                            }
                        }
                    ],
                    "synonyms": [
                        "overblijven"
                    ],
                    "antonyms": [
                        "vertrekken",
                        "meegaan"
                    ],
                    "common_phrases": [
                        "alleen achterblijven",
                        "op het filter achterblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain in a place after others have left or after something has been removed",
                        "ru": "оставаться в каком-либо месте после того, как другие ушли или что-то было удалено"
                    },
                    "translations": {
