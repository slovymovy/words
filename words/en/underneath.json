        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "4478be19-fd8c-3d70-8c4c-c6ebd5a2205d",
                    "sense_definition": "In or to a position directly below or beneath something else.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat is hiding <w>underneath</w> the wooden table in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Кот прячется <w>под</w> деревянным столом на кухне.",
                                "zh": "猫正躲在厨房木桌<w>底下</w>。"
                            }
                        },
                        {
                            "text": "We found the lost keys <w>underneath</w> the sofa cushions while cleaning.",
                            "target_lang_translations": {
                                "ru": "Во время уборки мы нашли потерянные ключи <w>под</w> диванными подушками.",
                                "zh": "打扫时，我们在沙发垫<w>下面</w>找到了丢失的钥匙。"
                            }
                        }
                    ],
                    "synonyms": [
