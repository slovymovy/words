{
    "word_family": [
        "devant",
        "devancier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d492073-104f-3f71-a27c-f662742d5c46",
                    "sense_definition": "Arriver avant une personne ou la dépasser lors d'un déplacement physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune coureur a accéléré sur la fin pour <w>devancer</w> le peloton d'une courte tête."
                        },
                        {
                            "text": "Il marchait d'un pas rapide pour <w>devancer</w> ses camarades avant l'ouverture de la grille."
                        }
                    ],
                    "synonyms": [
                        "précéder"
                    ],
                    "common_phrases": [
                        "devancer le peloton",
                        "devancer la foule"
                    ]
                },
                {
                    "sense_id": "bb3d6da6-10df-3648-b856-c2acfddc45d9",
                    "sense_definition": "Accomplir une action avant quelqu'un d'autre qui projetait de faire la même chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "priorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voulais acheter cette maison mais un autre acquéreur m'a <w>devancé</w> de quelques heures."
                        },
                        {
                            "text": "L'entreprise craignait de se faire <w>devancer</w> par un rival sur ce marché innovant."
                        }
                    ],
                    "synonyms": [
                        "prendre de court",
                        "prendre les devants"
                    ],
                    "common_phrases": [
                        "se faire devancer",
                        "devancer un rival"
                    ]
                },
                {
                    "sense_id": "d8f2219f-d177-3ee0-a041-af455c9cb9a6",
                    "sense_definition": "Anticiper une situation, une réaction ou un désir en agissant par avance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un bon serveur sait toujours <w>devancer</w> les attentes de ses clients sans rien demander."
                        },
                        {
                            "text": "Elle a préparé tous les documents nécessaires en <w>devançant</w> les demandes du directeur."
                        }
                    ],
                    "common_phrases": [
                        "devancer les attentes",
                        "devancer les désirs"
                    ]
                },
                {
                    "sense_id": "4358fe77-7ebb-3b4e-8027-205b506680d6",
                    "sense_definition": "Se produire avant un événement dans le temps ou être en avance sur les idées de son siècle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par ses inventions visionnaires, ce scientifique a largement <w>devancé</w> son époque."
                        },
                        {
                            "text": "Dans le ciel d'été, l'aube naissante <w>devance</w> toujours le lever du soleil."
                        }
                    ],
                    "synonyms": [
                        "précéder"
                    ],
                    "common_phrases": [
                        "devancer son époque",
                        "devancer son temps"
                    ]
                },
                {
                    "sense_id": "dee814f4-8432-35ba-9e79-0a72262b38d9",
                    "sense_definition": "Surpasser quelqu'un ou prendre un avantage manifeste dans une activité ou un domaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "superiorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des mois d'efforts continus, cette étudiante a fini par <w>devancer</w> toute sa promotion."
                        },
                        {
                            "text": "Le nouveau produit a rapidement permis de <w>devancer</w> tous les concurrents du secteur."
                        }
                    ],
                    "common_phrases": [
                        "devancer ses concurrents"
                    ]
                }
            ]
        }
    ]
}