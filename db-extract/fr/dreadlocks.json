                "entry_id": "1a9ea020-fa3c-312d-92a9-7916bae6768d",
                "word": "dreadlocks",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bd361b61-a051-4732-a6d5-397a3daef18b",
                        "entry_id": "1a9ea020-fa3c-312d-92a9-7916bae6768d",
                        "tags": [
                            "singular"
                        ],
                        "form": "dreadlock"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff08d597-7f38-39de-b7b8-f373a009a907",
                        "entry_id": "1a9ea020-fa3c-312d-92a9-7916bae6768d",
                        "glosses": [
                            "Style de coiffure composée de mèches de cheveux emmêlées naturellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61512661-06c9-4921-885e-1274ca7882d4",
                                "sense_id": "ff08d597-7f38-39de-b7b8-f373a009a907",
                                "text": "Avant d’achever cette partie de notre développement, il nous semblait intéressant d’examiner l’influence de la logique commerciale sur un symbole incontournable du mouvement rastafari, les nattes, communément appelées dreadlocks."
                            }
                        ]
                    },
                    {
                        "sense_id": "05ada55a-b361-3176-bf0d-ef73c1b26dc2",
                        "entry_id": "1a9ea020-fa3c-312d-92a9-7916bae6768d",
                        "glosses": [
                            "Personne portant cette coiffure."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62dbb496-0621-4e42-a95f-ac70d4bf7112",
                        "source_entry_id": "1a9ea020-fa3c-312d-92a9-7916bae6768d",
                        "target_lang_word": "Dreadlocks",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreadlocks",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4900bcd6-a4fa-37ad-851b-7d31e7445fb6",
                                        "entry_id": "92279dd5-4a69-3dab-a99c-0c6ab5280a31",
                                        "glosses": [
                                            "Frisur mit verfilzten Haarsträhnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db81011-eaf4-4153-bcf5-daafea9e582c",
                                                "sense_id": "4900bcd6-a4fa-37ad-851b-7d31e7445fb6",
                                                "text": "„Handys und Rucksäcke liegen am Boden verstreut, einige der jungen Leute tragen Dreadlocks, zerfetzte Jeans, dazu einen Rosenkranz ums Handgelenk.“"
                                            },
                                            {
                                                "example_id": "50b5acff-cee1-4589-b753-20dcdc5adbbf",
                                                "sense_id": "4900bcd6-a4fa-37ad-851b-7d31e7445fb6",
                                                "text": "„Für die Rastafari gelten ihre Dreadlocks als eine Art Antenne, mit denen sie göttliche Inspirationen erfahren können.“"
                                            },
                                            {
                                                "example_id": "289a4b64-0945-442b-b793-88b772b4a232",
                                                "sense_id": "4900bcd6-a4fa-37ad-851b-7d31e7445fb6",
                                                "text": "„Ein Schwarzer mit kurzen, wilden Dreadlocks winkte ihr linkisch zu, doch Ama ignorierte ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f254a452-77c4-4fb0-98c0-9ca96c42c6a8",
                        "source_entry_id": "1a9ea020-fa3c-312d-92a9-7916bae6768d",
