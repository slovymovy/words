                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da5bb9a-e5d6-437a-b680-8f977ca443ea",
                                                "sense_id": "43713b83-dd94-3f22-a868-8675dba8c51c",
                                                "text": "Eenigen derzelve waren in het slot tydelyk gehuisvest anderen hadden hunne heerlykheden in de nabyliggende vlakte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ae4b3c-5bf3-3cea-b9a6-99cd2d7a8cff",
                                        "entry_id": "8e6fbce4-4485-3cca-87c6-555b79f1ac79",
