                                "target_senses": [
                                    {
                                        "sense_id": "1b0af23c-00ee-3fb1-9042-fe6e12694073",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "The state of moving quickly or the capacity for rapid motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60cb0124-437a-4b34-a7c1-67e663fe61f1",
                                                "sense_id": "1b0af23c-00ee-3fb1-9042-fe6e12694073",
                                                "text": "How does Usain Bolt run at that speed?"
                                            },
                                            {
                                                "example_id": "029d2250-91d7-44bd-a06a-89f26a40bad2",
                                                "sense_id": "1b0af23c-00ee-3fb1-9042-fe6e12694073",
                                                "text": "Returne with ſpeed, time paſſeth ſwift away,\nOur life is fraile, and we may dye to day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9198ff36-baaa-3751-bd43-d781bdf34b28",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "The rate of motion or action, specifically the magnitude of the velocity; the rate distance is traversed in a given time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36201743-1505-44c6-97d0-7b9f1ac7328b",
                                                "sense_id": "9198ff36-baaa-3751-bd43-d781bdf34b28",
                                                "text": "Speed limits provide information to the drivers about the safe speed to travel in average conditions."
                                            },
                                            {
                                                "example_id": "1ecc33cb-5839-4f06-8429-88f2df22b6a8",
                                                "sense_id": "9198ff36-baaa-3751-bd43-d781bdf34b28",
                                                "text": "Train positions and speeds were established by a track magnet at each milepost, which produced a suitable mark on the punched recording tape whenever a train passed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4866a3b-3c55-3324-a08a-ae166ea5b54d",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "The sensitivity to light of film, plates or sensor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88178e71-3835-3d7b-9a21-afc8badf95fd",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "The duration of exposure, the time during which a camera shutter is open (shutter speed)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00b7f7f8-36d3-3492-b412-509a804f15cd",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "The largest size of the lens opening at which a lens can be used."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2de32eb4-a6ea-3099-9f6f-6fa09670ef90",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "The ratio of the focal length to the diameter of a photographic objective."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6ed0d04-36ce-3467-b0a8-186d5b75bc2e",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "Amphetamine or any amphetamine-based drug (especially methamphetamine) used as a stimulant, especially illegally."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c35c6487-dde7-45ef-b2e2-4920d89b07a5",
                                                "sense_id": "d6ed0d04-36ce-3467-b0a8-186d5b75bc2e",
                                                "text": "I don’t even like speed. It’s alright if ya wanna stay awake for three days an’ clean yer room, but I’m terrible on no sleep. It just makes me anxious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6ab6fb-7429-3514-9547-b48e76366fe9",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "Luck, success, prosperity."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3415fc8c-88dc-482f-8ed7-04d654229c73",
                                                "sense_id": "0f6ab6fb-7429-3514-9547-b48e76366fe9",
                                                "text": "St. Francis be my ſpeed, how oft to night / Haue my old feet ſtumbled at graues?"
                                            },
                                            {
                                                "example_id": "795c7099-3781-4ec9-a7a0-b50376fbb58f",
                                                "sense_id": "0f6ab6fb-7429-3514-9547-b48e76366fe9",
                                                "text": "O Lord God of my master Abraham, I pray thee, send me good speed this day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b63f0885-7201-35b0-9bdf-7ee0b9e27be1",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "Personal preference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61de165c-3291-4994-9680-a0c96a76f9f9",
                                                "sense_id": "b63f0885-7201-35b0-9bdf-7ee0b9e27be1",
                                                "text": "We could go to the shore next week, or somewhere else if that's not your speed."
                                            },
                                            {
                                                "example_id": "0b0b82f7-f7a0-4c2e-81e6-0322d1b95863",
                                                "sense_id": "b63f0885-7201-35b0-9bdf-7ee0b9e27be1",
                                                "text": "I used to dream of throwing on the heritage Burberry coat and teaming it with Hunter wellies (which is admittedly a very cute look), but a few years ago I realized an oversize option is actually my speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031f7ca4-95ae-3626-abdd-047800222271",
                                        "entry_id": "5946d7ec-ec5f-318d-adef-0d2965e88cc3",
                                        "glosses": [
                                            "A third-order measure of derivative price sensitivity, expressed as the rate of change of gamma with respect to changes in the underlying asset price."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "speed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e60dfab8-7160-38f2-ae68-c3b1b3293a18",
                                        "entry_id": "a4f08bf9-641f-34ec-980b-7e4f18dddecc",
                                        "glosses": [
                                            "Called by the soundman when the recording equipment has reached running speed and is ready to go."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be985174-8b59-4fda-97fd-b955086ba468",
                                                "sense_id": "e60dfab8-7160-38f2-ae68-c3b1b3293a18",
                                                "text": "“Speed,” Carlos, the soundman, said. […]\n“Camera.”\n“Rolling,” replied Bryce, the cameraman."
                                            },
                                            {
                                                "example_id": "bec0b5e9-ae56-4d91-af55-a0e094418273",
                                                "sense_id": "e60dfab8-7160-38f2-ae68-c3b1b3293a18",
                                                "text": "[…] the director called, “Roll 'em,” the sound man said, “Speed,” and Norling stepped in and said, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "speed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9740ee3-6d9e-3504-b464-cb11c79d2208",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To succeed; to prosper, be lucky."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f95c21-acb8-4f95-a1e4-3b5a54c08178",
                                                "sense_id": "d9740ee3-6d9e-3504-b464-cb11c79d2208",
                                                "text": "And yf I maye fynde suche a knyghte that hath all these vertues / he may drawe oute this swerd oute of the shethe / for I haue ben at kyng Ryons / it was told me ther were passyng good knyghtes / and he and alle his knyghtes haue assayed it and none can spede"
                                            },
                                            {
                                                "example_id": "d75ec080-d148-412a-a6cc-414efb8c0f07",
                                                "sense_id": "d9740ee3-6d9e-3504-b464-cb11c79d2208",
                                                "text": "We have been praying for our husbands' healths,\nWhich speed, we hope, the better for our words.\nAre they returned?"
                                            },
                                            {
                                                "example_id": "69dd0b6d-87d3-4578-a620-b6e4694298f9",
                                                "sense_id": "d9740ee3-6d9e-3504-b464-cb11c79d2208",
                                                "text": "Aristotle must find out the motion of Euripus; Pliny must needs see Vesuvius; but how sped they? One loseth goods, another his life."
                                            },
                                            {
                                                "example_id": "494778a8-d5df-412d-9e56-0ab4c2cd3e44",
                                                "sense_id": "d9740ee3-6d9e-3504-b464-cb11c79d2208",
                                                "text": "18ᵗʰc., Oliver Goldsmith, Introductory to Switzerland\nAt night returning, every labor sped, / He sits him down the monarch of a shed: / Smiles by his cheerful fire, and round surveys, / His children’s looks, that brighten at the blaze;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263fa857-9e71-37b9-92af-a148d50e2414",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To help someone, to give them fortune; to aid or favour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5ce64b-5728-4b5f-a173-26831dcbef36",
                                                "sense_id": "263fa857-9e71-37b9-92af-a148d50e2414",
                                                "text": "God speed, until we meet again."
                                            },
                                            {
                                                "example_id": "c8bb256d-f071-477e-b4e7-9a950e88bb01",
                                                "sense_id": "263fa857-9e71-37b9-92af-a148d50e2414",
                                                "text": "Fortune speed us! So we set forth to sea"
                                            },
                                            {
                                                "example_id": "ef1e9247-57ac-4925-a634-8363ec9f4419",
                                                "sense_id": "263fa857-9e71-37b9-92af-a148d50e2414",
                                                "text": "with rising gales that sped their happy flight"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a2438a-ee20-3f6b-9c4d-51d2dfd0e1da",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To go fast."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "347b7c3b-d3cc-47df-af5e-7de48dbc7b2f",
                                                "sense_id": "89a2438a-ee20-3f6b-9c4d-51d2dfd0e1da",
                                                "text": "The Ferrari was speeding along the road."
                                            },
                                            {
                                                "example_id": "20549c51-517b-457f-a2f6-3cfa19433536",
                                                "sense_id": "89a2438a-ee20-3f6b-9c4d-51d2dfd0e1da",
                                                "text": "I have speeded hither with the very extremest inch of possibility."
                                            },
                                            {
                                                "example_id": "4efb1a5d-1a52-4ea9-8edb-0b131644d616",
                                                "sense_id": "89a2438a-ee20-3f6b-9c4d-51d2dfd0e1da",
                                                "text": "With a little manœuvring they contrived to meet on the doorstep which was […] in a boiling stream of passers-by, hurrying business people speeding past in a flurry of fumes and dust in the bright haze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec80cf3-1bdb-34ec-82c6-d6b0d2437937",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To exceed the speed limit."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4dac01a-eb99-4cf3-a997-ca3ef5a374e2",
                                                "sense_id": "dec80cf3-1bdb-34ec-82c6-d6b0d2437937",
                                                "text": "Why do you speed when the road is so icy?"
                                            },
                                            {
                                                "example_id": "8b1fbca9-750c-4473-b9e4-eb8e7075485d",
                                                "sense_id": "dec80cf3-1bdb-34ec-82c6-d6b0d2437937",
                                                "text": "It had these very funny, crazy plays in it, and then it had this one story about a traffic cop that falls in love with this very cute girl that’s always speeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8eed0c8-b920-3743-8f67-2b19e8aa5510",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To increase the rate at which something occurs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb260ce9-be1a-4851-968e-d03f3964fe1c",
                                                "sense_id": "c8eed0c8-b920-3743-8f67-2b19e8aa5510",
                                                "text": "It is possible that the uterine contractions speed the sperm along."
                                            },
                                            {
                                                "example_id": "cc78d5f6-fb86-4efc-8c67-07d4df120dce",
                                                "sense_id": "c8eed0c8-b920-3743-8f67-2b19e8aa5510",
                                                "text": "Such interventions can help to speed the process of reducing CBRs and help countries pass through the demographic transition threshold more quickly[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1344c0c8-bed6-3bce-9c4e-da21bb2de619",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To be under the influence of stimulant drugs, especially amphetamines."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943710bc-a818-42d4-b153-d5ccfe780036",
                                                "sense_id": "1344c0c8-bed6-3bce-9c4e-da21bb2de619",
                                                "text": "Jackie is just speeding away / Thought she was James Dean for a day"
                                            },
                                            {
                                                "example_id": "33c11bc4-3319-4a0c-ab25-ffcc3a494eab",
                                                "sense_id": "1344c0c8-bed6-3bce-9c4e-da21bb2de619",
                                                "text": "If Hector had not been speeding, it was possible that his next thought would have hurt: he loves his uncle unconditionally, in a way he will never love me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f225ff78-64bf-3a23-aad3-9f8b055a8762",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To be expedient."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db37892b-759b-3fec-a8cc-12f908cdd353",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To hurry to destruction; to put an end to; to ruin."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88de86f6-7f69-4b42-97aa-b2b627b80cd4",
                                                "sense_id": "db37892b-759b-3fec-a8cc-12f908cdd353",
                                                "text": "infected with the fashions, full of wingdalls, sped with spavins, rayed with yellows"
                                            },
                                            {
                                                "example_id": "abeee0c2-048d-4a34-bac8-877d504398ca",
                                                "sense_id": "db37892b-759b-3fec-a8cc-12f908cdd353",
                                                "text": "A dire dilemma! either vvay I'm ſped, / If Foes, they vvrite, if Friends, they read me dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47eeadea-5ccd-3130-936d-7d4a28584033",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To wish success or good fortune to, in any undertaking, especially in setting out upon a journey."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be7f9c34-743b-4dc3-baaa-e61458650503",
                                                "sense_id": "47eeadea-5ccd-3130-936d-7d4a28584033",
                                                "text": "Welcome the coming, speed the parting guest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fdcae3e-32fc-31de-8516-eee614077dae",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To cause to make haste; to dispatch with celerity; to drive at full speed; hence, to hasten; to hurry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af0cadd-c93f-4834-a218-f6380636ea78",
                                                "sense_id": "6fdcae3e-32fc-31de-8516-eee614077dae",
                                                "text": "He sped him thence, home to his habitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38956317-d16e-3cff-95fc-c9c1b0058fb1",
                                        "entry_id": "7af920d3-8c99-31e3-b68b-a0e8270cb561",
                                        "glosses": [
                                            "To hasten to a conclusion; to expedite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9e354b-ac5f-4b5b-a8e1-4f339f650969",
                                                "sense_id": "38956317-d16e-3cff-95fc-c9c1b0058fb1",
                                                "text": "Judicial acts[…]are sped in open court at the instance of one or both of the parties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fea0b13-f0a8-4092-ae13-60da94c0bae6",
                        "source_entry_id": "30448f7c-41f0-340a-a0d5-e6390c65d03e",
                        "source_sense_id": "83ea4a5a-f2cf-3c6e-8f9c-1670bbc4488b",
                        "source_sense_description": "Substanz aus der Stoffgruppe der Phenylethylamine",
                        "target_lang_word": "amphétamine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphétamine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                        "entry_id": "e93970d8-97fc-373d-a635-e4cfa6409726",
                                        "glosses": [
                                            "Molécule synthétique de formule brute C₉H₁₃N utilisée comme drogue, dopant sportif, stimulant du système nerveux central, coupe-faim ou médicament dans le traitement de l'hyperactivité chez l’enfant, pour ses effets anorexigène et psychoanaleptique."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8400405-48b4-471e-94a7-16c58f6f853a",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "Il avala deux pilules de maxiton. L’usage des dopants à base d’amphétamine d’abord pratiqué par les étudiants pendant les périodes d’examens, est devenu commun chez les ouvriers depuis les années 1948 ; à Bionnas, on les utilise fréquemment pour vaincre la somnolence d’après la sixième ou septième heure du travail aux presses."
                                            },
                                            {
                                                "example_id": "5cf117a7-7488-4f85-912b-f14f98a86f82",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "L’amphétamine et ses dérivés font partie de ce qu’on a appelé les dopants de la première génération."
                                            },
                                            {
                                                "example_id": "8c82e676-5c3c-4053-b5f7-d46b4ac2a488",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "Très vite, le lien entre ce que voulait dire Motörhead, ou speedfreak, c'est-à-dire quelqu'un qui carbure aux amphétamines et surtout pas aux drogues dures de type héroïne."
                                            },
                                            {
                                                "example_id": "fbe3cc5f-af5f-45c1-8e57-81897ebde521",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "On trouve le reste en pharmacie : morphine ou méthédrine, une amphétamine prisée des routards ; et en avant la fixette, à moi les cachetons avalés entre deux shiloms."
                                            },
                                            {
                                                "example_id": "807040f2-d9cc-4433-8d0b-5bf234919923",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "Les amphétamines sont connues pour couper les élans vitaux mais cette fois-là, ce fut le contraire et Lélia avait été conçue dans l’euphorie d’une nuit sans fin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
