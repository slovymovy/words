                                "target_senses": [
                                    {
                                        "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                        "entry_id": "caf153bc-f12b-3e51-9904-f97aad88aa4a",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6b7814-f7ca-4087-9e1f-f769bc302b2d",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Frau Nathan ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "d907d8b4-10fa-42ae-b53f-f9249e4b9f30",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Herr Nathan wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "ac728988-1fd9-415f-9050-87442d97a71a",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Die Nathans kommen heute aus dem Erzgebirge."
                                            },
                                            {
                                                "example_id": "cadaaf4f-7d8d-4f69-873d-79a2b0f305e6",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Der Nathan trägt nie die Schals, die die Nathan ihm strickt."
                                            },
                                            {
                                                "example_id": "c5dc277a-b6d2-4a76-911f-ca9af27632b7",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nathan kommt, geht der Herr Nathan.“"
                                            },
                                            {
                                                "example_id": "626f82fc-d90e-42f3-82b5-68a4fd5c3caa",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Nathan kommt und geht."
                                            },
                                            {
                                                "example_id": "51515a1b-3fa7-4af4-85c2-b5ca04a0e76f",
                                                "sense_id": "376456ce-9177-3dee-b72e-57a0a08a698c",
                                                "text": "Nathans kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
