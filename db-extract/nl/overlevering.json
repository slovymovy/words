                                    {
                                        "sense_id": "795f17e3-3d37-30f1-bf80-707288f5f996",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "An unrealistic story depicting past events.",
