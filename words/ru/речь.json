    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dc42484-0402-3fb5-8176-45d41120ce13",
                    "sense_definition": "Разговор, обсуждение какого-либо предмета или темы (часто используется в устойчивых выражениях).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не понимаю, о чём идёт <w>речь</w>.",
                            "target_lang_translations": {
                                "en": "I don't understand what the <w>conversation</w> is about.",
                                "zh": "我不明白你在<w>谈论</w>什么。"
                            }
                        },
                        {
                            "text": "Мы завели <w>речь</w> о планах на летние каникулы.",
                            "target_lang_translations": {
                                "en": "We started a <w>conversation</w> about plans for summer vacation.",
                                "zh": "我们开始<w>讨论</w>暑假计划。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разговор",
                        "беседа"
                    ],
                    "common_phrases": [
                        "о чём речь",
                        "речь идёт о",
                        "завести речь",
                        "вести речь"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in phrases like 'речь идёт о'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Conversation, discussion, or the subject being talked about.",
                        "zh": "指谈话、讨论或所谈论的主题。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conversation",
                                "target_lang_sense_clarification": "exchange of ideas"
                            },
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "discussion"
                            },
                            {
                                "target_lang_word": "discussion",
                                "target_lang_sense_clarification": "serious conversation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谈话",
                                "target_lang_sense_clarification": "指交流思想的对话"
                            },
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "指针对某事的深入交流"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa2c6d5e-338b-3809-b54e-da92a3dc52f8",
                    "sense_definition": "Способность говорить, выражать свои мысли словами.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От сильного удивления он на минуту потерял дар <w>речи</w>.",
                            "target_lang_translations": {
                                "en": "From sheer surprise, he lost the power of <w>speech</w> for a moment.",
                                "zh": "他因极度惊讶而一时失去了<w>说话</w>的能力。"
                            }
                        },
                        {
                            "text": "Развитие <w>речи</w> у ребёнка происходит постепенно.",
                            "target_lang_translations": {
                                "en": "The development of <w>speech</w> in a child happens gradually.",
                                "zh": "儿童的<w>语言</w>能力是逐渐发展的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "немота"
                    ],
                    "common_phrases": [
                        "дар речи",
                        "органы речи",
                        "развитие речи",
                        "расстройство речи",
                        "человеческая речь"
                    ],
                    "target_lang_definitions": {
                        "en": "The ability to speak and express thoughts verbally.",
                        "zh": "指说话的能力或表达思想的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "speech",
                                "target_lang_sense_clarification": "faculty of speaking"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "语言能力",
                                "target_lang_sense_clarification": "指说话的生理或心理机能"
                            },
                            {
                                "target_lang_word": "说话",
                                "target_lang_sense_clarification": "指表达思想的动作"
                            }
                        ]
