                        "delightful"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Très agréable, merveilleux ou divin.",
                        "cs": "Velmi příjemný, úžasný nebo božský."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "merveilleux",
                                "target_lang_sense_clarification": "Qui est extrêmement plaisant."
                            },
                            {
                                "target_lang_word": "divin",
                                "target_lang_sense_clarification": "Qui est d'une qualité exceptionnelle."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "úžasný",
                                "target_lang_sense_clarification": "Velmi příjemný nebo skvělý."
                            },
                            {
                                "target_lang_word": "božský",
                                "target_lang_sense_clarification": "Mimořádně kvalitní nebo krásný."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}