    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0da88b86-e408-316f-a54a-41f906f08760",
                "word": "noiselessly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                        "entry_id": "0da88b86-e408-316f-a54a-41f906f08760",
                        "glosses": [
                            "In a quiet manner, without any noise."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4840c4b9-cb46-49b2-95c4-46efbfa8a8b3",
                                "sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                                "text": "Noiselessly she laid the clematis and wattle on her bed, then stood near the covered face, and, looking down at her untied bootlaces, sighed an impatient sigh always well known and understood by this now unresponsive father."
                            },
                            {
                                "example_id": "50472295-0828-4058-9ad9-1ff7bfb21f9d",
                                "sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                                "text": "Not thirty paces behind the two she crouched--Sabor, the huge lioness--lashing her tail. Cautiously she moved a great padded paw forward, noiselessly placing it before she lifted the next. Thus she advanced; her belly low, almost touching the surface of the ground--a great cat preparing to spring upon its prey."
                            },
                            {
                                "example_id": "fcea5b79-89d8-41d4-94d8-71fff74dbbb5",
                                "sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                                "text": "I now, O friend, whom noiselessly the snows / Settle around, and whose small chamber grows / Dusk as the sloping window takes its load:"
                            },
                            {
                                "example_id": "017af60b-60c8-4161-a301-beae3a6c21de",
                                "sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                                "text": "The Bat—they called him the Bat. Like a bat he chose the night hours for his work of rapine; like a bat he struck and vanished, pouncingly, noiselessly; like a bat he never showed himself to the face of the day."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3389e02-9c2b-4345-8bbc-c1fc674ed72f",
                        "source_entry_id": "0da88b86-e408-316f-a54a-41f906f08760",
                        "source_sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                        "source_sense_description": "in a quiet manner",
                        "target_lang_word": "sans bruit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7cfa1935-e130-41e5-b654-4721458dab4e",
                        "source_entry_id": "0da88b86-e408-316f-a54a-41f906f08760",
                        "source_sense_id": "ee5fceb4-6216-38b3-9dce-f88b234dca37",
                        "source_sense_description": "in a quiet manner",
                        "target_lang_word": "geräuschlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geräuschlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                        "entry_id": "16399adc-da76-31f4-b28c-dccbbb8f56eb",
                                        "glosses": [
                                            "ohne ein Geräusch abzugeben, lautlos, unhörbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ecedee-1d6b-4c64-84b3-89cd8b90c11d",
                                                "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                                "text": "Das Elektroauto näherte sich geräuschlos."
                                            },
                                            {
                                                "example_id": "cb64e666-94d7-451b-af62-a01a57c27260",
                                                "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                                "text": "„Die nagelneue Flyline am Rittisberg ist eine Mischung von Waldachterbahn und Flying-Fox, mit der Besucher nahezu geräuschlos zwischen den Baumkronen durch den Fichtenwald schweben können.“"
                                            },
                                            {
                                                "example_id": "38bf0ea7-c72c-4e54-93ec-0ed1d922c07c",
                                                "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                                "text": "„Die neuen Antriebstechnik funktioniert, als habe Opel nie andere Autos gebaut: nahezu geräuschlos, vibrationsfrei und ohne andere Auffälligkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "330fc106-55bf-46f2-9938-fbf90c5aaea4",
                        "source_entry_id": "0da88b86-e408-316f-a54a-41f906f08760",
