                ],
                "senses": [
                    {
                        "sense_id": "a2f6eb00-427b-3460-bfd5-f3472d2a4ab1",
                        "entry_id": "8c156eae-f104-30d4-8779-3e0506e79207",
                        "glosses": [
                            "S’attaquer de la langue, de propos piquants."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2e8291b1-2d6a-4837-8543-62a8dfad4148",
                                "sense_id": "a2f6eb00-427b-3460-bfd5-f3472d2a4ab1",
                                "text": "À la fin, lui et la dame se querellèrent tout de bon ; car, l’ayant rencontrée en une visite, ils se harpignèrent."
                            },
                            {
                                "example_id": "bbee0d8f-f536-4f8f-bc5e-54005745ecd8",
                                "sense_id": "a2f6eb00-427b-3460-bfd5-f3472d2a4ab1",
                                "text": "La comtesse et elle se harpignèrent ; les autres ne dirent rien."
                            },
                            {
                                "example_id": "a125a654-bd7b-4e06-aceb-6ea77c659a6d",
                                "sense_id": "a2f6eb00-427b-3460-bfd5-f3472d2a4ab1",
                                "text": "Il y avait quelque temps que cette fille et la Blake se harpillaient au sujet de Dongau que la Price avait enlevé à cette dernière."
                            }
                        ]
                    }
