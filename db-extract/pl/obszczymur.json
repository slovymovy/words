                    },
                    {
                        "sense_id": "01ae3adf-ff87-3288-b98c-9e6e274b0e6f",
                        "entry_id": "24130984-50b5-3f54-887c-4c1a9ddc9b95",
                        "glosses": [
                            "pijak spod sklepu monopolowego"
                        ],
                        "tags": [
                            "colloquial",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "d5fd4c25-7c21-42e2-8fb6-57e47fab7fdb",
                                "sense_id": "01ae3adf-ff87-3288-b98c-9e6e274b0e6f",
                                "text": "Uważam, że jestem zerem, mam świadomość tego, że byle zdrowy psychicznie obszczymur spod sklepu z alkoholem jest więcej wart niż ja"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5cf1cd39-1ea4-39b6-8bdc-d8810cff35ed",
                        "entry_id": "24130984-50b5-3f54-887c-4c1a9ddc9b95",
                        "glosses": [
                            "o osobie godnej pogardy"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "8d09176e-a23d-4536-8c76-38c7d7424870",
                                "sense_id": "5cf1cd39-1ea4-39b6-8bdc-d8810cff35ed",
                                "text": "Co się gapisz jak szpak w dupę, jestem nosicielką hifa, ejdsa. Zaraził mnie w Niemczech taki obszczymur, w którym się zakochałam"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
