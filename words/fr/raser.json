                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a décidé de <w>raser</w> cette vieille usine pour aménager un grand jardin public."
                        },
                        {
                            "text": "La violente tempête a fini par <w>raser</w> plusieurs cabanes situées le long du littoral."
                        }
                    ],
                    "synonyms": [
