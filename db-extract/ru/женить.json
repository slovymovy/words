                "senses": [
                    {
                        "sense_id": "ac040b9d-71d1-3c2c-ae96-3f7922fe59da",
                        "entry_id": "3ca26555-d715-3bd7-ac58-b8284d6e5a36",
                        "glosses": [
                            "содействовать мужчине в заключении брака, способствовать женитьбе"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ab8d252d-d941-334e-80c9-7a02faf7ed32",
                        "entry_id": "3ca26555-d715-3bd7-ac58-b8284d6e5a36",
                        "glosses": [
                            "добиться вступления какого-то мужчины в брак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4ed8d2-eab6-44a9-a734-a9b1a6a9197a",
                                "sense_id": "ab8d252d-d941-334e-80c9-7a02faf7ed32",
                                "text": "Марфа Андревна, как мы видели, имела намерение женить сына"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c020c0ac-9775-4eab-8c6f-3307a475ba54",
                        "source_entry_id": "3ca26555-d715-3bd7-ac58-b8284d6e5a36",
                        "target_lang_word": "wed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19e9c7d9-5297-3045-a970-28f78a9bfaca",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To perform the marriage ceremony for; to join in matrimony."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb4a574-56b7-4438-805f-0c77dbc96d48",
                                                "sense_id": "19e9c7d9-5297-3045-a970-28f78a9bfaca",
                                                "text": "The priest wed the couple."
                                            },
                                            {
                                                "example_id": "5a5455fe-e88f-4997-b806-e2ab811c3154",
                                                "sense_id": "19e9c7d9-5297-3045-a970-28f78a9bfaca",
                                                "text": "And Adam, wedded to another Eve,\n Shall live with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0678b4d9-7ac0-3d18-b0e7-e1369560f1bf",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To take as one's spouse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c4fc99-5681-4693-8e42-07e828c1b86c",
                                                "sense_id": "0678b4d9-7ac0-3d18-b0e7-e1369560f1bf",
                                                "text": "She wed her first love."
                                            },
                                            {
                                                "example_id": "14fe6057-5f00-4159-bf1b-a1012b1a9f44",
                                                "sense_id": "0678b4d9-7ac0-3d18-b0e7-e1369560f1bf",
                                                "text": "In 1989, he wed Playmate Kimberley Conrad, a marriage that ended in 2010. In 2013, he married his younger girlfriend, Crystal Harris, with whom he was still wed at the time of his death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b04a8c-8aeb-3eb6-a95b-15104fe62f1a",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To take a spouse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24dfab18-79e2-3b43-8c0f-ba9b1b34c542",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To take each other as a spouse."
                                        ],
                                        "tags": [
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6c2012-231d-4262-b605-955310c772b7",
                                                "sense_id": "24dfab18-79e2-3b43-8c0f-ba9b1b34c542",
                                                "text": "They will wed in the summer."
                                            },
                                            {
                                                "example_id": "bf7bb33e-9cf4-439a-a3ea-bf1eacae93f4",
                                                "sense_id": "24dfab18-79e2-3b43-8c0f-ba9b1b34c542",
                                                "text": "On the rock above was an inscription in three words. Ayesha translated it. It was `Wedded in Death.' What was the life-story of these two, who, of a truth, were beautiful in their lives, and in their death were not divided?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To join or commit to, more or less permanently, as if in marriage."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8205297d-f1df-45a4-b786-f9e7dd6ecc1d",
                                                "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                                "text": "I'm not wedded to this proposal; suggest an alternative."
                                            },
                                            {
                                                "example_id": "015703b7-827f-4a02-bef0-c2e2d3200d4d",
                                                "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                                "text": "Affliction is enamoured of thy parts, and thou art wedded to calamity."
                                            },
                                            {
                                                "example_id": "7da1742f-3720-4f5b-b64c-d64dad6e8b6c",
                                                "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                                "text": "Men are wedded to their lusts."
                                            },
                                            {
                                                "example_id": "86f83ba9-3e04-4fb4-8077-70772e11070c",
                                                "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                                "text": "[…] When each by turns was guide to each,\n⁠And Fancy light from Fancy caught,\n⁠And Thought leapt out to wed with Thought,\nEre Thought could wed itself with Speech: […]"
                                            },
                                            {
                                                "example_id": "11d899b0-b7a7-4504-b1c9-5daa038070e4",
                                                "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                                "text": "It will be a tragedy if further enterprises of this kind—for example, the one proposed between South Wales, Bristol and the South Coast via Salisbury—are now deferred until they, too, are realised too late to make an impact on a public that is too firmly wedded to the roads to be wooed back to the trains."
                                            },
                                            {
                                                "example_id": "489f92b7-b749-49fb-9f04-672d7937638f",
                                                "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                                                "text": "[…] the PPS paper proposed a political doctrine that wedded modernization theory to U.S. support for national security states […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ebb93de-e53e-397b-bfa0-be9a0bf6c325",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To take to oneself and support; to espouse."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f4164b-7f94-4aae-97b9-c0038c1eca18",
                                                "sense_id": "5ebb93de-e53e-397b-bfa0-be9a0bf6c325",
                                                "text": "They positively and concernedly wedded his cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517e5645-0d5c-362d-b707-04fe6922de1d",
                                        "entry_id": "887577f5-26a6-3534-bf29-2d1f9e4bce62",
                                        "glosses": [
                                            "To wager, stake, bet, place a bet, make a wager."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdf45f7f-bd91-4d58-9418-d8e281288d59",
                                                "sense_id": "517e5645-0d5c-362d-b707-04fe6922de1d",
                                                "text": "I'd wed my head on that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
