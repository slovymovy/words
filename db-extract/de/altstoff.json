                "senses": [
                    {
                        "sense_id": "f580b01a-1cb1-30f9-a5ce-5f9caef549cc",
                        "entry_id": "53ba1bdb-1529-3ee1-87e2-60f964ea3d38",
                        "glosses": [
                            "etwas, das nicht mehr verwendet, aber dem Konsumkreislauf wieder zugeführt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d0ef0d-595b-4c78-8aeb-c03e1fe1d886",
                                "sense_id": "f580b01a-1cb1-30f9-a5ce-5f9caef549cc",
                                "text": "„In den Innenstadtvierteln Isarvorstadt, Au und Haidhausen werden zudem von September an zwei ‚Wertstoffmobile‘ unterwegs sein, bei denen die Bürger die Altstoffe abgeben können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4174bda6-e7e1-35c0-b72a-d799712598a6",
                        "entry_id": "53ba1bdb-1529-3ee1-87e2-60f964ea3d38",
                        "glosses": [
                            "Chemikalie, die vor dem Inkrafttreten des jeweiligen nationalen Chemikaliengesetzes auf dem Markt war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b67451-e75b-44cd-b021-4f7c6b58aa2c",
                                "sense_id": "4174bda6-e7e1-35c0-b72a-d799712598a6",
                                "text": "„Das Chemikaliengesetz unterscheidet zwischen Altstoffen, die vor dem 18. September 1981 in den Verkehr gebracht wurden, und neuen Stoffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
