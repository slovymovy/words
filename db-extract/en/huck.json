                    },
                    {
                        "form_id": "35721e35-8eab-43d8-8274-8cc40b85d558",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "hucked"
                    },
                    {
                        "form_id": "66d0b848-52c5-4ed6-9e05-d7d8ab5a0246",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "tags": [
                            "past"
                        ],
                        "form": "hucked"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "350c530a-9f49-30b3-a14e-1b8d807985f9",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To throw or chuck."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cc6a344a-2b80-4695-a767-e6dfa36bc8b6",
                                "sense_id": "350c530a-9f49-30b3-a14e-1b8d807985f9",
                                "text": "He was so angry that he hucked the book at my face."
                            },
                            {
                                "example_id": "a13e0b58-c208-4052-8348-7c5d50afbca7",
                                "sense_id": "350c530a-9f49-30b3-a14e-1b8d807985f9",
                                "text": "So I came up with this plan for Blooey to hit that weak spot! All you, man,!\" I said. I waited for a pause in the statue's movements and hucked Blooey up there! And bull's-eye!"
                            },
                            {
                                "example_id": "a22c7983-4084-4a01-83c6-2ecca0b882c6",
                                "sense_id": "350c530a-9f49-30b3-a14e-1b8d807985f9",
                                "text": "Mostly these portable toilets are just thin molded plastic […] But at construction sites, we sheet-metal the sides. Cladding, it's called. Otherwise, people come along and punch holes through them. […] Or kids will come along and huck rocks through the roofs, just to hear the sound it makes."
                            }
                        ]
                    },
                    {
                        "sense_id": "32c1f8b2-76f3-3dd1-ae5b-757ca591fcf8",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To throw oneself off a large jump or drop."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "407b168a-162e-36fa-8e55-3a1de8d4c041",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To throw one's body in the air, possibly in a way that is ungraceful or lacks skill."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ab07952-fbd1-3441-adba-1a1d59146ab6",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To throw a frisbee a long distance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "404e6548-152a-33fb-8b02-d09e69ef25e4",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To make a long throw with the frisbee; to start a point by making such a throw."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9a2c5597-5762-3781-803b-deee0c77c922",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To attempt a particularly big jump or drop, often haphazardly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba6cb46f-c781-47dc-a527-ad3a2428389b",
                                "sense_id": "9a2c5597-5762-3781-803b-deee0c77c922",
                                "text": "A longer fork makes the bike more cumbersome, but you will be able to huck more stuff."
                            },
                            {
                                "example_id": "f3223319-d7a2-4a80-87b2-79a4389d2b47",
                                "sense_id": "9a2c5597-5762-3781-803b-deee0c77c922",
                                "text": "If you huck it (the take-off), you'll drop about 20 feet."
                            }
                        ]
                    },
                    {
                        "sense_id": "21d4a870-66d4-3308-821c-3499971bbc07",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To make a maneuver in a clumsy or poorly planned way."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ac398faf-4a4d-37e6-81cb-629134a1b53f",
                        "entry_id": "f31cb7f2-4dd8-3ee1-9746-1169781677b0",
                        "glosses": [
                            "To paddle off a waterfall or to boof a big drop."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eb4fa4a3-67b7-4799-9579-be4641d46662",
                                "sense_id": "ac398faf-4a4d-37e6-81cb-629134a1b53f",
                                "text": "I hucked a sweet 25-foot waterfall on the Tomata River."
                            }
                        ]
                    }
                ],
