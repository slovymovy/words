                        "translation_id": "65c33a6a-a45d-4012-8ec3-0085fb6d752f",
                        "source_entry_id": "179bb0ca-2dd8-355f-af87-e1af85e764f0",
                        "source_sense_id": "9675da30-d91b-34c1-85fb-77e6bf9e0966",
                        "source_sense_description": "wordt beschouwd als het noordelijkste punt van het Europese vasteland",
                        "target_lang_word": "Nordkap",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordkap",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c27a98-302f-3f3c-b291-90e067543223",
                                        "entry_id": "abf0b74d-9b97-36f2-8e51-2c38faf2b769",
                                        "glosses": [
                                            "ein ins Nordpolarmeer hineinragendes Kap an der Nordseite der norwegischen Insel Magerøya, der nördlichste vom Festland aus auf dem Straßenweg erreichbare Punkt Europas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b040655b-930d-479f-abd8-7a6a80de6244",
                                                "sense_id": "e4c27a98-302f-3f3c-b291-90e067543223",
                                                "text": "„Im September 2021 haben zwei Franzosen in einem Tesla Model 3 Long Range eine beeindruckende Reise von Portugal bis zum Nordkap in Norwegen in nur 70 Stunden und 45 Minuten absolviert.“"
                                            },
                                            {
                                                "example_id": "8eaea968-804a-47ea-bff5-6b4bb8973096",
                                                "sense_id": "e4c27a98-302f-3f3c-b291-90e067543223",
                                                "text": "„In Norwegen gibt’s viel zu sehen beispielsweise die vielen wunderschönen Fjordlandschaften, z. B. den Geirangerfjord, bekanntes Fotomotiv, Erscheinungen und Orte wie Polarlichter, die Lofoten, das Nordkap und die Mitternachtssonne und auch faszinierende Städte wie z. B. Bergen, Stavanger, Trondheim und Oslo.“"
                                            },
                                            {
                                                "example_id": "0deec614-fd1e-4ed2-94b0-bef7ba59751d",
                                                "sense_id": "e4c27a98-302f-3f3c-b291-90e067543223",
                                                "text": "„Durch seine Lage in der Nähe des Nordkaps hat die nördlichste Stadt Europas eine große Bedeutung für Kreuzfahrten durch Nordeuropa erlangt.“"
                                            },
                                            {
                                                "example_id": "5ccaad8c-f013-4145-8cb3-a0d87497c3d6",
                                                "sense_id": "e4c27a98-302f-3f3c-b291-90e067543223",
                                                "text": "„Viele Besucher des Nordkaps beginnen ihren Landausflug in Honningsvag, weshalb sich der Ort auf die vielen Touristen eingestellt hat.“"
                                            },
                                            {
                                                "example_id": "16c1f1ed-092e-4b4b-aeb7-cb6ae1f8e645",
                                                "sense_id": "e4c27a98-302f-3f3c-b291-90e067543223",
                                                "text": "„Wer das 32 Kilometer entfernte Nordkap besuchen möchte, ist auf alternative Verkehrsmittel angewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
