                    ]
                },
                {
                    "sense_id": "f37d359a-9907-30c6-a5ac-ddaf318d42bb",
                    "sense_definition": "leitet einen Relativsatz ein und bezieht sich auf ein zuvor genanntes Nomen im Femininum Singular oder im Plural",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ärztin, <w>welche</w> die Untersuchung durchgeführt hat, war sehr freundlich und aufmerksam."
