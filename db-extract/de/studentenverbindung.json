                        "sense_id": "d49956c7-64a5-372d-9025-a8bacc8a1948",
                        "entry_id": "53efb3b1-9f2a-35fb-be25-c45ff9ebe602",
                        "glosses": [
                            "Vereinigung von derzeitigen und ehemaligen Studenten einer Universität oder Hochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00c9214-ef6d-42a9-9acd-92471e64b5bc",
                                "sense_id": "d49956c7-64a5-372d-9025-a8bacc8a1948",
                                "text": "Es gibt immer noch viele schlagende Studentenverbindungen."
                            },
                            {
                                "example_id": "5c106033-5b26-45ff-a442-9aa1b2de5699",
                                "sense_id": "d49956c7-64a5-372d-9025-a8bacc8a1948",
                                "text": "„Er tritt einer Studentenverbindung bei, die fortan eine Art Familienersatz wird.“"
                            },
                            {
                                "example_id": "a1957109-7d30-425b-bd3a-9037c8db9b89",
                                "sense_id": "d49956c7-64a5-372d-9025-a8bacc8a1948",
                                "text": "„Thomas war dem viel älteren Wiedel 1929 in einer nichtschlagenden Studentenverbindung begegnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
