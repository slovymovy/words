                                "target_senses": [
                                    {
                                        "sense_id": "95812dcb-5bb2-3da9-a3d1-a98667b7f24d",
                                        "entry_id": "1432cd29-8ae4-3537-972a-8a359efc1c3d",
                                        "glosses": [
                                            "The plebeian class of Ancient Rome."
                                        ],
                                        "tags": [
                                            "historical",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03b950a5-c254-40a3-817d-6d8f2fef0b41",
                                                "sense_id": "95812dcb-5bb2-3da9-a3d1-a98667b7f24d",
                                                "text": "Why I am going with my pidgeons to the tribunall Plebs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a791654-2755-3a33-96da-99f932765040",
                                        "entry_id": "1432cd29-8ae4-3537-972a-8a359efc1c3d",
                                        "glosses": [
                                            "The common people, especially (derogatory) the mob."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b66106e-e2fe-4c3f-848f-bc6af16e8c49",
                                                "sense_id": "0a791654-2755-3a33-96da-99f932765040",
                                                "text": "For 'tis an Easier Thing\nTo make Trees Leape, and Stones selfe-burthens bring\n(As once Amphion to the walls of Thæbes,)"
                                            },
                                            {
                                                "example_id": "5f1b8437-824f-40e6-b47f-566656dd29a2",
                                                "sense_id": "0a791654-2755-3a33-96da-99f932765040",
                                                "text": "1993, Max Cavalera, \"Refuse/Resist\", Sepultura, Chaos A.D.\nChaos A.D. / Tanks On The Streets / Confronting Police / Bleeding The Plebs"
                                            },
                                            {
                                                "example_id": "3541b64c-d425-4510-a25a-2a21c99621da",
                                                "sense_id": "0a791654-2755-3a33-96da-99f932765040",
                                                "text": "The history of Palermo was punctuated by such uprisings; when they happened, the great barons simply fled to the safety of their country villas, leaving the urban plebs free to sack their palaces in the city."
                                            },
                                            {
                                                "example_id": "adb0cd2d-9d7f-4ec3-ad9b-aff69087f040",
                                                "sense_id": "0a791654-2755-3a33-96da-99f932765040",
                                                "text": "The lesser plebs are not unscrupulous troublemakers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
