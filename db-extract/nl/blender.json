                                            {
                                                "example_id": "c98c436b-940a-4f87-bdc7-1ccc1808e5bf",
                                                "sense_id": "ac2c3394-550e-36c6-a81f-c7cedd29992a",
                                                "text": "A blender is added to a wig in the same way that a quick front is added. It can be added at the same time as the fronting lace is added or after the wig is completed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db06400b-3e60-384b-bf12-73f40e478ce1",
