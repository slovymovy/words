                "senses": [
                    {
                        "sense_id": "a2675031-55c3-3b8f-bf82-50e7a5a9360e",
                        "entry_id": "8a03e5c6-cbdc-395d-825f-4ea54eb44646",
                        "glosses": [
                            "code"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "09c367cb-e1cf-4696-9801-3f544fa1d873",
                                "sense_id": "a2675031-55c3-3b8f-bf82-50e7a5a9360e",
                                "text": "По про́сьбе Спера́нского он взял пе́рвую часть составля́емого гражда́нского уложе́ния и, с по́мощию Code Napoléon и Justiniani, рабо́тал над составле́нием отде́ла: Права лиц.",
                                "translation": "At Speránski's request he took the first part of the Civil Code that was being drawn up and, with the aid of the Code Napoleon and the Institutes of Justinian, he worked at formulating the section on Personal Rights.",
                                "english": "At Speránski's request he took the first part of the Civil Code that was being drawn up and, with the aid of the Code Napoleon and the Institutes of Justinian, he worked at formulating the section on Personal Rights."
                            }
                        ]
                    }
                ],
