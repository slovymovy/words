                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58356e8b-0295-4179-b8df-720dae2bdb45",
                                "sense_id": "305130f4-379e-3e69-b745-97caeea7101e",
                                "text": "Le monomoteur AS 350 Écureuil est réputé pour ses performances élevées, sa sécurité et ses faibles coûts d’exploitation."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ddb3ba4-a53f-3faf-b291-983dbbc6f99b",
