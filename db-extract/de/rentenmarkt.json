                "senses": [
                    {
                        "sense_id": "0188574a-3572-3133-819e-bab432066827",
                        "entry_id": "6422562c-adbb-37e3-85bb-50652a9f6b0a",
                        "glosses": [
                            "Markt für Schuldverschreibungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a3515d-09e3-4a0c-b427-fae8c9443452",
                                "sense_id": "0188574a-3572-3133-819e-bab432066827",
                                "text": "Am Rentenmarkt werden Wertpapiere gehandelt, die im Normalfall regelmäßige Zinszahlungen (Rente) versprechen."
                            },
                            {
                                "example_id": "478025fb-740c-40c5-b4db-ba3d1a75a426",
                                "sense_id": "0188574a-3572-3133-819e-bab432066827",
                                "text": "Trotz der Bezeichnung werden am Rentenmarkt auch Schuldverschreibungen gehandelt, deren Zinszahlung an den Zeichner (Anleger) nicht regelmäßig, sondern endfällig erfolgt – das heißt, als einmalige Zahlung am Ende der Laufzeit der Schuldverschreibung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
