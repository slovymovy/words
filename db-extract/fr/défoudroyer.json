                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860574bc-15f3-4ba4-80f0-a21c645025f4",
                                "sense_id": "08e43ed1-b281-3ed5-a4a9-c7e0eb8eea00",
                                "text": "Je marche en la fraîcheur de l’expirant orage, Moi-même comme qui dirait défoudroyé."
                            },
                            {
                                "example_id": "46686da1-2ea1-4933-8f41-6ef901d677a6",
                                "sense_id": "08e43ed1-b281-3ed5-a4a9-c7e0eb8eea00",
                                "text": "Elle l’a défoudroyé."
                            },
                            {
                                "example_id": "e6937bdb-c521-4799-ae40-47230d62cb75",
                                "sense_id": "08e43ed1-b281-3ed5-a4a9-c7e0eb8eea00",
                                "text": "Tu vois, t’es défoudroyé par l’amour, c’est fou hein."
                            },
                            {
                                "example_id": "d5b8e3a8-60c5-4955-8ff8-97440c2cf10c",
                                "sense_id": "08e43ed1-b281-3ed5-a4a9-c7e0eb8eea00",
                                "text": "Afin que le foudroyé, ayant honte de son damnable état, rentre en soi-même, se repente et fasse toutes les cérémonies nécessaires, toutes les manœuvres requises pour se défoudroyer."
                            }
                        ]
