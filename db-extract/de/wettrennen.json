                ],
                "senses": [
                    {
                        "sense_id": "ebc1dc41-73d6-3d65-b08f-1ad3a7c6d623",
                        "entry_id": "2354d37d-aa19-3b02-97b5-fdee34fb4e2e",
                        "glosses": [
                            "Wettkampf, der als Laufwettbewerb oder mit Fahrzeugen ausgetragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ecd291d-08ae-4cd9-bbcb-06e8e63d10af",
                                "sense_id": "ebc1dc41-73d6-3d65-b08f-1ad3a7c6d623",
                                "text": "„Wir machten Wettrennen auf dem Gartenweg und waren mal Teilnehmer und mal Schiedsrichter.“"
                            },
                            {
                                "example_id": "3d904bac-a011-489a-962c-d6cbabb17564",
                                "sense_id": "ebc1dc41-73d6-3d65-b08f-1ad3a7c6d623",
                                "text": "„Nichts, wenn man es überlegt, kann dazu verlocken, in einem Wettrennen der erste sein zu wollen.“"
                            },
                            {
                                "example_id": "fe93d67f-ee1b-4d26-9926-2208e1729c67",
                                "sense_id": "ebc1dc41-73d6-3d65-b08f-1ad3a7c6d623",
                                "text": "„Jetzt, als stolzer Ponybesitzer, lieferte er sich Wettrennen mit seiner Schwester, die sich weiterhin kutschieren ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
