                        "zh": [
                            {
                                "target_lang_word": "斯皮尔斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Spears",
                                "target_lang_sense_clarification": "apellido propio"
                            }
                        ]
