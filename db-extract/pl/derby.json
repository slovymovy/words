                                    {
                                        "sense_id": "99344759-bdd9-36de-87b2-89e1e157cac0",
                                        "entry_id": "2e29bc08-eb8d-3ed4-a7e2-606325e92421",
                                        "glosses": [
                                            "A bowler hat."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdecda7d-e96a-411f-a992-88c55225fda3",
                                                "sense_id": "99344759-bdd9-36de-87b2-89e1e157cac0",
                                                "text": "He began to fan her with his hat. That was successful, for he struck her nose with the brim of his derby and she opened her eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24cceb4-7ca2-3f21-8856-190fe72af1ad",
                                        "entry_id": "2e29bc08-eb8d-3ed4-a7e2-606325e92421",
                                        "glosses": [
                                            "A sports match between rival teams."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9a8f65a-d5a6-35ff-a8ce-5a3f57157f9e",
                                        "entry_id": "2e29bc08-eb8d-3ed4-a7e2-606325e92421",
                                        "glosses": [
                                            "A local derby."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1015b936-92ad-498b-b832-ba96b3b879dc",
                                                "sense_id": "b9a8f65a-d5a6-35ff-a8ce-5a3f57157f9e",
                                                "text": "Defeat sees Forest remain a point outside the top six with a derby against Leicester up next."
                                            },
                                            {
                                                "example_id": "ae0f77f8-f876-4e6a-98f5-df627efd54b8",
                                                "sense_id": "b9a8f65a-d5a6-35ff-a8ce-5a3f57157f9e",
                                                "text": "The left-back had been a selection concern because of an injury niggle but his first goal since last March swung this derby decisively in United’s favour, extending their club record unbeaten run away from home in the Premier League to 22 games and torpedoing City’s sequence of 21 straight wins in all competitions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a9d96f8-81e3-47cc-96fd-4d3daa6f58fb",
