                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f4fd07f-6ea4-3402-b9ab-b0ae73425a6e",
                        "entry_id": "34eb6495-0ad4-3446-a066-5c77ad4d1e58",
                        "glosses": [
                            "Haltbarmachung von toten Tierkörpern, mit dem Ziel sie auszustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e214b39-9e7d-4155-aad7-d6a632567255",
                                "sense_id": "7f4fd07f-6ea4-3402-b9ab-b0ae73425a6e",
                                "text": "„Als er mit Claire Bloom zusammen war, lebte er in London, New York und Connecticut und verbrachte mehrere Wochen in Israel, um für ›Counterlife‹ und ›Operation Shylock‹ zu recherchieren, und in späteren Jahren reiste er, wann und wohin er wollte, um etwas über Taxidermie, die Herstellung von Handschuhen oder das Ausheben von Gräbern zu erfahren; er unternahm sogar eine Lesereise (mit ›Patrimony‹), um auch dies einmal kennenzulernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96fc2362-287a-4d53-a346-7a570707596e",
                        "source_entry_id": "34eb6495-0ad4-3446-a066-5c77ad4d1e58",
                        "source_sense_id": "7f4fd07f-6ea4-3402-b9ab-b0ae73425a6e",
                        "source_sense_description": "Haltbarmachung von toten Tierkörpern, mit dem Ziel sie auszustellen",
                        "target_lang_word": "taxidermy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxidermy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48835f01-39bd-35da-be92-4ef995cc2411",
                                        "entry_id": "09763564-0401-31e5-82a3-51e74c0a6681",
                                        "glosses": [
                                            "The art of stuffing and mounting the skins of dead animals for exhibition in a lifelike state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "taxidermy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab8b95b6-fcae-3807-9f01-311059e9d24b",
                                        "entry_id": "6157d48a-d15a-34b6-83e1-6fd8cbcaa30e",
                                        "glosses": [
                                            "To stuff and mount the skin of a dead animal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb074420-c0d9-4e4f-8558-4da859d8841f",
                                                "sense_id": "ab8b95b6-fcae-3807-9f01-311059e9d24b",
                                                "text": "Today's taxidermying is a combination of field work, calipers and Rodin. The hunters who get the animals for the leading museums of natural science bring 'em back dead, but measured within an inch of their lives […]"
                                            },
                                            {
                                                "example_id": "dcadc1eb-cd2c-4d7c-8bef-8b4042c27be2",
                                                "sense_id": "ab8b95b6-fcae-3807-9f01-311059e9d24b",
                                                "text": "It is indeed true that in recent years the business of taxidermying cats and dogs for mourning owners has blossomed into some form of art, especially in the United States."
                                            },
                                            {
                                                "example_id": "5b79be35-2129-48a8-8ae9-feedba7fa642",
                                                "sense_id": "ab8b95b6-fcae-3807-9f01-311059e9d24b",
                                                "text": "Even when mounted in the context of animal-centric conferences or events, exhibits of “animal art” routinely display works consisting of animal parts or taxidermied animals—most of which can be viewed while people are eating their politically correct vegan lunch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc3b6238-86aa-4c4d-a60f-818ad5820c46",
                        "source_entry_id": "34eb6495-0ad4-3446-a066-5c77ad4d1e58",
                        "source_sense_id": "7f4fd07f-6ea4-3402-b9ab-b0ae73425a6e",
                        "source_sense_description": "Haltbarmachung von toten Tierkörpern, mit dem Ziel sie auszustellen",
                        "target_lang_word": "taxidermie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxidermie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ecd3a88-92cd-31c9-a853-9e69dbf5629d",
                                        "entry_id": "8c3793dd-c8e1-3eb5-85cc-a947a93ebffb",
                                        "glosses": [
                                            "Art visant à préserver et reconstituer l’enveloppe externe d’un animal mort (peau, plumes, pelage) afin de lui donner une posture réaliste à des fins scientifiques, décoratives ou pédagogiques."
                                        ],
                                        "tags": [
                                            "Muséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7136e3-272e-4ac0-b500-a85c94b33253",
                                                "sense_id": "3ecd3a88-92cd-31c9-a853-9e69dbf5629d",
                                                "text": "Depuis son origine (XVIIIᵉ siècle), la taxidermie montre une grande variété techniques dans les différentes opérations conduisant d'un individu vivant à la réalisation d'un spécimen naturalisé."
                                            },
                                            {
                                                "example_id": "01f77881-ce5d-4172-acea-8d393060997a",
                                                "sense_id": "3ecd3a88-92cd-31c9-a853-9e69dbf5629d",
                                                "text": "La taxidermie est un art à part entière, aussi nommé empaillage ou naturalisation. Il nous est tous arrivé, dans un musée, de contempler avec fascination des animaux naturalisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc460e36-bffe-3e80-b7c8-44dffea5012f",
                                        "entry_id": "8c3793dd-c8e1-3eb5-85cc-a947a93ebffb",
                                        "glosses": [
                                            "Action de conserver artificiellement une apparence vivante ou authentique à ce qui est en réalité figé, mort ou vidé de sa substance."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d6965c-20a8-45a4-b191-3d9a318b5e3c",
                                                "sense_id": "dc460e36-bffe-3e80-b7c8-44dffea5012f",
                                                "text": "Des deux côtés, les façades des immeubles paraissaient neuves, comme recouvertes d’un enduit ou d’une pellicule de cellophane d’un blanc qui avait effacé les fissures et les taches du passé. Et, derrière, en profondeur, on avait dû se livrer à une taxidermie qui achevait de faire le vide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
