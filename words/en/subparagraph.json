{
    "word_family": [
        "paragraph"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b94fde93-21fd-32b8-a0df-b70bc2a050ac",
                    "sense_definition": "A subdivision or part of a paragraph that can be considered separately, commonly found in legal or formal documents.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "document_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please refer to the terms outlined in <w>subparagraph</w> b of the contract.",
                            "target_lang_translations": {
                                "es": "Por favor, consulte los términos detallados en el <w>subpárrafo</w> b del contrato."
                            }
                        },
                        {
                            "text": "The lawyer argued that the third <w>subparagraph</w> was not clear enough.",
                            "target_lang_translations": {
                                "es": "El abogado argumentó que el tercer <w>inciso</w> no era suficientemente claro."
                            }
                        }
                    ],
                    "synonyms": [
                        "subclause"
                    ],
                    "common_phrases": [
                        "in subparagraph",
                        "the following subparagraph"
                    ],
                    "target_lang_definitions": {
                        "es": "Subdivisión o parte de un párrafo que se puede considerar por separado, común en documentos formales o legales."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "subpárrafo",
                                "target_lang_sense_clarification": "división formal o legal de un párrafo"
                            },
                            {
                                "target_lang_word": "inciso",
                                "target_lang_sense_clarification": "en textos legales o normativos"
                            },
                            {
                                "target_lang_word": "subapartado",
                                "target_lang_sense_clarification": "sección secundaria dentro de un apartado"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b84aae0a-764d-3698-afc5-3005231b9530",
                    "sense_definition": "To divide text or a document into subparagraphs.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "document_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>subparagraph</w> the lengthy policy to improve readability.",
                            "target_lang_translations": {
                                "es": "El comité decidió <w>dividir en subpárrafos</w> la extensa política para mejorar la legibilidad."
                            }
                        },
                        {
                            "text": "He meticulously <w>subparagraphed</w> each section of the legal agreement.",
                            "target_lang_translations": {
                                "es": "Él <w>subdividió en incisos</w> meticulosamente cada sección del acuerdo legal."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Dividir un texto o documento en subpárrafos o incisos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "dividir en subpárrafos",
                                "target_lang_sense_clarification": "organizar el texto en subpárrafos"
                            },
                            {
                                "target_lang_word": "subdividir en incisos",
                                "target_lang_sense_clarification": "en redacción jurídica o formal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}