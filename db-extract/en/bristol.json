                                            {
                                                "example_id": "aa695d00-773e-40a2-9127-5e6baf409cf9",
                                                "sense_id": "5e1fbb2b-dbb1-3176-a3ef-05a53bba07eb",
                                                "text": "À l’époque, Harald Bristol, originaire de Trondheim (Norvège), avait vingt-deux ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bristol",
                                "target_lang_code": "fr",
                                "target_senses": [
