                            {
                                "target_lang_word": "indeterminato",
                                "target_lang_sense_clarification": "riferito a concetti matematici o spaziali senza limiti"
                            },
                            {
                                "target_lang_word": "illimitato",
                                "target_lang_sense_clarification": "riferito a uno spazio che sembra non avere confini"
