                "senses": [
                    {
                        "sense_id": "92ee88ea-8850-3144-8952-ad7b66c30270",
                        "entry_id": "a2d9be84-36bf-3ff7-8fe9-2a841be92314",
                        "glosses": [
                            "Espace de stationnement réservé à la dépose rapide de passagers, le véhicule repartant immédiatement après."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df06d5c5-182f-43f1-9606-2fa8b5c9497b",
                                "sense_id": "92ee88ea-8850-3144-8952-ad7b66c30270",
                                "text": "On a donc eu l’idée de proposer un dépose-minute devant l’école."
                            },
                            {
                                "example_id": "5b05ac9d-d463-4393-be8e-eee5451a3a42",
                                "sense_id": "92ee88ea-8850-3144-8952-ad7b66c30270",
                                "text": "Heureusement, la situation s'éclaircit quand nous nous rapprochâmes de la dépose-minute. Là, il fallait rester concentré, ne pas perdre la balle des yeux. La dépose-minute consistait en une zone de stationnement gardée par deux barrières."
                            },
                            {
                                "example_id": "3d42d276-4d84-4edf-ada9-42302426482e",
                                "sense_id": "92ee88ea-8850-3144-8952-ad7b66c30270",
                                "text": "Devant la dépose-minute, une multitude de taxis attendent les touristes. Je monte dans le premier disponible."
                            },
                            {
                                "example_id": "1f28296f-9719-4149-87b2-c7b70d92ae91",
                                "sense_id": "92ee88ea-8850-3144-8952-ad7b66c30270",
                                "text": "Pôle d'échanges multimodal de la gare de Poitiers, accueillant une gare routière, un dépose-minute ainsi qu’un tout nouveau parking de 700 places."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf8cfd5-9208-3a27-8efe-7d369568b086",
                        "entry_id": "a2d9be84-36bf-3ff7-8fe9-2a841be92314",
                        "glosses": [
                            "Lieu fictif de délaissement temporaire d'une activité principale pour s'occuper d'affaires censées ne pas être de son niveau."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1d419bd9-bc55-47b2-a7e6-c695062beb3d",
                                "sense_id": "fcf8cfd5-9208-3a27-8efe-7d369568b086",
                                "text": "(…) il a garé au dépose-minute le char de l’État qu’il est censé conduire 24 h/24 pour aller déguster des crêpes avec ses petits camarades de province, du coup tout ragaillardis (…)"
                            }
                        ]
                    }
