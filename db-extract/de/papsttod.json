                "senses": [
                    {
                        "sense_id": "400065c0-463d-3eb9-96f4-58f3344f771a",
                        "entry_id": "90b2f9d8-d010-352f-b2c7-34bc9fdbdb2e",
                        "glosses": [
                            "Ableben des Oberhaupts der römisch-katholischen Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e539baa-0a1e-414a-a803-90b8a641c882",
                                "sense_id": "400065c0-463d-3eb9-96f4-58f3344f771a",
                                "text": "„Die Sedisvakanz zwischen Papsttod und Neuwahl stellt ein Machtvakuum dar, das in jeder schlüssigen Staatstheorie für Monarchien nicht vorgesehen ist.“"
                            },
                            {
                                "example_id": "9be15f5b-e364-4479-bf06-db69b9987096",
                                "sense_id": "400065c0-463d-3eb9-96f4-58f3344f771a",
                                "text": "„Als Johannes XXIII. starb, formierte sich erstmals ein Kanon für Medienberichterstattung zum Papsttod.“"
                            },
                            {
                                "example_id": "09eba7e6-fd42-4ed7-b89d-4c103cac30ef",
                                "sense_id": "400065c0-463d-3eb9-96f4-58f3344f771a",
                                "text": "„Wenn zum Beispiel ein Papst in der Nacht entschläft und erst am folgenden Morgen entdeckt wird, daß der Papst gestorben ist, endet das Papstamt erst mit der kirchlichen Feststellung und Verkündung des Papsttodes.“"
                            },
                            {
                                "example_id": "22ab061f-4f1e-481e-b19b-ed20ddf8d947",
                                "sense_id": "400065c0-463d-3eb9-96f4-58f3344f771a",
                                "text": "„Der Vize-Camerlengo übernimmt insbesondere während der Zeit der Sedisvakanz nach einem Papsttod besondere Aufgaben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
