                        "sense_id": "ec4b41bd-3ddf-3128-b794-fd93f8302006",
                        "entry_id": "cf6d2592-5d40-3510-a3f3-86270cb6c4a7",
                        "glosses": [
                            "französischer Fahrzeughersteller"
                        ],
