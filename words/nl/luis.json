                {
                    "sense_id": "62bde942-6a4e-3918-9201-57eca60b169c",
                    "sense_definition": "Een klein, meestal vleugelloos insect dat als parasiet op mensen, dieren of planten leeft.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De school waarschuwde de ouders dat er een <w>luis</w> in de klas was gevonden.",
                            "target_lang_translations": {
                                "en": "The school warned the parents that a <w>louse</w> had been found in the class.",
                                "ru": "Школа предупредила родителей, что в классе была найдена <w>вошь</w>.",
                                "fr": "L'école a averti les parents qu'un <w>pou</w> avait été trouvé dans la classe."
                            }
                        },
                        {
                            "text": "Hij is een echte <w>luis</w> in de pels voor het bestuur van de vereniging.",
                            "target_lang_translations": {
                                "en": "He is a real <w>gadfly</w> to the association's board.",
                                "ru": "Он настоящая <w>заноза</w> для правления ассоциации.",
                                "fr": "Il est une vraie <w>épine dans le pied</w> pour le conseil d'administration de l'association."
                            }
                        }
                    ],
                    "common_phrases": [
                        "luis in de pels",
                        "zo kaal als een luis",
                        "leven als een luis op een zeer hoofd"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, usually wingless insect that lives as a parasite on humans, animals, or plants.",
                        "ru": "Маленькое, обычно бескрылое насекомое, которое живет как паразит на людях, животных или растениях.",
                        "fr": "Un petit insecte, généralement sans ailes, qui vit en parasite sur les humains, les animaux ou les plantes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "louse",
                                "target_lang_sense_clarification": "parasitic insect"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вошь",
                                "target_lang_sense_clarification": "паразит на людях и животных"
                            },
                            {
                                "target_lang_word": "тля",
                                "target_lang_sense_clarification": "паразит на растениях"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pou",
                                "target_lang_sense_clarification": "insecte parasite"
                            },
                            {
                                "target_lang_word": "puceron",
                                "target_lang_sense_clarification": "parasite des plantes"
                            }
                        ]
                    }
                }
            ]
        },
