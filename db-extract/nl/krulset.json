                        "glosses": [
                            "een verzameling rollers die je kunt gebruiken om krullen in stijl haar te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80307e85-f993-41c3-9112-a5ed954bc13d",
                                "sense_id": "7ace525f-6e7f-3aa5-b217-d019ac7df670",
                                "text": "Wil je toch gaan voor krullen of slag? Gebruik dan eens de stijltang om krullen te maken. Die blijven enorm lang zitten. Veel en veel langer dan die je met een krulset of krultang maakt. Het is even oefenen, maar het resultaat is er zeker naar. Binnenkort zal ik jullie laten zien hoe je dit moet doen. Het is echt geweldig!"
                            },
                            {
                                "example_id": "09cde702-300f-4a24-ad59-4906c9e1eeda",
                                "sense_id": "7ace525f-6e7f-3aa5-b217-d019ac7df670",
                                "text": "Maar hoe weet je wat je het beste kunt kopen? Welke wasmachine, digitale camera, dvd-speler of krulset? Veel mensen stappen naar een winkel waarin ze vertrouwen hebben, laten zich voorlichten en stappen even later met een kartonnen doos de winkel uit."
                            }
                        ]
                    }
