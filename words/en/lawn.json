{
    "word_family": [
        "lawny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25ba12ca-130a-3c6b-9ae2-f576f5169e72",
                    "sense_definition": "Ground (generally in front of or around a house) covered with grass kept closely mown.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grass_ground",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He mows the <w>lawn</w> every Saturday morning during the summer.",
                            "target_lang_translations": {
                                "ru": "Летом он стрижет <w>газон</w> каждое субботнее утро.",
                                "zh": "夏天他每周六早上都会去<w>修剪草坪</w>。"
                            }
                        },
                        {
                            "text": "The children played soccer on the front <w>lawn</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли в футбол на <w>лужайке</w> перед домом.",
                                "zh": "孩子们在屋前的<w>草坪</w>上踢足球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yard",
                        "grass",
                        "turf"
                    ],
                    "common_phrases": [
                        "mow the lawn",
                        "front lawn",
                        "back lawn",
                        "manicured lawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли (обычно перед домом или вокруг него), покрытый коротко подстриженной травой.",
                        "zh": "指房屋周围或前方种植并修剪整齐的草地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газон",
                                "target_lang_sense_clarification": "ухоженная трава"
                            },
                            {
                                "target_lang_word": "лужайка",
                                "target_lang_sense_clarification": "небольшой участок с травой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草坪",
                                "target_lang_sense_clarification": "人工修剪的草地"
                            },
                            {
                                "target_lang_word": "草地",
                                "target_lang_sense_clarification": "一般的草地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "704b5910-3db0-33fe-bc6c-e302d720ca7c",
                    "sense_definition": "A type of fine, thin linen or cotton fabric.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a delicate dress made of white <w>lawn</w>.",
                            "target_lang_translations": {
                                "ru": "На ней было изящное платье из белого <w>батиста</w>.",
                                "zh": "她穿了一件用白色<w>巴里纱</w>做的精致连衣裙。"
                            }
                        },
                        {
                            "text": "He wiped his forehead with a sheer <w>lawn</w> handkerchief.",
                            "target_lang_translations": {
                                "ru": "Он вытер лоб платком из тонкого <w>батиста</w>.",
                                "zh": "他用一条薄薄的<w>巴里纱</w>手帕擦了擦额头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "linen",
                        "cambric"
                    ],
                    "common_phrases": [
                        "lawn handkerchief",
                        "lawn sleeves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид тонкой льняной или хлопчатобумажной ткани.",
                        "zh": "一种质地细薄的棉织物或亚麻织物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "батист",
                                "target_lang_sense_clarification": "ткань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴里纱",
                                "target_lang_sense_clarification": "一种细薄的棉织物"
                            },
                            {
                                "target_lang_word": "细麻布",
                                "target_lang_sense_clarification": "细薄的亚麻织物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3baa909-1a6e-3f59-bab1-8c5e2ffc1b95",
                    "sense_definition": "An overgrown agar culture where colonies have merged into a continuous layer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bacteria formed a dense <w>lawn</w> across the surface of the petri dish.",
                            "target_lang_translations": {
                                "ru": "Бактерии образовали плотный <w>газон</w> на поверхности чашки Петри.",
                                "zh": "细菌在培养皿表面形成了一层致密的<w>菌苔</w>。"
                            }
                        },
                        {
                            "text": "Scientists observed a clear zone in the bacterial <w>lawn</w> around the antibiotic.",
                            "target_lang_translations": {
                                "ru": "Ученые наблюдали чистую зону в бактериальном <w>газоне</w> вокруг антибиотика.",
                                "zh": "科学家观察到抗生素周围的<w>菌苔</w>出现了一个透明圈。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bacterial lawn"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (microbiology)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплошной слой бактериальных колоний, выросший на поверхности питательной среды.",
                        "zh": "微生物学中，在培养基表面生长成连续覆盖层的细菌菌落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газон",
                                "target_lang_sense_clarification": "бактериальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菌苔",
                                "target_lang_sense_clarification": "微生物学专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "055ab9d1-d740-3ba6-96aa-8b18c1c8088b",
                    "sense_definition": "An open space between woods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They emerged from the dark forest into a sunlit <w>lawn</w>.",
                            "target_lang_translations": {
                                "ru": "Они вышли из темного леса на залитую солнцем <w>поляну</w>.",
                                "zh": "他们从阴暗的森林里走出来，来到了一片阳光明媚的<w>林中空地</w>。"
                            }
                        },
                        {
                            "text": "Deer often graze in the quiet <w>lawn</w> hidden within the trees.",
                            "target_lang_translations": {
                                "ru": "Олени часто пасутся на тихой <w>поляне</w>, скрытой среди деревьев.",
                                "zh": "鹿群经常在树林间那片安静的<w>草地</w>上吃草。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glade",
                        "clearing"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытое пространство в лесу.",
                        "zh": "森林中开阔的空地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поляна",
                                "target_lang_sense_clarification": "открытое место в лесу"
                            },
                            {
                                "target_lang_word": "прогалина",
                                "target_lang_sense_clarification": "просвет в лесу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "林中空地",
                                "target_lang_sense_clarification": "森林里的开阔地"
                            },
                            {
                                "target_lang_word": "草地",
                                "target_lang_sense_clarification": "自然形成的开阔草地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea2d4ff8-ec85-3f9e-b4c6-0f53a36006b7",
                    "sense_definition": "To furnish or cover an area with a lawn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landscapers decided to <w>lawn</w> the inner courtyard to make it more inviting.",
                            "target_lang_translations": {
                                "ru": "Ландшафтные дизайнеры решили <w>засеять газоном</w> внутренний дворик, чтобы сделать его более уютным.",
                                "zh": "景观设计师决定在内院<w>铺设草坪</w>，使其看起来更舒适。"
                            }
                        },
                        {
                            "text": "After the construction was finished, they <w>lawned</w> the area around the new building.",
                            "target_lang_translations": {
                                "ru": "После завершения строительства они <w>разбили газон</w> на территории вокруг нового здания.",
                                "zh": "施工结束后，他们在新建大楼周围<w>种上了草坪</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Засеивать или покрывать участок газоном.",
                        "zh": "在某处铺设或种植草坪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засеивать газоном",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "разбивать газон",
                                "target_lang_sense_clarification": "создавать газон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺设草坪",
                                "target_lang_sense_clarification": "园艺动作"
                            },
                            {
                                "target_lang_word": "种草",
                                "target_lang_sense_clarification": "种植草坪"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1796dd71-e4d0-3f74-b4c0-e590e4c044a6",
                    "sense_definition": "A town or community in Canada or the United States.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited the small town of <w>Lawn</w> during our trip to Newfoundland.",
                            "target_lang_translations": {
                                "ru": "Мы посетили маленький городок <w>Лон</w> во время нашей поездки в Ньюфаундленд.",
                                "zh": "我们在去纽芬兰旅行时参观了<w>朗</w>这个小镇。"
                            }
                        },
                        {
                            "text": "He grew up in <w>Lawn</w>, Texas, before moving to the city.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Лоне</w>, штат Техас, прежде чем переехать в большой город.",
                                "zh": "他在搬到大城市之前，是在德克萨斯州的<w>朗</w>长大的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город или община в Канаде или США.",
                        "zh": "美国或加拿大境内的城镇或社区名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лон",
                                "target_lang_sense_clarification": "название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朗",
