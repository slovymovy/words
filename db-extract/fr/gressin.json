                        "entry_id": "c8bea429-341e-32b5-bf77-3a8b98dab02b",
                        "glosses": [
                            "Petit pain allongé, sec et friable, pouvant se conserver plusieurs semaines, originaire de la région de Turin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e64138e-1436-4358-b8aa-d42f5eee0345",
                                "sense_id": "f6213add-b272-3d45-99ea-4f17627677bf",
                                "text": "Après une anchoïade servie avec son fagot de gressins torsadés … suivit une pleine assiettée de scattoni au jambon cru arrosée d'un Lacryma Christi rosso."
                            },
                            {
                                "example_id": "d80f97a7-1085-47b9-9e9e-d4faac8d4d56",
                                "sense_id": "f6213add-b272-3d45-99ea-4f17627677bf",
                                "text": "Entre mes dents de sagesse, le gressin fait un bruit de neige que l'on tasse en marchant."
                            }
                        ]
                    }
                ],
