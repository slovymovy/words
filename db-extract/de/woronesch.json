                                "example_id": "99d997cd-f294-4276-b29e-adcb706f9337",
                                "sense_id": "59dd97a4-76e9-3d67-8684-397bc7e96049",
                                "text": "„Anfang des 20. Jahrhunderts gab es in Europa nur noch fünf natürliche Bibervorkommen: in Frankreich und Norwegen, in Weißrussland und im europäischen Teil Russlands in Woronesch. In Deutschland überlebte allein in Sachsen-Anhalt eine kleine Population heimischer Elbebiber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
