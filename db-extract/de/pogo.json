                    {
                        "translation_id": "d9cc7a1a-31f7-4f7f-8d36-45465d1d2dc7",
                        "source_entry_id": "dc0170e2-16d1-3694-a318-033a57dd7185",
                        "source_sense_id": "6d113d67-fb45-315d-aa78-e14281772558",
                        "source_sense_description": "Punk-Kultur: unkoordiniert wirkender Tanz",
                        "target_lang_word": "pogo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pogo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9be6c8e-3cf5-3ed9-85ac-88609f00836d",
                                        "entry_id": "85843b54-87ac-30e1-a7b4-5cc5f3141bfc",
                                        "glosses": [
                                            "Danse et bousculade lors de concerts de rock où tout le monde saute et se pousse les uns contre les autres."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf53dd5-0c47-4ea6-a594-e8d67dd5d882",
                                                "sense_id": "f9be6c8e-3cf5-3ed9-85ac-88609f00836d",
                                                "text": "Gazo, nouvelle coqueluche du rap, aux 20 000 albums vendus, a d’abord voulu lancer un pogo, avant de se rétracter pour des raisons de sécurité."
                                            },
                                            {
                                                "example_id": "0f50f7ed-cb16-458a-8269-6e5398daa8c9",
                                                "sense_id": "f9be6c8e-3cf5-3ed9-85ac-88609f00836d",
                                                "text": "On était loin des pogos rageurs de mes concerts punks de jeunesse."
                                            },
                                            {
                                                "example_id": "30c34b08-54fb-4ec7-ad18-23a14cacb927",
                                                "sense_id": "f9be6c8e-3cf5-3ed9-85ac-88609f00836d",
                                                "text": "Elle entreprend une drôle de danse, qui tient du pogo et du swing en braillant à tue-tête: «L'air iodé, voilà ce qu'il me fallait.»"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pogo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "697aa6e8-0225-3da7-9077-13e3624a13bd",
                                        "entry_id": "4cf1e443-8287-3c43-b23e-8f0033950d2e",
                                        "glosses": [
                                            "Saucisse fumée enrobée de pâte à frire, le tout planté sur un bâtonnet avant la cuisson."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec5ee73-67c2-4fe5-815b-a6bf52291ab7",
                                                "sense_id": "697aa6e8-0225-3da7-9077-13e3624a13bd",
                                                "text": "Sans le vouloir, la parlementaire a contribué à associer la simplicité d’esprit à un mets de la cuisine rapide, la célèbre saucisse sur bâtonnet, mieux connue sous le nom de pogo…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f067eb88-eb5e-3a08-a072-f0bbdf9f2652",
                                        "entry_id": "4cf1e443-8287-3c43-b23e-8f0033950d2e",
                                        "glosses": [
                                            "Personne moyenne, John ou Jane Doe."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daf72245-e6be-450f-ba83-5ab77f7c7b7a",
                                                "sense_id": "f067eb88-eb5e-3a08-a072-f0bbdf9f2652",
                                                "text": "Ça prend pas le pogo le plus dégelé de la boîte pour comprendre qu’après avoir mis le feu dans la bâtisse, ce n’est pas un coup de peinture et des nouveaux rideaux qui vont changer les choses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
