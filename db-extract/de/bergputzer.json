                ],
                "senses": [
                    {
                        "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                        "entry_id": "bb10977c-0e0a-3ca8-983d-95d7c0bf76eb",
                        "glosses": [
                            "jemand, der die Felswände der Hausberge Salzburgs nach Gefahrenquellen absucht und diese beseitigt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "5faa2da7-99e1-4c04-8b64-3fbddbe73b16",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "Die Salzburger Bergputzer kontrollieren Mönchsberg, Kapuzinerberg und Co und sorgen für Sicherheit in der Stadt."
                            },
                            {
                                "example_id": "d1a76d9f-6ce9-4a88-bc17-914af9929692",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "Der Abbau von losen Felspartien an gefährdeten Stellen wird von den Bergputzern bewältigt."
                            },
                            {
                                "example_id": "0454ebdf-706c-4c64-9703-e7a4999edd9f",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "Der Job der Bergputzer der Stadt ist schon im Sommer nicht jedermanns Sache."
                            },
                            {
                                "example_id": "3700bc41-4b21-4c99-8188-3fba39f2e1fe",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "„Säuberten damals Bergknappen der Saline Hallein vom nahen Dürrnberg die Felswände der Stadt von lockeren Steinen, so sind die Bergputzer heute eine Institution, beinahe ein lebendes Kulturgut, angesiedelt im Magistrat der Stadt“, verrät Phillip Münch der Dienststellenleiter der Bergputzer."
                            },
                            {
                                "example_id": "6308d712-aead-42e8-bb9c-e97b11102fc6",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "„Bergputzer“ zum Beispiel sind keineswegs junge Burschen, die nächtens das Gebirge wienern, sondern sie haben einen sehr ernsthaften Job: An Seilen lassen sie sich an Steilwänden hinunter und entfernen dort loses Gestein und Geröll, um Steinschlag zu verhindern."
                            },
                            {
                                "example_id": "de7b61d4-248a-4309-aaef-c6b46753e306",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "Schierhuber: „Gute Bergputzer zu finden ist schwer. Der Beruf ist anstrengend, geht aufs Kreuz. Im Winter hängt man bei eisigen Temperaturen am Berg. Im Sommer ist es dafür der schönste Beruf Salzburgs.“"
                            },
                            {
                                "example_id": "9a156e54-bc34-48e5-b6dc-70ae75916a56",
                                "sense_id": "0123dadd-10dc-3a80-befd-0bac3cd001e9",
                                "text": "Filmteam und Bergputzer haben bei diesen Dreharbeiten tiefe Einblicke in die Arbeit der anderen bekommen. Es war für uns alle beindruckend, was die Bergputzer hier Tag für Tag unter oft schwierigsten Bedingungen leisten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
