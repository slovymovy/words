    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec3e7e5e-831d-3f81-92c5-ce9d65938308",
                    "sense_definition": "The state of being married; marriage as an institution.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marriage_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lived together in holy <w>matrimony</w> for over fifty years.",
                            "target_lang_translations": {
                                "tr": "Kutsal <w>evlilik</w> bağıyla elli yıldan fazla bir süre birlikte yaşadılar."
                            }
                        },
                        {
                            "text": "Many young couples choose to enter into <w>matrimony</w> after graduating from college.",
                            "target_lang_translations": {
                                "tr": "Birçok genç çift, üniversiteden mezun olduktan sonra <w>evlenmeyi</w> tercih ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "marriage",
                        "wedlock"
                    ],
                    "common_phrases": [
                        "holy matrimony",
                        "enter into matrimony"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Evli olma durumu; bir kurum olarak evlilik."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "evlilik",
                                "target_lang_sense_clarification": "karı koca olma durumu"
                            },
                            {
                                "target_lang_word": "nikâh",
                                "target_lang_sense_clarification": "evlilik birliği ve akdi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "689c1a30-4aab-30bf-9b3a-455f6d10a390",
                    "sense_definition": "The ceremony or rite of marriage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marriage_ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The holy <w>matrimony</w> was celebrated in the ancient village church.",
                            "target_lang_translations": {
                                "tr": "Kutsal <w>nikâh töreni</w> tarihi köy kilisesinde kutlandı."
                            }
                        },
                        {
                            "text": "Friends and family gathered from all over the world to witness the sacred <w>matrimony</w>.",
                            "target_lang_translations": {
                                "tr": "Kutsal <w>nikâha</w> tanıklık etmek için dünyanın dört bir yanından arkadaşlar ve aile toplandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "wedding",
                        "nuptials"
                    ],
                    "common_phrases": [
                        "holy matrimony"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or religious"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Evlenme töreni veya dini nikâh ayini."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nikâh",
                                "target_lang_sense_clarification": "evlenme töreni, dini veya resmi nikâh"
                            },
                            {
                                "target_lang_word": "düğün",
                                "target_lang_sense_clarification": "evlenme töreni ve kutlaması"
                            }
                        ]
                    }
                }
            ]
        }
