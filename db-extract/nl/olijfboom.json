                    {
                        "translation_id": "e6aea968-629d-4637-ad04-59a4d32d3375",
                        "source_entry_id": "dfa2e554-62ce-3dfe-a71d-19079e4a2ca9",
                        "source_sense_id": "7e30a84a-6f9b-3f05-943e-196779ddb5b2",
                        "source_sense_description": "een boom waaraan olijven groeien",
                        "target_lang_word": "olivier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olivier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac907498-590c-3a84-934f-d2caee1d9286",
                                        "entry_id": "18494102-fdf4-33b3-be19-4ca1c6d9d364",
                                        "glosses": [
                                            "Arbre de la famille des Oleaceae ou oléacées, dont le feuillage est toujours vert et qui porte les olives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a3da96-9dde-4a34-a27f-4b256690536e",
                                                "sense_id": "ac907498-590c-3a84-934f-d2caee1d9286",
                                                "text": "L’olivier serait originaire de Syrie où sa culture a été constatée au XVᵉ siècle av. J.-C. Après un passage en Grèce, il a été introduit en Italie puis en Provence par les Phocéens, vers 680 av. J.-C."
                                            },
                                            {
                                                "example_id": "4ae43ad8-2bad-40e5-a9a7-cabee6a753af",
                                                "sense_id": "ac907498-590c-3a84-934f-d2caee1d9286",
                                                "text": "Des landes, des rocs stériles, çà et là une bande de pâturage aromatique et dru, quelques champs pierreux, partout des oliviers : on se croirait dans notre Provence."
                                            },
                                            {
                                                "example_id": "fa290e5a-6917-473b-8960-cd5d8e2ed2ec",
                                                "sense_id": "ac907498-590c-3a84-934f-d2caee1d9286",
                                                "text": "La limite de l’Olivier, bien qu’artificielle, puisque c’est une plante cultivée, est la meilleure limite de la flore méditerranéenne en France."
                                            },
                                            {
                                                "example_id": "dc0743ce-93eb-406f-bac5-66c24a0c00bb",
                                                "sense_id": "ac907498-590c-3a84-934f-d2caee1d9286",
                                                "text": "Presque partout dans le département, l’abandon des campagnes a causé un recul de l’olivier et parfois même de la vigne, submergés par la croissance spontanée des pins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a386c60a-ce19-3e47-87f3-a195567f9cc8",
                                        "entry_id": "18494102-fdf4-33b3-be19-4ca1c6d9d364",
                                        "glosses": [
                                            "Le bois de cet arbre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482e1234-0970-410c-aaf0-0cd98aba44b5",
                                                "sense_id": "a386c60a-ce19-3e47-87f3-a195567f9cc8",
                                                "text": "L’olivier est un bois précieux pour le menuisier, l'ébéniste, le tourneur, le tabletier, le sculpteur, le fabricant de marqueterie."
                                            },
                                            {
                                                "example_id": "28d4fc30-cdb3-45f4-a342-c847d2c99e82",
                                                "sense_id": "a386c60a-ce19-3e47-87f3-a195567f9cc8",
                                                "text": "Une table d’olivier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f30afbf-e874-3241-9e43-73d127e87b5b",
                                        "entry_id": "18494102-fdf4-33b3-be19-4ca1c6d9d364",
                                        "glosses": [
                                            "Feuilles d’olivier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
