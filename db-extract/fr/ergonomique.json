                "senses": [
                    {
                        "sense_id": "09a14e6d-4132-32da-91f4-9875577761f8",
                        "entry_id": "ea655605-0477-3dfb-a338-71805174f075",
                        "glosses": [
                            "Dont la conception est bien adaptée à l’utilisateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf009bac-f2e3-417e-9aaf-3cb4952e73c6",
                                "sense_id": "09a14e6d-4132-32da-91f4-9875577761f8",
                                "text": "Pendant que plusieurs entreprises revoient leur stratégie ergonomique et d’espaces de travail, plusieurs locateurs peinent à trouver de nouveaux locataires."
                            },
                            {
                                "example_id": "90ff33fc-f2ba-4bdd-b06e-f50f7b07fdcb",
                                "sense_id": "09a14e6d-4132-32da-91f4-9875577761f8",
                                "text": "« Il faut des temps partiels, des aménagements ergonomiques… », liste le sociologue Michael Segon."
                            }
                        ]
                    },
                    {
                        "sense_id": "adab74e0-3100-3ff9-8d25-0116c11f6a03",
                        "entry_id": "ea655605-0477-3dfb-a338-71805174f075",
                        "glosses": [
                            "Se dit d´une interface utilisateur qui est simple ou conviviale."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51fc2553-cd73-4a91-8ae2-5e0b21c0cc20",
                        "source_entry_id": "ea655605-0477-3dfb-a338-71805174f075",
