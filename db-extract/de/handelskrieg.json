                    },
                    {
                        "sense_id": "663512a6-3e2e-3522-9088-ae08564c9748",
                        "entry_id": "5c56a839-5b46-39dc-96a3-85e15c9edc2d",
                        "glosses": [
                            "Guerre commerciale, guerre économique."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "c400e05c-72e7-4143-a6e9-a481b556d35b",
                                "sense_id": "663512a6-3e2e-3522-9088-ae08564c9748",
                                "text": "Zur Zeit findet ein partieller Handelskrieg zwischen Russland und dem Westen statt.",
                                "translation": "À l’heure actuelle a lieu guerre économique partielle entre la Russie et l’Occident."
                            },
                            {
                                "example_id": "51910051-fe52-415c-a88b-5fadd1aab3d7",
                                "sense_id": "663512a6-3e2e-3522-9088-ae08564c9748",
                                "text": "Ein in neue Handelskriege verstricktes China könnte früher oder später Mühe bekommen, noch ausreichend Nahrung heranzuschaffen für sein Milliardenvolk.",
                                "translation": "Une Chine impliquée dans de nouvelles guerres commerciales pourrait tôt ou tard avoir du mal à procurer suffisamment de nourriture pour sa population d'un milliard d'habitants."
                            }
                        ]
                    }
                ],
