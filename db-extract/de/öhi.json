                "senses": [
                    {
                        "sense_id": "45795b7e-b0d2-3de9-95cf-7856e2b0685f",
                        "entry_id": "28e02a45-13d7-354e-ae38-3b8adb250fef",
                        "glosses": [
                            "Onkel"
                        ],
                        "tags": [
                            "Südostschweiz"
                        ],
                        "examples": [
                            {
                                "example_id": "df3106f9-8c94-4505-abe7-0f2bd8f374a4",
                                "sense_id": "45795b7e-b0d2-3de9-95cf-7856e2b0685f",
                                "text": "„Seit Öhi Hap gestorben war, verfiel die Hütte. Wie oft war Conradin mit seinem Onkel auf dem warmen Stein davor gesessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e03f5b0a-cad8-3115-95e7-5ea7f0a0eda5",
                        "entry_id": "28e02a45-13d7-354e-ae38-3b8adb250fef",
                        "glosses": [
                            "Opa der Romanfigur »Heidi« in den Büchern von Johanna Spyri"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8922bafe-42a7-417a-91f2-e0867e557a05",
                                "sense_id": "e03f5b0a-cad8-3115-95e7-5ea7f0a0eda5",
                                "text": "»Mein lieber Öhi, Sie sind ein prächtiger Mann!« brach sie aus."
                            },
                            {
                                "example_id": "37d1a31d-43ff-4e81-9d5c-4269bb076a1b",
                                "sense_id": "e03f5b0a-cad8-3115-95e7-5ea7f0a0eda5",
                                "text": "Und wie der Öhi lernen wir vom kleinen Mädchen, was Evangelium meint."
                            },
                            {
                                "example_id": "0cbcc31b-3d2d-4280-b757-6bb027302501",
                                "sense_id": "e03f5b0a-cad8-3115-95e7-5ea7f0a0eda5",
                                "text": "In der Schweiz und in Südtirol freuen sich In 2000 Meter Höhe mittlerweile Dutzende von Öhis über Sommergäste aus dem Flachland, die ein bisschen mit anpacken, wenn es ums Melken und Mähen, Ernten und Jodeln geht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
