                            {
                                "target_word": "quarters",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55a611c7-9640-3eaa-80dd-0de6461f79dc",
                                        "entry_id": "6ba4d075-ae6a-3b80-a348-fc6be997532f",
                                        "glosses": [
                                            "Housing, barracks, or other habitation or living space."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e82b159b-db9a-4b22-a55f-c7a6066489f7",
                                                "sense_id": "55a611c7-9640-3eaa-80dd-0de6461f79dc",
                                                "text": "“I have visited my quarters, and find them very comfortable.[…]Steerage is like everything else maritime[…]vastly improved since Robert Louis Stevenson took his trip third class to New York.”"
                                            },
                                            {
                                                "example_id": "e63a4e78-0baf-4a89-bde2-0c116e803453",
                                                "sense_id": "55a611c7-9640-3eaa-80dd-0de6461f79dc",
                                                "text": "\"Yeah.\" It was him, alright; if the world's weariest pair of workboots hadn't tipped her off, his world-weary voice certainly would have. \"Where were you?\"\n\"My quarters. We've got a full ticket set today, and techs work best without oversight.\" Neither of these things was untrue, though the curation was more than a little dishonest.\n\"Maybe yours do.\" Nascimbeni rolled out, back flat against a neon orange creeper, and sat up with an audible wince. \"Mine fuck the dog.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ffcfdb3-6af0-3e20-8c4f-8cf027bd9d83",
                                        "entry_id": "6ba4d075-ae6a-3b80-a348-fc6be997532f",
                                        "glosses": [
                                            "The place where someone or something lives."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78bf0351-53f5-46bd-99e2-80300516d252",
                                                "sense_id": "7ffcfdb3-6af0-3e20-8c4f-8cf027bd9d83",
                                                "text": "2017, Jennifer S. Holland, For These Monkeys, It’s a Fight for Survival., National Geographic (March 2017)http://www.nationalgeographic.com/magazine/2017/03/macaques-monkeys-indonesia-endangered-pet-trade/\nThe local pet trade thrives on captured or orphaned baby macaques—often malnourished and kept in tight quarters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c24d3c5c-d2c3-3772-ba95-9433d4dc567c",
