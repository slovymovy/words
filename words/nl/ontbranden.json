{
    "word_family": [
        "ontbranding",
        "branden",
        "brand",
        "brandbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52923522-9ef3-3553-8a75-ab8f43deee0a",
                    "sense_definition": "In brand vliegen of vuur vatten, vaak plotseling of hevig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het droge hout begon snel te <w>ontbranden</w> in de open haard.",
                            "target_lang_translations": {
                                "en": "The dry wood quickly started to <w>ignite</w> in the fireplace."
                            }
                        },
                        {
                            "text": "De motor kan <w>ontbranden</w> als er een vonk bij de benzine komt.",
                            "target_lang_translations": {
                                "en": "The engine can <w>catch fire</w> if a spark reaches the gasoline."
                            }
                        }
                    ],
                    "synonyms": [
                        "vlamvatten"
                    ],
                    "antonyms": [
                        "doven",
                        "blussen"
                    ],
                    "common_phrases": [
                        "kan ontbranden",
                        "snel ontbranden"
                    ],
                    "target_lang_definitions": {
                        "en": "To catch fire or ignite, often suddenly or fiercely."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ignite",
                                "target_lang_sense_clarification": "to start burning"
                            },
                            {
                                "target_lang_word": "catch fire",
                                "target_lang_sense_clarification": "to begin to burn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65ffb97a-8603-3028-9fde-5b9c9396f2b4",
                    "sense_definition": "Figuurlijk of fysiek in alle hevigheid beginnen, zoals een strijd, discussie of passie.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een felle discussie <w>ontbrand</w> over de nieuwe maatregelen.",
                            "target_lang_translations": {
                                "en": "A fierce debate has <w>flared up</w> about the new measures."
                            }
                        },
                        {
                            "text": "Toen de beslissing werd genomen, zag je de strijd <w>ontbranden</w> tussen de partijen.",
                            "target_lang_translations": {
                                "en": "When the decision was made, you saw the struggle <w>ignite</w> between the parties."
                            }
                        }
                    ],
                    "synonyms": [
                        "losbarsten",
                        "uitbreken"
                    ],
                    "common_phrases": [
                        "strijd ontbranden",
                        "discussie ontbranden"
                    ],
                    "target_lang_definitions": {
                        "en": "To begin fiercely, either figuratively or physically, such as a fight, debate, or passion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flare up",
                                "target_lang_sense_clarification": "to suddenly erupt or intensify"
                            },
                            {
                                "target_lang_word": "ignite",
                                "target_lang_sense_clarification": "to trigger or spark an argument or conflict"
                            },
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "to start suddenly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}