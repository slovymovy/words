                                                "sense_id": "08d6eae5-6615-3092-9e9d-05615cb17ad2",
                                                "text": "Het steunverlenend Centrum oordeelt eigenmachtig over de staat van behoeftigheid van de betrokken persoon …."
                                            }
                                        ]
                                    }
                                ]
