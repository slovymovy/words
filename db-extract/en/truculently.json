                                "target_senses": [
                                    {
                                        "sense_id": "d07ea73e-67e3-31e4-b034-02661198ec0f",
                                        "entry_id": "c8d6c0b6-8693-3c58-a04d-b53fcd8c6fb4",
                                        "glosses": [
                                            "onbebouwd, braakliggend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ebeb01-e29a-4446-a5bf-7ab832e2cf73",
                                                "sense_id": "d07ea73e-67e3-31e4-b034-02661198ec0f",
                                                "text": "Heathcliff, ik kom weer thuis van die donkere, ruige, woeste hoogte."
                                            },
                                            {
                                                "example_id": "2ba53cd5-add2-4b7b-a764-3db862a8f357",
                                                "sense_id": "d07ea73e-67e3-31e4-b034-02661198ec0f",
                                                "text": "Het woeste Zillertal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be99fbf0-0636-3655-9168-608b71e4301b",
                                        "entry_id": "c8d6c0b6-8693-3c58-a04d-b53fcd8c6fb4",
                                        "glosses": [
                                            "wild, ongetemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc96dd06-8ca1-4b5b-b913-687eb9d91dfb",
                                                "sense_id": "be99fbf0-0636-3655-9168-608b71e4301b",
                                                "text": "Over de woeste baren."
                                            },
                                            {
                                                "example_id": "6f951c88-6a46-4024-ba51-62de938c1411",
                                                "sense_id": "be99fbf0-0636-3655-9168-608b71e4301b",
                                                "text": "Op de derde dag kwamen we aan bij een verlaten herdershut langs de woeste Kerns rivier en besloten al snel daar te blijven voor een zero in de natuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb73e74-9766-3bc0-bad4-c626f1010cc3",
                                        "entry_id": "c8d6c0b6-8693-3c58-a04d-b53fcd8c6fb4",
                                        "glosses": [
                                            "onbeschaafd, ruw:"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59c95cc6-6485-4ee9-af23-6961917cf2ce",
                                                "sense_id": "3fb73e74-9766-3bc0-bad4-c626f1010cc3",
                                                "text": "Woeste piraten."
                                            },
                                            {
                                                "example_id": "ebce3d6f-64c2-4b31-a0f7-e5967a2a2edd",
                                                "sense_id": "3fb73e74-9766-3bc0-bad4-c626f1010cc3",
                                                "text": "Zij waren keurig gekleed en wij zagen er woest uit en droegen versleten vodden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd573cf0-a911-343d-badf-fffd43417f30",
                                        "entry_id": "c8d6c0b6-8693-3c58-a04d-b53fcd8c6fb4",
                                        "glosses": [
                                            "heel boos, razend, woedend, spinnijdig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc8f732-d085-4ae7-b071-f9fae5f0b04d",
                                                "sense_id": "dd573cf0-a911-343d-badf-fffd43417f30",
                                                "text": "Hij werd woest toen ik dat opperde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woest",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b43d567b-2dd7-381d-9877-3e87940c7377",
                                        "entry_id": "08e16f09-3914-3555-9b65-5c2191374cfb",
                                        "glosses": [
                                            "heel ruw en onvoorzichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d20a36a-3e45-4ce7-920c-7bca8ff54378",
                                                "sense_id": "b43d567b-2dd7-381d-9877-3e87940c7377",
                                                "text": "Hij duwde het woest open zonder ook maar één keer om te kijken."
                                            },
                                            {
                                                "example_id": "6954c008-e99e-45c6-9d08-fa13a9228348",
                                                "sense_id": "b43d567b-2dd7-381d-9877-3e87940c7377",
                                                "text": "'Aaaaahl Het is zo heerlijk hier! Oeh! Za- lig! Mmmmm ' De borsten van Bibi drijven op het water, even later stijgen twee kadetvormige billetjes boven het oppervlak wanneer ze een koprol maakt die eindigt met een woest schudden van het hele lichaam."
                                            },
                                            {
                                                "example_id": "b8fea201-4d96-4da8-91df-31d2591862ce",
                                                "sense_id": "b43d567b-2dd7-381d-9877-3e87940c7377",
                                                "text": "Woest en wild schudden de bloemen heen en weer, woest en wild schudt het lichaam van Bibi achter me, haar armen om mijn middel, terwijl de honden beginnen te blaffen, steeds harder, steeds hoger, hun schrapende poten over het grind, en Bibi met haar prachtige lichaam die zich als een slang om mijn heupen kronkelt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c97aca7b-f88f-4bc7-8c50-96c663f4553e",
