                "senses": [
                    {
                        "sense_id": "9ca1f7ca-a562-399a-8f66-a71f9a85f586",
                        "entry_id": "d3560f78-c361-3629-9f87-2ce5113d9226",
                        "glosses": [
                            "Verschluss an einem Gürtel oder Riemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363a0921-ef4f-49b1-b7b9-1b7726d2ce3b",
                                "sense_id": "9ca1f7ca-a562-399a-8f66-a71f9a85f586",
                                "text": "Gürtel werden manchmal durch besonders aufwändig gestaltete Gürtelschnallen verziert."
                            },
                            {
                                "example_id": "e9c743c3-2a38-43d7-b5b6-c5a94f92d5ce",
                                "sense_id": "9ca1f7ca-a562-399a-8f66-a71f9a85f586",
                                "text": "„Die Wunde schlug eine Gürtelschnalle.“"
                            },
                            {
                                "example_id": "c3e4eea3-041c-4e00-9a74-d0251b8a0fd5",
                                "sense_id": "9ca1f7ca-a562-399a-8f66-a71f9a85f586",
                                "text": "„Sie fertigten Fibeln, Hals-, Arm- und Ohrringe, Gürtelschnallen, Dolche, Pfeil-, Lanzen- und Speerspitzen, Messer, Sicheln, Pinzetten, Nähnadeln, Nägel, Beschläge für Pferdegeschirr, Fleischgabeln, Kesselketten und Geschirr, nicht nur für den Eigenbedarf der Heuneburg, sondern auch für den Export.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
