                    },
                    {
                        "translation_id": "6c40fa5e-0d53-4a7b-9ac0-38aa9e4a0506",
                        "source_entry_id": "9e589eaf-d8aa-3ee3-a401-8697bd75064d",
                        "source_sense_id": "bfca0f80-9fce-344a-8ebc-0bda5d41efa5",
                        "target_lang_word": "psychopolitics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychopolitics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70fbe80a-b5d4-3bc9-ab2e-92cef6df3d2c",
                                        "entry_id": "e686f14a-5165-337f-b140-2dce2bce746a",
                                        "glosses": [
                                            "The interaction between human psychology and politics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39859dfb-fe97-4010-bbf5-89d75124f1bb",
                                                "sense_id": "70fbe80a-b5d4-3bc9-ab2e-92cef6df3d2c",
                                                "text": "As O'Meara has shown, the NP would become viewed through the prism of ideology and cod psycho-politics."
                                            },
                                            {
                                                "example_id": "31161c0e-0c9b-4d08-880b-6bff4e71c290",
                                                "sense_id": "70fbe80a-b5d4-3bc9-ab2e-92cef6df3d2c",
                                                "text": "Psychopolitics is a condition shaped by the human relations school of management, in which social relations take precendence over customers and clients and where process becomes king at the expense of productivity."
                                            },
                                            {
                                                "example_id": "d52a5135-64b2-485d-851e-0f4a188c9cf6",
                                                "sense_id": "70fbe80a-b5d4-3bc9-ab2e-92cef6df3d2c",
                                                "text": "By psychopolitics, Sykes means the synthesis of Freudian and neo-Marxian views."
                                            },
                                            {
                                                "example_id": "dcbab80e-6f7c-4ea7-9dd9-b6103e982b7e",
                                                "sense_id": "70fbe80a-b5d4-3bc9-ab2e-92cef6df3d2c",
                                                "text": "Politics too has been transformed in the era of psychopolitics. We’re incapable of conceiving politics as a communal activity because we have become habituated to being consumers rather than citizens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
