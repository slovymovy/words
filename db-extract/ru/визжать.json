                "senses": [
                    {
                        "sense_id": "66f6e934-4ed4-3139-a6ed-4544998f40bb",
                        "entry_id": "8ee2d465-13e3-3601-beed-fc52f3093738",
                        "glosses": [
                            "to squeal (to scream a high-pitched squeal)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285ad723-ba4a-42d5-9347-7695a3119598",
                                "sense_id": "66f6e934-4ed4-3139-a6ed-4544998f40bb",
                                "text": "Незнакомая дама была проститутка и сперва внимательно слушала его и даже смеялась, но, когда он заговорил о своем одиночестве и заплакал, приняла его за сумасшедшего и начала визжать от страха.",
                                "translation": "This fair unknown was a courtesan, and at first listened to him attentively and even laughed, but when he began to weep and complain of his loneliness, she took him for a madman, and began to scream with terror.",
                                "english": "This fair unknown was a courtesan, and at first listened to him attentively and even laughed, but when he began to weep and complain of his loneliness, she took him for a madman, and began to scream with terror."
                            }
                        ]
                    }
                ],
