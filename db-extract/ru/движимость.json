                    {
                        "translation_id": "5b3c05d2-f15a-4f9c-8c47-798b17cf7a69",
                        "source_entry_id": "d38d7108-7d72-3c7b-8a1f-20ea93e6ce6b",
                        "source_sense_description": "bимущество за исключением земли и того, что с нею непосредственно и естественно связано",
                        "target_lang_word": "Mobiliar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mobiliar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed5b1a35-a32e-3572-9d3a-43e7d56bfd37",
                                        "entry_id": "7bbacfc6-c17f-3e49-9749-b4f581ac89e5",
                                        "glosses": [
                                            "Gesamtheit der Möbel in einem Haus, Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67408e39-4156-437e-89b1-9657dcc287ee",
                                                "sense_id": "ed5b1a35-a32e-3572-9d3a-43e7d56bfd37",
                                                "text": "„Das Mobiliar sah bereits recht mitgenommen aus, doch machten die weißen Tischtücher eine Menge wieder gut.“"
                                            },
                                            {
                                                "example_id": "f9d79053-4ca6-4ba9-87bd-8f0b8c7f26a8",
                                                "sense_id": "ed5b1a35-a32e-3572-9d3a-43e7d56bfd37",
                                                "text": "„Wobei Diantha auch besonders scheußliches Mobiliar ausgesucht hatte.“"
                                            },
                                            {
                                                "example_id": "8208aed0-64b4-42a1-865c-059757597ee0",
                                                "sense_id": "ed5b1a35-a32e-3572-9d3a-43e7d56bfd37",
                                                "text": "„Das Mobiliar stand unversehrt in den Räumen, im Herd schwelte noch Glut; die Bewohner hatten, bevor sie am Morgen geflohen waren, noch ein stärkendes Frühstück eingenommen.“"
                                            },
                                            {
                                                "example_id": "86abe2e0-9806-4ce2-9384-d31ff9ce897f",
                                                "sense_id": "ed5b1a35-a32e-3572-9d3a-43e7d56bfd37",
                                                "text": "„Zu Hause hatten sie weniger Mobiliar, es war auch nicht so schön dekoriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10bb7a9d-db67-44a8-ade9-0244cec72bdf",
                        "source_entry_id": "d38d7108-7d72-3c7b-8a1f-20ea93e6ce6b",
                        "source_sense_description": "bимущество за исключением земли и того, что с нею непосредственно и естественно связано",
                        "target_lang_word": "Fahrnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11d776b1-a7f8-36c5-bbae-5dd43e019188",
                                        "entry_id": "b95878e2-b487-3338-bb3d-9dc4cb2d24ac",
                                        "glosses": [
                                            "bewegliche Sache(n)"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "460aef01-7dae-4ee2-a0aa-9be80cf915a0",
                                                "sense_id": "11d776b1-a7f8-36c5-bbae-5dd43e019188",
                                                "text": "Im BGB gibt es Vorschriften über die Übertragung des Eigentums an Fahrnis in den §§ 929 ff."
                                            },
                                            {
                                                "example_id": "bdc1c33a-82f8-4532-aeb5-d721e9fa7dfb",
                                                "sense_id": "11d776b1-a7f8-36c5-bbae-5dd43e019188",
                                                "text": "„Weiter wurde ihnen mitgeteilt, dass ihre Häuser, Güter und Fahrnisse verkauft und der Erlös nach Abzug der Transportkosten ihnen in der neuen Heimat ausbezahlt würde.“"
                                            },
                                            {
                                                "example_id": "3493daba-c2be-4df6-9822-d46136f7bce4",
                                                "sense_id": "11d776b1-a7f8-36c5-bbae-5dd43e019188",
                                                "text": "„Können Sachen ohne Verletzung ihrer Substanz von einer Stelle zu einer anderen versetzt werden, so sind sie beweglich und heißen ‚Fahrnis‘.“"
                                            },
                                            {
                                                "example_id": "80d31866-4c16-4211-9b0b-d68fb7a82b6d",
                                                "sense_id": "11d776b1-a7f8-36c5-bbae-5dd43e019188",
                                                "text": "„Tomatenhäuser aber gälten «als Fahrnis, nicht als fixe Gebäude» weshalb er für das Tomatenhaus eine Baubewilligung brauche oder es im Winter abbrechen müsse.“"
                                            },
                                            {
                                                "example_id": "a292cce8-e345-4ce1-b38a-e679a01d0439",
                                                "sense_id": "11d776b1-a7f8-36c5-bbae-5dd43e019188",
                                                "text": "„Darüber hinaus muss der Insolvenzverwalter aber auch über ein Netzwerk an Sachverständigen (zur Bewertung von Liegenschaften und Fahrnissen), Unternehmensberatern (zur Unterstützung bei der strategischen Planung sowie Erstellung der Fortführungsplanung), Steuerberatern und M&A-Beratern verfügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
