                    "sense_definition": "De gebiedende wijs van <w>leveren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
