                "senses": [
                    {
                        "sense_id": "5fd8ff0d-b469-3aae-a176-80a70c6a9ffd",
                        "entry_id": "77f4182a-3f9f-391e-af5a-869fcf4485d8",
                        "glosses": [
                            "A sweet pastry found in many cuisines of the Middle East and the Balkans, made of chopped nuts layered with phyllo pastry."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8de22e8-3269-45f5-b5d9-9729baed44b1",
                                "sense_id": "5fd8ff0d-b469-3aae-a176-80a70c6a9ffd",
                                "text": "It meant lifting tea towels off trays in her Muslim neighbours’ kitchens to help herself to sticky triangles of baklava, half lemon slices pressed into the syrupy pastry filled with walnuts and raisins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6237f264-fa1e-42b3-8fea-3d722d9060f7",
                        "source_entry_id": "77f4182a-3f9f-391e-af5a-869fcf4485d8",
                        "source_sense_id": "5fd8ff0d-b469-3aae-a176-80a70c6a9ffd",
