                    "sense_definition": "Enfant ou jeune garçon.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enfant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>gamins</w> du quartier se rassemblent souvent dans le parc pour jouer au ballon."
                        },
                        {
                            "text": "Quand j'étais <w>gamin</w>, je passais toutes mes vacances d'été chez mes grands-parents."
                        }
                    ],
                    "synonyms": [
                        "gosse",
                        "minot"
                    ],
                    "common_phrases": [
