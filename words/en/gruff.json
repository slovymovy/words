                            }
                        },
                        {
                            "text": "The manager gave a <w>gruff</w> mannered response when I asked for a day off.",
                            "target_lang_translations": {
                                "ru": "Менеджер ответил в <w>резкой</w> манере, когда я попросил выходной."
                            }
