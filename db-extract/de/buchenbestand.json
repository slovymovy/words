                                "example_id": "48da26e4-3f07-4be8-b63a-a6f72248bc76",
                                "sense_id": "405ae825-de49-362a-b549-e01597a9bd1b",
                                "text": "„Der Buchenbestand ist mit einem Alter von 53 Jahren etwas älter als der Fichtenbestand mit 47 Jahren. Die mittlere Höhe des Buchenbestandes beträgt 20,8 m.“"
                            },
                            {
                                "example_id": "6b228ae3-287f-4f61-ab9d-51d174f7bbef",
                                "sense_id": "405ae825-de49-362a-b549-e01597a9bd1b",
                                "text": "„Berechnungen über die Höhe der mit dem Buchenbestande zu erwirtschaftenden Bodenrente hat er [der Waldbesitzer] bis jetzt nicht angestellt.“ (1895)"
                            }
