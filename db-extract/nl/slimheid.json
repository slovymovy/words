                                            {
                                                "example_id": "9722ae02-a410-42b4-a416-804d5224ee0a",
                                                "sense_id": "e5d21470-770d-36a8-a2fd-68b0edf37658",
                                                "text": "The station buildings at Oxton and Lauder have been repainted, and a general air of smartness prevails, marred only by some broken signal spectacles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2e4ec2-ea8a-34e4-97fa-498a871818db",
