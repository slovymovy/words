                    "frequency": "Middle",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin <w>alerte</w> régulièrement la population sur les risques liés au tabagisme."
                        },
                        {
                            "text": "Ce signal sonore <w>alerte</w> automatiquement les résidents en cas de fuite de gaz."
                        }
                    ]
