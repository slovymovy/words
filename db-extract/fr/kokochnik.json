                ],
                "senses": [
                    {
                        "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                        "entry_id": "ac0e33be-8f39-3951-ab04-dc88d0fa6f33",
                        "glosses": [
                            "Coiffe traditionnelle de femme en Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca2b368-b248-434c-8ae2-90a845ff367a",
                                "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                "text": "Voici la clé du coffre de ta mère; tu y trouveras ses habits et ses coiffes, le kokochnik brodé de perles qui la parait les jours de fête, les simples pavoinik qu’elle portait les jours de travail."
                            },
                            {
                                "example_id": "74c02dc2-53ab-40ca-a650-8cfae5067a5d",
                                "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                "text": "La toque convient-elle bien à cette énorme chevelure qu’un kakochnyk ne ferait que mettre en valeur ?"
                            },
                            {
                                "example_id": "a8b4c806-53b0-47af-a621-94c4567030cb",
                                "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                "text": "Une fillette âgée de cinq ans tient dans ses bras une énorme poupée prêtée pour la photo. Une poupée somptueuse : lourde tresse, joues vermeilles, volant brodé de la robe, haut kokochnik, fauteuil en rotin."
                            }
                        ]
                    }
                ],
