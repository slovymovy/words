                "translations": [
                    {
                        "translation_id": "cd424814-f404-476f-a19a-b48a36220464",
                        "source_entry_id": "bf968a0a-57bc-3764-8ab5-b7a65c26019c",
                        "source_sense_description": "one who destructs",
                        "target_lang_word": "destructeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destructeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                        "entry_id": "89e0d0a1-a363-3b0e-9cb8-61b8c5f5b0d0",
                                        "glosses": [
                                            "Personne qui détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0171db-3a8f-491a-8999-94e9353a06af",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Les grecs furent les destructeurs de Troie."
                                            },
                                            {
                                                "example_id": "9f79c577-f773-4280-aaa5-6576c17e6f39",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Les Huns étaient de grands destructeurs."
                                            },
                                            {
                                                "example_id": "64bf566d-dbac-467f-bfce-b94f32167fc6",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Louis XIV voulut être le destructeur de l’hérésie."
                                            },
                                            {
                                                "example_id": "3a869fb9-fea7-4eec-b7a8-00ba7d7b1897",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Le destructeur des abus."
                                            },
                                            {
                                                "example_id": "c228a671-96dc-406c-a112-d734f87df315",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Cet homme a été, par ses folles dépenses, le destructeur de sa maison."
                                            },
                                            {
                                                "example_id": "19ab33ad-8b96-4abc-b5fa-fe165f35c0be",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Un destructeur comme Luther a plus fondé, c’est-à-dire a jeté plus de formes durables, et a plus donné à la vie subséquente de l’humanité, qu’un fondateur comme Calvin."
                                            },
                                            {
                                                "example_id": "788cbbb8-520c-41e4-a3e5-410874d4c193",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Cette réforme fut la destructrice des lois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c0a2d-c078-3bae-8a42-83d11ca73924",
                                        "entry_id": "89e0d0a1-a363-3b0e-9cb8-61b8c5f5b0d0",
                                        "glosses": [
                                            "Partie d’un programme qui décrit les actions à exécuter lors de la destruction d’un objet."
                                        ],
                                        "tags": [
                                            "Programmation orientée objet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840aa4df-e7ca-4792-bbd5-7df29086568f",
                                                "sense_id": "9e2c0a2d-c078-3bae-8a42-83d11ca73924",
                                                "text": "C++ offre un mécanisme très performant pour traiter ces problèmes : le constructeur. Il s’agit d’une fonction membre […] qui sera appelée automatiquement à chaque création d’un objet. […]\nUn objet pourra aussi posséder un destructeur, c’est-à-dire une fonction membre appelée automatiquement au moment de la destruction de l’objet. […]\nPar convention, le constructeur se reconnaît à ce qu’il porte le même nom que la classe.\nQuant au destructeur, il porte le même nom que la classe, précédé d’un tilde (~)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "destructeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                        "entry_id": "8aad2479-6626-3774-b727-c3902448348b",
                                        "glosses": [
                                            "Qui détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6122a4-cdef-4455-b635-01432ee231b5",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Un animal destructeur."
                                            },
                                            {
                                                "example_id": "7810ecd1-f340-447d-924d-c3b16fd6a716",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Fléau destructeur."
                                            },
                                            {
                                                "example_id": "9769524b-0b5c-4cc6-ba7f-4d39ea0ed376",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Un système destructeur."
                                            },
                                            {
                                                "example_id": "f5d79d75-bad0-469a-9739-98d741b68495",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Force destructrice."
                                            },
                                            {
                                                "example_id": "957a8132-4e31-48ce-828e-7e793ee0a896",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "– Vous êtes d’un naturel destructeur vous. Devriez faire attention, vous pourriez vous blesser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceebdc6c-8bce-40f4-8f62-c96766fd386f",
                        "source_entry_id": "bf968a0a-57bc-3764-8ab5-b7a65c26019c",
                        "source_sense_description": "one who destructs",
                        "target_lang_word": "Zerstörer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zerstörer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f896c7cd-65bd-3fbe-b972-ebc188c1a8c3",
                                        "entry_id": "090c6402-8198-3955-938d-0b5edb236845",
                                        "glosses": [
                                            "eine Form des Kriegsschiffes, kleinstes Kriegsschiff, welches operative Aufträge ohne weitere Unterstützung erfüllen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35aa240-e94b-45c8-afa1-53016754417a",
                                                "sense_id": "f896c7cd-65bd-3fbe-b972-ebc188c1a8c3",
                                                "text": "Der Zerstörer Mölders legte im Hafen an."
                                            },
                                            {
                                                "example_id": "92de13db-e432-4b1e-80a2-349f81476f1b",
                                                "sense_id": "f896c7cd-65bd-3fbe-b972-ebc188c1a8c3",
                                                "text": "„Fast jeden Tag kamen neue Zerstörer hinzu und schlossen sich der Jagd an.“"
                                            },
                                            {
                                                "example_id": "b0628f16-ae39-400f-804a-7169efe0ce20",
                                                "sense_id": "f896c7cd-65bd-3fbe-b972-ebc188c1a8c3",
                                                "text": "„Gleich zu Beginn meiner zweiten Wache begegneten wir einem japanischen Kreuzer und einem Zerstörer auf Gegenkurs.“"
                                            },
                                            {
                                                "example_id": "77e40b3f-e8c1-4755-95c7-4c7b6db3290f",
                                                "sense_id": "f896c7cd-65bd-3fbe-b972-ebc188c1a8c3",
                                                "text": "„Ich fuhr auf Zerstörern und schrieb Reportagen - wie hätte ich an Bord auch malen sollen!“"
                                            },
                                            {
                                                "example_id": "1e8b5de2-1ae4-4d3c-b22e-44657164a843",
                                                "sense_id": "f896c7cd-65bd-3fbe-b972-ebc188c1a8c3",
                                                "text": "„Ein britischer Flottenverband, der im März aus Europa eingetroffen war, beteiligte sich mit zwei Schlachtschiffen, vier Flugzeugträgern, sechs Kreuzern und fünfzehn Zerstörern an dem Unternehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "021336cd-5a0c-3d0a-8d32-0f08795023c8",
                                        "entry_id": "090c6402-8198-3955-938d-0b5edb236845",
                                        "glosses": [
                                            "ursprünglich Bezeichnung für ein kleines und schnelles Kriegsschiff zur Abwehr von Torpedobooten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b515e0fe-c12c-4918-bce8-1687da4232aa",
                                                "sense_id": "021336cd-5a0c-3d0a-8d32-0f08795023c8",
                                                "text": "„Ein Zerstörer hatte sie gesehen und schoß wie verrückt, in Lage Null kam er auf sie zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4c7afbde-dd69-3054-822e-86931a2115d3",
                                        "entry_id": "090c6402-8198-3955-938d-0b5edb236845",
                                        "glosses": [
                                            "jemand, der etwas zerstört"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f06b7205-b407-4d70-bae2-4a2763ef5241",
                                                "sense_id": "4c7afbde-dd69-3054-822e-86931a2115d3",
                                                "text": "„Schauspieler sind die Zerstörer und Vernichter der Phantasie, nicht ihre Lebendigmacher.“"
                                            },
                                            {
                                                "example_id": "95d1889f-ca99-443c-aef3-196aa154312a",
                                                "sense_id": "4c7afbde-dd69-3054-822e-86931a2115d3",
                                                "text": "„Der Mann, der heute in den Geschichtsbüchern als Führer der Solidarnośćbewegung und als der Zerstörer des Kommunismus gilt, lebte mit seiner Frau Danuta (die für ihn später den Nobelpreis in Stockholm abholen sollte) in einer winzigen Wohnung in einer Betonsiedlung am Rande Danzigs.“"
                                            },
                                            {
                                                "example_id": "26278b68-1f04-4157-9a57-39d1ce5aebd5",
                                                "sense_id": "4c7afbde-dd69-3054-822e-86931a2115d3",
                                                "text": "„Wenn der europäische Mensch sich auf einmal winzig vorkam auf der Erdkugel im Kosmos, lag das nicht so sehr an der Ausweitung der Welt durch die Seefahrer und Abenteurer, die Gewürzhändler, die Eroberer und Zerstörer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
