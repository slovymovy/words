        "fr-extract.jsonl": [
            {
                "entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                "word": "académicien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d181ddf-a19c-4342-a6b8-a5a33f73c573",
                        "entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "académiciens"
                    },
                    {
                        "form_id": "175be003-0672-4781-8300-408c0f259b42",
                        "entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                        "tags": [
                            "feminine"
                        ],
                        "form": "académicienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a30dc5b-72d0-3545-85b2-cbd77d25bcaa",
                        "entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                        "glosses": [
                            "Personne qui fait partie d’une compagnie de gens de lettres, de savants ou d’artistes, nommée académie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d1cf11-86ad-40f7-b4e3-412508b9e9a0",
                                "sense_id": "9a30dc5b-72d0-3545-85b2-cbd77d25bcaa",
                                "text": "Quelque peu disposé que vous parussiez à accepter la place d’académicien, il a cru vraisemblablement entrevoir dans vos yeux une envie d'y être forcé, et s'est persuadé qu'au moment que vous seriez élu vous ne vous feriez plus prier pour occuper une place qu'on ne pourrait plus vous soupçonner d'avoir recherchée : il s'est trompé et vous l'avez refusée."
                            },
                            {
                                "example_id": "5b39ebe5-66ba-4b80-b764-0131bb37e4ad",
                                "sense_id": "9a30dc5b-72d0-3545-85b2-cbd77d25bcaa",
                                "text": "Le fusil photographique est plus complet que le photo-revolver ; il a été construit par M. Marey, et sert spécialement à l'étude du vol des oiseaux, étude que l'éminent académicien poursuit avec tant de succès."
                            },
                            {
                                "example_id": "038d6ab5-af60-4b34-99b7-99acc4657c35",
                                "sense_id": "9a30dc5b-72d0-3545-85b2-cbd77d25bcaa",
                                "text": "Un célèbre Académicien a déjà tenté cette expérience , & j'ai lieu de croire que la répétant & opérant avec tout le soin qu'elle exige, nos résultats seront à-peu-près les mêmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3e76559-5c94-360a-a07a-8ca7f7a90061",
                        "entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                        "glosses": [
                            "Philosophe de l’école platonicienne dite Académie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94df09f8-1f1c-4aec-a15c-912df78dc9ba",
                                "sense_id": "b3e76559-5c94-360a-a07a-8ca7f7a90061",
                                "text": "Les académiciens et les péripatéticiens étaient opposés sur plusieurs points."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1667341e-dbcf-4ce4-8eab-6cc12b431c6f",
                        "source_entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                        "target_lang_word": "Akademiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akademiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                        "entry_id": "3512a3fa-36f1-34be-9e45-40c09156c24b",
                                        "glosses": [
                                            "Person, die eine Hochschule erfolgreich besucht und mit Examen abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc535cc0-5624-456e-9d48-508266693771",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "Akademiker kann man nur durch eine erfolgreiche Ausbildung an einer Hochschule werden."
                                            },
                                            {
                                                "example_id": "6f9e3b65-5951-4190-9af7-2ff347960087",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "„Ob Personen aus den oberen Strata der Gesellschaft oder Akademiker, mehr und mehr gingen nun dazu über, einander je nach ihrer Akzeptanz oder Ablehnung von Darwins großer Entdeckung geistig und gesellschaftlich einzuordnen.“"
                                            },
                                            {
                                                "example_id": "7e4bcfdb-cc23-417d-b075-f0aecbfc37be",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "„Wie die meisten jungen Akademiker seines Jahrgangs hatte er sich verpflichten lassen, um die Vorstöße der zweiten Welle des dritten Befreiungskriegs zurückzuschlagen.“"
                                            },
                                            {
                                                "example_id": "48b721a8-f78f-40bc-9d68-427bb08f0b86",
                                                "sense_id": "ba93cf59-afd3-3128-adde-d7268282c8d7",
                                                "text": "„Die Gruppe junger Akademiker aber ist deshalb besonders interessant, weil sie Trendsetter sein könnte für die weitere Entwicklung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6d02809-eaab-3f0e-a871-4aff34d9ce65",
                                        "entry_id": "3512a3fa-36f1-34be-9e45-40c09156c24b",
                                        "glosses": [
                                            "Mitglied einer Akademie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f703ac-0d5d-4ca1-978f-5eb36635eb0d",
                                                "sense_id": "c6d02809-eaab-3f0e-a871-4aff34d9ce65",
                                                "text": "„Wie glücklich sind doch diese französischen Akademiker! Da sitzen sie im süßesten Seelenfrieden auf ihren sichern Bänken, und sie können ruhig sterben, denn sie wissen, wie bedenklich auch ihre Handlungen gewesen, so wird sie doch der gute Mignet nach ihrem Tode rühmen und preisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "687f71dd-7549-4b53-8d0b-ec4fef3a0627",
                        "source_entry_id": "0be5dc9e-134e-38f6-ac5e-18e0cdbaf4d7",
                        "target_lang_word": "academician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "academician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72e914cd-0bef-3cac-813d-2bb8d65f2063",
                                        "entry_id": "5df32ba6-0153-39f2-8ff0-e1951c1807cf",
                                        "glosses": [
                                            "A member (especially a senior one) of the faculty at a college or university; an academic."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8156ce3f-5bcd-48d6-bd79-5a4d58851c00",
                                                "sense_id": "72e914cd-0bef-3cac-813d-2bb8d65f2063",
                                                "text": "One can learn more about the nature of our society by sharing in a small way the life of its victims than by interacting intellectually with its privileged academicians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11cf7d0d-5d1c-3b55-b893-0259977d2d8c",
                                        "entry_id": "5df32ba6-0153-39f2-8ff0-e1951c1807cf",
                                        "glosses": [
                                            "A member or follower of an academy, or society for promoting science, art, or literature, such as the French Academy, or the Royal Academy of Arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1956852-15ed-434b-ac1c-88647af2aac9",
                                                "sense_id": "11cf7d0d-5d1c-3b55-b893-0259977d2d8c",
                                                "text": "‘Well, after I had been in the room about ten minutes, talking to huge overdressed dowagers and tedious Academicians, I suddenly became conscious that some one was looking at me.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
