                "senses": [
                    {
                        "sense_id": "808c093b-a972-31bc-b2d2-9a44bb72e689",
                        "entry_id": "59a1c396-e1dd-3b0e-9533-5d9b6246404c",
                        "glosses": [
                            "een zeeman van de laagste rang"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "30821f80-59a5-4455-a90f-d8b1e9734e6d",
                                "sense_id": "808c093b-a972-31bc-b2d2-9a44bb72e689",
                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e187371b-cb27-419d-95c7-db3f6a428861",
                        "source_entry_id": "59a1c396-e1dd-3b0e-9533-5d9b6246404c",
                        "source_sense_id": "808c093b-a972-31bc-b2d2-9a44bb72e689",
                        "source_sense_description": "een zeeman van de laagste rang",
                        "target_lang_word": "Matrose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matrose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3340bc62-211d-3d30-a53e-023c24437c5c",
                                        "entry_id": "ae7f6700-17d5-3d80-a946-2d497e01fe17",
                                        "glosses": [
                                            "Angehöriger der Marine; niedrigster Dienstgrad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d0a5dc-ebc4-4b39-b4dd-c0ec839bc5d4",
                                                "sense_id": "3340bc62-211d-3d30-a53e-023c24437c5c",
                                                "text": "„Auf, Matrosen, die Anker gelichtet, // Segel gespannt, den Kompass gerichtet.“"
                                            },
                                            {
                                                "example_id": "609b41c3-d0a7-4c26-9ad9-f2fadaef191b",
                                                "sense_id": "3340bc62-211d-3d30-a53e-023c24437c5c",
                                                "text": "„Lastautos mit Matrosen rasen über die Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                        "entry_id": "ae7f6700-17d5-3d80-a946-2d497e01fe17",
                                        "glosses": [
                                            "Angehöriger einer zivilen Schiffsbesatzung; in der BRD als Ausbildungsberuf bis 1983"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03649c52-6d3d-460a-bd85-1a2e40e72f00",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "Die Matrosen trafen sich abends in der Bar am Hafen."
                                            },
                                            {
                                                "example_id": "a4e38137-3311-413e-b435-fbd5556d9e66",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Ein Matrose maß am Bug mit einem Handlot die Wassertiefe.“"
                                            },
                                            {
                                                "example_id": "ed1acacd-4a08-4801-81c1-8f540ee88b54",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Kurz nachdem sich die beiden Matrosen Lenz und Kremp in ihre Unterkunft im Vorschiff zurückgezogen hatten, klopfte es an der Außentür zum Achterruff.“"
                                            },
                                            {
                                                "example_id": "a0766cc7-686a-41c2-9bc7-aa8fe84bcb91",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Er stellte sicher - oder auch nicht -, dass der Schiffsarzt seine Pflicht tat und dass Matrosen und Offiziere die Gefangenen nicht misshandelten.“"
                                            },
                                            {
                                                "example_id": "0d825cde-f19e-4aa9-a967-f51aabbc7033",
                                                "sense_id": "558688e2-5f06-3336-9ce7-f01810c341f9",
                                                "text": "„Auf seinen zwei vorangegangenen Reisen hatte sich Cook derlei Widrigkeiten in der Regel mit Gleichmut gestellt und im Umgang mit Matrosen und Einheimischen eine strenge, aber gerechte Hand bewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45b12dfa-75fb-4423-948d-a15562eacb68",
                        "source_entry_id": "59a1c396-e1dd-3b0e-9533-5d9b6246404c",
                        "source_sense_id": "808c093b-a972-31bc-b2d2-9a44bb72e689",
                        "source_sense_description": "een zeeman van de laagste rang",
                        "target_lang_word": "matelot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matelot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d15fff2b-9809-3b3f-9b3d-9817877c84ee",
                                        "entry_id": "0de072ae-fa07-30bb-87b8-868b506a6c5f",
                                        "glosses": [
                                            "A sailor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ace167-afed-43f4-b3cb-bd823d924adc",
                                                "sense_id": "d15fff2b-9809-3b3f-9b3d-9817877c84ee",
                                                "text": "One day, a stalwart sailor was brought in with a severe fracture below the knee […] A week later the leg had turned septic but the matelot was endearing cheerful. \"Never mind, Sister\" he assured Anne. \"I'll get a piece of whalebone, like Captain Ahab.\""
                                            },
                                            {
                                                "example_id": "fb15d8c1-2629-4ab5-ac5d-41c93726e5a9",
                                                "sense_id": "d15fff2b-9809-3b3f-9b3d-9817877c84ee",
                                                "text": "[…] a chief petty officer, snarled something under his breath about bloody 'am-fisted matelots […]"
                                            },
                                            {
                                                "example_id": "2df1adf6-2047-4f7b-bda4-c564593e8b20",
                                                "sense_id": "d15fff2b-9809-3b3f-9b3d-9817877c84ee",
                                                "text": "So far as the average matelot was concerned, there was little romanticism about the preference for frigates, destroyers, frail E-boats that could be blown up with one well-aimed cannon, and submarines, those breeding grounds of TB and madness."
                                            },
                                            {
                                                "example_id": "f09cd861-80ce-4b13-82b3-73fedecae4f2",
                                                "sense_id": "d15fff2b-9809-3b3f-9b3d-9817877c84ee",
                                                "text": "Our matelot took us out to sea in what I believed was not a very seaworthy boat."
                                            },
                                            {
                                                "example_id": "2eaaaf42-108e-4688-ac00-46b2038cec5a",
                                                "sense_id": "d15fff2b-9809-3b3f-9b3d-9817877c84ee",
                                                "text": "There were no signs and no one quite knew how to navigate the museum, including, as it was Fleet Week, gaggles of boyish sailors all in their summer whites. It looked like a Frank Sinatra movie. A bunch of these matelots surrounded a police officer, who said: \"You guys are from the USS Cole? Thank you for your service. Want me to take you around?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7aaae1b-44e0-3fc6-b863-fd485d9e20e8",
                                        "entry_id": "0de072ae-fa07-30bb-87b8-868b506a6c5f",
                                        "glosses": [
                                            "A mate; a boon companion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad7ef8d-cc0f-4a37-abfd-ec85f847888e",
                                                "sense_id": "d7aaae1b-44e0-3fc6-b863-fd485d9e20e8",
                                                "text": "[…] \"Among the Brethren of the Coast—we tykes no wimmen save in passing, as it were, they being bothersome, frail and scatterbrained creatures. Instead we tykes a blood-brother, or matelot ... A matelot, 'e fights along side o' yer, nurses yer if yer falls sick. Wots 'is is yours and whats yours is 'is ... Take Klaas yonder, and young Pedro [described earlier as a slender-hipped boy with deep feminine brown eyes]; they shared the same barbacoa six, seven year and ye'll never come on 'em more than a few yards apart.\" To this explanation [Harry] Morgan listened in growing amazement and began to comprehend why none of these bestial-appearing boucan makers had so much as addressed Kate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "486f9e81-d8e7-437b-b888-3352533b8632",
                        "source_entry_id": "59a1c396-e1dd-3b0e-9533-5d9b6246404c",
                        "source_sense_id": "808c093b-a972-31bc-b2d2-9a44bb72e689",
                        "source_sense_description": "een zeeman van de laagste rang",
                        "target_lang_word": "seaman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61dc017c-d456-3b0e-870c-27d6ca117e75",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "Synonym of sailor, particularly on a maritime vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62e9762-980c-42e1-b1ba-6a100325ca78",
                                                "sense_id": "61dc017c-d456-3b0e-870c-27d6ca117e75",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa07803-d63d-344d-ab72-59d2195557e3",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "A person of the lowest rank in the Navy, below able seaman."
                                        ],
                                        "tags": [
                                            "British",
                                            "Navy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "021ebbf6-c5dd-3355-ae57-575e82be5def",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "An enlisted rate in the United States Navy and United States Coast Guard, ranking below petty officer third class and above seaman apprentice."
                                        ],
                                        "tags": [
                                            "Navy",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3db751fd-f829-3f36-9b74-9e2e514cc1b4",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "A merman; the male of the mermaid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75a0f4b-fd35-4085-b1ca-e2f0a59d8d98",
                                                "sense_id": "3db751fd-f829-3f36-9b74-9e2e514cc1b4",
                                                "text": ", Book III\nnot to mention what is confidently reported of mermaids, or sea-men"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baf27a1b-1de8-4686-ae30-1fa39fc174c3",
                        "source_entry_id": "59a1c396-e1dd-3b0e-9533-5d9b6246404c",
                        "source_sense_id": "808c093b-a972-31bc-b2d2-9a44bb72e689",
