                    {
                        "translation_id": "e11c0d8b-7b12-49a3-8d9e-0a420db6df02",
                        "source_entry_id": "5fe70cad-69f5-3d17-abd6-bbab2774709b",
                        "source_sense_description": "mountain range in France",
                        "target_lang_word": "Vosges",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vosges",
