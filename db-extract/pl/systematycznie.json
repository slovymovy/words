                            {
                                "example_id": "6d3c19c0-b9f2-464f-a453-5186d928b887",
                                "sense_id": "f3660017-a5d6-3417-85a6-9915dfab9d3d",
                                "text": "Ten palił papierosa, gryząc jego ustnik i systematycznie wypluwając na odległość kawałki papieru."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "86722249-f5ef-336b-b41b-23f388b5f203",
                        "entry_id": "2eb286df-c532-3666-8e32-b816cf2284fb",
                        "glosses": [
                            "stale przez dłuższy czas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0cdf65-1c7a-4132-9f7d-74b345a2fdf2",
                                "sense_id": "86722249-f5ef-336b-b41b-23f388b5f203",
                                "text": "Ta ostatnia izolowana populacja uległa skarłowaceniu wskutek systematycznie malejącej przestrzeni ich biotopów i zasobów pożywienia."
