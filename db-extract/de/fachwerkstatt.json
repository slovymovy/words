                        "examples": [
                            {
                                "example_id": "cc6aa5d7-a7ce-4863-b096-e5013743eb9c",
                                "sense_id": "c72d92d7-02d3-3d01-9c29-b0b38824ca80",
                                "text": "„Nur wenn's hier nicht klappt, sollte eine Fachwerkstatt für den (westlichen) Autotyp in Anspruch genommen werden.“"
                            },
                            {
                                "example_id": "c00a1232-92a8-4488-be83-1e944db96228",
                                "sense_id": "c72d92d7-02d3-3d01-9c29-b0b38824ca80",
                                "text": "„Doch wenn es um eine regelmäßige Wartung und Kontrolle in der Fachwerkstatt geht, erweisen sich immer mehr Autofahrer als nachlässig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
