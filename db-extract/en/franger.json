                        "entry_id": "f0a6733a-6d4d-3096-b522-5fa53b16ce79",
                        "glosses": [
                            "A condom."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "502e6d66-a05f-46f0-9616-c4137194a874",
                                "sense_id": "9a4b733b-dfe6-37f3-a76e-37f12e1ad101",
                                "text": "You have a point. But on the other hand, I didn't run off and tell mum with a six pack in one hand and an open franger packet in the other."
                            },
                            {
                                "example_id": "fd0a0b0e-7ef5-43b7-b99c-c648d21e8965",
                                "sense_id": "9a4b733b-dfe6-37f3-a76e-37f12e1ad101",
                                "text": "Ranpaging^([sic]) Roy Slaven & HG Nelson who are comedians of the host broadcaster's Olympic graveyard shift have said that 48,000 of the frangers are for the personal use of the mayor of the Olympic village - 'Richo'. they claim the rest are for the Cuban team who when they have finished their events are going at it like rabbits."
                            },
                            {
                                "example_id": "1d0a52a0-c559-414b-8878-b8502aaa4236",
                                "sense_id": "9a4b733b-dfe6-37f3-a76e-37f12e1ad101",
                                "text": "The barber would say while he was cutting a grown-up′s hair, ‘Do you need any home supplies, sir?’ which is the secret code for a packet of frangers."
                            },
                            {
                                "example_id": "d9c3c9a7-b892-476f-923e-0b86c28e0dfc",
                                "sense_id": "9a4b733b-dfe6-37f3-a76e-37f12e1ad101",
                                "text": "Gone are the terms we used in our youth the frenchies, frangers, rubbers, joes, french letters, gumboots, rubbers, johnnies, parachutes and plastic fantastics -- these days they're just condoms."
                            }
                        ]
                    }
