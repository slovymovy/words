                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a8cd50f-db31-4939-ab90-7e2cb05e2efb",
                                                "sense_id": "ab0a4d2b-90aa-31d1-a12b-d44499f92838",
                                                "text": "I’ll do the washing-up if you put it all away."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "washing-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a426483c-a6c3-3213-8f57-912c8c47d7be",
                                        "entry_id": "ecd35314-cef7-3bf6-8c35-47c0a9c62384",
                                        "glosses": [
                                            "Of or relating to washing dishes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3746c2f1-703b-4edf-b705-ad8a74d0cd5f",
                                                "sense_id": "a426483c-a6c3-3213-8f57-912c8c47d7be",
                                                "text": "This washing-up liquid is kinder to my hands than that one."
                                            }
                                        ]
