                "senses": [
                    {
                        "sense_id": "97c62b13-8626-3ff3-ad11-8ea0e8c64685",
                        "entry_id": "8e6454ea-ef50-3d3e-bb60-c0f1121c463f",
                        "glosses": [
                            "Gesamtheit der Utensilien (Nadel, Faden, Schere, …), die zum Nähen benötigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d388b988-18a0-43e1-848b-a21f80036c09",
                                "sense_id": "97c62b13-8626-3ff3-ad11-8ea0e8c64685",
                                "text": "„Ich holte Nähzeug aus der Tasche, befestigte die Zügel an einem Haken und begann zu nähen.“"
                            },
                            {
                                "example_id": "29f7c9fd-9c9b-47fc-bf23-4e39f33c6f75",
                                "sense_id": "97c62b13-8626-3ff3-ad11-8ea0e8c64685",
                                "text": "„Es waren noch drei andere vorhanden, hier und dort standen sie im Haus herum, angefüllt mit alten Weihnachtskarten und mit Nähzeug, mit Knöpfen und ähnlichem Kram.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
