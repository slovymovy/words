                "senses": [
                    {
                        "sense_id": "f362ed79-9b76-3bd8-b0f4-3aefde03263c",
                        "entry_id": "4c4cf7f6-567a-34e7-b433-6461d041ad95",
                        "glosses": [
                            "im Gesetz festgelegte Merkmale für eine bestimmte Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d386d57-cdae-4b9b-81fa-af4bd7e0dc90",
                                "sense_id": "f362ed79-9b76-3bd8-b0f4-3aefde03263c",
                                "text": "Er weigerte sich, über den Tatbestand eine Aussage ohne seinen Anwalt zu machen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2ce0164d-1f9f-3538-8888-cbbadf9332ed",
                        "entry_id": "4c4cf7f6-567a-34e7-b433-6461d041ad95",
                        "glosses": [
                            "die feststehenden Tatsachen eines bestimmten Ereignisses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec655516-6f85-4acf-b13e-f87ed3d9fdcd",
                                "sense_id": "2ce0164d-1f9f-3538-8888-cbbadf9332ed",
                                "text": "„Für den gleichen Tatbestand war auch die Einstellung der Schüler zur Unterrichtsmethodik typisch: Sie sprachen sich in großer Mehrheit für eine mehr traditionelle Form des Fachunterrichts aus, in dem der Lehrer als unterrichtende Fachkraft auftritt, und waren überwiegend gegen Arbeitsgemeinschaften und freiere Formen des Unterrichtens.“"
                            },
                            {
                                "example_id": "e1b28c3a-139c-42ff-ac86-7f9ded2ea48a",
                                "sense_id": "2ce0164d-1f9f-3538-8888-cbbadf9332ed",
                                "text": "„Corinna sagt das so sachlich, als wäre sie über den Tatbestand überhaupt nicht schockiert.“"
                            },
                            {
                                "example_id": "6e4f025d-c4e1-4c09-867b-b17b78e5e461",
                                "sense_id": "2ce0164d-1f9f-3538-8888-cbbadf9332ed",
                                "text": "„Damit war der Tatbestand des vom Amt geraubten Verstandes zureichend erfüllt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d5e3984-dbdb-4a41-b839-5edb2da9c001",
