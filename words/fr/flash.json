{
    "word_family": [
        "flasher",
        "flasheur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dab3e2e-fef6-375e-a11f-973e814e3680",
                    "sense_definition": "Dispositif photographique produisant un éclair de lumière intense et bref pour éclairer la scène.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à activer le <w>flash</w> car la pièce est beaucoup trop sombre pour une belle photo."
                        },
                        {
                            "text": "Le photographe a branché un nouveau <w>flash</w> sur son boîtier avant de commencer la séance."
                        }
                    ],
                    "common_phrases": [
                        "coup de flash",
                        "flash intégré"
                    ]
                },
                {
                    "sense_id": "da3f72d7-8be8-3277-9a12-4d0f40537ddb",
                    "sense_definition": "Court bulletin d'information diffusé de façon urgente ou régulière dans les médias.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medias",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le film a été soudainement interrompu par un <w>flash</w> spécial à propos de l'événement politique."
                        },
                        {
                            "text": "J'écoute chaque matin le <w>flash</w> d'information de huit heures pour connaître l'actualité du jour."
                        }
                    ],
                    "common_phrases": [
                        "flash spécial",
                        "flash info"
                    ]
                },
                {
                    "sense_id": "bf2e4326-a37e-3971-9dc9-93259d12f017",
                    "sense_definition": "Éclair lumineux très bref et vif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un bref <w>flash</w> lumineux a déchiré la nuit avant de disparaître immédiatement dans l'obscurité."
                        },
                        {
                            "text": "L'automobiliste imprudent a vu le <w>flash</w> rouge du radar sur le bord de la route."
                        }
                    ],
                    "synonyms": [
                        "éclair"
                    ],
                    "common_phrases": [
                        "flash lumineux"
                    ]
                },
                {
                    "sense_id": "c61c71e2-8ed4-3005-8bcd-3e38272a52cd",
                    "sense_definition": "Idée, vision ou souvenir soudain et fulgurant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cherchant mes clés, j'ai eu un <w>flash</w> et je me suis souvenu où je les avais posées."
                        },
                        {
                            "text": "Cette odeur d'enfance a provoqué un véritable <w>flash</w> dans sa mémoire après tant d'années."
                        }
                    ],
                    "synonyms": [
                        "illumination",
                        "intuition"
                    ],
                    "common_phrases": [
