                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "50026fc7-ce9f-4eff-90b9-78b523c116be",
                                "sense_id": "35725238-874f-3bac-9e81-6faebae802e5",
                                "text": "„Es war das Angelus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
