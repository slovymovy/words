                                    },
                                    {
                                        "sense_id": "23b34cc4-2e97-3d27-b59f-6586da67ce0c",
                                        "entry_id": "a02b0cc5-d83d-37c0-b866-0f8670b468c2",
                                        "glosses": [
                                            "A group of vehicles travelling together for safety, especially one with an escort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6314df9b-af95-4003-97f3-59e92a76617a",
                                                "sense_id": "23b34cc4-2e97-3d27-b59f-6586da67ce0c",
                                                "text": "'Cause we got a great big convoy\nRockin' through the night.\nYeah, we got a great big convoy\nAin't she a beautiful sight?\nCome on and join our convoy\nAin't nothin' gonna get in our way.\nWe gonna roll this truckin' convoy\n'Cross the USA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975104ab-278b-3649-bcf3-d74dd6ff1faa",
                                        "entry_id": "a02b0cc5-d83d-37c0-b866-0f8670b468c2",
                                        "glosses": [
                                            "The act of convoying; protection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "convoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d95e940f-6e9a-31cf-9502-cfe067added7",
                                        "entry_id": "e098344c-1635-35ee-8abb-f00fd6702cce",
                                        "glosses": [
                                            "To escort a group of vehicles, and provide protection."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5088da85-7061-40dd-b8ba-220f2d6db9fb",
                                                "sense_id": "d95e940f-6e9a-31cf-9502-cfe067added7",
                                                "text": "A frigate convoys a merchantman."
                                            },
                                            {
                                                "example_id": "3eff5f35-2197-414d-bc0a-e5a060622a1c",
                                                "sense_id": "d95e940f-6e9a-31cf-9502-cfe067added7",
                                                "text": "I know ye skilful to convoy / The total freight of hope and joy / Into rude and homely nooks, / Shed mocking lustres on shelf of books, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d569134-be07-3808-a55e-ac8e9e060c0d",
