                            {
                                "example_id": "18941aa9-3970-4cf7-8798-dadba0afb379",
                                "sense_id": "528d2d00-b937-3add-8942-5bd6988d561c",
                                "text": "линя́й отсю́да!",
                                "translation": "get lost!",
                                "english": "get lost!"
                            },
                            {
                                "example_id": "49112d47-8dde-4041-a028-ce3d651327c2",
                                "sense_id": "528d2d00-b937-3add-8942-5bd6988d561c",
                                "text": "Спасённых уже́ не́ было ви́дно — они́ успе́ли благополу́чно слиня́ть.",
                                "translation": "The youngsters who’d been saved were nowhere to be seen – they’d managed to sneak off.",
                                "english": "The youngsters who’d been saved were nowhere to be seen – they’d managed to sneak off."
                            }
                        ]
                    }
