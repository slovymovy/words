                    {
                        "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                        "entry_id": "fc649ce2-2bc0-3559-9fb2-29a5b398e137",
                        "glosses": [
                            "überall, allerorten; nach allen Seiten, von allen Seiten; von allen, bei allen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974d19d0-c25b-47a6-83f4-66039a786215",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Mit deinem allseits „geschätzten“ Humor hast du nach und nach all deine Fürsprecher vergrault."
                            },
                            {
                                "example_id": "0da11873-0b85-47e7-932e-a5674a43311d",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Mittlerweile verdient Jaroslaw mit seinen allseits gelobten Torten sehr viel Geld."
                            },
                            {
                                "example_id": "e7af477c-4d82-4091-9e8f-09189f9e5ac5",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Bert ist allseits beliebt und ein gern gesehener Gast."
                            },
                            {
                                "example_id": "d4d43aa4-3d92-4a76-b181-80333535e43d",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Du weißt, dass deine Fachkunde allseits gefragt ist."
                            },
                            {
                                "example_id": "6802b893-5e34-417c-afdc-35272dd4193e",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Henrike hat mit ihren Vorschlägen allseits Zustimmung gefunden."
                            },
                            {
                                "example_id": "5907e155-545f-485b-9da5-3c62afb01dc3",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Ich habe mich allseits nach einer Sommelière umgehört, mein Bemühen blieb aber ohne Erfolg."
                            },
                            {
                                "example_id": "3239c903-581b-4e88-9042-ffb119e815e0",
                                "sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                                "text": "Es ist allseits bekannt, dass Frau Koflers Gatte hinter schwedischen Gardinen sitzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
