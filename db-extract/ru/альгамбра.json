                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43fdab47-ce95-4744-b807-d180563cc27a",
                                "sense_id": "ca590c5e-91b9-33e7-ac4d-34d53b7e247d",
                                "text": "Очарование Альгамбры не только в архитектуре, но и в искусном украшении, которое делает её сказочно прекрасной: резные деревянные своды, кружевная лепка, немыслимые узоры арабесок, каменная вязь аркад с колоннами белого мрамора."
                            }
                        ]
