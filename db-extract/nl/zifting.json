                    {
                        "sense_id": "e4a12a25-4d74-3640-94c6-3d68591a2147",
                        "entry_id": "3afaaf99-8c5d-3326-8323-e6e78c5254ac",
                        "glosses": [
                            "het electief verwijderen van iets; iets in verschillende componenten verdelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60c6356-e6e8-4be7-993a-15370bcf320f",
                                "sense_id": "e4a12a25-4d74-3640-94c6-3d68591a2147",
                                "text": "Te denken valt aan spreidingskaarten van christelijke partijen en scholen, van de Confessionele Vereniging en de Gereformeerde Bond en van diverse gereformeerde kerkverbanden. Van rechtlijnige ontwikkelingen zal dan niet gauw sprake zijn, eerder van onvoorspelbaarheid, dynamiek en zifting van bevolkingsgroepen."
                            },
                            {
                                "example_id": "5b779dab-5bc1-470d-b546-4c206210dd15",
                                "sense_id": "e4a12a25-4d74-3640-94c6-3d68591a2147",
                                "text": "De spreekwijzen der Schrift kennen aan de duivel een „ingeving in het hart” toe (Johannes 13:2), een „verblinding van het gemoed” (2 Korinthe 4:4), een „zifting van het geloof in het hart” (Lukas 22:31), een „ingang in de mens” (Lukas 22:3, Johannes 13:27), een „vervulling des harten” (Handelingen 5:3) en een „geest der verleiding en leugen in de mond” bij de profeten van Achab (1 Koningen 22)."
                            }
                        ]
                    }
                ],
