                "senses": [
                    {
                        "sense_id": "f5b518ce-4dfa-32b1-88cb-e721ee3966d6",
                        "entry_id": "1ca04300-c487-3dd3-843a-ca41ded3afbd",
                        "glosses": [
                            "Person, welche aktiv mit einer anderen Person eine Sprechverbindung herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf54c47-6894-4688-8e2a-1442f6289b87",
                                "sense_id": "f5b518ce-4dfa-32b1-88cb-e721ee3966d6",
                                "text": "Gegen einen anonymen Anrufer, der am Mittwochvormittag eine Bombendrohung für das Amtsgricht Rostock aussprach, wird jetzt wegen Störung des öffentlichen Friedens durch Androhung von Straftaten ermittelt."
                            },
                            {
                                "example_id": "47d4686b-c3bc-4db8-9a8e-4e63790dd27e",
                                "sense_id": "f5b518ce-4dfa-32b1-88cb-e721ee3966d6",
                                "text": "„Dieser Anrufer hatte allein dadurch, daß er anrief, das Recht erworben, ganz über ihn, den Vater, zu verfügen.“"
                            },
                            {
                                "example_id": "5a822314-72f2-4776-a6d8-1f1f9f264656",
                                "sense_id": "f5b518ce-4dfa-32b1-88cb-e721ee3966d6",
                                "text": "„Der Anrufer ließ nicht locker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f42cb01-08f8-47e9-a230-4c70656acd2f",
                        "source_entry_id": "1ca04300-c487-3dd3-843a-ca41ded3afbd",
                        "source_sense_id": "f5b518ce-4dfa-32b1-88cb-e721ee3966d6",
