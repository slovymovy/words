                "senses": [
                    {
                        "sense_id": "eb7bacde-fc99-3888-b663-93a18a7d313f",
                        "entry_id": "005cc0f8-2379-3993-98b1-1ab7c4cb0f44",
                        "glosses": [
                            "etwas, das eine nicht erkennbare Gefahr für Leib und Leben birgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93846da-42d1-4f6e-8de7-e22ed9bdb263",
                                "sense_id": "eb7bacde-fc99-3888-b663-93a18a7d313f",
                                "text": "„Plastik ist eine Seuche in Ozeanen und eine Todesfalle für Tiere.“"
                            },
                            {
                                "example_id": "ba1b4bf9-3201-44bc-a7ab-6b3267255409",
                                "sense_id": "eb7bacde-fc99-3888-b663-93a18a7d313f",
                                "text": "„Die wärmegedämmte Fassade hatte aus dem Hochhaus eine Todesfalle gemacht.“"
                            },
                            {
                                "example_id": "02df60fa-3be1-47c5-b533-6dfc043b3e07",
                                "sense_id": "eb7bacde-fc99-3888-b663-93a18a7d313f",
                                "text": "„Windkraftanlagen werden für Fledermäuse vermehrt zur Todesfalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
