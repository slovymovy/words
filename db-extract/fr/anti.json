                                    {
                                        "sense_id": "b4da32aa-5baf-3a6f-ac9b-62fc042a4455",
                                        "entry_id": "e12b3bf2-661a-3951-90b1-d3bf3ef86859",
                                        "glosses": [
                                            "Opposed to something."
