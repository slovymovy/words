                                        "entry_id": "1d359e65-626c-36ee-b1c9-44cee42135cc",
                                        "glosses": [
                                            "meistens mehrtägige Veranstaltung, bei der mehrere Künstler auftreten, mit zusätzlichem Programm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879b88c9-6ff6-427b-8b81-7bcf49f5aa36",
                                                "sense_id": "f277e65c-eefd-342c-b847-56373d808e9e",
                                                "text": "Ich war letztes Jahr auf drei Festivals."
                                            },
                                            {
                                                "example_id": "5ba9bda5-4962-4b2c-8da1-2a33473b0d28",
                                                "sense_id": "f277e65c-eefd-342c-b847-56373d808e9e",
                                                "text": "„Auch das Festival war etwas für Insider.“"
                                            },
                                            {
                                                "example_id": "68c7bbfe-e947-4f70-8df6-2894c06a64e4",
                                                "sense_id": "f277e65c-eefd-342c-b847-56373d808e9e",
                                                "text": "„Der spanische Opernstar Placido Domingo, der Mitte Juli nach der Behandlung einer Lungenembolie aus einem Madrider Krankenhaus entlassen worden ist, hat seine Termine als Sänger und Dirigent im Rahmen des Festivals für das 100-jährige Jubiläum der Arena von Verona bestätigt.“"
                                            },
                                            {
                                                "example_id": "54a21c0b-02a0-4764-9f92-5d7ad3a70def",
                                                "sense_id": "f277e65c-eefd-342c-b847-56373d808e9e",
                                                "text": "„Einmal im Jahr lade er etwa 15 Indigene aus unterschiedlichen Regionen zu einem Festival ein, um die Vielfalt der Kulturen zu zeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
