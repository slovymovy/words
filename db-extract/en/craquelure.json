                        "form_id": "8cce0cff-a2c5-47fe-8e20-f68d9c819df7",
                        "entry_id": "6a955e79-dd4b-3bd2-acef-d40bc2f59a76",
                        "tags": [
                            "plural"
                        ],
                        "form": "craquelures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                        "entry_id": "6a955e79-dd4b-3bd2-acef-d40bc2f59a76",
                        "glosses": [
                            "The distinctive pattern of hairline cracks in the surface of an old painting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4cbe1887-fd87-4138-9105-1284255e7754",
                                "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                "text": "Documentary evidence is what he prefers; but, failing that, he will put up with a cunning concoction of dates and watermarks, cabalistic signatures, craquelure, patina, chemical properties of paint and medium, paper and canvas, all sorts of collateral evidence, historical and biographical, and racy tricks of brush or pen."
                            },
                            {
                                "example_id": "eb0da575-41ff-42ed-a659-5a31ef156268",
                                "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                "text": "Alan squinted. It was the robot, the one he’d given her, the pretty thing with the Dutch Master craquelure up its tuna-can skirts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32aeb0b1-68df-4ca0-a256-deccce6e3184",
                        "source_entry_id": "6a955e79-dd4b-3bd2-acef-d40bc2f59a76",
                        "source_sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                        "source_sense_description": "hairline cracks in painting",
                        "target_lang_word": "craquelure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "craquelure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e1a9fbd-b715-3fbd-bea7-5e1209b644b5",
                                        "entry_id": "01b7dc5a-8147-31fe-880f-16dc386583e9",
                                        "glosses": [
                                            "Fendillement qui se produit dans un vernis, dans un émail, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c501315a-8d86-4e78-b0ba-3b63b65c6dd6",
                                                "sense_id": "9e1a9fbd-b715-3fbd-bea7-5e1209b644b5",
                                                "text": "Ce tableau est plein de craquelures."
                                            },
                                            {
                                                "example_id": "3952944d-3b83-443b-99cd-8346a38a5dd0",
                                                "sense_id": "9e1a9fbd-b715-3fbd-bea7-5e1209b644b5",
                                                "text": "Nous aimons la craquelure, les traces de la polychromie effacée, la mutilation de la tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e01c4d-5992-3393-ab4e-418a6ce6606e",
                                        "entry_id": "01b7dc5a-8147-31fe-880f-16dc386583e9",
                                        "glosses": [
                                            "Fissure."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce34b732-0b29-451f-b5b2-73e5fe56b337",
                                                "sense_id": "43e01c4d-5992-3393-ab4e-418a6ce6606e",
                                                "text": "(…) et tout lui paraissait merveilleusement beau; la maison à façade de briques serrées les unes contre les autres de chaque côté de la rue, un épagneul qui venait de s’arrêter devant lui pour renifler une ordure, une grosse femme en bermuda rose qui exhibait sans vergogne ses mollets variqueux, les craquelures du trottoir, les pelouses rachitiques et même le vent qu’il ne voyait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434576a7-c3bc-369b-9a6f-3e9490364cb5",
                                        "entry_id": "01b7dc5a-8147-31fe-880f-16dc386583e9",
                                        "glosses": [
                                            "Fissure de petites dimensions qui se forme dans un matériau polymère et dont les parois restent reliées par des filaments."
                                        ],
                                        "tags": [
                                            "Polymères"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
