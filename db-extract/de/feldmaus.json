                "senses": [
                    {
                        "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                        "entry_id": "2e06fb60-3913-3e00-b26c-6c7a3c5bc1bc",
                        "glosses": [
                            "eine kleine graubraune Wühlmaus, die auf Feldern und Wiesen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d61756-351e-4d89-b0c3-cf7a4261c634",
                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                "text": "Die Feldmaus kann bis 10 cm groß werden."
                            },
                            {
                                "example_id": "bfba06d3-2709-4d4d-b3ae-ce1c4532b4f8",
                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                "text": "Das Feld ist von Feldmäusen durchlöchert."
                            },
                            {
                                "example_id": "7bbf6766-5c52-4078-be69-b7d78c2c5720",
                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                "text": "Die Feldmäuse leben in Kolonien mit bis zu 20 Tieren unter der Erde."
                            },
                            {
                                "example_id": "5672585d-52b7-4a33-bc27-6670a799eb85",
                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                "text": "„Hochsommerlicher Heuduft hing schwer über dem Hang, der voller Goldrute stand und von Feldmäusen wimmelte und sich zur Marsch hinuntersenkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
