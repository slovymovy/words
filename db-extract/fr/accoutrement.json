        "fr-extract.jsonl": [
            {
                "entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                "word": "accoutrement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eb443c6c-16c9-4bf3-b998-fc4808f9e724",
                        "entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "accoutrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                        "entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                        "glosses": [
                            "Habillement."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3d1c0ac6-911c-4c70-b756-da6b70d17001",
                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                "text": "Enfin je n'y tins plus, je mis bas pantalon, bottes et chaussettes, je complétai mon accoutrement de pêcheur sur le modèle de celui de Maurice, […]."
                            },
                            {
                                "example_id": "faccbed9-51c5-43fa-8a2e-aef1f9701b69",
                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                "text": "Des bonnets de fourrure, des ceintures de peau de daim complétaient l'accoutrement."
                            },
                            {
                                "example_id": "9e58f2e7-1dd4-4010-83d4-0d3ebcfa6f32",
                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                "text": "[…], un accoutrement de voyage qui n’est de bon goût ni dans sa coupe démodée ni dans sa couleur tapageuse."
                            },
                            {
                                "example_id": "f81eeb62-4e80-48e1-9607-44926e41a32a",
                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                "text": "Pensant à son accoutrement, il se défit de son faux-col et de sa casquette blanche d’aéronaute, qui pouvaient le trahir, […]."
                            },
                            {
                                "example_id": "a3ee8d15-ad80-46f1-a6f1-81afaa71d132",
                                "sense_id": "bb4653c3-5b5e-34fd-9e6f-89cc63895864",
                                "text": "Où donc était-il passé depuis le temps, car il n’avait assurément pu songer, dans l’accoutrement où il était, à descendre en ville ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "414e670f-beef-3924-8b1c-e4889a598485",
                        "entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                        "glosses": [
                            "Tenue vestimentaire surprenante."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "72497fd9-8d3e-40aa-b087-28d9cf8e3c7e",
                                "sense_id": "414e670f-beef-3924-8b1c-e4889a598485",
                                "text": "On lui ordonna d’ôter la belle pelisse dont elle était revêtue, ce qu’elle refusa de faire, et si opiniâtrement que les valets du bourreau furent obligés de l’attacher au poteau dans cet accoutrement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8defb3bc-5a07-4a21-b7cc-7687f8f2fe09",
                        "source_entry_id": "2c831d2a-4308-3d63-851b-436f60a570ef",
                        "target_lang_word": "dressing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dressing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d879ea5-addb-3ac8-9959-cc870864df62",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Material applied to a wound for protection or therapy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7f64a5-65e0-4264-bba8-bf1d5ebcf57d",
                                                "sense_id": "6d879ea5-addb-3ac8-9959-cc870864df62",
                                                "text": "She removed Stranleigh’s coat with a dexterity that aroused his imagination. The elder woman returned with dressings and a sponge, which she placed on a chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b17f01b4-b864-3a18-9812-237e1514a269",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "A sauce, especially a cold one for salads."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95208a35-8b2c-47d3-a7c1-7c5d19d67a64",
                                                "sense_id": "b17f01b4-b864-3a18-9812-237e1514a269",
                                                "text": "I was even more excited to tailor it with a choice of dressings — blue cheese, ranch, French, Russian, Italian, creamy Italian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c65d333-f26b-3c44-8687-029993dcc04a",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Something added to the soil as a fertilizer etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6348edd3-5ae6-3e39-9265-4bdf4e732f6c",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "The activity of getting dressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "127fab7d-27e3-4a93-a1a6-8d5d3072f1e3",
                                                "sense_id": "6348edd3-5ae6-3e39-9265-4bdf4e732f6c",
                                                "text": "Considered thus, the performance is a translation into images of bodies on display, as is well demonstrated by Monsieur Jourdain's repeated dressings and undressings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9808848d-9512-3f00-a3ad-f9efe7975f7e",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Dress; raiment; especially, ornamental habiliment or attire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc01089-0a4b-4e5f-90e9-3c4f06ce103e",
                                                "sense_id": "9808848d-9512-3f00-a3ad-f9efe7975f7e",
                                                "text": "Women ought to repair the losses , time and years have made in their features, with dressings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75335880-1342-3c42-bc1c-993c7970bebd",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "The stuffing of fowls, pigs, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5820e66-d541-36d2-adf1-10657bf804e4",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Gum, starch, etc., used in stiffening or finishing silk, linen, and other fabrics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee6898a0-6e27-3343-af37-09de0111f84a",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "An ornamental finish, such as a moulding around doors, windows, or on a ceiling."
                                        ],
                                        "tags": [
                                            "countable",
