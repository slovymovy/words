    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "565d5b8f-3298-31e3-8b82-387ab688558f",
                    "sense_definition": "Een verdikking van een wortel of stengel waarin een plant reservestoffen opslaat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aardappelplant slaat reservevoedsel op in een ondergrondse <w>knol</w>.",
                            "target_lang_translations": {
                                "en": "The potato plant stores reserve nutrients in an underground <w>tuber</w>."
                            }
                        },
                        {
                            "text": "In het voorjaar planten we de <w>knollen</w> van verschillende bloemen in de tuin.",
                            "target_lang_translations": {
                                "en": "In the spring we plant the <w>bulbs</w> of different flowers in the garden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ondergrondse knol"
                    ],
                    "target_lang_definitions": {
                        "en": "A thickening of a root or stem in which a plant stores nutrients."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tuber",
                                "target_lang_sense_clarification": "thickened plant root or stem"
                            },
                            {
                                "target_lang_word": "bulb",
                                "target_lang_sense_clarification": "underground storage organ of certain plants, like flower bulbs"
                            },
                            {
                                "target_lang_word": "corm",
                                "target_lang_sense_clarification": "botanical storage organ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beaf0c99-57d3-3f45-b59c-76c68205c2e8",
                    "sense_definition": "Een eetbare ronde wortel van bepaalde gewassen, zoals een raap of knolraap.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer oogstte verse <w>knollen</w> om soep van te maken.",
                            "target_lang_translations": {
                                "en": "The farmer harvested fresh <w>turnips</w> to make soup."
                            }
                        },
                        {
                            "text": "Voor het avondeten schilden we een grote <w>knol</w> uit de moestuin.",
                            "target_lang_translations": {
                                "en": "For dinner we peeled a large <w>turnip</w> from the vegetable garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "knolraap"
                    ],
                    "common_phrases": [
                        "knollen voor citroenen verkopen"
                    ],
                    "target_lang_definitions": {
                        "en": "An edible round root of certain plants, such as a turnip or rutabaga."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turnip",
                                "target_lang_sense_clarification": "edible root vegetable"
                            },
                            {
                                "target_lang_word": "swede",
                                "target_lang_sense_clarification": "rutabaga or brassica root vegetable"
                            },
                            {
                                "target_lang_word": "root vegetable",
                                "target_lang_sense_clarification": "general edible underground vegetable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d30eb392-4194-3734-9f79-9ce7ae00c84f",
                    "sense_definition": "Een oud, mager of versleten werkpaard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "paard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer liet zijn oude <w>knol</w> rustig grazen in het weiland.",
                            "target_lang_translations": {
                                "en": "The farmer let his old <w>nag</w> graze peacefully in the meadow."
                            }
                        },
                        {
                            "text": "Die oude <w>knol</w> kan de zware wagen echt niet meer trekken.",
                            "target_lang_translations": {
                                "en": "That old <w>nag</w> really cannot pull the heavy cart anymore."
                            }
                        }
                    ],
                    "synonyms": [
                        "guil"
                    ],
                    "common_phrases": [
                        "oude knol"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak ietwat pejoratief of schertsend gebruikt voor een paard."
                        }
                    ],
                    "target_lang_definitions": {
