                    {
                        "sense_id": "19190cdb-4bd5-35ea-85c7-a16f89c40ce1",
                        "entry_id": "2aec8fc6-a273-345c-9d32-9b752309342f",
                        "glosses": [
                            "arabischer Titel für Fürst, Prinz oder Befehlshaber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "845818b4-adf5-4dbd-991a-0977dc532af9",
                                "sense_id": "19190cdb-4bd5-35ea-85c7-a16f89c40ce1",
                                "text": "„In frühislamischer Zeit befehligte ein Emir eine muslimische Soldatentruppe.“"
                            },
                            {
                                "example_id": "93a48520-09c8-403a-a2ad-7ad893e2126d",
                                "sense_id": "19190cdb-4bd5-35ea-85c7-a16f89c40ce1",
                                "text": "„Es ist ein wichtiger Prestigeerfolg für den Emir.“"
                            },
                            {
                                "example_id": "d47611a2-7ed4-4918-8267-ae4e16637cec",
                                "sense_id": "19190cdb-4bd5-35ea-85c7-a16f89c40ce1",
                                "text": "„Damals ließ Emir Nur zum Schutz Harars eine mächtige Stadtmauer errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
