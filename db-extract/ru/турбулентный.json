                        "source_entry_id": "61d786df-4a24-3584-b418-9b354b5ccd0e",
                        "source_sense_id": "6610a040-594b-3f55-bb55-ebd779e6e465",
                        "target_lang_word": "turbulent",
                        "target_lang_code": "en",
