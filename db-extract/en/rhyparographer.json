                        "glosses": [
                            "A person who paints or writes about distasteful or sordid subjects."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "07edd1a5-835d-4b5b-9a43-68cd23f4c65c",
                                "sense_id": "a0f76389-e6a5-3ebd-808d-64f3bb6fd080",
                                "text": "Realism had its vogue in Greece when Euripedes dared to set upon the stage both men and women as they really are; but after the time of Euripedes there is no more realism in Greek literature, though its influence is felt in other fields, as, for instance, in the field of art among the rhyparographers of Pergamum, with their floors so cleverly defaced with melon rinds and scraps of garbage artfully put in by brushes of an almost Flemish cunning."
                            },
                            {
                                "example_id": "d6188548-dd6a-484c-8b3a-702ec4871e3e",
                                "sense_id": "a0f76389-e6a5-3ebd-808d-64f3bb6fd080",
                                "text": "The carnivalesque here is not simply an inversion of turning a text on its head to emphasize the chthonic origin of the human, as is the case for Rabelais as rhyparographer, according to Mikhail Bakhtin's famous reading."
                            }
                        ]
                    }
