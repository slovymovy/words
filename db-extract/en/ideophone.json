                        "entry_id": "f11b83d5-a71c-3da9-b93b-ef3b503cb84b",
                        "glosses": [
                            "A word that uses sound symbolism to express aspects of events that can be experienced by the senses, like smell, color, shape, sound, action, or movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b79c6f7-b3ec-4267-8beb-54fbab8104fb",
                                "sense_id": "c4f7e76c-d2c0-367d-b2c5-2caaea20e875",
                                "text": "1969 October, William J. Samarin, The Art of Gbeya Insults, in International Journal of American Linguistics 35(4), page 325, JSTOR\nIn insults the ideophone occurs either in its characteristic position, the verb phrase, or uncharacteristically as a modifier in a noun phrase."
                            }
                        ]
                    }
                ],
