                                        "sense_id": "c9e0b2d6-3cc2-3db8-b6e7-1e3a8fd26a1e",
                                        "entry_id": "810fd720-fcb1-3ba7-a3f1-bc546f9faf2c",
                                        "glosses": [
                                            "beutelartige Handtasche für Frauen aus weichem Material"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c47d7f-26e3-46ae-828c-400ded4d4b14",
                                                "sense_id": "c9e0b2d6-3cc2-3db8-b6e7-1e3a8fd26a1e",
                                                "text": "„Nun zieht sie sie aus und holt aus ihrem Pompadour ein Paar Spangenschuhe, die ich noch nie an ihren Füßen gesehen habe.“"
                                            },
                                            {
                                                "example_id": "09eb0624-27b7-4e79-94b2-df7b6b07ccab",
                                                "sense_id": "c9e0b2d6-3cc2-3db8-b6e7-1e3a8fd26a1e",
                                                "text": "„Tante Marguerite fühlte sofort heraus, wie günstig heute die Dinge für sie lagen, und begann denn auch in demselben Augenblicke, wo sie sich gesetzt und die Seidenhandschuh in ihren Pompadour gesteckt hatte, sich dem hohen Adel königlicher Residenzien zuzuwenden, diesmal mit Umgehung der »Allerhöchsten Herrschaften«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "559fad42-05fd-3319-9cd6-94855ab4c6bc",
                                        "entry_id": "810fd720-fcb1-3ba7-a3f1-bc546f9faf2c",
                                        "glosses": [
                                            "Haarschnitt mit langem, nach oben gestylten Deckhaar"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
