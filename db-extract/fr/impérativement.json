        "fr-extract.jsonl": [
            {
                "entry_id": "b8d9b69b-a42b-31f1-8ccb-b116fbbb2c35",
                "word": "impérativement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3600689-2c5f-3d10-a9f1-76d59c20d274",
                        "entry_id": "b8d9b69b-a42b-31f1-8ccb-b116fbbb2c35",
                        "glosses": [
                            "D’une manière impérative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be7fdd0f-0715-4883-868c-86ccff2aeb09",
                                "sense_id": "b3600689-2c5f-3d10-a9f1-76d59c20d274",
                                "text": "Le nombre et la place des trous du tuyau varie selon le type de musique que l'on joue. A l'origine, il est souvent fixé impérativement par des règles d'origine extra-acoustique, magiques ou religieuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56239c0c-3840-4775-8194-18ee53cee810",
                        "source_entry_id": "b8d9b69b-a42b-31f1-8ccb-b116fbbb2c35",
                        "source_sense_id": "b3600689-2c5f-3d10-a9f1-76d59c20d274",
                        "target_lang_word": "authoritatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authoritatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd41570-5232-36f8-954a-201d2d103ec9",
                                        "entry_id": "f7f84e20-4808-373f-a71d-42cae4e31c29",
                                        "glosses": [
                                            "In an authoritative manner; with authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0de0a4-bfe2-4905-b9b2-ef9395cbde1a",
                                                "sense_id": "0fd41570-5232-36f8-954a-201d2d103ec9",
                                                "text": "He has, of course, the right to speak authoritatively, and he laughs at my theory that there was a crack in Pansay's head and a little bit of the Dark World came through and pressed him to death."
                                            },
                                            {
                                                "example_id": "6dcd0dad-48ac-48d9-b2a6-6329133c80ab",
                                                "sense_id": "0fd41570-5232-36f8-954a-201d2d103ec9",
                                                "text": "The inability of Trump's own spokespeople to speak authoritatively on the president's thinking and actions -- a challenge even Trump himself has acknowledged -- has left the White House with an enormous credibility gap, and has tarnished the reputations of many of its most visible spokespeople."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93bce46d-a9bb-432b-a4f3-22289c6e173f",
                        "source_entry_id": "b8d9b69b-a42b-31f1-8ccb-b116fbbb2c35",
                        "source_sense_id": "b3600689-2c5f-3d10-a9f1-76d59c20d274",
                        "target_lang_word": "imperatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                        "entry_id": "f259221b-2b7e-3d2a-a19d-c9114b962243",
                                        "glosses": [
                                            "In an imperative manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a48866-76f0-489e-ab60-4121b204c088",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "Improvement is imperatively needed."
                                            },
                                            {
                                                "example_id": "e36827c4-dce4-4dc4-8d7f-593e894b9c57",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "1625, John Donne, Sermon preached 26 April, 1625, in Fifty Sermons, Volume 2, London: M.F., J. Marriot and R. Royston, 1649, Sermon 33, p. 299,\n[…] being a mother, and having the dignity of a Parent upon her, she does not proceed supplicatorily, she does not pray them, nor intreat them, she does not say, I would you would go forth, and I would you would looke out, but it is Egredimini, & videte, imperatively, authoritatively, Do it, you must do it: […]"
                                            },
                                            {
                                                "example_id": "bd5a0a02-3e67-432e-8598-f72dde75579d",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "If a man has been possessed by devils for long enough they will rend him as they leave him, however imperatively they may have been cast out. Ernest did not stay long where he was, for he feared each moment that his father and mother would come out."
                                            },
                                            {
                                                "example_id": "2a2d1b1b-c697-4f52-8df8-362766d48a45",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "The military band happened to be braying operatic selections on the plaza just then, and twice he raised his hand imperatively for silence in order to listen to a favourite passage."
                                            },
                                            {
                                                "example_id": "955a98dd-289e-4ce9-b045-17acf9e4f2a2",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "— Come here, Tommy, his sister called imperatively, at once! And you, Jacky, for shame to throw poor Tommy in the dirty sand. Wait till I catch you for that."
                                            },
                                            {
                                                "example_id": "d5f5857b-ed0e-4c2c-961b-aafe3808ccdc",
                                                "sense_id": "d8448f34-8cb8-3dec-b0b1-b11064b12486",
                                                "text": "[…] wedging his tense arm imperatively under mine, Tom Buchanan compelled me from the room as though he were moving a checker to another square."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26871800-ed30-485c-9a46-c73c741dedc0",
                        "source_entry_id": "b8d9b69b-a42b-31f1-8ccb-b116fbbb2c35",
