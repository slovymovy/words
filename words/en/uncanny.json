{
    "word_family": [
        "uncannily",
        "uncanniness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24b4d6bb-c829-3086-8390-b006c100b2c3",
                    "sense_definition": "Strange and mysterious in an unsettling way, often appearing as if supernatural or beyond normal explanation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bore an <w>uncanny</w> resemblance to the man in the old photograph from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Он обладал <w>поразительным</w> сходством с человеком на старой фотографии девятнадцатого века."
                            }
                        },
                        {
                            "text": "The detective had an <w>uncanny</w> knack for finding clues that everyone else had completely missed.",
                            "target_lang_translations": {
                                "ru": "У детектива было <w>сверхъестественное</w> чутьё на улики, которые все остальные совершенно упускали из виду."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerie",
                        "weird",
                        "unearthly",
                        "mysterious"
                    ],
                    "antonyms": [
                        "ordinary",
                        "natural",
                        "normal"
                    ],
                    "common_phrases": [
                        "uncanny resemblance",
                        "uncanny knack",
                        "uncanny ability",
                        "uncanny feeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Странный и таинственный, вызывающий тревогу или дискомфорт, часто кажущийся сверхъестественным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверхъестественный",
                                "target_lang_sense_clarification": "выходящий за рамки обычного"
                            },
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "вызывающий необъяснимый страх"
                            },
                            {
                                "target_lang_word": "поразительный",
                                "target_lang_sense_clarification": "о необычайном сходстве или способности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "768a3677-407e-3b8b-ae32-085da0851f6a",
                    "sense_definition": "Lacking care or attention; being careless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "careless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>uncanny</w> approach to the delicate task resulted in several avoidable mistakes.",
                            "target_lang_translations": {
                                "ru": "Его <w>небрежный</w> подход к деликатной задаче привел к нескольким ошибкам, которых можно было избежать."
                            }
                        },
                        {
                            "text": "The worker was criticized for his <w>uncanny</w> attitude toward safety regulations in the factory.",
                            "target_lang_translations": {
                                "ru": "Рабочего критиковали за его <w>беспечное</w> отношение к правилам техники безопасности на заводе."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless",
                        "negligent",
                        "heedless"
                    ],
                    "antonyms": [
                        "careful",
                        "attentive"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily found in specific regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий отсутствие заботы или внимания; неосторожный или небрежный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "о подходе к делу"
                            },
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "о поведении или отношении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5bba0db-c056-35fe-af9e-bc80cef24610",
                    "sense_definition": "A psychological concept referring to something that is simultaneously familiar and strange, leading to a sense of discomfort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychological_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his famous essay, Freud explores how the <w>uncanny</w> arises from repressed childhood memories.",
                            "target_lang_translations": {
                                "ru": "В своем знаменитом эссе Фрейд исследует, как <w>жуткое</w> возникает из подавленных детских воспоминаний."
                            }
                        },
                        {
                            "text": "The film uses lighting and sound to evoke the <w>uncanny</w>, making the domestic setting feel hostile.",
                            "target_lang_translations": {
                                "ru": "В фильме используются свет и звук, чтобы вызвать чувство <w>зловещего</w>, заставляя домашнюю обстановку казаться враждебной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the uncanny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психологическая концепция, описывающая нечто одновременно знакомое и чуждое, вызывающее чувство дискомфорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жуткое",
                                "target_lang_sense_clarification": "психологический термин (по Фрейду)"
                            },
                            {
                                "target_lang_word": "зловещее",
                                "target_lang_sense_clarification": "в контексте эстетики и психологии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}