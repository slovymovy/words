{
    "word_family": [
        "bouderie",
        "boudeur",
        "boudeuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec3472f0-7483-3dbd-9016-2e3acd8c9ab1",
                    "sense_definition": "Manifester sa mauvaise humeur ou son mécontentement par un silence obstiné ou une expression renfrognée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement_humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant fâché refuse de parler et continue de <w>bouder</w> dans son coin."
                        },
                        {
                            "text": "Depuis leur dispute d'hier matin, elle le <w>boude</w> et évite ostensiblement son regard."
                        }
                    ],
                    "synonyms": [
                        "faire la tête",
                        "faire la moue"
                    ],
                    "common_phrases": [
                        "bouder dans son coin"
                    ]
                },
                {
                    "sense_id": "58da0c88-624a-3095-ae97-ef827ca4cce7",
                    "sense_definition": "Dédaigner ou éviter délibérément quelque chose, refuser d'y assister ou d'y participer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refus_abstention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens déçus ont choisi de <w>bouder</w> les urnes lors du dernier scrutin."
                        },
                        {
                            "text": "Le public semble <w>bouder</w> ce festival de musique depuis l'augmentation du prix d'entrée."
                        }
                    ],
                    "common_phrases": [
                        "bouder les urnes",
                        "bouder un événement"
                    ]
                },
                {
                    "sense_id": "9e9d3008-c3b0-39d5-8183-1ef200f27a86",
                    "sense_definition": "Rechigner ou hésiter à s'engager dans une action ou à profiter de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rechignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Invités à cette dégustation gastronomique, les convives n'ont pas <w>boudé</w> leur plaisir."
                        },
                        {
                            "text": "Les ouvriers n'ont pas <w>boudé</w> à la tâche pour achever les travaux avant l'hiver."
                        }
                    ],
                    "common_phrases": [
                        "ne pas bouder son plaisir",
                        "bouder à la tâche"
                    ]
                }
            ]
        }
    ]
}