        "fr-extract.jsonl": [
            {
                "entry_id": "1f56cd19-7c8a-3d32-9941-b875277de8ad",
                "word": "bougnat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7a51e372-fed7-4685-921e-e42ac6b7d1cb",
                        "entry_id": "1f56cd19-7c8a-3d32-9941-b875277de8ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "bougnats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                        "entry_id": "1f56cd19-7c8a-3d32-9941-b875277de8ad",
                        "glosses": [
                            "Marchand de charbon originaire du sud du Massif Central qui tenait souvent un café."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "023e832e-b081-4e6f-8fe7-d77f47006eeb",
                                "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                                "text": "J’la crève, viens-tu prendre un glace chez l’bougnat ?"
                            },
                            {
                                "example_id": "f4a13aee-fcc3-401f-a882-09035d5c32e5",
                                "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                                "text": "Je vais chez le bougnat de la rue de la Colombe acheter deux cent cinquante grammes de charbon, puis chez un cordonnier à qui mon oncle a donné l’autre semaine des godasses à ressemeler."
                            },
                            {
                                "example_id": "f41fd496-1e9f-45e2-9407-fe41875913f8",
                                "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                                "text": "D’un côté de la porte, il y avait une teinturerie ; de l’autre, la boutique d’un bougnat."
                            },
                            {
                                "example_id": "ade356ee-c523-4b77-8084-63c53eb0b7ba",
                                "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                                "text": "En ce chaud début d’après-midi, la rue Mouffetard, si animée à d’autres heures, semblait plongée dans une sieste profonde. Toutes les boutiques, à l’exception du bougnat et du marchand de tabac, étaient fermées."
                            },
                            {
                                "example_id": "835d9dc6-fcda-47b6-86be-2335ae812e15",
                                "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                                "text": "À Montsalvy, les Salvagnac sont bougnats de père en fils et il a beaucoup de qualités, l’inspecteur issu de cette tenace lignée."
                            },
                            {
                                "example_id": "877bf689-e4f3-4e6f-9f60-202c71bf0a69",
                                "sense_id": "c6363c81-6fd7-3bf3-a5f9-cd8454823300",
                                "text": "Le maître d’école et ses potaches,\nLe maire, le bedeau, le bougnat\nNégligeaient carrément leur tâche\nPour voir ça"
                            }
                        ]
                    },
                    {
                        "sense_id": "427ab563-1279-35cc-8d85-e3616596d42b",
                        "entry_id": "1f56cd19-7c8a-3d32-9941-b875277de8ad",
                        "glosses": [
                            "Auvergnat."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
