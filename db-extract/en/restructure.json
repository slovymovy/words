                    {
                        "sense_id": "019f533a-ad48-3471-89ae-7336e0df91c1",
                        "entry_id": "e31086ae-d3e6-3c6f-b1ac-9997b1c784bd",
                        "glosses": [
                            "To change the organization of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab17d84-f590-4ef1-b0ed-f030ce3d2b57",
                                "sense_id": "019f533a-ad48-3471-89ae-7336e0df91c1",
                                "text": "On Tuesday, a proposal to fundamentally restructure the Minneapolis police department in the wake of George Floyd’s death in 2020 was soundly defeated, a setback that even many Democrats acknowledged could be laid at the feet of the “defund the police” movement that some within the party embraced last summer."
                            }
                        ]
                    },
                    {
                        "sense_id": "a50b8287-7376-3add-9b54-f381c705705b",
                        "entry_id": "e31086ae-d3e6-3c6f-b1ac-9997b1c784bd",
                        "glosses": [
                            "To modify the terms of a loan, providing relief to a debtor who would otherwise be forced to default."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7120b66b-9c14-47e6-a34c-c363d2f56f73",
                                "sense_id": "a50b8287-7376-3add-9b54-f381c705705b",
                                "text": "Valencia were in crisis, a club with two stadiums – one they could not sell and one that they could not afford to finish building – and a debt of €230m, the repayment of which was restructured."
                            }
                        ]
                    }
                ],
