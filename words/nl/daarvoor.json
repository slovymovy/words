                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sinds kort woon ik in Utrecht, maar <w>daarvoor</w> woonde ik jarenlang in Amsterdam.",
                            "target_lang_translations": {
                                "ru": "С недавних пор я живу в Утрехте, но <w>до этого</w> я много лет жил в Амстердаме.",
                                "en": "I've been living in Utrecht since recently, but <w>before that</w> I lived in Amsterdam for years.",
                                "it": "Da poco vivo a Utrecht, ma <w>prima di allora</w> ho vissuto per anni ad Amsterdam.",
                                "pl": "Od niedawna mieszkam w Utrechcie, ale <w>przedtem</w> mieszkałem przez lata w Amsterdamie.",
                                "de": "Seit Kurzem wohne ich in Utrecht, aber <w>davor</w> habe ich jahrelang in Amsterdam gewohnt.",
                                "fr": "Depuis peu, j'habite à Utrecht, mais <w>avant cela</w> j'ai vécu pendant des années à Amsterdam.",
                                "cs": "Od nedávna bydlím v Utrechtu, ale <w>předtím</w> jsem roky bydlel v Amsterdamu.",
                                "tr": "Kısa bir süre önce Utrecht'te yaşamaya başladım, ama <w>ondan önce</w> yıllarca Amsterdam'da yaşadım.",
                                "es": "Hace poco que vivo en Utrecht, pero <w>antes de eso</w> viví durante años en Ámsterdam.",
                                "zh": "我最近才搬到乌得勒支，但<w>在此之前</w>我在阿姆斯特丹住了很多年。"
                            }
                        },
                        {
                            "text": "Het feest begint om acht uur, maar kort <w>daarvoor</w> gaan we nog even wat eten.",
                            "target_lang_translations": {
                                "ru": "Вечеринка начинается в восемь часов, но незадолго <w>до этого</w> мы перекусим.",
                                "en": "The party starts at eight o'clock, but shortly <w>before that</w> we're going to grab a bite to eat.",
                                "it": "La festa inizia alle otto, ma poco <w>prima</w> andiamo a mangiare qualcosa.",
                                "pl": "Impreza zaczyna się o ósmej, ale krótko <w>przedtem</w> pójdziemy jeszcze coś zjeść.",
                                "de": "Die Party beginnt um acht Uhr, aber kurz <w>davor</w> gehen wir noch etwas essen.",
                                "fr": "La fête commence à huit heures, mais peu <w>avant cela</w> nous allons manger un morceau.",
                                "cs": "Večírek začíná v osm hodin, ale krátce <w>předtím</w> se ještě půjdeme někam najíst.",
                                "tr": "Parti saat sekizde başlıyor, ama kısa bir süre <w>öncesinde</w> bir şeyler yiyeceğiz.",
                                "es": "La fiesta empieza a las ocho, pero poco <w>antes</w> vamos a comer algo.",
                                "zh": "聚会八点开始，但我们会在那<w>之前</w>先去吃点东西。"
                            }
                        }
