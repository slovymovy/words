                        "examples": [
                            {
                                "example_id": "6641c074-71fa-433f-b157-dbdd52385376",
                                "sense_id": "21a7b6ab-69e0-3598-9a53-22af2663f710",
                                "text": "DSW verhoogt de premie met 45 euro tot 1185 euro op jaarbasis, wat neerkomt op een stijging van 3,75 euro per maand. Daarmee is de premiestijging lager dan de 7 euro per maand die het kabinet vorige week voorspelde."
                            },
                            {
                                "example_id": "bc7b805e-be35-49e9-ad19-43f163c309f8",
                                "sense_id": "21a7b6ab-69e0-3598-9a53-22af2663f710",
                                "text": "Een deel van de premiestijging wordt opgevangen door de overheid, die mensen met een laag inkomen ondersteunt. Maar wie meer verdient, draait zelf voor de extra kosten op. Dat leidde afgelopen tijd al tot een stortvloed van klachten van mensen met een laag inkomen: ze verdienen te veel om subsidie te krijgen, maar kunnen een particuliere verzekering niet of nauwelijks betalen."
                            }
                        ]
