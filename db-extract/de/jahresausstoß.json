                            {
                                "example_id": "7c076711-3ea7-44b5-9781-5a41a6b82500",
                                "sense_id": "a46e9b09-3a89-3533-93f9-c3eb083779b0",
                                "text": "„Obwohl Methan ein starkes Treibhausgas ist, beschwichtigen die Forscher, was die Folgen dieses Ausbruchs angeht: Die freigesetzte Gasmenge entspreche nur 0,5 Prozent des gesamten Jahresausstoßes der Bundesrepublik.“"
                            },
                            {
                                "example_id": "a67a8c02-1591-436f-bcec-e7cf2503044e",
                                "sense_id": "a46e9b09-3a89-3533-93f9-c3eb083779b0",
                                "text": "„Bereits die im Juni emittierten 50 Millionen Tonnen CO2 - der Jahresausstoß von Schweden - hätten demnach die Juni-Emissionen der vergangenen acht Jahre zusammen überstiegen.“"
                            }
                        ],
