                                        "entry_id": "6e3ffcc2-6273-3aee-9be7-bf855d3826ec",
                                        "glosses": [
                                            "Person oder Institution, die eine Information durch ein Medium zu einem Empfänger sendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699ce8c7-70bc-4f96-90cb-4acb108b1ed0",
                                                "sense_id": "fb42fcf5-0f6f-39f4-a2c0-49be1c5ef418",
                                                "text": "Ich habe ein Funksignal empfangen, weiß aber nicht, wer der Absender ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afde0563-1b4f-3f07-8a82-67266953d30b",
                                        "entry_id": "6e3ffcc2-6273-3aee-9be7-bf855d3826ec",
                                        "glosses": [
                                            "Name und Anschrift des Versenders einer Sendung"
                                        ],
                                        "tags": [
                                            "Post"
                                        ],
                                        "examples": [
                                            {
