    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6209be0-f90c-3331-96da-ab4387829440",
                    "sense_definition": "Se dit d'une route ou d'un chemin très abîmé, raviné ou plein de trous.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "detruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les violentes pluies, la voiture avançait très lentement sur cette route <w>défoncée</w>."
                        },
                        {
                            "text": "Les cyclistes ont dû faire demi-tour à cause d'un chemin <w>défoncé</w> par les engins."
                        }
                    ],
                    "common_phrases": [
                        "route défoncée",
                        "chemin défoncé"
                    ]
                },
                {
                    "sense_id": "6e7d8700-cc02-3637-bb65-7b660bdb6fc0",
                    "sense_definition": "Sous l'effet puissant et visible de drogues ou d'alcool.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il avait les yeux rouges et semblait complètement <w>défoncé</w> après cette soirée."
                        },
                        {
                            "text": "Elle refusait de monter dans la voiture d'un conducteur manifestement <w>défoncé</w>."
                        }
                    ],
                    "synonyms": [
                        "stone",
                        "foncedé"
                    ],
                    "traits": [
                        {
