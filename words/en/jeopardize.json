                            }
                        },
                        {
                            "text": "After having an affair with a junior, her chances of promotion were seriously <w>jeopardized</w>.",
                            "target_lang_translations": {
                                "tr": "Astlarından biriyle ilişki yaşadıktan sonra terfi şansı ciddi şekilde <w>tehlikeye girdi</w>."
