                            {
                                "example_id": "a6080ec4-ca04-4fb7-911e-2fb9b6c2dc63",
                                "sense_id": "d4dbbf96-6be4-3834-b601-365d1a3a9383",
                                "text": "Onder Catharina's opvolger Paul I kwam Radisjtsjev in 1801 vrij en kreeg hij rechtsherstel."
                            },
                            {
                                "example_id": "f5a9b1b9-7dc9-4a62-a588-1c16fc1488cf",
                                "sense_id": "d4dbbf96-6be4-3834-b601-365d1a3a9383",
                                "text": "Onderzoekers van het NIOD gaan onderzoek doen naar de organisatie en de activiteiten van de VNG in de jaren voorafgaand aan de bezetting, tijdens de bezetting en naar het jaar na de oorlog. Het sluit aan op een onderzoek van de VNG dat is geïnitieerd door de vier grote steden over de rol van het lokale bestuur bij ontrechting, onteigening en rechtsherstel van Joden."
                            }
                        ]
