                "senses": [
                    {
                        "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                        "entry_id": "cf10b2ff-72f7-3f62-936b-127de4e3cae7",
                        "glosses": [
                            "großflächiger Teil eines Kontinents, der wegen seiner Ausmaße eine gewisse Eigenständigkeit besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f25100-2e7e-417a-a8d9-f037abdaef66",
                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                "text": "„Als die Charta der Company 1813 erneuert wurde, erlaubte London auch christlichen Missionaren den Zugang zum Subkontinent.“"
                            },
                            {
                                "example_id": "a7ccbd7b-3b4c-480f-b3df-9004a66e7507",
                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                "text": "„Als Indischer Subkontinent wird die Landmasse südlich des Himalayas bezeichnet, auf der die Staaten Bangladesch, Bhutan, Indien, Nepal, Pakistan und Sri Lanka liegen, die wiederum einen Teil von Südasien bilden.“"
                            },
                            {
                                "example_id": "ccb86a4b-9530-4abf-b13c-8d9cb0460c83",
                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                "text": "„1947 wurde der Subkontinent geteilt, Millionen Muslime flohen nach Pakistan.“"
                            },
                            {
                                "example_id": "ee1601ba-4cce-4657-abbe-6f6d61326f4c",
                                "sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                                "text": "„Ziel der Fächerkooperation war die Vermittlung eines möglichst anschaulichen geschlossenen Mosaikbildes des Subkontinents mit seiner Landschaft, seiner Vegetation, seinen Tieren und Menschen, ihren Lebensbedingungen, Lebensgewohnheiten und geistigen Vorstellungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a79f2b25-d9c8-4a23-8076-f99cfa7e0807",
                        "source_entry_id": "cf10b2ff-72f7-3f62-936b-127de4e3cae7",
                        "source_sense_id": "124da81c-4395-3b6a-aa03-f8047bb8bb8e",
                        "source_sense_description": "großflächiger Teil eines Kontinents, der wegen seiner Ausmaße eine gewisse Eigenständigkeit besitzt",
                        "target_lang_word": "subcontinent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subcontinent",
