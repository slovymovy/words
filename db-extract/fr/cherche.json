                "senses": [
                    {
                        "sense_id": "ee5984a4-0913-382e-b6ff-ece6a4e84875",
                        "entry_id": "74db2ff8-b6df-3196-8e51-6fce0186a1b4",
                        "glosses": [
                            "Première personne du singulier de l’indicatif présent du verbe chercher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "bad6121d-5e3d-4620-b504-8ba7bcc3ca89",
                                "sense_id": "ee5984a4-0913-382e-b6ff-ece6a4e84875",
                                "text": "Je furette dans tous les coins et je trouve ce que je cherche derrière le plumard."
                            }
                        ]
                    },
                    {
                        "sense_id": "f21f6107-5072-34b9-9044-43b5d6e1e5a7",
                        "entry_id": "74db2ff8-b6df-3196-8e51-6fce0186a1b4",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent du verbe chercher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0396a8bc-5b60-423e-ae44-09b66b952183",
                                "sense_id": "f21f6107-5072-34b9-9044-43b5d6e1e5a7",
                                "text": "L’enfant se fait homme ou devient jeune fille, Et cependant que croît sa chair pleine de grâce, Son âme se répand par-delà la famille, Et cherche une âme sœur, une chair qu’il enlace."
                            },
                            {
                                "example_id": "56c4ff70-fc9b-4dfb-b995-757ac2a6e381",
                                "sense_id": "f21f6107-5072-34b9-9044-43b5d6e1e5a7",
                                "text": "Tu chouannes encore, tu cours par les chemins comme une bête enragée qui cherche à mordre."
                            },
                            {
                                "example_id": "0ad2793e-a173-4908-86ab-ba17734f8836",
                                "sense_id": "f21f6107-5072-34b9-9044-43b5d6e1e5a7",
                                "text": "Rosebud se cherche toujours. Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d’un pinardier."
                            }
                        ]
                    },
                    {
                        "sense_id": "d80b71c2-30ab-35d7-9717-a32f82a4a9d0",
                        "entry_id": "74db2ff8-b6df-3196-8e51-6fce0186a1b4",
                        "glosses": [
                            "Première personne du singulier du subjonctif présent du verbe chercher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cb43418b-f2ba-32fd-a39c-305660b0f5dc",
                        "entry_id": "74db2ff8-b6df-3196-8e51-6fce0186a1b4",
                        "glosses": [
                            "Troisième personne du singulier du subjonctif présent du verbe chercher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "19d4cf40-c4f2-3ae9-8a81-263aea8545cb",
                        "entry_id": "74db2ff8-b6df-3196-8e51-6fce0186a1b4",
                        "glosses": [
                            "Deuxième personne du singulier de l’impératif du verbe chercher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4cf0d5df-a396-45a6-a609-25159e05bca3",
                                "sense_id": "19d4cf40-c4f2-3ae9-8a81-263aea8545cb",
                                "text": "Margot tremble quand, en janvier 1944, son numéro six disparaît. « J’ai retourné tous nos lits, visité nos paquets, tout notre fourbi, inutile, il reste introuvable. Serait-ce quelqu’un qui me l’aurait empocheté pour me jouer un tour, je ne peux le croire, et pourtant “cherche-le” » (5 janvier 1944)."
                            }
                        ]
                    }
