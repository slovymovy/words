                                    {
                                        "sense_id": "e1bc4240-eb04-357d-adaf-456829a13510",
                                        "entry_id": "a9ae3a0f-fe63-3cd8-96f9-aa2ff13eaea5",
                                        "glosses": [
                                            "etwas (Bilder, Ornamente, Wörter, Zeichen) in hartes Material oder Stein mit speziellem Werkzeug einschneiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525578df-eade-4348-9d6e-d83cd17fc73e",
                                                "sense_id": "e1bc4240-eb04-357d-adaf-456829a13510",
                                                "text": "Die einheimische Künstlerin graviert mit einem elektrischen Gravierstift und erschafft so lebendige kleine Jagdszenen auf Schnapsgläser."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36348d84-6867-32fb-a049-e480df10ab5d",
                                        "entry_id": "a9ae3a0f-fe63-3cd8-96f9-aa2ff13eaea5",
                                        "glosses": [
                                            "etwas mit eingeschnittenen Verzierungen (Gravierungen) versehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8098c16-1016-4495-8b28-8a88af27d46a",
                                                "sense_id": "36348d84-6867-32fb-a049-e480df10ab5d",
                                                "text": "„Die Bauern sind beinahe alle Analphabeten, das sind aber auch viele der großen Fürsten, die sich metallene Petschaften mit ihrer Unterschrift gravieren lassen, sodass sie Dokumente nicht unterzeichnen müssen, sondern nur zu stempeln brauchen und damit verhehlen könnnen, dass sie unfähig sind, ihren eigenen erlauchten Namen zu schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gravieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11efeff4-00cb-31cc-84a3-bbe8ba07c5b0",
                                        "entry_id": "d9c8416e-291d-349d-b382-ff198df44517",
                                        "glosses": [
                                            "schwer auf jemandem lasten"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d574ca-ca13-45f8-b99c-15beb8aadc7f",
                                                "sense_id": "11efeff4-00cb-31cc-84a3-bbe8ba07c5b0",
                                                "text": "Soviel der Herr nachbar auch reden mag, das graviert mich gar nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
