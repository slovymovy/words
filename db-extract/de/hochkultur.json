                ],
                "senses": [
                    {
                        "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                        "entry_id": "0bba1d6e-5766-3de1-816d-ee2aa7546a2e",
                        "glosses": [
                            "in vielen Gebieten fortschrittliche, hoch entwickelte Kultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e379b14-9ae6-409c-89a1-c627a28ac5c6",
                                "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                                "text": "Als eine der ältesten Hochkulturen gelten die Sumerer in Mesopotamien."
                            },
                            {
                                "example_id": "57393e90-b7d7-4613-b225-3d80eca7ec6e",
                                "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                                "text": "„Die keltische Kultur war die erste Hochkultur in Mitteleuropa, den Kelten verdanken wir die ersten Städte nördlich der Alpen.“"
                            },
                            {
                                "example_id": "d4c4b834-6a48-427b-8a8a-b6752ceca3cd",
                                "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                                "text": "„Auf jeden Fall trafen die Invasoren, die in langen Ruderbooten aus Eiche kamen, auf eine Hochkultur im Niedergang.“"
                            },
                            {
                                "example_id": "c1b4476d-60a9-4a12-9656-069f3587c4af",
                                "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                                "text": "„An den Ufern des Nils entwickelte sich in der Antike eine der ältesten und bedeutendsten Hochkulturen der Erde.“"
                            },
                            {
                                "example_id": "f075f634-b8a9-46c8-ad55-70c39b955ea0",
                                "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                                "text": "„Damals war Griechenland noch eine Hochkultur – auch wenn man sich das heute gar nicht mehr vorstellen kann.“"
                            },
                            {
                                "example_id": "e5921e56-92de-426d-b403-aa3451bd6e7e",
                                "sense_id": "80c1f99a-bf5d-3fcd-a3ea-a8690b9f3910",
                                "text": "„Während die Anfänge eines sesshaften Ackerbauerntums entlang der Täler, die vom ostiranischen Plateau in das Industal abfallen, wohl bereits für die Zeit um 8000 v.Chr. nachgewiesen werden können, entwickelte sich eine erste Hochkultur, die sogenannte Indus- oder Harappa-Kultur, vermutlich zwischen 2800 und 1800 v.Chr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
