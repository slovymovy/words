                            {
                                "example_id": "922d67d1-2024-489d-a5eb-b45d2912dd7a",
                                "sense_id": "fbd99b73-de11-3996-b3e7-0489d5f161d1",
                                "text": "\"Voor Hak zijn die er. Je kan verse groente kopen, diepvriesgroente of conserven van een ander merk\", vervolgt Morren."
                            },
                            {
                                "example_id": "21bab4c6-384a-4c94-a473-44fffd37220e",
                                "sense_id": "fbd99b73-de11-3996-b3e7-0489d5f161d1",
                                "text": "Voordat een besluit over de verlaging van btw op groente en fruit kan worden genomen, moeten die producten eerst worden afgebakend en de staatssecretarissen noemen dat een puzzel. Het onderzoek neemt als uitgangspunt de volksgezondheid. Onbewerkte verse en diepvriesgroente zonder toegevoegd zout of suiker vallen er in elk geval onder, net als onbewerkt fruit, vers en diepvries."
                            }
                        ]
