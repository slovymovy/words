            {
                "entry_id": "f96b9f1f-8812-3aa0-a3c7-7852bbb2da4a",
                "word": "elliptic",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "37341617-13bc-4ad5-9735-d89cb87558f2",
                        "entry_id": "f96b9f1f-8812-3aa0-a3c7-7852bbb2da4a",
                        "tags": [
                            "plural"
                        ],
                        "form": "elliptics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65e876a0-5a87-34da-bc4c-9fbac4c051b2",
                        "entry_id": "f96b9f1f-8812-3aa0-a3c7-7852bbb2da4a",
                        "glosses": [
                            "An elliptical function, equation, path, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83c56ee-a876-4d20-9e70-83c616903a60",
                                "sense_id": "65e876a0-5a87-34da-bc4c-9fbac4c051b2",
                                "text": "The Planetary Paths I trace, / Exploring Realms of boundleſs Space; / Elliptics, Angles, Cubes, and Curves, / In me ſupply the Place of Nerves; […]"
                            },
                            {
                                "example_id": "a2b9c76b-e9ac-4118-9306-07b802fd7468",
                                "sense_id": "65e876a0-5a87-34da-bc4c-9fbac4c051b2",
                                "text": "Two men were smoking over a bottle of wine at one table; they were talking of parabolics and elliptics, and describing diagrams on the table with a wet finger; […]"
                            },
                            {
                                "example_id": "1cacb568-adbd-4cf0-94ed-504aff8983e4",
                                "sense_id": "65e876a0-5a87-34da-bc4c-9fbac4c051b2",
                                "text": "Diagrams geometric, on parchmental scroll; / Circles, ovals, elliptics and such, / He sure figures will tell what is inside the knoll, / And tho far under ground, he’s in touch / With the hidden deposits of mineral ore, / And lost channels ’neath mountains he feels: […]"
                            },
                            {
                                "example_id": "76f42bf3-4af8-4a45-8b58-1cef2b4f90ee",
                                "sense_id": "65e876a0-5a87-34da-bc4c-9fbac4c051b2",
                                "text": "The fix points of hyperbolics and parabolics in F must lie on the fixed circle C, while the fixed points of elliptics in F are inverse with respect to C."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
