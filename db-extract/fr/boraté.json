                        "glosses": [
                            "Combiné avec l'acide borique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d62162-358e-40b2-8cd8-fe008c68b994",
                                "sense_id": "0eacd39b-e333-32c0-839b-536f79a4ea09",
                                "text": "Après un historique succinct de l’origine et du développement de l’índustrie des produits boratés, Mr Francisco del Campo passe en revue les gisements principaux qui fournissent la matière première."
                            },
                            {
                                "example_id": "4d094ba2-bd9a-4fee-8d2c-13f1cdf1f1ac",
                                "sense_id": "0eacd39b-e333-32c0-839b-536f79a4ea09",
                                "text": "Pour étudier l’action de la fumure boratée, nous avons pulvérisé sur les pommiers une solution aqueuse de borate de soude à la concentration de 0,25 p. 100 dès la chute des pétales, puis une seconde fois quinze jours plus tard."
                            }
                        ]
