                "senses": [
                    {
                        "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                        "entry_id": "9bfc77a6-6e7b-36eb-b39b-64e87ef2fdfe",
                        "glosses": [
                            "Action de supputer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b886e87-5ff9-421a-abfe-138b41993556",
                                "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                                "text": "Supputation exacte."
                            },
                            {
                                "example_id": "49e0bfbf-8771-462f-88fc-5cc4f272c3b1",
                                "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                                "text": "La supputation d’une dépense."
                            },
                            {
                                "example_id": "5a428133-0362-4c27-aeb8-9a712bf41e76",
                                "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                                "text": "Il se trompe dans sa supputation."
                            },
                            {
                                "example_id": "8c437410-d367-4e61-93ab-1fc419a2842f",
                                "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                                "text": "Sa supputation est juste."
                            },
                            {
                                "example_id": "0dc051ec-e1b3-48b1-ae15-327b30c01d06",
                                "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                                "text": "Sa supputation est fausse."
                            },
                            {
                                "example_id": "136195fa-c8fc-437b-8348-8767c7ae535f",
                                "sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                                "text": "Toutes ces idées défilèrent dans son esprit en quelques secondes pendant que sa mère déplorait sa mauvaise mine et lançait des supputations négatives sur la régularité de son alimentation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f143bda5-7405-4ef7-a80d-801d93c671fe",
                        "source_entry_id": "9bfc77a6-6e7b-36eb-b39b-64e87ef2fdfe",
                        "source_sense_id": "f2e022a8-f90b-365b-9e72-f5e1e0afffdb",
                        "target_lang_word": "Schätzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schätzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                        "entry_id": "fed284b8-7460-3d27-a746-f8307f2faa21",
                                        "glosses": [
                                            "grobe ungefähre oder vorläufige Einstufung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9a98c3-d8ba-4432-9fa4-ee27fdfcad8c",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "Nach ersten Schätzungen wird das Geld nicht reichen."
                                            },
                                            {
                                                "example_id": "7acd4aa8-76e9-4a41-b1fe-0f93f80ef5b3",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Es handelt sich offenbar um approximative und ungesicherte Schätzungen; aber die Größenordnungen und Gesamtentwicklungen können als tragfähig gelten.“"
                                            },
                                            {
                                                "example_id": "b2130b37-52b0-48e1-b56e-b4461c152dac",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Schätzungen gehen davon aus, dass der Kohlendioxidgehalt der Atmosphäre in der Oberkreide vor knapp 100 Millionen Jahren – bedingt durch die große vulkanische Aktivität auf der Erde – etwa fünf- bis zehnmal so hoch war wie heute.“"
                                            },
                                            {
                                                "example_id": "b214d17e-51ac-4e7a-b7a8-e69598b3c9ba",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Unsere Arbeitsaufteilung war jedenfalls klar: Ich würde mich um die Begutachtung und Schätzung der für uns relevanten Gegenstände kümmern und Amalia sich ums Verhandeln, Vergraulen der Konkurrenz und Knüpfen von Kontakten.“"
                                            },
                                            {
                                                "example_id": "decf02a6-3d70-479d-9be0-830fbd125bd6",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Die Schätzung Prudhommes nahm er für wahr: genau eine Million Opfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e187f799-a190-3ebf-8e49-a4f03b160f61",
                                        "entry_id": "fed284b8-7460-3d27-a746-f8307f2faa21",
                                        "glosses": [
                                            "hohe Wertung einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d14fb1b-e4db-41cc-9b75-69a2d36232e2",
                                                "sense_id": "e187f799-a190-3ebf-8e49-a4f03b160f61",
                                                "text": "Die Schätzung der Dorfältesten war Tradition."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
