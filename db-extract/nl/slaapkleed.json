                        "examples": [
                            {
                                "example_id": "ebdc850a-50fb-4deb-9f8f-15b44bda721f",
                                "sense_id": "c0a05028-2a03-3ec3-8536-36483db1cb17",
                                "text": "De verschillende ontbijteilanden waaieren uit over de adembenemende wintertuin – een voormalige serre van 462m² waarin kosten noch moeite werden gespaard om de croissant stijlvol te presenteren. Zelfs een grootmoeder in haar overjaars slaapkleed zou zich koninklijk voelen bij het afdalen van de treden. Om maar te zeggen: hallo kroket."
                            },
                            {
                                "example_id": "2312fb7a-b8e9-4673-a0de-280c0668613d",
                                "sense_id": "c0a05028-2a03-3ec3-8536-36483db1cb17",
                                "text": "Veel kinderen, zei mijn grootmoeder, kwamen zomaar in de aarde terecht, in hun pyjama of slaapkleed, of in een lijkwade van inderhaast aan elkaar genaaide beddenlakens."
                            }
                        ]
                    }
