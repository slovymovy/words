                        "glosses": [
                            "Niżny Nowogród (nazwa oficjalna w latach 1932-1990)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e56930-7aee-4e13-848b-6cb18b78ce38",
                                "sense_id": "70ad5b39-4d05-3820-84db-80085cc05162",
                                "text": "Wywiad – z małymi skrótami dotyczącymi praw człowieka – wydrukowała wychodząca w Gorkim „Leninskaja smiena”. Był to pierwszy i ostatni dziennikarski popis mojego ojca"
                            },
                            {
                                "example_id": "8e55e852-f0ad-4d6f-ba67-8ca0f1edfe36",
                                "sense_id": "70ad5b39-4d05-3820-84db-80085cc05162",
                                "text": "Inżynier Szarubin z Gorkiego patrzy na Wisłę. Był na Żeraniu, przyjechał tu, by wesprzeć polskich kolegów swymi doświadczeniami w najgorętszym, ostatnim etapie budowy Fabryki Samochodów Osobowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
