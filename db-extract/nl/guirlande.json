                ],
                "senses": [
                    {
                        "sense_id": "c8f58d90-6f67-3b7d-9d92-d6b7c6544889",
                        "entry_id": "97f937b2-a701-3414-b672-6b44204c614b",
                        "glosses": [
                            "slinger"
                        ],
                        "tags": [
                            "bloemen"
                        ],
                        "examples": [
                            {
                                "example_id": "59029884-76fa-4e9e-a1b7-729cd8113360",
                                "sense_id": "c8f58d90-6f67-3b7d-9d92-d6b7c6544889",
                                "text": "Clara Bossers van het groenbedrijf Fleurs d'Amies zet de cursisten flink aan het werk, want er worden op één dag drie groendecoraties gemaakt. Een guirlande met lichtjes, een staande decoratie voor bijvoorbeeld een hal en een kerststuk voor de buitendeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "3634722d-941e-3b99-a894-b4ccc207a97d",
                        "entry_id": "97f937b2-a701-3414-b672-6b44204c614b",
                        "glosses": [
                            "ornament in de vorm van een bloemenslinger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24296071-ca29-471e-bea4-32918223b5d6",
                                "sense_id": "3634722d-941e-3b99-a894-b4ccc207a97d",
                                "text": "Ze pakte haar spullen in en keek nog eens naar de cello. Nu ze klaar was, leek het een dood lichaam: een holle, houten buik met een lang, dun nekje. Ze duwde de doeken iets naar beneden en zag nu pas hoe verfijnd hij was ingelegd. Langs de zijkanten slingerden sierlijke guirlandes. Ze staken zwart af tegen de roestbruine kleur van het gelakte hout. Daarboven spreidden aan beide zijden ivoren griffioenen hun lichte vleugels tussen donkere kransen."
                            }
                        ]
                    }
