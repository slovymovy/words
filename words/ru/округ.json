{
    "word_family": [
        "окружной"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f54e78f1-6842-3e95-80ef-0757ff296cc1",
                    "sense_definition": "Административно-территориальная единица, часть территории государства или города, имеющая собственное управление.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "territorial_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В состав России входят края, области и автономные <w>округа</w>.",
                            "target_lang_translations": {
                                "en": "Russia includes territories, regions, and autonomous <w>districts</w>.",
                                "pl": "W skład Rosji wchodzą kraje, obwody i autonomiczne <w>okręgi</w>."
                            }
                        },
                        {
                            "text": "Наш городской <w>округ</w> активно развивается, и здесь строят новые школы.",
                            "target_lang_translations": {
                                "en": "Our urban <w>district</w> is developing actively, and new schools are being built here.",
                                "pl": "Nasz <w>okręg</w> miejski prężnie się rozwija i budowane są tu nowe szkoły."
                            }
                        }
                    ],
                    "synonyms": [
                        "район"
                    ],
                    "common_phrases": [
                        "автономный округ",
                        "федеральный округ",
                        "городской округ",
                        "административный округ"
                    ],
                    "target_lang_definitions": {
                        "en": "An administrative-territorial unit, a part of a state or city territory having its own administration.",
                        "pl": "Jednostka podziału administracyjno-terytorialnego państwa lub miasta, posiadająca własną administrację."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "district",
                                "target_lang_sense_clarification": "administrative division"
                            },
                            {
                                "target_lang_word": "region",
                                "target_lang_sense_clarification": "broad administrative area"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "okręg",
                                "target_lang_sense_clarification": "jednostka administracyjna"
                            },
                            {
                                "target_lang_word": "dystrykt",
                                "target_lang_sense_clarification": "podział terytorialny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27fa2820-0802-3484-9e19-b0e4ad4936a2",
                    "sense_definition": "Территория, специально выделенная для проведения выборов (избирательный округ).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "territorial_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Депутат объехал весь свой избирательный <w>округ</w> перед выборами.",
                            "target_lang_translations": {
                                "en": "The deputy toured his entire electoral <w>district</w> before the elections.",
                                "pl": "Poseł przed wyborami objachał cały swój <w>okręg</w> wyborczy."
                            }
                        },
                        {
                            "text": "Голосование в одномандатных <w>округах</w> прошло без серьёзных нарушений.",
                            "target_lang_translations": {
                                "en": "Voting in single-mandate <w>districts</w> proceeded without serious violations.",
                                "pl": "Głosowanie w <w>okręgach</w> jednomandatowych przebiegło bez poważnych naruszeń."
                            }
                        }
                    ],
                    "common_phrases": [
                        "избирательный округ",
                        "одномандатный округ"
                    ],
                    "target_lang_definitions": {
                        "en": "A territory specifically designated for holding elections (electoral district).",
                        "pl": "Terytorium wyznaczone specjalnie do przeprowadzania wyborów."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constituency",
                                "target_lang_sense_clarification": "electoral area"
                            },
                            {
                                "target_lang_word": "electoral district",
                                "target_lang_sense_clarification": "voting area"
                            },
                            {
                                "target_lang_word": "district",
                                "target_lang_sense_clarification": "political division"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "okręg wyborczy",
                                "target_lang_sense_clarification": "miejsce głosowania"
                            },
                            {
                                "target_lang_word": "okręg",
                                "target_lang_sense_clarification": "w kontekście wyborów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a370b10-01da-3ead-8b3e-9d4bbca73830",
                    "sense_definition": "Военно-административное подразделение территории государства.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "territorial_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Командующий посетил Южный военный <w>округ</w> с внезапной проверкой.",
                            "target_lang_translations": {
                                "en": "The commander visited the Southern Military <w>District</w> with a surprise inspection.",
                                "pl": "Dowódca odwiedził Południowy <w>Okręg</w> Wojskowy z nagłą inspekcją."
                            }
                        },
                        {
                            "text": "Штаб военного <w>округа</w> находится в историческом центре города.",
                            "target_lang_translations": {
                                "en": "The headquarters of the military <w>district</w> is located in the historic city center.",
                                "pl": "Sztab <w>okręgu</w> wojskowego znajduje się w historycznym centrum miasta."
                            }
                        }
                    ],
                    "common_phrases": [
                        "военный округ"
                    ],
                    "target_lang_definitions": {
                        "en": "A military-administrative subdivision of a state's territory.",
                        "pl": "Wojskowo-administracyjna jednostka podziału terytorium państwa."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "military district",
                                "target_lang_sense_clarification": "military administration"
                            },
                            {
                                "target_lang_word": "district",
                                "target_lang_sense_clarification": "military subdivision"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "okręg wojskowy",
                                "target_lang_sense_clarification": "jednostka armii"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb7a3228-ded9-38f8-9e8a-bc6ba5602748",
                    "sense_definition": "Форма родительного падежа множественного числа существительного <w>округа</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Жители соседних <w>округ</w> часто приезжали к нам на праздничную ярмарку.",
                            "target_lang_translations": {
                                "en": "Residents of the neighboring <w>surroundings</w> often came to our holiday fair.",
                                "pl": "Mieszkańcy sąsiednich <w>okolic</w> często przyjeżdżali do nas na świąteczny jarmark."
                            }
                        },
                        {
                            "text": "Из всех близлежащих <w>округ</w> доносился звон церковных колоколов.",
                            "target_lang_translations": {
                                "en": "From all the nearby <w>surroundings</w> came the ringing of church bells.",
                                "pl": "Ze wszystkich pobliskich <w>okolic</w> dobiegało bicie dzwonów kościelnych."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Genitive plural form of the noun 'округа' (surroundings).",
                        "pl": "Forma dopełniacza liczby mnogiej rzeczownika 'округа' (okolica, sąsiedztwo)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surroundings",
                                "target_lang_sense_clarification": "area around a place"
                            },
                            {
                                "target_lang_word": "environs",
                                "target_lang_sense_clarification": "surrounding area"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "okolic",
                                "target_lang_sense_clarification": "obszar wokół"
                            },
                            {
                                "target_lang_word": "sąsiedztw",
                                "target_lang_sense_clarification": "pobliskie tereny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d8f41c0c-d03b-3231-ab77-f80e762c9207",
                    "sense_definition": "Вокруг, кругом, около.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Округ</w> него собралась большая толпа любопытных людей.",
                            "target_lang_translations": {
                                "en": "<w>Around</w> him gathered a large crowd of curious people.",
                                "pl": "<w>Wokół</w> niego zebrał się spory tłum ciekawskich ludzi."
                            }
                        },
                        {
                            "text": "Всё <w>округ</w> было покрыто густым белым туманом.",
                            "target_lang_translations": {
                                "en": "Everything <w>around</w> was covered in a thick white fog.",
                                "pl": "Wszystko <w>wokoło</w> było spowite gęstą białą mgłą."
                            }
                        }
                    ],
