                "senses": [
                    {
                        "sense_id": "0d787eca-b2ec-3645-bff1-c36bb6e6ba7d",
                        "entry_id": "ee987fd9-a258-3b49-b623-50682a75fe4f",
                        "glosses": [
                            "strategie om gewenste doelen op het gebied van taalgebruik en taalonderwijs te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f1e0b9c-cf8f-4c88-90f2-10cdec3f2541",
                                "sense_id": "0d787eca-b2ec-3645-bff1-c36bb6e6ba7d",
                                "text": "De minderheidstalen hebben na de grondwetswijziging van 2008 een plek gekregen. Alleen is er nog geen enkel signaal dat het Baskisch als officiële minderheidstaal ook dezelfde rechten krijgt als het Frans. Een decentralisatie van bevoegdheden naar regionale overheden zou helpen. Maar meer middelen betekent niet dat er ook een andere taalpolitiek gevoerd kan worden. De Basken willen eigen instituten die het taalbeleid kunnen vormgeven."
                            },
                            {
                                "example_id": "61e62aa8-887d-4295-a20b-16bdcee4b386",
                                "sense_id": "0d787eca-b2ec-3645-bff1-c36bb6e6ba7d",
                                "text": "Een adviseur is ingeschakeld om taalbeleid te ontwikkelen, waardoor het niveau van de leerlingen op een hoger plan moet komen."
                            },
                            {
                                "example_id": "f9708125-5091-4437-9258-d06366f43390",
                                "sense_id": "0d787eca-b2ec-3645-bff1-c36bb6e6ba7d",
                                "text": "Er komt een centraal meldpunt Fries bij de provincie voor klachten over taalbeleid (bij de rechtspraak en de zorg bijvoorbeeld) en taaldiscriminatie."
                            }
                        ]
                    }
