{
    "word_family": [
        "zaaien",
        "inzaaien",
        "zaad"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19e9a4d3-730e-3de3-9a43-0bb9572d5982",
                    "sense_definition": "Een akker of stuk grond met zaad bestrooien om gewassen te verbouwen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer besloot dit jaar zijn hele akker met tarwe te <w>bezaaien</w>.",
                            "target_lang_translations": {
                                "en": "The farmer decided to <w>sow</w> his entire field with wheat this year."
                            }
                        },
                        {
                            "text": "Het is belangrijk om de grond gelijkmatig te <w>bezaaien</w> voor een goede oogst.",
                            "target_lang_translations": {
                                "en": "It is important to <w>seed</w> the soil evenly for a good harvest."
                            }
                        }
                    ],
                    "synonyms": [
                        "inzaaien",
                        "zaaien"
                    ],
                    "common_phrases": [
                        "een akker bezaaien",
                        "met graszaad bezaaien"
                    ],
                    "target_lang_definitions": {
                        "en": "To scatter seed over a field or piece of land in order to grow crops."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sow",
                                "target_lang_sense_clarification": "to plant seeds in the ground"
                            },
                            {
                                "target_lang_word": "seed",
                                "target_lang_sense_clarification": "to sow with seed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce9f75bd-173e-3d31-9c2b-6e31aa82c08f",
                    "sense_definition": "Een oppervlakte dicht bedekken of overstrooien met een groot aantal objecten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bedekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de storm was de hele tuin <w>bezaaid</w> met takken en bladeren.",
                            "target_lang_translations": {
                                "en": "After the storm, the entire garden was <w>strewn</w> with branches and leaves."
                            }
                        },
                        {
                            "text": "Zijn toespraak was <w>bezaaid</w> met moeilijke woorden en vaktermen.",
                            "target_lang_translations": {
                                "en": "His speech was <w>littered</w> with difficult words and jargon."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedekken",
                        "bestrooien"
                    ],
                    "common_phrases": [
                        "bezaaid met hindernissen",
                        "bezaaid met sterren"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover or scatter a surface densely with a large number of objects."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strew",
                                "target_lang_sense_clarification": "to scatter untidily over a surface"
                            },
                            {
                                "target_lang_word": "litter",
                                "target_lang_sense_clarification": "to leave things scattered about"
                            },
                            {
                                "target_lang_word": "cover with",
                                "target_lang_sense_clarification": "to spread over the surface of"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}