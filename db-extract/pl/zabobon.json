                                    },
                                    {
                                        "sense_id": "4b8efcfb-d346-3eed-b6fe-d9e563517432",
                                        "entry_id": "68dfb139-46d1-3026-8f13-6f7a2c92ad25",
                                        "glosses": [
                                            "Aprecio o miedo excesivos a las cosas ocultas y misteriosas."
                                        ],
                                        "tags": [],
