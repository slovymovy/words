                                    {
                                        "sense_id": "d62a4496-fb35-35ab-9732-64e98ccdeb53",
                                        "entry_id": "b36241f6-1923-3394-9cac-71ab33ac74e5",
                                        "glosses": [
                                            "Supplied with what one needs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff66069a-f1e5-4632-ac75-cde1a426bbec",
                                                "sense_id": "d62a4496-fb35-35ab-9732-64e98ccdeb53",
                                                "text": "She's nicely fixed after two divorce settlements."
                                            },
                                            {
                                                "example_id": "543adc2c-e0cc-4af3-aa14-7b6159e96e6d",
                                                "sense_id": "d62a4496-fb35-35ab-9732-64e98ccdeb53",
                                                "text": "How are you fixed for money?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67de5629-bbbb-3581-ae12-1f524476eca0",
                                        "entry_id": "b36241f6-1923-3394-9cac-71ab33ac74e5",
                                        "glosses": [
                                            "Recorded on a permanent medium."
                                        ],
                                        "tags": [
                                            "of sound"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc530d0-5fea-4dcc-b5b0-4ff2dc6fb775",
                                                "sense_id": "67de5629-bbbb-3581-ae12-1f524476eca0",
                                                "text": "In the United States, recordings are only granted copyright protection when the sounds in the recording were fixed and first published on or after February 15, 1972."
                                            }
                                        ]
