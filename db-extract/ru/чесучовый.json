                        ],
                        "form": "чесучо́вой"
                    },
                    {
                        "form_id": "cf81c8e9-0fc2-498c-bdc8-be9a1dc213aa",
                        "entry_id": "66a01c5b-08a0-3efd-b396-e1da2d7a01ce",
                        "tags": [
                            "plural",
