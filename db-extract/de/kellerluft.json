                "senses": [
                    {
                        "sense_id": "865a03e7-d07c-3c8d-8996-987549cba7fe",
                        "entry_id": "3ad5c488-52f9-3989-9e8c-17bf68ca1d1a",
                        "glosses": [
                            "Luft in Kellerräumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5194c038-d7aa-43a2-8d40-fdf51beed54d",
                                "sense_id": "865a03e7-d07c-3c8d-8996-987549cba7fe",
                                "text": "„Die Mauern waren leicht gebaut und erst kürzlich mit einem groben Mörtel beworfen worden, der infolge der Feuchtigkeit der Kellerluft noch nicht hart geworden war.“"
                            },
                            {
                                "example_id": "0691397d-acc3-4170-8a98-9ac2c7a88e69",
                                "sense_id": "865a03e7-d07c-3c8d-8996-987549cba7fe",
                                "text": "„Die Luft war eine dumpfe Kellerluft, nicht gerade mit Moderdüften geschwängert, der Proceß der Verwesung war, da er über zwei Jahrhunderte lang Zeit gehabt sich zu entwickeln, vollkommen geendet und die animalischen Stoffe hatten sich verflüchtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
