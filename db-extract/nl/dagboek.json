                        ],
                        "form": "dagboekjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3390e9b8-a9c1-3447-8bcd-3edfd551f7d0",
                        "entry_id": "2f370f49-60d1-308a-a764-be2daecedb01",
                        "glosses": [
                            "een boek waarin men dagelijks zijn wederwaardigheden neerschrijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f3de517-0b3e-40ff-8310-1eb4c79a1834",
                                "sense_id": "3390e9b8-a9c1-3447-8bcd-3edfd551f7d0",
                                "text": "Het dagboek van Anne Frank is wereldberoemd geworden."
                            },
                            {
                                "example_id": "4104896c-981b-4f0f-a9a5-f9c6ce8d8673",
                                "sense_id": "3390e9b8-a9c1-3447-8bcd-3edfd551f7d0",
                                "text": "Owen is dood, ik heb alleen zijn papieren nog, een soort aan niemand gericht dagboek."
                            },
                            {
                                "example_id": "8ae76643-742b-442f-a019-da0954d67345",
                                "sense_id": "3390e9b8-a9c1-3447-8bcd-3edfd551f7d0",
                                "text": "Terlouw besloot niet terug te keren in de Kamer en haalde zijn gram met de publicatie van een bitter dagboek. Na een periode in het buitenland werd hij tussen 1991 en 1996 commissaris van de Koningin in Gelderland. Het einde van zijn loopbaan stond, net als aan het begin, in het teken van het water: in 1995 liet hij wegens dreigende overstromingen het rivierengebied evacueren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9f39d98-67d0-4848-8a8a-aa379aca9058",
                        "source_entry_id": "2f370f49-60d1-308a-a764-be2daecedb01",
                        "source_sense_id": "3390e9b8-a9c1-3447-8bcd-3edfd551f7d0",
                        "target_lang_word": "Tagebuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tagebuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a705f890-dcd4-3ae9-822a-a0bdf5fbfdc0",
                                        "entry_id": "87167a9a-daef-35e0-bca2-b2297d6b2ff4",
                                        "glosses": [
                                            "persönliches Notizbuch, in dem Tagesereignisse festgehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd7e03f5-5b05-42d6-b032-ed9953b2b3b2",
                                                "sense_id": "a705f890-dcd4-3ae9-822a-a0bdf5fbfdc0",
                                                "text": "Seit Klaus sie verlassen hatte, schrieb Susanne jeden Abend etwas in ihr Tagebuch."
                                            },
                                            {
                                                "example_id": "ed4542eb-c494-473b-9973-0e372a55b6b0",
                                                "sense_id": "a705f890-dcd4-3ae9-822a-a0bdf5fbfdc0",
                                                "text": "„Nun weiß ich nicht recht, wie und warum ich ein Vorwort zu meinem Tagebuch schreiben sollte.“"
                                            },
                                            {
                                                "example_id": "bd66dc22-9e34-48a0-80fb-60bd2c380543",
                                                "sense_id": "a705f890-dcd4-3ae9-822a-a0bdf5fbfdc0",
                                                "text": "„Es war das Tagebuch meiner ersten sechsundsechzig Tage in Spanien.“"
                                            },
                                            {
                                                "example_id": "db65b0cb-848c-4f2a-abf1-510a40dea1a7",
                                                "sense_id": "a705f890-dcd4-3ae9-822a-a0bdf5fbfdc0",
                                                "text": "„Als zehnjähriger Junge habe ich ein Tagebuch zu führen begonnen.“"
                                            },
                                            {
                                                "example_id": "ca635ac1-c9b0-42d2-87df-dfc3bf887b5c",
                                                "sense_id": "a705f890-dcd4-3ae9-822a-a0bdf5fbfdc0",
                                                "text": "„Ihr Tagebuch enthält auch viele für die politische und ökonomische Situation aussagekräftige Eintragungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb5c6915-7349-4c42-82c1-e638636a844c",
                        "source_entry_id": "2f370f49-60d1-308a-a764-be2daecedb01",
                        "source_sense_id": "3390e9b8-a9c1-3447-8bcd-3edfd551f7d0",
                        "target_lang_word": "diary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                        "entry_id": "21338898-4887-3bf7-a01d-5c8b8ba8532e",
                                        "glosses": [
                                            "A daily log of experiences, especially those of the writer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdafcd69-c59b-4ce2-b509-12f68e141ccf",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "They kept separate diaries. His was on paper and her diary was on her computer's hard drive."
                                            },
                                            {
                                                "example_id": "78d721b7-3796-4a92-babd-b92c0b0b2cc8",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "No, I’m just going over the stuff Tara wrote in my diary.\nShe’s writing your diary? Could you be any lazier?"
                                            },
                                            {
                                                "example_id": "c8ca5c6f-3cdc-44e4-b934-df73ad1829b7",
                                                "sense_id": "a96b3b75-9e2c-3ace-83d2-61b70a6ff44b",
                                                "text": "Both halves feature lyrics that are so teen-girly they sound like they were written in pink ink in a padlocked diary with hearts and frowny faces for punctuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b7fae01-51af-3be7-bf84-5b6f51e08c4a",
                                        "entry_id": "21338898-4887-3bf7-a01d-5c8b8ba8532e",
                                        "glosses": [
                                            "A personal organizer or appointment diary."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de45354-527f-4e2b-aa84-3015fc48890f",
                                                "sense_id": "8b7fae01-51af-3be7-bf84-5b6f51e08c4a",
                                                "text": "It is recommended that teachers and pupils are issued with homework diaries to help implement and monitor the homework timetable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cad41b2-0a3a-39da-a4cb-955b60642dcf",
                                        "entry_id": "49caeb2e-8210-3729-b325-596fb918466f",
                                        "glosses": [
                                            "To keep a diary or journal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca82135-ff7c-4342-8407-82e1cc922966",
                                                "sense_id": "6cad41b2-0a3a-39da-a4cb-955b60642dcf",
                                                "text": "As part of her mindful movement practise, diarying is important to Sarah. \"It gives me a chance to see what is going on, to reflect on my experience.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "758e5cc5-5fda-32ba-8299-9739e12f444d",
                                        "entry_id": "e229f690-04d8-3aaa-9659-e61a6730aa7d",
                                        "glosses": [
                                            "Lasting for one day."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5332aa-42e0-4334-b527-7e4ed51bc815",
                                                "sense_id": "758e5cc5-5fda-32ba-8299-9739e12f444d",
                                                "text": "the offer of a usurpation, though it were but as a diary ague"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
