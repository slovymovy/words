                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weather",
                                "target_lang_sense_clarification": "atmospheric conditions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "099d25bb-87ef-346c-b6fa-50966a5270fc",
                    "sense_definition": "Verouderde aanduiding voor een gecastreerde ram of geitenbok; synoniem van <w>weer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herder leidde de oude <w>weder</w> naar de weide.",
                            "target_lang_translations": {
                                "en": "The shepherd led the old <w>wether</w> to the meadow."
                            }
                        },
                        {
                            "text": "In de stal stond een gesneden <w>weder</w> tussen de schapen.",
                            "target_lang_translations": {
