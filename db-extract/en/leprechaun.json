                    {
                        "sense_id": "54ecc191-d0a2-378a-987a-55fa8adabc48",
                        "entry_id": "663ae70f-dd8f-37ed-b661-458fff8aa169",
                        "glosses": [
                            "One of a race of elves that can reveal hidden treasure to those who catch them."
                        ],
                        "tags": [
                            "Irish"
                        ],
                        "examples": [
                            {
                                "example_id": "86c64490-07c7-4c68-b539-cda5f584ad30",
                                "sense_id": "54ecc191-d0a2-378a-987a-55fa8adabc48",
                                "text": "Do you not catch the tiny clamour, / Busy click of an elfin hammer, / Voice of the leprechaun singing shrill, / As he merrily plies his trade?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69cc15aa-3fcc-4089-9686-5edfc2c6eeb9",
