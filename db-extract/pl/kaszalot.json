                                "sense_id": "3689d0cd-ac38-3a35-b100-58aaa4e730ee",
                                "text": "Syrena delikatnie wyciągnęła z płetwy kaszalota złamany harpun."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f5852326-ae3e-3605-b30f-9c601344817f",
