                                    {
                                        "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                                        "entry_id": "d790b3ba-e4e8-36f3-80f4-d80c6c9db615",
                                        "glosses": [
                                            "Gerät zum Klingeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3275f0-9832-4b64-bd52-da9e231fa32a",
                                                "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                                                "text": "Die Klingel des Hauses ist defekt."
                                            },
                                            {
                                                "example_id": "0927e852-7d65-4183-bd69-297cb1574106",
                                                "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                                                "text": "„Jugendliche, gefolgt von einem Schwarm kleiner Jungen, vertrieben sich die Zeit, indem sie auf uralten Rädern im Zick-Zack durch die Straßen pendelten und dabei weniger die Pedale als die Klingel benutzten.“"
                                            },
                                            {
                                                "example_id": "47e0a2d0-e585-4078-9a5f-a2e4b9910f1e",
                                                "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                                                "text": "„Ich drückte auf die Klingel neben dem Namen Deja Fountain.“"
                                            },
                                            {
                                                "example_id": "469df4fa-6a3f-49e3-896b-b9cfde81b049",
                                                "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                                                "text": "„Er zog die Klingel, gab seine Ordres und tat einige Fragen an den Kellner.“"
                                            },
                                            {
                                                "example_id": "39a57ca9-fb05-486f-b3b9-cf4c23608e27",
                                                "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                                                "text": "„Die dünne Klingel schrillte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f69e9574-9ccc-3316-83c9-75e279812b4d",
                                        "entry_id": "d790b3ba-e4e8-36f3-80f4-d80c6c9db615",
                                        "glosses": [
                                            "kleiner Metallkelch mit einem Klöppel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e3fbe6-3dd1-4856-b062-d790a692cd04",
                                                "sense_id": "f69e9574-9ccc-3316-83c9-75e279812b4d",
                                                "text": "Paul hat als Messdiener immer die Klingel bedient."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
