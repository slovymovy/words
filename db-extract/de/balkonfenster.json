                ],
                "senses": [
                    {
                        "sense_id": "162c2a6c-f920-3ffb-8bd5-4333de1c0885",
                        "entry_id": "bca68d4c-16ea-39a6-b9ba-96ccf7da0075",
                        "glosses": [
                            "Fenster, das zum Balkon hin gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa7d790e-bfc8-4c19-a561-f2a26c2bfdb6",
                                "sense_id": "162c2a6c-f920-3ffb-8bd5-4333de1c0885",
                                "text": "„Nun weiß sie, daß er sich auf das Sofa an der Wand gegenüber dem großen Balkonfenster setzen soll, während sie selbst mit ihrem Zeichenblock auf einem Schemel neben der Balkontür sitzen wird, das Tageslicht im Rücken.“"
                            },
                            {
                                "example_id": "c0bb90e4-ac7d-48ef-98b8-ab9b1bee83ec",
                                "sense_id": "162c2a6c-f920-3ffb-8bd5-4333de1c0885",
                                "text": "„Man sah den einen oder andern Althingsmann durch das Balkonfenster hinausschielen; ihr Lächeln sollte unbekümmert wirken, war aber eine Grimasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
