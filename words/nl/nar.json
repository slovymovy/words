    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecf43e7c-857d-34d6-9af5-eaa898dbac1c",
                    "sense_definition": "iemand die anderen vermaakt door zich in opvallende kleding dwaas te gedragen, vaak aan een vorstelijk hof",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vermaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>nar</w> maakte grappige opmerkingen om de koning en zijn gasten aan het lachen te krijgen.",
                            "target_lang_translations": {
                                "pl": "<w>Błazen</w> rzucał żartobliwymi uwagami, aby rozbawić króla i jego gości."
                            }
                        },
                        {
                            "text": "Tijdens het middeleeuwse feest liep een vrolijke <w>nar</w> rond in een kleurrijk kostuum met belletjes.",
                            "target_lang_translations": {
                                "pl": "Podczas średniowiecznego festynu przechadzał się wesoły <w>błazen</w> w kolorowym stroju z dzwoneczkami."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwaas",
                        "zot"
                    ],
                    "target_lang_definitions": {
                        "pl": "osoba zabawiająca innych głupawym zachowaniem i charakterystycznym strojem, zwłaszcza na dworze królewskim"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "błazen",
                                "target_lang_sense_clarification": "dworski"
                            },
                            {
                                "target_lang_word": "trefniś",
                                "target_lang_sense_clarification": "dawne określenie błazna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7b6a313-7a73-31ea-9ac6-6ade4a076bc7",
                    "sense_definition": "iemand die zich dwaas, onverstandig of belachelijk gedraagt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dwaas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gedroeg zich als een <w>nar</w> en niemand nam zijn serieuze plannen meer serieus.",
                            "target_lang_translations": {
                                "pl": "Zachowywał się jak <w>błazen</w> i nikt już nie traktował poważnie jego ambitnych planów."
                            }
                        },
                        {
                            "text": "Laat je niet voor de <w>nar</w> houden door zijn mooie verhalen.",
                            "target_lang_translations": {
                                "pl": "Nie daj zrobić z siebie <w>błazna</w> przez jego piękne opowieści."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwaas",
                        "zot"
                    ],
                    "common_phrases": [
                        "voor de nar houden"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in de betekenis van dwaas persoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "człowiek zachowujący się głupio, nierozsądnie lub niedorzecznie"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "błazen",
                                "target_lang_sense_clarification": "człowiek zachowujący się głupio"
                            },
                            {
                                "target_lang_word": "głupiec",
                                "target_lang_sense_clarification": "osoba nierozsądna"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "069e9211-adb1-3c1e-90ef-68a6a3d27617",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>narren</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_narren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>nar</w> mijn kleine broertje soms voor de grap, maar hij kan er gelukkig om lachen.",
                            "target_lang_translations": {
                                "pl": "Czasami <w>droczę się z</w> moim młodszym bratem dla żartu, ale na szczęście potrafi się z tego śmiać."
                            }
                        },
                        {
                            "text": "Als ik hem te veel <w>nar</w>, loopt hij boos naar zijn kamer toe.",
                            "target_lang_translations": {
                                "pl": "Kiedy za bardzo go <w>drażnię</w>, idzie ze złością do swojego pokoju."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "pierwsza osoba liczby pojedynczej czasu teraźniejszego od czasownika „narren” (drażnić, dokuczać, kpić)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drażnię",
                                "target_lang_sense_clarification": "1. os. lp czasu teraźniejszego"
                            },
                            {
                                "target_lang_word": "denerwuję",
                                "target_lang_sense_clarification": "1. os. lp czasu teraźniejszego"
                            },
                            {
                                "target_lang_word": "droczę się",
                                "target_lang_sense_clarification": "1. os. lp czasu teraźniejszego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f5692fc-d056-34ff-ba49-0a94a9c2d68b",
                    "sense_definition": "gebiedende wijs van <w>narren</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_narren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nar</w> die arme hond niet zo terwijl hij rustig probeert te slapen.",
                            "target_lang_translations": {
                                "pl": "Nie <w>drażnij</w> tak tego biednego psa, kiedy próbuje spokojnie spać."
                            }
                        },
                        {
                            "text": "<w>Nar</w> me toch niet steeds met die flauwe opmerkingen over mijn nieuwe jas.",
                            "target_lang_translations": {
                                "pl": "Nie <w>dokuczaj</w> mi ciągle tymi kiepskimi uwagami na temat mojego nowego płaszcza."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "tryb rozkazujący czasownika „narren” (nie drażnij, nie dokuczaj)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drażnij",
                                "target_lang_sense_clarification": "tryb rozkazujący"
                            },
                            {
                                "target_lang_word": "dokuczaj",
                                "target_lang_sense_clarification": "tryb rozkazujący"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee9786d-a759-3f7b-8d2c-d05912746059",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>narren</w> bij inversie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_narren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nar</w> je me nu serieus, of meen je die vreemde bewering echt?",
                            "target_lang_translations": {
                                "pl": "Czy ty sobie teraz ze mnie <w>żartujesz</w>, czy naprawdę wierzysz w to dziwne twierdzenie?"
                            }
                        },
                        {
                            "text": "Waarom <w>nar</w> je altijd je zusje als zij rustig haar huiswerk probeert te maken?",
                            "target_lang_translations": {
                                "pl": "Dlaczego zawsze <w>drażnisz</w> siostrę, gdy ta próbuje w spokoju odrabiać lekcje?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "druga osoba liczby pojedynczej czasu teraźniejszego od czasownika „narren” w szyku przestawnym"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drażnisz",
                                "target_lang_sense_clarification": "2. os. lp czasu teraźniejszego"
                            },
                            {
                                "target_lang_word": "robisz sobie żarty",
                                "target_lang_sense_clarification": "2. os. lp czasu teraźniejszego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}