                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b78d3eb-a505-49f8-a8c8-2fdb8fa8aa07",
                        "source_entry_id": "19f855a1-1f6f-3dda-a379-dc7832b14ee6",
                        "source_sense_id": "42fd1f02-8605-3b46-a776-57f4a3c5d0bd",
                        "target_lang_word": "dépensier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépensier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                        "entry_id": "462ee128-34b6-3609-adcc-7e079a7a01f7",
                                        "glosses": [
                                            "Qui dépense excessivement, qui aime à dépenser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca01d2b-b314-4279-b23d-b351a0dd8cd8",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Je connais Victor : sa gaieté est une gaieté sans esprit, une gaieté de caserne, il est sans talent et dépensier."
                                            },
                                            {
                                                "example_id": "b5346a86-2123-4002-9d50-ed58f6989f4f",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Le duc d’Orléans était leur garant, leur pavillon, leur espoir. Ils le savaient futile, versatile, influençable, […], aussi dépourvu de sens critique que de sens pratique, joueur, débauché, dépensier."
                                            },
                                            {
                                                "example_id": "672c4ed3-3fa2-4068-aeac-388af75c1690",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Les conservateurs ne manquèrent cependant de me reprocher à l'époque ma prétendue faiblesse vis-à-vis des services dépensiers."
                                            },
                                            {
                                                "example_id": "7bae40b9-85c3-482c-9e2e-37b6fef588dd",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Gaspilleur, qui verse sans compter."
                                            },
                                            {
                                                "example_id": "2ff7d419-c35b-4888-9e29-3f82be20546a",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Les hommes, qui sont si follement dépensiers de leur sang…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dépensier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f27685-0b55-3357-82f4-c9e93d9bc6ee",
                                        "entry_id": "5a39f2c0-ec52-37e4-a06d-9b53e18d506a",
                                        "glosses": [
                                            "Économe en charge de la dépense dans une communauté religieuse, un internat scolaire, ou autre organisation semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcd76a5-6378-4103-9916-6b373290573a",
                                                "sense_id": "f1f27685-0b55-3357-82f4-c9e93d9bc6ee",
                                                "text": "La dépensière du couvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0930fd66-8aba-3723-a41c-441110b989a7",
                                        "entry_id": "5a39f2c0-ec52-37e4-a06d-9b53e18d506a",
                                        "glosses": [
                                            "Trésorier au sein d'une association, d'un groupe."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e8bd92-8798-4bea-9828-09801dd002cf",
                                                "sense_id": "0930fd66-8aba-3723-a41c-441110b989a7",
                                                "text": "Une fille très jolie, accorte et fine, Line, dirigeait admirablement ce relais galant et tenait lieu de dépensière, d’économe, de caviste et de cuisinière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                        "entry_id": "5a39f2c0-ec52-37e4-a06d-9b53e18d506a",
                                        "glosses": [
                                            "Personne qui dépense sans compter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d70c2d-351a-4de6-b308-0717f56708ea",
                                                "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                                "text": "Le grand dépensier Napoléon III fait repriser ses chaussettes à raison de 24 centimes le reprisage."
                                            },
                                            {
                                                "example_id": "a18df333-bfbb-4069-971f-6edfcb9efc40",
                                                "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                                "text": "Lantier est un ambitieux, un dépensier, un homme qui ne songe qu'à son amusement."
                                            },
                                            {
                                                "example_id": "345aa23c-a5dc-4cf1-8e8f-d357b1e41df1",
                                                "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                                "text": "C’est une grande dépensière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f763979-f3c3-49fe-b409-ff9b5d30f5f4",
                        "source_entry_id": "19f855a1-1f6f-3dda-a379-dc7832b14ee6",
                        "source_sense_id": "42fd1f02-8605-3b46-a776-57f4a3c5d0bd",
                        "target_lang_word": "gaspilleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaspilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2951f8db-f385-3f73-af16-e9abc8dc96c5",
                                        "entry_id": "7c98527f-80f3-3b3b-a2f5-c4ff9f641646",
                                        "glosses": [
                                            "Celui qui gaspille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2111ae0-cbf4-4fe4-99aa-5b7889352584",
                                                "sense_id": "2951f8db-f385-3f73-af16-e9abc8dc96c5",
                                                "text": "On en a conclu que ce prince avait été un gaspilleur sans cervelle et sans probité qui avait ruiné son pays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaspilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db2859b7-5585-3adb-975e-f33371301db4",
                                        "entry_id": "ffc11445-781f-35f0-95c5-18184e5eab61",
                                        "glosses": [
                                            "Qui gaspille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53cc5751-4876-4723-8a6c-41d2e82695d1",
                                                "sense_id": "db2859b7-5585-3adb-975e-f33371301db4",
                                                "text": "Ces goûts de courtisane, Valérie les tenait de sa mère, comblée par le général Montcornet pendant les séjours qu’il faisait à Paris, et qui, pendant vingt ans, avait vu tout le monde à ses pieds ; qui, gaspilleuse, avait tout dissipé, tout mangé dans cette vie luxueuse dont le programme est perdu depuis la chute de Napoléon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75fe64af-f3cc-44c7-9bd3-dd7744b9c376",
                        "source_entry_id": "19f855a1-1f6f-3dda-a379-dc7832b14ee6",
                        "source_sense_id": "42fd1f02-8605-3b46-a776-57f4a3c5d0bd",
                        "target_lang_word": "prodigue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prodigue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb243893-4707-3acb-a607-8ab35f548b9c",
                                        "entry_id": "04f1d32e-0160-3147-8e42-85eb24d2bb4b",
                                        "glosses": [
                                            "Qui dissipe son bien en libéralités excessives, en dépenses déraisonnables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff2b971-6d6a-4712-844d-7ca494b3c633",
                                                "sense_id": "bb243893-4707-3acb-a607-8ab35f548b9c",
                                                "text": "Il n’est pas libéral, il est prodigue."
                                            },
                                            {
                                                "example_id": "a2eccc85-9a79-499a-a14d-637be87b9f54",
                                                "sense_id": "bb243893-4707-3acb-a607-8ab35f548b9c",
                                                "text": "Prodigue de son bien et du bien des autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0bed613-6cad-308a-be4f-dc1d630b2c26",
                                        "entry_id": "04f1d32e-0160-3147-8e42-85eb24d2bb4b",
                                        "glosses": [
                                            "En bonne part, celui qui fait de grands sacrifices pour l’utilité d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4d009b3-d10e-493c-8f30-65261606f1b7",
                                                "sense_id": "a0bed613-6cad-308a-be4f-dc1d630b2c26",
                                                "text": "Cet homme est prodigue de son bien pour soulager les malheureux."
                                            },
                                            {
                                                "example_id": "1b35e41b-e30b-4323-92ef-ad11e8f31b95",
                                                "sense_id": "a0bed613-6cad-308a-be4f-dc1d630b2c26",
                                                "text": "Il s’est montré prodigue de son sang, de sa vie pour l’état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2bdccb-c100-384d-8276-22559aa333ca",
                                        "entry_id": "04f1d32e-0160-3147-8e42-85eb24d2bb4b",
                                        "glosses": [
                                            "Qui distribue en abondance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b99b1ae3-9e9f-43d7-a378-b3afeba00104",
                                                "sense_id": "ed2bdccb-c100-384d-8276-22559aa333ca",
                                                "text": "Cet homme est prodigue de paroles, de promesses, de serments."
                                            },
                                            {
                                                "example_id": "f7f0872a-e8a7-4e3c-a962-579c6bc15155",
                                                "sense_id": "ed2bdccb-c100-384d-8276-22559aa333ca",
                                                "text": "Il n’est pas prodigue de louanges."
                                            },
                                            {
                                                "example_id": "21261d26-3d86-4077-b52a-0af41af8bd99",
                                                "sense_id": "ed2bdccb-c100-384d-8276-22559aa333ca",
                                                "text": "Il est prodigue de ses soins, de ses conseils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8acc5f40-b939-3d86-a8b1-02ef8e67788a",
                                        "entry_id": "04f1d32e-0160-3147-8e42-85eb24d2bb4b",
                                        "glosses": [
                                            "Qui donne des conseils à la légère."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33071332-72e3-4c59-8c52-b4ef4d899337",
                                                "sense_id": "8acc5f40-b939-3d86-a8b1-02ef8e67788a",
                                                "text": "Cet homme est prodigue de conseils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa39a63a-9f82-333f-8822-b200ba9b29d6",
                                        "entry_id": "04f1d32e-0160-3147-8e42-85eb24d2bb4b",
                                        "glosses": [
                                            "Qui aime à se donner en spectacle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13d97662-e18d-4970-9be8-78b9f541b2b2",
                                                "sense_id": "fa39a63a-9f82-333f-8822-b200ba9b29d6",
                                                "text": "Ce jeune homme est prodigue d’habits, d’ornements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3686720c-6310-3eb3-9500-dec8266fca70",
                                        "entry_id": "04f1d32e-0160-3147-8e42-85eb24d2bb4b",
                                        "glosses": [
                                            "Il se dit aussi d’une personne qui ne sait pas tenir sa parole."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ca4289-f62b-429d-a720-d3d1516e8a6a",
                                                "sense_id": "3686720c-6310-3eb3-9500-dec8266fca70",
                                                "text": "Il n’est pas prodigue"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prodigue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b503230c-f3c7-3966-8556-2afaaeb043d8",
                                        "entry_id": "e4fb3e1b-3f63-3c0f-a58e-83f4db6e5133",
                                        "glosses": [
                                            "Personne prodigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5ffe32-65a5-4044-86b3-4f5080cf110d",
                                                "sense_id": "b503230c-f3c7-3966-8556-2afaaeb043d8",
                                                "text": "Il peut être défendu aux prodigues de plaider, de transiger, d’emprunter, etc., sans l’assistance d’un conseil."
                                            },
                                            {
                                                "example_id": "1e503cac-e1bd-4d86-b3d3-c1a03e24fab2",
                                                "sense_id": "b503230c-f3c7-3966-8556-2afaaeb043d8",
                                                "text": "C’est un prodigue."
                                            },
                                            {
                                                "example_id": "befc9210-3859-4674-901e-23193eb82291",
                                                "sense_id": "b503230c-f3c7-3966-8556-2afaaeb043d8",
                                                "text": "Celui qui jette dans sa terre des tonnes d’engrais est un prodigue qui fabrique de la richesse pour le temps de la récolte."
                                            },
                                            {
                                                "example_id": "bbc2eddb-cb61-42db-8b5b-c0c7525cb363",
                                                "sense_id": "b503230c-f3c7-3966-8556-2afaaeb043d8",
                                                "text": "Ce ne sont pas toujours les gens intéressés qui sont les moins scrupuleux. Il y a beaucoup d’avares honnêtes.\n— Naturellement, darling ! dit miss Bell. Les avares ne veulent rien devoir, et les prodigues trouvent très supportable d’avoir des dettes. Il ne pensent guère à l’argent qu’ils ont, et ils pensent encore moins à celui qu’ils doivent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prodigue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac868100-adf1-3af0-a0f4-8b1c4bbce6a5",
                                        "entry_id": "47fd7189-d921-3135-b171-73c0f1321dc0",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de prodiguer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71d9a33b-7e82-3a27-9924-5b9133763553",
                                        "entry_id": "47fd7189-d921-3135-b171-73c0f1321dc0",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de prodiguer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618965c4-54b2-44e3-9c0f-444dbe2f6cd1",
                                                "sense_id": "71d9a33b-7e82-3a27-9924-5b9133763553",
                                                "text": "Par avance, il sait ce qu’il trouvera d’imparfait, de médiocre, de mal, d’immuable, en dépit des conseils, des admonestations ou reproches qu’il prodigue et ressasse à chaque inspection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb9577e-b988-31f3-975b-6570d2c19a20",
                                        "entry_id": "47fd7189-d921-3135-b171-73c0f1321dc0",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de prodiguer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15fba849-133b-3515-8061-9f8fa81c9c27",
