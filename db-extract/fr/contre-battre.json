                ],
                "senses": [
                    {
                        "sense_id": "4c3b1612-51d6-3bab-b536-be6b93ff7a60",
                        "entry_id": "3a43abdb-43e6-3410-a9aa-1ce1f9ce17b3",
                        "glosses": [
                            "Battre ce qui bat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dea27a77-9633-4502-af93-ed4ae9a82754",
                                "sense_id": "4c3b1612-51d6-3bab-b536-be6b93ff7a60",
                                "text": "Les légations alliées lentement pénétrées des exemples turc et bulgare, tardivement acquises à l’évidence que le droit ne se suffit point à lui-même, venaient de s’aviser de la nécessité de contre-battre par autre chose qu’une morgue passive la propagande ouverte des puissances centrales."
                            }
                        ]
                    },
                    {
                        "sense_id": "94e77739-78cd-3f8b-8978-bebc0ac13e81",
                        "entry_id": "3a43abdb-43e6-3410-a9aa-1ce1f9ce17b3",
                        "glosses": [
                            "Dresser une contre-batterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da54c1e-851a-4ca3-8116-6960e8fa1ff5",
                                "sense_id": "94e77739-78cd-3f8b-8978-bebc0ac13e81",
                                "text": "Après s'être ralliés, ils essayèrent en vain de tourner notre droite et d'établir de nouvelles pièces en batterie pour contre-battre celles qui défendaient le carrefour des routes de Mamers et de Marolles."
                            }
                        ]
                    },
                    {
                        "sense_id": "40dbf990-3671-31b9-9a6f-3c8d76dc1f0c",
                        "entry_id": "3a43abdb-43e6-3410-a9aa-1ce1f9ce17b3",
                        "glosses": [
                            "Inverser l’action en cours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9ad6fb-f883-40c8-9b52-91aba4e5a62e",
                                "sense_id": "40dbf990-3671-31b9-9a6f-3c8d76dc1f0c",
                                "text": "Mais en vain essaie-t il de manœuvrer la manette, de contre-battre la vapeur, d’enrayer la marche en serrant les freins…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0c0ebef-ee05-4113-8d8f-35ba1e56a87d",
                        "source_entry_id": "3a43abdb-43e6-3410-a9aa-1ce1f9ce17b3",
                        "target_lang_word": "controbattere",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "controbattere",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "47db2ae2-2e36-3117-8e95-fccc5b41e53e",
                                        "entry_id": "d06d51e8-0437-3d78-aa42-06efd9ce6e7b",
                                        "glosses": [
                                            "ostacolare qualcuno, negare qualcosa di vero oppure affrontare ostilmente persone, ingiustamente ritenute una minaccia, con un discorso in cui non si crede totalmente cercando a discolpa pretesti inutili o discussioni fuorvianti e vane"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a213af91-fa71-4c6b-99e1-a45d056acee6",
                                                "sense_id": "47db2ae2-2e36-3117-8e95-fccc5b41e53e",
                                                "text": "il suo modo di controbattere principia col tentativo di una sfida aperta"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62a8164-452a-375e-9ee4-ad0a0dd3efb6",
                                        "entry_id": "d06d51e8-0437-3d78-aa42-06efd9ce6e7b",
                                        "glosses": [
                                            "tentare di trasformare il bene in male con sofismi e creando difficoltà risolvibili solo in parte"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa9bf8d-299c-4f5a-a10a-1d1669344bf6",
                                                "sense_id": "a62a8164-452a-375e-9ee4-ad0a0dd3efb6",
                                                "text": "ho persino quasi perso di vista ciò a cui più tengo, talmente tanto ha controbattuto contro di me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c03ce0c9-7350-366f-86bf-4242f9e84930",
                                        "entry_id": "d06d51e8-0437-3d78-aa42-06efd9ce6e7b",
                                        "glosses": [
                                            "far perdere ogni speranza, soprattutto nei momenti di perplessità altrui ovvero quando si cercano risposte importanti"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e97d6b6-df40-4e0e-b12c-e377b87118d8",
                                                "sense_id": "c03ce0c9-7350-366f-86bf-4242f9e84930",
                                                "text": "era incredibile ma, anche in silenzio, sembrava quasi controbattere contro la stessa esistenza di chiunque avesse di fronte"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
