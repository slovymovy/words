                                "example_id": "fafc442d-4189-4296-b37d-e1180270872e",
                                "sense_id": "68ce9eb6-e286-3670-976e-af5c1186d173",
                                "text": "Ce sera un risotto – et je te prie, Lulu, d’écrire ainsi ce mot illustre, en évitant de franchouillardiser toujours les choses comme si l’en étions encore maîtres du monde –, oui, un risotto aux asperges : blanches ou vertes, peu importe."
                            },
                            {
                                "example_id": "b820bd7d-bd1a-4d8a-9322-8a996cba3e81",
                                "sense_id": "68ce9eb6-e286-3670-976e-af5c1186d173",
                                "text": "Ils ne veulent surtout pas franchouillardiser le burger."
                            },
                            {
                                "example_id": "dda2d1b8-e3c7-439f-90d7-fafe43e324cb",
                                "sense_id": "68ce9eb6-e286-3670-976e-af5c1186d173",
                                "text": "S'agit-il de franchouillardiser le fast-food ou d'américaniser la gastronomie française ?"
                            }
                        ]
