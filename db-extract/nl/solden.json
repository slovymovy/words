                "word": "solden",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45d4fede-23ec-3cd0-a149-d774b34e4650",
                        "entry_id": "4721e42f-708d-32b0-bb39-5c6d6b202f17",
                        "glosses": [
                            "verkoop tegen verlaagde prijzen, in de regel van aan het einde van het seizoen overgebleven producten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f714cfcd-4d33-4b9b-a829-41b773bcf765",
                                "sense_id": "45d4fede-23ec-3cd0-a149-d774b34e4650",
                                "text": "De onderneming die haar goederen in de solden wil verkopen, moet dat doen tegen verlaagde prijzen."
                            },
                            {
                                "example_id": "30903789-c2bc-494d-994a-b503625e5d8d",
                                "sense_id": "45d4fede-23ec-3cd0-a149-d774b34e4650",
                                "text": "Minister van Middenstand en KMO’s Willy Borsus denkt na over een hervorming van de solden."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b7fcc51-e8e6-3c6a-bf8b-e2e35e056d5a",
                        "entry_id": "4721e42f-708d-32b0-bb39-5c6d6b202f17",
                        "glosses": [
                            "periode waarin sommige producten tegen verlaagde prijzen worden verkocht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4a51da6-643d-4188-82a5-828b4103e921",
                                "sense_id": "0b7fcc51-e8e6-3c6a-bf8b-e2e35e056d5a",
                                "text": "Voorafgaand aan de solden zit de sperperiode."
                            },
                            {
                                "example_id": "710ae31a-cbbc-421a-9428-5de869d17bf2",
                                "sense_id": "0b7fcc51-e8e6-3c6a-bf8b-e2e35e056d5a",
                                "text": "Heel wat Vlamingen meten zich tijdens de solden een nieuwe garderobe aan, maar er zit een addertje onder het gras: meer dan 1 Vlaming op 5 (22,7%) laat zich tijdens de koopjesperiode vangen aan een miskoop."
                            }
                        ]
                    }
