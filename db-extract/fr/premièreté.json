                                        "examples": [
                                            {
                                                "example_id": "56f2626f-7238-4f18-9a2a-bc8132406a02",
                                                "sense_id": "f0b78a82-f12b-32de-831c-05c0aab3a3c9",
                                                "text": "But it was not swimming and boating again that pleased him. The joy of it was its firstness: never before had a boat rested on the waters of this world; never before had these children seen a human being swim."
                                            },
                                            {
                                                "example_id": "0d899c20-860a-4e41-9b72-f9c37e5ff10b",
                                                "sense_id": "f0b78a82-f12b-32de-831c-05c0aab3a3c9",
                                                "text": "Firstness (in-itselfness, originality) helps to explain logico-cognitive processes and therefore, at once, the formation of signs."
                                            }
                                        ]
                                    }
                                ]
