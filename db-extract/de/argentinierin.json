                                "target_senses": [
                                    {
                                        "sense_id": "a7f690f5-5bff-37a8-9cb4-7e455b3f5169",
                                        "entry_id": "d2431aa9-96b4-356f-953e-bb8f3c7a7e4d",
                                        "glosses": [
                                            "A person from Argentina or of Argentine descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7366d4-dce9-406c-9cc3-bc35544307ce",
                                                "sense_id": "a7f690f5-5bff-37a8-9cb4-7e455b3f5169",
                                                "text": "Fernández acidly notes that the \"Malvinas\" are 8,700 miles away from London and claims, controversially, that the Royal Navy expelled the Argentinians who originally lived on the remote South Atlantic territory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Argentinian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b565252-3e23-3c12-8ca6-2537fa0d8a2b",
                                        "entry_id": "d2efbbe4-7294-36bb-aa89-9f5d36cc60c9",
                                        "glosses": [
                                            "Of, from, or pertaining to Argentina and the Argentine people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4a5ce6-6681-434c-b562-dca6f522d0fd",
                                                "sense_id": "5b565252-3e23-3c12-8ca6-2537fa0d8a2b",
                                                "text": "The FCO also disputes Fernández's claim that Britain kicked out the island's original Argentinian inhabitants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
