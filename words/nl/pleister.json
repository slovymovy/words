{
    "word_family": [
        "pleisteren",
        "pleisterwerk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a59e41a-b62d-3d7c-a90d-352affb35226",
                    "sense_definition": "Een dun velletje zelfklevend verband dat op de huid geplakt wordt ter bescherming van een kleine wond of blaar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medisch_verband",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je je in je vinger gesneden hebt, kan je er beter een <w>pleister</w> op doen.",
                            "target_lang_translations": {
                                "en": "If you have cut your finger, you had better put a <w>plaster</w> on it."
                            }
                        },
                        {
                            "text": "Ik moet een <w>pleister</w> plakken op de blaar op mijn hiel.",
                            "target_lang_translations": {
                                "en": "I need to put a <w>Band-Aid</w> on the blister on my heel."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleefpleister",
                        "plakker"
                    ],
                    "common_phrases": [
                        "een pleister plakken",
                        "pleister op de wond"
                    ],
                    "target_lang_definitions": {
                        "en": "A thin piece of adhesive bandage applied to the skin to protect a small wound or blister."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plaster",
                                "target_lang_sense_clarification": "British, NZ, and Canadian term for an adhesive bandage"
                            },
                            {
                                "target_lang_word": "sticking plaster",
                                "target_lang_sense_clarification": "British and NZ term for an adhesive bandage"
                            },
                            {
                                "target_lang_word": "Band-Aid",
                                "target_lang_sense_clarification": "US, Canadian, and Australian term for an adhesive bandage"
                            },
                            {
                                "target_lang_word": "adhesive bandage",
                                "target_lang_sense_clarification": "general medical term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bebf752f-cd1a-3455-b85e-8f442a4e7a7f",
                    "sense_definition": "Een kalkmengsel om muren mee te besmeren of om mee te gieten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bouwmaterialen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stukadoor bracht een nieuwe laag <w>pleister</w> aan op de beschadigde muur.",
                            "target_lang_translations": {
                                "en": "The plasterer applied a new layer of <w>plaster</w> to the damaged wall."
                            }
                        },
                        {
                            "text": "Het natte <w>pleister</w> moet eerst goed drogen voordat we kunnen schilderen.",
                            "target_lang_translations": {
                                "en": "The wet <w>plaster</w> must dry thoroughly first before we can paint."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalk",
                        "witkalk",
                        "muurkalk",
                        "plaaster",
                        "pleistermortel",
                        "pleisterkalk",
                        "stuc",
                        "witsel"
                    ],
                    "common_phrases": [
                        "laag pleister"
                    ],
                    "target_lang_definitions": {
                        "en": "A mixture of lime or gypsum, sand, and water used for coating walls and ceilings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plaster",
                                "target_lang_sense_clarification": "substance used for coating walls"
                            },
                            {
                                "target_lang_word": "stucco",
                                "target_lang_sense_clarification": "fine plaster used for coating wall surfaces or molding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bae864d-8246-3f94-a2ad-ffd6fc9bedb6",
                    "sense_definition": "Een tijdelijk lapmiddel dat geen echte of structurele oplossing biedt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk_lapmiddel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze kleine subsidie is slechts een <w>pleister</w> op de wond, maar lost de crisis niet op.",
                            "target_lang_translations": {
                                "en": "This small subsidy is merely a <w>Band-Aid</w> on the wound, but it does not solve the crisis."
                            }
                        },
                        {
                            "text": "Al het andere is eerder een soort van <w>pleister</w> dan een echte oplossing voor het klimaatprobleem.",
                            "target_lang_translations": {
                                "en": "Everything else is more of a <w>sticking plaster</w> than a real solution to the climate problem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pleister op de wond"
                    ],
                    "target_lang_definitions": {
                        "en": "A temporary or makeshift solution that does not offer a real or structural fix."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Band-Aid",
                                "target_lang_sense_clarification": "temporary or makeshift solution"
                            },
                            {
                                "target_lang_word": "sticking plaster",
                                "target_lang_sense_clarification": "inadequate solution to a serious problem"
                            },
                            {
                                "target_lang_word": "quick fix",
                                "target_lang_sense_clarification": "temporary, superficial solution"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31ab0412-fee6-316a-98ba-55ea137e0a11",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>pleisteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>pleister</w> de muren van de nieuwe kamer vandaag nog helemaal zelf.",
                            "target_lang_translations": {
                                "en": "I will <w>plaster</w> the walls of the new room all by myself today."
                            }
                        },
                        {
                            "text": "Als ik de muur <w>pleister</w>, zorg ik altijd voor een gladde afwerking.",
                            "target_lang_translations": {
                                "en": "When I <w>plaster</w> the wall, I always ensure a smooth finish."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present indicative of the verb 'pleisteren' (to plaster)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plaster",
                                "target_lang_sense_clarification": "first-person singular present form of the verb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ac73561-65dd-3cbf-9aa9-15017732c6ea",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>pleisteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>pleister</w> je die oude wand niet voordat je gaat behangen?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>plaster</w> that old wall before you start wallpapering?"
                            }
                        },
                        {
                            "text": "Als je zelf <w>pleister</w>, bespaar je een hoop geld op de verbouwing.",
                            "target_lang_translations": {
                                "en": "If you <w>plaster</w> it yourself, you save a lot of money on the renovation."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present indicative of the verb 'pleisteren' (to plaster)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plaster",
                                "target_lang_sense_clarification": "second-person singular present form of the verb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f44e068c-4ddc-3e8f-bf68-404c168e3e00",
                    "sense_definition": "Gebiedende wijs van <w>pleisteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pleister</w> die muur nu eindelijk eens af, want we moeten door met schilderen.",
                            "target_lang_translations": {
                                "en": "<w>Plaster</w> that wall once and for all, because we need to move on to painting."
                            }
                        },
                        {
                            "text": "Kom op, <w>pleister</w> die gaten dicht voordat het stucwerk helemaal droog is.",
                            "target_lang_translations": {
                                "en": "Come on, <w>plaster</w> those holes shut before the stucco is completely dry."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'pleisteren' (to plaster)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plaster",
                                "target_lang_sense_clarification": "imperative form of the verb"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}