                        "form": "arrière-goûts"
                    },
                    {
                        "form_id": "43c9c4fb-3d22-4373-b391-59990df8bc98",
                        "entry_id": "dea3362a-5f97-3a5c-96a4-16266aee4632",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "arrière-gout"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7be7eab5-c5e4-379c-b491-63719c7467e6",
                        "entry_id": "dea3362a-5f97-3a5c-96a4-16266aee4632",
                        "glosses": [
                            "Goût que laissent dans la bouche certains aliments ou certaines liqueurs, différent de celui qu’on avait éprouvé d’abord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea951dd2-7c8a-4ec6-b667-e3558b488d3a",
                                "sense_id": "7be7eab5-c5e4-379c-b491-63719c7467e6",
                                "text": "Cette fin de l’ère rococo dans les Pays-Bas autrichiens laisse le même arrière-goût pâteux que les natures mortes des petits-maîtres flamands de l’époque, avec leurs fruits, leur foie gras en croûte, et leurs cadavres de bêtes sur des plats de vermeil et des tapis turcs."
                            },
                            {
                                "example_id": "44bc6932-eb38-4972-84d7-d2b9b8a2bfea",
                                "sense_id": "7be7eab5-c5e4-379c-b491-63719c7467e6",
                                "text": "De retour au camp, le couple fit un tour à la roulotte cantine où le cook les régala de cookies et de jus de fruit, ce qui leur permit d'éliminer l’arrière-goût râpeux du pinard militaire."
                            },
                            {
                                "example_id": "99d4645d-1944-412e-9a95-47c2280ddd60",
                                "sense_id": "7be7eab5-c5e4-379c-b491-63719c7467e6",
                                "text": "Ou mieux, je commande une carafe de ce vin rouge léger, à l’arrière-goût de fraise : le bardolino."
                            }
                        ]
                    },
                    {
                        "sense_id": "99235826-1339-3076-b43a-1f48c0e871d4",
                        "entry_id": "dea3362a-5f97-3a5c-96a4-16266aee4632",
                        "glosses": [
                            "Souvenir."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9352d3cb-b26f-498f-81d2-ccecd023b096",
                                "sense_id": "99235826-1339-3076-b43a-1f48c0e871d4",
                                "text": "Bon, je ne suis pas de bois, il m’est arrivé à moi aussi de m’envoyer en l’air, mais ce sont des histoires qui m’ont plutôt laissé un mauvais arrière-goût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca721bca-7342-485d-bbc8-e5c15bdea25d",
                        "source_entry_id": "dea3362a-5f97-3a5c-96a4-16266aee4632",
                        "target_lang_word": "Beigeschmack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beigeschmack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2d0710-a27c-3c42-86c0-61fcf61c92fd",
                                        "entry_id": "dea08af3-b1ab-3dda-80c2-afc51a7d5bec",
                                        "glosses": [
                                            "ein nebensächlicher Geschmack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065ee5b0-b662-49b2-b4f9-a7f54a6cce6e",
                                                "sense_id": "0a2d0710-a27c-3c42-86c0-61fcf61c92fd",
                                                "text": "Der holzige Beigeschmack wird bewusst durch die Lagerung erzeugt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                        "entry_id": "dea08af3-b1ab-3dda-80c2-afc51a7d5bec",
                                        "glosses": [
                                            "ein nebensächlicher, meist unerwünschter Anteil einer Sache (z.B. einer Äußerung)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ecf08a-65b7-4a06-8cca-788ced5ecce1",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "Seine Rede hatten einen üblen Beigeschmack von Polit-Propaganda."
                                            },
                                            {
                                                "example_id": "1c9d3d1e-3e85-4456-91d6-8f8de13b3026",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "Die fragwürdige Aktion hinterließ einen fahlen Beigeschmack."
                                            },
                                            {
                                                "example_id": "ca4c274d-7841-4db6-9a2f-c34da4440d5a",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "„Und wirklich war in der Prozedur des Friedensrichters, ungeachtet des starken Beigeschmacks hinterwäldischer Manieren, eine Offenheit und Biederkeit, die nicht fehlen konnten, ihm Vertrauen zu seinen neuen Bekannten einzuflößen.“"
                                            },
                                            {
                                                "example_id": "ec5852f9-8366-4652-963e-75745ea7f53b",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "„Die zahlenmäßig zweitstärkste Bevölkerungsgruppe bilden die Paschtunen mit 15,4 Prozent (1998) der Gesamtbevölkerung. In Pakistan werden sie häufig als Pathanen bezeichnet, jedoch hat diese Benennung, die auf die Briten zurückgeht, einen kolonialistischen Beigeschmack.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28a521be-74f5-4fb1-9890-b4441d6e8bbc",
