                                        "glosses": [
                                            "flüssige Substanz, die der Frisur Halt und Glanz verleiht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e02c83-4256-48e8-851f-b649fc09f2ce",
                                                "sense_id": "0408708e-bb95-3a21-8ad2-850010e187d2",
                                                "text": "Im Supermarkt findet man Haarlack bei den Kosmetikprodukten."
                                            },
                                            {
                                                "example_id": "9be813e6-cdca-4ea4-8228-0fb6c208f04b",
                                                "sense_id": "0408708e-bb95-3a21-8ad2-850010e187d2",
                                                "text": "„Die 1990er Jahre brachten farbige Strähnen und die Frisur wurde mit Gel oder Haarlack in Form gehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
