                ],
                "senses": [
                    {
                        "sense_id": "8e5543e4-9a87-3846-9d2e-010402215c83",
                        "entry_id": "96ef9091-eb76-383a-8086-dab396a0d870",
                        "glosses": [
                            "Émigrer à nouveau, repartir du pays où l’on est."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0510913-1c64-4d41-94ef-647856590261",
                                "sense_id": "8e5543e4-9a87-3846-9d2e-010402215c83",
                                "text": "Très peu retournent en Union soviétique, mais ce n'est pas chose facile, pas plus qu'il n'est facile de ré-émigrer vers les États-Unis."
                            },
                            {
                                "example_id": "f6c348b4-6986-4c5d-b6bb-ca39c7634372",
                                "sense_id": "8e5543e4-9a87-3846-9d2e-010402215c83",
                                "text": "Une fois qu'ils ont réussi à entrer dans le pays d'accueil, de nombreux sans-papiers sont réticents ne fût-ce qu'à reséjourner dans leur pays d'origine de peur de ne pas être en mesure de ré-émigrer ensuite."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7335b7c-d160-3543-8524-d1d524923fcf",
                        "entry_id": "96ef9091-eb76-383a-8086-dab396a0d870",
                        "glosses": [
                            "Quitter son pays d’accueil pour retourner dans son pays de naissance ou d’origine."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6d165610-f7a8-4cb3-85bd-367370dc089a",
                                "sense_id": "a7335b7c-d160-3543-8524-d1d524923fcf",
                                "text": "Le nombre de citoyens américains à ré-émigrer vers l'Europe est bien inférieur à celui des étrangers qui retournent chez eux."
                            },
                            {
                                "example_id": "57df83b0-9ec8-40eb-bba8-8380e4fed024",
                                "sense_id": "a7335b7c-d160-3543-8524-d1d524923fcf",
                                "text": "Ré-émigrer signifie revenir chez soi et en faire un but, non un choix par défaut."
                            }
                        ]
                    }
                ],
