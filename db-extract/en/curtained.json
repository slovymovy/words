    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5372bafe-96f8-3d62-85c4-b1c04d5dc119",
                "word": "curtained",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28fb4f43-cf88-34e8-9c96-89527bf9468a",
                        "entry_id": "5372bafe-96f8-3d62-85c4-b1c04d5dc119",
                        "glosses": [
                            "Covered or partitioned with a curtain or curtains."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3fbd6abf-e1f5-47dd-bff4-5a115a1f96c3",
                                "sense_id": "28fb4f43-cf88-34e8-9c96-89527bf9468a",
                                "text": "Golden head by golden head, / Like to pigeons in one nest / Folded in each other's wings, / They lay down in their curtained bed:"
                            },
                            {
                                "example_id": "013f3688-2206-471f-9dc6-c7d93ce91b5d",
                                "sense_id": "28fb4f43-cf88-34e8-9c96-89527bf9468a",
                                "text": "[…] as he lay and tossed in the gross darkness of the night and the curtained room, Mr. Enfield's tale went by before his mind in a scroll of lighted pictures."
                            },
                            {
                                "example_id": "0b78ae6d-69ef-4a81-922d-6f5289ad88a5",
                                "sense_id": "28fb4f43-cf88-34e8-9c96-89527bf9468a",
                                "text": "There was just room between the sofa and the curtained wall […]"
                            },
                            {
                                "example_id": "799aae24-4076-4baf-b8d0-a479b1d136de",
                                "sense_id": "28fb4f43-cf88-34e8-9c96-89527bf9468a",
                                "text": "The wall and door of the compartment on the corridor side are of plexiglass, fully curtained on the inside."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a511935-8587-3560-b0f2-bd3ad2c79204",
                        "entry_id": "5372bafe-96f8-3d62-85c4-b1c04d5dc119",
                        "glosses": [
                            "Hidden or separated as if by a curtain."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "134c4ee9-c305-471d-bbc4-c49739310a2e",
                                "sense_id": "9a511935-8587-3560-b0f2-bd3ad2c79204",
                                "text": "Now o'er the one halfworld / Nature seems dead, and wicked dreams abuse / The curtain'd sleep;"
                            }
                        ]
                    },
                    {
                        "sense_id": "bd4d895f-033b-370b-90ff-7bef1f94136d",
                        "entry_id": "5372bafe-96f8-3d62-85c4-b1c04d5dc119",
                        "glosses": [
                            "Hung with a curtain or curtains of a specified type."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "49191586-14ed-4851-b93b-ef9f11ecbdd8",
                                "sense_id": "bd4d895f-033b-370b-90ff-7bef1f94136d",
                                "text": "And in his sedgy bed the lark, for joy that Day is nigh, / Scatters the pearléd dew from off the grass, / In tremulous ecstasy to greet the sun, / Who soon in gilded panoply will pass / Forth from yon orange-curtained pavilion / Hung in the burning east […]"
                            },
                            {
                                "example_id": "54e8c4c2-7277-453f-ac25-c68b42f9e72a",
                                "sense_id": "bd4d895f-033b-370b-90ff-7bef1f94136d",
                                "text": "[…] the ladies had retired to their chintz-curtained bedroom […]"
                            },
                            {
                                "example_id": "fab900ab-5f3e-4805-b04e-7373052bdb95",
                                "sense_id": "bd4d895f-033b-370b-90ff-7bef1f94136d",
                                "text": "Little grocery shops and bakeries stood between jewelers and florists and bead-curtained doors opening into private houses […]"
                            }
                        ]
                    }
                ],
