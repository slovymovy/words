                                                "example_id": "75650578-e964-4321-a832-5579cbc96ae2",
                                                "sense_id": "d530bf5c-3b41-36d8-9c01-e554f3455259",
                                                "text": "Mangels Gegenvorschlägen werden wir dann also heute abend bei Kalle grillen."
                                            }
