                                    {
                                        "sense_id": "83f4cb80-943f-3fe8-bbdf-757178cd3003",
                                        "entry_id": "7997f1db-f87f-3698-9056-c12ad9214c31",
                                        "glosses": [
                                            "That which holds anything tightly or supports it firmly; a bandage or a prop."
                                        ],
                                        "tags": [],
