                "senses": [
                    {
                        "sense_id": "497db2df-ed04-3302-98fd-7ebd54fd4daa",
                        "entry_id": "26085d49-f385-3455-a5bf-5266d8c762d4",
                        "glosses": [
                            "Négocier sur des détails inutiles (des mégots, métaphoriquement parlant), vouloir économiser mesquinement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e5e974-4313-47a6-9167-a6cfe8c00c23",
                                "sense_id": "497db2df-ed04-3302-98fd-7ebd54fd4daa",
                                "text": "On ne va pas mégotter deux heures sur une broutille!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08828678-3dd9-4d7c-ba17-a90414468fba",
                        "source_entry_id": "26085d49-f385-3455-a5bf-5266d8c762d4",
                        "source_sense_id": "497db2df-ed04-3302-98fd-7ebd54fd4daa",
                        "target_lang_word": "feilschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feilschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c023b5e-224e-3418-a5ed-fa70bf06fc86",
                                        "entry_id": "0aef5b72-0ea9-34a0-9ed6-c017fcc320d2",
                                        "glosses": [
                                            "hartnäckig, oft kleinlich handeln und verhandeln, um ein gutes Ergebnis, meist einen guten Preis zu erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75604d50-8c7c-4312-89e1-ed1226992682",
                                                "sense_id": "4c023b5e-224e-3418-a5ed-fa70bf06fc86",
                                                "text": "Beim Nachmessen feilschte er um jeden Zentimeter."
                                            },
                                            {
                                                "example_id": "0789db70-0713-499a-a4ae-8772d65c0ff2",
                                                "sense_id": "4c023b5e-224e-3418-a5ed-fa70bf06fc86",
                                                "text": "Auf einem orientalischen Markt wird der Urlauber genötigt zu feilschen."
                                            },
                                            {
                                                "example_id": "2c0be713-cf0c-42fc-b49f-7dfeef65a4d2",
                                                "sense_id": "4c023b5e-224e-3418-a5ed-fa70bf06fc86",
                                                "text": "Die beiden konnten sich nicht über einen Preis für die Taxitour einigen und standen feilschend in der Hotelhalle."
                                            },
                                            {
                                                "example_id": "48099c64-0d91-4542-a253-8d66c8e227af",
                                                "sense_id": "4c023b5e-224e-3418-a5ed-fa70bf06fc86",
                                                "text": "An den Zahlen gibt es nichts zu feilschen, die stimmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c5a7344-7980-4789-a80c-804539d1d855",
                        "source_entry_id": "26085d49-f385-3455-a5bf-5266d8c762d4",
                        "source_sense_id": "497db2df-ed04-3302-98fd-7ebd54fd4daa",
                        "target_lang_word": "nitpick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitpick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59618a27-4f6c-33cd-94bc-10c490658fe4",
                                        "entry_id": "bdf15ae2-96b6-3bfc-85b4-f42b783c4041",
                                        "glosses": [
                                            "To correct insignificant mistakes or find fault in unimportant details."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38cdb178-5fd9-43ca-9a19-2b0bfdb0fe79",
                                                "sense_id": "59618a27-4f6c-33cd-94bc-10c490658fe4",
                                                "text": "Someone will invariably nitpick about any spelling error posted to the forums."
                                            },
                                            {
                                                "example_id": "2030913c-e80a-4e90-89b2-1cdfc490058c",
                                                "sense_id": "59618a27-4f6c-33cd-94bc-10c490658fe4",
                                                "text": "But Pirates! comes with all the usual Aardman strengths intact, particularly the sense that its characters and creators alike are too good-hearted and sweet to nitpick. The ambition is all in the craft rather than in the storytelling, but it’s hard to say no to the proficiency of that craft, or the mild good cheer behind it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf8019d8-10cc-3be4-be79-7d852b6fe70b",
                                        "entry_id": "bdf15ae2-96b6-3bfc-85b4-f42b783c4041",
                                        "glosses": [
                                            "To pick nits (lice eggs) from someone’s hair."
                                        ],
