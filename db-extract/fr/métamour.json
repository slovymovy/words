                        "glosses": [
                            "En relation polyamoureuse, autre compagne ou compagnon de sa compagne ou de son compagnon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5bb41269-0a5c-3049-aeba-ca1e307ff515",
                        "entry_id": "38a5d77b-4e38-37f2-b0eb-fcecfafa063e",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter) Terme utilisé par Jacques Lacan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7e4a96-029c-48d5-9418-be85f7517df1",
                                "sense_id": "5bb41269-0a5c-3049-aeba-ca1e307ff515",
                                "text": "Vous rencontrerez de ces deuils étranges décrits par Freud dans la mélancolie. Je vous présente comme terme le métamour. Il n’y a pas de métalangage, mais il y a sûrement un métamour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "077ee5cc-d9d0-40cd-9746-95ad66baa8ba",
                        "source_entry_id": "38a5d77b-4e38-37f2-b0eb-fcecfafa063e",
