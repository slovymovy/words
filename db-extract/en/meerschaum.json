                "senses": [
                    {
                        "sense_id": "86e2d2d5-c690-3476-a908-5be1c86c89d6",
                        "entry_id": "1d2ccffa-3062-391d-9bc2-5a8711e163a0",
                        "glosses": [
                            "A soft white mineral, chiefly used for smoking-pipes and cigar holders."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "be25c4e0-7a9c-4fa6-9ed8-2db057fa5fc9",
                                "sense_id": "86e2d2d5-c690-3476-a908-5be1c86c89d6",
                                "text": "He gazed around until on the lid of a spinet he spotted a promising collection of bottles, gin, whiskey, vermouth and sherry, mixed with violin bows, a flute, a toppling pile of books, six volumes of Grove's Dictionary mingled with paperback thrillers, a guitar without any strings, a pair of binoculars, a meerschaum pipe and a jar half-full of wasps and apricot jam."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f2a5bb-31aa-35c0-9751-1c361e92f0f7",
                        "entry_id": "1d2ccffa-3062-391d-9bc2-5a8711e163a0",
                        "glosses": [
                            "A smoking-pipe made from meerschaum."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "2847e039-04fe-4542-83a3-acd050ad453d",
                                "sense_id": "e7f2a5bb-31aa-35c0-9751-1c361e92f0f7",
                                "text": "The sale of part of his property cleared the rest. A large portion of his income was put aside to accumulate. Horses, pictures, wines, bijouterie, German meerschaum, and Turkish hookahs, were alike brought to the hammer."
                            },
                            {
                                "example_id": "36e56924-ba0c-46bd-b6d1-3c0f3b4a4fe0",
                                "sense_id": "e7f2a5bb-31aa-35c0-9751-1c361e92f0f7",
                                "text": "At Paris, just after dark one gusty evening in the autumn of 18—, I was enjoying the twofold luxury of meditation and a meerschaum, in company with my friend C. Auguste Dupin, in his little back library, or book-closet, au troisiême, No. 33, Rue Dunôt, Faubourg St. Germain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0571c845-8aae-4f21-8029-fc19c2bd8b6c",
                        "source_entry_id": "1d2ccffa-3062-391d-9bc2-5a8711e163a0",
                        "source_sense_description": "mineral",
                        "target_lang_word": "écume de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
