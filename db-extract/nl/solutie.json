                    {
                        "sense_id": "e2b372c3-d49a-33a9-be6d-c658b290d453",
                        "entry_id": "43fe6ae5-6cb2-3547-872c-768da73a7910",
                        "glosses": [
                            "een lijm die gebruikt wordt om kleine lekken in een rubberen fietsbinnenband te dichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c7c7c0-4f5f-4b24-a4a6-344ef2820198",
                                "sense_id": "e2b372c3-d49a-33a9-be6d-c658b290d453",
                                "text": "Samen met Frans de Bruin van de overkant ging ik naar de fietsenmaker, waar het naar solutie rook, naar fietsenlak, naar binnenbanden, wasbenzine."
                            },
                            {
                                "example_id": "b66ebd39-3bf1-4644-95e6-a1c87f1b926d",
                                "sense_id": "e2b372c3-d49a-33a9-be6d-c658b290d453",
                                "text": "Niets van dat al. Uitvindingen van enig belang heeft de mensheid - afgezien van het internet - na 1960 niet meer voortgebracht. Nog altijd is er het gehannes met bandenlichters en solutie. Zelfs het probleem van de eeuwig kapotte fietslamp is onopgelost. De moderne fietser heeft gelijk: genoeg geplakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c5bfd1b-de59-3bce-a309-77e61497a5d8",
                        "entry_id": "43fe6ae5-6cb2-3547-872c-768da73a7910",
                        "glosses": [
                            "stof die in een oplosmiddel is opgelost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0ef04a-d8cc-4b8b-9561-0777cf591be3",
                                "sense_id": "5c5bfd1b-de59-3bce-a309-77e61497a5d8",
                                "text": "\"Ik wist dat in de spinni[n]g-area maskers gebruikt moesten worden. De draden kwamen naar beneden met de solutie erin. Handschoenen werden niet gebruikt in de spinning. Toch hebben de vrouwen het binnengekregen. Ik wist dat het door de huid heenging.\""
                            }
                        ]
                    }
