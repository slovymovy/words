                        "glosses": [
                            "plötzlich auftretender Defekt an der Aufführungsfläche einer Bühne von Theater- oder Musikstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbaa4aff-9c05-402c-821c-060f23a5fafa",
                                "sense_id": "0b5c5c17-b632-3a12-9c6f-757b0782b02e",
                                "text": "„Der Auftakt der Bayreuther Festspiele wird von einer Bühnenpanne gestört.“"
                            },
                            {
                                "example_id": "2d796908-bc97-459d-aefb-b806d865d058",
                                "sense_id": "0b5c5c17-b632-3a12-9c6f-757b0782b02e",
                                "text": "„Eine Bühnenpanne hat den Auftakt der Richard-Wagner-Festspiele in Bayreuth unterbrochen.“"
                            },
                            {
                                "example_id": "648feda3-ce07-41ca-ad56-9f3a0d1f5f9a",
                                "sense_id": "0b5c5c17-b632-3a12-9c6f-757b0782b02e",
                                "text": "„Die Bühnenpanne mit dem Schwert war nicht der einzige Fall, in dem für den Tenor aus München während einer Oper etwas schief ging.“"
                            },
                            {
                                "example_id": "c9cdc640-06ae-484c-b924-03e8e4d7a70e",
                                "sense_id": "0b5c5c17-b632-3a12-9c6f-757b0782b02e",
                                "text": "„Die Bayreuther Festspiele haben mit einer Bühnenpanne begonnen.“"
                            }
                        ],
