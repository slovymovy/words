                "senses": [
                    {
                        "sense_id": "e90843dd-f1a9-351e-ae70-153b45523275",
                        "entry_id": "d31d510b-3086-355d-b427-8bea109665dc",
                        "glosses": [
                            "Donner un caractère onshore à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babc5712-300e-45b6-b103-1c8efb4066c7",
                                "sense_id": "e90843dd-f1a9-351e-ae70-153b45523275",
                                "text": "Pourquoi et comment « onshoriser » les sociétés financières patrimoniales : transfert de siège social vers la France, transfert de siège social vers la Suisse."
                            },
                            {
                                "example_id": "7d522371-5ca5-48e9-89f9-ac5506513be4",
                                "sense_id": "e90843dd-f1a9-351e-ae70-153b45523275",
                                "text": "Généralement inaccessibles aux particuliers, il faudrait les « sicaviser », les « onshoriser »."
                            },
                            {
                                "example_id": "a21759b7-fb8a-4e46-a7c1-350cc00e6371",
                                "sense_id": "e90843dd-f1a9-351e-ae70-153b45523275",
                                "text": "Le but était notamment de rapatrier (« onshoriser ») l'activité de shipping, par nature très mobile, qui faisait face à une concurrence importante au niveau mondial."
                            }
                        ]
                    }
