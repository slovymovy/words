                "senses": [
                    {
                        "sense_id": "d023e69f-cb52-3176-b40c-a609595666c6",
                        "entry_id": "e4aaa6cf-14d2-35bd-8706-8a5fc5da7348",
                        "glosses": [
                            "Débarrasser de son électricité statique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73d8c9e-8d37-4110-a8d3-2fc7bc8834ad",
                                "sense_id": "d023e69f-cb52-3176-b40c-a609595666c6",
                                "text": "Ces lames touchant le fond de métal servent à désélectriser l'intérieur de l’instrument."
                            },
                            {
                                "example_id": "f2b80a91-0406-4dcd-a95b-9fd706f0d9d1",
                                "sense_id": "d023e69f-cb52-3176-b40c-a609595666c6",
                                "text": "Jusqu’ici, on s’est borné à désélectriser les alentours des édifices armés, et l’on n'a pas tenté de soutirer l’électricité d’un nuage entier, en disposant à sa rencontre une série de conducteurs rapprochés et agissant simultanément."
                            },
                            {
                                "example_id": "1e4b53da-c38e-4489-8bc1-d18283d763c4",
                                "sense_id": "d023e69f-cb52-3176-b40c-a609595666c6",
                                "text": "Les appareils les plus utilisés sont des appareils Kestner, Lambert, le climatogène Bontemps, […], les appareils désélectrisant les laines, etc."
                            }
                        ]
                    }
                ],
