                        "source_sense_description": "with great skill or knowledge",
                        "target_lang_word": "habilement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habilement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d910be51-9783-3194-99a4-3bacda006ae1",
                                        "entry_id": "1c827973-3ea5-376c-acdb-6ee86552834a",
                                        "glosses": [
                                            "D'une manière habile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42402c13-e6c8-4878-b8f0-eb7b94fc3d41",
                                                "sense_id": "d910be51-9783-3194-99a4-3bacda006ae1",
                                                "text": "Les femmes ne vont jamais dans les kayaks, mais elles manient assez habilement les « omayaks », sortes de grands canots pouvant porter de lourdes charges."
                                            },
                                            {
                                                "example_id": "701e2888-4700-41ba-8cdd-c4aee0c449cd",
                                                "sense_id": "d910be51-9783-3194-99a4-3bacda006ae1",
                                                "text": "Il s’est tiré habilement d’affaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19bb3f3b-a048-48ff-9885-0b0df47ffefe",
                        "source_entry_id": "ff26d09c-aac3-3d5b-a9cb-a7e6c40c88e3",
                        "source_sense_id": "7dcd697b-0cdb-323b-a56b-5cd099dee323",
                        "source_sense_description": "with great skill or knowledge",
                        "target_lang_word": "dextrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dextrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                        "entry_id": "4d5dbdb9-d0da-3b8d-851b-db55ed60ccf0",
                                        "glosses": [
                                            "Avec dextérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05cf2334-e6e0-43c1-9d92-9d67f8637357",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Manier dextrement les desseins de nos princes."
                                            },
                                            {
                                                "example_id": "add90e33-db86-481e-aaed-379d1a03f664",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Vous coupez dextrement les trois peaux qui l'enveloppent."
                                            },
                                            {
                                                "example_id": "b24cbb40-92a7-49d9-b7d9-16f5ea7be3b2",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Un peintre peignit un rideau si dextrement qu'on s'avisa de le tirer."
                                            },
                                            {
                                                "example_id": "aae83713-5b34-4886-bc47-04408dec3bbb",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Conte-lui dextrement le naturel des femmes."
                                            },
                                            {
                                                "example_id": "b11b3e66-2fdb-42a2-87ce-e49be12d0be3",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Sans rien mettre au hasard, je saurai dextrement\nAccorder vos soupçons et son contentement."
                                            },
                                            {
                                                "example_id": "879f758b-a63d-4944-9aed-10b98a95e0e6",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Un médecin assez industrieux pour manier dextrement une partie et si malade et si délicate."
                                            },
                                            {
                                                "example_id": "f1c25167-0a92-4c89-ac74-8cadd2e57b3f",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Rosen alla trouver le roi, s'excusa, et s'en tira si dextrement que le roi ne put lui savoir mauvais gré."
                                            },
                                            {
                                                "example_id": "f1018923-023c-4712-aa12-d13f974c1ebe",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Apprends-moi l'art de tromper dextrement."
                                            },
                                            {
                                                "example_id": "69b433ff-ee45-473a-9a4a-89d2a53a8ecd",
                                                "sense_id": "84b6fb80-f103-3a6d-9990-502da378fd6e",
                                                "text": "Et voilà maintenant, séparés de nous par trois cents générations tout au plus, les ingénieux, les habiles, les adaptés du néolithique, talonnés bientôt par les technocrates du cuivre et du fer ; les artisans accomplissant dextrement des gestes que l'homme a faits et refaits jusqu'à la génération qui précède la nôtre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
