    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c672f4ac-1074-3c20-9e19-ddb32fffcc8a",
                    "sense_definition": "Iets omhoog of naar boven werpen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "omhoog_werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen lachen terwijl ze de kleurrijke ballen hoog in de lucht <w>opgooien</w>.",
                            "target_lang_translations": {
                                "en": "The children laugh as they <w>toss</w> the colorful balls high into the air."
                            }
                        },
                        {
                            "text": "Je moet de pannenkoek voorzichtig <w>opgooien</w> om hem in de pan om te draaien.",
                            "target_lang_translations": {
                                "en": "You have to <w>flip</w> the pancake carefully to turn it over in the pan."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhooggooien",
                        "omhoogwerpen",
                        "tossen"
                    ],
                    "antonyms": [
                        "neergooien",
                        "neerleggen"
                    ],
                    "common_phrases": [
                        "een muntje opgooien",
                        "een pannenkoek opgooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To throw something upwards or into the air."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw up",
                                "target_lang_sense_clarification": "to toss something upwards"
                            },
                            {
                                "target_lang_word": "toss in the air",
                                "target_lang_sense_clarification": "to throw something high into the air"
                            },
                            {
                                "target_lang_word": "throw upward",
                                "target_lang_sense_clarification": "to direct a throw upwards"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbd281e3-6a4e-369e-b7f9-a7b1155f0d35",
                    "sense_definition": "Iets boven op iets anders werpen, of figuurlijk een idee of suggestie ter sprake brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de vergadering besloot hij een nieuw idee <w>op</w> te <w>gooien</w> over de marketingstrategie.",
                            "target_lang_translations": {
                                "en": "During the meeting, he decided to <w>bring up</w> a new idea about the marketing strategy."
                            }
                        },
                        {
                            "text": "Hij wilde zijn laatste troef <w>opgooien</w> om het spel alsnog te winnen.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>play</w> his last trump card to win the game after all."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een idee opgooien",
                        "een balletje opgooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To throw something on top of something else, or figuratively to bring up an idea or suggestion for discussion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring up",
                                "target_lang_sense_clarification": "to suggest an idea or topic for discussion"
                            },
                            {
                                "target_lang_word": "toss out",
                                "target_lang_sense_clarification": "to casually suggest an idea"
                            },
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "to throw down a card or trump in a game"
                            }
                        ]
                    }
                }
            ]
        }
    ]
