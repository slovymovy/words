                                                "sense_id": "4b9152a6-a6c8-3148-8b93-430e6e9fa8a1",
                                                "text": "Aladdin, of the former dynasty [Khilji], subdued nearly all the Deccan, about 1312; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60ef8c57-366c-3997-9860-ae2a6250974c",
                                        "entry_id": "7f62154b-60f9-3daa-90c6-1006cd31513a",
                                        "glosses": [
                                            "Alternative form of Alaeddin."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84659516-22c3-4f95-a958-7cb5bc94b7c4",
                                                "sense_id": "60ef8c57-366c-3997-9860-ae2a6250974c",
                                                "text": "Orkhan, valuing his brother's knowledge, appointed him Grand Vizier. Aladdin was not an expert in warlike affairs, and turned his attention to the internal improvement of the dominion [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db796655-991b-3cf1-985d-e5ed26a63e7e",
                                        "entry_id": "7f62154b-60f9-3daa-90c6-1006cd31513a",
                                        "glosses": [
                                            "An Arabic tale about a young man named Aladdin who is recruited by a sorcerer to get a magic lamp from a cave; often adapted into comic pantomime in Britain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f201709-e282-38b4-af7f-5e136c1502ff",
                                        "entry_id": "7f62154b-60f9-3daa-90c6-1006cd31513a",
                                        "glosses": [
                                            "The young man who is the protagonist and title character of the story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3c0405-a8cb-4af2-921f-37df84db2a71",
                                                "sense_id": "2f201709-e282-38b4-af7f-5e136c1502ff",
                                                "text": "“Nay, never mind that,” said Aladdin, “tell thy story, friend, as best thou mayst.”"
                                            }
                                        ]
                                    }
                                ]
                            }
